"""Explicit collection of a segment store's obsolete layouts and unreferenced payloads under live leases."""

from crate.store import (
    HOME_VIEW,
    Lookup,
    Snapshot,
    current,
    lease_token,
    manifest_path,
    owned,
    read_frame,
    read_manifest,
    snapshot,
    switch,
    sync_durable,
)
from crate.store.files import StoreError, ensure_directory, failure, index_failure, io_failure, natural, place_synced
from crate.store.files import sync_directory
from crate.store.index import page_path, read_page
from crate.store.path import StorePath as Path


pub model Reclaimed:
    """Removed immutable files and logical lengths, with payload counts and bytes reported separately."""

    pub files: int = 0
    pub bytes: int = 0
    pub payloads: int = 0
    pub payload_bytes: int = 0


model Marked:
    """The exact immutable roots and layout files reached by current views and live scoped leases."""

    roots: set[str] = set()
    files: set[str] = set()
    pages: set[str] = set()
    segments: set[str] = set()
    payloads: set[str] = set()


pub def collect_layouts(root: Path) -> Result[Reclaimed, StoreError]:
    """
    Reclaim superseded manifests, index pages and segments while preserving every current view and live old reader.

    1. Pause publication, capture current roots and mark live leases outside the registration gate.
    2. Repeat the short handshake until every newly registered root is marked, or defer without deleting anything.
    3. Expire unretained descriptors atomically, then unlink only unreachable layouts.

    Payload eligibility belongs to its owning record codec. This operation conservatively keeps all payloads and all
    staging, including an uncommitted producer's files; it never guesses references from opaque record bytes.
    """
    return collect_records(root, no_payload_references, false)


pub def collect_records(
    root: Path,
    references: (str, bytes) -> Result[list[str], StoreError],
    payloads: bool = true,
) -> Result[Reclaimed, StoreError]:
    """
    Reclaim obsolete storage while current views, live readers and active preparations retain their content.

    1. Pause publication and trace current views through their owning codecs.
    2. Mark newly registered old readers, then expire all unretained historical descriptors atomically.
    3. Remove obsolete layouts and unreferenced payloads whose preparation locks are free.

    `references` must enumerate every payload a record's owning codec names or return an error. Marking errors abort
    before unlinking. `payloads=false` is layout-only maintenance and does not authorize removing opaque content.
    The collector never waits on a producer's payload lock while holding publication, which that producer needs.
    """
    # 1. Writers keep computing; canonical publication waits for this explicit maintenance operation.
    ensure_directory(root.joinpath("locks"))?
    writer = root.joinpath("locks/publication").store_lock_exclusive().map_err((error) => io_failure(root, error))?
    mut latest = snapshot(root)?
    mut marked = Marked()
    for entry in latest.views:
        mark_snapshot(marked, read_manifest(root, latest.generation, latest.digest, entry.view)?, references)?
    selected_segments = sorted([name for name in marked.segments])
    if latest.generation > 0 and selected_segments != sorted(latest.segments):
        latest = switch(root, latest, selected_segments, latest.views, "collection")?
        for entry in latest.views:
            mark_snapshot(marked, read_manifest(root, latest.generation, latest.digest, entry.view)?, references)?
    # 2. New pins can register during traversal; readers themselves never take publication's lock.
    for _attempt in range(8):
        pending = collect_handshake(root, latest, marked)?
        if len(pending) == 0:
            # 3. A producer that registered during traversal retains its digest under the same OS lock.
            mut result = sweep_layouts(root, marked)?
            if payloads:
                reclaimed = sweep_payloads(root, marked.payloads)?
                result.files += reclaimed.files
                result.bytes += reclaimed.bytes
                result.payloads += reclaimed.files
                result.payload_bytes += reclaimed.bytes
            return Ok(result)
        for selected in pending:
            mark_snapshot(marked, selected, references)?
    return Err(failure("busy", root.value, "collection deferred because new snapshot leases kept arriving"))


def collect_handshake(root: Path, latest: Snapshot, mut marked: Marked) -> Result[list[Snapshot], StoreError]:
    """Capture new live roots, or expire all other descriptors under the short registration gate."""
    gate = root.joinpath("locks/lifecycle").store_lock_exclusive().map_err((error) => io_failure(root, error))?
    pending = live_snapshots(root, marked)?
    if len(pending) > 0:
        return Ok(pending)
    registry = root.joinpath("RETAINED")
    data = ("\n".join([str(latest.generation)] + sorted([token for token in marked.roots])) + "\n").encode("utf-8")
    place_synced(registry, data)?
    sync_directory(root)?
    sync_durable(registry)?
    return Ok([])


def live_snapshots(root: Path, mut marked: Marked) -> Result[list[Snapshot], StoreError]:
    """Resolve immutable manifest descriptors only for locks the OS proves live; never infer liveness from a PID."""
    leases = root.joinpath("leases")
    if not leases.is_dir():
        return Ok([])
    mut pending: list[Snapshot] = []
    for path in leases.store_children().map_err((error) => io_failure(leases, error))?:
        name = path.name()
        if not name.startswith(".") or not name.endswith(".incan.lock"):
            return Err(failure("integrity", path.value, "unexpected lease entry"))
        token = name[1:len(name) - 11]
        if token in marked.roots:
            continue
        logical = leases.joinpath(token)
        free = logical.store_try_lock_exclusive().map_err((error) => io_failure(logical, error))?
        if free is not None:
            continue
        fields = token.split("-")
        if len(fields) != 3 or len(fields[2]) != 64:
            return Err(failure("integrity", path.value, "malformed live lease descriptor"))
        match natural(fields[0]):
            None => return Err(failure("integrity", path.value, "malformed lease generation"))
            Some(generation) =>
                if generation == 0:
                    if fields[1] != "":
                        return Err(failure("integrity", path.value, "empty snapshot lease names a manifest"))
                    continue
                if len(fields[1]) != 64:
                    return Err(failure("integrity", path.value, "malformed lease manifest digest"))
                manifest = read_manifest(root, generation, fields[1], HOME_VIEW)?
                mut found = false
                for entry in manifest.views:
                    selected = read_manifest(root, generation, fields[1], entry.view)?
                    if lease_token(selected) == token:
                        pending.append(selected)
                        found = true
                if not found:
                    # An empty view is valid, but has no lazy pages or frames to protect.
                    marked.roots.add(token)
                    marked.files.add(manifest_path(root, generation, fields[1]).value)
    return Ok(pending)


def mark_snapshot(
    mut marked: Marked,
    view: Snapshot,
    references: (str, bytes) -> Result[list[str], StoreError],
) -> Result[None, StoreError]:
    """Trace authenticated pages and exact frame locations, ignoring historical inventory and parent provenance."""
    token = lease_token(view)
    if token in marked.roots:
        return Ok(None)
    marked.roots.add(token)
    marked.files.add(manifest_path(view.root, view.generation, view.digest).value)
    mut pending: list[str] = [view.index]
    mut index = 0
    while index < len(pending):
        name = pending[index]
        index += 1
        if name == "" or name in marked.pages:
            continue
        page = read_page(view.root, name).map_err(index_failure)?
        marked.pages.add(name)
        marked.files.add(page_path(view.root, name).value)
        for entry in page.entries:
            if page.level > 0:
                pending.append(entry.child)
            else:
                match entry.location:
                    None => return Err(failure("integrity", name, "leaf without frame location"))
                    Some(location) =>
                        value = read_frame(view.root, entry.key, location)?
                        match value:
                            Lookup.Found(bytes_view) =>
                                for digest in references(entry.key, owned(bytes_view))?:
                                    if len(digest) != 64:
                                        return Err(failure("integrity", entry.key, "malformed payload reference"))
                                    marked.payloads.add(digest)
                            _ => pass
                        marked.segments.add(location.segment)
                        marked.files.add(view.root.joinpath(f"segments/{location.segment}.seg").value)
    return Ok(None)


def sweep_layouts(root: Path, marked: Marked) -> Result[Reclaimed, StoreError]:
    """Unlink only unmarked immutable layouts after descriptor expiry; deletion errors preserve an honest failure."""
    mut result = Reclaimed()
    for name in ["snapshots", "indexes", "segments"]:
        directory = root.joinpath(name)
        if not directory.is_dir():
            continue
        for path in directory.store_children().map_err((error) => io_failure(directory, error))?:
            if path.value in marked.files:
                continue
            mut suffix = ".seg"
            if name == "indexes":
                suffix = ".page"
            elif name == "snapshots":
                suffix = ".manifest"
            if not path.name().endswith(suffix) or path.is_symlink():
                continue
            info = path.store_stat().map_err((error) => io_failure(path, error))?
            size = info.store_size().map_err((error) => io_failure(path, error))?
            path.store_unlink().map_err((error) => io_failure(path, error))?
            result.files += 1
            result.bytes += size
        sync_directory(directory)?
    return Ok(result)


def no_payload_references(key: str, value: bytes) -> Result[list[str], StoreError]:
    """Layout-only maintenance keeps opaque payload ownership at the caller's codec boundary."""
    return Ok([])


def sweep_payloads(root: Path, marked: set[str]) -> Result[Reclaimed, StoreError]:
    """Unlink unreferenced content only while holding its exclusive preparation lock; live producers win the race."""
    mut result = Reclaimed()
    directory = root.joinpath("payloads")
    if not directory.is_dir():
        return Ok(result)
    for prefix in directory.store_children().map_err((error) => io_failure(directory, error))?:
        if not prefix.is_dir() or prefix.is_symlink():
            continue
        for path in prefix.store_children().map_err((error) => io_failure(prefix, error))?:
            digest = path.name()
            if len(digest) != 64 or digest in marked or path.is_symlink():
                continue
            leases = root.joinpath("payload-leases")
            ensure_directory(leases)?
            free = leases.joinpath(digest).store_try_lock_exclusive().map_err((error) => io_failure(path, error))?
            if free is None:
                continue
            size = path.store_stat().map_err((error) => io_failure(path, error))?.store_size().map_err(
                (error) => io_failure(path, error),
            )?
            path.store_unlink().map_err((error) => io_failure(path, error))?
            result.files += 1
            result.bytes += size
        sync_directory(prefix)?
    return Ok(result)
