"""
The store's copy-on-write B+tree directory: immutable, content-checked index pages from full keys to frame locations.

Part of the storage substrate with `crate.store`; it names no Oven type. A view's index is one root page. A lookup
reads only the pages on its path from that root to one leaf, and each page is checked against its content digest.
Pages are mapped and read in place. A lookup compares borrowed keys and copies only the selected references and
frame location. A write copies the pages on its changed paths and shares the other pages with older views.

Packs: every page one commit writes goes into one pack file, `indexes/<sha256>.pack`, named by its content, so a
commit installs one index file however many leaves its keys reach. A page reference is `pack:offset:length:digest`;
inside the pack being written it is `:offset:length:digest`, the pack it lies in. A store written before packs names
its pages by their digest alone, one `indexes/<digest>.page` file each; those references stay readable.

Page layout (little-endian): magic, level (0 for a leaf), entry count, then per entry the full key's length and bytes,
then for a leaf the frame's segment name, offset, length, SHA-256 and kind byte, or for an inner page the child's
reference: its length and bytes (a page file's page: the child's 64-character name). Entries are sorted by key, and
an inner entry's key is the smallest key below its child.

A process checks each page against its content digest once. It keeps each page it has checked, at most
`CHECKED_PAGE_LIMIT` of them, laid out over its own copy of the checked bytes and kept by that digest, and a later read
of a page with the same digest uses that layout instead of mapping, hashing and laying out its file again. The digest
names those bytes wherever the page lies, so a page found in another pack, as after a compaction, reuses them too; a
read takes its pack from its own reference, as `located_page` names it. Damage to a file after its page was checked
cannot reach an answer.
"""

from rust::std::cell import RefCell
from rust::std::str import from_utf8
from rust::std::ops import Deref, DerefMut
from rust::std::rc import Rc
from rust::std::sync import Arc
from rust::std::string import String as RustString
from std.primitives.hash import sha256
from std.primitives.hex import hexlify
from std.primitives.views import MappedFile, MappedView
from crate.store.bytes import append_bytes, append_u64
from crate.store.path import StorePath as Path

const FANOUT: int = 32
const NAME_BYTES: int = 64
const DIGEST_BYTES: int = 32
# The checked pages one process keeps; a process that meets more starts again from none.
const CHECKED_PAGE_LIMIT: int = 2048


pub model Location:
    """Where one key's newest frame lives: segment, byte range, frame digest, and whether it is a tombstone."""

    pub segment: str
    pub offset: int
    pub length: int
    pub digest: bytes
    pub tombstone: bool


pub model Entry:
    """One page entry: a full key and either a frame location (leaf) or a child page name (inner page)."""

    pub key: str
    pub location: Option[Location]
    pub child: str


pub model Page:
    """A decoded index page."""

    pub level: int
    pub entries: list[Entry]


pub model IndexError:
    """A damaged, missing or malformed index page, named."""

    pub object: str
    pub detail: str


pub model SearchResult:
    """One exact index answer and the digest of its authenticated root-to-leaf search path."""

    pub location: Option[Location]
    pub path_digest: str


model Span:
    """Where one entry of a mapped page lies: its key's offset and length, and the offset of the field after it."""

    key: int
    size: int
    field: int


model Layout:
    """
    A mapped page checked against its digest: its level, where each entry lies, its layout version, and the pack it
    lies in (empty for a page file), with nothing copied out.
    """

    view: MappedView
    level: int
    spans: Arc[list[Span]]
    version: int
    pack: str


model PageLocation:
    """Where a page reference points: a whole page file, or a byte range of an installed pack."""

    file: Path
    pack: str
    offset: int
    length: int
    digest: str


pub model PageWriter:
    """
    The pages one commit writes, gathered for one pack: each new page lies at its own offset, and equal pages are placed
    once. `install_pack` makes the pack one file in the index directory.
    """

    pub state: Rc[RefCell[PackState]] = Rc.new(RefCell.new(PackState()))

    pub def place(self, data: bytes) -> str:
        """Place one encoded page and return its reference inside the pack, `:offset:length:digest`."""
        mut held = self.state.as_ref().borrow_mut()
        return placed_page(data, held.deref_mut())


model PackState:
    """The pages of a pack being written, its size so far, and each placed page's reference by digest."""

    pages: list[bytes] = []
    size: int = 0
    placed: Dict[str, str] = {}


model CheckedPages:
    """
    Each index page this process has checked against its content digest, laid out over its own copy of the checked
    bytes, by that digest.
    """

    pages: Dict[str, Layout] = {}

    def checked(self, digest: str) -> Option[Layout]:
        """The page whose content digest is `digest`, when this process has checked it."""
        if digest not in self.pages:
            return None
        return Some(self.pages[digest])

    def keep(mut self, digest: str, page: Layout) -> None:
        """Keep one checked page; past `CHECKED_PAGE_LIMIT` pages the process starts again from none."""
        if len(self.pages) >= CHECKED_PAGE_LIMIT:
            self.pages = {}
        self.pages[digest] = page


# Index pages this process has read, and the bytes it copied out of them, for measuring what a lookup touches.
static pages_read: dict[str, int] = {}
# The pages this process has checked. A lookup reads them in place through the model's own methods: reading a key of a
# static dictionary would copy the whole dictionary.
static CHECKED: CheckedPages = CheckedPages()


pub def page_checked_bytes() -> int:
    """Physical bytes hashed on first access to immutable index pages in this process."""
    return pages_read.get("checked_bytes", 0)


pub def page_reads() -> int:
    """How many index pages this process has read."""
    return pages_read.get("pages", 0)


pub def pages_checked() -> int:
    """How many index pages this process has mapped and hashed to check them against their content digest."""
    return pages_read.get("checked", 0)


pub def copied_index_bytes() -> int:
    """Count bytes copied from mapped index pages to return decoded keys, child references, and frame locations."""
    return pages_read.get("copied", 0)


pub def pages_written() -> int:
    """How many index pages this process has placed in packs; equal pages within one pack count once."""
    return pages_read.get("written", 0)


pub def page_directory(root: Path) -> Path:
    """The directory every installed index pack and page file lives in."""
    return root.joinpath("indexes")


pub def page_path(root: Path, name: str) -> Path:
    """Where one page file of a store written before packs lives."""
    return page_directory(root).joinpath(f"{name}.page")


pub def pack_path(root: Path, name: str) -> Path:
    """Where one installed pack lives."""
    return page_directory(root).joinpath(f"{name}.pack")


pub def page_file(root: Path, reference: str) -> Result[Path, IndexError]:
    """The file a page reference reads: its pack, or a store's page file from before packs."""
    return Ok(located_page(root, reference)?.file)


def located_page(root: Path, reference: str) -> Result[PageLocation, IndexError]:
    """Where `reference` points: a whole page file named by its digest, or one range of an installed pack."""
    if ":" not in reference:
        return Ok(PageLocation(file=page_path(root, reference), pack="", offset=0, length=-1, digest=reference))
    parts = reference.split(":")
    if len(parts) != 4 or len(parts[0]) != 64 or len(parts[3]) != 64:
        return Err(IndexError(object=reference, detail="malformed index page reference"))
    match decimal(parts[1]):
        None => return Err(IndexError(object=reference, detail="malformed index page offset"))
        Some(offset) =>
            match decimal(parts[2]):
                None => return Err(IndexError(object=reference, detail="malformed index page length"))
                Some(length) =>
                    file = pack_path(root, parts[0])
                    return Ok(PageLocation(file=file, pack=parts[0], offset=offset, length=length, digest=parts[3]))


def decimal(text: str) -> Option[int]:
    """A bounded decimal number, when `text` is one."""
    if len(text) == 0 or len(text) > 18:
        return None
    for character in text:
        if character not in "0123456789":
            return None
    return Some(int(text))


def page_digest(reference: str) -> str:
    """The content digest a page reference names; a page file's name is its digest."""
    if ":" not in reference:
        return reference
    return reference.split(":")[3]


pub def installed_reference(reference: str, pack: str) -> str:
    """A reference made inside a pack being written, named absolutely once that pack is installed as `pack`."""
    if reference.startswith(":"):
        return pack + reference
    return reference


# ---- Reads ----


pub def find(root: Path, top: str, key: str) -> Result[Option[Location], IndexError]:
    """
    The location `key` has under the index rooted at `top`; an empty root is an empty index.

    Compare keys in place and copy only the references and frame location the search selects.
    """
    mut pages: list[str] = []
    return find_location(root, top, key, false, pages)


pub def search(root: Path, top: str, key: str) -> Result[SearchResult, IndexError]:
    """Find one location and bind the answer to every authenticated page examined on its search path."""
    mut pages: list[str] = []
    found = find_location(root, top, key, true, pages)?
    return Ok(SearchResult(location=found, path_digest=search_digest(pages, key)))


def find_location(root: Path, top: str, key: str, record_path: bool, mut pages: list[str]) -> Result[Option[Location], IndexError]:
    """Share the point lookup, retaining root-to-leaf evidence only for a caller that consumes it."""
    if top == "":
        return Ok(None)
    mut name = top
    loop:
        if record_path:
            pages.append(page_digest(name))
        page = mapped_page(root, name)?
        if page.level == 0:
            match select_span(page, key, false).map_err((detail) => malformed_at(name, detail))?:
                None => return Ok(None)
                Some(span) =>
                    found = location_at(page.view, span).map_err((detail) => malformed_at(name, detail))?
                    return Ok(Some(found))
        match select_span(page, key, true).map_err((detail) => malformed_at(name, detail))?:
            None => return Ok(None)
            Some(span) => name = child_at(page, span).map_err((detail) => malformed_at(name, detail))?


def search_digest(path: list[str], key: str) -> str:
    """Digest the page digests of the path and the exact searched key as reusable inclusion or exclusion evidence."""
    return hexlify(sha256.digest(("\n".join(path) + "\n" + key).encode("utf-8")))


def select_span(page: Borrowed[Layout], wanted: str, floor: bool) -> Result[Option[Span], str]:
    """Search the checked key directory for an exact leaf or the inner child covering the key."""
    position, exact = seek_position(page, wanted)?
    if exact:
        return Ok(Some(page.spans.as_ref()[position]))
    if floor and position > 0:
        return Ok(Some(page.spans.as_ref()[position - 1]))
    return Ok(None)


def seek_position(page: Borrowed[Layout], wanted: str) -> Result[tuple[int, bool], str]:
    """Find a key or its insertion point using the authenticated key spans in place."""
    mut lower = 0
    mut upper = len(page.spans.as_ref())
    while lower < upper:
        middle = (lower + upper) // 2
        span = page.spans.as_ref()[middle]
        candidate = key_view(page.view, span)?
        text = from_utf8(candidate.0.as_bytes()).map_err((_) => "key is not valid UTF-8")?
        if text < wanted:
            lower = middle + 1
        elif text > wanted:
            upper = middle
        else:
            return Ok((middle, true))
    return Ok((lower, false))



pub def entries(root: Path, top: str) -> Result[list[Entry], IndexError]:
    """Every leaf entry of the index, sorted by key; a maintenance read over every page."""
    mut result: list[Entry] = []
    if top == "":
        return Ok(result)
    page = read_page(root, top)?
    if page.level == 0:
        return Ok(page.entries)
    for entry in page.entries:
        result.extend(entries(root, entry.child)?)
    return Ok(result)


pub def first_stored_key(root: Path, top: str, lower: str) -> Result[Option[str], IndexError]:
    """Seek the first physical key at or above a lower bound, including keys whose current value is deleted."""
    if top == "":
        return Ok(None)
    page = mapped_page(root, top)?
    position, exact = seek_position(page, lower).map_err((detail) => malformed_at(top, detail))?
    if page.level == 0:
        if position == len(page.spans.as_ref()):
            return Ok(None)
        key = key_at(page.view, page.spans.as_ref()[position]).map_err((detail) => malformed_at(top, detail))?
        return Ok(Some(key))
    mut start = position
    if not exact and start > 0:
        start -= 1
    for index in range(start, len(page.spans.as_ref())):
        child = child_at(page, page.spans.as_ref()[index]).map_err((detail) => malformed_at(top, detail))?
        match first_stored_key(root, child, lower)?:
            Some(key) => return Ok(Some(key))
            None => pass
    return Ok(None)


pub def entries_with_prefix(root: Path, top: str, prefix: str) -> Result[list[Entry], IndexError]:
    """Collect the complete prefix range, retaining the existing three-argument store interface."""
    return limited_entries_with_prefix(root, top, prefix, 0)


pub def limited_entries_with_prefix(root: Path, top: str, prefix: str, limit: int) -> Result[list[Entry], IndexError]:
    """Walk the matching key range in place. Copy only selected leaf entries and traversed child references."""
    mut result: list[Entry] = []
    if top == "":
        return Ok(result)
    page = mapped_page(root, top)?
    boundary, exact = seek_position(page, prefix).map_err((detail) => malformed_at(top, detail))?
    if page.level == 0:
        for index in range(boundary, len(page.spans.as_ref())):
            span = page.spans.as_ref()[index]
            if not has_key_prefix(page.view, span, prefix).map_err((detail) => malformed_at(top, detail))?:
                break
            result.append(entry_at(page, span).map_err((detail) => malformed_at(top, detail))?)
            if limit > 0 and len(result) == limit:
                break
        return Ok(result)
    # The child immediately before the insertion point may contain the first match.
    mut start = boundary
    if not exact and start > 0:
        start -= 1
    for index in range(start, len(page.spans.as_ref())):
        span = page.spans.as_ref()[index]
        if index >= boundary and not has_key_prefix(page.view, span, prefix).map_err((detail) => malformed_at(top, detail))?:
            break
        child = child_at(page, span).map_err((detail) => malformed_at(top, detail))?
        mut remaining = 0
        if limit > 0:
            remaining = limit - len(result)
        result.extend(limited_entries_with_prefix(root, child, prefix, remaining)?)
        if limit > 0 and len(result) == limit:
            break
    return Ok(result)


def has_key_prefix(view: MappedView, span: Span, prefix: str) -> Result[bool, str]:
    """Compare a prevalidated key in place without allocating an owned string."""
    candidate = key_view(view, span)?
    text = from_utf8(candidate.0.as_bytes()).map_err((_) => "key is not valid UTF-8")?
    return Ok(text.startswith(prefix))


pub def entries_for_keys(root: Path, top: str, keys: list[str]) -> Result[list[Entry], IndexError]:
    """
    The leaf entries the index rooted at `top` holds for `keys`, sorted by key; each page on the keys' paths is read
    once, however many of the keys lie below it.
    """
    if top == "" or len(keys) == 0:
        return Ok([])
    return entries_below(root, read_page(root, top)?, sorted(keys))


def entries_below(root: Path, page: Page, keys: list[str]) -> Result[list[Entry], IndexError]:
    """The leaf entries below `page` whose keys are among the sorted `keys`."""
    mut result: list[Entry] = []
    if page.level == 0:
        mut wanted: set[str] = set()
        for key in keys:
            wanted.add(key)
        for entry in page.entries:
            if entry.key in wanted:
                result.append(entry)
        return Ok(result)
    mut taken = 0
    for position in range(len(page.entries)):
        mut group: list[str] = []
        while taken < len(keys) and (
            position + 1 == len(page.entries) or keys[taken] < page.entries[position + 1].key
        ):
            if keys[taken] >= page.entries[position].key:
                group.append(keys[taken])
            taken += 1
        if len(group) > 0:
            result.extend(entries_below(root, read_page(root, page.entries[position].child)?, group)?)
    return Ok(result)


pub def read_page(root: Path, reference: str) -> Result[Page, IndexError]:
    """One page, checked against its content digest and decoded into owned entries, children named absolutely."""
    page = mapped_page(root, reference)?
    mut result: list[Entry] = []
    for span in page.spans.as_ref():
        result.append(entry_at(page, span).map_err((detail) => malformed_at(reference, detail))?)
    return Ok(Page(level=page.level, entries=result))


def mapped_page(root: Path, reference: str) -> Result[Layout, IndexError]:
    """
    The page `reference` names, checked against its content digest and laid out in the pack `reference` names: mapped
    and hashed in place on this process's first read of that digest, and kept over a copy of its checked bytes for
    every later one.

    Packs and page files are content-named and never rewritten in place, so their inodes stay unchanged while mapped.
    """
    location = located_page(root, reference)?
    pages_read["pages"] = pages_read.get("pages", 0) + 1
    if let Some(checked) = CHECKED.checked(location.digest):
        mut found = checked
        found.pack = location.pack
        return Ok(found)
    path = location.file
    mapped = path.store_map_read().map_err((error) => IndexError(object=path.value, detail=error.message()))?
    mut length = location.length
    if length < 0:
        length = mapped.len()
    match mapped.view(location.offset, length):
        None => return Err(malformed(path, "the page lies outside its file"))
        Some(view) =>
            pages_read["checked"] = pages_read.get("checked", 0) + 1
            pages_read["checked_bytes"] = pages_read.get("checked_bytes", 0) + view.len()
            if hexlify(view_digest(view)) != location.digest:
                return Err(IndexError(object=path.value, detail="index page does not match its digest"))
            CHECKED.keep(
                location.digest,
                layout(checked_copy(path, view)?, location.pack).map_err((detail) => malformed(path, detail))?,
            )
            match CHECKED.checked(location.digest):
                Some(checked) => return Ok(checked)
                None => return Err(malformed(path, "a checked page was not kept"))


def checked_copy(path: Path, view: MappedView) -> Result[MappedView, IndexError]:
    """A whole view of this process's own copy of a page's checked bytes, which the kept layout reads."""
    copy = MappedFile.owned(view.to_bytes()).map_err((detail) => malformed(path, detail))?
    match copy.view(0, copy.len()):
        None => return Err(malformed(path, "the page copy has no whole view"))
        Some(whole) => return Ok(whole)


pub def view_digest(view: MappedView) -> bytes:
    """The SHA-256 of a mapped view, hashed where it lies; the store checks every object it reads with it."""
    mut hasher = sha256.new()
    hasher.update_view(view)
    return hasher.finalize_bytes()


def layout(view: MappedView, pack: str) -> Result[Layout, str]:
    """Validate the ordered UTF-8 keys and record the bounds of each entry in the checked page."""
    if view.len() < 24:
        return Err("not an index page")
    magic = scalar(view, 0)?
    mut version = 0
    if magic == u64_at(page_magic(), 0)?:
        version = 2
    elif magic == u64_at(page_file_magic(), 0)?:
        version = 1
    else:
        return Err("not an index page")
    level = scalar(view, 8)?
    count = scalar(view, 16)?
    mut offset = 24
    mut spans: list[Span] = []
    mut previous: Option[MappedView] = None
    for _position in range(count):
        size = scalar(view, offset)?
        field = offset + 8 + size
        if field > view.len():
            return Err("key runs past the page")
        mut width = NAME_BYTES
        if level == 0:
            width = NAME_BYTES + 17 + DIGEST_BYTES
        elif version == 2:
            if field + 8 > view.len():
                return Err("entry runs past the page")
            width = 8 + scalar(view, field)?
        if field + width > view.len():
            return Err("entry runs past the page")
        span = Span(key=offset + 8, size=size, field=field)
        key = key_view(view, span)?
        title = from_utf8(key.0.as_bytes()).map_err((_) => "key is not valid UTF-8")?
        if let Some(prior) = previous:
            earlier = from_utf8(prior.0.as_bytes()).map_err((_) => "key is not valid UTF-8")?
            if earlier >= title:
                return Err("index keys are out of order")
        previous = Some(key)
        spans.append(span)
        offset = field + width
    if offset != view.len():
        return Err("trailing bytes")
    return Ok(Layout(view=view, level=level, spans=Arc.new(spans), version=version, pack=pack))


def entry_at(page: Layout, span: Span) -> Result[Entry, str]:
    """One entry copied out of its page: the key, then the location of a leaf or the child of an inner page."""
    key = key_at(page.view, span)?
    if page.level == 0:
        return Ok(Entry(key=key, location=Some(location_at(page.view, span)?), child=""))
    return Ok(Entry(key=key, location=None, child=child_at(page, span)?))


def key_view(view: MappedView, span: Span) -> Result[MappedView, str]:
    """Borrow the key's checked extent within this immutable page."""
    match view.slice(span.key, span.size):
        Some(key) => return Ok(key)
        None => return Err("key runs past the page")


def key_at(view: MappedView, span: Span) -> Result[str, str]:
    """One entry's full key, copied out."""
    return text_of(copied(view, span.key, span.size)?)


def child_at(page: Layout, span: Span) -> Result[str, str]:
    """
    An inner entry's child reference, copied out and named absolutely: a reference inside the page's own pack names
    that pack, and a page file's child is the child's page file name.
    """
    if page.version == 1:
        return text_of(copied(page.view, span.field, NAME_BYTES)?)
    size = scalar(page.view, span.field)?
    child = text_of(copied(page.view, span.field + 8, size)?)?
    if child.startswith(":"):
        return Ok(page.pack + child)
    return Ok(child)


def location_at(view: MappedView, span: Span) -> Result[Location, str]:
    """A leaf entry's frame location, copied out: segment, offset, length, digest and kind."""
    segment = text_of(copied(view, span.field, NAME_BYTES)?)?
    start = scalar(view, span.field + NAME_BYTES)?
    length = scalar(view, span.field + NAME_BYTES + 8)?
    digest = copied(view, span.field + NAME_BYTES + 16, DIGEST_BYTES)?
    match view.read_u8(span.field + NAME_BYTES + 16 + DIGEST_BYTES):
        None => return Err("location runs past the page")
        Some(kind) =>
            tombstone = int(kind) != 0
            return Ok(Location(segment=segment, offset=start, length=length, digest=digest, tombstone=tombstone))


def copied(view: MappedView, offset: int, size: int) -> Result[bytes, str]:
    """`size` bytes at `offset` of a mapped page, copied out and counted."""
    match view.slice(offset, size):
        None => return Err("field runs past the page")
        Some(part) =>
            pages_read["copied"] = pages_read.get("copied", 0) + size
            return Ok(part.to_bytes())


def scalar(view: MappedView, offset: int) -> Result[int, str]:
    """One little-endian u64 of a mapped page, read in place."""
    match view.read_u64_le(offset):
        None => return Err("field runs past the page")
        Some(value) => return Ok(int(value))


def malformed(path: Path, detail: str) -> IndexError:
    """A page whose contents do not decode, named by its file."""
    return IndexError(object=path.value, detail=f"malformed index page: {detail}")


def malformed_at(reference: str, detail: str) -> IndexError:
    """A page whose contents do not decode, named by its reference."""
    return IndexError(object=reference, detail=f"malformed index page: {detail}")


# ---- Writes ----


pub def insert(root: Path, top: str, writer: PageWriter, additions: list[Entry]) -> Result[str, IndexError]:
    """
    The root of the index that holds `top`'s entries with `additions` replacing or adding entries by key.

    The additions are merged in one pass: each changed page is read once and placed once in `writer`'s pack, and every
    other page is shared. Every page placed is reachable from the returned root, a reference inside that pack until
    `install_pack` names it (`installed_reference`).
    """
    ordered = sorted_entries(additions)
    if top == "":
        return build(writer, ordered)
    if len(ordered) == 0:
        return Ok(top)
    page = read_page(root, top)?
    mut parts = merged_into(root, page, ordered, writer)?
    mut level = page.level + 1
    while len(parts) > 1:
        parts = written_chunks(writer, level, parts)?
        level += 1
    return Ok(parts[0].child)


def merged_into(root: Path, page: Page, additions: list[Entry], writer: PageWriter) -> Result[list[Entry], IndexError]:
    """The pages that replace `page` once sorted `additions` are merged below it, as inner entries."""
    if page.level == 0:
        return written_chunks(writer, 0, merged_leaves(page.entries, additions))
    mut updated: list[Entry] = []
    mut taken = 0
    for position in range(len(page.entries)):
        mut group: list[Entry] = []
        while taken < len(additions) and (
            position + 1 == len(page.entries) or additions[taken].key < page.entries[position + 1].key
        ):
            group.append(additions[taken])
            taken += 1
        if len(group) == 0:
            updated.append(page.entries[position])
        else:
            child = read_page(root, page.entries[position].child)?
            updated.extend(merged_into(root, child, group, writer)?)
    return written_chunks(writer, page.level, updated)


def merged_leaves(entries: list[Entry], additions: list[Entry]) -> list[Entry]:
    """Sorted leaf entries with sorted `additions` merged in by key, an addition replacing the entry of its key."""
    mut result: list[Entry] = []
    mut taken = 0
    for entry in entries:
        while taken < len(additions) and additions[taken].key < entry.key:
            result.append(additions[taken])
            taken += 1
        if taken < len(additions) and additions[taken].key == entry.key:
            result.append(additions[taken])
            taken += 1
        else:
            result.append(entry)
    result.extend(additions[taken:])
    return result


def written_chunks(writer: PageWriter, level: int, entries: list[Entry]) -> Result[list[Entry], IndexError]:
    """
    Write `entries` as one page, or as the fewest pages within the fan-out, sizes even and the larger ones last; return
    their inner entries.
    """
    count = (len(entries) + FANOUT - 1) // FANOUT
    mut parts: list[Entry] = []
    mut start = 0
    for chunk_index in range(count):
        mut size = len(entries) // count
        if chunk_index >= count - len(entries) % count:
            size += 1
        chunk = entries[start:start + size]
        reference = write_page(writer, Page(level=level, entries=chunk))?
        parts.append(Entry(key=chunk[0].key, location=None, child=reference))
        start += size
    return Ok(parts)


pub def build(writer: PageWriter, leaves: list[Entry]) -> Result[str, IndexError]:
    """
    A canonical index over sorted, distinct leaf entries: full pages from the left, level by level, each placed in
    `writer`'s pack.

    The pages depend only on the entries, so equal contents always give byte-identical pages, packs and roots.
    """
    if len(leaves) == 0:
        return Ok("")
    mut level = 0
    mut current = leaves
    loop:
        mut parents: list[Entry] = []
        mut start = 0
        while start < len(current):
            chunk = current[start:start + FANOUT]
            reference = write_page(writer, Page(level=level, entries=chunk))?
            parents.append(Entry(key=chunk[0].key, location=None, child=reference))
            start += FANOUT
        if len(parents) == 1:
            return Ok(parents[0].child)
        current = parents
        level += 1


pub def write_index(root: Path, staged: Path, leaves: list[Entry]) -> Result[str, IndexError]:
    """A canonical index over sorted, distinct leaf entries, installed as one pack; returns its root reference."""
    writer = PageWriter()
    top = build(writer, leaves)?
    pack = install_pack(root, writer, staged)?
    return Ok(installed_reference(top, pack))


def sorted_entries(additions: list[Entry]) -> list[Entry]:
    """Additions in key order, the last one per key kept."""
    mut by_key: Dict[str, Entry] = {}
    for entry in additions:
        by_key[entry.key] = entry
    return [by_key[key] for key in sorted([key for key in by_key.keys()])]


def write_page(writer: PageWriter, page: Page) -> Result[str, IndexError]:
    """Place one page in the pack being written; returns its reference inside that pack."""
    data = encode_page(page).map_err((detail) => IndexError(object="index page", detail=detail))?
    return Ok(writer.place(data))


def placed_page(data: bytes, mut state: BorrowedMut[PackState]) -> str:
    """Append a page to the pack unless equal bytes already lie in it; returns its reference inside the pack."""
    digest = hexlify(sha256.digest(data))
    if digest in state.placed:
        return state.placed[digest]
    reference = f":{state.size}:{len(data)}:{digest}"
    state.pages.append(data)
    state.size += len(data)
    state.placed[digest] = reference
    pages_read["written"] = pages_read.get("written", 0) + 1
    return reference


pub def install_pack(root: Path, writer: PageWriter, staged: Path) -> Result[str, IndexError]:
    """
    Install the pages `writer` gathered as one pack in the index directory, named by its content digest: written in
    `staged`, its bytes synchronized before the name appears, so an installed pack always holds its complete content.
    An installed pack of that name already holds these bytes and is kept. Returns the pack's name, or an empty name
    when no page was written. The index directory must exist.
    """
    held = writer.state.as_ref().borrow()
    data = pack_bytes(held.deref())
    if len(data) == 0:
        return Ok("")
    name = hexlify(sha256.digest(data))
    target = pack_path(root, name)
    if target.is_file():
        return Ok(name)
    staged.store_mkdir(true, true).map_err((error) => IndexError(object=staged.value, detail=error.message()))?
    written = staged.joinpath(f"{name}.pack")
    written.store_write_bytes(data).map_err((error) => IndexError(object=written.value, detail=error.message()))?
    written.store_sync_ordered().map_err((error) => IndexError(object=written.value, detail=error.message()))?
    written.store_replace(target).map_err((error) => IndexError(object=target.value, detail=error.message()))?
    return Ok(name)


def pack_bytes(state: Borrowed[PackState]) -> bytes:
    """The pages of a pack, in the order they were placed."""
    mut data: list[u8] = []
    for page in state.pages:
        append_bytes(data, page)
    return data


# ---- Repacking ----


pub def pack_usage(root: Path, tops: list[str]) -> Result[Dict[str, int], IndexError]:
    """The bytes of the pages reachable from `tops` that each pack holds, every page counted once."""
    mut usage: Dict[str, int] = {}
    for reference in tree_order(root, tops)?.order:
        location = located_page(root, reference)?
        if location.pack != "":
            usage[location.pack] = usage.get(location.pack, 0) + location.length
    return Ok(usage)


pub def repacked(root: Path, top: str, writer: PageWriter, moving: set[str]) -> Result[str, IndexError]:
    """
    The root of `top`'s index once every page that lies in a `moving` pack is placed again in `writer`'s pack, together
    with the pages above it, whose child references change. Every other page is shared and every entry is unchanged, so
    every lookup answers as before. Returns `top` when no page below it moves.

    A page placed again with its bytes unchanged, as every leaf is, keeps its content name in the new pack. A page above
    a moved one holds new child references, so it is a new page under a new name: no page's bytes change under its name.
    Pages are placed children first, from the end of the breadth-first order, so a parent meets its moved children's
    new references.
    """
    if top == "":
        return Ok(top)
    tree = tree_order(root, [top])?
    mut moved: Dict[str, str] = {}
    for back in range(len(tree.order)):
        reference = tree.order[len(tree.order) - 1 - back]
        page = tree.pages[reference]
        mut changes = located_page(root, reference)?.pack in moving
        mut entries: list[Entry] = []
        for entry in page.entries:
            if page.level > 0 and entry.child in moved:
                changes = true
                entries.append(Entry(key=entry.key, location=None, child=moved[entry.child]))
            else:
                entries.append(entry)
        if changes:
            moved[reference] = write_page(writer, Page(level=page.level, entries=entries))?
    return Ok(moved.get(top, top))


model TreeOrder:
    """The pages reachable from some roots, each once, in breadth-first order, and each page decoded."""

    order: list[str] = []
    pages: Dict[str, Page] = {}


def tree_order(root: Path, tops: list[str]) -> Result[TreeOrder, IndexError]:
    """Every page reachable from `tops`, each read once, parents before their children."""
    mut tree = TreeOrder()
    mut pending = tops
    mut position = 0
    while position < len(pending):
        reference = pending[position]
        position += 1
        if reference == "" or reference in tree.pages:
            continue
        page = read_page(root, reference)?
        tree.order.append(reference)
        if page.level > 0:
            for entry in page.entries:
                pending.append(entry.child)
        tree.pages[reference] = page
    return Ok(tree)


# ---- Encoding ----


def encode_page(page: Page) -> Result[bytes, str]:
    """The canonical bytes of a page written into a pack."""
    mut buffer: list[u8] = []
    append_bytes(buffer, page_magic())
    append_u64(buffer, page.level, "index")?
    append_u64(buffer, len(page.entries), "index")?
    for entry in page.entries:
        key = entry.key.encode("utf-8")
        append_u64(buffer, len(key), "index")?
        append_bytes(buffer, key)
        match entry.location:
            Some(location) =>
                append_bytes(buffer, location.segment.encode("utf-8"))
                append_u64(buffer, location.offset, "index")?
                append_u64(buffer, location.length, "index")?
                append_bytes(buffer, location.digest)
                if location.tombstone:
                    append_bytes(buffer, b"\x01")
                else:
                    append_bytes(buffer, b"\x00")
            None =>
                child = entry.child.encode("utf-8")
                append_u64(buffer, len(child), "index")?
                append_bytes(buffer, child)
    return Ok(buffer)


def page_magic() -> bytes:
    """The header every page in a pack starts with: inner entries name their child by a length-prefixed reference."""
    return b"INCIDX\x00\x02"


def page_file_magic() -> bytes:
    """The header of a page file from a store written before packs: inner entries name a 64-character page file."""
    return b"INCIDX\x00\x01"


def text_of(data: bytes) -> Result[str, str]:
    """`data` as UTF-8 text."""
    match RustString.from_utf8(data):
        Ok(text) => return Ok(str(text))
        Err(_) => return Err("not text")


def u64_at(data: bytes, offset: int) -> Result[int, str]:
    """One little-endian u64 at `offset`, when eight bytes are there."""
    if offset < 0 or offset + 8 > len(data):
        return Err("field runs past the page")
    return Ok(
        int(data[offset]) + int(data[offset + 1]) * 256 + int(data[offset + 2]) * 65536 + int(data[offset + 3]) * 16777216 + int(
            data[offset + 4],
        ) * 4294967296 + int(data[offset + 5]) * 1099511627776 + int(data[offset + 6]) * 281474976710656 + int(
            data[offset + 7],
        ) * 72057594037927936,
    )
