"""
The store's copy-on-write B+tree directory: immutable, content-named index pages from full keys to frame locations.

Part of the storage substrate with `crate.store`; it names no Oven type. A view's index is one root page. A lookup
reads only the pages on its path from that root to one leaf, and each page is checked against its content name. Pages
are mapped and read in place: a lookup copies out only the keys it compares and the location it finds. A write copies
the pages on the paths it changes and leaves every other page shared with older roots and other views.

Page layout (little-endian): magic, level (0 for a leaf), entry count, then per entry the full key's length and bytes,
then for a leaf the frame's segment name, offset, length, SHA-256 and kind byte, or for an inner page the child page
name. Entries are sorted by key, and an inner entry's key is the smallest key below its child.

A process checks each page against its name once. It keeps each page it has read, at most `CHECKED_PAGE_LIMIT` of
them, laid out over its own copy of the checked bytes, and a later read of the same page uses that layout instead of
mapping, hashing and laying out the file again. A page is content-named and never rewritten, so its name still names
those bytes, and damage to the file after the check cannot reach an answer.
"""

from rust::std::process import id
from rust::std::string import String as RustString
from std.primitives.hash import sha256
from std.primitives.hex import hexlify
from std.primitives.views import MappedFile, MappedView
from crate.store.bytes import append_bytes, append_u64
from crate.store.path import StorePath as Path

const FANOUT: int = 32
const NAME_BYTES: int = 64
const DIGEST_BYTES: int = 32
# The checked pages one process keeps; a process that meets more starts again from none.
const CHECKED_PAGE_LIMIT: int = 2048


pub model Location:
    """Where one key's newest frame lives: segment, byte range, frame digest, and whether it is a tombstone."""

    pub segment: str
    pub offset: int
    pub length: int
    pub digest: bytes
    pub tombstone: bool


pub model Entry:
    """One page entry: a full key and either a frame location (leaf) or a child page name (inner page)."""

    pub key: str
    pub location: Option[Location]
    pub child: str


pub model Page:
    """A decoded index page."""

    pub level: int
    pub entries: list[Entry]


pub model IndexError:
    """A damaged, missing or malformed index page, named."""

    pub object: str
    pub detail: str


pub model SearchResult:
    """One exact index answer and the digest of its authenticated root-to-leaf search path."""

    pub location: Option[Location]
    pub path_digest: str


model Span:
    """Where one entry of a mapped page lies: its key's offset and length, and the offset of the field after it."""

    key: int
    size: int
    field: int


model Layout:
    """A mapped page checked against its name: its level and where each entry lies, with nothing copied out."""

    view: MappedView
    level: int
    spans: list[Span]


model CheckedPages:
    """Each index page this process has checked against its name, laid out over its own copy of the checked bytes."""

    pages: Dict[str, Layout] = {}

    def checked(self, name: str) -> Option[Layout]:
        """The page named `name`, when this process has checked it."""
        if name not in self.pages:
            return None
        return Some(self.pages[name])

    def keep(mut self, name: str, page: Layout) -> None:
        """Keep one checked page; past `CHECKED_PAGE_LIMIT` pages the process starts again from none."""
        if len(self.pages) >= CHECKED_PAGE_LIMIT:
            self.pages = {}
        self.pages[name] = page


# Index pages this process has read, and the bytes it copied out of them, for measuring what a lookup touches.
static pages_read: dict[str, int] = {}
# The pages this process has checked; a lookup reads them in place through the model's own methods.
static CHECKED: CheckedPages = CheckedPages()


pub def page_reads() -> int:
    """How many index pages this process has read."""
    return pages_read.get("pages", 0)


pub def copied_index_bytes() -> int:
    """How many bytes this process copied out of mapped index pages: compared keys and decoded entries."""
    return pages_read.get("copied", 0)


pub def page_path(root: Path, name: str) -> Path:
    """Where one index page lives."""
    return root.joinpath("indexes").joinpath(f"{name}.page")


# ---- Reads ----


pub def find(root: Path, top: str, key: str) -> Result[Option[Location], IndexError]:
    """
    The location `key` has under the index rooted at `top`; an empty root is an empty index.

    Each page on the path is read in place; only the keys compared and the one location found are copied out.
    """
    return Ok(search(root, top, key)?.location)


pub def search(root: Path, top: str, key: str) -> Result[SearchResult, IndexError]:
    """Find one location and bind the answer to every authenticated page examined on its search path."""
    if top == "":
        return Ok(SearchResult(location=None, path_digest=search_digest([], key)))
    mut name = top
    mut names: list[str] = []
    loop:
        names.append(name)
        path = page_path(root, name)
        page = mapped_page(path, name)?
        if page.level == 0:
            match leaf_span(page, key).map_err((detail) => malformed(path, detail))?:
                None => return Ok(SearchResult(location=None, path_digest=search_digest(names, key)))
                Some(span) =>
                    found = location_at(page.view, span).map_err((detail) => malformed(path, detail))?
                    return Ok(SearchResult(location=Some(found), path_digest=search_digest(names, key)))
        match covering_span(page, key).map_err((detail) => malformed(path, detail))?:
            None => return Ok(SearchResult(location=None, path_digest=search_digest(names, key)))
            Some(span) => name = child_at(page.view, span).map_err((detail) => malformed(path, detail))?


def search_digest(path: list[str], key: str) -> str:
    """Digest the content-named page path and exact searched key as reusable inclusion or exclusion evidence."""
    return hexlify(sha256.digest(("\n".join(path) + "\n" + key).encode("utf-8")))


def leaf_span(page: Layout, key: str) -> Result[Option[Span], str]:
    """The leaf entry under `key`; only keys of its length are copied out to compare."""
    wanted = key.encode("utf-8")
    for span in page.spans:
        if span.size == len(wanted) and copied(page.view, span.key, span.size)? == wanted:
            return Ok(Some(span))
    return Ok(None)


def covering_span(page: Layout, key: str) -> Result[Option[Span], str]:
    """The inner entry whose child's key range holds `key`."""
    mut chosen: Option[Span] = None
    for span in page.spans:
        if key_at(page.view, span)? <= key:
            chosen = Some(span)
        else:
            break
    return Ok(chosen)


pub def entries(root: Path, top: str) -> Result[list[Entry], IndexError]:
    """Every leaf entry of the index, sorted by key; a maintenance read over every page."""
    mut result: list[Entry] = []
    if top == "":
        return Ok(result)
    page = read_page(root, top)?
    if page.level == 0:
        return Ok(page.entries)
    for entry in page.entries:
        result.extend(entries(root, entry.child)?)
    return Ok(result)


pub def entries_with_prefix(root: Path, top: str, prefix: str) -> Result[list[Entry], IndexError]:
    """
    The leaf entries whose keys start with `prefix`, sorted by key, reading only the pages whose range can hold one.

    An inner entry's key is the least key below it. A child is skipped when its next sibling starts at or before
    `prefix`, since every key below it is then less than `prefix`; the walk stops at the first child whose least key
    is past `prefix` without starting with it, since every key from there on is greater than any key with the prefix.
    """
    mut result: list[Entry] = []
    if top == "":
        return Ok(result)
    page = read_page(root, top)?
    if page.level == 0:
        for entry in page.entries:
            if entry.key.startswith(prefix):
                result.append(entry)
        return Ok(result)
    for position in range(len(page.entries)):
        entry = page.entries[position]
        if entry.key > prefix and not entry.key.startswith(prefix):
            break
        if position + 1 < len(page.entries) and page.entries[position + 1].key <= prefix:
            continue
        result.extend(entries_with_prefix(root, entry.child, prefix)?)
    return Ok(result)


pub def entries_for_keys(root: Path, top: str, keys: list[str]) -> Result[list[Entry], IndexError]:
    """
    The leaf entries the index rooted at `top` holds for `keys`, sorted by key; each page on the keys' paths is read
    once, however many of the keys lie below it.
    """
    if top == "" or len(keys) == 0:
        return Ok([])
    return entries_below(root, read_page(root, top)?, sorted(keys))


def entries_below(root: Path, page: Page, keys: list[str]) -> Result[list[Entry], IndexError]:
    """The leaf entries below `page` whose keys are among the sorted `keys`."""
    mut result: list[Entry] = []
    if page.level == 0:
        mut wanted: set[str] = set()
        for key in keys:
            wanted.add(key)
        for entry in page.entries:
            if entry.key in wanted:
                result.append(entry)
        return Ok(result)
    mut taken = 0
    for position in range(len(page.entries)):
        mut group: list[str] = []
        while taken < len(keys) and (
            position + 1 == len(page.entries) or keys[taken] < page.entries[position + 1].key
        ):
            if keys[taken] >= page.entries[position].key:
                group.append(keys[taken])
            taken += 1
        if len(group) > 0:
            result.extend(entries_below(root, read_page(root, page.entries[position].child)?, group)?)
    return Ok(result)


pub def read_page(root: Path, name: str) -> Result[Page, IndexError]:
    """One page, checked against its content name and decoded into owned entries."""
    return decoded_page(page_path(root, name), name)


def decoded_page(path: Path, name: str) -> Result[Page, IndexError]:
    """The page mapped at `path`, checked against `name`, with every entry copied out."""
    page = mapped_page(path, name)?
    mut result: list[Entry] = []
    for span in page.spans:
        result.append(entry_at(page.view, span, page.level).map_err((detail) => malformed(path, detail))?)
    return Ok(Page(level=page.level, entries=result))


def mapped_page(path: Path, name: str) -> Result[Layout, IndexError]:
    """
    The page at `path` checked against its content name and laid out: mapped and hashed in place on this process's
    first read of it, and kept over a copy of its checked bytes for every later one.

    Index pages are content-named and never rewritten in place, so their inodes stay unchanged while mapped.
    """
    if let Some(checked) = CHECKED.checked(name):
        return Ok(checked)
    mapped = path.store_map_read().map_err((error) => IndexError(object=path.value, detail=error.message()))?
    match mapped.view(0, mapped.len()):
        None => return Err(malformed(path, "the mapping has no whole view"))
        Some(view) =>
            pages_read["pages"] = pages_read.get("pages", 0) + 1
            if hexlify(view_digest(view)) != name:
                return Err(IndexError(object=path.value, detail="index page does not match its name"))
            CHECKED.keep(name, layout(checked_copy(path, view)?).map_err((detail) => malformed(path, detail))?)
            match CHECKED.checked(name):
                Some(checked) => return Ok(checked)
                None => return Err(malformed(path, "a checked page was not kept"))


def checked_copy(path: Path, view: MappedView) -> Result[MappedView, IndexError]:
    """A whole view of this process's own copy of a page's checked bytes, which the kept layout reads."""
    copy = MappedFile.owned(view.to_bytes()).map_err((detail) => malformed(path, detail))?
    match copy.view(0, copy.len()):
        None => return Err(malformed(path, "the page copy has no whole view"))
        Some(whole) => return Ok(whole)


pub def view_digest(view: MappedView) -> bytes:
    """The SHA-256 of a mapped view, hashed where it lies; the store checks every object it reads with it."""
    mut hasher = sha256.new()
    hasher.update_view(view)
    return hasher.finalize_bytes()


def layout(view: MappedView) -> Result[Layout, str]:
    """Where each entry of a page lies, refusing any length or field that does not fit; nothing is copied."""
    if view.len() < 24 or scalar(view, 0)? != u64_at(page_magic(), 0)?:
        return Err("not an index page")
    level = scalar(view, 8)?
    count = scalar(view, 16)?
    mut width = NAME_BYTES
    if level == 0:
        width = NAME_BYTES + 17 + DIGEST_BYTES
    mut offset = 24
    mut spans: list[Span] = []
    for _position in range(count):
        size = scalar(view, offset)?
        field = offset + 8 + size
        if field > view.len():
            return Err("key runs past the page")
        if field + width > view.len():
            return Err("entry runs past the page")
        spans.append(Span(key=offset + 8, size=size, field=field))
        offset = field + width
    if offset != view.len():
        return Err("trailing bytes")
    return Ok(Layout(view=view, level=level, spans=spans))


def entry_at(view: MappedView, span: Span, level: int) -> Result[Entry, str]:
    """One entry copied out of its page: the key, then the location of a leaf or the child of an inner page."""
    key = key_at(view, span)?
    if level == 0:
        return Ok(Entry(key=key, location=Some(location_at(view, span)?), child=""))
    return Ok(Entry(key=key, location=None, child=child_at(view, span)?))


def key_at(view: MappedView, span: Span) -> Result[str, str]:
    """One entry's full key, copied out."""
    return text_of(copied(view, span.key, span.size)?)


def child_at(view: MappedView, span: Span) -> Result[str, str]:
    """An inner entry's child page name, copied out."""
    return text_of(copied(view, span.field, NAME_BYTES)?)


def location_at(view: MappedView, span: Span) -> Result[Location, str]:
    """A leaf entry's frame location, copied out: segment, offset, length, digest and kind."""
    segment = text_of(copied(view, span.field, NAME_BYTES)?)?
    start = scalar(view, span.field + NAME_BYTES)?
    length = scalar(view, span.field + NAME_BYTES + 8)?
    digest = copied(view, span.field + NAME_BYTES + 16, DIGEST_BYTES)?
    match view.read_u8(span.field + NAME_BYTES + 16 + DIGEST_BYTES):
        None => return Err("location runs past the page")
        Some(kind) =>
            tombstone = int(kind) != 0
            return Ok(Location(segment=segment, offset=start, length=length, digest=digest, tombstone=tombstone))


def copied(view: MappedView, offset: int, size: int) -> Result[bytes, str]:
    """`size` bytes at `offset` of a mapped page, copied out and counted."""
    match view.slice(offset, size):
        None => return Err("field runs past the page")
        Some(part) =>
            pages_read["copied"] = pages_read.get("copied", 0) + size
            return Ok(part.to_bytes())


def scalar(view: MappedView, offset: int) -> Result[int, str]:
    """One little-endian u64 of a mapped page, read in place."""
    match view.read_u64_le(offset):
        None => return Err("field runs past the page")
        Some(value) => return Ok(int(value))


def malformed(path: Path, detail: str) -> IndexError:
    """A page whose contents do not decode, named."""
    return IndexError(object=path.value, detail=f"malformed index page: {detail}")


# ---- Writes ----


pub def insert(root: Path, top: str, staged: Path, additions: list[Entry]) -> Result[str, IndexError]:
    """
    The root of the index that holds `top`'s entries with `additions` replacing or adding entries by key.

    The additions are merged in one pass: each changed page is read and written once, into `staged` for the caller to
    install, and every other page is shared.
    """
    ordered = sorted_entries(additions)
    if top == "":
        return build(staged, ordered)
    if len(ordered) == 0:
        return Ok(top)
    page = read_page(root, top)?
    mut parts = merged_into(root, page, ordered, staged)?
    mut level = page.level + 1
    while len(parts) > 1:
        parts = written_chunks(staged, level, parts)?
        level += 1
    return Ok(parts[0].child)


pub def staged_pages(staged: Path, roots: list[str]) -> Result[list[Path], IndexError]:
    """
    New pages reachable from the final roots, excluding reused installed subtrees.

    A staged page can reference staged or installed children. An installed child is immutable and cannot reach a
    newly staged page, so this walk stops at it instead of reading the unchanged tree.
    """
    mut pending = roots
    mut seen: set[str] = set()
    mut result: list[Path] = []
    mut index = 0
    while index < len(pending):
        name = pending[index]
        index += 1
        if name == "" or name in seen:
            continue
        seen.add(name)
        path = staged.joinpath(f"{name}.page")
        if not path.is_file():
            continue
        page = decoded_page(path, name)?
        result.append(path)
        if page.level > 0:
            pending.extend([entry.child for entry in page.entries])
    return Ok(result)


def merged_into(root: Path, page: Page, additions: list[Entry], staged: Path) -> Result[list[Entry], IndexError]:
    """The pages that replace `page` once sorted `additions` are merged below it, as inner entries."""
    if page.level == 0:
        return written_chunks(staged, 0, merged_leaves(page.entries, additions))
    mut updated: list[Entry] = []
    mut taken = 0
    for position in range(len(page.entries)):
        mut group: list[Entry] = []
        while taken < len(additions) and (
            position + 1 == len(page.entries) or additions[taken].key < page.entries[position + 1].key
        ):
            group.append(additions[taken])
            taken += 1
        if len(group) == 0:
            updated.append(page.entries[position])
        else:
            child = read_page(root, page.entries[position].child)?
            updated.extend(merged_into(root, child, group, staged)?)
    return written_chunks(staged, page.level, updated)


def merged_leaves(entries: list[Entry], additions: list[Entry]) -> list[Entry]:
    """Sorted leaf entries with sorted `additions` merged in by key, an addition replacing the entry of its key."""
    mut result: list[Entry] = []
    mut taken = 0
    for entry in entries:
        while taken < len(additions) and additions[taken].key < entry.key:
            result.append(additions[taken])
            taken += 1
        if taken < len(additions) and additions[taken].key == entry.key:
            result.append(additions[taken])
            taken += 1
        else:
            result.append(entry)
    result.extend(additions[taken:])
    return result


def written_chunks(staged: Path, level: int, entries: list[Entry]) -> Result[list[Entry], IndexError]:
    """
    Write `entries` as one page, or as the fewest pages within the fan-out, sizes even and the larger ones last; return
    their inner entries.
    """
    count = (len(entries) + FANOUT - 1) // FANOUT
    mut parts: list[Entry] = []
    mut start = 0
    for chunk_index in range(count):
        mut size = len(entries) // count
        if chunk_index >= count - len(entries) % count:
            size += 1
        chunk = entries[start:start + size]
        name = write_page(staged, Page(level=level, entries=chunk))?
        parts.append(Entry(key=chunk[0].key, location=None, child=name))
        start += size
    return Ok(parts)


pub def build(staged: Path, leaves: list[Entry]) -> Result[str, IndexError]:
    """
    A canonical index over sorted, distinct leaf entries: full pages from the left, level by level.

    The pages depend only on the entries, so equal contents always give byte-identical pages and the same root.
    """
    if len(leaves) == 0:
        return Ok("")
    mut level = 0
    mut current = leaves
    loop:
        mut parents: list[Entry] = []
        mut start = 0
        while start < len(current):
            chunk = current[start:start + FANOUT]
            name = write_page(staged, Page(level=level, entries=chunk))?
            parents.append(Entry(key=chunk[0].key, location=None, child=name))
            start += FANOUT
        if len(parents) == 1:
            return Ok(parents[0].child)
        current = parents
        level += 1


def sorted_entries(additions: list[Entry]) -> list[Entry]:
    """Additions in key order, the last one per key kept."""
    mut by_key: Dict[str, Entry] = {}
    for entry in additions:
        by_key[entry.key] = entry
    return [by_key[key] for key in sorted([key for key in by_key.keys()])]


def write_page(staged: Path, page: Page) -> Result[str, IndexError]:
    """Write one page into staging under its content name."""
    data = encode_page(page).map_err((detail) => IndexError(object="index page", detail=detail))?
    name = hexlify(sha256.digest(data))
    target = staged.joinpath(f"{name}.page")
    if target.is_file():
        return Ok(name)
    staged.store_mkdir(true, true).map_err((error) => IndexError(object=staged.value, detail=error.message()))?
    temporary = target.at(f"{target.value}.{id()}.tmp")
    temporary.store_write_bytes(data).map_err((error) => IndexError(object=temporary.value, detail=error.message()))?
    temporary.store_replace(target).map_err((error) => IndexError(object=target.value, detail=error.message()))?
    return Ok(name)


# ---- Encoding ----


def encode_page(page: Page) -> Result[bytes, str]:
    """The canonical bytes of a page."""
    mut buffer: list[u8] = []
    append_bytes(buffer, page_magic())
    append_u64(buffer, page.level, "index")?
    append_u64(buffer, len(page.entries), "index")?
    for entry in page.entries:
        key = entry.key.encode("utf-8")
        append_u64(buffer, len(key), "index")?
        append_bytes(buffer, key)
        match entry.location:
            Some(location) =>
                append_bytes(buffer, location.segment.encode("utf-8"))
                append_u64(buffer, location.offset, "index")?
                append_u64(buffer, location.length, "index")?
                append_bytes(buffer, location.digest)
                if location.tombstone:
                    append_bytes(buffer, b"\x01")
                else:
                    append_bytes(buffer, b"\x00")
            None => append_bytes(buffer, entry.child.encode("utf-8"))
    return Ok(buffer)


def page_magic() -> bytes:
    """The header every index page starts with."""
    return b"INCIDX\x00\x01"


def text_of(data: bytes) -> Result[str, str]:
    """`data` as UTF-8 text."""
    match RustString.from_utf8(data):
        Ok(text) => return Ok(str(text))
        Err(_) => return Err("not text")


def u64_at(data: bytes, offset: int) -> Result[int, str]:
    """One little-endian u64 at `offset`, when eight bytes are there."""
    if offset < 0 or offset + 8 > len(data):
        return Err("field runs past the page")
    return Ok(
        int(data[offset]) + int(data[offset + 1]) * 256 + int(data[offset + 2]) * 65536 + int(data[offset + 3]) * 16777216 + int(
            data[offset + 4],
        ) * 4294967296 + int(data[offset + 5]) * 1099511627776 + int(data[offset + 6]) * 281474976710656 + int(
            data[offset + 7],
        ) * 72057594037927936,
    )
