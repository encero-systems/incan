"""
Bounded IPC over Unix sockets: length-framed byte payloads, per-direction data credits and OS peer identity.

It carries bytes and the OS identity of the peer, nothing else: what a payload encodes belongs to its protocol.
"""

from rust::std::fs import File, Permissions, set_permissions
from rust::std::io import ErrorKind, Read, Write
from rust::std::net import Shutdown
from rust::std::os::fd import AsRawFd
from rust::std::os::unix::fs import PermissionsExt
from rust::std::os::unix::net import UnixListener, UnixStream
from rust::std::cell import RefCell
from rust::std::rc import Rc
from rust::std::time import Duration

pub const MAX_FRAME: int = 16777216
const HEADER_DIGITS: int = 8
const OWNER_ONLY: u32 = 384
# The byte of the ASCII digit zero.
const DIGIT_ZERO: int = 48


pub model PeerIdentity:
    """Effective user and group reported by the OS for the connected Unix peer."""

    pub uid: u32
    pub gid: u32
    pub pid: Option[int]


pub class Connection:
    """One end of a Unix socket, speaking length-framed byte payloads."""

    # Shared and interior-mutable, because a foreign socket can be neither cloned nor copied.
    pub stream: Rc[RefCell[UnixStream]]

    def peer(self) -> Result[PeerIdentity, str]:
        """Read OS peer credentials; the standard wrapper uses getpeereid or SO_PEERCRED."""
        match self.stream.borrow().peer_cred():
            Err(error) => return Err(f"cannot identify socket peer: {error}")
            Ok(found) => return Ok(PeerIdentity(uid=found.uid, gid=found.gid, pid=found.pid.map((pid) => int(pid))))

    def close(self) -> Result[None, str]:
        """Close both directions of this socket without relying on the last shared wrapper being dropped."""
        return self.stream.borrow().shutdown(Shutdown.Both).map_err((error) => f"cannot close socket: {error}")

    def descriptor(self) -> int:
        """
        The OS descriptor number of this socket, valid while the connection is open. It lends the socket to native
        code that only observes it; ownership stays with this connection.
        """
        return int(self.stream.borrow().as_raw_fd())

    def read_part(mut self, count: int, bound: int) -> Result[bytes, str]:
        """Read exactly a bounded part, checking its length before allocating the receive buffer."""
        if count < 0 or count > bound:
            return Err("transport read exceeds its bound")
        mut payload = zeros(count)
        self.stream.borrow_mut().read_exact(payload).map_err((error) => f"cannot read frame: {error}")?
        return Ok(payload)

    def send(mut self, payload: bytes) -> Result[None, str]:
        """
        Write one frame.

        1. Refuse a payload over the bound.
        2. Write the eight-digit length header.
        3. Write the payload.
        """
        # 1. The bound is checked before anything is written.
        if len(payload) > MAX_FRAME:
            return Err(f"a frame of {len(payload)} bytes exceeds the {MAX_FRAME} allowed")
        # 2. The header states the payload's length.
        self.write_part(padded(len(payload)).encode("utf-8"), "the frame header")?
        # 3. The payload follows.
        return self.write_part(payload, "the frame")

    def write_part(mut self, part: bytes, what: str) -> Result[None, str]:
        """Write all of one part of a frame; a failure names the part."""
        match self.stream.borrow_mut().write_all(part):
            Ok(_) => return Ok(None)
            Err(error) => return Err(f"cannot write {what}: {error}")

    def receive(mut self) -> Result[bytes, str]:
        """
        Read one frame's payload. A header that is not a length, a length over the bound or a payload cut short
        refuses it.

        1. Read the eight-digit header and take the length it states.
        2. Read exactly that many payload bytes.
        """
        # 1. The length is validated before any buffer of that size exists.
        header = self.read_part(HEADER_DIGITS, HEADER_DIGITS)?
        size = length_of(header)?
        # 2. A payload cut short is an error, not a shorter frame.
        return self.read_part(size, MAX_FRAME)

    def wait_at_most(mut self, seconds: u64) -> None:
        """Bound each read by `seconds`; 0 removes the bound, which a long build needs."""
        mut limit: Option[Duration] = None
        if seconds != 0:
            limit = Some(Duration.from_secs(seconds))
        # A timeout the system refuses leaves the socket unbounded, which only delays a stuck peer's refusal.
        _ = self.stream.borrow_mut().set_read_timeout(limit)

    def write_at_most(mut self, seconds: u64) -> None:
        """Bound each write by `seconds`."""
        # A timeout the system refuses leaves the socket unbounded, which only delays a stuck peer's refusal.
        _ = self.stream.borrow_mut().set_write_timeout(Some(Duration.from_secs(seconds)))


pub def length_of(header: bytes) -> Result[int, str]:
    """
    The payload length a frame header states, within the bound.

    1. The header is exactly eight bytes.
    2. Each is an ASCII decimal digit, so nothing is signed.
    3. The length they spell does not exceed `MAX_FRAME`.
    """
    # 1. A length is exactly eight digits, nothing shorter.
    if len(header) != HEADER_DIGITS:
        return Err("the frame header is not eight digits")
    mut size = 0
    for index in range(HEADER_DIGITS):
        # 2. A byte that is not a decimal digit makes the header no length.
        digit = int(header[index]) - DIGIT_ZERO
        if digit < 0 or digit > 9:
            return Err("the frame header is not a length")
        size = size * 10 + digit
    # 3. The length they spell is within the bound, so no buffer of unbounded size is ever allocated.
    if size > MAX_FRAME:
        return Err(f"a frame of {size} bytes exceeds the {MAX_FRAME} allowed")
    return Ok(size)


pub def padded(size: int) -> str:
    """A length as the eight decimal digits of a frame header."""
    mut text = str(size)
    while len(text) < HEADER_DIGITS:
        text = "0" + text
    return text


def zeros(count: int) -> bytes:
    """A buffer of `count` bytes to read into."""
    if count == 0:
        return "".encode("utf-8")
    mut text = "0"
    while len(text) < count:
        text = text + text
    return text[0:count].encode("utf-8")


def connection(stream: UnixStream) -> Connection:
    """Speak frames over `stream`."""
    return Connection(stream=Rc.new(RefCell.new(stream)))


pub class Listener:
    """A listening Unix socket."""

    pub socket: Rc[RefCell[UnixListener]]

    def accept(mut self) -> Result[Connection, str]:
        """Take the next client."""
        match self.socket.borrow_mut().accept():
            Ok(accepted) =>
                stream, peer = accepted
                return Ok(connection(stream))
            Err(error) => return Err(f"cannot accept: {error}")

    def poll(mut self) -> Result[Option[Connection], str]:
        """
        The next client if one is waiting, without waiting for one; the listener must be non-blocking. The client's
        connection blocks, with the bounds its caller sets, as an accepted one does: some systems, macOS among them,
        hand it the listener's non-blocking mode, so a frame still on its way would read as an error.
        """
        match self.socket.borrow_mut().accept():
            Ok(accepted) =>
                stream, peer = accepted
                match stream.set_nonblocking(false):
                    Ok(_) => return Ok(Some(connection(stream)))
                    Err(error) => return Err(f"cannot accept: {error}")
            Err(error) =>
                if error.kind() == ErrorKind.WouldBlock:
                    return Ok(None)
                return Err(f"cannot accept: {error}")

    def stop_blocking(mut self, path: str) -> Result[None, str]:
        """Make `accept` return at once when no client waits, which `poll` relies on."""
        match self.socket.borrow_mut().set_nonblocking(true):
            Ok(_) => return Ok(None)
            Err(error) => return Err(f"cannot poll {path}: {error}")


pub def listen(path: str, blocking: bool) -> Result[Listener, str]:
    """
    Listen at a socket path, readable and writable by its owner alone.

    1. Bind the socket.
    2. Restrict the socket file to its owner.
    3. Unless the caller blocks in `accept`, make the listener non-blocking so `poll` can ask without waiting.
    """
    # 1. A socket listens at `path`, or the error says why it cannot.
    socket = bind(path)?
    mut listener = Listener(socket=Rc.new(RefCell.new(socket)))
    # 2. No other user can connect to the listener or read what it is sent.
    match set_permissions(path, Permissions.from_mode(OWNER_ONLY)):
        Ok(_) => pass
        Err(error) => return Err(f"cannot restrict {path}: {error}")
    # 3. A polled listener returns at once when no client waits.
    if not blocking:
        listener.stop_blocking(path)?
    return Ok(listener)


def bind(path: str) -> Result[UnixListener, str]:
    """A socket listening at `path`."""
    match UnixListener.bind(path):
        Ok(socket) => return Ok(socket)
        Err(error) => return Err(f"cannot listen at {path}: {error}")


pub def dial(path: str) -> Result[Connection, str]:
    """Connect to a socket path; the error says why the connection failed."""
    match UnixStream.connect(path):
        Ok(stream) => return Ok(connection(stream))
        Err(error) => return Err(f"cannot connect to {path}: {error}")


pub def dial_live(path: str) -> Result[Option[Connection], str]:
    """
    Connect to a socket path. `None` when nothing is alive there, with no listener or no socket any more; any other
    failure, such as a listener that refuses this user, is an error.
    """
    match UnixStream.connect(path):
        Ok(stream) => return Ok(Some(connection(stream)))
        Err(error) =>
            if error.kind() == ErrorKind.ConnectionRefused or error.kind() == ErrorKind.NotFound:
                return Ok(None)
            return Err(f"cannot connect to {path}: {error}")


pub def stale(path: str) -> bool:
    """Whether connecting to `path` found nothing alive there: no listener, or no socket any more."""
    match dial_live(path):
        Ok(found) => return found is None
        Err(_) => return false


pub def readable(connected: Connection) -> Result[bool, str]:
    """Ask the OS whether a byte or EOF is waiting, without consuming or retaining protocol data."""
    mut stream = connected.stream.borrow_mut()
    stream.set_nonblocking(true).map_err((error) => f"cannot poll socket: {error}")?
    mut byte: bytes = [0u8]
    observed = stream.peek(byte)
    stream.set_nonblocking(false).map_err((error) => f"cannot restore socket mode: {error}")?
    match observed:
        Ok(_) => return Ok(true)
        Err(error) =>
            if error.kind() == ErrorKind.WouldBlock:
                return Ok(false)
            return Err(f"cannot poll socket: {error}")


pub def session_id() -> Result[bytes, str]:
    """Obtain a fresh 128-bit connection identity from the OS entropy source, never from a clock or PID."""
    mut source = File.open("/dev/urandom").map_err((error) => f"cannot open OS entropy source: {error}")?
    mut result: bytes = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    source.read_exact(result).map_err((error) => f"cannot read OS entropy: {error}")?
    return Ok(result)


pub class Credits:
    """
    The data frames one direction of a connection may have outstanding, each named by its sequence.

    A sender spends a credit on each data frame and regains it only when the peer acknowledges that exact frame; a
    receiver spends one on each data frame it admits and returns it once the frame is consumed. A frame that holds no
    credit returns none, so a forged or repeated acknowledgment never adds one.
    """

    pub limit: int
    # The outstanding sequences, as decimal text.
    outstanding: list[str] = []

    def held(self) -> int:
        """How many credits are spent."""
        return len(self.outstanding)

    def exhausted(self) -> bool:
        """Whether every credit is spent, so the next data frame must wait."""
        return len(self.outstanding) >= self.limit

    def holds(self, sequence: u64) -> bool:
        """Whether the frame `sequence` holds a credit."""
        return str(sequence) in self.outstanding

    def spend(mut self, sequence: u64) -> Result[None, str]:
        """Spend a credit on the frame `sequence`; with none left, or one already spent on it, it is refused."""
        if self.exhausted():
            return Err("no data credit is left")
        if self.holds(sequence):
            return Err("the frame already holds a credit")
        self.outstanding.append(str(sequence))
        return Ok(None)

    def regain(mut self, sequence: u64) -> Result[None, str]:
        """Return the credit the frame `sequence` holds; a frame that holds none is refused."""
        if not self.holds(sequence):
            return Err("no outstanding frame has that sequence")
        self.outstanding = [item for item in self.outstanding if item != str(sequence)]
        return Ok(None)
