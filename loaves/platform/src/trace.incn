"""Bounded engine observations over a separate append-only channel, with process-monotonic span clocks."""

from rust::std::env import var_os
from rust::std::fs import OpenOptions
from rust::std::io import Write
from rust::std::process import id
from rust::std::thread import current
from rust::std::time import Instant

pub const SCHEMA: str = "incan.engine.trace/1"
pub const MAX_TEXT: int = 4096
pub const MAX_RECORD: int = 65536


pub enum TraceError:
    """A trace is incomplete when a field, record or output channel is refused."""

    FieldBound
    RecordBound
    InvalidSpan
    Channel


pub model Clock:
    """An enabled operation's identity and start on this process's monotonic origin."""

    pub span: int
    pub start_ns: int


model Origin:
    """One clock origin and sequence, protected by the language's static guard."""

    clock: Option[Instant] = None
    sequence: int = 0

    def begin(mut self) -> Clock:
        """Allocate a span identity only for an enabled observer."""
        self.sequence += 1
        return Clock(span=self.sequence, start_ns=self.now())

    def now(mut self) -> int:
        """Nanoseconds since the first enabled observation; wall time never enters durations."""
        match self.clock:
            Some(origin) => return int(origin.elapsed().as_nanos())
            None =>
                self.clock = Some(Instant.now())
                return 0


static ORIGIN: Origin = Origin()


pub model Counters:
    """Aggregated work inside one span; scalar reads increment these rather than emitting events."""

    pub bytes: int = 0
    pub records: int = 0
    pub calls: int = 0


pub model EngineSpan:
    """A completed operation; ids and redacted locators carry correlation, never source or environment values."""

    pub run: str
    pub request: str
    pub work: str
    pub span: int
    pub parent: int
    pub producer: str
    pub operation: str
    pub key: str
    pub snapshot: str
    pub start_ns: int
    pub end_ns: int
    pub process: int
    pub thread: str
    pub outcome: str
    pub counters: Counters = Counters()
    # An unavailable CPU clock is null on the wire, never an invented zero.
    pub cpu_ns: Option[int] = None


pub def enabled(variable: str) -> bool:
    """Whether a switch names a nonempty destination; absence creates no clock, event, buffer or sink."""
    match var_os(variable):
        Some(value) => return not value.is_empty()
        None => return false


pub def begin(observing: bool) -> Option[Clock]:
    """Start only an enabled operation; the disabled branch does not touch the clock or static state."""
    if not observing:
        return None
    return Some(ORIGIN.begin())


pub def complete(
    clock: Clock,
    producer: str,
    operation: str,
    key: str,
    counters: Counters = Counters(),
    run: str = "",
    request: str = "",
    work: str = "",
    parent: int = 0,
    snapshot: str = "",
    outcome: str = "done",
) -> EngineSpan:
    """Complete a caller-correlated operation on the same monotonic origin as its start."""
    return EngineSpan(
        run=run,
        request=request,
        work=work,
        span=clock.span,
        parent=parent,
        producer=producer,
        operation=operation,
        key=key,
        snapshot=snapshot,
        start_ns=clock.start_ns,
        end_ns=ORIGIN.now(),
        process=int(id()),
        thread=f"{current().id():?}",
        outcome=outcome,
        counters=counters,
    )


pub def encode(span: EngineSpan) -> Result[str, TraceError]:
    """
    Encode one versioned JSONL record, bounded before output.

    1. Validate numeric invariants.
    2. Bound and escape each text field.
    3. Bound the complete record.
    """
    # 1. Durations and aggregate counters cannot be negative.
    if span.span <= 0 or span.parent < 0 or span.process < 0 or span.start_ns < 0 or span.end_ns < span.start_ns:
        return Err(TraceError.InvalidSpan)
    if span.counters.bytes < 0 or span.counters.records < 0 or span.counters.calls < 0:
        return Err(TraceError.InvalidSpan)
    # 2. Field bounds are checked before escaping, whose worst-case expansion is six bytes per input byte.
    mut fields = [
        field("schema", SCHEMA)?,
        field("kind", "span")?,
        field("run", span.run)?,
        field("request", span.request)?,
        field("work", span.work)?,
        field("producer", span.producer)?,
        field("operation", span.operation)?,
        field("key", span.key)?,
        field("snapshot", span.snapshot)?,
        field("thread", span.thread)?,
        field("outcome", span.outcome)?,
        field("clock", "process-monotonic")?,
    ]
    fields.extend(
        [
            f"\"span\":{span.span}",
            f"\"parent\":{span.parent}",
            f"\"process\":{span.process}",
            f"\"start_ns\":{span.start_ns}",
            f"\"end_ns\":{span.end_ns}",
            f"\"bytes\":{span.counters.bytes}",
            f"\"records\":{span.counters.records}",
            f"\"calls\":{span.counters.calls}",
            cpu_field(span.cpu_ns)?,
        ],
    )
    # 3. A synchronous write is the bounded producer buffer and supplies back-pressure without dropping events.
    text = "{" + ",".join(fields) + "}\n"
    if len(text) > MAX_RECORD:
        return Err(TraceError.RecordBound)
    if len(text.encode("utf-8")) > MAX_RECORD:
        return Err(TraceError.RecordBound)
    return Ok(text)


pub def record(destination: str, span: EngineSpan) -> Result[None, TraceError]:
    """Append one complete schema record to a file; no schema output can select a console stream."""
    if destination == "":
        return Ok(None)
    if destination == "-":
        return Err(TraceError.Channel)
    return append(destination, encode(span)?)


pub def append(destination: str, text: str) -> Result[None, TraceError]:
    """Write one bounded record with OS back-pressure; failures are explicit, with no console diagnostics."""
    if destination == "" or destination == "-":
        return Err(TraceError.Channel)
    if len(text) > MAX_RECORD:
        return Err(TraceError.RecordBound)
    if len(text.encode("utf-8")) > MAX_RECORD:
        return Err(TraceError.RecordBound)
    mut options = OpenOptions.new()
    options.create(true).append(true)
    mut output = options.open(destination).map_err((_) => TraceError.Channel)?
    output.write_all(text.encode("utf-8")).map_err((_) => TraceError.Channel)?
    return Ok(None)


def field(name: str, value: str) -> Result[str, TraceError]:
    """A JSON string field; reject unsupported control bytes rather than emitting invalid JSON."""
    if len(value) > MAX_TEXT:
        return Err(TraceError.FieldBound)
    if len(value.encode("utf-8")) > MAX_TEXT:
        return Err(TraceError.FieldBound)
    escaped = value
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    for byte in escaped.encode("utf-8"):
        if int(byte) < 32:
            return Err(TraceError.InvalidSpan)
    return Ok(f"\"{name}\":\"{escaped}\"")


def cpu_field(value: Option[int]) -> Result[str, TraceError]:
    """A measured CPU duration or explicit unavailability."""
    match value:
        None => return Ok("\"cpu_ns\":null")
        Some(nanoseconds) =>
            if nanoseconds < 0:
                return Err(TraceError.InvalidSpan)
            return Ok(f"\"cpu_ns\":{nanoseconds}")
