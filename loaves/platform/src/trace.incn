"""Bounded engine observations over a separate append-only channel, with shared raw host-clock spans."""

from rust::std::env import var_os
from rust::std::fs import File, OpenOptions
from rust::std::io import BufWriter, Cursor, Write
from rust::std::sync import Arc, Mutex
from rust::std::ops import DerefMut
from rust::serde_json import Error as JsonError, to_writer
from rust::std::vec import Vec
from rust::serde import Serialize as RustSerialize
from rust::std::string import String as RustString
from rust::std::process import id
from rust::std::thread import current
from rust::std::time import SystemTime, UNIX_EPOCH
from rust::incan_platform_clock import raw_uptime_ns

pub const SCHEMA: str = "incan.engine.trace/1"
pub const MAX_TEXT: int = 4096
pub const MAX_RECORD: int = 65536
pub const BUFFER_BYTES: usize = 65536
const MAX_CHANNELS: int = 8


pub enum TraceError:
    """A trace is incomplete when a field, record or output channel is refused."""

    # A text field exceeds MAX_TEXT UTF-8 bytes.
    FieldBound
    # The encoded observation exceeds MAX_RECORD UTF-8 bytes.
    RecordBound
    # A duration, counter or string cannot represent a valid schema value.
    InvalidSpan
    # The file destination is unavailable or selects a console stream.
    Channel


pub model Clock:
    """An enabled operation's identity and start on the shared raw host clock."""

    pub span: int
    pub start_ns: int
    pub origin: str


model Origin:
    """One process lifetime identity and span sequence, protected by the language's static guard."""

    sequence: int = 0
    identity: str = ""

    def begin(mut self) -> Option[Clock]:
        """Allocate a span only for an enabled observer with an available host clock."""
        started = self.now()
        if started < 0:
            return None
        self.sequence += 1
        return Some(Clock(span=self.sequence, start_ns=started, origin=self.identity))

    def now(mut self) -> int:
        """Read host nanoseconds; a failed or out-of-range clock refuses an observation."""
        match raw_uptime_ns():
            Err(_) => return -1
            Ok(value) =>
                match value.try_resize[int]():
                    None => return -1
                    Some(started) =>
                        if self.identity == "":
                            match SystemTime.now().duration_since(UNIX_EPOCH):
                                Ok(epoch) => self.identity = f"{id()}-{epoch.as_nanos()}"
                                Err(_) => self.identity = f"{id()}-{started}"
                        return started


static ORIGIN: Origin = Origin()


pub enum Operation:
    """Fixed operation keys checked at call sites; dynamic locators remain bounded data."""

    FileRead
    JsonRead
    JsonDecode
    FileHash
    ManifestParse
    ArtifactIdentity
    FeatureResolution
    GraphResolution
    UnitDescription
    RegistryIndex
    RegistryCompletion
    WorkerReady
    WorkerConnect
    DriverRequest
    DriverSpawn
    OwnerRequest
    BakeryFind
    BakeryClaim
    BakerySeal
    BakeryView
    ProgramPrepare
    GraphExport
    EngineCapture
    StoreLock
    StoreFileSync
    StoreFileWrite
    StoreFileRename
    StoreDirectorySync
    StoreDurableSync
    EngineUnit
    EngineSelect
    EngineLease
    EngineEpoch
    EnginePrepare
    CliStart
    LegacyRequest
    LegacyPrepare
    EngineCaptureInputs
    EngineCaptureEncode
    EngineConnect
    EngineRequest
    EngineChild
    EngineAdmission
    RegistryPage
    ArchiveInventory
    ArchiveUnpack
    ToolchainAdmission
    CompilerFacts
    RegistryMetadata
    InstallationRuntime
    InstallationPayload
    InstallationDocument
    InstallationPageReuse
    InstallationPage
    FileStat
    Reason

    def key(self) -> str:
        """The stable schema spelling of this operation, with exhaustive compile-time coverage."""
        match self:
            Operation.FileRead => return "file_read"
            Operation.JsonRead => return "json_read"
            Operation.JsonDecode => return "json_decode"
            Operation.FileHash => return "file_hash"
            Operation.ManifestParse => return "manifest_parse"
            Operation.ArtifactIdentity => return "artifact_identity"
            Operation.FeatureResolution => return "feature_resolution"
            Operation.GraphResolution => return "graph_resolution"
            Operation.UnitDescription => return "unit_description"
            Operation.RegistryIndex => return "registry_index"
            Operation.RegistryCompletion => return "registry_completion"
            Operation.WorkerReady => return "worker_ready"
            Operation.WorkerConnect => return "worker_connect"
            Operation.DriverRequest => return "driver_request"
            Operation.DriverSpawn => return "driver_spawn"
            Operation.OwnerRequest => return "owner_request"
            Operation.BakeryFind => return "bakery_find"
            Operation.BakeryClaim => return "bakery_claim"
            Operation.BakerySeal => return "bakery_seal"
            Operation.BakeryView => return "bakery_view"
            Operation.ProgramPrepare => return "program_prepare"
            Operation.GraphExport => return "graph_export"
            Operation.EngineCapture => return "engine_capture"
            Operation.StoreLock => return "store_lock"
            Operation.StoreFileSync => return "store_file_sync"
            Operation.StoreFileWrite => return "store_file_write"
            Operation.StoreFileRename => return "store_file_rename"
            Operation.StoreDirectorySync => return "store_directory_sync"
            Operation.StoreDurableSync => return "store_durable_sync"
            Operation.EngineUnit => return "engine_unit"
            Operation.EngineSelect => return "engine_select"
            Operation.EngineLease => return "engine_lease"
            Operation.EngineEpoch => return "engine_epoch"
            Operation.EnginePrepare => return "engine_prepare"
            Operation.CliStart => return "cli_start"
            Operation.LegacyRequest => return "legacy_request"
            Operation.LegacyPrepare => return "legacy_prepare"
            Operation.EngineCaptureInputs => return "engine_capture_inputs"
            Operation.EngineCaptureEncode => return "engine_capture_encode"
            Operation.EngineConnect => return "engine_connect"
            Operation.EngineRequest => return "engine_request"
            Operation.EngineChild => return "engine_child"
            Operation.EngineAdmission => return "engine_admission"
            Operation.RegistryPage => return "registry_page"
            Operation.ArchiveInventory => return "archive_inventory"
            Operation.ArchiveUnpack => return "archive_unpack"
            Operation.ToolchainAdmission => return "toolchain_admission"
            Operation.CompilerFacts => return "compiler_facts"
            Operation.RegistryMetadata => return "registry_metadata"
