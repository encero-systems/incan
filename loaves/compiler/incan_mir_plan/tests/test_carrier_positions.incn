"""A carrier keeps its lowering position when source enums are appended, and publication folds it into the plan."""

from _plan import EnumDeclaration, EnumVariant, Function, Plan, Carrier
from _types import PlanType, source_span
from _body import Local, BasicBlock, Terminator, TerminatorKind
from carrier_positions import fold_carrier_positions
from nominal_identities import (
    NominalKind,
    ProductNominal,
    carrier_index,
    describe_nominals,
    resolve_nominals,
    unit_nominals,
    NominalReference,
)


def nominal(identity: str) -> ProductNominal:
    """A described enum or carrier declaration."""
    return ProductNominal(kind=NominalKind.Enum, identity=identity, digest=f"{identity}-digest")


pub def test_an_appended_source_enum_moves_no_carrier() -> Result[None, str]:
    """
    A unit whose second lowering attempt holds one more source enum names its carrier at the same position.

    1. With one source enum, the admitted carrier is at its carrier position.
    2. With a second source enum, as a module resolved later adds, the carrier stays there and resolves there.
    """
    carrier = nominal("carrier#Option[int]")
    models: list[ProductNominal] = []
    model_names: list[str] = []
    mut before = unit_nominals(models, [nominal("enum#Tone")], model_names, ["Tone"])
    before.append_carrier(carrier, "__IncanCarrier0")
    mut after = unit_nominals(list(models), [nominal("enum#Tone"), nominal("enum#Pace")], list(model_names), ["Tone", "Pace"])
    after.append_carrier(carrier, "__IncanCarrier0")
    match resolve_nominals([carrier], before):
        None => assert false, "the carrier was not described"
        Some(references) =>
            assert references[0].index == carrier_index(0), f"carrier at {references[0].index}"
    match resolve_nominals([carrier], after):
        None => assert false, "an appended source enum made the carrier a miss"
        Some(references) =>
            assert references[0].index == carrier_index(0), "an appended source enum moved the carrier"
    named = describe_nominals([NominalReference(kind=NominalKind.Enum, index=carrier_index(0), name="__IncanCarrier0")], after)?
    assert named == [carrier]
    return Ok(None)


pub def test_publication_folds_each_carrier_after_the_source_enums() -> Result[None, str]:
    """A frame naming a carrier by its lowering position names its plan position after the publication fold."""
    span = source_span(file="carrier_positions.incn", line=1, column=1)
    carrier = carrier_index(0)
    function = Function(
        name="main",
        parameters=[],
        return_type=PlanType.Enum(carrier, "__IncanCarrier0"),
        locals=[Local(ty=PlanType.Enum(carrier, "__IncanCarrier0"), span=span), Local(ty=PlanType.Enum(0, "Tone"), span=span)],
        blocks=[
            BasicBlock(statements=[], terminator=Terminator(kind=TerminatorKind.Return, span=span), cleanup=false, span=span),
        ],
        span=span,
    )
    tone = EnumDeclaration(name="Tone", public=false, variants=[EnumVariant(name="Low", fields=[])], derives=[], span=span)
    option = EnumDeclaration(
        name="__IncanCarrier0",
        public=false,
        variants=[EnumVariant(name="None", fields=[]), EnumVariant(name="Some", fields=[PlanType.Enum(0, "Tone")])],
        derives=["Clone"],
        span=span,
        carrier=Carrier.Option,
    )
    plan = Plan(enums=[tone, option], models=[], functions=[function], externals=[], span=span)
    folded = fold_carrier_positions(plan, 1)?
    assert folded.functions[0].return_type == PlanType.Enum(1, "__IncanCarrier0")
    assert folded.functions[0].locals[0].ty == PlanType.Enum(1, "__IncanCarrier0")
    assert folded.functions[0].locals[1].ty == PlanType.Enum(0, "Tone"), "a source enum position must be kept"
    assert folded.enums[1].variants[1].fields == [PlanType.Enum(0, "Tone")]
    # Folding a published plan again changes nothing.
    assert fold_carrier_positions(folded, 1)? == folded
    return Ok(None)
