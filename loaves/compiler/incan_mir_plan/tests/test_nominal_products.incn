"""Keyed plan products name models and enums by declaration identity, never by a position in the unit's tables."""

from _plan import Function, ExternalFunction
from _types import PlanType, ListLeaf, SourceSpan, source_span
from _body import Local, BasicBlock, Terminator, TerminatorKind, Parameter
from function_records import encode_product, decode_product, product_identities, product_nominals
from nominal_identities import (
    NominalKind,
    NominalReference,
    ProductNominal,
    UnitNominals,
    describe_nominals,
    resolve_nominals,
    unit_nominals,
)


pub def test_product_survives_an_unrelated_declaration() -> Result[None, str]:
    """
    A product captured with `Point` at model 0 binds to model 1 after an unrelated model is declared before it.

    The unrelated declaration also moves `Point`'s source position, which its native carrier name encodes; the
    product retains neither, so the restored function takes the name `Point` now has.
    """
    span = source_span(file="nominal_products.incn", line=3, column=1)
    before = unit_nominals([point("v1")], [shape("v1")], ["Point_0_37"], ["Shape_39_75"])
    captured, captured_runtime = point_function(0, 0, "Point_0_37", "Shape_39_75", span)
    product = keyed_product(captured, captured_runtime, before)?
    assert product_identities(product)? == [point("v1"), shape("v1")]
    assert "Point_0_37" not in product, "the product retained a position-dependent native name"
    # The unrelated declarations shift both named declarations' positions; the product bytes do not depend on them.
    after = unit_nominals(
        [line_model(), point("v1")], [color(), shape("v1")], ["Line_0_20", "Point_22_59"], ["Color_61_90", "Shape_92_128"],
    )
    moved, moved_runtime = point_function(1, 1, "Point_22_59", "Shape_92_128", span)
    assert keyed_product(moved, moved_runtime, after)? == product
    match resolve_nominals(product_identities(product)?, after):
        None => assert false, "an unrelated declaration made a reused product miss"
        Some(references) =>
            assert references == [model_at(1, "Point_22_59"), enum_at(1, "Shape_92_128")]
            restored, restored_runtime = decode_product(product, references)?
            assert restored == moved, "the reused product kept its producing unit's positions or names"
            assert restored_runtime == moved_runtime
    return Ok(None)


pub def test_changed_declaration_makes_the_product_a_miss() -> Result[None, str]:
    """Changing or removing a declaration the product names refuses its reuse; an unnamed one does not."""
    span = source_span(file="nominal_products.incn", line=3, column=1)
    before = unit_nominals([point("v1")], [shape("v1")], ["Point"], ["Shape"])
    captured, captured_runtime = point_function(0, 0, "Point", "Shape", span)
    identities = product_identities(keyed_product(captured, captured_runtime, before)?)?
    changed = unit_nominals([line_model(), point("v2")], [shape("v1")], ["Line", "Point"], ["Shape"])
    assert resolve_nominals(identities, changed) == None, "a changed model declaration was reused"
    changed_enum = unit_nominals([point("v1")], [shape("v2")], ["Point"], ["Shape"])
    assert resolve_nominals(identities, changed_enum) == None, "a changed enum declaration was reused"
    removed = unit_nominals([line_model()], [shape("v1")], ["Line"], ["Shape"])
    assert resolve_nominals(identities, removed) == None, "a removed declaration was reused"
    unrelated = unit_nominals([point("v1"), line_model()], [shape("v1"), color()], ["Point", "Line"], ["Shape", "Color"])
    assert resolve_nominals(identities, unrelated) == Some([model_at(0, "Point"), enum_at(0, "Shape")])
    return Ok(None)


pub def test_product_refuses_a_nominal_without_an_identity() -> Result[None, str]:
    """A product cannot retain a model position the caller did not name by declaration identity."""
    span = source_span(file="nominal_products.incn", line=3, column=1)
    captured, captured_runtime = point_function(0, 0, "Point", "Shape", span)
    match encode_product(captured, captured_runtime, [point("v1")]):
        Ok(_) => assert false, "a product retained an enum position without its declaration identity"
        Err(message) => assert "without a declaration identity" in message, message
    return Ok(None)


def keyed_product(function: Function, runtime: list[ExternalFunction], unit: &UnitNominals) -> Result[str, str]:
    """Capture a product the way lowering does: name every referenced position, then encode."""
    references = product_nominals(function, runtime)?
    return encode_product(function, runtime, describe_nominals(references, unit)?)


def point_function(
    model_position: int,
    enum_position: int,
    point_name: str,
    shape_name: str,
    span: SourceSpan,
) -> tuple[Function, list[ExternalFunction]]:
    """A function over `Point` and `Shape` at the given positions, with a runtime signature that also names `Point`."""
    point_type = PlanType.Model(model_position, point_name)
    shape_type = PlanType.Enum(enum_position, shape_name)
    function = Function(
        name="describe",
        parameters=[Parameter(name="point", ty=point_type, span=span), Parameter(name="shape", ty=shape_type, span=span)],
        return_type=PlanType.Unit,
        locals=[
            Local(ty=PlanType.Unit, span=span),
            Local(ty=point_type, span=span),
            Local(ty=shape_type, span=span),
            Local(ty=PlanType.List(ListLeaf.Model(model_position, point_name), 1), span=span),
        ],
        blocks=[
            BasicBlock(
                statements=[], terminator=Terminator(kind=TerminatorKind.Return, span=span), cleanup=false, span=span,
            ),
        ],
        span=span,
    )
    runtime = [
        ExternalFunction(
            path="incan_std_primitives::inspect",
            parameters=[PlanType.ModelRef(model_position, point_name)],
            return_type=PlanType.String,
            span=span,
        ),
    ]
    return (function, runtime)


def point(version: str) -> ProductNominal:
    """The `Point` model declaration at one checked meaning."""
    return ProductNominal(kind=NominalKind.Model, identity="model:app::Point", digest=f"point-{version}")


def shape(version: str) -> ProductNominal:
    """The `Shape` enum declaration at one checked meaning."""
    return ProductNominal(kind=NominalKind.Enum, identity="enum:app::Shape", digest=f"shape-{version}")


def line_model() -> ProductNominal:
    """An unrelated model declaration."""
    return ProductNominal(kind=NominalKind.Model, identity="model:app::Line", digest="line-v1")


def color() -> ProductNominal:
    """An unrelated enum declaration."""
    return ProductNominal(kind=NominalKind.Enum, identity="enum:app::Color", digest="color-v1")


def model_at(index: int, name: str) -> NominalReference:
    """The current unit's model at one position."""
    return NominalReference(kind=NominalKind.Model, index=index, name=name)


def enum_at(index: int, name: str) -> NominalReference:
    """The current unit's enum at one position."""
    return NominalReference(kind=NominalKind.Enum, index=index, name=name)
