"""Scalar plan products retain the exact linked callable in both the external table and call terminators."""

from rust::incan_semantics_core import (
    CanonicalSymbolId,
    HirSourceSpan,
    SemanticSourceTargetKind,
    SymbolNamespace,
    SymbolOrigin,
    encode_incan_symbol_identity,
)
from _plan import ExternalFunction, Function
from _types import PlanType, source_span
from _body import BasicBlock, Callee, CalleeKind, Local, Place, Projection, Terminator, TerminatorKind, Unwind
from function_records import decode_product, encode_product, product_nominals
from nominal_identities import ProductNominal


pub def test_product_keeps_a_rust_external() -> Result[None, str]:
    """Round-trip runtime, package function and method calls, and refuse uncertified external identities."""
    method = package_symbol(
        "incan_stdlib_system", ["fs", "path"], "read_text", SymbolNamespace.Member, SemanticSourceTargetKind.Method,
    )
    function = package_symbol(
        "incan_stdlib_data", ["json"], "parse_jsonl", SymbolNamespace.OrdinaryLexical, SemanticSourceTargetKind.Function,
    )
    read_text = "incan_stdlib_system::" + method
    span = source_span(file="lists.incn", line=44, column=1)
    instance = Function(
        name="append_list_3_105_110_116",
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=span)],
        blocks=[
            BasicBlock(
                statements=[],
                terminator=Terminator(
                    kind=TerminatorKind.Call(
                        Callee(kind=CalleeKind.External(read_text), span=span),
                        [],
                        Place(local=0, projection=Projection.Whole, span=span),
                        1,
                        Unwind.Continue,
                    ),
                    span=span,
                ),
                cleanup=false,
                span=span,
            ),
            BasicBlock(
                statements=[],
                terminator=Terminator(kind=TerminatorKind.Return, span=span),
                cleanup=false,
                span=span,
            ),
        ],
        span=span,
    )
    push = ExternalFunction(
        path="std::vec::Vec::push",
        type_arguments=[PlanType.Int],
        parameters=[PlanType.Int],
        return_type=PlanType.Unit,
        span=span,
    )
    mut runtime = [push]
    for path in [read_text, "incan_stdlib_data::" + function, "incan_std_data::json::__private::stringify_or_raise"]:
        mut external = push.clone()
        external.path = path
        runtime.append(external)
    no_nominals: list[ProductNominal] = []
    references = product_nominals(instance, runtime)?
    product = encode_product(instance, runtime, no_nominals)?
    restored, restored_runtime = decode_product(product, references)?
    assert restored == instance, "the instance did not survive its product"
    assert restored_runtime == runtime, "the Rust external did not survive its product"
    mut wrong_provider = push.clone()
    wrong_provider.path = "foreign::" + method
    assert encode_product(instance, [wrong_provider], no_nominals).is_err()
    wrong_provider.path = "foreign::__incan_v7_deadcafe"
    assert encode_product(instance, [wrong_provider], no_nominals).is_err()
    wrong_provider.path = "incan_std_data::unrelated_host_function"
    assert encode_product(instance, [wrong_provider], no_nominals).is_err()
    wrong_provider.path = "incan_stdlib_system::" + package_symbol(
        "incan_stdlib_system", ["fs", "path"], "Path", SymbolNamespace.OrdinaryLexical, SemanticSourceTargetKind.Model,
    )
    assert encode_product(instance, [wrong_provider], no_nominals).is_err()
    return Ok(None)


def package_symbol(
    package: str, module: list[str], name: str, namespace: SymbolNamespace, kind: SemanticSourceTargetKind,
) -> str:
    """Emit the native compiler identity used for an exported declaration in this fixture."""
    return str(encode_incan_symbol_identity(CanonicalSymbolId(
        namespace=namespace,
        kind=kind,
        origin=SymbolOrigin.Package(library=package, module_path=module),
        declaration_name=name,
        scope_discriminant=None,
        declaration_span=HirSourceSpan.new(3, 8),
    )))
