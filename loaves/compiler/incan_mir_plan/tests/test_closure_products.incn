"""A keyed product carries the closure frames its function's lowering lifted, and the calls into them."""

from _plan import Function, ExternalFunction
from _types import PlanType, SourceSpan, source_span
from _body import (
    BasicBlock,
    Callee,
    CalleeKind,
    Constant,
    Local,
    Operand,
    OperandKind,
    Place,
    Projection,
    Rvalue,
    RvalueKind,
    Statement,
    StatementKind,
    Terminator,
    TerminatorKind,
    Unwind,
)
from function_records import decode_frames, decode_product, encode_product, product_frame_names, product_nominals
from nominal_identities import ProductNominal


pub def test_product_carries_lifted_closure_frames() -> Result[None, str]:
    """A caller, its lifted closure frame and the closure-object calls between them round-trip as one product."""
    span = source_span(file="closures.incn", line=3, column=1)
    signature = [PlanType.Int, PlanType.Int]
    closure_type = PlanType.Closure(signature)
    item_span = source_span(file="closures.incn", line=5, column=9)
    item = Callee(kind=CalleeKind.Planned("__incan_closure_apply_0"), span=item_span)
    caller = Function(
        name="apply",
        parameters=[],
        return_type=PlanType.Int,
        locals=[
            Local(ty=PlanType.Int, span=span),
            Local(ty=closure_type, span=span),
            Local(ty=PlanType.ClosureRef(signature), span=span),
            Local(ty=PlanType.Int, span=span),
            Local(ty=PlanType.FunctionItem("__incan_closure_apply_0", signature), span=span),
        ],
        blocks=[
            block(
                [assign(4, RvalueKind.FunctionItem(item), span), assign(2, RvalueKind.ClosureObject(place(1, span)), span)],
                call(CalleeKind.CallClosure(signature), [copy(2, span), literal(20, span)], 3, 1, span),
                span,
            ),
            block(
                [],
                call(CalleeKind.ClosureBody("__incan_closure_apply_0", 0), [literal(1, span)], 0, 2, span),
                span,
            ),
            block([], Terminator(kind=TerminatorKind.Return, span=span), span),
        ],
        span=span,
    )
    frame = Function(
        name="__incan_closure_apply_0",
        parameters=[],
        return_type=PlanType.Int,
        locals=[Local(ty=PlanType.Int, span=span)],
        blocks=[block([], Terminator(kind=TerminatorKind.Return, span=span), span)],
        span=span,
    )
    empty_runtime: list[ExternalFunction] = []
    no_nominals: list[ProductNominal] = []
    references = product_nominals(caller, empty_runtime, [frame])?
    assert len(references) == 0
    product = encode_product(caller, empty_runtime, no_nominals, [frame])?
    assert product_frame_names(product)? == ["__incan_closure_apply_0"]
    restored, _runtime = decode_product(product, references)?
    assert restored == caller, "the caller's closure calls did not survive its product"
    frames = decode_frames(product, references)?
    assert len(frames) == 1 and frames[0] == frame, "the lifted closure frame did not survive its product"
    return Ok(None)


def block(statements: list[Statement], exit: Terminator, span: SourceSpan) -> BasicBlock:
    """One ordinary block."""
    return BasicBlock(statements=statements, terminator=exit, cleanup=false, span=span)


def call(callee: CalleeKind, arguments: list[Operand], destination: int, target: int, span: SourceSpan) -> Terminator:
    """A call that continues to `target`."""
    return Terminator(
        kind=TerminatorKind.Call(Callee(kind=callee, span=span), arguments, place(destination, span), target, Unwind.Continue),
        span=span,
    )


def assign(local: int, value: RvalueKind, span: SourceSpan) -> Statement:
    """Assign one operation to a whole local."""
    return Statement(kind=StatementKind.Assign(place(local, span), Rvalue(kind=value, span=span)), span=span)


def place(local: int, span: SourceSpan) -> Place:
    """A whole local."""
    return Place(local=local, projection=Projection.Whole, span=span)


def copy(local: int, span: SourceSpan) -> Operand:
    """Copy a whole local."""
    return Operand(kind=OperandKind.Copy(place(local, span)), span=span)


def literal(value: int, span: SourceSpan) -> Operand:
    """One integer literal."""
    return Operand(kind=OperandKind.Literal(Constant.Int(value)), span=span)
