pub def encode_models(values: &list[ModelDeclaration]) -> Result[list[bytes], str]:
    """Encode complete models inventories in their native order."""
    mut encoded: list[bytes] = []
    for value in values:
        encoded.append(write_wire(b"\x9c\xff\xb7\x00\xc4\x1f\x00", stored_layout_model_declaration_descriptions(), wire_stored_layout_model_declaration(retain_model_declaration(value)?))?)
    return Ok(encoded)


pub def decode_models(values: list[bytes]) -> Result[list[ModelDeclaration], str]:
    """Restore complete models inventories without checking or lowering source."""
    mut decoded: list[ModelDeclaration] = []
    for value in values:
        decoded.append(restore_model_declaration(read_model_declaration(value).map_err((error) => str(error))?)?)
    return Ok(decoded)


def read_model_declaration(value: bytes) -> Result[StoredLayoutModelDeclaration, str]:
    """Bind serde's decoder to this versioned layout value."""
    return read_wire_stored_layout_model_declaration(read_wire(value, b"\x9c\xff\xb7\x00\xc4\x1f\x00", stored_layout_model_declaration_descriptions())?, WirePositions())


pub def encode_enums(values: &list[EnumDeclaration]) -> Result[list[bytes], str]:
    """Encode complete enums inventories in their native order."""
    mut encoded: list[bytes] = []
    for value in values:
        encoded.append(write_wire(b"\x22x[\xf6\xa0\xa6\x00", stored_layout_enum_declaration_descriptions(), wire_stored_layout_enum_declaration(retain_enum_declaration(value)?))?)
    return Ok(encoded)


pub def decode_enums(values: list[bytes]) -> Result[list[EnumDeclaration], str]:
    """Restore complete enums inventories without checking or lowering source."""
    mut decoded: list[EnumDeclaration] = []
    for value in values:
        decoded.append(restore_enum_declaration(read_enum_declaration(value).map_err((error) => str(error))?)?)
    return Ok(decoded)


def read_enum_declaration(value: bytes) -> Result[StoredLayoutEnumDeclaration, str]:
    """Bind serde's decoder to this versioned layout value."""
    return read_wire_stored_layout_enum_declaration(read_wire(value, b"\x22x[\xf6\xa0\xa6\x00", stored_layout_enum_declaration_descriptions())?, WirePositions())


pub def encode_zip_carriers(values: &list[ZipCarrier]) -> Result[list[bytes], str]:
    """Encode complete zip_carriers inventories in their native order."""
    mut encoded: list[bytes] = []
    for value in values:
        encoded.append(write_wire(b">i\xa6U\x16 \x00", stored_layout_zip_carrier_descriptions(), wire_stored_layout_zip_carrier(retain_zip_carrier(value)?))?)
    return Ok(encoded)


pub def decode_zip_carriers(values: list[bytes]) -> Result[list[ZipCarrier], str]:
    """Restore complete zip_carriers inventories without checking or lowering source."""
    mut decoded: list[ZipCarrier] = []
    for value in values:
        decoded.append(restore_zip_carrier(read_zip_carrier(value).map_err((error) => str(error))?)?)
    return Ok(decoded)


def read_zip_carrier(value: bytes) -> Result[StoredLayoutZipCarrier, str]:
    """Bind serde's decoder to this versioned layout value."""
    return read_wire_stored_layout_zip_carrier(read_wire(value, b">i\xa6U\x16 \x00", stored_layout_zip_carrier_descriptions())?, WirePositions())

# Generated native-plan wire projections.


def wire_stored_layout_enum_declaration(value: StoredLayoutEnumDeclaration) -> Value:
    return Value.Record([
        required_value(b"\x82\xa3S\x7f\xf0\xdb", Value.Text(value.name)),
        required_value(b"\xef\xa1\xf3u\xd7a", Value.Boolean(value.public)),
        required_value(b"\xda\xd5i\xe1\x01\xad", Value.List([wire_stored_layout_enum_variant(item0) for item0 in value.variants])),
        required_value(b"\xa8\x8f\xe6\xeca\x15", Value.List([Value.Text(item0) for item0 in value.derives])),
        required_value(b"7\xa0\x02Z\xa1\xf2", wire_stored_span(value.span)),
        required_value(b"a5&\xd6\xca\x1f", wire_integer(value.view_lifetime_count)),
        required_value(b"X\x03X~g\x91", wire_stored_layout_carrier(value.carrier)),
        required_value(b"\x18&\xb5\x1c\x02V", wire_optional_stored_layout_checked_type(value.semantic_key)),
        required_value(b"p6\x9c\xac\xa4\xd8", Value.Text(value.source_type)),
        required_value(b"\xef\x06\xc8!DT", Value.Boolean(value.member_debug)),
        required_value(b"\x8a\xac\xe8\x82\x8f\xe6", Value.Text(value.library_item)),
        required_value(b".\xeeG\xf93\xc4", Value.List([wire_stored_layout_plan_type(item0) for item0 in value.library_type_arguments])),
        required_value(b"\x1d\x91\xf5\x83}\xa5", Value.Text(value.raw_kind)),
        required_value(b"\x0fF&\xf8\xea\xb1", Value.List([Value.Text(item0) for item0 in value.raw_values])),
        required_value(b";\xbbc\xd8xg", Value.List([Value.Text(item0) for item0 in value.comparison_methods])),
        required_value(b"\xb5\x1b\x90e\x9ax", Value.List([Value.Text(item0) for item0 in value.closure_items])),
    ])


