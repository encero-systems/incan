"""Lossless native layout-carrier encoding; canonical source-trait tokens explicitly refuse this bounded profile."""

from rust::serde import Serialize, Deserialize
from _types import (
    TupleElement,
    ListLeaf,
    SizedNumeric,
    PlanType,
)
from _plan import (
    Carrier,
)
from pub::internal_models.checked_types import (
    CheckedNumericType,
    CheckedPrimitiveType,
    CheckedInputAccess,
    CheckedCallableParamKind,
    CheckedRuntimeBuiltin,
    CheckedCallableParam,
    CheckedType,
)

@derive(Serialize, Deserialize)
pub enum StoredLayoutTupleElement:
    """The complete serialized TupleElement facts admitted by this layout profile."""

    Int
    Float
    Numeric(StoredLayoutSizedNumeric)
    Bool
    Unit
    String
    List(StoredLayoutListLeaf, int)
    Dict(StoredLayoutListLeaf, StoredLayoutListLeaf)
    Set(StoredLayoutListLeaf)
    Model(int, str)
    Enum(int, str)
    Tuple(list[StoredLayoutTupleElement])
    FunctionPointer(list[StoredLayoutPlanType])
    Reference(bool, list[StoredLayoutPlanType])
    ModelRef(int, str)
    ModelMutRef(int, str)
    SliceRef(list[StoredLayoutPlanType])
    SliceMutRef(list[StoredLayoutPlanType])
    FrozenStr
    StaticText
    StaticBytes
    FrozenBytes
    FrozenCollection(str, list[StoredLayoutPlanType])


