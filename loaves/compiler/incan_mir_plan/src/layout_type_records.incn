pub def retain_tuple_element(value: TupleElement) -> Result[StoredLayoutTupleElement, str]:
    """Encode exact TupleElement alternatives without interpreting their meaning."""
    match value:
        TupleElement.Int => return Ok(StoredLayoutTupleElement.Int)
        TupleElement.Float => return Ok(StoredLayoutTupleElement.Float)
        TupleElement.Numeric(field0) => return Ok(StoredLayoutTupleElement.Numeric(retain_sized_numeric(field0)?))
        TupleElement.Bool => return Ok(StoredLayoutTupleElement.Bool)
        TupleElement.Unit => return Ok(StoredLayoutTupleElement.Unit)
        TupleElement.String => return Ok(StoredLayoutTupleElement.String)
        TupleElement.List(field0, field1) => return Ok(StoredLayoutTupleElement.List(retain_list_leaf(field0)?, field1))
        TupleElement.Dict(field0, field1) => return Ok(StoredLayoutTupleElement.Dict(retain_list_leaf(field0)?, retain_list_leaf(field1)?))
        TupleElement.Set(field0) => return Ok(StoredLayoutTupleElement.Set(retain_list_leaf(field0)?))
        TupleElement.Model(field0, field1) => return Ok(StoredLayoutTupleElement.Model(field0, field1))
        TupleElement.Enum(field0, field1) => return Ok(StoredLayoutTupleElement.Enum(field0, field1))
        TupleElement.Tuple(field0) => return Ok(StoredLayoutTupleElement.Tuple([retain_tuple_element(item0)? for item0 in field0]))
        TupleElement.FunctionPointer(field0) => return Ok(StoredLayoutTupleElement.FunctionPointer([retain_plan_type(item0)? for item0 in field0]))
        TupleElement.Reference(field0, field1) => return Ok(StoredLayoutTupleElement.Reference(field0, [retain_plan_type(item0)? for item0 in field1]))
        TupleElement.ModelRef(field0, field1) => return Ok(StoredLayoutTupleElement.ModelRef(field0, field1))
        TupleElement.ModelMutRef(field0, field1) => return Ok(StoredLayoutTupleElement.ModelMutRef(field0, field1))
        TupleElement.SliceRef(field0) => return Ok(StoredLayoutTupleElement.SliceRef([retain_plan_type(item0)? for item0 in field0]))
        TupleElement.SliceMutRef(field0) => return Ok(StoredLayoutTupleElement.SliceMutRef([retain_plan_type(item0)? for item0 in field0]))
        TupleElement.FrozenStr => return Ok(StoredLayoutTupleElement.FrozenStr)
        TupleElement.StaticText => return Ok(StoredLayoutTupleElement.StaticText)
        TupleElement.StaticBytes => return Ok(StoredLayoutTupleElement.StaticBytes)
        TupleElement.FrozenBytes => return Ok(StoredLayoutTupleElement.FrozenBytes)
        TupleElement.FrozenCollection(field0, field1) => return Ok(StoredLayoutTupleElement.FrozenCollection(field0, [retain_plan_type(item0)? for item0 in field1]))


pub def restore_tuple_element(value: StoredLayoutTupleElement) -> Result[TupleElement, str]:
    """Restore exact TupleElement alternatives without interpreting their meaning."""
    match value:
        StoredLayoutTupleElement.Int => return Ok(TupleElement.Int)
        StoredLayoutTupleElement.Float => return Ok(TupleElement.Float)
        StoredLayoutTupleElement.Numeric(field0) => return Ok(TupleElement.Numeric(restore_sized_numeric(field0)?))
        StoredLayoutTupleElement.Bool => return Ok(TupleElement.Bool)
        StoredLayoutTupleElement.Unit => return Ok(TupleElement.Unit)
        StoredLayoutTupleElement.String => return Ok(TupleElement.String)
        StoredLayoutTupleElement.List(field0, field1) => return Ok(TupleElement.List(restore_list_leaf(field0)?, field1))
        StoredLayoutTupleElement.Dict(field0, field1) => return Ok(TupleElement.Dict(restore_list_leaf(field0)?, restore_list_leaf(field1)?))
        StoredLayoutTupleElement.Set(field0) => return Ok(TupleElement.Set(restore_list_leaf(field0)?))
        StoredLayoutTupleElement.Model(field0, field1) => return Ok(TupleElement.Model(field0, field1))
        StoredLayoutTupleElement.Enum(field0, field1) => return Ok(TupleElement.Enum(field0, field1))
        StoredLayoutTupleElement.Tuple(field0) => return Ok(TupleElement.Tuple([restore_tuple_element(item0)? for item0 in field0]))
        StoredLayoutTupleElement.FunctionPointer(field0) => return Ok(TupleElement.FunctionPointer([restore_plan_type(item0)? for item0 in field0]))
        StoredLayoutTupleElement.Reference(field0, field1) => return Ok(TupleElement.Reference(field0, [restore_plan_type(item0)? for item0 in field1]))
        StoredLayoutTupleElement.ModelRef(field0, field1) => return Ok(TupleElement.ModelRef(field0, field1))
        StoredLayoutTupleElement.ModelMutRef(field0, field1) => return Ok(TupleElement.ModelMutRef(field0, field1))
        StoredLayoutTupleElement.SliceRef(field0) => return Ok(TupleElement.SliceRef([restore_plan_type(item0)? for item0 in field0]))
        StoredLayoutTupleElement.SliceMutRef(field0) => return Ok(TupleElement.SliceMutRef([restore_plan_type(item0)? for item0 in field0]))
        StoredLayoutTupleElement.FrozenStr => return Ok(TupleElement.FrozenStr)
        StoredLayoutTupleElement.StaticText => return Ok(TupleElement.StaticText)
        StoredLayoutTupleElement.StaticBytes => return Ok(TupleElement.StaticBytes)
        StoredLayoutTupleElement.FrozenBytes => return Ok(TupleElement.FrozenBytes)
        StoredLayoutTupleElement.FrozenCollection(field0, field1) => return Ok(TupleElement.FrozenCollection(field0, [restore_plan_type(item0)? for item0 in field1]))


