        CheckedType.Primitive(field0) => return Ok(StoredLayoutCheckedType.Primitive(retain_checked_primitive_type(field0)?))
        CheckedType.Named(field0) => return Ok(StoredLayoutCheckedType.Named(field0))
        CheckedType.Generic(field0, field1) => return Ok(StoredLayoutCheckedType.Generic(field0, [retain_checked_type(item0)? for item0 in field1]))
        CheckedType.Decimal(field0, field1) => return Ok(StoredLayoutCheckedType.Decimal(field0, field1))
        CheckedType.Function(field0, field1) => return Ok(StoredLayoutCheckedType.Function([retain_checked_callable_param(item0)? for item0 in field0], [retain_checked_type(item0)? for item0 in field1]))
        CheckedType.TypeToken(field0) => return Ok(StoredLayoutCheckedType.TypeToken([retain_checked_type(item0)? for item0 in field0]))
        CheckedType.Tuple(field0) => return Ok(StoredLayoutCheckedType.Tuple([retain_checked_type(item0)? for item0 in field0]))
        CheckedType.TypeVar(field0) => return Ok(StoredLayoutCheckedType.TypeVar(field0))
        CheckedType.SelfType => return Ok(StoredLayoutCheckedType.SelfType)
        CheckedType.Ref(field0) => return Ok(StoredLayoutCheckedType.Ref([retain_checked_type(item0)? for item0 in field0]))
        CheckedType.RefMut(field0) => return Ok(StoredLayoutCheckedType.RefMut([retain_checked_type(item0)? for item0 in field0]))
        CheckedType.RustInteropPath(field0) => return Ok(StoredLayoutCheckedType.RustInteropPath(field0))
        CheckedType.NativeBuiltin(field0) => return Ok(StoredLayoutCheckedType.NativeBuiltin(retain_checked_runtime_builtin(field0)?))
        CheckedType.Unsupported(field0) => return Ok(StoredLayoutCheckedType.Unsupported(field0))
        CheckedType.Infer => return Ok(StoredLayoutCheckedType.Infer)
        CheckedType.Unknown => return Ok(StoredLayoutCheckedType.Unknown)
        CheckedType.NativeArray(field0, field1) => return Ok(StoredLayoutCheckedType.NativeArray([retain_checked_type(item0)? for item0 in field0], field1))
        CheckedType.NativeTraitObject(field0, field1, field2) => return Ok(StoredLayoutCheckedType.NativeTraitObject(field0, field1, field2))
        CheckedType.NativePointer(field0, field1) => return Ok(StoredLayoutCheckedType.NativePointer(field0, [retain_checked_type(item0)? for item0 in field1]))
        CheckedType.NativeCChar => return Ok(StoredLayoutCheckedType.NativeCChar)
        _ => return Err("native-interface refuses an unsupported CheckedType alternative")


pub def restore_checked_type(value: StoredLayoutCheckedType) -> Result[CheckedType, str]:
    """Restore exact CheckedType alternatives without interpreting their meaning."""
    match value:
        StoredLayoutCheckedType.Never => return Ok(CheckedType.Never)
        StoredLayoutCheckedType.Primitive(field0) => return Ok(CheckedType.Primitive(restore_checked_primitive_type(field0)?))
        StoredLayoutCheckedType.Named(field0) => return Ok(CheckedType.Named(field0))
        StoredLayoutCheckedType.Generic(field0, field1) => return Ok(CheckedType.Generic(field0, [restore_checked_type(item0)? for item0 in field1]))
        StoredLayoutCheckedType.Decimal(field0, field1) => return Ok(CheckedType.Decimal(field0, field1))
        StoredLayoutCheckedType.Function(field0, field1) => return Ok(CheckedType.Function([restore_checked_callable_param(item0)? for item0 in field0], [restore_checked_type(item0)? for item0 in field1]))
        StoredLayoutCheckedType.TypeToken(field0) => return Ok(CheckedType.TypeToken([restore_checked_type(item0)? for item0 in field0]))
        StoredLayoutCheckedType.Tuple(field0) => return Ok(CheckedType.Tuple([restore_checked_type(item0)? for item0 in field0]))
        StoredLayoutCheckedType.TypeVar(field0) => return Ok(CheckedType.TypeVar(field0))
        StoredLayoutCheckedType.SelfType => return Ok(CheckedType.SelfType)
        StoredLayoutCheckedType.Ref(field0) => return Ok(CheckedType.Ref([restore_checked_type(item0)? for item0 in field0]))
        StoredLayoutCheckedType.RefMut(field0) => return Ok(CheckedType.RefMut([restore_checked_type(item0)? for item0 in field0]))
        StoredLayoutCheckedType.RustInteropPath(field0) => return Ok(CheckedType.RustInteropPath(field0))
        StoredLayoutCheckedType.NativeBuiltin(field0) => return Ok(CheckedType.NativeBuiltin(restore_checked_runtime_builtin(field0)?))
        StoredLayoutCheckedType.Unsupported(field0) => return Ok(CheckedType.Unsupported(field0))
        StoredLayoutCheckedType.Infer => return Ok(CheckedType.Infer)
        StoredLayoutCheckedType.Unknown => return Ok(CheckedType.Unknown)
        StoredLayoutCheckedType.NativeArray(field0, field1) => return Ok(CheckedType.NativeArray([restore_checked_type(item0)? for item0 in field0], field1))
        StoredLayoutCheckedType.NativeTraitObject(field0, field1, field2) => return Ok(CheckedType.NativeTraitObject(field0, field1, field2))
        StoredLayoutCheckedType.NativePointer(field0, field1) => return Ok(CheckedType.NativePointer(field0, [restore_checked_type(item0)? for item0 in field1]))
        StoredLayoutCheckedType.NativeCChar => return Ok(CheckedType.NativeCChar)
        _ => return Err("native-interface refuses an unsupported CheckedType alternative")
