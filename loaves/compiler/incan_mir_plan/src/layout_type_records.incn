def retain_plan_type_1(value: PlanType) -> Result[StoredLayoutPlanType, str]:
    """Encode exact PlanType alternatives without interpreting their meaning."""
    match value:
        PlanType.StrRef => return Ok(StoredLayoutPlanType.StrRef)
        PlanType.StringArray(field0) => return Ok(StoredLayoutPlanType.StringArray(field0))
