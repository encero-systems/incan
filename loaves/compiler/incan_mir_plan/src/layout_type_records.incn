        PlanType.StringSlice => return Ok(StoredLayoutPlanType.StringSlice)
        PlanType.StrSlice => return Ok(StoredLayoutPlanType.StrSlice)
        PlanType.List(field0, field1) => return Ok(StoredLayoutPlanType.List(retain_list_leaf(field0)?, field1))
