"""
Carrier positions during lowering, and their fold into the plan's one enum table.

While a unit lowers, a standard carrier lowering admits is named by its own position among the carriers, offset by
`CARRIER_BASE`, and a source enum by its position among the source enums. Each table only appends, so a module whose
enums arrive in a later lowering attempt moves no carrier a frame already names. The plan keeps one enum table, the
source enums then the carriers; publication folds every carrier position into it once, after the last append.
"""

from _body import (
    BasicBlock,
    Callee,
    CalleeKind,
    Constant,
    FieldProjection,
    FrozenValue,
    Operand,
    OperandKind,
    Parameter,
    Place,
    Projection,
    Rvalue,
    RvalueKind,
    Statement,
    StatementKind,
    Terminator,
    TerminatorKind,
    Local,
)
from _plan import (
    EnumDeclaration,
    EnumVariant,
    ExternalFunction,
    FallibleIteratorMethods,
    Function,
    GenericEnumDeclaration,
    GenericEnumVariant,
    GenericLayoutField,
    GenericLayoutType,
    GenericLoan,
    GenericModelDeclaration,
    IteratorMethods,
    ModelDeclaration,
    Plan,
    StaticCell,
    ZipCarrier,
)
from nominal_identities import (
    NominalKind,
    NominalRemap,
    folding_remap,
    remap_element,
    remap_leaf,
    remap_type,
    remap_types,
)


pub def fold_carrier_positions(plan: Plan, sources: int) -> Result[Plan, str]:
    """
    Name every carrier by its place in the plan's enum table, after the `sources` source enums.

    Every other position, and every source enum position, is kept.
    """
    mut remap = folding_remap(sources)
    mut statics: list[StaticCell] = []
    for cell in plan.statics:
        mut kept = cell.clone()
        kept.ty = remap_type(cell.ty, remap)?
        statics.append(kept)
    mut zips: list[ZipCarrier] = []
    for carrier in plan.zip_carriers:
        mut kept = carrier.clone()
        kept.left = remap_element(carrier.left, remap)?
        kept.right = remap_element(carrier.right, remap)?
        kept.target = remap_type(carrier.target, remap)?
        zips.append(kept)
    return Ok(
        Plan(
            enums=[fold_enum(declaration, remap)? for declaration in plan.enums],
            models=[fold_model(declaration, remap)? for declaration in plan.models],
            functions=[fold_function(function, remap)? for function in plan.functions],
            externals=[fold_external(external, remap)? for external in plan.externals],
            span=plan.span,
            statics=statics,
            exports=plan.exports,
            tests=plan.tests,
            zip_carriers=zips,
            programs=plan.programs,
            generic_models=[fold_generic_model(declaration, remap)? for declaration in plan.generic_models],
            generic_enums=[fold_generic_enum(declaration, remap)? for declaration in plan.generic_enums],
        ),
    )


pub def fold_remaining_carrier_positions(plan: Plan, sources: int) -> Result[Plan, str]:
    """Retain inventories already folded after the final carrier append, then fold storage and templates."""
    mut remap = folding_remap(sources)
    mut statics: list[StaticCell] = []
    for cell in plan.statics:
        mut kept = cell.clone()
        kept.ty = remap_type(cell.ty, remap)?
        statics.append(kept)
    mut zips: list[ZipCarrier] = []
    for carrier in plan.zip_carriers:
        mut kept = carrier.clone()
        kept.left = remap_element(carrier.left, remap)?
        kept.right = remap_element(carrier.right, remap)?
        kept.target = remap_type(carrier.target, remap)?
        zips.append(kept)
    return Ok(
        Plan(
            enums=plan.enums,
            models=plan.models,
            functions=plan.functions,
            externals=plan.externals,
            span=plan.span,
            statics=statics,
            exports=plan.exports,
            tests=plan.tests,
            zip_carriers=zips,
            programs=plan.programs,
            generic_models=[fold_generic_model(declaration, remap)? for declaration in plan.generic_models],
            generic_enums=[fold_generic_enum(declaration, remap)? for declaration in plan.generic_enums],
        ),
    )


pub def fold_inventories(
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    sources: int,
) -> Result[None, str]:
    """Fold a unit's carrier positions in place once its last carrier is appended after its `sources` source enums."""
    mut remap = folding_remap(sources)
    for index in range(len(functions)):
        functions[index] = fold_function(functions[index], remap)?
    for index in range(len(models)):
        models[index] = fold_model(models[index], remap)?
    for index in range(len(enums)):
        enums[index] = fold_enum(enums[index], remap)?
    for index in range(len(externals)):
        externals[index] = fold_external(externals[index], remap)?
    return Ok(None)


def fold_enum(declaration: EnumDeclaration, mut remap: NominalRemap) -> Result[EnumDeclaration, str]:
    """Fold the carrier positions in an enum's payloads and closed SDK arguments."""
    mut kept = declaration.clone()
    mut variants: list[EnumVariant] = []
    for variant in declaration.variants:
        variants.append(EnumVariant(name=variant.name, fields=remap_types(variant.fields, remap)?))
    kept.variants = variants
    kept.library_type_arguments = remap_types(declaration.library_type_arguments, remap)?
    return Ok(kept)


def fold_model(declaration: ModelDeclaration, mut remap: NominalRemap) -> Result[ModelDeclaration, str]:
    """Fold the carrier positions in a model's fields, closed SDK arguments and checked bridge carriers."""
    mut kept = declaration.clone()
    kept.fields = [fold_parameter(field, remap)? for field in declaration.fields]
    kept.library_type_arguments = remap_types(declaration.library_type_arguments, remap)?
    kept.callable_signature = remap_types(declaration.callable_signature, remap)?
    match declaration.iterator:
        Some(methods) => kept.iterator = Some(IteratorMethods(item=remap_type(methods.item, remap)?, next=methods.next))
        None => pass
    match declaration.fallible_iterator:
        Some(methods) =>
            kept.fallible_iterator = Some(
                FallibleIteratorMethods(
                    item=remap_type(methods.item, remap)?,
                    error=remap_type(methods.error, remap)?,
                    next=methods.next,
                ),
            )
        None => pass
    return Ok(kept)


def fold_external(external: ExternalFunction, mut remap: NominalRemap) -> Result[ExternalFunction, str]:
    """Fold the carrier positions in a dependency signature."""
    mut kept = external.clone()
    kept.type_arguments = remap_types(external.type_arguments, remap)?
    kept.parameters = remap_types(external.parameters, remap)?
    kept.return_type = remap_type(external.return_type, remap)?
    return Ok(kept)


def fold_generic_model(
    declaration: GenericModelDeclaration,
    mut remap: NominalRemap,
) -> Result[GenericModelDeclaration, str]:
    """Fold the concrete carrier positions in a published model template."""
    mut kept = declaration.clone()
    mut fields: list[GenericLayoutField] = []
    for field in declaration.fields:
        fields.append(GenericLayoutField(name=field.name, ty=fold_layout(field.ty, remap)?, public=field.public))
    kept.fields = fields
    return Ok(kept)


def fold_generic_enum(
    declaration: GenericEnumDeclaration,
    mut remap: NominalRemap,
) -> Result[GenericEnumDeclaration, str]:
    """Fold the concrete carrier positions in a published enum template."""
    mut kept = declaration.clone()
    mut variants: list[GenericEnumVariant] = []
    for variant in declaration.variants:
        variants.append(GenericEnumVariant(name=variant.name, fields=[fold_layout(ty, remap)? for ty in variant.fields]))
    kept.variants = variants
    return Ok(kept)


def fold_layout(ty: GenericLayoutType, mut remap: NominalRemap) -> Result[GenericLayoutType, str]:
    """Fold the concrete types inside a template layout type."""
    match ty:
        GenericLayoutType.Concrete(concrete) => return Ok(GenericLayoutType.Concrete(remap_type(concrete, remap)?))
        GenericLayoutType.Applied(name, arguments) =>
            return Ok(GenericLayoutType.Applied(name, [fold_layout(argument, remap)? for argument in arguments]))
        GenericLayoutType.Tuple(elements) =>
            return Ok(GenericLayoutType.Tuple([fold_layout(element, remap)? for element in elements]))
        GenericLayoutType.FunctionPointer(types) =>
            return Ok(GenericLayoutType.FunctionPointer([fold_layout(element, remap)? for element in types]))
        _ => return Ok(ty)


def fold_parameter(parameter: Parameter, mut remap: NominalRemap) -> Result[Parameter, str]:
    """Fold one typed parameter or field."""
    return Ok(Parameter(name=parameter.name, ty=remap_type(parameter.ty, remap)?, span=parameter.span))


def fold_function(function: Function, mut remap: NominalRemap) -> Result[Function, str]:
    """Fold every carrier position in a function's signature, locals, blocks, loans and future callee."""
    mut kept = function.clone()
    kept.parameters = [fold_parameter(parameter, remap)? for parameter in function.parameters]
    kept.return_type = remap_type(function.return_type, remap)?
    kept.locals = [Local(ty=remap_type(local.ty, remap)?, span=local.span) for local in function.locals]
    kept.blocks = [fold_block(block, remap)? for block in function.blocks]
    mut loans: list[GenericLoan] = []
    for loan in function.generic_loans:
        mut held = loan.clone()
        held.ty = remap_type(loan.ty, remap)?
        loans.append(held)
    kept.generic_loans = loans
    match function.future_callee:
        Some(callee) => kept.future_callee = Some(fold_callee(callee, remap)?)
        None => pass
    return Ok(kept)


def fold_block(block: BasicBlock, mut remap: NominalRemap) -> Result[BasicBlock, str]:
    """Fold one block's statements and terminator."""
    mut statements: list[Statement] = []
    for statement in block.statements:
        match statement.kind:
            StatementKind.Assign(target, value) =>
                kind = StatementKind.Assign(
                    fold_place(target, remap)?,
                    Rvalue(kind=fold_rvalue(value.kind, remap)?, span=value.span),
                )
                statements.append(Statement(kind=kind, span=statement.span))
            _ => statements.append(statement)
    terminator = Terminator(kind=fold_terminator(block.terminator.kind, remap)?, span=block.terminator.span)
    return Ok(BasicBlock(statements=statements, terminator=terminator, cleanup=block.cleanup, span=block.span))


def fold_terminator(kind: TerminatorKind, mut remap: NominalRemap) -> Result[TerminatorKind, str]:
    """Fold the places, operands and callee a terminator holds."""
    match kind:
        TerminatorKind.SwitchBool(condition, otherwise, then) =>
            return Ok(TerminatorKind.SwitchBool(fold_operand(condition, remap)?, otherwise, then))
        TerminatorKind.Call(callee, arguments, destination, target, unwind) =>
            return Ok(
                TerminatorKind.Call(
                    fold_callee(callee, remap)?,
                    [fold_operand(argument, remap)? for argument in arguments],
                    fold_place(destination, remap)?,
                    target,
                    unwind,
                ),
            )
        TerminatorKind.Drop(dropped, target, unwind) =>
            return Ok(TerminatorKind.Drop(fold_place(dropped, remap)?, target, unwind))
        TerminatorKind.AssertOverflow(flag, operation, left, right, target, unwind) =>
            return Ok(
                TerminatorKind.AssertOverflow(
                    fold_operand(flag, remap)?,
                    operation,
                    fold_operand(left, remap)?,
                    fold_operand(right, remap)?,
                    target,
                    unwind,
                ),
            )
        TerminatorKind.Await(future, output, resume, drop, unwind, cancel) =>
            return Ok(
                TerminatorKind.Await(
                    fold_place(future, remap)?,
                    fold_place(output, remap)?,
                    resume,
                    drop,
                    unwind,
                    cancel,
                ),
            )
        _ => return Ok(kind)


def fold_callee(callee: Callee, mut remap: NominalRemap) -> Result[Callee, str]:
    """Fold a callee's enum owner, type arguments, generator leaves, operand and foreign signature."""
    match callee.kind:
        CalleeKind.CloneEnum(owner, name) =>
            return Ok(Callee(kind=CalleeKind.CloneEnum(fold_enum_owner(owner, remap)?, name), span=callee.span))
        CalleeKind.Instantiated(path, types) =>
            return Ok(Callee(kind=CalleeKind.Instantiated(path, remap_types(types, remap)?), span=callee.span))
        CalleeKind.FutureMethod(path, types) =>
            return Ok(Callee(kind=CalleeKind.FutureMethod(path, remap_types(types, remap)?), span=callee.span))
        CalleeKind.SpawnGenerator(name, leaf, depth) =>
            return Ok(Callee(kind=CalleeKind.SpawnGenerator(name, remap_leaf(leaf, remap)?, depth), span=callee.span))
        CalleeKind.YieldGenerator(leaf, depth) =>
            return Ok(Callee(kind=CalleeKind.YieldGenerator(remap_leaf(leaf, remap)?, depth), span=callee.span))
        CalleeKind.CollectGenerator(leaf, depth) =>
            return Ok(Callee(kind=CalleeKind.CollectGenerator(remap_leaf(leaf, remap)?, depth), span=callee.span))
        CalleeKind.Value(operand) =>
            return Ok(Callee(kind=CalleeKind.Value(fold_operand(operand, remap)?), span=callee.span))
        CalleeKind.SharedCallableBody(types) =>
            return Ok(Callee(kind=CalleeKind.SharedCallableBody(remap_types(types, remap)?), span=callee.span))
        CalleeKind.CallClosure(types) =>
            return Ok(Callee(kind=CalleeKind.CallClosure(remap_types(types, remap)?), span=callee.span))
        CalleeKind.CallClosureOnce(types) =>
            return Ok(Callee(kind=CalleeKind.CallClosureOnce(remap_types(types, remap)?), span=callee.span))
        CalleeKind.CallBorrowingClosure(types) =>
            return Ok(Callee(kind=CalleeKind.CallBorrowingClosure(remap_types(types, remap)?), span=callee.span))
        CalleeKind.CloneClosure(types) =>
            return Ok(Callee(kind=CalleeKind.CloneClosure(remap_types(types, remap)?), span=callee.span))
        CalleeKind.FormatValue(ty, debug) =>
            return Ok(Callee(kind=CalleeKind.FormatValue(remap_type(ty, remap)?, debug), span=callee.span))
        CalleeKind.InstallPanicHook(types) =>
            return Ok(Callee(kind=CalleeKind.InstallPanicHook(remap_types(types, remap)?), span=callee.span))
        CalleeKind.Foreign(foreign) =>
            mut kept = foreign.clone()
            kept.parameters = remap_types(foreign.parameters, remap)?
            kept.return_type = remap_type(foreign.return_type, remap)?
            return Ok(Callee(kind=CalleeKind.Foreign(kept), span=callee.span))
        _ => return Ok(callee)


def fold_rvalue(kind: RvalueKind, mut remap: NominalRemap) -> Result[RvalueKind, str]:
    """Fold an rvalue's enum owner, types, operands and places."""
    match kind:
        RvalueKind.Use(operand) => return Ok(RvalueKind.Use(fold_operand(operand, remap)?))
        RvalueKind.NativeAlias(operand, source, target) =>
            return Ok(
                RvalueKind.NativeAlias(
                    fold_operand(operand, remap)?,
                    remap_type(source, remap)?,
                    remap_type(target, remap)?,
                ),
            )
        RvalueKind.FrozenText(operand) => return Ok(RvalueKind.FrozenText(fold_operand(operand, remap)?))
        RvalueKind.FrozenCollection(ty, values) =>
            return Ok(
                RvalueKind.FrozenCollection(remap_type(ty, remap)?, [fold_frozen(value, remap)? for value in values]),
            )
        RvalueKind.Binary(operation, left, right) =>
            return Ok(RvalueKind.Binary(operation, fold_operand(left, remap)?, fold_operand(right, remap)?))
        RvalueKind.Unary(operation, operand) => return Ok(RvalueKind.Unary(operation, fold_operand(operand, remap)?))
        RvalueKind.NumericCast(operand, source, target) =>
            return Ok(
                RvalueKind.NumericCast(
                    fold_operand(operand, remap)?,
                    remap_type(source, remap)?,
                    remap_type(target, remap)?,
                ),
            )
        RvalueKind.IntToFloat(operand) => return Ok(RvalueKind.IntToFloat(fold_operand(operand, remap)?))
        RvalueKind.FloatToInt(operand) => return Ok(RvalueKind.FloatToInt(fold_operand(operand, remap)?))
        RvalueKind.BoolToInt(operand) => return Ok(RvalueKind.BoolToInt(fold_operand(operand, remap)?))
        RvalueKind.Array(operands) => return Ok(RvalueKind.Array(fold_operands(operands, remap)?))
        RvalueKind.Enum(owner, variant, operands) =>
            return Ok(RvalueKind.Enum(fold_enum_owner(owner, remap)?, variant, fold_operands(operands, remap)?))
        RvalueKind.Discriminant(target) => return Ok(RvalueKind.Discriminant(fold_place(target, remap)?))
        RvalueKind.TagToInt(operand) => return Ok(RvalueKind.TagToInt(fold_operand(operand, remap)?))
        RvalueKind.Model(owner, operands) => return Ok(RvalueKind.Model(owner, fold_operands(operands, remap)?))
        RvalueKind.Tuple(operands) => return Ok(RvalueKind.Tuple(fold_operands(operands, remap)?))
        RvalueKind.Range(operands) => return Ok(RvalueKind.Range(fold_operands(operands, remap)?))
        _ => return fold_reference_rvalue(kind, remap)


def fold_reference_rvalue(kind: RvalueKind, mut remap: NominalRemap) -> Result[RvalueKind, str]:
    """Fold the borrowing, callable and pointer rvalues."""
    match kind:
        RvalueKind.Borrow(target) => return Ok(RvalueKind.Borrow(fold_place(target, remap)?))
        RvalueKind.MutBorrow(target) => return Ok(RvalueKind.MutBorrow(fold_place(target, remap)?))
        RvalueKind.UnsizeSlice(operand) => return Ok(RvalueKind.UnsizeSlice(fold_operand(operand, remap)?))
        RvalueKind.UnsizeTraitObject(operand, source, target) =>
            return Ok(
                RvalueKind.UnsizeTraitObject(
                    fold_operand(operand, remap)?,
                    remap_type(source, remap)?,
                    remap_type(target, remap)?,
                ),
            )
        RvalueKind.FunctionItem(callee) => return Ok(RvalueKind.FunctionItem(fold_callee(callee, remap)?))
        RvalueKind.ReifyFunction(operand) => return Ok(RvalueKind.ReifyFunction(fold_operand(operand, remap)?))
        RvalueKind.FunctionAddress(operand) => return Ok(RvalueKind.FunctionAddress(fold_operand(operand, remap)?))
        RvalueKind.ClosureObject(target) => return Ok(RvalueKind.ClosureObject(fold_place(target, remap)?))
        RvalueKind.IsVariant(target, variant) => return Ok(RvalueKind.IsVariant(fold_place(target, remap)?, variant))
        RvalueKind.RawAddressOf(target, mutable) =>
            return Ok(RvalueKind.RawAddressOf(fold_place(target, remap)?, mutable))
        RvalueKind.PointerCast(operand, ty) =>
            return Ok(RvalueKind.PointerCast(fold_operand(operand, remap)?, remap_type(ty, remap)?))
        RvalueKind.PointerOffset(pointer, offset) =>
            return Ok(RvalueKind.PointerOffset(fold_operand(pointer, remap)?, fold_operand(offset, remap)?))
        RvalueKind.PointerAddress(operand) => return Ok(RvalueKind.PointerAddress(fold_operand(operand, remap)?))
        # The unit function name and frozen bytes name no type.
        _ => return Ok(kind)


def fold_frozen(value: FrozenValue, mut remap: NominalRemap) -> Result[FrozenValue, str]:
    """Fold a static value's constants and nested collection types."""
    match value:
        FrozenValue.Scalar(constant) => return Ok(FrozenValue.Scalar(fold_constant(constant, remap)?))
        FrozenValue.Collection(ty, values) =>
            return Ok(FrozenValue.Collection(remap_type(ty, remap)?, [fold_frozen(nested, remap)? for nested in values]))
        _ => return Ok(value)


def fold_operands(operands: list[Operand], mut remap: NominalRemap) -> Result[list[Operand], str]:
    """Fold an ordered operand list."""
    return Ok([fold_operand(operand, remap)? for operand in operands])


def fold_operand(operand: Operand, mut remap: NominalRemap) -> Result[Operand, str]:
    """Fold an operand's place or constant type."""
    match operand.kind:
        OperandKind.Copy(target) =>
            return Ok(Operand(kind=OperandKind.Copy(fold_place(target, remap)?), span=operand.span))
        OperandKind.Move(target) =>
            return Ok(Operand(kind=OperandKind.Move(fold_place(target, remap)?), span=operand.span))
        OperandKind.Literal(constant) =>
            return Ok(Operand(kind=OperandKind.Literal(fold_constant(constant, remap)?), span=operand.span))


def fold_constant(constant: Constant, mut remap: NominalRemap) -> Result[Constant, str]:
    """Fold a typed constant's carrier."""
    match constant:
        Constant.Numeric(digits, ty) => return Ok(Constant.Numeric(digits, remap_type(ty, remap)?))
        Constant.RustItem(path, ty) => return Ok(Constant.RustItem(path, remap_type(ty, remap)?))
        Constant.TypeToken(types) => return Ok(Constant.TypeToken(remap_types(types, remap)?))
        _ => return Ok(constant)


def fold_place(target: Place, mut remap: NominalRemap) -> Result[Place, str]:
    """Fold the types a place's projection names."""
    return Ok(Place(local=target.local, projection=fold_projection(target.projection, remap)?, span=target.span))


def fold_projection(projection: Projection, mut remap: NominalRemap) -> Result[Projection, str]:
    """Fold each typed projection step."""
    match projection:
        Projection.NumericValue(ty) => return Ok(Projection.NumericValue(remap_type(ty, remap)?))
        Projection.VariantField(variant, slot, ty) =>
            return Ok(Projection.VariantField(variant, slot, remap_type(ty, remap)?))
        Projection.Field(slot, ty) => return Ok(Projection.Field(slot, remap_type(ty, remap)?))
        Projection.Deref(ty) => return Ok(Projection.Deref(remap_type(ty, remap)?))
        Projection.DerefField(slot, ty) => return Ok(Projection.DerefField(slot, remap_type(ty, remap)?))
        Projection.Fields(steps) => return Ok(Projection.Fields(fold_steps(steps, remap)?))
        Projection.DerefFields(steps) => return Ok(Projection.DerefFields(fold_steps(steps, remap)?))
        _ => return Ok(projection)


def fold_steps(steps: list[FieldProjection], mut remap: NominalRemap) -> Result[list[FieldProjection], str]:
    """Fold each step of a canonical field path."""
    mut folded: list[FieldProjection] = []
    for step in steps:
        mut kept = step.clone()
        kept.ty = remap_type(step.ty, remap)?
        folded.append(kept)
    return Ok(folded)


def fold_enum_owner(owner: int, mut remap: NominalRemap) -> Result[int, str]:
    """Fold one enum owner position."""
    return Ok(remap.slot(NominalKind.Enum, owner, "")?.index)
