"""
Carrier positions during lowering, and their fold into the plan's one enum table.

While a unit lowers, a standard carrier lowering admits is named by its own position among the carriers, offset by
`CARRIER_BASE`, and a source enum by its position among the source enums. Each table only appends, so a module whose
enums arrive in a later lowering attempt moves no carrier a frame already names. The plan keeps one enum table, the
source enums then the carriers; publication folds every carrier position into it once, after the last append.
"""

from _body import (
    BasicBlock,
    Callee,
    CalleeKind,
    Constant,
    FieldProjection,
    FrozenValue,
    Operand,
    OperandKind,
    Parameter,
    Place,
    Projection,
    Rvalue,
    RvalueKind,
    Statement,
    StatementKind,
    Terminator,
    TerminatorKind,
    Local,
)
from _plan import (
    EnumDeclaration,
    EnumVariant,
    ExternalFunction,
    FallibleIteratorMethods,
    Function,
    GenericEnumDeclaration,
    GenericEnumVariant,
    GenericLayoutField,
    GenericLayoutType,
    GenericLoan,
    GenericModelDeclaration,
    IteratorMethods,
    ModelDeclaration,
    Plan,
    StaticCell,
    ZipCarrier,
)
from nominal_identities import (
    NominalKind,
    NominalRemap,
    folding_remap,
)


pub def fold_carrier_positions(plan: Plan, sources: int) -> Result[Plan, str]:
    """
    Name every carrier by its place in the plan's enum table, after the `sources` source enums.

    Every other position, and every source enum position, is kept.
    """
    mut fold = CarrierFold(remap=folding_remap(sources))
    mut folded = plan.clone()
    folded.enums = [fold.fold_enum(declaration)? for declaration in plan.enums]
    folded.models = [fold.fold_model(declaration)? for declaration in plan.models]
    folded.functions = [fold.fold_function(function)? for function in plan.functions]
    folded.externals = [fold.fold_external(external)? for external in plan.externals]
    mut statics: list[StaticCell] = []
    for cell in plan.statics:
        mut kept = cell.clone()
        kept.ty = fold.remap.remap_type(cell.ty)?
        statics.append(kept)
    folded.statics = statics
    mut zips: list[ZipCarrier] = []
    for carrier in plan.zip_carriers:
        mut kept = carrier.clone()
        kept.left = fold.remap.remap_element(carrier.left)?
        kept.right = fold.remap.remap_element(carrier.right)?
        kept.target = fold.remap.remap_type(carrier.target)?
        zips.append(kept)
    folded.zip_carriers = zips
    folded.generic_models = [fold.fold_generic_model(declaration)? for declaration in plan.generic_models]
    folded.generic_enums = [fold.fold_generic_enum(declaration)? for declaration in plan.generic_enums]
    return Ok(folded)


pub def fold_inventories(
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    sources: int,
) -> Result[None, str]:
    """Fold a unit's carrier positions in place once its last carrier is appended after its `sources` source enums."""
    mut fold = CarrierFold(remap=folding_remap(sources))
    for index in range(len(functions)):
        functions[index] = fold.fold_function(functions[index])?
    for index in range(len(models)):
        models[index] = fold.fold_model(models[index])?
    for index in range(len(enums)):
        enums[index] = fold.fold_enum(enums[index])?
    for index in range(len(externals)):
        externals[index] = fold.fold_external(externals[index])?
    return Ok(None)


class CarrierFold:
    """One plan's carrier fold: every declaration and frame is rewritten through the same folding translation."""

    pub remap: NominalRemap

    pub def fold_enum(mut self, declaration: EnumDeclaration) -> Result[EnumDeclaration, str]:
        """Fold the carrier positions in an enum's payloads and closed SDK arguments."""
        mut kept = declaration.clone()
        mut variants: list[EnumVariant] = []
        for variant in declaration.variants:
            variants.append(EnumVariant(name=variant.name, fields=self.remap.remap_types(variant.fields)?))
        kept.variants = variants
        kept.library_type_arguments = self.remap.remap_types(declaration.library_type_arguments)?
        return Ok(kept)

    pub def fold_model(mut self, declaration: ModelDeclaration) -> Result[ModelDeclaration, str]:
        """Fold the carrier positions in a model's fields, closed SDK arguments and checked bridge carriers."""
        mut kept = declaration.clone()
        kept.fields = [self.fold_parameter(field)? for field in declaration.fields]
        kept.library_type_arguments = self.remap.remap_types(declaration.library_type_arguments)?
        kept.callable_signature = self.remap.remap_types(declaration.callable_signature)?
        match declaration.iterator:
            Some(methods) => kept.iterator = Some(IteratorMethods(item=self.remap.remap_type(methods.item)?, next=methods.next))
            None => pass
        match declaration.fallible_iterator:
            Some(methods) =>
                kept.fallible_iterator = Some(
                    FallibleIteratorMethods(
                        item=self.remap.remap_type(methods.item)?,
                        error=self.remap.remap_type(methods.error)?,
                        next=methods.next,
                    ),
                )
            None => pass
        return Ok(kept)

    pub def fold_external(mut self, external: ExternalFunction) -> Result[ExternalFunction, str]:
        """Fold the carrier positions in a dependency signature."""
        mut kept = external.clone()
        kept.type_arguments = self.remap.remap_types(external.type_arguments)?
        kept.parameters = self.remap.remap_types(external.parameters)?
        kept.return_type = self.remap.remap_type(external.return_type)?
        return Ok(kept)

    pub def fold_generic_model(mut self, declaration: GenericModelDeclaration) -> Result[GenericModelDeclaration, str]:
        """Fold the concrete carrier positions in a published model template."""
        mut kept = declaration.clone()
        mut fields: list[GenericLayoutField] = []
        for field in declaration.fields:
            fields.append(GenericLayoutField(name=field.name, ty=self.fold_layout(field.ty)?, public=field.public))
        kept.fields = fields
        return Ok(kept)

    pub def fold_generic_enum(mut self, declaration: GenericEnumDeclaration) -> Result[GenericEnumDeclaration, str]:
        """Fold the concrete carrier positions in a published enum template."""
        mut kept = declaration.clone()
        mut variants: list[GenericEnumVariant] = []
        for variant in declaration.variants:
            variants.append(GenericEnumVariant(name=variant.name, fields=[self.fold_layout(ty)? for ty in variant.fields]))
        kept.variants = variants
        return Ok(kept)

    def fold_layout(mut self, ty: GenericLayoutType) -> Result[GenericLayoutType, str]:
        """Fold the concrete types inside a template layout type."""
        match ty:
            GenericLayoutType.Concrete(concrete) => return Ok(GenericLayoutType.Concrete(self.remap.remap_type(concrete)?))
            GenericLayoutType.Applied(name, arguments) =>
                return Ok(GenericLayoutType.Applied(name, [self.fold_layout(argument)? for argument in arguments]))
            GenericLayoutType.Tuple(elements) =>
                return Ok(GenericLayoutType.Tuple([self.fold_layout(element)? for element in elements]))
            GenericLayoutType.FunctionPointer(types) =>
                return Ok(GenericLayoutType.FunctionPointer([self.fold_layout(element)? for element in types]))
            _ => return Ok(ty)

    def fold_parameter(mut self, parameter: Parameter) -> Result[Parameter, str]:
        """Fold one typed parameter or field."""
        return Ok(Parameter(name=parameter.name, ty=self.remap.remap_type(parameter.ty)?, span=parameter.span))

    pub def fold_function(mut self, function: Function) -> Result[Function, str]:
        """Fold every carrier position in a function's signature, locals, blocks, loans and future callee."""
        mut kept = function.clone()
        kept.parameters = [self.fold_parameter(parameter)? for parameter in function.parameters]
        kept.return_type = self.remap.remap_type(function.return_type)?
        kept.locals = [Local(ty=self.remap.remap_type(local.ty)?, span=local.span) for local in function.locals]
        kept.blocks = [self.fold_block(block)? for block in function.blocks]
        mut loans: list[GenericLoan] = []
        for loan in function.generic_loans:
            mut held = loan.clone()
            held.ty = self.remap.remap_type(loan.ty)?
            loans.append(held)
        kept.generic_loans = loans
        match function.future_callee:
            Some(callee) => kept.future_callee = Some(self.fold_callee(callee)?)
            None => pass
        return Ok(kept)

    def fold_block(mut self, block: BasicBlock) -> Result[BasicBlock, str]:
        """Fold one block's statements and terminator."""
        mut statements: list[Statement] = []
        for statement in block.statements:
            match statement.kind:
                StatementKind.Assign(target, value) =>
                    kind = StatementKind.Assign(
                        self.fold_place(target)?,
                        Rvalue(kind=self.fold_rvalue(value.kind)?, span=value.span),
                    )
                    statements.append(Statement(kind=kind, span=statement.span))
                _ => statements.append(statement)
        terminator = Terminator(kind=self.fold_terminator(block.terminator.kind)?, span=block.terminator.span)
        return Ok(BasicBlock(statements=statements, terminator=terminator, cleanup=block.cleanup, span=block.span))

    def fold_terminator(mut self, kind: TerminatorKind) -> Result[TerminatorKind, str]:
        """Fold the places, operands and callee a terminator holds."""
        match kind:
            TerminatorKind.SwitchBool(condition, otherwise, then) =>
                return Ok(TerminatorKind.SwitchBool(self.fold_operand(condition)?, otherwise, then))
            TerminatorKind.Call(callee, arguments, destination, target, unwind) =>
                return Ok(
                    TerminatorKind.Call(
                        self.fold_callee(callee)?,
                        [self.fold_operand(argument)? for argument in arguments],
                        self.fold_place(destination)?,
                        target,
                        unwind,
                    ),
                )
            TerminatorKind.Drop(dropped, target, unwind) =>
                return Ok(TerminatorKind.Drop(self.fold_place(dropped)?, target, unwind))
            TerminatorKind.AssertOverflow(flag, operation, left, right, target, unwind) =>
                return Ok(
                    TerminatorKind.AssertOverflow(
                        self.fold_operand(flag)?,
                        operation,
                        self.fold_operand(left)?,
                        self.fold_operand(right)?,
                        target,
                        unwind,
                    ),
                )
            TerminatorKind.Await(future, output, resume, drop, unwind, cancel) =>
                return Ok(
                    TerminatorKind.Await(
                        self.fold_place(future)?,
                        self.fold_place(output)?,
                        resume,
                        drop,
                        unwind,
                        cancel,
                    ),
                )
            _ => return Ok(kind)

    def fold_callee(mut self, callee: Callee) -> Result[Callee, str]:
        """Fold a callee's enum owner, type arguments, generator leaves, operand and foreign signature."""
        match callee.kind:
            CalleeKind.CloneEnum(owner, name) =>
                return Ok(Callee(kind=CalleeKind.CloneEnum(self.fold_enum_owner(owner)?, name), span=callee.span))
            CalleeKind.Instantiated(path, types) =>
                return Ok(Callee(kind=CalleeKind.Instantiated(path, self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.FutureMethod(path, types) =>
                return Ok(Callee(kind=CalleeKind.FutureMethod(path, self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.SpawnGenerator(name, leaf, depth) =>
                return Ok(Callee(kind=CalleeKind.SpawnGenerator(name, self.remap.remap_leaf(leaf)?, depth), span=callee.span))
            CalleeKind.YieldGenerator(leaf, depth) =>
                return Ok(Callee(kind=CalleeKind.YieldGenerator(self.remap.remap_leaf(leaf)?, depth), span=callee.span))
            CalleeKind.CollectGenerator(leaf, depth) =>
                return Ok(Callee(kind=CalleeKind.CollectGenerator(self.remap.remap_leaf(leaf)?, depth), span=callee.span))
            CalleeKind.Value(operand) =>
                return Ok(Callee(kind=CalleeKind.Value(self.fold_operand(operand)?), span=callee.span))
            CalleeKind.SharedCallableBody(types) =>
                return Ok(Callee(kind=CalleeKind.SharedCallableBody(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.CallClosure(types) =>
                return Ok(Callee(kind=CalleeKind.CallClosure(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.CallClosureOnce(types) =>
                return Ok(Callee(kind=CalleeKind.CallClosureOnce(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.CallBorrowingClosure(types) =>
                return Ok(Callee(kind=CalleeKind.CallBorrowingClosure(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.CloneClosure(types) =>
                return Ok(Callee(kind=CalleeKind.CloneClosure(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.FormatValue(ty, debug) =>
                return Ok(Callee(kind=CalleeKind.FormatValue(self.remap.remap_type(ty)?, debug), span=callee.span))
            CalleeKind.InstallPanicHook(types) =>
                return Ok(Callee(kind=CalleeKind.InstallPanicHook(self.remap.remap_types(types)?), span=callee.span))
            CalleeKind.Foreign(foreign) =>
                mut kept = foreign.clone()
                kept.parameters = self.remap.remap_types(foreign.parameters)?
                kept.return_type = self.remap.remap_type(foreign.return_type)?
                return Ok(Callee(kind=CalleeKind.Foreign(kept), span=callee.span))
            _ => return Ok(callee)

    def fold_rvalue(mut self, kind: RvalueKind) -> Result[RvalueKind, str]:
        """Fold an rvalue's enum owner, types, operands and places."""
        match kind:
            RvalueKind.Use(operand) => return Ok(RvalueKind.Use(self.fold_operand(operand)?))
            RvalueKind.NativeAlias(operand, source, target) =>
                return Ok(
                    RvalueKind.NativeAlias(
                        self.fold_operand(operand)?,
                        self.remap.remap_type(source)?,
                        self.remap.remap_type(target)?,
                    ),
                )
            RvalueKind.FrozenText(operand) => return Ok(RvalueKind.FrozenText(self.fold_operand(operand)?))
            RvalueKind.FrozenCollection(ty, values) =>
                return Ok(
                    RvalueKind.FrozenCollection(self.remap.remap_type(ty)?, [self.fold_frozen(value)? for value in values]),
                )
            RvalueKind.Binary(operation, left, right) =>
                return Ok(RvalueKind.Binary(operation, self.fold_operand(left)?, self.fold_operand(right)?))
            RvalueKind.Unary(operation, operand) => return Ok(RvalueKind.Unary(operation, self.fold_operand(operand)?))
            RvalueKind.NumericCast(operand, source, target) =>
                return Ok(
                    RvalueKind.NumericCast(
                        self.fold_operand(operand)?,
                        self.remap.remap_type(source)?,
                        self.remap.remap_type(target)?,
                    ),
                )
            RvalueKind.IntToFloat(operand) => return Ok(RvalueKind.IntToFloat(self.fold_operand(operand)?))
            RvalueKind.FloatToInt(operand) => return Ok(RvalueKind.FloatToInt(self.fold_operand(operand)?))
            RvalueKind.BoolToInt(operand) => return Ok(RvalueKind.BoolToInt(self.fold_operand(operand)?))
            RvalueKind.Array(operands) => return Ok(RvalueKind.Array(self.fold_operands(operands)?))
            RvalueKind.Enum(owner, variant, operands) =>
                return Ok(RvalueKind.Enum(self.fold_enum_owner(owner)?, variant, self.fold_operands(operands)?))
            RvalueKind.Discriminant(target) => return Ok(RvalueKind.Discriminant(self.fold_place(target)?))
            RvalueKind.TagToInt(operand) => return Ok(RvalueKind.TagToInt(self.fold_operand(operand)?))
            RvalueKind.Model(owner, operands) => return Ok(RvalueKind.Model(owner, self.fold_operands(operands)?))
            RvalueKind.Tuple(operands) => return Ok(RvalueKind.Tuple(self.fold_operands(operands)?))
            RvalueKind.Range(operands) => return Ok(RvalueKind.Range(self.fold_operands(operands)?))
            _ => return self.fold_reference_rvalue(kind)

    def fold_reference_rvalue(mut self, kind: RvalueKind) -> Result[RvalueKind, str]:
        """Fold the borrowing, callable and pointer rvalues."""
        match kind:
            RvalueKind.Borrow(target) => return Ok(RvalueKind.Borrow(self.fold_place(target)?))
            RvalueKind.MutBorrow(target) => return Ok(RvalueKind.MutBorrow(self.fold_place(target)?))
            RvalueKind.UnsizeSlice(operand) => return Ok(RvalueKind.UnsizeSlice(self.fold_operand(operand)?))
            RvalueKind.UnsizeTraitObject(operand, source, target) =>
                return Ok(
                    RvalueKind.UnsizeTraitObject(
                        self.fold_operand(operand)?,
                        self.remap.remap_type(source)?,
                        self.remap.remap_type(target)?,
                    ),
                )
            RvalueKind.FunctionItem(callee) => return Ok(RvalueKind.FunctionItem(self.fold_callee(callee)?))
            RvalueKind.ReifyFunction(operand) => return Ok(RvalueKind.ReifyFunction(self.fold_operand(operand)?))
            RvalueKind.FunctionAddress(operand) => return Ok(RvalueKind.FunctionAddress(self.fold_operand(operand)?))
            RvalueKind.ClosureObject(target) => return Ok(RvalueKind.ClosureObject(self.fold_place(target)?))
            RvalueKind.IsVariant(target, variant) => return Ok(RvalueKind.IsVariant(self.fold_place(target)?, variant))
            RvalueKind.RawAddressOf(target, mutable) =>
                return Ok(RvalueKind.RawAddressOf(self.fold_place(target)?, mutable))
            RvalueKind.PointerCast(operand, ty) =>
                return Ok(RvalueKind.PointerCast(self.fold_operand(operand)?, self.remap.remap_type(ty)?))
            RvalueKind.PointerOffset(pointer, offset) =>
                return Ok(RvalueKind.PointerOffset(self.fold_operand(pointer)?, self.fold_operand(offset)?))
            RvalueKind.PointerAddress(operand) => return Ok(RvalueKind.PointerAddress(self.fold_operand(operand)?))
            # The unit function name and frozen bytes name no type.
            _ => return Ok(kind)

    def fold_frozen(mut self, value: FrozenValue) -> Result[FrozenValue, str]:
        """Fold a static value's constants and nested collection types."""
        match value:
            FrozenValue.Scalar(constant) => return Ok(FrozenValue.Scalar(self.fold_constant(constant)?))
            FrozenValue.Collection(ty, values) =>
                return Ok(FrozenValue.Collection(self.remap.remap_type(ty)?, [self.fold_frozen(nested)? for nested in values]))
            _ => return Ok(value)

    def fold_operands(mut self, operands: list[Operand]) -> Result[list[Operand], str]:
        """Fold an ordered operand list."""
        return Ok([self.fold_operand(operand)? for operand in operands])

    def fold_operand(mut self, operand: Operand) -> Result[Operand, str]:
        """Fold an operand's place or constant type."""
        match operand.kind:
            OperandKind.Copy(target) =>
                return Ok(Operand(kind=OperandKind.Copy(self.fold_place(target)?), span=operand.span))
            OperandKind.Move(target) =>
                return Ok(Operand(kind=OperandKind.Move(self.fold_place(target)?), span=operand.span))
            OperandKind.Literal(constant) =>
                return Ok(Operand(kind=OperandKind.Literal(self.fold_constant(constant)?), span=operand.span))

    def fold_constant(mut self, constant: Constant) -> Result[Constant, str]:
        """Fold a typed constant's carrier."""
        match constant:
            Constant.Numeric(digits, ty) => return Ok(Constant.Numeric(digits, self.remap.remap_type(ty)?))
            Constant.RustItem(path, ty) => return Ok(Constant.RustItem(path, self.remap.remap_type(ty)?))
            Constant.TypeToken(types) => return Ok(Constant.TypeToken(self.remap.remap_types(types)?))
            _ => return Ok(constant)

    def fold_place(mut self, target: Place) -> Result[Place, str]:
        """Fold the types a place's projection names."""
        return Ok(Place(local=target.local, projection=self.fold_projection(target.projection)?, span=target.span))

    def fold_projection(mut self, projection: Projection) -> Result[Projection, str]:
        """Fold each typed projection step."""
        match projection:
            Projection.NumericValue(ty) => return Ok(Projection.NumericValue(self.remap.remap_type(ty)?))
            Projection.VariantField(variant, slot, ty) =>
                return Ok(Projection.VariantField(variant, slot, self.remap.remap_type(ty)?))
            Projection.Field(slot, ty) => return Ok(Projection.Field(slot, self.remap.remap_type(ty)?))
            Projection.Deref(ty) => return Ok(Projection.Deref(self.remap.remap_type(ty)?))
            Projection.DerefField(slot, ty) => return Ok(Projection.DerefField(slot, self.remap.remap_type(ty)?))
            Projection.Fields(steps) => return Ok(Projection.Fields(self.fold_steps(steps)?))
            Projection.DerefFields(steps) => return Ok(Projection.DerefFields(self.fold_steps(steps)?))
            _ => return Ok(projection)

    def fold_steps(mut self, steps: list[FieldProjection]) -> Result[list[FieldProjection], str]:
        """Fold each step of a canonical field path."""
        mut folded: list[FieldProjection] = []
        for step in steps:
            mut kept = step.clone()
            kept.ty = self.remap.remap_type(step.ty)?
            folded.append(kept)
        return Ok(folded)

    def fold_enum_owner(mut self, owner: int) -> Result[int, str]:
        """Fold one enum owner position."""
        return Ok(self.remap.slot(NominalKind.Enum, owner, "")?.index)

