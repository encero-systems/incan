"""The graph's native plan profile uses compiler-owned Crumb descriptions for its stored functions and layouts."""

from rust::std::primitive import f64 as RustF64
from std.primitives.crumb.values import IntegerValue, Value, ValueField
pub from pub::internal_models.plan_wire_rows import read_wire, write_wire

pub def wire_fields(value: Value, count: int) -> Result[list[ValueField], str]:
    """Read a schema-admitted model's fields in identity order."""
    match value:
        Value.Record(fields) =>
            if len(fields) == count:
                return Ok(fields)
        _ => pass
    return Err("invalid native plan record")


pub def wire_variant(value: Value) -> Result[tuple[bytes, list[ValueField]], str]:
    """Read an admitted alternative's identity, preserving its exact payload field order."""
    match value:
        Value.Enum(identity, fields) => return Ok((identity, fields))
        _ => return Err("invalid native plan alternative")


pub def boolean_value(value: Value) -> Result[bool, str]:
    match value:
        Value.Boolean(flag) => return Ok(flag)
        _ => return Err("expected native plan boolean")


pub def unsigned_value(value: Value) -> Result[u64, str]:
    match value:
        Value.Integer(IntegerValue.Unsigned(number)) =>
            match number.try_resize[u64]():
                Some(item) => return Ok(item)
                None => pass
        _ => pass
    return Err("expected native plan unsigned integer")


pub def float_value(number: float) -> Value:
    """Retain the IEEE binary64 bits as Crumb's logical big-endian input."""
    bits = RustF64.to_bits(number)
    mut data: list[u8] = []
    for offset in range(8):
        data.append((bits >> ((7 - offset) * 8)).wrapping_resize[u8]())
    return Value.Float(64, data)


pub def read_float(value: Value) -> Result[float, str]:
    match value:
        Value.Float(64, data) =>
            if len(data) == 8:
                mut bits: u64 = 0u64
                for byte in data:
                    bits = (bits << 8) | byte.saturating_resize[u64]()
                return Ok(RustF64.from_bits(bits))
        _ => pass
    return Err("expected native plan binary64")


pub enum PositionChange:
    Preserve
    Relocate(str, int, str, int)
    Index(dict[str, int])
    IndexFrom(dict[str, int], str, int)
    Place(list[tuple[int, int]])
    PlaceAt(list[tuple[int, int]], str, int, str, int)


pub model WirePositions:
    """Apply source-coordinate edits only at declared native span fields."""
    pub change: PositionChange = PositionChange.Preserve

    pub def apply(self, file: str, line: int, column: int) -> Result[tuple[str, int, int], str]:
        match self.change:
            PositionChange.Preserve => pass
            PositionChange.Relocate(old_file, origin, new_file, start) =>
                return relocate_span(file, line, column, old_file, origin, new_file, start)
            PositionChange.Index(ordinals) =>
                return index_span(file, line, column, ordinals)
            PositionChange.IndexFrom(ordinals, source, origin) =>
                relative_file, relative_line, relative_column = relocate_span(file, line, column, source, origin, "<owner>", 1)?
                return index_span(relative_file, relative_line, relative_column, ordinals)
            PositionChange.Place(positions) =>
                return place_span(file, line, column, positions)
            PositionChange.PlaceAt(positions, old_file, origin, new_file, start) =>
                placed_file, placed_line, placed_column = place_span(file, line, column, positions)?
                return relocate_span(placed_file, placed_line, placed_column, old_file, origin, new_file, start)
        return Ok((file, line, column))



def index_span(file: str, line: int, column: int, ordinals: &Dict[str, int]) -> Result[tuple[str, int, int], str]:
    if file == "<owner>":
        key = f"{line - 1}:{column}"
        if ordinals.contains_key(key):
            return Ok((file, 0, ordinals[key] + 1))
        if line > 1:
            return Err("plan-function span locates no Body IR node")
    return Ok((file, line, column))


def place_span(file: str, line: int, column: int, positions: &list[tuple[int, int]]) -> Result[tuple[str, int, int], str]:
    if file == "<owner>" and line == 0:
        if column < 1 or column > len(positions):
            return Err("plan-function product names a body position the current body does not have")
        node_line, node_column = positions[column - 1]
        return Ok((file, node_line + 1, node_column))
    return Ok((file, line, column))


def relocate_span(file: str, line: int, column: int, old_file: str, origin: int, new_file: str, start: int) -> Result[tuple[str, int, int], str]:
    if file != old_file:
        return Err("plan-function position map refuses a mixed-source frame")
    moved = line - origin + start
    if moved < 1:
        return Err("plan-function position map precedes its owner")
    return Ok((new_file, moved, column))
