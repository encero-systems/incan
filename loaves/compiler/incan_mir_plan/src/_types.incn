"""Plan value types and source spans: scalars, sized numerics, list leaves, tuple elements and their projections."""

from rust::std::sync import Arc
from rust::incan_semantics_core import CanonicalSymbolId


@derive(Clone, PartialEq)
pub enum TupleElement:
    """
    One tuple element's layout: a scalar, owned or frozen text, an owned collection, or a model or enum carrier.
    A Copy function pointer, exact scalar, nominal or slice reference, or nested tuple retains its full layout.

    A list keeps its leaf and depth, a dictionary its key/value leaves, and a set its element leaf.
    An enum carrier (an `Option`, a `Result` or a source enum) keeps its retained
    declaration index and name, and a nested tuple keeps its own element layout, exactly as the matching `PlanType`
    does. A model retains its declaration identity, and a function pointer retains its exact signature.
    """

    Int
    Float
    Numeric(SizedNumeric)
    Bool
    Unit
    String
    List(ListLeaf, int)
    Dict(ListLeaf, ListLeaf)
    Set(ListLeaf)
    Model(int, str)
    Enum(int, str)
    Tuple(list[TupleElement])
    FunctionPointer(list[PlanType])
    Reference(bool, list[PlanType])
    ModelRef(int, str)
    ModelMutRef(int, str)
    SliceRef(list[PlanType])
    SliceMutRef(list[PlanType])
    FrozenStr
    # Exact native frozen storage remains Copy inside a tuple, including nested frozen collections.
    StaticText
    StaticBytes
    FrozenBytes
    FrozenCollection(str, list[PlanType])


@derive(Clone, PartialEq)
pub model SourceSpan:
    """One-based location retaining a shared file handle, so copying a span never copies its path text."""

    pub file: Arc[str]
    pub line: int
    pub column: int


@derive(Clone, PartialEq)
pub enum ListLeaf:
    """
    Scalar, flat tuple, Copy function pointer, and exact retained nominal/carrier leaves; hash keys still require admitted Eq and Hash authority.

    `List`, `Set` and `Dict` are owned collection values held by another collection, such as a dictionary's list values
    or a list's dictionaries. A list of lists keeps one leaf with a greater depth, so `List` never leads a `PlanType.List`.
    `FrozenStr` and `FrozenBytes` keep dependency-owned Copy wrappers; ordinary strings and bytes own their read data.
    A variant cannot hold its own type directly, so `List` holds its element leaf as the only item of a list, and
    `Set` holds one element leaf, and `Dict` holds its key and value leaves, in that order, as the two items of one.
    """

    Int
    Float
    Bool
    Str
    Tuple(list[TupleElement])
    Model(int, str)
    Enum(int, str)
    U8
    Unit
    Decimal
    FrozenStr
    FrozenBytes
    FunctionPointer(list[PlanType])
    # A zero-sized type token preserves its represented checked carrier when stored in a collection.
    TypeToken(list[PlanType])
    List(list[ListLeaf], int)
    Dict(list[ListLeaf])
    Set(list[ListLeaf])
    # Preserve the native pointer-width unsigned carrier in collection storage.
    USize
    # Exact-width numeric storage uses the same carrier table as scalar overflow results.
    Numeric(SizedNumeric)
    # A local collection may hold an exact shared or exclusive reference without copying its referent into the collection.
    Reference(list[PlanType])


@derive(Clone, PartialEq)
pub enum SizedNumeric:
    """Exact sized carrier retained by an overflow pair."""

    I8
    I16
    I32
    I128
    U8
    U16
    U32
    U64
    U128
    F32
    F64
    ISize
    USize


@derive(Clone, PartialEq)
pub enum PlanType:
    """
    Scalar and source nominal types plus the owned text, fixed arrays, and shared slices used by formatting.

    EnumTag is rustc's native discriminant type and stays body-internal; TagToInt explicitly converts it to source int.

    Sized numeric variants preserve their exact Rust carriers. CheckedNumeric stores its named sized carrier; its value projection retains the carrier type. Tuple elements retain their ordered types and own any string elements. Array lengths are exact nonnegative counts. CheckedInt and arrays are body temporaries; shared slice variants already include their reference.
    StringRef borrows an owned String, StringMutRef is the exclusive borrow a `mut str` parameter receives, and StrRef is a string literal's shared str view.
    ScalarRef and ScalarMutRef borrow one sized scalar, checked tuple, function pointer or shared reference with explicit
    shared or exclusive intent. Borrowing a reference preserves its referent without making that referent writable.
    Nested shared references retain their exact pointee and binders; exclusive references remain outside copying.
    List stores its scalar or flat tuple leaf element and a positive nesting depth; ListRef and ListMutRef borrow that same Vec representation.
    ModelRef and ModelMutRef retain shared and mutable nominal receiver references; ModelMutRef, EnumMutRef and
    TupleMutRef are also the exclusive borrow a `mut` parameter or an in-place loop item holds. TupleRef and TupleMutRef
    retain the complete tuple layout with shared and exclusive access respectively.
    Decimal retains the legacy Decimal128 carrier; precision is checked upstream and the value keeps its written scale.
    FrozenStr retains the copyable frozen wrapper over static text; it owns no allocation and is distinct from String.
    FrozenBytes retains the copyable wrapper over a static byte slice, distinct from an owned byte list.
    Set and Dict retain the legacy HashSet and HashMap leaf arguments; their reference variants preserve caller-owned storage. Float and model keys are refused; flat tuple keys exclude floating-point fields.
    Generator retains the legacy lazy runtime wrapper, with depth zero for an immediate scalar or retained nominal leaf.
    GeneratorMutRef advances caller-owned state. GeneratorYield and GeneratorYieldRef are producer-only runtime
    handles; they never represent source values or eagerly collected elements.
    ZipIterator retains two independent owned list snapshots; its reference variants retain shared read or exclusive poll authority.
    RangeValue retains a source range value's start, end, step, and inclusivity scalar fields in Body IR's declared range field order; its field projections use that order.
    FunctionPointer retains its inputs followed by exactly one return entry; the vector is never empty, including for a zero-argument function. FunctionItem keeps that same signature and the proven source declaration's name; it remains distinct from a pointer until an explicit reification.
    Closure owns a boxed callable object with that signature layout, holding its captures by value; ClosureRef is the shared view its calls take. BorrowingClosure owns a boxed callable object whose captures may be shared references; a call-only parameter receives a temporary one that lends the source callable. BorrowingClosureRef is the shared view its calls take. CallableArguments is the body-internal argument tuple; it preserves each input's exact type, including caller-owned collection references, independently of source tuple layouts.
    """

    Int
    Float
    I8
    I16
    I32
    I128
    ISize
    USize
    U8
    U16
    U32
    U64
    U128
    F32
    F64
    Bool
    Unit
    CheckedNumeric(SizedNumeric)
    # A checked diverging result has no value and gives its native call no normal continuation.
    Never
    # A source-free executor callback; ordinary source callable values stay outside this carrier.
    UnitFunction
    EnumTag
    CheckedInt
    Tuple(list[TupleElement])
    String
    TupleRef(list[TupleElement])
    TupleMutRef(list[TupleElement])
    StringRef
    # Exactly one primitive, frozen scalar or sized shared reference; the shared borrow owns no storage.
    ScalarRef(list[PlanType])
    ScalarMutRef(list[PlanType])
    StringMutRef
    Decimal
    FrozenStr
    FrozenBytes
    # Dependency-owned frozen collection and its exact static element types; dictionaries carry key then value.
    FrozenCollection(str, list[PlanType])
    # A shared view of the same baked storage; comparisons never consume or clone its elements.
    FrozenCollectionRef(str, list[PlanType])
    # The existing SDK's zero-sized marker with exactly one checked represented type.
    TypeToken(list[PlanType])
    # Exact static string storage, including generic arguments, distinct from a borrowed native StrRef view.
    StaticText
    StaticBytes
    # Dependency-owned builtin validation storage; the reference borrows its message and optional code.
    ValidationError
    ValidationErrorRef
    StrRef
    StringArray(int)
    StrArray(int)
    StringArrayRef(int)
    StrArrayRef(int)
    Enum(int, str)
    EnumRef(int, str)
    EnumMutRef(int, str)
    Model(int, str)
    ModelRef(int, str)
    ModelMutRef(int, str)
    StringSlice
    StrSlice
    # A homogeneous list: its admitted leaf element and nesting depth.
    List(ListLeaf, int)
    ListRef(ListLeaf, int)
    ListMutRef(ListLeaf, int)
    # Concrete Vec::IntoIter owns the checked list's items; its mutable view polls without Clone.
    ListIntoIter(ListLeaf, int)
    ListIntoIterMutRef(ListLeaf, int)
    Set(ListLeaf)
    SetRef(ListLeaf)
    SetMutRef(ListLeaf)
    Dict(ListLeaf, ListLeaf)
    DictRef(ListLeaf, ListLeaf)
    DictMutRef(ListLeaf, ListLeaf)
    # A source range value: four Copy scalar fields in declared range field order.
    RangeValue
    # Lazy zip over independent owned list snapshots; references retain poll authority.
    ZipIterator(TupleElement, TupleElement)
    ZipIteratorRef(TupleElement, TupleElement)
    ZipIteratorMutRef(TupleElement, TupleElement)
    # Lazy runtime generators retain the admitted immediate element representation.
    Generator(ListLeaf, int)
    GeneratorMutRef(ListLeaf, int)
    GeneratorYield(ListLeaf, int)
    GeneratorYieldRef(ListLeaf, int)
    FunctionPointer(list[PlanType])
    FunctionItem(str, list[PlanType])
    Closure(list[PlanType])
    # A Rust callback environment retains exactly its checked Send and Sync obligations.
    NativeClosure(list[PlanType], bool, bool)
    # A checked nongeneric Rust trait principal and its retained Send/Sync bounds.
    NativeTraitObject(str, bool, bool)
    # A one-argument SDK callable shares an immutable primitive-capture environment and implements its published Clone and Callable1 bounds.
    SharedCallable(list[PlanType])
    # An owned FnOnce object whose invocation transfers its environment instead of borrowing it.
    ClosureOnce(list[PlanType])
    ClosureRef(list[PlanType])
    # An owned callable object holding shared references to its borrowed captures, alive no longer than their shortest
    # borrow; it is neither cloned nor returned, and a call-only parameter owns its temporary lending envelope.
    BorrowingClosure(list[PlanType])
    BorrowingClosureRef(list[PlanType])
    CallableArguments(list[PlanType])
    # Exactly one output carrier; the owned pinned future executes only when polled.
    Future(list[PlanType])
    # Rust's unsized str is permitted as a native type argument; source text remains owned String.
    NativeStr
    # An unsized native slice has one exact element carrier; references retain their own shared/exclusive intent.
    NativeSlice(list[PlanType])
    SliceRef(list[PlanType])
    SliceMutRef(list[PlanType])
    # A native array preserves one element carrier and its checker-evaluated fixed length.
    NativeArray(list[PlanType], int)
    NativeArrayRef(list[PlanType], int)
    NativeArrayMutRef(list[PlanType], int)
    # Exact target C character category, used by verified foreign pointer signatures.
    CChar
    # A compiler-managed raw pointer with exactly one pointee carrier; source arithmetic never creates one.
    RawPointer(bool, list[PlanType])
    # A class field that reaches its own class by value is stored on the heap: exactly one owned referent. Reads
    # dereference it and construction boxes the checked value, so the source value keeps its referent type.
    Boxed(list[PlanType])
    # Canonical source-trait identity admitted only as a TypeToken's represented type. This remains last so older
    # serialized plan discriminants keep their existing values.
    Trait(CanonicalSymbolId)


pub def list_leaf_type(leaf: ListLeaf) -> PlanType:
    """Recover one admitted leaf's exact representation for lowering and adapter consumers."""
    match leaf:
        ListLeaf.Int => return PlanType.Int
        ListLeaf.Float => return PlanType.Float
        ListLeaf.Bool => return PlanType.Bool
        ListLeaf.Str => return PlanType.String
        ListLeaf.Tuple(elements) => return PlanType.Tuple(elements)
        ListLeaf.Model(index, name) => return PlanType.Model(index, name)
        ListLeaf.Enum(index, name) => return PlanType.Enum(index, name)
        ListLeaf.U8 => return PlanType.U8
        ListLeaf.USize => return PlanType.USize
        ListLeaf.Numeric(kind) => return sized_plan_type(kind)
        ListLeaf.Unit => return PlanType.Unit
        ListLeaf.Decimal => return PlanType.Decimal
        ListLeaf.FrozenStr => return PlanType.FrozenStr
        ListLeaf.FrozenBytes => return PlanType.FrozenBytes
        ListLeaf.FunctionPointer(signature) => return PlanType.FunctionPointer(signature)
        ListLeaf.TypeToken(represented) => return PlanType.TypeToken(represented)
        ListLeaf.List(element, depth) => return PlanType.List(element[0], depth)
        ListLeaf.Dict(entry) => return PlanType.Dict(entry[0], entry[1])
        ListLeaf.Set(element) => return PlanType.Set(element[0])
        ListLeaf.Reference(element) => return element[0]


pub def sized_plan_type(kind: SizedNumeric) -> PlanType:
    """Recover the exact scalar carrier shared by collection leaves and sized overflow pairs."""
    match kind:
        SizedNumeric.I8 => return PlanType.I8
        SizedNumeric.I16 => return PlanType.I16
        SizedNumeric.I32 => return PlanType.I32
        SizedNumeric.I128 => return PlanType.I128
        SizedNumeric.U8 => return PlanType.U8
        SizedNumeric.U16 => return PlanType.U16
        SizedNumeric.U32 => return PlanType.U32
        SizedNumeric.U64 => return PlanType.U64
        SizedNumeric.U128 => return PlanType.U128
        SizedNumeric.F32 => return PlanType.F32
        SizedNumeric.F64 => return PlanType.F64
        SizedNumeric.ISize => return PlanType.ISize
        SizedNumeric.USize => return PlanType.USize


pub def range_field_types() -> list[PlanType]:
    """Return RangeValue's native field carriers in declared range field order: start, end, step, then inclusivity."""
    return [PlanType.Int, PlanType.Int, PlanType.Int, PlanType.Bool]


pub def tuple_element_type(element: TupleElement) -> PlanType:
    """Recover a tuple field's exact local type from the admitted layout."""
    match element:
        TupleElement.Int => return PlanType.Int
        TupleElement.Float => return PlanType.Float
        TupleElement.Numeric(kind) => return sized_plan_type(kind)
        TupleElement.Bool => return PlanType.Bool
        TupleElement.Unit => return PlanType.Unit
        TupleElement.String => return PlanType.String
        TupleElement.List(leaf, depth) => return PlanType.List(leaf, depth)
        TupleElement.Dict(key, value) => return PlanType.Dict(key, value)
        TupleElement.Set(leaf) => return PlanType.Set(leaf)
        TupleElement.Model(owner, name) => return PlanType.Model(owner, name)
        TupleElement.Enum(owner, name) => return PlanType.Enum(owner, name)
        TupleElement.Tuple(elements) => return PlanType.Tuple(elements)
        TupleElement.FunctionPointer(signature) => return PlanType.FunctionPointer(signature)
        TupleElement.Reference(mutable, elements) => return reference_type(mutable, elements)
        TupleElement.ModelRef(index, name) => return PlanType.ModelRef(index, name)
        TupleElement.ModelMutRef(index, name) => return PlanType.ModelMutRef(index, name)
        TupleElement.SliceRef(elements) => return PlanType.SliceRef(elements)
        TupleElement.SliceMutRef(elements) => return PlanType.SliceMutRef(elements)
        TupleElement.FrozenStr => return PlanType.FrozenStr
        TupleElement.StaticText => return PlanType.StaticText
        TupleElement.StaticBytes => return PlanType.StaticBytes
        TupleElement.FrozenBytes => return PlanType.FrozenBytes
        TupleElement.FrozenCollection(name, elements) => return PlanType.FrozenCollection(name, elements)


def reference_type(mutable: bool, referent: list[PlanType]) -> PlanType:
    """
    The local type of a tuple element that borrows one referent, shared or exclusive.

    A string and an enum have reference types of their own, and a native `str` is the string-view type; any other
    referent is a scalar reference.
    """
    if len(referent) == 1:
        match referent[0]:
            PlanType.String =>
                if mutable:
                    return PlanType.StringMutRef
                return PlanType.StringRef
            PlanType.Enum(owner, name) =>
                if mutable:
                    return PlanType.EnumMutRef(owner, name)
                return PlanType.EnumRef(owner, name)
            _ => pass
    if mutable:
        return PlanType.ScalarMutRef(referent)
    if referent == [PlanType.NativeStr]:
        return PlanType.StrRef
    return PlanType.ScalarRef(referent)


pub def source_span(file: str, line: int, column: int) -> SourceSpan:
    """Own the file text behind a shared handle that remains valid after the creating scope returns."""
    return SourceSpan(file=Arc.new(file), line=line, column=column)
