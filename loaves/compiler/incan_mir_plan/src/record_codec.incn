"""Loss-check the complete native interface for ordinary programs through the existing function codec."""

from rust::serde import Serialize, Deserialize
from rust::serde_json import to_string, from_str, Error as JsonError
from _plan import Plan, ExternalFunction, Function
from _types import source_span
from function_records import encode_product, decode_product, encode_runtime, decode_runtime, product_nominals
from layout_records import encode_models, decode_models, encode_enums, decode_enums, encode_zip_carriers, decode_zip_carriers
from nominal_identities import NominalKind, NominalReference, ProductNominal


@derive(Serialize, Deserialize)
model StoredReference:
    """One keyed product ordinal's position and native name in this interface's own model or enum table."""

    kind: NominalKind
    index: int
    name: str


@derive(Serialize, Deserialize)
model StoredPlan:
    """Every nonempty field admitted by the bounded ordinary-program profile."""

    schema: int
    functions: list[str]
    references: list[list[StoredReference]]
    runtime: list[str]
    programs: list[str]
    models: list[str]
    enums: list[str]
    zip_carriers: list[str]
    file: str
    line: int
    column: int


@derive(Serialize, Deserialize)
model StoredEntry:
    """The standalone program-entry contribution selected from an already checked main function."""

    schema: str
    entry: str
    inputs: list[str]


pub def encode_entry_binding(entry: str, inputs: list[str]) -> Result[str, str]:
    """Encode the entry selection independently of the function's instructions and physical source positions."""
    return to_string(StoredEntry(schema="incan.plan-entry/1", entry=entry, inputs=inputs)).map_err((error) => str(error))


pub def encode_record_plan(plan: &Plan) -> Result[str, str]:
    """
    Encode one complete plan or explicitly refuse a field the codec cannot preserve.

    Each function's product names its models and enums by their interface declaration names.
    """
    mut functions: list[str] = []
    mut references: list[list[NominalReference]] = []
    empty_runtime: list[ExternalFunction] = []
    for index in range(len(plan.functions)):
        named = product_nominals(plan.functions[index], empty_runtime)?
        functions.append(encode_product(plan.functions[index], empty_runtime, interface_nominals(plan, named)?)?)
        references.append(named)
    return encode_record_plan_products(plan, functions, references)


pub def encode_record_plan_products(
    plan: &Plan,
    functions: list[str],
    references: list[list[NominalReference]] = [],
) -> Result[str, str]:
    """
    Encode a complete interface while retaining its keyed function-product bytes in declaration order.

    A product's runtime list is the lowering demand its declaration recorded. The unit's resolved runtime inventory is
    a separate interface field, so a keyed product never carries another declaration's requirements. A product names
    declarations, never positions; `references` binds each product's ordinals to this interface's own tables, and is
    empty only when no product names a model or enum.
    """
    counts: list[int] = [
        len(plan.statics), len(plan.exports), len(plan.tests), len(plan.generic_models), len(plan.generic_enums),
    ]
    fields = ["statics", "exports", "tests", "generic models", "generic enums"]
    for index in range(len(counts)):
        if counts[index] != 0:
            return Err(f"native-interface refuses {fields[index]}: {counts[index]}")
    if len(plan.functions) == 0:
        return Err("native-interface refuses an empty plan")
    if len(functions) != len(plan.functions):
        return Err("native-interface product count differs from its plan functions")
    if len(references) != 0 and len(references) != len(functions):
        return Err("native-interface product references differ from its plan functions")
    mut stored_references: list[list[StoredReference]] = []
    for index in range(len(functions)):
        mut stored: list[StoredReference] = []
        if len(references) != 0:
            for reference in references[index]:
                stored.append(StoredReference(kind=reference.kind, index=reference.index, name=reference.name))
        stored_references.append(stored)
    stored = StoredPlan(
        schema=3, functions=functions, references=stored_references, runtime=encode_runtime(plan.externals)?,
        programs=plan.programs, models=encode_models(plan.models)?, enums=encode_enums(plan.enums)?,
        zip_carriers=encode_zip_carriers(plan.zip_carriers)?,
        file=str(plan.span.file), line=plan.span.line, column=plan.span.column,
    )
    encoded = to_string(stored).map_err((error) => str(error))?
    if decode_record_plan(encoded)? != plan.clone():
        return Err("native-interface codec changed complete native plan facts")
    return Ok(encoded)


pub def decode_record_plan(encoded: str) -> Result[Plan, str]:
    """Restore one exact bounded native plan without resolving names or lowering a body."""
    stored = read_plan(encoded).map_err((error) => str(error))?
    if stored.schema != 3 or len(stored.functions) == 0 or len(stored.references) != len(stored.functions):
        return Err("unsupported native-interface schema")
    mut functions: list[Function] = []
    for index in range(len(stored.functions)):
        mut references: list[NominalReference] = []
        for reference in stored.references[index]:
            references.append(NominalReference(kind=reference.kind, index=reference.index, name=reference.name))
        function, _demand = decode_product(stored.functions[index], references)?
        functions.append(function)
    return Ok(
        Plan(
            models=decode_models(stored.models)?, enums=decode_enums(stored.enums)?,
            functions=functions, externals=decode_runtime(stored.runtime)?, programs=stored.programs,
            zip_carriers=decode_zip_carriers(stored.zip_carriers)?,
            span=source_span(file=stored.file, line=stored.line, column=stored.column),
        ),
    )


pub def record_plan_products(encoded: str) -> Result[list[str], str]:
    """Expose the whole interface's ordered function contributions for byte-equivalence checks."""
    return Ok(read_plan(encoded).map_err((error) => str(error))?.functions)


def interface_nominals(plan: &Plan, references: list[NominalReference]) -> Result[list[ProductNominal], str]:
    """Name each referenced interface declaration by its native declaration name."""
    mut nominals: list[ProductNominal] = []
    for reference in references:
        if reference.kind == NominalKind.Model:
            if reference.index < 0 or reference.index >= len(plan.models):
                return Err("native-interface function names a missing model")
            name = plan.models[reference.index].name
            nominals.append(ProductNominal(kind=reference.kind, identity=name, digest=name))
        else:
            if reference.index < 0 or reference.index >= len(plan.enums):
                return Err("native-interface function names a missing enum")
            name = plan.enums[reference.index].name
            nominals.append(ProductNominal(kind=reference.kind, identity=name, digest=name))
    return Ok(nominals)


def read_plan(encoded: str) -> Result[StoredPlan, JsonError]:
    """Bind the native generic decoder to the versioned interface model."""
    return from_str(encoded)
