"""Loss-check the complete native interface for ordinary programs through the existing function codec."""

from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from pub::internal_models.crumb_rows import ModelField, model_description, required_value
from pub::internal_models.graph_crumb_fields import decode_graph_row, encode_graph_row, integer, items, number, text, tuple_items
from pub::internal_models.plan_function_records import encode_entry_record
from _plan import Plan, ExternalFunction, Function
from _types import source_span
from function_records import encode_product, decode_product, encode_runtime, decode_runtime, product_nominals
from layout_records import encode_models, decode_models, encode_enums, decode_enums, encode_zip_carriers, decode_zip_carriers
from nominal_identities import NominalKind, NominalReference, ProductNominal


model StoredPlan:
    """Every nonempty field admitted by the bounded ordinary-program profile."""

    functions: list[str]
    references: list[list[NominalReference]]
    runtime: list[str]
    programs: list[str]
    models: list[str]
    enums: list[str]
    zip_carriers: list[str]
    file: str
    line: int
    column: int


pub def encode_entry_binding(entry: str, inputs: list[str]) -> Result[bytes, str]:
    """Bind the standalone entry under the same typed row the graph retains."""
    return encode_entry_record(entry, inputs)


pub def encode_record_plan(plan: &Plan) -> Result[bytes, str]:
    """
    Encode one complete plan or explicitly refuse a field the codec cannot preserve.

    Each function's product names its models and enums by their interface declaration names.
    """
    mut functions: list[str] = []
    mut references: list[list[NominalReference]] = []
    empty_runtime: list[ExternalFunction] = []
    for index in range(len(plan.functions)):
        named = product_nominals(plan.functions[index], empty_runtime)?
        functions.append(encode_product(plan.functions[index], empty_runtime, interface_nominals(plan, named)?)?)
        references.append(named)
    return encode_record_plan_products(plan, functions, references)


pub def encode_record_plan_products(
    plan: &Plan,
    functions: list[str],
    references: list[list[NominalReference]] = [],
) -> Result[bytes, str]:
    """
    Encode a complete interface while retaining its keyed function-product bytes in declaration order.

    A product's runtime list is the lowering demand its declaration recorded. The unit's resolved runtime inventory is
    a separate interface field, so a keyed product never carries another declaration's requirements. A product names
    declarations, never positions; `references` binds each product's ordinals to this interface's own tables, and is
    empty only when no product names a model or enum.
    """
    counts: list[int] = [
        len(plan.statics), len(plan.exports), len(plan.tests), len(plan.generic_models), len(plan.generic_enums),
    ]
    fields = ["statics", "exports", "tests", "generic models", "generic enums"]
    for index in range(len(counts)):
        if counts[index] != 0:
            return Err(f"native-interface refuses {fields[index]}: {counts[index]}")
    if len(plan.functions) == 0:
        return Err("native-interface refuses an empty plan")
    if len(functions) != len(plan.functions):
        return Err("native-interface product count differs from its plan functions")
    if len(references) != 0 and len(references) != len(functions):
        return Err("native-interface product references differ from its plan functions")
    mut stored_references: list[list[NominalReference]] = references
    if len(stored_references) == 0:
        for _ in functions:
            stored_references.append([])
    stored = StoredPlan(
        functions=functions, references=stored_references, runtime=encode_runtime(plan.externals)?,
        programs=plan.programs, models=encode_models(plan.models)?, enums=encode_enums(plan.enums)?,
        zip_carriers=encode_zip_carriers(plan.zip_carriers)?,
        file=str(plan.span.file), line=plan.span.line, column=plan.span.column,
    )
    encoded = write_plan(stored)?
    if decode_record_plan(encoded)? != plan.clone():
        return Err("native-interface codec changed complete native plan facts")
    return Ok(encoded)


pub def decode_record_plan(encoded: bytes) -> Result[Plan, str]:
    """Restore one exact bounded native plan without resolving names or lowering a body."""
    stored = read_plan(encoded)?
    if len(stored.functions) == 0 or len(stored.references) != len(stored.functions):
        return Err("unsupported native-interface schema")
    mut functions: list[Function] = []
    for index in range(len(stored.functions)):
        function, _demand = decode_product(stored.functions[index], stored.references[index])?
        functions.append(function)
    return Ok(
        Plan(
            models=decode_models(stored.models)?, enums=decode_enums(stored.enums)?,
            functions=functions, externals=decode_runtime(stored.runtime)?, programs=stored.programs,
            zip_carriers=decode_zip_carriers(stored.zip_carriers)?,
            span=source_span(file=stored.file, line=stored.line, column=stored.column),
        ),
    )


pub def record_plan_products(encoded: bytes) -> Result[list[str], str]:
    """Expose the whole interface's ordered function contributions for byte-equivalence checks."""
    return Ok(read_plan(encoded)?.functions)


def interface_nominals(plan: &Plan, references: list[NominalReference]) -> Result[list[ProductNominal], str]:
    """Name each referenced interface declaration by its native declaration name."""
    mut nominals: list[ProductNominal] = []
    for reference in references:
        if reference.kind == NominalKind.Model:
            if reference.index < 0 or reference.index >= len(plan.models):
                return Err("native-interface function names a missing model")
            name = plan.models[reference.index].name
            nominals.append(ProductNominal(kind=reference.kind, identity=name, digest=name))
        else:
            if reference.index < 0 or reference.index >= len(plan.enums):
                return Err("native-interface function names a missing enum")
            name = plan.enums[reference.index].name
            nominals.append(ProductNominal(kind=reference.kind, identity=name, digest=name))
    return Ok(nominals)


def plan_description() -> Description:
    """A unit interface preserves all native tables, reference ordinals and the plan's diagnostic span."""
    return model_description(b"mirpln\x00", "incan.native-plan/4", [
        ModelField(identity=b"enums_", name="enums", storage="list<string>"),
        ModelField(identity=b"functs", name="functions", storage="list<string>"),
        ModelField(identity=b"models", name="models", storage="list<string>"),
        ModelField(identity=b"progra", name="programs", storage="list<string>"),
        ModelField(identity=b"refers", name="references", storage="list<list<tuple<string,i64,string>>>"),
        ModelField(identity=b"runtim", name="runtime", storage="list<string>"),
        ModelField(identity=b"span__", name="span", storage="tuple<string,i64,i64>"),
        ModelField(identity=b"zipcar", name="zip_carriers", storage="list<string>"),
    ])


def text_list(values: list[str]) -> Value:
    """Keep table order and each element's exact bytes of UTF-8 text."""
    return Value.List([Value.Text(value) for value in values])


def read_text_list(value: Value) -> Result[list[str], str]:
    """Read one ordered textual table without coercing or dropping a field."""
    mut values: list[str] = []
    for element in items(value)?:
        values.append(text(element)?)
    return Ok(values)


def write_plan(plan: StoredPlan) -> Result[bytes, str]:
    """Serialize each independently typed native table with its full ordinal and position information."""
    mut groups: list[Value] = []
    for references in plan.references:
        mut members: list[Value] = []
        for reference in references:
            kind = "model" if reference.kind == NominalKind.Model else "enum"
            members.append(Value.Tuple([Value.Text(kind), integer(reference.index), Value.Text(reference.name)]))
        groups.append(Value.List(members))
    return encode_graph_row(b"mirpln\x00", plan_description(), [
        required_value(b"enums_", text_list(plan.enums)),
        required_value(b"functs", text_list(plan.functions)),
        required_value(b"models", text_list(plan.models)),
        required_value(b"progra", text_list(plan.programs)),
        required_value(b"refers", Value.List(groups)),
        required_value(b"runtim", text_list(plan.runtime)),
        required_value(b"span__", Value.Tuple([Value.Text(plan.file), integer(plan.line), integer(plan.column)])),
        required_value(b"zipcar", text_list(plan.zip_carriers)),
    ])


def read_plan(encoded: bytes) -> Result[StoredPlan, str]:
    """Admit the whole interface before selecting carriers, functions and declarations by their original positions."""
    fields = decode_graph_row(encoded, b"mirpln\x00", plan_description(), 8)?
    mut references: list[list[NominalReference]] = []
    for group in items(fields[4].value)?:
        mut members: list[NominalReference] = []
        for member in items(group)?:
            part = tuple_items(member, 3)?
            kind = match text(part[0])?:
                "model" => NominalKind.Model
                "enum" => NominalKind.Enum
                _ => return Err("invalid native interface nominal kind")
            members.append(NominalReference(kind=kind, index=number(part[1])?, name=text(part[2])?))
        references.append(members)
    span = tuple_items(fields[6].value, 3)?
    return Ok(StoredPlan(enums=read_text_list(fields[0].value)?, functions=read_text_list(fields[1].value)?,
        models=read_text_list(fields[2].value)?, programs=read_text_list(fields[3].value)?, references=references,
        runtime=read_text_list(fields[5].value)?, file=text(span[0])?, line=number(span[1])?, column=number(span[2])?,
        zip_carriers=read_text_list(fields[7].value)?))
