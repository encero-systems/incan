    if identity == b"\x9f\x1b#{]\xc3" and len(fields) == 1:
        return Ok(StoredUnwind.Cleanup(number(fields[0].value)?))
    if identity == b"\xf9\x13\xf0\x92\x10\xe8" and len(fields) == 0:
        return Ok(StoredUnwind.Terminate)
    return Err("unknown or incomplete StoredUnwind alternative")
