def wire_stored_exit(value: StoredExit) -> Value:
    match value:
        StoredExit.Goto(field0) => return Value.Enum(b"\xf1\x07\x91\x11\xa1\xc1", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredExit.Switch(field0, field1, field2) => return Value.Enum(b"9\x92\x1at\x0b\xf2", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_operand(field0)), required_value(b"k\x86\xb2s\xff4", wire_integer(field1)), required_value(b"\xd4s^:&^", wire_integer(field2))])
        StoredExit.Call(field0, field1, field2, field3, field4, field5) => return Value.Enum(b"\xd6\xe6E\xb7\xd2\xb2", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_target(field0)), required_value(b"k\x86\xb2s\xff4", wire_stored_span(field1)), required_value(b"\xd4s^:&^", Value.List([wire_stored_operand(item0) for item0 in field2])), required_value(b"N\x07@\x85b\xbe", wire_stored_place(field3)), required_value(b"K\x22ww\xd4\xdd", wire_integer(field4)), required_value(b"\xef-\x12}\xe3{", wire_stored_unwind(field5))])
        StoredExit.Drop(field0, field1, field2) => return Value.Enum(b"\xc8\xaf\x9a\xe3zH", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_place(field0)), required_value(b"k\x86\xb2s\xff4", wire_integer(field1)), required_value(b"\xd4s^:&^", wire_stored_unwind(field2))])
        StoredExit.Overflow(field0, field1, field2, field3, field4, field5) => return Value.Enum(b"\x17\xb8\xdc\xf5>K", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_operand(field0)), required_value(b"k\x86\xb2s\xff4", wire_integer(field1)), required_value(b"\xd4s^:&^", wire_stored_operand(field2)), required_value(b"N\x07@\x85b\xbe", wire_stored_operand(field3)), required_value(b"K\x22ww\xd4\xdd", wire_integer(field4)), required_value(b"\xef-\x12}\xe3{", wire_stored_unwind(field5))])
        StoredExit.Return => return Value.Enum(b"k\x01C\xd08d", [])
        StoredExit.Unreachable => return Value.Enum(b"\xab\xaaF\xad\xb4\xe1", [])
        StoredExit.Resume => return Value.Enum(b"\xd6@\xc7B\x1d\xa0", [])


def read_wire_stored_exit(value: Value, positions: &WirePositions) -> Result[StoredExit, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\xf1\x07\x91\x11\xa1\xc1" and len(fields) == 1:
        return Ok(StoredExit.Goto(number(fields[0].value)?))
    if identity == b"9\x92\x1at\x0b\xf2" and len(fields) == 3:
        return Ok(StoredExit.Switch(read_wire_stored_operand(fields[0].value, positions)?, number(fields[1].value)?, number(fields[2].value)?))
    if identity == b"\xd6\xe6E\xb7\xd2\xb2" and len(fields) == 6:
        return Ok(StoredExit.Call(read_wire_stored_target(fields[2].value, positions)?, read_wire_stored_span(fields[3].value, positions)?, [read_wire_stored_operand(item0, positions)? for item0 in items(fields[4].value)?], read_wire_stored_place(fields[1].value, positions)?, number(fields[0].value)?, read_wire_stored_unwind(fields[5].value, positions)?))
