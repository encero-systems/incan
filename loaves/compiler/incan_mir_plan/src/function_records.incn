        return Ok(StoredExit.Drop(read_wire_stored_place(fields[0].value, positions)?, number(fields[1].value)?, read_wire_stored_unwind(fields[2].value, positions)?))
    if identity == b"\x17\xb8\xdc\xf5>K" and len(fields) == 6:
        return Ok(StoredExit.Overflow(read_wire_stored_operand(fields[2].value, positions)?, number(fields[3].value)?, read_wire_stored_operand(fields[4].value, positions)?, read_wire_stored_operand(fields[1].value, positions)?, number(fields[0].value)?, read_wire_stored_unwind(fields[5].value, positions)?))
    if identity == b"k\x01C\xd08d" and len(fields) == 0:
        return Ok(StoredExit.Return)
    if identity == b"\xab\xaaF\xad\xb4\xe1" and len(fields) == 0:
        return Ok(StoredExit.Unreachable)
    if identity == b"\xd6@\xc7B\x1d\xa0" and len(fields) == 0:
        return Ok(StoredExit.Resume)
    return Err("unknown or incomplete StoredExit alternative")


