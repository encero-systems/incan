        return Ok(StoredTarget.CloneEnum(number(fields[0].value)?))
    if identity == b"\x81@\xe21\x84\x11" and len(fields) == 2:
        return Ok(StoredTarget.ClosureBody(text(fields[0].value)?, number(fields[1].value)?))
    if identity == b"q9EI8$" and len(fields) == 2:
        return Ok(StoredTarget.ClosureBodyOnce(text(fields[0].value)?, number(fields[1].value)?))
