    if identity == b"\xc4i\xacQ\xb1\x89" and len(fields) == 1:
        return Ok(StoredTarget.CallClosureOnce([read_wire_stored_type(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"\xa3C\xf89\x18\xe2" and len(fields) == 1:
        return Ok(StoredTarget.CallBorrowingClosure([read_wire_stored_type(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"\xd76^\xdcH\xed" and len(fields) == 1:
        return Ok(StoredTarget.SharedCallableBody([read_wire_stored_type(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"\x07\xb9v\xcd\xac\xf6" and len(fields) == 1:
        return Ok(StoredTarget.CloneClosure([read_wire_stored_type(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"\x8e7\x95=#\xda" and len(fields) == 1:
