def read_wire_stored_target(value: Value, positions: &WirePositions) -> Result[StoredTarget, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\xfbo|\x93\xe6\xbf" and len(fields) == 1:
        return Ok(StoredTarget.Planned(text(fields[0].value)?))
    if identity == b"h\xc1\x14\xea\x9c\x8c" and len(fields) == 1:
        return Ok(StoredTarget.External(text(fields[0].value)?))
    if identity == b"\x12\xfds\xf8Q\xe0" and len(fields) == 2:
        return Ok(StoredTarget.Instantiated(text(fields[0].value)?, [read_wire_stored_type(item0, positions)? for item0 in items(fields[1].value)?]))
