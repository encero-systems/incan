"""
Round-trip complete native functions through the plan owner's explicitly bounded product codec.

A product stores every plan type through the layout type codec, with each model and enum position replaced by a
product-local ordinal. The product names each ordinal's declaration by stable identity, so it never retains a
position in the unit's tables.
"""

from rust::serde import Serialize, Deserialize
from rust::serde_json import to_string, from_str, Error as JsonError
from _plan import ExternalFunction, Function
from _types import PlanType, SourceSpan, source_span
from layout_type_records import StoredLayoutPlanType, retain_plan_type, restore_plan_type
from nominal_identities import (
    NominalReference,
    NominalRemap,
    ProductNominal,
    binding_remap,
    capture_remap,
    preserving_remap,
    remap_type,
)
from _body import (
    BasicBlock,
    BinaryOp,
    Callee,
    CalleeKind,
    Constant,
    Local,
    Operand,
    OperandKind,
    Parameter,
    Place,
    Projection,
    Rvalue,
    RvalueKind,
    Statement,
    StatementKind,
    Terminator,
    TerminatorKind,
    UnaryOp,
    Unwind,
)


@derive(Serialize, Deserialize)
model StoredSpan:
    """Portable source provenance without serializing the shared file handle's allocation."""

    file: str
    line: int
    column: int


@derive(Serialize, Deserialize)
model StoredPlace:
    """One scalar local and its exact whole-value or checked-arithmetic projection."""

    local: int
    projection: int
    span: StoredSpan


@derive(Serialize, Deserialize)
enum StoredConstant:
    """The exact primitive and borrowed static text literals admitted by this codec."""

    Int(int)
    Float(float)
    Bool(bool)
    Unit
    Text(str)


@derive(Serialize, Deserialize)
enum StoredRead:
    """Retain explicit ownership intent rather than infer it when restoring an operand."""

    Copy(StoredPlace)
    Move(StoredPlace)
    Literal(StoredConstant)


@derive(Serialize, Deserialize)
model StoredOperand:
    """One native operand and its original diagnostic location."""

    kind: StoredRead
    span: StoredSpan


@derive(Serialize, Deserialize)
enum StoredRvalue:
    """Self-contained scalar and formatting-frame operations; any operation with external context refuses capture."""

    Use(StoredOperand)
    Binary(int, StoredOperand, StoredOperand)
    Unary(int, StoredOperand)
    IntToFloat(StoredOperand)
    FloatToInt(StoredOperand)
    BoolToInt(StoredOperand)
    Array(list[StoredOperand])
    Borrow(StoredPlace)
    UnsizeSlice(StoredOperand)


@derive(Serialize, Deserialize)
enum StoredStatementKind:
    """Exact scalar assignment and storage-lifetime operations."""

    Assign(StoredPlace, StoredRvalue, StoredSpan)
    Live(int)
    Dead(int)


@derive(Serialize, Deserialize)
model StoredStatement:
    """Keep the statement's location independently of its value and destination."""

    kind: StoredStatementKind
    span: StoredSpan


@derive(Serialize, Deserialize)
enum StoredUnwind:
    """Exact cleanup control flow for scalar overflow assertions."""

    Continue
    Cleanup(int)
    Terminate


@derive(Serialize, Deserialize)
enum StoredExit:
    """Scalar/text control flow, direct calls and explicit drops; coroutines refuse this codec."""

    Goto(int)
    Switch(StoredOperand, int, int)
    Call(StoredTarget, StoredSpan, list[StoredOperand], StoredPlace, int, StoredUnwind)
    Drop(StoredPlace, int, StoredUnwind)
    Overflow(StoredOperand, int, StoredOperand, StoredOperand, int, StoredUnwind)
    Return
    Unreachable
    Resume


@derive(Serialize, Deserialize)
enum StoredTarget:
    """Retain direct dependency targets and checked instantiations without resolving their names or types again."""

    Planned(str)
    External(str)
    Instantiated(str, list[StoredType])


@derive(Serialize, Deserialize)
enum StoredType:
    """
    Incan-facing scalar and text shapes; native carrier spelling stays behind this adapter.

    Any other carrier is retained through the layout type codec, with product-local model and enum ordinals.
    """

    Int
    Float
    Bool
    Unit
    CheckedInt
    Never
    Text
    LiteralTextView
    TextView
    TextValues(int)
    LiteralTextValues(int)
    TextValuesView(int)
    LiteralTextValuesView(int)
    TextSequence
    LiteralTextSequence
    Layout(StoredLayoutPlanType)


@derive(Serialize, Deserialize)
model StoredBlock:
    """One complete native scalar block, including cleanup status and terminator provenance."""

    statements: list[StoredStatement]
    exit: StoredExit
    exit_span: StoredSpan
    cleanup: bool
    span: StoredSpan


@derive(Serialize, Deserialize)
model StoredSlot:
    """A native local's layout type, with product-local nominal ordinals, and diagnostic source position."""

    ty: StoredType
    span: StoredSpan


@derive(Serialize, Deserialize)
model StoredParameter:
    """A named parameter whose exact native slot is retained in declaration order."""

    name: str
    slot: StoredSlot


@derive(Serialize, Deserialize)
model StoredFunction:
    """A versioned complete ordinary function; unsupported native attributes and instances refuse."""

    schema: int
    name: str
    parameters: list[StoredParameter]
    result: StoredType
    locals: list[StoredSlot]
    blocks: list[StoredBlock]
    span: StoredSpan
    lifetimes: list[list[str]]
    retained_result_source: int


@derive(Serialize, Deserialize)
model StoredExternal:
    """Every field of one dependency signature used by a retained function."""

    path: str
    arguments: list[StoredType]
    parameters: list[StoredType]
    result: StoredType
    span: StoredSpan


@derive(Serialize, Deserialize)
model StoredProduct:
    """
    A complete function and its dependency requirements, authenticated together by the store owner.

    `nominals` names, for each product-local ordinal in first-seen order, the model or enum declaration it stands for.
    """

    schema: int
    function: str
    runtime: list[StoredExternal]
    nominals: list[ProductNominal]


pub def product_nominals(function: &Function, runtime: &list[ExternalFunction]) -> Result[list[NominalReference], str]:
    """Name the unit positions a product of this function would retain, in the product's first-seen ordinal order."""
    mut remap = capture_remap()
    _stored = stored_product(function, runtime, remap)?
    return Ok(remap.references)


pub def encode_product(
    function: &Function,
    runtime: &list[ExternalFunction],
    nominals: list[ProductNominal] = [],
) -> Result[str, str]:
    """
    Retain a complete function and its dependency requirements, naming every model and enum by declaration identity.

    1. Loss-check the function and encode every external signature field with product-local nominal ordinals.
    2. Require one declaration identity for each ordinal, in first-seen order.
    3. Restore the product at the captured positions and require exact equality before publication.
    """
    # 1. Unsupported carriers still refuse capture rather than omit dependency facts.
    mut remap = capture_remap()
    mut stored = stored_product(function, runtime, remap)?
    # 2. An ordinal without an identity would only be meaningful in the producing unit.
    if len(nominals) != len(remap.references):
        return Err("plan product names a model or enum without a declaration identity")
    for ordinal in range(len(nominals)):
        if nominals[ordinal].kind != remap.references[ordinal].kind:
            return Err("plan product declaration identity names another table")
    stored.nominals = nominals
    text = to_string(stored).map_err((error) => str(error))?
    # 3. Requirements and positions are part of the native product, not an assumed side effect of lowering again.
    restored_function, restored = decode_product(text, remap.references)?
    if not same_function(restored_function, function):
        return Err("scalar function product round trip changed native facts")
    if not same_runtime(restored, runtime):
        return Err("native product round trip changed its dependency requirements")
    return Ok(text)


pub def product_identities(text: str) -> Result[list[ProductNominal], str]:
    """Read the declarations a product names, so its consumer can resolve each one in the current unit."""
    stored = decode_product_record(text).map_err((error) => str(error))?
    if stored.schema != 4:
        return Err("unknown native product schema")
    return Ok(stored.nominals)


pub def decode_product(
    text: str,
    references: list[NominalReference] = [],
) -> Result[tuple[Function, list[ExternalFunction]], str]:
    """
    Restore both parts of a native product without repeating dependency selection.

    1. Decode and validate the producer's private schema.
    2. Bind each product-local ordinal to the unit position its consumer resolved for that declaration.
    3. Restore the complete function and every dependency signature.
    """
    # 1. An unknown schema remains an ordinary cache miss at the store boundary.
    stored = decode_product_record(text).map_err((error) => str(error))?
    if stored.schema != 4:
        return Err("unknown native product schema")
    # 2. The consumer resolves declarations; this codec only checks that every ordinal has a position.
    if len(references) != len(stored.nominals):
        return Err("plan product declaration identities differ from their resolved positions")
    for ordinal in range(len(references)):
        if references[ordinal].kind != stored.nominals[ordinal].kind:
            return Err("plan product resolved a declaration in another table")
    mut remap = binding_remap(references)
    # 3. Both parts cross the private product boundary explicitly.
    function = decode_function(stored.function, remap)?
    mut restored: list[ExternalFunction] = []
    for value in stored.runtime:
        restored.append(restore_external(value, remap)?)
    return Ok((function, restored))


pub def encode_runtime(runtime: &list[ExternalFunction]) -> Result[list[str], str]:
    """Encode a unit's resolved runtime inventory, loss-checked; its positions index the unit's own tables."""
    mut remap = preserving_remap()
    mut encoded: list[str] = []
    for value in runtime:
        encoded.append(to_string(store_external(value, remap)?).map_err((error) => str(error))?)
    if not same_runtime(decode_runtime(encoded)?, runtime):
        return Err("native runtime inventory round trip changed its signatures")
    return Ok(encoded)


pub def decode_runtime(encoded: list[str]) -> Result[list[ExternalFunction], str]:
    """Restore a unit's resolved runtime inventory in its recorded order."""
    mut remap = preserving_remap()
    mut runtime: list[ExternalFunction] = []
    for text in encoded:
        runtime.append(restore_external(decode_external_record(text).map_err((error) => str(error))?, remap)?)
    return Ok(runtime)


pub def encode_scalar(function: &Function) -> Result[str, str]:
    """Retain one complete function that names no model or enum; the enclosing product retains its requirements."""
    mut remap = capture_remap()
    text = encode_function(function, remap)?
    if len(remap.references) != 0:
        return Err("a bare function record refuses models and enums; retain it as a product")
    # A loss in any native field refuses capture instead of becoming an accepted cache hit.
    restored = decode_scalar(text)?
    if not same_function(restored, function):
        return Err("scalar function product round trip changed native facts")
    return Ok(text)


pub def decode_scalar(text: str) -> Result[Function, str]:
    """Restore a bare function record, which names no model or enum."""
    references: list[NominalReference] = []
    mut remap = binding_remap(references)
    return decode_function(text, remap)


def stored_product(
    function: &Function,
    runtime: &list[ExternalFunction],
    mut remap: NominalRemap,
) -> Result[StoredProduct, str]:
    """Encode the function and then its requirements, assigning nominal ordinals in that first-seen order."""
    encoded = encode_function(function, remap)?
    mut externals: list[StoredExternal] = []
    for value in runtime:
        externals.append(store_external(value, remap)?)
    nominals: list[ProductNominal] = []
    return Ok(StoredProduct(schema=4, function=encoded, runtime=externals, nominals=nominals))


def encode_function(function: &Function, mut remap: NominalRemap) -> Result[str, str]:
    """
    Encode one complete function's native storage, control flow and source locations.

    1. Refuse attributes, coroutine state and generic loan provenance this codec cannot preserve.
    2. Encode every plan field explicitly, translating nominal positions through `remap`.
    """
    # 1. No invocation-only function field may disappear through a default during replay.
    if function.is_async or function.future_callee is not None:
        return Err("scalar function products refuse coroutine state")
    if len(function.attributes) != 0 or len(function.generic_loans) != 0:
        return Err("scalar function products refuse attributes and generic loans")
    # 2. Every plan field crosses the codec explicitly.
    mut parameters: list[StoredParameter] = []
    for value in function.parameters:
        parameters.append(store_parameter(value, remap)?)
    mut slots: list[StoredSlot] = []
    for value in function.locals:
        slots.append(store_slot(value.ty, value.span, remap)?)
    mut blocks: list[StoredBlock] = []
    for value in function.blocks:
        blocks.append(store_block(value, remap)?)
    stored = StoredFunction(
        schema=4,
        name=function.name,
        parameters=parameters,
        result=store_type(function.return_type, remap)?,
        locals=slots,
        blocks=blocks,
        span=store_span(function.span),
        lifetimes=function.signature_lifetimes,
        retained_result_source=function.retained_result_source,
    )
    return to_string(stored).map_err((error) => str(error))


def decode_function(text: str, mut remap: NominalRemap) -> Result[Function, str]:
    """
    Restore a function only from a recognized complete record.

    1. Decode the producer's versioned wire record.
    2. Restore its exact native fields and source locations, binding nominal ordinals through `remap`.
    """
    # 1. Malformed or unfamiliar records are cache misses at the caller.
    stored = decode_record(text).map_err((error) => str(error))?
    if stored.schema != 4:
        return Err("unknown scalar function product schema")
    # 2. Native attributes, coroutine fields and generic loans were refused by the producer.
    mut parameters: list[Parameter] = []
    for value in stored.parameters:
        parameters.append(restore_parameter(value, remap)?)
    mut slots: list[Local] = []
    for value in stored.locals:
        slots.append(Local(ty=restore_type(value.ty, remap)?, span=restore_span(value.span)))
    mut blocks: list[BasicBlock] = []
    for value in stored.blocks:
        blocks.append(restore_block(value, remap)?)
    return Ok(
        Function(
            name=stored.name,
            parameters=parameters,
            return_type=restore_type(stored.result, remap)?,
            locals=slots,
            blocks=blocks,
            span=restore_span(stored.span),
            signature_lifetimes=stored.lifetimes,
            retained_result_source=stored.retained_result_source,
        ),
    )


def store_parameter(value: Parameter, mut remap: NominalRemap) -> Result[StoredParameter, str]:
    """Retain the parameter name, layout type and independent source provenance."""
    return Ok(StoredParameter(name=value.name, slot=store_slot(value.ty, value.span, remap)?))


def restore_parameter(value: StoredParameter, mut remap: NominalRemap) -> Result[Parameter, str]:
    """Restore one complete parameter in its original declaration order."""
    return Ok(Parameter(name=value.name, ty=restore_type(value.slot.ty, remap)?, span=restore_span(value.slot.span)))


def same_function(left: &Function, right: &Function) -> bool:
    """Compare borrowed complete native functions without copying either plan."""
    return left == right


def decode_record(text: str) -> Result[StoredFunction, JsonError]:
    """Give the native serde decoder its expected wire type through the ordinary return contract."""
    return from_str(text)


def decode_product_record(text: str) -> Result[StoredProduct, JsonError]:
    """Give the existing serde decoder the complete product's expected wire type."""
    return from_str(text)


def decode_external_record(text: str) -> Result[StoredExternal, JsonError]:
    """Give the existing serde decoder one runtime signature's expected wire type."""
    return from_str(text)


def same_runtime(left: &list[ExternalFunction], right: &list[ExternalFunction]) -> bool:
    """Compare borrowed dependency records individually; collection equality currently loses its shared read."""
    if len(left) != len(right):
        return false
    for index in range(len(left)):
        if not same_external(left[index], right[index]):
            return false
    return true


def same_external(left: &ExternalFunction, right: &ExternalFunction) -> bool:
    """Compare every field through the plan owner's structural equality without copying either record."""
    return left == right


def store_external(value: ExternalFunction, mut remap: NominalRemap) -> Result[StoredExternal, str]:
    """Retain the Incan binding identity; the native adapter keeps its implementation path private."""
    return Ok(
        StoredExternal(
            path=store_binding(value.path)?,
            arguments=store_types(value.type_arguments, remap)?,
            parameters=store_types(value.parameters, remap)?,
            result=store_type(value.return_type, remap)?,
            span=store_span(value.span),
        ),
    )


def restore_external(value: StoredExternal, mut remap: NominalRemap) -> Result[ExternalFunction, str]:
    """Select the native implementation only after the Incan-facing record has been accepted."""
    return Ok(
        ExternalFunction(
            path=restore_binding(value.path)?,
            type_arguments=restore_types(value.arguments, remap)?,
            parameters=restore_types(value.parameters, remap)?,
            return_type=restore_type(value.result, remap)?,
            span=restore_span(value.span),
        ),
    )


def store_binding(path: str) -> Result[str, str]:
    """Translate the bounded scalar adapter's implementation paths to stable Incan identities."""
    match path:
        "incan_native_runtime::initialize_panic_hook" => return Ok("builtin::runtime_initialize")
        "incan_native_runtime::println_text" => return Ok("builtin::print")
        _ => pass
    runtime = "incan_native_runtime::"
    primitives = "incan_std_primitives::"
    standard = "incan_stdlib::"
    if path.startswith(runtime):
        return Ok("builtin::runtime::" + path[len(runtime):])
    if path.startswith(primitives):
        return Ok("std::" + path[len(primitives):])
    if path.startswith(standard):
        return Ok("std::" + path[len(standard):])
    return Err("scalar function products refuse an external without an Incan binding identity")


def restore_binding(identity: str) -> Result[str, str]:
    """Select one native implementation for an admitted Incan binding identity at adapter time."""
    match identity:
        "builtin::runtime_initialize" => return Ok("incan_native_runtime::initialize_panic_hook")
        "builtin::print" => return Ok("incan_native_runtime::println_text")
        _ => pass
    runtime = "builtin::runtime::"
    standard = "std::"
    if identity.startswith(runtime):
        return Ok("incan_native_runtime::" + identity[len(runtime):])
    if identity.startswith(standard):
        # Standard-library scalar adapters are currently implemented by the primitives crate. The legacy fstring
        # target is the only pre-primitives identity still accepted by this bounded product schema.
        suffix = identity[len(standard):]
        if suffix == "fstring":
            return Ok("incan_stdlib::fstring")
        return Ok("incan_std_primitives::" + suffix)
    return Err("unknown Incan scalar binding identity")


def store_span(span: SourceSpan) -> StoredSpan:
    """Retain file text and both one-based coordinates without exposing an allocation identity."""
    return StoredSpan(file=str(span.file), line=span.line, column=span.column)


def restore_span(span: StoredSpan) -> SourceSpan:
    """Use the plan owner's shared-file constructor for restored diagnostic locations."""
    return source_span(file=span.file, line=span.line, column=span.column)


def store_slot(ty: PlanType, span: SourceSpan, mut remap: NominalRemap) -> Result[StoredSlot, str]:
    """Retain one local or parameter layout type with its independent diagnostic location."""
    return Ok(StoredSlot(ty=store_type(ty, remap)?, span=store_span(span)))


def store_type(ty: PlanType, mut remap: NominalRemap) -> Result[StoredType, str]:
    """
    Retain a complete layout type.

    Scalar and text carriers keep their Incan-facing spelling; every other carrier crosses the layout type codec with
    each model and enum position translated to its product-local ordinal.
    """
    match ty:
        PlanType.Int => return Ok(StoredType.Int)
        PlanType.Float => return Ok(StoredType.Float)
        PlanType.Bool => return Ok(StoredType.Bool)
        PlanType.Unit => return Ok(StoredType.Unit)
        PlanType.CheckedInt => return Ok(StoredType.CheckedInt)
        PlanType.Never => return Ok(StoredType.Never)
        PlanType.String => return Ok(StoredType.Text)
        PlanType.StrRef => return Ok(StoredType.LiteralTextView)
        PlanType.StringRef => return Ok(StoredType.TextView)
        PlanType.StringArray(length) => return Ok(StoredType.TextValues(length))
        PlanType.StrArray(length) => return Ok(StoredType.LiteralTextValues(length))
        PlanType.StringArrayRef(length) => return Ok(StoredType.TextValuesView(length))
        PlanType.StrArrayRef(length) => return Ok(StoredType.LiteralTextValuesView(length))
        PlanType.StringSlice => return Ok(StoredType.TextSequence)
        PlanType.StrSlice => return Ok(StoredType.LiteralTextSequence)
        _ => return Ok(StoredType.Layout(retain_plan_type(remap_type(ty, remap)?)?))


def restore_type(stored: StoredType, mut remap: NominalRemap) -> Result[PlanType, str]:
    """Restore the exact carrier, binding each product-local ordinal to its resolved unit position."""
    match stored:
        StoredType.Int => return Ok(PlanType.Int)
        StoredType.Float => return Ok(PlanType.Float)
        StoredType.Bool => return Ok(PlanType.Bool)
        StoredType.Unit => return Ok(PlanType.Unit)
        StoredType.CheckedInt => return Ok(PlanType.CheckedInt)
        StoredType.Never => return Ok(PlanType.Never)
        StoredType.Text => return Ok(PlanType.String)
        StoredType.LiteralTextView => return Ok(PlanType.StrRef)
        StoredType.TextView => return Ok(PlanType.StringRef)
        StoredType.TextValues(length) => return Ok(PlanType.StringArray(length))
        StoredType.LiteralTextValues(length) => return Ok(PlanType.StrArray(length))
        StoredType.TextValuesView(length) => return Ok(PlanType.StringArrayRef(length))
        StoredType.LiteralTextValuesView(length) => return Ok(PlanType.StrArrayRef(length))
        StoredType.TextSequence => return Ok(PlanType.StringSlice)
        StoredType.LiteralTextSequence => return Ok(PlanType.StrSlice)
        StoredType.Layout(layout) => return remap_type(restore_plan_type(layout)?, remap)


def store_types(types: list[PlanType], mut remap: NominalRemap) -> Result[list[StoredType], str]:
    """Retain an ordered type list through one translation."""
    mut stored: list[StoredType] = []
    for ty in types:
        stored.append(store_type(ty, remap)?)
    return Ok(stored)


def restore_types(stored: list[StoredType], mut remap: NominalRemap) -> Result[list[PlanType], str]:
    """Restore an ordered type list through one translation."""
    mut types: list[PlanType] = []
    for value in stored:
        types.append(restore_type(value, remap)?)
    return Ok(types)


def store_place(place: Place) -> Result[StoredPlace, str]:
    """Preserve whole-local and checked-arithmetic projections; owner-dependent projections refuse."""
    mut projection = -1
    match place.projection:
        Projection.Whole => projection = 0
        Projection.Value => projection = 1
        Projection.Overflow => projection = 2
        _ => return Err("scalar function products refuse this native projection")
    return Ok(StoredPlace(local=place.local, projection=projection, span=store_span(place.span)))


def restore_place(place: StoredPlace) -> Result[Place, str]:
    """Restore the exact native scalar projection rather than infer it from a carrier."""
    mut projection = Projection.Whole
    match place.projection:
        0 => pass
        1 => projection = Projection.Value
        2 => projection = Projection.Overflow
        _ => return Err("unknown scalar projection tag")
    return Ok(Place(local=place.local, projection=projection, span=restore_span(place.span)))


def store_constant(value: Constant) -> Result[StoredConstant, str]:
    """Preserve ordinary scalar constants without narrowing integer digits or floating-point values."""
    match value:
        Constant.Int(value) => return Ok(StoredConstant.Int(value))
        Constant.Float(value) => return Ok(StoredConstant.Float(value))
        Constant.Bool(value) => return Ok(StoredConstant.Bool(value))
        Constant.Unit => return Ok(StoredConstant.Unit)
        Constant.Text(value) => return Ok(StoredConstant.Text(value))
        _ => return Err("scalar function products refuse this native constant")


def restore_constant(value: StoredConstant) -> Constant:
    """Recover the producer's exact scalar constant variant."""
    match value:
        StoredConstant.Int(value) => return Constant.Int(value)
        StoredConstant.Float(value) => return Constant.Float(value)
        StoredConstant.Bool(value) => return Constant.Bool(value)
        StoredConstant.Unit => return Constant.Unit
        StoredConstant.Text(value) => return Constant.Text(value)


def store_operand(operand: Operand) -> Result[StoredOperand, str]:
    """Retain the operand's ownership operation independently of its source position."""
    match operand.kind:
        OperandKind.Copy(place) =>
            return Ok(StoredOperand(kind=StoredRead.Copy(store_place(place)?), span=store_span(operand.span)))
        OperandKind.Move(place) =>
            return Ok(StoredOperand(kind=StoredRead.Move(store_place(place)?), span=store_span(operand.span)))
        OperandKind.Literal(value) =>
            return Ok(StoredOperand(kind=StoredRead.Literal(store_constant(value)?), span=store_span(operand.span)))


def restore_operand(operand: StoredOperand) -> Result[Operand, str]:
    """Restore explicit copy, move and literal reads without recomputing ownership."""
    span = restore_span(operand.span)
    match operand.kind:
        StoredRead.Copy(place) => return Ok(Operand(kind=OperandKind.Copy(restore_place(place)?), span=span))
        StoredRead.Move(place) => return Ok(Operand(kind=OperandKind.Move(restore_place(place)?), span=span))
        StoredRead.Literal(value) => return Ok(Operand(kind=OperandKind.Literal(restore_constant(value)), span=span))


def store_binary(operation: BinaryOp) -> int:
    """Encode the native operation by an explicit schema tag, independently of its display spelling."""
    match operation:
        BinaryOp.Add => return 0
        BinaryOp.Subtract => return 1
        BinaryOp.Multiply => return 2
        BinaryOp.Divide => return 3
        BinaryOp.Equal => return 4
        BinaryOp.NotEqual => return 5
        BinaryOp.Less => return 6
        BinaryOp.LessEqual => return 7
        BinaryOp.Greater => return 8
        BinaryOp.GreaterEqual => return 9
        BinaryOp.BitAnd => return 10
        BinaryOp.BitOr => return 11
        BinaryOp.BitXor => return 12
        BinaryOp.ShiftLeft => return 13
        BinaryOp.ShiftRight => return 14


def restore_binary(tag: int) -> Result[BinaryOp, str]:
    """Refuse unknown operation tags rather than map them to an approximate arithmetic operation."""
    match tag:
        0 => return Ok(BinaryOp.Add)
        1 => return Ok(BinaryOp.Subtract)
        2 => return Ok(BinaryOp.Multiply)
        3 => return Ok(BinaryOp.Divide)
        4 => return Ok(BinaryOp.Equal)
        5 => return Ok(BinaryOp.NotEqual)
        6 => return Ok(BinaryOp.Less)
        7 => return Ok(BinaryOp.LessEqual)
        8 => return Ok(BinaryOp.Greater)
        9 => return Ok(BinaryOp.GreaterEqual)
        10 => return Ok(BinaryOp.BitAnd)
        11 => return Ok(BinaryOp.BitOr)
        12 => return Ok(BinaryOp.BitXor)
        13 => return Ok(BinaryOp.ShiftLeft)
        14 => return Ok(BinaryOp.ShiftRight)
        _ => return Err("unknown scalar binary operation tag")


def store_unary(operation: UnaryOp) -> int:
    """Encode each ordinary native unary operation explicitly."""
    match operation:
        UnaryOp.Not => return 0
        UnaryOp.Negate => return 1
        UnaryOp.Invert => return 2


def restore_unary(tag: int) -> Result[UnaryOp, str]:
    """Decode only the unary operations defined by the private schema."""
    match tag:
        0 => return Ok(UnaryOp.Not)
        1 => return Ok(UnaryOp.Negate)
        2 => return Ok(UnaryOp.Invert)
        _ => return Err("unknown scalar unary operation tag")


def store_rvalue(value: RvalueKind) -> Result[StoredRvalue, str]:
    """Capture only self-contained operations whose operands and formatting storage are complete in this record."""
    match value:
        RvalueKind.Use(operand) => return Ok(StoredRvalue.Use(store_operand(operand)?))
        RvalueKind.Binary(op, left, right) =>
            return Ok(StoredRvalue.Binary(store_binary(op), store_operand(left)?, store_operand(right)?))
        RvalueKind.Unary(op, operand) => return Ok(StoredRvalue.Unary(store_unary(op), store_operand(operand)?))
        RvalueKind.IntToFloat(operand) => return Ok(StoredRvalue.IntToFloat(store_operand(operand)?))
        RvalueKind.FloatToInt(operand) => return Ok(StoredRvalue.FloatToInt(store_operand(operand)?))
        RvalueKind.BoolToInt(operand) => return Ok(StoredRvalue.BoolToInt(store_operand(operand)?))
        RvalueKind.Array(operands) => return Ok(StoredRvalue.Array([store_operand(value)? for value in operands]))
        RvalueKind.Borrow(place) => return Ok(StoredRvalue.Borrow(store_place(place)?))
        RvalueKind.UnsizeSlice(operand) => return Ok(StoredRvalue.UnsizeSlice(store_operand(operand)?))
        _ => return Err("scalar function products refuse this native operation")


def restore_rvalue(value: StoredRvalue) -> Result[RvalueKind, str]:
    """Recover the exact native operation; the checker and lowering's decisions are never repeated."""
    match value:
        StoredRvalue.Use(operand) => return Ok(RvalueKind.Use(restore_operand(operand)?))
        StoredRvalue.Binary(op, left, right) =>
            return Ok(RvalueKind.Binary(restore_binary(op)?, restore_operand(left)?, restore_operand(right)?))
        StoredRvalue.Unary(op, operand) => return Ok(RvalueKind.Unary(restore_unary(op)?, restore_operand(operand)?))
        StoredRvalue.IntToFloat(operand) => return Ok(RvalueKind.IntToFloat(restore_operand(operand)?))
        StoredRvalue.FloatToInt(operand) => return Ok(RvalueKind.FloatToInt(restore_operand(operand)?))
        StoredRvalue.BoolToInt(operand) => return Ok(RvalueKind.BoolToInt(restore_operand(operand)?))
        StoredRvalue.Array(operands) => return Ok(RvalueKind.Array([restore_operand(value)? for value in operands]))
        StoredRvalue.Borrow(place) => return Ok(RvalueKind.Borrow(restore_place(place)?))
        StoredRvalue.UnsizeSlice(operand) => return Ok(RvalueKind.UnsizeSlice(restore_operand(operand)?))


def store_statement(statement: Statement) -> Result[StoredStatement, str]:
    """Retain scalar assignments and explicit storage boundaries without dropping nested source spans."""
    span = store_span(statement.span)
    match statement.kind:
        StatementKind.Assign(place, value) =>
            kind = StoredStatementKind.Assign(store_place(place)?, store_rvalue(value.kind)?, store_span(value.span))
            return Ok(StoredStatement(kind=kind, span=span))
        StatementKind.StorageLive(local) => return Ok(StoredStatement(kind=StoredStatementKind.Live(local), span=span))
        StatementKind.StorageDead(local) => return Ok(StoredStatement(kind=StoredStatementKind.Dead(local), span=span))


def restore_statement(statement: StoredStatement) -> Result[Statement, str]:
    """Restore every scalar statement field, including the value's independent source location."""
    span = restore_span(statement.span)
    match statement.kind:
        StoredStatementKind.Assign(place, value, value_span) =>
            kind = StatementKind.Assign(
                restore_place(place)?,
                Rvalue(kind=restore_rvalue(value)?, span=restore_span(value_span)),
            )
            return Ok(Statement(kind=kind, span=span))
        StoredStatementKind.Live(local) => return Ok(Statement(kind=StatementKind.StorageLive(local), span=span))
        StoredStatementKind.Dead(local) => return Ok(Statement(kind=StatementKind.StorageDead(local), span=span))


def store_unwind(unwind: Unwind) -> StoredUnwind:
    """Retain each native unwind continuation exactly."""
    match unwind:
        Unwind.Continue => return StoredUnwind.Continue
        Unwind.Cleanup(block) => return StoredUnwind.Cleanup(block)
        Unwind.Terminate => return StoredUnwind.Terminate


def restore_unwind(unwind: StoredUnwind) -> Unwind:
    """Recover cleanup propagation without choosing a new unwind policy."""
    match unwind:
        StoredUnwind.Continue => return Unwind.Continue
        StoredUnwind.Cleanup(block) => return Unwind.Cleanup(block)
        StoredUnwind.Terminate => return Unwind.Terminate


def store_exit(exit: TerminatorKind, mut remap: NominalRemap) -> Result[StoredExit, str]:
    """Retain scalar/text branches, direct calls, explicit drops and overflow checks."""
    match exit:
        TerminatorKind.Goto(block) => return Ok(StoredExit.Goto(block))
        TerminatorKind.SwitchBool(operand, no, yes) => return Ok(StoredExit.Switch(store_operand(operand)?, no, yes))
        TerminatorKind.Call(callee, args, destination, target, unwind) =>
            return store_call(callee, args, destination, target, unwind, remap)
        TerminatorKind.Drop(place, target, unwind) =>
            return Ok(StoredExit.Drop(store_place(place)?, target, store_unwind(unwind)))
        TerminatorKind.AssertOverflow(flag, op, left, right, target, unwind) =>
            return Ok(
                StoredExit.Overflow(
                    store_operand(flag)?,
                    store_binary(op),
                    store_operand(left)?,
                    store_operand(right)?,
                    target,
                    store_unwind(unwind),
                ),
            )
        TerminatorKind.Return => return Ok(StoredExit.Return)
        TerminatorKind.Unreachable => return Ok(StoredExit.Unreachable)
        TerminatorKind.UnwindResume => return Ok(StoredExit.Resume)
        _ => return Err("scalar function products refuse this native terminator")


def restore_exit(exit: StoredExit, mut remap: NominalRemap) -> Result[TerminatorKind, str]:
    """Restore the producer's exact scalar branch and overflow control flow."""
    match exit:
        StoredExit.Goto(block) => return Ok(TerminatorKind.Goto(block))
        StoredExit.Switch(operand, no, yes) => return Ok(TerminatorKind.SwitchBool(restore_operand(operand)?, no, yes))
        StoredExit.Call(callee, span, args, destination, target, unwind) =>
            return restore_call(callee, span, args, destination, target, unwind, remap)
        StoredExit.Drop(place, target, unwind) =>
            return Ok(TerminatorKind.Drop(restore_place(place)?, target, restore_unwind(unwind)))
        StoredExit.Overflow(flag, op, left, right, target, unwind) =>
            return Ok(
                TerminatorKind.AssertOverflow(
                    restore_operand(flag)?,
                    restore_binary(op)?,
                    restore_operand(left)?,
                    restore_operand(right)?,
                    target,
                    restore_unwind(unwind),
                ),
            )
        StoredExit.Return => return Ok(TerminatorKind.Return)
        StoredExit.Unreachable => return Ok(TerminatorKind.Unreachable)
        StoredExit.Resume => return Ok(TerminatorKind.UnwindResume)


def store_call(
    callee: Callee,
    arguments: list[Operand],
    destination: Place,
    target: int,
    unwind: Unwind,
    mut remap: NominalRemap,
) -> Result[StoredExit, str]:
    """Retain every call field; its external requirements are separately retained by the complete product."""
    return Ok(
        StoredExit.Call(
            store_target(callee.kind, remap)?,
            store_span(callee.span),
            [store_operand(value)? for value in arguments],
            store_place(destination)?,
            target,
            store_unwind(unwind),
        ),
    )


def restore_call(
    callee: StoredTarget,
    span: StoredSpan,
    arguments: list[StoredOperand],
    destination: StoredPlace,
    target: int,
    unwind: StoredUnwind,
    mut remap: NominalRemap,
) -> Result[TerminatorKind, str]:
    """Restore the exact planned target, arguments, destination, successors and source provenance."""
    return Ok(
        TerminatorKind.Call(
            Callee(kind=restore_target(callee, remap)?, span=restore_span(span)),
            [restore_operand(value)? for value in arguments],
            restore_place(destination)?,
            target,
            restore_unwind(unwind),
        ),
    )


def store_target(target: CalleeKind, mut remap: NominalRemap) -> Result[StoredTarget, str]:
    """Retain direct dependency references and their already checked explicit type instantiations."""
    match target:
        CalleeKind.Planned(name) => return Ok(StoredTarget.Planned(name))
        CalleeKind.External(path) => return Ok(StoredTarget.External(store_binding(path)?))
        CalleeKind.Instantiated(path, arguments) =>
            return Ok(StoredTarget.Instantiated(store_binding(path)?, store_types(arguments, remap)?))
        _ => return Err("native products refuse dynamic or owner-dependent callees")


def restore_target(target: StoredTarget, mut remap: NominalRemap) -> Result[CalleeKind, str]:
    """Restore the exact reference kind, selecting its native implementation in this adapter."""
    match target:
        StoredTarget.Planned(name) => return Ok(CalleeKind.Planned(name))
        StoredTarget.External(identity) => return Ok(CalleeKind.External(restore_binding(identity)?))
        StoredTarget.Instantiated(identity, arguments) =>
            return Ok(CalleeKind.Instantiated(restore_binding(identity)?, restore_types(arguments, remap)?))


def store_block(block: BasicBlock, mut remap: NominalRemap) -> Result[StoredBlock, str]:
    """Retain the complete block, including its terminator and both block and exit locations."""
    return Ok(
        StoredBlock(
            statements=[store_statement(value)? for value in block.statements],
            exit=store_exit(block.terminator.kind, remap)?,
            exit_span=store_span(block.terminator.span),
            cleanup=block.cleanup,
            span=store_span(block.span),
        ),
    )


def restore_block(block: StoredBlock, mut remap: NominalRemap) -> Result[BasicBlock, str]:
    """Restore every block field without synthesizing control flow or source provenance."""
    return Ok(
        BasicBlock(
            statements=[restore_statement(value)? for value in block.statements],
            terminator=Terminator(kind=restore_exit(block.exit, remap)?, span=restore_span(block.exit_span)),
            cleanup=block.cleanup,
            span=restore_span(block.span),
        ),
    )
