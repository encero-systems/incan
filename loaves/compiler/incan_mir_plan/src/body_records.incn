pub def wire_stored_projection(value: StoredProjection) -> Value:
    match value:
        StoredProjection.Whole => return Value.Enum(b"\xfdU\x05`\x93\x8c", [])
        StoredProjection.Value => return Value.Enum(b"\x8e7\x95=#\xda", [])
        StoredProjection.Overflow => return Value.Enum(b"\x17\xb8\xdc\xf5>K", [])
        StoredProjection.NumericValue(field0) => return Value.Enum(b"\x04I\xf5\xd2N?", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_type(field0))])
        StoredProjection.VariantField(field0, field1, field2) => return Value.Enum(b"\xc0\x01\x8e\x9e\x9f\x16", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0)), required_value(b"k\x86\xb2s\xff4", wire_integer(field1)), required_value(b"\xd4s^:&^", wire_stored_type(field2))])
        StoredProjection.Field(field0, field1) => return Value.Enum(b"\xf4_\xc1\xdf\xdc\x96", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0)), required_value(b"k\x86\xb2s\xff4", wire_stored_type(field1))])
        StoredProjection.Deref(field0) => return Value.Enum(b"\x12/\x9b\xd7h\xa6", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_type(field0))])
        StoredProjection.DerefField(field0, field1) => return Value.Enum(b"\x84\xdd\xaa\x99\xf0\x90", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0)), required_value(b"k\x86\xb2s\xff4", wire_stored_type(field1))])
        StoredProjection.Fields(field0) => return Value.Enum(b"aoH\xc1\xdb\x19", [required_value(b"_\xec\xebf\xff\xc8", Value.List([wire_stored_field_step(item0) for item0 in field0]))])
        StoredProjection.DerefFields(field0) => return Value.Enum(b"g\x93\xd8#\xbc\xbe", [required_value(b"_\xec\xebf\xff\xc8", Value.List([wire_stored_field_step(item0) for item0 in field0]))])


pub def read_wire_stored_projection(value: Value, positions: &WirePositions) -> Result[StoredProjection, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\xfdU\x05`\x93\x8c" and len(fields) == 0:
        return Ok(StoredProjection.Whole)
    if identity == b"\x8e7\x95=#\xda" and len(fields) == 0:
        return Ok(StoredProjection.Value)
    if identity == b"\x17\xb8\xdc\xf5>K" and len(fields) == 0:
        return Ok(StoredProjection.Overflow)
    if identity == b"\x04I\xf5\xd2N?" and len(fields) == 1:
        return Ok(StoredProjection.NumericValue(read_wire_stored_type(fields[0].value, positions)?))
    if identity == b"\xc0\x01\x8e\x9e\x9f\x16" and len(fields) == 3:
        return Ok(StoredProjection.VariantField(number(fields[0].value)?, number(fields[1].value)?, read_wire_stored_type(fields[2].value, positions)?))
    if identity == b"\xf4_\xc1\xdf\xdc\x96" and len(fields) == 2:
        return Ok(StoredProjection.Field(number(fields[0].value)?, read_wire_stored_type(fields[1].value, positions)?))
    if identity == b"\x12/\x9b\xd7h\xa6" and len(fields) == 1:
        return Ok(StoredProjection.Deref(read_wire_stored_type(fields[0].value, positions)?))
    if identity == b"\x84\xdd\xaa\x99\xf0\x90" and len(fields) == 2:
        return Ok(StoredProjection.DerefField(number(fields[0].value)?, read_wire_stored_type(fields[1].value, positions)?))
    if identity == b"aoH\xc1\xdb\x19" and len(fields) == 1:
        return Ok(StoredProjection.Fields([read_wire_stored_field_step(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"g\x93\xd8#\xbc\xbe" and len(fields) == 1:
        return Ok(StoredProjection.DerefFields([read_wire_stored_field_step(item0, positions)? for item0 in items(fields[0].value)?]))
    return Err("unknown or incomplete StoredProjection alternative")


pub def wire_stored_read(value: StoredRead) -> Value:
    match value:
        StoredRead.Copy(field0) => return Value.Enum(b"\xe2\x1f\x93_\x11\xd7", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_place(field0))])
        StoredRead.Move(field0) => return Value.Enum(b"n\xcc=\xf6\xbf\xfd", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_place(field0))])
        StoredRead.Literal(field0) => return Value.Enum(b"\xa6#\x0c*\x81\xab", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_constant(field0))])


pub def read_wire_stored_read(value: Value, positions: &WirePositions) -> Result[StoredRead, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\xe2\x1f\x93_\x11\xd7" and len(fields) == 1:
        return Ok(StoredRead.Copy(read_wire_stored_place(fields[0].value, positions)?))
    if identity == b"n\xcc=\xf6\xbf\xfd" and len(fields) == 1:
        return Ok(StoredRead.Move(read_wire_stored_place(fields[0].value, positions)?))
    if identity == b"\xa6#\x0c*\x81\xab" and len(fields) == 1:
        return Ok(StoredRead.Literal(read_wire_stored_constant(fields[0].value, positions)?))
    return Err("unknown or incomplete StoredRead alternative")


pub def wire_stored_rvalue(value: StoredRvalue) -> Value:
