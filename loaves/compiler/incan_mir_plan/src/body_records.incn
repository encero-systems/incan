pub def read_wire_stored_rvalue(value: Value, positions: &WirePositions) -> Result[StoredRvalue, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\xc3m\x81\x9e{\xc6" and len(fields) == 1:
        return Ok(StoredRvalue.Use(read_wire_stored_operand(fields[0].value, positions)?))
