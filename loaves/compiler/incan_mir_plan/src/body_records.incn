    if identity == b"01\xa6\xb1\xeb^" and len(fields) == 1:
        return Ok(StoredRvalue.BoolToInt(read_wire_stored_operand(fields[0].value, positions)?))
    if identity == b"\xf0\xcf9\xd0\xbe>" and len(fields) == 1:
        return Ok(StoredRvalue.Array([read_wire_stored_operand(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b".\xdf\xb1h\xb3\x8b" and len(fields) == 1:
        return Ok(StoredRvalue.Borrow(read_wire_stored_place(fields[0].value, positions)?))
    if identity == b"\xecWL\xe3\xa7d" and len(fields) == 1:
        return Ok(StoredRvalue.UnsizeSlice(read_wire_stored_operand(fields[0].value, positions)?))
    if identity == b"\xdd\xb0\x0b=6\xb4" and len(fields) == 3:
        return Ok(StoredRvalue.NativeAlias(read_wire_stored_operand(fields[0].value, positions)?, read_wire_stored_type(fields[1].value, positions)?, read_wire_stored_type(fields[2].value, positions)?))
    if identity == b"\x0fAV\x17\xca$" and len(fields) == 1:
        return Ok(StoredRvalue.FrozenText(read_wire_stored_operand(fields[0].value, positions)?))
    if identity == b"\xa5\x1aU\xd1;\xee" and len(fields) == 1:
        return Ok(StoredRvalue.FrozenBytes([number(item0)? for item0 in items(fields[0].value)?]))
