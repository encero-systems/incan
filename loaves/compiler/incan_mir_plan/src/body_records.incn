pub def wire_stored_span(value: StoredSpan) -> Value:
    return Value.Record([
        required_value(b";\x9c5\x8f6\xf0", Value.Text(value.file)),
        required_value(b"8\xa9\xc1\xe7!X", wire_integer(value.line)),
        required_value(b"\x88\x1d_\xb6\x00\x90", wire_integer(value.column)),
    ])


pub def read_wire_stored_span(value: Value, positions: &WirePositions) -> Result[StoredSpan, str]:
    fields = wire_fields(value, 3)?
    file, line, column = positions.apply(text(fields[1].value)?, number(fields[0].value)?, number(fields[2].value)?)?
    return Ok(StoredSpan(file=file, line=line, column=column))


pub def wire_stored_statement(value: StoredStatement) -> Value:
    return Value.Record([
        required_value(b"\x0b'\xc1X\xfe\xb3", wire_stored_statement_kind(value.kind)),
        required_value(b"7\xa0\x02Z\xa1\xf2", wire_stored_span(value.span)),
    ])


pub def read_wire_stored_statement(value: Value, positions: &WirePositions) -> Result[StoredStatement, str]:
    fields = wire_fields(value, 2)?
    return Ok(StoredStatement(
        kind=read_wire_stored_statement_kind(fields[0].value, positions)?,
        span=read_wire_stored_span(fields[1].value, positions)?,
    ))


pub def wire_stored_statement_kind(value: StoredStatementKind) -> Value:
    match value:
        StoredStatementKind.Assign(field0, field1, field2) => return Value.Enum(b"\x8e\xce\x89\x5c\x9b2", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_place(field0)), required_value(b"k\x86\xb2s\xff4", wire_stored_rvalue(field1)), required_value(b"\xd4s^:&^", wire_stored_span(field2))])
        StoredStatementKind.Live(field0) => return Value.Enum(b"\xb6J\xc0_\x17\xe6", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredStatementKind.Dead(field0) => return Value.Enum(b"\xec\x9b\x10\xa4\xa7\x9c", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])


pub def read_wire_stored_statement_kind(value: Value, positions: &WirePositions) -> Result[StoredStatementKind, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\x8e\xce\x89\x5c\x9b2" and len(fields) == 3:
        return Ok(StoredStatementKind.Assign(read_wire_stored_place(fields[0].value, positions)?, read_wire_stored_rvalue(fields[1].value, positions)?, read_wire_stored_span(fields[2].value, positions)?))
    if identity == b"\xb6J\xc0_\x17\xe6" and len(fields) == 1:
        return Ok(StoredStatementKind.Live(number(fields[0].value)?))
    if identity == b"\xec\x9b\x10\xa4\xa7\x9c" and len(fields) == 1:
        return Ok(StoredStatementKind.Dead(number(fields[0].value)?))
    return Err("unknown or incomplete StoredStatementKind alternative")


pub def wire_stored_type(value: StoredType) -> Value:
    match value:
        StoredType.Int => return Value.Enum(b"\x0b_`\x80p\xc6", [])
        StoredType.Float => return Value.Enum(b"\x1ai<\x00\xc4\x0c", [])
        StoredType.Bool => return Value.Enum(b"I\xf4\x11\xf0\xa1\xa7", [])
        StoredType.Unit => return Value.Enum(b"NTY`\xf1\xbf", [])
        StoredType.CheckedInt => return Value.Enum(b"\xc3\xf45\xc7(Q", [])
        StoredType.Never => return Value.Enum(b"c\x00\xef\x80\x0b\xb8", [])
        StoredType.Text => return Value.Enum(b"q\x98\x8cM\x8e\x08", [])
        StoredType.LiteralTextView => return Value.Enum(b"\xd0Y?\xda\x9f\xb6", [])
        StoredType.TextView => return Value.Enum(b"pL \xb1\x8c\x8e", [])
        StoredType.TextValues(field0) => return Value.Enum(b"\xd1\xbf\xdd\xae\x10V", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredType.LiteralTextValues(field0) => return Value.Enum(b"\xf7\xbfU\x17\x8c\x06", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredType.TextValuesView(field0) => return Value.Enum(b"/\x98A\xdf\x82\x04", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredType.LiteralTextValuesView(field0) => return Value.Enum(b"\xe6Zg\x16y\x07", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0))])
        StoredType.TextSequence => return Value.Enum(b"\xdb\x01{)\xdaG", [])
        StoredType.LiteralTextSequence => return Value.Enum(b"\x931\xa0y+U", [])
        StoredType.Layout(field0) => return Value.Enum(b"\xa5\x11\x90\x91a\xe1", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_layout_plan_type(field0))])


pub def read_wire_stored_type(value: Value, positions: &WirePositions) -> Result[StoredType, str]:
    identity, fields = wire_variant(value)?
    if identity == b"\x0b_`\x80p\xc6" and len(fields) == 0:
        return Ok(StoredType.Int)
    if identity == b"\x1ai<\x00\xc4\x0c" and len(fields) == 0:
        return Ok(StoredType.Float)
    if identity == b"I\xf4\x11\xf0\xa1\xa7" and len(fields) == 0:
        return Ok(StoredType.Bool)
    if identity == b"NTY`\xf1\xbf" and len(fields) == 0:
        return Ok(StoredType.Unit)
    if identity == b"\xc3\xf45\xc7(Q" and len(fields) == 0:
        return Ok(StoredType.CheckedInt)
    if identity == b"c\x00\xef\x80\x0b\xb8" and len(fields) == 0:
        return Ok(StoredType.Never)
    if identity == b"q\x98\x8cM\x8e\x08" and len(fields) == 0:
        return Ok(StoredType.Text)
    if identity == b"\xd0Y?\xda\x9f\xb6" and len(fields) == 0:
        return Ok(StoredType.LiteralTextView)
    if identity == b"pL \xb1\x8c\x8e" and len(fields) == 0:
        return Ok(StoredType.TextView)
    if identity == b"\xd1\xbf\xdd\xae\x10V" and len(fields) == 1:
        return Ok(StoredType.TextValues(number(fields[0].value)?))
    if identity == b"\xf7\xbfU\x17\x8c\x06" and len(fields) == 1:
        return Ok(StoredType.LiteralTextValues(number(fields[0].value)?))
    if identity == b"/\x98A\xdf\x82\x04" and len(fields) == 1:
        return Ok(StoredType.TextValuesView(number(fields[0].value)?))
    if identity == b"\xe6Zg\x16y\x07" and len(fields) == 1:
        return Ok(StoredType.LiteralTextValuesView(number(fields[0].value)?))
    if identity == b"\xdb\x01{)\xdaG" and len(fields) == 0:
        return Ok(StoredType.TextSequence)
    if identity == b"\x931\xa0y+U" and len(fields) == 0:
        return Ok(StoredType.LiteralTextSequence)
    if identity == b"\xa5\x11\x90\x91a\xe1" and len(fields) == 1:
        return Ok(StoredType.Layout(read_wire_stored_layout_plan_type(fields[0].value, positions)?))
    return Err("unknown or incomplete StoredType alternative")
