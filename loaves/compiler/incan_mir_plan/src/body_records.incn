        return Ok(StoredRvalue.NumericCast(read_wire_stored_operand(fields[0].value, positions)?, read_wire_stored_type(fields[1].value, positions)?, read_wire_stored_type(fields[2].value, positions)?))
    if identity == b"T\x10\x8d\xaf\xaa\xc5" and len(fields) == 3:
        return Ok(StoredRvalue.Enum(number(fields[0].value)?, number(fields[1].value)?, [read_wire_stored_operand(item0, positions)? for item0 in items(fields[2].value)?]))
    if identity == b"x\xbc\x9c&\x03\x1a" and len(fields) == 1:
        return Ok(StoredRvalue.Discriminant(read_wire_stored_place(fields[0].value, positions)?))
    if identity == b"\xe7#\xb0\xbd\x03\xf7" and len(fields) == 1:
        return Ok(StoredRvalue.TagToInt(read_wire_stored_operand(fields[0].value, positions)?))
    if identity == b"^,aL#\xf0" and len(fields) == 2:
        return Ok(StoredRvalue.Model(number(fields[0].value)?, [read_wire_stored_operand(item0, positions)? for item0 in items(fields[1].value)?]))
    if identity == b"\xf16\xeex\xc3;" and len(fields) == 1:
        return Ok(StoredRvalue.Tuple([read_wire_stored_operand(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"]\xe7J\x81\xb1\x92" and len(fields) == 1:
        return Ok(StoredRvalue.Range([read_wire_stored_operand(item0, positions)? for item0 in items(fields[0].value)?]))
    if identity == b"\xa87!2_\xde" and len(fields) == 1:
        return Ok(StoredRvalue.MutBorrow(read_wire_stored_place(fields[0].value, positions)?))
    if identity == b"ivP2h\xd9" and len(fields) == 2:
        return Ok(StoredRvalue.IsVariant(read_wire_stored_place(fields[0].value, positions)?, number(fields[1].value)?))
