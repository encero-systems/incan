        StoredRvalue.NumericCast(field0, field1, field2) => return Value.Enum(b"\xdeJ\xe4\xd3\x93\xf0", [required_value(b"_\xec\xebf\xff\xc8", wire_stored_operand(field0)), required_value(b"k\x86\xb2s\xff4", wire_stored_type(field1)), required_value(b"\xd4s^:&^", wire_stored_type(field2))])
        StoredRvalue.Enum(field0, field1, field2) => return Value.Enum(b"T\x10\x8d\xaf\xaa\xc5", [required_value(b"_\xec\xebf\xff\xc8", wire_integer(field0)), required_value(b"k\x86\xb2s\xff4", wire_integer(field1)), required_value(b"\xd4s^:&^", Value.List([wire_stored_operand(item0) for item0 in field2]))])
