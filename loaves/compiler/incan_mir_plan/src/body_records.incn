"""
Round-trip a plan function's types, places, operands, operations and statements for keyed plan products.

Every model and enum position, whether in a type, a projection, a construction or a variant test, crosses one
`NominalRemap`: capture replaces it by a product-local ordinal, and binding replaces the ordinal by the position the
current unit resolved for the declaration the product names.
"""

from rust::serde import Serialize, Deserialize
from _types import PlanType, SourceSpan, source_span
from layout_type_records import StoredLayoutPlanType, retain_plan_type, restore_plan_type
from nominal_identities import NominalKind, NominalRemap, remap_type
from _body import (
    BinaryOp,
    Constant,
    FieldProjection,
    Operand,
    OperandKind,
    Place,
    Projection,
    Rvalue,
    RvalueKind,
    Statement,
    StatementKind,
    UnaryOp,
)


@derive(Serialize, Deserialize)
pub model StoredSpan:
    """Portable source provenance without serializing the shared file handle's allocation."""

    pub file: str
    pub line: int
    pub column: int


@derive(Serialize, Deserialize)
pub enum StoredType:
    """
    Incan-facing scalar and text shapes; native carrier spelling stays behind this adapter.

    Any other carrier is retained through the layout type codec, with product-local model and enum ordinals.
    """

    Int
    Float
    Bool
    Unit
    CheckedInt
    Never
    Text
    LiteralTextView
    TextView
    TextValues(int)
    LiteralTextValues(int)
    TextValuesView(int)
    LiteralTextValuesView(int)
    TextSequence
    LiteralTextSequence
    Layout(StoredLayoutPlanType)


@derive(Serialize, Deserialize)
pub model StoredFieldStep:
    """One typed field path step: its slot, the field's type, an optional variant downcast and dereference count."""

    pub slot: int
    pub ty: StoredType
    pub variant: int
    pub dereferences: int


@derive(Serialize, Deserialize)
pub enum StoredProjection:
    """A whole local, checked arithmetic component, typed dereference, field path or enum payload read."""

    Whole
    Value
    Overflow
    NumericValue(StoredType)
    VariantField(int, int, StoredType)
    Field(int, StoredType)
    Deref(StoredType)
    DerefField(int, StoredType)
    Fields(list[StoredFieldStep])
    DerefFields(list[StoredFieldStep])


@derive(Serialize, Deserialize)
pub model StoredPlace:
    """One local and its exact projection, with source provenance."""

    pub local: int
    pub projection: StoredProjection
    pub span: StoredSpan


@derive(Serialize, Deserialize)
pub enum StoredConstant:
    """The exact primitive, borrowed static text, sized numeric and type-token literals admitted by this codec."""

    Int(int)
    Float(float)
    Bool(bool)
    Unit
    Text(str)
    Numeric(str, StoredType)
    TypeToken(list[StoredType])


@derive(Serialize, Deserialize)
pub enum StoredRead:
    """Retain explicit ownership intent rather than infer it when restoring an operand."""

    Copy(StoredPlace)
    Move(StoredPlace)
    Literal(StoredConstant)


@derive(Serialize, Deserialize)
pub model StoredOperand:
    """One native operand and its original diagnostic location."""

    pub kind: StoredRead
    pub span: StoredSpan


@derive(Serialize, Deserialize)
pub enum StoredRvalue:
    """
    Self-contained operations; any operation with external context refuses capture.

    `Enum` and `Model` construction and `IsVariant` name their owner by product-local ordinal.
    """

    Use(StoredOperand)
    Binary(int, StoredOperand, StoredOperand)
    Unary(int, StoredOperand)
    IntToFloat(StoredOperand)
    FloatToInt(StoredOperand)
    BoolToInt(StoredOperand)
    Array(list[StoredOperand])
    Borrow(StoredPlace)
    UnsizeSlice(StoredOperand)
    NativeAlias(StoredOperand, StoredType, StoredType)
    FrozenText(StoredOperand)
    FrozenBytes(list[int])
    NumericCast(StoredOperand, StoredType, StoredType)
    Enum(int, int, list[StoredOperand])
    Discriminant(StoredPlace)
    TagToInt(StoredOperand)
    Model(int, list[StoredOperand])
    Tuple(list[StoredOperand])
    Range(list[StoredOperand])
    MutBorrow(StoredPlace)
    IsVariant(StoredPlace, int)


@derive(Serialize, Deserialize)
pub enum StoredStatementKind:
    """Exact assignment and storage-lifetime operations."""

    Assign(StoredPlace, StoredRvalue, StoredSpan)
    Live(int)
    Dead(int)


@derive(Serialize, Deserialize)
pub model StoredStatement:
    """Keep the statement's location independently of its value and destination."""

    pub kind: StoredStatementKind
    pub span: StoredSpan


pub def store_span(span: SourceSpan) -> StoredSpan:
    """Retain file text and both one-based coordinates without exposing an allocation identity."""
    return StoredSpan(file=str(span.file), line=span.line, column=span.column)


pub def restore_span(span: StoredSpan) -> SourceSpan:
    """Use the plan owner's shared-file constructor for restored diagnostic locations."""
    return source_span(file=span.file, line=span.line, column=span.column)


pub def store_type(ty: PlanType, mut remap: NominalRemap) -> Result[StoredType, str]:
    """
    Retain a complete layout type.

    Scalar and text carriers keep their Incan-facing spelling; every other carrier crosses the layout type codec with
    each model and enum position translated to its product-local ordinal.
    """
    match ty:
        PlanType.Int => return Ok(StoredType.Int)
        PlanType.Float => return Ok(StoredType.Float)
        PlanType.Bool => return Ok(StoredType.Bool)
        PlanType.Unit => return Ok(StoredType.Unit)
        PlanType.CheckedInt => return Ok(StoredType.CheckedInt)
        PlanType.Never => return Ok(StoredType.Never)
        PlanType.String => return Ok(StoredType.Text)
        PlanType.StrRef => return Ok(StoredType.LiteralTextView)
        PlanType.StringRef => return Ok(StoredType.TextView)
        PlanType.StringArray(length) => return Ok(StoredType.TextValues(length))
        PlanType.StrArray(length) => return Ok(StoredType.LiteralTextValues(length))
        PlanType.StringArrayRef(length) => return Ok(StoredType.TextValuesView(length))
        PlanType.StrArrayRef(length) => return Ok(StoredType.LiteralTextValuesView(length))
        PlanType.StringSlice => return Ok(StoredType.TextSequence)
        PlanType.StrSlice => return Ok(StoredType.LiteralTextSequence)
        _ => return Ok(StoredType.Layout(retain_plan_type(remap_type(ty, remap)?)?))


pub def restore_type(stored: StoredType, mut remap: NominalRemap) -> Result[PlanType, str]:
    """Restore the exact carrier, binding each product-local ordinal to its resolved unit position."""
    match stored:
        StoredType.Int => return Ok(PlanType.Int)
        StoredType.Float => return Ok(PlanType.Float)
        StoredType.Bool => return Ok(PlanType.Bool)
        StoredType.Unit => return Ok(PlanType.Unit)
        StoredType.CheckedInt => return Ok(PlanType.CheckedInt)
        StoredType.Never => return Ok(PlanType.Never)
        StoredType.Text => return Ok(PlanType.String)
        StoredType.LiteralTextView => return Ok(PlanType.StrRef)
        StoredType.TextView => return Ok(PlanType.StringRef)
        StoredType.TextValues(length) => return Ok(PlanType.StringArray(length))
        StoredType.LiteralTextValues(length) => return Ok(PlanType.StrArray(length))
        StoredType.TextValuesView(length) => return Ok(PlanType.StringArrayRef(length))
        StoredType.LiteralTextValuesView(length) => return Ok(PlanType.StrArrayRef(length))
        StoredType.TextSequence => return Ok(PlanType.StringSlice)
        StoredType.LiteralTextSequence => return Ok(PlanType.StrSlice)
        StoredType.Layout(layout) => return remap_type(restore_plan_type(layout)?, remap)


pub def store_types(types: list[PlanType], mut remap: NominalRemap) -> Result[list[StoredType], str]:
    """Retain an ordered type list through one translation."""
    mut stored: list[StoredType] = []
    for ty in types:
        stored.append(store_type(ty, remap)?)
    return Ok(stored)


pub def restore_types(stored: list[StoredType], mut remap: NominalRemap) -> Result[list[PlanType], str]:
    """Restore an ordered type list through one translation."""
    mut types: list[PlanType] = []
    for value in stored:
        types.append(restore_type(value, remap)?)
    return Ok(types)


pub def store_place(place: Place, mut remap: NominalRemap) -> Result[StoredPlace, str]:
    """Preserve every projection; its types and field paths cross the same nominal translation."""
    return Ok(StoredPlace(local=place.local, projection=store_projection(place.projection, remap)?, span=store_span(place.span)))


pub def restore_place(place: StoredPlace, mut remap: NominalRemap) -> Result[Place, str]:
    """Restore the exact projection rather than infer it from a carrier."""
    return Ok(Place(local=place.local, projection=restore_projection(place.projection, remap)?, span=restore_span(place.span)))


def store_projection(projection: Projection, mut remap: NominalRemap) -> Result[StoredProjection, str]:
    """Retain one projection; slots and variants are positions within the named declaration's checked layout."""
    match projection:
        Projection.Whole => return Ok(StoredProjection.Whole)
        Projection.Value => return Ok(StoredProjection.Value)
        Projection.Overflow => return Ok(StoredProjection.Overflow)
        Projection.NumericValue(ty) => return Ok(StoredProjection.NumericValue(store_type(ty, remap)?))
        Projection.VariantField(variant, slot, ty) =>
            return Ok(StoredProjection.VariantField(variant, slot, store_type(ty, remap)?))
        Projection.Field(slot, ty) => return Ok(StoredProjection.Field(slot, store_type(ty, remap)?))
        Projection.Deref(ty) => return Ok(StoredProjection.Deref(store_type(ty, remap)?))
        Projection.DerefField(slot, ty) => return Ok(StoredProjection.DerefField(slot, store_type(ty, remap)?))
        Projection.Fields(steps) => return Ok(StoredProjection.Fields(store_steps(steps, remap)?))
        Projection.DerefFields(steps) => return Ok(StoredProjection.DerefFields(store_steps(steps, remap)?))


def restore_projection(projection: StoredProjection, mut remap: NominalRemap) -> Result[Projection, str]:
    """Restore one projection at the current positions of the declarations it reads."""
    match projection:
        StoredProjection.Whole => return Ok(Projection.Whole)
        StoredProjection.Value => return Ok(Projection.Value)
        StoredProjection.Overflow => return Ok(Projection.Overflow)
        StoredProjection.NumericValue(ty) => return Ok(Projection.NumericValue(restore_type(ty, remap)?))
        StoredProjection.VariantField(variant, slot, ty) =>
            return Ok(Projection.VariantField(variant, slot, restore_type(ty, remap)?))
        StoredProjection.Field(slot, ty) => return Ok(Projection.Field(slot, restore_type(ty, remap)?))
        StoredProjection.Deref(ty) => return Ok(Projection.Deref(restore_type(ty, remap)?))
        StoredProjection.DerefField(slot, ty) => return Ok(Projection.DerefField(slot, restore_type(ty, remap)?))
        StoredProjection.Fields(steps) => return Ok(Projection.Fields(restore_steps(steps, remap)?))
        StoredProjection.DerefFields(steps) => return Ok(Projection.DerefFields(restore_steps(steps, remap)?))


def store_steps(steps: list[FieldProjection], mut remap: NominalRemap) -> Result[list[StoredFieldStep], str]:
    """Retain a field path in order."""
    mut stored: list[StoredFieldStep] = []
    for step in steps:
        stored.append(
            StoredFieldStep(
                slot=step.slot, ty=store_type(step.ty, remap)?, variant=step.variant, dereferences=step.dereferences,
            ),
        )
    return Ok(stored)


def restore_steps(stored: list[StoredFieldStep], mut remap: NominalRemap) -> Result[list[FieldProjection], str]:
    """Restore a field path in order."""
    mut steps: list[FieldProjection] = []
    for step in stored:
        steps.append(
            FieldProjection(
                slot=step.slot, ty=restore_type(step.ty, remap)?, variant=step.variant, dereferences=step.dereferences,
            ),
        )
    return Ok(steps)


def store_constant(value: Constant, mut remap: NominalRemap) -> Result[StoredConstant, str]:
    """Preserve ordinary constants without narrowing integer digits, floating-point values or sized literals."""
    match value:
        Constant.Int(value) => return Ok(StoredConstant.Int(value))
        Constant.Float(value) => return Ok(StoredConstant.Float(value))
        Constant.Bool(value) => return Ok(StoredConstant.Bool(value))
        Constant.Unit => return Ok(StoredConstant.Unit)
        Constant.Text(value) => return Ok(StoredConstant.Text(value))
        Constant.Numeric(digits, ty) => return Ok(StoredConstant.Numeric(digits, store_type(ty, remap)?))
        Constant.TypeToken(types) => return Ok(StoredConstant.TypeToken(store_types(types, remap)?))
        _ => return Err("scalar function products refuse this native constant")


def restore_constant(value: StoredConstant, mut remap: NominalRemap) -> Result[Constant, str]:
    """Recover the producer's exact constant variant."""
    match value:
        StoredConstant.Int(value) => return Ok(Constant.Int(value))
        StoredConstant.Float(value) => return Ok(Constant.Float(value))
        StoredConstant.Bool(value) => return Ok(Constant.Bool(value))
        StoredConstant.Unit => return Ok(Constant.Unit)
        StoredConstant.Text(value) => return Ok(Constant.Text(value))
        StoredConstant.Numeric(digits, ty) => return Ok(Constant.Numeric(digits, restore_type(ty, remap)?))
        StoredConstant.TypeToken(types) => return Ok(Constant.TypeToken(restore_types(types, remap)?))


pub def store_operand(operand: Operand, mut remap: NominalRemap) -> Result[StoredOperand, str]:
    """Retain the operand's ownership operation independently of its source position."""
    span = store_span(operand.span)
    match operand.kind:
        OperandKind.Copy(place) => return Ok(StoredOperand(kind=StoredRead.Copy(store_place(place, remap)?), span=span))
        OperandKind.Move(place) => return Ok(StoredOperand(kind=StoredRead.Move(store_place(place, remap)?), span=span))
        OperandKind.Literal(value) =>
            return Ok(StoredOperand(kind=StoredRead.Literal(store_constant(value, remap)?), span=span))


pub def restore_operand(operand: StoredOperand, mut remap: NominalRemap) -> Result[Operand, str]:
    """Restore explicit copy, move and literal reads without recomputing ownership."""
    span = restore_span(operand.span)
    match operand.kind:
        StoredRead.Copy(place) => return Ok(Operand(kind=OperandKind.Copy(restore_place(place, remap)?), span=span))
        StoredRead.Move(place) => return Ok(Operand(kind=OperandKind.Move(restore_place(place, remap)?), span=span))
        StoredRead.Literal(value) =>
            return Ok(Operand(kind=OperandKind.Literal(restore_constant(value, remap)?), span=span))


pub def store_operands(operands: list[Operand], mut remap: NominalRemap) -> Result[list[StoredOperand], str]:
    """Retain ordered operands through one translation."""
    mut stored: list[StoredOperand] = []
    for operand in operands:
        stored.append(store_operand(operand, remap)?)
    return Ok(stored)


pub def restore_operands(stored: list[StoredOperand], mut remap: NominalRemap) -> Result[list[Operand], str]:
    """Restore ordered operands through one translation."""
    mut operands: list[Operand] = []
    for operand in stored:
        operands.append(restore_operand(operand, remap)?)
    return Ok(operands)


pub def store_binary(operation: BinaryOp) -> int:
    """Encode the native operation by an explicit schema tag, independently of its display spelling."""
    match operation:
        BinaryOp.Add => return 0
        BinaryOp.Subtract => return 1
        BinaryOp.Multiply => return 2
        BinaryOp.Divide => return 3
        BinaryOp.Equal => return 4
        BinaryOp.NotEqual => return 5
        BinaryOp.Less => return 6
        BinaryOp.LessEqual => return 7
        BinaryOp.Greater => return 8
        BinaryOp.GreaterEqual => return 9
        BinaryOp.BitAnd => return 10
        BinaryOp.BitOr => return 11
        BinaryOp.BitXor => return 12
        BinaryOp.ShiftLeft => return 13
        BinaryOp.ShiftRight => return 14


pub def restore_binary(tag: int) -> Result[BinaryOp, str]:
    """Refuse unknown operation tags rather than map them to an approximate arithmetic operation."""
    match tag:
        0 => return Ok(BinaryOp.Add)
        1 => return Ok(BinaryOp.Subtract)
        2 => return Ok(BinaryOp.Multiply)
        3 => return Ok(BinaryOp.Divide)
        4 => return Ok(BinaryOp.Equal)
        5 => return Ok(BinaryOp.NotEqual)
        6 => return Ok(BinaryOp.Less)
        7 => return Ok(BinaryOp.LessEqual)
        8 => return Ok(BinaryOp.Greater)
        9 => return Ok(BinaryOp.GreaterEqual)
        10 => return Ok(BinaryOp.BitAnd)
        11 => return Ok(BinaryOp.BitOr)
        12 => return Ok(BinaryOp.BitXor)
        13 => return Ok(BinaryOp.ShiftLeft)
        14 => return Ok(BinaryOp.ShiftRight)
        _ => return Err("unknown scalar binary operation tag")


def store_unary(operation: UnaryOp) -> int:
    """Encode each ordinary native unary operation explicitly."""
    match operation:
        UnaryOp.Not => return 0
        UnaryOp.Negate => return 1
        UnaryOp.Invert => return 2


def restore_unary(tag: int) -> Result[UnaryOp, str]:
    """Decode only the unary operations defined by the private schema."""
    match tag:
        0 => return Ok(UnaryOp.Not)
        1 => return Ok(UnaryOp.Negate)
        2 => return Ok(UnaryOp.Invert)
        _ => return Err("unknown scalar unary operation tag")


def store_rvalue(value: RvalueKind, mut remap: NominalRemap) -> Result[StoredRvalue, str]:
    """Capture self-contained operations; nominal constructions name their owner by product-local ordinal."""
    match value:
        RvalueKind.Use(operand) => return Ok(StoredRvalue.Use(store_operand(operand, remap)?))
        RvalueKind.Binary(op, left, right) =>
            return Ok(StoredRvalue.Binary(store_binary(op), store_operand(left, remap)?, store_operand(right, remap)?))
        RvalueKind.Unary(op, operand) => return Ok(StoredRvalue.Unary(store_unary(op), store_operand(operand, remap)?))
        RvalueKind.IntToFloat(operand) => return Ok(StoredRvalue.IntToFloat(store_operand(operand, remap)?))
        RvalueKind.FloatToInt(operand) => return Ok(StoredRvalue.FloatToInt(store_operand(operand, remap)?))
        RvalueKind.BoolToInt(operand) => return Ok(StoredRvalue.BoolToInt(store_operand(operand, remap)?))
        RvalueKind.Array(operands) => return Ok(StoredRvalue.Array(store_operands(operands, remap)?))
        RvalueKind.Borrow(place) => return Ok(StoredRvalue.Borrow(store_place(place, remap)?))
        RvalueKind.UnsizeSlice(operand) => return Ok(StoredRvalue.UnsizeSlice(store_operand(operand, remap)?))
        _ => return store_nominal_rvalue(value, remap)


def store_nominal_rvalue(value: RvalueKind, mut remap: NominalRemap) -> Result[StoredRvalue, str]:
    """Capture constructions, variant tests, casts and aliases; owner indexes become product-local ordinals."""
    match value:
        RvalueKind.NativeAlias(operand, source, target) =>
            return Ok(
                StoredRvalue.NativeAlias(store_operand(operand, remap)?, store_type(source, remap)?, store_type(target, remap)?),
            )
        RvalueKind.FrozenText(operand) => return Ok(StoredRvalue.FrozenText(store_operand(operand, remap)?))
        RvalueKind.FrozenBytes(bytes) => return Ok(StoredRvalue.FrozenBytes(bytes))
        RvalueKind.NumericCast(operand, source, target) =>
            return Ok(
                StoredRvalue.NumericCast(store_operand(operand, remap)?, store_type(source, remap)?, store_type(target, remap)?),
            )
        RvalueKind.Enum(owner, variant, operands) =>
            slot = remap.slot(NominalKind.Enum, owner, "")?
            return Ok(StoredRvalue.Enum(slot.index, variant, store_operands(operands, remap)?))
        RvalueKind.Discriminant(place) => return Ok(StoredRvalue.Discriminant(store_place(place, remap)?))
        RvalueKind.TagToInt(operand) => return Ok(StoredRvalue.TagToInt(store_operand(operand, remap)?))
        RvalueKind.Model(owner, operands) =>
            slot = remap.slot(NominalKind.Model, owner, "")?
            return Ok(StoredRvalue.Model(slot.index, store_operands(operands, remap)?))
        RvalueKind.Tuple(operands) => return Ok(StoredRvalue.Tuple(store_operands(operands, remap)?))
        RvalueKind.Range(operands) => return Ok(StoredRvalue.Range(store_operands(operands, remap)?))
        RvalueKind.MutBorrow(place) => return Ok(StoredRvalue.MutBorrow(store_place(place, remap)?))
        RvalueKind.IsVariant(place, variant) => return Ok(StoredRvalue.IsVariant(store_place(place, remap)?, variant))
        _ => return Err("scalar function products refuse this native operation")


def restore_rvalue(value: StoredRvalue, mut remap: NominalRemap) -> Result[RvalueKind, str]:
    """Recover the exact native operation; the checker and lowering's decisions are never repeated."""
    match value:
        StoredRvalue.Use(operand) => return Ok(RvalueKind.Use(restore_operand(operand, remap)?))
        StoredRvalue.Binary(op, left, right) =>
            return Ok(RvalueKind.Binary(restore_binary(op)?, restore_operand(left, remap)?, restore_operand(right, remap)?))
        StoredRvalue.Unary(op, operand) =>
            return Ok(RvalueKind.Unary(restore_unary(op)?, restore_operand(operand, remap)?))
        StoredRvalue.IntToFloat(operand) => return Ok(RvalueKind.IntToFloat(restore_operand(operand, remap)?))
        StoredRvalue.FloatToInt(operand) => return Ok(RvalueKind.FloatToInt(restore_operand(operand, remap)?))
        StoredRvalue.BoolToInt(operand) => return Ok(RvalueKind.BoolToInt(restore_operand(operand, remap)?))
        StoredRvalue.Array(operands) => return Ok(RvalueKind.Array(restore_operands(operands, remap)?))
        StoredRvalue.Borrow(place) => return Ok(RvalueKind.Borrow(restore_place(place, remap)?))
        StoredRvalue.UnsizeSlice(operand) => return Ok(RvalueKind.UnsizeSlice(restore_operand(operand, remap)?))
        _ => return restore_nominal_rvalue(value, remap)


def restore_nominal_rvalue(value: StoredRvalue, mut remap: NominalRemap) -> Result[RvalueKind, str]:
    """Restore constructions and variant tests at the current positions of their owners."""
    match value:
        StoredRvalue.NativeAlias(operand, source, target) =>
            return Ok(
                RvalueKind.NativeAlias(
                    restore_operand(operand, remap)?, restore_type(source, remap)?, restore_type(target, remap)?,
                ),
            )
        StoredRvalue.FrozenText(operand) => return Ok(RvalueKind.FrozenText(restore_operand(operand, remap)?))
        StoredRvalue.FrozenBytes(bytes) => return Ok(RvalueKind.FrozenBytes(bytes))
        StoredRvalue.NumericCast(operand, source, target) =>
            return Ok(
                RvalueKind.NumericCast(
                    restore_operand(operand, remap)?, restore_type(source, remap)?, restore_type(target, remap)?,
                ),
            )
        StoredRvalue.Enum(ordinal, variant, operands) =>
            slot = remap.slot(NominalKind.Enum, ordinal, "")?
            return Ok(RvalueKind.Enum(slot.index, variant, restore_operands(operands, remap)?))
        StoredRvalue.Discriminant(place) => return Ok(RvalueKind.Discriminant(restore_place(place, remap)?))
        StoredRvalue.TagToInt(operand) => return Ok(RvalueKind.TagToInt(restore_operand(operand, remap)?))
        StoredRvalue.Model(ordinal, operands) =>
            slot = remap.slot(NominalKind.Model, ordinal, "")?
            return Ok(RvalueKind.Model(slot.index, restore_operands(operands, remap)?))
        StoredRvalue.Tuple(operands) => return Ok(RvalueKind.Tuple(restore_operands(operands, remap)?))
        StoredRvalue.Range(operands) => return Ok(RvalueKind.Range(restore_operands(operands, remap)?))
        StoredRvalue.MutBorrow(place) => return Ok(RvalueKind.MutBorrow(restore_place(place, remap)?))
        StoredRvalue.IsVariant(place, variant) => return Ok(RvalueKind.IsVariant(restore_place(place, remap)?, variant))
        _ => return Err("unknown stored native operation")


pub def store_statement(statement: Statement, mut remap: NominalRemap) -> Result[StoredStatement, str]:
    """Retain assignments and explicit storage boundaries without dropping nested source spans."""
    span = store_span(statement.span)
    match statement.kind:
        StatementKind.Assign(place, value) =>
            destination = store_place(place, remap)?
            kind = StoredStatementKind.Assign(destination, store_rvalue(value.kind, remap)?, store_span(value.span))
            return Ok(StoredStatement(kind=kind, span=span))
        StatementKind.StorageLive(local) => return Ok(StoredStatement(kind=StoredStatementKind.Live(local), span=span))
        StatementKind.StorageDead(local) => return Ok(StoredStatement(kind=StoredStatementKind.Dead(local), span=span))


pub def restore_statement(statement: StoredStatement, mut remap: NominalRemap) -> Result[Statement, str]:
    """Restore every statement field, including the value's independent source location."""
    span = restore_span(statement.span)
    match statement.kind:
        StoredStatementKind.Assign(place, value, value_span) =>
            destination = restore_place(place, remap)?
            kind = StatementKind.Assign(destination, Rvalue(kind=restore_rvalue(value, remap)?, span=restore_span(value_span)))
            return Ok(Statement(kind=kind, span=span))
        StoredStatementKind.Live(local) => return Ok(Statement(kind=StatementKind.StorageLive(local), span=span))
        StoredStatementKind.Dead(local) => return Ok(Statement(kind=StatementKind.StorageDead(local), span=span))
