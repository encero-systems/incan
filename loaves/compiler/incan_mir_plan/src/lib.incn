    product_identities,
    product_frame_names,
    NominalKind,
    NominalReference,
    ProductNominal,
    UnitNominals,
    describe_nominals,
    resolve_nominals,
    unit_nominals,
    carrier_index,
    carrier_position,
    is_carrier_index,
    fold_carrier_positions,
    fold_inventories,
    decode_record_plan,
    encode_entry_binding,
    record_plan_products,
    WirePositions,
    PositionChange,
    encode_checked_layout,
    encode_instance_request,
    decode_instance_request,
)
from rust::incan_mir_plan_native import (
    decode_frames as native_decode_frames,
    decode_product as native_decode_product,
    encode_product as native_encode_product,
    encode_record_plan as native_encode_record_plan,
    encode_record_plan_products as native_encode_record_plan_products,
    product_nominals as native_product_nominals,
    transform_product_positions as native_transform_product_positions,
)


pub def product_nominals(
    function: &Function,
    runtime: &list[ExternalFunction],
    frames: list[Function] = [],
) -> Result[list[NominalReference], str]:
    """Name the unit positions a product of this function would retain, in first-seen ordinal order."""
    return native_product_nominals(function, runtime, frames)


pub def encode_product(
    function: &Function,
    runtime: &list[ExternalFunction],
    nominals: list[ProductNominal] = [],
    frames: list[Function] = [],
) -> Result[bytes, str]:
    """Retain a complete function, its helper frames and its dependency requirements, naming declarations."""
    return native_encode_product(function, runtime, nominals, frames)


pub def decode_product(
    text: bytes,
    references: list[NominalReference] = [],
) -> Result[tuple[Function, list[ExternalFunction]], str]:
    """Restore a product's function and runtime demand at the positions its consumer resolved."""
    return native_decode_product(text, references)


pub def decode_frames(text: bytes, references: list[NominalReference] = []) -> Result[list[Function], str]:
    """Restore a product's helper frames, binding their ordinals as the product's function binds them."""
    return native_decode_frames(text, references)


pub def transform_product_positions(
    encoded: bytes,
    positions: WirePositions,
    mut frame_names: list[str] = [],
) -> Result[bytes, str]:
    """Rebuild only native span positions, naming the product's helper frames in `frame_names`."""
    return native_transform_product_positions(encoded, positions, frame_names)


pub def encode_record_plan(plan: &Plan) -> Result[bytes, str]:
    """Encode one complete plan or explicitly refuse a field the codec cannot preserve."""
    return native_encode_record_plan(plan)


pub def encode_record_plan_products(
    plan: &Plan,
    functions: list[bytes],
    references: list[list[NominalReference]] = [],
) -> Result[bytes, str]:
    """Encode a complete interface while retaining its keyed function-product bytes in declaration order."""
    return native_encode_record_plan_products(plan, functions, references)
