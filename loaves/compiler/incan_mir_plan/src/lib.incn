"""
Plain data for native bodies, independent of rustc's internal types.

Local zero is the return place; parameters occupy the next locals in declaration
order. Blocks are indexed from zero. Every source-bearing node keeps its Incan
location, including operands and places, so native diagnostics retain provenance.
"""

pub from _types import (
    TupleElement,
    SourceSpan,
    ListLeaf,
    SizedNumeric,
    PlanType,
    list_leaf_type,
    sized_plan_type,
    range_field_types,
    tuple_element_type,
    source_span,
)
pub from _body import (
    Parameter,
    Local,
    FieldProjection,
    Projection,
    Place,
    Constant,
    OperandKind,
    Operand,
    BinaryOp,
    UnaryOp,
    RvalueKind,
    FrozenValue,
    Rvalue,
    StatementKind,
    Statement,
    CalleeKind,
    ForeignFunction,
    Callee,
    Unwind,
    TerminatorKind,
    Terminator,
    BasicBlock,
    FieldMetadata,
    FieldLifecycle,
    place,
    integer,
    copy,
    assign,
    block,
)


