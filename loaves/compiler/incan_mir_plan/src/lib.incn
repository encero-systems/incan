"""
Plain data for native bodies, independent of rustc's internal types.

Local zero is the return place; parameters occupy the next locals in declaration
order. Blocks are indexed from zero. Every source-bearing node keeps its Incan
location, including operands and places, so native diagnostics retain provenance.
"""


@derive(Clone, PartialEq)
pub enum TupleElement:
    """
    One tuple element's layout: a scalar, owned or frozen text, an owned list, a model or enum carrier, a Copy function pointer, an exact scalar, nominal or slice reference, or a nested tuple.

    A list keeps its leaf and depth, an enum carrier (an `Option`, a `Result` or a source enum) keeps its retained
    declaration index and name, and a nested tuple keeps its own element layout, exactly as the matching `PlanType`
    does. A model retains its declaration identity, and a function pointer retains its exact signature.
    """

    Int
    Float
    Bool
    Unit
    String
    List(ListLeaf, int)
    Model(int, str)
    Enum(int, str)
    Tuple(list[TupleElement])
    FunctionPointer(list[PlanType])
    Reference(bool, list[PlanType])
    ModelRef(int, str)
    ModelMutRef(int, str)
    SliceRef(list[PlanType])
    SliceMutRef(list[PlanType])
    FrozenStr


@derive(Clone, PartialEq)
pub model SourceSpan:
    """One-based line and column in an Incan source file."""

    pub file: str
    pub line: int
    pub column: int


@derive(Clone, PartialEq)
pub enum ListLeaf:
    """
    Scalar, flat tuple, Copy function pointer, and exact retained nominal/carrier leaves; hash keys still require admitted Eq and Hash authority.

    `List` and `Dict` are owned collection values held by another collection, such as a dictionary's list values or a
    list's dictionaries. A list of lists keeps one leaf with a greater depth, so `List` never leads a `PlanType.List`.
    `FrozenStr` and `FrozenBytes` keep dependency-owned Copy wrappers; ordinary strings and bytes own their read data.
    A variant cannot hold its own type directly, so `List` holds its element leaf as the only item of a list, and
    `Dict` holds its key and value leaves, in that order, as the two items of one.
    """

    Int
    Float
    Bool
    Str
    Tuple(list[TupleElement])
    Model(int, str)
    Enum(int, str)
    U8
    Unit
    Decimal
    FrozenStr
    FrozenBytes
    FunctionPointer(list[PlanType])
    List(list[ListLeaf], int)
    Dict(list[ListLeaf])


@derive(Clone, PartialEq)
pub enum SizedNumeric:
    """Exact sized carrier retained by an overflow pair."""

    I8
    I16
    I32
    I128
    U8
    U16
    U32
    U64
    U128
    F32
    F64
    ISize
    USize


@derive(Clone, PartialEq)
pub enum PlanType:
    """
    Scalar and source nominal types plus the owned text, fixed arrays, and shared slices used by formatting.

    EnumTag is rustc's native discriminant type and stays body-internal; TagToInt explicitly converts it to source int.

    Sized numeric variants preserve their exact Rust carriers. CheckedNumeric stores its named sized carrier; its value projection retains the carrier type. Tuple elements retain their ordered types and own any string elements. Array lengths are exact nonnegative counts. CheckedInt and arrays are body temporaries; shared slice variants already include their reference.
    StringRef borrows an owned String, StringMutRef is the exclusive borrow a `mut str` parameter receives, and StrRef is a string literal's shared str view.
    ScalarRef and ScalarMutRef borrow exactly one numeric, Boolean, Decimal or frozen scalar carrier with explicit shared or exclusive intent; nested references and non-scalar referents are refused before native MIR construction.
    List stores its scalar or flat tuple leaf element and a positive nesting depth; ListRef and ListMutRef borrow that same Vec representation.
    ModelRef and ModelMutRef retain shared and mutable nominal receiver references; ModelMutRef, EnumMutRef and TupleMutRef are also the exclusive borrow a `mut` parameter or an in-place loop item holds. TupleMutRef retains its referent's complete tuple layout.
    Decimal retains the legacy Decimal128 carrier; precision is checked upstream and the value keeps its written scale.
    FrozenStr retains the copyable frozen wrapper over static text; it owns no allocation and is distinct from String.
    FrozenBytes retains the copyable wrapper over a static byte slice, distinct from an owned byte list.
    Set and Dict retain the legacy HashSet and HashMap leaf arguments; their reference variants preserve caller-owned storage. Float and model keys are refused; flat tuple keys exclude floating-point fields.
    Generator retains the legacy lazy runtime wrapper, with depth zero for an immediate scalar or retained nominal leaf.
    GeneratorMutRef advances caller-owned state. GeneratorYield and GeneratorYieldRef are producer-only runtime
    handles; they never represent source values or eagerly collected elements.
    ZipIterator retains two independent owned list snapshots; its reference variants retain shared read or exclusive poll authority.
    RangeValue retains a source range value's start, end, step, and inclusivity scalar fields in Body IR's declared range field order; its field projections use that order.
    FunctionPointer retains its inputs followed by exactly one return entry; the vector is never empty, including for a zero-argument function. FunctionItem keeps that same signature and the proven source declaration's name; it remains distinct from a pointer until an explicit reification.
    Closure owns a boxed callable object with that signature layout, holding its captures by value; ClosureRef is the shared view a closure-holding parameter receives. CallableArguments is the body-internal argument tuple; it preserves each input's exact type, including caller-owned collection references, independently of source tuple layouts.
    """

    Int
    Float
    I8
    I16
    I32
    I128
    ISize
    USize
    U8
    U16
    U32
    U64
    U128
    F32
    F64
    Bool
    Unit
    CheckedNumeric(SizedNumeric)
    # A source-free executor callback; ordinary source callable values stay outside this carrier.
    UnitFunction
    EnumTag
    CheckedInt
    Tuple(list[TupleElement])
    String
    TupleMutRef(list[TupleElement])
    StringRef
    # Exactly one numeric, Bool, Decimal or frozen scalar referent; the shared borrow owns no storage.
    ScalarRef(list[PlanType])
    ScalarMutRef(list[PlanType])
    StringMutRef
    Decimal
    FrozenStr
    FrozenBytes
    # Dependency-owned frozen collection and its exact static element types; dictionaries carry key then value.
    FrozenCollection(str, list[PlanType])
    # A shared view of the same baked storage; comparisons never consume or clone its elements.
    FrozenCollectionRef(str, list[PlanType])
    # The existing SDK's zero-sized marker with exactly one checked represented primitive type.
    TypeToken(list[PlanType])
    # Exact static string storage, including generic arguments; StrRef remains a body-local formatting view.
    StaticText
    StaticBytes
    # Dependency-owned builtin validation storage; the reference borrows its message and optional code.
    ValidationError
    ValidationErrorRef
    StrRef
    StringArray(int)
    StrArray(int)
    StringArrayRef(int)
    StrArrayRef(int)
    Enum(int, str)
    EnumRef(int, str)
    EnumMutRef(int, str)
    Model(int, str)
    ModelRef(int, str)
    ModelMutRef(int, str)
    StringSlice
    StrSlice
    # A homogeneous list: its admitted leaf element and nesting depth.
    List(ListLeaf, int)
    ListRef(ListLeaf, int)
    ListMutRef(ListLeaf, int)
    # Concrete Vec::IntoIter owns the checked list's items; its mutable view polls without Clone.
    ListIntoIter(ListLeaf, int)
    ListIntoIterMutRef(ListLeaf, int)
    Set(ListLeaf)
    SetRef(ListLeaf)
    SetMutRef(ListLeaf)
    Dict(ListLeaf, ListLeaf)
    DictRef(ListLeaf, ListLeaf)
    DictMutRef(ListLeaf, ListLeaf)
    # A source range value: four Copy scalar fields in declared range field order.
    RangeValue
    # Lazy zip over independent owned list snapshots; references retain poll authority.
    ZipIterator(TupleElement, TupleElement)
    ZipIteratorRef(TupleElement, TupleElement)
    ZipIteratorMutRef(TupleElement, TupleElement)
    # Lazy runtime generators retain the admitted immediate element representation.
    Generator(ListLeaf, int)
    GeneratorMutRef(ListLeaf, int)
    GeneratorYield(ListLeaf, int)
    GeneratorYieldRef(ListLeaf, int)
    FunctionPointer(list[PlanType])
    FunctionItem(str, list[PlanType])
    Closure(list[PlanType])
    # A one-argument SDK callable shares an immutable primitive-capture environment and implements its published Clone and Callable1 bounds.
    SharedCallable(list[PlanType])
    # An owned FnOnce object whose invocation transfers its environment instead of borrowing it.
    ClosureOnce(list[PlanType])
    ClosureRef(list[PlanType])
    CallableArguments(list[PlanType])
    # Exactly one output carrier; the owned pinned future executes only when polled.
    Future(list[PlanType])
    # Rust's unsized str is permitted as a native type argument; source text remains owned String.
    NativeStr
    # An unsized native slice has one exact element carrier; references retain their own shared/exclusive intent.
    NativeSlice(list[PlanType])
    SliceRef(list[PlanType])
    SliceMutRef(list[PlanType])


pub def list_leaf_type(leaf: ListLeaf) -> PlanType:
    """Recover one admitted leaf's exact representation for lowering and adapter consumers."""
    match leaf:
        ListLeaf.Int => return PlanType.Int
        ListLeaf.Float => return PlanType.Float
        ListLeaf.Bool => return PlanType.Bool
        ListLeaf.Str => return PlanType.String
        ListLeaf.Tuple(elements) => return PlanType.Tuple(elements)
        ListLeaf.Model(index, name) => return PlanType.Model(index, name)
        ListLeaf.Enum(index, name) => return PlanType.Enum(index, name)
        ListLeaf.U8 => return PlanType.U8
        ListLeaf.Unit => return PlanType.Unit
        ListLeaf.Decimal => return PlanType.Decimal
        ListLeaf.FrozenStr => return PlanType.FrozenStr
        ListLeaf.FrozenBytes => return PlanType.FrozenBytes
        ListLeaf.FunctionPointer(signature) => return PlanType.FunctionPointer(signature)
        ListLeaf.List(element, depth) => return PlanType.List(element[0], depth)
        ListLeaf.Dict(entry) => return PlanType.Dict(entry[0], entry[1])


pub def range_field_types() -> list[PlanType]:
    """Return RangeValue's native field carriers in declared range field order: start, end, step, then inclusivity."""
    return [PlanType.Int, PlanType.Int, PlanType.Int, PlanType.Bool]


pub def tuple_element_type(element: TupleElement) -> PlanType:
    """Recover a tuple field's exact local type from the admitted layout."""
    match element:
        TupleElement.Int => return PlanType.Int
        TupleElement.Float => return PlanType.Float
        TupleElement.Bool => return PlanType.Bool
        TupleElement.Unit => return PlanType.Unit
        TupleElement.String => return PlanType.String
        TupleElement.List(leaf, depth) => return PlanType.List(leaf, depth)
        TupleElement.Model(owner, name) => return PlanType.Model(owner, name)
        TupleElement.Enum(owner, name) => return PlanType.Enum(owner, name)
        TupleElement.Tuple(elements) => return PlanType.Tuple(elements)
        TupleElement.FunctionPointer(signature) => return PlanType.FunctionPointer(signature)
        TupleElement.Reference(mutable, elements) =>
            if mutable:
                return PlanType.ScalarMutRef(elements)
            return PlanType.ScalarRef(elements)
        TupleElement.ModelRef(index, name) => return PlanType.ModelRef(index, name)
        TupleElement.ModelMutRef(index, name) => return PlanType.ModelMutRef(index, name)
        TupleElement.SliceRef(elements) => return PlanType.SliceRef(elements)
        TupleElement.SliceMutRef(elements) => return PlanType.SliceMutRef(elements)
        TupleElement.FrozenStr => return PlanType.FrozenStr


@derive(Clone, PartialEq)
pub model Parameter:
    """A named function parameter; its local index follows declaration order."""

    pub name: str
    pub ty: PlanType
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub model Local:
    """A typed body local; parameters and the return place are included."""

    pub ty: PlanType
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub model FieldProjection:
    """One canonical field slot and its exact retained native type."""

    pub slot: int
    pub ty: PlanType
    # A nonnegative variant selects the checked enum payload before this field; -1 keeps an ordinary field.
    pub variant: int = -1


@derive(Clone, PartialEq)
pub enum Projection:
    """Whole local, checked component, typed reference dereference, canonical field path, or downcast enum payload."""

    Whole
    NumericValue(PlanType)
    Value
    Overflow
    VariantField(int, int, PlanType)
    Field(int, PlanType)
    Deref(PlanType)
    DerefField(int, PlanType)
    Fields(list[FieldProjection])
    DerefFields(list[FieldProjection])


@derive(Clone, PartialEq)
pub model Place:
    """An indexed local with a checked arithmetic, nominal field, or typed reference projection."""

    pub local: int
    pub projection: Projection
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub enum Constant:
    """A scalar literal or borrowed static text. Numeric retains exact integer digits or IEEE bit digits with its carrier, never a host-width approximation."""

    Numeric(str, PlanType)
    RustItem(str, PlanType)
    Int(int)
    Float(float)
    Bool(bool)
    Unit
    Text(str)


@derive(Clone, PartialEq)
pub enum OperandKind:
    """Explicit copy, move, or constant; ownership intent is never inferred."""

    Copy(Place)
    Move(Place)
    Literal(Constant)


@derive(Clone, PartialEq)
pub model Operand:
    """A source-located value read by a statement or terminator."""

    pub kind: OperandKind
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub enum BinaryOp:
    """
    Checked integer arithmetic, scalar comparisons, floating arithmetic, and integer bit operations.

    Add, Subtract, and Multiply on int produce CheckedInt. Comparisons produce
    Bool. The other arithmetic operations require float operands.
    BitAnd, BitOr, and BitXor take two operands of one integer type and keep it. A shift keeps its left operand's
    integer type, counts with any integer type, and masks the count to that width as Rust's unchecked release shift does.
    """

    Add
    Subtract
    Multiply
    Divide
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    BitAnd
    BitOr
    BitXor
    ShiftLeft
    ShiftRight


@derive(Clone, PartialEq)
pub enum UnaryOp:
    """Boolean inversion, numeric negation, or the bitwise complement of an integer that keeps its type."""

    Not
    Negate
    Invert


@derive(Clone, PartialEq)
pub enum RvalueKind:
    """
    An explicit native expression assigned to a checked place.

    Enum construction names the owner and variant indices. Discriminant reads without moving the enum; VariantField
    projections are valid only on the selected variant branch.

    NumericCast retains both checked source and destination carriers. FloatToInt preserves Rust truncation and saturation; BoolToInt produces zero or one.

    Tuple preserves the ordered operand layout of its destination type.
    Range preserves the four scalar operands in Body IR's declared range field order and requires a RangeValue destination.
    FrozenText wraps a static Text literal in the dependency-owned FrozenStr carrier; a dynamic text operand is refused.
    FrozenBytes wraps exact unsigned literal bytes in the dependency-owned static byte carrier.
    Array moves or copies its listed operands into a fixed array. Borrow creates
    a shared reference to a checked place; MutBorrow creates a mutable list or nominal receiver reference. UnsizeSlice converts an array reference
    to the corresponding shared slice without changing ownership of its owner.
    """

    Use(Operand)
    # Reify a validated zero-argument unit function for the canonical async entry bridge.
    UnitFunction(str)
    FrozenText(Operand)
    FrozenBytes(list[int])
    FrozenCollection(PlanType, list[FrozenValue])
    Binary(BinaryOp, Operand, Operand)
    Unary(UnaryOp, Operand)
    NumericCast(Operand, PlanType, PlanType)
    IntToFloat(Operand)
    FloatToInt(Operand)
    BoolToInt(Operand)
    Array(list[Operand])
    Enum(int, int, list[Operand])
    Discriminant(Place)
    TagToInt(Operand)
    Model(int, list[Operand])
    Tuple(list[Operand])
    Range(list[Operand])
    Borrow(Place)
    MutBorrow(Place)
    UnsizeSlice(Operand)
    FunctionItem(Callee)
    ReifyFunction(Operand)
    # Borrow an owned closure's callable object as the shared view a call or closure-holding parameter takes.
    ClosureObject(Place)


@derive(Clone, PartialEq)
pub enum FrozenValue:
    """Effect-free static data: scalars, raw bytes, and nested frozen collections in source order."""

    Scalar(Constant)
    Bytes(list[int])
    Collection(PlanType, list[FrozenValue])


@derive(Clone, PartialEq)
pub model Rvalue:
    """A source-located scalar expression."""

    pub kind: RvalueKind
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub enum StatementKind:
    """Assignment and explicit local storage lifetime boundaries."""

    Assign(Place, Rvalue)
    StorageLive(int)
    StorageDead(int)


@derive(Clone, PartialEq)
pub model Statement:
    """One source-located operation before a block's terminator."""

    pub kind: StatementKind
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub enum CalleeKind:
    """A planned function, canonical external path, checked model clone, explicit generic instantiation, exact legacy generator runtime operation, or a local item/pointer operand with its retained type."""

    Planned(str)
    External(str)
    CloneEnum(int, str)
    CloneModel(int, str)
    # Every type argument in the external's checked parameter order, including callable arguments.
    Instantiated(str, list[PlanType])
    # A checked inherent SDK method future keeps owner arguments on its type path, not on its method segment.
    FutureMethod(str, list[PlanType])
    # The explicit producer takes its yield handle before the source-ordered owned captures. A zero-capture spawn
    # uses a function item; a captured spawn is a constructor whose call arguments initialize one native FnOnce environment.
    SpawnGenerator(str, ListLeaf, int)
    YieldGenerator(ListLeaf, int)
    CollectGenerator(ListLeaf, int)
    Value(Operand)
    # A synthesized constructor's boxed environment. Its closure forwards the leading captured parameters, then its own
    # inputs, to the named lifted function; the count says how many of that function's parameters are captures.
    ClosureBody(str, int)
    # A validated bridge transfers a boxed callable into the SDK's cloneable immutable environment carrier.
    SharedCallableBody(list[PlanType])
    # The exact declaration owner and native FieldInfo carrier of a checked generated metadata hook.
    FieldMetadata(int, int)
    # A constructor and lifted body for a consuming environment, forwarded by value exactly once.
    ClosureBodyOnce(str, int)
    # Invoke a borrowed callable object of this signature with one packed argument tuple.
    CallClosure(list[PlanType])
    # Invoke the owned callable object by moving it with one packed argument tuple.
    CallClosureOnce(list[PlanType])
    # Read a clone of computed static storage slot `n`, running its initializer first if nothing has yet.
    StaticLoad(int)
    # Replace the value of computed static storage slot `n`.
    StaticStore(int)
    # Run computed static slot `n`'s initializer unless it has already run, keeping the value in its storage.
    StaticForce(int)
    # Call the selected planned method while holding computed slot n's actual shared or exclusive storage guard.
    StaticMethod(int, str)
    # Clone the captured concrete environment behind an authenticated shared callable object.
    CloneClosure(list[PlanType])


@derive(Clone, PartialEq)
pub model Callee:
    """A function reference, resolved by source name or canonical module path."""

    pub kind: CalleeKind
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub enum Unwind:
    """Propagate unwinding, enter cleanup, or abort a second panic during cleanup."""

    Continue
    Cleanup(int)
    Terminate


@derive(Clone, PartialEq)
pub enum TerminatorKind:
    """
    Control flow, calls, drops, overflow checks, and unwinding exits.

    SwitchBool records the false and true targets explicitly. AssertOverflow
    checks a checked arithmetic overflow flag against false and retains both
    inputs for the native panic message. Call and Drop carry explicit unwinding.
    """

    Goto(int)
    SwitchBool(Operand, int, int)
    Call(Callee, list[Operand], Place, int, Unwind)
    Drop(Place, int, Unwind)
    AssertOverflow(Operand, BinaryOp, Operand, Operand, int, Unwind)
    # Polling and completed-future destruction have distinct owner cleanup states; cancellation drops suspended owners.
    Await(Place, Place, int, int, Unwind, Unwind)
    CoroutineDrop
    Return
    Unreachable
    UnwindResume


@derive(Clone, PartialEq)
pub model Terminator:
    """The source-located exit of a basic block."""

    pub kind: TerminatorKind
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub model BasicBlock:
    """An indexed block; cleanup blocks may only run on the unwind path."""

    pub statements: list[Statement]
    pub terminator: Terminator
    pub cleanup: bool
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub model Function:
    """A declaration and its body, with locals zero through parameter count reserved."""

    pub name: str
    pub parameters: list[Parameter]
    pub return_type: PlanType
    pub locals: list[Local]
    pub blocks: list[BasicBlock]
    pub span: SourceSpan
    # A coroutine's constructor is native; its executable body still comes entirely from this plan.
    pub is_async: bool = false
    # Only the explicit boxing constructor retains native MIR for this callee.
    pub future_callee: Option[Callee] = None


@derive(Clone, PartialEq)
pub model Plan:
    """
    A native crate with scalar functions, plain nominal layouts and normal enums; external functions are admitted by canonical path.

    External declarations give validation a signature and explicit type arguments before rustc runs. The
    adapter verifies those signatures against the loaded dependency metadata.
    """

    pub enums: list[EnumDeclaration]
    pub models: list[ModelDeclaration]
    pub functions: list[Function]
    pub externals: list[ExternalFunction]
    pub span: SourceSpan
    # Computed static storage the adapter declares, each initialized by its planned initializer function.
    pub statics: list[StaticCell] = []
    # A library plan's public names, each re-exported at the crate root; an executable plan has none.
    pub exports: list[PlanExport] = []
    # Collected test entry functions; the adapter registers these with rustc's native test harness.
    pub tests: list[str] = []


@derive(Clone, PartialEq)
pub model PlanExport:
    """
    One public name a library plan publishes, emitted as `pub use <path> as <name>;` at the crate root.

    `path` is either a planned item of this crate (`crate::<item>`) or a Rust item the library re-exports (`::<path>`).
    """

    pub name: str
    pub path: str


@derive(Clone, PartialEq)
pub model StaticCell:
    """
    One computed module static's native storage: a lazily initialized cell holding a value of `ty`.

    The adapter declares the cell and its load, store and force accessors; `initializer` names the planned function
    with no parameters that computes the first value, run at most once, when the cell is first forced or read.
    """

    pub slot: int
    pub ty: PlanType
    pub initializer: str
    pub span: SourceSpan


@derive(Clone, PartialEq)
pub model FieldMetadata:
    """Immutable source field presentation values selected by the checked reflection visibility policy."""

    pub name: str
    pub alias: Option[str]
    pub description: Option[str]
    pub type_name: str
    pub has_default: bool


@derive(Clone, PartialEq)
pub model IteratorMethods:
    """Checked source poll and item carrier authorizing an ordinary native SDK iterator implementation."""

    pub item: PlanType
    pub next: str


@derive(Clone, PartialEq)
pub model FallibleIteratorMethods:
    """Complete standard default selection and the source poll body authorizing one concrete native implementation."""

    pub item: PlanType
    pub error: PlanType
    pub next: str


@derive(Clone, PartialEq)
pub enum MarkerTrait:
    """An empty standard trait authorized by its checked adoption and existing serde derive."""

    TomlSerialize
    TomlDeserialize


@derive(Clone, PartialEq)
pub model ModelDeclaration:
    """
    Checked field layout and implicit derives for one concrete source nominal layout.

    A newtype has exactly one public field named `0`, emitted as a tuple slot; named model fields retain their names.
    """

    pub name: str
    pub public: bool
    pub fields: list[Parameter]
    pub field_public: list[bool]
    pub derives: list[str]
    pub span: SourceSpan
    # A specialized carrier keeps its source name for derived Debug and declaration metadata.
    pub source_name: str = ""
    # A stdlib layout names the compiled SDK crate item that owns its storage; the plan never declares it. With no
    # fields the layout is opaque: its values move and drop, but no field is read or written.
    pub library_item: str = ""
    # A closed SDK alias keeps the checked arguments of its declaring model's type parameters.
    pub library_type_arguments: list[PlanType] = []
    # Per field, the name a serde form uses where a checked alias renames it, as legacy's `#[serde(rename)]`
    # does; an empty entry keeps the field name, and no entries means no field is renamed.
    pub field_serde_names: list[str] = []
    # A checked Deserialize forwards std String ingress to this exact planned root; empty keeps ordinary derives.
    # The native boundary validates its standard Result<owner,str> signature before injecting the Rust TryFrom header.
    pub checked_deserialize: str = ""
    # None grants no generated hook; an empty list is an authorized empty metadata surface.
    pub reflection_metadata: Option[list[FieldMetadata]] = None
    # Exact source comparison symbols: equality alone, or equality followed by lt/le/gt/ge. Empty grants no bridge.
    pub comparison_methods: list[str] = []
    # A source adoption grants native authority only after every standard slot and the poll ABI are checked.
    pub fallible_iterator: Option[FallibleIteratorMethods] = None
    # Ordinary native Iterator needs only the selected poll; its sum default remains SDK-owned.
    pub iterator: Option[IteratorMethods] = None
    # A checked standard Callable1 member and its ordered owned input/output carriers; empty grants no bridge.
    pub callable_method: str = ""
    pub callable_signature: list[PlanType] = []
    # Only a checked canonical standard adoption with its required serde derive authorizes an empty native impl.
    pub marker_traits: list[MarkerTrait] = []
    # A source SDK TryFrom[str] implementation forwards to the exact validated Incan conversion root.
    # Empty paired fields grant no implementation, independently of serde's Rust TryFrom contract.
    pub string_conversion_root: str = ""
    pub string_conversion_trait: str = ""


@derive(Clone, PartialEq)
pub model ExternalFunction:
    """The signature of a canonical dependency function used by this plan."""

    pub path: str
    pub type_arguments: list[PlanType] = []
    pub parameters: list[PlanType]
    pub return_type: PlanType
    pub span: SourceSpan


pub def place(local: int, span: SourceSpan) -> Place:
    """Name a whole local without exposing projection bookkeeping to builders."""
    return Place(local=local, projection=Projection.Whole, span=span)


pub def integer(value: int, span: SourceSpan) -> Operand:
    """Build an int literal, represented natively as a signed 64-bit constant."""
    return Operand(kind=OperandKind.Literal(Constant.Int(value)), span=span)


pub def copy(local: int, span: SourceSpan) -> Operand:
    """Read a scalar local while leaving it available to later operations."""
    return Operand(kind=OperandKind.Copy(place(local, span)), span=span)


pub def assign(destination: Place, value: RvalueKind, span: SourceSpan) -> Statement:
    """Assign one scalar expression and retain the statement's source location."""
    return Statement(kind=StatementKind.Assign(destination, Rvalue(kind=value, span=span)), span=span)


pub def block(statements: list[Statement], exit: TerminatorKind, span: SourceSpan) -> BasicBlock:
    """Build a normal block; cleanup blocks are constructed explicitly."""
    return BasicBlock(statements=statements, terminator=Terminator(kind=exit, span=span), cleanup=false, span=span)


@derive(Clone, PartialEq)
pub model EnumDeclaration:
    """Checked normal enum layout; variant indices follow source declaration order."""

    pub name: str
    pub public: bool
    pub variants: list[EnumVariant]
    pub derives: list[str]
    pub span: SourceSpan
    # Standard carriers use their concrete type arguments from the variant fields.
    pub carrier: str = ""
    pub source_type: str = ""
    # A union's Debug prints the member it holds, as legacy's hand-written impl does; it is never derived.
    pub member_debug: bool = false
    # A stdlib enum names the compiled SDK crate item that owns it; the plan never declares it.
    pub library_item: str = ""
    # Closed SDK alias arguments retained from the checked enum instance, in declaration order.
    pub library_type_arguments: list[PlanType] = []
    # A value enum's backing ("str" or "int") and its raw values in variant order, which its serde form writes and
    # reads as legacy's hand-written impls do; empty for any other enum.
    pub raw_kind: str = ""
    pub raw_values: list[str] = []
    # Checked source equality and ordering bodies; the adapter validates their exact enum input ABI before bridging.
    pub comparison_methods: list[str] = []


@derive(Clone, PartialEq)
pub model EnumVariant:
    """One unit or positional payload variant; its field types are checker facts."""

    pub name: str
    pub fields: list[PlanType]
