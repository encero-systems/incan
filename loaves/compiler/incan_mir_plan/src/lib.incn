"""
Plain data for native bodies, independent of rustc's internal types.

Local zero is the return place; parameters occupy the next locals in declaration
order. Blocks are indexed from zero. Every source-bearing node keeps its Incan
location, including operands and places, so native diagnostics retain provenance.
"""

pub from _types import (
    TupleElement,
    SourceSpan,
    ListLeaf,
    SizedNumeric,
    PlanType,
    list_leaf_type,
    sized_plan_type,
    range_field_types,
    tuple_element_type,
    source_span,
)
pub from _body import (
    Parameter,
    Local,
    FieldProjection,
    Projection,
    Place,
    Constant,
    OperandKind,
    Operand,
    BinaryOp,
    UnaryOp,
    RvalueKind,
    FrozenValue,
    Rvalue,
    StatementKind,
    Statement,
    CalleeKind,
    ForeignFunction,
    Callee,
    Unwind,
    TerminatorKind,
    Terminator,
    BasicBlock,
    FieldMetadata,
    FieldLifecycle,
    place,
    integer,
    copy,
    assign,
    block,
)


pub from _plan import (
    AttributeValue,
    AttributeArgument,
    NativeAttribute,
    GenericLoan,
    Function,
    Plan,
    GenericLayoutType,
    GenericLayoutField,
    GenericModelDeclaration,
    GenericEnumVariant,
    GenericEnumDeclaration,
    ZipCarrier,
    PlanExport,
    StaticCell,
    IteratorMethods,
    FallibleIteratorMethods,
    NativeTraitMethod,
    NativeTraitAdoption,
    ModelDeclaration,
    ExternalFunction,
    semantic_type_matches,
    Carrier,
    EnumDeclaration,
    EnumVariant,
)
pub from function_records import encode_product, decode_product, encode_scalar, decode_scalar
pub from record_codec import (
    encode_record_plan,
    encode_record_plan_products,
    decode_record_plan,
    encode_entry_binding,
    record_plan_products,
)
