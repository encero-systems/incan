"""Expose existing standard and platform items by stable Rust names for compiler record models."""

pub from rust::incan_std_primitives::collections import list_get
pub from rust::incan_std_primitives::crumb import RowAdmission, RowRead, RowRequest, RowWriteRequest
pub from rust::incan_std_primitives::errors import json_decode_error_string
pub from rust::incan_std_data::json import JsonValue as NativeJsonValue
pub from pub::incan_platform.store import BindingLookup, Snapshot, lookup_binding, lookup_binding_metadata, lookup_members
pub from std.primitives.crumb import Budget
pub from std.primitives.crumb.descriptions import Description, DescriptionMode
pub from std.primitives.crumb.records import RowRecord
pub from std.primitives.crumb.registrations import KindRegistry
pub from std.primitives.crumb.row_reader import RowSet, read_rows
pub from std.primitives.crumb.row_writer import write_rows
pub from std.primitives.crumb.row_values import build_value, refusal, settle
pub from std.primitives.crumb.types import AbsentPolicy
pub from std.primitives.crumb.values import IntegerValue, MapEntry, Metadata, MetadataEntry, Value, ValueField
pub from std.primitives.views import MappedFile, MappedView
pub from std.primitives.crumb.hashes import HashResult, description_hash, value_hash
pub from std.primitives.crumb.metadata_values import encode as encode_metadata
pub from std.primitives.crumb.values import Projection
pub from std.primitives.crumb.encoding_errors import BinaryError
from std.primitives.crumb.encoding_errors import BinaryFailure, failure
from std.primitives.crumb.encoding_cursor import EncodingCursor
from std.primitives.crumb.encoding_index import read_index, selected
pub from std.primitives.crumb.errors import CrumbError
pub from std.fs import Path
pub from std.json import JsonValue


pub def create_budget(octets: int, elements: int, depth: int) -> Result[Budget, CrumbError]:
    """Call the public Crumb budget constructor from the Rust compiler facet."""
    return Budget.create(octets, elements, depth)


pub def empty_registry(mut budget: Budget) -> Result[KindRegistry, CrumbError]:
    """Create the empty kind registry used by compiler records."""
    return KindRegistry.create([], budget)


pub def codec_allowance(budget: Budget) -> tuple[int, int]:
    """Return the remaining byte and element allowance for a native codec helper."""
    return budget.codec_allowance()


pub def depth_allowance(budget: Budget) -> int:
    """Return the nesting depth still available to a native codec helper."""
    return budget.depth_allowance()


pub def charge_bytes(mut budget: Budget, count: int) -> Result[None, CrumbError]:
    """Charge bytes a native helper already used."""
    return budget.charge_bytes(count)


pub def charge_elements(mut budget: Budget, count: int) -> Result[None, CrumbError]:
    """Charge elements a native helper already used."""
    return budget.charge_elements(count)


pub def mapped_bytes(data: bytes) -> Result[MappedFile, str]:
    """Pass owned bytes to the standard immutable mapping constructor."""
    return MappedFile.owned(data)


pub def complete_view(owner: MappedFile) -> Option[MappedView]:
    """Retain the complete mapped value without making a second byte buffer."""
    return owner.view(0, owner.len())


pub def view_len(view: MappedView) -> int:
    """Return the length of a mapped view."""
    return view.len()


pub def view_bytes(view: MappedView) -> bytes:
    """Copy a mapped view into independently owned bytes."""
    return view.to_bytes()


pub def view_request(view: MappedView, sealed: bool, strict: bool) -> RowRequest:
    """Start a native row request over the view's immutable backing without copying it."""
    return RowRequest.from_view(view.0, sealed, strict)


pub def row_count(rows: RowSet) -> int:
    """Return the number of rows the reader already admitted."""
    return rows.len()


pub def row_key(rows: RowSet, index: int) -> bytes:
    """Return one admitted row's key."""
    return rows.key(index)


pub def row_field_count(rows: RowSet, index: int) -> int:
    """Return one admitted record row's field count."""
    return rows.record_field_count(index)


pub def row_descriptions(rows: RowSet, mut budget: Budget) -> Result[list[Description], BinaryError]:
    """Return the admitted envelope's description dictionary."""
    return rows.descriptions(budget)


pub def read_record_at(rows: RowSet, index: int, mut budget: Budget) -> Result[RowRecord, BinaryError]:
    """Materialize the selected original Crumb row under its shared budget."""
    return rows.read_record(index, budget)


pub def read_field_at(rows: RowSet, index: int, identity: bytes, mut budget: Budget) -> Result[Value, BinaryError]:
    """Materialize one field of an admitted row under its shared budget."""
    return rows.read_field(index, identity, budget)


pub def binary_field_at(rows: RowSet, index: int, identity: bytes, mut budget: Budget) -> Result[MappedView, BinaryError]:
    """Return one binary field of an admitted row as a view of the envelope."""
    return rows.binary_field_view(index, identity, budget)


pub def binary_list_field_views(
    native: Borrowed[RowAdmission], backing: Borrowed[MappedView], identity: bytes, expected: int, mut budget: Budget,
) -> Result[list[MappedView], BinaryError]:
    """Return mapped payloads of one admitted binary-list field under the caller's count and budget."""
    rows = RowSet.create(native.clone(), [], backing.clone())
    cell = match rows.field_view(0, identity, budget)?:
        Some(view) => view
        None => return Err(failure(BinaryFailure.InvalidCell, 0))
    mut sequence = EncodingCursor.create(cell)?
    count = sequence.length(budget)?
    if count != expected:
        return Err(failure(BinaryFailure.ArityMismatch, 0))
    index = read_index(sequence, count, budget)?
    mut result: list[MappedView] = []
    for position in range(count):
        cell_view, origin = selected(index, position, budget)?
        mut binary = EncodingCursor.create(cell_view, origin)?
        value = binary.frame(budget)?
        binary.finished()?
        result.append(value)
    return Ok(result)


pub def single_row_reference_prefix(prefix: bytes, selector: bytes) -> bool:
    """Identify a complete first reference selector in a bounded row prefix without admitting its body."""
    match referenced_prefix(prefix, selector):
        Ok(declared) => return declared
        Err(_) => return false


def referenced_prefix(prefix: bytes, selector: bytes) -> Result[bool, BinaryError]:
    owner = MappedFile.owned(prefix).map_err((_) => failure(BinaryFailure.Truncated, 0))?
    view = match complete_view(owner):
        Some(value) => value
        None => return Ok(false)

    mut budget = Budget.create(len(prefix) * 2, len(prefix), 1).map_err((_) => failure(BinaryFailure.LimitExceeded, 0))?
    mut cursor = EncodingCursor.create(view)?
    if cursor.take(4, budget)?.to_bytes() != b"CRMB" or cursor.length(budget)? != 1 or cursor.length(budget)? != 1:
        return Ok(false)
    if cursor.byte(budget)? > 1:
        return Ok(false)
    # Only the payload length and its first referenced selector are needed to recognize the note. The rest may be
    # truncated or damaged. The result is a discriminator for refusal, never an admitted Crumb row.
    _ = cursor.length(budget)?
    if cursor.length(budget)? != 1 or cursor.byte(budget)? != 1:
        return Ok(false)
    return Ok(cursor.frame(budget)?.to_bytes() == selector)


pub def crumb_message(error: CrumbError) -> str:
    """Return the standard Crumb diagnostic verbatim."""
    return error.message()


pub def binary_message(error: BinaryError) -> str:
    """Return the standard binary diagnostic verbatim."""
    return error.message()


pub def path_is_file(path: Path) -> bool:
    """Whether the path resolves to a regular file."""
    return path.is_file()


pub def path_read(path: Path) -> Result[bytes, str]:
    """Read a whole file with the standard error text."""
    return path.read_bytes().map_err((error) => error.message())


pub def path_write(path: Path, data: bytes) -> Result[None, str]:
    """Replace a file's bytes with the standard error text."""
    return path.write_bytes(data).map_err((error) => error.message())


pub def path_unlink(path: Path) -> Result[None, str]:
    """Remove a file with the standard error text."""
    return path.unlink().map_err((error) => error.message())


pub def path_suffixed(path: Path, suffix: str) -> Path:
    """The path with text appended to its last component."""
    return Path(path.0 + suffix)


pub def json_native(value: JsonValue) -> NativeJsonValue:
    """The native carrier of a standard JSON value."""
    return value.0


pub def json_value(value: NativeJsonValue) -> JsonValue:
    """Wrap a native JSON carrier as a standard JSON value."""
    return JsonValue(value)
