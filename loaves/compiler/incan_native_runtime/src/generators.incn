"""Safe polling of the existing lazy runtime generator, and the adapter chain generator expressions build on it."""

from std.derives.collection import Iterator
from std.derives.copying import Clone
from std.rust import Static
from std.traits.callable import Callable1
from rust::incan_std_core::iter import Generator as NativeGenerator
from rust::incan_std_core::iter import range as native_range
from rust::incan_std_core::iter import batch as native_batch
from rust::incan_std_core::iter import nonnegative_count
from rust::std::iter import Iterator as NativeIterator, IntoIterator
from rust::std::iter import once as native_once, successors
from rust::std::clone import Clone as NativeClone


pub def poll_generator[T with Clone](values: &mut NativeGenerator[T], mut output: list[T]) -> bool:
    """Poll once: 1. Advance the borrowed generator. 2. Append an item on success, preserving output on exhaustion."""
    # 1. Advance the borrowed generator.
    mut iterator = values
    match iterator.next():
        Some(value) =>
            # 2. Append the owned item.
            output.append(value)
            return true
        None => return false


pub def list_generator[T with (Clone, Static)](values: list[T]) -> Generator[T]:
    """Yield an independent snapshot lazily and in order: 1. Clone the source. 2. Wrap its consuming native iterator."""
    # 1. Clone the source.
    snapshot = values.clone()
    # 2. Wrap its consuming native iterator.
    return NativeGenerator.new(IntoIterator.into_iter(snapshot))


pub def set_generator[T with (Clone, Static)](values: set[T]) -> Generator[T]:
    """Own one set snapshot and draw its distinct elements lazily through the ordinary list generator."""
    mut snapshot: list[T] = []
    for value in values:
        snapshot.append(value)
    return list_generator(snapshot)


pub def range_generator(start: int, end: int, step: int) -> Generator[int]:
    """Construct the builtin range now, rejecting a zero step, and yield its integers lazily."""
    return NativeGenerator.new(native_range(start, end, step))


pub def once_generator[T with (Clone, Static)](value: T) -> Generator[T]:
    """Yield one item a generator-expression step accepted."""
    return NativeGenerator.new(native_once(value))


pub def empty_generator[T with (Clone, Static)]() -> Generator[T]:
    """Yield nothing for an item a generator-expression step filtered out."""
    values: list[T] = []
    return list_generator(values)


pub def int_step_generator[T with (Clone, Static)](source: Generator[int], step: (int) -> Generator[T]) -> Generator[T]:
    """Expand each integer source item through a generator-expression step, drawing both only when polled."""
    return (value for item in source for value in step(item))


pub def float_step_generator[T with (Clone, Static)](
    source: Generator[float],
    step: (float) -> Generator[T],
) -> Generator[T]:
    """Expand each float source item through a generator-expression step, drawing both only when polled."""
    return (value for item in source for value in step(item))


pub def bool_step_generator[T with (Clone, Static)](
    source: Generator[bool],
    step: (bool) -> Generator[T],
) -> Generator[T]:
    """Expand each boolean source item through a generator-expression step, drawing both only when polled."""
    return (value for item in source for value in step(item))


pub def int_callable_step_generator[T with (Clone, Static), F with (Callable1[int, Generator[T]], Static)](
    source: Generator[int],
    step: F,
) -> Generator[T]:
    """1. Forward the integer source and its owned callable to the native lazy chain."""
    # 1. Forward the integer source and its owned callable to the native lazy chain.
    native: NativeGenerator[int] = source
    adapted = native.flat_map((item) => step(item))
    _ = step
    return NativeGenerator.new(adapted)


pub def float_callable_step_generator[T with (Clone, Static), F with (Callable1[float, Generator[T]], Static)](
    source: Generator[float],
    step: F,
) -> Generator[T]:
    """1. Forward the float source and its owned callable to the native lazy chain."""
    # 1. Forward the float source and its owned callable to the native lazy chain.
    native: NativeGenerator[float] = source
    adapted = native.flat_map((item) => step(item))
    _ = step
    return NativeGenerator.new(adapted)


pub def bool_callable_step_generator[T with (Clone, Static), F with (Callable1[bool, Generator[T]], Static)](
    source: Generator[bool],
    step: F,
) -> Generator[T]:
    """1. Forward the boolean source and its owned callable to the native lazy chain."""
    # 1. Forward the boolean source and its owned callable to the native lazy chain.
    native: NativeGenerator[bool] = source
    adapted = native.flat_map((item) => step(item))
    _ = step
    return NativeGenerator.new(adapted)


pub def str_callable_step_generator[T with (Clone, Static), F with (Callable1[str, Generator[T]], Static)](
    source: Generator[str],
    step: F,
) -> Generator[T]:
    """1. Forward owned text and its callable to the native lazy chain."""
    # 1. Forward owned text and its callable to the native lazy chain.
    native: NativeGenerator[str] = source
    adapted = native.flat_map((item) => step(item))
    _ = step
    return NativeGenerator.new(adapted)


pub def item_callable_step_generator[
    S with (Clone, Static), T with (Clone, Static), F with (Callable1[S, Generator[T]], Static),
](
    source: Generator[S],
    step: F,
) -> Generator[T]:
    """Expand source items only as they are polled: 1. Retain the native source. 2. Wrap its lazy flat-map.

    The native iterator owns its source and callable without spawning a producer thread. A function pointer and an
    environment-carrying callable both retain their checked native storage throughout the chain.
    """
    # 1. Retain the native source.
    native: NativeGenerator[S] = source
    # 2. Wrap its lazy flat-map.
    adapted = native.flat_map((item) => step(item))
    _ = step
    return NativeGenerator.new(adapted)


pub def take_generator[T with (Clone, Static)](values: Generator[T], count: int) -> Generator[T]:
    """Stop after at most `count` items, drawing each only when polled; a negative count yields nothing."""
    native: NativeGenerator[T] = values
    return NativeGenerator.new(NativeIterator.take(native, nonnegative_count(count)))


pub def skip_generator[T with (Clone, Static)](values: Generator[T], count: int) -> Generator[T]:
    """Skip lazily: 1. Retain the native source. 2. Wrap its skip adapter with a nonnegative count."""
    # 1. Retain the native source.
    native: NativeGenerator[T] = values
    # 2. Wrap the native skip adapter.
    return NativeGenerator.new(native.skip(nonnegative_count(count)))


pub def batch_generator[T with (Clone, Static)](values: Generator[T], size: int) -> Generator[list[T]]:
    """Draw batches only when polled: 1. Retain the native source. 2. Wrap the native batch iterator."""
    # 1. Retain the native source.
    native: NativeGenerator[T] = values
    # 2. Wrap the native batch iterator.
    return NativeGenerator.new(native_batch(native, size))


pub def chain_generators[T with (Clone, Static)](first: Generator[T], second: Generator[T]) -> Generator[T]:
    """Yield both sources in order: 1. Retain the first source. 2. Wrap its chain with the second source."""
    # 1. Retain the first source.
    native: NativeGenerator[T] = first
    # 2. Wrap the native chain.
    return NativeGenerator.new(native.chain(second))


pub def take_while_int_generator(values: Generator[int], predicate: (int) -> bool) -> Generator[int]:
    """Yield the integer items until the predicate first rejects one."""
    return (value for value in values.take_while(predicate))


pub def skip_while_int_generator(values: Generator[int], predicate: (int) -> bool) -> Generator[int]:
    """Drop the integer items the predicate accepts until it first rejects one, then yield the rest."""
    return (value for value in values.skip_while(predicate))


pub def flat_map_int_generator[U with (Clone, Static)](
    values: Generator[int],
    expand: (int) -> list[U],
) -> Generator[U]:
    """Expand each integer item into a list when it is polled and yield that list's items."""
    return (item for value in values for item in expand(value))


pub def flat_map_int_generators[U with (Clone, Static)](
    values: Generator[int],
    expand: (int) -> Generator[U],
) -> Generator[U]:
    """Expand each integer item into a generator when it is polled and draw that generator's items one at a time."""
    return (item for value in values for item in expand(value))


pub def flat_map_int_set_generator(values: Generator[int], expand: (int) -> set[int]) -> Generator[int]:
    """Expand each integer into a set and yield its distinct values when the expansion is polled."""
    return (item for value in values for item in expand(value))


pub def map_text_callable_generator[U with (Clone, Static), F with (Callable1[str, U], Static)](
    values: Generator[str],
    transform: F,
) -> Generator[U]:
    """Transform owned text through a callable taking each item by value, matching the direct callable boundary."""
    return (transform(value) for value in values)


pub def flat_map_text_callable_generator[U with (Clone, Static), F with (Callable1[str, list[U]], Static)](
    values: Generator[str],
    expand: F,
) -> Generator[U]:
    """Expand each owned text item through a callable returning a list, drawing that list only when polled."""
    return (item for value in values for item in expand(value))


pub def any_text_callable_generator[F with Callable1[str, bool]](values: Generator[str], predicate: F) -> bool:
    """Stop at the first accepted text item, leaving later generator items unpolled."""
    for value in values:
        if predicate(value):
            return true
    return false


pub def enumerate_generator[T with (Clone, Static)](values: Generator[T]) -> Generator[tuple[int, T]]:
    """Pair items with signed positions lazily: 1. Create the index stream. 2. Pair it with the source."""
    # 1. Create the index stream.
    indices: NativeGenerator[int] = NativeGenerator.new(successors(Some(0), next_index))
    # 2. Pair it with the source.
    native: NativeGenerator[T] = values
    return NativeGenerator.new(indices.zip(native))


pub def zip_generators[T with (Clone, Static), U with (Clone, Static)](
    left: Generator[T],
    right: Generator[U],
) -> Generator[tuple[T, U]]:
    """Pair items until either source is exhausted: 1. Retain the left source. 2. Wrap its zip with the right."""
    # 1. Retain the left source.
    native: NativeGenerator[T] = left
    # 2. Wrap the native zip.
    return NativeGenerator.new(native.zip(right))


pub def map_int_generator[U with (Clone, Static)](values: Generator[int], transform: (int) -> U) -> Generator[U]:
    """Transform each integer item when it is polled."""
    return (transform(value) for value in values)


pub def map_float_generator[U with (Clone, Static)](values: Generator[float], transform: (float) -> U) -> Generator[U]:
    """Transform each float item when it is polled."""
    return (transform(value) for value in values)


pub def map_bool_generator[U with (Clone, Static)](values: Generator[bool], transform: (bool) -> U) -> Generator[U]:
    """Transform each boolean item when it is polled."""
    return (transform(value) for value in values)


pub def filter_int_generator(values: Generator[int], predicate: (int) -> bool) -> Generator[int]:
    """Keep the integer items the predicate accepts, testing each when it is polled."""
    return (value for value in values if predicate(value))


pub def filter_float_generator(values: Generator[float], predicate: (float) -> bool) -> Generator[float]:
    """Keep the float items the predicate accepts, testing each when it is polled."""
    return (value for value in values if predicate(value))


pub def filter_bool_generator(values: Generator[bool], predicate: (bool) -> bool) -> Generator[bool]:
    """Keep the boolean items the predicate accepts, testing each when it is polled."""
    return (value for value in values if predicate(value))


pub def count_generator[T with (Clone, Static)](values: Generator[T]) -> int:
    """Drain and count the remaining items: 1. Retain the native source. 2. Count through its iterator."""
    # 1. Retain the native source.
    native: NativeGenerator[T] = values
    # 2. Count through its iterator.
    return int(native.count())


pub def sum_int_generator(values: Generator[int]) -> int:
    """Drain and sum the remaining integers: 1. Retain the native source. 2. Sum its items."""
    # 1. Retain the native source.
    native: NativeGenerator[int] = values
    # 2. Sum its items.
    total: int = native.sum()
    return total


pub def fold_int_generator(values: Generator[int], initial: int, combine: (int, int) -> int) -> int:
    """Combine items from `initial`, in order: 1. Retain the native source. 2. Fold its remaining items."""
    # 1. Retain the native source.
    native: NativeGenerator[int] = values
    # 2. Fold the remaining items.
    return native.fold(initial, combine)


pub def reduce_int_generator(values: Generator[int], initial: int, combine: (int, int) -> int) -> int:
    """Reduce items from `initial`, in order: 1. Retain the native source. 2. Fold with the supplied initial value."""
    # 1. Retain the native source.
    native: NativeGenerator[int] = values
    # 2. Fold with the source language's explicit initial value.
    return native.fold(initial, combine)


pub def any_int_generator(values: Generator[int], predicate: (int) -> bool) -> bool:
    """Stop at the first accepted item: 1. Retain the mutable native source. 2. Test its remaining items."""
    # 1. Retain the mutable native source.
    mut native: NativeGenerator[int] = values
    # 2. Test until an item is accepted.
    return native.any(predicate)


pub def all_int_generator(values: Generator[int], predicate: (int) -> bool) -> bool:
    """Stop at the first rejected item: 1. Retain the mutable native source. 2. Test its remaining items."""
    # 1. Retain the mutable native source.
    mut native: NativeGenerator[int] = values
    # 2. Test until an item is rejected.
    return native.all(predicate)


pub def find_int_generator(values: Generator[int], predicate: (int) -> bool) -> Option[int]:
    """Return the first accepted integer item, drawing items only until it is found."""
    return values.find(predicate)


pub def for_each_int_generator(values: Generator[int], action: (int) -> None) -> None:
    """Run the action in order: 1. Retain the native source. 2. Visit every remaining item."""
    # 1. Retain the native source.
    native: NativeGenerator[int] = values
    # 2. Visit every remaining item.
    native.for_each(action)


def next_index(previous: &int) -> Option[int]:
    """Advance the private signed index stream using the language's integer arithmetic."""
    return Some(NativeClone.clone(previous) + 1)
