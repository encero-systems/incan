"""List operations using the legacy route's Vec representation and indexing helpers."""

from std.derives.copying import Clone
from rust::std::clone import Clone as RuntimeClone
from rust::std::vec import Vec
from rust::std::mem import replace
from rust::std::cmp import Ordering
from native_equality import equal_native
from native_copying import clone_native
from rust::incan_std_core::collections import (
    list_concat as runtime_concat,
    list_contains as runtime_contains,
    list_count as runtime_count,
    list_index as runtime_index,
    list_get_mut as runtime_get_mut,
    list_get as runtime_get,
    list_extend as runtime_extend,
    list_remove as runtime_remove,
    normalize_list_index,
    list_repeat as runtime_repeat,
    list_slice as runtime_slice,
)
from rust::incan_std_core::collections::__private import list_pop as runtime_pop
from std.derives.comparison import Eq, Ord


pub def equal_list[T with Eq](left: &list[T], right: &list[T]) -> bool:
    """Compare elements without Clone effects: 1. Invoke native equality through its declared borrowed bound."""
    # 1. Invoke native equality through its declared borrowed bound.
    return equal_native(left, right)


pub def unequal_list[T with Eq](left: &list[T], right: &list[T]) -> bool:
    """Preserve borrowed list inequality: 1. Negate native equality without copying either input."""
    # 1. Negate native equality without copying either input.
    return not equal_native(left, right)


pub def empty_list[T]() -> list[T]:
    """Allocate list storage through Vec so a governed instance does not recursively invoke itself."""
    return Vec.new()


pub def append_list[T](values: &mut Vec[T], value: T) -> None:
    """Append through Vec's primitive to the caller's list storage."""
    Vec.push(values, value)


pub def length_list[T](values: &Vec[T]) -> int:
    """Read Vec's length without consuming its binding or reentering the list builtin."""
    return int(values.len())


pub def get_list[T with RuntimeClone](values: &list[T], index: int) -> T:
    """Read an element using Python indices and the legacy runtime errors."""
    element: &T = runtime_get(values, index)
    return clone_native[T](element)


pub def borrow_list_mut[T](values: &mut list[T], index: int) -> &mut T:
    """Borrow a nested element through the legacy negative-index and bounds checks."""
    return runtime_get_mut(values, index)


pub def set_list[T](values: &mut list[T], index: int, value: T) -> None:
    """Replace an element through a caller-owned mutable list borrow."""
    _ = replace(runtime_get_mut(values, index), value)


pub def clone_list[T with Clone](values: &list[T]) -> list[T]:
    """Duplicate a list when Body IR records a value-preserving read."""
    return clone_native(values)


pub def contains_list[T with Eq](values: &list[T], value: T) -> bool:
    """Test membership with the same element comparisons as the legacy list helper."""
    reference: &T = value
    return runtime_contains(values, reference)


pub def count_list[T with Eq](values: &list[T], value: T) -> int:
    """Count matching elements through the legacy helper."""
    reference: &T = value
    return runtime_count(values, reference)


pub def index_list[T with Eq](values: &list[T], value: T) -> int:
    """Find the first matching position, preserving the legacy missing-value error."""
    reference: &T = value
    return runtime_index(values, reference)


pub def extend_list[T with Clone](values: &mut list[T], other: &list[T]) -> None:
    """Append a copy of the other list's elements without consuming it."""
    runtime_extend(values, other)


pub def pop_list[T](values: &mut list[T]) -> T:
    """Remove the last element with the legacy empty-list error."""
    return runtime_pop(values)


pub def remove_list[T](values: &mut list[T], index: int) -> None:
    """Remove one element using legacy Python-style index normalization."""
    runtime_remove(values, index)


pub def swap_list[T](mut values: &mut Vec[T], left: int, right: int) -> None:
    """Swap elements through the canonical negative-index normalization and bounds-error boundary."""
    size = values.len()
    left_index = normalize_list_index(size, left)
    right_index = normalize_list_index(size, right)
    mut view = values.as_mut_slice()
    view.swap(left_index, right_index)


pub def concat_list[T with Clone](left: &list[T], right: &list[T]) -> list[T]:
    """Concatenate borrowed lists through the legacy helper without consuming either operand."""
    return runtime_concat(left, right)


pub def repeat_list[T with Clone](value: T, count: int) -> list[T]:
    """Build `count` clones of an owned value through the legacy helper, including its negative-count ValueError."""
    return runtime_repeat(value, count)


pub def sorted_list[T with (Clone, Ord)](values: &list[T]) -> list[T]:
    """Stably sort a fresh snapshot through the native slice method, leaving the source unchanged."""
    mut owned: Vec[T] = clone_native(values)
    mut view = owned.as_mut_slice()
    view.sort()
    return owned


pub def sorted_float(values: &list[float]) -> list[float]:
    """Stably sort a snapshot: 1. Clone the input. 2. Compare partial-order values with unordered pairs equal."""
    # 1. Clone the input while preserving its owner.
    mut owned: Vec[float] = clone_native(values)
    mut view = owned.as_mut_slice()
    # 2. Keep the native stable sort and the language's unordered-pair policy.
    view.sort_by(compare_float)
    return owned


def compare_float(left: &float, right: &float) -> Ordering:
    """Treat an unordered floating-point pair as equal, preserving the original stable sorting policy."""
    left_value: float = clone_native[float](left)
    right_value: float = clone_native[float](right)
    if left_value < right_value:
        return Ordering.Less
    if left_value > right_value:
        return Ordering.Greater
    return Ordering.Equal


pub def slice_list[T with Clone](
    values: &list[T],
    has_start: bool,
    start: int,
    has_end: bool,
    end: int,
    has_step: bool,
    step: int,
) -> list[T]:
    """Copy a slice using the legacy runtime's bounds, steps, and errors, retaining omitted endpoints."""
    return runtime_slice(
        values,
        optional_index(has_start, start),
        optional_index(has_end, end),
        optional_index(has_step, step),
    )


pub def optional_index(present: bool, value: int) -> Option[int]:
    """Decode a presence flag without treating an omitted index as zero."""
    if present:
        return Some(value)
    return None
