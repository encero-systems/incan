"""Cache closed decorated text callables with legacy declaration guards and source-module names."""

from rust::std::sync import Arc, Mutex
from rust::std::collections import HashMap
from rust::std::string import String as RustString
from rust::std::ptr import fn_addr_eq


type TextCallback = () -> str


type TextInitializer = () -> TextCallback


type TextCacheCell = Arc[Mutex[HashMap[str, TextCallback]]]


@derive(Clone)
model CacheEntry:
    """Keep one shared cell for a source declaration independently of its closed type arguments."""

    declaration: str
    cell: TextCacheCell


model CacheRegistry:
    """Hold the short registry guard only while selecting a declaration's independent cell."""

    entries: list[CacheEntry]

    def select(mut self, declaration: str) -> TextCacheCell:
        """Return a shared cell before any initializer runs, permitting nested calls to another declaration."""
        for entry in self.entries:
            if entry.declaration == declaration:
                return entry.cell.clone()
        cell: TextCacheCell = Arc.new(Mutex.new(HashMap.new()))
        self.entries.append(CacheEntry(declaration=declaration, cell=cell.clone()))
        return cell


model NameRegistry:
    """Retain dynamic pointer names within the same module scope as legacy's callable-name helpers."""

    entries: list[tuple[str, TextCallback, str]]

    def record(mut self, module: str, callback: TextCallback, name: str) -> None:
        """Replace an equal pointer's dynamic name only inside its declaring source module."""
        for index in range(len(self.entries)):
            candidate: TextCallback = self.entries[index][1]
            if self.entries[index][0] == module and fn_addr_eq(candidate, callback):
                self.entries[index] = (module, callback, name)
                return
        self.entries.append((module, callback, name))

    def describe(self, module: str, callback: TextCallback) -> str:
        """Return the module's registered name or the legacy fallback for an unregistered pointer."""
        for entry in self.entries:
            candidate: TextCallback = entry[1]
            if entry[0] == module and fn_addr_eq(candidate, callback):
                return entry[2]
        return "<callable>"


static CACHES: CacheRegistry = CacheRegistry(entries=[])
static NAMES: NameRegistry = NameRegistry(entries=[])


def borrowed_cache_key(value: &RustString) -> &RustString:
    """Retain an explicit borrowed Rust key across the generic method boundary tracked by issue #508."""
    return value


pub def cached_text_binding(
    module: str,
    declaration: str,
    instance: str,
    initialize: TextInitializer,
    original: TextCallback,
    name: str,
) -> TextCallback:
    """Register before cache lookup, initialize once per closed instance, and release the guard before invocation."""
    NAMES.record(module, original, name)
    cell = CACHES.select(declaration)
    mut guard = match cell.lock():
        Ok(value) => value
        Err(error) => error.into_inner()

    key: RustString = RustString.from(instance)
    match guard.get(borrowed_cache_key(key)):
        Some(value) => return value.clone()
        None => pass
    value = initialize()
    _ = guard.insert(RustString.from(instance), value)
    return value


pub def callable_text_name(module: str, callback: TextCallback) -> str:
    """Read the dynamic module registry; lowering must separately refuse unretained static name candidates."""
    return NAMES.describe(module, callback)
