"""Initialize closed decorated callables once and register declaration names independently of callable signatures."""

from rust::std::sync import Arc, Mutex, Condvar, MutexGuard
from rust::std::collections import HashMap
from rust::std::string import String as RustString
from rust::std::thread import current, ThreadId
from rust::std::panic import catch_unwind, resume_unwind
from rust::std::mem import drop
from rust::incan_std_core::errors import raise_value_error


# Runs a closed instance's decorators and stores their result in that instance's typed storage cell.
type BindingPublisher = () -> None


enum CacheBinding:
    """Distinguish a published instance from the thread currently publishing it."""

    Initializing(ThreadId)
    Ready


enum ClaimDecision:
    """Return the locked lookup decision without retaining its guard across a caller's error reporting."""

    Ready
    Acquired
    Recursive
    Waiting
    Poisoned


model BindingCache:
    """Serialize short state changes while letting independent closed instances initialize concurrently."""

    values: Arc[Mutex[HashMap[str, CacheBinding]]]
    changed: Arc[Condvar]


@derive(Clone)
model CacheEntry:
    """
    Keep one shared cell for each closed instance's publisher.

    Each compiled unit owns the storage its publisher writes, so a unit that instantiates a declaration another unit
    also instantiates publishes its own cell rather than observing the other unit's completion.
    """

    publisher: usize
    cell: BindingCache


model CacheRegistry:
    """Hold the short registry guard only while selecting an instance's independent cell."""

    entries: list[CacheEntry]

    def select(mut self, publisher: usize) -> BindingCache:
        """Return a shared cell before any initializer runs, permitting nested calls to another instance."""
        for entry in self.entries:
            if entry.publisher == publisher:
                return entry.cell.clone()
        cell = BindingCache(values=Arc.new(Mutex.new(HashMap.new())), changed=Arc.new(Condvar.new()))
        self.entries.append(CacheEntry(publisher=publisher, cell=cell.clone()))
        return cell


model NameEntry:
    """One callable pointer and its registered name in a declaring module."""

    module: str
    address: usize
    name: str


model NameRegistry:
    """Retain dynamic pointer names within the same module scope as legacy's callable-name helpers."""

    # Exact native scalar widths in tuples remain tracked under #2256.
    entries: list[NameEntry]

    def record(mut self, module: str, address: usize, name: str) -> None:
        """Replace an equal pointer's dynamic name only inside its declaring source module."""
        for index in range(len(self.entries)):
            if self.entries[index].module == module and self.entries[index].address == address:
                self.entries[index] = NameEntry(module=module, address=address, name=name)
                return
        self.entries.append(NameEntry(module=module, address=address, name=name))

    def describe(self, module: str, address: usize) -> str:
        """Return the module's registered name or the legacy fallback for an unregistered pointer."""
        for entry in self.entries:
            if entry.module == module and entry.address == address:
                return entry.name
        return "<callable>"


static CACHES: CacheRegistry = CacheRegistry(entries=[])
static NAMES: NameRegistry = NameRegistry(entries=[])


def borrowed_cache_key(value: &RustString) -> &RustString:
    """Retain an explicit borrowed Rust key across the generic method boundary tracked by issue #508."""
    return value


pub def initialize_binding(
    module: str,
    instance: str,
    publish: BindingPublisher,
    publisher: usize,
    original: usize,
    name: str,
) -> None:
    """
    Register a declaration and publish its closed callable once without holding a mutex across user code.

    `publisher` is the address of `publish`, which identifies this instance's storage within its compiled unit.

    1. Register the original callable's name and select the instance's cache.
    2. Return once published, wait for another thread, or claim this instance's initialization.
    3. Publish outside the guard, recording success or removing the claim before resuming a panic.
    """
    # 1. Select the instance cache without executing user code.
    NAMES.record(module, original, name)
    cell = CACHES.select(publisher)
    key: RustString = RustString.from(instance)
    # 2. A claim applies only to this closed instance, never the entire declaration.
    if not claim_binding(cell, key):
        return
    # 3. Unwinding cannot leave another caller waiting on an abandoned claim.
    match catch_unwind(publish):
        Ok(_) => finish_binding(cell, key, true)
        Err(payload) =>
            finish_binding(cell, key, false)
            resume_unwind(payload)


def claim_binding(cell: &BindingCache, key: &RustString) -> bool:
    """Wait for an existing owner or claim an absent instance, returning whether this caller must publish it."""
    owner = current().id()
    while true:
        match claim_once(cell, key, owner):
            ClaimDecision.Ready => return false
            ClaimDecision.Acquired => return true
            ClaimDecision.Recursive => raise_value_error(f"recursive initialization of decorated callable '{key}'")
            ClaimDecision.Waiting => pass
            ClaimDecision.Poisoned =>
                raise_value_error(f"poisoned decorator cache while another thread initializes '{key}'")


def claim_once(cell: &BindingCache, key: &RustString, owner: ThreadId) -> ClaimDecision:
    """Inspect under one guard, waiting atomically for another owner and dropping the guard before returning."""
    mut guard = match cell.values.lock():
        Ok(value) => value
        Err(error) => error.into_inner()

    decision = inspect_claim(guard, key, owner)
    match decision:
        ClaimDecision.Waiting =>
            # The seed can consume a guard once, but cannot move it across loop assignments (#2256).
            match cell.changed.wait(guard):
                Ok(waited) =>
                    drop(waited)
                    return ClaimDecision.Waiting
                Err(error) =>
                    mut poisoned = error.into_inner()
                    recovered = inspect_claim(poisoned, key, owner)
                    match recovered:
                        ClaimDecision.Waiting => return ClaimDecision.Poisoned
                        _ => return recovered
        _ => return decision


def inspect_claim(
    mut guard: &mut MutexGuard[HashMap[str, CacheBinding]],
    key: &RustString,
    owner: ThreadId,
) -> ClaimDecision:
    """Inspect or claim while borrowing the caller's guard; another thread's claim requires an atomic wait."""
    match guard.get(borrowed_cache_key(key)):
        Some(binding) =>
            # Only a thread id is copied; no cached inventory is copied with the state.
            state: CacheBinding = binding.clone()
            match state:
                CacheBinding.Ready => return ClaimDecision.Ready
                CacheBinding.Initializing(initializer) =>
                    if initializer == owner:
                        return ClaimDecision.Recursive
                    return ClaimDecision.Waiting
        None =>
            _ = guard.insert(RustString.from(key), CacheBinding.Initializing(owner))
            return ClaimDecision.Acquired


def finish_binding(cell: &BindingCache, key: RustString, published: bool) -> None:
    """Record one published binding or clear its failed claim, then wake callers to recheck the state."""
    mut guard = match cell.values.lock():
        Ok(value) => value
        Err(error) => error.into_inner()

    if published:
        _ = guard.insert(key, CacheBinding.Ready)
    else:
        _ = guard.remove(borrowed_cache_key(key))
    cell.changed.notify_all()


pub def register_callable_name(module: str, address: usize, name: str) -> None:
    """Register the checked declaration name when its function value is materialized, regardless of its signature."""
    NAMES.record(module, address, name)


pub def callable_name(module: str, address: usize) -> str:
    """Read the declaration name registered for this module's checked function value."""
    return NAMES.describe(module, address)
