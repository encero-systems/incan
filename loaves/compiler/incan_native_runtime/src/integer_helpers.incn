"""Shared integer power semantics and explicit u8 overflow policies at the native runtime boundary."""

const MAXIMUM_POWER_EXPONENT: int = 4294967295


pub def integer_power[T](left: T, right: int, identity: T) -> T:
    """
    Preserve integer power's carrier, multiplication order and overflow diagnostics.

    1. Retain the low 32 exponent bits, returning the carrier's identity for zero.
    2. Accumulate odd factors and square the base while another factor is needed.
    3. Multiply the last factor without an unused final square.
    """
    # 1. The exponent boundary is shared by every exact-width integer carrier.
    mut exponent = right & MAXIMUM_POWER_EXPONENT
    if exponent == 0:
        return identity
    # 2. Keep the original multiplication sequence, including checked-overflow failures.
    mut base = left
    mut accumulator = identity
    while exponent > 1:
        if exponent & 1 == 1:
            accumulator = accumulator * base
        exponent = exponent // 2
        base = base * base
    # 3. Squaring here could overflow even when the requested result is representable.
    return accumulator * base


pub def checked_add_u8(left: u8, right: u8) -> Option[u8]:
    """Apply the native u8 checked add policy at the checked operand widths."""
    return left.checked_add(right)


pub def checked_sub_u8(left: u8, right: u8) -> Option[u8]:
    """Apply the native u8 checked sub policy at the checked operand widths."""
    return left.checked_sub(right)


pub def checked_mul_u8(left: u8, right: u8) -> Option[u8]:
    """Apply the native u8 checked mul policy at the checked operand widths."""
    return left.checked_mul(right)


pub def checked_pow_u8(left: u8, right: u32) -> Option[u8]:
    """Apply the native u8 checked pow policy at the checked operand widths."""
    return left.checked_pow(right)


pub def wrapping_add_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 wrapping add policy at the checked operand widths."""
    return left.wrapping_add(right)


pub def wrapping_sub_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 wrapping sub policy at the checked operand widths."""
    return left.wrapping_sub(right)


pub def wrapping_mul_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 wrapping mul policy at the checked operand widths."""
    return left.wrapping_mul(right)


pub def wrapping_pow_u8(left: u8, right: u32) -> u8:
    """Apply the native u8 wrapping pow policy at the checked operand widths."""
    return left.wrapping_pow(right)


pub def saturating_add_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 saturating add policy at the checked operand widths."""
    return left.saturating_add(right)


pub def saturating_sub_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 saturating sub policy at the checked operand widths."""
    return left.saturating_sub(right)


pub def saturating_mul_u8(left: u8, right: u8) -> u8:
    """Apply the native u8 saturating mul policy at the checked operand widths."""
    return left.saturating_mul(right)


pub def saturating_pow_u8(left: u8, right: u32) -> u8:
    """Apply the native u8 saturating pow policy at the checked operand widths."""
    return left.saturating_pow(right)
