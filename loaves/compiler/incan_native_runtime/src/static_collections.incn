"""Persistent flat primitive dictionary and set cells, addressed by canonical storage slots."""

static INT_INT_DICTS: dict[int, dict[int, int]] = {}


pub def read_static_int_int_dict(slot: int, initial: dict[int, int]) -> dict[int, int]:
    """Read a snapshot of the current dictionary or its declared effect-free contents."""
    return INT_INT_DICTS.get(slot, initial)


pub def write_static_int_int_dict(slot: int, value: dict[int, int]) -> None:
    """Persist a dictionary replacement across native function frames."""
    INT_INT_DICTS[slot] = value


