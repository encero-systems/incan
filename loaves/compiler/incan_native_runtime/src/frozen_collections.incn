"""Read-only observations of static-or-shared frozen carriers."""

from rust::incan_std_primitives::frozen import (
    FrozenList as RuntimeFrozenList,
    FrozenSet as RuntimeFrozenSet,
    FrozenDict as RuntimeFrozenDict,
)
from rust::std::clone import Clone as RuntimeClone
from rust::std::fmt import Display
from rust::std::cmp import PartialEq
from rust::std::convert import Into as RustInto
from rust::std::borrow import Borrow
from rust::std::primitive import str as RustStr
from rust::incan_std_primitives::errors import raise_index_error, raise_key_error
from std.rust import Static
from std.derives.comparison import Eq, Hash
from rust::std::vec import Vec
from rust::std::collections import HashMap as RuntimeDict, HashSet as RuntimeSet
from rust::incan_std_primitives::iter import nonnegative_count
from rust::incan_std_primitives::collections import normalize_list_index
from native_copying import clone_native
from native_equality import equal_native


pub def freeze_list[T with Static](values: list[T]) -> RuntimeFrozenList[T]:
    """Retain a computed constant's one-time list storage for the lifetime of the program."""
    return RuntimeFrozenList.leak[T](values)


pub def share_list[T with Static](values: list[T]) -> RuntimeFrozenList[T]:
    """Freeze runtime-owned list values behind a shared handle released with its final copy."""
    return RuntimeFrozenList.from_owned[T](values)


pub def freeze_set[T with (Eq, Hash, Static)](values: RuntimeSet[T]) -> RuntimeFrozenSet[T]:
    """Freeze runtime-owned hashed set storage behind a shared handle."""
    return RuntimeFrozenSet.from_owned[T](values)


pub def freeze_dict[K with (Eq, Hash, Static), V with Static](values: RuntimeDict[K, V]) -> RuntimeFrozenDict[K, V]:
    """Freeze runtime-owned hashed dictionary storage behind a shared handle."""
    return RuntimeFrozenDict.from_owned[K, V](values)


pub def frozen_list_length[T with Static](value: RuntimeFrozenList[T]) -> int:
    """Measure immutable static storage without allocating an owned collection."""
    return int(value.len())


pub def frozen_list_length_ref[T with Static](value: &RuntimeFrozenList[T]) -> int:
    """Measure borrowed baked list storage without requiring its elements to be Copy."""
    return int(value.len())


pub def frozen_set_length_ref[T with Static](value: &RuntimeFrozenSet[T]) -> int:
    """Measure borrowed baked set storage without consuming its wrapper or elements."""
    return int(value.len())


pub def frozen_dict_length_ref[K with Static, V with Static](value: &RuntimeFrozenDict[K, V]) -> int:
    """Measure borrowed baked dictionary storage without consuming either element carrier."""
    return int(value.len())


pub def frozen_list_items[T with (RuntimeClone, Static)](value: RuntimeFrozenList[T]) -> list[T]:
    """Materialize ordered owned elements through their real Clone implementations, matching legacy iteration."""
    return value.as_slice().to_vec()


pub def frozen_list_nth[T with (RuntimeClone, Static)](value: &RuntimeFrozenList[T], index: int) -> T:
    """Clone only the selected list item for one borrowed iteration step."""
    match value.get(nonnegative_count(index)):
        Some(item) => return clone_native[T](item)
        None => return raise_index_error("frozen list cursor outside collection")


pub def frozen_list_get[T with (RuntimeClone, Static)](value: &RuntimeFrozenList[T], index: int) -> T:
    """Clone one indexed list item after applying the language's negative-index and bounds policy."""
    position = normalize_list_index(value.len(), index)
    match value.get(position):
        Some(item) => return clone_native[T](item)
        None => return raise_index_error("frozen list index outside collection")


pub def frozen_list_text_nth[T with (Display, Static)](value: &RuntimeFrozenList[T], index: int) -> str:
    """Format only the selected static text item for one borrowed iteration step."""
    match value.get(nonnegative_count(index)):
        Some(item) => return f"{item}"
        None => return raise_index_error("frozen list cursor outside collection")


pub def frozen_list_text_get[T with (Display, Static)](value: &RuntimeFrozenList[T], index: int) -> str:
    """Format one indexed static text item after applying the language's negative-index and bounds policy."""
    position = normalize_list_index(value.len(), index)
    match value.get(position):
        Some(item) => return f"{item}"
        None => return raise_index_error("frozen list index outside collection")


pub def frozen_list_byte_nth[Source with (RuntimeClone, RustInto[bytes], Static)](
    value: &RuntimeFrozenList[Source],
    index: int,
) -> bytes:
    """Copy only the selected static byte item for one borrowed iteration step."""
    match value.get(nonnegative_count(index)):
        Some(item) =>
            stored: Source = clone_native[Source](item)
            return RustInto.into(stored)
        None => return raise_index_error("frozen list cursor outside collection")


pub def frozen_list_byte_get[Source with (RuntimeClone, RustInto[bytes], Static)](
    value: &RuntimeFrozenList[Source],
    index: int,
) -> bytes:
    """Copy one indexed static-byte item after applying the language's negative-index and bounds policy."""
    position = normalize_list_index(value.len(), index)
    match value.get(position):
        Some(item) =>
            stored: Source = clone_native[Source](item)
            return RustInto.into(stored)
        None => return raise_index_error("frozen list index outside collection")


pub def frozen_list_text_items[T with (Display, Static)](value: RuntimeFrozenList[T]) -> list[str]:
    """Materialize owned text: 1. Read each static element by index. 2. Append its own display text."""
    mut result: Vec[str] = Vec.new()
    mut index = 0
    while true:
        # 1. Read the next static element without constructing an opaque borrowed iterator.
        match frozen_text_item[T](value, index):
            Some(item) =>
                # 2. Append that element's display text.
                result.push(item)
            None => return result
        index += 1


pub def frozen_list_byte_items[Source with (RuntimeClone, RustInto[bytes], Static)](
    value: RuntimeFrozenList[Source],
) -> list[bytes]:
    """Copy byte snapshots: 1. Read each static element by index. 2. Copy it into its owned byte buffer."""
    mut result: Vec[bytes] = Vec.new()
    mut index = 0
    while true:
        # 1. Read the next static element without an opaque borrowed iterator.
        match value.get(nonnegative_count(index)):
            Some(item) =>
                # 2. Copy the selected static byte slice into its owned byte buffer.
                stored: Source = clone_native[Source](item)
                owned: bytes = RustInto.into(stored)
                result.push(owned)
            None => return result
        index += 1


pub def own_static_bytes[Source with RustInto[bytes]](value: Source) -> bytes:
    """Copy a static byte slice into the owned byte buffer a frozen element read returns."""
    return RustInto.into(value)


pub def frozen_set_length[T with Static](value: RuntimeFrozenSet[T]) -> int:
    """Measure the baked slice without replacing it with a hash collection."""
    return int(value.len())


pub def frozen_set_items[T with (RuntimeClone, Static)](value: RuntimeFrozenSet[T]) -> list[T]:
    """Clone set elements only for an explicit owned snapshot request."""
    mut result: Vec[T] = Vec.new()
    mut index = 0
    while true:
        match value.get(nonnegative_count(index)):
            Some(item) => result.push(clone_native[T](item))
            None => return result
        index += 1


pub def frozen_set_text_items[T with (Display, Static)](value: RuntimeFrozenSet[T]) -> list[str]:
    """Format set elements only for an explicit owned text snapshot request."""
    mut result: Vec[str] = Vec.new()
    mut index = 0
    while true:
        match value.get(nonnegative_count(index)):
            Some(item) => result.push(f"{item}")
            None => return result
        index += 1


pub def frozen_set_nth[T with (RuntimeClone, Eq, Hash, Static)](value: &RuntimeFrozenSet[T], index: int) -> T:
    """Clone only the selected set item for one borrowed iteration step."""
    match value.get(nonnegative_count(index)):
        Some(item) => return clone_native[T](item)
        None => return raise_index_error("frozen set cursor outside collection")


pub def frozen_set_text_nth[T with (Display, Static)](value: &RuntimeFrozenSet[T], index: int) -> str:
    """Format only the selected set item for one borrowed iteration step."""
    match value.get(nonnegative_count(index)):
        Some(item) => return f"{item}"
        None => return raise_index_error("frozen set cursor outside collection")


pub def frozen_list_contains[T with (PartialEq[T], Static)](value: &RuntimeFrozenList[T], probe: T) -> bool:
    """Scan borrowed list storage in place without cloning its elements."""
    reference: &T = probe
    return value.contains[T](reference)


pub def frozen_set_contains[T with (Eq, Hash, Static)](value: &RuntimeFrozenSet[T], probe: T) -> bool:
    """Use hashed shared-set lookup, or the baked constant's borrowed fallback, without cloning elements."""
    reference: &T = probe
    return value.contains[T](reference)


pub def frozen_list_text_contains[T with (Borrow[RustStr], Static)](value: &RuntimeFrozenList[T], probe: &str) -> bool:
    """Compare a text probe with borrowed list elements without formatting them into owned strings."""
    return value.contains[RustStr](probe)


pub def frozen_set_text_contains[T with (Borrow[RustStr], Eq, Hash, Static)](
    value: &RuntimeFrozenSet[T],
    probe: &str,
) -> bool:
    """Use borrowed text lookup in frozen set storage without formatting or cloning elements."""
    return value.contains[RustStr](probe)


pub def frozen_dict_length[K with Static, V with Static](value: RuntimeFrozenDict[K, V]) -> int:
    """Measure baked entries, including the same duplicate-key storage legacy preserves."""
    return int(value.len())


pub def frozen_dict_keys[K with (RuntimeClone, Static), V with Static](value: RuntimeFrozenDict[K, V]) -> list[K]:
    """Copy keys only, preserving the storage's iteration order without reading values."""
    mut result: Vec[K] = Vec.new()
    mut index = 0
    while true:
        match value.key_at(nonnegative_count(index)):
            Some(key) => result.push(clone_native[K](key))
            None => return result
        index += 1


pub def frozen_dict_text_keys[K with (Display, Static), V with Static](value: RuntimeFrozenDict[K, V]) -> list[str]:
    """Format keys without cloning values or materializing an entry snapshot."""
    mut result: Vec[str] = Vec.new()
    mut index = 0
    while true:
        match value.key_at(nonnegative_count(index)):
            Some(key) => result.push(f"{key}")
            None => return result
        index += 1


pub def frozen_dict_nth_key[K with (RuntimeClone, Eq, Hash, Static), V with Static](
    value: &RuntimeFrozenDict[K, V],
    index: int,
) -> K:
    """Clone only the selected dictionary key for one borrowed iteration step."""
    match value.key_at(nonnegative_count(index)):
        Some(key) => return clone_native[K](key)
        None => return raise_index_error("frozen dictionary cursor outside collection")


pub def frozen_dict_text_nth_key[K with (Display, Static), V with Static](
    value: &RuntimeFrozenDict[K, V],
    index: int,
) -> str:
    """Format only the selected dictionary key for one borrowed iteration step."""
    match value.key_at(nonnegative_count(index)):
        Some(key) => return f"{key}"
        None => return raise_index_error("frozen dictionary cursor outside collection")


pub def frozen_dict_text_get[K with (Borrow[RustStr], Static), V with (RuntimeClone, Static)](
    value: RuntimeFrozenDict[K, V],
    key: &str,
) -> V:
    """Use borrowed text identity to find a value, cloning only the selected owned result."""
    match value.get[RustStr](key):
        Some(item) => return clone_native[V](item)
        None => pass
    return raise_key_error(f"'{key}' not found in dict")


pub def frozen_dict_get[K with (PartialEq[K], Display, Static), V with (RuntimeClone, Static)](
    value: RuntimeFrozenDict[K, V],
    key: K,
) -> V:
    """Read one scalar key: 1. Retain typed static entries. 2. Copy the first matching value or raise KeyError."""
    reference: &K = key
    mut index = 0
    while true:
        match value.key_at(nonnegative_count(index)):
            Some(stored) =>
                if equal_native[K](stored, reference):
                    match value.value_at(nonnegative_count(index)):
                        Some(item) => return clone_native[V](item)
                        None => pass
            None => break
        index += 1
    return raise_key_error(f"'{key}' not found in dict")


pub def frozen_dict_text_contains[K with (Borrow[RustStr], Static), V with Static](
    value: &RuntimeFrozenDict[K, V],
    key: &str,
) -> bool:
    """Check borrowed text identity through the frozen dictionary's canonical lookup."""
    return value.contains_key[RustStr](key)


pub def frozen_dict_contains[K with (Eq, Hash, Static), V with Static](value: &RuntimeFrozenDict[K, V], key: K) -> bool:
    """Use the shared dictionary's hash index, or the baked constant's borrowed fallback, without reading values."""
    reference: &K = key
    return value.contains_key[K](reference)


def frozen_text_item[T with (Display, Static)](value: RuntimeFrozenList[T], index: int) -> Option[str]:
    """Project one static element's text, or report ordinary exhaustion without allocating an iterator carrier."""
    match value.get(nonnegative_count(index)):
        Some(item) => return Some(f"{item}")
        None => return None
