"""Monomorphic exact-carrier boundaries preserving numeric widths and language display contracts."""

from model_values import display_value


pub def format_i8(value: i8) -> str:
    """Format the exact i8 carrier through the legacy language contract."""
    return str(value)


pub def int_i8(value: i8) -> int:
    """Apply the legacy integer cast to the exact i8 carrier."""
    return int(value)


pub def float_i8(value: i8) -> float:
    """Apply the legacy float cast to the exact i8 carrier."""
    return float(value)


