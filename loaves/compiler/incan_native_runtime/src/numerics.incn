pub def negate_i128(value: i128) -> i128:
    """Negate i128: 1. Invoke its native Neg implementation with inherited overflow behavior."""
    # 1. Retain the carrier's native overflow policy.
    return Neg.neg(value)


pub def parse_int(value: &str) -> int:
    """Parse an integer: 1. Use the existing conversion and canonical ValueError panic."""
    # 1. Delegate parsing and error behavior to the original primitive.
    return int_from_str(value)


pub def parse_float(value: &str) -> float:
    """Parse a float: 1. Use the existing conversion and canonical ValueError panic."""
    # 1. Delegate parsing and error behavior to the original primitive.
    return float_from_str(value)


pub def py_mod_i8(left: i8, right: i8) -> i8:
    """Compute i8 modulo: 1. Use the original signed arithmetic and errors."""
    # 1. Call the existing primitive at the exact width.
    return py_mod_signed(left, right)


