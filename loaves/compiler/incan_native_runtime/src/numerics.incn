pub def negate_i8(value: i8) -> i8:
    """Negate with the legacy carrier-specific overflow behavior."""
    return -value


pub def negate_i16(value: i16) -> i16:
    """Negate with the legacy carrier-specific overflow behavior."""
    return -value


