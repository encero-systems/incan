pub def power_i8(left: i8, right: int) -> i8:
    """Preserve i8 power's exponent boundary and checked multiplication behavior."""
    return integer_power[i8](left, right, 1)


pub def power_i16(left: i16, right: int) -> i16:
    """Preserve i16 power's exponent boundary and checked multiplication behavior."""
    return integer_power[i16](left, right, 1)


