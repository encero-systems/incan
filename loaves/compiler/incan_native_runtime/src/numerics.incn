pub def format_f32(value: f32) -> str:
    """Keep f32 visibly floating without widening its shortest native digits, including negative zero."""
    text = display_value(value)
    if "." in text or "e" in text or "E" in text:
        return text
    return text + ".0"


pub def int_f32(value: f32) -> int:
    """Apply the legacy integer cast to the exact f32 carrier."""
    return int(value)


pub def float_f32(value: f32) -> float:
    """Apply the legacy float cast to the exact f32 carrier."""
    return float(value)


pub def format_f64(value: f64) -> str:
    """Format the exact f64 carrier: 1. Retain visibly floating language spelling."""
    # 1. Use the existing float spelling primitive.
    return float_to_string(value)


pub def int_f64(value: f64) -> int:
    """Apply the legacy integer cast to the exact f64 carrier."""
    return int(value)


pub def float_f64(value: f64) -> float:
    """Apply the legacy float cast to the exact f64 carrier."""
    return float(value)


pub def negate_i8(value: i8) -> i8:
    """Negate i8: 1. Invoke its native Neg implementation with inherited overflow behavior."""
    # 1. Retain the carrier's native overflow policy.
    return value.neg()


pub def negate_i16(value: i16) -> i16:
