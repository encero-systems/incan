pub def parse_int(value: &str) -> int:
    """Parse text using the legacy integer conversion and its canonical ValueError panic."""
    return int(str(value))


pub def parse_float(value: &str) -> float:
    """Parse text using the legacy float conversion and its canonical ValueError panic."""
    return float(str(value))


pub def py_mod_i8(left: i8, right: i8) -> i8:
    """Preserve the legacy i8 py_mod arithmetic and errors."""
    return left % right


pub def py_floor_div_i8(left: i8, right: i8) -> i8:
    """Preserve the legacy i8 py_floor_div arithmetic and errors."""
    return left // right


