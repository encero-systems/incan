"""Monomorphic exact-carrier boundaries preserving numeric widths and language display contracts."""

from model_values import display_value
from integer_helpers import integer_power
from rust::incan_std_core::strings import float_to_string
from rust::std::ops import Neg
from rust::incan_std_core::conversions import int_from_str, float_from_str
from rust::incan_std_core::num import (
    py_mod_signed,
    py_mod_unsigned,
    py_floor_div_signed,
    py_floor_div_unsigned,
    py_mod_f32 as native_mod_f32,
    py_mod_f64 as native_mod_f64,
    py_floor_div_f32 as native_floor_div_f32,
    py_floor_div_f64 as native_floor_div_f64,
)


pub def format_i8(value: i8) -> str:
    """Format the exact i8 carrier: 1. Use its native integer spelling."""
    # 1. Format the original carrier directly.
    return display_value(value)


pub def int_i8(value: i8) -> int:
    """Apply the legacy integer cast to the exact i8 carrier."""
    return int(value)


pub def float_i8(value: i8) -> float:
    """Apply the legacy float cast to the exact i8 carrier."""
    return float(value)


