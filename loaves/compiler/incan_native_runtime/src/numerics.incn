# Exact-width integer powers. Legacy emits `base.pow(exponent as u32)` with the base keeping its own carrier, so each
# helper truncates the exponent to `u32` and repeats `power_i64`'s square-and-multiply steps in that carrier, which
# overflow exactly where the carrier's `pow` does in the same profile.
pub def power_i8(left: i8, right: int) -> i8:
    """Match legacy's `i8::pow` with the exponent truncated to `u32`."""
    mut exponent = right & 4294967295
    if exponent == 0:
        return 1
    mut base = left
    mut accumulator: i8 = 1
    while exponent > 1:
        if exponent & 1 == 1:
            accumulator = accumulator * base
        exponent = exponent // 2
        base = base * base
    return accumulator * base


