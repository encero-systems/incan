"""Legacy HashSet and HashMap operations for checked direct-route collection plans."""

from std.derives.copying import Clone
from std.derives.comparison import Eq, Hash
from rust::std::fmt import Display
from rust::std::clone import Clone as RuntimeClone
from rust::std::cmp import Eq as RuntimeEq
from rust::std::collections import HashMap as RuntimeDict, HashSet as RuntimeSet
from rust::std::collections::hash_set import Iter as RuntimeSetIter
from rust::std::collections::hash_map import Keys as RuntimeKeys, Values as RuntimeValues
from rust::std::iter import Iterator
from rust::incan_std_core::iter import nonnegative_count
from rust::incan_std_core::errors import raise_index_error
from rust::incan_std_core::collections import (
    set_contains, dict_contains_key, dict_get, dict_get_mut, normalize_list_index,
)
from native_equality import equal_native
from native_copying import clone_native


pub def equal_set[T with (Eq, Hash)](left: &Set[T], right: &Set[T]) -> bool:
    """Compare hashed membership without copying inputs: 1. Invoke native equality through its declared bound."""
    # 1. Invoke native equality through its declared bound.
    return equal_native(left, right)


pub def unequal_set[T with (Eq, Hash)](left: &Set[T], right: &Set[T]) -> bool:
    """Compare unequal hashed sets: 1. Negate borrowed native equality without consuming either source."""
    # 1. Negate borrowed native equality without consuming either source.
    return not equal_native(left, right)


pub def equal_dict[K with (Eq, Hash), V with Eq](left: &Dict[K, V], right: &Dict[K, V]) -> bool:
    """Compare matching keys and values: 1. Invoke the dictionary's borrowed native equality."""
    # 1. Invoke the dictionary's borrowed native equality.
    return equal_native(left, right)


pub def unequal_dict[K with (Eq, Hash), V with Eq](left: &Dict[K, V], right: &Dict[K, V]) -> bool:
    """Compare unequal dictionaries: 1. Negate borrowed native equality without cloning keys or values."""
    # 1. Negate borrowed native equality without cloning keys or values.
    return not equal_native(left, right)


pub def empty_set[T with (Eq, Hash)]() -> Set[T]:
    """Construct hash storage through Rust so a governed body does not reenter the Set builtin."""
    return RuntimeSet.new()


pub def insert_set[T with (RuntimeEq, Hash)](values: &mut RuntimeSet[T], value: T) -> None:
    """Insert one owned element, preserving legacy duplicate elimination."""
    RuntimeSet.insert(values, value)


pub def length_set[T](values: &RuntimeSet[T]) -> int:
    """Read the hash set's size without consuming it."""
    return int(values.len())


pub def contains_set[T with (Eq, Hash)](values: &Set[T], value: T) -> bool:
    """Use the legacy set membership helper and its element comparison."""
    reference: &T = value
    return set_contains(values, reference)


pub def clone_set[T with Clone](values: &Set[T]) -> Set[T]:
    """Copy a set only when the checked read requires an owned copy."""
    native: &RuntimeSet[T] = values
    return clone_native(native)


pub def empty_dict[K with (Eq, Hash), V]() -> Dict[K, V]:
    """Construct hash storage through Rust so a governed body does not reenter the Dict builtin."""
    return RuntimeDict.new()


pub def insert_dict[K with (RuntimeEq, Hash), V](values: &mut RuntimeDict[K, V], key: K, value: V) -> None:
    """Insert or overwrite a key in the same order as the source operands."""
    RuntimeDict.insert(values, key, value)


pub def length_dict[K, V](values: &RuntimeDict[K, V]) -> int:
    """Read a dictionary's size without consuming its binding."""
    return int(values.len())


pub def contains_dict[K with (Eq, Hash), V](values: &Dict[K, V], key: K) -> bool:
    """Test dictionary keys through the legacy membership helper."""
    reference: &K = key
    return dict_contains_key(values, reference)


pub def clone_dict[K with Clone, V with Clone](values: &Dict[K, V]) -> Dict[K, V]:
    """Materialize an owned dictionary for checked value-preserving reads."""
    native: &RuntimeDict[K, V] = values
    return clone_native(native)


pub def get_dict[K with (Eq, Hash, Display), V with RuntimeClone](values: &Dict[K, V], key: K) -> V:
    """Index a dictionary with the legacy missing-key diagnostic."""
    reference: &K = key
    value: &V = dict_get(values, reference)
    return clone_native(value)


pub def borrow_mut_dict[K with (Eq, Hash, Display), V](values: &mut Dict[K, V], key: K) -> &mut V:
    """Borrow a stored value in place through the legacy missing-key diagnostic, as `d[key]` does before a change."""
    reference: &K = key
    return dict_get_mut(values, reference)


pub def optional_dict[K with (Eq, Hash, Display), V with RuntimeClone](values: &Dict[K, V], key: K) -> Option[V]:
    """Copy a present value or report its absence, as the legacy one-argument lookup does."""
    reference: &K = key
    mapping: &RuntimeDict[K, V] = values
    match mapping.get[K](reference):
        Some(value) => return Some(clone_native(value))
        None => return None


pub def keys_dict[K with Clone, V](values: &Dict[K, V]) -> list[K]:
    """Copy keys in native order: 1. Retain a native key iterator. 2. Poll and clone each borrowed key once."""
    # 1. Retain a native key iterator.
    mut keys: list[K] = []
    mapping: &RuntimeDict[K, V] = values
    mut iterator: RuntimeKeys[K, V] = mapping.keys()
    # 2. Poll and clone each borrowed key once.
    while true:
        match iterator.next():
            Some(value) =>
                key: &K = value
                keys.append(clone_native(key))
            None => return keys


pub def values_dict[K with (Eq, Hash, Clone, Display), V with Clone](values: &Dict[K, V]) -> list[V]:
    """Copy values in native order: 1. Retain a native value iterator. 2. Poll and clone each borrowed value once."""
    # 1. Retain a native value iterator.
    mut items: list[V] = []
    mapping: &RuntimeDict[K, V] = values
    mut iterator: RuntimeValues[K, V] = mapping.values()
    # 2. Poll and clone each borrowed value once.
    while true:
        match iterator.next():
            Some(value) =>
                item: &V = value
                items.append(clone_native(item))
            None => return items


pub def default_dict[K with (Eq, Hash, Display), V with Clone](values: &Dict[K, V], key: K, default: V) -> V:
    """Copy the stored value or return the eagerly evaluated default, as legacy does."""
    reference: &K = key
    mapping: &RuntimeDict[K, V] = values
    match mapping.get[K](reference):
        Some(value) => return clone_native(value)
        None => return default


pub def nth_set[T with Clone](values: &Set[T], index: int) -> T:
    """Copy one element in the live HashSet order; lowering proves the cursor in bounds."""
    native: &RuntimeSet[T] = values
    mut iterator: RuntimeSetIter[T] = native.iter()
    match iterator.nth(nonnegative_count(index)):
        Some(value) =>
            element: &T = value
            return clone_native(element)
        None => return raise_index_error("set cursor outside collection")


pub def nth_dict[K with Clone, V](values: &Dict[K, V], index: int) -> K:
    """Clone only the selected key in native order, retaining canonical signed list-index bounds and errors."""
    mapping: &RuntimeDict[K, V] = values
    position = normalize_list_index(mapping.len(), index)
    mut keys: RuntimeKeys[K, V] = mapping.keys()
    match keys.nth(position):
        Some(key) => return clone_native(key)
        None => return raise_index_error("dictionary cursor outside its checked collection bounds")


pub def extend_list_set[T with (Eq, Hash, Clone)](mut values: Set[T], source: &list[T]) -> None:
    """Insert list elements in their source order, preserving repeated source bindings."""
    for value in source:
        values.add(value)


pub def extend_set[T with (Eq, Hash, Clone)](mut values: Set[T], source: &Set[T]) -> None:
    """Insert a source set's elements using the same hash collection representation."""
    for value in source:
        values.add(value)


pub def extend_dict[K with (Eq, Hash, Clone, Display), V with Clone](
    mut values: Dict[K, V],
    source: &Dict[K, V],
) -> None:
    """Apply a mapping spread: 1. Retain native source keys. 2. Copy entries, overwriting earlier destination keys."""
    # 1. Retain native source keys.
    mapping: &RuntimeDict[K, V] = source
    mut iterator: RuntimeKeys[K, V] = mapping.keys()
    # 2. Copy entries to the destination.
    while true:
        match iterator.next():
            Some(value) =>
                key: &K = value
                item: &V = dict_get(source, key)
                values.insert(clone_native(key), clone_native(item))
            None => return
