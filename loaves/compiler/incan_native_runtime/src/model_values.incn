"""Native nominal operations delegate to the same Rust derives as legacy emission."""

from rust::std::fmt import Debug, Display
from rust::serde import Serialize
from rust::serde::de import DeserializeOwned
from rust::incan_std_data::json::__private import stringify_or_raise, parse_or_error
from rust::std::any import type_name_of_val
from rust::std::cmp import PartialEq, PartialOrd


pub def debug_model[T with Debug](value: &T) -> str:
    """Render the actual derived Debug implementation, including field order and string escaping."""
    return f"{value:?}"


pub def debug_value[T with Debug](value: T) -> str:
    """Format an admitted owned carrier with legacy Debug spelling and escaping."""
    return f"{value:?}"


pub def display_value[T with Display](value: T) -> str:
    """Format a type-parameter value through its own Display, as generic code does, integral floats included."""
    return f"{value}"


pub def display_type_parameter[T with Display](value: T) -> str:
    """Use the argument's Rust Display contract, retaining generic float spelling without the concrete float adapter."""
    return f"{value}"


pub def equal_model[T with PartialEq](left: &T, right: &T) -> bool:
    """Compare through the derived PartialEq implementation without consuming either model."""
    return PartialEq.eq(left, right)


pub def unequal_model[T with PartialEq](left: &T, right: &T) -> bool:
    """Preserve the derived PartialEq inequality contract."""
    return PartialEq.ne(left, right)


pub def less_model[T with PartialOrd](left: &T, right: &T) -> bool:
    """Preserve lexicographic derived partial ordering."""
    return PartialOrd.lt(left, right)


pub def less_equal_model[T with PartialOrd](left: &T, right: &T) -> bool:
    """Compare through PartialOrd, preserving unordered field results."""
    return PartialOrd.le(left, right)


pub def greater_model[T with PartialOrd](left: &T, right: &T) -> bool:
    """Compare through the derived greater-than implementation."""
    return PartialOrd.gt(left, right)


pub def greater_equal_model[T with PartialOrd](left: &T, right: &T) -> bool:
    """Compare through the derived greater-than-or-equal implementation."""
    return PartialOrd.ge(left, right)


pub def serialize_model[T with Serialize](value: &T) -> str:
    """Use the same serde stringify and structured error boundary as the legacy JSON protocol default."""
    return stringify_or_raise(value, type_name_of_val(value))


pub def deserialize_model[T with DeserializeOwned](text: &str) -> Result[T, str]:
    """Parse through the same serde decoding and error text as legacy's derived `from_json`."""
    return parse_or_error(text)


pub def serialize_int(value: int) -> str:
    """Serialize the canonical signed Incan integer through the legacy JSON builtin boundary."""
    return json_stringify(value)


pub def serialize_float(value: float) -> str:
    """Preserve serde's floating-point spelling and nonfinite-value behavior."""
    return json_stringify(value)


pub def serialize_bool(value: bool) -> str:
    """Serialize a boolean as the same lowercase JSON literal as legacy."""
    return json_stringify(value)


pub def serialize_string(value: &str) -> str:
    """Serialize borrowed string text with serde's escaping without consuming its source owner."""
    return json_stringify(value)
