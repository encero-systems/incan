pub def format_int(value: int) -> str:
    """Format an integer with the same conversion used by language string interpolation."""
    return str(value)


pub def format_float(value: float) -> str:
    """Preserve the language's float spelling, including visibly integral floats."""
    return str(value)


pub def format_bool(value: bool) -> str:
    """Format a boolean with the language's existing scalar conversion."""
    return str(value)


pub def println_text(value: str) -> None:
    """Print one formatted value followed by the language's normal newline."""
    println(value)


pub def clone_text(value: &str) -> str:
    """Create the owned display text for an already formatted borrowed string."""
    return str(value)


pub def validate_range(start: int, end: int, step: int) -> None:
    """Use the existing range constructor's error behavior before a normalized counting loop."""
    _ = runtime_range(start, end, step)


pub def assert_failure(message: str) -> None:
    """Raise the same assertion panic and empty-message fallback as the legacy language primitive."""
    assert false, message


pub def initialize_panic_hook() -> None:
    """Initialize canonical language panic reporting before executing a direct native main body."""
    initialize_entrypoint()


pub def debug_int(value: int) -> str:
    """Preserve legacy tuple element debug spelling."""
    return f"{value:?}"


pub def debug_float(value: float) -> str:
    """Preserve legacy tuple element debug spelling."""
    return f"{value:?}"


pub def debug_bool(value: bool) -> str:
    """Preserve legacy tuple element debug spelling."""
    return f"{value:?}"


pub def debug_unit(value: None) -> str:
    """Preserve the empty tuple spelling of a unit element."""
    return f"{value:?}"


pub def debug_text(value: &str) -> str:
    """Quote and escape text with the legacy tuple debug formatter."""
    return f"{value:?}"
