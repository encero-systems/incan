"""Language formatting and collection helpers used by the direct native route."""

pub from collections import empty_set, insert_set, length_set, contains_set, clone_set
pub from collections import extend_list_set, extend_set, extend_dict
pub from collections import (
    empty_dict,
    insert_dict,
    length_dict,
    contains_dict,
    clone_dict,
    get_dict,
    keys_dict,
    values_dict,
    default_dict,
    nth_set,
    nth_dict,
)
from rust::incan_std_core::iter import range as runtime_range
pub from strings import (
    concat_text,
    equal_text,
    unequal_text,
    less_text,
    less_equal_text,
    greater_text,
    greater_equal_text,
)
pub from lists import empty_list, append_list, length_list, get_list, set_list, clone_list
pub from lists import contains_list
pub from lists import borrow_list_mut
pub from lists import count_list, index_list, extend_list, pop_list, remove_list, swap_list


pub def format_int(value: int) -> str:
    """Format an integer with the same conversion used by language string interpolation."""
    return str(value)


pub def format_float(value: float) -> str:
    """Preserve the language's float spelling, including visibly integral floats."""
    return str(value)


pub def format_bool(value: bool) -> str:
    """Format a boolean with the language's existing scalar conversion."""
    return str(value)


pub def println_text(value: str) -> None:
    """Print one formatted value followed by the language's normal newline."""
    println(value)


pub def clone_text(value: &str) -> str:
    """Create the owned display text for an already formatted borrowed string."""
    return str(value)


pub def validate_range(start: int, end: int, step: int) -> None:
    """Use the existing range constructor's error behavior before a normalized counting loop."""
    _ = runtime_range(start, end, step)
