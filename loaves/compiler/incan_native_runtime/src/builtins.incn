"""Scalar builtin contracts shared with legacy emission."""

from rust::incan_std_core::strings import str_len
from rust::incan_std_core::errors import raise_value_error
from rust::std::fs import read_to_string, write as native_write
from rust::incan_std_core::collections::__private import (
    list_min_copy,
    list_max_copy,
    list_min_clone,
    list_max_clone,
    list_min_f64,
    list_max_f64,
)


pub def absolute_int(value: int) -> int:
    """Take absolute value: 1. Reject the unrepresentable minimum. 2. Preserve nonnegative values."""
    # 1. Preserve the builtin's checked overflow message.
    if absolute_overflows(value):
        raise_value_error("integer overflow in builtin `abs`")
    # 2. Negate only representable negative inputs.
    if value < 0:
        return -value
    return value


def absolute_overflows(value: int) -> bool:
    """Only the signed minimum has no representable absolute value."""
    return value == -9223372036854775808


pub def truth_int(value: int) -> bool:
    """Integers are false exactly at zero."""
    return value != 0


pub def truth_float(value: float) -> bool:
    """Floats are false at either signed zero and true for NaN."""
    return value != 0.0


pub def truth_bool(value: bool) -> bool:
    """Boolean conversion preserves its operand."""
    return value


pub def boolean_and(left: bool, right: bool) -> bool:
    """Combine already evaluated compiler-owned boolean operands."""
    return left and right


pub def boolean_or(left: bool, right: bool) -> bool:
    """Combine already evaluated compiler-owned boolean operands."""
    return left or right


pub def sum_int(values: &list[int]) -> int:
    """Sum integers: 1. Accumulate in source order through the checked builtin error boundary."""
    # 1. Reject overflow at the same first item as the original checked fold.
    mut total = 0
    for value in values:
        total = sum_add(total, value)
    return total


pub def sum_bool(values: &list[bool]) -> int:
    """Sum booleans: 1. Accumulate zero or one through the same checked builtin boundary."""
    # 1. Count accepted values without changing order or overflow behavior.
    mut total = 0
    for value in values:
        if value:
            total = sum_add(total, 1)
    return total


def sum_add(total: int, value: int) -> int:
    """Preserve the builtin fold's exact overflow error before performing representable integer addition."""
    if sum_overflows(total, value):
        raise_value_error("integer overflow in builtin `sum`")
    return total + value


def sum_overflows(total: int, value: int) -> bool:
    """Compare against safe signed bounds without overflowing the guard's own subtraction."""
    if value > 0:
        return total > 9223372036854775807 - value
    if value < 0:
        return total < -9223372036854775808 - value
    return false


pub def minimum_int(values: &list[int]) -> int:
    """Borrow integer elements through legacy's minimum helper, including its empty-list error."""
    return list_min_copy(values)


pub def maximum_int(values: &list[int]) -> int:
    """Borrow integer elements through legacy's maximum helper, including its empty-list error."""
    return list_max_copy(values)


pub def minimum_float(values: &list[float]) -> float:
    """Use legacy floating minimum and its NaN and empty-list conventions."""
    return list_min_f64(values)


pub def maximum_float(values: &list[float]) -> float:
    """Use legacy floating maximum and its NaN and empty-list conventions."""
    return list_max_f64(values)


pub def minimum_bool(values: &list[bool]) -> bool:
    """Order borrowed booleans with false before true, preserving the empty-list error."""
    return list_min_copy(values)


pub def maximum_bool(values: &list[bool]) -> bool:
    """Order borrowed booleans with true after false, preserving the empty-list error."""
    return list_max_copy(values)


pub def minimum_text(values: &list[str]) -> str:
    """Clone the smallest borrowed string through the same helper as legacy."""
    return list_min_clone(values)


pub def maximum_text(values: &list[str]) -> str:
    """Clone the largest borrowed string through the same helper as legacy."""
    return list_max_clone(values)


pub def read_file_text(path: &str) -> Result[str, str]:
    """Read UTF-8 text: 1. Call native file I/O. 2. Preserve its error's Display text."""
    # 1. Read the original borrowed path; 2. preserve the original error text.
    match read_to_string(path):
        Ok(text) => return Ok(text)
        Err(error) => return Err(error.to_string())


pub def write_file_text(path: &str, content: &str) -> Result[None, str]:
    """Write UTF-8 text: 1. Call native file I/O. 2. Retain unit success or the original error text."""
    # 1. Write the original borrowed text; 2. preserve unit success or the original error text.
    match native_write(path, content):
        Ok(_value) => return Ok(None)
        Err(error) => return Err(error.to_string())


pub def truth_text(value: &str) -> bool:
    """Empty text is false; every nonempty string is true."""
    return str_len(value) != 0


pub def truth_list[T](value: &list[T]) -> bool:
    """Test list emptiness without consuming its owner."""
    return len(value) != 0


pub def power_i64(left: int, right: int) -> int:
    """
    Match legacy's `i64::pow`: the same `u32` exponent truncation and Rust's square-and-multiply steps.

    Each step uses `*`, which overflows exactly as Rust's `pow` does in the same profile, so results and overflow
    panics agree with legacy.
    """
    mut exponent = right & 4294967295
    if exponent == 0:
        return 1
    mut base = left
    mut accumulator = 1
    while exponent > 1:
        if exponent & 1 == 1:
            accumulator = accumulator * base
        exponent = exponent // 2
        base = base * base
    return accumulator * base


pub def power_f64(left: float, right: float) -> float:
    """Use legacy floating exponentiation without changing NaN or infinity behavior."""
    return left ** right


pub def power_f32(left: f32, right: f32) -> f32:
    """Retain single-precision exponentiation through legacy exact-width emission."""
    return left ** right
