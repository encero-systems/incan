"""UTF-8 codec boundaries preserving borrowed storage and the frozen legacy contract."""

from rust::std::string import String as RustString
from rust::std::vec import Vec as RustVec
from rust::std::convert import Into as RustInto
from rust::incan_std_core::frozen import FrozenStr as RuntimeFrozenStr, FrozenBytes as RuntimeFrozenBytes
from rust::std::str import from_utf8
from rust::incan_lang::lang::text_codecs import normalize_encoding_label, is_utf8_encoding_label
from rust::incan_std_core::validation import ValidationError as RuntimeError
from rust::incan_std_core::errors import raise_value_error
from validation_errors import make_coded_validation_error
from frozen_collections import own_static_bytes


pub def text_codec_encoding_valid(encoding: &RustString) -> bool:
    """Validate the normalized encoding before a computed receiver or error policy is evaluated."""
    return is_utf8_encoding_label(normalize_encoding_label(encoding.as_str()))


pub def text_codec_errors_valid(errors: &RustString) -> bool:
    """Admit only the decoder's strict and replacement policies before reading its receiver."""
    return errors.as_str() == "strict" or errors.as_str() == "replace"


pub def encode_text(value: &RustString, encoding: &RustString) -> bytes:
    """Copy shared UTF-8 text, reporting unsupported dynamic labels through legacy's ValueError primitive."""
    validate_encoder_label(encoding)
    copy: RustString = value.clone()
    return copy.into_bytes()


pub def encode_frozen_text(value: RuntimeFrozenStr, encoding: &RustString) -> bytes:
    """Validate the encoding and copy frozen UTF-8 bytes directly into the result allocation."""
    validate_encoder_label(encoding)
    return RustInto.into(value.as_str())


def validate_encoder_label(encoding: &RustString) -> None:
    """Preserve the encoder's normalized label diagnostic without copying its UTF-8 receiver."""
    label = normalize_encoding_label(encoding.as_str())
    if not is_utf8_encoding_label(label):
        raise_value_error(f"str.encode() supports only utf-8 in this release, got encoding '{label}'")


pub def decode_bytes(value: &RustVec[u8], encoding: &RustString, errors: &RustString) -> Result[str, RuntimeError]:
    """Decode a shared byte vector with the exact strict, replacement, label and error-policy behavior."""
    label = normalize_encoding_label(encoding.as_str())
    if not is_utf8_encoding_label(label):
        return Err(
            make_coded_validation_error(
                f"bytes.decode() supports only utf-8 in this release, got encoding '{label}'",
                "unknown-encoding",
            ),
        )
    if errors.as_str() == "replace":
        return Ok(RustString.from_utf8_lossy(value.as_slice()).into_owned())
    if not text_codec_errors_valid(errors):
        return Err(
            make_coded_validation_error(
                f"bytes.decode() errors must be \"strict\" or \"replace\", got '{errors}'",
                "unknown-errors-policy",
            ),
        )
    # Strict decoding validates once and owns only successfully validated borrowed text.
    match from_utf8(value.as_slice()):
        Err(error) =>
            return Err(make_coded_validation_error(f"'utf-8' codec can't decode bytes: {error}", "invalid-utf8"))
        Ok(text) => return Ok(RustString.from(text))


pub def decode_frozen_bytes(
    value: RuntimeFrozenBytes,
    encoding: &RustString,
    errors: &RustString,
) -> Result[str, ValidationError]:
    """Copy the frozen slice into ordinary byte storage and reuse that decoder, never calling this boundary again."""
    owned: RustVec[u8] = own_static_bytes(value.as_slice())
    return decode_bytes(owned, encoding, errors)
