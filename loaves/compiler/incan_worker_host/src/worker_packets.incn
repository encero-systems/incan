"""Typed IPC packets for a compiler worker generation with the version-three capability."""

from std.primitives.crumb.descriptions import Description, DescriptionMode
from std.primitives.crumb.records import RowRecord
from std.primitives.crumb.values import Value, ValueField
from pub::incan_platform.ipc import MAX_FRAME
from pub::internal_models.crumb_rows import ModelField, admit_rows, encode_rows, model_description, operation_budget, required_value
from pub::internal_models.graph_crumb_fields import text

pub const PREFIX: str = "cw3-"
pub const COMPILE: bytes = b"wkcprq\x00"
pub const READY: bytes = b"wkrdy_\x00"
pub const COMPLETE: bytes = b"wkdone\x00"
pub const PREPARE: bytes = b"wkprep\x00"
pub const PREPARED: bytes = b"wkpred\x00"
pub const NEED: bytes = b"wkneed\x00"
pub const EVALUATE: bytes = b"wkeval\x00"
pub const PRODUCED: bytes = b"wkprod\x00"
pub const REFUSAL: bytes = b"wkrefu\x00"
pub const FAULT: bytes = b"wkfalt\x00"

pub model Packet:
    pub key: bytes
    pub generation: str
    pub fields: list[ValueField]


pub def is_key(key: bytes, expected: bytes) -> bool:
    return key == expected


def description(key: bytes) -> Result[Description, str]:
    mut name = ""
    mut fields = [ModelField(identity=b"000gen", name="generation", storage="string")]
    if is_key(key, COMPILE):
        name = "compile"
        fields.append(ModelField(identity=b"argums", name="arguments", storage="list<string>"))
        fields.append(ModelField(identity=b"cwd___", name="cwd", storage="string"))
        fields.append(ModelField(identity=b"retire", name="retire_after", storage="boolean"))
        fields.append(ModelField(identity=b"stderr", name="stderr", storage="string"))
        fields.append(ModelField(identity=b"stdout", name="stdout", storage="string"))
    elif is_key(key, READY):
        name = "ready"
        fields.append(ModelField(identity=b"pid___", name="pid", storage="i64"))
    elif is_key(key, COMPLETE):
        name = "complete"
        fields.append(ModelField(identity=b"exit__", name="exit", storage="i64"))
        fields.append(ModelField(identity=b"handof", name="handoff", storage="string"))
        fields.append(ModelField(identity=b"reason", name="reason", storage="string"))
        fields.append(ModelField(identity=b"retire", name="retired", storage="boolean"))
    elif is_key(key, PREPARE):
        name = "prepare"
        fields.append(ModelField(identity=b"demand", name="demand_root", storage="string"))
        fields.append(ModelField(identity=b"profil", name="producer_profile", storage="string"))
        fields.append(ModelField(identity=b"snap__", name="snapshot", storage="string"))
        fields.append(ModelField(identity=b"stage_", name="stage", storage="string"))
    elif is_key(key, PREPARED):
        name = "prepared"
        fields.append(ModelField(identity=b"prepar", name="prepared_root", storage="string"))
    elif is_key(key, NEED):
        name = "need"
        fields.append(ModelField(identity=b"keys__", name="keys_root", storage="string"))
        fields.append(ModelField(identity=b"rank__", name="earlier_rank", storage="i64"))
    elif is_key(key, EVALUATE):
        name = "evaluate"
        fields.append(ModelField(identity=b"cancel", name="cancellation_generation", storage="i64"))
        fields.append(ModelField(identity=b"prepar", name="prepared_root", storage="string"))
        fields.append(ModelField(identity=b"reserv", name="reservation", storage="string"))
        fields.append(ModelField(identity=b"snap__", name="snapshot", storage="string"))
        fields.append(ModelField(identity=b"work__", name="work_root", storage="string"))
    elif is_key(key, PRODUCED):
        name = "produced"
        fields.append(ModelField(identity=b"counts", name="counter_root", storage="string"))
        fields.append(ModelField(identity=b"diag__", name="diagnostic_root", storage="string"))
        fields.append(ModelField(identity=b"staged", name="staged_root", storage="string"))
        fields.append(ModelField(identity=b"witnes", name="witness_root", storage="string"))
    elif is_key(key, REFUSAL):
        name = "refusal"
        fields.append(ModelField(identity=b"diag__", name="diagnostic_root", storage="string"))
        fields.append(ModelField(identity=b"witnes", name="witness_root", storage="string"))
    elif is_key(key, FAULT):
        name = "fault"
        fields.append(ModelField(identity=b"fault_", name="fault_root", storage="string"))
    else:
        return Err("unknown compiler worker Crumb family")
    return Ok(model_description(key, "incan.compiler-worker/3/" + name, fields))


pub def write_packet(key: bytes, generation: str, fields: list[ValueField]) -> Result[bytes, str]:
    if not generation.startswith(PREFIX):
        return Err("unsupported compiler worker wire generation")
    values = [required_value(b"000gen", Value.Text(generation))] + fields
    return encode_rows(description(key)?, [RowRecord(key=key, value=Value.Record(values))], MAX_FRAME)


pub def read_packet(encoded: bytes) -> Result[Packet, str]:
    if len(encoded) > MAX_FRAME:
        return Err("compiler worker frame exceeds transport limit")
    mut budget = operation_budget(MAX_FRAME * 4)?
    mut choices: list[Description] = []
    for key in [COMPILE, READY, COMPLETE, PREPARE, PREPARED, NEED, EVALUATE, PRODUCED, REFUSAL, FAULT]:
        choices.append(description(key)?)
    rows = admit_rows(encoded, choices, MAX_FRAME, budget)?
    dictionary = rows.descriptions(budget).map_err((error) => error.message())?
    if rows.len() != 1 or len(dictionary) != 1:
        return Err("compiler worker frame requires one referenced schema and row")
    match dictionary[0].mode:
        DescriptionMode.Inline => return Err("inline compiler worker frame is unsupported")
        DescriptionMode.Reference => pass
    row = rows.read_record(0, budget).map_err((error) => error.message())?
    match row.value:
        Value.Record(fields) =>
            if len(fields) == 0 or fields[0].identity != b"000gen":
                return Err("compiler worker packet has no generation")
            return Ok(Packet(key=row.key, generation=text(fields[0].value)?, fields=fields[1:]))
        _ => return Err("expected compiler worker record")


pub def value_of(packet: Packet, identity: bytes) -> Result[Value, str]:
    for field in packet.fields:
        if field.identity == identity:
            return Ok(field.value)
    return Err("missing compiler worker packet field")


pub def flag(value: Value) -> Result[bool, str]:
    match value:
        Value.Boolean(selected) => return Ok(selected)
        _ => return Err("invalid compiler worker Boolean")
