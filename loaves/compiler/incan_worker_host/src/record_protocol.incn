"""Record activation messages carried by `incan.compiler-worker/2`, separate from the client engine protocol."""

from rust::std::string import String as RustString
from std.json import JsonValue, parse

pub const RECORD_SCHEMA: str = "incan.compiler-worker/2"
const MAX_RANK: int = 4294967295


@derive(Eq)
pub enum RecordMessageKind(str):
    """The one closed worker record-message family."""

    Prepare = "prepare"
    Prepared = "prepared"
    NeedPrerequisite = "need-prerequisite"
    Evaluate = "evaluate"
    Produced = "produced"
    SemanticRefusal = "semantic-refusal"
    CompilerFault = "compiler-fault"


@derive(Eq)
pub model Prepare:
    """Compiler-owned preparation descriptors for one producer stage."""

    pub stage: str
    pub snapshot: str
    pub demand_root: str
    pub producer_profile: str


@derive(Eq)
pub model Prepared:
    """The immutable prepared-input envelope the engine may schedule for evaluation."""

    pub prepared_root: str


@derive(Eq)
pub model NeedPrerequisite:
    """Earlier-rank scheduling input returned without evaluating a record."""

    pub keys_root: str
    pub earlier_rank: int


@derive(Eq)
pub model Evaluate:
    """Prepared record work admitted under one resource reservation."""

    pub work_root: str
    pub snapshot: str
    pub prepared_root: str
    pub reservation: str
    pub cancellation_generation: int


@derive(Eq)
pub model Produced:
    """Staged record value and evidence roots returned for atomic publication."""

    pub staged_root: str
    pub witness_root: str
    pub diagnostic_root: str
    pub counter_root: str


@derive(Eq)
pub model SemanticRefusal:
    """Compiler-owned diagnostics and the complete read evidence supporting the refusal."""

    pub diagnostic_root: str
    pub witness_root: str


@derive(Eq)
pub model CompilerFault:
    """A typed compiler-service fault staged under one immutable root."""

    pub fault_root: str


@derive(Eq)
pub enum RecordMessage:
    """Every request and reply body of the version-two worker record protocol."""

    Prepare(Prepare)
    Prepared(Prepared)
    NeedPrerequisite(NeedPrerequisite)
    Evaluate(Evaluate)
    Produced(Produced)
    SemanticRefusal(SemanticRefusal)
    CompilerFault(CompilerFault)


pub enum RecordAdmission:
    """Whether one received frame is a valid version-two request for this worker."""

    Admitted(RecordMessage)
    NotRecordProtocol
    Incompatible
    ProtocolFault


pub def admit_record(payload: bytes, generation: str) -> RecordAdmission:
    """Admit only Prepare or Evaluate for this generation; replies sent as requests are protocol faults."""
    text = RustString.from_utf8(payload)
    match text:
        Err(_) => return RecordAdmission.NotRecordProtocol
        Ok(encoded) =>
            parsed = parse(str(encoded))
            match parsed:
                Err(_) => return RecordAdmission.NotRecordProtocol
                Ok(document) =>
                    match document.get("schema"):
                        None => return RecordAdmission.NotRecordProtocol
                        Some(value) =>
                            match value.as_str():
                                Some(schema) =>
                                    if schema != RECORD_SCHEMA:
                                        return RecordAdmission.NotRecordProtocol
                                None => return RecordAdmission.NotRecordProtocol
                    match document.get("generation"):
                        None => return RecordAdmission.Incompatible
                        Some(value) =>
                            match value.as_str():
                                Some(found) =>
                                    if found != generation:
                                        return RecordAdmission.Incompatible
                                None => return RecordAdmission.Incompatible
    match decode_record_message(payload, generation):
        Err(_) => return RecordAdmission.ProtocolFault
        Ok(message) =>
            match message:
                RecordMessage.Prepare(_) => return RecordAdmission.Admitted(message)
                RecordMessage.Evaluate(_) => return RecordAdmission.Admitted(message)
                _ => return RecordAdmission.ProtocolFault


pub def encode_record_message(message: RecordMessage, generation: str) -> bytes:
    """Encode one record activation with its worker generation and version-two schema."""
    mut fields: Dict[str, JsonValue] = {}
    fields["schema"] = JsonValue.string(RECORD_SCHEMA)
    fields["generation"] = JsonValue.string(generation)
    match message:
        RecordMessage.Prepare(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.Prepare.value())
            fields["stage"] = JsonValue.string(value.stage)
            fields["snapshot"] = JsonValue.string(value.snapshot)
            fields["demand_root"] = JsonValue.string(value.demand_root)
            fields["producer_profile"] = JsonValue.string(value.producer_profile)
        RecordMessage.Prepared(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.Prepared.value())
            fields["prepared_root"] = JsonValue.string(value.prepared_root)
        RecordMessage.NeedPrerequisite(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.NeedPrerequisite.value())
            fields["keys_root"] = JsonValue.string(value.keys_root)
            fields["earlier_rank"] = JsonValue.int(value.earlier_rank)
        RecordMessage.Evaluate(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.Evaluate.value())
            fields["work_root"] = JsonValue.string(value.work_root)
            fields["snapshot"] = JsonValue.string(value.snapshot)
            fields["prepared_root"] = JsonValue.string(value.prepared_root)
            fields["reservation"] = JsonValue.string(value.reservation)
            fields["cancellation_generation"] = JsonValue.int(value.cancellation_generation)
        RecordMessage.Produced(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.Produced.value())
            fields["staged_root"] = JsonValue.string(value.staged_root)
            fields["witness_root"] = JsonValue.string(value.witness_root)
            fields["diagnostic_root"] = JsonValue.string(value.diagnostic_root)
            fields["counter_root"] = JsonValue.string(value.counter_root)
        RecordMessage.SemanticRefusal(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.SemanticRefusal.value())
            fields["diagnostic_root"] = JsonValue.string(value.diagnostic_root)
            fields["witness_root"] = JsonValue.string(value.witness_root)
        RecordMessage.CompilerFault(value) =>
            fields["kind"] = JsonValue.string(RecordMessageKind.CompilerFault.value())
            fields["fault_root"] = JsonValue.string(value.fault_root)
    match JsonValue.object(fields).to_json():
        Ok(encoded) => return encoded.encode("utf-8")
        Err(_) => return "{}".encode("utf-8")


pub def decode_record_message(payload: bytes, generation: str) -> Result[RecordMessage, str]:
    """Decode only an exact version-two record message for this worker generation."""
    text = RustString.from_utf8(payload).map_err((_) => "the record frame is not UTF-8")?
    document = parse(str(text)).map_err((error) => error.message())?
    if required_text(document, "schema")? != RECORD_SCHEMA or required_text(document, "generation")? != generation:
        return Err("compiler worker generation or record protocol mismatch")
    match RecordMessageKind.from_value(required_text(document, "kind")?):
        Some(RecordMessageKind.Prepare) =>
            return Ok(
                RecordMessage.Prepare(
                    Prepare(
                        stage=required_text(document, "stage")?,
                        snapshot=required_text(document, "snapshot")?,
                        demand_root=required_text(document, "demand_root")?,
                        producer_profile=required_text(document, "producer_profile")?,
                    ),
                ),
            )
        Some(RecordMessageKind.Prepared) =>
            return Ok(
                RecordMessage.Prepared(
                    Prepared(prepared_root=required_text(document, "prepared_root")?),
                ),
            )
        Some(RecordMessageKind.NeedPrerequisite) =>
            return Ok(
                RecordMessage.NeedPrerequisite(
                    NeedPrerequisite(
                        keys_root=required_text(document, "keys_root")?,
                        earlier_rank=bounded_integer(document, "earlier_rank")?,
                    ),
                ),
            )
        Some(RecordMessageKind.Evaluate) =>
            return Ok(
                RecordMessage.Evaluate(
                    Evaluate(
                        work_root=required_text(document, "work_root")?,
                        snapshot=required_text(document, "snapshot")?,
                        prepared_root=required_text(document, "prepared_root")?,
                        reservation=required_text(document, "reservation")?,
                        cancellation_generation=bounded_integer(document, "cancellation_generation")?,
                    ),
                ),
            )
        Some(RecordMessageKind.Produced) =>
            return Ok(
                RecordMessage.Produced(
                    Produced(
                        staged_root=required_text(document, "staged_root")?,
                        witness_root=required_text(document, "witness_root")?,
                        diagnostic_root=required_text(document, "diagnostic_root")?,
                        counter_root=required_text(document, "counter_root")?,
                    ),
                ),
            )
        Some(RecordMessageKind.SemanticRefusal) =>
            return Ok(
                RecordMessage.SemanticRefusal(
                    SemanticRefusal(
                        diagnostic_root=required_text(document, "diagnostic_root")?,
                        witness_root=required_text(document, "witness_root")?,
                    ),
                ),
            )
        Some(RecordMessageKind.CompilerFault) =>
            return Ok(
                RecordMessage.CompilerFault(
                    CompilerFault(fault_root=required_text(document, "fault_root")?),
                ),
            )
        None => return Err("unknown compiler worker record message")


pub def accept_record_reply(request: RecordMessage, reply: RecordMessage) -> Result[RecordMessage, str]:
    """Accept only the closed reply set of the exact request; every other pairing is a protocol fault."""
    mut accepted = false
    match request:
        RecordMessage.Prepare(_) =>
            match reply:
                RecordMessage.Prepared(_) => accepted = true
                RecordMessage.NeedPrerequisite(_) => accepted = true
                RecordMessage.SemanticRefusal(_) => accepted = true
                RecordMessage.CompilerFault(_) => accepted = true
                _ => pass
        RecordMessage.Evaluate(_) =>
            match reply:
                RecordMessage.Produced(_) => accepted = true
                RecordMessage.SemanticRefusal(_) => accepted = true
                RecordMessage.CompilerFault(_) => accepted = true
                _ => pass
        _ => pass
    if not accepted:
        return Err("compiler worker record reply does not match its request")
    return Ok(reply)


def required_text(document: JsonValue, name: str) -> Result[str, str]:
    """Read one required string field without accepting another JSON kind."""
    match document.get(name):
        Some(value) =>
            match value.as_str():
                Some(found) => return Ok(found)
                None => return Err(f"`{name}` must be text")
        None => return Err(f"missing `{name}`")


def bounded_integer(document: JsonValue, name: str) -> Result[int, str]:
    """Read one unsigned 32-bit protocol integer through Incan's integer carrier."""
    match document.get(name):
        Some(value) =>
            match value.as_int():
                Some(found) =>
                    if found >= 0 and found <= MAX_RANK:
                        return Ok(found)
                    return Err(f"`{name}` exceeds u32")
                None => return Err(f"`{name}` must be an integer")
        None => return Err(f"missing `{name}`")
