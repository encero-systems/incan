"""Resolve one final-family activation into decoded source and local inputs."""

from pub::internal_models import prepared_reader
from pub::internal_models.checker_records import (
    CHECKER_PROFILE,
    CheckedFamily,
    CodecFault,
    decode_record,
    native_fields,
)
from pub::internal_models.records import ReadReceipt, ReadScope, RecordRead
from checked_activation import ResolvedCheckingActivation


pub model FinalActivationInputs:
    """Decoded values passed to the frontend's single-owner final entry, plus their completed read receipt."""

    pub source: str
    pub owner: str
    pub local: list[list[str]]
    pub environment: list[list[list[str]]]
    pub environment_names: list[str]
    pub environment_identities: list[str]
    pub receipt: ReadReceipt


pub def read_final_activation(activation: ResolvedCheckingActivation) -> Result[FinalActivationInputs, str]:
    """
    Construct the prepared reader and decode only one source and its matching local value.

    Declaration records supply only the stable identities needed to rebind the selected local value. No ambient
    checker or sibling local value is available to final settlement.
    """
    resolved = activation.snapshot
    ready = activation.ready
    prepared = activation.prepared
    snapshot = prepared.snapshot
    mut reader = prepared_reader(ready, snapshot, prepared).map_err((_) => "invalid final activation preparation")?
    scope = ReadScope(snapshot=snapshot.root.digest, profile=ready.profile.identity.digest)
    source = resolved.record_source(scope)
    mut module_header: Option[str] = None
    mut owner_source: Option[str] = None
    mut owner = ""
    mut local: Option[list[list[str]]] = None
    mut environment: list[list[list[str]]] = []
    mut environment_names: list[str] = []
    mut environment_identities: list[str] = []
    for request in prepared.required_reads:
        found = match reader.read(source, request):
            RecordRead.Found(value) => value.value
            RecordRead.Deleted(_) => return Err("final activation input was deleted")
            RecordRead.Absent(_) => return Err("final activation input is absent")
            RecordRead.Members(_) => return Err("final activation input cannot be a member page")
            RecordRead.Failed(_) => return Err("final activation record read failed")

        if request.key.family == "module-header" and request.key.facet == "module":
            if module_header is not None:
                return Err("final activation requires one module header")
            module_header = Some(found.decode().map_err((_) => "final module header is not UTF-8")?)
        elif request.key.family == "owner-source" and request.key.facet != "":
            if owner_source is not None:
                return Err("final activation requires one named owner source")
            owner_source = Some(found.decode().map_err((_) => "final owner source is not UTF-8")?)
            owner = request.key.facet
        elif (
            request.key.family == "local"
            and request.key.identity == ready.output.identity
            and request.key.context != ""
        ):
            if local is not None:
                return Err("final activation has more than one own local input")
            record = decode_record(found, CHECKER_PROFILE, request.key.identity, request.key.context).map_err(
                (fault) => "final local record is invalid: " + codec_fault_name(fault),
            )?
            if record.family != CheckedFamily.Local:
                return Err("final activation requires a local-family input")
            local = Some(native_fields(record).map_err((_) => "final local fields are invalid")?)
        elif request.key.family == "declaration" and request.key.context != "":
            record = decode_record(found, CHECKER_PROFILE, request.key.identity, request.key.context).map_err(
                (_) => "final declaration record is invalid",
            )?
            if record.family != CheckedFamily.Declaration:
                return Err("final activation requires declaration-family environment values")
            environment.append(native_fields(record).map_err((_) => "final declaration fields are invalid")?)
            environment_names.append(request.key.facet)
            environment_identities.append(request.key.identity)
        else:
            return Err("final activation prepared an unsupported input family")
    completed = reader.finish().map_err((_) => "final activation read receipt is incomplete")?
    match (module_header, owner_source, local):
        (Some(header_value), Some(source_value), Some(local_value)) =>
            return Ok(
                FinalActivationInputs(
                    source=header_value + source_value,
                    owner=owner,
                    local=local_value,
                    environment=environment,
                    environment_names=environment_names,
                    environment_identities=environment_identities,
                    receipt=completed,
                ),
            )
        _ => return Err("final activation is missing module header, owner source or local input")


def codec_fault_name(fault: CodecFault) -> str:
    """Name the exact local-codec refusal without leaking input values into worker diagnostics."""
    match fault:
        CodecFault.Malformed => return "malformed"
        CodecFault.ProfileMismatch => return "profile mismatch"
        CodecFault.OwnerMismatch => return "owner mismatch"
        CodecFault.BodyChanged => return "body changed"
        CodecFault.Unsupported(_) => return "unsupported"
        CodecFault.Limit => return "limit"
        CodecFault.LimitExceeded(_, _, _) => return "limit exceeded"
