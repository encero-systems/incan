"""Store-backed compiler reads retain authenticated value, tombstone, exclusion and membership facts."""

from pub::incan_platform.store import begin, commit, delete, put
from pub::incan_platform.store import snapshot as store_snapshot
from pub::incan_platform.store.memory import root as memory_root
from records import (
    DeletedFact,
    MemberFact,
    MemberSelection,
    RecordKey,
    RecordRead,
    RecordRequest,
    RecordSelection,
    ReadScope,
    StoreRecordSource,
    encode_record_key,
)


pub def test_store_record_source_returns_each_authenticated_binding_kind() -> Result[None, str]:
    """Read present, deleted, absent and bounded members through one pinned compiler snapshot."""
    root = memory_root()
    scope = ReadScope(snapshot="snapshot", profile="profile")
    present = key("present")
    deleted = key("deleted")
    missing = key("missing")
    group = key("group")
    mut selected = store_snapshot(root).map_err((error) => error.message())?
    mut transaction = put(begin(selected), encode_record_key(present)?, b"value")
    transaction = put(transaction, encode_record_key(deleted)?, b"old")
    transaction = put(transaction, encode_record_key(group)? + "\tone", b"one")
    transaction = put(transaction, encode_record_key(group)? + "\ttwo", b"two")
    selected = commit(transaction).map_err((error) => error.message())?
    selected = commit(delete(begin(selected), encode_record_key(deleted)?)).map_err((error) => error.message())?
    source = StoreRecordSource.open(selected, scope, ["body"])

    present_request = field(present)
    match source.read(scope, present_request):
        RecordRead.Found(found) =>
            assert found.value == b"value"
            assert found.evidence.revision != ""
            assert found.evidence.semantic_digest != ""
            assert found.selection_digest != ""
        _ =>
            assert false, "present record did not return selected evidence"

    deleted_request = field(deleted)
    match source.read(scope, deleted_request):
        RecordRead.Deleted(found) =>
            assert found.revision != ""
        _ =>
            assert false, "tombstone did not retain its revision"

    missing_request = field(missing)
    match source.read(scope, missing_request):
        RecordRead.Absent(absent) =>
            assert absent.exclusion_digest != ""
        _ =>
            assert false, "absence did not retain exclusion evidence"

    members_request = RecordRequest(
        key=group,
        selection=RecordSelection.Members(
            MemberSelection(selector="children", order="canonical", lower="", upper="", continuation=""),
        ),
    )
    match source.read(scope, members_request):
        RecordRead.Members(found) =>
            assert found.value == b"one\x0atwo"
            assert found.membership_digest != ""
            assert found.continuation == "end"
        _ =>
            assert false, "member selection did not retain bounded membership evidence"
    return Ok(None)


def key(identity: str) -> RecordKey:
    """Create one valid compiler record key in the allowed family."""
    return RecordKey(
        family="body",
        identity_profile="identity/1",
        origin="package",
        identity=identity,
        facet="ir",
        context="",
    )


def field(selected: RecordKey) -> RecordRequest:
    """Select the stored record value while naming the semantic field observed by the caller."""
    return RecordRequest(key=selected, selection=RecordSelection.Field("value"))
