"""Retained entry records bind the exact selected generation, entry and ordered lowering inputs."""

from plan_function_records import encode_entry_record, verify_entry_record


pub def test_entry_validation_depends_on_all_current_inputs() -> Result[None, str]:
    inputs = ["incan.plan-entry/2", "toolchain", "main", "implicit-main", "callee-key"]
    record = encode_entry_record("main", inputs)?
    verify_entry_record(record, "main", inputs)?
    assert verify_entry_record(record, "other", inputs).is_err()
    for index in range(len(inputs)):
        mut changed = inputs.clone()
        changed[index] = "different"
        assert verify_entry_record(record, "main", changed).is_err()
    assert verify_entry_record(record + b"x", "main", inputs).is_err()
    assert verify_entry_record(b"invalid", "main", inputs).is_err()
    return Ok(None)
