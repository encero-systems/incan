"""Stage 5 controls for bounded executable indexes and authorized selected reads."""

from compiler_records import (
    CanonicalSymbolId,
    DeclarationKind,
    HirSourceSpan,
    PackageIdentity,
    SymbolNamespace,
    SymbolOrigin,
)
from executable_records import (
    ExecutableDeclarationCoverage,
    ExecutableIndexEntry,
    ExecutableSelection,
    ExecutableSurfaceIndex,
    MAX_EXECUTABLE_INDEX_BYTES,
    select_execution_closure,
    valid_executable_surface_index,
)


pub def test_selected_root_reaches_private_implementation() -> None:
    """Select one public root and follow its checked private dependency without promoting that dependency."""
    helper = identity("helper", DeclarationKind.Function)
    root = identity("run", DeclarationKind.Function)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root.clone(), 2u64, 3u64, [helper.clone()])],
        implementation=[covered(helper.clone(), 0u64, 2u64, [])],
    )
    assert valid_executable_surface_index(index.clone(), 100u64, 5u64) == Ok(None)
    assert select_execution_closure(index, root) == Ok(
        ExecutableSelection(declarations=[root, helper], external_requirements=[]),
    )


pub def test_private_implementation_is_not_a_root() -> None:
    """Refuse direct selection of an implementation record even when a public declaration may require it."""
    helper = identity("helper", DeclarationKind.Function)
    root = identity("run", DeclarationKind.Function)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root, 2u64, 3u64, [helper.clone()])],
        implementation=[covered(helper.clone(), 0u64, 2u64, [])],
    )
    match select_execution_closure(index, helper):
        Err(reason) =>
            assert reason == "selected declaration is not a public executable root"
        Ok(_selected) =>
            assert false


pub def test_ranges_are_complete_and_contiguous() -> None:
    """Refuse a gap before the selected payload and a payload length not covered by the final fragment."""
    root = identity("run", DeclarationKind.Function)
    gap = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root.clone(), 1u64, 2u64, [])],
        implementation=[],
    )
    assert refused(gap, 100u64, 3u64, "fragment ranges overlap, contain gaps, or are empty")
    short = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root, 0u64, 2u64, [])],
        implementation=[],
    )
    assert refused(short, 100u64, 3u64, "executable index does not match payload length")


pub def test_duplicate_and_unsorted_identities_refuse() -> None:
    """Refuse a duplicated public key and requirements that are not in strict canonical order."""
    first = identity("first", DeclarationKind.Function)
    second = identity("second", DeclarationKind.Function)
    duplicate = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(first.clone(), 0u64, 1u64, []), covered(first.clone(), 1u64, 1u64, [])],
        implementation=[],
    )
    assert refused(duplicate, 100u64, 2u64, "public executable identities are duplicated or unsorted")
    unsorted = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(first, 0u64, 1u64, [second, identity("alpha", DeclarationKind.Function)])],
        implementation=[],
    )
    assert refused(unsorted, 100u64, 1u64, "executable requirements are duplicated or unsorted")


pub def test_public_and_private_partitions_do_not_overlap() -> None:
    """Refuse one identity appearing as both an authorized root and a private implementation dependency."""
    root = identity("run", DeclarationKind.Function)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root.clone(), 0u64, 1u64, [])],
        implementation=[covered(root, 1u64, 1u64, [])],
    )
    assert refused(index, 100u64, 2u64, "public and implementation identities overlap")


pub def test_type_context_requires_covered_same_owner() -> None:
    """Refuse a field context whose declaring model is absent instead of fabricating a type owner."""
    field = identity("field", DeclarationKind.Field)
    owner = identity("record", DeclarationKind.Model)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[ExecutableIndexEntry(identity=field, coverage=ExecutableDeclarationCoverage.TypeContext(owner))],
        implementation=[],
    )
    assert refused(index, 100u64, 0u64, "public member context does not select a covered declaring type")


pub def test_type_context_selects_only_its_covered_owner_record() -> None:
    """Follow a public field to its private owner without treating the field context as a declaration RecordSet."""
    field = identity("field", DeclarationKind.Field)
    owner = identity("record", DeclarationKind.Model)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[ExecutableIndexEntry(identity=field, coverage=ExecutableDeclarationCoverage.TypeContext(owner.clone()))],
        implementation=[covered(owner.clone(), 0u64, 1u64, [])],
    )
    assert valid_executable_surface_index(index.clone(), 100u64, 1u64) == Ok(None)
    assert select_execution_closure(index, identity("field", DeclarationKind.Field)) == Ok(
        ExecutableSelection(declarations=[owner], external_requirements=[]),
    )


pub def test_index_limit_and_package_version_are_admission_facts() -> None:
    """Refuse oversized metadata and an entry from a different version of the named provider."""
    root = identity("run", DeclarationKind.Function)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root.clone(), 0u64, 1u64, [])],
        implementation=[],
    )
    assert refused(index, MAX_EXECUTABLE_INDEX_BYTES + 1u64, 1u64, "executable index exceeds the admitted byte limit")
    forged = ExecutableSurfaceIndex(
        library="provider",
        package_version="2.0.0",
        public=[covered(root, 0u64, 1u64, [])],
        implementation=[],
    )
    assert refused(forged, 100u64, 1u64, "public executable identity belongs to another package")


pub def test_selection_preserves_foreign_requirements() -> None:
    """Return foreign identities to the package resolver without treating them as missing local declarations."""
    root = identity("run", DeclarationKind.Function)
    foreign = package_identity("dependency", "2.0.0", "support", DeclarationKind.Function)
    index = ExecutableSurfaceIndex(
        library="provider",
        package_version="1.0.0",
        public=[covered(root.clone(), 0u64, 1u64, [foreign.clone()])],
        implementation=[],
    )
    assert valid_executable_surface_index(index.clone(), 100u64, 1u64) == Ok(None)
    assert select_execution_closure(index, root.clone()) == Ok(
        ExecutableSelection(declarations=[root], external_requirements=[foreign]),
    )


def covered(
    identity: CanonicalSymbolId,
    offset: u64,
    length: u64,
    requirements: list[CanonicalSymbolId],
) -> ExecutableIndexEntry:
    """Build one covered index entry for concise admission controls."""
    return ExecutableIndexEntry(
        identity=identity,
        coverage=ExecutableDeclarationCoverage.Covered(offset, length, requirements),
    )


def identity(name: str, kind: DeclarationKind) -> CanonicalSymbolId:
    """Build one complete provider-owned identity whose declaration name controls canonical order."""
    return package_identity("provider", "1.0.0", name, kind)


def package_identity(package: str, version: str, name: str, kind: DeclarationKind) -> CanonicalSymbolId:
    """Build one complete package-owned identity for local and cross-provider controls."""
    return CanonicalSymbolId(
        namespace=SymbolNamespace.OrdinaryLexical,
        origin=SymbolOrigin.Package(PackageIdentity(name=package, version=version), ["api"]),
        declaration_name=name,
        kind=kind,
        scope_discriminant=None,
        declaration_span=HirSourceSpan(file="src/lib.incn", start=0, end=1),
    )


def refused(index: ExecutableSurfaceIndex, index_length: u64, payload_length: u64, expected: str) -> bool:
    """Require admission to refuse with the exact stable structural reason."""
    match valid_executable_surface_index(index, index_length, payload_length):
        Err(reason) => return reason == expected
        Ok(_) => return false
