"""A compiler output row records exactly which names and executable contracts its owner used."""

from std.hash import sha256
from checker_record_models import SettledCallContract
from checker_records import (
    CHECKER_PROFILE, CheckedFamily, CheckedRecord, CompiledBodyDependencyRead, CompiledBodyOutputs, CompiledBodyValue,
    CompiledNamespaceValue, GraphNamespaceValue, decode_graph_namespace_value, encode_graph_namespace_value, encode_record,
)
from compiled_body_rows import CompiledBodyOutput, decode_compiled_body_row, encode_compiled_body_rows
from namespace_proof import encode_namespace_proof

const ROOT: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const OWNER: str = "function:main::greeting"


def wire_rows(outputs: CompiledBodyOutputs) -> Result[list[bytes], str]:
    return encode_compiled_body_rows(outputs).map_err((_) => "compiled row encoding refused")


def frame(family: CheckedFamily) -> Result[bytes, str]:
    record = CheckedRecord(profile=CHECKER_PROFILE, family=family, owner=OWNER, root=ROOT, fields=[])
    return encode_record(record).map_err((_) => "checker frame")


pub def test_scoped_value_wire_binds_names_and_exact_dependency_reads() -> Result[None, str]:
    mut owner = CompiledBodyValue(module="main.incn", name="greeting", identity=OWNER, declaration=frame(CheckedFamily.Declaration)?,
        local=frame(CheckedFamily.Local)?, final=frame(CheckedFamily.Final)?, body_ir=b"body")
    empty_names: list[str] = []
    for names in [empty_names, ["greeting", "str"]]:
        owner.scope_names = names
        rows = wire_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).map_err((_) => "encode scalar")?
        match decode_compiled_body_row(rows[0].clone()).map_err((_) => "decode scalar")?:
            CompiledBodyOutput.Value(decoded) => assert decoded.scope_names == names
            _ => return Err("wrong output kind")
    for invalid in [["str", "greeting"], ["greeting", "greeting"], ["greeting", "str\talias"], ["str"]]:
        owner.scope_names = invalid
        assert wire_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).is_err()
    owner.scope_names = ["greeting", "str"]
    read = CompiledBodyDependencyRead(
        package=None, module="main", name="callee", identity="main::callee", reference_subject="expr:main#1..5",
    )
    owner.dependency_reads = [read]
    assert wire_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).is_err()

    owner.scope_names = ["callee", "greeting", "str"]
    rows = wire_rows(CompiledBodyOutputs(values=[owner], fallbacks=[]))?
    match decode_compiled_body_row(rows[0].clone()).map_err((_) => "decode scoped call")?:
        CompiledBodyOutput.Value(decoded) =>
            assert decoded.scope_names == ["callee", "greeting", "str"]
            assert decoded.dependency_reads == [read]
        _ => return Err("wrong output kind")
    return Ok(None)


pub def test_namespace_wire_preserves_absent_empty_and_supplied_call_contracts() -> Result[None, str]:
    proof = encode_namespace_proof("main.incn", 1u32, "main", ["main"], sha256.digest(b"interface"))?
    mut namespace = CompiledNamespaceValue(module="main.incn", interface=b"interface", body_ir=b"body", identity_proof=proof, dependencies=[])
    supplied = SettledCallContract(reader="callee#1", target="main::callee", digest=ROOT, owner="function:main::callee")
    empty: list[SettledCallContract] = []
    cases: list[Option[list[SettledCallContract]]] = [None, Some(empty), Some([supplied])]
    for contracts in cases:
        namespace.call_contracts = contracts
        rows = wire_rows(CompiledBodyOutputs(namespaces=[namespace], values=[], fallbacks=[])).map_err((_) => "encode namespace")?
        match decode_compiled_body_row(rows[0].clone()).map_err((_) => "decode namespace")?:
            CompiledBodyOutput.Namespace(decoded) => assert decoded.call_contracts == contracts
            _ => return Err("wrong output kind")
    return Ok(None)


pub def test_namespace_wire_carries_the_exact_published_record() -> Result[None, str]:
    source = "main.incn"
    durable = encode_graph_namespace_value(
        GraphNamespaceValue(module=source, interface=b"checked declarations", body_ir=b"lowered body", lowering_inputs=[]),
    ).map_err((_) => "encode durable namespace")?
    empty: list[SettledCallContract] = []
    transport = CompiledNamespaceValue(
        module=source, interface=b"", body_ir=b"", dependencies=["support.incn"],
        semantic_interface=sha256.digest(b"declarations"), call_contracts=Some(empty), published_record=durable,
    )
    rows = wire_rows(CompiledBodyOutputs(namespaces=[transport], values=[], fallbacks=[]))?
    match decode_compiled_body_row(rows[0].clone()).map_err((_) => "decode published namespace output")?:
        CompiledBodyOutput.Namespace(decoded) =>
            assert decoded.published_record == durable
            assert decoded.dependencies == ["support.incn"]
            assert decoded.call_contracts == Some(empty)
            value = decode_graph_namespace_value(decoded.published_record).map_err((_) => "read durable namespace")?
            assert value.module == source and value.body_ir == b"lowered body"
        _ => return Err("wrong output kind")
    return Ok(None)
