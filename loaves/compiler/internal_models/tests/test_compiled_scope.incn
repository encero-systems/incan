"""A compiler output row records exactly which names and executable contracts its owner used."""

from std.hash import sha256
from checker_record_models import SettledCallContract
from checker_records import CHECKER_PROFILE, CheckedFamily, CheckedRecord, CompiledBodyDependencyRead, CompiledBodyOutputs, CompiledBodyValue, CompiledNamespaceValue, encode_record
from compiled_body_rows import CompiledBodyOutput, decode_compiled_body_row, encode_compiled_body_rows
from namespace_proof import encode_namespace_proof

const ROOT: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const OWNER: str = "function:main::greeting"


def frame(family: CheckedFamily) -> Result[bytes, str]:
    record = CheckedRecord(profile=CHECKER_PROFILE, family=family, owner=OWNER, root=ROOT, fields=[])
    return encode_record(record).map_err((_) => "checker frame")


pub def test_scoped_value_wire_binds_names_and_excludes_dependency_reads() -> Result[None, str]:
    mut owner = CompiledBodyValue(module="main.incn", name="greeting", identity=OWNER, declaration=frame(CheckedFamily.Declaration)?,
        local=frame(CheckedFamily.Local)?, final=frame(CheckedFamily.Final)?, body_ir=b"body")
    for names in [[], ["greeting", "str"]]:
        owner.scope_names = names
        rows = encode_compiled_body_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).map_err((_) => "encode scalar")?
        match decode_compiled_body_row(rows[0]).map_err((_) => "decode scalar")?:
            CompiledBodyOutput.Value(decoded) => assert decoded.scope_names == names
            _ => return Err("wrong output kind")
    for invalid in [["str", "greeting"], ["greeting", "greeting"], ["greeting", "str\talias"], ["str"]]:
        owner.scope_names = invalid
        assert encode_compiled_body_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).is_err()
    owner.scope_names = ["greeting", "str"]
    owner.dependency_reads = [CompiledBodyDependencyRead(package=None, module="other", name="name", identity="other::name", reference_subject="expr:main#1..5")]
    assert encode_compiled_body_rows(CompiledBodyOutputs(values=[owner], fallbacks=[])).is_err()
    return Ok(None)


pub def test_namespace_wire_preserves_absent_empty_and_supplied_call_contracts() -> Result[None, str]:
    proof = encode_namespace_proof("main.incn", 1u32, "main", ["main"], sha256.digest(b"interface"))?
    mut namespace = CompiledNamespaceValue(module="main.incn", interface=b"interface", body_ir=b"body", identity_proof=proof, dependencies=[])
    supplied = SettledCallContract(reader="callee#1", target="main::callee", digest=ROOT, owner="function:main::callee")
    for contracts in [None, Some([]), Some([supplied])]:
        namespace.call_contracts = contracts
        rows = encode_compiled_body_rows(CompiledBodyOutputs(namespaces=[namespace], values=[], fallbacks=[])).map_err((_) => "encode namespace")?
        match decode_compiled_body_row(rows[0]).map_err((_) => "decode namespace")?:
            CompiledBodyOutput.Namespace(decoded) => assert decoded.call_contracts == contracts
            _ => return Err("wrong output kind")
    return Ok(None)
