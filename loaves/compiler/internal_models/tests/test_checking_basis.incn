"""Early checking can only select a receipt from its exact prior output."""

from std.encoding.hex import hexlify
from std.hash import sha256
from pub::internal_models.namespace_order import checking_basis_key, encode_checking_basis, read_checking_basis
from pub::internal_models.records import RecordKey


pub def test_checking_basis_requires_the_matching_output_and_digest() -> Result[None, str]:
    local = RecordKey(family="local", identity_profile="stable", origin="project", identity="owner", facet="checked", context="first")
    final = RecordKey(family="final", identity_profile="stable", origin="project", identity="owner", facet="checked", context="first")
    root = hexlify(sha256.digest(b"completed receipt"))
    assert checking_basis_key(local)?.startswith("incan.compiler.checking-basis/2\t")
    encoded = encode_checking_basis(local, root)?
    assert encoded[:4] == b"CRMB" and read_checking_basis(local, encoded)? == root
    assert read_checking_basis(final, encoded).is_err()
    assert read_checking_basis(local, root.encode("utf-8")).is_err()
    assert encode_checking_basis(local, root[:12]).is_err()
    return Ok(None)
