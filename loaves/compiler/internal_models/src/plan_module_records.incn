"""The module-level plan record: one Crumb row naming a module's plan functions, their final events kept opaque. Implemented in Rust by `internal_models_native`; this module keeps the reference import path."""

pub from rust::internal_models_native import (
    PLAN_MODULE_FAMILY,
    PLAN_MODULE_PAGE,
    POSITIONED_MODULE_PAGE,
    REPOSITION_MODULE_PAGE,
    ADMITTED_MODULE_NOTE,
    PARTIAL_MODULE_NOTE,
    PlanModuleFunction,
    PlanModuleValue,
    encode_plan_module,
    decode_plan_module,
)
