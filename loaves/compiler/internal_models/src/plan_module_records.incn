"""The module-level plan record: one Crumb row naming a module's plan functions, their final events kept opaque."""

from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.records import RowRecord
from std.primitives.crumb.values import Value
from std.primitives.text import copy_frozen_bytes
from checker_field_grammar import CodecFault
from crumb_rows import ModelField, decode_rows, encode_rows, model_description, required_value

pub const PLAN_MODULE_FAMILY: str = "plan-module"
# The extension of the page a compiler worker reads an admitted module's record from, named by the module's hex path.
pub const PLAN_MODULE_PAGE: str = ".incnmodule"
const PLAN_MODULE_SELECTOR: bytes = b"plnmod\x00"
const MAX_PLAN_MODULE_BYTES: int = 67108864
const MAX_PLAN_MODULE_FUNCTIONS: int = 65536
const FUNCTION_FIELDS: int = 5


pub model PlanModuleFunction:
    """
    One body of a module with a plan product: the owner its plan-function record is keyed by, the canonical identity
    of the body, its native function name, the key of its product, and the final lowering event with the product.
    """

    pub identity: str
    pub symbol: str
    pub function: str
    pub key: str
    pub event: str


pub model PlanModuleValue:
    """A module, named as lowering names it, with the plan function of every one of its bodies."""

    pub module: str
    pub functions: list[PlanModuleFunction]


def plan_module_description() -> Description:
    """Describe one module's plan functions without interpreting their events."""
    return model_description(
        PLAN_MODULE_SELECTOR,
        "incan.plan-module/1",
        [
            ModelField(identity=b"funcs_", name="functions", storage="list<string>"),
            ModelField(identity=b"module", name="module", storage="string"),
        ],
    )


pub def encode_plan_module(value: PlanModuleValue) -> Result[bytes, CodecFault]:
    """Encode one module's plan functions as one Crumb row, in strictly ascending order of owner and function."""
    if value.module == "" or len(value.functions) == 0 or len(value.functions) > MAX_PLAN_MODULE_FUNCTIONS:
        return Err(CodecFault.Malformed)
    mut flattened: list[Value] = []
    mut previous = ""
    for function in value.functions:
        order = function.identity + "\n" + function.function
        if "" in [function.identity, function.symbol, function.function, function.key, function.event]:
            return Err(CodecFault.Malformed)
        if order <= previous:
            return Err(CodecFault.Malformed)
        previous = order
        flattened += [
            Value.Text(function.identity),
            Value.Text(function.symbol),
            Value.Text(function.function),
            Value.Text(function.key),
            Value.Text(function.event),
        ]
    record = RowRecord(
        key=PLAN_MODULE_SELECTOR,
        value=Value.Record(
            [required_value(b"funcs_", Value.List(flattened)), required_value(b"module", Value.Text(value.module))],
        ),
    )
    return encode_rows(plan_module_description(), [record], MAX_PLAN_MODULE_BYTES).map_err((_) => CodecFault.Limit)


pub def decode_plan_module(encoded: bytes) -> Result[PlanModuleValue, CodecFault]:
    """Decode one complete module row and refuse unordered, empty or trailing function fields."""
    rows = decode_rows(encoded, [plan_module_description()], MAX_PLAN_MODULE_BYTES).map_err((_) => CodecFault.Malformed)?
    if len(rows) != 1 or rows[0].key != copy_frozen_bytes(PLAN_MODULE_SELECTOR):
        return Err(CodecFault.Malformed)
    fields = match rows[0].value:
        Value.Record(values) => values
        _ => return Err(CodecFault.Malformed)

    if len(fields) != 2:
        return Err(CodecFault.Malformed)
    flattened = text_values(fields[0].value)?
    module = text_value(fields[1].value)?
    if module == "" or len(flattened) == 0 or len(flattened) % FUNCTION_FIELDS != 0:
        return Err(CodecFault.Malformed)
    mut functions: list[PlanModuleFunction] = []
    mut previous = ""
    mut offset = 0
    while offset < len(flattened):
        function = PlanModuleFunction(
            identity=flattened[offset],
            symbol=flattened[offset + 1],
            function=flattened[offset + 2],
            key=flattened[offset + 3],
            event=flattened[offset + 4],
        )
        order = function.identity + "\n" + function.function
        if "" in [function.identity, function.symbol, function.function, function.key, function.event]:
            return Err(CodecFault.Malformed)
        if order <= previous:
            return Err(CodecFault.Malformed)
        functions.append(function)
        previous = order
        offset += FUNCTION_FIELDS
    return Ok(PlanModuleValue(module=module, functions=functions))


def text_value(value: Value) -> Result[str, CodecFault]:
    """Require one logical Crumb string value."""
    match value:
        Value.Text(text) => return Ok(text)
        _ => return Err(CodecFault.Malformed)


def text_values(value: Value) -> Result[list[str], CodecFault]:
    """Require one logical Crumb string list without accepting nested or alternate values."""
    match value:
        Value.List(items) =>
            mut result: list[str] = []
            for item in items:
                result.append(text_value(item)?)
            return Ok(result)
        _ => return Err(CodecFault.Malformed)
