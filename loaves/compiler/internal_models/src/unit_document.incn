"""Private compiler units use a closed Crumb schema; the public JSON field projection remains shared with describe-unit."""

from std.json import JsonValue
from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value, ValueField
from crumb_rows import ModelField, model_description, required_value
from graph_crumb_fields import integer as signed_value, items, number, text, tuple_items
from plan_wire_rows import read_wire, write_wire


model UnitField:
    """The six-byte selector stays fixed when unit fields are added or declarations are reordered."""

    name: str
    selector: bytes
    item: str
    storage: str
    multiple: bool
    presence: str


def field(name: str, selector: bytes, item: str, storage: str, multiple: bool = false, presence: str = "required") -> UnitField:
    return UnitField(name=name, selector=selector, item=item, storage=storage, multiple=multiple, presence=presence)


def fields(kind: str) -> Result[list[UnitField], str]:
    match kind:
        "unit_descriptor" => return Ok([
            field("active_features", b"f00000", "text", "list<string>", true),
            field("c_abi_target", b"f00001", "unit_target", "option<record@756e69747467>", false, "omitted"),
            field("c_headers", b"f00002", "text", "list<string>", true),
            field("checked_context", b"f00003", "text", "option<string>", false, "omitted"),
            field("checked_products", b"f00004", "text", "option<string>", false, "omitted"),
            field("cloves", b"f00005", "unit_clove", "option<list<record@756e6974636c>>", true, "omitted"),
            field("contract_models", b"f00006", "text", "list<string>", true),
            field("covered_by", b"f00007", "bindings", "list<tuple<string,string>>"),
            field("declared_features", b"f00008", "text", "list<string>", true),
            field("excluded_sources", b"f00009", "text", "option<list<string>>", true, "omitted"),
            field("externs", b"f00010", "native_crate", "list<record@756e69746578>", true),
            field("kind", b"f00011", "text", "string"),
            field("loaves", b"f00012", "unit_loaf", "list<record@756e69746c66>", true),
            field("not_prepared_loaves", b"f00013", "text", "list<string>", true),
            field("package", b"f00014", "text", "string"),
            field("profile", b"f00015", "text", "string"),
            field("program_checks", b"f00016", "boolean", "option<boolean>", false, "omitted"),
            field("program_entries", b"f00017", "text", "list<string>", true),
            field("project_library", b"f00018", "text", "option<string>", false, "omitted"),
            field("project_root", b"f00019", "text", "string"),
            field("registry_id", b"f00020", "text", "option<string>", false, "omitted"),
            field("rust_abi", b"f00021", "text", "list<string>", true),
            field("rust_crates", b"f00022", "text", "list<string>", true),
            field("schema", b"f00023", "text", "string"),
            field("search", b"f00024", "text", "list<string>", true),
            field("search_index", b"f00025", "text", "option<string>", false, "nullable"),
            field("source", b"f00026", "text", "string"),
            field("source_root", b"f00027", "text", "string"),
            field("test_batch", b"f00028", "text", "option<list<string>>", true, "omitted"),
            field("toolchain_access", b"f00029", "unit_access", "option<record@756e69746163>", false, "omitted"),
            field("trust_stop", b"f00030", "text", "string"),
            field("version", b"f00031", "text", "string"),
            field("vocab", b"f00032", "text", "option<string>", false, "nullable"),
            field("vocab_admissions", b"f00033", "text", "list<string>", true),
            field("vocab_desugarer", b"f00034", "boolean", "boolean"),
            field("vocab_entry", b"f00035", "text", "option<string>", false, "nullable"),
            field("vocab_policy", b"f00036", "text", "string"),
            field("vocabulary", b"f00037", "boolean", "boolean"),
        ])
        "unit_loaf" => return Ok([
            field("dir", b"f00000", "text", "string"),
            field("key", b"f00001", "text", "string"),
            field("name", b"f00002", "text", "string"),
            field("source_root", b"f00003", "text", "option<string>", false, "omitted"),
            field("standard", b"f00004", "boolean", "boolean"),
            field("toolchain_provided", b"f00005", "boolean", "boolean"),
        ])
        "native_crate" => return Ok([
            field("name", b"f00000", "text", "string"),
            field("path", b"f00001", "text", "string"),
        ])
        "unit_clove" => return Ok([
            field("compiler", b"f00000", "text", "string"),
            field("configurations", b"f00001", "clove_configuration", "list<record@756e69746366>", true),
            field("cplusplus", b"f00002", "boolean", "boolean"),
            field("include", b"f00003", "text", "list<string>", true),
            field("library", b"f00004", "text", "string"),
            field("name", b"f00005", "text", "string"),
            field("public_headers", b"f00006", "text", "list<string>", true),
            field("root", b"f00007", "text", "string"),
        ])
        "clove_configuration" => return Ok([
            field("archive", b"f00000", "text", "string"),
            field("definitions", b"f00001", "text", "list<string>", true),
            field("identity", b"f00002", "text", "string"),
            field("name", b"f00003", "text", "string"),
        ])
        "unit_target" => return Ok([
            field("api_level", b"f00000", "u32", "option<i64>", false, "omitted"),
            field("definitions", b"f00001", "text", "list<string>", true),
            field("deployment_target", b"f00002", "text", "option<string>", false, "omitted"),
            field("sdk", b"f00003", "unit_capability", "option<record@756e69746370>", false, "omitted"),
            field("target", b"f00004", "text", "string"),
            field("toolchain", b"f00005", "unit_capability", "option<record@756e69746370>", false, "omitted"),
        ])
        "unit_capability" => return Ok([
            field("capability", b"f00000", "text", "string"),
            field("version", b"f00001", "text", "string"),
        ])
        "unit_access" => return Ok([
            field("sysroot_dependencies", b"f00000", "text", "list<string>", true),
            field("toolchain_components", b"f00001", "text", "list<string>", true),
            field("unstable_features", b"f00002", "text", "list<string>", true),
        ])
        _ => return Err("unknown compiler unit record kind")


def descriptions() -> Result[list[Description], str]:
    mut supplied: list[Description] = []
    supplied.append(model_description(b"unitdf\x00", "incan.compiler-unit/2/unit_descriptor", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_descriptor")?]))
    supplied.append(model_description(b"unitlf\x00", "incan.compiler-unit/2/unit_loaf", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_loaf")?]))
    supplied.append(model_description(b"unitex\x00", "incan.compiler-unit/2/native_crate", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("native_crate")?]))
    supplied.append(model_description(b"unitcl\x00", "incan.compiler-unit/2/unit_clove", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_clove")?]))
    supplied.append(model_description(b"unitcf\x00", "incan.compiler-unit/2/clove_configuration", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("clove_configuration")?]))
    supplied.append(model_description(b"unittg\x00", "incan.compiler-unit/2/unit_target", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_target")?]))
    supplied.append(model_description(b"unitcp\x00", "incan.compiler-unit/2/unit_capability", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_capability")?]))
    supplied.append(model_description(b"unitac\x00", "incan.compiler-unit/2/unit_access", [
        ModelField(identity=value.selector, name=value.name, storage=value.storage) for value in fields("unit_access")?]))
    return Ok(supplied)


def project_object(kind: str, document: JsonValue) -> Result[Value, str]:
    object = document.expect_object().map_err((error) => error.message())?
    mut output: list[ValueField] = []
    mut consumed = 0
    for spec in fields(kind)?:
        mut value = Value.NoneValue
        if spec.name in object:
            consumed += 1
            selected = object[spec.name]
            if selected.is_null() and spec.presence == "omitted":
                return Err(f"compiler unit optional field {kind}.{spec.name} must be omitted or present with its declared type")
            if not selected.is_null() or spec.presence == "required":
                value = project_field(spec, selected)?
                if spec.presence != "required":
                    value = Value.Some([value])
        elif spec.presence != "omitted":
            return Err(f"missing compiler unit field {kind}.{spec.name}")
        output.append(required_value(spec.selector, value))
    if consumed != len(object):
        return Err(f"unknown compiler unit field in {kind}")
    return Ok(Value.Record(output))


def project_field(spec: UnitField, document: JsonValue) -> Result[Value, str]:
    if spec.multiple:
        mut values: list[Value] = []
        for element in document.expect_array().map_err((error) => error.message())?:
            values.append(project_item(spec.item, element)?)
        return Ok(Value.List(values))
    return project_item(spec.item, document)


def project_item(kind: str, document: JsonValue) -> Result[Value, str]:
    match kind:
        "text" => return Ok(Value.Text(document.expect_str().map_err((error) => error.message())?))
        "boolean" => return Ok(Value.Boolean(document.expect_bool().map_err((error) => error.message())?))
        "u32" =>
            n = document.expect_int().map_err((error) => error.message())?
            if n < 0 or n > 4294967295:
                return Err("compiler unit integer outside u32")
            return Ok(signed_value(n))
        "bindings" =>
            binding = document.expect_object().map_err((error) => error.message())?
            mut pairs: list[Value] = []
            for name in sorted([key for key in binding.keys()]):
                value = binding[name].expect_str().map_err((error) => error.message())?
                pairs.append(Value.Tuple([Value.Text(name), Value.Text(value)]))
            return Ok(Value.List(pairs))
        _ => return project_object(kind, document)


def read_object(kind: str, stored: Value) -> Result[JsonValue, str]:
    mut output: Dict[str, JsonValue] = {}
    specs = fields(kind)?
    match stored:
        Value.Record(encoded) =>
            if len(encoded) != len(specs):
                return Err("compiler unit field count differs")
            for index in range(len(specs)):
                spec = specs[index]
                if encoded[index].identity != spec.selector:
                    return Err("compiler unit field selector differs")
                value = encoded[index].value
                if spec.presence == "required":
                    output[spec.name] = read_field(spec, value)?
                else:
                    match value:
                        Value.NoneValue =>
                            if spec.presence == "nullable":
                                output[spec.name] = JsonValue.null()
                        Value.Some(inside) =>
                            if len(inside) != 1:
                                return Err("invalid optional compiler unit field")
                            output[spec.name] = read_field(spec, inside[0])?
                        _ => return Err("expected optional compiler unit field")
            return Ok(JsonValue.object(output))
        _ => return Err("expected compiler unit object")


def read_field(spec: UnitField, value: Value) -> Result[JsonValue, str]:
    if spec.multiple:
        mut values: list[JsonValue] = []
        for element in items(value)?:
            values.append(read_item(spec.item, element)?)
        return Ok(JsonValue.array(values))
    return read_item(spec.item, value)


def read_item(kind: str, value: Value) -> Result[JsonValue, str]:
    match kind:
        "text" => return Ok(JsonValue.string(text(value)?))
        "boolean" =>
            match value:
                Value.Boolean(v) => return Ok(JsonValue.bool(v))
                _ => return Err("expected compiler unit Boolean")
        "u32" =>
            n = number(value)?
            if n < 0 or n > 4294967295:
                return Err("compiler unit integer outside u32")
            return Ok(JsonValue.int(n))
        "bindings" =>
            mut result: Dict[str, JsonValue] = {}
            mut previous: Option[str] = None
            for pair in items(value)?:
                values = tuple_items(pair, 2)?
                name = text(values[0])?
                if let Some(before) = previous:
                    if name <= before:
                        return Err("compiler unit bindings require unique sorted keys")
                result[name] = JsonValue.string(text(values[1])?)
                previous = Some(name)
            return Ok(JsonValue.object(result))
        _ => return read_object(kind, value)


pub def encode_unit_document(document: JsonValue) -> Result[bytes, str]:
    """Project all compiler input fields into a typed row without serializing a JSON document."""
    return write_wire(b"unitdf\x00", descriptions()?, project_object("unit_descriptor", document)?)


pub def decode_unit_document(encoded: bytes) -> Result[JsonValue, str]:
    """Restore the closed field projection for the compiler's existing unit validator."""
    return read_object("unit_descriptor", read_wire(encoded, b"unitdf\x00", descriptions()?)?)
