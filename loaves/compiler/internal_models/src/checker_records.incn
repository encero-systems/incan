"""Canonical field records for the initial free-function checker profile; native objects never enter the codec."""

from std.encoding.hex import hexlify
from std.hash import sha256
from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.hashes import description_hash, value_hash
from std.primitives.crumb.records import RowRecord
from std.primitives.crumb.values import Projection, Value
from std.primitives.text import copy_frozen_bytes
from crumb_rows import ModelField, decode_rows, encode_rows, model_description, operation_budget, required_value

pub const CHECKER_SCHEMA: str = "incan.checker-fields/10"
pub const CHECKER_PROFILE: str = "incan.checker-free-functions/17"
const MAX_RECORD_BYTES: int = 65536
const MAX_FIELDS: int = 4096
const CHECKER_SELECTOR: bytes = b"checkr\x00"
const GRAPH_BODY_SELECTOR: bytes = b"grbody\x00"
const GRAPH_NAMESPACE_SELECTOR: bytes = b"grnams\x00"
# One selected-input request carries bounded checker records plus native owner frames; bound that request at 64 MiB
# while individual checker records retain their narrower 64 KiB limit.
const MAX_GRAPH_TRANSPORT_BYTES: int = 67108864


@derive(Eq)
pub enum CheckedFamily:
    """Declaration/default output, pending local output and settled output have distinct contracts."""

    Declaration
    Local
    Final


@derive(Eq)
pub model CanonicalField:
    """A schema-owned field: node is a structural role or stable binding reference; values follow its typed grammar."""

    pub family: str
    pub node: str
    pub selector: str
    pub values: list[str]


@derive(Eq)
pub model CheckedRecord:
    """One checked owner; owner is its checked stable source identity, root its position-free semantic syntax."""

    pub profile: str
    pub owner: str
    pub root: str
    pub family: CheckedFamily
    pub fields: list[CanonicalField]


pub model GraphBodyValue:
    """One graph-selected owner's checker values and opaque kernel-owned executable frame."""

    pub identity: str
    pub local: bytes
    pub final: bytes
    pub body_ir: bytes


pub model GraphBodyFields:
    """One validated graph-selected owner projected into native checker fields plus its opaque Body IR frame."""

    pub identity: str
    pub local: list[list[str]]
    pub final_fields: list[list[str]]
    pub body_ir: bytes


pub model GraphNamespaceValue:
    """One graph-selected editable namespace with its interface, Body IR and authenticated lowering witnesses."""

    pub module: str
    pub interface: bytes
    pub body_ir: bytes
    pub lowering_inputs: list[list[str]] = []


pub model CompiledBodyValue:
    """One compiler-produced checker triple and kernel-owned Body IR frame with its projected source owner."""

    pub module: str
    pub name: str
    pub identity: str
    pub declaration: bytes
    pub local: bytes
    pub final: bytes
    pub body_ir: bytes
    pub dependency_reads: list[CompiledBodyDependencyRead] = []


@derive(Eq)
pub model CompiledBodyDependencyRead:
    """One exact package or project declaration record witnessed by a compiled owner."""

    pub package: Option[str]
    pub module: str
    pub name: str
    pub identity: str
    pub reference_subject: str


@derive(Eq)
pub model CompiledBodyFallback:
    """One checked owner that cannot enter the record fast path, retaining absence when identity production failed."""

    pub module: str
    pub name: str
    pub identity: Option[str]
    pub reason: str


pub model CompiledNamespaceValue:
    """One installable checked namespace plus the lowering witnesses produced by the same completed check."""

    pub module: str
    pub interface: bytes
    pub body_ir: bytes
    pub dependencies: list[str]
    pub lowering_inputs: list[list[str]] = []


pub model CompiledBodyOutputs:
    """Every namespace, owner value and explicit full-source fallback awaiting independent binary framing."""

    pub namespaces: list[CompiledNamespaceValue] = []
    pub values: list[CompiledBodyValue]
    pub fallbacks: list[CompiledBodyFallback]


@derive(Eq)
pub enum CodecFault:
    """Infrastructure/capability refusals; none is a source-language diagnostic or a legacy fallback request."""

    Malformed
    ProfileMismatch
    OwnerMismatch
    BodyChanged
    Unsupported(str)
    Limit
    LimitExceeded(str, int, int)


pub def encode_record(record: CheckedRecord) -> Result[bytes, CodecFault]:
    """Encode one checked owner as one bounded Crumb row of the checker-record model."""
    logical = record_value(record)?
    return encode_rows(checker_description(), [RowRecord(key=CHECKER_SELECTOR, value=logical)], MAX_RECORD_BYTES).map_err(
        (_) => CodecFault.Malformed,
    )


pub def decode_record(encoded: bytes, profile: str, owner: str, root: str) -> Result[CheckedRecord, CodecFault]:
    """Decode one complete Crumb row, then bind its profile, stable owner and semantic root."""
    record = decoded_record(encoded)?
    if record.profile != profile:
        return Err(CodecFault.ProfileMismatch)
    if record.owner != owner:
        return Err(CodecFault.OwnerMismatch)
    if record.root != root:
        return Err(CodecFault.BodyChanged)
    return Ok(record)


pub def content_digest(record: CheckedRecord) -> Result[str, CodecFault]:
    """Hash every encoded record byte, including the model reference and fields excluded from semantic reuse."""
    return Ok("sha256:" + hexlify(sha256.digest(encode_record(record)?)))


pub def semantic_digest(record: CheckedRecord) -> Result[str, CodecFault]:
    """Hash the model description and canonical fields, excluding documentation and publication-only fields."""
    mut budget = operation_budget().map_err((_) => CodecFault.Limit)?
    value = value_hash(record_value(record)?, Projection.Canonical, budget).map_err((_) => CodecFault.Malformed)?
    description = description_hash(checker_description().metadata, budget).map_err((_) => CodecFault.Malformed)?
    preimage = (hexlify(description.digest) + "\n" + hexlify(value.digest)).encode()
    return Ok("sha256:" + hexlify(sha256.digest(preimage)))


def record_value(record: CheckedRecord) -> Result[Value, CodecFault]:
    """Project one validated checker record into its exact Crumb logical model."""
    validate(record)?
    mut flattened: list[Value] = []
    for field in record.fields:
        flattened += [
            Value.Text(field.family),
            Value.Text(field.node),
            Value.Text(field.selector),
            Value.Text(str(len(field.values))),
        ]
        for value in field.values:
            flattened.append(Value.Text(value))
    return Ok(
        Value.Record(
            [
                required_value(b"family", Value.Text(family_name(record.family))),
                required_value(b"fields", Value.List(flattened)),
                required_value(b"owner_", Value.Text(record.owner)),
                required_value(b"profil", Value.Text(record.profile)),
                required_value(b"root__", Value.Text(record.root)),
            ],
        ),
    )


def decoded_record(encoded: bytes) -> Result[CheckedRecord, CodecFault]:
    """Admit exactly one checker-model row and reconstruct all schema-owned fields."""
    rows = decode_rows(encoded, [checker_description()], MAX_RECORD_BYTES).map_err((_) => CodecFault.Malformed)?
    if len(rows) != 1:
        return Err(CodecFault.Malformed)
    row = rows[0]
    if row.key != copy_frozen_bytes(CHECKER_SELECTOR):
        return Err(CodecFault.Malformed)
    values = match row.value:
        Value.Record(fields) => fields
        _ => return Err(CodecFault.Malformed)

    if len(values) != 5:
        return Err(CodecFault.Malformed)
    family = text_value(values[0].value)?
    flattened = text_values(values[1].value)?
    record = CheckedRecord(
        profile=text_value(values[3].value)?,
        owner=text_value(values[2].value)?,
        root=text_value(values[4].value)?,
        family=read_family(family)?,
        fields=decoded_fields(flattened)?,
    )
    validate(record)?
    return Ok(record)


def decoded_fields(values: list[str]) -> Result[list[CanonicalField], CodecFault]:
    """Restore the ordered checker-field list from the Crumb list payload."""
    mut fields: list[CanonicalField] = []
    mut offset = 0
    while offset < len(values):
        if offset + 4 > len(values):
            return Err(CodecFault.Malformed)
        count = decimal(values[offset + 3])?
        if count > MAX_FIELDS or offset + 4 + count > len(values):
            return Err(CodecFault.Malformed)
        fields.append(
            CanonicalField(
                family=values[offset],
                node=values[offset + 1],
                selector=values[offset + 2],
                values=values[offset + 4:offset + 4 + count],
            ),
        )
        offset += 4 + count
    if len(fields) > MAX_FIELDS:
        return Err(CodecFault.Limit)
    return Ok(fields)


def text_value(value: Value) -> Result[str, CodecFault]:
    """Require one logical Crumb string value."""
    match value:
        Value.Text(text) => return Ok(text)
        _ => return Err(CodecFault.Malformed)


def text_values(value: Value) -> Result[list[str], CodecFault]:
    """Require one logical Crumb string list without accepting nested or alternate values."""
    match value:
        Value.List(items) =>
            mut result: list[str] = []
            for item in items:
                result.append(text_value(item)?)
            return Ok(result)
        _ => return Err(CodecFault.Malformed)


def checker_description() -> Description:
    """Declare the complete checker-record model while keeping its repeated wire header referenced."""
    return model_description(
        CHECKER_SELECTOR,
        CHECKER_SCHEMA,
        [
            ModelField(identity=b"family", name="family", storage="string"),
            ModelField(identity=b"fields", name="fields", storage="list<string>"),
            ModelField(identity=b"owner_", name="owner", storage="string"),
            ModelField(identity=b"profil", name="profile", storage="string"),
            ModelField(identity=b"root__", name="root", storage="string"),
        ],
    )


def binary_value(value: Value) -> Result[bytes, CodecFault]:
    """Require one logical Crumb byte-string value."""
    match value:
        Value.Binary(data) => return Ok(data)
        _ => return Err(CodecFault.Malformed)


def graph_body_description() -> Description:
    """Describe one graph-selected checked owner while retaining Body IR as opaque kernel bytes."""
    return model_description(
        GRAPH_BODY_SELECTOR,
        "incan.checker-graph-body/1",
        [
            ModelField(identity=b"bodyir", name="body_ir", storage="binary"),
            ModelField(identity=b"final_", name="final", storage="binary"),
            ModelField(identity=b"ident_", name="identity", storage="string"),
            ModelField(identity=b"local_", name="local", storage="binary"),
        ],
    )


def graph_namespace_description() -> Description:
    """Describe one checked namespace boundary without interpreting its interface or Body IR bytes."""
    return model_description(
        GRAPH_NAMESPACE_SELECTOR,
        "incan.checker-graph-namespace/1",
        [
            ModelField(identity=b"bodyir", name="body_ir", storage="binary"),
            ModelField(identity=b"iface_", name="interface", storage="binary"),
            ModelField(identity=b"inputs", name="lowering_inputs", storage="list<string>"),
            ModelField(identity=b"module", name="module", storage="string"),
        ],
    )


def validate(record: CheckedRecord) -> Result[None, CodecFault]:
    """Reject unknown capabilities and duplicate/unsorted fields; an empty supported family remains explicit."""
    if record.profile != CHECKER_PROFILE:
        return Err(CodecFault.ProfileMismatch)
    if record.owner == "" or not full_digest(record.root):
        return Err(CodecFault.Malformed)
    if len(record.fields) > MAX_FIELDS:
        return Err(CodecFault.Limit)
    mut previous_family = ""
    mut previous_node = ""
    mut previous_selector = ""
    for field in record.fields:
        # Field names are versioned schema vocabulary, never native field offsets or Debug spellings.
        if field.family not in [
            "type",
            "type-identity",
            "binding",
            "binding-type",
            "reference",
            "write",
            "builtin",
            "parameter",
            "signature",
            "diagnostic",
            "status",
            "default",
            "final-type",
            "native-call",
            "target",
            "identifier",
            "effect",
            "mutation",
            "ownership",
            "input-call",
            "input-local",
            "input-flow",
            "input-copy",
        ]:
            return Err(CodecFault.Unsupported(field.family))
        if (
            field.family < previous_family
            or (field.family == previous_family and field.node < previous_node)
            or (field.family == previous_family and field.node == previous_node and field.selector <= previous_selector)
            or len(field.values) > MAX_FIELDS
        ):
            return Err(CodecFault.Malformed)
        validate_field(field)?
        previous_family = field.family
        previous_node = field.node
        previous_selector = field.selector
    return Ok(None)


def family_name(family: CheckedFamily) -> str:
    """The persistent stage tag is independent of compiler enum discriminants."""
    match family:
        CheckedFamily.Declaration => return "declaration"
        CheckedFamily.Local => return "local"
        CheckedFamily.Final => return "final"


def read_family(value: str) -> Result[CheckedFamily, CodecFault]:
    """Unknown stage tags require a new admitted codec profile."""
    match value:
        "declaration" => return Ok(CheckedFamily.Declaration)
        "local" => return Ok(CheckedFamily.Local)
        "final" => return Ok(CheckedFamily.Final)
        _ => return Err(CodecFault.Unsupported(value))


def decimal(text: str) -> Result[int, CodecFault]:
    """Accept only a bounded unsigned canonical decimal spelling, including the one-byte zero."""
    if text == "" or len(text) > 5 or (len(text) > 1 and text.startswith("0")):
        return Err(CodecFault.Malformed)
    mut value = 0
    for digit in text.encode():
        if digit < 48 or digit > 57:
            return Err(CodecFault.Malformed)
        value = value * 10 + digit - 48
    return Ok(value)


pub def from_native_fields(rows: list[list[str]]) -> Result[CheckedRecord, CodecFault]:
    """Convert native field primitives into the Incan-owned schema; this boundary never accepts native dump bytes."""
    if len(rows) == 0 or len(rows[0]) != 5 or rows[0][0] != "header":
        return Err(CodecFault.Malformed)
    header = rows[0]
    mut fields: list[CanonicalField] = []
    for row in rows[1:]:
        if len(row) < 4:
            return Err(CodecFault.Malformed)
        fields.append(CanonicalField(family=row[0], node=row[1], selector=row[2], values=row[3:]))
    record = CheckedRecord(
        profile=header[4],
        owner=header[1],
        root=header[2],
        family=read_family(header[3])?,
        fields=fields,
    )
    validate(record)?
    return Ok(record)


pub def from_native_local_fields(rows: list[list[str]]) -> Result[CheckedRecord, CodecFault]:
    """Assign the schema-owned pending family to native owner/root/profile metadata and canonical field primitives."""
    return from_family_fields(rows, CheckedFamily.Local)


pub def from_native_final_fields(rows: list[list[str]]) -> Result[CheckedRecord, CodecFault]:
    """Assign the schema-owned settled family to native owner/root/profile metadata and canonical field primitives."""
    return from_family_fields(rows, CheckedFamily.Final)


def from_family_fields(rows: list[list[str]], family: CheckedFamily) -> Result[CheckedRecord, CodecFault]:
    """Attach or verify one family on fresh producer rows or a decoded graph value retained for re-publication."""
    if len(rows) == 0 or len(rows[0]) == 0 or rows[0][0] != "header":
        return Err(CodecFault.Malformed)
    header = rows[0]
    mut profile = ""
    if len(header) == 4:
        profile = header[3]
    elif len(header) == 5 and header[3] == family_name(family):
        profile = header[4]
    else:
        return Err(CodecFault.Malformed)
    mut fields: list[CanonicalField] = []
    for row in rows[1:]:
        if len(row) < 4:
            return Err(CodecFault.Malformed)
        fields.append(CanonicalField(family=row[0], node=row[1], selector=row[2], values=row[3:]))
    record = CheckedRecord(profile=profile, owner=header[1], root=header[2], family=family, fields=fields)
    validate(record)?
    return Ok(record)


pub def native_fields(record: CheckedRecord) -> Result[list[list[str]], CodecFault]:
    """Project decoded canonical fields for the narrow rebinding adapter, retaining every field and ordered value."""
    validate(record)?
    mut rows = [["header", record.owner, record.root, family_name(record.family), record.profile]]
    for field in record.fields:
        rows.append([field.family, field.node, field.selector] + field.values)
    return Ok(rows)


pub def encode_graph_body_values(values: list[GraphBodyValue]) -> Result[bytes, CodecFault]:
    """
    Encode graph-selected body pairs independently of the unit description and callable-body product cache.

    Each pair is decoded before framing, so an owner mismatch, changed body root or crossed local/final family cannot
    enter the transport. Strict owner order gives equivalent selections one canonical byte representation.
    """
    if len(values) > MAX_FIELDS:
        return Err(CodecFault.Limit)
    mut rows: list[RowRecord] = []
    mut previous = ""
    for value in values:
        if value.identity == "" or value.identity <= previous:
            return Err(CodecFault.Malformed)
        validate_graph_body_value(value)?
        rows.append(
            RowRecord(
                key=GRAPH_BODY_SELECTOR,
                value=Value.Record(
                    [
                        required_value(b"bodyir", Value.Binary(value.body_ir)),
                        required_value(b"final_", Value.Binary(value.final)),
                        required_value(b"ident_", Value.Text(value.identity)),
                        required_value(b"local_", Value.Binary(value.local)),
                    ],
                ),
            ),
        )
        previous = value.identity
    return encode_rows(graph_body_description(), rows, MAX_GRAPH_TRANSPORT_BYTES).map_err((_) => CodecFault.Limit)


pub def decode_graph_body_values(encoded: bytes) -> Result[list[GraphBodyFields], CodecFault]:
    """Decode and authenticate every selected body pair before projecting its canonical native field primitives."""
    rows = decode_rows(encoded, [graph_body_description()], MAX_GRAPH_TRANSPORT_BYTES).map_err(
        (_) => CodecFault.Malformed,
    )?
    if len(rows) > MAX_FIELDS:
        return Err(CodecFault.Limit)
    mut selected: list[GraphBodyFields] = []
    mut previous = ""
    for row in rows:
        if row.key != copy_frozen_bytes(GRAPH_BODY_SELECTOR):
            return Err(CodecFault.Malformed)
        fields = match row.value:
            Value.Record(values) => values
            _ => return Err(CodecFault.Malformed)

        if len(fields) != 4:
            return Err(CodecFault.Malformed)
        value = GraphBodyValue(
            identity=text_value(fields[2].value)?,
            local=binary_value(fields[3].value)?,
            final=binary_value(fields[1].value)?,
            body_ir=binary_value(fields[0].value)?,
        )
        if value.identity == "" or value.identity <= previous:
            return Err(CodecFault.Malformed)
        selected.append(decode_graph_body_page(value.identity, value.local, value.final, value.body_ir)?)
        previous = value.identity
    return Ok(selected)


pub def decode_graph_body_page(
    identity: str,
    local: bytes,
    final: bytes,
    body_ir: bytes,
) -> Result[GraphBodyFields, CodecFault]:
    """Authenticate one already unframed owner page while the native #3036 framing workaround remains removable."""
    value = GraphBodyValue(identity=identity, local=local, final=final, body_ir=body_ir)
    records = validate_graph_body_value(value)?
    return Ok(
        GraphBodyFields(
            identity=identity,
            local=native_fields(records[0])?,
            final_fields=native_fields(records[1])?,
            body_ir=body_ir,
        ),
    )


pub def encode_graph_namespace_value(value: GraphNamespaceValue) -> Result[bytes, CodecFault]:
    """Encode one checked namespace as one Crumb row while its compiler-owned payloads stay opaque."""
    if (
        value.module == ""
        or len(value.interface) == 0
        or len(value.body_ir) == 0
        or len(value.lowering_inputs) > MAX_FIELDS
    ):
        return Err(CodecFault.Malformed)
    mut flattened: list[Value] = []
    mut previous = ""
    for input in value.lowering_inputs:
        if len(input) != 2 or input[0] == "" or input[1] == "" or input[0] <= previous:
            return Err(CodecFault.Malformed)
        flattened += [Value.Text(input[0]), Value.Text(input[1])]
        previous = input[0]
    record = RowRecord(
        key=GRAPH_NAMESPACE_SELECTOR,
        value=Value.Record(
            [
                required_value(b"bodyir", Value.Binary(value.body_ir)),
                required_value(b"iface_", Value.Binary(value.interface)),
                required_value(b"inputs", Value.List(flattened)),
                required_value(b"module", Value.Text(value.module)),
            ],
        ),
    )
    return encode_rows(graph_namespace_description(), [record], MAX_GRAPH_TRANSPORT_BYTES).map_err(
        (_) => CodecFault.Limit,
    )


pub def decode_graph_namespace_value(encoded: bytes) -> Result[GraphNamespaceValue, CodecFault]:
    """Decode one complete namespace row and refuse unordered, empty or trailing lowering witnesses."""
    rows = decode_rows(encoded, [graph_namespace_description()], MAX_GRAPH_TRANSPORT_BYTES).map_err(
        (_) => CodecFault.Malformed,
    )?
    if len(rows) != 1 or rows[0].key != copy_frozen_bytes(GRAPH_NAMESPACE_SELECTOR):
        return Err(CodecFault.Malformed)
    fields = match rows[0].value:
        Value.Record(values) => values
        _ => return Err(CodecFault.Malformed)

    if len(fields) != 4:
        return Err(CodecFault.Malformed)
    body_ir = binary_value(fields[0].value)?
    interface = binary_value(fields[1].value)?
    flattened = text_values(fields[2].value)?
    module = text_value(fields[3].value)?
    if module == "" or len(interface) == 0 or len(body_ir) == 0 or len(flattened) % 2 != 0:
        return Err(CodecFault.Malformed)
    mut lowering_inputs: list[list[str]] = []
    mut previous = ""
    mut offset = 0
    while offset < len(flattened):
        identity = flattened[offset]
        witness = flattened[offset + 1]
        if identity == "" or witness == "" or identity <= previous:
            return Err(CodecFault.Malformed)
        lowering_inputs.append([identity, witness])
        previous = identity
        offset += 2
    return Ok(GraphNamespaceValue(module=module, interface=interface, body_ir=body_ir, lowering_inputs=lowering_inputs))


pub def record_root(encoded: bytes) -> Result[str, CodecFault]:
    """Read one validated checker record's position-free semantic root for its logical record key."""
    return Ok(decoded_record(encoded)?.root)


def validate_graph_body_value(value: GraphBodyValue) -> Result[list[CheckedRecord], CodecFault]:
    """Bind a selected pair to its compiler-owned identity and require one shared semantic body root."""
    if len(value.body_ir) == 0:
        return Err(CodecFault.Malformed)
    local = decode_graph_record(value.local, value.identity)?
    final = decode_graph_record(value.final, value.identity)?
    if local.family != CheckedFamily.Local or final.family != CheckedFamily.Final:
        return Err(CodecFault.Malformed)
    if local.root != final.root:
        return Err(CodecFault.BodyChanged)
    return Ok([local, final])


def decode_graph_record(encoded: bytes, identity: str) -> Result[CheckedRecord, CodecFault]:
    """Read one selected Crumb row and bind it to the graph-selected stable owner."""
    record = decoded_record(encoded)?
    return decode_record(encoded, CHECKER_PROFILE, identity, record.root)


def validate_field(field: CanonicalField) -> Result[None, CodecFault]:
    """The profile defines each primitive field grammar; unknown selectors or extra primitives are unsupported."""
    values = field.values
    mut end = 0
    # Each family's values follow that family's grammar, and `end` is where it stops; a field with values left over is
    # malformed. A type field holds one value type: an expression's, a body expression's, an assignment's or a
    # destination's.
    if field.family == "type":
        if field.selector not in ["expr", "body-expr", "assignment", "destination"]:
            return Err(CodecFault.Unsupported(field.selector))
        end = type_end(values, 0, 0)?
    # One checked nominal/native identity at a structural component of an expression's resolved type.
    elif field.family == "type-identity":
        if field.node == "" or len(values) != 1 or values[0] == "":
            return Err(CodecFault.Malformed)
        validate_type_identity_path(field.selector)?
        end = 1
    # A binding's type: the binding, then its type.
    elif field.family == "binding-type":
        if field.node == "" or len(values) == 0 or values[0] == "":
            return Err(CodecFault.Malformed)
        if field.selector == "body":
            end = type_end(values, 1, 0)?
        elif field.selector == "parameter-requirement":
            if len(values) < 2:
                return Err(CodecFault.Malformed)
            if values[1] == "none":
                end = 2
            elif values[1] == "some":
                end = type_end(values, 2, 0)?
            else:
                return Err(CodecFault.Malformed)
        else:
            return Err(CodecFault.Unsupported(field.selector))
    # What a node changes: `reassigned` is just `true`; `changed` counts the names it changes, strictly sorted.
    elif field.family == "mutation":
        if field.node == "":
            return Err(CodecFault.Malformed)
        if field.selector == "reassigned":
            if values != ["true"]:
                return Err(CodecFault.Malformed)
            end = 1
        elif field.selector == "changed":
            if len(values) < 2 or values[0] == "":
                return Err(CodecFault.Malformed)
            size = decimal(values[1])?
            if size != len(values) - 2:
                return Err(CodecFault.Malformed)
            mut previous = ""
            for name in values[2:]:
                if name <= previous:
                    return Err(CodecFault.Malformed)
                previous = name
            end = len(values)
        else:
            return Err(CodecFault.Malformed)
    # Explicit ownership facts: call contracts, local modes, control-flow graphs and Copy decisions, each in its own
    # versioned grammar.
    elif field.family in ["input-call", "input-local", "input-flow", "input-copy"]:
        end = input_field_end(field)?
    # A declaration's ownership contract.
    elif field.family == "ownership":
        if field.selector != "contract" or field.node == "":
            return Err(CodecFault.Malformed)
        end = ownership_end(values)?
    # Signatures: a declaration's flag, parameters and result type; a call's parameters; or a counted list of types,
    # its monomorphs or type arguments.
    elif field.family == "signature":
        if field.selector == "declaration":
            if len(values) == 0 or values[0] not in ["true", "false"]:
                return Err(CodecFault.Malformed)
            end = parameters_end(values, 1, 0)?
            end = type_end(values, end, 0)?
        elif field.selector in ["call", "body-call"]:
            end = parameters_end(values, 0, 0)?
        elif field.selector in ["monomorphs", "type-arguments"]:
            if len(values) == 0:
                return Err(CodecFault.Malformed)
            count = decimal(values[0])?
            if count > len(values):
                return Err(CodecFault.Malformed)
            end = 1
            for _ in range(count):
                end = type_end(values, end, 0)?
        else:
            return Err(CodecFault.Unsupported(field.selector))
    # A builtin call keeps its selected function; a builtin method also keeps its selected owner.
    elif field.family == "builtin":
        if field.selector == "call" and len(values) == 1 and values[0] != "":
            end = 1
        elif field.selector == "method" and len(values) == 2 and values[0] != "" and values[1] != "":
            end = 2
        else:
            return Err(CodecFault.Malformed)
    # Facts that hold one nonempty value.
    elif field.family in ["binding", "reference", "write", "default"]:
        if len(values) != 1 or values[0] == "":
            return Err(CodecFault.Malformed)
        end = 1
    # A parameter's type.
    elif field.family == "parameter":
        end = type_end(values, 0, 0)?
    # An identifier's kind; only plain values are recorded.
    elif field.family == "identifier":
        if field.selector != "kind" or values != ["value"]:
            return Err(CodecFault.Unsupported("identifier"))
        end = 1
    # A target's source: at least two values, all kept.
    elif field.family == "target":
        if field.selector != "source" or len(values) < 2:
            return Err(CodecFault.Malformed)
        end = len(values)
    # Whether a body was refused or is pending: one flag, recorded on no node.
    elif field.family == "status":
        if field.node != "" or field.selector not in ["refused", "pending"] or len(values) != 1:
            return Err(CodecFault.Malformed)
        if values[0] not in ["true", "false"]:
            return Err(CodecFault.Malformed)
        end = 1
    # A checked effect, recorded on no node.
    elif field.family == "effect":
        if field.node != "" or field.selector == "" or values != ["checked"]:
            return Err(CodecFault.Malformed)
        end = 1
    # An empty native-call inventory, recorded on no node.
    elif field.family == "native-call":
        if field.node != "" or field.selector != "empty" or values != ["true"]:
            return Err(CodecFault.Unsupported("native-call"))
        end = 1
    # Final types: an empty marker, or the type of an expression or a binding.
    elif field.family == "final-type":
        if field.selector == "empty" and values == ["true"]:
            end = 1
        elif field.selector == "expression":
            end = type_end(values, 0, 0)?
        elif field.selector == "binding" and field.node != "":
            end = type_end(values, 0, 0)?
        else:
            return Err(CodecFault.Malformed)
    # A diagnostic the body reported.
    elif field.family == "diagnostic":
        end = diagnostic_end(values)?
    else:
        return Err(CodecFault.Unsupported(field.family))
    if end != len(values):
        return Err(CodecFault.Malformed)
    return Ok(None)


def validate_type_identity_path(path: str) -> Result[None, CodecFault]:
    """Accept the canonical root marker or at most 32 dot-separated canonical component indices."""
    if path == "root":
        return Ok(None)
    components = path.split(".")
    if len(components) == 0 or len(components) > 32:
        return Err(CodecFault.Malformed)
    for component in components:
        _ = decimal(component)?
    return Ok(None)


def type_end(values: list[str], offset: int, depth: int) -> Result[int, CodecFault]:
    """Validate one prefix-encoded type with a bounded nesting depth, independently of native type object layout."""
    if depth > 32 or offset >= len(values):
        return Err(CodecFault.Malformed)
    tag = values[offset]
    if tag in ["int", "float", "bool", "str", "bytes", "unit", "unknown"]:
        return Ok(offset + 1)
    if tag in ["named", "type-var"]:
        if offset + 1 >= len(values) or values[offset + 1] == "":
            return Err(CodecFault.Malformed)
        return Ok(offset + 2)
    if tag == "result":
        after = type_end(values, offset + 1, depth + 1)?
        return type_end(values, after, depth + 1)
    if tag == "option":
        return type_end(values, offset + 1, depth + 1)
    if tag == "list":
        return type_end(values, offset + 1, depth + 1)
    if tag == "ownership":
        if offset + 1 >= len(values) or values[offset + 1] not in ["Borrowed", "BorrowedMut", "Owned", "Reference"]:
            return Err(CodecFault.Malformed)
        return type_end(values, offset + 2, depth + 1)
    if tag == "callable":
        after = parameters_end(values, offset + 1, depth + 1)?
        return type_end(values, after, depth + 1)
    return Err(CodecFault.Unsupported("type:" + tag))


def parameters_end(values: list[str], offset: int, depth: int) -> Result[int, CodecFault]:
    """Parameter markers retain spelling, source shape, default/preset/mutation bits and the complete checked type."""
    if offset >= len(values):
        return Err(CodecFault.Malformed)
    count = decimal(values[offset])?
    if count > len(values):
        return Err(CodecFault.Malformed)
    mut end = offset + 1
    for _ in range(count):
        if end + 6 >= len(values):
            return Err(CodecFault.Malformed)
        if values[end] not in ["named", "unnamed"]:
            return Err(CodecFault.Malformed)
        if values[end] == "unnamed" and values[end + 1] != "":
            return Err(CodecFault.Malformed)
        if values[end + 2] not in ["normal", "rest", "keywords"]:
            return Err(CodecFault.Malformed)
        for bit in values[end + 3:end + 6]:
            if bit not in ["true", "false"]:
                return Err(CodecFault.Malformed)
        end = type_end(values, end + 6, depth + 1)?
    return Ok(end)


def diagnostic_end(values: list[str]) -> Result[int, CodecFault]:
    """Diagnostics retain recipe prose, optional catalog code, ordered notes/hints, labels and structural ranges."""
    if len(values) < 7 or values[0] not in ["error", "syntax", "type", "warning", "lint"]:
        return Err(CodecFault.Malformed)
    mut end = 3
    for _ in range(2):
        if end >= len(values):
            return Err(CodecFault.Malformed)
        count = decimal(values[end])?
        end += 1 + count
        if end >= len(values):
            return Err(CodecFault.Malformed)
    if values[end] == "primary-label":
        end += 2
    elif values[end] == "no-primary-label":
        end += 1
    else:
        return Err(CodecFault.Malformed)
    if end >= len(values):
        return Err(CodecFault.Malformed)
    if values[end] == "expected-actual":
        end += 3
    elif values[end] == "no-expected-actual":
        end += 1
    else:
        return Err(CodecFault.Malformed)
    if end >= len(values):
        return Err(CodecFault.Malformed)
    count = decimal(values[end])?
    return Ok(end + 1 + count * 2)


def full_digest(value: str) -> bool:
    """A normalized node root carries the full SHA-256 spelling, not a shortened hint or nonempty placeholder."""
    if len(value) != 71 or not value.startswith("sha256:"):
        return false
    for digit in value[7:].encode():
        if not ((48 <= digit and digit <= 57) or (97 <= digit and digit <= 102)):
            return false
    return true


def ownership_end(values: list[str]) -> Result[int, CodecFault]:
    """Explicit access modes, type component paths and stable source slots survive independently of source spelling."""
    if len(values) < 3 or values[0] != "1":
        return Err(CodecFault.Malformed)
    count = decimal(values[1])?
    if count > len(values):
        return Err(CodecFault.Malformed)
    mut end = 2
    for _ in range(count):
        if end + 3 >= len(values) or values[end] not in ["Borrowed", "BorrowedMut", "Owned", "Reference"]:
            return Err(CodecFault.Malformed)
        if values[end + 1] != "result":
            decimal(values[end + 1])?
        size = decimal(values[end + 2])?
        end += 3
        if size > len(values) - end:
            return Err(CodecFault.Malformed)
        for component in values[end:end + size]:
            decimal(component)?
        end = type_end(values, end + size, 0)?
    if end >= len(values):
        return Err(CodecFault.Malformed)
    if values[end] == "none":
        if count == 0:
            return Err(CodecFault.Malformed)
        return Ok(end + 1)
    if values[end] == "parameter":
        if end + 1 >= len(values):
            return Err(CodecFault.Malformed)
        decimal(values[end + 1])?
        end += 2
    elif values[end] == "receiver":
        end += 1
    else:
        return Err(CodecFault.Malformed)
    if end >= len(values):
        return Err(CodecFault.Malformed)
    size = decimal(values[end])?
    end += 1
    if size > len(values) - end:
        return Err(CodecFault.Malformed)
    for identity in values[end:end + size]:
        if identity == "":
            return Err(CodecFault.Malformed)
    return Ok(end + size)


class InputFields:
    """Read bounded ownership primitives; native identities and source anchors remain opaque nonempty handles."""

    values: list[str]
    offset: int = 0
    strict_indices: bool = true

    @staticmethod
    pub def read(values: list[str]) -> InputFields:
        """Create a reader while keeping its cursor and index policy private to the class."""
        return InputFields(values=values)

    pub def position(self) -> int:
        return self.offset

    pub def parameters(mut self) -> Result[None, CodecFault]:
        self.offset = parameters_end(self.values, self.offset, 0)?
        return Ok(None)

    def input_evaluation(mut self) -> Result[list[int], CodecFault]:
        """Collect producer-linked evaluation indices for bounds checking after the graph's node count is known."""
        start = self.number()?
        end = self.number()?
        mut indices = [start, end]
        if self.tag(["none", "some"])? == "some":
            indices.append(self.number()?)
        return Ok(indices)

    pub def value_type(mut self) -> Result[None, CodecFault]:
        self.offset = type_end(self.values, self.offset, 0)?
        return Ok(None)

    def token(mut self) -> Result[str, CodecFault]:
        if self.offset >= len(self.values):
            return Err(CodecFault.Malformed)
        value = self.values[self.offset]
        self.offset += 1
        return Ok(value)

    pub def tag(mut self, allowed: list[str]) -> Result[str, CodecFault]:
        value = self.token()?
        if value not in allowed:
            return Err(CodecFault.Malformed)
        return Ok(value)

    pub def handle(mut self) -> Result[None, CodecFault]:
        if self.token()? == "":
            return Err(CodecFault.Malformed)
        return Ok(None)

    def number(mut self) -> Result[int, CodecFault]:
        return decimal(self.token()?)

    pub def count(mut self) -> Result[int, CodecFault]:
        value = self.number()?
        if value > len(self.values) - self.offset:
            return Err(CodecFault.Malformed)
        return Ok(value)

    def index(mut self, limit: int) -> Result[None, CodecFault]:
        if self.number()? >= limit and self.strict_indices:
            return Err(CodecFault.Malformed)
        return Ok(None)

    def optional_index(mut self, limit: int) -> Result[None, CodecFault]:
        if self.tag(["none", "some"])? == "some":
            self.index(limit)?
        return Ok(None)

    def root(mut self) -> Result[None, CodecFault]:
        kind = self.tag(["binding", "temporary"])?
        self.handle()?
        if kind == "temporary":
            self.handle()?
            self.handle()?
        return Ok(None)

    def place(mut self) -> Result[None, CodecFault]:
        self.root()?
        size = self.count()?
        for _ in range(size):
            self.tag(["field", "element"])?
            self.handle()?
        return Ok(None)

    pub def ordered(self, previous: str, start: int) -> Result[str, CodecFault]:
        """A map key uses framed UTF-8 tokens, never native identity order or ambiguous separators."""
        mut parts: list[str] = []
        for value in self.values[start:self.offset]:
            parts.append(str(len(value.encode())) + ":" + value)
        key = "".join(parts)
        if key <= previous:
            return Err(CodecFault.Malformed)
        return Ok(key)

    def closures(mut self, loans: int) -> Result[list[int], CodecFault]:
        """Each closure bound to a local: its local, captures, loan and the nodes reading its Copy captures."""
        mut closure_nodes: list[int] = []
        closures = self.count()?
        mut previous = ""
        for _ in range(closures):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            self.handle()?
            captures = self.count()?
            for _ in range(captures):
                self.handle()?
            self.optional_index(loans)?
            reads = self.count()?
            for _ in range(reads):
                closure_nodes.append(self.number()?)
        return Ok(closure_nodes)

    def invocations(
        mut self,
        loans: int,
        receiver_dependencies: bool,
        result_requirements: bool,
    ) -> Result[list[int], CodecFault]:
        """Retain invocation inputs and collect the graph nodes that their evaluations reference."""
        mut invocation_nodes: list[int] = []
        invocations = self.count()?
        mut previous = ""
        for _ in range(invocations):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            self.handle()?
            if result_requirements and self.tag(["none", "some"])? == "some":
                self.value_type()?
            self.optional_index(loans)?
            self.tag(["true", "false"])?
            if self.tag(["none", "some"])? == "some":
                self.place()?
            if receiver_dependencies:
                dependencies = self.count()?
                for _ in range(dependencies):
                    self.index(loans)?
            arguments = self.count()?
            for _ in range(arguments):
                self.handle()?
                self.number()?
                self.number()?
                self.tag(["inferred", "shared", "exclusive", "owned"])?
                self.optional_index(loans)?
                if self.tag(["none", "some"])? == "some":
                    self.place()?
                invocation_nodes += self.input_evaluation()?
            if self.tag(["none", "some"])? == "some":
                invocation_nodes += self.input_evaluation()?
            invocation_nodes.append(self.number()?)
            final_accesses = self.count()?
            for _ in range(final_accesses):
                invocation_nodes.append(self.number()?)
        return Ok(invocation_nodes)

    pub def graph(
        mut self,
        strict_indices: bool,
        receiver_dependencies: bool,
        result_requirements: bool,
    ) -> Result[None, CodecFault]:
        """Retain every permission, dependency, invocation and edge under the selected input-flow schema."""
        self.strict_indices = strict_indices
        self.handle()?
        entry = self.number()?
        # Permissions: each storage root in canonical order, with whether it is exclusive, writable and transferable.
        permissions = self.count()?
        mut previous = ""
        for _ in range(permissions):
            start = self.offset
            self.root()?
            previous = self.ordered(previous, start)?
            for _ in range(3):
                self.tag(["true", "false"])?
        # Loans: each one's source place, kind, writability, parent loan and span.
        loans = self.count()?
        for _ in range(loans):
            self.place()?
            self.tag(["shared", "exclusive"])?
            self.tag(["true", "false"])?
            self.optional_index(loans)?
            self.handle()?
        # Local loans: each local in canonical order, with the loan it holds.
        locals = self.count()?
        previous = ""
        for _ in range(locals):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            self.index(loans)?
        # Dependent locals: each local in canonical order, followed by every retained source loan.
        dependent_locals = self.count()?
        previous = ""
        for _ in range(dependent_locals):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            dependencies = self.count()?
            for _ in range(dependencies):
                self.index(loans)?
        # Aggregate expressions whose physical storage retains those dependencies.
        dependent_values = self.count()?
        for _ in range(dependent_values):
            self.handle()?
        # Owned locals: each one's initializer, the place it was transferred from and the node that reads it; with
        # strict indices a local has both or neither.
        owned = self.count()?
        previous = ""
        mut initializer_nodes: list[int] = []
        for _ in range(owned):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            self.handle()?
            has_source = self.tag(["none", "some"])? == "some"
            if has_source:
                self.place()?
            has_access = self.tag(["none", "some"])? == "some"
            if has_access:
                initializer_nodes.append(self.number()?)
            if has_source != has_access and self.strict_indices:
                return Err(CodecFault.Malformed)
        # Operations: each one's completion node, then each operand's span, source place, loan and final access node.
        operations = self.count()?
        previous = ""
        mut operation_nodes: list[int] = []
        for _ in range(operations):
            start = self.offset
            self.handle()?
            previous = self.ordered(previous, start)?
            operation_nodes.append(self.number()?)
            operands = self.count()?
            for _ in range(operands):
                self.handle()?
                self.place()?
                self.index(loans)?
                operation_nodes.append(self.number()?)
        # Invocations: each one's callee, receiver loan and arguments (span, slot, written position, access, loan and
        # source place).
        invocation_nodes = self.invocations(loans, receiver_dependencies, result_requirements)?
        # Closures bound to locals; the nodes that read their captures are checked with the others below.
        closure_nodes = self.closures(loans)?
        # Nodes: each one's event, successors and span. Every node index recorded above must name one of them.
        nodes = self.count()?
        if entry >= nodes and self.strict_indices:
            return Err(CodecFault.Malformed)
        for index in initializer_nodes:
            if index >= nodes and self.strict_indices:
                return Err(CodecFault.Malformed)
        for index in operation_nodes:
            if index >= nodes and self.strict_indices:
                return Err(CodecFault.Malformed)
        for index in invocation_nodes:
            if index >= nodes and self.strict_indices:
                return Err(CodecFault.Malformed)
        for index in closure_nodes:
            if index >= nodes and self.strict_indices:
                return Err(CodecFault.Malformed)
        for _ in range(nodes):
            event = self.tag(["nothing", "borrow", "access"])?
            if event == "borrow":
                self.index(loans)?
            elif event == "access":
                self.place()?
                self.tag(["read", "write", "move", "replace"])?
                self.optional_index(loans)?
            successors = self.count()?
            for _ in range(successors):
                self.index(nodes)?
            self.handle()?
        return Ok(None)


def input_field_end(field: CanonicalField) -> Result[int, CodecFault]:
    """Versioned ownership grammar: invocation contracts, local modes and complete anchored control-flow facts."""
    if field.node == "":
        return Err(CodecFault.Malformed)
    mut reader = InputFields.read(field.values)
    # Every explicit ownership field starts with its grammar version.
    version = reader.tag(["1", "2", "3"])?
    input_flow = field.family == "input-flow" and field.selector == "graph"
    if version != "1" and not input_flow:
        return Err(CodecFault.Malformed)
    # Copy decisions: the owner, then each value type in canonical order with whether it is Copy.
    if field.family == "input-copy" and field.selector == "types":
        reader.handle()?
        size = reader.count()?
        mut previous = ""
        for _ in range(size):
            start = reader.position()
            reader.value_type()?
            previous = reader.ordered(previous, start)?
            reader.tag(["true", "false"])?
    # A call contract: the callee's optional owner, the callee, its receiver's access and its parameters.
    elif field.family == "input-call" and field.selector == "contract":
        reader.tag(["explicit", "ordinary"])?
        if reader.tag(["none", "some"])? == "some":
            reader.handle()?
        reader.handle()?
        reader.tag(["none", "shared", "exclusive"])?
        reader.parameters()?
    # A local's mode: the binding, its owner, the explicit mode, whether it is writable, its annotation and its value
    # type.
    elif field.family == "input-local" and field.selector == "mode":
        reader.handle()?
        reader.handle()?
        reader.tag(["Borrowed", "BorrowedMut", "Owned", "Reference"])?
        reader.tag(["true", "false"])?
        reader.handle()?
        reader.value_type()?
    # A body's control-flow graph: checked, invalid (the graph and its fault) or unavailable (the owner, where and why).
    elif input_flow:
        state = reader.tag(["checked", "invalid", "unavailable"])?
        if state == "unavailable":
            reader.handle()?
            reader.handle()?
            reader.handle()?
        else:
            reader.graph(state == "checked", version != "1", version == "3")?
            if state == "invalid":
                reader.handle()?
    else:
        return Err(CodecFault.Malformed)
    return Ok(reader.position())
