"""Graph-only Crumb roots for checked executable bodies and modules."""

from rust::internal_models_native import (
    NamespaceAtom, PreparedWireReader, checked_projection_fields, decode_checked_projection, decode_checked_projection_view,
    encode_checked_projection, executable_type_descriptions,
)
from std.primitives.crumb.descriptions import Description
from std.primitives.text import copy_frozen_bytes
from std.primitives.views import MappedView
from executable_body_shapes import descriptions as body_descriptions
from executable_declaration_shapes import descriptions as declaration_descriptions
from executable_graph_schema import (
    EXECUTABLE_NAMESPACE, EXECUTABLE_OWNER, executable_namespace_description, executable_owner_description,
)

const BODY: bytes = b"\x02\xff\x73\xc4\xb3\x17\x00"
const MODULE: bytes = b"\x70\x27\x49\xa1\x72\x4a\x00"


def shapes(include_declarations: bool) -> list[Description]:
    """Select the closed executable dictionary and reuse the checker-owned identity and type descriptions."""
    mut descriptions = executable_type_descriptions(include_declarations)
    descriptions.extend(body_descriptions())
    if include_declarations:
        descriptions.extend(declaration_descriptions())
    return descriptions


pub def encode_executable_body(value: Borrowed[NamespaceAtom]) -> Result[bytes, str]:
    """Write a single checked body under the graph shape closure."""
    return encode_checked_projection(copy_frozen_bytes(BODY), shapes(false), value)


pub def decode_executable_body(encoded: Borrowed[bytes]) -> Result[NamespaceAtom, str]:
    """Admit the exact graph body shape before exposing its executable fields."""
    return decode_checked_projection(copy_frozen_bytes(BODY), shapes(false), encoded)


pub def encode_executable_module(value: Borrowed[NamespaceAtom]) -> Result[bytes, str]:
    """Write the checked module's declarations and executable bodies as one typed graph value."""
    return encode_checked_projection(copy_frozen_bytes(MODULE), shapes(true), value)


pub def decode_executable_module(encoded: Borrowed[bytes]) -> Result[NamespaceAtom, str]:
    """Admit the exact graph module shape before exposing its executable fields."""
    return decode_checked_projection(copy_frozen_bytes(MODULE), shapes(true), encoded)


def owner_shapes() -> list[Description]:
    """Use the same body closure inside the bounded owner and provenance record."""
    mut descriptions = shapes(false)
    descriptions.append(executable_owner_description())
    return descriptions


def namespace_shapes() -> list[Description]:
    """Use the same module closure inside its independently authenticated scope directory."""
    mut descriptions = shapes(true)
    descriptions.append(executable_namespace_description())
    return descriptions


pub def encode_executable_owner_frame(value: Borrowed[NamespaceAtom]) -> Result[bytes, str]:
    """Write a checked executable owner with its exact provenance, scope reference and body."""
    return encode_checked_projection(copy_frozen_bytes(EXECUTABLE_OWNER), owner_shapes(), value)


pub def decode_executable_owner_frame(encoded: Borrowed[bytes]) -> Result[NamespaceAtom, str]:
    """Admit the complete typed owner record before native checked-body restoration."""
    return decode_checked_projection(copy_frozen_bytes(EXECUTABLE_OWNER), owner_shapes(), encoded)


pub def prepare_executable_owner_reader() -> Result[PreparedWireReader, str]:
    """Freeze the exact description dictionary shared by metadata reads of native owner frames."""
    return PreparedWireReader.create(copy_frozen_bytes(EXECUTABLE_OWNER), owner_shapes(), "executable owner")


pub def read_executable_owner_header(reader: Borrowed[PreparedWireReader], view: Borrowed[MappedView]) -> Result[list[NamespaceAtom], str]:
    """Read owner, source, name, symbol and scope from an authenticated view without restoring the body."""
    return checked_projection_fields(reader, view, [b"ident_", b"source", b"name__", b"canon_", b"scope_"])


pub def encode_executable_namespace_frame(value: Borrowed[NamespaceAtom]) -> Result[bytes, str]:
    """Write a checked module and its first-use scope directory as one typed graph value."""
    return encode_checked_projection(copy_frozen_bytes(EXECUTABLE_NAMESPACE), namespace_shapes(), value)


pub def decode_executable_namespace_frame(encoded: Borrowed[bytes]) -> Result[NamespaceAtom, str]:
    """Admit the checked module and its typed scope slots before restoring executable declarations."""
    return decode_checked_projection(copy_frozen_bytes(EXECUTABLE_NAMESPACE), namespace_shapes(), encoded)


pub def prepare_executable_namespace_reader() -> Result[PreparedWireReader, str]:
    """Freeze the exact typed declaration, Body IR and scope-slot dictionary before mapped restore."""
    return PreparedWireReader.create(copy_frozen_bytes(EXECUTABLE_NAMESPACE), namespace_shapes(), "executable namespace")


pub def decode_executable_namespace_view(reader: Borrowed[PreparedWireReader], view: Borrowed[MappedView]) -> Result[NamespaceAtom, str]:
    """Restore the selected executable module from its authenticated immutable bytes."""
    return decode_checked_projection_view(reader, view)
