"""Checking order from the compiler's transitive project import closures."""

from std.encoding.hex import hexlify, unhexlify
from std.hash import sha256
from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from crumb_rows import ModelField, model_description, required_value
from graph_crumb_fields import KEY_TYPE, decode_graph_row, encode_graph_row, items, key_value, read_key, text
from record_scope import RecordKey
from store_record_source import encode_record_key

pub const CHECKING_BASIS: str = "incan.compiler.checking-basis/2"
const BASIS_SELECTOR: bytes = b"chbase\x00"
const ORDER_SELECTOR: bytes = b"nsrank\x00"
const COMPLETION_SELECTOR: bytes = b"chdone\x00"


def completion_description() -> Description:
    """One completed worker value and its exact source receipt before the next stage."""
    return model_description(COMPLETION_SELECTOR, "incan.compiler.checking-completion/1", [
        ModelField(identity=b"receip", name="receipt", storage="binary"),
        ModelField(identity=b"result", name="value_root", storage="string"),
    ])


pub def encode_checking_completion(value_root: str, receipt: bytes) -> Result[bytes, str]:
    """Preserve the worker's produced value root together with its authenticated input receipt."""
    return encode_graph_row(COMPLETION_SELECTOR, completion_description(), [
        required_value(b"receip", Value.Binary(receipt)), required_value(b"result", Value.Text(value_root)),
    ])


pub def checking_completion_receipt(encoded: bytes, value: bytes) -> Result[bytes, str]:
    """Require the exact earlier producer output before admitting its read evidence."""
    fields = decode_graph_row(encoded, COMPLETION_SELECTOR, completion_description(), 2)?
    if text(fields[1].value)? != hexlify(sha256.digest(value)):
        return Err("completed checking value differs from its producer root")
    match fields[0].value:
        Value.Binary(receipt) => return Ok(receipt)
        _ => return Err("completed checking value has no receipt")


pub def checking_basis_key(output: RecordKey) -> Result[str, str]:
    """Name the last completed supplier evidence for the exact requested checking output."""
    if output.family not in ["local", "final"]:
        return Err("checking preparation requires a local or final output")
    return Ok(CHECKING_BASIS + "\t" + hexlify(sha256.digest(encode_record_key(output)?.encode("utf-8"))))


def basis_description() -> Description:
    return model_description(BASIS_SELECTOR, "incan.compiler.checking-basis/2", [
        ModelField(identity=b"key___", name="output", storage=KEY_TYPE),
        ModelField(identity=b"receip", name="receipt_sha256", storage="binary"),
    ])


pub def encode_checking_basis(output: RecordKey, root: str) -> Result[bytes, str]:
    """Authenticate a local or final producer's exact completed receipt under its own key."""
    digest = unhexlify(root).map_err((error) => error.message())?
    if output.family not in ["local", "final"] or len(digest) != 32 or hexlify(digest) != root:
        return Err("invalid checking basis")
    return encode_graph_row(BASIS_SELECTOR, basis_description(), [
        required_value(b"key___", key_value(output)), required_value(b"receip", Value.Binary(digest)),
    ])


pub def read_checking_basis(output: RecordKey, encoded: bytes) -> Result[str, str]:
    fields = decode_graph_row(encoded, BASIS_SELECTOR, basis_description(), 2)?
    if read_key(fields[0].value)? != output:
        return Err("checking basis belongs to another output")
    match fields[1].value:
        Value.Binary(digest) =>
            if len(digest) == 32:
                return Ok(hexlify(digest))
        _ => pass
    return Err("invalid checking basis receipt")


def order_description() -> Description:
    """Bind the project identity, mutually importing namespaces and full predecessor closure."""
    return model_description(ORDER_SELECTOR, "incan.compiler.namespace-order/1", [
        ModelField(identity=b"closed", name="closure", storage="list<string>"),
        ModelField(identity=b"member", name="members", storage="list<string>"),
        ModelField(identity=b"origin", name="origin", storage="string"),
    ])


pub model NamespaceOrder:
    """Strict predecessor count and rank evidence for one module or one mutually importing group."""

    pub rank: int = 0
    # Older and partial publications have no certificate for independent scheduling.
    pub evidence: str = "compiled-check"
    pub members: list[str] = []
    pub certificate: bytes = b""

    pub def covers(self, sources: &set[str]) -> Result[bool, str]:
        """Whether this authenticated namespace includes every source consumed by a unit-level producer."""
        if len(sources) == 0 or len(sources) > self.rank + len(self.members) or len(self.certificate) == 0:
            return Ok(false)
        fields = decode_graph_row(self.certificate, ORDER_SELECTOR, order_description(), 3)?
        closure = set(namespace_names(fields[0].value)?)
        for source in sources:
            if source not in closure:
                return Ok(false)
        return Ok(true)


def encoded_order(origin: str, members: list[str], closure: list[str]) -> Result[bytes, str]:
    """Emit the canonical typed Crumb value used for both publication and verification."""
    return encode_graph_row(ORDER_SELECTOR, order_description(), [
        required_value(b"closed", Value.List([Value.Text(name) for name in closure])),
        required_value(b"member", Value.List([Value.Text(name) for name in members])),
        required_value(b"origin", Value.Text(origin)),
    ])


def namespace_names(value: Value) -> Result[list[str], str]:
    """Require the canonical strictly increasing spelling of a nonempty namespace set."""
    mut names: list[str] = []
    for element in items(value)?:
        name = text(element)?
        if name == "" or (len(names) > 0 and name <= names[len(names) - 1]):
            return Err("noncanonical certified namespace names")
        names.append(name)
    if len(names) == 0:
        return Err("empty certified namespace set")
    return Ok(names)


pub def decode_namespace_order(certificate: bytes, expected_origin: str) -> Result[NamespaceOrder, str]:
    """Recompute the canonical rank certificate and require its full origin-bound Crumb payload."""
    fields = decode_graph_row(certificate, ORDER_SELECTOR, order_description(), 3)?
    closure = namespace_names(fields[0].value)?
    members = namespace_names(fields[1].value)?
    if text(fields[2].value)? != expected_origin:
        return Err("certified namespace order belongs to another origin")
    for member in members:
        if member not in closure:
            return Err("certified namespace group lies outside its closure")
    if encoded_order(expected_origin, members, closure)? != certificate:
        return Err("noncanonical namespace order certificate")
    return Ok(NamespaceOrder(rank=len(closure) - len(members), evidence="sha256:" + hexlify(sha256.digest(certificate)), members=members, certificate=certificate))


pub def certified_namespace_order(
    origin: str,
    closures: Dict[str, list[str]],
) -> Result[Dict[str, NamespaceOrder], str]:
    """
    The compiler supplies the full transitive import closure, excluding the module itself. Members of a cycle
    reach one another and have identical closed sets once they include themselves. Every external predecessor
    contributes to the shared rank. Incomplete closures cannot certify independent work.
    """
    mut result: Dict[str, NamespaceOrder] = {}
    mut reachable: Dict[str, set[str]] = {}
    for module in closures.keys():
        mut members: set[str] = set()
        for dependency in closures[module]:
            if dependency == "" or dependency == module or dependency in members:
                return Err("malformed compiler namespace closure: " + module)
            members.add(dependency)
        members.add(module)
        reachable[module] = members
    for module in sorted([name for name in closures.keys()]):
        closure = reachable[module]
        mut group = [module]
        mut complete = true
        for dependency in closures[module]:
            if dependency not in reachable:
                complete = false
                break
            supplier = reachable[dependency]
            for predecessor in supplier:
                if predecessor not in closure:
                    return Err("inconsistent transitive compiler namespace closure: " + module)
            if module in supplier:
                if len(supplier) != len(closure):
                    return Err("inconsistent joint compiler namespace closure: " + module)
                group.append(dependency)
        if complete:
            members = sorted(group)
            dependencies = sorted([name for name in closure])
            certificate = encoded_order(origin, members, dependencies)?
            result[module] = NamespaceOrder(
                rank=len(closure) - len(members),
                evidence="sha256:" + hexlify(sha256.digest(certificate)),
                members=members,
                certificate=certificate,
            )
    return Ok(result)


pub const IMPORT_ORDER_FILE: str = "import-closures.crumb"
const IMPORT_ORDER_ROW: bytes = b"imprnk\x00"


pub def ranked_output_suffix() -> str:
    """Keep the existing checked-namespace proof suffix recognizable to predecessor compilers."""
    return ".ranked.cmpns5.graph-body-output"


def import_order_description() -> Description:
    return model_description(IMPORT_ORDER_ROW, "incan.compiler.import-closures/1", [
        ModelField(identity=b"closed", name="module_and_imports", storage="list<list<string>>"),
    ])


pub def encode_import_closures(rows: list[list[str]]) -> Result[bytes, str]:
    """Each row starts with its project source and lists the other project sources transitively imported."""
    return encode_graph_row(IMPORT_ORDER_ROW, import_order_description(), [
        required_value(b"closed", Value.List([Value.List([Value.Text(name) for name in row]) for row in rows])),
    ])


pub def read_import_closures(encoded: bytes) -> Result[Dict[str, list[str]], str]:
    """Require sorted, unique project-relative source names and a closed inventory from the collected unit."""
    fields = decode_graph_row(encoded, IMPORT_ORDER_ROW, import_order_description(), 1)?
    mut result: Dict[str, list[str]] = {}
    mut previous = ""
    for value in items(fields[0].value)?:
        cells = items(value)?
        if len(cells) == 0:
            return Err("empty compiler import closure")
        module = text(cells[0])?
        if module <= previous or module.startswith("/") or ".." in module.split("/") or "" in module.split("/"):
            return Err("noncanonical compiler import source")
        previous = module
        mut dependencies: list[str] = []
        for item in cells[1:]:
            name = text(item)?
            if name == "" or name == module or (len(dependencies) > 0 and name <= dependencies[len(dependencies) - 1]):
                return Err("noncanonical compiler import dependency")
            dependencies.append(name)
        result[module] = dependencies
    for module in result.keys():
        for dependency in result[module]:
            if dependency not in result:
                return Err("compiler import closure lacks its supplier")
    return Ok(result)
