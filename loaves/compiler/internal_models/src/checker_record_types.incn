"""Validate canonical checker-record source types independently of native object layouts."""

from checker_record_models import CodecFault


pub def canonical_decimal(text: str) -> Result[int, CodecFault]:
    """Accept only a bounded unsigned canonical decimal spelling, including the one-byte zero."""
    if text == "" or len(text) > 5 or (len(text) > 1 and text.startswith("0")):
        return Err(CodecFault.Malformed)
    mut value = 0
    for digit in text.encode():
        if digit < 48 or digit > 57:
            return Err(CodecFault.Malformed)
        value = value * 10 + digit - 48
    return Ok(value)


pub def checked_type_end(values: list[str], offset: int, depth: int) -> Result[int, CodecFault]:
    """Return the first field after one prefix-encoded source type."""
    if depth > 32 or offset >= len(values):
        return Err(CodecFault.Malformed)
    tag = values[offset]
    if tag in [
        "never", "int", "float", "bool", "str", "bytes", "frozen-str", "frozen-bytes", "unit", "self-type",
        "call-site-infer", "unknown",
    ]:
        return Ok(offset + 1)
    if tag in ["named", "type-var", "numeric", "rust-path"]:
        if offset + 1 >= len(values) or values[offset + 1] == "":
            return Err(CodecFault.Malformed)
        return Ok(offset + 2)
    if tag == "result":
        after = checked_type_end(values, offset + 1, depth + 1)?
        return checked_type_end(values, after, depth + 1)
    if tag in ["option", "list", "frozen-list", "frozen-set", "type-token", "ref", "ref-mut"]:
        return checked_type_end(values, offset + 1, depth + 1)
    if tag == "frozen-dict":
        after = checked_type_end(values, offset + 1, depth + 1)?
        return checked_type_end(values, after, depth + 1)
    if tag == "ownership":
        if offset + 1 >= len(values) or values[offset + 1] not in ["Borrowed", "BorrowedMut", "Owned", "Reference"]:
            return Err(CodecFault.Malformed)
        return checked_type_end(values, offset + 2, depth + 1)
    if tag == "callable":
        after = parameters_end(values, offset + 1, depth + 1)?
        return checked_type_end(values, after, depth + 1)
    if tag in ["generic", "tuple"]:
        if offset + 1 >= len(values):
            return Err(CodecFault.Malformed)
        mut end = offset + 1
        if tag == "generic":
            if values[end] == "":
                return Err(CodecFault.Malformed)
            end += 1
        count = canonical_decimal(values[end])?
        end += 1
        if count > len(values) - end:
            return Err(CodecFault.Malformed)
        for _ in range(count):
            end = checked_type_end(values, end, depth + 1)?
        return Ok(end)
    return Err(CodecFault.Unsupported("type:" + tag))


pub def parameters_end(values: list[str], offset: int, depth: int) -> Result[int, CodecFault]:
    """Return the first field after canonical callable parameters and their checked source types."""
    if offset >= len(values):
        return Err(CodecFault.Malformed)
    count = canonical_decimal(values[offset])?
    if count > len(values):
        return Err(CodecFault.Malformed)
    mut end = offset + 1
    for _ in range(count):
        if end + 6 >= len(values):
            return Err(CodecFault.Malformed)
        if values[end] not in ["named", "unnamed"]:
            return Err(CodecFault.Malformed)
        if values[end] == "unnamed" and values[end + 1] != "":
            return Err(CodecFault.Malformed)
        if values[end + 2] not in ["normal", "rest", "keywords"]:
            return Err(CodecFault.Malformed)
        for bit in values[end + 3:end + 6]:
            if bit not in ["true", "false"]:
                return Err(CodecFault.Malformed)
        end = checked_type_end(values, end + 6, depth + 1)?
    return Ok(end)
