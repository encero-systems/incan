"""The candidate compiler's private installation index preserves the ordered logical membership of a sealed record set."""

from std.encoding.hex import hexlify, unhexlify
from std.hash import sha256
from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from crumb_rows import ModelField, model_description, required_value
from graph_crumb_fields import decode_graph_row, encode_graph_row, items, text, tuple_items

const EXPORT: bytes = b"cmpexp\x00"


@derive(Eq)
pub model CompilerExportMember:
    """One key and the lowercase SHA-256 revision naming its exact exported object."""

    pub key: str
    pub revision: str


def description() -> Description:
    return model_description(EXPORT, "incan.compiler-record-export/3", [
        ModelField(identity=b"check_", name="membership_digest", storage="binary"),
        ModelField(identity=b"member", name="members", storage="list<tuple<string,binary>>"),
    ])


def checked_revision(member: CompilerExportMember, previous: str) -> Result[bytes, str]:
    if member.key <= previous:
        return Err("compiler record export requires nonempty keys in unique ascending order")
    revision = unhexlify(member.revision).map_err((error) => error.message())?
    if len(revision) != 32 or hexlify(revision) != member.revision:
        return Err("compiler record export revision must be a lowercase SHA-256 digest")
    return Ok(revision)


def membership_digest(members: list[CompilerExportMember]) -> bytes:
    mut hasher = sha256.new()
    hasher.update(EXPORT)
    for member in members:
        key = member.key.encode("utf-8")
        hasher.update(str(len(key)).encode("utf-8"))
        hasher.update(b":")
        hasher.update(key)
        hasher.update(member.revision.encode("utf-8"))
    return hasher.finalize_bytes()


pub def encode_compiler_export(members: list[CompilerExportMember]) -> Result[bytes, str]:
    """Bind each logical key to the binary digest of its object in the compiler's bytewise key order."""
    mut values: list[Value] = []
    mut previous = ""
    for member in members:
        revision = checked_revision(member, previous)?
        values.append(Value.Tuple([Value.Text(member.key), Value.Binary(revision)]))
        previous = member.key
    return encode_graph_row(EXPORT, description(), [
        required_value(b"check_", Value.Binary(membership_digest(members))),
        required_value(b"member", Value.List(values)),
    ])


pub def decode_compiler_export(encoded: bytes) -> Result[list[CompilerExportMember], str]:
    """Verify the full unique ordered roster before any exported object can enter a sealed set."""
    fields = decode_graph_row(encoded, EXPORT, description(), 2)?
    mut members: list[CompilerExportMember] = []
    mut previous = ""
    for item in items(fields[1].value)?:
        pair = tuple_items(item, 2)?
        key = text(pair[0])?
        if key <= previous:
            return Err("compiler record export keys repeat or are out of order")
        match pair[1]:
            Value.Binary(revision) =>
                if len(revision) != 32:
                    return Err("compiler record export revision has the wrong length")
                members.append(CompilerExportMember(key=key, revision=hexlify(revision)))
            _ => return Err("compiler record export revision must be binary")
        previous = key
    match fields[0].value:
        Value.Binary(digest) =>
            if digest == membership_digest(members):
                return Ok(members)
            return Err("compiler record export membership digest mismatch")
        _ => return Err("compiler record export has no membership digest")
