"""The native frontend's typed checked namespace projection, framed by the public Crumb row codec."""

from rust::std::primitive import f64 as RustF64
from rust::incan_std_primitives::crumb import RowAdmission
from std.primitives.crumb.budget import Budget
from std.primitives.crumb.row_values import Nodes, settle
from std.primitives.text import copy_frozen_bytes
from std.primitives.views import MappedView
from std.primitives.crumb.hashes import value_hash
from std.primitives.crumb.types import AbsentPolicy
from std.primitives.crumb.values import Projection, IntegerValue, MapEntry, Value, ValueField
from crumb_rows import operation_budget, required_value
from callable_schema import CALLABLE_PRODUCT, callable_descriptions
from graph_crumb_fields import graph_read_budget, items, text
from namespace_schema import NAMESPACE_SCHEMA, NAMESPACE_MODULE_NAME, NAMESPACE_MODULE_PATH, namespace_descriptions, namespace_field_is_canonical, namespace_root
from plan_wire_rows import PreparedWireReader, admit_wire, read_wire, wire_field, write_wire


pub model NamespaceField:
    pub identity: u64
    pub value: NamespaceAtom


pub model NamespaceEntry:
    pub key: NamespaceAtom
    pub value: NamespaceAtom


pub enum NamespaceAtom:
    """Logical ABI between the Rust-owned checker declarations and their Incan storage contract."""

    Text(str)
    Binary(bytes)
    Flag(bool)
    Signed(i64)
    Unsigned(u64)
    Real(float)
    Missing
    Present(list[NamespaceAtom])
    Items(list[NamespaceAtom])
    TupleItems(list[NamespaceAtom])
    Mapping(list[NamespaceEntry])
    Fields(list[NamespaceField])
    Alternative(u64, list[NamespaceField])


def selector(number: u64) -> Result[bytes, str]:
    if number > 281474976710655u64:
        return Err("namespace member identity exceeds six bytes")
    mut result: list[u8] = []
    for shift in range(6):
        result.append((number >> ((5 - shift) * 8)).wrapping_resize[u8]())
    return Ok(result)


def selector_number(value: bytes) -> Result[u64, str]:
    if len(value) != 6:
        return Err("namespace member identity must have six bytes")
    mut result = 0u64
    for byte in value:
        result = (result << 8) | byte.saturating_resize[u64]()
    return Ok(result)


def fields(values: list[NamespaceField]) -> Result[list[ValueField], str]:
    mut items: list[ValueField] = []
    for field in values:
        key = selector(field.identity)?
        items.append(required_value(key, logical(field.value)?, namespace_field_is_canonical(key)))
    return Ok(items)


def logical(cell: NamespaceAtom) -> Result[Value, str]:
    match cell:
        NamespaceAtom.Text(s) => return Ok(Value.Text(s))
        NamespaceAtom.Binary(data) => return Ok(Value.Binary(data))
        NamespaceAtom.Flag(flag) => return Ok(Value.Boolean(flag))
        NamespaceAtom.Signed(number) => return Ok(Value.Integer(IntegerValue.Signed(number.saturating_resize[i128]())))
        NamespaceAtom.Unsigned(number) => return Ok(Value.Integer(IntegerValue.Unsigned(number.saturating_resize[u128]())))
        NamespaceAtom.Real(number) =>
            bits = RustF64.to_bits(number)
            mut data: list[u8] = []
            for offset in range(8):
                data.append((bits >> ((7 - offset) * 8)).wrapping_resize[u8]())
            return Ok(Value.Float(64, data))
        NamespaceAtom.Missing => return Ok(Value.NoneValue)
        NamespaceAtom.Present(items) =>
            if len(items) == 1:
                return Ok(Value.Some([logical(items[0])?]))
            return Err("namespace option needs one value")
        NamespaceAtom.Items(items) => return Ok(Value.List([logical(item)? for item in items]))
        NamespaceAtom.TupleItems(items) => return Ok(Value.Tuple([logical(item)? for item in items]))
        NamespaceAtom.Mapping(pairs) =>
            mut entries: list[MapEntry] = []
            for entry in pairs:
                entries.append(MapEntry(key=logical(entry.key)?, value=logical(entry.value)?))
            return Ok(Value.Map(entries))
        NamespaceAtom.Fields(items) => return Ok(Value.Record(fields(items)?))
        NamespaceAtom.Alternative(identity, items) => return Ok(Value.Enum(selector(identity)?, fields(items)?))


def read_fields(values: list[ValueField]) -> Result[list[NamespaceField], str]:
    mut result: list[NamespaceField] = []
    for field in values:
        result.append(NamespaceField(identity=selector_number(field.identity)?, value=atom(field.value)?))
    return Ok(result)


def atom(value: Value) -> Result[NamespaceAtom, str]:
    match value:
        Value.Text(s) => return Ok(NamespaceAtom.Text(s))
        Value.Binary(data) => return Ok(NamespaceAtom.Binary(data))
        Value.Boolean(flag) => return Ok(NamespaceAtom.Flag(flag))
        Value.Integer(IntegerValue.Signed(number)) =>
            if number.try_resize[i64]().is_some():
                return Ok(NamespaceAtom.Signed(number.saturating_resize[i64]()))
        Value.Integer(IntegerValue.Unsigned(number)) =>
            if number.try_resize[u64]().is_some():
                return Ok(NamespaceAtom.Unsigned(number.saturating_resize[u64]()))
        Value.Float(64, data) =>
            if len(data) == 8:
                mut bits: u64 = 0u64
                for byte in data:
                    bits = (bits << 8) | byte.saturating_resize[u64]()
                return Ok(NamespaceAtom.Real(RustF64.from_bits(bits)))
        Value.NoneValue => return Ok(NamespaceAtom.Missing)
        Value.Some(items) =>
            if len(items) == 1:
                return Ok(NamespaceAtom.Present([atom(items[0])?]))
        Value.List(items) => return Ok(NamespaceAtom.Items([atom(item)? for item in items]))
        Value.Tuple(items) => return Ok(NamespaceAtom.TupleItems([atom(item)? for item in items]))
        Value.Map(entries) => return Ok(NamespaceAtom.Mapping([NamespaceEntry(key=atom(entry.key)?, value=atom(entry.value)?) for entry in entries]))
        Value.Record(items) => return Ok(NamespaceAtom.Fields(read_fields(items)?))
        Value.Enum(identity, items) => return Ok(NamespaceAtom.Alternative(selector_number(identity)?, read_fields(items)?))
        _ => pass
    return Err("invalid logical cell in a checked namespace")


def atom_fields(mut nodes: Nodes, count: int) -> Result[list[NamespaceField], str]:
    """Decode the compiler field projection from the validated Crumb node stream."""
    mut fields: list[NamespaceField] = []
    for _ in range(count):
        if nodes.next() != 18:
            return Err("invalid field in a checked namespace")
        identity = selector_number(nodes.data())?
        if AbsentPolicy.from_value(nodes.text()).is_none():
            return Err("invalid absent policy in a checked namespace")
        fields.append(NamespaceField(identity=identity, value=read_atom(nodes)?))
    return Ok(fields)


def read_atom(mut nodes: Nodes) -> Result[NamespaceAtom, str]:
    """Build the compiler carrier directly from one settled Crumb record in preorder."""
    code = nodes.next()
    match code:
        0 => return Ok(NamespaceAtom.Missing)
        1 => return Ok(NamespaceAtom.Present([read_atom(nodes)?]))
        2 => return Ok(NamespaceAtom.Flag(nodes.flag()))
        3 =>
            signed = nodes.signed()
            if signed.try_resize[i64]().is_some():
                return Ok(NamespaceAtom.Signed(signed.saturating_resize[i64]()))
        4 =>
            unsigned = nodes.unsigned()
            if unsigned.try_resize[u64]().is_some():
                return Ok(NamespaceAtom.Unsigned(unsigned.saturating_resize[u64]()))
        5 =>
            data = nodes.data()
            if nodes.number() == 64 and len(data) == 8:
                mut bits = 0u64
                for byte in data:
                    bits = (bits << 8) | byte.saturating_resize[u64]()
                return Ok(NamespaceAtom.Real(RustF64.from_bits(bits)))
        7 => return Ok(NamespaceAtom.Text(nodes.text()))
        8 => return Ok(NamespaceAtom.Binary(nodes.data()))
        10 | 11 =>
            mut values: list[NamespaceAtom] = []
            for _ in range(nodes.count()):
                values.append(read_atom(nodes)?)
            if code == 10:
                return Ok(NamespaceAtom.Items(values))
            return Ok(NamespaceAtom.TupleItems(values))
        13 =>
            mut entries: list[NamespaceEntry] = []
            for _ in range(nodes.count()):
                key = read_atom(nodes)?
                entries.append(NamespaceEntry(key=key, value=read_atom(nodes)?))
            return Ok(NamespaceAtom.Mapping(entries))
        14 => return Ok(NamespaceAtom.Fields(atom_fields(nodes, nodes.count())?))
        15 =>
            identity = selector_number(nodes.data())?
            return Ok(NamespaceAtom.Alternative(identity, atom_fields(nodes, nodes.count())?))
        _ => pass
    return Err("invalid logical cell in a checked namespace")


pub model PreparedNamespaceReader:
    """The immutable D-encoded compiler descriptions shared by namespace reads in one driver process."""

    reader: PreparedWireReader

    @staticmethod
    pub def create() -> Result[Self, str]:
        return Ok(PreparedNamespaceReader(reader=PreparedWireReader.create(namespace_root(), namespace_descriptions(), "checked namespace")?))

    pub def decode(self, encoded: bytes) -> Result[NamespaceAtom, str]:
        mut budget = graph_read_budget()?
        row = self.reader.admit(encoded, budget)?
        return self.decode_admitted(row, budget)

    pub def decode_view(self, view: MappedView) -> Result[NamespaceAtom, str]:
        """Decode the namespace in place through the same referenced dictionary."""
        mut budget = graph_read_budget()?
        row = self.reader.admit_view(view, budget)?
        return self.decode_admitted(row, budget)

    def decode_admitted(self, row: &RowAdmission, mut budget: Budget) -> Result[NamespaceAtom, str]:
        """Project the admitted namespace into the frontend's cells under the remaining allowance."""
        remaining_bytes, remaining_elements = budget.codec_allowance()
        decoded = row.read_record(0, remaining_bytes, remaining_elements, budget.depth_allowance())
        settle(decoded, budget).map_err((error) => error.message())?
        mut nodes = Nodes.create(decoded)
        root = read_atom(nodes)?
        if nodes.next() != -1:
            return Err("checked namespace row has trailing logical cells")
        return Ok(root)

    pub def identity(self, encoded: bytes, schema: u32) -> Result[NamespaceIdentity, str]:
        mut budget = graph_read_budget()?
        row = self.reader.admit(encoded, budget)?
        return self.identity_admitted(row, schema, budget)

    pub def identity_view(self, view: MappedView, schema: u32) -> Result[NamespaceIdentity, str]:
        """Recover the exact identity from an older namespace envelope already held by a mapped view."""
        mut budget = graph_read_budget()?
        row = self.reader.admit_view(view, budget)?
        return self.identity_admitted(row, schema, budget)

    def identity_admitted(self, row: &RowAdmission, schema: u32, mut budget: Budget) -> Result[NamespaceIdentity, str]:
        """Read only the advertised identity fields and verify the frontend schema."""
        name = text(wire_field(row, copy_frozen_bytes(NAMESPACE_MODULE_NAME), budget)?)?
        version = wire_field(row, copy_frozen_bytes(NAMESPACE_SCHEMA), budget)?
        match version:
            Value.Integer(IntegerValue.Unsigned(number)) =>
                if number != schema.saturating_resize[u128]():
                    return Err("unsupported checked namespace schema")
            _ => return Err("invalid checked namespace schema")
        segments = items(wire_field(row, copy_frozen_bytes(NAMESPACE_MODULE_PATH), budget)?)?
        mut path: list[str] = []
        for segment in segments:
            path.append(text(segment)?)
        return Ok(NamespaceIdentity(name=name, path=path))


pub def prepare_namespace_reader() -> Result[PreparedNamespaceReader, str]:
    return PreparedNamespaceReader.create()


pub def decode_prepared_namespace(reader: &PreparedNamespaceReader, encoded: bytes) -> Result[NamespaceAtom, str]:
    return reader.decode(encoded)


pub def identify_prepared_namespace(reader: &PreparedNamespaceReader, encoded: bytes, schema: u32) -> Result[NamespaceIdentity, str]:
    return reader.identity(encoded, schema)


pub def decode_prepared_namespace_view(reader: &PreparedNamespaceReader, view: MappedView) -> Result[NamespaceAtom, str]:
    """Decode a bounded interface directly from an immutable view."""
    return reader.decode_view(view)


pub def identify_prepared_namespace_view(reader: &PreparedNamespaceReader, view: MappedView, schema: u32) -> Result[NamespaceIdentity, str]:
    """Read the identity from a mapped interface when the caller has no separate proof."""
    return reader.identity_view(view, schema)


pub def encode_namespace_interface(root: NamespaceAtom) -> Result[bytes, str]:
    return write_wire(namespace_root(), namespace_descriptions(), logical(root)?)


pub def decode_namespace_interface(encoded: bytes) -> Result[NamespaceAtom, str]:
    return atom(read_wire(encoded, namespace_root(), namespace_descriptions())?)

pub model NamespaceIdentity:
    pub name: str
    pub path: list[str]


pub def namespace_identity(encoded: bytes, schema: u32) -> Result[NamespaceIdentity, str]:
    """Read the checked namespace identity without constructing declarations for an unused lookup table."""
    mut budget = graph_read_budget()?
    rows = admit_wire(encoded, namespace_descriptions(), budget)?
    # Only CheckedNamespaceInterface declares module_name in the closed namespace dictionary.
    name = text(rows.read_field(0, copy_frozen_bytes(NAMESPACE_MODULE_NAME), budget).map_err((error) => error.message())?)?
    version = rows.read_field(0, copy_frozen_bytes(NAMESPACE_SCHEMA), budget).map_err((error) => error.message())?
    match version:
        Value.Integer(IntegerValue.Unsigned(number)) =>
            if number != schema.saturating_resize[u128]():
                return Err("unsupported checked namespace schema")
        _ => return Err("invalid checked namespace schema")
    segments = items(rows.read_field(0, copy_frozen_bytes(NAMESPACE_MODULE_PATH), budget).map_err((error) => error.message())?)?
    mut path: list[str] = []
    for segment in segments:
        path.append(text(segment)?)
    return Ok(NamespaceIdentity(name=name, path=path))


pub model NamespacePublication:
    """The full installable namespace and its RFC 124 canonical logical-value digest."""

    pub interface: bytes
    pub semantic_interface: bytes


pub def publish_namespace_interface(root: NamespaceAtom) -> Result[NamespacePublication, str]:
    """Hash the same checked rows the compiler emits; canonical field selection preserves expansion identity."""
    value = logical(root)?
    interface = write_wire(namespace_root(), namespace_descriptions(), value)?
    mut budget = operation_budget()?
    semantic = value_hash(value, Projection.Canonical, budget).map_err((error) => error.message())?
    return Ok(NamespacePublication(interface=interface, semantic_interface=semantic.digest))


pub def encode_callable_inventory(root: NamespaceAtom) -> Result[bytes, str]:
    """Keep the full checked product and its integrity witness in the same schema-bound Crumb row."""
    value = logical(root)?
    mut budget = operation_budget()?
    checksum = value_hash(value, Projection.Object, budget).map_err((error) => error.message())?
    envelope = Value.Record([required_value(b"digest", Value.Binary(checksum.digest)), required_value(b"produc", value)])
    return write_wire(CALLABLE_PRODUCT, callable_descriptions(), envelope)


pub def decode_callable_inventory(encoded: bytes) -> Result[NamespaceAtom, str]:
    """Authenticate all fields, including the current source positions, before rebuilding any callable."""
    envelope = read_wire(encoded, CALLABLE_PRODUCT, callable_descriptions())?
    fields = match envelope:
        Value.Record(found) => found
        _ => return Err("invalid callable publication")
    if len(fields) != 2 or fields[0].identity != b"digest" or fields[1].identity != b"produc":
        return Err("invalid callable publication fields")
    mut budget = operation_budget()?
    checksum = value_hash(fields[1].value, Projection.Object, budget).map_err((error) => error.message())?
    match fields[0].value:
        Value.Binary(stored) =>
            if stored != checksum.digest:
                return Err("callable publication checksum differs")
        _ => return Err("missing callable publication checksum")
    return atom(fields[1].value)
