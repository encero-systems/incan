"""One bounded Crumb row for a retained plan-function product and its complete input witness."""

from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from graph_crumb_fields import decode_graph_row, encode_graph_row
from crumb_rows import ModelField, model_description, required_value

const PLAN_FUNCTION_SELECTOR: bytes = b"plnfun\x00"


pub model PlanFunctionRecord:
    """The exact lowering inputs, native function payload, instance requests and payload digest."""

    pub inputs: list[str]
    pub function: str
    pub requests: list[str]
    pub digest: str


pub def encode_plan_function_record(record: PlanFunctionRecord) -> Result[bytes, str]:
    """Encode one validated retained product as a complete Crumb envelope."""
    validate_record(record)?
    return encode_graph_row(PLAN_FUNCTION_SELECTOR, plan_function_description(), [
        required_value(b"digest", Value.Text(record.digest)),
        required_value(b"funct_", Value.Text(record.function)),
        required_value(b"inputs", Value.List(text_items(record.inputs))),
        required_value(b"reques", Value.List(text_items(record.requests))),
    ])


pub def decode_plan_function_record(encoded: bytes) -> Result[PlanFunctionRecord, str]:
    """Decode exactly one retained-product row without a legacy JSON fallback."""
    fields = decode_graph_row(encoded, PLAN_FUNCTION_SELECTOR, plan_function_description(), 4)?
    record = PlanFunctionRecord(
        digest=text_value(fields[0].value)?,
        function=text_value(fields[1].value)?,
        inputs=text_values(fields[2].value)?,
        requests=text_values(fields[3].value)?,
    )
    validate_record(record)?
    return Ok(record)


def validate_record(record: PlanFunctionRecord) -> Result[None, str]:
    """Refuse incomplete witnesses and malformed semantic digests before publication or reuse."""
    if len(record.inputs) == 0 or record.function == "":
        return Err("incomplete plan-function record")
    if len(record.digest) != 71 or not record.digest.starts_with("sha256:"):
        return Err("invalid plan-function record digest")
    for digit in record.digest[7:]:
        if digit not in "0123456789abcdef":
            return Err("invalid plan-function record digest")
    return Ok(None)


def text_items(values: list[str]) -> list[Value]:
    """Project a string list into its exact logical Crumb values."""
    return [Value.Text(value) for value in values]


def text_value(value: Value) -> Result[str, str]:
    """Require one logical Crumb string."""
    match value:
        Value.Text(text) => return Ok(text)
        _ => return Err("plan-function Crumb field is not text")


def text_values(value: Value) -> Result[list[str], str]:
    """Require one logical Crumb list containing only strings."""
    match value:
        Value.List(items) =>
            mut result: list[str] = []
            for item in items:
                result.append(text_value(item)?)
            return Ok(result)
        _ => return Err("plan-function Crumb field is not a text list")


def plan_function_description() -> Description:
    """Describe the retained product independently of its filesystem projection."""
    return model_description(
        PLAN_FUNCTION_SELECTOR,
        "incan.plan-function-product/1",
        [
            ModelField(identity=b"digest", name="digest", storage="string"),
            ModelField(identity=b"funct_", name="function", storage="string"),
            ModelField(identity=b"inputs", name="inputs", storage="list<string>"),
            ModelField(identity=b"reques", name="requests", storage="list<string>"),
        ],
    )


pub def encode_entry_record(entry: str, inputs: list[str]) -> Result[bytes, str]:
    """Retain the standalone entry and its ordered, complete producer inputs."""
    selector: bytes = b"plnent\x00"
    description = model_description(selector, "incan.plan-entry/2", [
        ModelField(identity=b"entry_", name="entry", storage="string"),
        ModelField(identity=b"inputs", name="inputs", storage="list<string>"),
    ])
    return encode_graph_row(selector, description, [
        required_value(b"entry_", Value.Text(entry)),
        required_value(b"inputs", Value.List(text_items(inputs))),
    ])


pub def encode_lowering_demand(inputs: list[str], runtime: list[str]) -> Result[bytes, str]:
    """Preserve the ordered producer inputs and each separately bounded native dependency signature."""
    selector: bytes = b"lowdem\x00"
    description = model_description(selector, "incan.lowering-demand/3", [
        ModelField(identity=b"inputs", name="inputs", storage="list<string>"),
        ModelField(identity=b"runtim", name="runtime", storage="list<string>"),
    ])
    return encode_graph_row(selector, description, [
        required_value(b"inputs", Value.List(text_items(inputs))),
        required_value(b"runtim", Value.List(text_items(runtime))),
    ])
