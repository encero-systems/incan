    CanonicalSymbolId,
    DeclarationSignature,
    StableDeclarationComponent,
    StableDeclarationLocation,
    StableDeclarationId,
    valid_hir_source_span,
    valid_canonical_symbol_id,
    valid_stable_declaration_id,
)
