"""
The compiler's shared record contracts, one module per contract; none names Oven, a worker or a native compiler object.

`records` reads keyed compiler facts through one revision-bound scope, `record_service` is the producer interface and
`checker_records` the canonical checker record codec. A consumer imports a module, for example
`from pub::internal_models.checker_records import encode_record`, or the read and producer contracts from this facade.
"""

pub from compiler_records import (
    IDENTITY_ADAPTER_PROFILE,
    IDENTITY_ADAPTER_SOURCE,
    IDENTITY_ADAPTER_GENERATION,
    IDENTITY_ADAPTER_REMOVAL_GATE,
    SymbolNamespace,
