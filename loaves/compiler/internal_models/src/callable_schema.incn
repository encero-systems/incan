def shape_location() -> Description:
    return enum_schema(b"\xb8\x57\xb7\x6c\x29\x6c\x00", "callable_products.StableDeclarationLocation", [
        variant_schema(b"\x60\x95\x02\x21\x2e\xb7", "ModuleLevel", []),
        variant_schema(b"\xa5\xe4\x74\x4f\x2c\xd8", "Nested", [ModelField(identity=b"\x4c\x10\x29\x69\x7e\xe3", name="owner", storage="record@cc1467c513c3"), ModelField(identity=b"\x50\x25\x25\x9b\x76\xb5", name="binding_ordinal", storage="u32")]),
    ])


pub def callable_descriptions() -> list[Description]:
    envelope = model_description(CALLABLE_PRODUCT, "callable_products.Publication", [
        ModelField(identity=b"digest", name="checksum", storage="binary"),
        ModelField(identity=b"produc", name="product", storage="record@37214867b828"),
    ])
    return namespace_descriptions() + [
        envelope, shape_location(),
        shape_callable_inventory(),
        shape_callable_header(),
        shape_callable_owner(),
        shape_callable_read(),
        shape_function_export(),
        shape_stable_declaration_id(),
    ]
