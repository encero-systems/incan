"""The settled executable argument contract read by one checked project call."""

from std.primitives.crumb.values import Value
from std.primitives.crumb.descriptions import Description
from crumb_rows import ModelField, model_description, required_value
from graph_crumb_fields import decode_graph_row, encode_graph_row, text as graph_text
from checker_field_grammar import full_digest
from checker_record_models import CodecFault, SettledCallRead


pub def call_read_values(reads: list[SettledCallRead]) -> Result[list[Value], CodecFault]:
    """Validate the canonical reader/target order before emitting each independently typed dependency."""
    mut previous_reader = ""
    mut previous_target = ""
    mut result: list[Value] = []
    for read in reads:
        if read.reader == "" or read.target == "" or not full_digest(read.digest):
            return Err(CodecFault.Malformed)
        if previous_reader > read.reader or (previous_reader == read.reader and previous_target >= read.target):
            return Err(CodecFault.Malformed)
        result.append(Value.Tuple([Value.Text(read.reader), Value.Text(read.target), Value.Text(read.digest)]))
        previous_reader = read.reader
        previous_target = read.target
    return Ok(result)


pub def decoded_call_reads(value: Value) -> Result[list[SettledCallRead], CodecFault]:
    """Refuse duplicate edges and malformed digests at the graph boundary."""
    values = match value:
        Value.List(found) => found
        _ => return Err(CodecFault.Malformed)
    mut result: list[SettledCallRead] = []
    for item in values:
        fields = match item:
            Value.Tuple(found) => found
            _ => return Err(CodecFault.Malformed)
        if len(fields) != 3:
            return Err(CodecFault.Malformed)
        result.append(SettledCallRead(reader=text(fields[0])?, target=text(fields[1])?, digest=text(fields[2])?))
    _ = call_read_values(result)?
    return Ok(result)


def text(value: Value) -> Result[str, CodecFault]:
    match value:
        Value.Text(found) => return Ok(found)
        _ => return Err(CodecFault.Malformed)


const OWNER_CALLS: bytes = b"owncal\x00"


def owner_description() -> Description:
    return model_description(OWNER_CALLS, "incan.graph.owner-settled-calls/1", [
        ModelField(identity=b"ident_", name="owner", storage="string"),
        ModelField(identity=b"reader", name="kernel_reader", storage="string"),
        ModelField(identity=b"reads_", name="reads", storage="list<tuple<string,string,string>>"),
        ModelField(identity=b"source", name="source", storage="string"),
    ])


def check_owner_reads(identity: &str, reader: &str, source: &str, reads: list[SettledCallRead]) -> Result[None, str]:
    if identity == "" or reader == "" or source == "":
        return Err("missing executable call witness owner")
    for read in reads:
        if read.reader != reader:
            return Err("executable call witness contains a different reader")
    return Ok(None)


pub def encode_owner_call_reads(identity: str, reader: str, source: str, reads: list[SettledCallRead]) -> Result[bytes, str]:
    """Record the exact settled targets, including an empty set, for this physical owner."""
    check_owner_reads(identity, reader, source, reads)?
    values = call_read_values(reads).map_err((error) => f"invalid executable call read: {error:?}")?
    return encode_graph_row(OWNER_CALLS, owner_description(), [
        required_value(b"ident_", Value.Text(identity)), required_value(b"reader", Value.Text(reader)),
        required_value(b"reads_", Value.List(values)), required_value(b"source", Value.Text(source)),
    ])


pub def decode_owner_call_reads(identity: &str, reader: &str, source: &str, encoded: bytes) -> Result[list[SettledCallRead], str]:
    """Verify the checked and physical reader identities before admitting any call contract."""
    fields = decode_graph_row(encoded, OWNER_CALLS, owner_description(), 4)?
    if graph_text(fields[0].value)? != identity or graph_text(fields[1].value)? != reader or graph_text(fields[3].value)? != source:
        return Err("executable call witness belongs to another owner")
    reads = decoded_call_reads(fields[2].value).map_err((error) => f"invalid executable call read: {error:?}")?
    check_owner_reads(identity, reader, source, reads)?
    return Ok(reads)
