"""The codec each generated call-artifact field writes, so a record row validates by that codec's grammar."""


pub enum CallArtifactCodec(str):
    """
    A generated call-artifact row's grammar: one checked type, one `true` flag, one checked identity, or one resolved
    operator call.
    """

    SpanType = "span-type"
    SpanSet = "span-set"
    SpanIdentity = "span-identity"
    Operator = "operator"
    Method = "method"

    pub def admits_plain_values(self, values: list[str]) -> bool:
        """
        Whether one row's values fit this codec's grammar of plain values.

        A checked type is a nested grammar the record schema validates itself, so the type codec admits no plain values.
        """
        match self:
            CallArtifactCodec.SpanType => return false
            CallArtifactCodec.Method => return false
            CallArtifactCodec.SpanSet => return values == ["true"]
            CallArtifactCodec.SpanIdentity => return len(values) == 1 and values[0] != ""
            CallArtifactCodec.Operator =>
                return len(values) == 2 and OperatorKind.from_value(values[0]).is_some() and values[1] != ""


pub enum OperatorKind(str):
    """The expression shape of a resolved user-defined operator call, as the frontend's operator codec spells it."""

    Binary = "binary"
    Unary = "unary"
    Index = "index"
    Slice = "slice"
    IndexAssign = "index-assign"
    Truthiness = "truthiness"
    Len = "len"
    Contains = "contains"
    Call = "call"


pub def call_artifact_codec(selector: str) -> Option[CallArtifactCodec]:
    """
    Name the codec the frontend's generated call-artifact projection writes for one field.

    A field the generator leaves to a hand-written or composite codec has no entry, so its rows stay unsupported.
    """
    if selector in [
        "body_ir_factory_owner_types",
        "body_ir_constructor_types",
        "inferred_constructor_types",
        "inferred_call_result_types",
        "race_arm_binding_types",
    ]:
        return Some(CallArtifactCodec.SpanType)
    if selector in [
        "body_ir_factory_result_conflicts",
        "mutable_receiver_method_calls",
        "closure_holding_params",
        "closure_returning_callables",
        "capturing_callable_bindings",
    ]:
        return Some(CallArtifactCodec.SpanSet)
    if selector in [
        "body_ir_string_slice_members",
        "body_ir_self_result_methods",
        "body_ir_async_call_targets",
        "body_ir_native_argument_identities",
        "body_ir_native_codec_members",
        "source_display_methods",
    ]:
        return Some(CallArtifactCodec.SpanIdentity)
    if selector == "resolved_method_calls":
        return Some(CallArtifactCodec.Method)
    if selector == "resolved_operator_calls":
        return Some(CallArtifactCodec.Operator)
    return None
