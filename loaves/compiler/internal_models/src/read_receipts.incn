"""Canonical completed-read receipt bytes shared by compiler workers and the engine graph publisher."""

from std.json import JsonValue
from records import ReadReceipt, ReadWitness, RecordRequest, RecordSelection, encode_record_key

pub const RECEIPT_SCHEMA: str = "incan.engine.read-receipt/1"


pub def encode_read_receipt(receipt: ReadReceipt) -> Result[bytes, str]:
    """Encode one complete compiler read receipt without depending on engine graph storage."""
    mut witnesses: list[JsonValue] = []
    for witness in receipt.witnesses:
        witnesses.append(witness_document(witness)?)
    document = JsonValue.object(
        {"schema": JsonValue.string(RECEIPT_SCHEMA), "read_schema": JsonValue.string(receipt.schema), "snapshot": JsonValue.string(
            receipt.scope.snapshot,
        ), "profile": JsonValue.string(receipt.scope.profile), "output": JsonValue.string(
            encode_record_key(receipt.preparation.output)?,
        ), "rank_certificate": JsonValue.string(receipt.preparation.rank_certificate), "selector_witnesses": JsonValue.string(
            receipt.preparation.selector_witnesses,
        ), "operations": JsonValue.int(receipt.operations), "response_bytes": JsonValue.int(receipt.response_bytes), "witnesses": JsonValue.array(
            witnesses,
        )},
    )
    return Ok(document.to_json().map_err((error) => error.message())?.encode("utf-8"))


def witness_document(witness: ReadWitness) -> Result[JsonValue, str]:
    """Normalize one typed read witness to the receipt representation retained by graph indexes."""
    match witness:
        ReadWitness.Found(found, selection_digest) =>
            return edge_document(
                "present",
                found.request,
                found.revision + "\n" + found.semantic_digest + "\n" + selection_digest,
            )
        ReadWitness.Deleted(deleted) => return edge_document("deleted", deleted.request, deleted.revision)
        ReadWitness.Absent(absent) => return edge_document("absent", absent.request, absent.exclusion_digest)
        ReadWitness.Members(_, request, membership_digest, continuation) =>
            return edge_document("members", request, membership_digest + "\n" + continuation)


def edge_document(kind: str, request: RecordRequest, evidence: str) -> Result[JsonValue, str]:
    """Bind one witness to its canonical target key, exact selection and nonempty evidence."""
    if evidence == "":
        return Err("a graph edge requires witness evidence")
    return Ok(
        JsonValue.object(
            {"kind": JsonValue.string(kind), "target": JsonValue.string(encode_record_key(request.key)?), "selection": selection_document(
                request,
            ), "evidence": JsonValue.string(evidence)},
        ),
    )


def selection_document(request: RecordRequest) -> JsonValue:
    """Encode the exact field, payload range or bounded member selector for receipt validation."""
    match request.selection:
        RecordSelection.Field(name) =>
            return JsonValue.object({"kind": JsonValue.string("field"), "name": JsonValue.string(name)})
        RecordSelection.Payload(payload) =>
            return JsonValue.object(
                {"kind": JsonValue.string("payload"), "reference": JsonValue.string(payload.reference), "offset": JsonValue.int(
                    payload.offset,
                ), "length": JsonValue.int(payload.length)},
            )
        RecordSelection.Members(members) =>
            return JsonValue.object(
                {"kind": JsonValue.string("members"), "selector": JsonValue.string(members.selector), "order": JsonValue.string(
                    members.order,
                ), "lower": JsonValue.string(members.lower), "upper": JsonValue.string(members.upper), "continuation": JsonValue.string(
                    members.continuation,
                )},
            )
