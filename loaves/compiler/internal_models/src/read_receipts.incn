"""Typed completed-read Crumb rows shared by compiler workers and the engine graph publisher."""

from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from crumb_rows import ModelField, model_description, required_value
from graph_crumb_fields import (
    KEY_TYPE, REQUEST_TYPE, decode_graph_row, encode_graph_row, integer, items, key_value, number,
    read_key, read_request, request_value, text, tuple_items,
)
from record_scope import (
    AbsentFact, DeletedFact, PreparationEvidence, ReadReceipt, ReadScope, ReadWitness,
    RecordRequest, RevisionEvidence, READ_SCHEMA, valid_request,
)

from store_record_source import encode_record_key

pub const RECEIPT_SCHEMA: str = "incan.engine.read-receipt/3"
const SELECTOR: bytes = b"readrc\x00"


def description() -> Description:
    """Each receipt commits the selected scope, producing activation, exact reads and measured work."""
    return model_description(SELECTOR, RECEIPT_SCHEMA, [
        ModelField(identity=b"budget", name="response_bytes", storage="i64"),
        ModelField(identity=b"count_", name="operations", storage="i64"),
        ModelField(identity=b"output", name="output", storage=KEY_TYPE),
        ModelField(identity=b"profil", name="profile", storage="string"),
        ModelField(identity=b"rank__", name="rank_certificate", storage="string"),
        ModelField(identity=b"schema", name="read_schema", storage="string"),
        ModelField(identity=b"select", name="selector_witnesses", storage="string"),
        ModelField(identity=b"snapsh", name="snapshot", storage="string"),
        ModelField(identity=b"witnes", name="witnesses", storage=f"list<tuple<string,{REQUEST_TYPE},list<string>>>"),
    ])


pub def encode_read_receipt(receipt: ReadReceipt) -> Result[bytes, str]:
    """Persist every completed witness, including a valid zero-read activation."""
    _ = encode_record_key(receipt.preparation.output)?
    mut witnesses: list[Value] = []
    for witness in receipt.witnesses:
        witnesses.append(witness_value(witness, receipt.scope)?)
    return encode_graph_row(SELECTOR, description(), [
        required_value(b"budget", integer(receipt.response_bytes)),
        required_value(b"count_", integer(receipt.operations)),
        required_value(b"output", key_value(receipt.preparation.output)),
        required_value(b"profil", Value.Text(receipt.scope.profile)),
        required_value(b"rank__", Value.Text(receipt.preparation.rank_certificate)),
        required_value(b"schema", Value.Text(receipt.schema)),
        required_value(b"select", Value.Text(receipt.preparation.selector_witnesses)),
        required_value(b"snapsh", Value.Text(receipt.scope.snapshot)),
        required_value(b"witnes", Value.List(witnesses)),
    ])


pub def decode_read_receipt(encoded: bytes) -> Result[ReadReceipt, str]:
    """Decode exactly one receipt and verify the domain constraints on its scope, counters and read requests."""
    fields = decode_graph_row(encoded, SELECTOR, description(), 9)?
    if text(fields[5].value)? != READ_SCHEMA:
        return Err("unsupported compiler read receipt schema")
    scope = ReadScope(snapshot=text(fields[7].value)?, profile=text(fields[3].value)?)
    operations = number(fields[1].value)?
    response_bytes = number(fields[0].value)?
    if scope.snapshot == "" or scope.profile == "" or operations < 0 or response_bytes < 0:
        return Err("compiler read receipt has incomplete scope or counters")
    mut witnesses: list[ReadWitness] = []
    for witness in items(fields[8].value)?:
        witnesses.append(read_witness(witness, scope)?)
    return Ok(ReadReceipt(
        schema=READ_SCHEMA,
        scope=scope,
        preparation=PreparationEvidence(
            output=read_key(fields[2].value)?,
            rank_certificate=text(fields[4].value)?,
            selector_witnesses=text(fields[6].value)?,
        ),
        witnesses=witnesses,
        operations=operations,
        response_bytes=response_bytes,
    ))


def witness_value(witness: ReadWitness, scope: ReadScope) -> Result[Value, str]:
    """Keep each evidence component independent of its contents and bind the witness to the receipt scope."""
    match witness:
        ReadWitness.Found(found, selection) =>
            return edge("present", scope, found.scope, found.request, [found.revision, found.semantic_digest, selection])
        ReadWitness.Deleted(deleted) =>
            return edge("deleted", scope, deleted.scope, deleted.request, [deleted.revision])
        ReadWitness.Absent(absent) =>
            return edge("absent", scope, absent.scope, absent.request, [absent.exclusion_digest])
        ReadWitness.Members(observed, request, membership, continuation) =>
            return edge("members", scope, observed, request, [membership, continuation])


def edge(kind: str, scope: ReadScope, observed: ReadScope, request: RecordRequest, evidence: list[str]) -> Result[Value, str]:
    """A witness always belongs to the leased snapshot and profile of the completed reader."""
    _ = encode_record_key(request.key)?
    if observed != scope or not valid_request(request) or evidence[0] == "":
        return Err("compiler read witness lacks matching scope, request or evidence")
    return Ok(Value.Tuple([Value.Text(kind), request_value(request), Value.List([Value.Text(part) for part in evidence])]))


def read_witness(value: Value, scope: ReadScope) -> Result[ReadWitness, str]:
    """Interpret each witness variant using its own exact evidence fields."""
    fields = tuple_items(value, 3)?
    kind = text(fields[0])?
    request = read_request(fields[1])?
    _ = encode_record_key(request.key)?
    evidence = items(fields[2])?
    if not valid_request(request) or len(evidence) == 0 or text(evidence[0])? == "":
        return Err("compiler read witness has an invalid request or empty evidence")
    first = text(evidence[0])?
    if kind == "present" and len(evidence) == 3:
        return Ok(ReadWitness.Found(RevisionEvidence(scope=scope, request=request, revision=first, semantic_digest=text(evidence[1])?), text(evidence[2])?))
    if kind == "deleted" and len(evidence) == 1:
        return Ok(ReadWitness.Deleted(DeletedFact(scope=scope, request=request, revision=first)))
    if kind == "absent" and len(evidence) == 1:
        return Ok(ReadWitness.Absent(AbsentFact(scope=scope, request=request, exclusion_digest=first)))
    if kind == "members" and len(evidence) == 2:
        return Ok(ReadWitness.Members(scope, request, first, text(evidence[1])?))
    return Err("unknown or malformed compiler read witness")
