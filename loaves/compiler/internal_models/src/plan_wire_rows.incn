"""The graph's native plan profile uses compiler-owned Crumb descriptions for its stored functions and layouts."""

from rust::incan_std_primitives::crumb import RowAdmission, RowRequest
from std.primitives.crumb.metadata_values import encode
from std.primitives.crumb.row_values import build_value, refusal, settle
from std.primitives.crumb import Budget
from std.primitives.crumb.row_reader import RowSet
from std.primitives.crumb.descriptions import Description, DescriptionMode
from std.primitives.crumb.records import RowRecord
from std.primitives.crumb.registrations import KindRegistry
from std.primitives.crumb.row_writer import write_rows
from std.primitives.crumb.values import IntegerValue, Metadata, MetadataEntry, Value, ValueField
from crumb_rows import ModelField, admit_rows, description_field, operation_budget
from graph_crumb_fields import graph_read_budget


pub def write_wire(key: bytes, descriptions: list[Description], value: Value) -> Result[bytes, str]:
    """Write a schema-checked row under the same byte, element and nesting limits as other graph records."""
    mut budget = graph_read_budget()?
    registry = KindRegistry.create([], budget).map_err((error) => error.message())?
    encoded = write_rows(descriptions, [RowRecord(key=key, value=value)], registry, false, budget).map_err((error) => error.message())?
    if len(encoded) > 67108864:
        return Err("native plan wire exceeds its byte limit")
    return Ok(encoded)


pub def read_wire(encoded: bytes, key: bytes, supplied: list[Description]) -> Result[Value, str]:
    """Authenticate every reachable schema and the sole root selector before interpreting the native payload."""
    mut budget = graph_read_budget()?
    rows = admit_wire(encoded, supplied, budget)?
    row = rows.read_record(0, budget).map_err((error) => error.message())?
    if row.key != key:
        return Err("unexpected native plan root selector")
    return Ok(row.value)


pub def admit_wire(encoded: bytes, supplied: list[Description], mut budget: Budget) -> Result[RowSet, str]:
    """Admit the complete envelope and require exactly the supplied referenced schema closure."""
    rows = admit_rows(encoded, supplied, 67108864, budget)?
    dictionary = rows.descriptions(budget).map_err((error) => error.message())?
    if rows.len() != 1 or len(dictionary) != len(supplied):
        return Err("native plan wire requires one row and its exact declaration closure")
    for entry in dictionary:
        if entry.mode != DescriptionMode.Reference:
            return Err("native plan wire requires referenced compiler schemas")
    return Ok(rows)


pub model PreparedWireReader:
    """Retain an exact reference dictionary for repeated field reads of one compiler-owned root."""

    root: bytes
    dictionary: list[bytes]
    name: str

    pub def admit(self, encoded: bytes, mut budget: Budget, mut slots: list[int] = []) -> Result[RowAdmission, str]:
        """Authenticate the complete bounded envelope against the compiler's closed reference dictionary."""
        if len(encoded) > 67108864:
            return Err(self.name + " exceeds its byte limit")
        mut request = RowRequest.new(encoded, false, true)
        for entry in self.dictionary:
            request.supply(entry)
        remaining_bytes, remaining_elements = budget.codec_allowance()
        request.allow(remaining_bytes, remaining_elements, budget.depth_allowance())
        row = request.admit()
        budget.charge_bytes(row.bytes_charged).map_err((error) => error.message())?
        budget.charge_elements(row.elements_charged).map_err((error) => error.message())?
        if not row.admitted():
            return Err(refusal(row.category, row.offset, row.field, row.variant, row.cause).message())
        if row.records != 1 or row.key(0) != self.root or row.description_count() != len(self.dictionary):
            return Err(self.name + " requires one root and its complete declaration dictionary")
        for index in range(row.description_count()):
            descriptor_bytes, descriptor_elements = budget.codec_allowance()
            descriptor = row.description(index, descriptor_bytes, descriptor_elements, budget.depth_allowance())
            settle(descriptor, budget).map_err((error) => error.message())?
            if descriptor.inline or descriptor.supplied < 0:
                return Err(self.name + " requires referenced compiler descriptions")
            slots.append(descriptor.supplied)
        return Ok(row)

    @staticmethod
    pub def create(root: bytes, descriptions: &list[Description], name: str) -> Result[Self, str]:
        mut boundary = operation_budget()?
        mut dictionary: list[bytes] = []
        for description in descriptions:
            dictionary.append(encode(description.metadata, boundary).map_err((error) => error.message())?)
        return Ok(PreparedWireReader(root=root, dictionary=dictionary, name=name))


pub def wire_field(row: &RowAdmission, selector: bytes, mut budget: Budget) -> Result[Value, str]:
    remaining_bytes, remaining_elements = budget.codec_allowance()
    field = row.read_field(0, selector, remaining_bytes, remaining_elements, budget.depth_allowance())
    settle(field, budget).map_err((error) => error.message())?
    return build_value(field).map_err((error) => error.message())


pub def variant_schema(identity: bytes, name: str, fields: list[ModelField]) -> Metadata:
    """Describe a closed native alternative and its identity-addressed positional payload."""
    return Metadata.Map([
        MetadataEntry(key="id", value=Metadata.Binary(identity)),
        MetadataEntry(key="name", value=Metadata.Text(name)),
        MetadataEntry(key="fields", value=Metadata.List([description_field(field) for field in fields])),
        MetadataEntry(key="properties", value=Metadata.Map([])),
    ])


pub def enum_schema(key: bytes, name: str, variants: list[Metadata]) -> Description:
    """A graph-local sum type with stable member identities and explicit positional types."""
    return Description(mode=DescriptionMode.Reference, metadata=Metadata.Map([
        MetadataEntry(key="kind", value=Metadata.Text("Enum")),
        MetadataEntry(key="nominal", value=Metadata.Binary(key)),
        MetadataEntry(key="path", value=Metadata.Text(name)),
        MetadataEntry(key="properties", value=Metadata.Map([])),
        MetadataEntry(key="variants", value=Metadata.List(variants)),
    ]))
