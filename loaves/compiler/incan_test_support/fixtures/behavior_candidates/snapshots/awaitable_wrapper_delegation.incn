# behavior: a model adopting Awaitable over its JoinHandle field is awaited through that field and yields the task's result
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_awaitable_wrapper_delegation_codegen
# expect-stdout:
#   9

import std.async
from std.async.task import spawn, JoinHandle, TaskJoinError

pub model TaskBox[T] with Awaitable[Result[T, TaskJoinError]]:
  pub handle: JoinHandle[T]

pub async def wait_for(box: TaskBox[int]) -> Result[int, TaskJoinError]:
  return await box

async def nine() -> int:
  return 9

async def main() -> None:
  match await wait_for(TaskBox(handle=spawn(nine()))):
    Ok(value) => println(value)
    Err(error) => println(f"join failed: {error.message()}")
