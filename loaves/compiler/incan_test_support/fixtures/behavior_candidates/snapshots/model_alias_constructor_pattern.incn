# behavior: a constructor pattern names a field by its alias and selects the arm whose literal matches (RFC 021)
# expect-stdout:
#   Premium account
#   Basic account
#   Unknown

# The constructor-pattern half of test_model_alias_expressions_codegen; the rest of that test is twinned in
# snapshots_models_and_classes/model_alias_expressions.incn. Lands (merged back into that fixture) when the route
# compiles constructor patterns with a str literal field.

from std.serde import json

@derive(json)
model Account:
    type_ [alias="type", description="Account type"]: str
    class_ [alias="class"]: str
    name: str

def describe_account(a: Account) -> str:
    match a:
        Account(type="premium") => return "Premium account"
        Account(type="basic") => return "Basic account"
        _ => return "Unknown"

def main() -> None:
    println(describe_account(Account(type="premium", class="gold", name="A")))
    println(describe_account(Account(type="basic", class="silver", name="B")))
    println(describe_account(Account(type="other", class="bronze", name="C")))
