# behavior: a provider that itself depends on a second in-fixture provider is baked after it, and the consumer reaches both through `pub::` to sum the entries
# expect-stdout:
#   coffee: 350 cents
#   bagel: 275 cents
#   total: 625 cents

from pub::ledger import entry, total
from pub::money import describe


def main() -> None:
    entries = [entry("coffee", 350), entry("bagel", 275)]
    for item in entries:
        println(f"{item.label}: {describe(item.amount)}")
    println(f"total: {describe(total(entries))}")
