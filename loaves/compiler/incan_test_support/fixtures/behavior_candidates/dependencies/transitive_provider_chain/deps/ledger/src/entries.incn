from pub::money import Amount, add, cents


pub model Entry:
    pub label: str
    pub amount: Amount


pub def entry(label: str, value: int) -> Entry:
    return Entry(label=label, amount=cents(value))


pub def total(entries: list[Entry]) -> Amount:
    mut sum = cents(0)
    for item in entries:
        sum = add(sum, item.amount)
    return sum
