# behavior: generic functions that call a callable twice, copy a str beside a type parameter, copy a concrete model, copy a value of one type parameter beside a second, and return self from a generic method all run with a Rust standard-input handle, a value that cannot be copied, as the type argument the retired tests leave unbound
# retires: loaves/compiler/incan_emit/src/trait_bound_inference.rs::clone_dependencies_exclude_callable_signatures_and_concrete_values
# retires: loaves/compiler/incan_emit/src/trait_bound_inference.rs::repeated_clone_dependency_does_not_add_unrelated_parameters
# retires: loaves/compiler/incan_emit/src/trait_bound_inference.rs::concrete_nominal_clone_does_not_bind_enclosing_generic_parameters
# retires: loaves/compiler/incan_emit/src/trait_bound_inference.rs::self_clone_binds_no_callable_own_parameters
# expect-stdout:
#   handle handle
#   ab-ab
#   fast fast
#   go go go
#   codec codec

# UNVERIFIED CANDIDATE: not executed; a `rust::` import needs a Rust inspection bake, which launches Cargo. The
# expected lines are reasoned from the program. `Stdin` has no `Clone`, so an over-inferred `T: Clone` (or `U: Clone`)
# on any of these functions would refuse the program at the Rust build; the clone-carrying parameter of `repeat_first`
# is instantiated with a str on purpose. The same shapes run with copyable arguments in
# `behavior/ownership_numerics_and_bounds/generic_functions_reuse_callables_models_and_payloads.incn`, which proves
# nothing about an absent bound. Rows stay open until a Cargo-free bake serves `rust::` under the suite.

from rust::std::io import Stdin, stdin


model Algorithm:
    name: str


model Codec:
    label: str

    def duplicate[T](self, marker: T) -> Codec:
        return self


def hold[T](_value: T) -> None:
    pass


def describe(handle: Stdin) -> str:
    _ = handle.lock()
    return "handle"


def call_both[T, U](transform: (T) -> U, first: T, second: T) -> str:
    return f"{transform(first)} {transform(second)}"


def label_twice[T](prefix: str, value: T) -> str:
    joined = prefix + "-" + prefix
    hold(value)
    return joined


def copy_algorithm[T, U](algorithm: Algorithm, first: T, second: U) -> str:
    kept = algorithm
    hold(first)
    hold(second)
    return f"{kept.name} {algorithm.name}"


def repeat_first[T, U](value: T, other: U) -> str:
    first = value
    second = value
    hold(other)
    return f"{first} {second} {value}"


def main() -> None:
    println(call_both(describe, stdin(), stdin()))
    println(label_twice("ab", stdin()))
    println(copy_algorithm(Algorithm(name="fast"), stdin(), stdin()))
    println(repeat_first("go", stdin()))
    codec = Codec(label="codec")
    println(f"{codec.duplicate(stdin()).label} {codec.label}")
