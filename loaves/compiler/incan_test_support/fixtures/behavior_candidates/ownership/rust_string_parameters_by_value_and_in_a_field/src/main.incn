# behavior: a str literal and a str variable fill a Rust struct's String field and are handed to a Rust function taking a String by value, and the variable is unchanged afterwards
# retires: loaves/compiler/incan_emit/src/conversions.rs::test_struct_field_string_literal_to_rust_string_target
# retires: loaves/compiler/incan_emit/src/conversions.rs::test_external_function_string_var_with_by_value_target_does_not_borrow
# expect-stdout:
#   sketch_family
#   literal
#   NAME
#   name

# UNVERIFIED CANDIDATE for `conversions.rs::test_struct_field_string_literal_to_rust_string_target` and
# `test_external_function_string_var_with_by_value_target_does_not_borrow` (the const-field half is the
# `build_static_str_const_rust_string_struct_field` CLI test): a `rust::` path dependency needs a Cargo-launching
# inspection bake. Rows stay open until a Cargo-free bake serves `rust::` under the suite.

from rust::tiny_option import FunctionOption, option_name, shout

pub const OPTION_NAME: str = "sketch_family"


def main() -> None:
    option = FunctionOption(name=OPTION_NAME, enabled=True)
    println(option_name(option))
    println(option_name(FunctionOption(name="literal", enabled=False)))
    name = "name"
    println(shout(name))
    println(name)
