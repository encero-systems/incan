# behavior: a closure passed to a Rust Option's map calls a local function, the same one a direct call in the function reaches (#1492)
# retires: loaves/compiler/incan_emit/tests/closure_local_call_codegen_tests.rs::a_closure_argument_to_a_rust_method_keeps_its_callee_identity_issue1492
# expect-stdout:
#   code 1
#   code 7

from rust::std::option import Option as RustOption


def describe(code: int) -> str:
    return f"code {code}"


pub def run(value: RustOption[int]) -> RustOption[str]:
    direct = describe(1)
    println(direct)
    return value.map((code) => describe(code))


def main() -> None:
    match run(RustOption.Some(7)):
        Some(text) => println(text)
        None => println("none")
