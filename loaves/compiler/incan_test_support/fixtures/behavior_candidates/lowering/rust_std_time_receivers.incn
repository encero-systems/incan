# behavior: an imported Rust type is a type-like receiver for its associated function, also when that call is nested inside a method argument, while an imported Rust constant is a value receiver for its methods
# retires: loaves/compiler/incan_ir/src/lower/expr/calls.rs::lower_rust_import_associated_method_keeps_type_like_receiver
# retires: loaves/compiler/incan_ir/src/lower/expr/calls.rs::lower_nested_rust_associated_method_arg_keeps_type_like_receiver
# retires: loaves/compiler/incan_ir/src/lower/expr/calls.rs::lower_rust_constant_method_receiver_as_value_not_type_like
# expect-stdout:
#   1
#   1500
#   1

from rust::std::time import Duration, UNIX_EPOCH


def main() -> None:
    base = Duration.from_secs(1)
    println(base.as_secs())
    total = base.saturating_add(Duration.from_millis(500))
    println(total.as_millis())
    match UNIX_EPOCH.checked_add(Duration.from_secs(1)):
        Some(later) =>
            match later.duration_since(UNIX_EPOCH):
                Ok(elapsed) => println(elapsed.as_secs())
                Err(_) => println("earlier than the epoch")
        None => println("overflow")
