# behavior: a model named Response, a name std.web also uses, is the return type of its own static method in a program that never imports std.web
# expect-stdout:
#   ok

# CHECKER BUG CANDIDATE: `incan run` refuses this program at check time with "Unknown symbol 'Response'" at the
# static method's return annotation: the stdlib surface-type check does not find the program's own model there
# (the same program with the model named `Page` runs). Found when `emit_calls_and_builtins` first ran; the twin
# `static_method_with_str_argument.incn` names its model `Page`.


model Response:
    body: str

    @staticmethod
    def make(body: str) -> Response:
        return Response(body=body)


def main() -> None:
    println(Response.make("ok").body)
