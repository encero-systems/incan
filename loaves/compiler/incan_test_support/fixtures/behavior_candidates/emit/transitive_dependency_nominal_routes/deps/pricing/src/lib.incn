from pub::catalog import Product, Column, column_name


pub model Basket:
    pub product: Product
    pub quantity: int

    def total(self) -> int:
        return self.product.cents * self.quantity


pub def column_names(columns: list[Column]) -> str:
    mut names: list[str] = []
    for column in columns:
        names.append(column_name(column))
    return " ".join(names)
