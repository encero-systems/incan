# behavior: a str parameter handed to get on a static dict is still readable after the lookup
# expect-stdout:
#   a=1
#   b missing

# ROUTE BUG CANDIDATE: `incan check` accepts this program; the run refuses it (E0382, borrow of moved value `name`:
# the static's `get` takes the parameter by value, and the f-string reads it afterwards). Found when
# `emit_declarations_and_modules` first ran; the twin `static_collection_method_mutations.incn` reads the static
# through a helper whose parameter is at its last use. Lands beside it when a reused probe works.

static counts: dict[str, int] = {}


def lookup(name: str) -> str:
    match counts.get(name):
        Some(value) => return f"{name}={value}"
        None => return f"{name} missing"


def main() -> None:
    counts.insert("a", 1)
    println(lookup("a"))
    println(lookup("b"))
