from rust::std::path import Path
from rust::std::str import from_utf8
from rust::std::string import String as RustString
from rust::std::vec import Vec


def decoded(data: bytes) -> str:
    match from_utf8(data):
        Ok(text) => return text
        Err(_) => return "invalid"


def decoded_vec(encoded: Vec[u8]) -> str:
    match from_utf8(encoded):
        Ok(text) => return text
        Err(_) => return "invalid"


def decoded_slice(encoded: Vec[u8]) -> str:
    match from_utf8(encoded.as_slice()):
        Ok(text) => return text
        Err(_) => return "invalid"


def owned(encoded: Vec[u8]) -> str:
    match RustString.from_utf8(encoded):
        Ok(text) => return text
        Err(_) => return "invalid"


def main() -> None:
    println(decoded(b"ab"))
    println(decoded_vec(Vec.from(b"cd")))
    println(decoded_slice(Vec.from(b"ef")))
    println(owned(Vec.from(b"gh")))
    data = b"ij"
    println(decoded(data))
    println(decoded(b"kl"))
    text = "a/b.txt"
    println(Path.new(text).is_relative())
    println(Path.new("c/d.txt").is_relative())
    println(not Path.new("e").exists())
