trait Read[Element]:
    """Require one value at the trait's own parameter position."""

    def read(self) -> Element


model Cell[Payload] with Read:
    """Use a differently named owner parameter through the existing bare adoption rule."""

    pub value: Payload

    def read(self) -> Payload:
        """Return the owner's value without introducing a new dispatch policy."""
        return self.value


def main() -> None:
    """Make the declared owner witness concrete at an ordinary source call."""
    cell = Cell(value=7)
    println(cell.read())
