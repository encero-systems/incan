# behavior: a for loop that awaits each task handle of a list takes the handles out of the list and prints each task's result
# retires: loaves/compiler/incan_ir/src/lower/tests/for_item_taking.rs::loop_awaiting_each_handle_iterates_the_list_by_value_issue1844
# expect-stdout:
#   1
#   1

from std.async import spawn


async def work() -> int:
    return 1


async def main() -> None:
    handles = [spawn(work()), spawn(work())]
    for handle in handles:
        match await handle:
            Ok(value) => println(value)
            Err(_) => println("join failed")
