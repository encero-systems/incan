# behavior: print, str and an f-string display a list, a tuple, an Option, a Result and a dict alike, through their structure
# expect-stdout:
#   [1, 2, 3]
#   [1, 2, 3]
#   [1, 2, 3]
#   (10, 20)
#   Some(1)
#   None
#   Err("bad")
#   {"a": 1}

def main() -> None:
    items: list[int] = [1, 2, 3]
    print(items)
    println(str(items))
    println(f"{items}")
    coords: tuple[int, int] = (10, 20)
    print(coords)
    present: Option[int] = Some(1)
    absent: Option[int] = None
    println(present)
    println(absent)
    outcome: Result[int, str] = Err("bad")
    println(outcome)
    counts: dict[str, int] = {"a": 1}
    println(counts)
