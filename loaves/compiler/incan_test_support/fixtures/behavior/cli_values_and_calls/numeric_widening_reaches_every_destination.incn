# behavior: a narrower integer or an f32 value widens into a wider binding, argument, return, field, list slot, Option payload and union member, a lookup probe widens to the element or key type, and two integer types compare in a type holding both
# retires: loaves/compiler/incan_emit/src/tests/numeric_operator_emission.rs::accepted_numeric_widenings_build
# expect-stdout:
#   -5 250 -10 1.5
#   250 [-5, 250]
#   -5 true
#   true true 1
#   true false

model Holder:
    value: int


def twice(value: int) -> int:
    return value * 2


def widened(value: u16) -> i64:
    return value


def main() -> None:
    small: i8 = -5
    byte: u8 = 250
    narrow: f32 = 1.5
    wide: int = small
    println(f"{wide} {widened(byte)} {twice(small)} {narrow + 0.0}")
    mut values: list[int] = [small, 0]
    values[1] = byte
    holder = Holder(value=byte)
    println(f"{holder.value} {values}")
    maybe: Option[int] = small
    held: int | str = byte
    match maybe:
        Some(inner) => println(f"{inner} {isinstance(held, int)}")
        None => println("none")
    table: dict[int, str] = {250: "b"}
    println(f"{small in values} {byte in table} {values.count(small)}")
    println(f"{small < byte} {byte == -1}")
