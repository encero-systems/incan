# behavior: FrozenList(...), FrozenDict(...) and FrozenSet(...) are not constructors; a frozen collection is declared as a const, and the call is refused at check time instead of failing the build (#1719)
# expect-diagnostic: INCAN-T0001

def count(frozen: FrozenList[int]) -> int:
    return len(frozen)

def main() -> None:
    println(count(FrozenList([7, 8])))
