# behavior: string literals passed to Deque, list, set and dict methods are stored as elements and counted (#1494)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_issue1494_collection_method_literal_arguments_codegen
# expect-stdout:
#   7

"""Issue #1494: string literals passed to collection methods become owned strings."""

from std.collections import Deque

def probe(requested: list[str]) -> int:
    mut pending = Deque[str].from_iter(requested)
    pending.append("default")
    pending.appendleft("first")
    mut names: list[str] = []
    names.append("default")
    mut seen: set[str] = set()
    seen.add("default")
    mut labels: Dict[str, str] = {}
    labels["default"] = "value"
    labels.insert("first", "value")
    return len(pending) + len(names) + len(seen) + len(labels)

def main() -> None:
    println(probe(["a"]))
