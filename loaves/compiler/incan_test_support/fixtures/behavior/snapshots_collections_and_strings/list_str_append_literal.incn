# behavior: a str list accepts an element from another list and a string literal through append (#391)
# expect-stdout:
#   orders_total count

pub def columns(input_columns: list[str]) -> list[str]:
    mut columns: list[str] = []
    columns.append(input_columns[0])
    columns.append("count")
    return columns


def main() -> None:
    result = columns(["orders_total"])
    println(" ".join(result))
