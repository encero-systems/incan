# behavior: an imported function named sum shadows the builtin and is called as the module's function (#377)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_issue377_imported_sum_shadows_builtin_codegen
# expect-stdout:
#   amount

from functions import col, sum

def selected_column_name() -> str:
  amount = col("amount")
  result = sum(amount)
  return result.column_name

def main() -> None:
  println(selected_column_name())
