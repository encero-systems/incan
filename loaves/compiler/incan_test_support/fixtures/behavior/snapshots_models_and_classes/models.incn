# behavior: models with Debug, Clone and json derives, Option fields, nested collections and nested models are constructible and every declared field is readable
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_models_codegen
# expect-stdout:
#   User: Alice, Age: 30, alice@example.com
#   Product ID: 123, Laptop at 999.99
#   Config port: 8080, localhost, timeout 30
#   must have: optional value 42
#   also must have: none none
#   Student: Bob, 4 grades, school MIT
#   Point: (1, 2)
#   Complex: 2 ids, 1 mapped, 1 optional, 3 nested
#   Distance: 5.0
#   Contact: Charlie in Boston, 123 Main St 02101, phone 555-1234
#   {"endpoint":"/users","method":"GET","payload":""}

"""Test model definitions with various decorators"""

from std.serde import json

# Simple model with basic fields
model User:
    name: str
    age: int
    email: str


# Model with @derive(Debug)
@derive(Debug)
model Product:
    id: int
    name: str
    price: float


# Model with @derive(Clone)
@derive(Clone)
model Config:
    host: str
    port: int
    timeout: int


# Model with @derive(json)
@derive(json)
model ApiRequest:
    endpoint: str
    method: str
    payload: str


# Model with multiple derives
@derive(Debug, Clone)
model Point:
    x: int
    y: int


# Model with Option fields
@derive(Debug)
model OptionalData:
    required: str
    optional: Option[str]
    maybe_number: Option[int]


# Model with nested types
@derive(Debug, Clone)
model StudentData:
    name: str
    grades: list[int]
    metadata: dict[str, str]


# Model with complex nested types
@derive(Debug)
model ComplexModel:
    ids: list[int]
    mapping: dict[str, int]
    optional_list: Option[list[str]]
    nested_dict: dict[str, list[int]]


@derive(Debug)
model Address:
    street: str
    city: str
    zipcode: str


@derive(Debug)
model Contact:
    name: str
    address: Address
    phone: str


# Model used in function signatures
@derive(Debug, Clone)
model Coordinate:
    latitude: float
    longitude: float


def create_coordinate(lat: float, lon: float) -> Coordinate:
    return Coordinate(latitude=lat, longitude=lon)


def distance_from_origin(coord: Coordinate) -> float:
    lat_sq: float = coord.latitude * coord.latitude
    lon_sq: float = coord.longitude * coord.longitude
    return (lat_sq + lon_sq) ** 0.5


def describe_optional(data: OptionalData) -> str:
    mut text: str = "none"
    match data.optional:
        Some(value) => text = value
        None => text = "none"
    mut number: str = "none"
    match data.maybe_number:
        Some(value) => number = str(value)
        None => number = "none"
    return f"{data.required}: {text} {number}"


def main() -> None:
    # Test simple model instantiation
    user: User = User(
        name="Alice",
        age=30,
        email="alice@example.com"
    )
    print(f"User: {user.name}, Age: {user.age}, {user.email}")

    # Test model with Debug derive
    product: Product = Product(
        id=123,
        name="Laptop",
        price=999.99
    )
    print(f"Product ID: {product.id}, {product.name} at {product.price}")

    # Test model with Clone derive
    config: Config = Config(
        host="localhost",
        port=8080,
        timeout=30
    )
    print(f"Config port: {config.port}, {config.host}, timeout {config.timeout}")

    # Test model with Option fields
    data1: OptionalData = OptionalData(
        required="must have",
        optional=Some("optional value"),
        maybe_number=Some(42)
    )

    data2: OptionalData = OptionalData(
        required="also must have",
        optional=None,
        maybe_number=None
    )
    print(describe_optional(data1))
    print(describe_optional(data2))

    # Test model with nested types
    student: StudentData = StudentData(
        name="Bob",
        grades=[85, 90, 88, 92],
        metadata={"school": "MIT", "year": "2024"}
    )
    school: str = student.metadata["school"]
    print(f"Student: {student.name}, {len(student.grades)} grades, school {school}")

    point: Point = Point(x=1, y=2)
    print(f"Point: ({point.x}, {point.y})")

    complex: ComplexModel = ComplexModel(
        ids=[1, 2],
        mapping={"a": 1},
        optional_list=Some(["x"]),
        nested_dict={"k": [1, 2, 3]}
    )
    mut optional_count: int = 0
    match complex.optional_list:
        Some(values) => optional_count = len(values)
        None => optional_count = 0
    nested: list[int] = complex.nested_dict["k"]
    print(f"Complex: {len(complex.ids)} ids, {len(complex.mapping)} mapped, {optional_count} optional, {len(nested)} nested")

    # Test function with models
    coord: Coordinate = create_coordinate(3.0, 4.0)
    dist: float = distance_from_origin(coord)
    print(f"Distance: {dist}")

    # Test nested models
    address: Address = Address(
        street="123 Main St",
        city="Boston",
        zipcode="02101"
    )

    contact: Contact = Contact(
        name="Charlie",
        address=address,
        phone="555-1234"
    )
    print(f"Contact: {contact.name} in {contact.address.city}, {contact.address.street} {contact.address.zipcode}, phone {contact.phone}")

    request: ApiRequest = ApiRequest(endpoint="/users", method="GET", payload="")
    print(request.to_json())
