# behavior: alias names work in a constructor, in field access, in self access and mixed with canonical names (RFC 021)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_model_alias_expressions_codegen
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_model_alias_self_access_codegen
# expect-stdout:
#   premium
#   gold
#   premium: Test
#   premium

"""RFC 021: Test alias-aware expression lowering end-to-end"""

from std.serde import json


@derive(json)
model Account:
    type_ [alias="type", description="Account type"]: str
    class_ [alias="class"]: str
    name: str

    def get_type(self) -> str:
        return self.type


# Test 1: Constructor using alias names
def create_account() -> Account:
    return Account(type="premium", class="gold", name="Test")


# Test 2: Field access using alias names
def get_type(a: Account) -> str:
    return a.type


def get_class(a: Account) -> str:
    return a.class


# Test 3: Mix of alias and canonical names
def mixed_access(a: Account) -> str:
    # Both should work
    let t = a.type   # alias
    let n = a.name   # canonical (no alias)
    return f"{t}: {n}"


def main() -> None:
    account = create_account()
    println(get_type(account))
    println(get_class(account))
    println(mixed_access(account))
    println(account.get_type())
