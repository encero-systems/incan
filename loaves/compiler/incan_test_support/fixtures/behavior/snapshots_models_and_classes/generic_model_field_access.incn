# behavior: a generic model's field is readable through a generic function for an int and a str instantiation
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_generic_model_field_access_codegen
# expect-stdout:
#   41
#   forty-one

pub model Boxed[T]:
  pub value: T

pub def get_value[T](boxed: Boxed[T]) -> T:
  return boxed.value

def main() -> None:
  println(get_value(Boxed(value=41)))
  println(get_value(Boxed(value="forty-one")))
