# behavior: selected string helpers preserve shared edge semantics
# expect-stdout:
#   a||b|

"""Selected string helpers preserve shared edge semantics."""
def result() -> str:
    """Return the fixture expression `"|".join("a,,b,".split(","))`."""
    return "|".join("a,,b,".split(","))


def main() -> None:
    """Print the fixture values in the expected order."""
    println(result())
