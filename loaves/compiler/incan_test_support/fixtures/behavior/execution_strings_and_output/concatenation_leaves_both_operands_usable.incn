# behavior: concatenation leaves both operands usable
# expect-stdout:
#   61


"""Concatenation leaves both operands usable."""
def program_result() -> int:
  """Compute and return `xs[0] + ys[0] + joined[2]`."""
  xs = [1, 2]
  ys = [30]
  joined = xs + ys
  return xs[0] + ys[0] + joined[2]


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
