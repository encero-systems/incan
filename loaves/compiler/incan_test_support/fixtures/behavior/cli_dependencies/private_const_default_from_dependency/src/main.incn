# behavior: a dependency's function whose default names a private const of its module takes that const's value when a consumer omits the argument, directly and through a partial over the function
# retires: loaves/compiler/incan_ir/src/lower/tests/default_named_consts.rs::private_const_a_default_names_is_published_for_its_callers
# expect-stdout:
#   flat of size 2
#   flat of size 3

from pub::shapes import build, default_build


def main() -> None:
    println(build(2))
    println(default_build())
