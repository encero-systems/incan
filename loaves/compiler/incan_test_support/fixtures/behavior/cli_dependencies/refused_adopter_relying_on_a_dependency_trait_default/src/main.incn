# behavior: a consumer's model that adopts a dependency's trait without defining the trait's default method is refused at check time, since a package publishes its traits' method signatures without their default bodies
# expect-diagnostic: INCAN-T0001

from pub::tags import Tag


model Mine with Tag:
    id: int

    def tag(self) -> str:
        return "mine"


def main() -> None:
    println(Mine(id=1).loud())
