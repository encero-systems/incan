# expect-stdout:
#   first product 1
#   first number 2
#   second product two
#   second number 3

from pub::producer.first import Product as FirstProduct, label as first_label
from pub::producer.second import Product as SecondProduct, label as second_label


def main() -> None:
    println(first_label(FirstProduct(value=1)))
    println(first_label(2))
    println(second_label(SecondProduct(value="two")))
    println(second_label(3))
