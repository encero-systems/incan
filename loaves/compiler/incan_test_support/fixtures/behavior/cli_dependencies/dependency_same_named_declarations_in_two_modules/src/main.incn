# behavior: two modules of one dependency each declare `Product` and `Answer = Product | int`; the dependency builds, and each module's union accepts its own `Product` and an int (#1796)
# retires: loaves/compiler/incan_emit/src/codegen.rs::same_named_nominals_in_two_modules_get_one_union_wrapper_each_issue1796
# retires: loaves/compiler/incan_emit/src/emit/native_unions.rs::emitted_union_publication_is_scoped_to_module_and_span
# retires: loaves/compiler/incan_emit/src/emit/native_unions.rs::native_union_local_nominals_keep_module_identity_through_forwarding
# retires: loaves/compiler/incan_ir/src/lower/tests/union_member_identity.rs::shared_nominal_union_members_are_spelled_by_their_declaring_module_issue1796
# expect-stdout:
#   first product 1
#   first number 2
#   second product two
#   second number 3

from pub::producer.first import Product as FirstProduct, label as first_label
from pub::producer.second import Product as SecondProduct, label as second_label


def main() -> None:
    println(first_label(FirstProduct(value=1)))
    println(first_label(2))
    println(second_label(SecondProduct(value="two")))
    println(second_label(3))
