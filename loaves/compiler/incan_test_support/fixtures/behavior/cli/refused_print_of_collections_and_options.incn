# behavior: printing a list, a dict or an Option value is refused at check time because none of them has a printed form
# expect-diagnostic: INCAN-T0103

def main() -> None:
    items: list[int] = [1, 2, 3]
    print(items)
    counts: dict[str, int] = {"a": 1}
    println(counts)
    maybe: Option[int] = Some(1)
    println(maybe)
