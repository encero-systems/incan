# behavior: spawn given an async function instead of the task its call creates is refused at check time
# expect-diagnostic: INCAN-T0001

import std.async
from std.async import spawn


async def work() -> int:
    return 41


async def main() -> None:
    match await spawn(work):
        Ok(value) => println(value + 1)
        Err(error) => println(f"join failed: {error.message()}")
