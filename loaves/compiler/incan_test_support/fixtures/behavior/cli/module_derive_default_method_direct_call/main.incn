# behavior: the default method a user module's derive bundle gives a model is callable directly on the model, whether the bundle is applied under its plain or its aliased import binding
# retires: loaves/compiler/incan_ir/src/lower/tests/imported_trait_adoption_scope.rs::derive_bundle_trait_counts_as_adopted_for_direct_calls_issue1792
# expect-stdout:
#   1
#   encoded
#   2
#   encoded

import codec
import codec as formats


@derive(codec)
model Item:
    value: int


@derive(formats)
model Other:
    value: int


def main() -> None:
    item = Item(value=1)
    println(item.value)
    println(item.tag())
    other = Other(value=2)
    println(other.value)
    println(other.tag())
