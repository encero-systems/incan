# behavior: a const declared str reaches FrozenStr destinations and a FrozenStr const reaches str destinations, returned bare, as a union member and inside Some, passed as an argument, bound to an annotated name, stored in a model field, a list and a dict, and isinstance reads each as a str
# retires: loaves/compiler/incan_emit/src/tests/static_reads_and_frozen_strings.rs::frozen_str_const_is_converted_at_str_destinations_issue1794
# retires: loaves/compiler/incan_emit/src/tests/static_reads_and_frozen_strings.rs::planner_wraps_a_static_str_at_frozen_str_destinations_issue1794
# retires: loaves/compiler/incan_emit/src/tests/static_reads_and_frozen_strings.rs::str_const_is_wrapped_at_frozen_str_destinations_issue1794
# retires: loaves/compiler/incan_ir/src/types.rs::frozen_str_union_member_admits_a_static_str_const_issue1794
# expect-stdout:
#   true
#   true
#   policy
#   true
#   true
#   true
#   true
#   frozen
#   true
#   true
#   policy frozen
#   policy
#   policy
#   frozen
#   frozen
#   2

const NAME: str = "policy"
const FROZEN: FrozenStr = "frozen"


model Holder:
    label: FrozenStr


model Text:
    text: str


def frozen_or_int(flag: bool) -> FrozenStr | int:
    if flag:
        return NAME
    return 7


def maybe_frozen(flag: bool) -> Option[FrozenStr]:
    if flag:
        return Some(NAME)
    return None


def plain_frozen() -> FrozenStr:
    return NAME


def text_or_int(flag: bool) -> str | int:
    if flag:
        return FROZEN
    return 7


def maybe_text(flag: bool) -> Option[str]:
    if flag:
        return Some(FROZEN)
    return None


def plain_text() -> str:
    return FROZEN


def is_text(value: FrozenStr | int) -> bool:
    return isinstance(value, str)


def is_present(value: Option[str]) -> bool:
    return value is not None


def main() -> None:
    println(isinstance(frozen_or_int(true), str))
    println(isinstance(maybe_frozen(true), str))
    println(plain_frozen())
    println(is_text(NAME))
    println(isinstance(text_or_int(true), str))
    println(isinstance(maybe_text(true), str))
    println(is_present(Some(FROZEN)))
    println(plain_text())
    bound: FrozenStr = NAME
    wrapped: Option[str] = Some(FROZEN)
    println(isinstance(bound, str))
    println(wrapped is not None)
    println(f"{bound} {plain_text()}")
    held = Holder(label=NAME)
    labels: list[FrozenStr] = [NAME]
    by_key: dict[str, FrozenStr] = {"k": NAME}
    text = Text(text=FROZEN)
    texts: list[str] = [FROZEN]
    words: dict[str, str] = {"k": FROZEN}
    println(held.label)
    println(labels[0])
    println(text.text)
    println(texts[0])
    println(len(by_key) + len(words))
