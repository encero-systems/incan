# behavior: a method decorator whose shapes write the decorated method's receiver as `&Box` is refused at check time; the receiver is written the way the method writes it
# expect-diagnostic: INCAN-T0110

class Box:
    value: int

    @as_int
    def label(self, value: int) -> str:
        return "value"

def parse(box: &Box, value: int) -> int:
    return value + 1

def as_int(func: (&Box, int) -> str) -> (&Box, int) -> int:
    return parse

def main() -> None:
    box = Box(value=1)
    println(box.label(7))
