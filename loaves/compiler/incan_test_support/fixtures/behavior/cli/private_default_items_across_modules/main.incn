# behavior: defaults and method-partial presets that name private consts, a private function, a private model and a private enum of their module take those items' values when another module of the project omits the arguments
# expect-stdout:
#   4
#   8
#   chunk 4 bytes
#   16
#   fast
#   hello Ada

from helpers import Greeter, describe, limit, read, speed


def main() -> None:
    println(read())
    println(read(8))
    println(describe())
    println(limit())
    println(speed())
    println(Greeter(name="Ada").hello())
