# behavior: a list comprehension consumes an owned generic list parameter and returns its elements without requiring a Clone bound
# retires: loaves/compiler/incan_emit/src/tests/comprehension_item_places.rs::generic_list_comprehension_consumes_its_parameter_issue1983
# expect-stdout:
#   3

def copy_all[T](items: list[T]) -> list[T]:
    return [item for item in items]


def main() -> None:
    println(len(copy_all([1, 2, 3])))
