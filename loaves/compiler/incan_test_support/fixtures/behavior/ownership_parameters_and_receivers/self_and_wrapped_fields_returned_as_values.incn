# behavior: a method returning self hands the caller an equal value while the receiver stays usable, and a field read from a wrapper and passed to a function leaves the wrapper's field in place
# retires: loaves/compiler/incan_emit/src/ownership.rs::return_value_noncopy_self_read_clones_to_materialize_owned_result
# retires: loaves/compiler/incan_emit/src/ownership.rs::incan_call_field_backed_noncopy_arg_clones_for_by_value_methods_issue241
# expect-stdout:
#   2 1
#   1 1

model Cursor:
    position: int


model Wrapper:
    cursor: Cursor

    def snapshot(self) -> Wrapper:
        return self


def advance(cursor: Cursor) -> Cursor:
    return Cursor(position=cursor.position + 1)


def main() -> None:
    other = Wrapper(cursor=Cursor(position=1))
    moved = advance(other.cursor)
    println(f"{moved.position} {other.cursor.position}")
    copy = other.snapshot()
    println(f"{copy.cursor.position} {other.cursor.position}")
