# behavior: std.environ args() returns the program's arguments with the program itself first, so a run without arguments selects the help subcommand (#1668)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_issue1668_std_environ_args_codegen
# expect-stdout:
#   help

from std.environ import EnvironError, args


def subcommand(arguments: list[str]) -> str:
    if len(arguments) < 2:
        return "help"
    return arguments[1]


def main() -> Result[None, EnvironError]:
    arguments = args()?
    println(subcommand(arguments))
    for argument in arguments[1:]:
        println(argument)
    return Ok(None)
