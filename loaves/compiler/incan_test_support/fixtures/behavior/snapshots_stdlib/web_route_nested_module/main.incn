# behavior: a program importing a nested module that declares route handlers with and without an explicit method list runs, and the handlers compute from their parameters
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_web_route_extractors_nested_module_codegen
# expect-stdout:
#   3
#   4

import std.async
import api::routes
from api.routes import create, search


async def main() -> None:
    println(await create(3))
    println(await search(4))
