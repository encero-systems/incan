# behavior: a described function registers in a static Registry, its entry carries the key and descriptor, and the function stays callable (RFC 113)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_std_registry_import_codegen
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_std_registry_type_token_codegen
# expect-stdout:
#   1
#   normalize Normalize text
#   incan
#   1 incan

from std.registry import Registry, SubjectKind, describe


@derive(Clone, Eq)
type FunctionId = newtype str


@derive(Descriptor)
model FunctionSpec:
    summary: str


@derive(Descriptor)
model TargetSpec:
    target: Type[int]


pub static functions: Registry[FunctionId, FunctionSpec] = Registry.define(
    subjects=[SubjectKind.Function],
)


pub static targets: Registry[FunctionId, TargetSpec] = Registry.define(
    subjects=[SubjectKind.Function],
)


@describe(functions, FunctionId("normalize"), FunctionSpec(summary="Normalize text"))
pub def normalize(value: str) -> str:
    return value.strip().lower()


@describe(targets, FunctionId("normalize_target"), TargetSpec(target=int))
pub def normalize_target(value: str) -> str:
    return value.strip().lower()


def main() -> None:
    entries = functions.loaded_entries()
    assert len(entries) == 1
    assert entries[0].key == FunctionId("normalize")
    assert entries[0].descriptor.summary == "Normalize text"
    assert normalize("  INCAN  ") == "incan"
    println(len(entries))
    println(f"{entries[0].key.0} {entries[0].descriptor.summary}")
    println(normalize("  INCAN  "))
    target_entries = targets.loaded_entries()
    println(f"{len(target_entries)} {normalize_target("  INCAN  ")}")
