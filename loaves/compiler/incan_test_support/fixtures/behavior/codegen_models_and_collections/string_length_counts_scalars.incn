# behavior: len() and .len() on a str count Unicode scalars while len() on a list counts elements
# retires: loaves/compiler/incan_emit/tests/string_len_codegen_tests.rs::string_len_spelling_emit_shared_runtime_semantics
# retires: loaves/compiler/incan_emit/tests/string_len_codegen_tests.rs::list_len_keeps_collection_element_count_emission
# expect-stdout:
#   5
#   5
#   3

def length(value: str) -> int:
    return len(value)


def method_length(value: str) -> int:
    return value.len()


def list_length(values: list[int]) -> int:
    return len(values)


def main() -> None:
    println(length("héllo"))
    println(method_length("héllo"))
    println(list_length([1, 2, 3]))
