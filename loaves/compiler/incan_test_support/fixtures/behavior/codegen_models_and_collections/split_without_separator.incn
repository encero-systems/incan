# behavior: split() with no separator yields the whole text as its one part, so joining the parts with "|" returns the text unchanged
# retires: loaves/compiler/incan_emit/tests/string_helper_codegen_tests.rs::omitted_split_separator_has_a_concrete_emitted_type
# expect-stdout:
#   a b   c
#   one
#   1

def split_default(text: str) -> str:
    return "|".join(text.split())


def main() -> None:
    println(split_default("a b   c"))
    println(split_default("one"))
    println(len("a b".split()))
