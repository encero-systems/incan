# behavior: a subtrait default satisfies its supertrait slot through direct and supertrait-bounded calls, and an inherited method dispatches its self-call to the subclass override
# retires: loaves/compiler/incan_emit/src/codegen.rs::subtrait_default_satisfies_supertrait_slot_issue1825
# retires: loaves/compiler/incan_emit/src/codegen.rs::class_override_replaces_inherited_dispatch_issue1841
# expect-stdout:
#   child
#   child
#   2

trait Root:
    def label(self) -> str: ...


trait Child with Root:
    def label(self) -> str:
        return "child"


model Item with Child:
    value: int


def describe[T with Root](item: T) -> str:
    return item.label()


class Animal:
    id: int

    def grow(self) -> int:
        return 1

    def feed(self) -> int:
        return self.grow()


class Dog extends Animal:
    def grow(self) -> int:
        return 2


def main() -> None:
    println(Item(value=1).label())
    println(describe(Item(value=1)))
    println(Dog(id=1).feed())
