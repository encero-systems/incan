# behavior: a method alias declared in a model body (`mean = avg`) calls the method it aliases
# retires: loaves/toolchain/incan-cli/tests/integration_tests.rs::test_method_alias_codegen_rewrites_to_target_method
# expect-stdout:
#   10
#   10

model Stats:
    value: int
    mean = avg

    def avg(self) -> int:
        return self.value


def main() -> None:
    stats = Stats(value=10)
    println(stats.mean())
    println(stats.avg())
