# behavior: a validated newtype's from_underlying hook accepts a positive value and refuses a non-positive one, and an int argument coerces through the same hook
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::newtype_associated_declaration_and_call_share_one_projection
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::validated_newtype_implicit_coercion_calls_the_hook_projection
# expect-stdout:
#   ok 1
#   err value must be positive
#   accepted 1

type Positive = newtype int:
  def from_underlying(value: int) -> Result[Self, ValidationError]:
    if value <= 0:
      return Err(ValidationError("value must be positive"))
    return Ok(Positive(value))

def accept(value: Positive) -> None:
  println(f"accepted {value.0}")

def main() -> None:
  match Positive.from_underlying(1):
    Ok(value) => println(f"ok {value.0}")
    Err(error) => println(f"err {error}")
  match Positive.from_underlying(0):
    Ok(value) => println(f"ok {value.0}")
    Err(error) => println(f"err {error}")
  accept(1)
