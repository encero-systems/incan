# behavior: a user-defined decorator on a mutating method keeps the method callable and its mutation of the receiver visible afterwards (RFC 036)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_user_defined_mutable_method_decorators_codegen
# expect-stdout:
#   3
#   5

# RFC 036: user-defined mutable method decorators

class Counter:
    value: int

    @keep
    def bump(mut self, by: int) -> int:
        self.value = self.value + by
        return self.value

def keep(func: (&mut Counter, int) -> int) -> (&mut Counter, int) -> int:
    return func

def main() -> None:
    mut counter = Counter(value=1)
    println(counter.bump(2))
    println(counter.bump(2))
