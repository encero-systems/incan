# behavior: a rest-parameter function sums its spread positional arguments whether called directly, through a bound callable or as a method
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_variadic_calls_codegen
# expect-stdout:
#   6
#   10
#   14
#   30

def collect(prefix: str, *items: int, **labels: str) -> int:
  mut total: int = 0
  for item in items:
    total = total + item
  return total

def collect_via_callable(xs: list[int], kw: dict[str, str]) -> int:
  f = collect
  return f("x", 1, *xs, name="inline", **kw)

class Collector:
  def collect(self, *items: int, **labels: str) -> int:
    mut total: int = 0
    for item in items:
      total = total + item
    return total

def collect_via_method(xs: list[int], kw: dict[str, str]) -> int:
  collector = Collector()
  return collector.collect(1, *xs, name="inline", **kw)

def main() -> None:
  xs_direct = [2, 3]
  kw_direct = {"name": "demo"}
  xs_callable = [4, 5]
  kw_callable = {"name": "callable"}
  xs_method = [6, 7]
  kw_method = {"name": "method"}
  direct = collect("x", 1, *xs_direct, name="inline", **kw_direct)
  via_callable = collect_via_callable(xs_callable, kw_callable)
  via_method = collect_via_method(xs_method, kw_method)
  println(direct)
  println(via_callable)
  println(via_method)
  println(direct + via_callable + via_method)
