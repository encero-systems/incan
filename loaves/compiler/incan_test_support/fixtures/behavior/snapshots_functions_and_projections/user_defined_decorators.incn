# behavior: a user-defined decorator runs once, when the decorated binding is initialized before main starts and not again per call, and replaces the decorated function with the callable it returns, so each call of the decorated name runs the replacement (RFC 036)
# expect-stdout:
#   decorating label
#   main
#   7
#   9

# RFC 036: user-defined decorators


def parse(value: int) -> int:
    return value


def as_int(func: (int) -> str) -> (int) -> int:
    println("decorating label")
    return parse


@as_int
def label(value: int) -> str:
    return "value"


def run(value: int) -> int:
    return label(value)


def main() -> None:
    println("main")
    println(run(7))
    println(run(9))
