# behavior: a for loop with continue and a while loop whose condition is false fall through to the final return (parity corpus row replacement-body-v0-004)
# expect-stdout:
#   10

def control_flow() -> int:
    for value in range(1, 5):
        if value % 2 == 0:
            continue
    while false:
        return 0
    return 10


def main() -> None:
    println(control_flow())
