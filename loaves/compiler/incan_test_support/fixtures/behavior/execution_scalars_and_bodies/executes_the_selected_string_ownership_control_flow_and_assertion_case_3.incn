# behavior: executes the selected string ownership control flow and assertion cases
# expect-stdout:
#   10

"""Executes the selected string ownership control flow and assertion cases."""
def program_result() -> int:
  """Traverse `for value in range(1, 5)` and return `10`."""
  for value in range(1, 5):
    if value % 2 == 0:
      continue
  while false:
    return 0
  return 10


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
