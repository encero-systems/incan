# behavior: executes let shadowing by local identity
# expect-stdout:
#   3


"""Executes let shadowing by local identity."""
def program_result() -> int:
  """Compute and return `total + x`."""
  mut total = 0
  x = 1
  if true:
    let x = 2
    total += x
  return total + x


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
