"""A for loop destructuring tuples returns from its body (parity corpus row replacement-body-v0-006)."""
def select_second_pair() -> int:
    """Return the encoded pair selected during tuple iteration."""
    pairs = [(1, 2), (4, 5)]
    for a, b in pairs:
        if a == 4:
            return a * 10 + b
    return 0


def main() -> None:
