# behavior: a for loop destructuring tuples returns from its body (parity corpus row replacement-body-v0-006)
# expect-stdout:
#   45

def select_second_pair() -> int:
    pairs = [(1, 2), (4, 5)]
    for a, b in pairs:
        if a == 4:
            return a * 10 + b
    return 0


def main() -> None:
    println(select_second_pair())
