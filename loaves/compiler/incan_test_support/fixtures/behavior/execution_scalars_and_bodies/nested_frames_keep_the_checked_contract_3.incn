# behavior: nested frames keep the checked contract, as the legacy route runs it
# expect-stdout:
#   before generator abs
# expect-exit: 101

"""Nested frames keep the checked contract, as the legacy route runs it."""
import std.async

def generated(value: int) -> Generator[int]:
    """Yield the fixture values for lazy iteration."""
    println("before generator abs")
    yield abs(value)

async def child(value: int) -> int:
    """Print the task marker before computing the absolute value."""
    println("before task abs")
    return abs(value)

async def through_generator(value: int) -> int:
    """Collect the generator and return its first value."""
    values = generated(value).collect()
    return values[0]

async def through_task(value: int) -> int:
    """Return the fixture expression `await child(value)`."""
    return await child(value)


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await through_generator(-9223372036854775808))
