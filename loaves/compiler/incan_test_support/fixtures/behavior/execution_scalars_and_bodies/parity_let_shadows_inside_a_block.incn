# behavior: a `let` inside a block shadows the outer binding only inside it (parity corpus identity row)
# expect-stdout:
#   3

"""A `let` inside a block shadows the outer binding only inside it (parity corpus identity row)."""
def shadow_let() -> int:
    """Combine the inner immutable binding with the outer value."""
    mut total = 0
    x = 1
    if true:
        let x = 2
        total += x
    return total + x


def main() -> None:
    """Print the fixture values in the expected order."""
    println(shadow_let())
