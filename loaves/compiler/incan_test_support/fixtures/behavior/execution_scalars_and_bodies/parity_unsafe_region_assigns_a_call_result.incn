# behavior: an `unsafe:` region assigns a call's result to an outer local (parity corpus case 19)
# expect-stdout:
#   5

def probe(x: int) -> int:
    return x


def touch(value: int) -> int:
    mut total = 0
    unsafe:
        total = probe(value)
    return total


def main() -> None:
    println(touch(5))
