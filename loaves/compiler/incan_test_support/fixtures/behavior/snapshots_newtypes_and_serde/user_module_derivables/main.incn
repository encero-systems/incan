# behavior: a user module declaring __derives__ supplies traits to @derive beside the stdlib json derive, for a serde-backed and a pure Incan trait (RFC 024)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc024_user_module_serde_format_codegen
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc024_user_module_pure_incan_derivable_codegen
# expect-stdout:
#   yaml
#   {"value":1}
#   schema

from std.serde import json
import yaml
import schema


@derive(json, yaml)
model Payload:
    value: int


@derive(schema)
model Schematic:
    value: int


def encode_yaml[T with yaml.Serialize](value: T) -> str:
    return value.to_yaml()


def encode_json[T with json.Serialize](value: T) -> str:
    return value.to_json()


def name[T with schema.Named](value: T) -> str:
    return value.schema_name()


def main() -> None:
    println(encode_yaml(Payload(value=1)))
    println(encode_json(Payload(value=1)))
    println(name(Schematic(value=1)))
