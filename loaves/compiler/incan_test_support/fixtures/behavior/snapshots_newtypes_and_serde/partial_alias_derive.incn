# behavior: std.serde.json Serialize imported under an alias derives, bounds and dispatches like the direct import (RFC 024, #1712)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc024_partial_alias_derive_codegen
# retires: loaves/compiler/incan_ir/src/lower/mod.rs::aliased_stdlib_json_trait_dispatch_names_the_declaration_issue1712
# expect-stdout:
#   {"value":1}

from std.serde.json import Serialize as JsonSerialize


@derive(JsonSerialize)
model Payload:
    value: int


def encode[T with JsonSerialize](value: T) -> str:
    return value.to_json()


def main() -> None:
    println(encode(Payload(value=1)))
