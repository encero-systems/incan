# behavior: after `from std import serde`, serde.json.Serialize and serde.json.Deserialize bound functions and type a parameter and a return, and to_json, json_stringify and from_json work through each (#1887)
# retires: loaves/compiler/incan_ir/src/lower/tests/json_protocol_bounds.rs::serde_json_spelling_through_the_serde_module_lowers_like_json_serialize_issue1887
# expect-stdout:
#   {"value":1}
#   {"value":2}
#   {"value":3}
#   4

from std import serde
from crate.models import Payload


def encode[T with serde.json.Serialize](value: T) -> str:
    return value.to_json()


def describe(value: serde.json.Serialize) -> str:
    return json_stringify(value)


def make() -> serde.json.Serialize:
    return Payload(value=3)


def decode[T with serde.json.Deserialize](text: str) -> Result[T, str]:
    return T.from_json(text)


def main() -> None:
    println(encode(Payload(value=1)))
    println(describe(Payload(value=2)))
    println(make().to_json())
    match decode[Payload]("{\"value\":4}"):
        Ok(payload) => println(payload.value)
        Err(error) => println(error)
