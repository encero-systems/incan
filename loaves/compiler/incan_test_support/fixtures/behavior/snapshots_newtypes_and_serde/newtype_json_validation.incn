# behavior: JSON deserialization of a validated newtype runs its from_underlying hook, accepting a short id and refusing a long one, for a plain and a generic newtype
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_validated_newtype_json_deserialization_uses_canonical_hook
# expect-stdout:
#   valid
#   refused
#   {"id":"valid"}
#   valid

from std.serde import json
from std.serde.json import Deserialize


@derive(Clone, json)
type ShortId = newtype str:
    def from_underlying(value: str) -> Result[Self, ValidationError]:
        if len(value) > 8:
            return Err(ValidationError("identifier too long"))
        return Ok(ShortId(value))


@derive(json)
model Envelope:
    id: ShortId


@derive(Clone, Deserialize)
type CheckedBox[D] = newtype D:
    def from_underlying(value: D) -> Result[Self, ValidationError]:
        return Ok(CheckedBox[D](value))


@derive(Deserialize)
model GenericEnvelope:
    value: CheckedBox[str]


def main() -> None:
    match Envelope.from_json("{\"id\":\"valid\"}"):
        Ok(envelope) => println(envelope.id.0)
        Err(_) => println("refused")
    match Envelope.from_json("{\"id\":\"far-too-long-identifier\"}"):
        Ok(envelope) => println(envelope.id.0)
        Err(_) => println("refused")
    println(Envelope(id=ShortId("valid")).to_json())
    match GenericEnvelope.from_json("{\"value\":\"valid\"}"):
        Ok(envelope) => println(envelope.value.0)
        Err(_) => println("refused")
