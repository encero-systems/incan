# behavior: Serialize and Deserialize re-exported through a facade module keep the stdlib JSON protocol, with the adopter's own from_json used
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_facade_reexported_std_serde_json_traits_keep_their_protocol
# expect-stdout:
#   {"value":1}
#   2

from facade import Serialize, Deserialize

model Payload with Serialize, Deserialize:
  value: int

  def from_json(json_str: str) -> Result[Payload, str]:
    return Ok(Payload(value=len(json_str)))

def main() -> None:
  println(Payload(value=1).to_json())
  match Payload.from_json("{}"):
    case Ok(restored):
      println(restored.value)
    case Err(message):
      println(message)
