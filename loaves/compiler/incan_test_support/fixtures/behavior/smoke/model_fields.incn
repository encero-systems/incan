# behavior: a model built with named arguments carries each str and int field's value
# retires: loaves/compiler/incan_emit/src/codegen.rs::test_model_generation
# retires: loaves/compiler/incan_emit/src/codegen.rs::test_struct_instantiation
# expect-stdout:
#   10
#   20
#   Ada 36

model Point:
    x: int
    y: int


pub model User:
    pub name: str
    pub age: int


def main() -> None:
    p = Point(x=10, y=20)
    println(p.x)
    println(p.y)
    u = User(name="Ada", age=36)
    println(f"{u.name} {u.age}")
