# behavior: a generic function iterates the fallible chunk stream of any binary reader it is given and reports each chunk's length
# retires: loaves/compiler/incan_emit/src/trait_bound_inference.rs::external_implementation_bounds_propagate_through_checked_trait_dispatch
# expect-stdout:
#   2
#   2
#   1
#   3 chunks

from std.io import BinaryReader, BytesIO, IoError


def count_chunks[R with BinaryReader](reader: R) -> Result[int, IoError]:
    mut count = 0
    for chunk in reader.chunks(2)?:
        println(len(chunk))
        count += 1
    return Ok(count)


def main() -> None:
    match count_chunks(BytesIO(b"abcde")):
        Ok(count) => println(f"{count} chunks")
        Err(error) => println(f"error {error.kind}")
