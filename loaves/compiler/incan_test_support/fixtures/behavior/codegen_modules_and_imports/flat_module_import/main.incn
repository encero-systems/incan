# behavior: a flat sibling module's model is reachable through from-import at the root and in another sibling module
# retires: loaves/compiler/incan_emit/src/codegen.rs::test_non_nested_multi_file_api_sets_internal_module_roots
# expect-stdout:
#   store:7
#   8

from db import Database
from store import touch


def main() -> None:
    println(touch(Database(id=7)))
    println(Database(id=8).id)
