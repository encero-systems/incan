# behavior: a std.serde.json trait re-exported by a user facade module still gives an adopting model its to_json (#1431)
# retires: loaves/compiler/incan_emit/src/codegen.rs::sdk_facade_reexported_serde_json_trait_keeps_its_protocol
# expect-stdout:
#   {"value":1}

from facade import Serialize


model Payload with Serialize:
    value: int


def main() -> None:
    println(Payload(value=1).to_json())
