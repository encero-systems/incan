# behavior: zip alias assignment preserves both source values
# expect-stdout:
#   6

def observe() -> int:
    pairs = zip([1], [2])
    alias = pairs
    mut total = 0
    for left, right in pairs:
        total += left + right
    for other_left, other_right in alias:
        total += other_left + other_right
    return total


def main() -> None:
    println(observe())
