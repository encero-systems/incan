# behavior: selected enumerate and zip match through the staged legacy route
# expect-stdout:
#   0
#   10
#   1
#   20
#   10
#   ten
#   41


"""Selected enumerate and zip match through the staged legacy route."""
def enumerate_zip_profile() -> int:
  """Print and sum values from enumeration and zipped lists."""
  values = [10, 20]
  labels = ["ten"]
  mut total = 0
  for pair in enumerate(values):
    println(pair.0)
    println(pair.1)
    total += pair.0 + pair.1
  for zipped_pair in zip(values, labels):
    println(zipped_pair.0)
    println(zipped_pair.1)
    total += zipped_pair.0
  return total


def main() -> None:
    """Print the fixture values in the expected order."""
    println(enumerate_zip_profile())
