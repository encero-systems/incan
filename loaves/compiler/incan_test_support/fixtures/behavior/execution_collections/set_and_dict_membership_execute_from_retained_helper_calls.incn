# behavior: set and dict membership execute from retained helper calls
# expect-stdout:
#   42

def program_result() -> int:
  values = {1, 2, 3}
  names = {"key": "value"}
  if 2 in values and 4 not in values and "key" in names and "value" not in names:
    return 42
  return 0


def main() -> None:
    println(program_result())
