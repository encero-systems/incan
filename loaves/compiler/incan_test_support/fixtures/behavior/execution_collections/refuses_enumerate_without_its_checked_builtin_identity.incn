# behavior: refuses enumerate without its checked builtin identity, as the legacy route runs it
# expect-stdout:
#   1


"""Refuses enumerate without its checked builtin identity, as the legacy route runs it."""
def missing_enumerate_identity() -> int:
  """Sum values from the enumeration under test."""
  values = [1]
  mut total = 0
  for pair in enumerate(values):
    total += pair.1
  return total


def main() -> None:
    """Print the fixture values in the expected order."""
    println(missing_enumerate_identity())
