# behavior: collection len cli publishes its result and receipt
# expect-stdout:
#   collection len
#   2200

"""Collection len cli publishes its result and receipt."""
def program_result() -> int:
  """Compute and return `len(values) * 1000 + len(mapping) * 100 + len(empty_values) * 10 + len(empty_mapping)`."""
  values = {1, 1, 2}
  mapping = {"a": 1, "a": 2, "b": 3}
  empty_values: set[int] = Set()
  empty_mapping: dict[str, int] = Dict()
  println("collection len")
  return len(values) * 1000 + len(mapping) * 100 + len(empty_values) * 10 + len(empty_mapping)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
