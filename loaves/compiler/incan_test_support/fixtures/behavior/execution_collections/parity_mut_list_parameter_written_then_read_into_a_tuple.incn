# behavior: a mut list parameter is written through an index and read into a tuple (parity corpus row replacement-body-v0-012)
# expect-stdout:
#   42

def score(mut values: list[int]) -> int:
    values[0] = 40
    pair = (values[0], 2)
    return pair.0 + pair.1

def structural_values() -> int:
    mut values = [1, 2]
    return score(values)


def main() -> None:
    println(structural_values())
