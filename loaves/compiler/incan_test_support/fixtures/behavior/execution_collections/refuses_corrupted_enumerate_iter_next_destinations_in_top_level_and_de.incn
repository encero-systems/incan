# behavior: refuses corrupted enumerate iter next destinations in top level and deferred frames
# expect-stdout:
#   1


"""Refuses corrupted enumerate iter next destinations in top level and deferred frames."""
def top_level_enumerate_item() -> int:
  """Sum indices and values from a stored enumeration."""
  pairs = enumerate([1])
  mut total = 0
  for top_level_index, top_level_value in pairs:
    total += top_level_index + top_level_value
  return total


def main() -> None:
    """Print the fixture values in the expected order."""
    println(top_level_enumerate_item())
