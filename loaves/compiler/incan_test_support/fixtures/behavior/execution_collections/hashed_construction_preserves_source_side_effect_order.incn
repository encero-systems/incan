# behavior: hashed construction preserves source side effect order
# expect-stdout:
#   set first
#   set second
#   key first
#   value first
#   key duplicate
#   value duplicate
#   needle
#   true

def mark(label: str, value: int) -> int:
  println(label)
  return value

def program_result() -> bool:
  values = {mark("set first", 1), mark("set second", 2)}
  mapping = {mark("key first", 1): mark("value first", 10), mark("key duplicate", 1): mark("value duplicate", 20)}
  return mark("needle", 1) in values and 1 in mapping


def main() -> None:
    println(program_result())
