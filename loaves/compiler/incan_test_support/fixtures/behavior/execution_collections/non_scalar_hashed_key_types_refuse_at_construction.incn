# behavior: non scalar hashed key types refuse at construction, as the legacy route runs it
# expect-stdout:
#   true

"""Non scalar hashed key types refuse at construction, as the legacy route runs it."""
def program_result() -> bool:
  """Compute and return `(1, 2) in values`."""
  values = {(1, 2)}
  return (1, 2) in values


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
