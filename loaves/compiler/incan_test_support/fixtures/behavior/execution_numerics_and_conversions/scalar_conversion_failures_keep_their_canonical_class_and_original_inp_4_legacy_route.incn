# behavior: scalar conversion failures keep their canonical class and original input, as the legacy route runs it
# expect-stdout:
#   before conversion
# expect-exit: 101
# expect-stderr-contains:
#   ValueError: cannot convert '1_000._50' to float

"""Scalar conversion failures keep their canonical class and original input, as the legacy route runs it."""
def parse(value: str) -> str:
    """Print the conversion marker and attempt to parse the supplied text."""
    println("before conversion")
    parsed = float(value)
    return str(parsed)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(parse("1_000._50"))
