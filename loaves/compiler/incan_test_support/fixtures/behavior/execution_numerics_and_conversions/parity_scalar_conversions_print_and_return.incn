# behavior: int and float conversions are printed and returned as a formatted str (parity corpus row replacement-body-v0-022)
# expect-stdout:
#   converted: 42 3.14 10.0
#   42 3.14 10.0

def scalar_conversions() -> str:
    parsed_int = int("42")
    parsed_float = float("3.14")
    widened_float = float(10)
    println(f"converted: {parsed_int} {parsed_float} {widened_float}")
    return f"{str(parsed_int)} {parsed_float} {widened_float}"


def main() -> None:
    println(scalar_conversions())
