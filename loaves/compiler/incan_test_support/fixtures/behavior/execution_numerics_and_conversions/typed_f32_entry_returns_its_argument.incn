# behavior: an f32 parameter returned unchanged prints as the same f32
# expect-stdout:
#   1.2345679

"""An f32 parameter returned unchanged prints as the same f32."""
def identity(value: f32) -> f32:
    """Return `value` for this fixture."""
    return value


def main() -> None:
    """Print `identity(value)` after preparing the fixture inputs."""
    value: f32 = 1.2345679
    println(identity(value))
