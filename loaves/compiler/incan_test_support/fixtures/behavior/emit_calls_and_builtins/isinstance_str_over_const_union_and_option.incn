# behavior: isinstance(value, str) is true for a FrozenStr const, a str literal, a `str | int` holding str, an `Option[str]` holding the const, a `FrozenStr | int` holding the const, an `Option[FrozenStr]` holding it and a `FrozenStr | str | int` holding either str member, and false for every int member and for None
# retires: loaves/compiler/incan_emit/src/emit/expressions/builtins.rs::checked_isinstance_matches_string_storage_in_direct_union_and_option_shapes
# expect-stdout:
#   true
#   true
#   true
#   false
#   true
#   false
#   true
#   false
#   true
#   false
#   true
#   true
#   false

const NAME: FrozenStr = "policy"


def pick(flag: bool) -> str | int:
    if flag:
        return "text"
    return 7


def maybe(flag: bool) -> Option[str]:
    if flag:
        return Some(NAME)
    return None


def frozen_or_int(flag: bool) -> FrozenStr | int:
    if flag:
        return NAME
    return 7


def maybe_frozen(flag: bool) -> Option[FrozenStr]:
    if flag:
        return Some(NAME)
    return None


def mixed(which: int) -> FrozenStr | str | int:
    if which == 0:
        return NAME
    if which == 1:
        text: str = "text"
        return text
    return 7


def main() -> None:
    println(isinstance(NAME, str))
    println(isinstance("literal", str))
    println(isinstance(pick(true), str))
    println(isinstance(pick(false), str))
    println(isinstance(maybe(true), str))
    println(isinstance(maybe(false), str))
    println(isinstance(frozen_or_int(true), str))
    println(isinstance(frozen_or_int(false), str))
    println(isinstance(maybe_frozen(true), str))
    println(isinstance(maybe_frozen(false), str))
    println(isinstance(mixed(0), str))
    println(isinstance(mixed(1), str))
    println(isinstance(mixed(2), str))
