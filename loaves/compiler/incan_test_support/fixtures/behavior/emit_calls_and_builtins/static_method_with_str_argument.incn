# behavior: a model's static method called through the type name takes a str local and a str literal as owned arguments and builds the model from them
# retires: loaves/compiler/incan_emit/src/emit/expressions/mod.rs::type_name_associated_call_does_not_borrow_string_arguments
# expect-stdout:
#   <p>hello</p> 12
#   <p>literal</p> 14

model Response:
    body: str
    length: int

    @staticmethod
    def html(html: str) -> Response:
        wrapped = f"<p>{html}</p>"
        return Response(body=wrapped, length=len(wrapped))


def main() -> None:
    html = "hello"
    response = Response.html(html)
    println(f"{response.body} {response.length}")
    literal = Response.html("literal")
    println(f"{literal.body} {literal.length}")
