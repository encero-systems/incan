# behavior: a for loop or a list comprehension that changes its items through its variable, over a local declared without mut read directly, through enumerate, zip or values(), through a field, a list element or a tuple element, is refused at check time
# expect-diagnostic: INCAN-T0001

class Holder:
    pub rows: list[list[int]]


def main() -> None:
    rows: list[list[int]] = [[1]]
    for row in rows:
        row.append(2)
    for i, row in enumerate(rows):
        row.append(i)
    for row, n in zip(rows, [3]):
        row.append(n)
    table: dict[str, list[int]] = {"a": [1]}
    for value in table.values():
        value.append(4)
    holder = Holder(rows=[[1]])
    for row in holder.rows:
        row.append(5)
    groups: list[list[list[int]]] = [[[1]]]
    for row in groups[0]:
        row.append(6)
    pair: tuple[list[list[int]], int] = ([[1]], 0)
    for row in pair[0]:
        row.append(7)
    popped = [row.pop() for row in rows]
    println(len(rows[0]))
