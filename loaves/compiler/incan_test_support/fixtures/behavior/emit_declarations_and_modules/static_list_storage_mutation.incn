# behavior: a module static list appended through a function keeps the appended items for later readers of the same static, and a static list that is only read yields its declared items
# expect-stdout:
#   3
#   6
#   2
#   true

static items: list[int] = [1]
static active_flags: list[bool] = [true, false]


def push(value: int) -> None:
    items.append(value)


def total() -> int:
    mut acc = 0
    for item in items:
        acc += item
    return acc


def first_flag() -> bool:
    flags = active_flags
    return flags[0]


def main() -> None:
    push(2)
    push(3)
    println(len(items))
    println(total())
    println(len(active_flags))
    println(first_flag())
