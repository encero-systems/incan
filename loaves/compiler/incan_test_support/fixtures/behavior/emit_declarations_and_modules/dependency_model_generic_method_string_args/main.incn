# behavior: a generic method with an explicit type argument on a model from another module takes a str literal and a str local as ordinary owned arguments and the local stays usable afterwards
# retires: loaves/compiler/incan_emit/src/emit/expressions/mod.rs::internal_dependency_nominal_method_call_does_not_borrow_string_arguments
# expect-stdout:
#   main:order_lines@s3://bucket/orders.csv
#   s3://bucket/orders.csv

from session import Session


model OrderLine:
    id: int


def main() -> None:
    session = Session(name="main")
    input_uri = "s3://bucket/orders.csv"
    println(session.read_csv[OrderLine]("order_lines", input_uri))
    println(input_uri)
