# behavior: a list comprehension whose binding is spelled like the enclosing parameter leaves the parameter's value in place for the match that follows
# expect-stdout:
#   true 3
#   false 3

enum Item:
    Table(int)
    Value(str)


def classify(item: Item) -> str:
    values = [item for item in [1, 2]]
    match item:
        Item.Table(_) => return f"true {len(values) + 1}"
        _ => return f"false {len(values) + 1}"


def main() -> None:
    println(classify(Item.Table(1)))
    println(classify(Item.Value("v")))
