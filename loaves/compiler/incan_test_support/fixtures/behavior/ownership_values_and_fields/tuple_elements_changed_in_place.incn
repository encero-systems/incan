# behavior: a method call or an assignment through a constant tuple index changes that element of the tuple in place, through a mut local tuple, a nested tuple, a list of tuples, a loop variable, an index counted from the end, a field of self and a field of a mut binding
# retires: loaves/compiler/incan_emit/src/tests/tuple_element_places.rs::tuple_element_method_changes_the_tuple_in_place_issue1561
# retires: loaves/compiler/incan_emit/src/tests/tuple_element_places.rs::tuple_element_of_a_field_changes_in_place_issue1561
# retires: loaves/compiler/incan_emit/src/tests/tuple_element_places.rs::writes_through_a_tuple_element_change_the_tuple_issue1561
# expect-stdout:
#   2 3 4 5 6
#   2 8
#   6 19

class Holder:
    pub pair: tuple[list[int], int]

    def add(mut self, value: int) -> None:
        self.pair[0].append(value)


class Counter:
    pub count: int

    def bump(mut self) -> None:
        self.count += 1


def main() -> None:
    mut pair: tuple[list[int], int] = ([], 0)
    pair[0].append(1)
    pair[0].append(2)
    mut outer: tuple[int, tuple[list[int], int]] = (0, ([], 0))
    outer[1][0].append(3)
    mut rows: list[tuple[list[int], int]] = [([], 0)]
    rows[0][0].append(4)
    for row in rows:
        row[0].append(5)
    mut tail: tuple[int, list[int]] = (0, [])
    tail[-1].append(6)
    println(f"{len(pair[0])} {outer[1][0][0]} {rows[0][0][0]} {rows[0][0][1]} {tail[1][0]}")
    mut holder = Holder(pair=([], 0))
    holder.add(7)
    holder.pair[0].append(8)
    println(f"{len(holder.pair[0])} {holder.pair[0][1]}")
    mut items: tuple[list[int], int] = ([0], 0)
    items[0][0] = 5
    items[0][0] += 1
    mut counted: tuple[Counter, int] = (Counter(count=1), 0)
    counted[0].count = 10
    counted[0].bump()
    mut spare = 0
    counted[0].count, spare = (counted[0].count + 1, 7)
    println(f"{items[0][0]} {counted[0].count + spare}")
