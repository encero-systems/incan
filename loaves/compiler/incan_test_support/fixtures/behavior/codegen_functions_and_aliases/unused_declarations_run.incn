# behavior: an unused private helper, an unused parameter and an unused local do not stop a program from running, and a shadowing local reads the inner value
# retires: loaves/compiler/incan_emit/src/codegen.rs::normal_codegen_keeps_used_private_helpers_without_dead_code_allows
# retires: loaves/compiler/incan_emit/src/codegen.rs::normal_codegen_prunes_unused_private_helpers
# retires: loaves/compiler/incan_emit/src/codegen.rs::normal_codegen_uses_underscore_for_unused_parameters
# retires: loaves/compiler/incan_emit/src/codegen.rs::normal_codegen_uses_underscore_for_unused_locals
# retires: loaves/compiler/incan_emit/src/codegen.rs::normal_codegen_unused_local_scan_respects_shadowing
# expect-stdout:
#   1
#   3
#   inner
#   done

def helper(value: int) -> int:
    return value


def never_called(value: int) -> int:
    return value * 100


def pick(value: int, unused: int) -> int:
    return value


def main() -> None:
    let unused = "value"
    println(helper(1))
    println(pick(3, 4))
    let shadowed = "outer"
    if true:
        let shadowed = "inner"
        println(shadowed)
    println("done")
