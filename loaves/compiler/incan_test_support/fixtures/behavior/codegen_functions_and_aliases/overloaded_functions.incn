# behavior: two public functions sharing one name are distinct overloads selected by their parameter type
# retires: loaves/compiler/incan_emit/src/codegen.rs::overloaded_source_functions_keep_distinct_canonical_projections
# expect-stdout:
#   2
#   a!

pub def convert(value: int) -> int:
    return value + 1


pub def convert(value: str) -> str:
    return value + "!"


def main() -> None:
    println(convert(1))
    println(convert("a"))
