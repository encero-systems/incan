# behavior: cli refuses unsupported callable default without a receipt, as the legacy route runs it
# expect-stdout:
#   1

"""Cli refuses unsupported callable default without a receipt, as the legacy route runs it."""
def keep(payload: bytes = b"x") -> bytes:
  """Return `payload` for this fixture."""
  return payload

def program_result() -> int:
  """Compute and return `1`."""
  keep()
  return 1


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
