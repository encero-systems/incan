# behavior: cli refuses failing race winner without a receipt, as the legacy route runs it
# expect-stdout:
# expect-exit: 101

"""Cli refuses failing race winner without a receipt, as the legacy route runs it."""
import std.async

async def first() -> int:
  """Fail the assertion when this callable is reached."""
  assert false
  return 1

async def loser() -> int:
  """Fail the assertion when this callable is reached."""
  assert false
  return 2

async def program_result() -> int:
  """Compute and return `winner`."""
  winner = race for value:
    await first() => value
    await loser() => value
  return winner


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
