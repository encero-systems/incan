# expect-stdout:
#   1

"""A race over two awaited calls takes the first arm in source order (parity corpus row replacement-body-v0-019)."""
import std.async

async def first() -> int:
    """Return `1` for this fixture."""
    return 1

async def second() -> int:
    """Return `2` for this fixture."""
    return 2

async def source_order_race() -> int:
    """Return the value from the first ready race arm."""
    winner = race for value:
        await first() => value
        await second() => value
    return winner


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await source_order_race())
