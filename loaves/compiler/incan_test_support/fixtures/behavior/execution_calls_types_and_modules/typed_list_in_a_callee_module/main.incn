# behavior: a u8 list built in a callee module returns its element to the caller
# expect-stdout:
#   41

"""A u8 list built in a callee module returns its element to the caller."""
from helper import widen


def program_result() -> u8:
    """Compute and return `widen(start)`."""
    start: u8 = 41
    return widen(start)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
