# behavior: race failure preserves the first arm span and cancels constructed losers, as the legacy route runs it
# expect-stdout:
# expect-exit: 101


import std.async

async def first() -> int:
  assert false
  return 1

async def loser() -> int:
  assert false
  return 2

async def program_result() -> int:
  winner = race for value:
    await first() => value
    await loser() => value
  return winner


async def main() -> None:
    println(await program_result())
