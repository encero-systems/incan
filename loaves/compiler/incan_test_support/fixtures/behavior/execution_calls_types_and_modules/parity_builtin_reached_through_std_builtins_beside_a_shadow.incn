# behavior: a module `len` shadows the builtin, which stays reachable as `std.builtins.len` (parity corpus identity row)
# expect-stdout:
#   8

"""A module `len` shadows the builtin, which stays reachable as `std.builtins.len` (parity corpus identity row)."""
def len(value: int) -> int:
    """Return the fixture expression `value + 1`."""
    return value + 1


def main() -> None:
    """Print the fixture values in the expected order."""
    println(len(4) + std.builtins.len([1, 2, 3]))
