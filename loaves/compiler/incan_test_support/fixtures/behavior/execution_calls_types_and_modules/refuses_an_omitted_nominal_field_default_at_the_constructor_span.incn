# behavior: refuses an omitted nominal field default at the constructor span, as the legacy route runs it
# expect-stdout:
#   40


"""Refuses an omitted nominal field default at the constructor span, as the legacy route runs it."""
model Pair:
  """Hold left and right used by this fixture."""
  left: int
  right: int = 2

def program_result() -> int:
  """Compute and return `pair.left`."""
  pair = Pair(left=40)
  return pair.left


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
