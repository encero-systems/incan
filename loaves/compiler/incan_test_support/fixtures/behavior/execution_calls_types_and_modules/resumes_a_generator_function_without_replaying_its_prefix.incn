# behavior: resumes a generator function without replaying its prefix
# expect-stdout:
#   123


"""Resumes a generator function without replaying its prefix."""
def counter() -> Generator[int]:
  """Yield the sequence consumed or retained by this fixture."""
  for value in range(1, 3):
    yield value
  yield 3

def program_result() -> int:
  """Compute and return `values[0] * 100 + values[1] * 10 + values[2]`."""
  values = counter().collect()
  return values[0] * 100 + values[1] * 10 + values[2]


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
