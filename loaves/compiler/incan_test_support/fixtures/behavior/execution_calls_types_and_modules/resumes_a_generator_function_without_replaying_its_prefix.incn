# behavior: resumes a generator function without replaying its prefix
# expect-stdout:
#   123


def counter() -> Generator[int]:
  for value in range(1, 3):
    yield value
  yield 3

def program_result() -> int:
  values = counter().collect()
  return values[0] * 100 + values[1] * 10 + values[2]


def main() -> None:
    println(program_result())
