# behavior: source defined isinstance keeps its direct callable identity
# expect-stdout:
#   false

def isinstance(value: int, target: int) -> bool:
  return value == target

def probe() -> bool:
  return isinstance(1, 1)

def explicit_probe(value: int | str) -> bool:
  return std.builtins.isinstance(value, int)


def main() -> None:
    println(explicit_probe("text"))
