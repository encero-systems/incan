# behavior: race ready ties follow source order and cancel unpolled losers
# expect-stdout:
#   2


"""Race ready ties follow source order and cancel unpolled losers."""
import std.async

async def first() -> int:
  """Return `1` for this fixture."""
  return 1

async def second() -> int:
  """Return `2` for this fixture."""
  return 2

async def program_result() -> int:
  """Compute and return `winner`."""
  winner = race for value:
    await second() => value
    await first() => value
  return winner


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
