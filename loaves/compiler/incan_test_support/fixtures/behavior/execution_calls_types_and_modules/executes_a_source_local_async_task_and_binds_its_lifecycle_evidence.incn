# behavior: executes a source local async task and binds its lifecycle evidence
# expect-stdout:
#   42


"""Executes a source local async task and binds its lifecycle evidence."""
import std.async

async def child() -> int:
  """Return `42` for this fixture."""
  return 42

async def program_result() -> int:
  """Return the fixture expression `await child()`."""
  return await child()


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
