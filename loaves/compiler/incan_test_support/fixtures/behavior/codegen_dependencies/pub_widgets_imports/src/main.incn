# behavior: a dependency's model, function and const are usable through `from pub::… import`, with an item alias, and through `import pub::… as` module alias
# expect-stdout:
#   ok
#   default
#   aliased

from pub::widgets import Widget as PublicWidget, make_widget, DEFAULT_NAME
import pub::widgets as widgets_alias


def main() -> None:
    w: PublicWidget = make_widget("ok")
    println(w.name)
    d: PublicWidget = make_widget(DEFAULT_NAME)
    println(d.name)
    println(widgets_alias.make_widget("aliased").name)
