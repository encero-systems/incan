# behavior: Type.default() from @derive(Default) gives each field its declared default and its type's default only to a field that declares none, for a model, a class and a generic model, and T.default() under a Default bound builds the same value
# retires: loaves/compiler/incan_ir/src/lower/tests/derive_contract_lowering.rs::default_derive_over_field_defaults_lowers_to_a_constructing_impl_issue1879
# expect-stdout:
#   dark
#   14
#   0
#   dark
#   1
#   3
#   5


@derive(Default)
model Settings:
    theme: str = "dark"
    font_size: int = 14
    retries: int


@derive(Default)
class Tags:
    pub names: list[str] = ["a"]


@derive(Default)
model Holder[T]:
    items: list[T]
    size: int = 3


@derive(Default)
model Inner:
    x: int = 5


@derive(Default)
model Outer:
    inner: Inner


def make[T with Default]() -> T:
    return T.default()


def main() -> None:
    settings = Settings.default()
    println(settings.theme)
    println(settings.font_size)
    println(settings.retries)
    made: Settings = make()
    println(made.theme)
    println(len(Tags.default().names))
    holder: Holder[int] = Holder.default()
    println(holder.size)
    println(Outer.default().inner.x)
