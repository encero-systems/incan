# behavior: explicit call-site type arguments on a function and on a method select the instantiation and return the passed value (RFC 054)
# expect-stdout:
#   3
#   text

"""RFC 054: explicit call-site type arguments lower to Rust turbofish on calls and method calls."""


def id[T](x: T) -> T:
    return x


class Boxed:
    def pick[T](self, value: T) -> T:
        return value


def main() -> None:
    let a = id[int](1)
    let b = Boxed()
    let c = b.pick[int](2)
    println(a + c)
    println(b.pick[str]("text"))
