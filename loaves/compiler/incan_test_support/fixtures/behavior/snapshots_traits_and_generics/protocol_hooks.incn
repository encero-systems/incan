# behavior: __bool__, __len__, __contains__, __call__ and __iter__/__next__ hooks drive truth tests, len(), in, calls and for loops (RFC 068)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc068_protocol_hooks_lower_to_method_calls
# expect-stdout:
#   ready
#   3
#   true false
#   9
#   1 2 3

model Flag:
    ready: bool

    def __bool__(self) -> bool:
        return self.ready


model Bag:
    size: int

    def __len__(self) -> int:
        return self.size

    def __contains__(self, item: int) -> bool:
        return item == self.size


model CallableBox:
    seed: int

    def __call__(self, value: int) -> int:
        return self.seed + value


model CounterIter:
    current: int
    limit: int

    def __next__(mut self) -> Option[int]:
        if self.current >= self.limit:
            return None
        self.current += 1
        return Some(self.current)


model Counter:
    limit: int

    def __iter__(self) -> CounterIter:
        return CounterIter(current=0, limit=self.limit)


def main() -> None:
    flag = Flag(ready=true)
    bag = Bag(size=3)
    callable = CallableBox(seed=4)
    if flag:
        println("ready")
    n = len(bag)
    println(n)
    present = 3 in bag
    absent = 4 in bag
    println(f"{present} {absent}")
    called = callable(5)
    println(called)
    mut seen: list[str] = []
    for item in Counter(limit=3):
        seen.append(str(item))
    println(" ".join(seen))
