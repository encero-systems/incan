# behavior: std.rust capability markers Send, Sync and Static in with-clauses accept ordinary values, alone and combined, and a Static-bounded identity returns its argument (RFC 041)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc041_std_rust_capability_bounds_codegen
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc041_capability_bounds_full_codegen
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_rfc041_emit_static_bound_codegen
# expect-stdout:
#   ran
#   7

# RFC 041: `std.rust` capability markers in generic `with` clauses (surface + codegen smoke).
# Note: `std.rust` is the Incan namespace for bound markers (`Send`, `Sync`, ...). That is not `rust::std::...`,
# which imports Rust's standard library as foreign items (e.g. `Instant`).
from std.rust import Send, Sync, Static

def run[T with Send, Sync](_t: T) -> None:
  pass

def run_static[T with Send, Static](_t: T) -> None:
  pass

def run_all[T with Send, Sync, Static](_value: T) -> None:
  pass

def pin[T with Static](value: T) -> T:
  return value

def main() -> None:
  run(1)
  run_static("text")
  run_all(2.5)
  println("ran")
  println(pin(7))
