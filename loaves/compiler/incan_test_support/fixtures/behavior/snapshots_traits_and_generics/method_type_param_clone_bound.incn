# behavior: generic methods and functions returning the first element of a list or a decoded payload work for a trait-bounded and an unbounded type parameter (#1489)
# retires: loaves/compiler/incan_emit/tests/codegen_snapshot_tests.rs::test_issue1489_method_type_param_clone_bound_codegen
# expect-stdout:
#   7
#   empty
#   plain
#   3
#   first
#   9

"""Issue #1489: a planned clone of a method's own type parameter binds `Clone` on the method header."""


pub model Decoded[T]:
    pub value: T


pub trait Marker:
    def mark(self) -> int


@derive(Clone)
pub model Tag with Marker:
    pub weight: int

    def mark(self) -> int:
        return self.weight


pub class Codec:
    pub name: str

    def pick[T with Marker](self, items: list[T]) -> Result[T, str]:
        for item in items:
            return Ok(item)
        return Err("empty")

    def pick_plain[T](self, items: list[T]) -> Result[T, str]:
        for item in items:
            return Ok(item)
        return Err("empty")

    def decode[T with Marker](self, decoded: Decoded[T]) -> Result[T, str]:
        return Ok(decoded.value)


pub def first[T](items: list[T]) -> Result[T, str]:
    for item in items:
        return Ok(item)
    return Err("empty")


pub def unwrap[T](decoded: Decoded[T]) -> Result[T, str]:
    return Ok(decoded.value)


pub def main() -> None:
    codec = Codec(name="codec")
    match codec.pick([Tag(weight=7), Tag(weight=8)]):
        Ok(tag) => println(tag.mark())
        Err(error) => println(error)
    empty: list[Tag] = []
    match codec.pick(empty):
        Ok(tag) => println(tag.mark())
        Err(error) => println(error)
    match codec.pick_plain(["plain"]):
        Ok(text) => println(text)
        Err(error) => println(error)
    match codec.decode(Decoded(value=Tag(weight=3))):
        Ok(tag) => println(tag.mark())
        Err(error) => println(error)
    match first(["first", "second"]):
        Ok(text) => println(text)
        Err(error) => println(error)
    match unwrap(Decoded(value=9)):
        Ok(number) => println(number)
        Err(error) => println(error)
