# behavior: a model, class, enum, newtype and generic model that derive Display print their {value:?} structure through println, str, an f-string and a Display bound, and a generic model displays inside a generic function over its type argument
# retires: loaves/compiler/incan_emit/src/tests/derived_display_emission.rs::derived_display_prints_the_value_structure
# retires: loaves/compiler/incan_emit/src/tests/derived_display_emission.rs::derived_display_of_a_generic_type_displays_inside_a_generic_function
# expect-stdout:
#   Point { x: 1, y: 2 }
#   Point { x: 1, y: 2 }
#   Point { x: 1, y: 2 } and Empty
#   Account { owner: "Ada", balance: 3 }
#   Circle(1.5)
#   UserId(5)
#   Box { value: "x" }
#   <Point { x: 1, y: 2 }>
#   <UserId(6)>
#   Box { value: 7 }
#   [Box { value: 7 }] Box { value: 7 }


@derive(Display)
model Point:
    x: int
    y: int


@derive(Display)
class Account:
    pub owner: str
    pub balance: int


@derive(Display)
enum Shape:
    Circle(float)
    Empty


@derive(Display)
type UserId = newtype int


@derive(Display)
model Box[T]:
    value: T


def show[T with Display](value: T) -> str:
    return f"<{value}>"


def describe[U](b: Box[U]) -> str:
    println(b)
    return f"[{b}] {str(b)}"


def main() -> None:
    p = Point(x=1, y=2)
    println(p)
    println(str(p))
    println(f"{p} and {Shape.Empty}")
    println(Account(owner="Ada", balance=3))
    println(Shape.Circle(1.5))
    println(UserId(5))
    println(Box(value="x"))
    println(show(p))
    println(show(UserId(6)))
    println(describe(Box(value=7)))
