# behavior: a user function named like the decorated function's original-name spelling stays a distinct callable beside the decorated one
# retires: loaves/compiler/incan_ir/src/lower/mod.rs::decorated_function_original_name_collision_uses_distinct_registry_keys
# expect-stdout:
#   1
#   2

def preserve[F]() -> ((F) -> F):
    return (func) => func


def __incan_original_target() -> int:
    return 1


@preserve()
def target() -> int:
    return 2


def main() -> None:
    println(__incan_original_target())
    println(target())
