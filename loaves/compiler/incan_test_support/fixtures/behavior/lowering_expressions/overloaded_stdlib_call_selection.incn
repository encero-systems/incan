# behavior: a call to an overloaded stdlib function reaches the overload the checker selected by arity, and a call to a non-overloaded one reaches its only declaration
# expect-stdout:
#   absent
#   7
#   fallback

from std.environ import EnvironError, get_as, get_optional

const KEY: str = "INCAN_BEHAVIOR_FIXTURE_UNSET_KEY"


def read() -> Result[None, EnvironError]:
    optional: Option[int] = get_as[int](KEY)?
    match optional:
        Some(value) => println(value)
        None => println("absent")
    defaulted: int = get_as[int](KEY, 7)?
    println(defaulted)
    match get_optional(KEY):
        Some(value) => println(value)
        None => println("fallback")
    return Ok(None)


def main() -> None:
    match read():
        Ok(_) => pass
        Err(error) => println(error.message())
