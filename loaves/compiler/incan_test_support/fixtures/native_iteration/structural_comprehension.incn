model Source:
    """Create a fresh cursor for each checked structural iteration."""

    pub limit: int

    def __iter__(self) -> Cursor:
        """Observe the one-time initialization and return a separate iterator owner."""
        println("iter")
        return Cursor(limit=self.limit, index=0)


model Cursor:
    """Advance a finite integer sequence through the structural next hook."""

    pub limit: int
    pub index: int

    def __next__(mut self) -> Option[int]:
        """Yield the next item or report exhaustion without changing the source."""
        if self.index >= self.limit:
            return None
        self.index += 1
        return Some(self.index)


def source(limit: int) -> Source:
    """Exercise iteration over a written call whose own facts must survive hook checking."""
    return Source(limit=limit)


def choose[T with Clone](value: T) -> T:
    """Retain a concrete generic call at the span where the checker probes iterator hooks."""
    return value


def main() -> None:
    """Compare statement, comprehension and empty iteration on the same protocol."""
    for value in choose(source(3)):
        println(value)
    values = [value * 2 for value in choose(source(2))]
    println(values)
    for value in source(0):
        println("wrong")
