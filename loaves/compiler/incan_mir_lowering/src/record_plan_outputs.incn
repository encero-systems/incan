"""Retain the existing scalar plan's entry selection and complete native interface as record producer outputs."""

from std.fs import Path
from std.json import JsonValue, parse
from pub::incan_mir_plan import (
    Function,
    NominalKind,
    NominalReference,
    Plan,
    PlanType,
    carrier_position,
    is_carrier_index,
    product_frame_names,
)
from rust::incan_semantics_core::semantic_digest import semantic_digest
from rust::serde_json import to_string
from record_plan_codec import encode_record_plan_products, encode_entry_binding
from record_positions import place_positions, relocate_product
from scalar_store import event_positions, event_references, finalize_scalar, report_scalar_refusal
from plan_modules import module_page, read_admitted
from pub::internal_models.plan_module_records import decode_plan_module


pub def publish_plan_records(plan: &Plan, products: str, report: str) -> Result[None, str]:
    """Publish loss-checked plan output and a reusable ordinary-entry binding before native compilation."""
    report_path = Path(report)
    mut events = scalar_events(report_path)?
    append_admitted_events(events, products, report_path)?
    # Every keyed declaration retains its whole-plan function, including in a unit that publishes no interface.
    mut references: list[list[NominalReference]] = []
    mut carried: list[str] = []
    keyed = keyed_plan_products(plan, products, report_path, events, references, carried)?
    if len(events) != len(plan.functions):
        # Helper frames travel inside their caller's product, so a unit with any publishes no whole-unit interface,
        # and says so: Bakery accepts an omitted interface only beside an explicit lowering refusal.
        for frame in carried:
            report_scalar_refusal(
                Some(report), frame, frame, "native-interface refuses a helper frame carried inside its caller's product",
            )?
        if len(carried) != 0 or has_scalar_refusal(report_path)?:
            return Ok(None)
        # Unit-level runtime resolution adds forwarders after every product was captured, so none witnesses them.
        mut unwitnessed = 0
        for function in plan.functions:
            if not witnessed(events, function.name):
                report_scalar_refusal(
                    Some(report),
                    function.name,
                    function.name,
                    "native-interface refuses a generated function without a graph body witness",
                )?
                unwitnessed += 1
        if unwitnessed != 0:
            return Ok(None)
        return Err("native-interface refuses generated functions without graph body witnesses")
    if len(keyed) != len(plan.functions):
        return Err("native-interface has an unwitnessed plan-function member")
    encoded = encode_record_plan_products(plan, keyed, references)?
    main = ordinary_entry(plan)?
    mut selected = JsonValue.null()
    for event in events:
        if text(event, "function")? == main:
            selected = event
    if selected.is_null():
        return Err("plan-function(entry) has no witnessed main function")
    generation = Path(products).joinpath("producer-profile").read_text("utf-8", "strict").map_err(
        (error) => error.message(),
    )?
    mut selection = "implicit-main"
    if len(plan.programs) != 0:
        selection = "selected-main"
    inputs = ["incan.plan-entry/1", generation, main, selection, text(selected, "key")?]
    key = semantic_digest(inputs).map_err((error) => str(error))?.replace("sha256:", "")
    path = Path(products).joinpath(key + ".incnentry")
    value = encode_entry_binding(main, inputs)?
    mut reused = false
    if path.is_file():
        prior = path.read_text("utf-8", "strict").map_err((error) => error.message())?
        if prior != value:
            return Err("selected plan-function(entry) disagrees with its complete inputs")
        reused = true
    else:
        path.write_text(value, "utf-8", "strict", None).map_err((error) => error.message())?
    entry = JsonValue.object({
        "schema": JsonValue.int(2), "identity": JsonValue.string(text(selected, "identity")?),
        "key": JsonValue.string(key), "function": JsonValue.string("entry"), "role": JsonValue.string("entry"),
        "demand": JsonValue.string(text(selected, "key")?), "product": JsonValue.string(value),
        "runtime_requirements": JsonValue.int(0), "reused": JsonValue.bool(reused),
    })
    write(Path(report).joinpath(key + ".event"), entry)?
    write(Path(report).joinpath("native-interface.json"), JsonValue.object({
        "schema": JsonValue.string("incan.native-interface/1"), "plan": JsonValue.string(encoded),
        "entry": JsonValue.string(key),
    }))?
    return Ok(None)


def keyed_plan_products(
    plan: &Plan,
    products: str,
    report: Path,
    events: &list[JsonValue],
    mut references: list[list[NominalReference]],
    mut carried: list[str],
) -> Result[list[str], str]:
    """
    Make each keyed product byte-identical to its whole-plan function, relocated to the declaration's position.

    Lowering captures a product before unit-level runtime resolution rewrites its calls. A fresh product therefore
    retains the final function under the same inputs, and its event carries the replaced bytes to Bakery admission.
    A reused product must already be final. A declaration without a product stays ordinary. `references` receives,
    per keyed product, the positions its declaration ordinals take in this unit, and `carried` the names of the helper
    frames those products carry.
    """
    mut keyed: list[str] = []
    for function in plan.functions:
        matches = [event for event in events if text(event, "function").unwrap_or("") == function.name]
        if len(matches) == 0:
            continue
        if len(matches) != 1:
            return Err(f"native-interface has an ambiguous plan-function member {function.name}")
        event = matches[0]
        key = text(event, "key")?
        reused = event.require("reused").and_then((field) => field.expect_bool()).map_err((error) => error.message())?
        reported = event.to_json().map_err((error) => error.message())?
        resolved = plan_positions(plan, event_references(reported)?)?
        nodes = event_positions(reported)?
        frames = carried_frames(plan, text(event, "product")?, carried)?
        # An admitted function's product is already final: it was finalized by the request that reported it.
        mut record = text(event, "product")?
        mut positions = resolved
        if event.get("admitted") is None:
            final_record, final_positions = finalize_scalar(products, key, function, reused, resolved, nodes, frames)?
            if final_record != record:
                mut fields = event.expect_object().map_err((error) => error.message())?
                fields["product"] = JsonValue.string(final_record)
                write(report.joinpath(key + ".event"), JsonValue.object(fields))?
            record = final_record
            positions = final_positions
        product = text(parse(record).map_err((error) => error.message())?, "function")?
        keyed.append(relocate_product(place_positions(product, nodes)?, str(function.span.file), function.span.line)?)
        references.append(positions)
    return Ok(keyed)


def witnessed(events: &list[JsonValue], function: str) -> bool:
    """Whether a producer event names this plan function."""
    for event in events:
        if text(event, "function").unwrap_or("") == function:
            return true
    return false


def has_scalar_refusal(report: Path) -> Result[bool, str]:
    """Require incomplete native-interface publication to carry an explicit scalar-record refusal."""
    for path in report.iterdir().map_err((error) => error.message())?:
        if path.is_file() and path.name().endswith(".refusal"):
            refusal = parse(path.read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
                (error) => error.message(),
            )?
            if refusal.require("schema").and_then((field) => field.expect_int()).map_err(
                (error) => error.message(),
            )? != 2:
                return Err("scalar record refusal has an unsupported schema")
            _ = text(refusal, "function")?
            _ = text(refusal, "refusal")?
            return Ok(true)
    return Ok(false)


def ordinary_entry(plan: &Plan) -> Result[str, str]:
    """Select the same standalone synchronous unit main admitted by existing lowering; other entry roles refuse."""
    if len(plan.programs) != 0 and plan.programs != ["main"]:
        return Err("plan-function(entry) refuses a non-standalone program selection")
    for function in plan.functions:
        if function.name == "main":
            if len(function.parameters) != 0 or function.return_type != PlanType.Unit or function.is_async:
                return Err("plan-function(entry) currently requires a synchronous unit main")
            return Ok(function.name)
    return Err("plan-function(entry) has no standalone main")


def scalar_events(report: Path) -> Result[list[JsonValue], str]:
    """Read each actual scalar producer output in deterministic key order."""
    mut events: list[JsonValue] = []
    for path in sorted([str(path.0) for path in report.iterdir().map_err((error) => error.message())?]):
        if path.endswith(".event"):
            event = parse(Path(path).read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
                (error) => error.message(),
            )?
            events.append(event)
    return Ok(events)


def text(value: JsonValue, key: str) -> Result[str, str]:
    """Require one typed compiler-event field."""
    return value.require(key).and_then((field) => field.expect_str()).map_err((error) => error.message())


def write(path: Path, value: JsonValue) -> Result[None, str]:
    """Retain one complete invocation-local output; failure refuses publication."""
    encoded = value.to_json().map_err((error) => error.message())?
    return path.write_text(encoded, "utf-8", "strict", None).map_err((error) => error.message())


def carried_frames(plan: &Plan, record: str, mut carried: list[str]) -> Result[list[Function], str]:
    """Select, in a product's order, the whole-plan helper frames it carries, and record their names."""
    payload = text(parse(record).map_err((error) => error.message())?, "function")?
    mut frames: list[Function] = []
    for name in product_frame_names(payload)?:
        mut found = false
        for function in plan.functions:
            if function.name == name:
                frames.append(function)
                found = true
                break
        if not found:
            return Err(f"plan-function frame {name} is missing from the whole-program plan")
        carried.append(name)
    return Ok(frames)


def plan_positions(plan: &Plan, references: list[NominalReference]) -> Result[list[NominalReference], str]:
    """
    Name each carrier a product reported at its lowering position by its place in the published plan.

    Publication appended the carriers, in their lowering order, after the source enums; only a carrier records the
    checked type it lays out, so the first enum that does is the first carrier.
    """
    mut base = len(plan.enums)
    for index in range(len(plan.enums)):
        if plan.enums[index].semantic_key is not None:
            base = index
            break
    mut placed: list[NominalReference] = []
    for reference in references:
        if reference.kind != NominalKind.Enum or not is_carrier_index(reference.index):
            placed.append(reference)
            continue
        index = base + carrier_position(reference.index)
        if index >= len(plan.enums) or (reference.name != "" and plan.enums[index].name != reference.name):
            return Err(f"plan names no carrier {reference.name} at the place a product reported")
        placed.append(NominalReference(kind=reference.kind, index=index, name=reference.name))
    return Ok(placed)


# The list of functions restored from admitted module plan records, which the native adapter reads beside the events.
const ADMITTED_DEFINITIONS: str = "admitted-definitions.json"


def append_admitted_events(mut events: list[JsonValue], products: str, report: Path) -> Result[None, str]:
    """
    Add the final event of every function this request restored from an admitted module's plan record.

    Such a function reported no event. Its event comes from the module's page, marked `admitted`, with the positions
    its declarations resolved to in this request in place of the ones the page recorded. A function that also took
    the keyed route keeps the event it reported.
    """
    mut reported: set[str] = set()
    for event in events:
        reported.add(text(event, "function").unwrap_or(""))
    # The native adapter fingerprints each definition by its product key and digest; it reads them from one list.
    mut definitions: list[JsonValue] = []
    for note in read_admitted(report)?:
        encoded = module_page(products, note.module)
            .read_bytes()
            .map_err((error) => f"cannot read admitted plan module {error.message()}")?
        page = decode_plan_module(encoded).map_err((error) => f"admitted plan module refused: {error:?}")?
        mut stored: Dict[str, str] = {}
        for function in page.functions:
            stored[function.function] = function.event
        for function in note.functions:
            if function.function in reported:
                continue
            if function.function not in stored:
                return Err(f"admitted plan module {note.module} holds no event for {function.function}")
            event = parse(stored[function.function]).map_err((error) => error.message())?
            # The body may have moved in its file since the record was folded; its identity is this request's.
            event_key = text(event, "key")?
            record = parse(text(event, "product")?).map_err((error) => error.message())?
            mut fields = event.expect_object().map_err((error) => error.message())?
            mut references: list[JsonValue] = []
            for reference in function.references:
                kind = parse(to_string(reference.kind).map_err((error) => str(error))?).map_err(
                    (error) => error.message(),
                )?
                references.append(
                    JsonValue.object(
                        {"kind": kind, "index": JsonValue.int(reference.index), "name": JsonValue.string(reference.name)},
                    ),
                )
            fields["references"] = JsonValue.array(references)
            fields["reused"] = JsonValue.bool(true)
            fields["admitted"] = JsonValue.bool(true)
            fields["identity"] = JsonValue.string(function.identity)
            events.append(JsonValue.object(fields))
            reported.add(function.function)
            definitions.append(
                JsonValue.object(
                    {"function": JsonValue.string(function.function), "identity": JsonValue.string(function.identity), "key": JsonValue.string(
                        event_key,
                    ), "digest": JsonValue.string(text(record, "digest")?)},
                ),
            )
    listed = report.joinpath(ADMITTED_DEFINITIONS)
    if len(definitions) > 0:
        write(listed, JsonValue.array(definitions))?
    elif listed.is_file():
        listed.unlink().map_err((error) => error.message())?
    return Ok(None)
