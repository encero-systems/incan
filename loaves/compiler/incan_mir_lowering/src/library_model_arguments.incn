"""Native SDK model arguments retained from the exact checked nominal instances that scheduled their layouts."""

from rust::incan_semantics_core::body_ir import BodyIrModule, NominalDeclaration
from pub::incan_mir_plan import PlanType, EnumDeclaration
from nominal_instances import NominalInstance, nominal_symbol
from unions import native_source_type, collect_unions


pub def local_generic_item(declaration: &NominalDeclaration, instances: list[NominalInstance]) -> Result[str, str]:
    """Select the retained template of a local closed carrier, so its storage aliases the ADT published by this Loaf."""
    for instance in instances:
        if instance.declaration.canonical == declaration.canonical and nominal_symbol(str(instance.declaration.name), instance.arguments) == declaration.name:
            return Ok("crate::" + str(instance.declaration.name))
    return Err("invalid Body IR local generic layout without its template")


pub def library_model_arguments(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    instances: list[NominalInstance],
    intrinsics: list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Transport a retained instance's actual arguments, without decoding names or inferring them from fields."""
    if len(declaration.type_parameters) == 0:
        return Ok([])
    mut selected: Option[NominalInstance] = None
    for instance in instances:
        if instance.declaration.canonical != declaration.canonical:
            continue
        if nominal_symbol(str(instance.declaration.name), instance.arguments) != declaration.name:
            continue
        if len(instance.arguments) != len(declaration.type_parameters):
            return Err("unsupported Body IR SDK model argument arity")
        match selected:
            None =>
                selected = Some(instance)
            Some(previous) =>
                if previous.arguments != instance.arguments:
                    return Err("unsupported Body IR conflicting SDK model arguments")
    match selected:
        None => return Err("unsupported Body IR SDK model without checked instance arguments")
        Some(instance) =>
            unions = collect_unions(module)
            mut arguments: list[PlanType] = []
            for argument in instance.arguments:
                arguments.append(
                    native_source_type(
                        module.nominal_declarations,
                        module.enum_declarations,
                        unions,
                        argument,
                        intrinsics,
                    )?,
                )
            return Ok(arguments)
