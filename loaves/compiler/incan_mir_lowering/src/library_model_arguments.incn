"""Native SDK model arguments retained from the exact checked nominal instances that scheduled their layouts."""

from rust::incan_semantics_core::body_ir import BodyIrModule, NominalDeclaration
from pub::incan_mir_plan import PlanType, EnumDeclaration
from nominal_instances import NominalInstance, nominal_symbol
from unions import native_source_type, collect_unions
from rust::incan_semantics_core import IncanType as RustType


pub def local_generic_item(declaration: &NominalDeclaration, instances: list[NominalInstance]) -> Result[str, str]:
    """Select the retained template of a local closed carrier, so its storage aliases the ADT published by this Loaf."""
    for instance in instances:
        if (
            instance.declaration.canonical == declaration.canonical
            and nominal_symbol(str(instance.declaration.name), instance.arguments) == declaration.name
        ):
            return Ok("crate::" + str(instance.declaration.name))
    return Err("invalid Body IR local generic layout without its template")


pub def library_model_arguments(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    instances: list[NominalInstance],
    mut intrinsics: list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Transport a retained instance's actual arguments, without decoding names or inferring them from fields."""
    native_item: str = str(declaration.native_item)
    if len(declaration.type_parameters) == 0:
        return native_arguments(module, declaration, intrinsics).map_err(
            (reason) => f"{reason} in native arguments of {native_item}",
        )
    mut selected: Option[NominalInstance] = None
    for instance in instances:
        if instance.declaration.canonical != declaration.canonical:
            continue
        if nominal_symbol(str(instance.declaration.name), instance.arguments) != declaration.name:
            continue
        if len(instance.arguments) != len(declaration.type_parameters):
            return Err("unsupported Body IR SDK model argument arity")
        match selected:
            None => selected = Some(instance)
            Some(previous) =>
                if previous.arguments != instance.arguments:
                    return Err("unsupported Body IR conflicting SDK model arguments")
    match selected:
        None => return Err(f"unsupported Body IR SDK model without checked instance arguments for {declaration.name}")
        Some(instance) =>
            return instance_native_arguments(module, declaration, instance, intrinsics).map_err(
                (reason) => f"{reason} in native instance arguments of {native_item}",
            )


def native_arguments(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    mut intrinsics: list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Preserve fixed runtime arguments of a nongeneric source surface without manufacturing an instance."""
    mut unions = collect_unions(module)
    mut arguments: list[PlanType] = []
    for argument in declaration.native_type_arguments:
        arguments.append(
            native_source_type(
                list(module.nominal_declarations),
                list(module.enum_declarations),
                unions,
                argument,
                intrinsics,
            )?,
        )
    return Ok(arguments)


def instance_native_arguments(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    instance: NominalInstance,
    mut intrinsics: list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Close native argument templates and retain each generic value's field storage through the linked owner ABI."""
    mut templates: list[RustType] = []
    for argument in instance.declaration.native_type_arguments:
        templates.append(argument.clone())
    if len(templates) == 0:
        for name in instance.declaration.type_parameters:
            parameter: RustType = RustType.TypeVar(str(name))
            templates.append(parameter.clone())
    mut closed = instance.arguments
    if len(declaration.native_type_arguments) != 0:
        closed = []
        for argument in declaration.native_type_arguments:
            closed.append(argument.clone())
    if len(templates) != len(closed):
        return Err("invalid Body IR native owner argument templates")
    mut unions = collect_unions(module)
    mut arguments: list[PlanType] = []
    for index in range(len(closed)):
        ty = native_source_type(
            list(module.nominal_declarations),
            list(module.enum_declarations),
            unions,
            closed[index],
            intrinsics,
        )?
        arguments.append(stored_argument_type(declaration, instance.declaration, templates[index], ty)?)
    return Ok(arguments)


def stored_argument_type(
    declaration: &NominalDeclaration,
    template: &NominalDeclaration,
    argument: &RustType,
    ty: PlanType,
) -> Result[PlanType, str]:
    """Transport a stored generic callable's owning ABI into its native owner argument, using the same field facts."""
    for slot in range(len(template.field_types)):
        owned: bool = declaration.owns_callable_field(slot)
        if not owned:
            continue
        match template.field_types[slot]:
            RustType.TypeVar(_name) =>
                if template.field_types[slot] != argument.clone():
                    continue
                match ty:
                    PlanType.FunctionPointer(signature) => return Ok(PlanType.Closure(signature))
                    _ => return Err("invalid Body IR stored callable owner argument")
            _ => return Err("invalid Body IR stored callable field template")
    return Ok(ty)
