"""Resolve complete checked carrier and collection types against one retained native layout context."""

from rust::incan_semantics_core import (
    IncanType as RustType,
    IncanCallableParam,
    IncanCallableParamKind,
    RuntimeBuiltinType,
    SemanticSourceTargetKind,
)
from rust::incan_semantics_core::body_ir import NominalDeclaration, EnumDeclaration as RustEnumDeclaration
from rust::incan_lang::lang::types::collections import from_str as collection_type, CollectionTypeId
from pub::incan_mir_plan import PlanType, ListLeaf, EnumDeclaration, TupleElement
from models import model_type, hashed_element
from tuples import tuple_element
from enums import enum_type
from closures import semantic_input
from decls import library_enum_item
from lists import exclusive_reference, list_parameter_type


pub def native_source_type(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    unions: list[RustType],
    ty: &RustType,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Use retained carrier identity before recursively resolving collection elements; never reopen source syntax."""
    for index in range(len(intrinsics)):
        if intrinsics[index].source_type == str(ty):
            return Ok(PlanType.Enum(len(enums) + index, intrinsics[index].name))
    match enum_type(enums, ty):
        Some(result) => return Ok(result)
        None => pass
    match ty:
        RustType.RustInteropPath(path) =>
            if str(path) == "str":
                return Ok(PlanType.NativeStr)
        RustType.Ref(inner) =>
            if is_native_str(inner):
                return Ok(PlanType.StrRef)
            return shared_receiver_type(native_source_type(nominals, enums, unions, inner, intrinsics)?)
        RustType.RefMut(inner) =>
            return mutable_receiver_type(native_source_type(nominals, enums, unions, inner, intrinsics)?)
        RustType.Unsupported(description) => return Err(f"unsupported Body IR type {description}")
        RustType.NativeBuiltin(RuntimeBuiltinType.ValidationError) => return Ok(PlanType.ValidationError)
        RustType.Function(params=parameters, return_type=result) =>
            mut signature: list[PlanType] = []
            for parameter in parameters:
                input = native_source_type(nominals, enums, unions, parameter.ty, intrinsics)?
                signature.append(semantic_input(input, parameter.kind, parameter.is_mut)?)
            signature.append(native_source_type(nominals, enums, unions, result, intrinsics)?)
            return Ok(PlanType.FunctionPointer(signature))
        RustType.Generic(base=base, args=arguments) =>
            if base == "[]" and len(arguments) == 1:
                return Ok(PlanType.NativeSlice([native_source_type(nominals, enums, unions, arguments[0], intrinsics)?]))
            if base == "Awaitable" and len(arguments) == 1:
                return Ok(PlanType.Future([native_source_type(nominals, enums, unions, arguments[0], intrinsics)?]))
            if base == "List" and len(arguments) == 1:
                element = native_source_type(nominals, enums, unions, arguments[0], intrinsics)?
                match element:
                    PlanType.List(leaf, depth) => return Ok(PlanType.List(leaf, depth + 1))
                    _ => return Ok(PlanType.List(collection_leaf(element)?, 1))
            if base == "Set" and len(arguments) == 1:
                return Ok(PlanType.Set(hashed_leaf(nominals, enums, arguments[0], intrinsics)?))
            if base == "Dict" and len(arguments) == 2:
                key = hashed_leaf(nominals, enums, arguments[0], intrinsics)?
                value = native_source_type(nominals, enums, unions, arguments[1], intrinsics)?
                return Ok(PlanType.Dict(key, collection_leaf(value)?))
            if base == "Iterator" and len(arguments) == 1:
                match zip_pair_type(nominals, enums, unions, arguments[0], intrinsics):
                    Some(pair) => return Ok(pair)
                    None => pass
            if (base == "Iterator" or base == "Generator") and len(arguments) == 1:
                match numeric_newtype_iterator(nominals, arguments[0]):
                    Some(iterator) => return Ok(iterator)
                    None => pass
                element = native_source_type(nominals, enums, unions, arguments[0], intrinsics)?
                match element:
                    PlanType.Model(owner, name) => return Ok(PlanType.Generator(ListLeaf.Model(owner, name), 0))
                    PlanType.List(ListLeaf.Model(owner, name), depth) =>
                        return Ok(PlanType.Generator(ListLeaf.Model(owner, name), depth))
                    _ => pass
            match collection_type(str(base)):
                Some(CollectionTypeId.Tuple) => return layout_tuple_type(nominals, enums, unions, arguments, intrinsics)
                _ => pass
        RustType.Tuple(elements) => return layout_tuple_type(nominals, enums, unions, elements, intrinsics)
        _ => pass
    return model_type(nominals, ty)


def is_native_str(ty: &RustType) -> bool:
    """Recognize the checker's unsized Rust str referent before ordinary owned-text projection."""
    match ty:
        RustType.RustInteropPath(path) => return str(path) == "str"
        _ => return false


pub def shared_receiver_type(ty: PlanType) -> Result[PlanType, str]:
    """Borrow the exact retained nominal, text, scalar or collection carrier through the ordinary parameter layout."""
    match ty:
        PlanType.NativeSlice(elements) => return Ok(PlanType.SliceRef(elements))
        PlanType.Model(index, name) => return Ok(PlanType.ModelRef(index, name))
        PlanType.Enum(index, name) => return Ok(PlanType.EnumRef(index, name))
        PlanType.String => return Ok(PlanType.StringRef)
        _ => pass
    collection = list_parameter_type(ty, false)
    if collection != ty:
        return Ok(collection)
    if ty in [PlanType.Int, PlanType.Float, PlanType.I8, PlanType.I16, PlanType.I32, PlanType.I128, PlanType.ISize, PlanType.USize, PlanType.U8, PlanType.U16, PlanType.U32, PlanType.U64, PlanType.U128, PlanType.F32, PlanType.F64, PlanType.Bool, PlanType.Decimal, PlanType.FrozenStr, PlanType.FrozenBytes]:
        return Ok(PlanType.ScalarRef([ty]))
    return Err("unsupported Body IR shared SDK receiver carrier")


pub def mutable_receiver_type(ty: PlanType) -> Result[PlanType, str]:
    """Reuse exclusive source parameter storage for native references, retaining scalar reference carriers explicitly."""
    match ty:
        PlanType.NativeSlice(elements) => return Ok(PlanType.SliceMutRef(elements))
        _ => pass
    match exclusive_reference(ty):
        Some(reference) => return Ok(reference)
        None => pass
    match shared_receiver_type(ty)?:
        PlanType.ScalarRef(elements) => return Ok(PlanType.ScalarMutRef(elements))
        _ => return Err("unsupported Body IR mutable callable receiver carrier")


pub def callable_parameter_type(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    unions: list[RustType],
    parameter: &IncanCallableParam,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Translate checked callable parameter kinds into the same native collection storage their Body IR frames retain."""
    element = native_source_type(nominals, enums, unions, parameter.ty, intrinsics)?
    match parameter.kind:
        IncanCallableParamKind.Normal => return Ok(element)
        IncanCallableParamKind.RestPositional =>
            match element:
                PlanType.List(leaf, depth) => return Ok(PlanType.List(leaf, depth + 1))
                _ => return Ok(PlanType.List(collection_leaf(element)?, 1))
        IncanCallableParamKind.RestKeyword => return Ok(PlanType.Dict(ListLeaf.Str, collection_leaf(element)?))


def numeric_newtype_iterator(nominals: list[NominalDeclaration], element: &RustType) -> Option[PlanType]:
    """Retain an integer newtype's exact owned generator leaf through the same canonical layout as its list items."""
    match element:
        RustType.Named(name) =>
            for index in range(len(nominals)):
                declaration = nominals[index]
                if declaration.name != str(name) or declaration.canonical.kind != SemanticSourceTargetKind.Newtype:
                    continue
                if len(declaration.type_parameters) != 0 or declaration.fields != ["0"] or len(declaration.field_types) != 1:
                    return None
                if declaration.field_identities != [declaration.canonical]:
                    return None
                match model_type(nominals, declaration.field_types[0]):
                    Ok(PlanType.Int) => return Some(PlanType.Generator(ListLeaf.Model(index, str(name)), 0))
                    _ => return None
        _ => pass
    return None


def hashed_leaf(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    ty: &RustType,
    intrinsics: list[EnumDeclaration],
) -> Result[ListLeaf, str]:
    """
    Admit an enum set element or dictionary key only when its retained layout hashes.

    A source enum must derive Eq and Hash. An `Option` or `Result` carrier hashes when every type argument does, as
    the standard carrier's own bounds require. A stdlib enum's derives belong to its compiled crate and stay refused.
    Models and primitives keep their existing hashed leaves.
    """
    match enum_type(enums, ty):
        Some(found) =>
            match found:
                PlanType.Enum(index, name) =>
                    declaration = enums[index]
                    if library_enum_item(declaration) != "":
                        return Err(f"unsupported Body IR stdlib enum hashed key {name}")
                    if "Eq" not in declaration.derives or "Hash" not in declaration.derives:
                        return Err(f"unsupported Body IR enum hashed key {name} without derived Eq and Hash")
                    return Ok(ListLeaf.Enum(index, name))
                _ => return Err(f"unsupported Body IR enum hashed key {ty}")
        None => pass
    match ty:
        RustType.Generic(base=base, args=arguments) =>
            if base == "Option" or base == "Result":
                for argument in arguments:
                    hashed_leaf(nominals, enums, argument, intrinsics)?
                for index in range(len(intrinsics)):
                    carrier = intrinsics[index]
                    if carrier.carrier == str(base) and carrier.source_type == str(ty):
                        return Ok(ListLeaf.Enum(len(enums) + index, carrier.name))
                return Err(f"unsupported Body IR unretained carrier hashed key {ty}")
        _ => pass
    return hashed_element(nominals, ty)


def layout_tuple_type(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    unions: list[RustType],
    elements: &list[RustType],
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Resolve each tuple element in the retained layout context, so a list or carrier element keeps its identity."""
    # Legacy emits a singleton literal as a parenthesized scalar; do not admit a different native layout.
    if len(elements) == 1:
        return Err("unsupported Body IR singleton Tuple: legacy scalar emission")
    mut types: list[TupleElement] = []
    for element in elements:
        resolved = native_source_type(nominals, enums, unions, element, intrinsics)?
        types.append(tuple_element(resolved, element)?)
    return Ok(PlanType.Tuple(types))


def zip_pair_type(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    unions: list[RustType],
    element: &RustType,
    intrinsics: list[EnumDeclaration],
) -> Option[PlanType]:
    """Admit a checked pair iterator, such as `zip`'s, through its element tuple's retained layout."""
    match element:
        RustType.Tuple(elements) => return pair_layout(nominals, enums, unions, elements, intrinsics)
        RustType.Generic(base=base, args=arguments) =>
            match collection_type(str(base)):
                Some(CollectionTypeId.Tuple) => return pair_layout(nominals, enums, unions, arguments, intrinsics)
                _ => return None
        _ => return None


def pair_layout(
    nominals: list[NominalDeclaration],
    enums: list[RustEnumDeclaration],
    unions: list[RustType],
    elements: &list[RustType],
    intrinsics: list[EnumDeclaration],
) -> Option[PlanType]:
    """Lay out both pair components in the retained context; any other arity or element keeps its refusal."""
    if len(elements) != 2:
        return None
    match layout_tuple_type(nominals, enums, unions, elements, intrinsics):
        Ok(PlanType.Tuple(pair)) => return Some(PlanType.ZipIterator(pair[0], pair[1]))
        _ => return None


pub def collection_leaf(ty: PlanType) -> Result[ListLeaf, str]:
    """
    Keep exact source nominal and intrinsic carrier identities alongside the existing primitive leaves.

    An owned list or dictionary held by another collection, such as a dictionary's list values, is a collection leaf.
    """
    match ty:
        PlanType.Int => return Ok(ListLeaf.Int)
        PlanType.Float => return Ok(ListLeaf.Float)
        PlanType.Bool => return Ok(ListLeaf.Bool)
        PlanType.String => return Ok(ListLeaf.Str)
        PlanType.FrozenStr => return Ok(ListLeaf.FrozenStr)
        PlanType.FrozenBytes => return Ok(ListLeaf.FrozenBytes)
        PlanType.U8 => return Ok(ListLeaf.U8)
        PlanType.Unit => return Ok(ListLeaf.Unit)
        PlanType.Decimal => return Ok(ListLeaf.Decimal)
        PlanType.Tuple(elements) => return Ok(ListLeaf.Tuple(elements))
        PlanType.Model(owner, name) => return Ok(ListLeaf.Model(owner, name))
        PlanType.Enum(owner, name) => return Ok(ListLeaf.Enum(owner, name))
        PlanType.FunctionPointer(signature) => return Ok(ListLeaf.FunctionPointer(signature))
        PlanType.List(leaf, depth) => return Ok(ListLeaf.List([leaf], depth))
        PlanType.Dict(key, value) => return Ok(ListLeaf.Dict([key, value]))
        _ => return Err("unsupported Body IR collection element representation")
