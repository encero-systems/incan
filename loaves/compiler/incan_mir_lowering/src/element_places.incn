"""
Recognize and type checked places that select a collection element or a copied text slice.

No native place projection can name such an element: the runtime reaches it through a call. A read of one therefore
materializes a copy, and code that only needs its type must compute it here instead of projecting the place.
"""

from rust::incan_semantics_core::body_ir import Place as RustPlace, PlaceElem
from pub::incan_mir_plan import PlanType, ListLeaf
from frame import Builder
from models import field_projection
from lists import list_shape, list_element, is_list
from collections import is_collection, collection_arguments
from model_lists import structural_prefix


pub def is_element_place(builder: Builder, source: &RustPlace) -> Result[bool, str]:
    """
    Whether a local place selects a collection element or text slice rather than storage a native place can name.

    Such a place is rooted at a list, dictionary or text value, or indexes a sequence after a structural field, payload or tuple
    element prefix. A global place keeps its static read path and is never an element place here.
    """
    if len(source.projection) == 0:
        return Ok(false)
    match source.local_id():
        None => return Ok(false)
        Some(local) =>
            root = builder.locals[int(local.index()) + 1 + builder.local_offset].ty
            if is_list(root) or is_collection(root) or root in [PlanType.String, PlanType.StringRef, PlanType.StringMutRef, PlanType.FrozenStr, PlanType.FrozenBytes]:
                return Ok(true)
            match root:
                PlanType.FrozenCollection(_name, _elements) => return Ok(true)
                _ => pass
    match structural_prefix(builder, source)?:
        Some((count, _through_tuple)) => return Ok(count < len(source.projection))
        None => return Ok(false)


pub def element_place_type(builder: Builder, source: &RustPlace) -> Result[PlanType, str]:
    """Follow an element place's projections to the type of the value its read materializes, emitting nothing."""
    return element_prefix_type(builder, source, len(source.projection))


pub def element_prefix_type(builder: Builder, source: &RustPlace, count: int) -> Result[PlanType, str]:
    """Resolve a checked element prefix once, without reading or borrowing its storage."""
    if count < 0 or count > len(source.projection):
        return Err("invalid Body IR element type prefix length")
    match source.local_id():
        None => return Err("unsupported Body IR global element place")
        Some(local) =>
            mut ty = builder.locals[int(local.index()) + 1 + builder.local_offset].ty
            # A receiver reference projects its model's fields.
            match ty:
                PlanType.ModelRef(owner, name) =>
                    ty = PlanType.Model(owner, name)
                PlanType.ModelMutRef(owner, name) =>
                    ty = PlanType.Model(owner, name)
                PlanType.TupleMutRef(elements) =>
                    ty = PlanType.Tuple(elements)
                PlanType.StringRef =>
                    ty = PlanType.String
                PlanType.StringMutRef =>
                    ty = PlanType.String
                _ => pass
            for slot in range(count):
                ty = projected_type(builder, ty, source.projection[slot])?
            return Ok(ty)


def projected_type(builder: Builder, ty: PlanType, projection: &PlaceElem) -> Result[PlanType, str]:
    """Select one step's type: a collection element, sequence slice, or structural field or tuple element."""
    match projection:
        PlaceElem.Index(_index) =>
            match ty:
                PlanType.FrozenCollection(name, elements) =>
                    if name == "FrozenDict" and len(elements) == 2:
                        return Ok(frozen_read_type(elements[1]))
                    if name == "FrozenList" and len(elements) == 1:
                        return Ok(frozen_read_type(elements[0]))
                    return Err("unsupported Body IR frozen collection index type")
                _ => pass
            match list_shape(ty):
                Some((leaf, depth)) => return Ok(list_element(leaf, depth))
                None => pass
            if is_collection(ty):
                return dictionary_value_type(ty)
        PlaceElem.Slice(start=_start, end=_end, step=_step) =>
            if ty in [PlanType.String, PlanType.FrozenStr]:
                return Ok(PlanType.String)
            if ty == PlanType.FrozenBytes:
                return Ok(PlanType.List(ListLeaf.U8, 1))
            match list_shape(ty):
                Some((leaf, depth)) => return Ok(PlanType.List(leaf, depth))
                None => return Err("unsupported Body IR slicing non-list")
        _ => pass
    return Ok(field_projection(builder.nominals, ty, projection, builder.enums, builder.unions, builder.intrinsics)?.ty)


def frozen_read_type(storage: PlanType) -> PlanType:
    """Observe ordinary static text and bytes as owned values; explicitly frozen wrappers keep their exact identity."""
    if storage == PlanType.StaticText:
        return PlanType.String
    if storage == PlanType.StaticBytes:
        return PlanType.List(ListLeaf.U8, 1)
    return storage


def dictionary_value_type(ty: PlanType) -> Result[PlanType, str]:
    """A dictionary index selects its value type; a set has no indexable elements."""
    arguments = collection_arguments(ty)
    if len(arguments) != 2:
        return Err("unsupported Body IR set indexing")
    return Ok(arguments[1])
