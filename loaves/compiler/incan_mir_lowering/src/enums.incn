"""Canonical normal-enum layouts and identity-checked native construction and pattern admission."""

from rust::incan_semantics_core import IncanType as RustType
from rust::incan_semantics_core::body_ir import (
    EnumDeclaration as RustEnumDeclaration,
    NominalDeclaration as RustNominalDeclaration,
    BodyIrModule as RustBodyIrModule,
    EnumVariantTarget,
    FieldlessEnumVariantTarget,
    Pattern as RustPattern,
    ArgumentBinding,
    OwnershipFact,
    Constant as RustConstant,
    ValueEnumBacking,
)
from pub::incan_mir_plan import EnumDeclaration, EnumVariant, PlanType, SourceSpan
from models import model_type as plain_model_type
from layout_types import native_source_type as retained_source_type
from decls import library_enum_item, serde_propagation, with_serde_derives


pub def enum_type(declarations: list[RustEnumDeclaration], ty: &RustType) -> Option[PlanType]:
    """Recognize a retained source enum before the model/scalar resolver runs."""
    match ty:
        RustType.Named(name) =>
            for index in range(len(declarations)):
                if declarations[index].name == str(name):
                    return Some(PlanType.Enum(index, str(name)))
        _ => pass
    return None


pub def variant_index(
    declarations: list[RustEnumDeclaration],
    target: &EnumVariantTarget,
) -> Result[tuple[int, int], str]:
    """Resolve construction by exact variant and owner identities; written owner aliases remain diagnostic spelling."""
    for owner in range(len(declarations)):
        declaration = declarations[owner]
        for slot in range(len(declaration.variants)):
            variant = declaration.variants[slot]
            if variant.canonical != target.variant_canonical:
                continue
            if target.enum_canonical != Some(declaration.canonical) or target.variant_name != variant.name:
                return Err("invalid Body IR enum constructor identity")
            validate_binding(target.binding, len(variant.fields))?
            return Ok((owner, slot))
    return Err("unsupported Body IR unretained enum constructor")


pub def unit_variant(
    declarations: list[RustEnumDeclaration],
    target: &FieldlessEnumVariantTarget,
) -> Result[tuple[int, int], str]:
    """Resolve the older fieldless constructor vocabulary against the same canonical layout."""
    for owner in range(len(declarations)):
        declaration = declarations[owner]
        if declaration.canonical != target.enum_canonical or declaration.direct_declaration_id != target.enum_declaration_id:
            continue
        for slot in range(len(declaration.variants)):
            variant = declaration.variants[slot]
            if variant.canonical == target.variant_canonical and variant.direct_declaration_id == target.variant_declaration_id and len(
                variant.fields,
            ) == 0:
                if declaration.name != target.enum_name or variant.name != target.variant_name:
                    return Err("invalid Body IR fieldless enum spelling")
                return Ok((owner, slot))
    return Err("unsupported Body IR unretained fieldless enum variant")


pub def pattern_variant(declaration: &RustEnumDeclaration, pattern: &RustPattern) -> Result[int, str]:
    """Resolve exact variant identities while allowing checked owner aliases; payload layout and ownership stay explicit."""
    match pattern:
        RustPattern.Wildcard => return Ok(-1)
        RustPattern.Enum(canonical=identity, name=_name, variant=name_variant, fields=fields) =>
            for slot in range(len(declaration.variants)):
                variant = declaration.variants[slot]
                if identity.clone() == Some(variant.canonical):
                    # The exact variant identity above proves the owner; reexports can rename its written path.
                    # Retain the member-spelling check without treating the source owner alias as a carrier name.
                    components = str(name_variant).split("::")
                    if components[len(components) - 1] != str(variant.name) or len(fields) != len(variant.fields):
                        return Err("invalid Body IR enum pattern layout")
                    validate_payload_patterns(fields)?
                    return Ok(slot)
        RustPattern.FieldlessEnumVariant(target) =>
            if target.enum_canonical != declaration.canonical or target.enum_declaration_id != declaration.direct_declaration_id:
                return Err("invalid Body IR fieldless enum pattern owner")
            for slot in range(len(declaration.variants)):
                variant = declaration.variants[slot]
                if target.variant_canonical == variant.canonical and target.variant_declaration_id == variant.direct_declaration_id and len(
                    variant.fields,
                ) == 0:
                    return Ok(slot)
        _ => pass
    return Err("unsupported Body IR enum pattern")


pub def validate_payload_patterns(patterns: &list[RustPattern]) -> Result[None, str]:
    """
    Admit payload patterns whose tests and bindings are represented: bindings with a known ownership, literals,
    nested carrier and tuple patterns, and alternations of those; anything else stays refused by name.
    """
    for pattern in patterns:
        validate_payload_pattern(pattern)?
    return Ok(None)


def validate_payload_pattern(pattern: &RustPattern) -> Result[None, str]:
    """Admit one payload pattern, recursing into the payloads a nested pattern names."""
    match pattern:
        RustPattern.Wildcard => pass
        RustPattern.Literal(_value) => pass
        RustPattern.FieldlessEnumVariant(_target) => pass
        RustPattern.Var(binding) =>
            # A moved payload binding reads like a cloned one: legacy matches a cloned enum by value. A payload its
            # arm changes in place is borrowed exclusively from the scrutinee instead.
            match binding.fact:
                OwnershipFact.Copy => pass
                OwnershipFact.Clone => pass
                OwnershipFact.Borrow => pass
                OwnershipFact.Move => pass
                OwnershipFact.MutBorrow => pass
                _ => return Err("unsupported Body IR enum payload binding ownership")
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=fields) =>
            return validate_payload_patterns(fields)
        RustPattern.Result(variant=_variant, fields=fields) => return validate_payload_patterns(fields)
        RustPattern.UnionMember(ty=_ty, fields=fields) => return validate_payload_patterns(fields)
        RustPattern.Tuple(items) => return validate_payload_patterns(items)
        RustPattern.Or(alternatives) => return validate_payload_patterns(alternatives)
        _ => return Err("unsupported Body IR nested enum payload pattern")
    return Ok(None)


pub def validate_binding(binding: &ArgumentBinding, count: int) -> Result[None, str]:
    """Require complete positional payload binding; spreads and omitted payload slots remain refused."""
    match binding:
        ArgumentBinding.Resolved(arguments=arguments, defaulted_slots=defaults) =>
            if len(defaults) != 0 or len(arguments) != count:
                return Err("unsupported Body IR incomplete enum payload binding")
            for index in range(count):
                if int(arguments[index].slot) != index:
                    return Err("unsupported Body IR reordered enum payload binding")
            return Ok(None)
        _ => return Err("unsupported Body IR unresolved enum payload binding")


pub def native_source_type(
    nominals: list[RustNominalDeclaration],
    declarations: list[RustEnumDeclaration],
    ty: &RustType,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Resolve retained standard carriers and source enums before delegating the existing scalar/model boundary."""
    for index in range(len(intrinsics)):
        if intrinsics[index].source_type == str(ty):
            return Ok(PlanType.Enum(len(declarations) + index, intrinsics[index].name))
    match enum_type(declarations, ty):
        Some(result) => return Ok(result)
        None => return plain_model_type(nominals, ty)


pub def lower_enum_declarations(
    module: &RustBodyIrModule,
    file: str,
    intrinsics: list[EnumDeclaration] = [],
) -> Result[list[EnumDeclaration], str]:
    """
    Copy checked source-order variants and derives into the native declaration plan.

    A source enum also takes the serde derives a serde-deriving declaration's fields require of it, as legacy
    propagates them. A value enum reached this way stays refused until propagated raw-value serialization has parity
    evidence; explicitly selected value-enum serde keeps its proven raw-value form.
    """
    reached = serde_propagation(module)?
    mut declarations: list[EnumDeclaration] = []
    for declaration in module.enum_declarations:
        mut variants: list[EnumVariant] = []
        for variant in declaration.variants:
            mut fields: list[PlanType] = []
            for ty in variant.fields:
                fields.append(
                    retained_source_type(module.nominal_declarations, module.enum_declarations, [], ty, intrinsics)?,
                )
            variants.append(EnumVariant(name=str(variant.name), fields=fields))
        # A stdlib enum is the SDK crate's own type; its derives and storage belong to that crate.
        item = library_enum_item(declaration)
        mut derives = with_serde_derives(declaration.derives, str(declaration.name), reached)
        if item != "":
            derives = []
        raw_kind, raw_values = value_enum_raw_values(module, declaration)?
        serialize, deserialize = reached
        adds_serialize = str(declaration.name) in serialize and "serde::Serialize" not in declaration.derives
        adds_deserialize = str(declaration.name) in deserialize and "serde::Deserialize" not in declaration.derives
        if raw_kind != "" and item == "" and (adds_serialize or adds_deserialize):
            return Err(f"unsupported Body IR serde derive propagation to value enum {declaration.name}")
        declarations.append(
            EnumDeclaration(
                name=str(declaration.name),
                public=declaration.public or item != "",
                variants=variants,
                derives=derives,
                span=SourceSpan(file=file, line=1, column=1),
                library_item=item,
                raw_kind=raw_kind,
                raw_values=raw_values,
            ),
        )
    return Ok(declarations)


def value_enum_raw_values(
    module: &RustBodyIrModule,
    declaration: &RustEnumDeclaration,
) -> Result[tuple[str, list[str]], str]:
    """A source value enum's backing and raw values in variant order; an SDK enum keeps its serialization in its crate."""
    if library_enum_item(declaration) != "":
        return Ok(("", []))
    for value_enum in module.value_enum_declarations:
        if value_enum.canonical != declaration.canonical:
            continue
        mut raw_values: list[str] = []
        for variant in value_enum.variants:
            match variant.raw_value:
                RustConstant.Str(text) => raw_values.append(str(text))
                RustConstant.Int(number) => raw_values.append(str(number))
                _ => return Err("invalid Body IR value enum raw value")
        match value_enum.backing:
            ValueEnumBacking.Str => return Ok(("str", raw_values))
            ValueEnumBacking.Int => return Ok(("int", raw_values))
    return Ok(("", []))


pub def enum_owner(ty: PlanType) -> Result[int, str]:
    """Require an enum-plan scrutinee; scalar, Option and Result matches stay named refusals."""
    match ty:
        PlanType.Enum(index, _name) => return Ok(index)
        _ => return Err("unsupported Body IR Match outside source enums")


pub def validate_unit_comparison(
    declarations: list[RustEnumDeclaration],
    left: PlanType,
    right: PlanType,
) -> Result[None, str]:
    """Authorize tag equality only for one retained fieldless owner with checked structural equality."""
    if left != right:
        return Err("unsupported Body IR mixed enum comparison")
    mut owner = -1
    match left:
        PlanType.Enum(index, _name) =>
            owner = index
        _ => return Err("unsupported Body IR nonenum comparison")
    if owner < 0 or owner >= len(declarations):
        return Err("unsupported Body IR non-source enum comparison")
    declaration = declarations[owner]
    if "PartialEq" not in declaration.derives:
        return Err("unsupported Body IR enum comparison without retained equality")
    for variant in declaration.variants:
        if len(variant.fields) != 0:
            return Err("unsupported Body IR payload enum comparison")
    return Ok(None)


pub def validate_unit_ordering(declarations: list[RustEnumDeclaration], ty: PlanType) -> Result[None, str]:
    """
    Authorize tag ordering only for a fieldless owner whose checked derives select a derived order.

    The checker retains an enum's written derives without their implications, so a derived `Ord` names the order
    as well as a derived `PartialOrd`.
    """
    match ty:
        PlanType.Enum(index, _name) =>
            if index < 0 or index >= len(declarations):
                return Err("unsupported Body IR non-source enum ordering")
            derives = declarations[index].derives
            if "PartialOrd" not in derives and "Ord" not in derives:
                return Err("unsupported Body IR enum ordering without a derived order")
            return Ok(None)
        _ => return Err("unsupported Body IR nonenum ordering")
