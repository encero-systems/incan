pub model SourceInputs:
    """Own source provenance, collected tests and the unit's ordinary integer overflow policy across the Rust boundary."""

    pub sources: list[str]
    pub files: list[str]
    pub tests: list[str]
    # Ordinary integer operations follow the selected unit's profile; explicit helpers keep their own policies.
    pub overflow_checks: bool = true
    # Producer-owned empty-read-set evidence; absence preserves ordinary lowering.
    pub scalar_products: Option[str] = None
    pub scalar_bodies: list[CompilerNodeId] = []


pub def unit_plan(
    modules: &list[BodyIrModule],
    inputs: SourceInputs,
    entry: int,
    kind: str,
    mut published: list[NativeUnionDeclaration],
) -> Result[Option[Plan], str]:
    """Borrow checked modules and consume their source inputs to lower a program, library or collected test unit."""
    return checked_unit_plan(
        modules,
        inputs.sources,
        inputs.files,
        entry,
        kind,
        inputs.tests,
        published,
        inputs.overflow_checks,
        inputs.scalar_products,
        inputs.scalar_bodies,
    )


pub def program_refusals(
    modules: &list[BodyIrModule],
    inputs: SourceInputs,
    entry: int,
    progress: bool,
    selection: str,
    kind: str,
) -> list[str]:
    """Consume source inputs for complete or exact-body refusal collection, optionally reporting its current body."""
    return checked_program_refusals(
        modules,
        inputs.sources,
        inputs.files,
        entry,
        progress,
        selection,
        kind,
        inputs.overflow_checks,
    )


pub def numeric_carrier(ty: PlanType) -> bool:
    """Share lowering's numeric classification with native owned-result validation without a second carrier list."""
    return checked_numeric_carrier(ty)
