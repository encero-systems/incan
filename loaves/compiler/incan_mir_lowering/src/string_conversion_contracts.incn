"""Consumer checks for one compilation's selected source conversion contract and exact raw chains."""

from rust::incan_semantics_core import (
    IncanType as RustType,
    IncanPrimitiveType as Primitive,
    SemanticSourceTargetKind,
    SymbolNamespace,
    SymbolOrigin,
    CompilerNodeId,
    CanonicalSymbolId,
    canonical_module_identity,
)
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    NominalDeclaration,
    NewtypeStringConversion,
    StringConversionContract,
    nominal_carrier_key,
    loaf_item_path,
)
from symbols import symbol_component


pub def validate_conversion_placement(modules: &list[BodyIrModule], entry: int) -> Result[None, str]:
    """Only this invocation's entry can supply a fresh import union; package and dependency fragments supply none."""
    for index in range(len(modules)):
        if index == entry:
            continue
        match modules[index].string_conversion_contract:
            StringConversionContract.Unselected => pass
            _ => return Err("unsupported Body IR misplaced string conversion contract")
    return Ok(None)


pub def conversion_trait(module: &BodyIrModule) -> Result[str, str]:
    """Absent and inactive states grant no conversion; a selected source trait keeps its encoded canonical identity."""
    match module.string_conversion_contract:
        StringConversionContract.Unselected => return Ok("")
        StringConversionContract.Inactive => return Ok("")
        StringConversionContract.Selected(selection) =>
            owner = selection.trait_identity
            method = selection.method_identity
            if (
                not is_conversion_trait(owner)
                or not is_conversion_method(method)
                or not method_belongs_to_owner(method, owner)
            ):
                return Err("unsupported Body IR string conversion contract identity")
            match owner.scope_discriminant:
                Some(_scope) => return Err("unsupported Body IR string conversion contract identity")
                None => pass
            match method.scope_discriminant:
                Some(_scope) => return Err("unsupported Body IR string conversion contract identity")
                None => pass
            match owner.origin:
                SymbolOrigin.Package(library=library, module_path=path) =>
                    if library != "incan_stdlib_core" or path != ["traits", "convert"]:
                        return Err("unsupported Body IR string conversion contract identity")
                    match loaf_item_path(owner):
                        Some(item) => return Ok(str(item))
                        None => return Err("unsupported Body IR string conversion contract item")
                _ => return Err("unsupported Body IR string conversion contract identity")


def is_conversion_trait(identity: &CanonicalSymbolId) -> bool:
    """Require the selected lexical TryFrom trait rather than a same-name value or member."""
    return identity.kind == SemanticSourceTargetKind.Trait and identity.namespace == SymbolNamespace.OrdinaryLexical and identity.declaration_name == "TryFrom"


def is_conversion_method(identity: &CanonicalSymbolId) -> bool:
    """Require the selected member method, not a free function or differently named declaration."""
    return identity.kind == SemanticSourceTargetKind.Method and identity.namespace == SymbolNamespace.Member and identity.declaration_name == "try_from"


def method_belongs_to_owner(method: &CanonicalSymbolId, owner: &CanonicalSymbolId) -> bool:
    """Keep the method's origin and complete source span inside the selected trait's declaration."""
    if method.origin != owner.origin:
        return false
    return method.declaration_span.start >= owner.declaration_span.start and method.declaration_span.end <= owner.declaration_span.end


pub def conversion_name(module: &BodyIrModule, declaration: &NominalDeclaration) -> Result[str, str]:
    """A producer-attested automatic candidate becomes executable only under the selected invocation contract."""
    if conversion_trait(module)? == "":
        return Ok("")
    match declaration.canonical.origin:
        SymbolOrigin.Module(_path) => pass
        _ => return Ok("")
    match declaration.newtype_string_conversion:
        NewtypeStringConversion.Unselected => return Ok("")
        NewtypeStringConversion.Automatic =>
            _ = conversion_chain(module, declaration, [])?
            return Ok("__incan_string_try_from_" + symbol_component(str(declaration.name)))


pub def conversion_chain(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    ancestors: list[str],
) -> Result[None, str]:
    """Check each exact named underlying edge before scheduling roots; an unselected inner cannot be overwritten."""
    if declaration.name in ancestors:
        return Err("unsupported Body IR automatic string conversion cycle")
    _ = raw_conversion_owner(declaration)?
    match declaration.newtype_string_conversion:
        NewtypeStringConversion.Unselected =>
            return Err("unsupported Body IR automatic string conversion underlying selection")
        NewtypeStringConversion.Automatic => pass
    underlying = declaration.field_types[0]
    match underlying:
        RustType.Primitive(Primitive.Int) => return Ok(None)
        RustType.Primitive(Primitive.Str) => return Ok(None)
        RustType.Named(name) =>
            identity = underlying_identity(declaration, name)
            match identity:
                None => return Err("unsupported Body IR automatic string conversion underlying identity")
                Some(canonical) =>
                    if canonical_module_identity(canonical) != canonical_module_identity(declaration.canonical):
                        return Err("unsupported Body IR automatic string conversion nonlocal underlying")
                    mut selected: Option[NominalDeclaration] = None
                    for candidate in module.nominal_declarations:
                        # Compare owned identity values across the foreign declaration boundary.
                        if candidate.canonical == canonical.clone():
                            match selected:
                                Some(_previous) =>
                                    return Err("unsupported Body IR automatic string conversion ambiguous underlying")
                                None => pass
                            selected = Some(candidate.clone())
                    match selected:
                        None => return Err("unsupported Body IR automatic string conversion missing underlying")
                        Some(inner) =>
                            if name != canonical.declaration_name and name != inner.carrier_name():
                                return Err("unsupported Body IR automatic string conversion underlying identity")
                            mut seen = ancestors
                            seen.append(str(declaration.name))
                            return conversion_chain(module, inner, seen)
        _ => return Err("unsupported Body IR automatic string conversion primitive")


def underlying_identity(declaration: &NominalDeclaration, name: str) -> Option[CanonicalSymbolId]:
    """Borrow the exact retained key for native lookup, copying only the selected canonical identity."""
    match declaration.named_type_identities.get(name):
        Some(identity) => return Some(identity.clone())
        None => return None


def conversion_owner_name(declaration: &NominalDeclaration) -> bool:
    """Accept a source leaf or its exact retained carrier, never carrier_name's unproven spelling fallback."""
    if declaration.name == declaration.canonical.declaration_name:
        return true
    match nominal_carrier_key(declaration.canonical):
        None => return false
        Some(key) =>
            if declaration.name != key:
                return false
            match underlying_identity(declaration, key):
                None => return false
                Some(identity) => return identity == declaration.canonical.clone()


def raw_conversion_layout(declaration: &NominalDeclaration) -> bool:
    """Require one public raw field with its exact owner identity, no binders, and no declared defaults."""
    if len(declaration.type_parameters) != 0 or declaration.type_parameter_count != 0:
        return false
    if (
        declaration.fields != ["0"]
        or declaration.field_identities != [declaration.canonical]
        or len(declaration.field_types) != 1
    ):
        return false
    return declaration.field_public == [true] and not declaration.has_field_defaults and len(
        declaration.method_partial_defaults,
    ) == 0


def raw_conversion_owner(declaration: &NominalDeclaration) -> Result[None, str]:
    """Validate the canonical layout before or after project assembly gives it its exact retained carrier name."""
    owner = declaration.canonical
    if (
        owner.kind != SemanticSourceTargetKind.Newtype
        or owner.namespace != SymbolNamespace.OrdinaryLexical
        or not conversion_owner_name(declaration)
    ):
        return Err("unsupported Body IR automatic string conversion owner")
    if not raw_conversion_layout(declaration):
        return Err("unsupported Body IR automatic string conversion owner")
    match owner.origin:
        SymbolOrigin.Module(_path) => pass
        _ => return Err("unsupported Body IR automatic string conversion owner")
    match owner.scope_discriminant:
        Some(_scope) => return Err("unsupported Body IR automatic string conversion owner")
        None => pass
    match declaration.field_default_body:
        Some(_body) => return Err("unsupported Body IR automatic string conversion owner")
        None => pass
    for alias in declaration.field_aliases:
        match alias:
            Some(_name) => return Err("unsupported Body IR automatic string conversion owner")
            None => pass
    match canonical_module_identity(owner):
        None => return Err("unsupported Body IR automatic string conversion owner")
        Some(module) =>
            expected = CompilerNodeId.declaration_at(module, owner.declaration_span)
            if declaration.direct_declaration_id != expected:
                return Err("unsupported Body IR automatic string conversion owner")
    return Ok(None)
