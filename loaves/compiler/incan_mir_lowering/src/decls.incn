"""Runtime layouts of checked source-local declarations; erased aliases have no storage."""

from rust::incan_semantics_core import IncanType as RustType, SemanticSourceTargetKind
from rust::incan_lang::lang::types::ownership import from_str as ownership_mode, OwnershipMode
from rust::std::collections import BTreeMap, BTreeSet
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    NominalDeclaration,
    StaticDeclaration,
    GlobalPlace,
    EnumDeclaration as RustEnumDeclaration,
    LifecycleMetadata as CheckedLifecycle,
)
from pub::incan_mir_plan import (
    EnumDeclaration,
    ModelDeclaration,
    FieldMetadata,
    FieldLifecycle,
    Parameter,
    SourceSpan,
    PlanType,
    ListLeaf,
)
from unions import collect_unions
from layout_types import stored_field_type
from native_type_identity import ConstructorIndex
from checked_json_contracts import checked_deserialize_name
from comparison_methods import comparison_functions
from fallible_methods import fallible_methods
from iterator_methods import iterator_methods
from callable_methods import callable_methods
from native_arguments import native_argument_names
from table_views import borrowed_at, borrowed_table
from native_traits import native_trait_adoptions
from marker_traits import validate_marker_traits
from nominal_instances import NominalInstance
from library_model_arguments import library_model_arguments, local_generic_item
from string_conversion_contracts import conversion_name, conversion_trait
from symbols import model_symbol
from reflection_carriers import is_field_metadata_carrier
from stored_types import stored_type
from pub::incan_mir_plan import source_span as plan_span


pub def static_slot(declarations: &list[StaticDeclaration], value: &GlobalPlace) -> Result[int, str]:
    """Resolve global storage only by retained canonical identity and exact checked carrier."""
    mut slot = 0
    for declaration in declarations:
        if declaration.canonical == value.identity and declaration.ty == value.ty:
            return Ok(slot)
        slot += 1
    return Err(f"unsupported Body IR unretained global storage `{value.identity.declaration_name}`")


pub def static_accessors(ty: PlanType) -> Result[tuple[str, str], str]:
    """
    Name persistent primitive and set cells after checked carrier admission.

    Literal lists and dictionaries use native guarded cells; the remaining carriers use typed runtime cells.
    """
    match ty:
        PlanType.Set(leaf) =>
            if leaf == ListLeaf.Int:
                return Ok(("incan_native_runtime::read_static_int_set", "incan_native_runtime::write_static_int_set"))
            return Err("unsupported Body IR static set carrier")
        PlanType.String =>
            return Ok(("incan_native_runtime::read_static_text", "incan_native_runtime::write_static_text"))
        PlanType.Int => return Ok(("incan_native_runtime::read_static_int", "incan_native_runtime::write_static_int"))
        PlanType.Float =>
            return Ok(("incan_native_runtime::read_static_float", "incan_native_runtime::write_static_float"))
        PlanType.Bool =>
            return Ok(("incan_native_runtime::read_static_bool", "incan_native_runtime::write_static_bool"))
        _ => return Err("unsupported Body IR static carrier")


pub def publish_local_layouts(mut models: list[ModelDeclaration], mut enums: list[EnumDeclaration]) -> None:
    """
    Expose canonical native ABI items for a compiled Loaf; its checked manifest retains source visibility.

    Private layouts can appear in compiled callable signatures or governed defaults. Linked layouts already belong
    to their selected artifact and keep its visibility.
    """
    for index in range(len(models)):
        if models[index].library_item == "":
            models[index].public = true
    for index in range(len(enums)):
        if enums[index].library_item == "":
            enums[index].public = true


pub def lower_model_declarations(
    constructors: &ConstructorIndex,
    module: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    publish_generics: bool = false,
    start: int = 0,
) -> Result[list[ModelDeclaration], str]:
    """
    Retain checked field layout and derives for admitted plain model, class, and newtype declarations.

    Instance selection borrows the retained inventory; only the resulting native declaration plan is owned here.
    `start` lets a resumed unit append layouts for declarations absent from its preserved plan.

    Semantic construction derives stay in checked Body IR rather than becoming Rust derives. `Default` is built at
    each `default()` call from declared field defaults, and `Validate` is executed by its retained generated constructor.
    """
    mut unions = collect_unions(module)
    reached = serde_propagation(module)?
    mut models: list[ModelDeclaration] = []
    comparisons = comparison_functions(constructors, module, intrinsics)?
    # Foreign storage names are collected once; each owner then checks membership instead of rescanning the module.
    native_names = native_argument_names(module)?
    mut view_lifetimes = ViewLifetimeLayout.start(module.nominal_declarations, module.enum_declarations)
    for owner in range(start, len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, owner)
        mut item = library_item(declaration)
        if publish_generics and item == "" and len(declaration.type_parameters) != 0:
            item = local_generic_item(declaration, nominal_instances)?
        mut library_arguments: list[PlanType] = []
        mut checked_deserialize = ""
        mut string_conversion_root = ""
        mut string_conversion_trait = ""
        if item == "" and declaration.canonical.kind == SemanticSourceTargetKind.Newtype:
            checked_deserialize = checked_deserialize_name(declaration)?
            string_conversion_root = conversion_name(module, declaration)?
            if string_conversion_root != "":
                string_conversion_trait = conversion_trait(module)?
        mut derives: list[str] = []
        for derive in declaration.derives:
            if (
                derive not in ["Default", "Validate"]
                and not (len(comparisons[owner]) != 0 and derive in ["PartialEq", "Eq", "PartialOrd", "Ord"])
            ):
                derives.append(derive)
        mut fields: list[Parameter] = []
        mut unavailable_fields: list[int] = []
        mut field_public = declaration.field_public
        mut serde_names: list[str] = []
        if item != "":
            library_arguments = library_model_arguments(
                constructors,
                module,
                declaration,
                nominal_instances,
                unions,
                intrinsics,
            )?
            fields, unavailable_fields = library_fields(constructors, module, declaration, file, unions, intrinsics)
            # Native Copy is a checked capability, verified again against rustc rather than derived on this alias.
            derives = []
            if "Copy" in declaration.derives:
                derives.append("Copy")
        else:
            # Only a plain newtype takes a propagated serde derive; another reached nominal keeps its own derives.
            if len(declaration.fields) == 1 and str(declaration.fields[0]) == "0":
                derives = with_serde_derives(derives, str(declaration.name), reached)
            serde_names = serde_field_names(declaration)
            for slot in range(len(declaration.fields)):
                mut ty = PlanType.Unit
                match stored_field_type(
                    constructors,
                    borrowed_table(module.nominal_declarations),
                    borrowed_table(module.enum_declarations),
                    unions,
                    declaration,
                    slot,
                    intrinsics,
                ):
                    Ok(resolved) => ty = resolved
                    Err(reason) => return Err(f"{reason} in model {declaration.name} field {declaration.fields[slot]}")
                fields.append(
                    Parameter(name=str(declaration.fields[slot]), ty=ty, span=plan_span(file=file, line=1, column=1)),
                )
        callable_name, callable_signature = callable_methods(constructors, module, owner, native_names, intrinsics)?
        if item == "":
            validate_marker_traits(declaration)?
        mut view_lifetime_count = 0
        if item == "":
            view_lifetime_count = view_lifetimes.declaration(
                declaration,
                module.nominal_declarations,
                module.enum_declarations,
            )
        models.append(
            ModelDeclaration(
                name=model_symbol(str(declaration.name)),
                public=declaration.public or item != "",
                fields=fields,
                field_public=field_public,
                derives=derives,
                source_name=str(declaration.canonical.declaration_name),
                span=plan_span(file=file, line=1, column=1),
                view_lifetime_count=view_lifetime_count,
                library_item=item,
                library_type_arguments=library_arguments,
                field_serde_names=serde_names,
                checked_deserialize=checked_deserialize,
                reflection_metadata=planned_field_metadata(module, constructors, declaration),
                field_metadata_carrier=is_field_metadata_carrier(declaration),
                comparison_methods=comparisons[owner],
                fallible_iterator=fallible_methods(constructors, module, owner, native_names, intrinsics)?,
                iterator=iterator_methods(constructors, module, owner, native_names, intrinsics)?,
                callable_method=callable_name,
                callable_signature=callable_signature,
                string_conversion_root=string_conversion_root,
                string_conversion_trait=string_conversion_trait,
                native_trait_adoptions=native_trait_adoptions(module, owner)?,
                unavailable_native_fields=unavailable_fields,
            ),
        )
    return Ok(models)


model ViewLifetimeCount:
    """One measured layout and whether no declaration cycle truncated it."""

    count: int
    complete: bool


pub class ViewLifetimeLayout:
    """Index view-bearing nominal layouts, then memoize their ordered native lifetime counts."""

    cached: BTreeMap[str, int]
    active: list[str]
    dependents: BTreeMap[str, list[str]]
    view_types: BTreeSet[str]
    pending: list[str]

    @staticmethod
    pub def start(
        declarations: &list[NominalDeclaration], enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeLayout:
        """Index direct borrow storage and propagate it once through the reverse nominal dependency graph."""
        cached: BTreeMap[str, int] = BTreeMap.new()
        dependents: BTreeMap[str, list[str]] = BTreeMap.new()
        view_types: BTreeSet[str] = BTreeSet.new()
        mut layout = ViewLifetimeLayout(
            cached=cached,
            active=[],
            dependents=dependents,
            view_types=view_types,
            pending=[],
        )
        layout.index_declarations(declarations, enums)
        layout.propagate_view_types()
        return layout

    def index_declarations(
        mut self,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> None:
        """Record each stored nominal dependency and every owner with a direct reference slot."""
        for declaration in declarations:
            owner = str(declaration.name)
            for field in declaration.field_types:
                self.index_type(owner, field)
        for declaration in enums:
            owner = declaration.carrier_name()
            for variant in declaration.variants:
                for field in variant.fields:
                    self.index_type(owner, field)

    def index_type(mut self, owner: str, ty: &RustType) -> None:
        """Index direct references and transitive nominal dependencies using the storage rules of `type_lifetimes`."""
        match ty:
            RustType.Ref(inner) =>
                self.seed(owner)
                self.index_type(owner, inner)
            RustType.RefMut(inner) =>
                self.seed(owner)
                self.index_type(owner, inner)
            RustType.Named(name) => self.record_dependency(str(name), owner)
            RustType.Generic(base=base, args=arguments) =>
                if base in ["FrozenList", "FrozenSet", "FrozenDict", "$FrozenList", "$FrozenSet", "$FrozenDict"]:
                    return
                match ownership_mode(base):
                    Some(OwnershipMode.Borrowed | OwnershipMode.BorrowedMut | OwnershipMode.Reference) =>
                        self.seed(owner)
                    Some(OwnershipMode.Owned) => pass
                    None => self.record_dependency(str(base), owner)
                for argument in arguments:
                    self.index_type(owner, argument)
            RustType.Tuple(elements) =>
                for element in elements:
                    self.index_type(owner, element)
            RustType.NativeArray(element=element, length=_length) => self.index_type(owner, element)
            _ => pass

    def seed(mut self, owner: str) -> None:
        """Queue one nominal that stores a direct source reference, retaining first-discovery order."""
        if owner not in self.pending:
            self.pending.append(owner)

    def record_dependency(mut self, dependency: str, owner: str) -> None:
        """Record that `owner` becomes a view type whenever `dependency` does."""
        owners = self.dependents.entry(dependency).or_insert([])
        if not owners.contains(owner):
            owners.push(owner)

    def propagate_view_types(mut self) -> None:
        """Compute the least fixed point of nominal layouts that directly or transitively retain a borrow."""
        mut cursor = 0
        while cursor < len(self.pending):
            selected = str(self.pending[cursor])
            cursor += 1
            if self.view_types.contains(selected):
                continue
            _ = self.view_types.insert(selected)
            mut owners: list[str] = []
            match self.dependents.get(selected):
                Some(dependents) =>
                    for owner in dependents:
                        owners.append(str(owner))
                None => pass
            for owner in owners:
                if not self.view_types.contains(owner):
                    self.pending.append(owner)

    pub def declaration(
        mut self,
        declaration: &NominalDeclaration,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> int:
        """Count physical references retained by one source layout; callable fields bind their own signatures."""
        return self.named(str(declaration.name), declarations, enums).count

    pub def enum_declaration(
        mut self,
        declaration: &RustEnumDeclaration,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> int:
        """Count physical references retained by an enum's payloads in source variant order."""
        return self.named(declaration.carrier_name(), declarations, enums).count

    def named(
        mut self,
        name: str,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeCount:
        """Resolve one nominal once when acyclic; a cycle is bounded without caching its path-dependent partial count."""
        match self.cached.get(name):
            Some(count) => return ViewLifetimeCount(count=int(count.clone()), complete=true)
            None => pass
        if not self.view_types.contains(name):
            _ = self.cached.insert(name, 0)
            return ViewLifetimeCount(count=0, complete=true)
        if name in self.active:
            return ViewLifetimeCount(count=0, complete=false)

        self.active.append(name)
        mut measured = ViewLifetimeCount(count=0, complete=true)
        mut found = false
        for declaration in declarations:
            if str(declaration.name) == name:
                measured = self.nominal_fields(declaration, declarations, enums)
                found = true
                break
        if not found:
            for declaration in enums:
                if declaration.carrier_name() == name:
                    measured = self.enum_fields(declaration, declarations, enums)
                    found = true
                    break
        _ = self.active.pop()
        if found and measured.complete:
            _ = self.cached.insert(name, measured.count)
        return measured

    def nominal_fields(
        mut self,
        declaration: &NominalDeclaration,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeCount:
        """Measure stored nominal fields once in checked declaration order."""
        mut measured = ViewLifetimeCount(count=0, complete=true)
        for field in declaration.field_types:
            measured = combined_view_lifetimes(measured, self.type_lifetimes(field, declarations, enums))
        return measured

    def enum_fields(
        mut self,
        declaration: &RustEnumDeclaration,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeCount:
        """Measure every enum payload in source variant order."""
        mut measured = ViewLifetimeCount(count=0, complete=true)
        for variant in declaration.variants:
            for field in variant.fields:
                measured = combined_view_lifetimes(measured, self.type_lifetimes(field, declarations, enums))
        return measured

    def type_lifetimes(
        mut self,
        ty: &RustType,
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeCount:
        """Count reference slots through structural fields and source nominal view layouts."""
        match ty:
            RustType.Ref(inner) =>
                nested = self.type_lifetimes(inner, declarations, enums)
                return ViewLifetimeCount(count=1 + nested.count, complete=nested.complete)
            RustType.RefMut(inner) =>
                nested = self.type_lifetimes(inner, declarations, enums)
                return ViewLifetimeCount(count=1 + nested.count, complete=nested.complete)
            RustType.Named(name) => return self.named(str(name), declarations, enums)
            RustType.Generic(base=base, args=arguments) =>
                arguments_count = self.element_lifetimes(arguments, declarations, enums)
                match ownership_mode(base):
                    Some(OwnershipMode.Borrowed | OwnershipMode.BorrowedMut | OwnershipMode.Reference) =>
                        return ViewLifetimeCount(
                            count=1 + arguments_count.count,
                            complete=arguments_count.complete,
                        )
                    Some(OwnershipMode.Owned) => return arguments_count
                    None => pass
                if base in ["FrozenList", "FrozenSet", "FrozenDict", "$FrozenList", "$FrozenSet", "$FrozenDict"]:
                    return ViewLifetimeCount(count=0, complete=true)
                return combined_view_lifetimes(
                    self.named(str(base), declarations, enums),
                    arguments_count,
                )
            RustType.Tuple(elements) => return self.element_lifetimes(elements, declarations, enums)
            RustType.NativeArray(element=element, length=_length) =>
                return self.type_lifetimes(element, declarations, enums)
            _ => return ViewLifetimeCount(count=0, complete=true)

    def element_lifetimes(
        mut self,
        elements: &list[RustType],
        declarations: &list[NominalDeclaration],
        enums: &list[RustEnumDeclaration],
    ) -> ViewLifetimeCount:
        """Sum structural reference slots without copying retained field types."""
        mut measured = ViewLifetimeCount(count=0, complete=true)
        for element in elements:
            measured = combined_view_lifetimes(measured, self.type_lifetimes(element, declarations, enums))
        return measured


def combined_view_lifetimes(left: ViewLifetimeCount, right: ViewLifetimeCount) -> ViewLifetimeCount:
    """Combine two structural measurements while retaining whether either crossed a declaration cycle."""
    return ViewLifetimeCount(count=left.count + right.count, complete=left.complete and right.complete)


def lifecycle_text(value: &Option[str]) -> Option[str]:
    """Copy a checked optional label without treating empty text as absence."""
    match value:
        Some(text) => return Some(str(text))
        None => return None


def planned_lifecycle(value: &Option[CheckedLifecycle]) -> Option[FieldLifecycle]:
    """Keep the five source-checked labels as ordinary Incan plan data."""
    match value:
        None => return None
        Some(labels) =>
            return Some(FieldLifecycle(
                since=lifecycle_text(labels.since),
                retire_in=lifecycle_text(labels.retire_in),
                message=lifecycle_text(labels.message),
                by=lifecycle_text(labels.by),
                issue=lifecycle_text(labels.issue),
            ))


def planned_field_metadata(
    module: &BodyIrModule, constructors: &ConstructorIndex, declaration: &NominalDeclaration,
) -> Option[list[FieldMetadata]]:
    """Retain checked visibility and defaults; derive stored selectors from each original typed field slot."""
    match declaration.reflection_metadata:
        None => return None
        Some(fields) =>
            mut result: list[FieldMetadata] = []
            for field in fields:
                mut stored: Option[str] = None
                if int(field.position) < len(declaration.field_types):
                    stored = stored_type(module, constructors, declaration.field_types[int(field.position)])
                mut alias: Option[str] = None
                mut description: Option[str] = None
                mut record_identity: list[int] = []
                mut renamed_from: list[str] = []
                for byte in field.record_identity:
                    record_identity.append(int(byte))
                for earlier in field.renamed_from:
                    renamed_from.append(str(earlier))
                match field.alias:
                    Some(value) => alias = Some(str(value))
                    None => pass
                match field.description:
                    Some(value) => description = Some(str(value))
                    None => pass
                result.append(
                    FieldMetadata(
                        name=str(field.name),
                        record_identity=record_identity,
                        record_canonical=field.record_canonical,
                        renamed_from=renamed_from,
                        renamed_from_lifecycle=planned_lifecycle(field.renamed_from_lifecycle),
                        position=int(field.position),
                        default_is_empty=field.default_is_empty,
                        stored_type=stored,
                        alias=alias,
                        description=description,
                        type_name=str(field.type_name),
                        has_default=field.has_default,
                    ),
                )
            return Some(result)


pub def serde_propagation(module: &BodyIrModule) -> Result[tuple[list[str], list[str]], str]:
    """
    Name the nominals a serde-deriving declaration's fields hold, as legacy's serde derive propagation collects them:
    the names reached under Serialize, then those reached under Deserialize.

    Legacy adds a model's serde derives to each source enum and plain newtype its field types name, so the generated
    derive compiles without annotating every nested type. Field types are walked through lists, sets, dictionaries,
    tuples, `Option` and `Result` carriers and other type arguments, one level deep: a reached model's own fields
    propagate nothing. Legacy propagates within one module's declarations, so a reached declaration of another module
    takes nothing. A stdlib layout's derives belong to its crate, so it neither propagates nor receives a derive.
    """
    mut serialize: list[str] = []
    mut deserialize: list[str] = []
    for declaration_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, declaration_position)
        if library_item(declaration) != "":
            continue
        if "serde::Serialize" not in declaration.derives and "serde::Deserialize" not in declaration.derives:
            continue
        mut reached: list[str] = []
        for ty in declaration.field_types:
            reached = reached_names(ty, reached)?
        for name in reached:
            if not declared_beside(module, name, declaration):
                continue
            if "serde::Serialize" in declaration.derives and name not in serialize:
                serialize.append(name)
            if "serde::Deserialize" in declaration.derives and name not in deserialize:
                deserialize.append(name)
    return Ok((serialize, deserialize))


def declared_beside(module: &BodyIrModule, name: str, source: &NominalDeclaration) -> bool:
    """Whether `name` is a source enum or nominal declared in the same module as `source`."""
    for declaration_position in range(len(module.enum_declarations)):
        declaration = borrowed_at(module.enum_declarations, declaration_position)
        if str(declaration.name) == name:
            return declaration.canonical.origin == source.canonical.origin
    for declaration_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, declaration_position)
        if str(declaration.name) == name:
            return declaration.canonical.origin == source.canonical.origin
    return false


def reached_names(ty: &RustType, names: list[str]) -> Result[list[str], str]:
    """
    Add the nominal names one field type holds to `names`.

    A union field is refused: the direct route's union layout carries no serde derive.
    """
    mut result = names
    match ty:
        RustType.NativeBuiltin(_builtin) => return Err("unsupported Body IR serde of a builtin runtime carrier")
        RustType.Named(name) =>
            if str(name) not in result:
                result.append(str(name))
        RustType.Generic(base=_base, args=arguments) =>
            if ty.is_union():
                return Err("unsupported Body IR serde derive propagation through a union field")
            for argument in arguments:
                result = reached_names(argument, result)?
        RustType.Tuple(elements) =>
            for element in elements:
                result = reached_names(element, result)?
        RustType.Ref(inner) => result = reached_names(inner, result)?
        RustType.RefMut(inner) => result = reached_names(inner, result)?
        _ => pass
    return Ok(result)


pub def with_serde_derives(derives: list[str], name: str, reached: tuple[list[str], list[str]]) -> list[str]:
    """Append each serde derive a serde-deriving declaration's fields require of `name`, unless it is already derived."""
    serialize, deserialize = reached
    mut result = derives
    if name in serialize and "serde::Serialize" not in result:
        result.append("serde::Serialize")
    if name in deserialize and "serde::Deserialize" not in result:
        result.append("serde::Deserialize")
    return result


def library_fields(
    constructors: &ConstructorIndex,
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    file: str,
    mut unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> tuple[list[Parameter], list[int]]:
    """
    A native layout's fields in their native slots, and the slots whose type the plan cannot carry.

    An uncarried field keeps its name and slot with a unit placeholder type. The placeholder never authorizes a read,
    write or construction: the driver's plan validation refuses a projection into that slot and an aggregate of the
    layout, while the layout's other fields stay usable. Its values still move and drop as the native crate's own type.

    Reuse the enclosing layout pass's union inventory so every field reads that pass's exact slot order.
    """
    mut fields: list[Parameter] = []
    mut unavailable: list[int] = []
    for slot in range(len(declaration.fields)):
        match stored_field_type(
            constructors,
            borrowed_table(module.nominal_declarations),
            borrowed_table(module.enum_declarations),
            unions,
            declaration,
            slot,
            intrinsics,
        ):
            Ok(ty) =>
                fields.append(
                    Parameter(name=str(declaration.fields[slot]), ty=ty, span=plan_span(file=file, line=1, column=1)),
                )
            Err(_reason) =>
                unavailable.append(slot)
                fields.append(
                    Parameter(
                        name=str(declaration.fields[slot]),
                        ty=PlanType.Unit,
                        span=plan_span(file=file, line=1, column=1),
                    ),
                )
    return (fields, unavailable)


pub def library_item(declaration: &NominalDeclaration) -> str:
    """Name the compiled item that owns a layout a linked Loaf declares, or nothing for a layout declared here."""
    return str(declaration.native_item)


pub def library_enum_item(declaration: &RustEnumDeclaration) -> str:
    """Name the compiled item that owns an enum a linked Loaf declares, or nothing for an enum declared here."""
    return str(declaration.native_item)


def serde_field_names(declaration: &NominalDeclaration) -> list[str]:
    """
    Name each aliased field by its alias in the declaration's serde form, as legacy's `#[serde(rename)]` does.

    Legacy renames only when the declaration derives serde; without any alias every field keeps its name.
    """
    mut names: list[str] = []
    if "serde::Serialize" not in declaration.derives and "serde::Deserialize" not in declaration.derives:
        return names
    mut renamed = false
    for alias in declaration.field_aliases:
        match alias:
            Some(name) =>
                names.append(str(name))
                renamed = true
            None => names.append("")
    if not renamed:
        return []
    return names
