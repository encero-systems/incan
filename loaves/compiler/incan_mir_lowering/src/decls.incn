"""Runtime layouts of checked source-local declarations; erased aliases have no storage."""

from rust::incan_semantics_core import SymbolOrigin
from rust::incan_semantics_core::body_ir import BodyIrModule, NominalDeclaration, StaticDeclaration, GlobalPlace
from pub::incan_mir_plan import EnumDeclaration, ModelDeclaration, Parameter, SourceSpan, PlanType, ListLeaf
from unions import native_source_type, collect_unions


pub def static_slot(declarations: list[StaticDeclaration], value: &GlobalPlace) -> Result[int, str]:
    """Resolve global storage only by retained canonical identity and exact checked carrier."""
    for slot in range(len(declarations)):
        declaration = declarations[slot]
        if declaration.canonical == value.identity and declaration.ty == value.ty:
            return Ok(slot)
    return Err(f"unsupported Body IR unretained global storage `{value.identity.declaration_name}`")


pub def static_accessors(ty: PlanType) -> Result[tuple[str, str], str]:
    """Name persistent primitive and flat-list cells after checked carrier admission."""
    match ty:
        PlanType.List(leaf, depth) =>
            if depth != 1:
                return Err("unsupported Body IR nested static list carrier")
            return static_list_accessors(leaf)
        PlanType.String =>
            return Ok(("incan_native_runtime::read_static_text", "incan_native_runtime::write_static_text"))
        PlanType.Int => return Ok(("incan_native_runtime::read_static_int", "incan_native_runtime::write_static_int"))
        PlanType.Float =>
            return Ok(("incan_native_runtime::read_static_float", "incan_native_runtime::write_static_float"))
        PlanType.Bool =>
            return Ok(("incan_native_runtime::read_static_bool", "incan_native_runtime::write_static_bool"))
        _ => return Err("unsupported Body IR static carrier")


def static_list_accessors(leaf: ListLeaf) -> Result[tuple[str, str], str]:
    """Choose typed runtime list cells without erasing their checked element representation."""
    mut name = ""
    match leaf:
        ListLeaf.Int =>
            name = "int"
        ListLeaf.Float =>
            name = "float"
        ListLeaf.Bool =>
            name = "bool"
        ListLeaf.Str =>
            name = "text"
        _ => return Err("unsupported Body IR static list element")
    return Ok((f"incan_native_runtime::read_static_{name}_list", f"incan_native_runtime::write_static_{name}_list"))


pub def lower_model_declarations(module: &BodyIrModule, file: str, intrinsics: list[EnumDeclaration] = []) -> Result[list[ModelDeclaration], str]:
    """Retain checked field layout and derives for admitted plain model, class, and newtype declarations."""
    unions = collect_unions(module)
    mut models: list[ModelDeclaration] = []
    for declaration in module.nominal_declarations:
        if declaration.has_field_defaults and "Default" in declaration.derives:
            return Err(f"unsupported Body IR derived Default over field defaults on {declaration.name}")
        mut fields: list[Parameter] = []
        for slot in range(len(declaration.fields)):
            fields.append(
                Parameter(
                    name=str(declaration.fields[slot]),
                    ty=native_source_type(
                        module.nominal_declarations,
                        module.enum_declarations,
                        unions,
                        declaration.field_types[slot],
                        intrinsics,
                    )?,
                    span=SourceSpan(file=file, line=1, column=1),
                ),
            )
        item = library_item(declaration)
        mut derives = declaration.derives
        if item != "":
            # The SDK crate already derives and implements everything its layout carries.
            derives = []
        models.append(
            ModelDeclaration(
                name=str(declaration.name),
                public=declaration.public or item != "",
                fields=fields,
                field_public=declaration.field_public,
                derives=derives,
                source_name=str(declaration.canonical.declaration_name),
                span=SourceSpan(file=file, line=1, column=1),
                library_item=item,
            ),
        )
    return Ok(models)


def library_item(declaration: &NominalDeclaration) -> str:
    """
    Name the compiled item that owns a stdlib layout, `library::module::Name`, or nothing for any other layout.

    SDK packages compile each stdlib module into the like-named module of their crate, and the native route links
    those crates, so a stdlib layout is named rather than declared. A dependency package's layout is declared from
    its published representation instead.
    """
    if declaration.canonical.origin == SymbolOrigin.Builtin:
        return ""
    match declaration.canonical.origin:
        SymbolOrigin.Package(library=library, module_path=path) =>
            if not str(library).startswith("incan_stdlib_"):
                return ""
            mut segments = [str(library)]
            for segment in path:
                segments.append(str(segment))
            segments.append(str(declaration.canonical.declaration_name))
            return "::".join(segments)
        _ => return ""
