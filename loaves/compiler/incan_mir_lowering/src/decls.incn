"""Runtime layouts of checked source-local declarations; erased aliases have no storage."""

from rust::incan_semantics_core import SymbolOrigin, IncanType as RustType
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    NominalDeclaration,
    StaticDeclaration,
    GlobalPlace,
    EnumDeclaration as RustEnumDeclaration,
)
from pub::incan_mir_plan import EnumDeclaration, ModelDeclaration, Parameter, SourceSpan, PlanType, ListLeaf
from unions import native_source_type, collect_unions
from nominal_instances import instance_arguments


pub def static_slot(declarations: list[StaticDeclaration], value: &GlobalPlace) -> Result[int, str]:
    """Resolve global storage only by retained canonical identity and exact checked carrier."""
    for slot in range(len(declarations)):
        declaration = declarations[slot]
        if declaration.canonical == value.identity and declaration.ty == value.ty:
            return Ok(slot)
    return Err(f"unsupported Body IR unretained global storage `{value.identity.declaration_name}`")


pub def static_accessors(ty: PlanType) -> Result[tuple[str, str], str]:
    """
    Name persistent primitive, flat-list and hashed-collection cells after checked carrier admission.

    The runtime keeps a typed cell per carrier, so a hashed carrier without one stays refused by name.
    """
    match ty:
        PlanType.List(leaf, depth) =>
            if depth != 1:
                return Err("unsupported Body IR nested static list carrier")
            return static_list_accessors(leaf)
        PlanType.Dict(key, value) =>
            if key == ListLeaf.Str and value == ListLeaf.Int:
                return Ok(
                    ("incan_native_runtime::read_static_text_int_dict", "incan_native_runtime::write_static_text_int_dict"),
                )
            return Err("unsupported Body IR static dictionary carrier")
        PlanType.Set(leaf) =>
            if leaf == ListLeaf.Int:
                return Ok(("incan_native_runtime::read_static_int_set", "incan_native_runtime::write_static_int_set"))
            return Err("unsupported Body IR static set carrier")
        PlanType.String =>
            return Ok(("incan_native_runtime::read_static_text", "incan_native_runtime::write_static_text"))
        PlanType.Int => return Ok(("incan_native_runtime::read_static_int", "incan_native_runtime::write_static_int"))
        PlanType.Float =>
            return Ok(("incan_native_runtime::read_static_float", "incan_native_runtime::write_static_float"))
        PlanType.Bool =>
            return Ok(("incan_native_runtime::read_static_bool", "incan_native_runtime::write_static_bool"))
        _ => return Err("unsupported Body IR static carrier")


def static_list_accessors(leaf: ListLeaf) -> Result[tuple[str, str], str]:
    """Choose typed runtime list cells without erasing their checked element representation."""
    mut name = ""
    match leaf:
        ListLeaf.Int =>
            name = "int"
        ListLeaf.Float =>
            name = "float"
        ListLeaf.Bool =>
            name = "bool"
        ListLeaf.Str =>
            name = "text"
        _ => return Err("unsupported Body IR static list element")
    return Ok((f"incan_native_runtime::read_static_{name}_list", f"incan_native_runtime::write_static_{name}_list"))


pub def lower_model_declarations(
    module: &BodyIrModule,
    file: str,
    intrinsics: list[EnumDeclaration] = [],
) -> Result[list[ModelDeclaration], str]:
    """
    Retain checked field layout and derives for admitted plain model, class, and newtype declarations.

    A derived Default is built at each `default()` call from the declared field defaults, so the native struct never
    derives Default: a Rust derive would give every field its zero value instead.
    """
    unions = collect_unions(module)
    reached = serde_propagation(module)?
    mut models: list[ModelDeclaration] = []
    for declaration in module.nominal_declarations:
        item = library_item(declaration)
        mut library_arguments: list[PlanType] = []
        mut derives: list[str] = []
        for derive in declaration.derives:
            if derive != "Default":
                derives.append(derive)
        mut fields: list[Parameter] = []
        mut field_public = declaration.field_public
        mut serde_names: list[str] = []
        if item != "":
            for argument in instance_arguments(module, declaration)?:
                library_arguments.append(
                    native_source_type(
                        module.nominal_declarations,
                        module.enum_declarations,
                        unions,
                        argument,
                        intrinsics,
                    )?,
                )
            fields = library_fields(module, declaration, file, intrinsics)
            if len(fields) != len(declaration.fields):
                field_public = []
            # The SDK crate already derives and implements everything its layout carries.
            derives = []
        else:
            # Only a plain newtype takes a propagated serde derive; another reached nominal keeps its own derives.
            if len(declaration.fields) == 1 and str(declaration.fields[0]) == "0":
                derives = with_serde_derives(derives, str(declaration.name), reached)
            serde_names = serde_field_names(declaration)
            for slot in range(len(declaration.fields)):
                mut ty = PlanType.Unit
                match native_source_type(
                    module.nominal_declarations,
                    module.enum_declarations,
                    unions,
                    declaration.field_types[slot],
                    intrinsics,
                ):
                    Ok(resolved) =>
                        ty = resolved
                    Err(reason) => return Err(f"{reason} in model {declaration.name} field {declaration.fields[slot]}")
                fields.append(
                    Parameter(name=str(declaration.fields[slot]), ty=ty, span=SourceSpan(file=file, line=1, column=1)),
                )
        models.append(
            ModelDeclaration(
                name=str(declaration.name),
                public=declaration.public or item != "",
                fields=fields,
                field_public=field_public,
                derives=derives,
                source_name=str(declaration.canonical.declaration_name),
                span=SourceSpan(file=file, line=1, column=1),
                library_item=item,
                library_type_arguments=library_arguments,
                field_serde_names=serde_names,
            ),
        )
    return Ok(models)


pub def serde_propagation(module: &BodyIrModule) -> Result[tuple[list[str], list[str]], str]:
    """
    Name the nominals a serde-deriving declaration's fields hold, as legacy's serde derive propagation collects them:
    the names reached under Serialize, then those reached under Deserialize.

    Legacy adds a model's serde derives to each source enum and plain newtype its field types name, so the generated
    derive compiles without annotating every nested type. Field types are walked through lists, sets, dictionaries,
    tuples, `Option` and `Result` carriers and other type arguments, one level deep: a reached model's own fields
    propagate nothing. Legacy propagates within one module's declarations, so a reached declaration of another module
    takes nothing. A stdlib layout's derives belong to its crate, so it neither propagates nor receives a derive.
    """
    mut serialize: list[str] = []
    mut deserialize: list[str] = []
    for declaration in module.nominal_declarations:
        if library_item(declaration) != "":
            continue
        if "serde::Serialize" not in declaration.derives and "serde::Deserialize" not in declaration.derives:
            continue
        mut reached: list[str] = []
        for ty in declaration.field_types:
            reached = reached_names(ty, reached)?
        for name in reached:
            if not declared_beside(module, name, declaration):
                continue
            if "serde::Serialize" in declaration.derives and name not in serialize:
                serialize.append(name)
            if "serde::Deserialize" in declaration.derives and name not in deserialize:
                deserialize.append(name)
    return Ok((serialize, deserialize))


def declared_beside(module: &BodyIrModule, name: str, source: &NominalDeclaration) -> bool:
    """Whether `name` is a source enum or nominal declared in the same module as `source`."""
    for declaration in module.enum_declarations:
        if str(declaration.name) == name:
            return declaration.canonical.origin == source.canonical.origin
    for declaration in module.nominal_declarations:
        if str(declaration.name) == name:
            return declaration.canonical.origin == source.canonical.origin
    return false


def reached_names(ty: &RustType, names: list[str]) -> Result[list[str], str]:
    """
    Add the nominal names one field type holds to `names`.

    A union field is refused: the direct route's union layout carries no serde derive.
    """
    mut result = names
    match ty:
        RustType.Named(name) =>
            if str(name) not in result:
                result.append(str(name))
        RustType.Generic(base=base, args=arguments) =>
            if base == "Union":
                return Err("unsupported Body IR serde derive propagation through a union field")
            for argument in arguments:
                result = reached_names(argument, result)?
        RustType.Tuple(elements) =>
            for element in elements:
                result = reached_names(element, result)?
        RustType.Ref(inner) =>
            result = reached_names(inner, result)?
        RustType.RefMut(inner) =>
            result = reached_names(inner, result)?
        _ => pass
    return Ok(result)


pub def with_serde_derives(derives: list[str], name: str, reached: tuple[list[str], list[str]]) -> list[str]:
    """Append each serde derive a serde-deriving declaration's fields require of `name`, unless it is already derived."""
    serialize, deserialize = reached
    mut result = derives
    if name in serialize and "serde::Serialize" not in result:
        result.append("serde::Serialize")
    if name in deserialize and "serde::Deserialize" not in result:
        result.append("serde::Deserialize")
    return result


def library_fields(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    file: str,
    intrinsics: list[EnumDeclaration],
) -> list[Parameter]:
    """
    A stdlib layout's fields when the plan can carry every one of them, otherwise none.

    A layout without fields is opaque: its values move and drop as the SDK crate's own type. Reading a field whose type
    the plan cannot carry refuses while lowering; the driver's plan validation rejects any projection into an opaque
    layout.
    """
    unions = collect_unions(module)
    mut fields: list[Parameter] = []
    for slot in range(len(declaration.fields)):
        match native_source_type(
            module.nominal_declarations,
            module.enum_declarations,
            unions,
            declaration.field_types[slot],
            intrinsics,
        ):
            Ok(ty) =>
                fields.append(
                    Parameter(name=str(declaration.fields[slot]), ty=ty, span=SourceSpan(file=file, line=1, column=1)),
                )
            Err(_reason) => return []
    return fields


pub def library_item(declaration: &NominalDeclaration) -> str:
    """Name the compiled item that owns a stdlib layout, or nothing for any other layout."""
    if declaration.native_item != "":
        return str(declaration.native_item)
    return library_path(declaration.canonical.origin, str(declaration.canonical.declaration_name))


pub def library_enum_item(declaration: &RustEnumDeclaration) -> str:
    """Name the compiled item that owns a stdlib enum, or nothing for any other enum."""
    return library_path(declaration.canonical.origin, str(declaration.canonical.declaration_name))


def library_path(origin: &SymbolOrigin, name: str) -> str:
    """
    Name a stdlib declaration's compiled item, `library::module::Name`, or nothing for any other origin.

    SDK packages compile each stdlib module into the like-named module of their crate, and the native route links
    those crates, so a stdlib type is named rather than declared. A dependency package's type is declared from its
    published representation instead. Registered async runtime types name their runtime facet directly; their opaque
    records expose no fields or constructors.
    """
    # Comparing in expression position keeps the `SymbolOrigin` import that the match patterns alone would not.
    if origin == SymbolOrigin.Builtin:
        return ""
    match origin:
        SymbolOrigin.Package(library=library, module_path=path) =>
            if not str(library).startswith("incan_stdlib_") and str(library) != "incan_std_async":
                return ""
            mut segments = [str(library)]
            for segment in path:
                segments.append(str(segment))
            segments.append(name)
            return "::".join(segments)
        _ => return ""


def serde_field_names(declaration: &NominalDeclaration) -> list[str]:
    """
    Name each aliased field by its alias in the declaration's serde form, as legacy's `#[serde(rename)]` does.

    Legacy renames only when the declaration derives serde; without any alias every field keeps its name.
    """
    mut names: list[str] = []
    if "serde::Serialize" not in declaration.derives and "serde::Deserialize" not in declaration.derives:
        return names
    mut renamed = false
    for alias in declaration.field_aliases:
        match alias:
            Some(name) =>
                names.append(str(name))
                renamed = true
            None => names.append("")
    if not renamed:
        return []
    return names
