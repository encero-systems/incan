"""
Keep generic instance requests and closed generic instances in keyed plan products.

A request names its generic by the declaration's stable identity, never by a source position, beside its closed type
arguments, owned callable slots and execution role. A caller's product carries the requests its lowering made, so a
reused caller still schedules its instances. A closed instance is its own product, keyed by its generic body's checked
witness and that request identity.
"""

from std.encoding.hex import hexlify
from std.hash import sha256
from pub::internal_models.checked_types import CheckedType
from compiler_record_adapters import checked_type, native_checked_type, checked_type_matches_native
from rust::incan_semantics_core import CompilerNodeId, IncanType as RustType, SymbolOrigin, encode_incan_symbol_identity
from rust::incan_semantics_core::stable_identity import StableDeclarationId
from rust::incan_semantics_core::stable_identity::source_signature import SourceSignatureContext
from rust::incan_semantics_core import IncanCallableParam
from rust::incan_semantics_core::body_ir import Body as RustBody, CallableParamDefault
from rust::std::collections import BTreeMap
from pub::incan_mir_plan import ExternalFunction, Function, UnitNominals, encode_instance_request, decode_instance_request
from pub::internal_models.compiler_records import RUNTIME_INSTANCE_IDENTITY
from lowering import BodyIrModule
from table_views import borrowed_at
from type_parameters import Instance, request_instance
from scalar_store import reported, retained_scalar, report_scalar, report_scalar_refusal
from nominal_records import retain_named_scalar
from checked_values import location
from plan_product_inputs import graph_owner, ordinary_product_inputs, producer_generation

# Separates a closed instance's request identity from its generic body's checked witness in the product key.
const INSTANCE_FUNCTION: str = "incan.instance-function/2"
# The toolchain Loaf whose generics lowering instantiates for list and copy operations.
const RUNTIME_LIBRARY: str = "incan_native_runtime"
# Stands in for a checker witness in a runtime generic's instance key; its checked meaning is keyed beside it.
const RUNTIME_BODY: str = "runtime-body:incan_native_runtime"


pub model InstanceProducts:
    """The keyed-product transport of one records request, shared by every closed instance its unit lowers."""

    pub directory: str
    pub generation: Option[str]
    pub admitted: BTreeMap[CompilerNodeId, str]
    pub report: Option[str]
    pub overflow_checks: bool


pub model InstanceProduct:
    """A closed instance's reused native function with its runtime demand, carried frames and own requests."""

    pub function: Function
    pub runtime: list[ExternalFunction]
    pub frames: list[Function]
    pub requests: list[Instance]


pub def request_identity(request: &Instance) -> Result[bytes, str]:
    """
    Name one request without source positions; a generic or argument only a position names is refused.

    A member's request is refused too. Its instance is named for the receiver it was requested on, such as each model
    that adopts one trait default method, and this identity names no receiver, so a restored request could select
    another receiver's instance.
    """
    if not graph_owner(request.body):
        return Err("generic instance of a member is named for its receiver")
    declaration = match signed_template(request.body):
        None => return Err("generic instance has no checked declaration signature")
        Some(stable) => stable.render_compact()
    mut arguments: list[CheckedType] = []
    for index in range(len(request.arguments)):
        native = borrowed_at(request.arguments, index)
        argument = checked_type(native, "", "")
        if not checked_type_matches_native(argument, native)?:
            return Err("generic instance argument differs from its native checked type")
        arguments.append(argument)
    return encode_instance_request(declaration, arguments, list(request.owned_callable_slots), request.original_callable)



pub def encode_requests(requests: &list[Instance]) -> Result[list[bytes], str]:
    """Encode the requests a lowering made, in request order, for the product that carries them."""
    mut encoded: list[bytes] = []
    for position in range(len(requests)):
        encoded.append(request_identity(borrowed_at(requests, position))?)
    return Ok(encoded)


pub def restore_requests(encoded: &list[bytes], context: &BodyIrModule) -> Option[list[Instance]]:
    """Rebuild a product's requests against this unit's generic templates; a generic no longer present is a miss."""
    mut restored: list[Instance] = []
    for row in encoded:
        current = match decode_instance_request(row):
            Ok(value) => value
            Err(_) => return None
        declaration, authored, slots, original = current
        mut arguments: list[RustType] = []
        for ty in authored:
            match native_checked_type(ty):
                Ok(native) => arguments.append(native)
                Err(_) => return None
        match template_position(context, declaration):
            None => return None
            Some(position) =>
                request_instance(restored, borrowed_at(context.bodies, position), arguments, slots, original)
    return Some(restored)


pub def reused_instance(
    products: &InstanceProducts,
    context: &BodyIrModule,
    request: &Instance,
    body: &RustBody,
    source: str,
    file: str,
    nominals: &UnitNominals,
) -> Result[Option[InstanceProduct], str]:
    """
    Read a closed instance's product when its generic body and request identity are unchanged.

    1. Key the instance by its generic body's witness and the request identity; an unkeyable instance reports why.
    2. Restore the product at the template's current node positions, with the requests it carries.
    3. Report it as a reuse, unless an earlier pass of this request already reported it.
    """
    # 1. Only a module-level generic the checker witnessed has a product.
    keyed = instance_key(products, context, request, source, file)?
    match keyed:
        None => return Ok(None)
        Some(key) =>
            inputs, positions, identity = key
            # A runtime retry drains the instances again. The first pass already reused or retained this product and
            # reported which, so the retry restores the same product and keeps that verdict.
            settled = reported(products.report, inputs)
            current = Some(location(body.span, source, file))
            # 2. A missing or stale product, or a generic it requests that is gone, is an ordinary miss.
            match retained_scalar(products.directory, inputs, nominals, current, positions):
                None => return Ok(None)
                Some(product) =>
                    function, runtime, references, frames, encoded = product
                    match restore_requests(encoded, context):
                        None => return Ok(None)
                        Some(requests) =>
                            # 3. Only the first pass that reads the product counts it.
                            if not settled:
                                report_scalar(
                                    products.report,
                                    products.directory,
                                    inputs,
                                    identity,
                                    function.name,
                                    true,
                                    len(runtime),
                                    references,
                                    positions,
                                )?
                            return Ok(
                                Some(InstanceProduct(function=function, runtime=runtime, frames=frames, requests=requests)),
                            )


pub def retain_instance_product(
    products: &InstanceProducts,
    context: &BodyIrModule,
    request: &Instance,
    function: &Function,
    runtime: &list[ExternalFunction],
    frames: &list[Function],
    pending: &list[Instance],
    source: str,
    file: str,
    nominals: &UnitNominals,
) -> Result[None, str]:
    """
    Retain a freshly lowered closed instance as its own product, or report why it has none.

    Every instance of a records request ends in a product event or a refusal, so publication sees each plan function.
    """
    keyed = instance_key(products, context, request, source, file)?
    match keyed:
        None =>
            report_scalar_refusal(products.report, "", function.name, "generic instance has no checked body witness")?
        Some(key) =>
            inputs, positions, identity = key
            match encode_requests(pending):
                Err(reason) => report_scalar_refusal(products.report, identity, function.name, reason)?
                Ok(encoded) =>
                    match retain_named_scalar(
                        products.directory,
                        inputs,
                        function,
                        runtime,
                        nominals,
                        positions,
                        list(frames),
                        encoded,
                    ):
                        Ok(references) =>
                            report_scalar(
                                products.report,
                                products.directory,
                                inputs,
                                identity,
                                function.name,
                                false,
                                len(runtime),
                                references,
                                positions,
                            )?
                        Err(reason) => report_scalar_refusal(products.report, identity, function.name, reason)?
    return Ok(None)


def instance_key(
    products: &InstanceProducts,
    context: &BodyIrModule,
    request: &Instance,
    source: str,
    file: str,
) -> Result[Option[tuple[list[str], list[tuple[int, int]], str]], str]:
    """
    Key one closed instance by its generic body's witness and request identity, with the generic's positions.

    A generic of the toolchain's runtime Loaf has no checker witness: no consumer checks its published body. It keys by
    its own checked meaning under the installed producer instead, and its event names the generic as a runtime instance.
    """
    if not graph_owner(request.body):
        return Ok(None)
    mut identity = ""
    mut unchecked: Option[str] = None
    match request.body.canonical:
        None => return Ok(None)
        Some(canonical) =>
            identity = encode_incan_symbol_identity(canonical)
            if runtime_generic(canonical.origin):
                identity = RUNTIME_INSTANCE_IDENTITY + identity
                unchecked = Some(RUNTIME_BODY)
    selected = ordinary_product_inputs(
        context,
        request.body,
        source,
        file,
        products.overflow_checks,
        Some(products.directory),
        products.admitted,
        products.report is not None,
        products.generation,
        unchecked,
    )
    match selected:
        None => return Ok(None)
        Some(value) =>
            witness, positions = value
            match request_identity(request):
                Err(_) => return Ok(None)
                Ok(named) =>
                    mut inputs = witness
                    inputs.append(INSTANCE_FUNCTION)
                    inputs.append("sha256:" + hexlify(sha256.digest(named)))
                    return Ok(Some((inputs, positions, identity)))


def runtime_generic(origin: SymbolOrigin) -> bool:
    """Whether a generic is published by the toolchain's runtime Loaf, whose bodies are fixed for an installation."""
    match origin:
        SymbolOrigin.Package(library=library, module_path=_path) => return library == RUNTIME_LIBRARY
        _ => return false


def signed_template(body: &RustBody) -> Option[StableDeclarationId]:
    """Project the checked generic overload through the same source signature used by the checker."""
    match body.canonical:
        None => return None
        Some(canonical) =>
            mut parameters: list[IncanCallableParam] = []
            for slot in range(len(body.params)):
                param = borrowed_at(body.params, slot)
                optional = match param.default:
                    CallableParamDefault.Required => false
                    _ => true
                parameters.append(IncanCallableParam(
                    name=None,
                    ty=param.ty,
                    kind=param.kind,
                    has_default=optional,
                    is_partial_preset=false,
                    is_mut=param.mutable,
                    native_owned=param.native_owned,
                    input_access=param.input_access,
                ))
            signature = SourceSignatureContext(nominals=body.named_type_identities.as_ref(), binders=body.type_parameters.as_slice())
            match signature.callable(parameters, body.return_type, body.is_async):
                None => return None
                Some(value) => return StableDeclarationId.from_canonical(canonical, Some(value), None)


def template_position(context: &BodyIrModule, declaration: str) -> Option[int]:
    """Restore one uniquely matching overload. Older unsigned requests require a unique declaration."""
    name = declaration.split("|")[0]
    mut selected: Option[int] = None
    for position in range(len(context.bodies)):
        body = borrowed_at(context.bodies, position)
        match body.canonical:
            None => continue
            Some(canonical) =>
                match StableDeclarationId.from_canonical(canonical, None, None):
                    None => continue
                    Some(stable) =>
                        if stable.render_compact() != name:
                            continue
        if name != declaration:
            match signed_template(body):
                None => continue
                Some(signed) =>
                    if signed.render_compact() != declaration:
                        continue
        if selected is not None:
            return None
        selected = Some(position)
    return selected


pub def product_directory(products: &Option[InstanceProducts]) -> Option[str]:
    """The keyed-product directory of a records request, when instances keep products at all."""
    match products:
        Some(transport) => return Some(transport.directory)
        None => return None


pub def instance_transport(
    directory: Option[str],
    admitted: BTreeMap[CompilerNodeId, str],
    report: Option[str],
    overflow_checks: bool,
) -> Option[InstanceProducts]:
    """Share one records request's keyed-product transport with its closed instances; other requests keep none."""
    match directory:
        None => return None
        Some(root) =>
            return Some(InstanceProducts(directory=root, admitted=admitted, report=report, overflow_checks=overflow_checks, generation=producer_generation(Some(root))))
