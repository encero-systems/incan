"""Explicit calls of a standard-library derive's method on a source nominal, through the derive's own implementation."""

from rust::incan_semantics_core import CanonicalSymbolId, SymbolOrigin, SemanticSourceTargetKind
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    BinOp,
    MethodTarget,
    ArgumentElement as RustArgumentElement,
    Operand as RustOperand,
    Place as RustPlace,
    Rvalue as RustRvalue,
)
from pub::incan_mir_plan import CalleeKind, Place, PlanType, RvalueKind, SourceSpan
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, place_type, read_place, temporary
from lowering import scalar_place, lower_callable_result, lower_assignment
from trait_links import contains


pub def is_derived_clone(target: &MethodTarget) -> bool:
    """Recognize `clone` of the standard library's Clone in source and compiled SDK identities, never a same-name method."""
    return is_std_derive_method(target, "copying", "clone")


pub def is_std_callable_call(target: &MethodTarget) -> bool:
    """Recognize `__call__` of the standard library's callable traits, through which a callable bound is called."""
    return is_std_core_method(target, "traits", "callable", "__call__")


def is_std_derive_method(target: &MethodTarget, module: str, name: str) -> bool:
    """Whether the checker selected `name` of a trait declared by the standard library's `std.derives.<module>`."""
    return is_std_core_method(target, "derives", module, name)


def is_std_core_method(target: &MethodTarget, section: str, module: str, name: str) -> bool:
    """Whether the checker selected `name` of `std.<section>.<module>`, in source or compiled SDK identities."""
    match target.canonical:
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method or identity.declaration_name != name:
                return false
            match identity.origin:
                SymbolOrigin.Module(path) =>
                    return len(path) == 3 and path[0] == "std" and path[1] == section and path[2] == module
                SymbolOrigin.Package(library=library, module_path=path) =>
                    return library == "incan_stdlib_core" and len(path) == 2 and path[0] == section and path[1] == module
                _ => return false
        None => return false


pub def lower_derived_clone(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Copy the receiver through its real derived Clone implementation, as legacy's `.clone()` call does.

    Models and classes always derive Clone; an enum's checked derives must name it. Any other receiver keeps refusing.
    """
    if len(arguments) != 1:
        return Err("invalid Body IR Clone arguments")
    match arguments[0].as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) =>
                    source = scalar_place(builder, read.place, span)?
                    return clone_place(builder, source, destination, span)
                _ => return Err("unsupported Body IR Clone of a nonplace receiver")
        None => return Err("unsupported Body IR Clone spread receiver")


def clone_place(
    mut builder: Builder,
    source: Place,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Select the nominal's own Clone implementation from its native carrier."""
    ty = place_type(builder.locals, source)
    match ty:
        PlanType.Model(index, name) =>
            reference = PlanType.ModelRef(index, name)
            return clone_into(builder, source, reference, CalleeKind.CloneModel(index, name), ty, destination, span)
        PlanType.Enum(index, name) =>
            if index < 0 or index >= len(builder.enums) or "Clone" not in builder.enums[index].derives:
                return Err("unsupported Body IR enum Clone without a derived Clone")
            reference = PlanType.EnumRef(index, name)
            return clone_into(builder, source, reference, CalleeKind.CloneEnum(index, name), ty, destination, span)
        _ => return Err("unsupported Body IR Clone outside models and enums")


def clone_into(
    mut builder: Builder,
    source: Place,
    reference_type: PlanType,
    callee: CalleeKind,
    ty: PlanType,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Borrow the receiver and write the owned copy to the call's destination, replacing what it held."""
    reference = temporary(builder, reference_type, span)
    builder.emit(plan_assign(reference, RvalueKind.Borrow(source), span))
    mut output = source
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None =>
            output = temporary(builder, ty, span)
    return lower_callable_result(builder, callee, [read_place(reference, false, span)], output, ty, span)


pub def comparison_dunder(target: &MethodTarget) -> Option[BinOp]:
    """Select the operator a dunder of the standard library's Eq or Ord names, never a same-name method."""
    if is_std_derive_method(target, "comparison", "__eq__"):
        return Some(BinOp.Eq)
    if is_std_derive_method(target, "comparison", "__ne__"):
        return Some(BinOp.Ne)
    if is_std_derive_method(target, "comparison", "__lt__"):
        return Some(BinOp.Lt)
    if is_std_derive_method(target, "comparison", "__le__"):
        return Some(BinOp.Le)
    if is_std_derive_method(target, "comparison", "__gt__"):
        return Some(BinOp.Gt)
    if is_std_derive_method(target, "comparison", "__ge__"):
        return Some(BinOp.Ge)
    return None


pub def lower_comparison_dunder(
    module: &BodyIrModule,
    mut builder: Builder,
    operator: BinOp,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Lower an explicit standard comparison dunder as the operator it names, through that operator's own lowering.

    A derived Eq or Ord implements each dunder as its operator, so `a.__ge__(b)` is `a >= b`. A receiver whose type
    declares any comparison dunder itself keeps refusing: its operators need not be the derived ones.
    """
    if len(arguments) != 2:
        return Err("invalid Body IR comparison dunder arguments")
    left = single_operand(arguments[0])?
    right = single_operand(arguments[1])?
    if declares_own_comparison(module, builder, left, span)?:
        return Err("unsupported Body IR comparison dunder on a type with its own comparison methods")
    match destination:
        Some(place) =>
            comparison: RustRvalue = RustRvalue.BinaryOp(operator, left, right)
            return lower_assignment(module, builder, place, comparison, span)
        None => return Err("unsupported Body IR discarded comparison dunder")


def single_operand(argument: &RustArgumentElement) -> Result[RustOperand, str]:
    """Read one positional argument's checked operand, refusing a spread."""
    match argument.as_one():
        Some(value) => return Ok(value.clone())
        None => return Err("unsupported Body IR comparison dunder spread argument")


def declares_own_comparison(
    module: &BodyIrModule,
    builder: Builder,
    receiver: &RustOperand,
    span: SourceSpan,
) -> Result[bool, str]:
    """Whether the receiver's source nominal or enum declares a comparison dunder or fills one from a source trait."""
    match receiver:
        RustOperand.Place(read) =>
            source = scalar_place(builder, read.place, span)?
            match place_type(builder.locals, source):
                PlanType.Model(index, _name) => return Ok(owns_comparison(module, builder.nominals[index].canonical))
                PlanType.Enum(index, _name) =>
                    if index >= 0 and index < len(builder.enums):
                        return Ok(owns_comparison(module, builder.enums[index].canonical))
                    return Ok(false)
                _ => return Ok(false)
        _ => return Ok(false)


def owns_comparison(module: &BodyIrModule, owner: &CanonicalSymbolId) -> bool:
    """Whether a body inside the owner's declaration, or a source trait slot it adopts, is a comparison dunder."""
    for body in module.bodies:
        match body.canonical:
            Some(identity) =>
                name = str(identity.declaration_name)
                if identity.origin == owner.origin and contains(owner, identity) and is_comparison_name(name):
                    return true
            None => pass
    for implementation in module.trait_implementations:
        if implementation.owner == owner.clone() and is_comparison_name(str(implementation.method.declaration_name)):
            return true
    return false


def is_comparison_name(name: str) -> bool:
    """The six comparison dunders of the standard library's Eq and Ord."""
    return name in ["__eq__", "__ne__", "__lt__", "__le__", "__gt__", "__ge__"]
