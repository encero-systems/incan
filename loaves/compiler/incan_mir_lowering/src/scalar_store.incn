"""Read and atomically retain scalar native products under their producer's complete input witnesses."""

from rust::serde import Serialize, Deserialize
from rust::serde_json import to_string, from_str, Error as JsonError
from rust::incan_semantics_core::semantic_digest import semantic_digest
from rust::std::process import id as process_id
from std.fs import Path
from pub::incan_mir_plan import ExternalFunction, Function, SourceSpan
from scalar_products import encode_product, decode_product
from record_positions import relocate_product


@derive(Serialize, Deserialize)
model ScalarRecord:
    """Authenticate the exact producer inputs, function and dependency requirements in a private product."""

    schema: int
    inputs: list[str]
    function: str
    digest: str


@derive(Serialize, Deserialize)
model ScalarRecordEvent:
    """One request-local observation of an evaluated or reused plan-function product."""

    schema: int
    identity: str
    key: str
    function: str
    product: str
    reused: bool
    runtime_requirements: int


@derive(Serialize, Deserialize)
model ScalarRecordRefusal:
    """One request-local refusal to represent an ordinarily lowered function as a scalar record."""

    schema: int
    identity: str
    function: str
    refusal: str


pub def scalar_inputs(body: str, name: str, span: SourceSpan, overflow_checks: bool, reads: str) -> list[str]:
    """Bind a native product to its checked body, consumed signatures, physical frame and diagnostic provenance."""
    return [
        "incan.scalar-function/4",
        body,
        name,
        str(span.file),
        str(span.line),
        str(span.column),
        str(overflow_checks),
        reads,
    ]


pub def record_scalar_inputs(body: str, name: str, span: SourceSpan, overflow: bool, reads: str, positions: str) -> list[str]:
    """Separate a record's checked meaning and relative positions from its current owner-line translation."""
    return ["incan.record-function/1", body, name, str(span.file), str(overflow), reads, positions]


pub def retained_scalar(
    directory: str,
    inputs: list[str],
    span: Option[SourceSpan] = None,
) -> Option[tuple[Function, list[ExternalFunction]]]:
    """
    Read a complete native function whose full producer inputs still match.

    1. Read the content-addressed private record.
    2. Validate its input witness and payload digest.
    3. Restore the complete native function or return a cache miss.
    """
    # 1. Missing, corrupt and concurrently replaced entries all remain ordinary misses.
    match scalar_path(directory, inputs):
        Err(_) => return None
        Ok(path) =>
            match path.read_text("utf-8", "strict"):
                Err(_) => return None
                Ok(text) => return restore_record(text, inputs, span)


pub def retain_scalar(directory: str, inputs: list[str], function: &Function, runtime: &list[ExternalFunction]) -> Result[None, str]:
    """
    Publish a loss-checked scalar native function without changing compilation's verdict.

    1. Encode and authenticate every function field against its producer inputs.
    2. Write a complete temporary record and atomically replace its destination.
    """
    # 1. Records mode must preserve an unsupported native shape as an explicit producer refusal.
    text = encoded_record(inputs, function, runtime)?
    # 2. The request-local transport is required input to Bakery publication, so failed writes refuse the producer.
    return publish_record(directory, inputs, text)


pub def report_scalar(
    directory: Option[str],
    products: str,
    inputs: list[str],
    identity: str,
    function: str,
    reused: bool,
    runtime: int,
) -> Result[None, str]:
    """Publish one bounded product event for Bakery admission; records mode refuses incomplete transport."""
    if let Some(root) = directory:
        digest = fingerprint(inputs)?
        product = scalar_path(products, inputs)?.read_text("utf-8", "strict").map_err(
            (error) => f"cannot read plan-function product {error.message()}",
        )?
        # Revalidate the exact bytes before they cross from private lowering transport into Bakery publication.
        if restore_record(product, inputs) is None:
            return Err("plan-function product failed its lowering codec round trip")
        event = ScalarRecordEvent(
            schema=2,
            identity=identity,
            key=digest.replace("sha256:", ""),
            function=function,
            product=product,
            reused=reused,
            runtime_requirements=runtime,
        )
        text = to_string(event).map_err((error) => str(error))?
        path = Path(root).joinpath(digest.replace("sha256:", "") + ".event")
        path.parent().mkdir(true, true).map_err((error) => error.message())?
        path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(None)


pub def report_scalar_refusal(
    directory: Option[str],
    identity: str,
    function: str,
    refusal: str,
) -> Result[None, str]:
    """Retain an explicit record refusal without changing the ordinary lowering verdict."""
    if let Some(root) = directory:
        report = ScalarRecordRefusal(
            schema=2,
            identity=identity,
            function=function,
            refusal=refusal,
        )
        text = to_string(report).map_err((error) => str(error))?
        digest = fingerprint([identity, function, refusal])?.replace("sha256:", "")
        path = Path(root).joinpath(digest + ".refusal")
        path.parent().mkdir(true, true).map_err((error) => error.message())?
        path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(None)


def encoded_record(inputs: list[str], function: &Function, runtime: &list[ExternalFunction]) -> Result[str, str]:
    """Authenticate the entire native payload after the codec proves an exact structural round trip."""
    mut payload = encode_product(function, runtime)?
    if inputs[0] == "incan.record-function/1":
        relative = relocate_product(payload, "<owner>", 1)?
        restored = relocate_product(relative, str(function.span.file), function.span.line)?
        restored_function, restored_runtime = decode_product(restored)?
        if encode_product(restored_function, restored_runtime)? != payload:
            return Err("plan-function position round trip changed native facts")
        payload = relative
    digest = fingerprint([payload])?
    record = ScalarRecord(schema=3, inputs=inputs, function=payload, digest=digest)
    return to_string(record).map_err((error) => str(error))


def restore_record(
    text: str,
    inputs: list[str],
    span: Option[SourceSpan] = None,
) -> Option[tuple[Function, list[ExternalFunction]]]:
    """Treat invalid schema, changed inputs and altered native bytes as cache misses before decoding a function."""
    match decode_record(text):
        Err(_) => return None
        Ok(record) =>
            if record.schema != 3 or record.inputs != inputs:
                return None
            match fingerprint([record.function]):
                Err(_) => return None
                Ok(digest) =>
                    if record.digest != digest:
                        return None
            mut payload = record.function
            if inputs[0] == "incan.record-function/1":
                if let Some(current) = span:
                    match relocate_product(payload, str(current.file), current.line):
                        Ok(moved) => payload = moved
                        Err(_) => return None
            match decode_product(payload):
                Ok(product) => return Some(product)
                Err(_) => return None


def decode_record(text: str) -> Result[ScalarRecord, JsonError]:
    """Pass the expected private record type to the native generic decoder through its result contract."""
    return from_str(text)


def scalar_path(directory: str, inputs: list[str]) -> Result[Path, str]:
    """Name a native product by the existing semantic digest owner's unambiguous framed serialization."""
    digest = fingerprint(inputs)?
    return Ok(Path(directory).joinpath(digest.replace("sha256:", "") + ".incnfunction"))


def fingerprint(inputs: list[str]) -> Result[str, str]:
    """Use the existing digest owner; these fingerprints never define a second declaration identity."""
    return semantic_digest(inputs).map_err((error) => str(error))


def publish_record(directory: str, inputs: list[str], text: str) -> Result[None, str]:
    """Publish one complete record with a process-local temporary name under the producer's locked build."""
    path = scalar_path(directory, inputs)?
    path.parent().mkdir(true, true).map_err((error) => f"cannot create scalar cache directory {error.message()}")?
    temporary = Path(f"{path.0}.{process_id()}.pending")
    temporary
        .write_text(text, "utf-8", "strict", None)
        .map_err((error) => f"cannot write scalar cache {error.message()}")?
    _ = temporary.replace(path).map_err((error) => f"cannot replace scalar cache {error.message()}")?
    return Ok(None)
