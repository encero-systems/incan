"""Read and atomically retain native plan products under their producer's complete input witnesses."""

from rust::serde import Serialize, Deserialize
from rust::serde_json import to_string, from_str, Error as JsonError
from rust::incan_semantics_core::semantic_digest import semantic_digest
from rust::std::process import id as process_id
from std.fs import Path
from pub::incan_mir_plan import (
    ExternalFunction,
    Function,
    NominalKind,
    NominalReference,
    ProductNominal,
    SourceSpan,
    UnitNominals,
    product_identities,
    product_nominals,
    resolve_nominals,
)
from scalar_products import encode_product, decode_product
from record_positions import index_positions, place_positions, relocate_product


# A record whose key is its checked meaning; its spans name Body IR nodes by ordinal through a request-local position map.
const RECORD_FUNCTION: str = "incan.record-function/2"


@derive(Serialize, Deserialize)
model EventPosition:
    """One Body IR node's owner-relative line and column in this request; request-local, never part of the product."""

    line: int
    column: int


@derive(Serialize, Deserialize)
model ScalarRecord:
    """Authenticate the exact producer inputs, function and dependency requirements in a private product."""

    schema: int
    inputs: list[str]
    function: str
    digest: str


@derive(Serialize, Deserialize)
model EventReference:
    """The current unit position and native name one product ordinal resolved to; request-local, never retained."""

    kind: NominalKind
    index: int
    name: str


@derive(Serialize, Deserialize)
model ScalarRecordEvent:
    """One request-local observation of an evaluated or reused plan-function product."""

    schema: int
    identity: str
    key: str
    function: str
    product: str
    reused: bool
    runtime_requirements: int
    references: list[EventReference]
    positions: list[EventPosition]


@derive(Serialize, Deserialize)
model ScalarRecordRefusal:
    """One request-local refusal to represent an ordinarily lowered function as a scalar record."""

    schema: int
    identity: str
    function: str
    refusal: str


pub def scalar_inputs(body: str, name: str, span: SourceSpan, overflow_checks: bool, reads: str) -> list[str]:
    """Bind a native product to its checked body, consumed signatures, physical frame and diagnostic provenance."""
    return [
        "incan.scalar-function/4",
        body,
        name,
        str(span.file),
        str(span.line),
        str(span.column),
        str(overflow_checks),
        reads,
    ]


pub def record_scalar_inputs(body: str, name: str, span: SourceSpan, overflow: bool, reads: str, nodes: int) -> list[str]:
    """
    Key a record by its checked meaning and its Body IR node count; node positions are a separate map.

    The count keeps a position map aligned with the nodes it was captured from, as when a docstring adds a node the
    meaning digest leaves out.
    """
    return [RECORD_FUNCTION, body, name, str(span.file), str(overflow), reads, str(nodes)]


pub def retained_scalar(
    directory: str,
    inputs: list[str],
    unit: &UnitNominals,
    span: Option[SourceSpan] = None,
    positions: list[tuple[int, int]] = [],
) -> Option[tuple[Function, list[ExternalFunction], list[NominalReference]]]:
    """
    Read a complete native function whose full producer inputs and named declarations still match.

    1. Read the content-addressed private record.
    2. Validate its input witness and payload digest, and resolve each declaration it names in the current unit.
    3. Restore the complete native function at the current declaration and node positions, or return a cache miss.
    """
    # 1. Missing, corrupt and concurrently replaced entries all remain ordinary misses.
    match scalar_path(directory, inputs):
        Err(_) => return None
        Ok(path) =>
            match path.read_text("utf-8", "strict"):
                Err(_) => return None
                Ok(text) =>
                    # 2. A changed or missing named declaration is a miss, never a stale position.
                    payload = match record_payload(text, inputs, span, positions):
                        Some(value) => value
                        None => return None
                    references = match product_identities(payload):
                        Ok(identities) => resolve_nominals(identities, unit)
                        Err(_) => None
                    match references:
                        None => return None
                        Some(resolved) =>
                            # 3. The restored function names the declarations at their current positions.
                            match decode_product(payload, resolved):
                                Ok(product) =>
                                    function, runtime = product
                                    return Some((function, runtime, resolved))
                                Err(_) => return None


pub def retain_scalar(
    directory: str,
    inputs: list[str],
    function: &Function,
    runtime: &list[ExternalFunction],
    nominals: list[ProductNominal] = [],
    positions: list[tuple[int, int]] = [],
) -> Result[None, str]:
    """
    Publish a loss-checked native function without changing compilation's verdict.

    1. Encode and authenticate every function field and named declaration against its producer inputs.
    2. Write a complete temporary record and atomically replace its destination.
    """
    # 1. Records mode must preserve an unsupported native shape as an explicit producer refusal.
    text = encoded_record(inputs, function, runtime, nominals, positions)?
    # 2. The request-local transport is required input to Bakery publication, so failed writes refuse the producer.
    return publish_record(directory, inputs, text)


pub def finalize_scalar(
    directory: str,
    key: str,
    function: &Function,
    reused: bool,
    references: list[NominalReference],
    positions: list[tuple[int, int]],
) -> Result[tuple[str, list[NominalReference]], str]:
    """
    Retain the whole-program plan's final function under a keyed product's unchanged inputs and lowering demand.

    1. Read the product lowering retained or reused for this declaration, at the positions this request resolved.
    2. Encode the function the whole-program plan compiles, after unit-level runtime resolution, with that demand and
       the declarations the product named for those positions.
    3. Accept a reused product only when it is already identical; replace a fresh product atomically.

    Returns the final record and the positions its ordinals take in this request.
    """
    # 1. The event key names the product by its complete producer inputs.
    path = Path(directory).joinpath(key + ".incnfunction")
    text = path.read_text("utf-8", "strict").map_err((error) => f"cannot read plan-function product {error.message()}")?
    record = decode_record(text).map_err((error) => str(error))?
    placed = place_positions(record.function, positions)?
    current = relocate_product(placed, str(function.span.file), function.span.line)?
    identities = product_identities(current)?
    _captured, demand = decode_product(current, references)?
    # 2. The same inputs now name the exact native function compiled for this declaration.
    whole = product_nominals(function, demand)?
    mut nominals: list[ProductNominal] = []
    for reference in whole:
        mut named: Option[ProductNominal] = None
        for ordinal in range(len(references)):
            if references[ordinal] == reference:
                named = Some(identities[ordinal])
        match named:
            Some(nominal) => nominals.append(nominal)
            None => return Err(f"plan-function {function.name} names a declaration its keyed product does not")
    final = encoded_record(record.inputs, function, demand, nominals, positions)?
    if final == text:
        return Ok((text, whole))
    # 3. A reused product was already final when retained, so any difference is a lowering defect, never a refresh.
    if reused:
        return Err(f"plan-function {function.name} differs from the whole-program plan")
    publish_record(directory, record.inputs, final)?
    return Ok((final, whole))


pub def report_scalar(
    directory: Option[str],
    products: str,
    inputs: list[str],
    identity: str,
    function: str,
    reused: bool,
    runtime: int,
    references: list[NominalReference] = [],
    positions: list[tuple[int, int]] = [],
) -> Result[None, str]:
    """Publish one bounded product event for Bakery admission; records mode refuses incomplete transport."""
    if let Some(root) = directory:
        digest = fingerprint(inputs)?
        product = scalar_path(products, inputs)?.read_text("utf-8", "strict").map_err(
            (error) => f"cannot read plan-function product {error.message()}",
        )?
        # Revalidate the exact bytes before they cross from private lowering transport into Bakery publication.
        if not valid_record(product, inputs):
            return Err("plan-function product failed its lowering codec round trip")
        mut stored: list[EventReference] = []
        for reference in references:
            stored.append(EventReference(kind=reference.kind, index=reference.index, name=reference.name))
        event = ScalarRecordEvent(
            schema=2,
            identity=identity,
            key=digest.replace("sha256:", ""),
            function=function,
            product=product,
            reused=reused,
            runtime_requirements=runtime,
            references=stored,
            positions=event_nodes(positions),
        )
        text = to_string(event).map_err((error) => str(error))?
        path = Path(root).joinpath(digest.replace("sha256:", "") + ".event")
        path.parent().mkdir(true, true).map_err((error) => error.message())?
        path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(None)


pub def event_references(event: str) -> Result[list[NominalReference], str]:
    """Read the positions a reported product's ordinals resolved to in this request."""
    decoded = decode_event(event).map_err((error) => str(error))?
    mut references: list[NominalReference] = []
    for reference in decoded.references:
        references.append(NominalReference(kind=reference.kind, index=reference.index, name=reference.name))
    return Ok(references)

pub def event_positions(event: str) -> Result[list[tuple[int, int]], str]:
    """Read the Body IR node positions a reported product's spans were placed at in this request."""
    decoded = decode_event(event).map_err((error) => str(error))?
    return Ok([(position.line, position.column) for position in decoded.positions])



pub def report_scalar_refusal(
    directory: Option[str],
    identity: str,
    function: str,
    refusal: str,
) -> Result[None, str]:
    """Retain an explicit record refusal without changing the ordinary lowering verdict."""
    if let Some(root) = directory:
        report = ScalarRecordRefusal(
            schema=2,
            identity=identity,
            function=function,
            refusal=refusal,
        )
        text = to_string(report).map_err((error) => str(error))?
        digest = fingerprint([identity, function, refusal])?.replace("sha256:", "")
        path = Path(root).joinpath(digest + ".refusal")
        path.parent().mkdir(true, true).map_err((error) => error.message())?
        path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(None)


def encoded_record(
    inputs: list[str],
    function: &Function,
    runtime: &list[ExternalFunction],
    nominals: list[ProductNominal],
    positions: list[tuple[int, int]] = [],
) -> Result[str, str]:
    """
    Authenticate the entire native payload after the codec proves an exact structural round trip.

    A keyed record's spans are owner-relative, and each span that locates a Body IR node names that node's ordinal, so
    the record holds no line a moved comment or docstring can change.
    """
    mut payload = encode_product(function, runtime, nominals)?
    if inputs[0] == RECORD_FUNCTION:
        relative = relocate_product(payload, "<owner>", 1)?
        restored = relocate_product(relative, str(function.span.file), function.span.line)?
        restored_function, restored_runtime = decode_product(restored, product_nominals(function, runtime)?)?
        if encode_product(restored_function, restored_runtime, nominals)? != payload:
            return Err("plan-function position round trip changed native facts")
        payload = index_positions(relative, positions)?
        if place_positions(payload, positions)? != relative:
            return Err("plan-function position map changed native facts")
    digest = fingerprint([payload])?
    record = ScalarRecord(schema=3, inputs=inputs, function=payload, digest=digest)
    return to_string(record).map_err((error) => str(error))


def record_payload(
    text: str,
    inputs: list[str],
    span: Option[SourceSpan] = None,
    positions: list[tuple[int, int]] = [],
) -> Option[str]:
    """Treat invalid schema, changed inputs and altered native bytes as cache misses before decoding a function."""
    match decode_record(text):
        Err(_) => return None
        Ok(record) =>
            if record.schema != 3 or record.inputs != inputs:
                return None
            match fingerprint([record.function]):
                Err(_) => return None
                Ok(digest) =>
                    if record.digest != digest:
                        return None
            mut payload = record.function
            if inputs[0] == RECORD_FUNCTION:
                if let Some(current) = span:
                    # Node ordinals take this body's positions; a body without those nodes is a miss.
                    match place_positions(payload, positions):
                        Err(_) => return None
                        Ok(placed) =>
                            match relocate_product(placed, str(current.file), current.line):
                                Ok(moved) => payload = moved
                                Err(_) => return None
            return Some(payload)


def valid_record(text: str, inputs: list[str]) -> bool:
    """Require a record to decode completely, binding each named declaration to its own ordinal."""
    match record_payload(text, inputs):
        None => return false
        Some(payload) =>
            match product_identities(payload):
                Err(_) => return false
                Ok(identities) =>
                    mut ordinals: list[NominalReference] = []
                    for ordinal in range(len(identities)):
                        ordinals.append(NominalReference(kind=identities[ordinal].kind, index=ordinal))
                    match decode_product(payload, ordinals):
                        Ok(_) => return true
                        Err(_) => return false


def decode_record(text: str) -> Result[ScalarRecord, JsonError]:
    """Pass the expected private record type to the native generic decoder through its result contract."""
    return from_str(text)


def decode_event(text: str) -> Result[ScalarRecordEvent, JsonError]:
    """Pass the expected request-local event type to the native generic decoder."""
    return from_str(text)


def scalar_path(directory: str, inputs: list[str]) -> Result[Path, str]:
    """Name a native product by the existing semantic digest owner's unambiguous framed serialization."""
    digest = fingerprint(inputs)?
    return Ok(Path(directory).joinpath(digest.replace("sha256:", "") + ".incnfunction"))


def fingerprint(inputs: list[str]) -> Result[str, str]:
    """Use the existing digest owner; these fingerprints never define a second declaration identity."""
    return semantic_digest(inputs).map_err((error) => str(error))


def publish_record(directory: str, inputs: list[str], text: str) -> Result[None, str]:
    """Publish one complete record with a process-local temporary name under the producer's locked build."""
    path = scalar_path(directory, inputs)?
    path.parent().mkdir(true, true).map_err((error) => f"cannot create scalar cache directory {error.message()}")?
    temporary = Path(f"{path.0}.{process_id()}.pending")
    temporary
        .write_text(text, "utf-8", "strict", None)
        .map_err((error) => f"cannot write scalar cache {error.message()}")?
    _ = temporary.replace(path).map_err((error) => f"cannot replace scalar cache {error.message()}")?
    return Ok(None)


def event_nodes(positions: list[tuple[int, int]]) -> list[EventPosition]:
    """Carry a body's node positions in a request-local event."""
    mut nodes: list[EventPosition] = []
    for position in positions:
        line, column = position
        nodes.append(EventPosition(line=line, column=column))
    return nodes
