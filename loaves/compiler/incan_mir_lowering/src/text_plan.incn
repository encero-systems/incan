"""Shared owned-text materialization for formatting and tuple lowering."""

from pub::incan_mir_plan import Place, PlanType, SourceSpan, Operand, RvalueKind
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, temporary, read_place, text_literal, forget_owned, drop_owned, external_call


pub def format_parts(
    mut builder: Builder,
    destination: Place,
    parts: list[str],
    values: list[Place],
    span: SourceSpan,
) -> None:
    """
    Call `incan_std_core::strings::fstring(&[&str], &[String])`, the helper the legacy route's f-strings use.

    The literal texts and the displayed values become two fixed-size arrays, borrowed as slices for the call. The
    value array takes ownership of the displayed strings and is dropped after the call.
    """
    literals = temporary(builder, PlanType.StrArray(len(parts)), span)
    mut texts: list[Operand] = []
    for part in parts:
        texts.append(text_literal(part, span))
    builder.emit(plan_assign(literals, RvalueKind.Array(texts), span))

    strings = temporary(builder, PlanType.StringArray(len(values)), span)
    mut operands: list[Operand] = []
    for value in values:
        operands.append(read_place(value, true, span))
        # Each displayed string moves into the array, so the array now owns it.
        forget_owned(builder, value.local)
    builder.emit(plan_assign(strings, RvalueKind.Array(operands), span))
    builder.owned.append(strings.local)

    # `&[T; N]` coerces to `&[T]`: borrow each array, then unsize the borrow into a slice.
    literal_reference = temporary(builder, PlanType.StrArrayRef(len(parts)), span)
    string_reference = temporary(builder, PlanType.StringArrayRef(len(values)), span)
    builder.emit(plan_assign(literal_reference, RvalueKind.Borrow(literals), span))
    builder.emit(plan_assign(string_reference, RvalueKind.Borrow(strings), span))
    literal_slice = temporary(builder, PlanType.StrSlice, span)
    string_slice = temporary(builder, PlanType.StringSlice, span)
    builder.emit(plan_assign(literal_slice, RvalueKind.UnsizeSlice(read_place(literal_reference, false, span)), span))
    builder.emit(plan_assign(string_slice, RvalueKind.UnsizeSlice(read_place(string_reference, false, span)), span))

    slices = [read_place(literal_slice, false, span), read_place(string_slice, false, span)]
    path = "incan_std_core::strings::fstring"
    external_call(builder, path, [PlanType.StrSlice, PlanType.StringSlice], PlanType.String, slices, destination, span)
    drop_owned(builder, strings.local, span)


pub def clone_text(mut builder: Builder, place: Place, span: SourceSpan) -> Result[Place, str]:
    """Clone a string local into a new owned string through the runtime, borrowing the original."""
    reference = temporary(builder, PlanType.StringRef, span)
    builder.emit(plan_assign(reference, RvalueKind.Borrow(place), span))
    result = temporary(builder, PlanType.String, span)
    path = "incan_native_runtime::clone_text"
    external_call(
        builder,
        path,
        [PlanType.StringRef],
        PlanType.String,
        [read_place(reference, false, span)],
        result,
        span,
    )
    return Ok(result)


pub def owned_literal(mut builder: Builder, text: str, span: SourceSpan) -> Place:
    """Allocate an owned string from literal text, through the same runtime concatenation the legacy route uses."""
    result = temporary(builder, PlanType.String, span)
    arguments = [text_literal(text, span), text_literal("", span)]
    path = "incan_std_core::strings::str_concat"
    external_call(builder, path, [PlanType.StrRef, PlanType.StrRef], PlanType.String, arguments, result, span)
    return result
