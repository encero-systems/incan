"""Generator consumers: `count`, `sum`, `fold`, `reduce`, `any`, `all`, `find` and `for_each` drain an owned generator."""

from pub::incan_mir_plan import Carrier
from pub::incan_mir_plan import CalleeKind, ExternalFunction, ListLeaf, Operand, Place, PlanType, SourceSpan
from frame import Builder, value_type, external_call, terminate_call
from generators import generator_shape, generator_element, generator_runtime_call
from generator_adapters import adapter_callable
from options import carrier_layout
from calls import instantiated_external_call
from table_views import borrowed_at
from rust::incan_lang::lang::surface::iterator_methods import IteratorMethodId as RustIteratorMethodId


pub def is_generator_consumer(method: RustIteratorMethodId) -> bool:
    """Report whether a checker-selected iterator operation drains its receiver into one value."""
    return method in [
        RustIteratorMethodId.Count,
        RustIteratorMethodId.Sum,
        RustIteratorMethodId.Fold,
        RustIteratorMethodId.Reduce,
        RustIteratorMethodId.Any,
        RustIteratorMethodId.All,
        RustIteratorMethodId.Find,
        RustIteratorMethodId.ForEach,
    ]


pub def consumer_result(method: RustIteratorMethodId, source: PlanType) -> PlanType:
    """Return the result a discarded consumer call still produces; `find`'s carrier comes from its destination."""
    if method in [RustIteratorMethodId.Any, RustIteratorMethodId.All]:
        return PlanType.Bool
    if method == RustIteratorMethodId.ForEach:
        return PlanType.Unit
    if method == RustIteratorMethodId.Sum and source == PlanType.Generator(ListLeaf.Float, 0):
        return PlanType.Float
    return PlanType.Int


pub def generator_consumer(
    mut builder: Builder,
    method: RustIteratorMethodId,
    source: Operand,
    arguments: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Drain the owned source through the runtime consumer, which legacy's own iterator protocol implements."""
    source_type = value_type(builder, source)?
    match generator_shape(source_type):
        Some((leaf, depth)) =>
            if source_type != PlanType.Generator(leaf, depth):
                return Err("unsupported Body IR borrowed generator consumer receiver")
            if method == RustIteratorMethodId.Count:
                if len(arguments) != 0:
                    return Err("invalid Body IR generator count arguments")
                element = generator_element(leaf, depth)
                require_result(builder, output, PlanType.Int)?
                generator_runtime_call(
                    builder,
                    "count_generator",
                    element,
                    [source_type],
                    PlanType.Int,
                    [source],
                    output,
                    span,
                )
                return Ok(None)
            if source_type == PlanType.Generator(ListLeaf.Str, 0) and method == RustIteratorMethodId.Any:
                return text_any(builder, source, source_type, arguments, output, span)
            if source_type == PlanType.Generator(ListLeaf.Float, 0) and method == RustIteratorMethodId.Sum:
                return float_sum(builder, source, source_type, arguments, output, span)
            if source_type != PlanType.Generator(ListLeaf.Int, 0):
                return Err("unsupported Body IR generator consumer element outside int")
            return int_consumer(builder, method, source, arguments, output, span)
        None => return Err("unsupported Body IR generator consumer receiver")


def float_sum(
    mut builder: Builder,
    source: Operand,
    source_type: PlanType,
    arguments: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Consume the float iterator through Rust's existing Sum implementation, preserving its order and empty identity."""
    if len(arguments) != 0:
        return Err("invalid Body IR generator sum arguments")
    require_result(builder, output, PlanType.Float)?
    return instantiated_external_call(
        builder,
        "core::iter::Sum::sum",
        [PlanType.Float, PlanType.Float, source_type],
        [source_type],
        PlanType.Float,
        [source],
        output,
        span,
    )


def text_any(
    mut builder: Builder,
    source: Operand,
    source_type: PlanType,
    arguments: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Drain text until a by-value callable accepts one item, preserving legacy short-circuit behavior."""
    if len(arguments) != 1:
        return Err("invalid Body IR generator any arguments")
    require_result(builder, output, PlanType.Bool)?
    signature = [PlanType.String, PlanType.Bool]
    callable = adapter_callable(builder, arguments[0], signature, span)?
    pointer = PlanType.FunctionPointer(signature)
    path = "incan_native_runtime::any_text_callable_generator"
    builder.externals.append(
        ExternalFunction(
            path=path,
            type_arguments=[pointer],
            parameters=[source_type, pointer],
            return_type=PlanType.Bool,
            span=span,
        ),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, [pointer]), [source, callable], output, span)
    return Ok(None)


def int_consumer(
    mut builder: Builder,
    method: RustIteratorMethodId,
    source: Operand,
    arguments: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Drain an integer generator; each function value takes its items by value, as legacy's callable ABI does."""
    generator = PlanType.Generator(ListLeaf.Int, 0)
    if method == RustIteratorMethodId.Sum:
        if len(arguments) != 0:
            return Err("invalid Body IR generator sum arguments")
        return consume(builder, "sum_int_generator", [generator], PlanType.Int, [source], output, span)
    if method in [RustIteratorMethodId.Fold, RustIteratorMethodId.Reduce]:
        return accumulate(builder, method, source, arguments, output, span)
    if len(arguments) != 1:
        return Err("invalid Body IR generator consumer arguments")
    mut returns = PlanType.Bool
    if method == RustIteratorMethodId.ForEach:
        returns = PlanType.Unit
    signature = [PlanType.Int, returns]
    callable = adapter_callable(builder, arguments[0], signature, span)?
    parameters = [generator, PlanType.FunctionPointer(signature)]
    if method == RustIteratorMethodId.Find:
        result = borrowed_at(builder.locals, output.local).ty
        _owner, declaration = carrier_layout(builder, result)?
        if declaration.carrier != Carrier.Option or declaration.variants[1].fields != [PlanType.Int]:
            return Err("unsupported Body IR generator find carrier")
        return consume(builder, "find_int_generator", parameters, result, [source, callable], output, span)
    return consume(
        builder,
        int_consumer_name(method)?,
        parameters,
        returns,
        [source, callable],
        output,
        span,
    )


def accumulate(
    mut builder: Builder,
    method: RustIteratorMethodId,
    source: Operand,
    arguments: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Combine the integer items from an initial value, as `fold` and `reduce` both do."""
    if len(arguments) != 2 or value_type(builder, arguments[0])? != PlanType.Int:
        return Err("unsupported Body IR generator accumulator arguments")
    signature = [PlanType.Int, PlanType.Int, PlanType.Int]
    combine = adapter_callable(builder, arguments[1], signature, span)?
    parameters = [PlanType.Generator(ListLeaf.Int, 0), PlanType.Int, PlanType.FunctionPointer(signature)]
    return consume(
        builder,
        accumulator_name(method)?,
        parameters,
        PlanType.Int,
        [source, arguments[0], combine],
        output,
        span,
    )


def int_consumer_name(method: RustIteratorMethodId) -> Result[str, str]:
    """Project one typed predicate consumer to its native runtime routine."""
    match method:
        RustIteratorMethodId.Any => return Ok("any_int_generator")
        RustIteratorMethodId.All => return Ok("all_int_generator")
        RustIteratorMethodId.ForEach => return Ok("for_each_int_generator")
        _ => return Err("unsupported Body IR integer generator consumer")


def accumulator_name(method: RustIteratorMethodId) -> Result[str, str]:
    """Project one typed accumulator consumer to its native runtime routine."""
    match method:
        RustIteratorMethodId.Fold => return Ok("fold_int_generator")
        RustIteratorMethodId.Reduce => return Ok("reduce_int_generator")
        _ => return Err("unsupported Body IR integer generator accumulator")


def consume(
    mut builder: Builder,
    name: str,
    parameters: list[PlanType],
    result: PlanType,
    operands: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Call one monomorphic runtime consumer into its checked destination."""
    require_result(builder, output, result)?
    external_call(builder, f"incan_native_runtime::{name}", parameters, result, operands, output, span)
    return Ok(None)


def require_result(mut builder: Builder, output: Place, result: PlanType) -> Result[None, str]:
    """Refuse a consumer whose checked destination does not hold the runtime result."""
    if borrowed_at(builder.locals, output.local).ty != result:
        return Err("unsupported Body IR generator consumer result type")
    return Ok(None)
