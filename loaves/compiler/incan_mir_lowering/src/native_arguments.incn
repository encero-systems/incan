"""Checked native storage uses that require source nominal ABI implementations."""

from rust::incan_semantics_core import IncanType as RustType, SymbolOrigin
from rust::incan_semantics_core::body_ir import BodyIrModule
from nominal_instances import instance_arguments
from decls import library_item
from table_views import borrowed_at


pub def native_argument_names(module: &BodyIrModule) -> Result[list[str], str]:
    """
    Collect, once per module, the source carrier names found in foreign Rust storage arguments. Each needs its source
    ABI implementations; an ordinary Loaf's generic ADT imposes no SDK trait ABI.
    """
    mut names: list[str] = []
    for position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, position)
        if library_item(declaration) == "":
            continue
        if not foreign_storage(declaration.canonical.origin):
            continue
        mut arguments: list[RustType] = []
        for argument in declaration.native_type_arguments:
            arguments.append(argument.clone())
        if len(arguments) == 0:
            arguments = instance_arguments(declaration)?
        for argument in arguments:
            collect_names(argument, names)
    return Ok(names)


def foreign_storage(origin: &SymbolOrigin) -> bool:
    """Distinguish an extracted Rust ADT from an Incan Loaf's compiled storage declaration."""
    match origin:
        SymbolOrigin.RustCrate(_path) => return true
        _ => return false


def collect_names(ty: &RustType, mut names: list[str]) -> None:
    """Record each named argument in a checked argument tree once; canonical qualification has resolved aliases."""
    match ty:
        RustType.Named(value) =>
            name = str(value)
            if name not in names:
                names.append(name)
        RustType.Generic(base=_base, args=arguments) =>
            for argument in arguments:
                collect_names(argument, names)
        _ => pass
