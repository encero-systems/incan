"""Source-body symbols for checker-selected nominal display methods."""

from rust::incan_semantics_core import IncanType as RustType, IncanPrimitiveType
from rust::incan_semantics_core::body_ir import BodyIrModule
from pub::incan_mir_plan import PlanType, EnumDeclaration, CalleeKind
from frame import DisplayFunction
from classes import frame_type, function_name
from layout_types import native_source_type


pub def display_functions(
    module: &BodyIrModule,
    intrinsics: list[EnumDeclaration],
) -> Result[list[DisplayFunction], str]:
    """Resolve only the retained selected identity with its exact shared receiver and string-returning signature."""
    mut functions: list[DisplayFunction] = []
    for owner in range(len(module.nominal_declarations)):
        declaration = module.nominal_declarations[owner]
        match declaration.display_method:
            None => pass
            Some(selected) =>
                for body in module.bodies:
                    if body.canonical != Some(selected.clone()) or len(body.type_parameters) != 0:
                        continue
                    if len(body.params) != 1 or len(body.locals) == 0:
                        continue
                    if not string_result(body.return_type):
                        continue
                    if frame_type(module, body.locals[0], intrinsics)? != PlanType.ModelRef(owner, str(declaration.name)):
                        continue
                    for retained in functions:
                        if retained.owner == owner:
                            return Err(f"unsupported Body IR ambiguous checked display body on {declaration.name}")
                    functions.append(
                        DisplayFunction(owner=owner, callee=CalleeKind.Planned(function_name(module, body))),
                    )
                mut native_display = false
                for delegation in module.loaf_callables:
                    if delegation.canonical != selected.clone():
                        continue
                    if len(delegation.type_parameters) != 0 or len(delegation.native_type_arguments) != 0:
                        continue
                    if len(delegation.parameters) != 1 or not string_result(delegation.return_type):
                        continue
                    receiver = native_source_type(
                        module.nominal_declarations,
                        module.enum_declarations,
                        [],
                        delegation.parameters[0],
                        intrinsics,
                    )?
                    if receiver != PlanType.ModelRef(owner, str(declaration.name)):
                        continue
                    match delegation.rust_path():
                        None => return Err("unsupported Body IR selected SDK display native identity")
                        Some(path) =>
                            if native_display:
                                return Err(f"unsupported Body IR ambiguous checked display body on {declaration.name}")
                            native_display = true
                            # One selected source body and its published native entry describe the same method.
                            # Prefer the checked body, but validate every native entry before choosing either form.
                            mut source_display = false
                            for retained in functions:
                                if retained.owner == owner:
                                    source_display = true
                            if not source_display:
                                functions.append(DisplayFunction(owner=owner, callee=CalleeKind.External(path)))
    return Ok(functions)


def string_result(ty: &RustType) -> bool:
    """Require the exact checked string result without permitting an implicit formatting conversion."""
    match ty:
        RustType.Primitive(IncanPrimitiveType.Str) => return true
        _ => return false
