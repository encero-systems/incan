"""Native value representations shared by primitive lowering and guarded call admission."""

from rust::incan_semantics_core import IncanPrimitiveType as Primitive
from pub::incan_mir_plan import PlanType, ListLeaf
from numerics import numeric_type, numeric_carrier


pub def static_method_result_type(ty: PlanType) -> bool:
    """
    Admit values that leave a static guard by value, including retained Option, Result and source enum carriers.
    Borrowed representations stay refused; the native adapter proves that retained payloads also outlive the guard.
    """
    if numeric_carrier(ty):
        return true
    match ty:
        (
            PlanType.Bool
            | PlanType.Unit
            | PlanType.String
            | PlanType.FunctionPointer(_)
            | PlanType.Model(_, _)
            | PlanType.Enum(_, _)
            | PlanType.List(_, _)
        ) => return true
        _ => return false


pub def primitive_type(primitive: &Primitive) -> Result[PlanType, str]:
    """Map the admitted primitive vocabulary once, including exact sized numeric carriers, and name every other primitive refusal."""
    match primitive:
        Primitive.Numeric(kind) => return numeric_type(kind)
        Primitive.Int => return Ok(PlanType.Int)
        Primitive.Float => return Ok(PlanType.Float)
        Primitive.Bool => return Ok(PlanType.Bool)
        Primitive.Unit => return Ok(PlanType.Unit)
        Primitive.Str => return Ok(PlanType.String)
        Primitive.FrozenStr => return Ok(PlanType.FrozenStr)
        Primitive.FrozenBytes => return Ok(PlanType.FrozenBytes)
        Primitive.Bytes => return Ok(PlanType.List(ListLeaf.U8, 1))
        _ => return Err(f"unsupported Body IR primitive type {primitive}")
