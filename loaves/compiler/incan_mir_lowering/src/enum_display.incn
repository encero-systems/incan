"""Native Rust enum formatting and checked derived Display for source enums."""

from rust::incan_semantics_core::body_ir import Operand as RustOperand
from rust::incan_semantics_core import SymbolOrigin
from pub::incan_mir_plan import PlanType, Place, Operand, SourceSpan, RvalueKind, ExternalFunction, CalleeKind
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, temporary, place_type, read_place, terminate_call
from lowering import scalar_place, runtime_text
from decls import library_enum_item


pub def display_enum_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Option[Place], str]:
    """Use native Display for foreign layouts and retained derived Display for whole source enums."""
    match native_enum_text(builder, value, false, span)?:
        Some(text) => return Ok(Some(text))
        None => pass
    match value:
        RustOperand.Place(read) =>
            if len(read.place.projection) != 0:
                return Ok(None)
            match read.place.local_id():
                None => return Ok(None)
                Some(_local) => pass
            place = scalar_place(builder, read.place, span)?
            ty = place_type(builder.locals, place)
            match ty:
                PlanType.Enum(owner, name) =>
                    if owner < 0 or owner >= len(builder.enums):
                        return Ok(None)
                    if library_enum_item(builder.enums[owner]) != "":
                        argument = enum_reference(builder, place, owner, name, span)
                        return Ok(Some(runtime_text(builder, "incan_native_runtime::display_value", argument, span)?))
                    if "Display" not in builder.enums[owner].derives:
                        return Ok(None)
                    return Ok(Some(borrowed_enum_debug(builder, place, ty, owner, name, span)?))
                _ => pass
        _ => pass
    return Ok(None)


pub def native_enum_text(
    mut builder: Builder,
    value: &RustOperand,
    debug: bool,
    span: SourceSpan,
) -> Result[Option[Place], str]:
    """Borrow an exact native enum for its Rust Display or Debug implementation; trait validation stays in rustc."""
    match value:
        RustOperand.Place(read) =>
            if len(read.place.projection) != 0 or read.place.local_id() == None:
                return Ok(None)
            place = scalar_place(builder, read.place, span)?
            mut argument = read_place(place, false, span)
            match place_type(builder.locals, place):
                PlanType.Enum(owner, name) =>
                    if not native_enum_owner(builder, owner):
                        return Ok(None)
                    argument = enum_reference(builder, place, owner, name, span)
                PlanType.EnumRef(owner, _name) =>
                    if not native_enum_owner(builder, owner):
                        return Ok(None)
                _ => return Ok(None)
            mut path = "incan_native_runtime::display_value"
            if debug:
                path = "incan_native_runtime::debug_value"
            return Ok(Some(runtime_text(builder, path, argument, span)?))
        _ => return Ok(None)


def native_enum_owner(builder: Builder, owner: int) -> bool:
    """Require an authenticated Rust enum layout, independently of compiled source enum aliases and their derives."""
    if owner < 0 or owner >= len(builder.enums) or library_enum_item(builder.enums[owner]) == "":
        return false
    match builder.enums[owner].canonical.origin:
        SymbolOrigin.RustCrate(_path) => return true
        _ => return false


def borrowed_enum_debug(
    mut builder: Builder,
    value: Place,
    ty: PlanType,
    owner: int,
    name: str,
    span: SourceSpan,
) -> Result[Place, str]:
    """Call the existing generic Debug runtime without cloning or consuming the enum's payload."""
    reference_type = PlanType.EnumRef(owner, name)
    argument = enum_reference(builder, value, owner, name, span)
    result = temporary(builder, PlanType.String, span)
    path = "incan_native_runtime::debug_model"
    builder.externals.append(
        ExternalFunction(
            path=path,
            type_arguments=[ty],
            parameters=[reference_type],
            return_type=PlanType.String,
            span=span,
        ),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, [ty]), [argument], result, span)
    builder.owned.append(result.local)
    return Ok(result)


def enum_reference(mut builder: Builder, value: Place, owner: int, name: str, span: SourceSpan) -> Operand:
    """Borrow the original enum storage for a native formatter without cloning or consuming its payload."""
    reference = temporary(builder, PlanType.EnumRef(owner, name), span)
    builder.emit(plan_assign(reference, RvalueKind.Borrow(value), span))
    return read_place(reference, false, span)
