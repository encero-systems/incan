"""Bind keyed native products to source declarations and closed specializations through their checked versions."""

from rust::incan_semantics_core::stable_identity import StableDeclarationId
from rust::incan_semantics_core::semantic_digest import semantic_digest, model_layout_witness, enum_layout_witness
from rust::incan_semantics_core import CanonicalSymbolId
from pub::incan_mir_plan import (
    EnumDeclaration,
    ExternalFunction,
    Function,
    NominalKind,
    NominalReference,
    ProductNominal,
    UnitNominals,
    describe_nominals,
    product_nominals,
    unit_nominals,
)
from pub::incan_mir_plan import encode_checked_layout
from std.encoding.hex import hexlify
from std.hash import sha256
from scalar_store import retain_scalar
from program_context import ProgramContext
from symbols import model_symbol
from table_views import borrowed_at


pub def product_nominal_table(
    program: &ProgramContext,
    intrinsics: &list[EnumDeclaration],
    products: Option[str],
) -> UnitNominals:
    """Describe the unit's tables only for a request that reads or retains plan products."""
    if products is None:
        models: list[ProductNominal] = []
        enums: list[ProductNominal] = []
        names: list[str] = []
        return unit_nominals(models, enums, names, list(names))
    return unit_product_nominals(program, intrinsics)


pub def unit_product_nominals(program: &ProgramContext, intrinsics: &list[EnumDeclaration]) -> UnitNominals:
    """
    Describe every model and enum position of the program's tables, then each intrinsic carrier at its carrier position.

    A declaration without a stable identity is described with an empty identity, which a product refuses to name.
    """
    nominals = program.nominals.as_ref()
    mut models: list[ProductNominal] = []
    mut model_names: list[str] = []
    for position in range(len(nominals)):
        declaration = borrowed_at(nominals, position)
        witness = model_layout_witness(declaration).map_err((error) => str(error))
        models.append(source_nominal(NominalKind.Model, declaration.canonical, witness))
        model_names.append(model_symbol(str(declaration.name)))
    enums = program.enums.as_ref()
    mut described: list[ProductNominal] = []
    mut enum_names: list[str] = []
    for position in range(len(enums)):
        declaration = borrowed_at(enums, position)
        carrier = str(declaration.carrier_name())
        witness = enum_layout_witness(declaration).map_err((error) => str(error))
        described.append(source_nominal(NominalKind.Enum, declaration.canonical, witness))
        enum_names.append(model_symbol(carrier))
    mut unit = unit_nominals(models, described, model_names, enum_names)
    sync_carriers(unit, program, intrinsics)
    return unit


pub def sync_carriers(mut unit: UnitNominals, program: &ProgramContext, intrinsics: &list[EnumDeclaration]) -> None:
    """Describe intrinsic carriers lowering admitted since the table was described, each at its carrier position."""
    while len(unit.carriers) < len(intrinsics):
        declaration = borrowed_at(intrinsics, len(unit.carriers))
        unit.append_carrier(carrier_nominal(declaration), declaration.name)


pub def retain_named_scalar(
    directory: str,
    inputs: list[str],
    function: &Function,
    runtime: &list[ExternalFunction],
    unit: &UnitNominals,
    positions: list[tuple[int, int]] = [],
    frames: list[Function] = [],
    requests: list[bytes] = [],
) -> Result[list[NominalReference], str]:
    """
    Retain a fresh product, with the helper frames and generic instance requests its lowering made, naming each model
    and enum it uses by declaration; return their current positions.
    """
    references = product_nominals(function, runtime, frames)?
    nominals = describe_nominals(references, unit)?
    retain_scalar(directory, inputs, function, runtime, nominals, positions, frames, requests)?
    return Ok(references)


def source_nominal(kind: NominalKind, canonical: &CanonicalSymbolId, witness: Result[tuple[str, str], str]) -> ProductNominal:
    """Combine the existing stable declaration identity with its closed specialization and complete checked version."""
    unnamed = ProductNominal(kind=kind, identity="", digest="")
    match StableDeclarationId.from_canonical(canonical, None, None):
        None => return unnamed
        Some(stable) =>
            match witness:
                Err(_) => return unnamed
                Ok(item) =>
                    specialization, version = item
                    return ProductNominal(kind=kind, identity=f"{stable.render_compact()}#{specialization}", digest=version)


pub def carrier_nominal(declaration: &EnumDeclaration) -> ProductNominal:
    """
    Name a standard carrier by the checked type it lays out; its variants and derives are its checked meaning.

    The native name numbers carriers in admission order, which another module's types change, so it never names one.
    A carrier without an encodable checked type stays unnamed, and a product refuses to name it.
    """
    match carrier_type_text(declaration):
        Err(_) => return ProductNominal(kind=NominalKind.Enum, identity="", digest="")
        Ok(text) =>
            mut meaning: list[str] = [text]
            for variant in declaration.variants:
                meaning.append(f"{variant.name}/{len(variant.fields)}")
            for derive in declaration.derives:
                meaning.append(derive)
            match semantic_digest(meaning):
                Ok(digest) => return ProductNominal(kind=NominalKind.Enum, identity=f"carrier#{text}", digest=digest)
                Err(_) => return ProductNominal(kind=NominalKind.Enum, identity="", digest="")


def carrier_type_text(declaration: &EnumDeclaration) -> Result[str, str]:
    """Encode the exact checked type a carrier lays out; its nominal names carry no source span."""
    match declaration.semantic_key:
        None => return Err("carrier has no checked type")
        Some(key) =>
            stored = encode_checked_layout(key.clone())?
            return Ok("sha256:" + hexlify(sha256.digest(stored)))
