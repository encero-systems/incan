"""Canonical scalar conversion admission, with legacy Rust cast semantics."""

from pub::incan_mir_plan import Operand, PlanType, RvalueKind, Constant, SizedNumeric
from rust::incan_semantics_core import NumericTypeId
from rust::incan_semantics_core::body_ir import TypedNumericConstant


pub def integer_conversion(value: Operand, ty: PlanType) -> Result[RvalueKind, str]:
    """Preserve truncating, saturating float casts and boolean zero/one conversion."""
    match ty:
        PlanType.Int => return Ok(RvalueKind.Use(value))
        PlanType.Float => return Ok(RvalueKind.FloatToInt(value))
        PlanType.Bool => return Ok(RvalueKind.BoolToInt(value))
        PlanType.String => return Err("unsupported Body IR Int string parsing")
        _ => return Err("unsupported Body IR Int input type")


pub def float_conversion(value: Operand, ty: PlanType) -> Result[RvalueKind, str]:
    """Admit legacy numeric carriers; bool-to-float stays refused because legacy Rust emission rejects it."""
    match ty:
        PlanType.Int => return Ok(RvalueKind.IntToFloat(value))
        PlanType.Float => return Ok(RvalueKind.Use(value))
        PlanType.String => return Err("unsupported Body IR Float string parsing")
        _ => return Err("unsupported Body IR Float input type")


pub def numeric_type(kind: &NumericTypeId) -> Result[PlanType, str]:
    """Translate the checker-owned numeric identity without decoding display spellings."""
    match kind:
        NumericTypeId.I8 => return Ok(PlanType.I8)
        NumericTypeId.I16 => return Ok(PlanType.I16)
        NumericTypeId.I32 => return Ok(PlanType.I32)
        NumericTypeId.I128 => return Ok(PlanType.I128)
        NumericTypeId.U8 => return Ok(PlanType.U8)
        NumericTypeId.U16 => return Ok(PlanType.U16)
        NumericTypeId.U32 => return Ok(PlanType.U32)
        NumericTypeId.U64 => return Ok(PlanType.U64)
        NumericTypeId.U128 => return Ok(PlanType.U128)
        NumericTypeId.F32 => return Ok(PlanType.F32)
        NumericTypeId.F64 => return Ok(PlanType.F64)
        NumericTypeId.ISize => return Ok(PlanType.ISize)
        NumericTypeId.USize => return Ok(PlanType.USize)
        NumericTypeId.I64 => return Ok(PlanType.Int)
        NumericTypeId.Bool => return Err("unsupported Body IR numeric carrier bool")


pub def numeric_constant(value: &TypedNumericConstant) -> Result[Constant, str]:
    """Retain exact integer digits and IEEE bits without a host-width conversion."""
    match value:
        TypedNumericConstant.Signed(kind=kind, value=number) =>
            return Ok(Constant.Numeric(str(number), numeric_type(kind)?))
        TypedNumericConstant.Unsigned(kind=kind, value=number) =>
            return Ok(Constant.Numeric(str(number), numeric_type(kind)?))
        TypedNumericConstant.F32(bits=bits) => return Ok(Constant.Numeric(str(bits), PlanType.F32))
        TypedNumericConstant.F64(bits=bits) => return Ok(Constant.Numeric(str(bits), PlanType.F64))
        _ => return Err("unsupported Body IR decimal constant")


pub def sized_numeric(ty: PlanType) -> Option[SizedNumeric]:
    """Retain the named carrier when a scalar has a sized numeric representation."""
    match ty:
        PlanType.I8 => return Some(SizedNumeric.I8)
        PlanType.I16 => return Some(SizedNumeric.I16)
        PlanType.I32 => return Some(SizedNumeric.I32)
        PlanType.I128 => return Some(SizedNumeric.I128)
        PlanType.U8 => return Some(SizedNumeric.U8)
        PlanType.U16 => return Some(SizedNumeric.U16)
        PlanType.U32 => return Some(SizedNumeric.U32)
        PlanType.U64 => return Some(SizedNumeric.U64)
        PlanType.U128 => return Some(SizedNumeric.U128)
        PlanType.F32 => return Some(SizedNumeric.F32)
        PlanType.F64 => return Some(SizedNumeric.F64)
        PlanType.ISize => return Some(SizedNumeric.ISize)
        PlanType.USize => return Some(SizedNumeric.USize)
        _ => return None


pub def has_sized_numeric(ty: PlanType) -> bool:
    """Recognize a sized carrier through the same canonical admission mapping."""
    match sized_numeric(ty):
        Some(_kind) => return true
        None => return false


pub def sized_plan_type(kind: SizedNumeric) -> PlanType:
    """Recover the scalar plan type carried by a sized overflow pair."""
    match kind:
        SizedNumeric.I8 => return PlanType.I8
        SizedNumeric.I16 => return PlanType.I16
        SizedNumeric.I32 => return PlanType.I32
        SizedNumeric.I128 => return PlanType.I128
        SizedNumeric.U8 => return PlanType.U8
        SizedNumeric.U16 => return PlanType.U16
        SizedNumeric.U32 => return PlanType.U32
        SizedNumeric.U64 => return PlanType.U64
        SizedNumeric.U128 => return PlanType.U128
        SizedNumeric.F32 => return PlanType.F32
        SizedNumeric.F64 => return PlanType.F64
        SizedNumeric.ISize => return PlanType.ISize
        SizedNumeric.USize => return PlanType.USize


pub def numeric_name(ty: PlanType) -> str:
    """Name the matching monomorphic legacy-runtime boundary."""
    match ty:
        PlanType.I8 => return "i8"
        PlanType.I16 => return "i16"
        PlanType.I32 => return "i32"
        PlanType.I128 => return "i128"
        PlanType.U8 => return "u8"
        PlanType.U16 => return "u16"
        PlanType.U32 => return "u32"
        PlanType.U64 => return "u64"
        PlanType.U128 => return "u128"
        PlanType.F32 => return "f32"
        PlanType.F64 => return "f64"
        PlanType.ISize => return "isize"
        PlanType.USize => return "usize"
        _ => return ""


pub def sized_integer(ty: PlanType) -> bool:
    """Distinguish width-specific integers from exact floating carriers."""
    return has_sized_numeric(ty) and ty != PlanType.F32 and ty != PlanType.F64


pub def sized_signed_integer(ty: PlanType) -> bool:
    """Select only the carriers admitting overflow-checked unary negation."""
    return ty == PlanType.I8 or ty == PlanType.I16 or ty == PlanType.I32 or ty == PlanType.I128 or ty == PlanType.ISize


pub def numeric_carrier(ty: PlanType) -> bool:
    """Recognize ordinary and sized numeric carriers at checked assignment boundaries."""
    return has_sized_numeric(ty) or ty == PlanType.Int or ty == PlanType.Float


pub def is_float_constant(value: &TypedNumericConstant) -> bool:
    """Report whether a typed numeric literal is one of the float carriers."""
    match value:
        TypedNumericConstant.F32(bits=_bits) => return true
        TypedNumericConstant.F64(bits=_bits) => return true
        _ => return false
