"""
Separate plan products from their source positions, and relocate products without lowering their bodies again.

A product's spans are owner-relative, and each span that locates a Body IR node is stored as that node's ordinal. The
body's position map, its nodes' owner-relative lines and columns, is a request-local fact: a comment or docstring that
moves lines inside a body changes the map, never the product.
"""

from pub::incan_mir_plan import transform_product_positions, PositionChange, WirePositions


pub def relocate_product(encoded: bytes, file: str, line: int) -> Result[bytes, str]:
    """Translate every typed function, frame and runtime span together."""
    return transform_product_positions(encoded, WirePositions(change=PositionChange.Relocate("", 0, file, line)))


pub def index_positions(encoded: bytes, positions: &list[tuple[int, int]]) -> Result[bytes, str]:
    """Replace each known source coordinate by its first Body IR node ordinal."""
    mut ordinals: dict[str, int] = {}
    for index in range(len(positions)):
        line, column = positions[index]
        key = f"{line}:{column}"
        if key not in ordinals:
            ordinals[key] = index
    return transform_product_positions(encoded, WirePositions(change=PositionChange.Index(ordinals)))


pub def place_positions(encoded: bytes, positions: &list[tuple[int, int]]) -> Result[bytes, str]:
    """Place the stable node ordinals of an admitted product at this revision's coordinates."""
    return transform_product_positions(encoded, WirePositions(change=PositionChange.Place(list(positions))))
