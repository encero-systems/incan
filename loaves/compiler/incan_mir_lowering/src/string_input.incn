"""Owned String ingress frames shared by checked reconstruction and raw source conversions."""

from rust::incan_semantics_core::body_ir import BodyIrModule
from rust::incan_semantics_core import IncanType as RustType
# Keep inferred empty Builder field element types in scope until #2010 is resolved.
from pub::incan_mir_plan import BasicBlock, Local, PlanType, EnumDeclaration, ExternalFunction, Function, SourceSpan
from frame import Builder
from program_context import synthetic_program_context


pub def owned_string_frame(
    module: &BodyIrModule,
    name: str,
    result: PlanType,
    mut intrinsics: list[EnumDeclaration],
    span: SourceSpan,
) -> Builder:
    """Keep the sole input owned until a planned call or construction consumes it, with one local cleanup ledger."""
    empty_unions: list[RustType] = []
    empty_type_arguments: list[RustType] = []
    mut builder = Builder(
        program=synthetic_program_context(module),
        locals=[Local(ty=result, span=span), Local(ty=PlanType.String, span=span)],
        parameter_count=1,
        blocks=[],
        current=0,
        source="",
        file=span.file,
        module_identity=str(module.module_id.path()),
        callable_identity=None,
        loops=[],
        loop_owners=[],
        externals=[],
        owned=[1],
        closed=[],
        iterators=[],
        borrowed_items=[],
        in_place_items=[],
        partial_callables=[],
        scalar_closures=[],
        unproven_closures=[],
        unions=empty_unions,
        local_offset=0,
        consuming_closure_frame=false,
        intrinsics=list(intrinsics),
        generator_handle=-1,
        instances=[],
        type_parameters=[],
        type_arguments=empty_type_arguments,
        function_pointer_locals=[],
        name=name,
        synthesized=[],
        moved_tuple_fields=[],
    )
    _ = builder.new_block(span)
    return builder
