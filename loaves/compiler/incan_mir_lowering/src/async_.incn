"""Owned native future construction, suspension and canonical executor entry."""

from rust::incan_semantics_core import IncanType as RustType, IncanPrimitiveType as Primitive, SemanticSourceTargetKind
from rust::incan_semantics_core::body_ir import BodyIrModule, Body
from pub::incan_mir_plan import (
    PlanType,
    EnumDeclaration,
    Function,
    ExternalFunction,
    Local,
    Parameter,
    BasicBlock,
    SourceSpan,
    Statement,
    Place,
    Operand,
    TerminatorKind,
    Unwind,
    Callee,
    CalleeKind,
)
from pub::incan_mir_plan import place as plan_place, block as plan_block
from classes import function_name, frame_type, is_program_entry
from layout_types import native_source_type
from unions import collect_unions
from frame import (
    Builder,
    read_place,
    forget_moved_arguments,
    forget_owned,
    terminate_call,
    drop_all_owned,
    cleanup_exit,
)
from models import place_type


pub def is_future(ty: PlanType) -> bool:
    """Identify owned pinned future storage independently of its retained output layout."""
    match ty:
        PlanType.Future(_output) => return true
        _ => return false


pub def future_type(
    module: &BodyIrModule,
    ty: &RustType,
    mut intrinsics: list[EnumDeclaration],
) -> Result[Option[PlanType], str]:
    """Use the same retained output ABI for source and SDK futures; construction identity stays with the call."""
    match ty:
        RustType.Generic(base=base, args=args) =>
            if str(base) != "Awaitable":
                return Ok(None)
            if len(args) != 1:
                return Err("unsupported Body IR async future output arity")
            return Ok(
                Some(
                    native_source_type(
                        list(module.nominal_declarations),
                        list(module.enum_declarations),
                        collect_unions(module),
                        ty,
                        intrinsics,
                    )?,
                ),
            )
        _ => return Ok(None)


pub def evaluator_name(module: &BodyIrModule, body: &Body) -> str:
    """Separate coroutine and integer main bodies from their process entry and construction shims."""
    name = function_name(module, body)
    if body.is_async:
        return f"__incan_async_body_{name}"
    if is_program_entry(module, body) and body.return_type == RustType.Primitive(Primitive.Int):
        return f"__incan_integer_{name}"
    return name


def capture_types(module: &BodyIrModule, body: &Body, mut intrinsics: list[EnumDeclaration]) -> Result[list[PlanType], str]:
    """Retain owned captures and at most one nominal loan, whose lifetime the native boxing constructor preserves."""
    mut fields: list[PlanType] = []
    mut loans = 0
    mut nominals = module.nominal_declarations
    mut enums = module.enum_declarations
    for parameter in body.params:
        ty = frame_type(nominals, enums, body.locals[int(parameter.local.index())], intrinsics)?
        match ty:
            PlanType.ModelRef(_owner, _name) => loans += 1
            PlanType.ModelMutRef(_owner, _name) => loans += 1
            PlanType.List(_leaf, _depth) => return Err("unsupported Body IR async borrowed list capture")
            PlanType.Set(_leaf) => return Err("unsupported Body IR async borrowed set capture")
            PlanType.Dict(_key, _value) => return Err("unsupported Body IR async borrowed dictionary capture")
            _ => pass
        if parameter.mutable and ty == PlanType.String:
            return Err("unsupported Body IR async mutable string capture")
        fields.append(ty)
    if loans > 1:
        return Err("unsupported Body IR async future with multiple borrowed captures")
    return Ok(fields)


pub def validate_futures(module: &BodyIrModule, mut intrinsics: list[EnumDeclaration]) -> Result[None, str]:
    """Validate source coroutine identities and captures before native storage is selected by rustc."""
    for body in module.bodies:
        if not body.is_async:
            continue
        match body.canonical:
            Some(identity) =>
                if identity.kind != SemanticSourceTargetKind.Function and identity.kind != SemanticSourceTargetKind.Method:
                    return Err("unsupported Body IR async callable identity")
            None => return Err("unsupported Body IR async body without canonical identity")
        if len(body.type_parameters) == 0:
            _ = capture_types(module, body, intrinsics)?
    return Ok(None)


pub def construct_boxed_future(
    mut builder: Builder,
    callee: CalleeKind,
    types: list[PlanType],
    output: PlanType,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Construct a source or SDK future now and pin it, preserving deferred body execution and native obligations."""
    name = f"__incan_future_ctor_{builder.name}_{len(builder.synthesized)}"
    builder.synthesized.append(boxed_future_constructor(name, callee, types, output, span))
    forget_moved_arguments(builder, arguments)
    terminate_call(builder, CalleeKind.Planned(name), arguments, destination, span)
    builder.owned.append(destination.local)
    return Ok(None)


pub def boxed_future_constructor(
    name: str,
    callee: CalleeKind,
    types: list[PlanType],
    output: PlanType,
    span: SourceSpan,
) -> Function:
    """Retain one exact boxed-future ABI for both call-site shims and a library's exported async constructor."""
    result = PlanType.Future([output])
    mut parameters: list[Parameter] = []
    mut locals = [Local(ty=result, span=span)]
    for index in range(len(types)):
        parameters.append(Parameter(name=f"capture{index}", ty=types[index], span=span))
        locals.append(Local(ty=types[index], span=span))
    return Function(
        name=name,
        parameters=parameters,
        return_type=result,
        locals=locals,
        blocks=[plan_block([], TerminatorKind.Unreachable, span)],
        span=span,
        future_callee=Some(Callee(kind=callee, span=span)),
    )


pub def construct_future(
    module: &BodyIrModule,
    mut builder: Builder,
    body: &Body,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Capture evaluated arguments by value and return a native coroutine without polling its body."""
    if str(body.name) == "main":
        return Err("unsupported Body IR calling async main")
    fields = capture_types(module, body, builder.intrinsics)?
    output = native_source_type(
        list(module.nominal_declarations),
        list(module.enum_declarations),
        collect_unions(module),
        body.return_type,
        builder.intrinsics,
    )?
    return construct_boxed_future(
        builder,
        CalleeKind.Planned(evaluator_name(module, body)),
        fields,
        output,
        arguments,
        destination,
        span,
    )


pub def await_future(
    module: &BodyIrModule,
    mut builder: Builder,
    future: Place,
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Retain a native suspension and an explicit cancellation edge; the adapter emits only the pinned poll plumbing."""
    # The checked suspension already retains its output. Rustc validates the native Future obligation and exact poll output.
    incoming = builder.owned
    current = builder.current
    cancelled = builder.new_block(span)
    builder.current = cancelled
    drop_all_owned(builder, span)
    builder.finish(TerminatorKind.CoroutineDrop, span)
    builder.current = current
    builder.owned = incoming
    after = builder.new_block(span)
    unwind = Unwind.Cleanup(cleanup_exit(builder, span))
    forget_owned(builder, future.local)
    match place_type(builder.locals, destination):
        PlanType.String => builder.owned.append(destination.local)
        PlanType.Future(_output) => builder.owned.append(destination.local)
        PlanType.Enum(_owner, _name) => builder.owned.append(destination.local)
        PlanType.Model(_owner, _name) => builder.owned.append(destination.local)
        PlanType.List(_leaf, _depth) => builder.owned.append(destination.local)
        PlanType.Set(_leaf) => builder.owned.append(destination.local)
        PlanType.Dict(_key, _value) => builder.owned.append(destination.local)
        _ => pass
    drop_unwind = Unwind.Cleanup(cleanup_exit(builder, span))
    builder.finish(TerminatorKind.Await(future, destination, after, cancelled, unwind, drop_unwind), span)
    builder.current = after
    return Ok(None)


pub def integer_entry(body: Function, entry_name: str) -> Function:
    """Run the checked integer main for its effects; its value is program metadata, never the process exit code."""
    span = body.span
    return Function(
        name=entry_name,
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=span), Local(ty=body.return_type, span=span)],
        blocks=[plan_block(
            [],
            TerminatorKind.Call(
                Callee(kind=CalleeKind.Planned(body.name), span=span),
                [],
                plan_place(1, span),
                1,
                Unwind.Continue,
            ),
            span,
        ), plan_block([], TerminatorKind.Return, span)],
        span=span,
    )


pub def async_test_name(native: str) -> str:
    """Name the synchronous function that drives one async test's coroutine for the native test harness."""
    return f"__incan_test_{native}"


pub def async_entry(
    module: &BodyIrModule,
    body: Function,
    mut intrinsics: list[EnumDeclaration],
    entry_name: str,
) -> Result[tuple[Function, Function, ExternalFunction], str]:
    """
    Return the coroutine's checked output through the native function `entry_name`, preserving Result termination
    after executor setup: `main` for a program, the test wrapper for an async test.
    """
    span = body.span
    future = PlanType.Future([body.return_type])
    constructor = boxed_future_constructor(
        f"__incan_{entry_name}_future",
        CalleeKind.Planned(body.name),
        [],
        body.return_type,
        span,
    )
    mut path = "incan_native_runtime::run_future_entry"
    mut arguments = [future]
    if body.return_type != PlanType.Unit:
        match body.return_type:
            PlanType.Enum(owner, _name) =>
                index = owner - len(module.enum_declarations)
                if index < 0 or index >= len(intrinsics):
                    return Err("unsupported Body IR async main outside a standard Result")
                declaration = intrinsics[index]
                if declaration.carrier != "Result" or len(declaration.variants) != 2:
                    return Err("unsupported Body IR async main outside a standard Result")
                errors = declaration.variants[1].fields
                if len(errors) != 1:
                    return Err("unsupported Body IR async main error arity")
                arguments = [errors[0], future]
                path = "incan_native_runtime::run_result_future_entry"
            _ => return Err("unsupported Body IR async main output")
    entry = Function(
        name=entry_name,
        parameters=[],
        return_type=body.return_type,
        locals=[Local(ty=body.return_type, span=span), Local(ty=future, span=span)],
        blocks=[plan_block(
            [],
            TerminatorKind.Call(
                Callee(kind=CalleeKind.Planned(constructor.name), span=span),
                [],
                plan_place(1, span),
                1,
                Unwind.Continue,
            ),
            span,
        ), plan_block(
            [],
            TerminatorKind.Call(
                Callee(kind=CalleeKind.Instantiated(path, arguments), span=span),
                [read_place(plan_place(1, span), true, span)],
                plan_place(0, span),
                2,
                Unwind.Continue,
            ),
            span,
        ), plan_block([], TerminatorKind.Return, span)],
        span=span,
    )
    external = ExternalFunction(
        path=path,
        type_arguments=arguments,
        parameters=[future],
        return_type=body.return_type,
        span=span,
    )
    return Ok((entry, constructor, external))
