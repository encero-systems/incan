"""Owned native future construction, suspension and canonical executor entry."""

from rust::incan_semantics_core import IncanType as RustType, SemanticSourceTargetKind
from rust::incan_semantics_core::body_ir import BodyIrModule, Body
from pub::incan_mir_plan import (
    PlanType,
    EnumDeclaration,
    Function,
    ExternalFunction,
    Local,
    Parameter,
    BasicBlock,
    SourceSpan,
    Statement,
    Place,
    Operand,
    TerminatorKind,
    Unwind,
    Callee,
    CalleeKind,
)
from pub::incan_mir_plan import place as plan_place, block as plan_block
from classes import function_name, frame_type
from layout_types import native_source_type
from unions import collect_unions
from frame import (
    Builder,
    read_place,
    forget_moved_arguments,
    forget_owned,
    terminate_call,
    drop_all_owned,
    cleanup_exit,
)
from models import place_type
from decls import library_item


pub def is_future(ty: PlanType) -> bool:
    """Identify owned pinned future storage independently of its retained output layout."""
    match ty:
        PlanType.Future(_output) => return true
        _ => return false


pub def future_type(
    module: &BodyIrModule,
    ty: &RustType,
    intrinsics: list[EnumDeclaration],
) -> Result[Option[PlanType], str]:
    """Use the same retained output ABI for source and SDK futures; construction identity stays with the call."""
    match ty:
        RustType.Generic(base=base, args=args) =>
            if str(base) != "Awaitable":
                return Ok(None)
            if len(args) != 1:
                return Err("unsupported Body IR async future output arity")
            return Ok(
                Some(
                    native_source_type(
                        module.nominal_declarations,
                        module.enum_declarations,
                        collect_unions(module),
                        ty,
                        intrinsics,
                    )?,
                ),
            )
        _ => return Ok(None)


pub def evaluator_name(module: &BodyIrModule, body: &Body) -> str:
    """Separate native coroutine bodies from synchronous process entry and construction shims."""
    name = function_name(module, body)
    if body.is_async:
        return f"__incan_async_body_{name}"
    return name


def capture_types(module: &BodyIrModule, body: &Body, intrinsics: list[EnumDeclaration]) -> Result[list[PlanType], str]:
    """Retain owned captures only; source borrows require an explicit future lifetime and remain refused."""
    mut fields: list[PlanType] = []
    for parameter in body.params:
        ty = frame_type(module, body.locals[int(parameter.local.index())], intrinsics)?
        match ty:
            PlanType.ModelRef(_owner, _name) => return Err("unsupported Body IR async borrowed receiver capture")
            PlanType.ModelMutRef(_owner, _name) => return Err("unsupported Body IR async mutable receiver capture")
            PlanType.List(_leaf, _depth) => return Err("unsupported Body IR async borrowed list capture")
            PlanType.Set(_leaf) => return Err("unsupported Body IR async borrowed set capture")
            PlanType.Dict(_key, _value) => return Err("unsupported Body IR async borrowed dictionary capture")
            _ => pass
        if parameter.mutable and ty == PlanType.String:
            return Err("unsupported Body IR async mutable string capture")
        fields.append(ty)
    return Ok(fields)


pub def validate_futures(module: &BodyIrModule, intrinsics: list[EnumDeclaration]) -> Result[None, str]:
    """Validate source coroutine identities and captures before native storage is selected by rustc."""
    for body in module.bodies:
        if not body.is_async:
            continue
        match body.canonical:
            Some(identity) =>
                if identity.kind != SemanticSourceTargetKind.Function:
                    return Err("unsupported Body IR async method future")
            None => return Err("unsupported Body IR async body without canonical identity")
        if len(body.type_parameters) == 0:
            _ = capture_types(module, body, intrinsics)?
    return Ok(None)


pub def construct_boxed_future(
    mut builder: Builder,
    callee: CalleeKind,
    types: list[PlanType],
    output: PlanType,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Construct a source or SDK future now and pin it, preserving deferred body execution and native obligations."""
    name = f"__incan_future_ctor_{builder.name}_{len(builder.synthesized)}"
    result = PlanType.Future([output])
    mut parameters: list[Parameter] = []
    mut locals = [Local(ty=result, span=span)]
    for index in range(len(types)):
        parameters.append(Parameter(name=f"capture{index}", ty=types[index], span=span))
        locals.append(Local(ty=types[index], span=span))
    builder.synthesized.append(
        Function(
            name=name,
            parameters=parameters,
            return_type=result,
            locals=locals,
            blocks=[plan_block([], TerminatorKind.Unreachable, span)],
            span=span,
            future_callee=Some(Callee(kind=callee, span=span)),
        ),
    )
    forget_moved_arguments(builder, arguments)
    terminate_call(builder, CalleeKind.Planned(name), arguments, destination, span)
    builder.owned.append(destination.local)
    return Ok(None)


pub def construct_future(
    module: &BodyIrModule,
    mut builder: Builder,
    body: &Body,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Capture evaluated arguments by value and return a native coroutine without polling its body."""
    if str(body.name) == "main":
        return Err("unsupported Body IR calling async main")
    fields = capture_types(module, body, builder.intrinsics)?
    output = native_source_type(
        module.nominal_declarations,
        module.enum_declarations,
        collect_unions(module),
        body.return_type,
        builder.intrinsics,
    )?
    return construct_boxed_future(
        builder,
        CalleeKind.Planned(evaluator_name(module, body)),
        fields,
        output,
        arguments,
        destination,
        span,
    )


pub def await_future(
    module: &BodyIrModule,
    mut builder: Builder,
    future: Place,
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Retain a native suspension and an explicit cancellation edge; the adapter emits only the pinned poll plumbing."""
    match place_type(builder.locals, future):
        PlanType.Future(_output) => pass
        PlanType.Model(owner, _name) =>
            if owner < 0 or owner >= len(module.nominal_declarations):
                return Err("unsupported Body IR Await without a retained native future")
            if library_item(module.nominal_declarations[owner]) != "incan_std_async::task::JoinHandle":
                return Err("unsupported Body IR Await without a retained native future")
        _ => return Err("unsupported Body IR Await without a retained native future")
    incoming = builder.owned
    current = builder.current
    cancelled = builder.new_block(span)
    builder.current = cancelled
    drop_all_owned(builder, span)
    builder.finish(TerminatorKind.CoroutineDrop, span)
    builder.current = current
    builder.owned = incoming
    after = builder.new_block(span)
    unwind = Unwind.Cleanup(cleanup_exit(builder, span))
    forget_owned(builder, future.local)
    match place_type(builder.locals, destination):
        PlanType.String => builder.owned.append(destination.local)
        PlanType.Future(_output) => builder.owned.append(destination.local)
        PlanType.Enum(_owner, _name) => builder.owned.append(destination.local)
        PlanType.Model(_owner, _name) => builder.owned.append(destination.local)
        PlanType.List(_leaf, _depth) => builder.owned.append(destination.local)
        PlanType.Set(_leaf) => builder.owned.append(destination.local)
        PlanType.Dict(_key, _value) => builder.owned.append(destination.local)
        _ => pass
    drop_unwind = Unwind.Cleanup(cleanup_exit(builder, span))
    builder.finish(TerminatorKind.Await(future, destination, after, cancelled, unwind, drop_unwind), span)
    builder.current = after
    return Ok(None)


pub def async_entry(body: Function) -> tuple[Function, Function, ExternalFunction]:
    """Run the planned main coroutine through the same SDK executor and runtime initialization boundary as legacy."""
    span = body.span
    future = PlanType.Future([PlanType.Unit])
    constructor = Function(
        name="__incan_main_future",
        parameters=[],
        return_type=future,
        locals=[Local(ty=future, span=span)],
        blocks=[plan_block([], TerminatorKind.Unreachable, span)],
        span=span,
        future_callee=Some(Callee(kind=CalleeKind.Planned(body.name), span=span)),
    )
    path = "incan_native_runtime::run_future_entry"
    entry = Function(
        name="main",
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=span), Local(ty=future, span=span)],
        blocks=[plan_block(
            [],
            TerminatorKind.Call(
                Callee(kind=CalleeKind.Planned(constructor.name), span=span),
                [],
                plan_place(1, span),
                1,
                Unwind.Continue,
            ),
            span,
        ), plan_block(
            [],
            TerminatorKind.Call(
                Callee(kind=CalleeKind.Instantiated(path, [future]), span=span),
                [read_place(plan_place(1, span), true, span)],
                plan_place(0, span),
                2,
                Unwind.Continue,
            ),
            span,
        ), plan_block([], TerminatorKind.Return, span)],
        span=span,
    )
    external = ExternalFunction(
        path=path,
        type_arguments=[future],
        parameters=[future],
        return_type=PlanType.Unit,
        span=span,
    )
    return (entry, constructor, external)
