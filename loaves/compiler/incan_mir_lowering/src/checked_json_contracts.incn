"""Exact checked serde hook contracts closed from retained nominal and Body facts."""

from rust::incan_semantics_core import (
    IncanType as RustType,
    IncanPrimitiveType as Primitive,
    RuntimeBuiltinType,
    SemanticSourceTargetKind,
    CanonicalSymbolId,
)
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    Body,
    NominalDeclaration,
    NewtypeDeserialize,
    CallableParamDefault,
    LocalOrigin,
)
from nominal_instances import NominalInstance, nominal_symbol
from symbols import symbol_component
from type_parameters import instantiate


pub def checked_deserialize_name(declaration: &NominalDeclaration) -> Result[str, str]:
    """Name a root only for an explicit checked string reconstruction; absent selection never becomes ordinary serde."""
    deserialize = "serde::Deserialize" in declaration.derives
    match declaration.newtype_deserialize:
        NewtypeDeserialize.Unselected =>
            if deserialize:
                return Err("unsupported Body IR newtype Deserialize without retained reconstruction selection")
            return Ok("")
        NewtypeDeserialize.Ordinary =>
            if not deserialize:
                return Err("unsupported Body IR ordinary newtype Deserialize without derive selection")
            return Ok("")
        NewtypeDeserialize.Checked(_hook) =>
            if (
                not deserialize
                or len(declaration.field_types) != 1
                or declaration.field_types[0] != RustType.Primitive(Primitive.Str)
            ):
                return Err("unsupported Body IR checked newtype Deserialize outside owned str")
            return Ok("__incan_checked_deserialize" + symbol_component(str(declaration.name)))


pub def checked_owner_arguments(
    declaration: &NominalDeclaration,
    instances: list[NominalInstance],
) -> Result[list[RustType], str]:
    """Use the exact discovery registry for scheduling; physical names only verify the selected closed layout."""
    if len(declaration.type_parameters) == 0:
        return Ok([])
    for instance in instances:
        if (
            instance.declaration.canonical == declaration.canonical
            and nominal_symbol(str(instance.declaration.name), instance.arguments) == declaration.name
        ):
            if instance.declaration.type_parameters != declaration.type_parameters:
                return Err("unsupported Body IR checked Deserialize owner binder disagreement")
            return Ok(instance.arguments)
    return Err("unsupported Body IR checked Deserialize without exact owner arguments")


pub def selected_deserialize_hook(
    module: &BodyIrModule,
    declaration: &NominalDeclaration,
    arguments: list[RustType],
) -> Result[tuple[Body, Body], str]:
    """Validate one exact source hook before closing its existing frame; never choose a body by conventional name."""
    match declaration.newtype_deserialize:
        NewtypeDeserialize.Checked(hook) =>
            if (
                hook.kind != SemanticSourceTargetKind.Method
                or hook.origin != declaration.canonical.origin
                or hook.declaration_span.start < declaration.canonical.declaration_span.start
                or hook.declaration_span.end > declaration.canonical.declaration_span.end
            ):
                return Err("unsupported Body IR checked Deserialize hook owner provenance")
            mut found: Option[Body] = None
            for body in module.bodies:
                match body.canonical:
                    Some(identity) =>
                        if identity == hook:
                            match found:
                                Some(_previous) =>
                                    return Err("unsupported Body IR checked Deserialize duplicate hook Body")
                                None => pass
                            found = Some(body.clone())
                    None => pass
            match found:
                None => return Err("unsupported Body IR checked Deserialize missing hook Body")
                Some(body) =>
                    if not hook_declaration_agrees(body, hook, declaration):
                        return Err("unsupported Body IR checked Deserialize hook declaration disagreement")
                    closed: Body = instantiate(body, arguments, [])?
                    require_closed_hook(closed)?
                    return Ok((body, closed))
        _ => return Err("unsupported Body IR checked Deserialize without selected hook")


def hook_declaration_agrees(body: &Body, hook: &CanonicalSymbolId, declaration: &NominalDeclaration) -> bool:
    """Require the retained hook's full checked span and declaring type parameters to agree with its frame."""
    return (
        body.name == hook.declaration_name
        and body.span == hook.declaration_span
        and body.type_parameters == declaration.type_parameters
    )


def require_closed_hook(body: &Body) -> Result[None, str]:
    """Require an owned String input and the canonical builtin error before constructing an executable serde root."""
    if body.is_async or body.is_generator() or len(body.params) != 1 or len(body.locals) == 0:
        return Err("unsupported Body IR checked Deserialize hook frame")
    parameter = body.params[0]
    if (
        parameter.mutable
        or parameter.ty != RustType.Primitive(Primitive.Str)
        or int(parameter.local.index()) != 0
        or body.locals[0].ty != parameter.ty
    ):
        return Err("unsupported Body IR checked Deserialize hook owned str parameter")
    match body.locals[0].origin:
        LocalOrigin.Parameter => pass
        _ => return Err("unsupported Body IR checked Deserialize hook receiver")
    match parameter.default:
        CallableParamDefault.Required => pass
        _ => return Err("unsupported Body IR checked Deserialize hook parameter default")
    match body.return_type:
        RustType.Generic(base=base, args=arguments) =>
            if (
                base == "Result"
                and len(arguments) == 2
                and arguments[1] == RustType.NativeBuiltin(RuntimeBuiltinType.ValidationError)
            ):
                return Ok(None)
        _ => pass
    return Err("unsupported Body IR checked Deserialize hook canonical Result")
