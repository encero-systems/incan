"""Derived nominal formatting and comparisons over the retained source field layout."""

from rust::incan_semantics_core::body_ir import (
    Operand as RustOperand,
    BinOp,
    MethodTarget,
    BodyIrModule,
    Body,
    NominalDeclaration,
    NamedCallableTarget,
    ArgumentElement,
    Place as RustPlace,
)
from rust::incan_semantics_core import IncanType as RustType, SymbolOrigin, SemanticSourceTargetKind
from pub::incan_mir_plan import PlanType, Place, Operand, RvalueKind, ExternalFunction, CalleeKind, SourceSpan
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, temporary, read_place, terminate_call, place_type, external_call
from models import model_place
from type_parameters import substitute
from unions import native_source_type
from options import carrier_layout
from text_ownership import drop_borrowed_text_temporaries
from lowering import scalar_place, text_argument, lower_callable_result, runtime_text
from decls import library_item


pub def nominal_place(builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Option[Place], str]:
    """Locate a checked model operand without applying value-read cloning before a shared trait call."""
    match value:
        RustOperand.Place(read) =>
            if len(read.place.projection) != 0:
                return Ok(None)
            match read.place.local_id():
                None => return Ok(None)
                Some(_local) => pass
            mut place = model_place(
                builder.nominals,
                builder.locals[builder.local_offset:],
                read.place,
                span,
                builder.enums,
                builder.unions,
                builder.intrinsics,
            )?
            place.local += builder.local_offset
            match place_type(builder.locals, place):
                PlanType.Model(_owner, _name) => return Ok(Some(place))
                _ => pass
        _ => pass
    return Ok(None)


def borrow_model(mut builder: Builder, value: Place, ty: PlanType, span: SourceSpan) -> Result[Operand, str]:
    """Borrow a nominal value for a runtime trait call, retaining its owner's initialized storage."""
    match ty:
        PlanType.Model(owner, name) =>
            reference = temporary(builder, PlanType.ModelRef(owner, name), span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(value), span))
            return Ok(read_place(reference, false, span))
        _ => return Err("unsupported Body IR model trait receiver")


def model_call(
    mut builder: Builder,
    name: str,
    ty: PlanType,
    result: PlanType,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Retain the exact nominal instantiation and shared-reference signature for metadata validation."""
    match ty:
        PlanType.Model(owner, model_name) =>
            reference = PlanType.ModelRef(owner, model_name)
            mut parameters: list[PlanType] = []
            for _argument in arguments:
                parameters.append(reference)
            path = f"incan_native_runtime::{name}"
            builder.externals.append(
                ExternalFunction(path=path, type_arguments=[ty], parameters=parameters, return_type=result, span=span),
            )
            terminate_call(builder, CalleeKind.Instantiated(path, [ty]), arguments, destination, span)
            if result == PlanType.String:
                builder.owned.append(destination.local)
            return Ok(None)
        _ => return Err("unsupported Body IR model trait instantiation")


pub def debug_model(mut builder: Builder, value: Place, span: SourceSpan) -> Result[Place, str]:
    """Render with the nominal's derived Debug implementation rather than reconstructing field text."""
    ty = place_type(builder.locals, value)
    operand = borrow_model(builder, value, ty, span)?
    result = temporary(builder, PlanType.String, span)
    model_call(builder, "debug_model", ty, PlanType.String, [operand], result, span)?
    return Ok(result)


pub def debug_model_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Accept explicit Debug formatting only for a retained nominal place."""
    match nominal_place(builder, value, span)?:
        Some(place) => return debug_model(builder, place, span)
        None => return Err("unsupported Body IR nonmodel FormatStyle.Debug")


def comparison_name(operator: &BinOp) -> Result[str, str]:
    """Select a trait operation without translating nominal comparisons into scalar MIR."""
    match operator:
        BinOp.Eq => return Ok("equal_model")
        BinOp.Ne => return Ok("unequal_model")
        BinOp.Lt => return Ok("less_model")
        BinOp.Le => return Ok("less_equal_model")
        BinOp.Gt => return Ok("greater_model")
        BinOp.Ge => return Ok("greater_equal_model")
        _ => return Err("unsupported Body IR model binary operator")


def compare_places(
    mut builder: Builder,
    destination: Place,
    operator: &BinOp,
    first: Place,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[bool, str]:
    """Require matching retained nominal carriers before borrowing the two comparison operands."""
    match nominal_place(builder, right, span)?:
        None => return Err("unsupported Body IR mixed model comparison")
        Some(second) =>
            ty = place_type(builder.locals, first)
            if ty != place_type(builder.locals, second):
                return Err("unsupported Body IR distinct model comparison")
            name = comparison_name(operator)?
            match ty:
                PlanType.Model(owner, _model_name) =>
                    mut required = "PartialOrd"
                    if operator == BinOp.Eq or operator == BinOp.Ne:
                        required = "PartialEq"
                    mut count = 5
                    if required == "PartialEq":
                        count = 1
                    if library_item(builder.nominals[owner]) == "" and required not in builder.nominals[owner].derives and len(builder.comparison_functions[owner]) < count:
                        return Err(f"unsupported Body IR model comparison without derived {required}")
                _ => return Err("unsupported Body IR model comparison carrier")
            arguments = [borrow_model(builder, first, ty, span)?, borrow_model(builder, second, ty, span)?]
            model_call(builder, name, ty, PlanType.Bool, arguments, destination, span)?
            return Ok(true)


pub def compare_models(
    mut builder: Builder,
    destination: Place,
    operator: &BinOp,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[bool, str]:
    """Route model comparisons through retained derives or validated source implementation frames."""
    match nominal_place(builder, left, span)?:
        None => return Ok(false)
        Some(first) => return compare_places(builder, destination, operator, first, right, span)


pub def display_model_operand(
    mut builder: Builder,
    value: &RustOperand,
    span: SourceSpan,
) -> Result[Option[Place], str]:
    """Display native carriers through their Rust implementation; source carriers use their checked string method or derive."""
    match nominal_place(builder, value, span)?:
        None => return Ok(None)
        Some(place) =>
            match place_type(builder.locals, place):
                PlanType.Model(owner, _name) =>
                    if library_item(builder.nominals[owner]) != "":
                        argument = borrow_model(builder, place, place_type(builder.locals, place), span)?
                        return Ok(Some(runtime_text(builder, "incan_native_runtime::display_value", argument, span)?))
                    match builder.nominals[owner].display_method:
                        Some(_selected) => return Ok(Some(display_checked_model(builder, owner, place, span)?))
                        None => pass
                    if "Display" not in builder.nominals[owner].derives:
                        return Err("unsupported Body IR model display without derived Display")
                _ => return Err("unsupported Body IR model display carrier")
            return Ok(Some(debug_model(builder, place, span)?))


def display_checked_model(mut builder: Builder, owner: int, place: Place, span: SourceSpan) -> Result[Place, str]:
    """Call the exact validated source body or SDK item; a crate call keeps its metadata-checked shared signature."""
    for index in range(len(builder.display_functions)):
        if builder.display_functions[index].owner != owner:
            continue
        ty = place_type(builder.locals, place)
        argument = borrow_model(builder, place, ty, span)?
        result = temporary(builder, PlanType.String, span)
        match builder.display_functions[index].callee:
            CalleeKind.Planned(symbol) => terminate_call(builder, CalleeKind.Planned(symbol), [argument], result, span)
            CalleeKind.External(path) =>
                reference = PlanType.ModelRef(owner, builder.nominals[owner].name)
                external_call(builder, path, [reference], PlanType.String, [argument], result, span)
            _ => return Err("unsupported Body IR checked display callee kind")
        builder.owned.append(result.local)
        return Ok(result)
    return Err(f"unsupported Body IR unavailable checked display body on {builder.nominals[owner].name}")


pub def serialize_model_operand(
    mut builder: Builder,
    value: &RustOperand,
    destination: Place,
    span: SourceSpan,
) -> Result[bool, str]:
    """Serialize a retained model with checked serde capability, borrowing its original storage."""
    match nominal_place(builder, value, span)?:
        None => return Ok(false)
        Some(place) =>
            ty = place_type(builder.locals, place)
            match ty:
                PlanType.Model(owner, _name) =>
                    if "serde::Serialize" not in builder.nominals[owner].derives:
                        return Err("unsupported Body IR model JSON serialization without serde::Serialize")
                _ => return Err("unsupported Body IR model JSON carrier")
            argument = borrow_model(builder, place, ty, span)?
            model_call(builder, "serialize_model", ty, PlanType.String, [argument], destination, span)?
            return Ok(true)


pub def is_json_serialize_method(target: &MethodTarget) -> bool:
    """Recognize the JSON protocol default in source and compiled SDK identities, never a same-name override."""
    match target.canonical:
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method or identity.declaration_name != "to_json":
                return false
            match identity.origin:
                SymbolOrigin.Module(path) =>
                    return len(path) == 3 and path[0] == "std" and path[1] == "serde" and path[2] == "json"
                SymbolOrigin.Package(library=library, module_path=path) =>
                    return library == "incan_stdlib_data" and len(path) == 2 and path[0] == "serde" and path[1] == "json"
                _ => return false
        None => return false


pub def refuse_overridden_json_default(
    module: &BodyIrModule,
    builder: Builder,
    receiver: PlanType,
    method: str,
) -> Result[None, str]:
    """
    Refuse the serde protocol default named `method` for a model receiver that declares its own `method` body.

    A call that reaches the protocol default through a type parameter must run the adopter's own method instead, and
    Body IR records no implementation slot for an imported protocol trait, so that dispatch stays refused.
    """
    match receiver:
        PlanType.Model(owner, _name) =>
            for body in module.bodies:
                if declares_own_method(builder.nominals[owner], body, method):
                    return Err(f"unsupported Body IR JSON protocol default over an adopter's own {method}")
        _ => pass
    return Ok(None)


def declares_own_method(owner: &NominalDeclaration, body: &Body, method: str) -> bool:
    """Whether a body is a method spelled `method` declared inside the model `owner`, as an adopter's override is."""
    match body.canonical:
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method or identity.declaration_name != method:
                return false
            if identity.origin != owner.canonical.origin:
                return false
            member = identity.declaration_span
            declaration = owner.canonical.declaration_span
            return declaration.start <= member.start and member.end <= declaration.end
        None => return false


pub def is_json_deserialize_method(target: &NamedCallableTarget) -> bool:
    """Recognize the JSON protocol's `from_json` default in source and compiled SDK identities, never an override."""
    match target.canonical:
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method or identity.declaration_name != "from_json":
                return false
            match identity.origin:
                SymbolOrigin.Module(path) =>
                    return len(path) == 3 and path[0] == "std" and path[1] == "serde" and path[2] == "json"
                SymbolOrigin.Package(library=library, module_path=path) =>
                    return library == "incan_stdlib_data" and len(path) == 2 and path[0] == "serde" and path[1] == "json"
                _ => return false
        None => return false


pub def lower_model_from_json(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &NamedCallableTarget,
    arguments: &list[ArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Parse a model that derives serde's Deserialize through legacy's serde decoding and its error text."""
    ty = static_receiver_type(builder, target)?
    match ty:
        PlanType.Model(owner, _name) =>
            if "serde::Deserialize" not in builder.nominals[owner].derives:
                return Err("unsupported Body IR model JSON deserialization without serde::Deserialize")
        _ => return Err("unsupported Body IR JSON deserialization receiver")
    refuse_overridden_json_default(module, builder, ty, "from_json")?
    if len(arguments) != 1 or len(target.type_args) != 0:
        return Err("invalid Body IR from_json arguments")
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
            result = place_type(builder.locals, output)
            require_parsed_result(builder, result, ty)?
            incoming = builder.owned
            text = text_argument(builder, arguments, 0, span)?
            path = "incan_native_runtime::deserialize_model"
            builder.externals.append(
                ExternalFunction(
                    path=path,
                    type_arguments=[ty],
                    parameters=[PlanType.StringRef],
                    return_type=result,
                    span=span,
                ),
            )
            lower_callable_result(builder, CalleeKind.Instantiated(path, [ty]), [text], output, result, span)?
            drop_borrowed_text_temporaries(builder, incoming, output.local, span)
            return Ok(None)
        None => return Err("unsupported Body IR discarded from_json")


def static_receiver_type(builder: Builder, target: &NamedCallableTarget) -> Result[PlanType, str]:
    """The checked static owner, closed in the active instance when it names a type parameter."""
    match target.receiver_type:
        Some(ty) =>
            closed: RustType = substitute(ty, builder.type_parameters, builder.type_arguments)?
            return native_source_type(builder.nominals, builder.enums, builder.unions, closed, builder.intrinsics)
        None => return Err("unsupported Body IR from_json without a receiver type")


def require_parsed_result(builder: Builder, result: PlanType, payload: PlanType) -> Result[None, str]:
    """Require the destination to be the `Result[Model, str]` carrier legacy's `from_json` returns."""
    _owner, declaration = carrier_layout(builder, result)?
    if declaration.carrier != "Result":
        return Err("unsupported Body IR from_json destination carrier")
    if declaration.variants[0].fields != [payload] or declaration.variants[1].fields != [PlanType.String]:
        return Err("unsupported Body IR from_json destination carrier")
    return Ok(None)
