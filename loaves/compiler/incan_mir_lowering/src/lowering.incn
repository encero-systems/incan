from frame_instances import lower_instances, merge_externals


pub type BodyIrModule = rusttype RustBodyIrModule with Send, Sync:
    """The frontend-owned canonical module, borrowed without conversion or duplication."""


pub model UnitContinuation:
    """Ordinary-frame work retained while the frontend resolves only the runtime declarations that work selected."""

    pub source_context: Arc[BodyIrModule]
    pub template_constructors: Arc[ConstructorIndex]
    pub owners: list[str]
    pub sources: list[str]
    pub files: list[str]
    pub entry_owner: str
    pub entry_file: str
    pub context: Arc[BodyIrModule]
    pub template_references: list[str]
    pub constructors: Arc[ConstructorIndex]
    pub program: ProgramContext
    pub unions: list[RustType]
    pub nominal_instances: list[NominalInstance]
    pub intrinsic_layouts: list[EnumDeclaration]
    pub models: list[ModelDeclaration]
    pub enums: list[EnumDeclaration]
    pub functions: list[Function]
    pub externals: list[ExternalFunction]
    pub instances: list[Instance]
    pub emitted_frames: EmittedFrames
    pub statics: list[StaticCell]


pub enum UnitPlanning:
    """A complete native plan, or preserved ordinary-frame work awaiting exact runtime declarations."""

    Complete(Option[Plan])
    NeedsRuntime(UnitContinuation, list[RuntimeRequirement])


def validate_project_module(
    module: &BodyIrModule,
    modules: &list[BodyIrModule],
    retained: &BodyIrModule,
) -> Result[int, str]:
    """Validate one module, resolving trait implementations against its current slice and retained project authority."""
    count = validate_declarations_and_bodies(module, modules)?
    for implementation_position in range(len(module.trait_implementations)):
        implementation = borrowed_at(module.trait_implementations, implementation_position)
        match validate_project_implementation(module, implementation, modules, retained):
            Ok(_valid) => pass
            Err(reason) =>
                if has_open_trait_arguments(implementation):
                    return Err("unsupported Body IR open trait default type arguments")
                return Err(
                    f"{reason}; owner={implementation.owner:?}; slot={implementation.method:?}; implementation={implementation.implementation:?}",
                )
    return Ok(count)


def validate_declarations_and_bodies(module: &BodyIrModule, modules: &list[BodyIrModule]) -> Result[int, str]:
    """
    Validate a module's retained declarations and bodies; trait implementations are validated by the caller.

    A generic decorator initializer is admitted only for a synchronous per-instantiation binding. Its closed instances
    publish their own storage cells; they never enter ordinary module-static initialization or fall through to the
    undecorated original.
    """
    for binding in module.decorated_bindings:
        if not module.is_well_formed_decorated_binding_in_project(binding, modules):
            return Err("invalid Body IR decorated binding identity")
        match binding.initializer:
            Some(_initializer) => _ = validate_instance_binding(binding)?
            None => pass
    for declaration in module.static_declarations:
        if not module.is_well_formed_static_declaration_in_project(declaration, modules):
            return Err("invalid Body IR static declaration")
    for enum_position in range(len(module.enum_declarations)):
        declaration = borrowed_at(module.enum_declarations, enum_position)
        if not module.is_well_formed_native_enum_declaration(declaration):
            return Err("invalid Body IR normal enum declaration identity")
    for nominal_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, nominal_position)
        if not module.is_well_formed_nominal_declaration(declaration):
            return Err(f"invalid Body IR nominal declaration identity {declaration.name} in {module.module_id.path()}")
    for declaration in module.fieldless_enum_declarations:
        if not module.is_well_formed_fieldless_enum_declaration(declaration):
            return Err("invalid Body IR fieldless enum declaration identity")
    for declaration_position in range(len(module.value_enum_declarations)):
        declaration = borrowed_at(module.value_enum_declarations, declaration_position)
        if not module.is_well_formed_value_enum_declaration(declaration):
            return Err("invalid Body IR value enum declaration identity")
    for body_position in range(len(module.bodies)):
        body = borrowed_at(module.bodies, body_position)
        if not module.body_has_canonical_direct_call_id(body):
            return Err(f"unsupported Body IR body identity {module.module_id.path()}::{body.name}")
    return Ok(len(module.bodies))


pub def unit_plan(
    modules: list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut published: list[NativeUnionDeclaration],
    package_versions: BTreeMap[str, str],
    overflow_checks: bool = true,
    scalar_products: Option[str] = None,
    scalar_bodies: list[tuple[CompilerNodeId, str]] = [],
) -> Result[UnitPlanning, str]:
    """Lower one checked unit by kind; test entries come from session collection, never from naming heuristics here."""
    if kind != "program" and kind != "library" and kind != "test":
        return Err(f"unsupported unit kind {kind}")
    mut scalar_index: BTreeMap[CompilerNodeId, str] = BTreeMap.new()
    for identity, inputs in scalar_bodies:
        _ = scalar_index.insert(identity, inputs)
    return lowered_plan(
        modules,
        sources,
        files,
        entry,
        kind,
        tests,
        published,
        overflow_checks,
        package_versions,
        scalar_products,
        scalar_index,
    )


pub def program_context(
    constructors: Arc[ConstructorIndex],
    module: &BodyIrModule,
    mut intrinsics: list[EnumDeclaration],
    unions: list[RustType],
    overflow_checks: bool = true,
) -> Result[ProgramContext, str]:
    """Freeze program dispatch mappings after layout admission, copying storage once from the still-borrowed checked module."""
    # Resolve the native loan before applying another module's source-type expectation (seed compiler, #2256).
    constructor_view = constructors.as_ref()
    return Ok(
        ProgramContext(
            body_indices=body_index(module),
            display_functions=Arc.new(display_functions(constructor_view, module, intrinsics)?),
            statics=Arc.new(list(module.static_declarations)),
            comparison_functions=Arc.new(comparison_functions(constructor_view, module, intrinsics)?),
            union_types=union_index(unions),
            nominals=Arc.new(list(module.nominal_declarations)),
            constructors=constructors,
            enums=Arc.new(list(module.enum_declarations)),
            value_enums=Arc.new(list(module.value_enum_declarations)),
            decorated_bindings=Arc.new(list(module.decorated_bindings)),
            overflow_checks=overflow_checks,
            observe_work=native_environment("INCAN_NATIVE_TIMING").is_some(),
        ),
    )


def lowered_plan(
    modules: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut published: list[NativeUnionDeclaration],
    overflow_checks: bool,
    package_versions: BTreeMap[str, str],
    scalar_products: Option[str],
    scalar_bodies: BTreeMap[CompilerNodeId, str],
) -> Result[UnitPlanning, str]:
    """Lower a checked unit once, preserving ordinary frames when exact runtime declarations need resolution."""
    trace_key: str = "INCAN_TRACE_LOWERING"
    trace = native_environment(trace_key).is_some()
    # 1. Validate the checked inputs and prepare their shared layouts.
    source_files = source_file_index(modules, files)?
    empty_templates = index_constructors([], source_files, package_versions)
    source_context, template_constructors, owners, specialized_context, nominal_instances, template_references = plan_contexts(
        modules,
        sources,
        files,
        entry,
        trace,
        source_files,
        package_versions,
        borrowed_at(modules, entry),
        empty_templates,
    )?
    shared_source_context = Arc.new(source_context)
    mut context = Arc.new(specialized_context)
    mut constructor_table, unions, initial_intrinsics = layout_tables(
        context.as_ref(),
        files[entry],
        source_files,
        package_versions,
    )?
    constructors = Arc.new(with_generic_constructor_arities(constructor_table, template_constructors))
    mut intrinsics = initial_intrinsics
    mut models: list[ModelDeclaration] = []
    mut enums: list[EnumDeclaration] = []
    mut functions: list[Function] = []
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    initial_program = initial_plan_roots(
        constructors,
        context.as_ref(),
        files[entry],
        intrinsics,
        nominal_instances,
        kind,
        unions,
        overflow_checks,
        trace,
        models,
        enums,
        functions,
        externals,
        instances,
    )?
    mut program = initial_program
    mut emitted_frames = no_emitted_frames()
    # 2. Lower ordinary frames and static initializers exactly once.
    mut retained_nominals = nominal_instances
    lower_ordinary_bodies(
        context,
        shared_source_context,
        source_files,
        package_versions,
        program,
        list(owners),
        sources,
        files,
        entry,
        kind,
        tests,
        intrinsics,
        functions,
        externals,
        instances,
        emitted_frames,
        unions,
        trace,
        scalar_products,
        scalar_bodies,
        overflow_checks,
    )?
    mut statics = lower_computed_statics(
        context.as_ref(),
        program,
        unions,
        sources,
        files,
        list(owners),
        intrinsics,
        functions,
        externals,
        instances,
    )?
    requirements = selected_runtime_requirements(context.as_ref(), externals, functions)?
    if len(requirements) != 0:
        return Ok(
            UnitPlanning.NeedsRuntime(
                UnitContinuation(
                    source_context=shared_source_context,
                    template_constructors=Arc.new(template_constructors),
                    owners=list(owners),
                    sources=sources,
                    files=files,
                    entry_owner=owners[entry],
                    entry_file=files[entry],
                    context=context,
                    template_references=template_references,
                    constructors=constructors,
                    program=program,
                    unions=unions,
                    nominal_instances=list(retained_nominals),
                    intrinsic_layouts=list(intrinsics),
                    models=models,
                    enums=list(enums),
                    functions=functions,
                    externals=externals,
                    instances=instances,
                    emitted_frames=emitted_frames,
                    statics=statics,
                ),
                requirements,
            ),
        )

    # 3. Complete instances and publish the plan when no declaration resolution is needed.
    return finish_unit_plan(
        Arc.new(template_constructors),
        constructors,
        shared_source_context,
        template_references,
        context,
        program,
        owners,
        sources,
        files,
        owners[entry],
        files[entry],
        kind,
        tests,
        intrinsics,
        functions,
        models,
        enums,
        externals,
        instances,
        emitted_frames,
        statics,
        unions,
        retained_nominals,
        published,
        trace,
    )


pub def resume_unit_plan(
    continuation: UnitContinuation,
    modules: list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut published: list[NativeUnionDeclaration],
    package_versions: BTreeMap[str, str],
    overflow_checks: bool = true,
) -> Result[UnitPlanning, str]:
    """Resume preserved ordinary frames against the exact runtime declaration closure the frontend resolved."""
    trace_key: str = "INCAN_TRACE_LOWERING"
    trace = native_environment(trace_key).is_some()
    validate_plan_inputs(modules, sources, files, entry, continuation.context.as_ref())?
    source_files = source_file_index(modules, files)?
    mut source_context = continuation.source_context
    mut template_constructors = continuation.template_constructors
    mut owners = continuation.owners
    mut retained_sources = continuation.sources
    mut retained_files = continuation.files
    entry_owner = continuation.entry_owner
    entry_file = continuation.entry_file
    mut context = continuation.context
    mut template_references = continuation.template_references
    mut constructors = continuation.constructors
    mut program = continuation.program
    mut unions = continuation.unions
    mut retained_nominals = continuation.nominal_instances
    mut intrinsics = continuation.intrinsic_layouts
    mut models = continuation.models
    mut enums = continuation.enums
    mut functions = continuation.functions
    mut externals = continuation.externals
    mut instances = continuation.instances
    mut emitted_frames = continuation.emitted_frames
    mut statics = continuation.statics
    # #3022: release the copied model shell before Arc.make_mut so retained contexts remain uniquely owned.
    drop(continuation)
    previous_nominal_count = len(context.as_ref().nominal_declarations)
    previous_model_count = len(models)
    previous_static_count = len(context.as_ref().static_declarations)
    refresh_entry_context(Arc.make_mut(context), borrowed_at(modules, entry))
    additions = continuation_inputs(source_context.as_ref(), context.as_ref(), owners, modules, sources, files, entry)?
    if len(additions.modules.as_ref()) != 0:
        addition_source_files = source_file_index(additions.modules.as_ref(), additions.files)?
        added_source_context, _added_constructors, _added_owners, added_context, added_nominals, added_template_references = plan_contexts_parallel(
            additions.modules.clone(),
            additions.sources,
            additions.files,
            additions.entry,
            false,
            addition_source_files,
            package_versions,
            context.as_ref(),
            template_constructors.as_ref(),
        )?
        extend_continuation_context(
            Arc.make_mut(source_context),
            Arc.make_mut(context),
            Arc.make_mut(template_constructors),
            owners,
            retained_sources,
            retained_files,
            template_references,
            retained_nominals,
            additions,
            added_source_context,
            added_context,
            added_template_references,
            added_nominals,
        )?
    extend_constructor_authority(Arc.make_mut(template_constructors), source_files, package_versions)
    extend_constructor_index(Arc.make_mut(constructors), context.as_ref().nominal_declarations)
    extend_generic_constructor_arities(Arc.make_mut(constructors), template_constructors.as_ref())
    extend_constructor_authority(Arc.make_mut(constructors), source_files, package_versions)
    extend_unions(unions, context.as_ref())
    intrinsics = intrinsic_declarations(constructors.as_ref(), context.as_ref(), entry_file, intrinsics)?
    resume_plan_roots(
        program,
        constructors,
        context.as_ref(),
        entry_file,
        intrinsics,
        retained_nominals,
        kind,
        unions,
        previous_nominal_count,
        previous_model_count,
        models,
        functions,
        externals,
        instances,
    )?
    mut resolved_statics = lower_computed_statics(
        context.as_ref(),
        program,
        unions,
        retained_sources,
        retained_files,
        list(owners),
        intrinsics,
        functions,
        externals,
        instances,
        previous_static_count,
    )?
    emitted_frames = rebase_emitted_frames(context.as_ref(), emitted_frames)
    for cell in resolved_statics:
        statics.append(cell)
    requirements = selected_runtime_requirements(context.as_ref(), externals, functions)?
    if len(requirements) != 0:
        return Ok(
            UnitPlanning.NeedsRuntime(
                UnitContinuation(
                    source_context=source_context,
                    template_constructors=template_constructors,
                    owners=list(owners),
                    sources=retained_sources,
                    files=retained_files,
                    entry_owner=entry_owner,
                    entry_file=entry_file,
                    context=context,
                    template_references=template_references,
                    constructors=constructors,
                    program=program,
                    unions=unions,
                    nominal_instances=list(retained_nominals),
                    intrinsic_layouts=list(intrinsics),
                    models=models,
                    enums=list(enums),
                    functions=functions,
                    externals=externals,
                    instances=instances,
                    emitted_frames=emitted_frames,
                    statics=statics,
                ),
                requirements,
            ),
        )
    return finish_unit_plan(
        template_constructors,
        constructors,
        source_context,
        template_references,
        context,
        program,
        owners,
        retained_sources,
        retained_files,
        entry_owner,
        entry_file,
        kind,
        tests,
        intrinsics,
        functions,
        models,
        enums,
        externals,
        instances,
        emitted_frames,
        statics,
        unions,
        retained_nominals,
        published,
        trace,
    )


def rebase_emitted_frames(context: &BodyIrModule, previous: EmittedFrames) -> EmittedFrames:
    """Rebase ordinary-frame body positions after resolved dependency modules enter before authored modules."""
    mut emitted = no_emitted_frames()
    for position in range(len(context.bodies)):
        body = borrowed_at(context.bodies, position)
        match body.canonical:
            Some(identity) =>
                if previous.positions.get(identity) != None:
                    emitted.record(body.clone(), position)
            None => pass
    return emitted


def finish_unit_plan(
    mut template_constructors: Arc[ConstructorIndex],
    constructors: Arc[ConstructorIndex],
    source_context: Arc[BodyIrModule],
    template_references: list[str],
    mut context: Arc[BodyIrModule],
    program: ProgramContext,
    owners: list[str],
    sources: list[str],
    files: list[str],
    entry_owner: str,
    entry_file: str,
    kind: str,
    tests: list[str],
    mut intrinsics: list[EnumDeclaration],
    mut functions: list[Function],
    models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
    emitted_frames: EmittedFrames,
    mut statics: list[StaticCell],
    unions: list[RustType],
    mut retained_nominals: list[NominalInstance],
    mut published: list[NativeUnionDeclaration],
    trace: bool,
) -> Result[UnitPlanning, str]:
    """Drain instances from preserved ordinary frames, finalize their layouts and publish one complete plan."""
    mut retained_program = program
    original_nominal_count = len(context.as_ref().nominal_declarations)
    trace_lowering(trace, "generic instances")
    retry_intrinsic_layouts = list(intrinsics)
    retry_functions = list(functions)
    retry_externals = list(externals)
    retry_instances = list(instances)
    retry_emitted_frames = emitted_frames.clone()
    retry_statics = list(statics)
    mut instance_cells: list[StaticCell] = []
    retention = lower_instances(
        template_constructors.as_ref(),
        Arc.make_mut(context),
        source_context.as_ref(),
        retained_program,
        instances,
        unions,
        sources,
        files,
        list(owners),
        functions,
        externals,
        intrinsics,
        retained_nominals,
        instance_cells,
    )?
    for cell in instance_cells:
        statics.append(cell)
    match retention:
        RuntimeRetention.NeedsRuntime(requests) =>
            retry = UnitContinuation(
                source_context=source_context,
                template_constructors=template_constructors,
                owners=list(owners),
                sources=sources,
                files=files,
                entry_owner=entry_owner,
                entry_file=entry_file,
                context=context,
                template_references=template_references,
                constructors=constructors,
                program=retained_program,
                unions=unions,
                nominal_instances=list(retained_nominals),
                intrinsic_layouts=retry_intrinsic_layouts,
                models=models,
                enums=list(enums),
                functions=retry_functions,
                externals=retry_externals,
                instances=retry_instances,
                emitted_frames=retry_emitted_frames,
                statics=retry_statics,
            )
            return Ok(UnitPlanning.NeedsRuntime(retry, requests))
        RuntimeRetention.Complete => pass

    retained_constructors = retained_program.constructors.as_ref()
    original_constructors = constructors.as_ref()
    mut completed_models = models
    if len(context.as_ref().nominal_declarations) != original_nominal_count:
        completed_models = lower_model_declarations(
            retained_constructors,
            context.as_ref(),
            entry_file,
            intrinsics,
            retained_nominals,
            kind == "library",
        )?
    zip_carriers = finish_instance_layouts(
        original_constructors,
        retained_constructors,
        Arc.make_mut(context),
        original_nominal_count,
        functions,
        completed_models,
        enums,
        externals,
        intrinsics,
        kind,
    )?

    # ---- Completed publication ----
    mut exports: list[PlanExport] = []
    mut templates: list[GenericModelDeclaration] = []
    mut enum_templates: list[GenericEnumDeclaration] = []
    if kind == "library":
        templates = generic_models(
            template_constructors.as_ref(),
            source_context.as_ref(),
            template_references,
            retained_nominals,
            entry_file,
        )?
        enum_templates = generic_enums(
            template_constructors.as_ref(),
            source_context.as_ref(),
            context.as_ref(),
            enums,
            intrinsics,
            entry_file,
        )?
        exports = loaf_exports(
            context.as_ref(),
            emitted_frames.body_positions,
            source_context.as_ref(),
            templates,
            enum_templates,
        )
        publish_unions(original_constructors, context.as_ref(), intrinsics, published)?
    planned = completed_plan(
        context.as_ref(),
        entry_owner,
        kind,
        tests,
        entry_file,
        functions,
        completed_models,
        enums,
        externals,
        statics,
        exports,
        templates,
        enum_templates,
        zip_carriers,
    )?
    return Ok(UnitPlanning.Complete(planned))


pub def initial_plan_roots(
    constructors: Arc[ConstructorIndex],
    context: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    kind: str,
    unions: list[RustType],
    overflow_checks: bool,
    trace: bool,
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
) -> Result[ProgramContext, str]:
    """
    Fill empty planning inventories with generated functions and declaration roots for either entry point.

    1. Retain checked deserialization and string conversion roots in declaration order.
    2. Admit model and enum layouts with the selected unit kind and profile policy.
    3. Merge their runtime and instance requests through the ordinary admission rules.
    """
    # 1. Generated roots precede ordinary bodies and keep the same refusal order.
    trace_lowering(trace, "checked deserialize")
    checked_functions, checked_runtime, checked_instances = lower_checked_deserialize(
        constructors,
        context,
        nominal_instances,
        file,
        intrinsics,
    )?
    trace_lowering(trace, "string conversions")
    string_functions, conversion_runtime = lower_string_conversions(constructors, context, file, intrinsics)?
    # 2. Library publication and overflow policy belong to the selected unit, including diagnostic lowering.
    prepared_models, prepared_enums, program = initial_plan_layouts(
        constructors,
        context,
        file,
        intrinsics,
        nominal_instances,
        kind,
        unions,
        overflow_checks,
        trace,
    )?
    # 3. Both callers consume the same admitted roots without rebuilding their inventories.
    models.extend(prepared_models)
    enums.extend(prepared_enums)
    functions.extend(checked_functions)
    functions.extend(string_functions)
    externals.extend(checked_runtime)
    merge_externals(externals, conversion_runtime)?
    merge_instance_requests(instances, checked_instances)
    merge_instance_requests(instances, comparison_bridge_instances(context, models, enums))
    return Ok(program)


def resume_plan_roots(
    mut program: ProgramContext,
    constructors: Arc[ConstructorIndex],
    context: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    kind: str,
    unions: list[RustType],
    previous_nominal_count: int,
    previous_model_count: int,
    mut models: list[ModelDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
) -> Result[None, str]:
    """
    Append roots introduced since the preserved attempt and extend the retained shared lookup generations.

    `previous_nominal_count` separates newly resolved runtime declarations from layouts an earlier generic-instance
    pass appended. `previous_model_count` also admits those already-closed layouts without rebuilding older models.
    """
    checked_functions, checked_runtime, checked_instances = lower_checked_deserialize(
        constructors,
        context,
        nominal_instances,
        file,
        intrinsics,
        previous_nominal_count,
    )?
    string_functions, conversion_runtime = lower_string_conversions(
        constructors,
        context,
        file,
        intrinsics,
        previous_nominal_count,
    )?
    new_models = lower_model_declarations(
        constructors.as_ref(),
        context,
        file,
        intrinsics,
        nominal_instances,
        kind == "library",
        previous_model_count,
    )?
    extend_program_context(program, context, constructors, unions)?
    functions.extend(checked_functions)
    functions.extend(string_functions)
    externals.extend(checked_runtime)
    merge_externals(externals, conversion_runtime)?
    merge_instance_requests(instances, checked_instances)
    new_enums: list[EnumDeclaration] = []
    merge_instance_requests(instances, comparison_bridge_instances(context, new_models, new_enums))
    models.extend(new_models)
    return Ok(None)


pub def layout_tables(
    context: &BodyIrModule,
    file: str,
    source_files: &BTreeMap[str, str],
    package_versions: &BTreeMap[str, str],
    retained_intrinsics: list[EnumDeclaration] = [],
) -> Result[tuple[ConstructorIndex, list[RustType], list[EnumDeclaration]], str]:
    """Create matched constructor, union and intrinsic tables for either planning entry point."""
    constructors = index_constructors(context.nominal_declarations, source_files, package_versions)
    unions = collect_unions(context)
    intrinsics = intrinsic_declarations(constructors, context, file, retained_intrinsics)?
    return Ok((constructors, unions, intrinsics))


def completed_plan(
    context: &BodyIrModule,
    entry_owner: str,
    kind: str,
    tests: list[str],
    file: str,
    functions: list[Function],
    models: list[ModelDeclaration],
    enums: list[EnumDeclaration],
    externals: list[ExternalFunction],
    statics: list[StaticCell],
    exports: list[PlanExport],
    templates: list[GenericModelDeclaration],
    enum_templates: list[GenericEnumDeclaration],
    zip_carriers: list[ZipCarrier],
) -> Result[Option[Plan], str]:
    """Admit the completed unit's test and program entries, then transfer its owned native inventories into the plan."""
    has_main, declares_main = main_selection(context, entry_owner)
    test_entries = collected_test_entries(context, entry_owner, tests, functions, enums)?
    mut program_entries: list[str] = []
    if kind == "program" and not has_main:
        if declares_main:
            return Err("unsupported Body IR selected main representation")
        return Ok(None)
    if kind == "program":
        program_entries = selected_program_entries(context)?
    return Ok(
        Some(
            Plan(
                enums=enums,
                models=models,
                functions=functions,
                externals=externals,
                span=plan_span(file=file, line=1, column=1),
                statics=statics,
                exports=exports,
                tests=test_entries,
                programs=program_entries,
                generic_models=templates,
                generic_enums=enum_templates,
                zip_carriers=zip_carriers,
            ),
        ),
    )


def lower_plan_frames(
    template_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    templates: &BodyIrModule,
    mut program: ProgramContext,
    owners: &list[str],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut intrinsics: list[EnumDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
    mut emitted_frames: EmittedFrames,
    unions: list[RustType],
    mut retained_nominals: list[NominalInstance],
    trace: bool,
) -> Result[BodyPlanning, str]:
    """Lower ordinary frames, then retain request layouts and the nominal length for source restoration."""
    empty_scalar_bodies: BTreeMap[CompilerNodeId, str] = BTreeMap.new()
    lower_ordinary_bodies_serial(
        context,
        program,
        list(owners),
        sources,
        files,
        entry,
        kind,
        tests,
        intrinsics,
        functions,
        externals,
        instances,
        emitted_frames,
        unions,
        trace,
        None,
        empty_scalar_bodies,
    )?
    original_nominal_count = len(context.nominal_declarations)
    match lower_requested_frames(
        template_constructors,
        context,
        templates,
        program,
        instances,
        unions,
        sources,
        files,
        list(owners),
        functions,
        externals,
        intrinsics,
        retained_nominals,
        trace,
    )?:
        FramesPlanning.NeedsRuntime(requests) => return Ok(BodyPlanning.NeedsRuntime(requests))
        FramesPlanning.Complete(statics) => return Ok(BodyPlanning.Complete((statics, original_nominal_count)))


def initial_plan_layouts(
    constructors: Arc[ConstructorIndex],
    context: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    kind: str,
    unions: list[RustType],
    overflow_checks: bool,
    trace: bool,
) -> Result[tuple[list[ModelDeclaration], list[EnumDeclaration], ProgramContext], str]:
    """Admit model and enum layouts in order, then freeze their matching program lookup context."""
    constructor_view = constructors.as_ref()
    trace_lowering(trace, "model declarations")
    models = lower_model_declarations(constructor_view, context, file, intrinsics, nominal_instances, kind == "library")?
    trace_lowering(trace, "enum declarations")
    mut enums = lower_enum_declarations(constructor_view, context, file, intrinsics)?
    attach_enum_comparisons(constructor_view, context, enums, intrinsics)?
    program = program_context(constructors, context, intrinsics, unions, overflow_checks)?
    return Ok((models, enums, program))


def finish_instance_layouts(
    original_constructors: &ConstructorIndex,
    retained_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    original_nominal_count: int,
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    kind: str,
) -> Result[list[ZipCarrier], str]:
    """Retain closed storage, restore the source inventory, then finalize with its paired index."""
    zip_carriers = runtime_zip_carriers(retained_constructors, context, intrinsics)?
    # Closed frames keep their native layouts; source exports retain the original declaration inventory.
    while len(context.nominal_declarations) > original_nominal_count:
        _ = context.nominal_declarations.pop()
    finalize_plan_layouts(
        original_constructors,
        context,
        functions,
        models,
        enums,
        externals,
        intrinsics,
        kind == "library",
    )?
    return Ok(zip_carriers)


def lower_requested_frames(
    template_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    templates: &BodyIrModule,
    mut program: ProgramContext,
    mut instances: list[Instance],
    unions: list[RustType],
    sources: list[str],
    files: list[str],
    owners: &list[str],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    mut retained_nominals: list[NominalInstance],
    trace: bool,
) -> Result[FramesPlanning, str]:
    """Lower static initializers before draining the checked callable requests they and ordinary bodies contribute."""
    statics = lower_computed_statics(
        context,
        program,
        unions,
        sources,
        files,
        list(owners),
        intrinsics,
        functions,
        externals,
        instances,
    )?
    trace_lowering(trace, "generic instances")
    mut instance_cells: list[StaticCell] = []
    match lower_instances(
        template_constructors,
        context,
        templates,
        program,
        instances,
        unions,
        sources,
        files,
        list(owners),
        functions,
        externals,
        intrinsics,
        retained_nominals,
        instance_cells,
    )?:
        RuntimeRetention.NeedsRuntime(requests) => return Ok(FramesPlanning.NeedsRuntime(requests))
        RuntimeRetention.Complete => pass
    mut cells = statics
    for cell in instance_cells:
        cells.append(cell)
    return Ok(FramesPlanning.Complete(cells))


def finalize_plan_layouts(
    constructors: &ConstructorIndex,
    context: &BodyIrModule,
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    publish: bool,
) -> Result[None, str]:
    """Publish completed layouts and validate callable and coroutine storage after every instance has contributed."""
    # Instance lowering can append carriers needed by a callable or coroutine capture.
    for declaration_position in range(len(intrinsics)):
        declaration = borrowed_at(intrinsics, declaration_position)
        enums.append(declaration)
    if publish:
        publish_local_layouts(models, enums)
    retain_factory_callable_storage(context, functions, models, externals)?
    validate_futures(constructors, context, intrinsics)?
    return Ok(None)


# The immutable source context retains its matching constructor index beside module provenance and specialized layouts.
pub type PlanContexts = tuple[BodyIrModule, ConstructorIndex, list[str], BodyIrModule, list[NominalInstance], list[str]]


pub def plan_contexts(
    modules: &list[BodyIrModule],
    sources: &list[str],
    files: &list[str],
    entry: int,
    trace: bool,
    source_files: &BTreeMap[str, str],
    package_versions: &BTreeMap[str, str],
    validation_context: &BodyIrModule,
    retained_templates: &ConstructorIndex,
) -> Result[PlanContexts, str]:
    """Validate against retained authority and prepare only the current slice's compact specialized contexts."""
    footprint_trace = native_environment("INCAN_TRACE_LOWERING_FOOTPRINT").is_some()
    trace_lowering(trace, "validate modules")
    validate_plan_inputs(modules, sources, files, entry, validation_context)?
    trace_lowering_footprint(footprint_trace, "validated modules")
    trace_lowering(trace, "project context")
    mut context, owners = project_context(modules, entry)?
    source_context, constructors, nominal_instances, template_references = specialize_plan_context(
        context, source_files, package_versions, retained_templates, footprint_trace, trace,
    )?
    return Ok((source_context, constructors, owners, context, nominal_instances, template_references))


def plan_contexts_parallel(
    modules: Arc[list[BodyIrModule]],
    sources: &list[str],
    files: &list[str],
    entry: int,
    trace: bool,
    source_files: &BTreeMap[str, str],
    package_versions: &BTreeMap[str, str],
    validation_context: &BodyIrModule,
    retained_templates: &ConstructorIndex,
) -> Result[PlanContexts, str]:
    """Validate a resumed runtime slice and project its body-weighted module ranges concurrently."""
    footprint_trace = native_environment("INCAN_TRACE_LOWERING_FOOTPRINT").is_some()
    trace_lowering(trace, "validate resumed modules")
    validate_plan_inputs(modules.as_ref(), sources, files, entry, validation_context)?
    trace_lowering_footprint(footprint_trace, "validated resumed modules")
    trace_lowering(trace, "parallel resumed project context")
    mut context, owners = project_context_parallel(modules, entry)?
    source_context, constructors, nominal_instances, template_references = specialize_plan_context(
        context, source_files, package_versions, retained_templates, footprint_trace, trace,
    )?
    return Ok((source_context, constructors, owners, context, nominal_instances, template_references))


def specialize_plan_context(
    mut context: &mut BodyIrModule,
    source_files: &BTreeMap[str, str],
    package_versions: &BTreeMap[str, str],
    retained_templates: &ConstructorIndex,
    footprint_trace: bool,
    trace: bool,
) -> Result[tuple[BodyIrModule, ConstructorIndex, list[NominalInstance], list[str]], str]:
    """Specialize one serially or concurrently projected module context under the same deterministic layout rules."""
    trace_lowering_footprint(footprint_trace, "joined project")
    # Later generic-instance and publication work reads only source nominal and enum declarations. Retain that
    # declaration authority without keeping a second copy of executable bodies or the other joined module tables.
    mut source_context = BodyIrModule.declarations_only(str(context.module_id.path()))
    source_context.nominal_declarations = list(context.nominal_declarations)
    source_context.enum_declarations = list(context.enum_declarations)
    constructors = with_generic_constructor_arities(
        index_constructors(source_context.nominal_declarations, source_files, package_versions),
        retained_templates,
    )
    template_references = referenced_templates(context)
    trace_lowering_footprint(footprint_trace, "retained source templates")
    # A closed enum payload can name a nominal instance no frame uses, and a closed nominal field or method frame can
    # name an enum instance no source frame uses, so enum layouts are discovered before nominal specialization and
    # installed again from the same joined context afterwards.
    trace_lowering(trace, "discover enum payload dependencies")
    enum_layouts = specialized_enum_layouts(context)?
    trace_lowering(trace, "specialize nominals")
    nominal_instances = specialize_nominals_with_instances(constructors, context, enum_layouts)?
    trace_lowering_footprint(footprint_trace, "specialized nominals")
    trace_lowering(trace, "specialize enums")
    specialize_enums(context)?
    trace_lowering_footprint(footprint_trace, "specialized enums")
    return Ok((source_context, constructors, nominal_instances, template_references))


pub def source_file_index(modules: &list[BodyIrModule], files: &list[str]) -> Result[BTreeMap[str, str], str]:
    """Bind every checked module identity to its aligned source input without inferring files from reference sites."""
    if len(modules) != len(files):
        return Err("invalid Body IR project source provenance")
    mut indexed: BTreeMap[str, str] = BTreeMap.new()
    for position in range(len(modules)):
        module = str(borrowed_at(modules, position).module_id.path())
        if indexed.contains_key(module):
            return Err(f"duplicate Body IR source provenance for module {module}")
        indexed.insert(module, files[position])
    return Ok(indexed)


def trace_lowering(enabled: bool, stage: str) -> None:
    """Report one requested lowering stage without repeating diagnostic selection at each step."""
    if enabled:
        println(f"lowering: {stage}")


def trace_lowering_footprint(enabled: bool, boundary: str) -> None:
    """Report physical footprint and live allocator bytes at a requested boundary, without affecting ordinary runs."""
    if not enabled:
        return
    match current_footprint():
        Ok(footprint) =>
            match current_live_allocated():
                Ok(live) => println(f"lowering footprint: {boundary}: {footprint} bytes; live allocated: {live} bytes")
                Err(reason) => println(
                    f"lowering footprint: {boundary}: {footprint} bytes; live allocated: unavailable: {reason}",
                )
        Err(reason) => println(f"lowering footprint: {boundary}: unavailable: {reason}")


def validate_plan_inputs(
    modules: &list[BodyIrModule],
    sources: &list[str],
    files: &list[str],
    entry: int,
    retained: &BodyIrModule,
) -> Result[None, str]:
    """Validate source provenance and checked authority, including retained continuation facts, before indexing."""
    if len(modules) == 0 or entry < 0 or entry >= len(modules):
        return Err("invalid Body IR project entry")
    if len(sources) != len(modules) or len(files) != len(modules):
        return Err("invalid Body IR project source provenance")
    _selected_entries = validate_program_entry_selection(modules, entry, retained)?
    _conversion_placement = validate_conversion_placement(modules, entry)?
    for module_position in range(len(modules)):
        module = borrowed_at(modules, module_position)
        _ = validate_project_module(module, modules, retained)?
    return Ok(None)


def main_selection(context: &BodyIrModule, entry_owner: str) -> tuple[bool, bool]:
    """Separate the checked program entry from an ordinary declaration merely spelled main."""
    mut selected = false
    mut declared = false
    for body in context.bodies:
        match body_module_identity(body):
            Ok(owner) =>
                if owner != entry_owner:
                    continue
            Err(_reason) => continue
        if str(body.name) == "main":
            declared = true
        if is_program_entry(context, body):
            selected = true
    return (selected, declared)
