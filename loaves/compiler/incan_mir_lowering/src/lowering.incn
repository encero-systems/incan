"""
Lower the frontend's canonical checked Body IR into an `incan_mir_plan` plan.

The Body IR is read through Rust interop: the real `incan_semantics_core` types, borrowed, never a serialized or
mirrored copy. Every module is validated before any lowering reads its identities, and every construct outside the
supported slice is refused by name rather than lowered approximately.

This module owns the boundary types, project validation, and plan assembly. Program entries, function frames, and
each construct's lowering live in their own modules.
"""

from pub::incan_mir_plan import (
    source_span as plan_span,
    ExternalFunction,
    Function,
    ModelDeclaration,
    EnumDeclaration,
    Plan,
    PlanExport,
    GenericModelDeclaration,
    GenericEnumDeclaration,
    StaticCell,
    ZipCarrier,
)
from trait_links import validate_project_implementation, has_open_trait_arguments
from rust::std::env import var_os as native_environment
from rust::incan_semantics_core import IncanType as RustType
from rust::incan_semantics_core::body_ir import NativeUnionDeclaration, BodyIrModule as RustBodyIrModule
from classes import is_program_entry
from project import project_context
from body_index import body_index
from program_context import ProgramContext
from native_type_identity import ConstructorIndex, constructor_index as index_constructors
from rust::std::sync import Arc
from nominal_instances import NominalInstance, specialize_nominals_with_instances
from checked_json import lower_checked_deserialize
from string_conversion import lower_string_conversions
from string_conversion_contracts import validate_conversion_placement
from table_views import borrowed_at
from enum_instances import specialize_enums
from display_methods import display_functions
from comparison_methods import comparison_functions, attach_enum_comparisons
from decorator_caches import validate_instance_binding
from decls import lower_model_declarations, publish_local_layouts
from fallible_factories import retain_factory_callable_storage
from enums import lower_enum_declarations
from unions import publish_unions, collect_unions, union_index
from generic_layouts import generic_models
from generic_enums import generic_enums
from options import intrinsic_declarations
from async_ import validate_futures
from type_parameters import Instance, merge_instance_requests
from runtime_layouts import runtime_zip_carriers
from runtime_requirements import RuntimeRetention, FramesPlanning, BodyPlanning, UnitPlanning
from program_entries import (
    EmittedFrames,
    collected_test_entries,
    comparison_bridge_instances,
    loaf_exports,
    lower_ordinary_bodies,
    no_emitted_frames,
    selected_program_entries,
    validate_program_entry_selection,
)
from static_storage import lower_computed_statics
from frame_instances import lower_instances, merge_externals


pub type BodyIrModule = rusttype RustBodyIrModule:
    """The frontend-owned canonical module, borrowed without conversion or duplication."""


def validate_project_module(module: &BodyIrModule, modules: &list[BodyIrModule]) -> Result[int, str]:
    """Validate one module of a project, resolving its trait implementations against every module of the project."""
    count = validate_declarations_and_bodies(module, modules)?
    for implementation_position in range(len(module.trait_implementations)):
        implementation = borrowed_at(module.trait_implementations, implementation_position)
        match validate_project_implementation(module, implementation, modules):
            Ok(_valid) => pass
            Err(reason) =>
                if has_open_trait_arguments(implementation):
                    return Err("unsupported Body IR open trait default type arguments")
                return Err(
                    f"{reason}; owner={implementation.owner:?}; slot={implementation.method:?}; implementation={implementation.implementation:?}",
                )
    return Ok(count)


def validate_declarations_and_bodies(module: &BodyIrModule, modules: &list[BodyIrModule]) -> Result[int, str]:
    """
    Validate a module's retained declarations and bodies; trait implementations are validated by the caller.

    A generic decorator initializer is admitted only for a synchronous per-instantiation binding. Its closed instances
    publish their own storage cells; they never enter ordinary module-static initialization or fall through to the
    undecorated original.
    """
    for binding in module.decorated_bindings:
        if not module.is_well_formed_decorated_binding_in_project(binding, modules):
            return Err("invalid Body IR decorated binding identity")
        match binding.initializer:
            Some(_initializer) => _ = validate_instance_binding(binding)?
            None => pass
    for declaration in module.static_declarations:
        if not module.is_well_formed_static_declaration_in_project(declaration, modules):
            return Err("invalid Body IR static declaration")
    for enum_position in range(len(module.enum_declarations)):
        declaration = borrowed_at(module.enum_declarations, enum_position)
        if not module.is_well_formed_native_enum_declaration(declaration):
            return Err("invalid Body IR normal enum declaration identity")
    for nominal_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, nominal_position)
        if not module.is_well_formed_nominal_declaration(declaration):
            return Err(f"invalid Body IR nominal declaration identity {declaration.name} in {module.module_id.path()}")
    for declaration in module.fieldless_enum_declarations:
        if not module.is_well_formed_fieldless_enum_declaration(declaration):
            return Err("invalid Body IR fieldless enum declaration identity")
    for declaration_position in range(len(module.value_enum_declarations)):
        declaration = borrowed_at(module.value_enum_declarations, declaration_position)
        if not module.is_well_formed_value_enum_declaration(declaration):
            return Err("invalid Body IR value enum declaration identity")
    for body_position in range(len(module.bodies)):
        body = borrowed_at(module.bodies, body_position)
        if not module.body_has_canonical_direct_call_id(body):
            return Err(f"unsupported Body IR body identity {module.module_id.path()}::{body.name}")
    return Ok(len(module.bodies))


pub def unit_plan(
    modules: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut published: list[NativeUnionDeclaration],
    overflow_checks: bool = true,
) -> Result[UnitPlanning, str]:
    """Lower one checked unit by kind; test entries come from session collection, never from naming heuristics here."""
    if kind != "program" and kind != "library" and kind != "test":
        return Err(f"unsupported unit kind {kind}")
    return lowered_plan(modules, sources, files, entry, kind, tests, published, overflow_checks)


def program_context(
    constructors: Arc[ConstructorIndex],
    module: &BodyIrModule,
    mut intrinsics: list[EnumDeclaration],
    unions: list[RustType],
    overflow_checks: bool = true,
) -> Result[ProgramContext, str]:
    """Freeze program dispatch mappings after layout admission, copying storage once from the still-borrowed checked module."""
    # Resolve the native loan before applying another module's source-type expectation (seed compiler, #2256).
    constructor_view = constructors.as_ref()
    return Ok(
        ProgramContext(
            body_indices=body_index(module),
            bodies=Arc.new(list(module.bodies)),
            display_functions=Arc.new(display_functions(constructor_view, module, intrinsics)?),
            statics=Arc.new(list(module.static_declarations)),
            comparison_functions=Arc.new(comparison_functions(constructor_view, module, intrinsics)?),
            union_types=union_index(unions),
            nominals=Arc.new(list(module.nominal_declarations)),
            constructors=constructors,
            enums=Arc.new(list(module.enum_declarations)),
            value_enums=Arc.new(list(module.value_enum_declarations)),
            decorated_bindings=Arc.new(list(module.decorated_bindings)),
            overflow_checks=overflow_checks,
        ),
    )


def lowered_plan(
    modules: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut published: list[NativeUnionDeclaration],
    overflow_checks: bool,
) -> Result[UnitPlanning, str]:
    """Lower a checked unit: 1. Prepare layouts. 2. Lower bodies and instances. 3. Publish the completed plan."""
    trace_key: str = "INCAN_TRACE_LOWERING"
    trace = native_environment(trace_key).is_some()
    # 1. Validate the checked inputs and prepare their shared layouts.
    source_context, template_constructors, checked, specialized_context, nominal_instances = plan_contexts(
        modules,
        sources,
        files,
        entry,
        trace,
    )?
    mut context = specialized_context
    constructor_table, unions, initial_intrinsics = layout_tables(context, files[entry])?
    constructors = Arc.new(constructor_table)
    mut intrinsics = initial_intrinsics
    mut models: list[ModelDeclaration] = []
    mut enums: list[EnumDeclaration] = []
    mut functions: list[Function] = []
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    initial_program = initial_plan_roots(
        constructors,
        context,
        files[entry],
        intrinsics,
        nominal_instances,
        kind,
        unions,
        overflow_checks,
        trace,
        models,
        enums,
        functions,
        externals,
        instances,
    )?
    mut program = initial_program
    mut emitted_frames = no_emitted_frames()
    # 2. Lower ordinary frames, static initializers and their requested instances.
    mut retained_nominals = nominal_instances
    mut statics: list[StaticCell] = []
    mut original_nominal_count: int = 0
    match lower_plan_frames(
        template_constructors,
        context,
        source_context,
        program,
        checked,
        sources,
        files,
        entry,
        kind,
        tests,
        intrinsics,
        functions,
        externals,
        instances,
        emitted_frames,
        unions,
        retained_nominals,
        trace,
    )?:
        BodyPlanning.NeedsRuntime(requests) => return Ok(UnitPlanning.NeedsRuntime(requests))
        BodyPlanning.Complete((retained, original)) =>
            statics = retained
            original_nominal_count = original
    retained_constructors = program.constructors.as_ref()
    original_constructors = constructors.as_ref()
    if len(context.nominal_declarations) != original_nominal_count:
        models = lower_model_declarations(
            retained_constructors,
            context,
            files[entry],
            intrinsics,
            retained_nominals,
            kind == "library",
        )?
    zip_carriers = finish_instance_layouts(
        original_constructors,
        retained_constructors,
        context,
        original_nominal_count,
        functions,
        models,
        enums,
        externals,
        intrinsics,
        kind,
    )?
    # 3. Publish only the declarations and entry points retained by the completed plan.
    mut exports: list[PlanExport] = []
    mut templates: list[GenericModelDeclaration] = []
    mut enum_templates: list[GenericEnumDeclaration] = []
    if kind == "library":
        templates = generic_models(template_constructors, source_context, retained_nominals, files[entry])?
        enum_templates = generic_enums(template_constructors, source_context, context, enums, intrinsics, files[entry])?
        exports = loaf_exports(context, emitted_frames.body_positions, source_context, templates, enum_templates)
        publish_unions(original_constructors, context, intrinsics, published)?
    planned = completed_plan(
        context,
        checked[entry],
        kind,
        tests,
        files[entry],
        functions,
        models,
        enums,
        externals,
        statics,
        exports,
        templates,
        enum_templates,
        zip_carriers,
    )?
    return Ok(UnitPlanning.Complete(planned))


pub def initial_plan_roots(
    constructors: Arc[ConstructorIndex],
    context: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    kind: str,
    unions: list[RustType],
    overflow_checks: bool,
    trace: bool,
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
) -> Result[ProgramContext, str]:
    """
    Fill empty planning inventories with generated functions and declaration roots for either entry point.

    1. Retain checked deserialization and string conversion roots in declaration order.
    2. Admit model and enum layouts with the selected unit kind and profile policy.
    3. Merge their runtime and instance requests through the ordinary admission rules.
    """
    # 1. Generated roots precede ordinary bodies and keep the same refusal order.
    trace_lowering(trace, "checked deserialize")
    checked_functions, checked_runtime, checked_instances = lower_checked_deserialize(
        constructors,
        context,
        nominal_instances,
        file,
        intrinsics,
    )?
    trace_lowering(trace, "string conversions")
    string_functions, conversion_runtime = lower_string_conversions(constructors, context, file, intrinsics)?
    # 2. Library publication and overflow policy belong to the selected unit, including diagnostic lowering.
    prepared_models, prepared_enums, program = initial_plan_layouts(
        constructors,
        context,
        file,
        intrinsics,
        nominal_instances,
        kind,
        unions,
        overflow_checks,
        trace,
    )?
    # 3. Both callers consume the same admitted roots without rebuilding their inventories.
    models.extend(prepared_models)
    enums.extend(prepared_enums)
    functions.extend(checked_functions)
    functions.extend(string_functions)
    externals.extend(checked_runtime)
    merge_externals(externals, conversion_runtime)?
    merge_instance_requests(instances, checked_instances)
    merge_instance_requests(instances, comparison_bridge_instances(context, models, enums))
    return Ok(program)


pub def layout_tables(
    context: &BodyIrModule,
    file: str,
) -> Result[tuple[ConstructorIndex, list[RustType], list[EnumDeclaration]], str]:
    """Create matched constructor, union and intrinsic tables for either planning entry point."""
    constructors = index_constructors(context.nominal_declarations)
    unions = collect_unions(context)
    intrinsics = intrinsic_declarations(constructors, context, file)?
    return Ok((constructors, unions, intrinsics))


def completed_plan(
    context: &BodyIrModule,
    entry: &BodyIrModule,
    kind: str,
    tests: list[str],
    file: str,
    functions: list[Function],
    models: list[ModelDeclaration],
    enums: list[EnumDeclaration],
    externals: list[ExternalFunction],
    statics: list[StaticCell],
    exports: list[PlanExport],
    templates: list[GenericModelDeclaration],
    enum_templates: list[GenericEnumDeclaration],
    zip_carriers: list[ZipCarrier],
) -> Result[Option[Plan], str]:
    """Admit the completed unit's test and program entries, then transfer its owned native inventories into the plan."""
    has_main, declares_main = main_selection(context, entry)
    test_entries = collected_test_entries(context, entry, tests, functions, enums)?
    if kind == "program" and not has_main:
        if declares_main:
            return Err("unsupported Body IR selected main representation")
        return Ok(None)
    return Ok(
        Some(
            Plan(
                enums=enums,
                models=models,
                functions=functions,
                externals=externals,
                span=plan_span(file=file, line=1, column=1),
                statics=statics,
                exports=exports,
                tests=test_entries,
                programs=selected_program_entries(context)?,
                generic_models=templates,
                generic_enums=enum_templates,
                zip_carriers=zip_carriers,
            ),
        ),
    )


def lower_plan_frames(
    template_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    templates: &BodyIrModule,
    mut program: ProgramContext,
    checked: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
    kind: str,
    tests: list[str],
    mut intrinsics: list[EnumDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
    mut emitted_frames: EmittedFrames,
    unions: list[RustType],
    mut retained_nominals: list[NominalInstance],
    trace: bool,
) -> Result[BodyPlanning, str]:
    """Lower ordinary frames, then retain request layouts and the nominal length for source restoration."""
    lower_ordinary_bodies(
        context,
        program,
        checked,
        sources,
        files,
        entry,
        kind,
        tests,
        intrinsics,
        functions,
        externals,
        instances,
        emitted_frames,
        unions,
        trace,
    )?
    original_nominal_count = len(context.nominal_declarations)
    match lower_requested_frames(
        template_constructors,
        context,
        templates,
        program,
        instances,
        unions,
        sources,
        files,
        checked,
        functions,
        externals,
        intrinsics,
        retained_nominals,
        trace,
    )?:
        FramesPlanning.NeedsRuntime(requests) => return Ok(BodyPlanning.NeedsRuntime(requests))
        FramesPlanning.Complete(statics) => return Ok(BodyPlanning.Complete((statics, original_nominal_count)))


def initial_plan_layouts(
    constructors: Arc[ConstructorIndex],
    context: &BodyIrModule,
    file: str,
    mut intrinsics: list[EnumDeclaration],
    nominal_instances: &list[NominalInstance],
    kind: str,
    unions: list[RustType],
    overflow_checks: bool,
    trace: bool,
) -> Result[tuple[list[ModelDeclaration], list[EnumDeclaration], ProgramContext], str]:
    """Admit model and enum layouts in order, then freeze their matching program lookup context."""
    constructor_view = constructors.as_ref()
    trace_lowering(trace, "model declarations")
    models = lower_model_declarations(constructor_view, context, file, intrinsics, nominal_instances, kind == "library")?
    trace_lowering(trace, "enum declarations")
    mut enums = lower_enum_declarations(constructor_view, context, file, intrinsics)?
    attach_enum_comparisons(constructor_view, context, enums, intrinsics)?
    program = program_context(constructors, context, intrinsics, unions, overflow_checks)?
    return Ok((models, enums, program))


def finish_instance_layouts(
    original_constructors: &ConstructorIndex,
    retained_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    original_nominal_count: int,
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    kind: str,
) -> Result[list[ZipCarrier], str]:
    """Retain closed storage, restore the source inventory, then finalize with its paired index."""
    zip_carriers = runtime_zip_carriers(retained_constructors, context, intrinsics)?
    # Closed frames keep their native layouts; source exports retain the original declaration inventory.
    while len(context.nominal_declarations) > original_nominal_count:
        _ = context.nominal_declarations.pop()
    finalize_plan_layouts(
        original_constructors,
        context,
        functions,
        models,
        enums,
        externals,
        intrinsics,
        kind == "library",
    )?
    return Ok(zip_carriers)


def lower_requested_frames(
    template_constructors: &ConstructorIndex,
    mut context: &mut BodyIrModule,
    templates: &BodyIrModule,
    mut program: ProgramContext,
    mut instances: list[Instance],
    unions: list[RustType],
    sources: list[str],
    files: list[str],
    checked: &list[BodyIrModule],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    mut retained_nominals: list[NominalInstance],
    trace: bool,
) -> Result[FramesPlanning, str]:
    """Lower static initializers before draining the checked callable requests they and ordinary bodies contribute."""
    mut owners: list[str] = []
    for module_position in range(len(checked)):
        module = borrowed_at(checked, module_position)
        owners.append(str(module.module_id.path()))
    statics = lower_computed_statics(
        context,
        program,
        unions,
        sources,
        files,
        owners,
        intrinsics,
        functions,
        externals,
        instances,
    )?
    trace_lowering(trace, "generic instances")
    mut instance_cells: list[StaticCell] = []
    match lower_instances(
        template_constructors,
        context,
        templates,
        program,
        instances,
        unions,
        sources,
        files,
        owners,
        functions,
        externals,
        intrinsics,
        retained_nominals,
        instance_cells,
    )?:
        RuntimeRetention.NeedsRuntime(requests) => return Ok(FramesPlanning.NeedsRuntime(requests))
        RuntimeRetention.Complete => pass
    mut cells = statics
    for cell in instance_cells:
        cells.append(cell)
    return Ok(FramesPlanning.Complete(cells))


def finalize_plan_layouts(
    constructors: &ConstructorIndex,
    context: &BodyIrModule,
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut enums: list[EnumDeclaration],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
    publish: bool,
) -> Result[None, str]:
    """Publish completed layouts and validate callable and coroutine storage after every instance has contributed."""
    # Instance lowering can append carriers needed by a callable or coroutine capture.
    for declaration_position in range(len(intrinsics)):
        declaration = borrowed_at(intrinsics, declaration_position)
        enums.append(declaration)
    if publish:
        publish_local_layouts(models, enums)
    retain_factory_callable_storage(context, functions, models, externals)?
    validate_futures(constructors, context, intrinsics)?
    return Ok(None)


# The immutable source context retains its matching constructor index beside checked and specialized layouts.
pub type PlanContexts = tuple[BodyIrModule, ConstructorIndex, list[BodyIrModule], BodyIrModule, list[NominalInstance]]


pub def plan_contexts(
    modules: &list[BodyIrModule],
    sources: &list[str],
    files: &list[str],
    entry: int,
    trace: bool,
) -> Result[PlanContexts, str]:
    """Validate project authority and retain checked source and specialized layouts in dependency order."""
    trace_lowering(trace, "validate modules")
    validate_plan_inputs(modules, sources, files, entry)?
    trace_lowering(trace, "project context")
    source_context, checked = project_context(modules, entry)?
    constructors = index_constructors(source_context.nominal_declarations)
    trace_lowering(trace, "specialize nominals")
    nominal_context, nominal_instances = specialize_nominals_with_instances(constructors, source_context)?
    trace_lowering(trace, "specialize enums")
    context = specialize_enums(nominal_context)?
    return Ok((source_context, constructors, checked, context, nominal_instances))


def trace_lowering(enabled: bool, stage: str) -> None:
    """Report one requested lowering stage without repeating diagnostic selection at each step."""
    if enabled:
        println(f"lowering: {stage}")


def validate_plan_inputs(
    modules: &list[BodyIrModule],
    sources: &list[str],
    files: &list[str],
    entry: int,
) -> Result[None, str]:
    """Validate source provenance and checked project authority before indexing any module or layout table."""
    if len(modules) == 0 or entry < 0 or entry >= len(modules):
        return Err("invalid Body IR project entry")
    if len(sources) != len(modules) or len(files) != len(modules):
        return Err("invalid Body IR project source provenance")
    _selected_entries = validate_program_entry_selection(modules, entry)?
    _conversion_placement = validate_conversion_placement(modules, entry)?
    for module_position in range(len(modules)):
        module = borrowed_at(modules, module_position)
        _ = validate_project_module(module, modules)?
    return Ok(None)


def main_selection(context: &BodyIrModule, entry: &BodyIrModule) -> tuple[bool, bool]:
    """Separate the checked program entry from an ordinary declaration merely spelled main."""
    mut selected = false
    mut declared = false
    for body in entry.bodies:
        if str(body.name) == "main":
            declared = true
        if is_program_entry(context, body):
            selected = true
    return (selected, declared)
