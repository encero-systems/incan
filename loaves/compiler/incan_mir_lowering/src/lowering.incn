from rust::incan_semantics_core::body_ir import NativeUnionDeclaration, BodyIrModule as RustBodyIrModule
from classes import body_module_identity, is_program_entry
from project import project_context, project_context_parallel
from continuation_context import continuation_inputs, extend_continuation_context, refresh_entry_context
from body_index import body_index
from program_context import ProgramContext, extend_program_context
from native_type_identity import (
    ConstructorIndex,
    constructor_index_with_packages as index_constructors,
    extend_constructor_index,
    extend_constructor_authority,
    extend_generic_constructor_arities,
    with_generic_constructor_arities,
)
from rust::std::collections import BTreeMap
from rust::std::mem import drop
from rust::std::sync import Arc
from rust::std::marker import Send, Sync
from nominal_instances import NominalInstance, specialize_nominals_with_instances
from checked_json import lower_checked_deserialize
from string_conversion import lower_string_conversions
from string_conversion_contracts import validate_conversion_placement
