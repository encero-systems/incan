pub type BodyIrModule = rusttype RustBodyIrModule:
    """The frontend-owned canonical module, borrowed without conversion or duplication."""


pub type BodyStatementKind = rusttype RustStatementKind:
    """The real checked statement vocabulary used by borrowed boundary conformance tests."""


pub def validate_module(module: &BodyIrModule) -> Result[int, str]:
    """Validate every retained declaration and body before consuming its facts."""
    count = validate_declarations_and_bodies(module)?
    for implementation in module.trait_implementations:
        if not is_well_formed_module_implementation(module, implementation):
            if has_open_trait_arguments(implementation):
                return Err("unsupported Body IR open trait default type arguments")
            return Err("invalid Body IR trait implementation identity")
    return Ok(count)


def validate_project_module(module: &BodyIrModule, modules: &list[BodyIrModule]) -> Result[int, str]:
    """Validate one module of a project, resolving its trait implementations against every module of the project."""
    count = validate_declarations_and_bodies(module)?
    for implementation in module.trait_implementations:
        if not is_well_formed_project_implementation(module, implementation, modules):
            if has_open_trait_arguments(implementation):
                return Err("unsupported Body IR open trait default type arguments")
            return Err("invalid Body IR trait implementation identity")
    return Ok(count)


def validate_declarations_and_bodies(module: &BodyIrModule) -> Result[int, str]:
    """Validate a module's retained declarations and bodies; trait implementations are validated by the caller."""
    for binding in module.decorated_bindings:
        if not module.is_well_formed_decorated_binding(binding):
            return Err("invalid Body IR decorated binding identity")
    for declaration in module.static_declarations:
        if not module.is_well_formed_static_declaration(declaration):
            return Err("invalid Body IR static declaration")
    for declaration in module.enum_declarations:
        if not module.is_well_formed_native_enum_declaration(declaration):
            return Err("invalid Body IR normal enum declaration identity")
    for declaration in module.nominal_declarations:
        if not module.is_well_formed_nominal_declaration(declaration):
            return Err("invalid Body IR nominal declaration identity")
    for declaration in module.fieldless_enum_declarations:
        if not module.is_well_formed_fieldless_enum_declaration(declaration):
            return Err("invalid Body IR fieldless enum declaration identity")
    for declaration in module.value_enum_declarations:
        if not module.is_well_formed_value_enum_declaration(declaration):
            return Err("invalid Body IR value enum declaration identity")
    for body in module.bodies:
        if not module.body_has_canonical_direct_call_id(body):
            return Err("invalid Body IR body identity")
    return Ok(len(module.bodies))


pub def count_continues(module: &BodyIrModule) -> Result[int, str]:
    """
    Match the retained statements after validating their owning bodies.

    This boundary probe counts only top-level continue statements. It does not
    construct a plan or infer executable coverage from the count.
    """
    _ = validate_module(module)?
    mut count = 0
    for body in module.bodies:
        for statement in body.block.stmts:
            match statement.kind:
                RustStatementKind.Continue =>
                    count += 1
                _ => pass
    return Ok(count)


pub def is_continue(statement: &BodyStatementKind) -> bool:
    """Read the real Body IR statement enum through a shared borrow."""
    match statement:
        BodyStatementKind.Continue => return true
        _ => return false
# =====================================================================================================================
# Translating checked values
# =====================================================================================================================


def location(span: &RustSpan, source: str, file: str) -> SourceSpan:
    """Map the checked byte offset to the source line and byte column."""
    mut start = 0
    mut number = 1
    offset = int(span.start)
    for line in source.split("\n"):
        width = len(line.encode())
        if offset <= start + width:
            return SourceSpan(file=file, line=number, column=offset - start + 1)
        start += width + 1
        number += 1
    return SourceSpan(file=file, line=number, column=1)


pub def scalar_place(builder: Builder, value: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Map a local or proven model field into the native frame, which reserves local zero for return."""
    match union_projection(
        builder.nominals,
        builder.enums,
        builder.unions,
        builder.locals[builder.local_offset:],
        value,
        span,
        builder.intrinsics,
    )?:
        Some(projected) =>
            mut target = projected
            target.local += builder.local_offset
            return Ok(target)
        None => pass
    mut target = model_place(
        builder.nominals,
        builder.locals[builder.local_offset:],
        value,
        span,
        builder.enums,
        builder.unions,
        builder.intrinsics,
    )?
    target.local += builder.local_offset
    return Ok(target)


pub def scalar_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Preserve each scalar read's checked ownership fact rather than inferring it."""
    match value:
        RustOperand.Place(read) => return place_read(builder, read.place, read.fact, span)
        RustOperand.Constant(constant) =>
            match constant:
                RustConstant.FrozenAggregate(_ty, _elements) =>
                    return frozen_collection_literal(builder, constant, span)
                RustConstant.Str(text) => return Ok(read_place(owned_literal(builder, str(text), span), true, span))
                RustConstant.FrozenStr(_text) => return frozen_literal(builder, constant, span)
                RustConstant.TypedNumeric(value) =>
                    if is_decimal_literal(value):
                        return decimal_literal(builder, value, span)
                _ => return scalar_constant(constant, span)
            return scalar_constant(constant, span)


def place_read(mut builder: Builder, value: &RustPlace, fact: &OwnershipFact, span: SourceSpan) -> Result[Operand, str]:
    """Turn a place read into a copy or move exactly as Body IR's ownership fact says."""
    match value.global():
        Some(global) => return read_static(builder, value, global, fact, span)
        None => pass
    # An element read materializes a copy, which would silently drop a write through a mutable borrow.
    match fact:
        OwnershipFact.MutBorrow =>
            if is_element_place(builder, value)?:
                return Err("unsupported Body IR mutable list element borrow")
        _ => pass
    match element_read(builder, value, span)?:
        Some(operand) => return Ok(operand)
        None => pass
    return target_read(builder, scalar_place(builder, value, span)?, fact, span)


def target_read(mut builder: Builder, target: Place, fact: &OwnershipFact, span: SourceSpan) -> Result[Operand, str]:
    """Read a resolved frame place as a copy, move or clone, exactly as Body IR's ownership fact says."""
    # Only the binding remembers a partial's supplied flags, so a partial is called or moved into a binding, never read.
    match partial_flags(builder, target.local):
        Some(_flags) => return Err("unsupported Body IR partial read outside a call or a binding")
        None => pass
    if callable_copy_type(place_type(builder.locals, target)):
        match fact:
            OwnershipFact.Unknown => return Err("unsupported Body IR unknown callable ownership")
            OwnershipFact.MutBorrow => return Err("unsupported Body IR mutable callable borrow")
            _ => return Ok(read_place(target, false, span))
    match place_type(builder.locals, target):
        PlanType.ClosureRef(_signature) =>
            match fact:
                OwnershipFact.Unknown => return Err("unsupported Body IR unknown callable-object ownership")
                OwnershipFact.MutBorrow => return Err("unsupported Body IR mutable callable-object borrow")
                _ => return Ok(read_place(target, false, span))
        PlanType.Closure(_signature) =>
            match fact:
                OwnershipFact.Move =>
                    if target.projection != Projection.Whole:
                        return Err("unsupported Body IR partial closure move")
                    return Ok(read_place(target, true, span))
                _ => return Err("unsupported Body IR closure read outside a call, argument, or move")
        _ => pass
    match fact:
        OwnershipFact.Copy => return Ok(Operand(kind=OperandKind.Copy(target), span=span))
        OwnershipFact.Move =>
            if target.projection != Projection.Whole and (place_type(builder.locals, target) == PlanType.String or tuple_has_owners(
                place_type(builder.locals, target),
            )):
                return Err("unsupported Body IR partial model move")
            # The whole tuple stays an owner, so moving an owned element out of it would drop that element twice.
            if target.projection != Projection.Whole and is_tuple_type(builder.locals[target.local].ty) and owned_carrier(
                place_type(builder.locals, target),
            ):
                return Err("unsupported Body IR partial tuple move")
            # A value reached through a reference stays its owner's; moving it out would leave that owner empty.
            if is_nominal_type(place_type(builder.locals, target)) and reads_through_reference(target):
                return Err("unsupported Body IR move out of a borrowed value")
            return Ok(Operand(kind=OperandKind.Move(target), span=span))
        OwnershipFact.Clone =>
            if frozen_observation_type(place_type(builder.locals, target)):
                return Ok(read_place(target, false, span))
            # A checked clone of an open parameter becomes Rust's copy-valued Clone on concrete scalar instances.
            ty = place_type(builder.locals, target)
            # A range value's four scalar fields own nothing, so its clone is a copy, as legacy's is.
            if numeric_carrier(ty) or ty == PlanType.Bool or ty == PlanType.Unit or ty == PlanType.RangeValue:
                return Ok(Operand(kind=OperandKind.Copy(target), span=span))
            if is_tuple_type(place_type(builder.locals, target)):
                return clone_tuple_operand(builder, target, span)
            if is_list(ty) and is_tuple_type(builder.locals[target.local].ty):
                return carrier_payload_value(builder, target, span)
            if place_type(builder.locals, target) == PlanType.String:
                cloned = clone_text(builder, target, span)?
                return Ok(read_place(cloned, true, span))
            return clone_nominal_operand(builder, target, span)
        OwnershipFact.Borrow =>
            if frozen_observation_type(place_type(builder.locals, target)):
                return Ok(read_place(target, false, span))
            if is_tuple_type(place_type(builder.locals, target)):
                return clone_tuple_operand(builder, target, span)
            # A list held by a tuple element is materialized by cloning it, leaving the owning tuple whole.
            if is_list(place_type(builder.locals, target)) and is_tuple_type(builder.locals[target.local].ty):
                return carrier_payload_value(builder, target, span)
            # A checked projected read borrows its parent. Materialize only the selected enum or model through its real
            # Clone implementation; copying or moving that field would invalidate the still-owned parent. A model
            # read through a shared receiver is cloned the same way, as legacy clones `self` to return it.
            match place_type(builder.locals, target):
                PlanType.Enum(_owner, _name) =>
                    match target.projection:
                        Projection.Field(_slot, _ty) => return clone_nominal_operand(builder, target, span)
                        Projection.VariantField(_variant, _slot, _ty) =>
                            return clone_nominal_operand(builder, target, span)
                        Projection.Fields(_fields) => return clone_nominal_operand(builder, target, span)
                        _ => pass
                PlanType.Model(_owner, _name) =>
                    match target.projection:
                        Projection.Whole => pass
                        Projection.VariantField(_variant, _slot, _ty) => pass
                        _ => return clone_nominal_operand(builder, target, span)
                PlanType.ModelRef(_owner, _name) => return clone_nominal_operand(builder, target, span)
                _ => pass
            match target.projection:
                Projection.VariantField(_variant, _slot, _ty) => return enum_payload_read(builder, target, fact, span)
                _ =>
                    selected_type = place_type(builder.locals, target)
                    # A checked borrow of a value of an open type parameter, a field of a generic model say, reads a
                    # copy once the instance makes it a concrete scalar, which owns nothing the borrow would protect.
                    if numeric_carrier(selected_type) or selected_type == PlanType.Bool or selected_type == PlanType.Unit:
                        return Ok(Operand(kind=OperandKind.Copy(target), span=span))
                    site = f"{builder.file}:{span.line}:{span.column} in {builder.name}"
                    detail = f"projection {target.projection:?}; selected type {selected_type:?}"
                    return Err(f"unsupported Body IR ownership Borrow outside formatting at {site}; {detail}")
        OwnershipFact.MutBorrow => return Err("unsupported Body IR ownership MutBorrow")
        OwnershipFact.Unknown => return Err("unsupported Body IR ownership Unknown")


def reads_through_reference(place: Place) -> bool:
    """Report whether a place reaches its value through a reference: a receiver, a `mut` parameter or an in-place view."""
    match place.projection:
        Projection.Deref(_ty) => return true
        Projection.DerefField(_slot, _ty) => return true
        Projection.DerefFields(_fields) => return true
        _ => return false


def scalar_constant(constant: &RustConstant, span: SourceSpan) -> Result[Operand, str]:
    """Turn a scalar literal into a plan constant; other literal kinds are refused by name."""
    match constant.clone():
        RustConstant.Int(number) => return Ok(literal(Constant.Int(number), span))
        RustConstant.Float(text) => return Ok(literal(Constant.Float(float(str(text))), span))
        RustConstant.Bool(flag) => return Ok(literal(Constant.Bool(flag), span))
        RustConstant.Unit => return Ok(literal(Constant.Unit, span))
        RustConstant.TypedNumeric(value) => return Ok(literal(numeric_constant(value)?, span))
        RustConstant.Str(_value) => return Err("unsupported Body IR Str constant")
        RustConstant.FrozenStr(_value) => return Err("Body IR FrozenStr constant requires its retained carrier")
        RustConstant.Bytes(_value) => return Err("unsupported Body IR Bytes constant")
        RustConstant.None => return Err("unsupported Body IR None constant")
        RustConstant.FrozenAggregate(_ty, _values) => return Err("unsupported Body IR frozen aggregate scalar constant")


def operand_type(mut builder: Builder, operand: Operand) -> Result[PlanType, str]:
    """The plan type an operand carries: its local's declared type, or its literal's type."""
    return value_type(builder, operand)


pub def binary_operator(operator: &BinOp) -> Result[BinaryOp, str]:
    """Translate only native scalar operations; operators with runtime semantics are separate calls."""
    match operator:
        BinOp.Add => return Ok(BinaryOp.Add)
        BinOp.Sub => return Ok(BinaryOp.Subtract)
        BinOp.Mul => return Ok(BinaryOp.Multiply)
        BinOp.Div => return Ok(BinaryOp.Divide)
        BinOp.Eq => return Ok(BinaryOp.Equal)
        BinOp.Ne => return Ok(BinaryOp.NotEqual)
        BinOp.Lt => return Ok(BinaryOp.Less)
        BinOp.Le => return Ok(BinaryOp.LessEqual)
        BinOp.Gt => return Ok(BinaryOp.Greater)
        BinOp.Ge => return Ok(BinaryOp.GreaterEqual)
        BinOp.FloorDiv => return Err("Body IR FloorDiv requires its runtime helper")
        BinOp.Mod => return Err("Body IR Mod requires its runtime helper")
        BinOp.Pow => return Err("unsupported Body IR Pow")
        BinOp.BitAnd => return Ok(BinaryOp.BitAnd)
        BinOp.BitOr => return Ok(BinaryOp.BitOr)
        BinOp.BitXor => return Ok(BinaryOp.BitXor)
        BinOp.Shl => return Ok(BinaryOp.ShiftLeft)
        BinOp.Shr => return Ok(BinaryOp.ShiftRight)
        BinOp.Is => return Err("unsupported Body IR Is")
        BinOp.IsNot => return Err("unsupported Body IR IsNot")
        BinOp.And => return Err("unsupported Body IR And")
        BinOp.Or => return Err("unsupported Body IR Or")


def is_bit_operator(operator: &BinOp) -> bool:
    """Select the integer bit operations legacy emits as Rust infix operators."""
    match operator:
        BinOp.BitAnd => return true
        BinOp.BitOr => return true
        BinOp.BitXor => return true
        BinOp.Shl => return true
        BinOp.Shr => return true
        _ => return false


def is_ordering(operator: &BinOp) -> bool:
    """Select the four ordering comparisons."""
    match operator:
        BinOp.Lt => return true
        BinOp.Le => return true
        BinOp.Gt => return true
        BinOp.Ge => return true
        _ => return false


def bit_operation(
    operator: &BinOp,
    left: Operand,
    left_type: PlanType,
    right: Operand,
    right_type: PlanType,
) -> Result[RvalueKind, str]:
    """Admit integer bit operations over one integer type; a shift keeps its left type and counts with any integer."""
    if not integer_carrier(left_type) or not integer_carrier(right_type):
        return Err("unsupported Body IR non-integer bit operands")
    shift = operator == BinOp.Shl or operator == BinOp.Shr
    if not shift and left_type != right_type:
        return Err("unsupported Body IR mixed integer bit operands")
    return Ok(RvalueKind.Binary(binary_operator(operator)?, left, right))


def scalar_operator_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Materialize indexed scalar operands and refuse collection operators before native validation."""
    operand = value_operand(builder, value, span)?
    if is_list(operand_type(builder, operand)?) or is_collection(operand_type(builder, operand)?):
        return Err("unsupported Body IR list scalar operator")
    return Ok(operand)


def unit_enum_comparison(
    mut builder: Builder,
    operator: &BinOp,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[RvalueKind, str]:
    """
    Compare fieldless tags without consuming either receiver; payload comparisons stay refused.

    Ordering compares the tags too, which is the derived order: native discriminants are the source variant indices.
    """
    if operator != BinOp.Eq and operator != BinOp.Ne and not is_ordering(operator):
        return Err("unsupported Body IR enum BinaryOp")
    left_place = enum_comparison_place(builder, left, span)?
    right_place = enum_comparison_place(builder, right, span)?
    validate_unit_comparison(
        builder.enums,
        place_type(builder.locals, left_place),
        place_type(builder.locals, right_place),
    )?
    if is_ordering(operator):
        validate_unit_ordering(builder.enums, place_type(builder.locals, left_place))?
    left_tag = enum_comparison_tag(builder, left_place, span)
    right_tag = enum_comparison_tag(builder, right_place, span)
    return Ok(
        RvalueKind.Binary(
            binary_operator(operator)?,
            read_place(left_tag, false, span),
            read_place(right_tag, false, span),
        ),
    )


def optional_none_comparison(
    mut builder: Builder,
    operator: &BinOp,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[Option[RvalueKind], str]:
    """Compare a checked Option against None by its tag without copying or equating its payload."""
    if operator != BinOp.Eq and operator != BinOp.Ne and operator != BinOp.Is and operator != BinOp.IsNot:
        return Ok(None)
    mut other = left
    if none_constant(right):
        other = left
    elif none_constant(left):
        other = right
    else:
        return Ok(None)
    if none_constant(other):
        return Ok(Some(RvalueKind.Use(literal(Constant.Bool(operator == BinOp.Eq or operator == BinOp.Is), span))))
    source = enum_comparison_place(builder, other, span)?
    if place_type(builder.locals, source) == PlanType.Unit:
        return Ok(Some(RvalueKind.Use(literal(Constant.Bool(operator == BinOp.Eq or operator == BinOp.Is), span))))
    _owner, declaration = carrier_layout(builder, place_type(builder.locals, source))?
    if declaration.carrier != "Option":
        return Err("invalid Body IR None comparison carrier")
    tag = enum_comparison_tag(builder, source, span)
    mut comparison = BinaryOp.Equal
    if operator == BinOp.Ne or operator == BinOp.IsNot:
        comparison = BinaryOp.NotEqual
    return Ok(Some(RvalueKind.Binary(comparison, read_place(tag, false, span), literal(Constant.Int(0), span))))


def none_constant(value: &RustOperand) -> bool:
    """Recognize only the retained None constant; ordinary unit values cannot authorize an Option tag comparison."""
    match value:
        RustOperand.Constant(RustConstant.None) => return true
        _ => return false


def enum_comparison_place(builder: Builder, operand: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Read the already-evaluated checked operand place before borrowing its native discriminant."""
    match operand:
        RustOperand.Place(read) => return scalar_place(builder, read.place, span)
        _ => return Err("unsupported Body IR nonplace enum comparison")


def enum_comparison_tag(mut builder: Builder, source: Place, span: SourceSpan) -> Place:
    """Materialize one native discriminant as the integer tag type used by checked match dispatch."""
    raw = temporary(builder, PlanType.EnumTag, span)
    tag = temporary(builder, PlanType.Int, span)
    builder.emit(plan_assign(raw, RvalueKind.Discriminant(source), span))
    builder.emit(plan_assign(tag, RvalueKind.TagToInt(read_place(raw, false, span)), span))
    return tag


def scalar_rvalue(
    module: &BodyIrModule,
    mut builder: Builder,
    value: &RustRvalue,
    expected: PlanType,
    span: SourceSpan,
) -> Result[RvalueKind, str]:
    """Read the checked expression; the retained destination carrier selects a proven constructor's closed layout."""
    match value:
        RustRvalue.Use(operand) => return Ok(RvalueKind.Use(value_operand(builder, operand, span)?))
        RustRvalue.UnaryOp(operator, operand) =>
            match operator:
                UnOp.Not => return Ok(RvalueKind.Unary(UnaryOp.Not, scalar_operator_operand(builder, operand, span)?))
                UnOp.Neg =>
                    return Ok(RvalueKind.Unary(UnaryOp.Negate, scalar_operator_operand(builder, operand, span)?))
                UnOp.Invert =>
                    inverted = scalar_operator_operand(builder, operand, span)?
                    if not integer_carrier(operand_type(builder, inverted)?):
                        return Err("unsupported Body IR non-integer unary operator Invert")
                    return Ok(RvalueKind.Unary(UnaryOp.Invert, inverted))
        RustRvalue.BinaryOp(operator, left, right) =>
            match optional_none_comparison(builder, operator, left, right, span)?:
                Some(result) => return Ok(result)
                None => pass
            if enum_operand(builder, left, span)? or enum_operand(builder, right, span)?:
                return unit_enum_comparison(builder, operator, left, right, span)
            if operator == BinOp.Eq or operator == BinOp.Ne:
                match collection_equality(builder, operator, left, right, span)?:
                    Some(result) => return Ok(RvalueKind.Use(result))
                    None => pass
            match text_comparison(builder, operator, left, right, span)?:
                Some(result) => return Ok(RvalueKind.Use(result))
                None => pass
            if operator == BinOp.Div:
                if not float_operand(
                    builder.nominals,
                    builder.locals[builder.local_offset:],
                    left,
                    span,
                    builder.enums,
                    builder.unions,
                    builder.intrinsics,
                )? or not float_operand(
                    builder.nominals,
                    builder.locals[builder.local_offset:],
                    right,
                    span,
                    builder.enums,
                    builder.unions,
                    builder.intrinsics,
                )?:
                    return Err("unsupported Body IR non-float true division operands")
            left_operand = scalar_operator_operand(builder, left, span)?
            right_operand = scalar_operator_operand(builder, right, span)?
            left_type = operand_type(builder, left_operand)?
            right_type = operand_type(builder, right_operand)?
            if is_bit_operator(operator):
                return bit_operation(operator, left_operand, left_type, right_operand, right_type)
            if left_type != right_type:
                return Err("unsupported Body IR mixed numeric arithmetic without retained coercion")
            if operator == BinOp.Is or operator == BinOp.IsNot:
                if left_type != PlanType.Bool:
                    return Err("unsupported Body IR scalar identity outside booleans")
                mut comparison = BinaryOp.Equal
                if operator == BinOp.IsNot:
                    comparison = BinaryOp.NotEqual
                return Ok(RvalueKind.Binary(comparison, left_operand, right_operand))
            if left_type == PlanType.Decimal:
                return Ok(RvalueKind.Use(decimal_comparison(builder, operator, left_operand, right_operand, span)?))
            # A closed type-parameter instance can reach here with text or a nominal where the checker chose a plain
            # operator for the open parameter; those need a runtime operation the checker never selected.
            if is_text_or_nominal(left_type):
                return Err("unsupported Body IR binary operator on text or nominal operands")
            return Ok(RvalueKind.Binary(binary_operator(operator)?, left_operand, right_operand))
        RustRvalue.IsInstance(value=value, value_ty=ty, target=target) =>
            return lower_union_isinstance(builder, value, ty, target.ty, span)
        RustRvalue.Aggregate(kind, elements) =>
            return checked_aggregate(module, builder, kind, elements, expected, span)
        RustRvalue.Dict(_entries) => return Err("unsupported Body IR Dict")
        RustRvalue.ValueEnumVariant(target) =>
            owner, variant = value_variant(builder.enums, builder.value_enums, target)?
            return Ok(RvalueKind.Enum(owner, variant, []))
        RustRvalue.FieldlessEnumVariant(target) =>
            owner, variant = unit_variant(builder.enums, target)?
            return Ok(RvalueKind.Enum(owner, variant, []))
        RustRvalue.ResultVariant(_value) => return Err("unsupported Body IR ResultVariant")
        RustRvalue.Format(_parts) => return Err("unsupported Body IR Format")
        RustRvalue.Closure(params=_params, captured_operands=_captures, body=_body) =>
            return Err("unsupported Body IR Closure")
        RustRvalue.Generator(source=_source, captured_operands=_captures, body=_body) =>
            return Err("unsupported Body IR Generator")
        RustRvalue.Match(scrutinee=_value, arms=_arms) => return Err("unsupported Body IR Match")


def comparison_collection_place(
    mut builder: Builder,
    value: &RustOperand,
    span: SourceSpan,
) -> Result[Option[Place], str]:
    """Select a whole collection comparison operand only when Body IR retained its shared read."""
    match value:
        RustOperand.Place(read) =>
            if len(read.place.projection) != 0:
                return Ok(None)
            match read.place.local_id():
                None => return Ok(None)
                Some(_local) => pass
            place = scalar_place(builder, read.place, span)?
            match equality_shape(place_type(builder.locals, place)):
                None => return Ok(None)
                Some(_shape) => pass
            if read.fact != OwnershipFact.Borrow:
                return Err("unsupported Body IR collection equality without retained shared read")
            return Ok(Some(place))
        _ => return Ok(None)


def collection_equality(
    mut builder: Builder,
    operator: &BinOp,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[Option[Operand], str]:
    """Borrow both checked collection layouts and invoke legacy equality without value-materialization clones."""
    mut places: list[Place] = []
    for operand in [left, right]:
        match comparison_collection_place(builder, operand, span)?:
            Some(place) => places.append(place)
            None => return Ok(None)
    left_shape = equality_shape(place_type(builder.locals, places[0]))
    if left_shape != equality_shape(place_type(builder.locals, places[1])):
        return Err("unsupported Body IR collection equality across different layouts")
    match left_shape:
        Some(ty) =>
            references = [list_borrow(builder, places[0], false, span)?, list_borrow(builder, places[1], false, span)?]
            return Ok(Some(emit_collection_equality(builder, ty, references, operator == BinOp.Ne, span)?))
        None => return Ok(None)


def text_comparison_operand(builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[bool, str]:
    """Recognize a concrete text carrier without cloning a value to inspect its type."""
    match value:
        RustOperand.Constant(RustConstant.Str(_text)) => return Ok(true)
        RustOperand.Constant(RustConstant.FrozenStr(_text)) => return Ok(true)
        RustOperand.Place(read) =>
            # Collection indexing owns its separate value-materialization path; a probe must not evaluate it twice.
            for projection in read.place.projection:
                match projection:
                    PlaceElem.Index(_index) => return Ok(false)
                    PlaceElem.Slice(start=_start, end=_end, step=_step) => return Ok(false)
                    _ => pass
            mut ty = PlanType.Unit
            match read.place.global():
                Some(global) =>
                    ty = native_source_type(
                        builder.nominals,
                        builder.enums,
                        builder.unions,
                        global.ty,
                        builder.intrinsics,
                    )?
                None =>
                    place = scalar_place(builder, read.place, span)?
                    ty = place_type(builder.locals, place)
            return Ok(ty == PlanType.String or ty == PlanType.FrozenStr)
        _ => return Ok(false)


def text_comparison(
    mut builder: Builder,
    operator: &BinOp,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[Option[Operand], str]:
    """Bind a checked comparison in a closed text instance to the same borrowed runtime operation as concrete text."""
    mut name = ""
    match operator:
        BinOp.Eq =>
            name = "equal_text"
        BinOp.Ne =>
            name = "unequal_text"
        BinOp.Lt =>
            name = "less_text"
        BinOp.Le =>
            name = "less_equal_text"
        BinOp.Gt =>
            name = "greater_text"
        BinOp.Ge =>
            name = "greater_equal_text"
        _ => return Ok(None)
    if not text_comparison_operand(builder, left, span)? or not text_comparison_operand(builder, right, span)?:
        return Ok(None)
    incoming = builder.owned
    operands = [borrow_text_operand(builder, left, span)?, borrow_text_operand(builder, right, span)?]
    output = emit_text_helper(builder, name, PlanType.Bool, [PlanType.StringRef, PlanType.StringRef], operands, span)
    drop_borrowed_text_temporaries(builder, incoming, output.local, span)
    return Ok(Some(read_place(output, false, span)))
# =====================================================================================================================
# The frame builder and ownership
# =====================================================================================================================


def is_nominal_type(ty: PlanType) -> bool:
    """Identify nominal, generator, zip, and tuple values whose owned payloads require transfer or destruction."""
    match ty:
        PlanType.ValidationError => return true
        PlanType.Enum(_index, _name) => return true
        PlanType.Model(_index, _name) => return true
        PlanType.ZipIterator(_left, _right) => return true
        PlanType.Generator(_leaf, _depth) => return true
        PlanType.Tuple(_elements) => return tuple_has_owners(ty)
        _ => return false


def is_text_or_nominal(ty: PlanType) -> bool:
    """Text and source nominals compare only through runtime operations, never through a native binary operator."""
    match ty:
        PlanType.String => return true
        PlanType.StringRef => return true
        PlanType.StrRef => return true
        PlanType.Model(_index, _name) => return true
        PlanType.Enum(_index, _name) => return true
        _ => return false


def verify_branch_owners(reachable: bool, owned: list[int], incoming: list[int]) -> Result[None, str]:
    """
    Refuse a branch that leaves different owners live than it started with.

    Merging such branches would need conditional drop flags; refusing keeps every drop on an initialized value.
    """
    if reachable and owned != incoming:
        return Err("unsupported Body IR owned-value branch merge")
    return Ok(None)


def drop_loop_owners(mut builder: Builder, span: SourceSpan) -> Result[None, str]:
    """Release loop-local owners while retaining initialized enclosing storage, including a loop expression's result."""
    incoming = builder.loop_owners[-1]
    for owner in incoming:
        if owner not in builder.owned:
            return Err("unsupported Body IR loop changes incoming formatting ownership")
    retained = builder.owned
    for index in range(len(retained)):
        owner = retained[len(retained) - index - 1]
        if owner not in incoming and loop_local_owner(builder, owner):
            drop_owned(builder, owner, span)
    return Ok(None)


def loop_local_owner(builder: Builder, local: int) -> bool:
    """Use Body IR's lexical scope tree to distinguish loop-local storage from values declared outside the loop."""
    for slot in range(len(builder.scoped_locals)):
        index = builder.scoped_locals[slot][0]
        scope = builder.scoped_locals[slot][1]
        if index != local:
            continue
        mut current = scope
        for _ in range(len(builder.scope_parents) + 1):
            if current == builder.loop_scopes[-1]:
                return true
            mut parent = -1
            for ancestor in range(len(builder.scope_parents)):
                enclosing_scope = builder.scope_parents[ancestor][0]
                enclosing = builder.scope_parents[ancestor][1]
                if enclosing_scope == current:
                    parent = enclosing
            if parent < 0:
                return false
            current = parent
        return true
    # Native temporaries have no source scope and belong to the current evaluation.
    return true
# =====================================================================================================================
# Statements and control flow
# =====================================================================================================================


def lower_block(module: &BodyIrModule, mut builder: Builder, block: &RustBlock) -> Result[None, str]:
    """Lower a retained lexical block and stop after a terminating source statement."""
    for statement in block.stmts:
        lower_statement(module, builder, statement)?
        if builder.closed[builder.current]:
            return Ok(None)
    return Ok(None)


pub def lower_statement(module: &BodyIrModule, mut builder: Builder, statement: &RustStatement) -> Result[None, str]:
    """Preserve statement order and refuse constructs outside the supported slice."""
    mut span = location(statement.span, builder.source, builder.file)
    match builder.anchor:
        Some(site) =>
            span = site
        None => pass
    match statement.kind:
        RustStatementKind.Assign(place=destination, rvalue=value) =>
            # A later clause's iterator is never materialized: the clause's own chain draws from the source.
            if later_clause_index(builder, whole_local(destination)) >= 0:
                return Ok(None)
            return lower_assignment(module, builder, destination, value, span)
        RustStatementKind.If(cond=condition, then_block=then_body, else_block=else_body) =>
            return lower_if(module, builder, condition, then_body, else_body, span)
        RustStatementKind.Loop(body=body) =>
            clause = later_clause_index(builder, clause_iterator(body))
            if clause >= 0:
                return lower_later_clause(module, builder, clause, body, span)
            return lower_loop(module, builder, body, span)
        RustStatementKind.Return(value=value) => return lower_return(builder, value, span)
        RustStatementKind.Break(value=value) =>
            match value:
                Some(_operand) => return Err("unsupported Body IR value-producing Break")
                None => return lower_loop_exit(builder, false, span)
        RustStatementKind.Continue => return lower_loop_exit(builder, true, span)
        RustStatementKind.Drop(local=local) =>
            index = int(local.index()) + 1 + builder.local_offset
            drop_owned(builder, index, span)
            # Parameters stay in caller-provided storage for the whole invocation, even after their value drops.
            if index > builder.parameter_count:
                builder.emit(Statement(kind=StatementKind.StorageDead(index), span=span))
        RustStatementKind.Expr(value=value) =>
            # An expression statement only needs its operand to be valid; its value is discarded.
            return lower_discarded_operand(builder, value, span)
        RustStatementKind.Call(destination=_destination, callee=_callee, args=_args, may_panic=_may_panic) =>
            return lower_call(module, builder, statement, span)
        RustStatementKind.Await(destination=destination, awaited=awaited) =>
            future = source_future_place(builder, awaited, span)?
            match destination:
                Some(place) =>
                    output = scalar_place(builder, place, span)?
                    return await_future(module, builder, future, output, span)
                None => return Err("unsupported Body IR Await without destination")
        RustStatementKind.Race(destination=destination, arms=arms) =>
            return lower_ready_race(module, builder, destination, arms, span)
        RustStatementKind.Yield(value=value) => return lower_yield(builder, value, span)
        RustStatementKind.Assert(kind=kind, message=message, may_panic=_panic) =>
            return lower_assertion(builder, kind, message, span)
        RustStatementKind.TryPropagate(destination=destination, operand=operand, error_routing=routing) =>
            return lower_try_propagation(builder, destination, operand, routing, span)
        RustStatementKind.IterNext(destination=destination, iterator=iterator, protocol=protocol) =>
            return list_next(builder, destination, iterator, protocol, span)
        RustStatementKind.Unsupported(description=description) =>
            return Err(f"unsupported Body IR Unsupported: {description}")
    return Ok(None)


def source_future_place(builder: Builder, awaited: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Consume a frontend-owned source future; copying or borrowing one cannot realize its one-shot await."""
    match awaited:
        RustOperand.Place(read) =>
            if read.fact != OwnershipFact.Move:
                return Err("unsupported Body IR async future ownership")
            return scalar_place(builder, read.place, span)
        _ => return Err("unsupported Body IR Await constant")


def lower_ready_race(
    module: &BodyIrModule,
    mut builder: Builder,
    destination: &Option[RustPlace],
    arms: list[RustRaceArm],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Preserve source-order ready ties, winner callbacks, and cancellation after the callback returns.

    Every arm is lowered, including statically losing arms, so unsupported futures or callback statements still refuse.
    The frontend already constructed every awaitable in source order before this statement.
    """
    target = ready_race_destination(builder, destination, span)?
    ty = place_type(builder.locals, target)
    if not numeric_carrier(ty) and ty != PlanType.Bool and ty != PlanType.Unit:
        return Err("unsupported Body IR Race owned result")
    if len(arms) == 0:
        return Err("unsupported Body IR Race without arms")
    mut futures: list[Place] = []
    for arm in arms:
        futures.append(source_future_place(builder, arm.awaitable, span)?)
    incoming = builder.owned
    future_locals = [future.local for future in futures]
    retained = [owner for owner in incoming if owner not in future_locals]
    after = builder.new_block(span)
    for index in range(len(arms)):
        selected = builder.new_block(span)
        next_arm = builder.new_block(span)
        builder.finish(TerminatorKind.SwitchBool(literal(Constant.Bool(index == 0), span), next_arm, selected), span)
        builder.current = selected
        builder.owned = incoming
        arm = arms[index]
        binding = plan_place(int(arm.binding.index()) + 1 + builder.local_offset, span)
        await_future(module, builder, futures[index], binding, span)?
        lower_ready_race_callback(module, builder, arm.body)?
        lower_local_assignment(module, builder, target, RustRvalue.Use(arm.result), span)?
        # Legacy drops losing futures after the winning callback has produced the shared result.
        for future in futures:
            drop_owned(builder, future.local, span)
        verify_branch_owners(true, builder.owned, retained)?
        builder.finish(TerminatorKind.Goto(after), span)
        builder.current = next_arm
    builder.finish(TerminatorKind.Unreachable, span)
    builder.current = after
    builder.owned = retained
    return Ok(None)


def ready_race_destination(builder: Builder, destination: &Option[RustPlace], span: SourceSpan) -> Result[Place, str]:
    """Require the frontend's shared race result slot before building any winner branch."""
    match destination:
        Some(place) => return scalar_place(builder, place, span)
        None => return Err("unsupported Body IR Race without destination")


def lower_ready_race_callback(module: &BodyIrModule, mut builder: Builder, body: &RustBlock) -> Result[None, str]:
    """Keep callback control transfers out of the enclosing body until the plan retains a callback boundary."""
    for statement in body.stmts:
        match statement.kind:
            RustStatementKind.If(cond=_condition, then_block=_then, else_block=_else) =>
                return Err("unsupported Body IR Race callback control flow")
            RustStatementKind.Loop(body=_body) => return Err("unsupported Body IR Race callback control flow")
            RustStatementKind.Return(value=_value) => return Err("unsupported Body IR Race callback Return")
            RustStatementKind.Break(value=_value) => return Err("unsupported Body IR Race callback Break")
            RustStatementKind.Continue => return Err("unsupported Body IR Race callback Continue")
            RustStatementKind.Race(destination=_destination, arms=_arms) =>
                return Err("unsupported Body IR nested Race callback")
            RustStatementKind.TryPropagate(destination=_destination, operand=_operand, error_routing=_routing) =>
                return Err("unsupported Body IR Race callback TryPropagate")
            RustStatementKind.Await(destination=_destination, awaited=_awaited) =>
                return Err("unsupported Body IR Race callback Await")
            RustStatementKind.Assign(place=_place, rvalue=rvalue) =>
                validate_ready_race_assignment(rvalue)?
                lower_statement(module, builder, statement)?
            _ => lower_statement(module, builder, statement)?
    return Ok(None)


def validate_ready_race_assignment(value: &RustRvalue) -> Result[None, str]:
    """Require an assignment without nested arm blocks that could transfer control out of the callback."""
    match value:
        RustRvalue.Match(scrutinee=_value, arms=_arms) => return Err("unsupported Body IR Race callback Match")
        _ => return Ok(None)


def lower_return(mut builder: Builder, value: &Option[RustOperand], span: SourceSpan) -> Result[None, str]:
    """Store the result in the return slot, drop every live owner, and return."""
    mut result = literal(Constant.Unit, span)
    match value:
        Some(operand) =>
            result = return_operand(builder, operand, span)?
        None => pass
    return finish_return(builder, result, span)


def return_operand(mut builder: Builder, operand: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Materialize a returned value for the return slot's type, taking ownership of an owned result."""
    return_type = builder.locals[0].ty
    if return_type == PlanType.String:
        text = display_operand(builder, operand, span)?
        forget_owned(builder, text.local)
        return Ok(read_place(text, true, span))
    result = boundary_operand(builder, operand, return_type, span)?
    track_rvalue_moves(builder, RvalueKind.Use(result))
    return Ok(result)


def finish_return(mut builder: Builder, value: Operand, span: SourceSpan) -> Result[None, str]:
    """Store a materialized result in the return slot, drop every live owner, and return."""
    return_type = builder.locals[0].ty
    result = coerce_numeric_operand(builder, value, return_type, span)?
    if callable_copy_type(return_type):
        assign_callable(builder, plan_place(0, span), result, true, span)?
    else:
        builder.emit(plan_assign(plan_place(0, span), RvalueKind.Use(result), span))
    validate_exact_float(builder, plan_place(0, span), span)
    drop_all_owned(builder, span)
    builder.finish(TerminatorKind.Return, span)
    return Ok(None)


def lower_loop_exit(mut builder: Builder, repeat: bool, span: SourceSpan) -> Result[None, str]:
    """Leave the innermost loop (`break`) or start its next iteration (`continue`), dropping its owners first."""
    if len(builder.loops) == 0:
        return Err("Body IR Break or Continue outside Loop")
    drop_loop_owners(builder, span)?
    header, after = builder.loops[-1]
    if repeat:
        builder.finish(TerminatorKind.Goto(header), span)
    else:
        end = builder.current
        owners = builder.owned
        builder.loop_exit_blocks[-1].append(end)
        builder.loop_exit_owners[-1].append(owners)
        builder.finish(TerminatorKind.Goto(after), span)
    return Ok(None)


def lower_yield(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[None, str]:
    """Apply the checked generator's element boundary conversion before transferring an owned yield."""
    # A generator-expression step hands its one accepted element back to the chain instead of suspending.
    match builder.step_element:
        Some(element) =>
            # A later `for` clause would yield many elements per item; one step returns exactly one.
            if len(builder.loops) != 0:
                return Err("unsupported Body IR generator expression with a later for clause")
            operand = value_operand(builder, value, span)?
            accepted = coerce_numeric_operand(builder, operand, element, span)?
            result = step_result(builder, Some(accepted), span)?
            return finish_return(builder, result, span)
        None => pass
    if builder.generator_handle < 0:
        return Err("unsupported Body IR Yield outside generator producer")
    match builder.locals[builder.generator_handle].ty:
        PlanType.GeneratorYield(leaf, depth) =>
            operand = value_operand(builder, value, span)?
            converted = coerce_numeric_operand(builder, operand, generator_element(leaf, depth), span)?
            return generator_yield(builder, converted, span)
        _ => return Err("invalid native generator yield handle")


pub def lower_assignment(
    module: &BodyIrModule,
    mut builder: Builder,
    destination: &RustPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Assign a checked value to a local, routing strings, formatting and runtime-semantics operators first."""
    match destination.global():
        Some(global) => return write_static(module, builder, destination, global, value, span)
        None => pass
    if len(destination.projection) != 0:
        if is_element_place(builder, destination)?:
            return element_assignment(module, builder, destination, value, span)
        base = list_base_place(builder, destination, span)?
        ty = builder.locals[base.local].ty
        if is_collection(ty):
            return dictionary_index_assignment(builder, destination, value, span)
        if is_list(ty):
            return indexed_assignment(builder, destination, value, span)
        # A list held by a model field or tuple element is written at its list indexes after that structural prefix.
        match structural_prefix(builder, destination)?:
            Some((count, _through_tuple)) =>
                if count > 0 and count < len(destination.projection):
                    receiver = prefix_place(builder, destination, count, span)?
                    if is_collection(place_type(builder.locals, receiver)):
                        return dictionary_entry_assignment(builder, destination, receiver, count, value, span)
                    return indexed_assignment_at(builder, destination, count, value, span)
            None => pass
    target = scalar_place(builder, destination, span)?
    match value:
        RustRvalue.Match(scrutinee=scrutinee, arms=arms) =>
            return lower_enum_match(module, builder, target, scrutinee, arms, span)
        _ => pass
    lower_local_assignment(module, builder, target, value, span)?
    inherit_borrowed_item(builder, target, value)
    return Ok(None)


def element_assignment(
    module: &BodyIrModule,
    mut builder: Builder,
    destination: &RustPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Evaluate a replacement before reborrowing checked element storage, then write its last index or structural field."""
    ty = element_place_type(builder, destination)?
    replacement = temporary(builder, ty, span)
    lower_local_assignment(module, builder, replacement, value, span)?
    argument = element_plan_operand(builder, read_place(replacement, replacement.local in builder.owned, span), ty, span)?
    last = len(destination.projection) - 1
    container_type = element_prefix_type(builder, destination, last)?
    match destination.projection[last]:
        PlaceElem.Index(value) =>
            if is_list(container_type):
                subscript = scalar_operand(builder, value, span)?
                container = mutable_element_prefix(builder, destination, last, span)?
                leaf, depth = require_list_shape(container_type, "invalid Body IR list write container")?
                reference = list_borrow(builder, container, true, span)?
                output = temporary(builder, PlanType.Unit, span)
                list_call(
                    builder,
                    "set_list",
                    list_element(leaf, depth),
                    [PlanType.ListMutRef(leaf, depth), PlanType.Int, ty],
                    PlanType.Unit,
                    [reference, subscript, argument],
                    output,
                    span,
                )
                return Ok(None)
            if is_collection(container_type):
                types = collection_arguments(container_type)
                if len(types) != 2:
                    return Err("unsupported Body IR set indexing assignment")
                subscript = element_operand(builder, value, types[0], span)?
                container = mutable_element_prefix(builder, destination, last, span)?
                return insert_collection(builder, container, [subscript, argument], span)
        _ => pass
    target = mutable_element_place(builder, destination, span)?
    operation = RvalueKind.Use(argument)
    if ty == PlanType.String or is_owned_list(ty) or is_owned_collection(ty) or is_nominal_type(ty):
        replace_owned_destination(builder, target, operation, span)
    else:
        builder.emit(plan_assign(target, operation, span))
    return Ok(None)


def lower_local_assignment(
    module: &BodyIrModule,
    mut builder: Builder,
    target: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Assign a resolved local slot while preserving checked values and ownership replacement."""
    # Replacing the caller's text through a `mut str` parameter would need its old value dropped in place.
    if builder.locals[target.local].ty == PlanType.StringMutRef:
        return Err("unsupported Body IR assignment through a mutable text parameter")
    if target.local in builder.borrowed_items:
        return Err("unsupported Body IR mutation of borrowed list iteration item")
    if in_place_iteration_binding(builder, target, value, span)?:
        return Ok(None)
    match source_function_item(module, builder, value)?:
        Some(item) =>
            name, ty = item
            if target.projection != Projection.Whole:
                return Err("unsupported Body IR projected function-item construction")
            builder.locals[target.local].ty = ty
            builder.emit(
                plan_assign(target, RvalueKind.FunctionItem(Callee(kind=CalleeKind.Planned(name), span=span)), span),
            )
            return Ok(None)
        None => pass
    match value:
        RustRvalue.Closure(params=parameters, captured_operands=captures, body=closure) =>
            if not closure.function_item:
                return lower_closure(
                    module,
                    builder,
                    target,
                    parameters,
                    captures,
                    closure.capture_locals,
                    closure.stmts,
                    closure.result,
                    span,
                )
        RustRvalue.Generator(source=source, captured_operands=captures, body=generator) =>
            return lower_generator_expression(module, builder, target, source, captures, generator, span)
        RustRvalue.Use(operand) =>
            if callable_copy_type(place_type(builder.locals, target)):
                callable = stored_callable(builder, operand, span)?
                match operand_type(builder, callable)?:
                    PlanType.Closure(signature) => return move_closure(builder, target, callable, signature, span)
                    _ =>
                        return assign_callable(
                            builder,
                            target,
                            callable,
                            target.local in builder.function_pointer_locals,
                            span,
                        )
        _ => pass
    match builder.locals[target.local].ty:
        PlanType.ZipIteratorMutRef(_left, _right) =>
            match value:
                RustRvalue.Use(RustOperand.Place(read)) =>
                    if read.fact != OwnershipFact.Borrow:
                        return Err("unsupported Body IR zip iteration source ownership")
                    source = list_root_place(builder, read.place, span)?
                    return initialize_zip_iterator(builder, target, source, span)
                _ => return Err("unsupported Body IR zip iterator initialization")
        PlanType.GeneratorMutRef(_leaf, _depth) =>
            match value:
                RustRvalue.Use(value) =>
                    source = operand_list_place(builder, value, span)?
                    reference = generator_reference(builder, source, span)?
                    builder.emit(plan_assign(target, RvalueKind.Use(reference), span))
                    return Ok(None)
                _ => return Err("unsupported Body IR generator iterator initialization")
        PlanType.SetRef(_leaf) => return iterator_assignment(builder, target, value, span)
        PlanType.DictRef(_key, _value) => return iterator_assignment(builder, target, value, span)
        PlanType.ListRef(_leaf, _depth) => return iterator_assignment(builder, target, value, span)
        _ => pass
    if is_collection(place_type(builder.locals, target)):
        return collection_assignment(builder, target, value, span)
    if is_list(place_type(builder.locals, target)):
        return list_assignment(builder, target, value, span)
    if place_type(builder.locals, target) == PlanType.String:
        if target.local in builder.iteration_locals:
            return initialize_text_iterator(builder, target, value, span)
        return lower_string_assignment(builder, target, value, span)
    if place_type(builder.locals, target) == PlanType.FrozenStr:
        match value:
            RustRvalue.Use(operand) =>
                converted = frozen_operand(builder, operand, span)?
                builder.emit(plan_assign(target, RvalueKind.Use(converted), span))
                return Ok(None)
            _ => return Err("unsupported Body IR nonliteral FrozenStr assignment")
    if place_type(builder.locals, target) == PlanType.FrozenBytes:
        match value:
            RustRvalue.Use(RustOperand.Constant(constant)) =>
                converted = frozen_bytes_literal(builder, constant, span)?
                builder.emit(plan_assign(target, RvalueKind.Use(converted), span))
                return Ok(None)
            RustRvalue.Use(operand) =>
                converted = scalar_operand(builder, operand, span)?
                if operand_type(builder, converted)? != PlanType.FrozenBytes:
                    return Err("unsupported Body IR dynamic FrozenBytes assignment")
                builder.emit(plan_assign(target, RvalueKind.Use(converted), span))
                return Ok(None)
            _ => return Err("unsupported Body IR nonliteral FrozenBytes assignment")
    match value:
        RustRvalue.ResultVariant(variant) => return lower_result_construction(builder, target, variant, span)
        RustRvalue.Aggregate(RustAggregateKind.OptionSome, elements) =>
            return lower_option_construction(builder, target, elements, span)
        RustRvalue.Use(RustOperand.Constant(RustConstant.None)) =>
            return lower_none_assignment(builder, target, value, span)
        RustRvalue.Format(parts) => return lower_format(builder, target, parts, span)
        RustRvalue.BinaryOp(operator, left, right) =>
            match operator:
                BinOp.Pow => return lower_power_operator(builder, target, left, right, span)
                BinOp.And => return lower_boolean_operator(builder, target, left, right, "boolean_and", span)
                BinOp.Or => return lower_boolean_operator(builder, target, left, right, "boolean_or", span)
                BinOp.FloorDiv => return lower_numeric_helper(builder, target, left, right, "py_floor_div", span)
                BinOp.Mod => return lower_numeric_helper(builder, target, left, right, "py_mod", span)
                _ => pass
            if compare_models(builder, target, operator, left, right, span)?:
                return Ok(None)
        _ => pass
    mut operation = scalar_rvalue(module, builder, value, place_type(builder.locals, target), span)?
    ty = place_type(builder.locals, target)
    match operation:
        RvalueKind.Use(operand) =>
            if numeric_carrier(ty):
                source_type = operand_type(builder, operand)?
                if source_type != ty:
                    if not numeric_carrier(source_type):
                        return Err("unsupported Body IR nonnumeric implicit conversion")
                    operation = RvalueKind.NumericCast(operand, source_type, ty)
            else:
                payload = option_payload_operand(builder, operand, place_type(builder.locals, target), span)?
                operation = carrier_injection(
                    builder.nominals,
                    builder.enums,
                    builder.unions,
                    payload,
                    operand_type(builder, payload)?,
                    place_type(builder.locals, target),
                    builder.intrinsics,
                )?
        RvalueKind.Unary(operator, operand) =>
            if operator == UnaryOp.Negate and sized_signed_integer(ty):
                external_call(
                    builder,
                    f"incan_native_runtime::negate_{numeric_name(ty)}",
                    [ty],
                    ty,
                    [operand],
                    target,
                    span,
                )
                return Ok(None)
        _ => pass
    track_rvalue_moves(builder, operation)
    # Legacy release builds use native wrapping arithmetic for sized integers.
    # Only the existing default-int boundary requests an explicit overflow pair.
    if ty == PlanType.Int:
        operation = negation_as_subtraction(operation, span)
        if is_checked_int_operation(operation):
            return lower_checked_int_assignment(builder, target, operation, span)
    if is_nominal_type(place_type(builder.locals, target)):
        replace_owned_destination(builder, target, operation, span)
        return Ok(None)
    builder.emit(plan_assign(target, operation, span))
    validate_exact_float(builder, target, span)
    return Ok(None)


def in_place_iteration_binding(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[bool, str]:
    """Consume a checked exclusive pattern binding as a view of its polled element, preserving ordinary owned aliases."""
    if destination.local in builder.iteration_locals:
        return Ok(false)
    match value:
        RustRvalue.Use(RustOperand.Place(read)) =>
            if read.fact != OwnershipFact.MutBorrow:
                return Ok(false)
            mut source = plan_place(-1, span)
            if is_element_place(builder, read.place)?:
                source = mutable_element_place(builder, read.place, span)?
            else:
                source = scalar_place(builder, read.place, span)?
            if is_list(place_type(builder.locals, source)):
                reference = list_borrow(builder, source, true, span)?
                builder.locals[destination.local].ty = operand_type(builder, reference)?
                builder.emit(plan_assign(destination, RvalueKind.Use(reference), span))
            else:
                # An indexed element accessor returns a reference; pattern binding reborrows its retained value.
                match place_type(builder.locals, source):
                    PlanType.ModelMutRef(owner, name) =>
                        source = Place(
                            local=source.local,
                            projection=Projection.Deref(PlanType.Model(owner, name)),
                            span=span,
                        )
                    PlanType.TupleMutRef(elements) =>
                        source = Place(
                            local=source.local,
                            projection=Projection.Deref(PlanType.Tuple(elements)),
                            span=span,
                        )
                    _ => pass
                bind_payload_in_place(builder, destination.local, source, span)?
            if destination.local not in builder.in_place_items:
                builder.in_place_items.append(destination.local)
            return Ok(true)
        _ => return Ok(false)


def assign_callable(
    mut builder: Builder,
    target: Place,
    value: Operand,
    pointer_storage: bool,
    span: SourceSpan,
) -> Result[None, str]:
    """Store a Copy callable with its retained item type or the source-required function-pointer coercion."""
    if target.projection != Projection.Whole:
        return Err("unsupported Body IR projected callable assignment")
    source = operand_type(builder, value)?
    ty, operation = function_assignment(place_type(builder.locals, target), source, value, pointer_storage)?
    builder.locals[target.local].ty = ty
    record_partial(builder, target.local, [])
    builder.emit(plan_assign(target, operation, span))
    return Ok(None)


def move_closure(
    mut builder: Builder,
    target: Place,
    value: Operand,
    signature: list[PlanType],
    span: SourceSpan,
) -> Result[None, str]:
    """Transfer an owned closure into a callable binding, which takes the closure's own boxed type."""
    if target.projection != Projection.Whole:
        return Err("unsupported Body IR projected closure assignment")
    if target.local in builder.function_pointer_locals:
        return Err("unsupported Body IR capturing closure stored as a function pointer")
    mut declared = callable_signature(place_type(builder.locals, target))?
    # A closure whose parameters carry defaults keeps its supplied flags in whichever binding holds it.
    mut flags: list[bool] = []
    match value.kind:
        OperandKind.Move(source) =>
            match partial_flags(builder, source.local):
                Some(held) =>
                    declared = with_supplied_flags(declared, held.clone())?
                    flags = held
                None => pass
        _ => pass
    if declared != signature:
        return Err("invalid Body IR closure assignment signature")
    track_rvalue_moves(builder, RvalueKind.Use(value))
    drop_owned(builder, target.local, span)
    hold_closure(builder, target.local, signature, flags)?
    builder.emit(plan_assign(target, RvalueKind.Use(value), span))
    builder.owned.append(target.local)
    return Ok(None)


def stored_callable(mut builder: Builder, operand: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Read the callable an assignment stores; a partial moves out whole, because its binding carries its flags."""
    match operand:
        RustOperand.Place(read) =>
            match read.place.global():
                Some(_global) => return value_operand(builder, operand, span)
                None => pass
            if is_element_place(builder, read.place)?:
                return value_operand(builder, operand, span)
            source = scalar_place(builder, read.place, span)?
            match partial_flags(builder, source.local):
                Some(_flags) =>
                    if read.fact != OwnershipFact.Move or source.projection != Projection.Whole:
                        return Err("unsupported Body IR partial shared between bindings")
                    return Ok(read_place(source, true, span))
                None => pass
        _ => pass
    return value_operand(builder, operand, span)


def hold_closure(mut builder: Builder, local: int, signature: list[PlanType], flags: list[bool]) -> Result[None, str]:
    """
    Type a binding as the owned closure it now holds and record the closure's supplied flags, if it has any.

    One binding keeps one closure type, so it cannot hold a partial and a closure that takes its inputs differently.
    """
    match builder.locals[local].ty:
        PlanType.Closure(held) =>
            if held != signature:
                return Err("unsupported Body IR binding holding closures with different default parameters")
        _ => pass
    builder.locals[local].ty = PlanType.Closure(signature)
    record_partial(builder, local, flags)
    return Ok(None)


def synthesize(mut builder: Builder, function: Function) -> None:
    """Retain one synthesized function per name; a forwarding environment for one item is shared."""
    for retained in builder.synthesized:
        if retained.name == function.name:
            return
    builder.synthesized.append(function)


def lower_closure(
    module: &BodyIrModule,
    mut builder: Builder,
    target: Place,
    parameters: &list[RustCallableParam],
    captures: &list[RustOperand],
    capture_locals: &list[RustLocalId],
    statements: &list[RustStatement],
    result: &RustOperand,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Lift a closure expression's body into a planned function, then bind the value the source requires.

    A closure without captures is that function's item, so it reuses item storage, pointer reification, and calls. A
    capturing closure boxes one environment holding its captures by value, which is the checker's snapshot contract.
    """
    if target.projection != Projection.Whole:
        return Err("unsupported Body IR projected closure construction")
    if builder.local_offset != 0:
        return Err("unsupported Body IR closure inside a deferred default")
    if len(captures) != len(capture_locals):
        return Err("invalid Body IR closure capture layout")
    flags = default_flags(parameters)
    mut signature = callable_signature(place_type(builder.locals, target))?
    if true in flags:
        if len(captures) == 0:
            return Err("unsupported Body IR partial without presets")
        signature = with_supplied_flags(signature, flags.clone())?
    mut operands: list[Operand] = []
    mut capture_types: list[PlanType] = []
    for capture in captures:
        operand = value_operand(builder, capture, span)?
        ty = operand_type(builder, operand)?
        match ty:
            PlanType.ZipIterator(_left, _right) =>
                return Err("unsupported Body IR iterator closure capture without FnOnce contract")
            _ => pass
        if not closure_capture_type(ty):
            return Err("unsupported Body IR closure capture outside scalars, owned text and models")
        operands.append(operand)
        capture_types.append(ty)
    name = f"__incan_closure_{builder.name}_{len(builder.synthesized)}"
    lifted = lift_closure(
        module,
        builder,
        name,
        capture_types,
        parameters,
        capture_locals,
        statements,
        result,
        signature,
        span,
    )?
    synthesize(builder, lifted)
    item = RvalueKind.FunctionItem(Callee(kind=CalleeKind.Planned(name), span=span))
    if len(capture_types) == 0:
        if target.local in builder.function_pointer_locals:
            held = temporary(builder, PlanType.FunctionItem(name, signature), span)
            builder.emit(plan_assign(held, item, span))
            return assign_callable(builder, target, read_place(held, false, span), true, span)
        builder.locals[target.local].ty = PlanType.FunctionItem(name, signature)
        record_partial(builder, target.local, [])
        builder.emit(plan_assign(target, item, span))
        return Ok(None)
    if target.local in builder.function_pointer_locals:
        return Err("unsupported Body IR capturing closure stored as a function pointer")
    _ = closure_arguments(signature)?
    constructor = closure_constructor(f"{name}_new", name, capture_types, signature, span)
    synthesize(builder, constructor)
    drop_owned(builder, target.local, span)
    hold_closure(builder, target.local, signature, flags)?
    terminate_call(builder, CalleeKind.Planned(f"{name}_new"), operands, target, span)
    builder.owned.append(target.local)
    return Ok(None)


def lift_closure(
    module: &BodyIrModule,
    mut builder: Builder,
    name: str,
    captures: list[PlanType],
    parameters: &list[RustCallableParam],
    capture_locals: &list[RustLocalId],
    statements: &list[RustStatement],
    result: &RustOperand,
    signature: list[PlanType],
    span: SourceSpan,
) -> Result[Function, str]:
    """
    Build a closure body as a planned function taking its captures, then its inputs, by value.

    The enclosing frame's locals keep their Body IR slots after those arguments, so the closure's statements lower with
    the ordinary local offset; a prologue moves each argument into the capture or parameter local the body reads. A
    parameter that carries a default takes a supplied flag before its value (see `partial_callables`).
    """
    mut supplied_flags = 0
    for flag in default_flags(parameters):
        if flag:
            supplied_flags += 1
    if len(parameters) + supplied_flags + 1 != len(signature):
        return Err("invalid Body IR closure parameter count")
    mut arguments: list[PlanType] = []
    for ty in captures:
        arguments.append(ty)
    for index in range(len(signature) - 1):
        arguments.append(signature[index])
    count = len(arguments)
    mut lifted_parameters: list[Parameter] = []
    for index in range(count):
        lifted_parameters.append(Parameter(name=f"__incan_argument_{index}", ty=arguments[index], span=span))
    mut lifted = lifted_frame(builder, name, arguments, signature[-1], span)
    for index in range(len(captures)):
        destination = int(capture_locals[index].index()) + 1 + count
        captured = lifted.locals[destination].ty
        bind_closure_input(lifted, destination, index + 1, arguments[index], captured, span)?
    mut position = len(captures)
    for parameter in parameters:
        destination = int(parameter.local.index()) + 1 + count
        match parameter.default:
            CallableParamDefault.Required =>
                declared = lifted.locals[destination].ty
                # A closure checked against a callable type whose input is `mut` takes that input as the borrow too.
                mutable = parameter.mutable or parameter_storage_type(declared, true) == arguments[position]
                storage = parameter_storage_type(declared, mutable)
                bind_closure_input(lifted, destination, position + 1, arguments[position], storage, span)?
                position += 1
            _ =>
                # The supplied flag comes first, then the value it describes.
                value_type = arguments[position + 1]
                bind_defaulted_parameter(module, lifted, parameter, destination, position + 1, value_type, span)?
                position += 2
    for statement in statements:
        lower_statement(module, lifted, statement)?
    if not lifted.closed[lifted.current]:
        value = return_operand(lifted, result, span)?
        finish_return(lifted, value, span)?
    # A generator expression's step lifted inside the closure, with its environment constructor, belongs to the
    # enclosing plan too; any other function synthesized there keeps the nested-closure refusal.
    for function in lifted.synthesized:
        if not function.name.startswith("__incan_generator_step_"):
            return Err("unsupported Body IR closure nested in a closure")
        synthesize(builder, function)
    adopt_lifted(builder, lifted)
    return Ok(
        Function(
            name=name,
            parameters=lifted_parameters,
            return_type=signature[-1],
            locals=lifted.locals,
            blocks=lifted.blocks,
            span=span,
        ),
    )


def lifted_frame(builder: Builder, name: str, arguments: list[PlanType], result: PlanType, span: SourceSpan) -> Builder:
    """
    Start a lifted function's frame: its result slot, its arguments, then the enclosing frame's locals.

    The enclosing locals keep their Body IR slots behind the arguments, so the lifted statements lower with the ordinary
    local offset. An enclosing frame that is itself lifted, such as a generator-expression step whose later clause lifts
    another, contributes its Body IR slots without its own arguments.
    """
    count = len(arguments)
    mut locals = [Local(ty=result, span=span)]
    for argument in arguments:
        locals.append(Local(ty=argument, span=span))
    for index in range(1 + builder.local_offset, len(builder.locals)):
        locals.append(builder.locals[index])
    # Only the enclosing frame's own Body IR slots move into the lifted frame; a deferred default's caller locals sit
    # below its offset and stay behind.
    mut pointer_locals: list[int] = []
    for local in builder.function_pointer_locals:
        if local > builder.local_offset:
            pointer_locals.append(local - builder.local_offset + count)
    mut scoped_locals: list[tuple[int, int]] = []
    for slot in range(len(builder.scoped_locals)):
        local = builder.scoped_locals[slot][0]
        scope = builder.scoped_locals[slot][1]
        if local > builder.local_offset:
            scoped_locals.append((local - builder.local_offset + count, scope))
    mut lifted = Builder(
        locals=locals,
        parameter_count=count,
        blocks=[],
        current=0,
        source=builder.source,
        file=builder.file,
        module_identity=builder.module_identity,
        loops=[],
        loop_owners=[],
        externals=[],
        owned=[],
        closed=[],
        nominals=builder.nominals,
        iterators=[],
        borrowed_items=[],
        in_place_items=[],
        partial_callables=[],
        enums=builder.enums,
        intrinsics=builder.intrinsics,
        statics=builder.statics,
        value_enums=builder.value_enums,
        local_offset=count,
        generator_handle=-1,
        unions=builder.unions,
        type_parameters=builder.type_parameters,
        type_arguments=builder.type_arguments,
        instances=[],
        function_pointer_locals=pointer_locals,
        name=name,
        synthesized=[],
        scoped_locals=scoped_locals,
        scope_parents=builder.scope_parents,
        display_functions=builder.display_functions,
    )
    _ = lifted.new_block(span)
    return lifted


def adopt_lifted(mut builder: Builder, lifted: Builder) -> None:
    """Carry a lifted function's runtime signatures and checked instantiations into the enclosing plan."""
    for external in lifted.externals:
        builder.externals.append(external)
    builder.instances.extend(lifted.instances)


def lower_generator_expression(
    module: &BodyIrModule,
    mut builder: Builder,
    target: Place,
    source: &RustOperand,
    captures: &list[RustOperand],
    body: &RustGeneratorBody,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Build a generator expression as legacy's lazy adapter chain over its eagerly evaluated first source.

    The first source becomes an owned generator now. A lifted step receives each of its items only when a consumer polls
    and returns that item's accepted element, or nothing, so no clause, filter or element runs before it is drawn.
    """
    if target.projection != Projection.Whole:
        return Err("unsupported Body IR projected generator expression")
    if len(captures) != len(body.capture_locals):
        return Err("invalid Body IR generator expression capture layout")
    item_local = first_clause_item(body)?
    evaluated = value_operand(builder, source, span)?
    first = source_generator(builder, evaluated, span)?
    # The step's environment holds each capture by value, read once now, as legacy's `move` closure takes it.
    mut operands: list[Operand] = []
    mut capture_types: list[PlanType] = []
    for capture in captures:
        operand = value_operand(builder, capture, span)?
        ty = operand_type(builder, operand)?
        if not step_capture_type(ty):
            return Err("unsupported Body IR generator expression capture outside scalars, owned text and lists")
        operands.append(operand)
        capture_types.append(ty)
    mut bindings: list[int] = []
    for local in body.capture_locals:
        bindings.append(int(local.index()))
    item = source_item(builder, first)?
    name = f"__incan_generator_step_{builder.name}_{len(builder.synthesized)}"
    match body.stmts[1].kind:
        RustStatementKind.Loop(body=block) =>
            step = lift_generator_step(
                module,
                builder,
                name,
                item,
                capture_types,
                bindings,
                place_type(builder.locals, target),
                item_local,
                block,
                span,
            )?
            synthesize(builder, step)
        _ => return Err("unsupported Body IR generator expression body shape")
    drop_owned(builder, target.local, span)
    callable = step_callable(builder, name, item, place_type(builder.locals, target), capture_types, operands, span)
    construct_chain(builder, first, callable, target, span)?
    builder.owned.append(target.local)
    return Ok(None)


def step_callable(
    mut builder: Builder,
    name: str,
    item: PlanType,
    result: PlanType,
    captures: list[PlanType],
    operands: list[Operand],
    span: SourceSpan,
) -> Operand:
    """Pass a capture-free step as its function pointer, and a capturing one as a boxed environment over its captures."""
    signature = [item, result]
    if len(captures) == 0:
        return step_pointer(builder, name, signature, span)
    synthesize(builder, closure_constructor(f"{name}_new", name, captures, signature, span))
    environment = temporary(builder, PlanType.Closure(signature), span)
    terminate_call(builder, CalleeKind.Planned(f"{name}_new"), operands, environment, span)
    builder.owned.append(environment.local)
    return read_place(environment, true, span)


def lift_generator_step(
    module: &BodyIrModule,
    mut builder: Builder,
    name: str,
    item: PlanType,
    captures: list[PlanType],
    capture_locals: list[int],
    result: PlanType,
    item_local: int,
    block: &RustBlock,
    span: SourceSpan,
) -> Result[Function, str]:
    """
    Build one generator-expression step: from a first-source item to the generator of that item's accepted elements.

    The step takes the expression's captures, then the item, as a capturing closure's lifted function does. It binds
    each to the local the deferred body reads, then lowers every statement after the item's poll; a yield returns its
    element, a later `for` clause returns the nested chain it builds, and falling through returns an empty generator.
    """
    match generator_shape(result):
        Some((leaf, depth)) =>
            mut arguments: list[PlanType] = []
            mut bindings: list[int] = []
            for index in range(len(captures)):
                arguments.append(captures[index])
                bindings.append(capture_locals[index])
            arguments.append(item)
            bindings.append(item_local)
            mut lifted = lifted_frame(builder, name, arguments, result, span)
            lifted.step_element = Some(generator_element(leaf, depth))
            lifted.step_bindings = bindings
            lifted.step_clauses = later_clauses(block)
            bind_step_arguments(lifted, arguments, bindings, span)?
            mut parameters: list[Parameter] = []
            for index in range(len(arguments)):
                parameters.append(Parameter(name=f"__incan_argument_{index}", ty=arguments[index], span=span))
            for index in range(1, len(block.stmts)):
                lower_statement(module, lifted, block.stmts[index])?
                if lifted.closed[lifted.current]:
                    break
            if not lifted.closed[lifted.current]:
                filtered = step_result(lifted, None, span)?
                finish_return(lifted, filtered, span)?
            # A later clause's step and environment constructor belong to the enclosing plan too.
            for function in lifted.synthesized:
                synthesize(builder, function)
            adopt_lifted(builder, lifted)
            return Ok(
                Function(
                    name=name,
                    parameters=parameters,
                    return_type=result,
                    locals=lifted.locals,
                    blocks=lifted.blocks,
                    span=span,
                ),
            )
        None => return Err("unsupported Body IR generator expression type")


def later_clause_index(builder: Builder, iterator: int) -> int:
    """Find the step's later clause that polls this iterator local, or -1 outside a step or for any other local."""
    if iterator < 0:
        return -1
    for index in range(len(builder.step_clauses)):
        if builder.step_clauses[index][0] == iterator:
            return index
    return -1


def lower_later_clause(
    module: &BodyIrModule,
    mut builder: Builder,
    clause: int,
    body: &RustBlock,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Return a later `for` clause's own chain as the step's result, as legacy's nested `flat_map` does.

    The clause's source is drawn lazily from a snapshot of a list, or from a generator the step built. Its step is
    lifted like the first one; its environment holds the outer step's bound locals, cloned for each item it expands.
    """
    iterator, source, assigned = builder.step_clauses[clause]
    item_local = clause_item(body)
    if item_local < 0:
        return Err("unsupported Body IR generator expression later for clause poll")
    first = clause_source(builder, source + 1 + builder.local_offset, span)?
    item = source_item(builder, first)?
    mut environment: list[int] = []
    mut types: list[PlanType] = []
    mut operands: list[Operand] = []
    for local in builder.step_bindings + assigned:
        if local != iterator and local != source and local not in environment:
            operand = environment_operand(builder, local + 1 + builder.local_offset, span)?
            environment.append(local)
            types.append(operand_type(builder, operand)?)
            operands.append(operand)
    result = builder.locals[0].ty
    name = f"__incan_generator_step_{builder.name}_{len(builder.synthesized)}"
    step = lift_generator_step(module, builder, name, item, types, environment, result, item_local, body, span)?
    synthesize(builder, step)
    callable = step_callable(builder, name, item, result, types, operands, span)
    # The chain moves straight into the return slot, so it never joins the step's owners.
    output = temporary(builder, result, span)
    construct_chain(builder, first, callable, output, span)?
    return finish_return(builder, read_place(output, true, span), span)


def clause_source(mut builder: Builder, slot: int, span: SourceSpan) -> Result[Operand, str]:
    """Snapshot a list source, as legacy's clause clones it per item, or move a generator the step built."""
    place = plan_place(slot, span)
    ty = builder.locals[slot].ty
    match generator_shape(ty):
        Some((leaf, depth)) =>
            if ty != PlanType.Generator(leaf, depth):
                return Err("unsupported Body IR generator expression later for clause over a borrowed generator")
            return Ok(read_place(place, true, span))
        None => pass
    if not is_owned_list(ty):
        return Err("unsupported Body IR generator expression later for clause source outside lists and generators")
    snapshot = environment_operand(builder, slot, span)?
    return source_generator(builder, snapshot, span)


def environment_operand(mut builder: Builder, slot: int, span: SourceSpan) -> Result[Operand, str]:
    """Copy a scalar, or clone owned text or an owned list, so the outer step keeps its own value."""
    place = plan_place(slot, span)
    ty = builder.locals[slot].ty
    if not step_capture_type(ty):
        return Err("unsupported Body IR generator expression clause environment outside scalars, owned text and lists")
    if ty == PlanType.String:
        text = clone_text(builder, place, span)?
        builder.owned.append(text.local)
        return Ok(read_place(text, true, span))
    match list_shape(ty):
        Some((leaf, depth)) =>
            reference = list_borrow(builder, place, false, span)?
            copy = temporary(builder, ty, span)
            list_call(
                builder,
                "clone_list",
                list_element(leaf, depth),
                [PlanType.ListRef(leaf, depth)],
                ty,
                [reference],
                copy,
                span,
            )
            builder.owned.append(copy.local)
            return Ok(read_place(copy, true, span))
        None => return Ok(read_place(place, false, span))


def bind_step_arguments(
    mut lifted: Builder,
    arguments: list[PlanType],
    bindings: list[int],
    span: SourceSpan,
) -> Result[None, str]:
    """Move each step argument into the Body IR local the deferred body reads; an owned one is the step's to drop."""
    count = len(arguments)
    for index in range(count):
        destination = bindings[index] + 1 + count
        if lifted.locals[destination].ty != arguments[index]:
            return Err("unsupported Body IR generator expression item binding")
        # A tuple item holding text, such as an `enumerate` pair over strings, is owned like text.
        owned = arguments[index] == PlanType.String or is_owned_list(arguments[index]) or tuple_has_owners(
            arguments[index],
        )
        lifted.emit(
            plan_assign(
                plan_place(destination, span),
                RvalueKind.Use(read_place(plan_place(index + 1, span), owned, span)),
                span,
            ),
        )
        if owned:
            lifted.owned.append(destination)
    return Ok(None)


def bind_closure_input(
    mut lifted: Builder,
    destination: int,
    argument: int,
    ty: PlanType,
    storage: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Move one closure argument into the capture or parameter local the body reads, which stores it as `storage`: a
    capture by value, a parameter as a function frame stores it (a list as a view, a `mut` value as its borrow).
    """
    if storage != ty:
        return Err("invalid Body IR closure argument type")
    lifted.locals[destination].ty = storage
    # Text and an owned collection, model, enum or carrier input move into the local the body reads, which then owns them; an
    # exclusive borrow moves in too, and every other input is a copy or a shared view.
    owned = ty == PlanType.String or is_nominal_type(ty) or is_owned_collection(ty)
    value = read_place(plan_place(argument, span), owned or is_exclusive_borrow(ty), span)
    lifted.emit(plan_assign(plan_place(destination, span), RvalueKind.Use(value), span))
    if owned:
        lifted.owned.append(destination)
    return Ok(None)


def negation_as_subtraction(operation: RvalueKind, span: SourceSpan) -> RvalueKind:
    """Rewrite integer `-x` as `0 - x`, so it gets the same overflow check as any other subtraction."""
    match operation:
        RvalueKind.Unary(operator, operand) =>
            if operator == UnaryOp.Negate:
                return RvalueKind.Binary(BinaryOp.Subtract, literal(Constant.Int(0), span), operand)
        _ => pass
    return operation


def is_checked_int_operation(operation: RvalueKind) -> bool:
    """Whether an integer operation can overflow: `+`, `-` and `*` panic on overflow, as the legacy route does."""
    match operation:
        RvalueKind.Binary(operator, _left, _right) =>
            return operator == BinaryOp.Add or operator == BinaryOp.Subtract or operator == BinaryOp.Multiply
        _ => return false


def lower_checked_int_assignment(
    mut builder: Builder,
    target: Place,
    operation: RvalueKind,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Lower an overflow-checked integer operation the way rustc's own MIR does.

    The operation writes a (value, overflowed) pair; an overflow assertion branches to a panic (unwinding through the
    current owners' cleanup) or continues, and only then is the value copied into the destination.
    """
    match operation:
        RvalueKind.Binary(operator, left, right) =>
            pair = len(builder.locals)
            ty = place_type(builder.locals, target)
            mut pair_type = PlanType.CheckedInt
            mut projection = Projection.Value
            match sized_numeric(ty):
                Some(kind) =>
                    pair_type = PlanType.CheckedNumeric(kind)
                    projection = Projection.NumericValue(sized_plan_type(kind))
                None => pass
            builder.locals.append(Local(ty=pair_type, span=span))
            builder.emit(plan_assign(plan_place(pair, span), operation, span))
            next_block = builder.new_block(span)
            flag = read_place(Place(local=pair, projection=Projection.Overflow, span=span), false, span)
            cleanup = cleanup_exit(builder, span)
            assertion = TerminatorKind.AssertOverflow(flag, operator, left, right, next_block, Unwind.Cleanup(cleanup))
            builder.finish(assertion, span)
            builder.current = next_block
            result = read_place(Place(local=pair, projection=projection, span=span), false, span)
            builder.emit(plan_assign(target, RvalueKind.Use(result), span))
            return Ok(None)
        _ => return Err("checked integer lowering expects a binary operation")


def lower_if(
    module: &BodyIrModule,
    mut builder: Builder,
    condition: &RustOperand,
    then_body: &RustBlock,
    else_body: &Option[RustBlock],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower both branches into their own blocks and join them in a common successor."""
    then_index = builder.new_block(span)
    else_index = builder.new_block(span)
    after = builder.new_block(span)
    # `SwitchBool` takes its false target first, then its true target.
    # Legacy E0499: materialize before borrowing the builder receiver again, until dev.8.
    condition_value = value_operand(builder, condition, span)?
    builder.finish(TerminatorKind.SwitchBool(condition_value, else_index, then_index), span)

    incoming = builder.owned
    mut branch_ends: list[int] = []
    mut branch_owners: list[list[int]] = []
    builder.current = then_index
    lower_block(module, builder, then_body)?
    if not builder.closed[builder.current]:
        branch_ends.append(builder.current)
        branch_owners.append(builder.owned)

    builder.owned = incoming
    builder.current = else_index
    match else_body:
        Some(body) => lower_block(module, builder, body)?
        None => pass
    if not builder.closed[builder.current]:
        branch_ends.append(builder.current)
        branch_owners.append(builder.owned)

    builder.owned = incoming
    if len(branch_ends) != 0:
        builder.owned = join_branch_owners(builder, after, branch_ends, branch_owners, span)?
    builder.current = after
    builder.closed[after] = len(branch_ends) == 0
    return Ok(None)


def lower_loop(module: &BodyIrModule, mut builder: Builder, body: &RustBlock, span: SourceSpan) -> Result[None, str]:
    """Lower a normalized loop: a header block that the body jumps back to, and an `after` block for `break`."""
    header = builder.new_block(span)
    after = builder.new_block(span)
    builder.finish(TerminatorKind.Goto(header), span)
    builder.current = header
    incoming = builder.owned
    builder.loops.append((header, after))
    builder.loop_owners.append(incoming)
    builder.loop_scopes.append(int(body.scope.0))
    builder.loop_exit_blocks.append([])
    builder.loop_exit_owners.append([])
    lower_block(module, builder, body)?
    if not builder.closed[builder.current]:
        drop_loop_owners(builder, span)?
    _loop = builder.loops.pop()
    _owners = builder.loop_owners.pop()
    _scope = builder.loop_scopes.pop()
    ends = builder.loop_exit_blocks.pop()
    owners = builder.loop_exit_owners.pop()
    finish_fallthrough(builder, header, span)
    builder.owned = incoming
    if len(ends) != 0:
        builder.owned = join_branch_owners(builder, after, ends, owners, span)?
    builder.current = after
    # A loop nothing leaves (`loop:` or `while true:` without `break`) never falls through to what follows it.
    builder.closed[after] = not exits_to(builder.blocks, header, after)
    return Ok(None)
# =====================================================================================================================
# Calls
# =====================================================================================================================


def lower_call(
    module: &BodyIrModule,
    mut builder: Builder,
    statement: &RustStatement,
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch by the retained callee kind, preserving the call's operand and result facts."""
    match statement.kind:
        RustStatementKind.Call(destination=destination, callee=callee, args=arguments, may_panic=_may_panic) =>
            match callee:
                RustCallee.Function(callable) =>
                    match callable:
                        CallableTarget.Named(target) =>
                            return lower_named_target(module, builder, target, arguments, destination, span)
                        CallableTarget.Local(target) =>
                            return lower_callable_value(builder, target, arguments, destination, span)
                        _ => return Err("unsupported Body IR local callable value")
                RustCallee.Method(target) =>
                    return lower_method_call(module, builder, target, arguments, destination, span)
                RustCallee.Helper(helper) => return lower_runtime_helper(builder, helper, arguments, destination, span)
                RustCallee.ProviderOperation(_operation) => return Err("unsupported Body IR ProviderOperation")
        _ => return Err("expected Body IR Call")


def lower_value_enum_method(
    mut builder: Builder,
    owner: int,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Select the retained raw value by native tag, preserving repeated reads and text ownership."""
    if len(arguments) != 1:
        return Err("unsupported Body IR value enum getter arguments")
    source = argument_place(builder, arguments, 0, span)?
    result_type = value_enum_raw_type(builder, owner)
    output = call_destination(builder, destination, result_type, span)?
    if place_type(builder.locals, output) != result_type or output.local in builder.owned:
        return Err("unsupported Body IR value enum getter destination")
    return select_value_enum_raw(builder, owner, source, output, span)


def value_enum_raw_type(builder: Builder, owner: int) -> PlanType:
    """The raw value a value enum's variants carry: text or an integer."""
    match builder.value_enums[owner].backing:
        ValueEnumBacking.Str => return PlanType.String
        ValueEnumBacking.Int => return PlanType.Int


def select_value_enum_raw(
    mut builder: Builder,
    owner: int,
    source: Place,
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Write the raw value of the variant `source` holds into `output`, selected by its native tag."""
    declaration = builder.value_enums[owner]
    result_type = value_enum_raw_type(builder, owner)
    join = builder.new_block(span)
    owners = builder.owned
    branches = tag_branches(builder, source, len(declaration.variants), span)
    for slot in range(len(branches)):
        builder.current = branches[slot]
        raw_value: RustConstant = declaration.variants[slot].raw_value.clone()
        operand: RustOperand = RustOperand.Constant(raw_value)
        if result_type == PlanType.String:
            raw: RustRvalue = RustRvalue.Use(operand)
            lower_string_assignment(builder, output, raw, span)?
        else:
            value = value_operand(builder, operand, span)?
            builder.emit(plan_assign(output, RvalueKind.Use(value), span))
        builder.finish(TerminatorKind.Goto(join), span)
        builder.owned = owners
    builder.current = join
    if result_type == PlanType.String:
        builder.owned.append(output.local)
    return Ok(None)


def tag_branches(mut builder: Builder, source: Place, count: int, span: SourceSpan) -> list[int]:
    """
    Branch on the native tag of the enum `source` holds, returning one block per variant in variant order.

    Each returned block runs only for its variant; the caller fills it and ends it with a jump to its own join.
    """
    raw_tag = temporary(builder, PlanType.EnumTag, span)
    tag = temporary(builder, PlanType.Int, span)
    builder.emit(plan_assign(raw_tag, RvalueKind.Discriminant(source), span))
    builder.emit(plan_assign(tag, RvalueKind.TagToInt(read_place(raw_tag, false, span)), span))
    mut branches: list[int] = []
    for slot in range(count):
        if slot + 1 == count:
            branches.append(builder.current)
            continue
        selected = builder.new_block(span)
        next = builder.new_block(span)
        condition = temporary(builder, PlanType.Bool, span)
        builder.emit(
            plan_assign(
                condition,
                RvalueKind.Binary(BinaryOp.Equal, read_place(tag, false, span), literal(Constant.Int(slot), span)),
                span,
            ),
        )
        builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), next, selected), span)
        branches.append(selected)
        builder.current = next
    return branches


def lower_value_enum_from_value(
    mut builder: Builder,
    owner: int,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Select the variant whose raw value equals the argument, as the generated `from_value()` does: `Some` of the first
    variant in declaration order that matches, or `None` when none does.
    """
    if len(arguments) != 1:
        return Err("unsupported Body IR value enum from_value arguments")
    layout = value_enum_layout(builder, owner)?
    raw_type = value_enum_raw_type(builder, owner)
    value = argument_value(builder, arguments, 0, span)?
    if operand_type(builder, value)? != raw_type:
        return Err("unsupported Body IR value enum from_value argument")
    raw = temporary(builder, raw_type, span)
    track_rvalue_moves(builder, RvalueKind.Use(value))
    builder.emit(plan_assign(raw, RvalueKind.Use(value), span))
    if raw_type == PlanType.String:
        builder.owned.append(raw.local)
    output = call_destination(builder, destination, PlanType.Unit, span)?
    carrier, declaration = carrier_layout(builder, place_type(builder.locals, output))?
    element = PlanType.Enum(layout, str(builder.enums[layout].name))
    if declaration.carrier != "Option" or declaration.variants[1].fields != [element] or output.local in builder.owned:
        return Err("unsupported Body IR value enum from_value destination")
    join = builder.new_block(span)
    owners = builder.owned
    for slot in range(len(builder.value_enums[owner].variants)):
        raw_value: RustConstant = builder.value_enums[owner].variants[slot].raw_value.clone()
        condition = raw_value_matches(builder, raw, raw_value, span)?
        matched = builder.new_block(span)
        next = builder.new_block(span)
        builder.finish(TerminatorKind.SwitchBool(condition, next, matched), span)
        builder.current = matched
        variant = temporary(builder, element, span)
        builder.emit(plan_assign(variant, RvalueKind.Enum(layout, slot, []), span))
        assign_carrier(builder, output, carrier, 1, [read_place(variant, true, span)], span)
        builder.finish(TerminatorKind.Goto(join), span)
        builder.owned = owners
        builder.current = next
    assign_carrier(builder, output, carrier, 0, [], span)
    builder.finish(TerminatorKind.Goto(join), span)
    builder.owned = owners
    builder.current = join
    builder.owned.append(output.local)
    drop_owned(builder, raw.local, span)
    return Ok(None)


def value_enum_layout(builder: Builder, owner: int) -> Result[int, str]:
    """Find the retained source enum layout of value enum `owner`."""
    for index in range(len(builder.enums)):
        if builder.enums[index].canonical == builder.value_enums[owner].canonical:
            validate_layout(builder.enums[index], builder.value_enums[owner])?
            return Ok(index)
    return Err("unsupported Body IR unretained value enum layout")


def raw_value_matches(mut builder: Builder, raw: Place, value: RustConstant, span: SourceSpan) -> Result[Operand, str]:
    """Compare a value enum's raw argument with one variant's raw value: integers natively, text through the runtime."""
    condition = temporary(builder, PlanType.Bool, span)
    if place_type(builder.locals, raw) == PlanType.Int:
        operand = value_operand(builder, RustOperand.Constant(value), span)?
        builder.emit(
            plan_assign(condition, RvalueKind.Binary(BinaryOp.Equal, read_place(raw, false, span), operand), span),
        )
        return Ok(read_place(condition, false, span))
    mut text = ""
    match value:
        RustConstant.Str(spelling) =>
            text = str(spelling)
        _ => return Err("unsupported Body IR value enum raw value")
    literal = owned_literal(builder, text, span)
    left = temporary(builder, PlanType.StringRef, span)
    builder.emit(plan_assign(left, RvalueKind.Borrow(raw), span))
    right = temporary(builder, PlanType.StringRef, span)
    builder.emit(plan_assign(right, RvalueKind.Borrow(literal), span))
    operands = [read_place(left, false, span), read_place(right, false, span)]
    result = emit_text_helper(
        builder,
        "equal_text",
        PlanType.Bool,
        [PlanType.StringRef, PlanType.StringRef],
        operands,
        span,
    )
    drop_owned(builder, literal.local, span)
    return Ok(read_place(result, false, span))


def lower_enum_message(
    mut builder: Builder,
    index: int,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Spell the name of the variant a source enum holds, as the generated `message()` does."""
    if len(arguments) != 1:
        return Err("unsupported Body IR enum message arguments")
    source = argument_place(builder, arguments, 0, span)?
    output = call_destination(builder, destination, PlanType.String, span)?
    if place_type(builder.locals, output) != PlanType.String or output.local in builder.owned:
        return Err("unsupported Body IR enum message destination")
    variants = builder.enums[index].variants
    join = builder.new_block(span)
    owners = builder.owned
    branches = tag_branches(builder, source, len(variants), span)
    for slot in range(len(branches)):
        builder.current = branches[slot]
        name = str(variants[slot].name)
        texts = [text_literal(name, span), text_literal("", span)]
        external_call(
            builder,
            "incan_std_core::strings::str_concat",
            [PlanType.StrRef, PlanType.StrRef],
            PlanType.String,
            texts,
            output,
            span,
        )
        builder.finish(TerminatorKind.Goto(join), span)
        builder.owned = owners
    builder.current = join
    builder.owned.append(output.local)
    return Ok(None)


def lower_method_call(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Borrow the proven receiver and call its canonical method body with bound ordinary arguments."""
    match target.intrinsic_carrier:
        Some(_carrier) => return lower_carrier_method(builder, target, arguments, destination, span)
        None => pass
    # Builtin registry members and source methods both retain identities; their origin selects the admission path.
    match target.canonical:
        Some(identity) =>
            if identity.origin == SymbolOrigin.Builtin:
                match result_combinator(str(identity.declaration_name)):
                    Some(combinator) =>
                        return lower_result_combinator(module, builder, combinator, arguments, destination, span)
                    None => pass
                return lower_builtin_method(builder, target, arguments, destination, span)
        None => return Err("unsupported Body IR Method without canonical identity")
    if len(arguments) == 0:
        return Err("invalid Body IR Method missing receiver")
    if lower_standard_slot(module, builder, target, arguments, destination, span)?:
        return Ok(None)
    # A list or dictionary element receiver is reborrowed in its container; no native place names it.
    match element_method_owner(builder, arguments[0])?:
        Some(owner) =>
            index = owner_method_index(module, target, owner, builder.intrinsics)?
            reference = element_method_receiver(module, builder, index, arguments[0], span)?
            return call_method_body(module, builder, target, index, reference, arguments, destination, span)
        None => pass
    match enum_message_layout(
        module,
        target,
        builder.locals[builder.local_offset:],
        arguments[0],
        span,
        builder.unions,
        builder.intrinsics,
    )?:
        Some(index) => return lower_enum_message(builder, index, arguments, destination, span)
        None => pass
    match value_method_owner(
        module,
        target,
        builder.locals[builder.local_offset:],
        arguments[0],
        span,
        builder.unions,
        builder.intrinsics,
    )?:
        Some(owner) => return lower_value_enum_method(builder, owner, arguments, destination, span)
        None => pass
    # A retained source implementation takes priority over the SDK trait's crate-call record. SDK-owned receivers
    # otherwise call the method in the crate that compiled it.
    for delegation in module.stdlib_delegations:
        if receiver_fills_slot(
            module,
            target,
            builder.locals[builder.local_offset:],
            arguments[0],
            span,
            builder.unions,
            builder.intrinsics,
        ):
            break
        match target.canonical:
            Some(identity) =>
                if identity == delegation.canonical:
                    return lower_library_method(module, builder, delegation, target, arguments, destination, span)
            None => pass
    index = method_index(
        module,
        target,
        builder.locals[builder.local_offset:],
        arguments[0],
        span,
        builder.unions,
        builder.intrinsics,
    )?
    receiver_type, borrow = method_receiver(
        module,
        builder.locals[builder.local_offset:],
        builder.local_offset,
        index,
        arguments[0],
        span,
        builder.unions,
        builder.intrinsics,
    )?
    reference = temporary(builder, receiver_type, span)
    builder.emit(plan_assign(reference, borrow, span))
    return call_method_body(module, builder, target, index, reference, arguments, destination, span)


def call_method_body(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &MethodTarget,
    index: int,
    reference: Place,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call the selected method body with its already borrowed receiver and the bound ordinary arguments."""
    mut body = module.bodies[index].clone()
    if len(body.type_parameters) != 0:
        closed = checked_type_arguments(builder, target.type_args)?
        builder.instances.append(Instance(body=body.clone(), arguments=closed))
        body = instantiate(body, closed)?
    else:
        if len(target.type_args) != 0:
            return Err("unsupported Body IR type arguments on a method without type parameters")
    mut types: list[PlanType] = []
    for position in range(1, len(body.params)):
        types.append(call_parameter_type(builder, body, body.params[position])?)
    mut ordinary: list[Operand] = []
    match method_default_arguments(module, builder, target, arguments, body, types, span)?:
        Some(values) =>
            ordinary = values
        None =>
            ordinary = ordered_slot_operands(builder, target.binding, arguments, types, span, 1)?
    mut operands = [read_place(reference, true, span)]
    for operand in ordinary:
        operands.append(operand)
    return emit_local_call(module, builder, body, operands, destination, span)


def lower_library_method(
    module: &BodyIrModule,
    mut builder: Builder,
    delegation: &RustStdlibDelegation,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Call a stdlib method in the SDK crate that compiled it.

    The record's first parameter is the receiver as that crate declares it, a shared or exclusive borrow of the
    retained stdlib layout. The receiver is borrowed in place and the other arguments bind as for a local method; the
    driver checks the whole signature against the crate's metadata before building the call.
    """
    if len(target.type_args) != 0:
        return Err("unsupported Body IR type arguments on a stdlib method")
    if len(delegation.parameters) == 0 or len(arguments) == 0:
        return Err("unsupported Body IR stdlib method without a receiver")
    receiver_type = delegation.parameters[0]
    mut names: list[str] = []
    for name in delegation.type_parameters:
        names.append(str(name))
    reference = library_receiver(module, builder, receiver_type, arguments[0], span)?
    closed = library_receiver_arguments(module, builder, reference, names)?
    mut parameters = [place_type(builder.locals, reference)]
    mut ordinary_types: list[PlanType] = []
    for index in range(1, len(delegation.parameters)):
        parameter: RustType = substitute(delegation.parameters[index], names, closed)?
        ordinary_types.append(
            native_source_type(builder.nominals, builder.enums, builder.unions, parameter, builder.intrinsics)?,
        )
    parameters.extend(ordinary_types)
    returned: RustType = substitute(delegation.return_type, names, closed)?
    result = native_source_type(builder.nominals, builder.enums, builder.unions, returned, builder.intrinsics)?
    ordinary = library_call_operands(builder, delegation, target.binding, arguments, ordinary_types, span, 1, false)?
    mut operands = [read_place(reference, true, span)]
    operands.extend(ordinary)
    mut output = temporary(builder, result, span)
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None => pass
    match delegation.rust_path():
        None => return Err("unsupported Body IR stdlib method native identity")
        Some(path) =>
            if len(closed) != 0:
                mut type_arguments: list[PlanType] = []
                for argument in closed:
                    type_arguments.append(
                        native_source_type(builder.nominals, builder.enums, builder.unions, argument, builder.intrinsics)?,
                    )
                return instantiated_external_call(
                    builder,
                    path,
                    type_arguments,
                    parameters,
                    result,
                    operands,
                    output,
                    span,
                )
            external_call(builder, path, parameters, result, operands, output, span)
            return Ok(None)


def library_receiver_arguments(
    module: &BodyIrModule,
    builder: Builder,
    receiver: Place,
    names: list[str],
) -> Result[list[RustType], str]:
    """Close SDK owner binders from the retained receiver; a trait's Self binder takes that entire concrete owner."""
    if len(names) == 0:
        return Ok([])
    mut owner = -1
    match place_type(builder.locals, receiver):
        PlanType.ModelRef(index, _name) =>
            owner = index
        PlanType.ModelMutRef(index, _name) =>
            owner = index
        _ => return Err("unsupported Body IR SDK method receiver type arguments")
    declaration = builder.nominals[owner]
    arguments = instance_arguments(module, declaration)?
    if names == ["Self"]:
        if len(arguments) == 0:
            return Ok([RustType.Named(str(declaration.canonical.declaration_name))])
        concrete: RustType = generic(str(declaration.canonical.declaration_name), arguments)
        return Ok([concrete])
    if len(arguments) == len(names):
        return Ok(arguments)
    return Err("unsupported Body IR SDK method owner type arguments")


def library_receiver(
    module: &BodyIrModule,
    mut builder: Builder,
    declared: &RustType,
    argument: &RustArgumentElement,
    span: SourceSpan,
) -> Result[Place, str]:
    """Borrow the receiver place as the stdlib method declares it, shared or exclusive, never moving its owner."""
    match argument.as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) =>
                    mut receiver = model_place(
                        module.nominal_declarations,
                        builder.locals[builder.local_offset:],
                        read.place,
                        span,
                        module.enum_declarations,
                        builder.unions,
                        builder.intrinsics,
                    )?
                    receiver.local += builder.local_offset
                    match place_type(builder.locals, receiver):
                        PlanType.Model(owner, name) =>
                            match declared:
                                RustType.Ref(_inner) =>
                                    reference = temporary(builder, PlanType.ModelRef(owner, name), span)
                                    builder.emit(plan_assign(reference, RvalueKind.Borrow(receiver), span))
                                    return Ok(reference)
                                RustType.RefMut(_inner) =>
                                    reference = temporary(builder, PlanType.ModelMutRef(owner, name), span)
                                    builder.emit(plan_assign(reference, RvalueKind.MutBorrow(receiver), span))
                                    return Ok(reference)
                                _ => return Err("unsupported Body IR by-value stdlib method receiver")
                        _ => return Err("unsupported Body IR stdlib method receiver outside a stdlib layout")
                _ => return Err("unsupported Body IR stdlib method nonplace receiver")
        None => return Err("unsupported Body IR stdlib method spread receiver")


def lower_standard_slot(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """
    Lower a standard-library slot through the behavior a derive or a held callable gives the receiver.

    A slot the receiver's own method fills is left to ordinary dispatch, because that method is what legacy calls. A
    receiver type that declares a method of the slot's name without such a record refuses, rather than taking the derived
    behavior in its place.
    """
    locals = builder.locals[builder.local_offset:]
    if receiver_fills_slot(module, target, locals, arguments[0], span, builder.unions, builder.intrinsics):
        return Ok(false)
    if is_json_serialize_method(target) or is_derived_clone(target) or is_derived_display(target):
        if receiver_declares_method(module, builder, arguments[0], slot_name(target), span)?:
            return Err("unsupported Body IR standard slot on a type with its own method of that name")
    if is_json_serialize_method(target):
        lower_model_json_builtin(builder, arguments, destination, span)?
        return Ok(true)
    if is_derived_clone(target):
        lower_derived_clone(builder, arguments, destination, span)?
        return Ok(true)
    match comparison_dunder(target):
        Some(operator) =>
            lower_comparison_dunder(module, builder, operator, arguments, destination, span)?
            return Ok(true)
        None => pass
    if is_derived_display(target):
        lower_display_str(builder, arguments, destination, span)?
        return Ok(true)
    return lower_callable_bound_call(builder, target, arguments, destination, span)


def lower_callable_bound_call(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """
    Call a function or closure received through a standard callable bound, as legacy calls its `Fn` value.

    The checker selects the callable trait's `__call__` for `func(value)` on a type parameter bounded by it; a closed
    instance holding a function item, pointer or closure calls that value with the remaining arguments. Any other
    receiver, a nominal callable object included, keeps its ordinary method dispatch.
    """
    if not is_std_callable_call(target) or len(arguments) == 0:
        return Ok(false)
    match arguments[0].as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) =>
                    held = scalar_place(builder, read.place, span)?
                    match callable_signature(place_type(builder.locals, held)):
                        Ok(_signature) => pass
                        Err(_error) => return Ok(false)
                    call_callable_place(builder, read, target.binding, arguments, 1, destination, span)?
                    return Ok(true)
                _ => return Ok(false)
        None => return Ok(false)


def lower_named_target(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &RustNamedCallableTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call a builtin, a retained project function, or a proven stdlib forwarder selected by canonical identity."""
    match target.builtin:
        Some(builtin) =>
            if len(target.type_args) != 0:
                return Err("unsupported Body IR builtin type arguments")
            return lower_builtin(builder, builtin, arguments, destination, span)
        None => pass
    if is_derived_default(target):
        return lower_derived_default(module, builder, target, destination, span)
    if is_json_deserialize_method(target):
        return lower_model_from_json(module, builder, target, arguments, destination, span)
    match value_enum_from_value_owner(module, target)?:
        Some(owner) => return lower_value_enum_from_value(builder, owner, arguments, destination, span)
        None => pass
    match target.canonical:
        None => return Err("unsupported Body IR builtin or unproven NamedCallableTarget")
        Some(_identity) =>
            # Without a retained project body, only a frontend-proven stdlib forwarder may reach a native Rust call.
            match program_body_index(module, target):
                None =>
                    # A generic stdlib crate call checks its type arguments against its record's type parameters.
                    return lower_stdlib_delegation(module, builder, target, arguments, destination, span)
                Some(index) =>
                    body = module.bodies[index]
                    if len(body.type_parameters) != 0:
                        return lower_type_parameter_call(module, builder, target, body, arguments, destination, span)
                    if len(target.type_args) != 0:
                        return Err("unsupported Body IR type arguments on a function without type parameters")
                    _ = validate_static_receiver(module, target)?
                    return lower_local_call(module, builder, target, body, arguments, destination, span)


def lower_type_parameter_call(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &RustNamedCallableTarget,
    body: &RustBody,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Schedule the checker-selected closed frame, refusing every unadmitted type argument before use."""
    _ = validate_static_receiver(module, target)?
    closed = checked_type_arguments(builder, static_type_arguments(module, target)?)?
    concrete_body = instantiate(body, closed)?
    builder.instances.append(Instance(body=body.clone(), arguments=closed))
    return lower_local_call(module, builder, target, concrete_body, arguments, destination, span)


def checked_type_arguments(builder: Builder, arguments: list[RustType]) -> Result[list[RustType], str]:
    """Close checker-recorded call arguments in the active declaration binding and require admitted carriers."""
    mut closed: list[RustType] = []
    for argument in arguments:
        concrete: RustType = substitute(argument, builder.type_parameters, builder.type_arguments)?
        _ = native_source_type(builder.nominals, builder.enums, builder.unions, concrete, builder.intrinsics)?
        closed.append(concrete.clone())
    return Ok(closed)


def program_body_index(module: &BodyIrModule, target: &RustNamedCallableTarget) -> Option[int]:
    """Find exactly one body by complete checker identity across the validated project graph."""
    mut found: Option[int] = None
    for index in range(len(module.bodies)):
        if module.bodies[index].canonical == target.canonical:
            match found:
                Some(_previous) => return None
                None =>
                    found = Some(index)
    return found


def lower_local_call(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &RustNamedCallableTarget,
    body: &RustBody,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call a canonical retained body; local span identities must agree when present."""
    match target.direct_call_id:
        None =>
            # Publication removes source-local call ids even within one package fragment. Its exact validated
            # canonical target selected this unique body; source modules still require their local span proof.
            match body.canonical:
                Some(identity) =>
                    match identity.origin:
                        SymbolOrigin.Module(_path) =>
                            if canonical_module_identity(identity) == Some(builder.module_identity):
                                return Err("unsupported Body IR local NamedCallableTarget without direct identity")
                        SymbolOrigin.Package(library=_library, module_path=_path) => pass
                        _ => return Err("unsupported Body IR unproven NamedCallableTarget")
                None => return Err("unsupported Body IR unproven NamedCallableTarget")
        Some(call_id) =>
            if call_id != body.direct_call_id:
                return Err("Body IR call identity disagrees with target body")
    operands = ordered_arguments(module, builder, target.binding, arguments, body, span)?
    if body.is_async:
        match destination:
            Some(place) =>
                output = scalar_place(builder, place, span)?
                return construct_future(module, builder, body, operands, output, span)
            None => return Err("unsupported Body IR async call without carrier")
    return emit_local_call(module, builder, body, operands, destination, span)


def emit_local_call(
    module: &BodyIrModule,
    mut builder: Builder,
    body: &RustBody,
    operands: list[Operand],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Emit a previously validated local call, sharing owned-result replacement between functions and methods."""
    mut output = plan_place(0, span)
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None =>
            output = temporary(
                builder,
                native_source_type(builder.nominals, builder.enums, builder.unions, body.return_type, builder.intrinsics)?,
                span,
            )
    declared = native_source_type(builder.nominals, builder.enums, builder.unions, body.return_type, builder.intrinsics)?
    result_type = return_representation(body, declared)?
    return lower_callable_result(
        builder,
        CalleeKind.Planned(function_name(module, body)),
        operands,
        output,
        result_type,
        span,
    )


pub def lower_callable_result(
    mut builder: Builder,
    callee: CalleeKind,
    operands: list[Operand],
    output: Place,
    result_type: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve owned return replacement and unwind cleanup identically for declared and locally held callees."""
    mut owned_closure = false
    match result_type:
        PlanType.Closure(_signature) =>
            # The destination's function type takes the returned closure's own boxed representation.
            if output.projection != Projection.Whole:
                return Err("unsupported Body IR projected closure result")
            builder.locals[output.local].ty = result_type
            owned_closure = true
        _ => pass
    if result_type == PlanType.String or is_nominal_type(result_type) or is_owned_collection(result_type) or owned_closure:
        result = temporary(builder, result_type, span)
        terminate_call(builder, callee, operands, result, span)
        builder.owned.append(result.local)
        drop_owned(builder, output.local, span)
        forget_owned(builder, result.local)
        builder.emit(plan_assign(output, RvalueKind.Use(read_place(result, true, span)), span))
        builder.owned.append(output.local)
    else:
        terminate_call(builder, callee, operands, output, span)
    return Ok(None)


def lower_callable_value(
    mut builder: Builder,
    target: &RustLocalCallableTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call an admitted function item or pointer; closure environments retain a distinct named refusal."""
    return call_callable_place(builder, target.operand, target.binding, arguments, 0, destination, span)


pub def call_callable_place(
    mut builder: Builder,
    held: &RustPlaceOperand,
    binding: &RustArgumentBinding,
    arguments: &list[RustArgumentElement],
    first: int,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Call the function item, pointer or closure a local holds, binding the arguments from position `first` on.

    A direct call passes every argument; a call through a callable bound's method passes the receiver first.
    """
    callable = scalar_place(builder, held.place, span)?
    signature = callable_signature(place_type(builder.locals, callable))?
    if len(signature) == 0:
        return Err("invalid Body IR callable signature without return type")
    mut operands: list[Operand] = []
    match partial_flags(builder, callable.local):
        Some(flags) =>
            # A partial's supplied flags follow its written arguments, so it binds from the first argument only.
            if first != 0:
                return Err("unsupported Body IR partial called through a callable bound")
            operands = partial_call_operands(builder, binding, arguments, signature.clone(), flags, span)?
        None =>
            mut parameters: list[PlanType] = []
            for index in range(len(signature) - 1):
                parameters.append(signature[index])
            operands = ordered_slot_operands(builder, binding, arguments, parameters, span, first)?
    result = signature[-1]
    mut output = plan_place(0, span)
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None =>
            output = temporary(builder, result, span)
    match place_type(builder.locals, callable):
        PlanType.Closure(_held) => return call_closure(builder, callable, signature, operands, output, span)
        PlanType.ClosureRef(_held) => return call_closure(builder, callable, signature, operands, output, span)
        _ => pass
    value = place_read(builder, held.place, held.fact, span)?
    return lower_callable_result(builder, CalleeKind.Value(value), operands, output, result, span)


pub def call_closure(
    mut builder: Builder,
    callable: Place,
    signature: list[PlanType],
    operands: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Pack the call's inputs into one tuple and invoke the borrowed callable object."""
    elements = closure_arguments(signature)?
    packed = temporary(builder, PlanType.CallableArguments(elements), span)
    track_rvalue_moves(builder, RvalueKind.Tuple(operands))
    builder.emit(plan_assign(packed, RvalueKind.Tuple(operands), span))
    receiver = callable_object(builder, callable, signature, span)?
    return lower_callable_result(
        builder,
        CalleeKind.CallClosure(signature),
        [receiver, read_place(packed, true, span)],
        output,
        signature[-1],
        span,
    )


def callable_object(
    mut builder: Builder,
    callable: Place,
    signature: list[PlanType],
    span: SourceSpan,
) -> Result[Operand, str]:
    """Borrow an owned closure, or copy a received view, as the shared callable object a call takes."""
    match place_type(builder.locals, callable):
        PlanType.ClosureRef(_held) => return Ok(read_place(callable, false, span))
        PlanType.Closure(_held) =>
            view = temporary(builder, PlanType.ClosureRef(signature), span)
            builder.emit(plan_assign(view, RvalueKind.ClosureObject(callable), span))
            return Ok(read_place(view, false, span))
        _ => return Err("unsupported Body IR callable without an object representation")


def callable_argument(
    mut builder: Builder,
    value: &RustOperand,
    signature: list[PlanType],
    span: SourceSpan,
) -> Result[Operand, str]:
    """Give a closure-holding parameter a shared callable object; a function item is boxed behind a forwarding environment."""
    match value:
        RustOperand.Place(read) =>
            place = scalar_place(builder, read.place, span)?
            match partial_flags(builder, place.local):
                Some(_flags) => return Err("unsupported Body IR partial passed to a closure-holding parameter")
                None => pass
            source = place_type(builder.locals, place)
            if callable_signature(source)? != signature:
                return Err("invalid Body IR callable argument signature")
            match source:
                PlanType.FunctionItem(name, _held) =>
                    constructor = f"__incan_item_closure_{name}"
                    # The environment belongs to the item, not to this call site: every function passing the item
                    # synthesizes the identical constructor, so the plan keeps one copy.
                    anchor = SourceSpan(file=builder.file, line=1, column=1)
                    synthesize(builder, closure_constructor(constructor, name, [], signature, anchor))
                    boxed = temporary(builder, PlanType.Closure(signature), span)
                    terminate_call(builder, CalleeKind.Planned(constructor), [], boxed, span)
                    builder.owned.append(boxed.local)
                    return callable_object(builder, boxed, signature, span)
                PlanType.FunctionPointer(_held) =>
                    _ = closure_arguments(signature)?
                    name = f"__incan_pointer_closure_{builder.name}_{len(builder.synthesized)}"
                    synthesize(builder, pointer_forwarder(name, signature, span))
                    constructor = f"{name}_new"
                    synthesize(builder, closure_constructor(constructor, name, [source], signature, span))
                    boxed = temporary(builder, PlanType.Closure(signature), span)
                    terminate_call(
                        builder,
                        CalleeKind.Planned(constructor),
                        [read_place(place, false, span)],
                        boxed,
                        span,
                    )
                    builder.owned.append(boxed.local)
                    return callable_object(builder, boxed, signature, span)
                _ => return callable_object(builder, place, signature, span)
        _ => return Err("unsupported Body IR constant passed to a closure-holding parameter")
# =====================================================================================================================
# Plain model construction and field replacement
# =====================================================================================================================


def lower_stdlib_delegation(
    module: &BodyIrModule,
    mut builder: Builder,
    target: &RustNamedCallableTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Call the native item an imported stdlib function runs as.

    A forwarder the frontend proved transparent, whose only statement returns one Rust call with every parameter passed
    through in order, calls that Rust function directly. Any other stdlib function calls the item its SDK crate
    compiled. Either is the call the legacy route makes, selected by the checker's canonical identity and native path,
    never by a spelling, and the driver checks its signature against the crate's metadata.
    """
    match target.direct_call_id:
        Some(_identity) => return Err("Body IR imported delegation has a local call identity")
        None => pass
    for delegation in module.stdlib_delegations:
        match target.canonical:
            None => return Err("unsupported Body IR unproven stdlib call target")
            Some(identity) =>
                if identity != delegation.canonical:
                    continue
        return lower_delegated_call(builder, delegation, target, arguments, destination, span)
    return Err("unsupported Body IR imported or unresolved canonical call target")


def lower_delegated_call(
    mut builder: Builder,
    delegation: &RustStdlibDelegation,
    target: &RustNamedCallableTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Emit the external call for one matched delegation: a proven forwarder's Rust callee or the SDK crate item itself.

    A generic crate item takes the call's checked type arguments for its declared type parameters, in order, and the
    driver instantiates the item with them before checking its signature.
    """
    mut names: list[str] = []
    for name in delegation.type_parameters:
        names.append(str(name))
    mut closed: list[RustType] = []
    if len(names) != 0:
        match target.receiver_type:
            Some(RustType.Generic(base=_base, args=arguments)) =>
                if len(target.type_args) != 0:
                    return Err("unsupported Body IR SDK owner and method type arguments")
                closed = arguments.clone()
            _ =>
                closed = checked_type_arguments(builder, target.type_args)?
    if len(closed) != len(names) or (len(names) == 0 and len(target.type_args) != 0):
        return Err("unsupported Body IR nonlocal function with type parameters")
    mut parameters: list[PlanType] = []
    for parameter in delegation.parameters:
        instantiated: RustType = substitute(parameter, names, closed)?
        parameters.append(
            native_source_type(builder.nominals, builder.enums, builder.unions, instantiated, builder.intrinsics)?,
        )
    returned: RustType = substitute(delegation.return_type, names, closed)?
    result = native_source_type(builder.nominals, builder.enums, builder.unions, returned, builder.intrinsics)?
    mut type_arguments: list[PlanType] = []
    for argument in closed:
        type_arguments.append(
            native_source_type(builder.nominals, builder.enums, builder.unions, argument, builder.intrinsics)?,
        )
    operands = library_call_operands(builder, delegation, target.binding, arguments, parameters, span, 0, true)?
    mut output = temporary(builder, result, span)
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None => pass
    match delegation.rust_path():
        None => return Err("unsupported Body IR stdlib delegation native identity")
        Some(path) =>
            if len(type_arguments) == 0:
                external_call(builder, path, parameters, result, operands, output, span)
                return Ok(None)
            return instantiated_external_call(builder, path, type_arguments, parameters, result, operands, output, span)


def library_call_operands(
    mut builder: Builder,
    delegation: &RustStdlibDelegation,
    binding: &RustArgumentBinding,
    arguments: &list[RustArgumentElement],
    types: list[PlanType],
    span: SourceSpan,
    offset: int,
    positional: bool,
) -> Result[list[Operand], str]:
    """
    Bind a stdlib crate call's arguments, each passed owned as the crate item takes it.

    A call that omits an argument passes the constant its record holds for that parameter, as legacy expands the
    stdlib default at the call site. An offset of one skips a method receiver, the record's first parameter.
    """
    if has_defaulted_slots(binding):
        return library_default_arguments(
            builder,
            delegation.parameter_defaults,
            binding,
            arguments[offset:],
            types,
            span,
            offset,
        )
    return ordered_slot_operands(builder, binding, arguments, types, span, offset, true, positional)


pub def instantiated_external_call(
    mut builder: Builder,
    path: str,
    type_arguments: list[PlanType],
    parameters: list[PlanType],
    result: PlanType,
    operands: list[Operand],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Declare one generic external instantiation and preserve owned-result replacement and cleanup."""
    builder.externals.append(
        ExternalFunction(path=path, type_arguments=type_arguments, parameters=parameters, return_type=result, span=span),
    )
    return lower_callable_result(builder, CalleeKind.Instantiated(path, type_arguments), operands, output, result, span)


def ordered_arguments(
    module: &BodyIrModule,
    mut builder: Builder,
    binding: &RustArgumentBinding,
    elements: &list[RustArgumentElement],
    body: &RustBody,
    span: SourceSpan,
) -> Result[list[Operand], str]:
    """Use the body's parameter types when materializing arguments in source order."""
    # Legacy evaluates permuted generator calls in declaration order, after Body IR has evaluated written order.
    if body.is_generator():
        match binding:
            RustArgumentBinding.Resolved(arguments=bindings, defaulted_slots=_defaults) =>
                for bound in bindings:
                    if int(bound.slot) != int(bound.written_position):
                        return Err("unsupported Body IR reordered generator ArgumentBinding")
            _ => pass
    mut types: list[PlanType] = []
    for parameter in body.params:
        types.append(call_parameter_type(builder, body, parameter)?)
    if has_defaulted_slots(binding):
        return default_arguments(module, builder, binding, elements, body, types, span, 0, false)
    return ordered_slot_operands(builder, binding, elements, types, span, 0)


def call_parameter_type(builder: Builder, body: &RustBody, parameter: &RustCallableParam) -> Result[PlanType, str]:
    """
    The representation a call passes for one declared parameter, shared by functions and methods.

    A list, set or dictionary parameter takes a shared or, when `mut`, an exclusive reference to the caller's storage;
    `mut` text, models and enums take an exclusive reference to the caller's value; a `mut` scalar is the callee's own
    copy. A `mut` tuple borrows its complete layout; an iterator without retained exclusive storage stays refused.
    """
    declared = native_source_type(builder.nominals, builder.enums, builder.unions, parameter.ty, builder.intrinsics)?
    ty = parameter_representation(body, int(parameter.local.index()), declared)?
    if parameter.mutable and lacks_exclusive_parameter(ty):
        return Err("unsupported Body IR mutable tuple or iterator parameter")
    return Ok(parameter_storage_type(ty, parameter.mutable))


def lacks_exclusive_parameter(ty: PlanType) -> bool:
    """Report whether a value that owns storage has no exclusive reference a `mut` parameter could receive."""
    if not is_nominal_type(ty) or is_generator_type(ty):
        return false
    match exclusive_reference(ty):
        Some(_reference) => return false
        None => return true


def has_defaulted_slots(binding: &RustArgumentBinding) -> bool:
    """Report whether a resolved call leaves at least one declared slot to its default."""
    match binding:
        RustArgumentBinding.Resolved(arguments=_arguments, defaulted_slots=defaults) => return len(defaults) != 0
        _ => return false


def ordered_slot_operands(
    mut builder: Builder,
    binding: &RustArgumentBinding,
    elements: &list[RustArgumentElement],
    types: list[PlanType],
    span: SourceSpan,
    offset: int = 0,
    owned: bool = false,
    positional: bool = false,
) -> Result[list[Operand], str]:
    """
    Place the written arguments into the callee's declared parameter slots.

    Body IR has already evaluated the arguments in written order; the binding says which slot each one fills.
    Defaults, missing slots, named or spread elements are refused. An offset of one skips a method receiver,
    whose borrow is lowered separately and whose slot is absent from the ordinary argument binding. With `owned`,
    a collection slot receives an owned value, as an SDK crate's compiled signature takes it.

    With `positional`, an unresolved binding whose elements are exactly one plain value per declared slot fills the
    slots in written order: without a name, a spread or an omitted slot, position is the only binding. An SDK crate
    call to an overloaded function arrives this way, since the checker records no slots for an overload set.
    """
    if offset < 0 or offset > len(elements):
        return Err("invalid Body IR argument offset")
    count = len(types)
    match binding:
        RustArgumentBinding.Resolved(arguments=bindings, defaulted_slots=defaults) =>
            if len(defaults) != 0 or len(bindings) != len(elements) - offset or len(bindings) != count:
                return Err("unsupported Body IR defaulted or incomplete ArgumentBinding")
            mut operands: list[Operand] = []
            for _index in range(count):
                operands.append(literal(Constant.Unit, span))
            mut occupied: list[int] = []
            for index in range(count):
                slot = int(bindings[index].slot)
                if slot < 0 or slot >= count or slot in occupied:
                    return Err("invalid Body IR argument slot map")
                occupied.append(slot)
                match elements[index + offset].as_one():
                    Some(value) =>
                        operands[slot] = call_argument_operand(builder, value, types[slot], span, owned)?
                    None => return Err("unsupported Body IR named or spread ArgumentElement")
            return Ok(operands)
        RustArgumentBinding.UnresolvedPositional =>
            if not positional or len(elements) - offset != count:
                return Err("unsupported Body IR unresolved ArgumentBinding")
            mut operands: list[Operand] = []
            for index in range(count):
                match elements[index + offset]:
                    RustArgumentElement.One(value) =>
                        operands.append(call_argument_operand(builder, value, types[index], span, owned)?)
                    _ => return Err("unsupported Body IR named or spread ArgumentElement")
            return Ok(operands)


pub def call_argument_operand(
    mut builder: Builder,
    value: &RustOperand,
    ty: PlanType,
    span: SourceSpan,
    owned: bool = false,
) -> Result[Operand, str]:
    """Share checked collection borrows, owned strings, callable objects, union injection, and numeric coercion across call slots."""
    match ty:
        PlanType.ClosureRef(signature) => return callable_argument(builder, value, signature, span)
        _ => pass
    if owned and owned_collection(ty):
        # An SDK crate takes its collection parameters by value; a borrowed argument is cloned, as legacy passes it.
        return value_operand(builder, value, span)
    if is_list(ty) or is_collection(ty):
        if is_mutable_list_reference(ty):
            match loop_variable_copy(builder, value, span)?:
                Some(copy) => return list_borrow(builder, copy, true, span)
                None => pass
        return checked_list_argument(builder, value, is_mutable_list_reference(ty), span)
    if is_generator_reference(ty):
        match value:
            RustOperand.Place(read) =>
                if read.fact != OwnershipFact.MutBorrow:
                    return Err("unsupported Body IR generator argument without mutable borrow fact")
                root = list_root_place(builder, read.place, span)?
                return generator_reference(builder, root, span)
            _ => return Err("unsupported Body IR constant generator argument")
    if ty == PlanType.String:
        text = display_operand(builder, value, span)?
        return Ok(read_place(text, true, span))
    match ty:
        PlanType.ModelRef(_owner, _name) => return shared_model_argument(builder, value, ty, span)
        PlanType.StringMutRef => return mutable_argument(builder, value, ty, span)
        PlanType.ModelMutRef(_owner, _name) => return mutable_argument(builder, value, ty, span)
        PlanType.EnumMutRef(_owner, _name) => return mutable_argument(builder, value, ty, span)
        PlanType.TupleMutRef(_elements) => return mutable_argument(builder, value, ty, span)
        _ => pass
    operand = boundary_operand(builder, value, ty, span)?
    coerced = coerce_numeric_operand(builder, operand, ty, span)?
    return function_argument(builder, ty, coerced, span)


def shared_model_argument(
    mut builder: Builder,
    value: &RustOperand,
    ty: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Pass a checked method-chain receiver by shared reference, retaining a reference already on its frame."""
    match value:
        RustOperand.Place(read) =>
            mut receiver = model_place(
                builder.nominals,
                builder.locals[builder.local_offset:],
                read.place,
                span,
                builder.enums,
                builder.unions,
                builder.intrinsics,
            )?
            receiver.local += builder.local_offset
            source = place_type(builder.locals, receiver)
            if source == ty:
                return Ok(read_place(receiver, false, span))
            match source:
                PlanType.Model(owner, name) =>
                    if ty != PlanType.ModelRef(owner, name):
                        return Err("unsupported Body IR shared receiver owner mismatch")
                    reference = temporary(builder, ty, span)
                    builder.emit(plan_assign(reference, RvalueKind.Borrow(receiver), span))
                    return Ok(read_place(reference, false, span))
                _ => return Err("unsupported Body IR shared receiver outside its nominal frame")
        _ => return Err("unsupported Body IR shared receiver without a place")


def owned_collection(ty: PlanType) -> bool:
    """Whether a parameter takes a list, set or dictionary by value rather than through a borrow."""
    match ty:
        PlanType.List(_leaf, _depth) => return true
        PlanType.Set(_leaf) => return true
        PlanType.Dict(_key, _value) => return true
        _ => return false


def loop_variable_copy(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Option[Place], str]:
    """
    Copy a list loop variable, or a list field of one, that a function's `mut` parameter receives.

    Legacy passes such a parameter `&mut item.clone()`, whether the loop copies its items or iterates them in place,
    so the callee's changes never reach the iterated list. A method receiver is not an argument and changes the item.
    """
    match value:
        RustOperand.Place(read) =>
            match read.place.global():
                Some(_global) => return Ok(None)
                None => pass
            root = list_root_place(builder, read.place, span)?
            if not is_list(place_type(builder.locals, root)):
                return Ok(None)
            if root.local in builder.borrowed_items or root.local in builder.in_place_items:
                return Ok(Some(cloned_list(builder, root, span)?))
            return Ok(None)
        _ => return Ok(None)


def tuple_pointer_element(element: TupleElement) -> bool:
    """A tuple's function-pointer field requires explicit item reification, independently of whether it owns storage."""
    match element:
        TupleElement.FunctionPointer(_signature) => return true
        _ => return false


def function_argument(mut builder: Builder, ty: PlanType, value: Operand, span: SourceSpan) -> Result[Operand, str]:
    """Reify an item passed into a function-pointer signature without changing its inferred binding type."""
    match ty:
        PlanType.FunctionPointer(_signature) =>
            source = operand_type(builder, value)?
            _type, operation = function_assignment(ty, source, value, true)?
            match operation:
                RvalueKind.ReifyFunction(_value) =>
                    result = temporary(builder, ty, span)
                    builder.emit(plan_assign(result, operation, span))
                    return Ok(read_place(result, false, span))
                _ => return Ok(value)
        _ => return Ok(value)


pub def fixed_arguments(
    mut builder: Builder,
    elements: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[list[Operand], str]:
    """Read already ordered positional elements, refusing spreading by name."""
    mut result: list[Operand] = []
    for element in elements:
        match element.as_one():
            Some(value) => result.append(value_operand(builder, value, span)?)
            None => return Err("unsupported Body IR spread ArgumentElement")
    return Ok(result)


def lower_boolean_operator(
    mut builder: Builder,
    destination: Place,
    left: &RustOperand,
    right: &RustOperand,
    name: str,
    span: SourceSpan,
) -> Result[None, str]:
    """Combine pure Body IR operands; source short-circuiting is retained by frontend branches."""
    operands = [scalar_operator_operand(builder, left, span)?, scalar_operator_operand(builder, right, span)?]
    return emit_boolean_operator(builder, destination, operands, name, span)


def lower_numeric_helper(
    mut builder: Builder,
    destination: Place,
    left: &RustOperand,
    right: &RustOperand,
    operation: str,
    span: SourceSpan,
) -> Result[None, str]:
    """Call the runtime's Python-semantics `//` or `%`, which handle negative operands and division by zero."""
    ty = place_type(builder.locals, destination)
    if has_sized_numeric(ty):
        arguments = [scalar_operand(builder, left, span)?, scalar_operand(builder, right, span)?]
        if operand_type(builder, arguments[0])? != ty or operand_type(builder, arguments[1])? != ty:
            return Err("unsupported Body IR mixed numeric division or modulo")
        external_call(
            builder,
            f"incan_native_runtime::{operation}_{numeric_name(ty)}",
            [ty, ty],
            ty,
            arguments,
            destination,
            span,
        )
        validate_exact_float(builder, destination, span)
        return Ok(None)
    mut suffix = ""
    match ty:
        PlanType.Int =>
            suffix = "i64"
        PlanType.Float =>
            suffix = "f64"
        _ => return Err("unsupported Body IR division or modulo type")
    path = f"incan_std_core::num::{operation}_{suffix}"
    arguments = [value_operand(builder, left, span)?, value_operand(builder, right, span)?]
    external_call(builder, path, [ty, ty], ty, arguments, destination, span)
    return Ok(None)


def lower_runtime_helper(
    mut builder: Builder,
    helper: &RustHelper,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch retained runtime helper identities."""
    match helper:
        RustHelper.SetContains => return collection_contains(builder, false, arguments, destination, span)
        RustHelper.SetNotContains => return collection_contains(builder, true, arguments, destination, span)
        RustHelper.DictContainsKey => return collection_contains(builder, false, arguments, destination, span)
        RustHelper.DictNotContainsKey => return collection_contains(builder, true, arguments, destination, span)
        RustHelper.StrSplit => return lower_split_helper(builder, arguments, destination, span)
        RustHelper.StrJoin => return lower_join_helper(builder, arguments, destination, span)
        RustHelper.ListConcat => return lower_list_concat(builder, arguments, destination, span)
        RustHelper.ListRepeat => return lower_list_repeat(builder, arguments, destination, span)
        RustHelper.ListContains => return lower_list_helper(builder, false, arguments, destination, span)
        RustHelper.ListNotContains => return lower_list_helper(builder, true, arguments, destination, span)
        _ => pass
    match text_helper(helper):
        Some((name, result)) => return lower_text_helper(builder, name, result, arguments, destination, span)
        None => pass
    match helper:
        RustHelper.RangeValidate =>
            if len(arguments) != 3:
                return Err("invalid Body IR RangeValidate arity")
            int_triple = [PlanType.Int, PlanType.Int, PlanType.Int]
            output = temporary(builder, PlanType.Unit, span)
            path = "incan_native_runtime::validate_range"
            operands = fixed_arguments(builder, arguments, span)?
            external_call(builder, path, int_triple, PlanType.Unit, operands, output, span)
            return Ok(None)
        RustHelper.NewtypeHookExtract => return lower_newtype_hook_result(builder, arguments, destination, span)
        RustHelper.ValidationErrorNew => return lower_validation_error(builder, arguments, destination, false, span)
        RustHelper.ValidationErrorWithCode => return lower_validation_error(builder, arguments, destination, true, span)
        RustHelper.NewtypeConstraintValidate =>
            if len(arguments) != 3:
                return Err("invalid Body IR NewtypeConstraintValidate arity")
            output = call_destination(builder, destination, PlanType.Unit, span)?
            operands = fixed_arguments(builder, arguments, span)?
            path = "incan_native_runtime::validate_newtype_constraint"
            external_call(
                builder,
                path,
                [PlanType.Bool, PlanType.String, PlanType.String],
                PlanType.Unit,
                operands,
                output,
                span,
            )
            return Ok(None)
        _ => return Err(f"unsupported Body IR Helper {helper.as_str()}")


def lower_builtin(
    mut builder: Builder,
    builtin: &RustBuiltin,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch checked builtin identities rather than matching source spellings."""
    if builtin == RustBuiltin.Bool:
        return lower_truth_builtin(builder, arguments, destination, span)
    if len(arguments) == 1 and builtin == RustBuiltin.Abs:
        operand = argument_value(builder, arguments, 0, span)?
        ty = operand_type(builder, operand)?
        match scalar_builtin(builtin, ty):
            Some((name, result)) =>
                output = call_destination(builder, destination, result, span)?
                external_call(builder, f"incan_native_runtime::{name}", [ty], result, [operand], output, span)
                return Ok(None)
            None => pass
    match builtin:
        RustBuiltin.Print => return lower_print(builder, arguments, destination, span)
        RustBuiltin.Sum => return lower_sequence_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.Sorted => return lower_sequence_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.Min => return lower_extrema_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.Max => return lower_extrema_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.ReadFile => return lower_file_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.WriteFile => return lower_file_builtin(builder, builtin, arguments, destination, span)
        RustBuiltin.Zip => return lower_zip_builtin(builder, arguments, destination, span)
        RustBuiltin.Enumerate => return lower_enumerate_builtin(builder, arguments, destination, span)
        RustBuiltin.Len => return lower_list_builtin(builder, arguments, destination, span)
        RustBuiltin.Float => return lower_scalar_conversion(builder, arguments, destination, false, span)
        RustBuiltin.Int => return lower_scalar_conversion(builder, arguments, destination, true, span)
        RustBuiltin.Str => return lower_str_builtin(builder, arguments, destination, span)
        RustBuiltin.JsonStringify => return lower_model_json_builtin(builder, arguments, destination, span)
        RustBuiltin.Range => return lower_range_builtin(builder, arguments, destination, span)
        _ => return Err(f"unsupported Body IR builtin {builtin:?}")


def lower_file_builtin(
    mut builder: Builder,
    builtin: &RustBuiltin,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Use checked Result storage for file IO, borrowing text inputs and preserving the string error payload."""
    mut count = 1
    mut name = "read_file_text"
    mut success_type = PlanType.String
    if builtin == RustBuiltin.WriteFile:
        count = 2
        name = "write_file_text"
        success_type = PlanType.Unit
    if len(arguments) != count:
        return Err("unsupported Body IR file builtin arity")
    mut output = plan_place(0, span)
    match destination:
        None => return Err("unsupported Body IR file builtin without result storage")
        Some(place) =>
            output = scalar_place(builder, place, span)?
    result = place_type(builder.locals, output)
    _owner, declaration = carrier_layout(builder, result)?
    if declaration.carrier != "Result" or len(declaration.variants) != 2:
        return Err("unsupported Body IR file builtin result carrier")
    if declaration.variants[0].fields != [success_type] or declaration.variants[1].fields != [PlanType.String]:
        return Err("unsupported Body IR file builtin result payloads")
    incoming = builder.owned
    mut operands: list[Operand] = []
    mut parameters: list[PlanType] = []
    for argument in arguments:
        match argument.as_one():
            None => return Err("unsupported Body IR spread file builtin argument")
            Some(value) =>
                operands.append(borrow_text_operand(builder, value, span)?)
                parameters.append(PlanType.StringRef)
    external_call(builder, f"incan_native_runtime::{name}", parameters, result, operands, output, span)
    drop_borrowed_text_temporaries(builder, incoming, output.local, span)
    builder.owned.append(output.local)
    return Ok(None)


def lower_extrema_builtin(
    mut builder: Builder,
    builtin: &RustBuiltin,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Borrow one homogeneous scalar list and call legacy's copy or clone minimum/maximum implementation."""
    if len(arguments) != 1:
        return Err("unsupported Body IR extrema builtin arity")
    receiver = argument_place(builder, arguments, 0, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, receiver), "unsupported Body IR extrema builtin type")?
    if depth != 1:
        return Err("unsupported Body IR nested extrema list")
    mut suffix = "int"
    mut result = PlanType.Int
    match leaf:
        ListLeaf.Int => pass
        ListLeaf.Float =>
            suffix = "float"
            result = PlanType.Float
        ListLeaf.Bool =>
            suffix = "bool"
            result = PlanType.Bool
        ListLeaf.Str =>
            suffix = "text"
            result = PlanType.String
        _ => return Err("unsupported Body IR extrema list element")
    mut name = "minimum"
    if builtin == RustBuiltin.Max:
        name = "maximum"
    output = call_destination(builder, destination, result, span)?
    reference = borrowed_list_argument(builder, arguments, 0, false, span)?
    external_call(
        builder,
        f"incan_native_runtime::{name}_{suffix}",
        [PlanType.ListRef(leaf, depth)],
        result,
        [reference],
        output,
        span,
    )
    if result == PlanType.String:
        builder.owned.append(output.local)
    return Ok(None)


def lower_range_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Construct a checked builtin `range` value as legacy's lazy integer range, rejecting a zero step now.

    The checker types the call as a list, but legacy never materializes one: the value is a native range that only
    iteration consumes. The call's fresh temporary therefore holds the runtime's integer generator, and a consumer that
    needs a list keeps its named refusal.
    """
    bounds = builtin_range_bounds(fixed_arguments(builder, arguments, span)?, span)?
    for bound in bounds:
        if operand_type(builder, bound)? != PlanType.Int:
            return Err("unsupported Body IR builtin range bound type")
    output = call_destination(builder, destination, PlanType.List(ListLeaf.Int, 1), span)?
    if output.projection != Projection.Whole or output.local in builder.owned:
        return Err("unsupported Body IR builtin range value outside a fresh temporary")
    if place_type(builder.locals, output) != PlanType.List(ListLeaf.Int, 1):
        return Err("unsupported Body IR builtin range destination type")
    result = PlanType.Generator(ListLeaf.Int, 0)
    builder.locals[output.local].ty = result
    external_call(
        builder,
        "incan_native_runtime::range_generator",
        [PlanType.Int, PlanType.Int, PlanType.Int],
        result,
        bounds,
        output,
        span,
    )
    builder.owned.append(output.local)
    return Ok(None)


def lower_zip_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Construct lazy zip only from canonical identity and two checked primitive-list arguments."""
    if len(arguments) != 2:
        return Err("unsupported Body IR zip arity")
    output = call_destination(builder, destination, PlanType.Unit, span)?
    # The frame lays out zip over two iterators as a generator of pairs, which draws from both lazily.
    match generator_shape(builder.locals[output.local].ty):
        Some(_shape) =>
            first = argument_value(builder, arguments, 0, span)?
            second = argument_value(builder, arguments, 1, span)?
            drop_owned(builder, output.local, span)
            zip_generators(builder, first, second, output, span)?
            builder.owned.append(output.local)
            return Ok(None)
        None => pass
    match zip_shape(builder.locals[output.local].ty):
        None => return Err("unsupported Body IR zip checked destination")
        Some((left, right)) =>
            first = argument_value(builder, arguments, 0, span)?
            second = argument_value(builder, arguments, 1, span)?
            first_type = operand_type(builder, first)?
            second_type = operand_type(builder, second)?
            if list_shape(first_type) == None or list_shape(second_type) == None:
                return Err("unsupported Body IR zip non-list operands")
            first_leaf, first_depth = require_list_shape(first_type, "unsupported Body IR zip left")?
            second_leaf, second_depth = require_list_shape(second_type, "unsupported Body IR zip right")?
            if list_element(first_leaf, first_depth) != tuple_element_type(left) or list_element(
                second_leaf,
                second_depth,
            ) != tuple_element_type(right):
                return Err("unsupported Body IR zip checked operand type")
            drop_owned(builder, output.local, span)
            zip_call(
                builder,
                "zip_lists",
                left,
                right,
                [first_type, second_type],
                PlanType.ZipIterator(left, right),
                [first, second],
                output,
                span,
            )
            builder.owned.append(output.local)
            return Ok(None)


def lower_enumerate_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Materialize the checked builtin's zero-based tuple list from admitted list or text inputs."""
    if len(arguments) != 1:
        return Err("invalid Body IR enumerate arity")
    source_type = argument_type(builder, arguments, 0, span)?
    mut element_type = PlanType.String
    if source_type not in [PlanType.String, PlanType.StringRef]:
        leaf, depth = require_list_shape(source_type, "unsupported Body IR enumerate non-list or text source")?
        element_type = list_element(leaf, depth)
    element = enumerated_element(element_type)?
    result = PlanType.List(ListLeaf.Tuple([TupleElement.Int, element]), 1)
    output = call_destination(builder, destination, result, span)?
    if place_type(builder.locals, output) != result:
        return Err("unsupported Body IR enumerate checked destination")
    drop_owned(builder, output.local, span)
    if source_type in [PlanType.String, PlanType.StringRef]:
        reference = text_argument(builder, arguments, 0, span)?
        external_call(
            builder,
            "incan_native_runtime::enumerate_text",
            [PlanType.StringRef],
            result,
            [reference],
            output,
            span,
        )
        builder.owned.append(output.local)
    else:
        receiver = argument_place(builder, arguments, 0, span)?
        leaf, depth = require_list_shape(source_type, "unsupported Body IR enumerate source layout")?
        reference = list_borrow(builder, receiver, false, span)?
        list_call(
            builder,
            "enumerate_list",
            element_type,
            [PlanType.ListRef(leaf, depth)],
            result,
            [reference],
            output,
            span,
        )
    return Ok(None)


def lower_model_json_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Serialize exactly one checked operand through the same implementation as the JSON protocol default."""
    if len(arguments) != 1:
        return Err("unsupported Body IR json_stringify arity")
    match arguments[0].as_one():
        Some(value) =>
            result = call_destination(builder, destination, PlanType.String, span)?
            if serialize_model_operand(builder, value, result, span)?:
                return Ok(None)
            if serialize_enum_operand(builder, value, result, span)?:
                return Ok(None)
            return serialize_scalar_json(builder, value, result, span)
        None => return Err("unsupported Body IR json_stringify spread argument")


def serialize_scalar_json(
    mut builder: Builder,
    value: &RustOperand,
    result: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve canonical scalar carriers and borrow string storage for the legacy JSON builtin."""
    match value:
        RustOperand.Constant(constant) =>
            match constant:
                RustConstant.Str(_text) => return serialize_json_text(builder, value, result, span)
                RustConstant.None =>
                    # Legacy gives untyped None a unit payload; every empty Option serializes as null.
                    text = owned_literal(builder, "null", span)
                    forget_owned(builder, text.local)
                    drop_owned(builder, result.local, span)
                    builder.emit(plan_assign(result, RvalueKind.Use(read_place(text, true, span)), span))
                    builder.owned.append(result.local)
                    return Ok(None)
                _ => pass
        RustOperand.Place(read) =>
            if not is_element_place(builder, read.place)?:
                place = scalar_place(builder, read.place, span)?
                ty = place_type(builder.locals, place)
                if ty == PlanType.String:
                    return serialize_json_text(builder, value, result, span)
                if is_list(ty):
                    return serialize_json_list(builder, value, ty, result, span)
    operand = value_operand(builder, value, span)?
    ty = operand_type(builder, operand)?
    mut name = ""
    match ty:
        PlanType.Int =>
            name = "serialize_int"
        PlanType.Float =>
            name = "serialize_float"
        PlanType.Bool =>
            name = "serialize_bool"
        _ => return Err(f"unsupported Body IR JSON serialization type {ty:?}")
    external_call(builder, f"incan_native_runtime::{name}", [ty], PlanType.String, [operand], result, span)
    return Ok(None)


def serialize_json_list(
    mut builder: Builder,
    value: &RustOperand,
    ty: PlanType,
    result: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Serialize a borrowed list through the same serde stringify boundary legacy's `json_stringify` uses."""
    leaf, depth = require_list_shape(ty, "unsupported Body IR JSON serialization of a non-list")?
    reference = checked_list_argument(builder, value, false, span)?
    owned = PlanType.List(leaf, depth)
    path = "incan_native_runtime::serialize_model"
    builder.externals.append(
        ExternalFunction(
            path=path,
            type_arguments=[owned],
            parameters=[PlanType.ListRef(leaf, depth)],
            return_type=PlanType.String,
            span=span,
        ),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, [owned]), [reference], result, span)
    builder.owned.append(result.local)
    return Ok(None)


def serialize_json_text(
    mut builder: Builder,
    value: &RustOperand,
    result: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Borrow string text before any value-read ownership transformation can move its source."""
    operand = borrow_text_operand(builder, value, span)?
    external_call(
        builder,
        "incan_native_runtime::serialize_string",
        [PlanType.StringRef],
        PlanType.String,
        [operand],
        result,
        span,
    )
    return Ok(None)


def lower_print(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Print space-separated arguments and initialize the checked Unit result when the call is an expression."""
    # `parts` holds the literal text around each value: "" before the first, " " between values, "" after the last.
    mut parts = [""]
    mut values: list[Place] = []
    for argument in arguments:
        match argument.as_one():
            Some(value) => values.append(display_operand(builder, value, span)?)
            None => return Err("unsupported Body IR spread print argument")
        parts.append(" ")
    parts[-1] = ""
    text = temporary(builder, PlanType.String, span)
    format_parts(builder, text, parts, values, span)
    mut output = temporary(builder, PlanType.Unit, span)
    # Expression arms read this call's retained result; an unrelated Unit temporary leaves that read uninitialized.
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
        None => pass
    path = "incan_native_runtime::println_text"
    external_call(builder, path, [PlanType.String], PlanType.Unit, [read_place(text, true, span)], output, span)
    return Ok(None)


def lower_scalar_conversion(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    integer: bool,
    span: SourceSpan,
) -> Result[None, str]:
    """Lower checked scalar builtins through the numeric admission table."""
    match destination:
        None => return Err("Body IR scalar conversion has no destination")
        Some(place) =>
            output = scalar_place(builder, place, span)?
            if lower_text_scalar_conversion(builder, arguments, output, integer, span)?:
                return Ok(None)
            operands = fixed_arguments(builder, arguments, span)?
            if len(operands) == 0:
                mut zero = Constant.Float(0.0)
                if integer:
                    zero = Constant.Int(0)
                builder.emit(plan_assign(output, RvalueKind.Use(literal(zero, span)), span))
                return Ok(None)
            if len(operands) != 1:
                return Err("unsupported Body IR scalar conversion arity")
            operand = operands[0]
            ty = operand_type(builder, operand)?
            if has_sized_numeric(ty):
                mut builtin = "float"
                mut result_type = PlanType.Float
                if integer:
                    builtin = "int"
                    result_type = PlanType.Int
                external_call(
                    builder,
                    f"incan_native_runtime::{builtin}_{numeric_name(ty)}",
                    [ty],
                    result_type,
                    [operand],
                    output,
                    span,
                )
                return Ok(None)
            mut conversion = float_conversion(operand, ty)
            if integer:
                conversion = integer_conversion(operand, ty)
            builder.emit(plan_assign(output, conversion?, span))
            return Ok(None)
# =====================================================================================================================
# Formatting and strings
# =====================================================================================================================


def validate_exact_float(mut builder: Builder, target: Place, span: SourceSpan) -> None:
    """Keep exact f32 values finite at assignment and parameter boundaries, as legacy does."""
    if place_type(builder.locals, target) == PlanType.F32:
        operand = read_place(target, false, span)
        external_call(
            builder,
            "incan_std_core::num::require_finite_f32",
            [PlanType.F32],
            PlanType.F32,
            [operand],
            target,
            span,
        )


def lower_text_scalar_conversion(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    output: Place,
    integer: bool,
    span: SourceSpan,
) -> Result[bool, str]:
    """Parse borrowed text through legacy's raising runtime functions, preserving the original input."""
    if len(arguments) != 1:
        return Ok(false)
    match arguments[0].as_one():
        None => return Err("unsupported Body IR spread scalar conversion")
        Some(value) =>
            mut text_input = false
            match value:
                RustOperand.Constant(constant) =>
                    match constant:
                        RustConstant.FrozenStr(_text) =>
                            return Err(
                                "unsupported Body IR static text numeric conversion: legacy emits an invalid cast",
                            )
                        RustConstant.Str(_text) =>
                            text_input = true
                        _ => pass
                RustOperand.Place(read) =>
                    place = scalar_place(builder, read.place, span)?
                    text_input = place_type(builder.locals, place) in [PlanType.String, PlanType.FrozenStr]
            if not text_input:
                return Ok(false)
            text = display_operand(builder, value, span)?
            reference = temporary(builder, PlanType.StringRef, span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(text), span))
            mut name = "parse_float"
            mut result = PlanType.Float
            if integer:
                name = "parse_int"
                result = PlanType.Int
            external_call(
                builder,
                f"incan_native_runtime::{name}",
                [PlanType.StringRef],
                result,
                [read_place(reference, false, span)],
                output,
                span,
            )
            drop_owned(builder, text.local, span)
            return Ok(true)


def coerce_numeric_operand(
    mut builder: Builder,
    operand: Operand,
    target: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Materialize a checker-admitted destination carrier at typed boundaries, never guess binary promotions."""
    if not numeric_carrier(target):
        return Ok(operand)
    source = operand_type(builder, operand)?
    if source == target:
        return Ok(operand)
    if not numeric_carrier(source):
        return Err("unsupported Body IR nonnumeric implicit conversion")
    converted = temporary(builder, target, span)
    builder.emit(plan_assign(converted, RvalueKind.NumericCast(operand, source, target), span))
    validate_exact_float(builder, converted, span)
    return Ok(read_place(converted, false, span))


pub def clone_nominal_operand(mut builder: Builder, value: Place, span: SourceSpan) -> Result[Operand, str]:
    """
    Materialize the checker's clone fact through a source nominal's real derived Clone implementation.

    A shared model reference, such as a receiver, already is the borrow that Clone takes.
    """
    match place_type(builder.locals, value):
        PlanType.ValidationError => return carrier_payload_value(builder, value, span)
        PlanType.ValidationErrorRef =>
            owned = Place(local=value.local, projection=Projection.Deref(PlanType.ValidationError), span=span)
            return carrier_payload_value(builder, owned, span)
        PlanType.ModelRef(index, name) =>
            result = temporary(builder, PlanType.Model(index, name), span)
            terminate_call(builder, CalleeKind.CloneModel(index, name), [read_place(value, false, span)], result, span)
            builder.owned.append(result.local)
            return Ok(read_place(result, true, span))
        PlanType.Model(index, name) =>
            reference = temporary(builder, PlanType.ModelRef(index, name), span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(value), span))
            result = temporary(builder, PlanType.Model(index, name), span)
            terminate_call(
                builder,
                CalleeKind.CloneModel(index, name),
                [read_place(reference, false, span)],
                result,
                span,
            )
            builder.owned.append(result.local)
            return Ok(read_place(result, true, span))
        PlanType.Enum(index, name) =>
            reference = temporary(builder, PlanType.EnumRef(index, name), span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(value), span))
            result = temporary(builder, PlanType.Enum(index, name), span)
            terminate_call(
                builder,
                CalleeKind.CloneEnum(index, name),
                [read_place(reference, false, span)],
                result,
                span,
            )
            builder.owned.append(result.local)
            return Ok(read_place(result, true, span))
        _ => return Err("unsupported Body IR ownership Clone outside models or formatting")


def checked_aggregate(
    module: &BodyIrModule,
    mut builder: Builder,
    kind: &RustAggregateKind,
    elements: &list[RustArgumentElement],
    expected: PlanType,
    span: SourceSpan,
) -> Result[RvalueKind, str]:
    """Materialize a tuple or a proven plain-model constructor with its retained field order and ownership."""
    match kind:
        RustAggregateKind.EnumVariant(target) =>
            owner, variant = variant_index(builder.enums, target, expected)?
            if len(elements) != len(builder.enums[owner].variants[variant].fields):
                return Err("invalid Body IR enum constructor payload count")
            mut operands: list[Operand] = []
            for slot in range(len(elements)):
                match elements[slot].as_one():
                    Some(value) =>
                        ty = native_source_type(
                            builder.nominals,
                            builder.enums,
                            builder.unions,
                            builder.enums[owner].variants[variant].fields[slot],
                            builder.intrinsics,
                        )?
                        if ty == PlanType.String:
                            text = display_operand(builder, value, span)?
                            operands.append(read_place(text, true, span))
                        elif ty == PlanType.FrozenStr:
                            operands.append(frozen_operand(builder, value, span)?)
                        else:
                            operands.append(boundary_operand(builder, value, ty, span)?)
                    None => return Err("unsupported Body IR spread enum payload")
            return Ok(RvalueKind.Enum(owner, variant, operands))
        RustAggregateKind.Tuple =>
            mut element_types: list[TupleElement] = []
            match expected:
                PlanType.Tuple(types) =>
                    element_types = types
                _ => pass
            mut operands: list[Operand] = []
            for slot in range(len(elements)):
                element = elements[slot]
                match element.as_one():
                    Some(value) =>
                        # A list or carrier element takes the destination element's exact carrier, `None` included.
                        if slot < len(element_types) and (carrier_element(element_types[slot]) or tuple_pointer_element(
                            element_types[slot],
                        )):
                            operands.append(
                                boundary_operand(builder, value, tuple_element_type(element_types[slot]), span)?,
                            )
                            continue
                        match value:
                            RustOperand.Constant(constant) =>
                                match constant:
                                    RustConstant.Str(text) =>
                                        operands.append(read_place(owned_literal(builder, str(text), span), true, span))
                                    _ => operands.append(scalar_operand(builder, value, span)?)
                            RustOperand.Place(read) =>
                                # A list or dictionary element is already a materialized copy the tuple can own.
                                if is_element_place(builder, read.place)?:
                                    operands.append(value_operand(builder, value, span)?)
                                    continue
                                target = scalar_place(builder, read.place, span)?
                                if place_type(builder.locals, target) == PlanType.String:
                                    operands.append(read_place(display_operand(builder, value, span)?, true, span))
                                else:
                                    operands.append(scalar_operand(builder, value, span)?)
                    None => return Err("unsupported Body IR spread tuple element")
            return Ok(tuple_aggregate(operands))
        RustAggregateKind.Constructor(target) =>
            index = constructor_index(builder.nominals, target, len(elements), expected)?
            match target.binding:
                RustArgumentBinding.Resolved(arguments=_arguments, defaulted_slots=defaults) =>
                    if len(defaults) == 0:
                        operands = model_field_operands(builder, index, elements, span)?
                        return Ok(RvalueKind.Model(index, operands))
                _ => return Err("unsupported Body IR unresolved model constructor")
            operands = model_default_arguments(module, builder, index, target.binding, elements, span)?
            return Ok(RvalueKind.Model(index, operands))
        RustAggregateKind.Range => return range_value(builder, elements, expected, span)
        _ => return Err("unsupported Body IR Aggregate outside plain models")


def range_value(
    mut builder: Builder,
    elements: &list[RustArgumentElement],
    expected: PlanType,
    span: SourceSpan,
) -> Result[RvalueKind, str]:
    """Copy a source range's checked scalar fields, in Body IR's declared order, into its native layout."""
    mut fields: list[Operand] = []
    mut types: list[PlanType] = []
    for element in elements:
        match element.as_one():
            Some(value) =>
                field = scalar_operand(builder, value, span)?
                fields.append(field)
                types.append(operand_type(builder, field)?)
            None => return Err("unsupported Body IR spread range field")
    return range_aggregate(expected, fields, types)


def model_field_operands(
    mut builder: Builder,
    index: int,
    elements: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[list[Operand], str]:
    """Materialize canonical fields with their checked concrete types, preserving string and model ownership facts."""
    declaration = builder.nominals[index]
    mut operands: list[Operand] = []
    for slot in range(len(elements)):
        match elements[slot].as_one():
            Some(value) =>
                field_type = native_source_type(
                    builder.nominals,
                    builder.enums,
                    builder.unions,
                    declaration.field_types[slot],
                    builder.intrinsics,
                )?
                if field_type == PlanType.String:
                    text = display_operand(builder, value, span)?
                    operands.append(read_place(text, true, span))
                else:
                    operand = boundary_operand(builder, value, field_type, span)?
                    # Generic inference has already selected this field's carrier; retain its widening just as a call slot does.
                    operands.append(coerce_numeric_operand(builder, operand, field_type, span)?)
            None => return Err("unsupported Body IR spread model field")
    return Ok(operands)


def lower_string_field_assignment(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Evaluate replacement text before dropping the old field, retaining its initialized parent owner."""
    mut replacement = temporary(builder, PlanType.String, span)
    match value:
        RustRvalue.Use(operand) =>
            replacement = display_operand(builder, operand, span)?
        RustRvalue.Format(parts) => lower_format(builder, replacement, parts, span)?
        _ => return Err("unsupported Body IR string field Rvalue outside formatting")
    continuation = builder.new_block(span)
    cleanup = cleanup_exit(builder, span)
    builder.finish(TerminatorKind.Drop(destination, continuation, Unwind.Cleanup(cleanup)), span)
    builder.current = continuation
    forget_owned(builder, replacement.local)
    builder.emit(plan_assign(destination, RvalueKind.Use(read_place(replacement, true, span)), span))
    return Ok(None)
# =====================================================================================================================
# Formatting and strings
# =====================================================================================================================


def lower_format(
    mut builder: Builder,
    destination: Place,
    retained: &list[RustFormatPart],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower an f-string, retaining literal boundaries and the checked display or nominal Debug style."""
    mut parts = [""]
    mut values: list[Place] = []
    for part in retained:
        append_format_part(builder, part, parts, values, span)?
    format_parts(builder, destination, parts, values, span)
    return Ok(None)


def append_format_part(
    mut builder: Builder,
    part: &RustFormatPart,
    mut parts: list[str],
    mut values: list[Place],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Add one f-string part: literal text extends the current text run, a value starts a new one.

    `parts` always has one more entry than `values`: the text before, between and after the values.
    """
    match part:
        RustFormatPart.Literal(text) =>
            parts[-1] += str(text)
        RustFormatPart.Expr(operand=value, style=style) =>
            match style:
                RustFormatStyle.Display => values.append(display_operand(builder, value, span)?)
                RustFormatStyle.Debug => values.append(debug_operand(builder, value, span)?)
                RustFormatStyle.TypeParameterDisplay => values.append(
                    type_parameter_display_operand(builder, value, span)?,
                )
            parts.append("")
    return Ok(None)


def type_parameter_display_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Use the shared formatter's generic Display contract, including its copied borrowed-field observations."""
    return display_value_operand(builder, value, span, true)


def debug_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Render admitted scalar and list values with legacy Debug after materializing their checked ownership."""
    match value:
        RustOperand.Place(read) =>
            if len(read.place.projection) == 0:
                match read.place.global():
                    None =>
                        place = scalar_place(builder, read.place, span)?
                        match place_type(builder.locals, place):
                            PlanType.Model(_owner, _name) => return debug_model_operand(builder, value, span)
                            PlanType.Enum(owner, _name) => return debug_union_operand(builder, place, owner, span)
                            _ => pass
                    Some(_global) => pass
        _ => pass
    operand = value_operand(builder, value, span)?
    ty = operand_type(builder, operand)?
    if has_sized_numeric(ty) or ty == PlanType.Int or ty == PlanType.Float or ty == PlanType.Bool or ty == PlanType.Unit or ty == PlanType.String or is_owned_list(
        ty,
    ):
        return debug_plan_operand(builder, operand, span)
    return Err("unsupported Body IR nonmodel FormatStyle.Debug")


def display_tuple_place(mut builder: Builder, value: &RustPlace, span: SourceSpan) -> Result[Option[Place], str]:
    """Display a whole local tuple while leaving global statics and other carriers on their existing paths."""
    match value.local_id():
        None => return Ok(None)
        Some(_local) => pass
    if len(value.projection) != 0:
        return Ok(None)
    target = scalar_place(builder, value, span)?
    ty = place_type(builder.locals, target)
    if not is_tuple_type(ty):
        return Ok(None)
    if tuple_debug_formatted(ty):
        # A list or carrier element has no flat formatter; Debug of a snapshot spells the whole tuple as legacy does.
        snapshot = clone_tuple_operand(builder, target, span)?
        return Ok(Some(debug_plan_operand(builder, snapshot, span)?))
    return Ok(Some(display_tuple(builder, target, span)?))


pub def display_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Produce an owned `String` holding a value's display text, honoring the value's ownership fact."""
    return display_value_operand(builder, value, span, false)


def display_value_operand(
    mut builder: Builder,
    value: &RustOperand,
    span: SourceSpan,
    type_parameter: bool,
) -> Result[Place, str]:
    """
    Produce an owned `String` holding a value's display text, honoring the value's ownership fact.

    A value whose checked type is a type parameter displays as generic code displays it (see `display_plan_value`).
    """
    match display_model_operand(builder, value, span)?:
        Some(text) => return Ok(text)
        None => pass
    # Indexed collection reads come first: their places are not model places, so the carrier check below cannot map them.
    match value:
        RustOperand.Place(read) =>
            # Retained globals are scalar-only and have no frame-local slot for carrier inspection.
            match read.place.global():
                Some(_global) =>
                    operand = value_operand(builder, value, span)?
                    return display_plan_value(builder, operand, span, type_parameter)
                None => pass
            match element_read(builder, read.place, span)?:
                Some(item) => return display_plan_value(builder, item, span, type_parameter)
                None => pass
            match display_tuple_place(builder, read.place, span)?:
                Some(text) => return Ok(text)
                None => pass
        _ => pass
    match value:
        RustOperand.Place(read) =>
            place = scalar_place(builder, read.place, span)?
            if is_list(place_type(builder.locals, place)) or is_collection(place_type(builder.locals, place)):
                operand = value_operand(builder, value, span)?
                return display_plan_value(builder, operand, span, type_parameter)
            match place_type(builder.locals, place):
                PlanType.ValidationError => return display_validation_error(builder, place, span)
                PlanType.ValidationErrorRef => return display_validation_error(builder, place, span)
                PlanType.Enum(owner, name) =>
                    if owner >= len(builder.enums) and builder.intrinsics[owner - len(builder.enums)].carrier != "":
                        result = format_carrier(builder, place, span)?
                        if read.fact == OwnershipFact.Move:
                            drop_owned(builder, place.local, span)
                        return Ok(result)
                    value_enum = value_enum_owner(builder, owner)?
                    if value_enum >= 0:
                        return display_value_enum(builder, value_enum, place, span)
                _ => pass
        _ => pass
    # A cloned or borrowed string is copied into a new owned string; the original stays where it is.
    match value:
        RustOperand.Place(read) =>
            match read.fact:
                OwnershipFact.Clone => return clone_display_place(builder, read.place, span, type_parameter)
                OwnershipFact.Borrow => return clone_display_place(builder, read.place, span, type_parameter)
                _ => pass
        RustOperand.Constant(constant) =>
            match literal_text(constant):
                Some(text) => return Ok(owned_literal(builder, text, span))
                None => pass
    operand = value_operand(builder, value, span)?
    return display_plan_value(builder, operand, span, type_parameter)


def value_enum_owner(builder: Builder, index: int) -> Result[int, str]:
    """Find the value enum whose retained layout is source enum `index`, or -1 for any other enum."""
    if index >= len(builder.enums):
        return Ok(-1)
    for owner in range(len(builder.value_enums)):
        if builder.enums[index].canonical == builder.value_enums[owner].canonical:
            validate_layout(builder.enums[index], builder.value_enums[owner])?
            return Ok(owner)
    return Ok(-1)


def display_value_enum(mut builder: Builder, owner: int, source: Place, span: SourceSpan) -> Result[Place, str]:
    """Display a value enum as its raw value, as legacy's Display does: the text itself, or the integer's digits."""
    ty = value_enum_raw_type(builder, owner)
    raw = temporary(builder, ty, span)
    select_value_enum_raw(builder, owner, source, raw, span)?
    if ty == PlanType.String:
        return Ok(raw)
    return display_plan_operand(builder, read_place(raw, false, span), span)


def display_plan_operand(mut builder: Builder, operand: Operand, span: SourceSpan) -> Result[Place, str]:
    """Format a materialized scalar without re-reading its source ownership fact."""
    return display_plan_value(builder, operand, span, false)


def display_plan_value(
    mut builder: Builder,
    operand: Operand,
    span: SourceSpan,
    type_parameter: bool,
) -> Result[Place, str]:
    """
    Format a materialized scalar, as generic code formats it when its checked type is a type parameter.

    A list, set or dictionary displays through its structure, as legacy's Debug spells it.
    """
    ty = operand_type(builder, operand)?
    match ty:
        PlanType.FrozenCollection(_name, _elements) => return debug_plan_operand(builder, operand, span)
        _ => pass
    # Generic code displays a type-parameter value through its type argument's own Display, which spells an
    # integral float without the fractional part the concrete float spelling keeps.
    if type_parameter and (ty == PlanType.Float or ty == PlanType.F32 or ty == PlanType.F64):
        return type_parameter_display(builder, operand, span)
    if is_owned_list(ty) or is_owned_collection(ty):
        return debug_plan_operand(builder, operand, span)
    if ty == PlanType.String:
        return display_string_operand(builder, operand, span)
    if has_sized_numeric(ty):
        result = temporary(builder, PlanType.String, span)
        external_call(
            builder,
            f"incan_native_runtime::format_{numeric_name(ty)}",
            [ty],
            PlanType.String,
            [operand],
            result,
            span,
        )
        return Ok(result)
    mut name = ""
    match ty:
        PlanType.Decimal =>
            name = "format_decimal"
        PlanType.FrozenStr =>
            name = "format_frozen"
        PlanType.Int =>
            name = "format_int"
        PlanType.Float =>
            name = "format_float"
        PlanType.Bool =>
            name = "format_bool"
        _ => return Err("unsupported Body IR display type")
    result = temporary(builder, PlanType.String, span)
    external_call(builder, f"incan_native_runtime::{name}", [ty], PlanType.String, [operand], result, span)
    return Ok(result)


def debug_union_operand(mut builder: Builder, place: Place, owner: int, span: SourceSpan) -> Result[Place, str]:
    """Render a union through its member-delegating Debug on a copy; other enums keep their named refusal."""
    if not is_union_carrier(builder, owner):
        return Err("unsupported Body IR nonmodel FormatStyle.Debug")
    copied = clone_nominal_operand(builder, place, span)?
    return debug_plan_operand(builder, copied, span)


def debug_plan_operand(mut builder: Builder, operand: Operand, span: SourceSpan) -> Result[Place, str]:
    """Invoke legacy Debug on an admitted carrier after its read ownership has been materialized."""
    return runtime_text(builder, "incan_native_runtime::debug_value", operand, span)


def type_parameter_display(mut builder: Builder, operand: Operand, span: SourceSpan) -> Result[Place, str]:
    """Invoke the carrier's own Display, as generic code formats a type-parameter value."""
    return runtime_text(builder, "incan_native_runtime::display_value", operand, span)


def runtime_text(mut builder: Builder, path: str, operand: Operand, span: SourceSpan) -> Result[Place, str]:
    """Render one owned carrier through a runtime formatter instantiated at the carrier's exact type."""
    ty = operand_type(builder, operand)?
    result = temporary(builder, PlanType.String, span)
    builder.externals.append(
        ExternalFunction(path=path, type_arguments=[ty], parameters=[ty], return_type=PlanType.String, span=span),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, [ty]), [operand], result, span)
    builder.owned.append(result.local)
    return Ok(result)


def display_string_operand(mut builder: Builder, operand: Operand, span: SourceSpan) -> Result[Place, str]:
    """A string displays as itself: a moved string is used directly, a copied one is cloned."""
    match operand.kind:
        OperandKind.Move(place) => return Ok(place)
        OperandKind.Copy(place) => return clone_text(builder, place, span)
        _ => return Err("unsupported Body IR string display ownership")


def clone_display_place(
    mut builder: Builder,
    value: &RustPlace,
    span: SourceSpan,
    type_parameter: bool,
) -> Result[Place, str]:
    """
    Clone borrowed owned text for display; copyable decimal and frozen carriers keep their exact values.

    A scalar a type parameter's checked clone or borrow fact reads, once its instance or closed binding makes it
    concrete, displays from a copy, in the type-parameter display style when the value's checked type is one.
    """
    place = scalar_place(builder, value, span)?
    ty = place_type(builder.locals, place)
    if ty in [PlanType.Decimal, PlanType.FrozenStr] or numeric_carrier(ty) or ty == PlanType.Bool or ty == PlanType.Unit:
        return display_plan_value(builder, read_place(place, false, span), span, type_parameter)
    if place_type(builder.locals, place) != PlanType.String:
        return Err("unsupported Body IR nonscalar display borrow")
    return clone_text(builder, place, span)


def lower_string_assignment(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Evaluate a replacement before dropping its old value, preserving retained text ownership."""
    if destination.projection != Projection.Whole:
        return lower_string_field_assignment(builder, destination, value, span)
    match value:
        RustRvalue.Format(parts) =>
            text = temporary(builder, PlanType.String, span)
            lower_format(builder, text, parts, span)?
            forget_owned(builder, text.local)
            drop_owned(builder, destination.local, span)
            builder.emit(plan_assign(destination, RvalueKind.Use(read_place(text, true, span)), span))
            builder.owned.append(destination.local)
            return Ok(None)
        RustRvalue.Use(operand) =>
            text = display_operand(builder, operand, span)?
            forget_owned(builder, text.local)
            drop_owned(builder, destination.local, span)
            builder.emit(plan_assign(destination, RvalueKind.Use(read_place(text, true, span)), span))
            builder.owned.append(destination.local)
            return Ok(None)
        _ => return Err("unsupported Body IR string Rvalue outside formatting")


def lower_discarded_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[None, str]:
    """Evaluate discarded text through retained ownership facts and drop its materialized owner."""
    mut is_text = false
    match value:
        RustOperand.Constant(constant) =>
            match constant:
                RustConstant.Str(_text) =>
                    is_text = true
                _ => pass
        RustOperand.Place(read) =>
            place = scalar_place(builder, read.place, span)?
            is_text = place_type(builder.locals, place) == PlanType.String
    if is_text:
        text = display_operand(builder, value, span)?
        drop_owned(builder, text.local, span)
    else:
        _ = value_operand(builder, value, span)?
    return Ok(None)


def borrow_text_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Borrow an owned string for a helper without transferring its owner."""
    match value:
        RustOperand.Place(read) =>
            match read.place.global():
                Some(global) =>
                    owner = read_static(builder, read.place, global, read.fact, span)?
                    match owner.kind:
                        OperandKind.Move(place) =>
                            reference = temporary(builder, PlanType.StringRef, span)
                            builder.emit(plan_assign(reference, RvalueKind.Borrow(place), span))
                            return Ok(read_place(reference, false, span))
                        _ => return Err("unsupported Body IR non-string static text operand")
                None => pass
            if is_element_place(builder, read.place)?:
                return borrow_element_text(builder, value, read.fact, span)
            place = scalar_place(builder, read.place, span)?
            if place_type(builder.locals, place) == PlanType.FrozenStr:
                if read.fact == OwnershipFact.MutBorrow or read.fact == OwnershipFact.Unknown:
                    return Err("unsupported Body IR unproven FrozenStr text borrow")
                owner = display_plan_operand(builder, read_place(place, false, span), span)?
                reference = temporary(builder, PlanType.StringRef, span)
                builder.emit(plan_assign(reference, RvalueKind.Borrow(owner), span))
                return Ok(read_place(reference, false, span))
            if place_type(builder.locals, place) != PlanType.String:
                return Err("unsupported Body IR non-string text operand")
            match read.fact:
                OwnershipFact.MutBorrow => return Err("unsupported Body IR mutable String borrow")
                OwnershipFact.Unknown => return Err("unsupported Body IR unknown String ownership")
                _ => pass
            reference = temporary(builder, PlanType.StringRef, span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(place), span))
            return Ok(read_place(reference, false, span))
        RustOperand.Constant(constant) =>
            match literal_text(constant):
                Some(text) =>
                    owner = owned_literal(builder, text, span)
                    reference = temporary(builder, PlanType.StringRef, span)
                    builder.emit(plan_assign(reference, RvalueKind.Borrow(owner), span))
                    return Ok(read_place(reference, false, span))
                None => return Err("unsupported Body IR non-string text constant")


def borrow_element_text(
    mut builder: Builder,
    value: &RustOperand,
    fact: &OwnershipFact,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Borrow a materialized copy of a list or dictionary text element; the copy is a new owner its caller releases."""
    match fact:
        OwnershipFact.MutBorrow => return Err("unsupported Body IR mutable String borrow")
        OwnershipFact.Unknown => return Err("unsupported Body IR unknown String ownership")
        _ => pass
    match value_operand(builder, value, span)?.kind:
        OperandKind.Move(owner) =>
            if place_type(builder.locals, owner) != PlanType.String:
                return Err("unsupported Body IR non-string text operand")
            reference = temporary(builder, PlanType.StringRef, span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(owner), span))
            return Ok(read_place(reference, false, span))
        _ => return Err("unsupported Body IR non-string text operand")


def lower_text_helper(
    mut builder: Builder,
    name: str,
    result: PlanType,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Bind the retained string-helper identity to shared operands and its monomorphic runtime entry."""
    arity = text_helper_arity(name)
    if len(arguments) != arity:
        return Err("invalid Body IR string helper arity")
    incoming = builder.owned
    mut parameters: list[PlanType] = []
    mut operands: list[Operand] = []
    for argument in arguments:
        parameters.append(PlanType.StringRef)
        match argument.as_one():
            Some(value) => operands.append(borrow_text_operand(builder, value, span)?)
            None => return Err("unsupported Body IR spread string helper argument")
    text = emit_text_helper(builder, name, result, parameters, operands, span)
    # Literal arguments belong to this call, including when its source branch is skipped elsewhere.
    drop_borrowed_text_temporaries(builder, incoming, text.local, span)
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
            forget_owned(builder, text.local)
            drop_owned(builder, output.local, span)
            builder.emit(plan_assign(output, RvalueKind.Use(read_place(text, result == PlanType.String, span)), span))
            if result == PlanType.String:
                builder.owned.append(output.local)
        None => drop_owned(builder, text.local, span)
    return Ok(None)
# =====================================================================================================================
# Module and function entry points
# =====================================================================================================================


def lower_str_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Materialize str() using the same scalar display conversions as legacy formatting."""
    mut text = plan_place(0, span)
    if len(arguments) == 0:
        text = owned_literal(builder, "", span)
    elif len(arguments) == 1:
        match arguments[0].as_one():
            Some(value) =>
                text = display_operand(builder, value, span)?
            None => return Err("unsupported Body IR spread str argument")
    else:
        return Err("unsupported Body IR str arity")
    return assign_text_result(builder, text, destination, span)


def assign_text_result(
    mut builder: Builder,
    text: Place,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Move an owned text temporary into the call's destination, replacing what it held, or drop a discarded one."""
    match destination:
        Some(place) =>
            output = scalar_place(builder, place, span)?
            forget_owned(builder, text.local)
            drop_owned(builder, output.local, span)
            builder.emit(plan_assign(output, RvalueKind.Use(read_place(text, true, span)), span))
            builder.owned.append(output.local)
        None => drop_owned(builder, text.local, span)
    return Ok(None)


def lower_display_str(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Render the receiver's Display form, as a derived or builtin Display's `__str__` does.

    A number or a bool is copied, though the method call borrows it; any other receiver, a model with a checked derived
    Display included, displays as `str()` displays it.
    """
    if len(arguments) != 1:
        return Err("invalid Body IR Display __str__ arguments")
    match arguments[0].as_one():
        Some(value) =>
            text = display_receiver(builder, value, span)?
            return assign_text_result(builder, text, destination, span)
        None => return Err("unsupported Body IR Display __str__ spread receiver")


def display_receiver(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Select the display rendering for one borrowed receiver."""
    match value:
        RustOperand.Place(read) =>
            place = scalar_place(builder, read.place, span)?
            ty = place_type(builder.locals, place)
            if numeric_carrier(ty) or ty == PlanType.Bool:
                return display_plan_operand(builder, Operand(kind=OperandKind.Copy(place), span=span), span)
        _ => pass
    return display_operand(builder, value, span)


pub def lower_program(
    modules: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
) -> Result[Plan, str]:
    """Validate each owning module, then lower one native plan with a shared canonical declaration context."""
    if len(modules) == 0 or entry < 0 or entry >= len(modules):
        return Err("invalid Body IR project entry")
    if len(sources) != len(modules) or len(files) != len(modules):
        return Err("invalid Body IR project source provenance")
    for module in modules:
        _ = validate_project_module(module, modules)?
    source_context, checked = project_context(modules, entry)?
    context = specialize_enums(specialize_nominals(source_context)?)?
    mut has_main = false
    for body in checked[entry].bodies:
        if function_name(context, body) == "main":
            has_main = true
    if not has_main:
        return Err("unsupported Body IR project without selected main entrypoint")
    unions = collect_unions(context)
    mut intrinsics = intrinsic_declarations(context, files[entry])?
    models = lower_model_declarations(context, files[entry], intrinsics)?
    mut enums = lower_enum_declarations(context, files[entry], intrinsics)?
    mut functions: list[Function] = []
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    for index in range(len(checked)):
        for body in context.bodies:
            if body_module_identity(body)? != str(checked[index].module_id.path()):
                continue
            if len(body.type_parameters) != 0:
                continue
            function, runtime, pending, synthesized = lower_function(
                context,
                body,
                unions,
                sources[index],
                files[index],
                intrinsics,
                [],
            )?
            instances.extend(pending)
            for retained in functions:
                if retained.name == function.name:
                    return Err(f"unsupported Body IR overloaded function {body.name}")
            functions.append(function)
            append_synthesized(functions, synthesized)?
            if body.is_async and function_name(context, body) == "main":
                entry_function, entry_runtime = async_entry(function)
                functions.append(entry_function)
                merge_externals(externals, [entry_runtime])
            append_generator_constructor(functions, context, body, sources[index], files[index], intrinsics)?
            merge_externals(externals, runtime)
    mut owners: list[str] = []
    for module in checked:
        owners.append(str(module.module_id.path()))
    statics = lower_computed_statics(
        context,
        unions,
        sources,
        files,
        owners,
        intrinsics,
        functions,
        externals,
        instances,
    )?
    _ = lower_instances(context, instances, unions, sources, files, owners, functions, externals, intrinsics)?
    # Instances may add intrinsic declarations, so the intrinsic and future declarations join the plan last.
    for declaration in intrinsics:
        enums.append(declaration)
    for declaration in future_declarations(context, files[entry], intrinsics)?:
        enums.append(declaration)
    return Ok(
        Plan(
            enums=enums,
            models=models,
            functions=functions,
            externals=externals,
            span=SourceSpan(file=files[entry], line=1, column=1),
            statics=statics,
        ),
    )


def lower_computed_statics(
    module: &BodyIrModule,
    unions: list[RustType],
    sources: list[str],
    files: list[str],
    owners: list[str],
    intrinsics: list[EnumDeclaration],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut instances: list[Instance],
) -> Result[list[StaticCell], str]:
    """
    Plan each computed static (RFC 052): its initializer body becomes a planned function returning the first value,
    the static a storage cell the adapter declares, and each module declaring computed statics one initializer that
    forces them in declaration order (see `computed_statics`).
    """
    mut cells: list[StaticCell] = []
    mut keys: list[int] = []
    for slot in range(len(module.static_declarations)):
        declaration = module.static_declarations[slot]
        for binding in module.decorated_bindings:
            if binding.original_body.canonical == Some(declaration.canonical):
                mut owner_index = -1
                for index in range(len(owners)):
                    if owners[index] == static_owner(declaration):
                        owner_index = index
                if owner_index < 0:
                    return Err("unsupported Body IR original callable without source provenance")
                original, original_runtime, original_pending, original_synthesized = lower_function(
                    module,
                    binding.original_body,
                    unions,
                    sources[owner_index],
                    files[owner_index],
                    intrinsics,
                    [],
                )?
                mut original_function = original
                original_function.name = f"{function_name(module, binding.original_body)}__incan_original"
                for retained in functions:
                    if retained.name == original_function.name:
                        return Err("unsupported Body IR original callable name collision")
                functions.append(original_function)
                append_synthesized(functions, original_synthesized)?
                merge_externals(externals, original_runtime)
                instances.extend(original_pending)
        match declaration.initial:
            RustStaticInitializer.Computed(body) =>
                owner = static_owner(declaration)
                mut source_index = -1
                for index in range(len(owners)):
                    if owners[index] == owner:
                        source_index = index
                if source_index < 0:
                    return Err("unsupported Body IR computed static without source provenance")
                function, runtime, pending, synthesized = lower_function(
                    module,
                    body,
                    unions,
                    sources[source_index],
                    files[source_index],
                    intrinsics,
                    [],
                )?
                mut initializer = function
                initializer.name = static_initializer_name(slot)
                ty = native_source_type(
                    module.nominal_declarations,
                    module.enum_declarations,
                    unions,
                    declaration.ty,
                    intrinsics,
                )?
                if initializer.return_type != ty:
                    return Err("invalid Body IR computed static initializer carrier")
                cells.append(StaticCell(slot=slot, ty=ty, initializer=initializer.name, span=initializer.span))
                key = module_static_key(module.static_declarations, owner)
                if key not in keys:
                    keys.append(key)
                    functions.append(module_initializer(module.static_declarations, key, initializer.span))
                    merge_externals(externals, module_initialization_externals(initializer.span))
                functions.append(initializer)
                append_synthesized(functions, synthesized)?
                merge_externals(externals, runtime)
                instances.extend(pending)
            _ => pass
    return Ok(cells)


pub def program_refusals(modules: &list[BodyIrModule], sources: list[str], files: list[str], entry: int) -> list[str]:
    """
    Collect every body's first refusal rather than only the program's first, for the direct-route census.

    The declaration context is prepared as `lower_program` prepares it, and a refusal there is the only one reported,
    because no body lowers without that context. Each ordinary body then lowers independently, so a refusal in one body
    never hides another body's, and checked type-parameter instances follow once every body has been tried. Each
    refusal names the body it came from. The plan itself is discarded.
    """
    if len(modules) == 0 or entry < 0 or entry >= len(modules):
        return ["invalid Body IR project entry"]
    if len(sources) != len(modules) or len(files) != len(modules):
        return ["invalid Body IR project source provenance"]
    match body_refusals(modules, sources, files, entry):
        Ok(refusals) => return refusals
        Err(error) => return [error]


def body_refusals(
    modules: &list[BodyIrModule],
    sources: list[str],
    files: list[str],
    entry: int,
) -> Result[list[str], str]:
    """
    Prepare the declaration context exactly as `lower_program` does, refusing as it refuses, then lower each ordinary
    body on its own and record the first refusal of every body that refuses.
    """
    for module in modules:
        _ = validate_project_module(module, modules)?
    source_context, checked = project_context(modules, entry)?
    context = specialize_enums(specialize_nominals(source_context)?)?
    unions = collect_unions(context)
    mut intrinsics = intrinsic_declarations(context, files[entry])?
    _models = lower_model_declarations(context, files[entry], intrinsics)?
    _enums = lower_enum_declarations(context, files[entry], intrinsics)?
    mut refusals: list[str] = []
    mut functions: list[Function] = []
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    for index in range(len(checked)):
        for body in context.bodies:
            match body_module_identity(body):
                Ok(owner) =>
                    if owner != str(checked[index].module_id.path()):
                        continue
                Err(error) =>
                    refusals.append(f"{body.name}: {error}")
                    continue
            if len(body.type_parameters) != 0:
                continue
            match lower_function(context, body, unions, sources[index], files[index], intrinsics, []):
                Ok((function, runtime, pending, synthesized)) =>
                    instances.extend(pending)
                    functions.append(function)
                    functions.extend(synthesized)
                    merge_externals(externals, runtime)
                Err(error) => refusals.append(f"{body.name}: {error}")
    mut owners: list[str] = []
    for module in checked:
        owners.append(str(module.module_id.path()))
    match lower_computed_statics(context, unions, sources, files, owners, intrinsics, functions, externals, instances):
        Ok(_cells) => pass
        Err(error) => refusals.append(f"computed static: {error}")
    match lower_instances(context, instances, unions, sources, files, owners, functions, externals, intrinsics):
        Ok(_lowered) => pass
        Err(error) => refusals.append(f"type-parameter instance: {error}")
    return Ok(refusals)


pub def lower_module(module: &BodyIrModule, source: str, file: str) -> Result[Plan, str]:
    """Validate declarations first, then lower ordinary bodies and each checked type-parameter instance used by them."""
    _ = validate_module(module)?
    traits = specialize_traits(module)?
    specialized = specialize_enums(specialize_nominals(traits)?)?
    return lower_concrete_module(specialized, source, file)


def lower_concrete_module(module: &BodyIrModule, source: str, file: str) -> Result[Plan, str]:
    """Lower ordinary bodies, closed trait defaults, and the worklist of checker-selected function instances."""
    unions = collect_unions(module)
    mut intrinsics = intrinsic_declarations(module, file)?
    models = lower_model_declarations(module, file, intrinsics)?
    mut enums = lower_enum_declarations(module, file, intrinsics)?
    mut functions: list[Function] = []
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    for body in module.bodies:
        if len(body.type_parameters) != 0:
            continue
        for retained in functions:
            if retained.name == function_name(module, body):
                return Err(f"unsupported Body IR overloaded function {body.name}")
        function, runtime, pending, synthesized = lower_function(module, body, unions, source, file, intrinsics, [])?
        functions.append(function)
        append_synthesized(functions, synthesized)?
        if body.is_async and function_name(module, body) == "main":
            entry_function, entry_runtime = async_entry(function)
            functions.append(entry_function)
            merge_externals(externals, [entry_runtime])
        append_generator_constructor(functions, module, body, source, file, intrinsics)?
        merge_externals(externals, runtime)
        instances.extend(pending)
    owners = [str(module.module_id.path())]
    statics = lower_computed_statics(
        module,
        unions,
        [source],
        [file],
        owners,
        intrinsics,
        functions,
        externals,
        instances,
    )?
    _ = lower_instances(module, instances, unions, [source], [file], owners, functions, externals, intrinsics)?
    # Instances may add intrinsic declarations, so the intrinsic and future declarations join the plan last.
    for declaration in intrinsics:
        enums.append(declaration)
    for declaration in future_declarations(module, file, intrinsics)?:
        enums.append(declaration)
    return Ok(
        Plan(
            enums=enums,
            models=models,
            functions=functions,
            externals=externals,
            span=SourceSpan(file=file, line=1, column=1),
            statics=statics,
        ),
    )


def append_generator_constructor(
    mut functions: list[Function],
    module: &BodyIrModule,
    body: &RustBody,
    source: str,
    file: str,
    intrinsics: list[EnumDeclaration],
) -> Result[None, str]:
    """Retain the canonical lazy constructor beside its separately named producer in either entrypoint."""
    if not body.is_generator():
        return Ok(None)
    ty = native_source_type(
        module.nominal_declarations,
        module.enum_declarations,
        collect_unions(module),
        body.return_type,
        intrinsics,
    )?
    match generator_shape(ty):
        Some((leaf, depth)) =>
            functions.append(
                generator_constructor(
                    function_name(module, body),
                    frame_parameters(module, body, source, file, intrinsics)?,
                    leaf,
                    depth,
                    location(body.span, source, file),
                ),
            )
            return Ok(None)
        None => return Err("unsupported Body IR generator return type")


def lower_instances(
    module: &BodyIrModule,
    mut instances: list[Instance],
    unions: list[RustType],
    sources: list[str],
    files: list[str],
    owners: list[str],
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
    mut intrinsics: list[EnumDeclaration],
) -> Result[None, str]:
    """Drain checked instance requests using their original declaring module's source provenance."""
    mut completed: list[Instance] = []
    mut cursor = 0
    while cursor < len(instances):
        instance = instances[cursor]
        cursor += 1
        if instance_is_retained(instance, completed):
            continue
        body = instantiate(instance.body, instance.arguments)?
        owner = body_module_identity(body)?
        mut source_index = -1
        for index in range(len(owners)):
            if owners[index] == owner:
                source_index = index
        if source_index < 0:
            return Err("unsupported Body IR instance without source provenance")
        retain_body_carriers(module, intrinsics, body, files[source_index])?
        function, runtime, pending, synthesized = lower_function(
            module,
            body,
            unions,
            sources[source_index],
            files[source_index],
            intrinsics,
            instance.arguments,
        )?
        retain_instance(functions, function)?
        append_synthesized(functions, synthesized)?
        completed.append(instance)
        merge_externals(externals, runtime)
        instances.extend(pending)
    return Ok(None)
# =====================================================================================================================
# Module and function entry points
# =====================================================================================================================


def instance_is_retained(instance: Instance, completed: list[Instance]) -> bool:
    """Deduplicate by checked declaration identity and arguments; an emitted spelling is never execution authority."""
    for retained in completed:
        if retained.body.canonical == instance.body.canonical and retained.arguments == instance.arguments and retained.body.locals == instance.body.locals:
            return true
    return false


def retain_instance(mut functions: list[Function], function: Function) -> Result[None, str]:
    """Refuse a native instance symbol that collides with another retained source declaration."""
    for retained in functions:
        if retained.name == function.name:
            return Err(f"unsupported Body IR type parameter instance symbol collision {function.name}")
    functions.append(function)
    return Ok(None)


def append_synthesized(mut functions: list[Function], additions: list[Function]) -> Result[None, str]:
    """Add closure bodies and constructors once; two functions sharing one item's forwarding environment agree on it."""
    for addition in additions:
        mut present = false
        for retained in functions:
            if retained.name == addition.name:
                if retained != addition:
                    return Err(f"invalid Body IR synthesized function collision {addition.name}")
                present = true
        if not present:
            functions.append(addition)
    return Ok(None)


def merge_externals(mut externals: list[ExternalFunction], additions: list[ExternalFunction]) -> None:
    """Add each runtime function the plan does not declare yet; one declaration per path and generic instantiation."""
    for external in additions:
        mut found = false
        for retained in externals:
            if retained.path == external.path and retained.type_arguments == external.type_arguments:
                found = true
        if not found:
            externals.append(external)


def entry_result(module: &BodyIrModule, ty: PlanType, intrinsics: list[EnumDeclaration]) -> bool:
    """
    Report whether a native main's result is a `Result` with a unit success, which Rust's entry point reports itself.

    The error side must be text or a type an SDK crate owns: legacy's entry point reports an error through its Debug,
    which both have.
    """
    match ty:
        PlanType.Enum(owner, _name) =>
            index = owner - len(module.enum_declarations)
            if index < 0 or index >= len(intrinsics):
                return false
            declaration = intrinsics[index]
            if declaration.carrier != "Result" or len(declaration.variants) != 2:
                return false
            success = declaration.variants[0].fields
            failure = declaration.variants[1].fields
            if len(failure) != 1 or (len(success) != 0 and success != [PlanType.Unit]):
                return false
            return entry_error(module, failure[0])
        _ => return false


def entry_error(module: &BodyIrModule, ty: PlanType) -> bool:
    """Report whether an entry result's error is text or an SDK crate's model or enum."""
    match ty:
        PlanType.String => return true
        PlanType.Model(index, _name) =>
            return index < len(module.nominal_declarations) and library_item(module.nominal_declarations[index]) != ""
        PlanType.Enum(index, _name) =>
            return index < len(module.enum_declarations) and library_enum_item(module.enum_declarations[index]) != ""
        _ => return false


def lower_function(
    module: &BodyIrModule,
    body: &RustBody,
    unions: list[RustType],
    source: str,
    file: str,
    intrinsics: list[EnumDeclaration],
    type_arguments: list[RustType],
) -> Result[tuple[Function, list[ExternalFunction], list[Instance], list[Function]], str]:
    """Build a concrete frame and retain checked instance requests together with lifted closure functions."""
    span = location(body.span, source, file)
    match body.extern_delegation:
        Some(delegation) =>
            if body.is_async or body.is_generator():
                return Err("unsupported Body IR async or generator ExternDelegation")
            function, externals = delegated_function(
                evaluator_name(module, body),
                delegation.rust_path(),
                frame_parameters(module, body, source, file, intrinsics)?,
                native_source_type(
                    module.nominal_declarations,
                    module.enum_declarations,
                    unions,
                    body.return_type,
                    intrinsics,
                )?,
                span,
            )?
            return Ok((function, externals, [], []))
        None => pass
    validate_callable_representation(body)?
    declared_type = return_representation(
        body,
        native_source_type(module.nominal_declarations, module.enum_declarations, unions, body.return_type, intrinsics)?,
    )?
    return_type = producer_return_type(module, body, declared_type, intrinsics)?
    if function_name(module, body) == "main" and return_type != PlanType.Unit:
        if body.is_async or not entry_result(module, return_type, intrinsics):
            return Err("unsupported Body IR non-unit native main")
    if body.is_async and function_name(module, body) == "main" and len(body.params) != 0:
        return Err("unsupported Body IR async entry signature")
    parameters = frame_parameters(module, body, source, file, intrinsics)?
    names, bindings = body_type_bindings(module, body, type_arguments)?
    mut selected_unions = unions
    retain_body_unions(selected_unions, body)
    scoped_locals, scope_parents = frame_scopes(body)
    mut builder = Builder(
        locals=frame_locals(module, body, unions, return_type, span, source, file, intrinsics)?,
        parameter_count=len(parameters),
        blocks=[],
        current=0,
        source=source,
        file=file,
        module_identity=body_module_identity(body)?,
        loops=[],
        loop_owners=[],
        externals=[],
        owned=[],
        closed=[],
        nominals=module.nominal_declarations,
        iterators=[],
        borrowed_items=[],
        in_place_items=[],
        partial_callables=[],
        enums=module.enum_declarations,
        intrinsics=intrinsics,
        statics=module.static_declarations,
        value_enums=module.value_enum_declarations,
        local_offset=0,
        generator_handle=-1,
        unions=selected_unions,
        instances=[],
        type_parameters=names,
        type_arguments=bindings,
        function_pointer_locals=function_pointer_storage(body),
        name=evaluator_name(module, body),
        synthesized=[],
        iteration_locals=list_iterator_locals(body.block),
        scoped_locals=scoped_locals,
        scope_parents=scope_parents,
        display_functions=display_functions(module, intrinsics)?,
    )
    _ = builder.new_block(span)
    if body.is_generator():
        match generator_shape(declared_type):
            Some((leaf, depth)) =>
                handle = temporary(builder, PlanType.GeneratorYield(leaf, depth), span)
                builder.generator_handle = handle.local
                builder.owned.append(handle.local)
            None => return Err("unsupported Body IR generator return type")
    # Legacy initializes the module's computed statics on entry to each of its functions (RFC 052), in `main` before
    # it installs the panic hook.
    if enters_module_initialization(body):
        initialize_module_statics(builder, body_module_identity(body)?, span)
    # Direct MIR bypasses legacy's generated entrypoint, so request its canonical panic initialization explicitly.
    if str(body.name) == "main":
        initialized = temporary(builder, PlanType.Unit, span)
        external_call(builder, "incan_native_runtime::initialize_panic_hook", [], PlanType.Unit, [], initialized, span)
    for index in range(len(parameters)):
        if parameters[index].ty == PlanType.String or is_nominal_type(parameters[index].ty):
            builder.owned.append(index + 1)
    for index in range(len(parameters)):
        validate_exact_float(builder, plan_place(index + 1, span), span)
    if function_name(module, body) == "main":
        if len(module.entrypoint_effects) != 0 and (body.is_async or body.is_generator()):
            return Err("unsupported Body IR producer entrypoint setup effects")
        lower_entrypoint_effects(module, builder)?
    lower_block(module, builder, body.block)?
    if not builder.closed[builder.current]:
        if return_type != PlanType.Unit:
            return Err("Body IR non-unit body has no retained Return")
        builder.emit(plan_assign(plan_place(0, span), RvalueKind.Use(literal(Constant.Unit, span)), span))
        drop_all_owned(builder, span)
        builder.finish(TerminatorKind.Return, span)
    mut function = Function(
        name=evaluator_name(module, body),
        parameters=parameters,
        return_type=return_type,
        locals=builder.locals,
        blocks=builder.blocks,
        span=span,
    )
    if body.is_generator():
        match generator_shape(declared_type):
            Some((leaf, depth)) =>
                producer_frame(function, builder.generator_handle, leaf, depth)
                function.name = producer_name(function.name)
            None => return Err("unsupported Body IR generator return type")
    return Ok((function, builder.externals, builder.instances, builder.synthesized))


def lower_entrypoint_effects(module: &BodyIrModule, mut builder: Builder) -> Result[None, str]:
    """Print the entry module's retained setup before its body; project assembly does not merge dependency effects."""
    for effect in module.entrypoint_effects:
        match effect:
            RustEntrypointEffect.PrintText(text=text, span=source_span) =>
                span = location(source_span, builder.source, builder.file)
                value = owned_literal(builder, str(text), span)
                output = temporary(builder, PlanType.Unit, span)
                external_call(
                    builder,
                    "incan_native_runtime::println_text",
                    [PlanType.String],
                    PlanType.Unit,
                    [read_place(value, true, span)],
                    output,
                    span,
                )
    return Ok(None)


def producer_return_type(
    module: &BodyIrModule,
    body: &RustBody,
    declared: PlanType,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """A generator producer returns unit and holds only owned parameters; ordinary functions retain their declared result."""
    if not body.is_generator():
        return Ok(declared)
    for parameter in body.params:
        capture = frame_type(module, body.locals[int(parameter.local.index())], intrinsics)?
        if parameter_storage_type(capture, parameter.mutable) != capture:
            return Err("unsupported Body IR borrowed generator parameter")
        match capture:
            PlanType.ModelRef(_owner, _name) => return Err("unsupported Body IR borrowed generator receiver")
            PlanType.ModelMutRef(_owner, _name) => return Err("unsupported Body IR borrowed generator receiver")
            _ => pass
    return Ok(PlanType.Unit)


def frame_scopes(body: &RustBody) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    """Retain the checked scope IDs and parent links in Copy tables; a negative parent denotes the root scope."""
    mut scoped_locals: list[tuple[int, int]] = []
    for local in body.locals:
        scoped_locals.append((int(local.id.index()) + 1, int(local.scope.0)))
    mut scope_parents: list[tuple[int, int]] = []
    for scope in body.scopes:
        mut parent = -1
        match scope.parent:
            Some(enclosing) =>
                parent = int(enclosing.0)
            None => pass
        scope_parents.append((int(scope.id.0), parent))
    return (scoped_locals, scope_parents)


def frame_locals(
    module: &BodyIrModule,
    body: &RustBody,
    unions: list[RustType],
    return_type: PlanType,
    span: SourceSpan,
    source: str,
    file: str,
    intrinsics: list[EnumDeclaration],
) -> Result[list[Local], str]:
    """The frame's locals: the return slot first, then Body IR's locals in `LocalId` order."""
    iterators = list_iterator_locals(body.block)
    pairs = pair_generator_locals(body)
    mut locals = [Local(ty=return_type, span=span)]
    for local in body.locals:
        if int(local.id.index()) + 1 != len(locals):
            return Err("Body IR local order disagrees with LocalId")
        mut ty = PlanType.Unit
        match future_type(module, local.ty, intrinsics)?:
            Some(carrier) =>
                ty = carrier
            None =>
                ty = body_frame_type(module, body, local, intrinsics)?
        index = int(local.id.index()) + 1
        if index in pairs:
            ty = pair_generator_type(ty)
        if index in iterators:
            match ty:
                PlanType.FrozenCollection(_name, _elements) =>
                    ty = frozen_list_snapshot_type(ty)?
                _ => pass
            match zip_shape(ty):
                Some((left, right)) =>
                    ty = PlanType.ZipIteratorMutRef(left, right)
                None => pass
            match generator_shape(ty):
                Some((leaf, depth)) =>
                    ty = PlanType.GeneratorMutRef(leaf, depth)
                None =>
                    ty = list_parameter_type(ty, false)
        for parameter in body.params:
            if parameter.local == local.id:
                ty = parameter_storage_type(parameter_representation(body, index - 1, ty)?, parameter.mutable)
        locals.append(Local(ty=ty, span=location(local.span, source, file)))
    return Ok(locals)


def body_frame_type(
    module: &BodyIrModule,
    body: &RustBody,
    local: &RustLocalDecl,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Admit a checked frame local with its declaration and slot retained in every refusal."""
    match frame_type(module, local, intrinsics):
        Ok(ty) => return Ok(ty)
        Err(reason) => return Err(f"{reason} in {body.name} frame local {int(local.id.index())}")


def frame_parameters(
    module: &BodyIrModule,
    body: &RustBody,
    source: str,
    file: str,
    intrinsics: list[EnumDeclaration],
) -> Result[list[Parameter], str]:
    """The frame's parameters, in declaration order; mutable model and frozen text parameters are refused."""
    mut parameters: list[Parameter] = []
    for parameter in body.params:
        ty = parameter_representation(
            body,
            int(parameter.local.index()),
            body_frame_type(module, body, body.locals[int(parameter.local.index())], intrinsics)?,
        )?
        if parameter.mutable and lacks_exclusive_parameter(ty):
            return Err("unsupported Body IR mutable tuple or iterator parameter")
        if ty == PlanType.FrozenStr and parameter.mutable:
            return Err("unsupported Body IR mutable FrozenStr parameter: mutable scalar parameter representation")
        if int(parameter.local.index()) != len(parameters):
            return Err("Body IR parameter order disagrees with scalar frame")
        match parameter.default:
            CallableParamDefault.Required => pass
            _ =>
                _ = default_type(ty)?
        mut name = str(parameter.name)
        if name == "self":
            name = "__incan_self"
        parameters.append(
            Parameter(
                name=name,
                ty=parameter_storage_type(ty, parameter.mutable),
                span=location(parameter.span, source, file),
            ),
        )
    return Ok(parameters)


pub def list_borrow(mut builder: Builder, place: Place, mutable: bool, span: SourceSpan) -> Result[Operand, str]:
    """Borrow an owner or reborrow a parameter without copying a mutable reference."""
    if mutable and place.local in builder.borrowed_items:
        return Err("unsupported Body IR mutation of borrowed list iteration item")
    ty = place_type(builder.locals, place)
    if is_collection(ty):
        return borrow_collection(builder, place, mutable, span)
    leaf, depth = require_list_shape(ty, "unsupported Body IR non-list borrow")?
    mut source = place
    match ty:
        PlanType.ListRef(_leaf, _depth) =>
            if mutable:
                return Err("unsupported Body IR mutable access through shared list parameter")
            source.projection = Projection.Deref(PlanType.List(leaf, depth))
        PlanType.ListMutRef(_leaf, _depth) =>
            source.projection = Projection.Deref(PlanType.List(leaf, depth))
        _ => pass
    mut reference_type = PlanType.ListRef(leaf, depth)
    mut operation = RvalueKind.Borrow(source)
    if mutable:
        reference_type = PlanType.ListMutRef(leaf, depth)
        operation = RvalueKind.MutBorrow(source)
    reference = temporary(builder, reference_type, span)
    builder.emit(plan_assign(reference, operation, span))
    return Ok(read_place(reference, mutable, span))


def checked_list_argument(
    mut builder: Builder,
    value: &RustOperand,
    mutable: bool,
    span: SourceSpan,
) -> Result[Operand, str]:
    """
    Preserve checked exclusive-access authority before borrowing a local for an Incan parameter or method receiver.

    An exclusive borrow also takes a value the caller last uses (a list literal, a temporary) in place, since nothing
    reads it again. A copied loop variable stays refused for an exclusive borrow, because a change to it could never
    reach the iterated list.
    """
    match value:
        RustOperand.Place(read) =>
            if mutable:
                match read.place.global():
                    Some(_global) => return Err("unsupported Body IR mutable static borrow through source function")
                    None => pass
            if mutable and read.fact != OwnershipFact.MutBorrow and read.fact != OwnershipFact.Move:
                return Err("unsupported Body IR list argument without mutable borrow fact")
            # A shared parameter reads an indexed or sliced list through a copy that stays owned until its scope ends.
            if is_element_place(builder, read.place)?:
                if not mutable:
                    copied = materialized_receiver(builder, read.place, span)?
                    return list_borrow(builder, copied, false, span)
                # An exclusive argument reaches the list stored in the container, so its change lands there.
                stored = mutable_element_place(builder, read.place, span)?
                return list_borrow(builder, stored, true, span)
            root = list_root_place(builder, read.place, span)?
            return list_borrow(builder, root, mutable, span)
        RustOperand.Constant(constant) =>
            match constant:
                RustConstant.Bytes(_bytes) =>
                    if mutable:
                        return Err("unsupported Body IR mutable byte literal argument")
                    literal_place = bytes_literal(builder, constant, span)?
                    return list_borrow(builder, literal_place, false, span)
                _ => return Err("unsupported Body IR constant list argument")
        _ => return Err("unsupported Body IR constant list argument")


def cloned_list(mut builder: Builder, source: Place, span: SourceSpan) -> Result[Place, str]:
    """Copy a list into a new owned temporary, which drops when its scope ends."""
    leaf, depth = require_list_shape(place_type(builder.locals, source), "unsupported Body IR non-list borrow")?
    reference = list_borrow(builder, source, false, span)?
    output = temporary(builder, PlanType.List(leaf, depth), span)
    list_call(
        builder,
        "clone_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth)],
        PlanType.List(leaf, depth),
        [reference],
        output,
        span,
    )
    return Ok(output)


pub def value_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Materialize owned list and string values using each checked read's fact."""
    match value:
        RustOperand.Constant(constant) =>
            match constant:
                RustConstant.Bytes(_bytes) => return Ok(read_place(bytes_literal(builder, constant, span)?, true, span))
                _ => pass
            match constant.clone():
                RustConstant.Str(text) =>
                    text_place = owned_literal(builder, str(text), span)
                    return Ok(read_place(text_place, true, span))
                _ => return scalar_operand(builder, value, span)
        RustOperand.Place(read) =>
            match read.place.global():
                Some(global) => return read_static(builder, read.place, global, read.fact, span)
                None => pass
            match element_read(builder, read.place, span)?:
                Some(item) => return Ok(item)
                None => pass
            base = list_base_place(builder, read.place, span)?
            if is_collection(builder.locals[base.local].ty):
                return collection_value(builder, read, span)
            place = scalar_place(builder, read.place, span)?
            ty = place_type(builder.locals, place)
            match zip_shape(ty):
                Some(_shape) =>
                    if read.fact == OwnershipFact.Move:
                        return Ok(read_place(place, true, span))
                    if read.fact == OwnershipFact.Clone or read.fact == OwnershipFact.Borrow:
                        return clone_zip(builder, place, span)
                    return Err("unsupported Body IR zip value ownership")
                None => pass
            match list_shape(ty):
                Some((leaf, depth)) =>
                    if read.fact == OwnershipFact.Move and ty == PlanType.List(leaf, depth):
                        return Ok(read_place(place, true, span))
                    # A list parameter is a view of the caller's list, so moving it out hands over a copy, which is the
                    # value legacy's by-value parameter would carry.
                    shared = read.fact == OwnershipFact.Move and ty == PlanType.ListRef(leaf, depth)
                    if read.fact != OwnershipFact.Clone and read.fact != OwnershipFact.Borrow and not shared:
                        return Err("unsupported Body IR list value ownership")
                    return Ok(read_place(cloned_list(builder, place, span)?, true, span))
                None => pass
            if ty == PlanType.String:
                if read.fact == OwnershipFact.Move:
                    return Ok(read_place(place, true, span))
                if read.fact == OwnershipFact.Clone or read.fact == OwnershipFact.Borrow:
                    text_place = clone_text(builder, place, span)?
                    return Ok(read_place(text_place, true, span))
                return Err("unsupported Body IR string list element ownership")
            return scalar_operand(builder, value, span)


def element_read(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Option[Operand], str]:
    """Materialize a list or dictionary element as a copy that leaves its container whole; `None` for other places."""
    match source.local_id():
        Some(local) =>
            root = plan_place(int(local.index()) + 1 + builder.local_offset, span)
            match place_type(builder.locals, root):
                PlanType.FrozenCollection(_name, _elements) =>
                    if len(source.projection) != 0:
                        return Ok(Some(projected_element_read(builder, source, root, 0, span)?))
                _ => pass
        None => pass
    match model_list_read(builder, source, span)?:
        Some(item) => return Ok(Some(item))
        None => pass
    if not is_element_place(builder, source)?:
        return Ok(None)
    base = list_base_place(builder, source, span)?
    if is_collection(builder.locals[base.local].ty):
        return Ok(Some(dictionary_index_read(builder, source, span)?))
    return Ok(Some(indexed_read(builder, source, span)?))


def indexed_read(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Operand, str]:
    """Use the retained list projection and legacy negative-index error behavior; a final slice copies a new list."""
    if len(source.projection) == 0:
        return Err("unsupported Body IR list read without index")
    container = list_base_place(builder, source, span)?
    return projected_element_read(builder, source, container, 0, span)


pub def projected_element_read(
    mut builder: Builder,
    source: &RustPlace,
    container: Place,
    start: int,
    span: SourceSpan,
) -> Result[Operand, str]:
    """
    Copy the value the indexes, slices and element fields after `start` steps select out of `container`.

    Each index clones its element, or the value its key selects in a dictionary, and each slice copies a new list, so
    the container stays whole; a field of a copied element is read from that copy.
    """
    mut place = container
    for slot in range(start, len(source.projection)):
        match source.projection[slot]:
            PlaceElem.Slice(start=_start, end=_end, step=_step) =>
                place = read_list_slice(builder, place, source.projection[slot], span)?
            PlaceElem.Field(name=_name, canonical=_canonical, structural=_structural) =>
                place = read_element_field(builder, place, source.projection[slot], span)?
            PlaceElem.OptionPayload(option_type=_container, payload_type=_payload) =>
                place = read_element_field(builder, place, source.projection[slot], span)?
            PlaceElem.UnionMember(ty=_member) =>
                place = read_element_field(builder, place, source.projection[slot], span)?
            _ =>
                place = read_indexed_element(builder, place, source, slot, span)?
    ty = place_type(builder.locals, place)
    owned = ty == PlanType.String or is_owned_list(ty) or is_nominal_type(ty) or is_owned_collection(ty)
    return Ok(read_place(place, owned, span))


def read_indexed_element(
    mut builder: Builder,
    place: Place,
    source: &RustPlace,
    slot: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Read a checked tuple field, frozen item, or cloned collection element from the place earlier steps reached."""
    if is_tuple_type(place_type(builder.locals, place)):
        return read_element_field(builder, place, source.projection[slot], span)
    match place_type(builder.locals, place):
        PlanType.FrozenCollection(name, _elements) =>
            if name == "FrozenDict":
                return frozen_dictionary_element(builder, place, source, slot, span)
            snapshot = frozen_list_snapshot(builder, read_place(place, false, span), span)?
            argument = list_index_operand(builder, source, slot, span)?
            return read_list_element(builder, snapshot, argument, span)
        _ => pass
    if is_collection(place_type(builder.locals, place)):
        return read_dictionary_element(builder, place, source, slot, span)
    argument = list_index_operand(builder, source, slot, span)?
    return read_list_element(builder, place, argument, span)


pub def read_list_element(
    mut builder: Builder,
    place: Place,
    argument: Operand,
    span: SourceSpan,
) -> Result[Place, str]:
    """Clone a projected element instead of moving caller or container-owned storage."""
    leaf, depth = require_list_shape(place_type(builder.locals, place), "unsupported Body IR indexing non-list")?
    reference = list_borrow(builder, place, false, span)?
    element = list_element(leaf, depth)
    output = temporary(builder, element, span)
    list_call(
        builder,
        "get_list",
        element,
        [PlanType.ListRef(leaf, depth), PlanType.Int],
        element,
        [reference, argument],
        output,
        span,
    )
    return Ok(output)


def read_list_slice(mut builder: Builder, place: Place, projection: &PlaceElem, span: SourceSpan) -> Result[Place, str]:
    """Copy the selected elements into a new owned list through legacy's Python-style slice helper."""
    leaf, depth = require_list_shape(place_type(builder.locals, place), "unsupported Body IR slicing non-list")?
    mut bounds: list[Operand] = []
    # Each component travels with its presence, so an omitted bound or step keeps the slice default.
    match projection:
        PlaceElem.Slice(start=start, end=end, step=step) =>
            match start:
                Some(value) => bounds.extend(slice_bound(builder, value, span)?)
                None => bounds.extend(absent_slice_bound(span))
            match end:
                Some(value) => bounds.extend(slice_bound(builder, value, span)?)
                None => bounds.extend(absent_slice_bound(span))
            match step:
                Some(value) => bounds.extend(slice_bound(builder, value, span)?)
                None => bounds.extend(absent_slice_bound(span))
        _ => return Err("unsupported Body IR list slice or field projection")
    reference = list_borrow(builder, place, false, span)?
    output = temporary(builder, PlanType.List(leaf, depth), span)
    mut operands = [reference]
    operands.extend(bounds)
    list_call(
        builder,
        "slice_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth), PlanType.Bool, PlanType.Int, PlanType.Bool, PlanType.Int, PlanType.Bool, PlanType.Int],
        PlanType.List(leaf, depth),
        operands,
        output,
        span,
    )
    return Ok(output)


def read_element_field(
    mut builder: Builder,
    place: Place,
    projection: &PlaceElem,
    span: SourceSpan,
) -> Result[Place, str]:
    """Read one field of a model element already copied out of a list, copying scalars and cloning owned values."""
    selected = field_projection(
        builder.nominals,
        place_type(builder.locals, place),
        projection,
        builder.enums,
        builder.unions,
        builder.intrinsics,
    )?
    field = appended_field(place, selected, span)?
    ty = selected.ty
    if ty == PlanType.String:
        return clone_text(builder, field, span)
    if is_nominal_type(ty):
        match clone_nominal_operand(builder, field, span)?.kind:
            OperandKind.Move(cloned) => return Ok(cloned)
            _ => return Err("invalid Body IR cloned list element field")
    if is_owned_list(ty):
        leaf, depth = require_list_shape(ty, "invalid Body IR list element field")?
        reference = list_borrow(builder, field, false, span)?
        output = temporary(builder, ty, span)
        list_call(
            builder,
            "clone_list",
            list_element(leaf, depth),
            [PlanType.ListRef(leaf, depth)],
            ty,
            [reference],
            output,
            span,
        )
        return Ok(output)
    if not numeric_carrier(ty) and ty != PlanType.Bool:
        return Err("unsupported Body IR list element field type")
    output = temporary(builder, ty, span)
    builder.emit(plan_assign(output, RvalueKind.Use(read_place(field, false, span)), span))
    return Ok(output)


def slice_bound(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[list[Operand], str]:
    """Pass a written slice bound or step as a present int component, presence flag first as `slice_list` takes it."""
    operand = scalar_operand(builder, value, span)?
    if operand_type(builder, operand)? != PlanType.Int:
        return Err("unsupported Body IR non-int list slice component")
    return Ok([literal(Constant.Bool(true), span), operand])


def absent_slice_bound(span: SourceSpan) -> list[Operand]:
    """Mark an omitted slice bound or step absent, as legacy passes `None` for it."""
    return [literal(Constant.Bool(false), span), literal(Constant.Int(0), span)]


def list_base_place(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Map a frame root or materialize a primitive static list's current owned snapshot."""
    match source.global():
        Some(global) =>
            root = RustPlace.from_global(global.clone())
            operand = read_static(builder, root, global, OwnershipFact.Borrow, span)?
            match operand.kind:
                OperandKind.Move(place) => return Ok(place)
                _ => return Err("unsupported Body IR non-list global receiver")
        None => pass
    match source.local_id():
        Some(local) => return Ok(plan_place(int(local.index()) + 1 + builder.local_offset, span))
        None => return Err("unsupported Body IR global list place")


def list_index_operand(mut builder: Builder, source: &RustPlace, slot: int, span: SourceSpan) -> Result[Operand, str]:
    """Read one retained index after the caller has checked the projection count."""
    match source.projection[slot]:
        PlaceElem.Index(index) => return scalar_operand(builder, index, span)
        _ => return Err("unsupported Body IR list slice or field projection")


def list_assignment(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Construct list literals or transfer checked list values, dropping an initialized destination first."""
    if destination.projection != Projection.Whole:
        replacement = temporary(builder, place_type(builder.locals, destination), span)
        _ = list_assignment(builder, replacement, value, span)?
        replace_owned_destination(builder, destination, RvalueKind.Use(read_place(replacement, true, span)), span)
        return Ok(None)
    leaf, depth = require_list_shape(builder.locals[destination.local].ty, "unsupported Body IR non-list assignment")?
    ty = PlanType.List(leaf, depth)
    if builder.locals[destination.local].ty != ty:
        return Err("unsupported Body IR whole borrowed list assignment")
    element = list_element(leaf, depth)
    output = temporary(builder, ty, span)
    match value:
        RustRvalue.Aggregate(kind, elements) =>
            if kind != RustAggregateKind.List:
                return Err("unsupported Body IR non-list Aggregate")
            list_call(builder, "empty_list", element, [], ty, [], output, span)
            for item in elements:
                match item.as_one():
                    Some(value) =>
                        argument = element_operand(builder, value, element, span)?
                        if operand_type(builder, argument)? != element:
                            return Err(
                                f"unsupported Body IR list element coercion from {operand_type(builder, argument)?:?} to {element:?}",
                            )
                        append_list_value(builder, output, argument, leaf, depth, span)?
                    None => splice_list_spread(builder, output, item, leaf, depth, span)?
        RustRvalue.Use(value) =>
            argument = value_operand(builder, value, span)?
            # The checker types a builtin range call as a list, but its value is a lazy range only iteration consumes.
            if operand_type(builder, argument)? != ty:
                return Err("unsupported Body IR list assignment from a non-list value")
            match argument.kind:
                OperandKind.Move(place) => forget_owned(builder, place.local)
                _ => pass
            builder.emit(plan_assign(output, RvalueKind.Use(argument), span))
            builder.owned.append(output.local)
        _ => return Err("unsupported Body IR list assignment rvalue")
    drop_owned(builder, destination.local, span)
    forget_owned(builder, output.local)
    builder.emit(plan_assign(destination, RvalueKind.Use(read_place(output, true, span)), span))
    builder.owned.append(destination.local)
    return Ok(None)


def append_list_value(
    mut builder: Builder,
    output: Place,
    value: Operand,
    leaf: ListLeaf,
    depth: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Append one checked element to a list literal under construction."""
    element = list_element(leaf, depth)
    reference = list_borrow(builder, output, true, span)?
    unit = temporary(builder, PlanType.Unit, span)
    list_call(
        builder,
        "append_list",
        element,
        [PlanType.ListMutRef(leaf, depth), element],
        PlanType.Unit,
        [reference, value],
        unit,
        span,
    )
    return Ok(None)


def splice_list_spread(
    mut builder: Builder,
    output: Place,
    item: &RustArgumentElement,
    leaf: ListLeaf,
    depth: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Append a `*source` spread to a list literal at its written position."""
    match item:
        RustArgumentElement.Spread(spread) =>
            # A whole tuple has a fixed arity, so it splices field by field without a runtime helper.
            match tuple_spread_place(builder, spread.source, span)?:
                Some(tuple_place) => return append_tuple_fields(builder, output, tuple_place, leaf, depth, span)
                None => pass
            # A list spread's own ownership fact materializes one owner: the moved list, or a clone of a list that is
            # read again. `extend_list` copies from it and it is then dropped, as set and dictionary spreads do.
            source = value_operand(builder, spread.source, span)?
            match source.kind:
                OperandKind.Move(place) =>
                    if place.projection != Projection.Whole:
                        return Err("unsupported Body IR projected list spread owner")
                    if place_type(builder.locals, place) != PlanType.List(leaf, depth):
                        return Err("unsupported Body IR list spread source type")
                    target = list_borrow(builder, output, true, span)?
                    reference = list_borrow(builder, place, false, span)?
                    unit = temporary(builder, PlanType.Unit, span)
                    list_call(
                        builder,
                        "extend_list",
                        list_element(leaf, depth),
                        [PlanType.ListMutRef(leaf, depth), PlanType.ListRef(leaf, depth)],
                        PlanType.Unit,
                        [target, reference],
                        unit,
                        span,
                    )
                    drop_owned(builder, place.local, span)
                    return Ok(None)
                _ => return Err("unsupported Body IR list spread without owned source")
        _ => return Err("unsupported Body IR named list element")


def tuple_spread_place(builder: Builder, source: &RustOperand, span: SourceSpan) -> Result[Option[Place], str]:
    """Select a spread source that is a whole tuple local; every other source splices as a list."""
    match source:
        RustOperand.Place(read) =>
            if len(read.place.projection) != 0:
                return Ok(None)
            match read.place.global():
                Some(_global) => return Ok(None)
                None => pass
            place = scalar_place(builder, read.place, span)?
            if is_tuple_type(place_type(builder.locals, place)):
                return Ok(Some(place))
            return Ok(None)
        RustOperand.Constant(_constant) => return Ok(None)


def append_tuple_fields(
    mut builder: Builder,
    output: Place,
    source: Place,
    leaf: ListLeaf,
    depth: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Splice each tuple field in order, copying scalars and cloning text so the tuple itself stays whole."""
    element = list_element(leaf, depth)
    for field in tuple_fields(source, place_type(builder.locals, source), span)?:
        if place_type(builder.locals, field) != element:
            return Err("unsupported Body IR tuple spread element type")
        mut value = read_place(field, false, span)
        if element == PlanType.String:
            value = read_place(clone_text(builder, field, span)?, true, span)
        append_list_value(builder, output, value, leaf, depth, span)?
    return Ok(None)


def argument_place(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Require a retained single local receiver before constructing a runtime borrow."""
    if index >= len(arguments):
        return Err("invalid Body IR list call arity")
    match arguments[index].as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) => return list_root_place(builder, read.place, span)
                _ => return Err("unsupported Body IR list receiver constant")
        None => return Err("unsupported Body IR list spread argument")


def shared_receiver_place(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Like `argument_place` for a receiver read only through a shared borrow, materializing a list element first."""
    if index >= len(arguments):
        return Err("invalid Body IR list call arity")
    match arguments[index].as_one():
        Some(RustOperand.Place(read)) =>
            if is_element_place(builder, read.place)?:
                return materialized_receiver(builder, read.place, span)
        _ => pass
    return argument_place(builder, arguments, index, span)


pub def materialized_receiver(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Copy a list or dictionary element into an owned temporary that a shared receiver borrow can read."""
    match element_read(builder, source, span)?:
        Some(item) =>
            match item.kind:
                OperandKind.Move(place) => return Ok(place)
                _ => pass
        None => pass
    return Err("unsupported Body IR projected non-list receiver")


def argument_value(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Materialize exactly one retained argument, refusing a spread before executing it."""
    if index >= len(arguments):
        return Err("invalid Body IR list call arity")
    match arguments[index].as_one():
        Some(value) => return value_operand(builder, value, span)
        None => return Err("unsupported Body IR list spread argument")


def call_destination(
    mut builder: Builder,
    destination: &Option[RustPlace],
    ty: PlanType,
    span: SourceSpan,
) -> Result[Place, str]:
    """Select the checked destination or a typed temporary for a discarded call."""
    match destination:
        Some(place) => return list_root_place(builder, place, span)
        None => return Ok(temporary(builder, ty, span))


def borrowed_list_argument(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    mutable: bool,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Borrow one checked positional list argument without admitting a spread."""
    if index >= len(arguments):
        return Err("unsupported Body IR missing list argument")
    match arguments[index].as_one():
        Some(value) => return checked_list_argument(builder, value, mutable, span)
        None => return Err("unsupported Body IR list argument spread")


def lower_builtin_method(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch retained builtin registry members to text, numeric resize, or collection boundaries."""
    mut member = ""
    match target.canonical:
        Some(identity) =>
            if identity.origin != SymbolOrigin.Builtin:
                return Err("unsupported Body IR non-builtin list Method")
            member = str(identity.declaration_name)
        None => return Err("unsupported Body IR Method without canonical identity")
    # Option's checked builtin Clone selects its native carrier, not a list member with a same-named method.
    if member == "Option.clone":
        return lower_derived_clone(builder, arguments, destination, span)
    receiver_type = argument_type(builder, arguments, 0, span)?
    match receiver_type:
        PlanType.FrozenCollection(name, _elements) =>
            if member == f"{name}.len":
                return lower_list_builtin(builder, arguments, destination, span)
            if name == "FrozenDict" and member == "FrozenDict.contains_key":
                return frozen_dictionary_contains(builder, arguments, destination, false, span)
            if name == "FrozenSet" and member == "FrozenSet.contains":
                return collection_contains(builder, false, arguments, destination, span)
        _ => pass
    if receiver_type == PlanType.FrozenBytes and member == "frozenbytes.len":
        return lower_list_builtin(builder, arguments, destination, span)
    match text_method(member, receiver_type):
        Some((name, result)) => return lower_text_helper(builder, name, result, arguments, destination, span)
        None => pass
    match resize_policy(member, receiver_type):
        Some(policy) =>
            if len(arguments) != 1:
                return Err("invalid Body IR resize arity")
            match destination:
                Some(place) =>
                    output = scalar_place(builder, place, span)?
                    operand = numeric_receiver(builder, arguments, span)?
                    return emit_resize(builder, policy, receiver_type, operand, output, span)
                None => return Err("unsupported Body IR resize without checked destination")
        None => pass
    # The checker types every non-predicate float member as `float`, but an `f32` receiver's own `powf` returns `f32`.
    # Lowering either width would disagree with one of them, so the member stays refused until they agree.
    if member == "f32.powf":
        return Err("unsupported Body IR f32 powf: its checked float result differs from the carrier's f32 powf")
    match float_method(member, receiver_type):
        Some((name, parameters, result)) =>
            return lower_float_method(builder, name, parameters, result, arguments, destination, span)
        None => pass
    return lower_list_method(builder, member, arguments, destination, span)


def float_method(member: str, receiver: PlanType) -> Option[tuple[str, list[PlanType], PlanType]]:
    """Select the runtime boundary for a builtin float member; `powf` is the same `powf` legacy emits for `**`."""
    mut width = ""
    if receiver == PlanType.F32:
        width = "f32"
    elif receiver == PlanType.Float or receiver == PlanType.F64:
        width = "f64"
    else:
        return None
    if member == "f64.powf":
        return Some(("power_f64", [receiver, receiver], receiver))
    if member == f"{width}.is_finite":
        return Some((f"is_finite_{width}", [receiver], PlanType.Bool))
    if member == f"{width}.is_nan":
        return Some((f"is_nan_{width}", [receiver], PlanType.Bool))
    return None


def lower_float_method(
    mut builder: Builder,
    name: str,
    parameters: list[PlanType],
    result: PlanType,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call a float member's runtime boundary with the copied receiver and each argument at its checked carrier."""
    if len(arguments) != len(parameters):
        return Err("unsupported Body IR float Method arity")
    mut operands = [numeric_receiver(builder, arguments, span)?]
    for index in range(1, len(parameters)):
        argument = argument_value(builder, arguments, index, span)?
        operands.append(coerce_numeric_operand(builder, argument, parameters[index], span)?)
    output = call_destination(builder, destination, result, span)?
    external_call(builder, f"incan_native_runtime::{name}", parameters, result, operands, output, span)
    return Ok(None)


def numeric_receiver(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[Operand, str]:
    """Read a canonical numeric method's shared receiver without consuming its Copy storage."""
    match arguments[0].as_one():
        Some(RustOperand.Place(read)) =>
            # A list or dictionary element has no storage to copy from; its materialized value is read below.
            if read.fact == OwnershipFact.Borrow and not is_element_place(builder, read.place)?:
                place = scalar_place(builder, read.place, span)?
                if not numeric_carrier(place_type(builder.locals, place)):
                    return Err("invalid Body IR numeric receiver outside numeric storage")
                return Ok(read_place(place, false, span))
        _ => pass
    return argument_value(builder, arguments, 0, span)


def lower_generator_member(
    mut builder: Builder,
    method: str,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    receiver_ty: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Move the owned generator receiver into one runtime adapter or consumer, as legacy's member consumes its receiver.

    An adapter's result is another owned generator; a consumer drains the receiver into its checked destination.
    """
    receiver = argument_place(builder, arguments, 0, span)?
    if receiver.projection != Projection.Whole or place_type(builder.locals, receiver) != receiver_ty:
        return Err("unsupported Body IR generator member receiver")
    mut operands: list[Operand] = []
    for index in range(1, len(arguments)):
        operands.append(argument_value(builder, arguments, index, span)?)
    source = read_place(receiver, true, span)
    if is_generator_consumer(method):
        output = call_destination(builder, destination, consumer_result(method), span)?
        drop_owned(builder, output.local, span)
        return generator_consumer(builder, method, source, operands, output, span)
    output = call_destination(builder, destination, receiver_ty, span)?
    drop_owned(builder, output.local, span)
    generator_adapter(builder, method, source, operands, output, span)?
    builder.owned.append(output.local)
    return Ok(None)


def lower_list_iter(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Start a lazy iterator over a snapshot of the list, so the list stays readable, as legacy's `iter()` leaves it."""
    if len(arguments) != 1:
        return Err("invalid Body IR list iter arguments")
    leaf, depth = require_list_shape(argument_type(builder, arguments, 0, span)?, "unsupported Body IR iter on non-list")?
    element = list_element(leaf, depth)
    cell = static_collection_receiver(builder, arguments, false, span)?
    mut reference = read_place(plan_place(0, span), false, span)
    match cell:
        Some((_global, receiver)) =>
            reference = list_borrow(builder, receiver, false, span)?
        None =>
            reference = borrowed_list_argument(builder, arguments, 0, false, span)?
    snapshot = temporary(builder, PlanType.List(leaf, depth), span)
    list_call(
        builder,
        "clone_list",
        element,
        [PlanType.ListRef(leaf, depth)],
        PlanType.List(leaf, depth),
        [reference],
        snapshot,
        span,
    )
    builder.owned.append(snapshot.local)
    result = PlanType.Generator(leaf, depth - 1)
    output = call_destination(builder, destination, result, span)?
    if builder.locals[output.local].ty != result:
        return Err("unsupported Body IR list iter destination")
    drop_owned(builder, output.local, span)
    generator_runtime_call(
        builder,
        "list_generator",
        element,
        [PlanType.List(leaf, depth)],
        result,
        [read_place(snapshot, true, span)],
        output,
        span,
    )
    builder.owned.append(output.local)
    return Ok(None)


def lower_list_method(
    mut builder: Builder,
    member: str,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Admit already resolved builtin list members with exact runtime signatures."""
    receiver_ty = argument_type(builder, arguments, 0, span)?
    match generator_shape(receiver_ty):
        Some((leaf, depth)) =>
            method = iterator_method(member)
            if is_generator_adapter(method) or is_generator_consumer(method):
                return lower_generator_member(builder, method, arguments, destination, receiver_ty, span)
            if method != "collect":
                return Err(f"unsupported Body IR generator Method {member}")
            if len(arguments) != 1:
                return Err("invalid Body IR generator collect arguments")
            receiver = argument_place(builder, arguments, 0, span)?
            output = call_destination(builder, destination, PlanType.List(leaf, depth + 1), span)?
            drop_owned(builder, output.local, span)
            generator_collect(builder, receiver, output, span)?
            builder.owned.append(output.local)
            return Ok(None)
        None => pass
    if member == "List.iter":
        return lower_list_iter(builder, arguments, destination, span)
    if member == "List.contains":
        leaf, _depth = require_list_shape(receiver_ty, "unsupported Body IR List.contains receiver")?
        # Primitive leaves use the runtime's builtin PartialEq. Nominal hooks and compound equality need their own
        # parity before this method may select Rust equality in their place.
        match leaf:
            ListLeaf.Model(_owner, _name) => return Err("unsupported Body IR List.contains nominal equality")
            ListLeaf.Enum(_owner, _name) => return Err("unsupported Body IR List.contains enum equality")
            ListLeaf.FunctionPointer(_signature) => return Err("unsupported Body IR List.contains callable equality")
            ListLeaf.Tuple(_fields) => return Err("unsupported Body IR List.contains tuple equality")
            ListLeaf.List(_elements, _depth) => return Err("unsupported Body IR List.contains nested equality")
            ListLeaf.Dict(_elements) => return Err("unsupported Body IR List.contains dictionary equality")
            _ => pass
        return lower_list_helper(builder, false, arguments, destination, span)
    if is_collection(receiver_ty):
        return collection_method(builder, member, arguments, destination, span)
    leaf, depth = require_list_shape(receiver_ty, "unsupported Body IR list Method on non-list")?
    element = list_element(leaf, depth)
    mut name = ""
    mut mutable = false
    mut result = PlanType.Unit
    mut parameters: list[PlanType] = []
    match member:
        "List.append" =>
            name = "append_list"
            mutable = true
            parameters = [element]
        "List.extend" =>
            name = "extend_list"
            mutable = true
            parameters = [PlanType.ListRef(leaf, depth)]
        "List.pop" =>
            name = "pop_list"
            mutable = true
            result = element
        "List.remove" =>
            name = "remove_list"
            mutable = true
            parameters = [PlanType.Int]
        "List.swap" =>
            name = "swap_list"
            mutable = true
            parameters = [PlanType.Int, PlanType.Int]
        "List.clone" =>
            name = "clone_list"
            result = PlanType.List(leaf, depth)
        "List.contains" =>
            name = "contains_list"
            result = PlanType.Bool
            parameters = [element]
        "List.count" =>
            result = PlanType.Int
            if len(arguments) == 1:
                name = "length_list"
            else:
                name = "count_list"
                parameters = [element]
        "List.index" =>
            name = "index_list"
            result = PlanType.Int
            parameters = [element]
        _ => return Err(f"unsupported Body IR list Method {member}")
    if len(arguments) != len(parameters) + 1:
        return Err(f"unsupported Body IR list Method arity {member}")
    mut operands: list[Operand] = []
    for index in range(len(parameters)):
        if name == "extend_list":
            operands.append(borrowed_list_argument(builder, arguments, index + 1, false, span)?)
        else:
            match arguments[index + 1].as_one():
                Some(value) => operands.append(boundary_operand(builder, value, parameters[index], span)?)
                None => return Err("unsupported Body IR list method spread argument")
    cell = static_collection_receiver(builder, arguments, mutable, span)?
    mut reference = read_place(plan_place(0, span), false, span)
    match cell:
        Some((_global, receiver)) =>
            reference = list_borrow(builder, receiver, mutable, span)?
        None =>
            reference = borrowed_list_argument(builder, arguments, 0, mutable, span)?
    mut receiver_type = PlanType.ListRef(leaf, depth)
    if mutable:
        receiver_type = PlanType.ListMutRef(leaf, depth)
    output = call_destination(builder, destination, result, span)?
    mut all_parameters = [receiver_type]
    all_parameters.extend(parameters)
    mut all_operands = [reference]
    all_operands.extend(operands)
    list_call(builder, name, element, all_parameters, result, all_operands, output, span)
    if mutable:
        match cell:
            Some((global, receiver)) => persist_static_value(builder, global, receiver, span)?
            None => pass
    return Ok(None)


def static_collection_receiver(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    mutable: bool,
    span: SourceSpan,
) -> Result[Option[tuple[RustGlobalPlace, Place]], str]:
    """Read static storage after method arguments, retaining exclusive-access authority for a subsequent commit."""
    if len(arguments) == 0:
        return Err("invalid Body IR static method arity")
    match arguments[0].as_one():
        Some(RustOperand.Place(read)) => return static_place_receiver(builder, read, mutable, span)
        _ => return Ok(None)


def static_place_receiver(
    mut builder: Builder,
    read: &RustPlaceOperand,
    mutable: bool,
    span: SourceSpan,
) -> Result[Option[tuple[RustGlobalPlace, Place]], str]:
    """Materialize a checked global receiver while retaining its identity for the mutation's commit."""
    match read.place.global():
        Some(global) =>
            if len(read.place.projection) != 0:
                return Err("unsupported Body IR projected static collection method")
            if mutable and read.fact != OwnershipFact.MutBorrow:
                return Err("unsupported Body IR static collection method without mutable borrow fact")
            operand = read_static(builder, read.place, global, read.fact, span)?
            match operand.kind:
                OperandKind.Move(place) => return Ok(Some((global.clone(), place)))
                _ => return Err("unsupported Body IR noncollection static method receiver")
        None => return Ok(None)


def lower_list_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Read string, list, and hashed-collection lengths through the legacy runtime contracts."""
    if len(arguments) != 1:
        return Err("unsupported Body IR len arity")
    # An indexed nested list, such as `len(rows[1])`, is measured through the copy a shared list argument reads.
    if indexes_nested_list(builder, arguments):
        element = borrowed_list_argument(builder, arguments, 0, false, span)?
        return list_length(builder, element, destination, span)
    ty = argument_type(builder, arguments, 0, span)?
    match ty:
        PlanType.FrozenCollection(name, elements) =>
            value = argument_value(builder, arguments, 0, span)?
            output = call_destination(builder, destination, PlanType.Int, span)?
            mut path = "incan_native_runtime::frozen_list_length"
            if name == "FrozenSet":
                path = "incan_native_runtime::frozen_set_length"
            elif name == "FrozenDict":
                path = "incan_native_runtime::frozen_dict_length"
            return instantiated_external_call(builder, path, elements, [ty], PlanType.Int, [value], output, span)
        _ => pass
    if ty == PlanType.FrozenBytes:
        match arguments[0].as_one():
            None => return Err("unsupported Body IR spread FrozenBytes length")
            Some(value) =>
                operand = scalar_operand(builder, value, span)?
                mut output = temporary(builder, PlanType.Int, span)
                match destination:
                    Some(place) =>
                        output = scalar_place(builder, place, span)?
                    None => pass
                external_call(
                    builder,
                    "incan_native_runtime::length_frozen_bytes",
                    [PlanType.FrozenBytes],
                    PlanType.Int,
                    [operand],
                    output,
                    span,
                )
                return Ok(None)
    if ty in [PlanType.String, PlanType.StringRef, PlanType.FrozenStr]:
        return lower_text_helper(builder, "length_text", PlanType.Int, arguments, destination, span)
    receiver = shared_receiver_place(builder, arguments, 0, span)?
    if is_collection(place_type(builder.locals, receiver)):
        return collection_length(builder, receiver, destination, span)
    _ = require_list_shape(place_type(builder.locals, receiver), "unsupported Body IR len on non-list")?
    reference = list_borrow(builder, receiver, false, span)?
    return list_length(builder, reference, destination, span)


def indexes_nested_list(builder: Builder, arguments: &list[RustArgumentElement]) -> bool:
    """Recognize one index into a local list of lists, such as `rows[1]`."""
    match arguments[0].as_one():
        Some(RustOperand.Place(read)) =>
            if len(read.place.projection) != 1:
                return false
            match read.place.projection[0]:
                PlaceElem.Index(_index) => pass
                _ => return false
            match read.place.local_id():
                Some(local) =>
                    slot = int(local.index()) + 1 + builder.local_offset
                    match list_shape(builder.locals[slot].ty):
                        Some((_leaf, depth)) => return depth > 1
                        None => return false
                None => return false
        _ => return false


def list_length(
    mut builder: Builder,
    reference: Operand,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Read a borrowed list's length through the runtime."""
    leaf, depth = require_list_shape(operand_type(builder, reference)?, "unsupported Body IR len on non-list")?
    output = call_destination(builder, destination, PlanType.Int, span)?
    list_call(
        builder,
        "length_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth)],
        PlanType.Int,
        [reference],
        output,
        span,
    )
    return Ok(None)


def lower_list_helper(
    mut builder: Builder,
    negated: bool,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Keep Body IR's haystack-first membership argument order and explicit negation."""
    if len(arguments) != 2:
        return Err("unsupported Body IR list membership arity")
    receiver = membership_receiver(builder, arguments, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, receiver), "unsupported Body IR membership on non-list")?
    argument = argument_value(builder, arguments, 1, span)?
    reference = list_borrow(builder, receiver, false, span)?
    output = call_destination(builder, destination, PlanType.Bool, span)?
    list_call(
        builder,
        "contains_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth), list_element(leaf, depth)],
        PlanType.Bool,
        [reference, argument],
        output,
        span,
    )
    if negated:
        builder.emit(plan_assign(output, RvalueKind.Unary(UnaryOp.Not, read_place(output, false, span)), span))
    return Ok(None)


def indexed_assignment(
    mut builder: Builder,
    destination: &RustPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Write one checked list element through the legacy mutable indexing helper."""
    return indexed_assignment_at(builder, destination, 0, value, span)


def indexed_assignment_at(
    mut builder: Builder,
    destination: &RustPlace,
    start: int,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Write one checked list element whose list is reached after `start` structural steps (zero for a bare list)."""
    if len(destination.projection) <= start:
        return Err("unsupported Body IR list assignment without index")
    # Materialize the replacement before borrowing storage that its value might itself read.
    mut argument = assignment_value(builder, value, span)?
    mut receiver = list_base_place(builder, destination, span)?
    if start > 0:
        receiver = prefix_place(builder, destination, start, span)?
    for slot in range(start, len(destination.projection) - 1):
        index = list_index_operand(builder, destination, slot, span)?
        receiver = borrow_element_mut(builder, receiver, index, span)?
    leaf, depth = require_list_shape(
        place_type(builder.locals, receiver),
        "unsupported Body IR indexed assignment on non-list",
    )?
    element = list_element(leaf, depth)
    match value:
        RustRvalue.Use(RustOperand.Constant(RustConstant.None)) =>
            argument = none_operand(builder, element, span)?
        _ =>
            argument = element_plan_operand(builder, argument, element, span)?
    subscript = list_index_operand(builder, destination, len(destination.projection) - 1, span)?
    reference = list_borrow(builder, receiver, true, span)?
    unit = temporary(builder, PlanType.Unit, span)
    list_call(
        builder,
        "set_list",
        element,
        [PlanType.ListMutRef(leaf, depth), PlanType.Int, element],
        PlanType.Unit,
        [reference, subscript, argument],
        unit,
        span,
    )
    return Ok(None)


def assignment_value(mut builder: Builder, value: &RustRvalue, span: SourceSpan) -> Result[Operand, str]:
    """Materialize the checked single value before borrowing its indexing destination mutably."""
    match value:
        RustRvalue.Use(operand) => return value_operand(builder, operand, span)
        _ => return Err("unsupported Body IR indexed assignment rvalue")


def operand_list_place(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Require the checked bare list root before preparing an iterator or receiver borrow."""
    match value:
        RustOperand.Place(read) => return list_root_place(builder, read.place, span)
        _ => return Err("unsupported Body IR constant list place")


def borrow_iteration_item(mut builder: Builder, local: int) -> None:
    """Refuse later changes to an iteration item that is only a snapshot of storage the source program changes."""
    if local not in builder.borrowed_items:
        builder.borrowed_items.append(local)


def pair_holds_list(ty: PlanType) -> bool:
    """Report whether a polled pair carries a list, directly or in a nested tuple."""
    match ty:
        PlanType.Tuple(elements) =>
            for element in elements:
                if pair_holds_list(tuple_element_type(element)):
                    return true
            return false
        _ => return is_list(ty)


def inherit_borrowed_item(mut builder: Builder, target: Place, value: &RustRvalue) -> None:
    """A list bound out of a snapshot iteration item is part of that snapshot, so it stays unchangeable too."""
    if target.projection != Projection.Whole or not is_list(place_type(builder.locals, target)):
        return
    match value:
        RustRvalue.Use(operand) =>
            match operand:
                RustOperand.Place(read) =>
                    if len(read.place.projection) == 0:
                        return
                    match read.place.local_id():
                        Some(local) =>
                            root = int(local.index()) + 1 + builder.local_offset
                            if root in builder.borrowed_items:
                                borrow_iteration_item(builder, target.local)
                        None => pass
                _ => pass
        _ => pass


def initialize_text_iterator(
    mut builder: Builder,
    target: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Materialize a text iterable's characters once, before its loop, as the one-character strings legacy's loop draws.

    The checked iterator slot then holds that list and is polled through the ordinary list cursor.
    """
    match value:
        RustRvalue.Use(operand) =>
            reference = borrow_text_operand(builder, operand, span)?
            items = PlanType.List(ListLeaf.Str, 1)
            builder.locals[target.local].ty = items
            external_call(
                builder,
                "incan_native_runtime::text_items",
                [PlanType.StringRef],
                items,
                [reference],
                target,
                span,
            )
            builder.owned.append(target.local)
            cursor = temporary(builder, PlanType.Int, span)
            builder.emit(plan_assign(cursor, RvalueKind.Use(literal(Constant.Int(0), span)), span))
            builder.iterators.append((target.local, cursor.local))
            return Ok(None)
        _ => return Err("unsupported Body IR text iterator initialization")


def membership_receiver(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[Place, str]:
    """Read immutable frozen membership through an owned primitive snapshot; ordinary collections retain their root."""
    match argument_type(builder, arguments, 0, span)?:
        PlanType.FrozenCollection(_name, _elements) =>
            value = argument_value(builder, arguments, 0, span)?
            return frozen_list_snapshot(builder, value, span)
        _ => return argument_place(builder, arguments, 0, span)


def frozen_dictionary_element(
    mut builder: Builder,
    receiver: Place,
    source: &RustPlace,
    slot: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Read one baked dictionary value using its retained storage arguments, then apply legacy's owned read conversion."""
    ty = place_type(builder.locals, receiver)
    match ty:
        PlanType.FrozenCollection(name, elements) =>
            if name != "FrozenDict" or len(elements) != 2:
                return Err("unsupported Body IR frozen dictionary shape")
            match source.projection[slot]:
                PlaceElem.Index(value) =>
                    key = frozen_dictionary_key(builder, elements[0], value, span)?
                    return frozen_dictionary_value(builder, receiver, elements, key, span)
                _ => return Err("unsupported Body IR frozen dictionary nonindex projection")
        _ => return Err("unsupported Body IR nonfrozen dictionary read")


def frozen_dictionary_value(
    mut builder: Builder,
    receiver: Place,
    elements: list[PlanType],
    probe: tuple[Operand, PlanType, bool],
    span: SourceSpan,
) -> Result[Place, str]:
    """Convert only the selected stored value to its source read representation; other entries stay untouched."""
    ty = place_type(builder.locals, receiver)
    key, key_type, text = probe
    mut path = "incan_native_runtime::frozen_dict_get"
    if text:
        path = "incan_native_runtime::frozen_dict_text_get"
    raw = temporary(builder, elements[1], span)
    instantiated_external_call(
        builder,
        path,
        elements,
        [ty, key_type],
        elements[1],
        [read_place(receiver, false, span), key],
        raw,
        span,
    )?
    if elements[1] == PlanType.StaticText:
        return runtime_text(builder, "incan_native_runtime::display_value", read_place(raw, false, span), span)
    if elements[1] == PlanType.StaticBytes:
        output = temporary(builder, PlanType.List(ListLeaf.U8, 1), span)
        instantiated_external_call(
            builder,
            "incan_native_runtime::own_static_bytes",
            [PlanType.StaticBytes],
            [PlanType.StaticBytes],
            PlanType.List(ListLeaf.U8, 1),
            [read_place(raw, false, span)],
            output,
            span,
        )?
        builder.owned.append(output.local)
        return Ok(output)
    match elements[1]:
        PlanType.FrozenCollection(_kind, _arguments) => return Ok(raw)
        PlanType.Int => return Ok(raw)
        PlanType.Bool => return Ok(raw)
        PlanType.FrozenStr => return Ok(raw)
        _ => return Err("unsupported Body IR frozen dictionary value read")


def frozen_dictionary_key(
    mut builder: Builder,
    storage: PlanType,
    value: &RustOperand,
    span: SourceSpan,
) -> Result[tuple[Operand, PlanType, bool], str]:
    """Use text probes for static text/FrozenStr keys and exact scalar probes for the admitted numeric keys."""
    if storage in [PlanType.StaticText, PlanType.FrozenStr]:
        key = borrow_text_operand(builder, value, span)?
        return Ok((key, PlanType.StringRef, true))
    if storage not in [PlanType.Int, PlanType.Bool]:
        return Err("unsupported Body IR frozen dictionary key storage")
    key = value_operand(builder, value, span)?
    if operand_type(builder, key)? != storage:
        return Err("unsupported Body IR frozen dictionary key type")
    return Ok((key, storage, false))


def frozen_dictionary_contains(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    negated: bool,
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve linear frozen-key membership without reading or cloning values."""
    if len(arguments) != 2:
        return Err("unsupported Body IR frozen dictionary membership arity")
    ty = argument_type(builder, arguments, 0, span)?
    match ty:
        PlanType.FrozenCollection(name, elements) =>
            if name != "FrozenDict" or len(elements) != 2:
                return Err("unsupported Body IR frozen dictionary membership shape")
            match arguments[1].as_one():
                Some(value) =>
                    key, key_type, text = frozen_dictionary_key(builder, elements[0], value, span)?
                    mut path = "incan_native_runtime::frozen_dict_contains"
                    if text:
                        path = "incan_native_runtime::frozen_dict_text_contains"
                    receiver = argument_value(builder, arguments, 0, span)?
                    output = call_destination(builder, destination, PlanType.Bool, span)?
                    instantiated_external_call(
                        builder,
                        path,
                        elements,
                        [ty, key_type],
                        PlanType.Bool,
                        [receiver, key],
                        output,
                        span,
                    )?
                    if negated:
                        builder.emit(
                            plan_assign(output, RvalueKind.Unary(UnaryOp.Not, read_place(output, false, span)), span),
                        )
                    return Ok(None)
                None => return Err("unsupported Body IR spread frozen dictionary membership")
        _ => return Err("unsupported Body IR nonfrozen dictionary membership")


def frozen_list_snapshot_type(ty: PlanType) -> Result[PlanType, str]:
    """Keep the owned read type distinct from frozen storage: static text becomes String at the read boundary."""
    match ty:
        PlanType.FrozenCollection(name, elements) =>
            if name not in ["FrozenList", "FrozenSet", "FrozenDict"] or len(elements) == 0:
                return Err("unsupported Body IR frozen collection snapshot")
            if elements[0] == PlanType.StaticText:
                return Ok(PlanType.List(ListLeaf.Str, 1))
            if elements[0] == PlanType.StaticBytes:
                if name != "FrozenList":
                    return Err("unsupported Body IR frozen byte set or dictionary snapshot")
                return Ok(PlanType.List(ListLeaf.U8, 2))
            if elements[0] not in [PlanType.Int, PlanType.Float, PlanType.Bool, PlanType.FrozenStr, PlanType.FrozenBytes]:
                return Err("unsupported Body IR frozen collection snapshot with nonprimitive elements")
            return Ok(PlanType.List(collection_leaf(elements[0])?, 1))
        _ => return Err("unsupported Body IR nonfrozen snapshot")


def frozen_list_snapshot(mut builder: Builder, value: Operand, span: SourceSpan) -> Result[Place, str]:
    """Materialize an ordered owned snapshot through the runtime, leaving immutable static storage unchanged."""
    ty = operand_type(builder, value)?
    snapshot = frozen_list_snapshot_type(ty)?
    match ty:
        PlanType.FrozenCollection(name, elements) =>
            mut path = "incan_native_runtime::frozen_list_items"
            if name == "FrozenSet":
                path = "incan_native_runtime::frozen_set_items"
            elif name == "FrozenDict":
                path = "incan_native_runtime::frozen_dict_keys"
            if elements[0] == PlanType.StaticText:
                path = "incan_native_runtime::frozen_list_text_items"
                if name == "FrozenSet":
                    path = "incan_native_runtime::frozen_set_text_items"
                elif name == "FrozenDict":
                    path = "incan_native_runtime::frozen_dict_text_keys"
            elif elements[0] == PlanType.StaticBytes:
                path = "incan_native_runtime::frozen_list_byte_items"
            output = temporary(builder, snapshot, span)
            instantiated_external_call(builder, path, elements, [ty], snapshot, [value], output, span)?
            builder.owned.append(output.local)
            return Ok(output)
        _ => return Err("unsupported Body IR nonfrozen snapshot")


def frozen_set_source(mut builder: Builder, source: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Convert a checked frozen set-constructor source into an owned primitive snapshot without consuming static data."""
    value = value_operand(builder, source, span)?
    match operand_type(builder, value)?:
        PlanType.FrozenCollection(_name, _elements) =>
            snapshot = frozen_list_snapshot(builder, value, span)?
            return Ok(read_place(snapshot, true, span))
        _ => return Ok(value)


def initialize_frozen_iterator(mut builder: Builder, iterator: Place, span: SourceSpan) -> None:
    """Start a fresh cursor for a constant's immutable snapshot without inventing a mutable source place."""
    cursor = temporary(builder, PlanType.Int, span)
    builder.emit(plan_assign(cursor, RvalueKind.Use(literal(Constant.Int(0), span)), span))
    builder.iterators.append((iterator.local, cursor.local))


def initialize_list_iterator(mut builder: Builder, iterator: Place, source: &RustOperand, span: SourceSpan) -> None:
    """Retain cursor storage for Body IR's borrowed builtin iterable materialization, shared or exclusive."""
    match source:
        RustOperand.Place(read) =>
            if read.fact == OwnershipFact.Borrow or read.fact == OwnershipFact.MutBorrow:
                cursor = temporary(builder, PlanType.Int, span)
                zero = Operand(kind=OperandKind.Literal(Constant.Int(0)), span=span)
                builder.emit(plan_assign(cursor, RvalueKind.Use(zero), span))
                builder.iterators.append((iterator.local, cursor.local))
        _ => pass


def list_next(
    mut builder: Builder,
    destination: &RustPlace,
    iterator: &RustOperand,
    protocol: &IterProtocol,
    span: SourceSpan,
) -> Result[None, str]:
    """Poll a retained builtin collection cursor, branching to the loop exit on exhaustion."""
    if not is_builtin_iteration(protocol) or len(builder.loops) == 0:
        return Err("unsupported Body IR non-builtin list IterNext")
    receiver = operand_list_place(builder, iterator, span)?
    match zip_shape(place_type(builder.locals, receiver)):
        Some(_shape) =>
            target = list_root_place(builder, destination, span)?
            zip_next(builder, receiver, target, span)?
            # Legacy changes a zipped operand's list items in place; a pair here holds only snapshots of them.
            if pair_holds_list(place_type(builder.locals, target)):
                borrow_iteration_item(builder, target.local)
            return Ok(None)
        None => pass
    match generator_shape(place_type(builder.locals, receiver)):
        Some(_shape) =>
            target = list_root_place(builder, destination, span)?
            return generator_next(builder, receiver, target, span)
        None => pass
    ty = place_type(builder.locals, receiver)
    mut element = PlanType.Unit
    match list_shape(ty):
        Some((leaf, depth)) =>
            element = list_element(leaf, depth)
        None =>
            arguments = collection_arguments(ty)
            if len(arguments) == 0:
                return Err("unsupported Body IR noncollection IterNext")
            element = arguments[0]
    mut cursor = -1
    for index in range(len(builder.iterators)):
        if builder.iterators[index][0] == receiver.local:
            cursor = builder.iterators[index][1]
    if cursor < 0:
        return Err("unsupported Body IR list iterator without retained materialization")
    reference = list_borrow(builder, receiver, false, span)?
    length = temporary(builder, PlanType.Int, span)
    iterable_call(builder, ty, "length", [], PlanType.Int, [reference], length, span)?
    condition = temporary(builder, PlanType.Bool, span)
    position = read_place(plan_place(cursor, span), false, span)
    builder.emit(
        plan_assign(condition, RvalueKind.Binary(BinaryOp.Less, position, read_place(length, false, span)), span),
    )
    next_block = builder.new_block(span)
    exhausted = builder.new_block(span)
    owners = builder.owned
    builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), exhausted, next_block), span)
    builder.current = exhausted
    drop_loop_owners(builder, span)?
    builder.finish(TerminatorKind.Goto(builder.loops[-1][1]), span)
    builder.current = next_block
    builder.owned = owners
    target = list_root_place(builder, destination, span)?
    if is_list(place_type(builder.locals, receiver)) and is_mutable_list_reference(place_type(builder.locals, receiver)):
        in_place_item(builder, receiver, target, element, position, span)?
    else:
        item_reference = list_borrow(builder, receiver, false, span)?
        drop_owned(builder, target.local, span)
        if element == PlanType.String or is_list(element) or is_nominal_type(element):
            borrow_iteration_item(builder, target.local)
        # A bytes value's items are unsigned bytes, which legacy's loop widens to the checked `int` item.
        widened = element == PlanType.U8 and place_type(builder.locals, target) == PlanType.Int
        mut item = target
        if widened:
            item = temporary(builder, PlanType.U8, span)
        iterable_call(builder, ty, "nth", [PlanType.Int], element, [item_reference, position], item, span)?
        if owned_carrier(element) or element == PlanType.String or is_owned_collection(element) or tuple_has_owners(
            element,
        ):
            builder.owned.append(item.local)
        if widened:
            byte = read_place(item, false, span)
            builder.emit(plan_assign(target, RvalueKind.NumericCast(byte, PlanType.U8, PlanType.Int), span))
    # The cursor cannot overflow: a successful poll is bounded by the native collection length.
    pair = temporary(builder, PlanType.CheckedInt, span)
    one = Operand(kind=OperandKind.Literal(Constant.Int(1)), span=span)
    builder.emit(plan_assign(pair, RvalueKind.Binary(BinaryOp.Add, position, one), span))
    result = Place(local=pair.local, projection=Projection.Value, span=span)
    builder.emit(plan_assign(plan_place(cursor, span), RvalueKind.Use(read_place(result, false, span)), span))
    return Ok(None)


def in_place_item(
    mut builder: Builder,
    iterator: Place,
    item: Place,
    element: PlanType,
    position: Operand,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Bind a loop item that the body changes in place as an exclusive reference to its element, as legacy's `iter_mut`.

    The element is reborrowed through the runtime's checked `borrow_list_mut` at the cursor position, so each change
    lands in the list. Tuples keep their complete layout behind that reference; scalar elements remain refused.
    """
    leaf, depth = require_list_shape(place_type(builder.locals, iterator), "unsupported Body IR nonlist cursor")?
    mut reference_type = PlanType.Unit
    match exclusive_reference(element):
        Some(reference) =>
            reference_type = reference
        None => return Err("unsupported Body IR in-place iteration over tuple or scalar elements")
    builder.locals[item.local].ty = reference_type
    if item.local not in builder.in_place_items:
        builder.in_place_items.append(item.local)
    exclusive_list = list_borrow(builder, iterator, true, span)?
    list_call(
        builder,
        "borrow_list_mut",
        element,
        [PlanType.ListMutRef(leaf, depth), PlanType.Int],
        reference_type,
        [exclusive_list, position],
        item,
        span,
    )
    return Ok(None)


def iterator_assignment(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Materialize the explicit builtin iterator's live list view and initialize its cursor once.

    The view is shared, unless the loop changes its items in place: then Body IR borrows the list exclusively and each
    item becomes an exclusive reference to its element (see `in_place_item`).
    """
    match value:
        RustRvalue.Use(value) =>
            match value:
                RustOperand.Constant(constant) =>
                    match constant:
                        RustConstant.FrozenAggregate(_ty, _elements) =>
                            frozen = frozen_collection_literal(builder, constant, span)?
                            snapshot = frozen_list_snapshot(builder, frozen, span)?
                            reference = list_borrow(builder, snapshot, false, span)?
                            builder.emit(plan_assign(destination, RvalueKind.Use(reference), span))
                            initialize_frozen_iterator(builder, destination, span)
                            return Ok(None)
                        _ => pass
                _ => pass
            match value:
                RustOperand.Place(read) =>
                    mut exclusive = false
                    match read.fact:
                        OwnershipFact.Borrow => pass
                        OwnershipFact.MutBorrow =>
                            exclusive = true
                        _ => return Err("unsupported Body IR list iterator initialization ownership")
                    mut root = iteration_root(builder, read.place, exclusive, span)?
                    match place_type(builder.locals, root):
                        PlanType.FrozenCollection(_name, _elements) =>
                            if exclusive:
                                return Err("unsupported Body IR mutable frozen iteration")
                            root = frozen_list_snapshot(builder, read_place(root, false, span), span)?
                        _ => pass
                    root_type = place_type(builder.locals, root)
                    dictionary = len(collection_arguments(root_type)) == 2
                    if exclusive and not is_list(root_type) and not dictionary:
                        return Err("unsupported Body IR in-place iteration over a set")
                    reference = list_borrow(builder, root, exclusive, span)?
                    if exclusive:
                        builder.locals[destination.local].ty = operand_type(builder, reference)?
                    builder.emit(plan_assign(destination, RvalueKind.Use(reference), span))
                    initialize_list_iterator(builder, destination, value, span)
                    return Ok(None)
                _ => return Err("unsupported Body IR list iterator constant")
        _ => return Err("unsupported Body IR list iterator initialization")


def iteration_root(mut builder: Builder, value: &RustPlace, exclusive: bool, span: SourceSpan) -> Result[Place, str]:
    """
    Select the list a loop iterates: a loop changing the items of a list held by a list element or dictionary value
    iterates the stored list itself, reached through the container's checked reborrows.
    """
    if is_element_place(builder, value)?:
        if exclusive:
            return mutable_element_place(builder, value, span)
        return materialized_receiver(builder, value, span)
    return list_root_place(builder, value, span)


pub def list_root_place(mut builder: Builder, value: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """
    Borrow whole storage or an exact field, payload or tuple element path.

    A constant index selects a tuple element exactly like a structural field, so it stays on this path. Indexing a list
    retains its separate element-materialization route.
    """
    if len(value.projection) != 0:
        match computed_static_root(builder, value, span)?:
            Some(place) => return Ok(place)
            None => pass
        match value.local_id():
            None => return Err("unsupported Body IR global list root projection")
            Some(local) =>
                mut ty = builder.locals[int(local.index()) + 1 + builder.local_offset].ty
                # A receiver reference projects its model's fields.
                match ty:
                    PlanType.ModelRef(owner, name) =>
                        ty = PlanType.Model(owner, name)
                    PlanType.ModelMutRef(owner, name) =>
                        ty = PlanType.Model(owner, name)
                    PlanType.EnumMutRef(owner, name) =>
                        ty = PlanType.Enum(owner, name)
                    _ => pass
                for projection in value.projection:
                    match projection:
                        PlaceElem.Field(name=_name, canonical=_canonical, structural=_structural) => pass
                        PlaceElem.OptionPayload(option_type=_container, payload_type=_payload) => pass
                        PlaceElem.UnionMember(ty=_member) => pass
                        PlaceElem.Index(_index) =>
                            if not is_tuple_type(ty):
                                return Err("unsupported Body IR list root projection")
                        _ => return Err("unsupported Body IR list root projection")
                    ty = field_projection(
                        builder.nominals,
                        ty,
                        projection,
                        builder.enums,
                        builder.unions,
                        builder.intrinsics,
                    )?.ty
        return scalar_place(builder, value, span)
    return list_base_place(builder, value, span)


def collection_value(mut builder: Builder, read: &RustPlaceOperand, span: SourceSpan) -> Result[Operand, str]:
    """Materialize a checked collection read while preserving caller-owned bindings."""
    if len(read.place.projection) != 0:
        return dictionary_index_read(builder, read.place, span)
    place = list_root_place(builder, read.place, span)?
    ty = place_type(builder.locals, place)
    owned = collection_owned(ty)
    if read.fact == OwnershipFact.Move and ty == owned:
        return Ok(read_place(place, true, span))
    if read.fact != OwnershipFact.Clone and read.fact != OwnershipFact.Borrow:
        return Err("unsupported Body IR collection value ownership")
    return cloned_collection(builder, place, span)


def cloned_collection(mut builder: Builder, place: Place, span: SourceSpan) -> Result[Operand, str]:
    """
    Copy a set or dictionary into a new owned temporary that drops when its scope ends.

    A whole local is borrowed, or reborrowed when it is a parameter view; a projected one, such as an enum payload,
    is owned where it lives and is borrowed in place.
    """
    ty = place_type(builder.locals, place)
    owned = collection_owned(ty)
    mut reference = literal(Constant.Unit, span)
    if place.projection == Projection.Whole:
        reference = borrow_collection(builder, place, false, span)?
    else:
        if ty != owned:
            return Err("unsupported Body IR projected collection view")
        view = temporary(builder, collection_reference(ty, false), span)
        builder.emit(plan_assign(view, RvalueKind.Borrow(place), span))
        reference = read_place(view, false, span)
    output = temporary(builder, owned, span)
    collection_call(builder, ty, "clone", [collection_reference(ty, false)], owned, [reference], output, span)?
    return Ok(read_place(output, true, span))


def collection_assignment(
    mut builder: Builder,
    destination: Place,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Read checked literal operands before the collection module constructs their exact layout."""
    if destination.projection != Projection.Whole:
        replacement = temporary(builder, place_type(builder.locals, destination), span)
        _ = collection_assignment(builder, replacement, value, span)?
        replace_owned_destination(builder, destination, RvalueKind.Use(read_place(replacement, true, span)), span)
        return Ok(None)
    match value:
        RustRvalue.Use(value) =>
            argument = value_operand(builder, value, span)?
            return transfer_collection(builder, destination, argument, span)
        RustRvalue.Aggregate(kind, elements) =>
            if kind != RustAggregateKind.Set:
                return Err("unsupported Body IR non-set collection Aggregate")
            output = begin_collection(builder, destination, span)?
            types = collection_arguments(builder.locals[output.local].ty)
            for element in elements:
                match element.as_one():
                    Some(value) =>
                        argument = element_operand(builder, value, types[0], span)?
                        insert_collection(builder, output, [argument], span)?
                    None =>
                        match element:
                            RustArgumentElement.Spread(spread) =>
                                source = frozen_set_source(builder, spread.source, span)?
                                extend_collection(builder, output, source, span)?
                            _ => return Err("unsupported Body IR set spread")
            finish_collection(builder, destination, output, span)
            return Ok(None)
        RustRvalue.Dict(entries) =>
            output = begin_collection(builder, destination, span)?
            types = collection_arguments(builder.locals[output.local].ty)
            for entry in entries:
                match entry:
                    DictEntry.Pair(key, value) =>
                        key_operand = element_operand(builder, key, types[0], span)?
                        item_operand = element_operand(builder, value, types[1], span)?
                        insert_collection(builder, output, [key_operand, item_operand], span)?
                    DictEntry.Spread(spread) =>
                        source = value_operand(builder, spread.source, span)?
                        extend_collection(builder, output, source, span)?
            finish_collection(builder, destination, output, span)
            return Ok(None)
        _ => return Err("unsupported Body IR collection assignment rvalue")


def collection_length(
    mut builder: Builder,
    receiver: Place,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower canonical len without transferring container ownership."""
    ty = place_type(builder.locals, receiver)
    reference = borrow_collection(builder, receiver, false, span)?
    output = call_destination(builder, destination, PlanType.Int, span)?
    return collection_call(
        builder,
        ty,
        "length",
        [collection_reference(ty, false)],
        PlanType.Int,
        [reference],
        output,
        span,
    )


def collection_contains(
    mut builder: Builder,
    negated: bool,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve canonical haystack-first membership and explicit negation."""
    if len(arguments) != 2:
        return Err("unsupported Body IR collection membership arity")
    match argument_type(builder, arguments, 0, span)?:
        PlanType.FrozenCollection(name, _elements) =>
            if name == "FrozenDict":
                return frozen_dictionary_contains(builder, arguments, destination, negated, span)
            return lower_list_helper(builder, negated, arguments, destination, span)
        _ => pass
    receiver = argument_place(builder, arguments, 0, span)?
    ty = place_type(builder.locals, receiver)
    types = collection_arguments(ty)
    if len(types) == 0:
        return Err("unsupported Body IR collection membership on noncollection")
    argument = argument_value(builder, arguments, 1, span)?
    reference = borrow_collection(builder, receiver, false, span)?
    output = call_destination(builder, destination, PlanType.Bool, span)?
    collection_call(
        builder,
        ty,
        "contains",
        [collection_reference(ty, false), types[0]],
        PlanType.Bool,
        [reference, argument],
        output,
        span,
    )?
    if negated:
        builder.emit(plan_assign(output, RvalueKind.Unary(UnaryOp.Not, read_place(output, false, span)), span))
    return Ok(None)


def dictionary_index_read(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Operand, str]:
    """Clone a checked dictionary element through legacy indexing and error behavior, then read what follows from it."""
    if len(source.projection) == 0:
        return Err("unsupported Body IR dictionary read without key")
    receiver = list_base_place(builder, source, span)?
    return dictionary_value_read(builder, source, receiver, span)


def dictionary_value_read(
    mut builder: Builder,
    source: &RustPlace,
    receiver: Place,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Look up the place's first key in an already selected dictionary, such as a static's snapshot, then read on."""
    output = read_dictionary_element(builder, receiver, source, 0, span)?
    return projected_element_read(builder, source, output, 1, span)


def read_dictionary_element(
    mut builder: Builder,
    receiver: Place,
    source: &RustPlace,
    slot: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Clone the value the key at projection `slot` selects, through legacy indexing and its missing-key error."""
    ty = place_type(builder.locals, receiver)
    types = collection_arguments(ty)
    if len(types) != 2:
        return Err("unsupported Body IR set indexing")
    # Legacy dictionary indexing requires Display for its missing-key diagnostic; tuples and unit lack that bound.
    match types[0]:
        PlanType.Tuple(_elements) => return Err("unsupported Body IR tuple dictionary key lookup: legacy Display bound")
        PlanType.Unit => return Err("unsupported Body IR unit dictionary key lookup: legacy Display bound")
        _ => pass
    mut key = read_place(receiver, false, span)
    match source.projection[slot]:
        PlaceElem.Index(index) =>
            key = value_operand(builder, index, span)?
        _ => return Err("unsupported Body IR dictionary slice or field projection")
    reference = borrow_collection(builder, receiver, false, span)?
    output = temporary(builder, types[1], span)
    collection_call(
        builder,
        ty,
        "get",
        [collection_reference(ty, false), types[0]],
        types[1],
        [reference, key],
        output,
        span,
    )?
    # A cloned value that owns storage is a new owner, like a cloned list element; the final read moves it out.
    if is_nominal_type(types[1]) or is_owned_list(types[1]) or is_owned_collection(types[1]):
        builder.owned.append(output.local)
    return Ok(output)


def dictionary_index_assignment(
    mut builder: Builder,
    destination: &RustPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Replace dictionary entries after evaluating the source value and retained key."""
    receiver = list_base_place(builder, destination, span)?
    return dictionary_entry_assignment(builder, destination, receiver, 0, value, span)


def dictionary_entry_assignment(
    mut builder: Builder,
    destination: &RustPlace,
    receiver: Place,
    start: int,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Insert an evaluated entry into its retained dictionary, including a dictionary reached through a structural field."""
    if len(destination.projection) != start + 1:
        return Err("unsupported Body IR nested dictionary mutation")
    types = collection_arguments(place_type(builder.locals, receiver))
    if len(types) != 2:
        return Err("unsupported Body IR set indexing assignment")
    match value:
        RustRvalue.Use(value) =>
            argument = element_operand(builder, value, types[1], span)?
            match destination.projection[start]:
                PlaceElem.Index(index) =>
                    key = element_operand(builder, index, types[0], span)?
                    return insert_collection(builder, receiver, [key, argument], span)
                _ => return Err("unsupported Body IR dictionary mutation projection")
        _ => return Err("unsupported Body IR dictionary indexed rvalue")


def collection_method(
    mut builder: Builder,
    member: str,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Admit canonical set and dictionary methods with the legacy signatures."""
    if member == "Set.contains" or member == "Dict.contains_key":
        return collection_contains(builder, false, arguments, destination, span)
    if member == "Set.add" or member == "Dict.insert":
        return collection_insert_method(builder, member, arguments, span)
    receiver = argument_place(builder, arguments, 0, span)?
    ty = place_type(builder.locals, receiver)
    if member == "Dict.get" and len(arguments) == 2:
        return optional_dictionary_get(builder, receiver, arguments, destination, span)
    operation, parameters, result = dictionary_method_signature(ty, member, len(arguments))?
    mut operands: list[Operand] = []
    for slot in range(len(parameters)):
        operands.append(argument_value(builder, arguments, slot + 1, span)?)
    reference = borrow_collection(builder, receiver, false, span)?
    output = call_destination(builder, destination, result, span)?
    mut all_parameters = [collection_reference(ty, false)]
    all_parameters.extend(parameters)
    mut all_operands = [reference]
    all_operands.extend(operands)
    return collection_call(builder, ty, operation, all_parameters, result, all_operands, output, span)


def collection_insert_method(
    mut builder: Builder,
    member: str,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Insert the evaluated arguments into a set or dictionary receiver.

    A static receiver's snapshot is read only after the arguments and committed after the insertion, as a static list
    method's is.
    """
    types = collection_arguments(argument_type(builder, arguments, 0, span)?)
    if len(arguments) != len(types) + 1:
        return Err(f"unsupported Body IR collection method arity {member}")
    # Use the shared argument check before creating the short mutable runtime borrow.
    require_mutable_receiver(arguments)?
    mut operands: list[Operand] = []
    for slot in range(len(types)):
        argument = argument_value(builder, arguments, slot + 1, span)?
        operands.append(element_plan_operand(builder, argument, types[slot], span)?)
    match static_collection_receiver(builder, arguments, true, span)?:
        Some((global, receiver)) =>
            insert_collection(builder, receiver, operands, span)?
            return persist_static_value(builder, global, receiver, span)
        None => pass
    receiver = argument_place(builder, arguments, 0, span)?
    return insert_collection(builder, receiver, operands, span)


def optional_dictionary_get(
    mut builder: Builder,
    receiver: Place,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Copy a present value into the checked Option destination, replacing that destination's earlier value."""
    mut output = plan_place(0, span)
    match destination:
        Some(place) =>
            output = list_root_place(builder, place, span)?
        None => return Err("unsupported Body IR discarded optional dictionary get")
    ty = place_type(builder.locals, receiver)
    types = collection_arguments(ty)
    result = builder.locals[output.local].ty
    _owner, declaration = carrier_layout(builder, result)?
    if declaration.carrier != "Option" or declaration.variants[1].fields != [types[1]]:
        return Err("unsupported Body IR optional dictionary get carrier")
    key = argument_value(builder, arguments, 1, span)?
    reference = borrow_collection(builder, receiver, false, span)?
    found = temporary(builder, result, span)
    collection_call(
        builder,
        ty,
        "optional",
        [collection_reference(ty, false), types[0]],
        result,
        [reference, key],
        found,
        span,
    )?
    drop_owned(builder, output.local, span)
    builder.emit(plan_assign(output, RvalueKind.Use(read_place(found, true, span)), span))
    builder.owned.append(output.local)
    return Ok(None)


def iterable_call(
    mut builder: Builder,
    ty: PlanType,
    operation: str,
    tail: list[PlanType],
    result: PlanType,
    operands: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Share cursor calls while each collection retains its actual runtime representation."""
    if is_collection(ty):
        mut parameters = [collection_reference(ty, false)]
        parameters.extend(tail)
        return collection_call(builder, ty, operation, parameters, result, operands, destination, span)
    leaf, depth = require_list_shape(ty, "unsupported Body IR nonlist cursor")?
    mut name = "length_list"
    if operation == "nth":
        name = "get_list"
    mut parameters = [PlanType.ListRef(leaf, depth)]
    parameters.extend(tail)
    list_call(builder, name, list_element(leaf, depth), parameters, result, operands, destination, span)
    return Ok(None)


def lower_enum_match(
    module: &BodyIrModule,
    mut builder: Builder,
    target: Place,
    scrutinee: &RustOperand,
    arms: &list[RustMatchArm],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch checked variants in source arm order, with independent owner snapshots on each branch."""
    if target.local in builder.owned:
        return Err("unsupported Body IR initialized owned match destination")
    source = match_scrutinee_place(builder, scrutinee, arms, span)?
    match place_type(builder.locals, source):
        PlanType.Enum(_owner, _name) => pass
        _ => return lower_structural_match(module, builder, target, source, arms, span)
    owner = enum_owner(place_type(builder.locals, source))?
    raw_tag = temporary(builder, PlanType.EnumTag, span)
    tag = temporary(builder, PlanType.Int, span)
    builder.emit(plan_assign(raw_tag, RvalueKind.Discriminant(source), span))
    builder.emit(plan_assign(tag, RvalueKind.TagToInt(read_place(raw_tag, false, span)), span))
    join = builder.new_block(span)
    mut owners = builder.owned
    mut arm_ends: list[int] = []
    mut arm_owners: list[list[int]] = []
    for arm in arms:
        selected = builder.new_block(span)
        missed = builder.new_block(span)
        next_arm = builder.new_block(span)
        mut slot = -2
        if binds_through_alternation(arm.pattern):
            bound = bind_alternatives(builder, source, arm.pattern, selected, missed, owners, span)?
            builder.current = selected
            builder.owned = bound
        else:
            slot = dispatch_enum_arm(builder, source, owner, tag, arm.pattern, selected, missed, span)?
            builder.current = selected
            builder.owned = owners
            bind_enum_payload(builder, source, slot, arm.pattern, span)?
        consumed = lower_arm_guard(module, builder, arm, owners, source.local, next_arm, span)?
        lower_enum_arm_body(module, builder, arm)?
        if not builder.closed[builder.current]:
            value = boundary_operand(builder, arm.result, place_type(builder.locals, target), span)?
            track_rvalue_moves(builder, RvalueKind.Use(value))
            builder.emit(plan_assign(target, RvalueKind.Use(value), span))
            # Pattern-bound owners are branch locals; release them before the arm's owners meet the others at the join.
            mut branch_owners = builder.owned
            for local in branch_owners:
                if local not in owners:
                    drop_owned(builder, local, span)
            arm_ends.append(builder.current)
            arm_owners.append(builder.owned)
        owners = skip_consumed_guard(builder, missed, next_arm, owners, consumed, span)
        # A catch-all arm ends the dispatch unless its guard can still reject.
        if slot == -1 and arm.guard.is_none():
            break
    builder.finish(TerminatorKind.Unreachable, span)
    join_owners = join_branch_owners(builder, join, arm_ends, arm_owners, span)?
    reaches_join = len(arm_ends) != 0
    builder.current = join
    builder.closed[join] = not reaches_join
    builder.owned = join_owners
    ty = place_type(builder.locals, target)
    if reaches_join and (ty == PlanType.String or is_nominal_type(ty) or is_owned_collection(ty)):
        builder.owned.append(target.local)
    return Ok(None)


def dispatch_enum_arm(
    mut builder: Builder,
    source: Place,
    owner: int,
    tag: Place,
    pattern: &RustPattern,
    selected: int,
    rejected: int,
    span: SourceSpan,
) -> Result[int, str]:
    """
    Branch to `selected` when an arm's pattern matches the scrutinee and to `rejected` otherwise; return the variant.

    A plain variant pattern compares the tag the match already read. A pattern with a literal or nested payload, or an
    alternation, runs the full pattern tests in source order. A wildcard selects every value (-1), and an alternation
    names no single variant to bind (-2).
    """
    if has_refutable_payload(pattern):
        pattern_tests(builder, source, pattern, selected, rejected, span)?
        match pattern:
            RustPattern.Or(_alternatives) => return Ok(-2)
            _ => return carrier_pattern_slot(builder, owner, pattern)
    slot = carrier_pattern_slot(builder, owner, pattern)?
    if slot < 0:
        builder.finish(TerminatorKind.Goto(selected), span)
        return Ok(slot)
    condition = temporary(builder, PlanType.Bool, span)
    builder.emit(
        plan_assign(
            condition,
            RvalueKind.Binary(BinaryOp.Equal, read_place(tag, false, span), literal(Constant.Int(slot), span)),
            span,
        ),
    )
    builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), rejected, selected), span)
    return Ok(slot)


def is_binding_alternation(pattern: &RustPattern) -> bool:
    """Report whether a pattern is an alternation whose alternatives bind names."""
    match pattern:
        RustPattern.Or(_alternatives) => return pattern_binds(pattern)
        _ => return false


def binds_through_alternation(pattern: &RustPattern) -> bool:
    """Report whether an arm's pattern binds through an alternation: at its top, or as an item of a tuple there."""
    if is_binding_alternation(pattern):
        return true
    match pattern:
        RustPattern.Tuple(items) =>
            for item in items:
                if is_binding_alternation(item):
                    return true
        _ => pass
    return false


def bind_alternatives(
    mut builder: Builder,
    source: Place,
    pattern: &RustPattern,
    selected: int,
    rejected: int,
    incoming: list[int],
    span: SourceSpan,
) -> Result[list[int], str]:
    """
    Test each alternative of a binding alternation in source order; the first that matches binds and selects the arm.

    The checker requires every alternative to bind the same names, which share one local each, so every path reaches
    `selected` owning the same bound locals. The owners at `selected` are returned. A pattern that is not itself an
    alternation is its own single alternative.
    """
    match pattern:
        RustPattern.Or(alternatives) =>
            mut bound: list[int] = []
            mut first = true
            for alternative in alternatives:
                next_alternative = builder.new_block(span)
                owners = bind_alternative(builder, source, alternative, selected, next_alternative, incoming, span)?
                if first:
                    bound = owners
                    first = false
                elif not same_owners(owners, bound):
                    return Err("unsupported Body IR binding alternation ownership")
                builder.current = next_alternative
            builder.finish(TerminatorKind.Goto(rejected), span)
            return Ok(bound)
        _ => return bind_alternative(builder, source, pattern, selected, rejected, incoming, span)


def bind_alternative(
    mut builder: Builder,
    source: Place,
    alternative: &RustPattern,
    selected: int,
    rejected: int,
    incoming: list[int],
    span: SourceSpan,
) -> Result[list[int], str]:
    """Test one alternative and, when it matches, bind it and select the arm, returning the owners at `selected`."""
    match alternative:
        RustPattern.Tuple(items) =>
            if binds_through_alternation(alternative):
                fields = tuple_fields(source, place_type(builder.locals, source), span)?
                if len(fields) != len(items):
                    return Err("invalid Body IR tuple pattern layout")
                mut choices: list[int] = []
                for _item in items:
                    choices.append(-1)
                return tuple_paths(builder, fields, items, 0, choices, selected, rejected, incoming, span)
        _ => pass
    matched = builder.new_block(span)
    pattern_tests(builder, source, alternative, matched, rejected, span)?
    builder.current = matched
    builder.owned = incoming
    bind_structural_pattern(builder, source, alternative, span)?
    owners = builder.owned
    builder.finish(TerminatorKind.Goto(selected), span)
    return Ok(owners)


def tuple_paths(
    mut builder: Builder,
    fields: list[Place],
    items: &list[RustPattern],
    index: int,
    choices: list[int],
    selected: int,
    rejected: int,
    incoming: list[int],
    span: SourceSpan,
) -> Result[list[int], str]:
    """
    Test a tuple pattern's items from `index` on, trying each alternative of an item that binds through an alternation.

    `(A | B, C)` matches as `(A, C) | (B, C)`: a later item's failure tries the item's next alternative, and its last
    alternative's failure rejects. A path on which every item matched binds each item, an alternation item through the
    alternative `choices` records for it, and selects the arm. The owners at `selected` are returned.
    """
    if index == len(items):
        builder.owned = incoming
        for position in range(len(items)):
            bind_tuple_item(builder, fields[position], items[position], choices[position], span)?
        owners = builder.owned
        builder.finish(TerminatorKind.Goto(selected), span)
        return Ok(owners)
    if not is_binding_alternation(items[index]):
        next_item = builder.new_block(span)
        pattern_tests(builder, fields[index], items[index], next_item, rejected, span)?
        builder.current = next_item
        return tuple_paths(builder, fields, items, index + 1, choices, selected, rejected, incoming, span)
    mut bound: list[int] = []
    match items[index]:
        RustPattern.Or(alternatives) =>
            for choice in range(len(alternatives)):
                matched = builder.new_block(span)
                # A miss in this alternative or in any later item retries with the item's next alternative.
                retry = builder.new_block(span)
                pattern_tests(builder, fields[index], alternatives[choice], matched, retry, span)?
                builder.current = matched
                mut chosen = choices.clone()
                chosen[index] = choice
                owners = tuple_paths(builder, fields, items, index + 1, chosen, selected, retry, incoming, span)?
                if choice == 0:
                    bound = owners
                elif not same_owners(owners, bound):
                    return Err("unsupported Body IR binding alternation ownership")
                builder.current = retry
        _ => return Err("invalid Body IR binding alternation")
    builder.finish(TerminatorKind.Goto(rejected), span)
    return Ok(bound)


def bind_tuple_item(
    mut builder: Builder,
    field: Place,
    item: &RustPattern,
    choice: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Bind one tuple item: the alternative `choice` selects of an item that binds through an alternation, or the item."""
    if choice < 0:
        return bind_structural_pattern(builder, field, item, span)
    match item:
        RustPattern.Or(alternatives) => return bind_structural_pattern(builder, field, alternatives[choice], span)
        _ => return Err("invalid Body IR binding alternation")


def same_owners(left: list[int], right: list[int]) -> bool:
    """Report whether two owner ledgers hold the same locals, in any order."""
    if len(left) != len(right):
        return false
    for local in left:
        if local not in right:
            return false
    return true


def match_scrutinee_place(
    mut builder: Builder,
    scrutinee: &RustOperand,
    arms: &list[RustMatchArm],
    span: SourceSpan,
) -> Result[Place, str]:
    """
    Select the place a match inspects, borrowing the matched storage itself when an arm changes it in place.

    A list element is read as a copy unless an arm changes its payload in place; then it is reborrowed in its list, as
    legacy's checked `list_get_mut` does. A local, a field of one, a `mut` parameter and an exclusive loop item are
    already places the change reaches. A copied loop variable is not, so an in-place match over one stays refused.
    """
    mut in_place = false
    for arm in arms:
        if binds_in_place(arm.pattern):
            in_place = true
    match scrutinee:
        RustOperand.Place(read) =>
            mut indexed = false
            for projection in read.place.projection:
                match projection:
                    PlaceElem.Index(_index) =>
                        indexed = true
                    _ => pass
            if indexed and in_place:
                return exclusive_element(builder, read.place, span)
            if indexed:
                # Collection reads clone one element before inspecting its tag. Evaluate the checked index once
                # and keep the parent alive; an index cannot be interpreted as a model field projection.
                operand = value_operand(builder, scrutinee, span)?
                match operand.kind:
                    OperandKind.Move(place) => return Ok(place)
                    OperandKind.Copy(place) => return Ok(place)
                    _ => return Err("unsupported Body IR nonplace enum match scrutinee")
            source = scalar_place(builder, read.place, span)?
            if in_place and source.local in builder.borrowed_items:
                return Err("unsupported Body IR in-place match on a copied loop variable")
            return Ok(source)
        _ => return Err("unsupported Body IR nonplace enum match scrutinee")


def exclusive_element(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """
    Reborrow the list element an in-place match names through the runtime's checked `borrow_list_mut`.

    The list is the scrutinee's local or a structural field path of it; the index is evaluated before the list is
    borrowed. Only an enum carrier element is matched this way, and a nested or sliced element stays refused.
    """
    last = len(source.projection) - 1
    match source.projection[last]:
        PlaceElem.Index(_index) => pass
        _ => return Err("unsupported Body IR in-place match on a list slice")
    mut container = plan_place(0, span)
    if last == 0:
        container = list_base_place(builder, source, span)?
    else:
        match structural_prefix(builder, source)?:
            Some((count, _through_tuple)) =>
                if count != last:
                    return Err("unsupported Body IR in-place match on a nested list element")
            None => return Err("unsupported Body IR in-place match on a nested list element")
        container = prefix_place(builder, source, last, span)?
    leaf, depth = require_list_shape(
        place_type(builder.locals, container),
        "unsupported Body IR in-place match off a list",
    )?
    element = list_element(leaf, depth)
    mut reference_type = PlanType.Unit
    match element:
        PlanType.Enum(owner, name) =>
            reference_type = PlanType.EnumMutRef(owner, name)
        _ => return Err("unsupported Body IR in-place match on a non-carrier element")
    index = list_index_operand(builder, source, last, span)?
    exclusive_list = list_borrow(builder, container, true, span)?
    reference = temporary(builder, reference_type, span)
    list_call(
        builder,
        "borrow_list_mut",
        element,
        [PlanType.ListMutRef(leaf, depth), PlanType.Int],
        reference_type,
        [exclusive_list, index],
        reference,
        span,
    )
    return Ok(Place(local=reference.local, projection=Projection.Deref(element), span=span))


def lower_structural_match(
    module: &BodyIrModule,
    mut builder: Builder,
    target: Place,
    source: Place,
    arms: &list[RustMatchArm],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch numeric, primitive, tuple and source-local model patterns with branch-local owned bindings."""
    source_type = place_type(builder.locals, source)
    if not numeric_carrier(source_type) and source_type not in [PlanType.Bool, PlanType.Unit, PlanType.String] and not is_tuple_type(
        source_type,
    ) and not is_model_type(source_type):
        return Err("unsupported Body IR nonprimitive structural match scrutinee")
    result_type = place_type(builder.locals, target)
    join = builder.new_block(span)
    mut owners = builder.owned
    mut arm_ends: list[int] = []
    mut arm_owners: list[list[int]] = []
    for arm in arms:
        selected = builder.new_block(span)
        missed = builder.new_block(span)
        next_arm = builder.new_block(span)
        if binds_through_alternation(arm.pattern):
            bound = bind_alternatives(builder, source, arm.pattern, selected, missed, owners, span)?
            builder.current = selected
            builder.owned = bound
        else:
            pattern_tests(builder, source, arm.pattern, selected, missed, span)?
            builder.current = selected
            bind_structural_pattern(builder, source, arm.pattern, span)?
        consumed = lower_arm_guard(module, builder, arm, owners, source.local, next_arm, span)?
        lower_enum_arm_body(module, builder, arm)?
        if not builder.closed[builder.current]:
            value = boundary_operand(builder, arm.result, result_type, span)?
            track_rvalue_moves(builder, RvalueKind.Use(value))
            builder.emit(plan_assign(target, RvalueKind.Use(value), span))
            release_match_scratch(builder, owners, span)
            arm_ends.append(builder.current)
            arm_owners.append(builder.owned)
        owners = skip_consumed_guard(builder, missed, next_arm, owners, consumed, span)
    builder.finish(TerminatorKind.Unreachable, span)
    # An arm or its guard may move an incoming owner the other arms keep; the join keeps only what every arm kept.
    join_owners = join_branch_owners(builder, join, arm_ends, arm_owners, span)?
    reaches_join = len(arm_ends) != 0
    builder.current = join
    builder.closed[join] = not reaches_join
    builder.owned = join_owners
    if reaches_join and (result_type == PlanType.String or tuple_has_owners(result_type) or is_nominal_type(result_type) or is_owned_collection(
        result_type,
    )):
        builder.owned.append(target.local)
    return Ok(None)


def is_model_type(ty: PlanType) -> bool:
    """Report whether a scrutinee is a plain model, whose patterns name its fields."""
    match ty:
        PlanType.Model(_owner, _name) => return true
        _ => return false


def lower_arm_guard(
    module: &BodyIrModule,
    mut builder: Builder,
    arm: &RustMatchArm,
    incoming: list[int],
    scrutinee: int,
    rejected: int,
    span: SourceSpan,
) -> Result[list[int], str]:
    """
    Run a matched arm's guard after its pattern bound, falling through to `rejected` when the guard is false.

    The guard reads the arm's bindings and the incoming owners. A rejecting guard releases the bindings and guard
    temporaries it owns before falling through; an admitting guard keeps them for the arm's body. The guard may make
    the last use of an incoming owner, moving it on every path through the guard (Body IR counts last uses in source
    order, so no later arm reads it); those owners are returned for the caller to release on the paths that skip the
    guard. The scrutinee, which later arms test, and an owner whose release does more than free memory stay refused.
    """
    mut consumed: list[int] = []
    match arm.guard:
        Some(guard) =>
            for statement in arm.guard_stmts:
                lower_statement(module, builder, statement)?
                if builder.closed[builder.current]:
                    return Err("unsupported Body IR diverging match guard")
            condition = scalar_operand(builder, guard, span)?
            for local in incoming:
                if local not in builder.owned:
                    if local == scrutinee or not releases_only_memory(builder.locals[local].ty):
                        return Err("unsupported Body IR match guard consuming an owner")
                    consumed.append(local)
            admitted = builder.new_block(span)
            refused = builder.new_block(span)
            builder.finish(TerminatorKind.SwitchBool(condition, refused, admitted), span)
            kept = builder.owned
            builder.current = refused
            release_match_scratch(builder, incoming, span)
            builder.finish(TerminatorKind.Goto(rejected), span)
            builder.current = admitted
            builder.owned = kept
        None => pass
    return Ok(consumed)


def skip_consumed_guard(
    mut builder: Builder,
    missed: int,
    next_arm: int,
    owners: list[int],
    consumed: list[int],
    span: SourceSpan,
) -> list[int]:
    """
    Close an arm's pattern-miss path into the next arm and return the owners the next arm starts with.

    The arm's guard moved `consumed` on every path through it, so the miss path, which skips the guard, releases them
    too; both ways into the next arm then hold the same owners.
    """
    builder.current = missed
    builder.owned = owners
    for local in consumed:
        drop_owned(builder, local, span)
    builder.finish(TerminatorKind.Goto(next_arm), span)
    mut remaining: list[int] = []
    for local in owners:
        if local not in consumed:
            remaining.append(local)
    builder.current = next_arm
    builder.owned = remaining
    return remaining


def release_match_scratch(mut builder: Builder, incoming: list[int], span: SourceSpan) -> None:
    """Release branch-local bindings and literal materializations without dropping incoming owners."""
    owners = builder.owned
    for local in owners:
        if local not in incoming:
            drop_owned(builder, local, span)


def bind_structural_pattern(
    mut builder: Builder,
    source: Place,
    pattern: &RustPattern,
    span: SourceSpan,
) -> Result[None, str]:
    """Initialize arm-scoped locals only after every component of the pattern matched."""
    match pattern:
        RustPattern.Var(binding) =>
            local = int(binding.local.index()) + 1 + builder.local_offset
            ty = place_type(builder.locals, source)
            if builder.locals[local].ty != ty:
                return Err("invalid Body IR structural pattern binding carrier")
            mut value = read_place(source, false, span)
            match binding.fact:
                OwnershipFact.Unknown => return Err("unsupported Body IR pattern binding ownership Unknown")
                OwnershipFact.MutBorrow => return Err("unsupported Body IR mutable pattern binding")
                _ => pass
            if ty == PlanType.String:
                cloned = clone_text(builder, source, span)?
                value = read_place(cloned, true, span)
            else:
                if is_tuple_type(ty):
                    value = clone_tuple_operand(builder, source, span)?
            track_rvalue_moves(builder, RvalueKind.Use(value))
            builder.emit(plan_assign(plan_place(local, span), RvalueKind.Use(value), span))
            if ty == PlanType.String or tuple_has_owners(ty):
                builder.owned.append(local)
        RustPattern.Tuple(items) =>
            ty = place_type(builder.locals, source)
            fields = tuple_fields(source, ty, span)?
            if len(fields) != len(items):
                return Err("invalid Body IR tuple pattern binding layout")
            for index in range(len(items)):
                bind_structural_pattern(builder, fields[index], items[index], span)?
        RustPattern.Nominal(target=target, fields=fields) =>
            for name, field_pattern in fields:
                field = nominal_field(builder, source, target, str(name), span)?
                # A field binding reads out of the borrowed scrutinee, so it may only copy the value or clone text.
                match field_pattern:
                    RustPattern.Var(_binding) =>
                        if not structural_binding_carrier(place_type(builder.locals, field)):
                            return Err("unsupported Body IR owned model field pattern binding")
                    _ => pass
                bind_structural_pattern(builder, field, field_pattern, span)?
        RustPattern.Or(_alternatives) =>
            if pattern_binds(pattern):
                return Err("unsupported Body IR binding alternation")
        RustPattern.Wildcard => pass
        RustPattern.Literal(_value) => pass
        _ =>
            # A carrier pattern inside a structure binds its payload names like a match over that carrier.
            if pattern_binds(pattern):
                match place_type(builder.locals, source):
                    PlanType.Enum(owner, _name) =>
                        slot = carrier_pattern_slot(builder, owner, pattern)?
                        return bind_enum_payload(builder, source, slot, pattern, span)
                    _ => return Err("unsupported Body IR structural pattern binding")
    return Ok(None)


def structural_binding_carrier(ty: PlanType) -> bool:
    """Report whether a binding copies its matched value or clones it as text."""
    return numeric_carrier(ty) or ty == PlanType.Bool or ty == PlanType.Unit or ty == PlanType.String


def join_branch_owners(
    mut builder: Builder,
    join: int,
    ends: list[int],
    arm_owners: list[list[int]],
    span: SourceSpan,
) -> Result[list[int], str]:
    """
    Close each `if` branch or match arm reaching the join, keeping live only the owners every such branch left live.

    Body IR counts last uses across branches in source order, so one branch may move a value that another only borrows,
    and a branch's own temporaries (a condition's constructed model, a comparison's enum value) end with it. Rust drops
    such a value at scope end through a drop flag. Destroying text, collections and nominal values only releases their
    memory, so releasing the value at the end of the branch that kept it is equivalent. An owner of any other type
    left live on only some paths stays refused.
    """
    mut live: list[int] = []
    if len(ends) != 0:
        for local in arm_owners[0]:
            if kept_by_every_arm(local, arm_owners):
                live.append(local)
    for index in range(len(ends)):
        builder.current = ends[index]
        builder.owned = arm_owners[index]
        for local in arm_owners[index]:
            if local in live:
                continue
            if not releases_only_memory(builder.locals[local].ty):
                return Err("unsupported Body IR owned-value branch merge")
            drop_owned(builder, local, span)
        finish_fallthrough(builder, join, span)
    return Ok(live)


def releases_only_memory(ty: PlanType) -> bool:
    """Report whether destroying an owner of this type only frees memory: text, owned collections and nominal values."""
    if ty == PlanType.String or is_owned_collection(ty):
        return true
    match ty:
        PlanType.Model(_index, _name) => return true
        PlanType.Enum(_index, _name) => return true
        PlanType.Tuple(_elements) => return true
        _ => return false


def kept_by_every_arm(local: int, arm_owners: list[list[int]]) -> bool:
    """Report whether every arm reaching a join still owns `local`."""
    for owned in arm_owners:
        if local not in owned:
            return false
    return true


def lower_enum_arm_body(module: &BodyIrModule, mut builder: Builder, arm: &RustMatchArm) -> Result[None, str]:
    """Borrow the retained arm's statements and stop once its control flow terminates."""
    for statement in arm.body_stmts:
        lower_statement(module, builder, statement)?
        if builder.closed[builder.current]:
            return Ok(None)
    return Ok(None)


pub def bind_enum_payload(
    mut builder: Builder,
    source: Place,
    variant: int,
    pattern: &RustPattern,
    span: SourceSpan,
) -> Result[None, str]:
    """Bind payloads through native downcasts, copying scalars and cloning checked owned payloads."""
    match pattern:
        RustPattern.UnionMember(ty=_ty, fields=fields) =>
            return bind_enum_fields(builder, source, variant, fields, span)
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=fields) =>
            return bind_enum_fields(builder, source, variant, fields, span)
        RustPattern.Result(variant=_kind, fields=fields) =>
            return bind_enum_fields(builder, source, variant, fields, span)
        _ => pass
    return Ok(None)


def enum_payload_read(
    mut builder: Builder,
    place: Place,
    fact: &OwnershipFact,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Preserve projected copy/borrow facts while materializing the source binding's owned value."""
    # Legacy matches a cloned enum by value, so a moved payload binding is materialized like a cloned one.
    match fact:
        OwnershipFact.Copy => return Ok(read_place(place, false, span))
        OwnershipFact.Clone => pass
        OwnershipFact.Borrow => pass
        OwnershipFact.Move => pass
        _ => return Err("unsupported Body IR enum payload binding ownership")
    # The canonical frozen wrapper's Clone is its Copy value; it owns no allocation or custom clone hook.
    if place_type(builder.locals, place) == PlanType.FrozenStr:
        return Ok(read_place(place, false, span))
    # A type parameter's payload binding is cloned by its checked fact, which is Rust's copy-valued Clone once the
    # instance makes the payload a concrete scalar.
    payload_type = place_type(builder.locals, place)
    if numeric_carrier(payload_type) or payload_type == PlanType.Bool or payload_type == PlanType.Unit:
        return Ok(read_place(place, false, span))
    if is_list(place_type(builder.locals, place)):
        return carrier_payload_value(builder, place, span)
    if is_collection(place_type(builder.locals, place)):
        return cloned_collection(builder, place, span)
    # Legacy matches a cloned enum by value. Cloning just the selected payload preserves that owned-binding contract
    # while the canonical match scrutinee stays borrowed; unselected payloads remain owned by their original enum.
    if place_type(builder.locals, place) == PlanType.String:
        cloned = clone_text(builder, place, span)?
        return Ok(read_place(cloned, true, span))
    return clone_nominal_operand(builder, place, span)


def enum_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[bool, str]:
    """Keep unsupported derived enum comparisons a named refusal rather than submitting invalid scalar MIR."""
    match value:
        RustOperand.Place(read) =>
            # Retained static cells are scalar-only; the ordinary read validates their canonical storage identity.
            match read.place.global():
                Some(_global) => return Ok(false)
                None => pass
            # List and dictionary projections have scalar leaf types and are materialized by their own readers.
            base = list_base_place(builder, read.place, span)?
            if is_list(builder.locals[base.local].ty) or is_collection(builder.locals[base.local].ty):
                return Ok(false)
            # So does a list reached through a tuple element.
            match structural_prefix(builder, read.place)?:
                Some((count, through_tuple)) =>
                    if through_tuple and count < len(read.place.projection):
                        return Ok(false)
                None => pass
            place = scalar_place(builder, read.place, span)?
            match place_type(builder.locals, place):
                PlanType.Enum(_owner, _name) => return Ok(true)
                _ => pass
        _ => pass
    return Ok(false)


def read_static(
    mut builder: Builder,
    value: &RustPlace,
    global: &RustGlobalPlace,
    fact: &OwnershipFact,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Read persistent storage without consuming it, cloning owned string and collection values."""
    slot = static_slot(builder.statics, global)?
    initialize_module_statics(builder, static_owner(builder.statics[slot]), span)
    if is_computed_static(builder.statics[slot]):
        return read_computed_static(builder, value, global, slot, fact, span)
    ty = model_type(builder.nominals, global.ty)?
    if len(value.projection) != 0 and not is_owned_collection(ty):
        return Err("unsupported Body IR static projection")
    if is_owned_collection(ty):
        if fact != OwnershipFact.Clone and fact != OwnershipFact.Borrow and fact != OwnershipFact.MutBorrow:
            if len(value.projection) == 0 or fact != OwnershipFact.Copy:
                return Err("unsupported Body IR static collection ownership")
    elif ty == PlanType.String:
        if fact != OwnershipFact.Clone and fact != OwnershipFact.Borrow:
            return Err("unsupported Body IR static string ownership")
    elif fact != OwnershipFact.Copy:
        return Err("unsupported Body IR static ownership")
    read_cell, _write_cell = static_accessors(ty)?
    initial = static_initial_operand(builder, builder.statics[slot].initial, ty, span)?
    target = temporary(builder, ty, span)
    external_call(builder, read_cell, [PlanType.Int, ty], ty, [literal(Constant.Int(slot), span), initial], target, span)
    if not is_owned_collection(ty):
        return Ok(read_place(target, ty == PlanType.String, span))
    builder.owned.append(target.local)
    # An element read selects from the snapshot, which stays owned until its scope ends.
    if len(value.projection) == 0:
        return Ok(read_place(target, true, span))
    if is_collection(ty):
        return dictionary_value_read(builder, value, target, span)
    return projected_element_read(builder, value, target, 0, span)


def read_computed_static(
    mut builder: Builder,
    value: &RustPlace,
    global: &RustGlobalPlace,
    slot: int,
    fact: &OwnershipFact,
    span: SourceSpan,
) -> Result[Operand, str]:
    """
    Read a computed static (RFC 052) as legacy reads it: initialize its module's statics, then copy its current value.

    The copy is a fresh owner, so a whole read hands it on and a projected read selects from it as from any owned
    snapshot. Only a collection is borrowed mutably, by a method that commits the changed copy back.
    """
    ty = native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?
    match fact:
        OwnershipFact.Unknown => return Err("unsupported Body IR static ownership")
        OwnershipFact.MutBorrow =>
            if len(value.projection) != 0 or not is_owned_collection(ty):
                return Err("unsupported Body IR mutable borrow of a computed static")
        OwnershipFact.Move =>
            if len(value.projection) != 0:
                return Err("unsupported Body IR partial move out of a static")
        _ => pass
    snapshot = load_computed_static(builder, slot, ty, span)
    if len(value.projection) == 0:
        return Ok(read_place(snapshot, snapshot_owns(ty), span))
    if is_collection(ty):
        return dictionary_value_read(builder, value, snapshot, span)
    if is_owned_collection(ty):
        return projected_element_read(builder, value, snapshot, 0, span)
    selected = snapshot_projection(builder, value, snapshot, span)?
    # The copy stays whole until its scope ends, so a borrowed field is read as a clone rather than moved out of it.
    if fact == OwnershipFact.Borrow:
        return target_read(builder, selected, OwnershipFact.Clone, span)
    return target_read(builder, selected, fact, span)


def load_computed_static(mut builder: Builder, slot: int, ty: PlanType, span: SourceSpan) -> Place:
    """Load a copy of computed static `slot` after its module's statics are initialized, as legacy reads do."""
    initialize_module_statics(builder, static_owner(builder.statics[slot]), span)
    snapshot = temporary(builder, ty, span)
    terminate_call(builder, CalleeKind.StaticLoad(slot), [], snapshot, span)
    if snapshot_owns(ty):
        builder.owned.append(snapshot.local)
    return snapshot


def snapshot_owns(ty: PlanType) -> bool:
    """Whether a loaded static value owns resources its frame must drop, rather than being a plain copy."""
    if numeric_carrier(ty) or ty == PlanType.Bool or ty == PlanType.Unit or ty == PlanType.FrozenStr:
        return false
    return not callable_copy_type(ty)


def computed_static_root(mut builder: Builder, value: &RustPlace, span: SourceSpan) -> Result[Option[Place], str]:
    """The place a projected computed static selects inside a freshly loaded copy, or None for any other place."""
    match value.global():
        Some(global) =>
            slot = static_slot(builder.statics, global)?
            if not is_computed_static(builder.statics[slot]):
                return Ok(None)
            ty = native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?
            snapshot = load_computed_static(builder, slot, ty, span)
            if len(value.projection) == 0:
                return Ok(Some(snapshot))
            if is_owned_collection(ty):
                selected = projected_element_read(builder, value, snapshot, 0, span)?
                match selected.kind:
                    OperandKind.Copy(place) => return Ok(Some(place))
                    OperandKind.Move(place) => return Ok(Some(place))
                    _ => return Err("unsupported Body IR computed static element without a place")
            return Ok(Some(snapshot_projection(builder, value, snapshot, span)?))
        None => return Ok(None)


def computed_static_type(builder: Builder, value: &RustPlace, global: &RustGlobalPlace) -> Result[PlanType, str]:
    """The checked carrier a computed static place selects, without reading the static."""
    mut ty = native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?
    for projection in value.projection:
        match projection:
            PlaceElem.Index(_index) =>
                if is_collection(ty):
                    types = collection_arguments(ty)
                    if len(types) != 2:
                        return Err("unsupported Body IR computed static set indexing")
                    ty = types[1]
                    continue
                if is_list(ty):
                    leaf, depth = require_list_shape(ty, "unsupported Body IR computed static list indexing")?
                    ty = list_element(leaf, depth)
                    continue
            PlaceElem.Slice(start=_start, end=_end, step=_step) =>
                if is_list(ty):
                    continue
            _ => pass
        ty = field_projection(builder.nominals, ty, projection, builder.enums, builder.unions, builder.intrinsics)?.ty
    return Ok(ty)


def snapshot_projection(builder: Builder, value: &RustPlace, snapshot: Place, span: SourceSpan) -> Result[Place, str]:
    """Select a static place's checked field and payload path inside its loaded copy."""
    fields = field_path(
        builder.nominals,
        place_type(builder.locals, snapshot),
        value.projection,
        len(value.projection),
        builder.enums,
        builder.unions,
        builder.intrinsics,
    )?
    if len(fields) == 1 and fields[0].variant >= 0:
        return Ok(
            Place(
                local=snapshot.local,
                projection=Projection.VariantField(fields[0].variant, fields[0].slot, fields[0].ty),
                span=span,
            ),
        )
    if len(fields) == 1:
        return Ok(Place(local=snapshot.local, projection=Projection.Field(fields[0].slot, fields[0].ty), span=span))
    return Ok(Place(local=snapshot.local, projection=Projection.Fields(fields), span=span))


def static_initial_operand(
    mut builder: Builder,
    initial: &RustStaticInitializer,
    ty: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Materialize the checked effect-free initializer without reading source syntax or replacing stored values."""
    match initial:
        RustStaticInitializer.Literal(value) =>
            return scalar_operand(builder, RustOperand.Constant(value.clone()), span)
        RustStaticInitializer.List(values) =>
            mut elements: list[RustArgumentElement] = []
            for value in values:
                elements.append(static_literal_element(value))
            target = temporary(builder, ty, span)
            list_assignment(builder, target, RustRvalue.Aggregate(RustAggregateKind.List, elements), span)?
            return Ok(read_place(target, true, span))
        RustStaticInitializer.Dict(entries) =>
            mut keys: list[RustConstant] = []
            mut values: list[RustConstant] = []
            for key, value in entries:
                keys.append(key.clone())
                values.append(value.clone())
            return static_hashed_initial(builder, ty, keys, values, span)
        RustStaticInitializer.Set(members) =>
            mut keys: list[RustConstant] = []
            for member in members:
                keys.append(member.clone())
            return static_hashed_initial(builder, ty, keys, [], span)
        RustStaticInitializer.Computed(_body) =>
            return Err("invalid Body IR computed static as a literal initial value")


def static_hashed_initial(
    mut builder: Builder,
    ty: PlanType,
    keys: list[RustConstant],
    values: list[RustConstant],
    span: SourceSpan,
) -> Result[Operand, str]:
    """Build a dictionary from checked literal keys and their values, or a set from its members, in source order."""
    target = temporary(builder, ty, span)
    output = begin_collection(builder, target, span)?
    types = collection_arguments(ty)
    if len(types) == 2 and len(values) != len(keys):
        return Err("invalid Body IR static dictionary entries")
    if len(types) == 1 and len(values) != 0:
        return Err("invalid Body IR static set members")
    for index in range(len(keys)):
        key = element_operand(builder, RustOperand.Constant(keys[index].clone()), types[0], span)?
        mut operands: list[Operand] = [key]
        if len(types) == 2:
            operands.append(element_operand(builder, RustOperand.Constant(values[index].clone()), types[1], span)?)
        insert_collection(builder, output, operands, span)?
    finish_collection(builder, target, output, span)
    return Ok(read_place(target, true, span))


def static_literal_element(value: &RustConstant) -> RustArgumentElement:
    """Return a fresh owned foreign element; legacy append conservatively copies constructors containing name reads."""
    return RustArgumentElement.One(RustOperand.Constant(value.clone()))


def read_text_constant(mut builder: Builder, global: &RustGlobalPlace, span: SourceSpan) -> Result[Operand, str]:
    """Own a copy of a read-only text constant's literal, as legacy's owned read of the constant does."""
    if global.write_policy != RustGlobalWritePolicy.ReadOnly:
        return Err("unsupported Body IR static ownership")
    slot = static_slot(builder.statics, global)?
    match builder.statics[slot].initial:
        RustStaticInitializer.Literal(RustConstant.Str(text)) =>
            return Ok(read_place(owned_literal(builder, str(text), span), true, span))
        _ => return Err("unsupported Body IR static ownership")


def write_static(
    module: &BodyIrModule,
    mut builder: Builder,
    destination: &RustPlace,
    global: &RustGlobalPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Evaluate a write before committing it to a checker-authorized persistent cell."""
    match global.write_policy:
        RustGlobalWritePolicy.Rebindable => pass
        _ => return Err("unsupported Body IR static write policy")
    mut ty = PlanType.Unit
    if is_computed_static(builder.statics[static_slot(builder.statics, global)?]):
        ty = native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?
    else:
        ty = model_type(builder.nominals, global.ty)?
    if len(destination.projection) != 0:
        if not is_collection(ty):
            return Err("unsupported Body IR static projection")
        return write_static_entry(builder, destination, global, value, span)
    target = temporary(builder, ty, span)
    lower_local_assignment(module, builder, target, value, span)?
    return persist_static_value(builder, global, target, span)


def write_static_entry(
    mut builder: Builder,
    destination: &RustPlace,
    global: &RustGlobalPlace,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Write one static dictionary entry: evaluate the value and then the key, insert them into the current snapshot,
    and commit that snapshot.

    The snapshot is read only after both are evaluated, so a value that itself changes the static is not overwritten
    by a stale copy.
    """
    if len(destination.projection) != 1:
        return Err("unsupported Body IR nested static dictionary mutation")
    types = collection_arguments(
        native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?,
    )
    if len(types) != 2:
        return Err("unsupported Body IR static set indexing assignment")
    mut argument = literal(Constant.Unit, span)
    match value:
        RustRvalue.Use(operand) =>
            argument = element_operand(builder, operand, types[1], span)?
        _ => return Err("unsupported Body IR static dictionary indexed rvalue")
    mut key = literal(Constant.Unit, span)
    match destination.projection[0]:
        PlaceElem.Index(index) =>
            key = element_operand(builder, index, types[0], span)?
        _ => return Err("unsupported Body IR static dictionary mutation projection")
    receiver = list_base_place(builder, destination, span)?
    insert_collection(builder, receiver, [key, argument], span)?
    return persist_static_value(builder, global, receiver, span)


def persist_static_value(
    mut builder: Builder,
    global: &RustGlobalPlace,
    target: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Commit an evaluated primitive or collection replacement to its exact canonical storage slot."""
    slot = static_slot(builder.statics, global)?
    if is_computed_static(builder.statics[slot]):
        return store_computed_static(builder, global, slot, target, span)
    initialize_module_statics(builder, static_owner(builder.statics[slot]), span)
    ty = model_type(builder.nominals, global.ty)?
    if place_type(builder.locals, target) != ty:
        return Err("invalid Body IR static replacement carrier")
    _read_cell, write_cell = static_accessors(ty)?
    output = temporary(builder, PlanType.Unit, span)
    external_call(
        builder,
        write_cell,
        [PlanType.Int, ty],
        PlanType.Unit,
        [literal(Constant.Int(slot), span), read_place(target, ty == PlanType.String or is_owned_collection(ty), span)],
        output,
        span,
    )
    return Ok(None)


def store_computed_static(
    mut builder: Builder,
    global: &RustGlobalPlace,
    slot: int,
    target: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Replace a computed static's value with an evaluated one, after its module's statics are initialized as legacy's
    writes first initialize them (RFC 052).
    """
    ty = native_source_type(builder.nominals, builder.enums, builder.unions, global.ty, builder.intrinsics)?
    if place_type(builder.locals, target) != ty:
        return Err("unsupported Body IR computed static replacement carrier")
    initialize_module_statics(builder, static_owner(builder.statics[slot]), span)
    output = temporary(builder, PlanType.Unit, span)
    terminate_call(builder, CalleeKind.StaticStore(slot), [read_place(target, snapshot_owns(ty), span)], output, span)
    return Ok(None)


def boundary_operand(
    mut builder: Builder,
    value: &RustOperand,
    target: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Materialize union construction before passing or returning an owned value."""
    if target == PlanType.FrozenStr:
        return frozen_operand(builder, value, span)
    operand = typed_carrier_operand(builder, value, target, span)?
    # The checker types a builtin range call as a list, but its value is a lazy range only iteration consumes.
    match generator_shape(operand_type(builder, operand)?):
        Some(_shape) =>
            if is_list(target):
                return Err("unsupported Body IR generator value at a list boundary")
        None => pass
    return boundary_plan_operand(builder, operand, target, span)


def element_operand(
    mut builder: Builder,
    value: &RustOperand,
    element: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """
    Evaluate a collection element at the element's checked carrier.

    The checker types each element against the collection, so a frozen `str` constant becomes owned text and a
    narrower numeric carrier widens to the element's carrier, exactly as at any other typed boundary.
    """
    operand = boundary_operand(builder, value, element, span)?
    return coerce_numeric_operand(builder, operand, element, span)


def element_plan_operand(
    mut builder: Builder,
    value: Operand,
    element: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Convert an already evaluated collection element to the element's checked carrier, as `element_operand` does."""
    mut operand = value
    if element == PlanType.String and operand_type(builder, operand)? == PlanType.FrozenStr:
        text = display_plan_operand(builder, operand, span)?
        operand = read_place(text, true, span)
    operand = boundary_plan_operand(builder, operand, element, span)?
    return coerce_numeric_operand(builder, operand, element, span)


def boundary_plan_operand(
    mut builder: Builder,
    value: Operand,
    target: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Inject a previously evaluated member without reading its source or executing its effects a second time."""
    match converted_carrier_operand(builder, value, target, span)?:
        Some(converted) => return Ok(converted)
        None => pass
    match target:
        PlanType.FunctionPointer(_signature) =>
            ty, operation = function_assignment(target, operand_type(builder, value)?, value, true)?
            pointer = temporary(builder, ty, span)
            builder.emit(plan_assign(pointer, operation, span))
            return Ok(read_place(pointer, false, span))
        _ => pass
    mut operand = value
    if operand_type(builder, operand)? == PlanType.FrozenStr:
        match target:
            PlanType.Enum(owner, _name) =>
                if owner >= len(builder.enums) and builder.intrinsics[owner - len(builder.enums)].carrier == "":
                    mut convert = false
                    for union in builder.unions:
                        if str(union) != builder.intrinsics[owner - len(builder.enums)].source_type:
                            continue
                        members = union_members(builder.nominals, builder.enums, union, builder.intrinsics)?
                        convert = PlanType.FrozenStr not in members and PlanType.String in members
                        break
                    if convert:
                        text = display_plan_operand(builder, operand, span)?
                        operand = read_place(text, true, span)
            _ => pass
    operand = option_payload_operand(builder, operand, target.clone(), span)?
    operation = carrier_injection(
        builder.nominals,
        builder.enums,
        builder.unions,
        operand,
        operand_type(builder, operand)?,
        target,
        builder.intrinsics,
    )?
    match operation:
        RvalueKind.Use(result) => return Ok(result)
        _ =>
            output = temporary(builder, target, span)
            track_rvalue_moves(builder, operation)
            builder.emit(plan_assign(output, operation, span))
            builder.owned.append(output.local)
            return Ok(read_place(output, true, span))
# =====================================================================================================================
# Lists: borrowing and runtime calls
# =====================================================================================================================
# =====================================================================================================================
# Lists: owned values and indexed reads
# =====================================================================================================================
# =====================================================================================================================
# Lists: checked arguments and methods
# =====================================================================================================================
# =====================================================================================================================
# Lists: indexed mutation
# =====================================================================================================================
# =====================================================================================================================
# Lists: iteration
# =====================================================================================================================
# =====================================================================================================================
# Hashed collections: shared frame operations
# =====================================================================================================================
# =====================================================================================================================
# Persistent scalar storage
# =====================================================================================================================


def converted_carrier_operand(
    mut builder: Builder,
    value: Operand,
    target: PlanType,
    span: SourceSpan,
) -> Result[Option[Operand], str]:
    """Convert checked Option/Result payload carriers without changing the active variant or duplicating its owners."""
    source_type = operand_type(builder, value)?
    if source_type == target:
        return Ok(None)
    mut source_owner = -1
    mut target_owner = -1
    match source_type:
        PlanType.Enum(owner, _name) =>
            source_owner = owner
        _ => return Ok(None)
    match target:
        PlanType.Enum(owner, _name) =>
            target_owner = owner
        _ => return Ok(None)
    if source_owner < len(builder.enums) or target_owner < len(builder.enums):
        return Ok(None)
    before = builder.intrinsics[source_owner - len(builder.enums)]
    after = builder.intrinsics[target_owner - len(builder.enums)]
    if before.carrier not in ["Option", "Result"] or before.carrier != after.carrier:
        return Ok(None)
    mut source = plan_place(-1, span)
    match value.kind:
        OperandKind.Move(place) =>
            source = place
        _ => return Err("unsupported Body IR carrier conversion without an owned value")
    output = temporary(builder, target, span)
    selected = builder.new_block(span)
    other = builder.new_block(span)
    joined = builder.new_block(span)
    condition = variant_condition(builder, source, 0, span)
    builder.finish(TerminatorKind.SwitchBool(condition, other, selected), span)
    forget_owned(builder, source.local)
    owners = builder.owned
    for slot in range(2):
        builder.current = selected
        if slot == 1:
            builder.current = other
        builder.owned = owners
        if len(before.variants[slot].fields) != len(after.variants[slot].fields):
            return Err("unsupported Body IR carrier conversion variant layout")
        mut fields: list[Operand] = []
        for index in range(len(before.variants[slot].fields)):
            payload_type = before.variants[slot].fields[index]
            payload = Place(local=source.local, projection=Projection.VariantField(slot, index, payload_type), span=span)
            fields.append(
                boundary_plan_operand(builder, read_place(payload, true, span), after.variants[slot].fields[index], span)?,
            )
        assign_carrier(builder, output, target_owner, slot, fields, span)
        builder.finish(TerminatorKind.Goto(joined), span)
    builder.current = joined
    builder.owned = owners
    builder.owned.append(output.local)
    return Ok(Some(read_place(output, true, span)))


def option_payload_operand(
    mut builder: Builder,
    value: Operand,
    target: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """
    Bring a value written into an `Option` to the type of that `Option`'s payload, which then wraps it in `Some`.

    A value written into an `Option` of an `Option` or union is first injected into that inner carrier, so each layer
    wraps it, and a number written into an `Option` of another numeric type converts first, as legacy writes it.
    Every other value is returned unchanged.
    """
    mut payload = PlanType.Unit
    match target:
        PlanType.Enum(owner, _name) =>
            if owner < len(builder.enums):
                return Ok(value)
            declaration = builder.intrinsics[owner - len(builder.enums)]
            if declaration.carrier != "Option":
                return Ok(value)
            payload = declaration.variants[1].fields[0]
        _ => return Ok(value)
    source = operand_type(builder, value)?
    if source == target or source == payload:
        return Ok(value)
    if numeric_carrier(source) and numeric_carrier(payload):
        return coerce_numeric_operand(builder, value, payload, span)
    match payload:
        PlanType.Enum(_owner, _name) => return boundary_plan_operand(builder, value, payload, span)
        _ => return Ok(value)


def lower_union_isinstance(
    mut builder: Builder,
    value: &RustOperand,
    ty: &RustType,
    target: &RustType,
    span: SourceSpan,
) -> Result[RvalueKind, str]:
    """Inspect the physical carrier's tag without consuming it; a narrowed view never changes stored variant indexes."""
    source_ty = isinstance_source_type(builder, value, ty, span)?
    member = native_source_type(builder.nominals, builder.enums, builder.unions, target, builder.intrinsics)?
    match source_ty:
        PlanType.Int => return Ok(RvalueKind.Use(literal(Constant.Bool(source_ty == member), span)))
        PlanType.Float => return Ok(RvalueKind.Use(literal(Constant.Bool(source_ty == member), span)))
        PlanType.Bool => return Ok(RvalueKind.Use(literal(Constant.Bool(source_ty == member), span)))
        PlanType.String =>
            return Ok(RvalueKind.Use(literal(Constant.Bool(member in [PlanType.String, PlanType.FrozenStr]), span)))
        PlanType.FrozenStr =>
            return Ok(RvalueKind.Use(literal(Constant.Bool(member in [PlanType.String, PlanType.FrozenStr]), span)))
        _ => pass
    owner = enum_owner(source_ty)?
    if is_option_carrier(builder, owner):
        option = isinstance_place(builder, value, span)?
        return option_isinstance(builder, option, owner, member, span)
    slots = union_test_slots(builder.nominals, builder.enums, builder.unions, owner, member, builder.intrinsics)?
    if len(slots) == 0:
        return Ok(RvalueKind.Use(literal(Constant.Bool(false), span)))
    source = isinstance_place(builder, value, span)?
    tag = enum_tag(builder, source, span)
    return Ok(test_union_tag(builder, tag, slots, span))


def isinstance_source_type(
    builder: Builder,
    value: &RustOperand,
    checked: &RustType,
    span: SourceSpan,
) -> Result[PlanType, str]:
    """Use retained place storage for carrier views, preserving full union indexes after a checker-proven narrowing."""
    match checked:
        RustType.Generic(base=base, args=_arguments) =>
            if base == "Union" or base == "Option":
                source = isinstance_place(builder, value, span)?
                return Ok(place_type(builder.locals, source))
        _ => pass
    return native_source_type(builder.nominals, builder.enums, builder.unions, checked, builder.intrinsics)


def isinstance_place(builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """The storage whose tag `isinstance` reads in place."""
    match value:
        RustOperand.Place(read) => return scalar_place(builder, read.place, span)
        _ => return Err("unsupported Body IR nonplace union isinstance")


def bind_enum_fields(
    mut builder: Builder,
    source: Place,
    variant: int,
    fields: &list[RustPattern],
    span: SourceSpan,
) -> Result[None, str]:
    """Bind checked enum payload slots through the same downcast and ownership path for source enums and unions."""
    for slot in range(len(fields)):
        match fields[slot]:
            RustPattern.Var(binding) =>
                local = int(binding.local.index()) + 1 + builder.local_offset
                ty = builder.locals[local].ty
                projected = appended_field(source, FieldProjection(slot=slot, ty=ty, variant=variant), span)?
                if binding.fact == OwnershipFact.MutBorrow:
                    bind_payload_in_place(builder, local, projected, span)?
                else:
                    value = enum_payload_read(builder, projected, binding.fact, span)?
                    track_rvalue_moves(builder, RvalueKind.Use(value))
                    builder.emit(plan_assign(plan_place(local, span), RvalueKind.Use(value), span))
                    if ty == PlanType.String or is_nominal_type(ty):
                        builder.owned.append(local)
            _ =>
                if pattern_binds(fields[slot]):
                    bind_nested_payload(builder, source, variant, slot, fields[slot], span)?
    return Ok(None)


def bind_nested_payload(
    mut builder: Builder,
    source: Place,
    variant: int,
    slot: int,
    pattern: &RustPattern,
    span: SourceSpan,
) -> Result[None, str]:
    """Bind the names a nested carrier or tuple payload pattern names, from the payload its tests already matched."""
    mut owner = -1
    match place_type(builder.locals, source):
        PlanType.Enum(index, _name) =>
            owner = index
        _ => return Err("invalid Body IR nested payload carrier")
    types = carrier_payload_types(builder, owner, variant)?
    payload = appended_field(source, FieldProjection(slot=slot, ty=types[slot], variant=variant), span)?
    match place_type(builder.locals, payload):
        PlanType.Enum(nested_owner, _name) =>
            nested = carrier_pattern_slot(builder, nested_owner, pattern)?
            return bind_enum_payload(builder, payload, nested, pattern, span)
        _ => return bind_structural_pattern(builder, payload, pattern, span)


def bind_payload_in_place(mut builder: Builder, local: int, payload: Place, span: SourceSpan) -> Result[None, str]:
    """
    Bind a name its arm changes as an exclusive reference to the payload it names, as legacy matches `&mut`.

    The change then lands in the scrutinee itself. The reference owns nothing, so the binding never enters the drop
    ledger. Tuple payloads retain their complete layout behind that reference; scalar payloads keep copy bindings.
    """
    mut reference = PlanType.Unit
    match exclusive_reference(place_type(builder.locals, payload)):
        Some(exclusive) =>
            reference = exclusive
        None => return Err("unsupported Body IR in-place pattern payload without an exclusive reference")
    builder.locals[local].ty = reference
    builder.emit(plan_assign(plan_place(local, span), RvalueKind.MutBorrow(payload), span))
    return Ok(None)


def lower_sequence_builtin(
    mut builder: Builder,
    builtin: &RustBuiltin,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Admit homogeneous list sorting and the legacy integer sum domain."""
    if len(arguments) != 1:
        return Err("unsupported Body IR sequence builtin arity")
    receiver = argument_place(builder, arguments, 0, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, receiver), "unsupported Body IR sequence builtin type")?
    if depth != 1 and builtin == RustBuiltin.Sum:
        return Err("unsupported Body IR nested sequence builtin")
    if builtin == RustBuiltin.Sorted:
        if leaf != ListLeaf.Float or depth != 1:
            require_sort_order(builder, list_element(leaf, depth))?
    reference = borrowed_list_argument(builder, arguments, 0, false, span)?
    if builtin == RustBuiltin.Sum:
        mut name = "sum_int"
        if leaf == ListLeaf.Bool:
            name = "sum_bool"
        elif leaf != ListLeaf.Int:
            return Err("unsupported Body IR builtin Sum element")
        output = call_destination(builder, destination, PlanType.Int, span)?
        external_call(
            builder,
            f"incan_native_runtime::{name}",
            [PlanType.ListRef(leaf, depth)],
            PlanType.Int,
            [reference],
            output,
            span,
        )
        return Ok(None)
    result = PlanType.List(leaf, depth)
    output = call_destination(builder, destination, result, span)?
    if leaf == ListLeaf.Float and depth == 1:
        external_call(
            builder,
            "incan_native_runtime::sorted_float",
            [PlanType.ListRef(leaf, depth)],
            result,
            [reference],
            output,
            span,
        )
        builder.owned.append(output.local)
    else:
        list_call(
            builder,
            "sorted_list",
            list_element(leaf, depth),
            [PlanType.ListRef(leaf, depth)],
            result,
            [reference],
            output,
            span,
        )
    return Ok(None)


def require_sort_order(builder: Builder, element: PlanType) -> Result[None, str]:
    """
    Require retained native ordering for new model and compound sorting shapes.

    A model's Rust Ord derive is executable authority; a source Ord adoption alone does not prove its native dunders.
    Existing scalar and enum leaves retain their established profile. Floating elements inside a compound value have
    no Rust Ord implementation, unlike the separately admitted flat floating-list partial-order sort.
    """
    match element:
        PlanType.Model(owner, _name) =>
            if owner >= len(builder.nominals) or "Ord" not in builder.nominals[owner].derives:
                return Err("unsupported Body IR Sorted nominal without a retained Ord derive")
        PlanType.Tuple(elements) =>
            for item in elements:
                require_sort_order(builder, tuple_element_type(item))?
        PlanType.Float => return Err("unsupported Body IR Sorted compound containing float")
        PlanType.List(_leaf, _depth) =>
            leaf, depth = require_list_shape(element, "unsupported Body IR Sorted compound list")?
            require_sort_order(builder, list_element(leaf, depth))?
        _ => pass
    return Ok(None)


def lower_list_repeat(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """
    Clone one owned value `count` times into a new list through legacy's runtime helper.

    The element type is the checked list the call assigns. The value moves into the helper, so a value read from a
    binding arrives as the copy its ownership fact already made.
    """
    if len(arguments) != 2:
        return Err("unsupported Body IR list_repeat arity")
    match destination:
        Some(_place) => pass
        None => return Err("unsupported Body IR discarded list_repeat")
    output = call_destination(builder, destination, PlanType.Unit, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, output), "unsupported Body IR list_repeat type")?
    element = list_element(leaf, depth)
    types = [element, PlanType.Int]
    mut operands: list[Operand] = []
    for index in range(2):
        match arguments[index].as_one():
            Some(value) => operands.append(call_argument_operand(builder, value, types[index], span, true)?)
            None => return Err("unsupported Body IR list_repeat spread")
    list_call(
        builder,
        "repeat_list",
        element,
        [element, PlanType.Int],
        PlanType.List(leaf, depth),
        operands,
        output,
        span,
    )
    return Ok(None)


def lower_list_concat(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Borrow both concatenation inputs and retain one new list owner."""
    if len(arguments) != 2:
        return Err("unsupported Body IR list_concat arity")
    receiver = argument_place(builder, arguments, 0, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, receiver), "unsupported Body IR list_concat type")?
    other = argument_place(builder, arguments, 1, span)?
    other_leaf, other_depth = require_list_shape(
        place_type(builder.locals, other),
        "unsupported Body IR list_concat type",
    )?
    if leaf != other_leaf or depth != other_depth:
        return Err("unsupported Body IR mixed list_concat type")
    operands = [borrowed_list_argument(builder, arguments, 0, false, span)?, borrowed_list_argument(
        builder,
        arguments,
        1,
        false,
        span,
    )?]
    result = PlanType.List(leaf, depth)
    output = call_destination(builder, destination, result, span)?
    list_call(
        builder,
        "concat_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth), PlanType.ListRef(leaf, depth)],
        result,
        operands,
        output,
        span,
    )
    return Ok(None)


def lower_truth_builtin(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve builtin truthiness for admitted scalars, lists, and hashed collections."""
    output = call_destination(builder, destination, PlanType.Bool, span)?
    if len(arguments) == 0:
        builder.emit(plan_assign(output, RvalueKind.Use(literal(Constant.Bool(false), span)), span))
        return Ok(None)
    if len(arguments) != 1:
        return Err("unsupported Body IR Bool arity")
    ty = argument_type(builder, arguments, 0, span)?
    match scalar_builtin(RustBuiltin.Bool, ty):
        Some((name, result)) =>
            operand = argument_value(builder, arguments, 0, span)?
            external_call(builder, f"incan_native_runtime::{name}", [ty], result, [operand], output, span)
            return Ok(None)
        None => pass
    if ty in [PlanType.String, PlanType.StringRef, PlanType.FrozenStr]:
        match arguments[0].as_one():
            Some(value) =>
                # Legacy's StaticStr constant falls through bool() to true, even for empty text.
                match value:
                    RustOperand.Constant(RustConstant.FrozenStr(_text)) =>
                        builder.emit(plan_assign(output, RvalueKind.Use(literal(Constant.Bool(true), span)), span))
                        return Ok(None)
                    _ => pass
                incoming = builder.owned
                reference = borrow_text_operand(builder, value, span)?
                external_call(
                    builder,
                    "incan_native_runtime::truth_text",
                    [PlanType.StringRef],
                    PlanType.Bool,
                    [reference],
                    output,
                    span,
                )
                drop_borrowed_text_temporaries(builder, incoming, output.local, span)
                return Ok(None)
            None => return Err("unsupported Body IR Bool spread")
    if is_collection(ty):
        receiver = argument_place(builder, arguments, 0, span)?
        reference = borrow_collection(builder, receiver, false, span)?
        length = temporary(builder, PlanType.Int, span)
        collection_call(
            builder,
            ty,
            "length",
            [collection_reference(ty, false)],
            PlanType.Int,
            [reference],
            length,
            span,
        )?
        builder.emit(
            plan_assign(
                output,
                RvalueKind.Binary(BinaryOp.NotEqual, read_place(length, false, span), literal(Constant.Int(0), span)),
                span,
            ),
        )
        return Ok(None)
    if is_list(ty):
        leaf, depth = require_list_shape(ty, "unsupported Body IR Bool list")?
        reference = borrowed_list_argument(builder, arguments, 0, false, span)?
        list_call(
            builder,
            "truth_list",
            list_element(leaf, depth),
            [PlanType.ListRef(leaf, depth)],
            PlanType.Bool,
            [reference],
            output,
            span,
        )
        return Ok(None)
    return Err("unsupported Body IR builtin Bool type")


def lower_power_operator(
    mut builder: Builder,
    destination: Place,
    left: &RustOperand,
    right: &RustOperand,
    span: SourceSpan,
) -> Result[None, str]:
    """Bind exponentiation to the checked result carrier, as legacy's `powf` and `pow` do."""
    mut operands = [scalar_operator_operand(builder, left, span)?, scalar_operator_operand(builder, right, span)?]
    target = place_type(builder.locals, destination)
    # A float result is a retained checker fact: legacy converts every numeric operand to that carrier before `powf`,
    # so an `int` exponent and an `f32` base both widen here.
    if target in [PlanType.Float, PlanType.F32, PlanType.F64]:
        for index in range(2):
            source = operand_type(builder, operands[index])?
            if source != target and not numeric_carrier(source):
                return Err("unsupported Body IR mixed Pow operands")
            operands[index] = coerce_numeric_operand(builder, operands[index], target, span)?
    elif target != PlanType.Int and integer_carrier(target):
        return lower_exact_integer_power(builder, destination, operands, target, span)
    emit_power_operator(builder, destination, operands, span)?
    validate_exact_float(builder, destination, span)
    return Ok(None)


def lower_exact_integer_power(
    mut builder: Builder,
    destination: Place,
    operands: list[Operand],
    target: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """Raise an exact-width integer base through the runtime power for its carrier."""
    # The checked result keeps the base's carrier. Legacy calls that carrier's `pow` with the exponent cast to `u32`;
    # the runtime helper takes an `int` exponent and truncates it the same way.
    if operand_type(builder, operands[0])? != target:
        return Err("unsupported Body IR mixed Pow operands")
    exponent = coerce_numeric_operand(builder, operands[1], PlanType.Int, span)?
    external_call(
        builder,
        f"incan_native_runtime::power_{numeric_name(target)}",
        [target, PlanType.Int],
        target,
        [operands[0], exponent],
        destination,
        span,
    )
    return Ok(None)


pub def text_argument(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Borrow one text argument without consuming a caller-owned string."""
    if index >= len(arguments):
        return Err("invalid Body IR text argument arity")
    match arguments[index].as_one():
        Some(value) => return borrow_text_operand(builder, value, span)
        None => return Err("unsupported Body IR text argument spread")


def lower_split_helper(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Select explicit and omitted separators without admitting general Option lowering."""
    if len(arguments) < 1 or len(arguments) > 2:
        return Err("invalid Body IR str_split arity")
    mut omitted = len(arguments) == 1
    if len(arguments) == 2:
        match arguments[1].as_one():
            Some(RustOperand.Constant(RustConstant.None)) =>
                omitted = true
            _ => pass
    mut name = "split_default_text"
    mut parameters = [PlanType.StringRef]
    mut operands = [text_argument(builder, arguments, 0, span)?]
    if not omitted:
        name = "split_text"
        parameters.append(PlanType.StringRef)
        operands.append(text_argument(builder, arguments, 1, span)?)
    result = PlanType.List(ListLeaf.Str, 1)
    output = call_destination(builder, destination, result, span)?
    external_call(builder, f"incan_native_runtime::{name}", parameters, result, operands, output, span)
    builder.owned.append(output.local)
    return Ok(None)


def lower_join_helper(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Join only an admitted flat string list through the canonical runtime helper."""
    if len(arguments) != 2:
        return Err("invalid Body IR str_join arity")
    values = argument_place(builder, arguments, 1, span)?
    leaf, depth = require_list_shape(place_type(builder.locals, values), "unsupported Body IR str_join input")?
    if leaf != ListLeaf.Str or depth != 1:
        return Err("unsupported Body IR str_join element")
    operands = [text_argument(builder, arguments, 0, span)?, borrowed_list_argument(builder, arguments, 1, false, span)?]
    output = call_destination(builder, destination, PlanType.String, span)?
    external_call(
        builder,
        "incan_native_runtime::join_text",
        [PlanType.StringRef, PlanType.ListRef(ListLeaf.Str, 1)],
        PlanType.String,
        operands,
        output,
        span,
    )
    return Ok(None)


pub def argument_type(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    index: int,
    span: SourceSpan,
) -> Result[PlanType, str]:
    """Read an argument's retained carrier before selecting a borrow, avoiding an accidental owned read."""
    if index >= len(arguments):
        return Err("invalid Body IR argument type arity")
    match arguments[index].as_one():
        Some(RustOperand.Place(read)) =>
            match read.place.global():
                Some(global) =>
                    if is_computed_static(builder.statics[static_slot(builder.statics, global)?]):
                        return computed_static_type(builder, read.place, global)
                    return model_type(builder.nominals, global.ty)
                None => pass
            if is_element_place(builder, read.place)?:
                return element_place_type(builder, read.place)
            place = scalar_place(builder, read.place, span)?
            return Ok(place_type(builder.locals, place))
        Some(RustOperand.Constant(RustConstant.Str(_text))) => return Ok(PlanType.String)
        Some(RustOperand.Constant(RustConstant.FrozenStr(_text))) => return Ok(PlanType.FrozenStr)
        Some(value) =>
            operand = value_operand(builder, value, span)?
            return operand_type(builder, operand)
        None => return Err("unsupported Body IR argument type spread")


def lower_try_propagation(
    mut builder: Builder,
    destination: &RustPlace,
    operand: &RustOperand,
    routing: &TryErrorRouting,
    span: SourceSpan,
) -> Result[None, str]:
    """Materialize the checked Result read before consuming its selected payload on either propagation edge."""
    match routing:
        TryErrorRouting.SameType(error_type=_error) => pass
        TryErrorRouting.ConversionRequired(source_error_type=_source, destination_error_type=_destination) =>
            return Err("unsupported Body IR TryPropagate error conversion without retained conversion target")
        _ => return Err("unsupported Body IR unresolved TryPropagate error routing")
    value = value_operand(builder, operand, span)?
    ty = operand_type(builder, value)?
    source = temporary(builder, ty, span)
    track_rvalue_moves(builder, RvalueKind.Use(value))
    builder.emit(plan_assign(source, RvalueKind.Use(value), span))
    builder.owned.append(source.local)
    target = scalar_place(builder, destination, span)?
    return propagate_result(builder, source, target, span)


def lower_result_construction(
    mut builder: Builder,
    target: Place,
    variant: &RustResultVariant,
    span: SourceSpan,
) -> Result[None, str]:
    """Construct the checker-selected Result variant in its concrete standard carrier."""
    owner = enum_owner(place_type(builder.locals, target))?
    if owner < len(builder.enums):
        return Err("invalid Body IR Result destination")
    declaration = builder.intrinsics[owner - len(builder.enums)]
    if declaration.carrier != "Result" or not variant.has_complete_canonical_types():
        return Err("invalid Body IR Result payload identity")
    mut slot = 0
    if variant.kind == ResultVariantKind.Err:
        slot = 1
    operand = boundary_operand(builder, variant.payload, declaration.variants[slot].fields[0], span)?
    assign_carrier(builder, target, owner, slot, [operand], span)
    return Ok(None)


def lower_option_construction(
    mut builder: Builder,
    target: Place,
    elements: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[None, str]:
    """Build only an explicitly retained intrinsic Some node in the checked Option destination."""
    owner = enum_owner(place_type(builder.locals, target))?
    if owner < len(builder.enums) or builder.intrinsics[owner - len(builder.enums)].carrier != "Option" or len(elements) != 1:
        return Err("invalid Body IR Some destination or payload")
    match elements[0].as_one():
        Some(payload) =>
            ty = builder.intrinsics[owner - len(builder.enums)].variants[1].fields[0]
            value = boundary_operand(builder, payload, ty, span)?
            assign_carrier(builder, target, owner, 1, [value], span)
            return Ok(None)
        _ => return Err("unsupported Body IR Some spread payload")


def lower_none_assignment(
    mut builder: Builder,
    target: Place,
    _value: &RustRvalue,
    span: SourceSpan,
) -> Result[None, str]:
    """Assign the typed None value through the standard carrier ownership path."""
    ty = place_type(builder.locals, target)
    value = none_operand(builder, ty, span)?
    if is_nominal_type(ty):
        replace_owned_destination(builder, target, RvalueKind.Use(value), span)
    else:
        track_rvalue_moves(builder, RvalueKind.Use(value))
        builder.emit(plan_assign(target, RvalueKind.Use(value), span))
    return Ok(None)


def lower_carrier_method(
    mut builder: Builder,
    method: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Materialize intrinsic call arguments, then delegate the carrier's branch and ownership operations."""
    source = carrier_receiver(builder, arguments, span)?
    _owner, declaration = carrier_layout(builder, place_type(builder.locals, source))?
    if method.intrinsic_carrier != Some(declaration.carrier):
        return Err("invalid Body IR intrinsic carrier method identity")
    name = str(method.name)
    mut ty = PlanType.Bool
    mut fallback: Option[Operand] = None
    mut arity = 1
    if name == "unwrap_or" or name == "unwrap":
        if name == "unwrap_or":
            arity = 2
        # The present payload lives in Option's `Some` slot one and Result's `Ok` slot zero.
        mut slot = 0
        if declaration.carrier == "Option":
            slot = 1
        ty = declaration.variants[slot].fields[0]
    if len(arguments) != arity:
        return Err("unsupported Body IR intrinsic carrier method arity")
    if arity == 2:
        match arguments[1].as_one():
            Some(value) =>
                fallback = Some(boundary_operand(builder, value, ty, span)?)
            None => return Err("unsupported Body IR carrier fallback spread")
    target = call_destination(builder, destination, ty, span)?
    return lower_carrier_method_plan(builder, name, source, target, fallback, span)


def carrier_receiver(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[Place, str]:
    """
    The place a carrier method reads: the receiver itself, or a copy of a list element.

    An element is read out of its list as any element read is, as legacy's checked `list_get` reads it; the copy drops
    when its scope ends.
    """
    if len(arguments) == 0:
        return Err("invalid Body IR intrinsic carrier method arity")
    match arguments[0].as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) =>
                    if indexes_a_list(read.place):
                        return element_copy(builder, read.place, span)
                _ => pass
        None => pass
    return argument_place(builder, arguments, 0, span)


def indexes_a_list(place: &RustPlace) -> bool:
    """Report whether a place reaches its value through a list index."""
    for projection in place.projection:
        match projection:
            PlaceElem.Index(_index) => return true
            _ => pass
    return false


def element_copy(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Read a list element into an owned copy and return its place."""
    match indexed_read(builder, source, span)?.kind:
        OperandKind.Move(place) => return Ok(place)
        OperandKind.Copy(place) => return Ok(place)
        _ => return Err("unsupported Body IR carrier receiver element")


def typed_carrier_operand(
    mut builder: Builder,
    operand: &RustOperand,
    ty: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Materialize checked carrier and text conversions at a concrete call, return, or collection boundary."""
    if ty == PlanType.FrozenStr:
        return frozen_operand(builder, operand, span)
    match operand:
        RustOperand.Constant(RustConstant.None) => return none_operand(builder, ty, span)
        _ => pass
    value = value_operand(builder, operand, span)?
    if ty == PlanType.String and operand_type(builder, value)? == PlanType.FrozenStr:
        text = display_plan_operand(builder, value, span)?
        return Ok(read_place(text, true, span))
    return Ok(value)


def frozen_operand(mut builder: Builder, value: &RustOperand, span: SourceSpan) -> Result[Operand, str]:
    """Keep only checked static literals or existing frozen values; dynamic text remains named-refused."""
    match value:
        RustOperand.Constant(constant) => return frozen_literal(builder, constant, span)
        RustOperand.Place(_read) =>
            operand = value_operand(builder, value, span)?
            if operand_type(builder, operand)? != PlanType.FrozenStr:
                return Err("unsupported Body IR dynamic text to FrozenStr conversion")
            return Ok(operand)
