"""Native comparison bridge symbols selected exclusively from checked standard trait implementations."""

from rust::incan_semantics_core import (
    CanonicalSymbolId,
    SymbolOrigin,
    SemanticSourceTargetKind,
    SymbolNamespace,
    IncanType as RustType,
    IncanPrimitiveType,
)
from rust::incan_semantics_core::body_ir import BodyIrModule, Body, MethodTarget, CallableParamDefault
from pub::incan_mir_plan import PlanType, EnumDeclaration
from classes import frame_type, function_name
from decls import library_item, library_enum_item


pub def standard_comparison_slot(identity: &CanonicalSymbolId, name: str) -> bool:
    """Require the checked member identity of the standard comparison protocol, in source or SDK form."""
    if identity.kind != SemanticSourceTargetKind.Method or identity.namespace != SymbolNamespace.Member or identity.declaration_name != name:
        return false
    match identity.origin:
        SymbolOrigin.Module(path) =>
            return len(path) == 3 and path[0] == "std" and path[1] == "derives" and path[2] == "comparison"
        SymbolOrigin.Package(library=library, module_path=path) =>
            return library == "incan_stdlib_core" and len(path) == 2 and path[0] == "derives" and path[1] == "comparison"
        _ => return false


pub def comparison_functions(module: &BodyIrModule, intrinsics: list[EnumDeclaration]) -> Result[list[list[str]], str]:
    """Retain one borrowed equality body, and all four owned ordering bodies when a checked source Ord slot is supplied."""
    mut owners: list[list[str]] = []
    for owner in range(len(module.nominal_declarations)):
        if library_item(module.nominal_declarations[owner]) != "":
            owners.append([])
            continue
        mut symbols: list[str] = []
        match module.nominal_declarations[owner].comparison_equality:
            Some(_identity) =>
                symbols.append(comparison_body(module, owner, "__eq__", true, intrinsics)?)
                if source_slot(module, owner, "__lt__"):
                    for name in ["__lt__", "__le__", "__gt__", "__ge__"]:
                        symbols.append(comparison_body(module, owner, name, false, intrinsics)?)
            None => pass
        owners.append(symbols)
    return Ok(owners)


def source_slot(module: &BodyIrModule, owner: int, name: str) -> bool:
    """A retained source body filling this owner's canonical standard slot authorizes a bridge."""
    identity = module.nominal_declarations[owner].canonical
    for implementation in module.trait_implementations:
        if implementation.owner == identity and standard_comparison_slot(implementation.method, name):
            return implementation.implementation != implementation.method
    return false


def comparison_body(
    module: &BodyIrModule,
    owner: int,
    name: str,
    borrowed: bool,
    intrinsics: list[EnumDeclaration],
) -> Result[str, str]:
    """Resolve a selected non-generic implementation with its exact shared receiver and legacy other-operand ABI."""
    declaration = module.nominal_declarations[owner]
    mut selected: Option[CanonicalSymbolId] = None
    for implementation in module.trait_implementations:
        if implementation.owner != declaration.canonical or not standard_comparison_slot(implementation.method, name):
            continue
        match selected:
            Some(previous) =>
                if previous != implementation.implementation:
                    return Err("unsupported Body IR ambiguous native comparison implementation")
            None =>
                selected = Some(implementation.implementation.clone())
    match selected:
        None => return Err(f"unsupported Body IR unavailable native comparison slot {name}")
        Some(identity) =>
            if name == "__eq__" and module.nominal_declarations[owner].comparison_equality != Some(identity.clone()):
                return Err("unsupported Body IR mismatched native equality witness")
            for body in module.bodies:
                if body.canonical != Some(identity.clone()) or len(body.params) != 2:
                    continue
                first = body.locals[int(body.params[0].local.index())]
                match frame_type(module, first, intrinsics):
                    Ok(receiver) =>
                        if receiver == PlanType.ModelRef(owner, str(declaration.name)):
                            validate_comparison_body(module, body, owner, borrowed, intrinsics)?
                            return Ok(function_name(module, body))
                    Err(_reason) => pass
    return Err(f"unsupported Body IR unavailable published native comparison body {name}")


def validate_comparison_body(
    module: &BodyIrModule,
    body: &Body,
    owner: int,
    borrowed: bool,
    intrinsics: list[EnumDeclaration],
) -> Result[None, str]:
    """Admit only concrete bool functions with the validated source owner's two native input carriers."""
    if len(body.type_parameters) != 0 or len(body.params) != 2:
        return Err("unsupported Body IR generic or nonbinary native comparison body")
    name = str(module.nominal_declarations[owner].name)
    reference = PlanType.ModelRef(owner, name)
    first = body.locals[int(body.params[0].local.index())]
    second = body.locals[int(body.params[1].local.index())]
    mut expected = PlanType.Model(owner, name)
    if borrowed:
        expected = reference
        match body.params[1].default:
            CallableParamDefault.Required => pass
            _ => return Err("unsupported Body IR native equality with a defaulted other operand")
    if frame_type(module, first, intrinsics)? != reference or frame_type(module, second, intrinsics)? != expected:
        return Err("unsupported Body IR native comparison input ABI")
    if body.return_type != RustType.Primitive(IncanPrimitiveType.Bool):
        return Err("unsupported Body IR native comparison result ABI")
    return Ok(None)


pub def source_equality_value(module: &BodyIrModule, target: &MethodTarget, body: &Body) -> Option[PlanType]:
    """Keep owned source operands for exact own equality calls or a checked enum slot dispatching to that body."""
    if body.canonical == None:
        return None
    for owner in range(len(module.nominal_declarations)):
        if target.canonical == body.canonical and module.nominal_declarations[owner].comparison_equality == body.canonical:
            return Some(PlanType.Model(owner, str(module.nominal_declarations[owner].name)))
    for owner in range(len(module.enum_declarations)):
        declaration = module.enum_declarations[owner]
        for implementation in module.trait_implementations:
            if implementation.owner == declaration.canonical and standard_comparison_slot(
                implementation.method,
                "__eq__",
            ) and Some(implementation.implementation.clone()) == body.canonical and (target.canonical == body.canonical or target.canonical == Some(
                implementation.method.clone(),
            )):
                if len(body.params) == 2 and body.params[1].ty == RustType.Ref(RustType.Named(str(declaration.name))):
                    return Some(PlanType.Enum(owner, str(declaration.name)))
    return None


pub def enum_comparison_functions(
    module: &BodyIrModule,
    intrinsics: list[EnumDeclaration],
) -> Result[list[list[str]], str]:
    """Select enum bridges from checked standard slots and their retained borrowed equality ABI, never variant order."""
    mut owners: list[list[str]] = []
    for owner in range(len(module.enum_declarations)):
        declaration = module.enum_declarations[owner]
        mut symbols: list[str] = []
        if library_enum_item(declaration) == "" and len(declaration.type_parameters) == 0:
            for implementation in module.trait_implementations:
                if implementation.owner != declaration.canonical or not standard_comparison_slot(
                    implementation.method,
                    "__eq__",
                ):
                    continue
                if implementation.implementation == implementation.method:
                    continue
                symbols.append(enum_comparison_body(module, owner, "__eq__", true, intrinsics)?)
                for slot in module.trait_implementations:
                    if slot.owner == declaration.canonical and standard_comparison_slot(slot.method, "__lt__") and slot.implementation != slot.method:
                        for name in ["__lt__", "__le__", "__gt__", "__ge__"]:
                            symbols.append(enum_comparison_body(module, owner, name, false, intrinsics)?)
                        break
                break
        owners.append(symbols)
    return Ok(owners)


pub def attach_enum_comparisons(
    module: &BodyIrModule,
    mut declarations: list[EnumDeclaration],
    intrinsics: list[EnumDeclaration],
) -> Result[None, str]:
    """Attach checked source bridges and remove only native comparison derives replaced by those exact bodies."""
    selected = enum_comparison_functions(module, intrinsics)?
    for owner in range(len(module.enum_declarations)):
        declarations[owner].comparison_methods = selected[owner]
        if len(selected[owner]) != 0:
            mut derives: list[str] = []
            for derive in declarations[owner].derives:
                if derive not in ["PartialEq", "Eq", "PartialOrd", "Ord"]:
                    derives.append(derive)
            declarations[owner].derives = derives
    return Ok(None)


def enum_comparison_body(
    module: &BodyIrModule,
    owner: int,
    name: str,
    borrowed: bool,
    intrinsics: list[EnumDeclaration],
) -> Result[str, str]:
    """Require the unique checked enum slot body and its exact two-input bool ABI before planning a native bridge."""
    declaration = module.enum_declarations[owner]
    mut selected: Option[CanonicalSymbolId] = None
    for implementation in module.trait_implementations:
        if implementation.owner != declaration.canonical or not standard_comparison_slot(implementation.method, name):
            continue
        match selected:
            Some(previous) =>
                if previous != implementation.implementation:
                    return Err("unsupported Body IR ambiguous enum comparison implementation")
            None =>
                selected = Some(implementation.implementation.clone())
    match selected:
        None => return Err(f"unsupported Body IR unavailable enum comparison slot {name}")
        Some(identity) =>
            for body in module.bodies:
                if body.canonical != Some(identity.clone()) or len(body.params) != 2:
                    continue
                if len(body.type_parameters) != 0 or body.return_type != RustType.Primitive(IncanPrimitiveType.Bool):
                    return Err("unsupported Body IR generic or nonboolean enum comparison body")
                reference = PlanType.EnumRef(owner, str(declaration.name))
                mut other = PlanType.Enum(owner, str(declaration.name))
                if borrowed:
                    other = reference
                first = body.locals[int(body.params[0].local.index())]
                second = body.locals[int(body.params[1].local.index())]
                if frame_type(module, first, intrinsics)? != reference or frame_type(module, second, intrinsics)? != other:
                    continue
                match body.params[1].default:
                    CallableParamDefault.Required => return Ok(function_name(module, body))
                    _ => return Err("unsupported Body IR defaulted enum comparison operand")
    return Err(f"unsupported Body IR unavailable published enum comparison body {name}")
