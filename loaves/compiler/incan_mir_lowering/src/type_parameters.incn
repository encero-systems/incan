"""Closed native callable instances selected exclusively by checked call-site arguments."""

from rust::incan_semantics_core import (
    IncanCallableParam as RustCallableParam,
    IncanType as RustType,
    SemanticSourceTargetKind,
    SymbolOrigin,
    CanonicalSymbolId,
    function_type,
    generic,
    native_array_type,
)
from rust::incan_semantics_core::body_ir import (
    Body,
    BodyIrModule,
    NamedCallableTarget,
    LocalId as RustLocalId,
    nominal_carrier_key,
    TraitDefaultInstantiation,
)
from rust::std::vec import Vec as NativeVec
from symbols import type_component


pub model Instance:
    """One retained declaration and checked arguments; original-callable requests select the retained source role."""

    pub body: Body
    pub arguments: list[RustType]
    pub owned_callable_slots: list[int]
    # Ordinary recursive calls still request the visible wrapper, even from a retained original.
    pub original_callable: bool


pub def static_type_arguments(module: &BodyIrModule, target: &NamedCallableTarget) -> Result[list[RustType], str]:
    """
    Return an associated call's checked owner arguments followed by its method arguments.

    1. Validate and retain the receiver's owner arguments.
    2. Append the method's checked arguments in declaration order.
    """
    # 1. Validate and retain the receiver's owner arguments.
    mut arguments = static_owner_arguments(module, target)?
    # 2. Append the method's checked arguments in declaration order.
    for argument in target.type_args:
        arguments.append(argument.clone())
    return Ok(arguments)


def static_owner_arguments(module: &BodyIrModule, target: &NamedCallableTarget) -> Result[list[RustType], str]:
    """Read an applied receiver only when its retained canonical template confirms the owner and arity."""
    match target.receiver_type:
        Some(ty) =>
            match ty:
                RustType.Generic(base=base, args=owner_arguments) =>
                    for declaration in module.nominal_declarations:
                        if declaration.template_carrier_name() != str(base):
                            continue
                        if len(declaration.type_parameters) != len(owner_arguments):
                            return Err(f"unsupported Body IR static owner type argument arity on {base}")
                        mut arguments: list[RustType] = []
                        for argument in owner_arguments:
                            arguments.append(argument.clone())
                        return Ok(arguments)
                    return Err(f"unsupported Body IR static receiver {base}")
                _ => return Ok([])
        None => return Ok([])


pub def substitute(ty: &RustType, names: list[str], arguments: list[RustType]) -> Result[RustType, str]:
    """Substitute declared placeholders through structural types and references without inferring bindings from operands or source spelling."""
    match ty:
        RustType.TypeVar(name) =>
            for index in range(len(names)):
                if names[index] == str(name):
                    return Ok(arguments[index].clone())
            return Err(f"unsupported Body IR unbound type parameter {name} in binding scope {names}")
        RustType.Named(name) =>
            # A named declaration is not a placeholder, even when its spelling matches a type parameter.
            return Ok(ty.clone())
        RustType.Ref(inner) =>
            concrete: RustType = substitute(inner, names, arguments)?
            return Ok(RustType.Ref(concrete.clone()))
        RustType.RefMut(inner) =>
            concrete: RustType = substitute(inner, names, arguments)?
            return Ok(RustType.RefMut(concrete.clone()))
        RustType.NativeArray(element=element, length=length) =>
            concrete: RustType = substitute(element, names, arguments)?
            return Ok(native_array_type(concrete, length.clone()))
        RustType.Generic(base=base, args=elements) =>
            mut concrete: list[RustType] = []
            for element in elements:
                closed: RustType = substitute(element, names, arguments)?
                concrete.append(closed.clone())
            # Work around legacy struct-variant construction; removed in dev.8.
            return Ok(generic(str(base), concrete))
        RustType.Tuple(elements) =>
            mut concrete: list[RustType] = []
            for element in elements:
                closed: RustType = substitute(element, names, arguments)?
                concrete.append(closed.clone())
            return Ok(RustType.Tuple(concrete))
        RustType.Function(params=parameters, return_type=result) =>
            # A callable parameter such as `transform: (T) -> U` closes with its instance like any other parameter.
            mut closed_parameters: list[RustCallableParam] = []
            for parameter in parameters:
                mut closed_parameter = parameter.clone()
                closed_parameter.ty = substitute(parameter.ty, names, arguments)?
                closed_parameters.append(closed_parameter)
            closed_result: RustType = substitute(result, names, arguments)?
            # Work around legacy struct-variant construction; removed in dev.8.
            return Ok(function_type(closed_parameters, closed_result))
        _ => return Ok(ty.clone())


pub def close_trait_environment(
    environment: Option[TraitDefaultInstantiation],
    names: list[str],
    arguments: list[RustType],
) -> Result[Option[TraitDefaultInstantiation], str]:
    """
    Close a derived default scope with the same owner or method instance as its frame.

    1. Preserve the absence of a default scope.
    2. Substitute instance arguments through the receiver and trait bindings.
    """
    # 1. Ordinary source bodies have no derived trait scope.
    match environment:
        None => return Ok(None)
        Some(retained) =>
            # 2. Close the complete retained scope without merging its binders into method binders.
            mut closed = retained.clone()
            receiver: RustType = substitute(retained.receiver_type, names, arguments).map_err(
                (reason) => f"{reason} in trait-default receiver",
            )?
            closed.receiver_type = receiver
            for index in range(len(closed.arguments)):
                argument: RustType = substitute(closed.arguments[index].argument, names, arguments).map_err(
                    (reason) => f"{reason} in trait-default argument",
                )?
                closed.arguments[index].argument = argument
            return Ok(Some(closed))


pub def instantiate(body: &Body, arguments: list[RustType], owned_callable_slots: list[int]) -> Result[Body, str]:
    """Close checked types and preserve the value ABI of captured callables passed to original generic parameters."""
    names = body.type_parameters.clone()
    match body.canonical:
        Some(identity) =>
            if (
                identity.kind != SemanticSourceTargetKind.Function
                and identity.kind != SemanticSourceTargetKind.Method
                and identity.kind != SemanticSourceTargetKind.Property
            ):
                return Err("unsupported Body IR declaration with type parameters")
        None => return Err("unsupported Body IR unproven declaration with type parameters")
    if len(names) != len(arguments):
        return Err(f"unsupported Body IR type argument arity on {body.name}")
    storage = callable_storage_arguments(body, arguments, owned_callable_slots)?
    mut result = retain_owned_callable_storage(body, owned_callable_slots)?
    result.trait_default_instantiation = close_trait_environment(body.trait_default_instantiation, names, arguments)?
    pointers = native_pointer_parameters(body, storage)
    if len(pointers) != 0:
        result = retain_native_pointer_storage(result, pointers)
    for index in range(len(result.locals)):
        concrete: RustType = substitute(result.locals[index].ty, names, storage).map_err(
            (reason) => f"{reason} in instantiated local of {body.name}",
        )?
        result.locals[index].ty = source_nominal_storage(body, concrete)?
    for index in range(len(result.params)):
        concrete: RustType = substitute(result.params[index].ty, names, storage)?
        result.params[index].ty = source_nominal_storage(body, concrete)?
    concrete: RustType = substitute(result.return_type, names, storage)?
    result.return_type = source_nominal_storage(body, concrete)?
    mut name = str(body.name)
    for argument in arguments:
        name += type_component(argument)
    for slot in owned_callable_slots:
        name += f"__owned_callable_{slot}"
    result.name = name
    return Ok(result)


pub def callable_storage_arguments(
    body: &Body,
    arguments: list[RustType],
    slots: list[int],
) -> Result[list[RustType], str]:
    """
    1. Read selected generic value slots. 2. Preserve their owned ABI throughout nested native arguments.

    The private structural marker carries an existing Body IR representation selection through substitution; it
    introduces no source type or callable inference. Unselected function types remain function pointers.
    """
    # 1. Read selected generic value slots.
    names = owned_callable_parameters(body, slots)?
    mut storage: list[RustType] = []
    # 2. Preserve the owned ABI throughout nested native arguments.
    for index in range(len(arguments)):
        if body.type_parameters[index] in names:
            owned: RustType = owned_callable_argument(arguments[index])?
            storage.append(owned.clone())
        else:
            storage.append(arguments[index].clone())
    return Ok(storage)


def source_nominal_storage(body: &Body, ty: &RustType) -> Result[RustType, str]:
    """
    Keep source nominal arguments semantic; their declared generic value fields already retain owning storage.

    A bare callable or a native constructor argument keeps its representation marker. Only the direct arguments
    of an identity-bound source nominal use the signature type; this does not guess a carrier from its spelling.
    """
    match ty:
        RustType.Generic(base=base, args=arguments) =>
            source = source_nominal_owner(body, str(base))
            mut retained: list[RustType] = []
            for argument in arguments:
                value: &RustType = argument
                match value:
                    RustType.Generic(base=marker, args=signature) =>
                        if source and str(marker) == "<owned-callable>" and len(signature) == 1:
                            retained.append(source_nominal_storage(body, signature[0])?)
                            continue
                    _ => pass
                retained.append(source_nominal_storage(body, argument)?)
            return Ok(generic(str(base), retained))
        RustType.Ref(inner) => return Ok(RustType.Ref(source_nominal_storage(body, inner)?))
        RustType.RefMut(inner) => return Ok(RustType.RefMut(source_nominal_storage(body, inner)?))
        RustType.TypeToken(inner) => return Ok(RustType.TypeToken(source_nominal_storage(body, inner)?))
        RustType.Tuple(elements) =>
            mut retained: list[RustType] = []
            for element in elements:
                retained.append(source_nominal_storage(body, element)?)
            return Ok(RustType.Tuple(retained))
        RustType.NativeArray(element=element, length=length) =>
            return Ok(native_array_type(source_nominal_storage(body, element)?, length.clone()))
        RustType.Function(params=parameters, return_type=result) =>
            mut retained = parameters.clone()
            for index in range(len(retained)):
                concrete: RustType = source_nominal_storage(body, parameters[index].ty)?
                retained[index].ty = concrete.clone()
            return Ok(function_type(retained, source_nominal_storage(body, result)?))
        _ => return Ok(ty.clone())


def source_nominal_owner(body: &Body, name: str) -> bool:
    """Require the checker's source declaration identity before separating nominal arguments from native storage."""
    match body.named_type_identities.get(str(name)):
        Some(identity) => return source_nominal_identity(identity)
        None => pass
    for identity in body.named_type_identities.values():
        match nominal_carrier_key(identity):
            Some(key) =>
                if str(key) == name:
                    return source_nominal_identity(identity)
            None => pass
    return false


def source_nominal_identity(identity: &CanonicalSymbolId) -> bool:
    """Separate retained source declarations from native constructors by their canonical origin."""
    if (
        identity.kind != SemanticSourceTargetKind.Model
        and identity.kind != SemanticSourceTargetKind.Class
        and identity.kind != SemanticSourceTargetKind.Newtype
        and identity.kind != SemanticSourceTargetKind.Enum
    ):
        return false
    origin: SymbolOrigin = identity.origin
    match origin:
        SymbolOrigin.Module(_path) => return true
        SymbolOrigin.Package(library=_library, module_path=_owner) => return true
        _ => return false


def owned_callable_parameters(body: &Body, slots: list[int]) -> Result[list[str], str]:
    """Read generic binders only from the validated original value slots that own callable environments."""
    mut names: list[str] = []
    for slot in slots:
        if slot < 0 or slot >= len(body.params):
            return Err("invalid owned callable storage slot")
        match body.params[slot].ty:
            RustType.TypeVar(name) => names.append(str(name))
            _ => return Err("invalid owned callable storage binder")
    return Ok(names)


def owned_callable_argument(argument: &RustType) -> Result[RustType, str]:
    """Mark one function signature as owned, retaining an existing marker when a generic call forwards it."""
    match argument:
        RustType.Function(params=_parameters, return_type=_result) =>
            return Ok(generic("<owned-callable>", [argument.clone()]))
        RustType.Generic(base=base, args=elements) =>
            if str(base) == "<owned-callable>" and len(elements) == 1:
                return Ok(argument.clone())
            if str(base) == "<native-callable>" and len(elements) == 1:
                return Ok(generic("<owned-callable>", [argument.clone()]))
        _ => pass
    return Err("invalid owned callable storage argument")


def retain_owned_callable_storage(original: &Body, slots: list[int]) -> Result[Body, str]:
    """Return the updated imported body explicitly; retain owners only for verified generic values and their aliases."""
    mut result = original.clone()
    if len(slots) == 0:
        return Ok(result)
    mut names: list[str] = []
    for slot in slots:
        if slot < 0 or slot >= len(original.params) or original.params[slot].mutable:
            return Err("unsupported Body IR owned generic callable parameter")
        match original.params[slot].ty:
            RustType.TypeVar(name) => names.append(str(name))
            _ => return Err("invalid Body IR owned callable slot outside a generic value parameter")
    match result.callable_representation:
        None => return Err("unsupported Body IR generic callable without representation facts")
        Some(representation) =>
            mut retained = representation.clone()
            # The checked hook marks environment capability, not a borrowed ABI for an original generic value.
            # Owned selection is carried by the local marker; ordinary function parameters keep their shared marker.
            for local in original.locals:
                match local.ty:
                    RustType.TypeVar(name) =>
                        if str(name) in names:
                            if not has_local(retained.closure_holding_locals, local.id):
                                retained.closure_holding_locals.push(local.id)
                    _ => pass
            match original.return_type:
                RustType.TypeVar(name) =>
                    if str(name) in names:
                        retained.closure_holding_return = true
                _ => pass
            result.callable_representation = Some(retained)
    return Ok(result)


def native_pointer_parameters(body: &Body, arguments: list[RustType]) -> list[str]:
    """Select generic binders supplied with exact native function-pointer arguments, excluding owned environments."""
    mut names: list[str] = []
    for index in range(len(arguments)):
        match arguments[index]:
            RustType.Generic(base=base, args=elements) =>
                if str(base) == "<native-callable>" and len(elements) == 1:
                    names.append(str(body.type_parameters[index]))
            _ => pass
    return names


def retain_native_pointer_storage(body: &Body, names: list[str]) -> Body:
    """Keep the selected pointer ABI in every original generic local instead of borrowing a closure object."""
    mut result = body.clone()
    match body.callable_representation:
        Some(representation) =>
            mut retained = representation.clone()
            mut pointers: NativeVec[RustLocalId] = NativeVec.new()
            for local in body.locals:
                match local.ty:
                    RustType.TypeVar(name) =>
                        if str(name) in names:
                            pointers.push(local.id.clone())
                    _ => pass
            local_holds: list[RustLocalId] = without_locals(retained.closure_holding_locals, pointers)
            parameter_holds: list[RustLocalId] = without_locals(retained.closure_holding_parameters, pointers)
            retained.closure_holding_locals = local_holds
            retained.closure_holding_parameters = parameter_holds
            for pointer in pointers:
                if not has_local(retained.function_pointer_locals, pointer):
                    retained.function_pointer_locals.push(pointer.clone())
            match body.return_type:
                RustType.TypeVar(name) =>
                    if str(name) in names:
                        retained.closure_holding_return = false
                _ => pass
            result.callable_representation = Some(retained)
        None => pass
    return result


def without_locals(values: &list[RustLocalId], excluded: &list[RustLocalId]) -> list[RustLocalId]:
    """Remove only locals whose checked generic binder has a separately selected native pointer representation."""
    mut result: list[RustLocalId] = []
    for value in values:
        if not has_local(excluded, value):
            result.append(value.clone())
    return result


def has_local(locals: &list[RustLocalId], sought: &RustLocalId) -> bool:
    """Compare opaque kernel local identities through their public indices, without cloning their Rust vector."""
    for local in locals:
        if int(local.index()) == int(sought.index()):
            return true
    return false
