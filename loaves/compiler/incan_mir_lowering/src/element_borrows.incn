"""
Borrow checked list or dictionary element storage through the runtime's bounds-checked accessors.

Owned reads materialize elements. A checked shared list loan preserves the stored value without requiring Clone;
a `mut self` method or a field write changes the stored element. Field projections follow the resulting loan.
"""

from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    ArgumentElement as RustArgumentElement,
    Place as RustPlace,
    PlaceElem,
    Operand as RustOperand,
    OwnershipFact,
)
from pub::incan_mir_plan import Operand, PlanType, Place, Projection, RvalueKind, SourceSpan
from pub::incan_mir_plan import assign as plan_assign, place as plan_place
from frame import Builder, place_type, temporary, appended_field
from models import field_steps
from lists import require_list_shape, list_element, is_list
from collections import (
    is_collection,
    collection_arguments,
    collection_reference,
    collection_call,
    borrow_collection,
    collection_owned,
)
from builtins import list_call
from model_lists import structural_prefix, prefix_place
from element_places import is_element_place, element_place_type, element_prefix_type
from layout_types import shared_receiver_type
from classes import frame_type
from tuples import is_tuple_type
from lowering import (
    list_borrow,
    list_slice_view,
    scalar_operand,
    value_operand,
    materialized_receiver,
    instantiated_external_call,
)


pub def shared_element_place(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Option[Place], str]:
    """
    Reach a checked shared list element loan without copying its owner or requiring Clone.

    1. Admit a list indexing path before evaluating any index.
    2. Borrow each indexed element and project any structural fields through that loan.
    """
    # 1. Other container reads retain their existing materialization path.
    if not is_shared_list_path(builder, source)?:
        return Ok(None)
    start = element_start(builder, source)?
    mut place = local_root(builder, source, span)?
    if start > 0:
        place = prefix_place(builder, source, start, span)?
    # 2. Each index is evaluated once; the runtime owns negative-index and bounds checks.
    for position in range(start, len(source.projection)):
        match source.projection[position]:
            PlaceElem.Index(index) =>
                if is_tuple_type(place_type(builder.locals, place)):
                    place = projected_field(builder, place, source.projection[position], span)?
                else:
                    argument = scalar_operand(builder, index, span)?
                    place = shared_list_element(builder, place, argument, span)?
            _ => place = projected_field(builder, place, source.projection[position], span)?
    return Ok(Some(place))


def is_shared_list_path(mut builder: Builder, source: &RustPlace) -> Result[bool, str]:
    """Admit only list indices and structural fields, without evaluating a partial path that might be retried."""
    mut indexed = false
    for position in range(len(source.projection)):
        match source.projection[position]:
            PlaceElem.Index(_index) =>
                ty = element_prefix_type(builder, source, position)?
                if not is_list(ty) and not is_tuple_type(ty):
                    return Ok(false)
                indexed = indexed or is_list(ty)
            PlaceElem.Slice(start=_start, end=_end, step=_step) => return Ok(false)
            _ => pass
    return Ok(indexed)


def shared_list_element(mut builder: Builder, container: Place, index: Operand, span: SourceSpan) -> Result[Place, str]:
    """Call the checked runtime accessor returning a shared element reference, with no owned element read."""
    leaf, depth = require_list_shape(place_type(builder.locals, container), "invalid shared list loan")?
    element = list_element(leaf, depth)
    reference = shared_receiver_type(element)?
    output = temporary(builder, reference, span)
    loan = list_borrow(builder, container, false, span)?
    borrowed = list_slice_view(builder, loan, [element], false, span)?
    instantiated_external_call(
        builder,
        "incan_std_core::collections::list_get",
        [element],
        [PlanType.SliceRef([element]), PlanType.Int],
        reference,
        [borrowed, index],
        output,
        span,
    )?
    return Ok(Place(local=output.local, projection=Projection.Deref(element), span=span))


pub def element_method_owner(mut builder: Builder, argument: &RustArgumentElement) -> Result[Option[PlanType], str]:
    """The model or source enum owner of a list or dictionary element receiver; `None` when a native place names it."""
    match argument.as_one():
        Some(RustOperand.Place(read)) =>
            if not is_element_place(builder, read.place)?:
                return Ok(None)
            match element_place_type(builder, read.place)?:
                PlanType.Model(owner, name) => return Ok(Some(PlanType.Model(owner, name)))
                PlanType.Enum(owner, name) =>
                    if owner < len(builder.enums):
                        return Ok(Some(PlanType.Enum(owner, name)))
                _ => pass
            return Err("unsupported Body IR Method on a non-nominal collection element")
        _ => return Ok(None)


pub def element_method_receiver(
    module: &BodyIrModule,
    mut builder: Builder,
    index: int,
    argument: &RustArgumentElement,
    span: SourceSpan,
) -> Result[Place, str]:
    """Borrow a list or dictionary element as the selected method's receiver: in place when `mut self` changes it."""
    receiver_type = frame_type(
        builder.constructors,
        builder.nominals,
        builder.enums,
        module.bodies[index].locals[0],
        builder.intrinsics,
    )?
    match argument.as_one():
        Some(RustOperand.Place(read)) =>
            # Body IR borrows every source receiver; the selected body's `mut self` decides the borrow's exclusivity.
            if read.fact != OwnershipFact.Borrow and read.fact != OwnershipFact.MutBorrow:
                return Err("unsupported Body IR Method receiver ownership")
            match receiver_type:
                PlanType.ModelMutRef(_owner, _name) => return mutable_element_reference(builder, read.place, span)
                PlanType.ModelRef(_owner, _name) =>
                    return shared_element_receiver(builder, read.place, receiver_type, span)
                PlanType.EnumRef(_owner, _name) =>
                    return shared_element_receiver(builder, read.place, receiver_type, span)
                _ => return Err("invalid Body IR Method receiver type")
        _ => return Err("unsupported Body IR Method nonplace or spread receiver")


def shared_element_receiver(
    mut builder: Builder,
    source: &RustPlace,
    receiver_type: PlanType,
    span: SourceSpan,
) -> Result[Place, str]:
    """Borrow a copy of the element as a shared receiver, as any other element read copies it."""
    copied = materialized_receiver(builder, source, span)?
    reference = temporary(builder, receiver_type, span)
    builder.emit(plan_assign(reference, RvalueKind.Borrow(copied), span))
    return Ok(reference)


pub def mutable_element_reference(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Reborrow the nominal element, or a nominal field inside it, that a list or dictionary place selects."""
    place = mutable_element_place(builder, source, span)?
    return model_reference(builder, place, span)


pub def mutable_element_place(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """
    Reach the storage a list or dictionary place selects, so a change through it lands in the container.

    Each index reborrows its element or value through the runtime's checked accessor, and each field after it projects
    through the resulting reference. The result is that reference, or a field place behind it.
    """
    return mutable_element_prefix(builder, source, len(source.projection), span)


pub def mutable_element_prefix(
    mut builder: Builder,
    source: &RustPlace,
    count: int,
    span: SourceSpan,
) -> Result[Place, str]:
    """Reborrow checked element storage up to `count` projections, retaining the container before an assignment's final index."""
    if count < 0 or count > len(source.projection):
        return Err("invalid Body IR element prefix length")
    start = element_start(builder, source)?
    mut place = local_root(builder, source, span)?
    if start > 0:
        place = prefix_place(builder, source, start, span)?
    for position in range(start, count):
        match source.projection[position]:
            PlaceElem.Index(index) =>
                if is_tuple_type(place_type(builder.locals, place)):
                    place = projected_field(builder, place, source.projection[position], span)?
                else:
                    place = borrow_element(builder, place, index, span)?
            PlaceElem.Slice(start=_start, end=_end, step=_step) =>
                return Err("unsupported Body IR mutable borrow through a list slice")
            _ => place = projected_field(builder, place, source.projection[position], span)?
    return Ok(place)


def projected_field(mut builder: Builder, place: Place, projection: &PlaceElem, span: SourceSpan) -> Result[Place, str]:
    """Project a checked model or constant tuple field through its retained element reference."""
    owner = dereferenced(builder, place)
    steps = field_steps(
        builder.constructors,
        builder.nominals,
        place_type(builder.locals, owner),
        projection,
        builder.enums,
        builder.unions,
        builder.intrinsics,
    )?
    mut projected = owner
    for step in steps:
        projected = appended_field(projected, step, span)?
    return Ok(projected)


pub def borrow_element_mut(
    mut builder: Builder,
    receiver: Place,
    index: Operand,
    span: SourceSpan,
) -> Result[Place, str]:
    """Reborrow one nested list or nominal list element through the legacy negative-index and bounds checks."""
    ty = place_type(builder.locals, receiver)
    site = f"{builder.file}:{span.line}:{span.column} in {builder.name}"
    leaf, depth = require_list_shape(
        ty,
        f"unsupported Body IR indexing non-list at {site}; type {ty:?}; exclusive element borrow",
    )?
    element = list_element(leaf, depth)
    result = mutable_reference_type(element)?
    reference = list_borrow(builder, receiver, true, span)?
    output = temporary(builder, result, span)
    list_call(
        builder,
        "borrow_list_mut",
        element,
        [PlanType.ListMutRef(leaf, depth), PlanType.Int],
        result,
        [reference, index],
        output,
        span,
    )
    return Ok(output)


def element_start(mut builder: Builder, source: &RustPlace) -> Result[int, str]:
    """Count the structural steps before the first element index; a list or dictionary root has none."""
    match source.local_id():
        None => return Err("unsupported Body IR mutable borrow of a static element")
        Some(local) =>
            root = builder.locals[int(local.index()) + 1 + builder.local_offset].ty
            if is_list(root) or is_collection(root):
                return Ok(0)
    match structural_prefix(builder, source)?:
        Some((count, _through_tuple)) =>
            if count > 0 and count < len(source.projection):
                return Ok(count)
        None => pass
    return Err("unsupported Body IR mutable borrow of a non-element place")


def local_root(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Place, str]:
    """Map the place's frame local; static storage is a snapshot, so a borrow of it could never change the static."""
    match source.local_id():
        Some(local) => return Ok(plan_place(int(local.index()) + 1 + builder.local_offset, span))
        None => return Err("unsupported Body IR mutable borrow of a static element")


def borrow_element(mut builder: Builder, container: Place, index: &RustOperand, span: SourceSpan) -> Result[Place, str]:
    """Evaluate the index or key first, then reborrow the selected list element or dictionary value."""
    if is_collection(place_type(builder.locals, container)):
        return borrow_dictionary_value(builder, container, index, span)
    argument = scalar_operand(builder, index, span)?
    return borrow_element_mut(builder, container, argument, span)


def borrow_dictionary_value(
    mut builder: Builder,
    container: Place,
    index: &RustOperand,
    span: SourceSpan,
) -> Result[Place, str]:
    """
    Reborrow a stored dictionary value through legacy's missing-key diagnostic.

    The dictionary is a whole local or reference, or an owned dictionary field such as a model's; a reference reached
    through a projection keeps its refusal, because the reborrow dereferences only a whole reference.
    """
    ty = place_type(builder.locals, container)
    if container.projection != Projection.Whole and collection_owned(ty) != ty:
        return Err("unsupported Body IR mutable borrow of a projected dictionary value")
    types = collection_arguments(ty)
    if len(types) != 2:
        return Err("unsupported Body IR set indexing")
    # Legacy dictionary indexing requires Display for its missing-key diagnostic; tuples and unit lack that bound.
    match types[0]:
        PlanType.Tuple(_elements) => return Err("tuple dictionary keys cannot satisfy the lookup's Display requirement")
        PlanType.Unit => return Err("unit dictionary keys cannot satisfy the lookup's Display requirement")
        _ => pass
    result = mutable_reference_type(types[1])?
    key = value_operand(builder, index, span)?
    reference = borrow_collection(builder, container, true, span)?
    output = temporary(builder, result, span)
    collection_call(
        builder,
        ty,
        "borrow_mut",
        [collection_reference(ty, true), types[0]],
        result,
        [reference, key],
        output,
        span,
    )?
    return Ok(output)


def mutable_reference_type(element: PlanType) -> Result[PlanType, str]:
    """The exclusive reference a reborrowed element takes; scalar elements are written by index instead."""
    match element:
        PlanType.List(leaf, depth) => return Ok(PlanType.ListMutRef(leaf, depth))
        PlanType.Model(owner, name) => return Ok(PlanType.ModelMutRef(owner, name))
        PlanType.Dict(key, value) => return Ok(PlanType.DictMutRef(key, value))
        PlanType.Set(leaf) => return Ok(PlanType.SetMutRef(leaf))
        PlanType.Tuple(elements) => return Ok(PlanType.TupleMutRef(elements))
        _ => return Err("unsupported Body IR mutable borrow of a scalar collection element")


def dereferenced(mut builder: Builder, place: Place) -> Place:
    """Project through a whole nominal reference so its fields append to the referent rather than the reference."""
    if place.projection != Projection.Whole:
        return place
    match builder.locals[place.local].ty:
        PlanType.ModelMutRef(owner, name) =>
            return Place(local=place.local, projection=Projection.Deref(PlanType.Model(owner, name)), span=place.span)
        PlanType.TupleMutRef(elements) =>
            return Place(local=place.local, projection=Projection.Deref(PlanType.Tuple(elements)), span=place.span)
        _ => return place


def model_reference(mut builder: Builder, place: Place, span: SourceSpan) -> Result[Place, str]:
    """Return the element's exclusive reference, reborrowing a field path inside it as a reference of its own."""
    match place_type(builder.locals, place):
        PlanType.ModelMutRef(_owner, _name) =>
            if place.projection == Projection.Whole:
                return Ok(place)
        PlanType.Model(owner, name) =>
            reference = temporary(builder, PlanType.ModelMutRef(owner, name), span)
            builder.emit(plan_assign(reference, RvalueKind.MutBorrow(place), span))
            return Ok(reference)
        _ => pass
    return Err("unsupported Body IR mutable Method receiver on a non-nominal element")
