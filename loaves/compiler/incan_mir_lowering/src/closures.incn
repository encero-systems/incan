"""Callable signature admission from checked frontend representation facts."""

from rust::incan_semantics_core import IncanType as RustType, IncanCallableParam, IncanCallableParamKind
from body_index import BodyIndex
from native_type_identity import constructor_index
from rust::incan_semantics_core::body_ir import (
    Body as RustBody,
    BodyIrModule as RustModule,
    Rvalue as RustRvalue,
    CallableParam as RustParameter,
    StatementKind as RustStatementKind,
    Callee as RustCallee,
    CallableTarget as RustCallableTarget,
    NamedCallableTarget as RustNamedTarget,
    LoafCallable,
    DecoratedBinding,
    DecoratedInitialization,
    NominalDeclaration,
    EnumDeclaration as RustEnumDeclaration,
)
from pub::incan_mir_plan import (
    PlanType,
    ListLeaf,
    Operand,
    RvalueKind,
    Callee,
    CalleeKind,
    Function,
    Local,
    Parameter,
    SourceSpan,
    Statement,
    TerminatorKind,
    Unwind,
    OperandKind,
    EnumDeclaration,
    ExternalFunction,
)
from pub::incan_mir_plan import block as plan_block, place as plan_place
from types import primitive_type
from classes import receiver_mode, parameter_local_index
from async_ import evaluator_name
from collections import is_collection, is_owned_collection
from layout_types import native_source_type, context_free_type, callable_parameter_type, collection_leaf
from lists import is_list, parameter_storage_type, is_exclusive_borrow
from numerics import numeric_carrier
from generators import generator_type, is_generator_type
from frame import Builder
from type_parameters import Instance, instantiate, substitute, request_instance
from lowering import call_parameter_type


pub def function_pointer_type(parameters: &list[IncanCallableParam], result: &RustType) -> Result[PlanType, str]:
    """Build the native signature: 1. Retain checked input order and loans. 2. Append the owned return contract."""
    # 1. Retain checked input order and loans.
    mut signature: list[PlanType] = []
    nominals: list[NominalDeclaration] = []
    constructors = constructor_index(nominals)
    enums: list[RustEnumDeclaration] = []
    unions: list[RustType] = []
    intrinsics: list[EnumDeclaration] = []
    for parameter in parameters:
        mut input = PlanType.Unit
        if parameter.kind == IncanCallableParamKind.Normal:
            input = callable_input(parameter.ty)?
        else:
            input = callable_parameter_type(constructors, nominals, enums, unions, parameter, intrinsics)?
        signature.append(packed_input(input, parameter.kind, parameter.is_mut, parameter.native_owned)?)
    # 2. Append the owned return contract.
    signature.append(callable_result(result)?)
    return Ok(PlanType.FunctionPointer(signature))


def callable_input(ty: &RustType) -> Result[PlanType, str]:
    """Retain explicit native input loans; returned values still follow the owned callable component contract."""
    match ty:
        RustType.Ref(_inner) => return context_free_type(ty)
        RustType.RefMut(_inner) => return context_free_type(ty)
        _ => return callable_component(ty)


def callable_result(ty: &RustType) -> Result[PlanType, str]:
    """Admit a callable's result: any admitted component, or a lazy generator, such as a `flat_map` expansion."""
    match generator_type(ty):
        Some(Ok(result)) =>
            if is_generator_type(result):
                return Ok(result)
        _ => pass
    return callable_component(ty)


pub def signature_input(ty: PlanType, mutable: bool, native_owned: bool = false) -> Result[PlanType, str]:
    """
    A callable's input as its declaration's frame receives it: a list or collection by the caller-owned reference, and
    for a `mut` parameter the exclusive borrow of the caller's value.

    A checked native collection consumes its outer value; references inside its elements keep their own ABI.
    """
    # Every function frame stores its parameters this way, so a function item, a lifted closure and an annotated
    # callable type all agree on this one input representation.
    if native_owned:
        if not is_owned_collection(ty):
            return Err("invalid Body IR owned native collection parameter")
        return Ok(ty)
    return Ok(parameter_storage_type(ty, mutable))


pub def semantic_input(
    ty: PlanType,
    kind: IncanCallableParamKind,
    mutable: bool,
    native_owned: bool = false,
) -> Result[PlanType, str]:
    """
    Project a checked callable element onto its parameter ABI.

    1. Preserve ordinary input borrowing.
    2. Refuse mutable rest parameters.
    3. Pack the checked element using the shared collection representation.
    """
    # 1. Preserve ordinary input borrowing.
    if kind == IncanCallableParamKind.Normal:
        return signature_input(ty, mutable, native_owned)
    # 2. Refuse mutable rest parameters.
    if mutable:
        return Err("unsupported Body IR mutable rest parameter")
    # 3. Pack the checked element using the shared collection representation.
    if kind == IncanCallableParamKind.RestPositional:
        match ty:
            PlanType.List(leaf, depth) => return Ok(PlanType.List(leaf, depth + 1))
            _ => pass
        return Ok(PlanType.List(collection_leaf(ty)?, 1))
    if kind == IncanCallableParamKind.RestKeyword:
        return Ok(PlanType.Dict(ListLeaf.Str, collection_leaf(ty)?))
    return Err("unsupported Body IR callable parameter role")


pub def packed_input(
    ty: PlanType,
    kind: IncanCallableParamKind,
    mutable: bool,
    native_owned: bool = false,
) -> Result[PlanType, str]:
    """
    Consume a checked frame pack as owned storage.

    1. Preserve ordinary input borrowing.
    2. Refuse mutable rest parameters.
    3. Match the checked list or string-keyed dictionary to its declared rest role.
    """
    # 1. Preserve ordinary input borrowing.
    if kind == IncanCallableParamKind.Normal:
        return signature_input(ty, mutable, native_owned)
    # 2. Refuse mutable rest parameters.
    if mutable:
        return Err("unsupported Body IR mutable rest parameter")
    # 3. Match the checked pack to its declared rest role.
    match ty:
        PlanType.List(_leaf, depth) =>
            if kind == IncanCallableParamKind.RestPositional and depth > 0:
                return Ok(ty)
        PlanType.Dict(key, _value) =>
            if kind == IncanCallableParamKind.RestKeyword and key == ListLeaf.Str:
                return Ok(ty)
        _ => pass
    return Err("unsupported Body IR checked rest pack representation")


pub def callable_component(ty: &RustType) -> Result[PlanType, str]:
    """Admit scalar, list, collection and recursively callable signature components; name every other type."""
    match ty:
        RustType.Primitive(primitive) => return primitive_type(primitive)
        RustType.Function(params=parameters, return_type=result) => return function_pointer_type(parameters, result)
        _ => pass
    # A signature component carries no source-local nominal context, and lists or collections of admitted elements
    # translate without one. Models, enums and unions inside a signature stay refused by name. The `EnumDeclaration`
    # import keeps the empty intrinsics list's element type in scope (the compiler gap tracked by #2010).
    match context_free_type(ty):
        Ok(component) =>
            if is_list(component) or is_collection(component):
                return Ok(component)
        Err(_reason) => pass
    return Err(f"unsupported Body IR callable signature type {ty}")


pub def function_pointer_storage(body: &RustBody) -> list[int]:
    """The return slot and explicit function annotations keep pointer storage; inferred item locals keep their type."""
    mut locals: list[int] = []
    match body.callable_representation:
        Some(representation) =>
            if not representation.closure_holding_return:
                locals.append(0)
        None => locals.append(0)
    match body.callable_representation:
        Some(representation) =>
            for local in representation.function_pointer_locals:
                locals.append(int(local.index()) + 1)
        None => pass
    for parameter in body.params:
        match parameter.ty:
            RustType.Function(params=_parameters, return_type=_result) =>
                match body.callable_representation:
                    Some(representation) =>
                        if parameter.local not in representation.closure_holding_locals:
                            locals.append(int(parameter.local.index()) + 1)
                    None => locals.append(int(parameter.local.index()) + 1)
            _ => pass
    return locals


pub def validate_callable_representation(body: &RustBody) -> Result[None, str]:
    """Refuse callable signatures whose closure-holding contract the checker did not record."""
    match body.callable_representation:
        Some(_representation) => return Ok(None)
        None =>
            match body.return_type:
                RustType.Function(params=_parameters, return_type=_result) =>
                    return Err(f"unsupported Body IR unproven callable return representation in {body.name}")
                _ => pass
            for parameter in body.params:
                match parameter.ty:
                    RustType.Function(params=_parameters, return_type=_result) =>
                        return Err(f"unsupported Body IR unproven callable parameter representation in {body.name}")
                    _ => pass
            return Ok(None)


pub def parameter_representation(body: &RustBody, local: int, ty: PlanType) -> Result[PlanType, str]:
    """A selected generic value owns its environment; an ordinary environment-capable function parameter borrows it."""
    match ty:
        PlanType.FunctionPointer(signature) =>
            match body.callable_representation:
                Some(representation) =>
                    for held in representation.closure_holding_locals:
                        if int(held.index()) == local:
                            return Ok(PlanType.Closure(signature))
                    for held in representation.closure_holding_parameters:
                        if int(held.index()) == local:
                            _ = closure_arguments(signature)?
                            return Ok(PlanType.ClosureRef(signature))
                None => pass
        _ => pass
    return Ok(ty)


pub def local_representation(body: &RustBody, local: int, ty: PlanType) -> PlanType:
    """Retain an instance's owned generic aliases at their checked environment-carrying ABI."""
    match ty:
        PlanType.FunctionPointer(signature) =>
            match body.callable_representation:
                Some(representation) =>
                    for held in representation.closure_holding_locals:
                        if int(held.index()) == local:
                            return PlanType.Closure(signature)
                None => pass
        _ => pass
    return ty


pub def return_representation(body: &RustBody, ty: PlanType) -> Result[PlanType, str]:
    """A function whose one returned closure captures returns that closure's owned callable object."""
    match ty:
        PlanType.FunctionPointer(signature) =>
            match body.callable_representation:
                Some(representation) =>
                    if representation.closure_holding_return:
                        _ = closure_arguments(signature)?
                        return Ok(PlanType.Closure(signature))
                None => pass
        _ => pass
    return Ok(ty)


pub def closure_arguments(signature: list[PlanType]) -> Result[list[PlanType], str]:
    """
    Validate a closure's retained input and result storage, including shared native model references.

    1. Validate scalar/text inputs, owned nominals, shared model and collection views, and exclusive `mut` borrows.
    2. Validate the result's scalar or owned transfer carrier.
    3. Return input types in their checked call order.
    """
    # 1. Validate each retained input representation.
    if len(signature) == 0:
        return Err("invalid Body IR callable signature without return type")
    mut elements: list[PlanType] = []
    for index in range(len(signature) - 1):
        input = signature[index]
        if not closure_value_type(input) and not owned_nominal_input(input):
            match input:
                PlanType.ListRef(_leaf, _depth) => pass
                PlanType.SetRef(_leaf) => pass
                PlanType.DictRef(_key, _value) => pass
                PlanType.ListMutRef(_leaf, _depth) => pass
                PlanType.SetMutRef(_leaf) => pass
                PlanType.DictMutRef(_key, _value) => pass
                PlanType.StringMutRef => pass
                PlanType.Model(_index, _name) => pass
                PlanType.ModelMutRef(_index, _name) => pass
                PlanType.ModelRef(_index, _name) => pass
                PlanType.EnumMutRef(_index, _name) => pass
                _ =>
                    return Err(
                        "unsupported Body IR closure input outside scalars, text, models, collection views and borrows",
                    )
        elements.append(input)
    # 2. Validate the result's owned transfer representation.
    if (
        not closure_value_type(signature[-1])
        and not is_owned_collection(signature[-1])
        and not is_generator_type(signature[-1])
        and not owned_nominal_result(signature[-1])
    ):
        return Err(
            "unsupported Body IR closure result outside scalars, owned text, collections and retained nominal values",
        )
    # 3. Keep the checked input order.
    return Ok(elements)


def owned_nominal_input(ty: PlanType) -> bool:
    """Report whether a callable input is an owned model or enum, which the call moves into the callable."""
    match ty:
        PlanType.Model(_index, _name) => return true
        PlanType.Enum(_index, _name) => return true
        _ => return false


def owned_nominal_result(ty: PlanType) -> bool:
    """Admit a retained model, newtype or enum through the owned return path; borrowed and unretained layouts stay refused."""
    match ty:
        PlanType.Model(_index, _name) => return true
        PlanType.Enum(_index, _name) => return true
        _ => return false


def closure_value_type(ty: PlanType) -> bool:
    """Report whether a value crosses a boxed closure's call boundary by value: a scalar of any numeric carrier, or text."""
    return numeric_carrier(ty) or ty == PlanType.Bool or ty == PlanType.Unit or ty == PlanType.String


pub def closure_capture_type(ty: PlanType, consumes_environment: bool) -> bool:
    """
    Admit captures according to the retained reusable or consuming environment contract.

    Reusable environments copy scalars and clone owned text, collection, model, and enum snapshots for every call.
    Checking forbids changes to captured values and aliases of their storage.
    A proven consuming environment instead transfers its canonical zip into the lifted body once.
    """
    match ty:
        PlanType.ZipIterator(_left, _right) => return consumes_environment
        _ => return owned_capture(ty) or (closure_value_type(ty) and ty != PlanType.Unit)


pub def owned_capture(ty: PlanType) -> bool:
    """
    Select owned text, collection, callable, model, enum and zip snapshots for construction, validation and invocation.

    Reusable calls clone these snapshots.
    """
    match ty:
        PlanType.String => return true
        PlanType.List(_leaf, _depth) => return true
        PlanType.Set(_leaf) => return true
        PlanType.Dict(_key, _value) => return true
        PlanType.Model(_owner, _name) => return true
        PlanType.Enum(_owner, _name) => return true
        PlanType.Closure(_signature) => return true
        PlanType.NativeClosure(_signature, _send, _sync) => return true
        PlanType.ZipIterator(_left, _right) => return true
        _ => return false


pub def closure_constructor(
    name: str,
    lifted: str,
    captures: list[PlanType],
    signature: list[PlanType],
    consumes_environment: bool,
    span: SourceSpan,
    native_send: bool = false,
    native_sync: bool = false,
) -> Function:
    """
    Declare the constructor whose native body boxes one environment holding the captures in order.

    Its plan body is the validated reusable or consuming call contract returning the corresponding boxed object.
    The driver supplies the native closure, whose body forwards the captures and then its own inputs to `lifted`.
    """
    mut object_type = PlanType.Closure(signature)
    mut body_call = CalleeKind.ClosureBody(lifted, len(captures))
    if native_send or native_sync:
        object_type = PlanType.NativeClosure(signature, native_send, native_sync)
    if consumes_environment:
        object_type = PlanType.ClosureOnce(signature)
        body_call = CalleeKind.ClosureBodyOnce(lifted, len(captures))
    mut locals = [Local(ty=object_type, span=span)]
    mut parameters: list[Parameter] = []
    mut operands: list[Operand] = []
    for index in range(len(captures)):
        locals.append(Local(ty=captures[index], span=span))
        parameters.append(Parameter(name=f"__incan_capture_{index}", ty=captures[index], span=span))
        # Owned captures move into the environment; Copy scalars are copied.
        mut capture = OperandKind.Copy(plan_place(index + 1, span))
        if consumes_environment or owned_capture(captures[index]):
            capture = OperandKind.Move(plan_place(index + 1, span))
        operands.append(Operand(kind=capture, span=span))
    call = TerminatorKind.Call(Callee(kind=body_call, span=span), operands, plan_place(0, span), 1, Unwind.Continue)
    # The `Statement` import keeps these empty blocks' element type in scope (the compiler gap tracked by #2010).
    return Function(
        name=name,
        parameters=parameters,
        return_type=object_type,
        locals=locals,
        blocks=[plan_block([], call, span), plan_block([], TerminatorKind.Return, span)],
        span=span,
    )


pub def callable_copy_type(ty: PlanType) -> bool:
    """Function items and function pointers have no environment owner and are native Copy values."""
    match ty:
        PlanType.FunctionPointer(_signature) => return true
        PlanType.FunctionItem(_name, _signature) => return true
        _ => return false


pub def pointer_forwarder(name: str, signature: list[PlanType], span: SourceSpan) -> Function:
    """Forward a copied function pointer and its inputs through a closure's lifted body."""
    pointer = PlanType.FunctionPointer(signature)
    mut locals = [Local(ty=signature[-1], span=span), Local(ty=pointer, span=span)]
    mut parameters = [Parameter(name="__incan_pointer", ty=pointer, span=span)]
    mut operands: list[Operand] = []
    for index in range(len(signature) - 1):
        ty = signature[index]
        locals.append(Local(ty=ty, span=span))
        parameters.append(Parameter(name=f"__incan_argument_{index}", ty=ty, span=span))
        place = plan_place(index + 2, span)
        mut kind = OperandKind.Copy(place)
        # Owned text, an owned model or enum, and the exclusive borrow a `mut` input receives move on; every other
        # input is copied.
        if ty == PlanType.String or is_exclusive_borrow(ty) or owned_nominal_input(ty):
            kind = OperandKind.Move(place)
        operands.append(Operand(kind=kind, span=span))
    pointer_value = Operand(kind=OperandKind.Copy(plan_place(1, span)), span=span)
    call = TerminatorKind.Call(
        Callee(kind=CalleeKind.Value(pointer_value), span=span),
        operands,
        plan_place(0, span),
        1,
        Unwind.Continue,
    )
    return Function(
        name=name,
        parameters=parameters,
        return_type=signature[-1],
        locals=locals,
        blocks=[plan_block([], call, span), plan_block([], TerminatorKind.Return, span)],
        span=span,
    )


pub def callable_signature(ty: PlanType) -> Result[list[PlanType], str]:
    """Read a retained function or callable-object signature; inputs come first and the result is last."""
    match ty:
        PlanType.FunctionPointer(signature) => return Ok(signature)
        PlanType.FunctionItem(_name, signature) => return Ok(signature)
        PlanType.Closure(signature) => return Ok(signature)
        PlanType.NativeClosure(signature, _send, _sync) => return Ok(signature)
        PlanType.ClosureOnce(signature) => return Ok(signature)
        PlanType.ClosureRef(signature) => return Ok(signature)
        _ => return Err("unsupported Body IR local callable representation")


pub def function_assignment(
    destination: PlanType,
    source: PlanType,
    value: Operand,
    pointer_storage: bool,
    context: str,
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Preserve exact item, pointer, or shared closure signatures; reify only a proven function-pointer destination."""
    match source:
        PlanType.FunctionItem(_name, signature) =>
            if pointer_storage:
                if destination != PlanType.FunctionPointer(signature):
                    return Err("invalid Body IR function-pointer assignment signature")
                return Ok((destination, RvalueKind.ReifyFunction(value)))
            match destination:
                PlanType.FunctionItem(_previous, _signature) =>
                    if destination != source:
                        return Err("unsupported Body IR function-item reassignment")
                _ => pass
            return Ok((source, RvalueKind.Use(value)))
        PlanType.FunctionPointer(_signature) =>
            if destination != source:
                return Err("invalid Body IR callable assignment signature")
            return Ok((destination, RvalueKind.Use(value)))
        PlanType.ClosureRef(signature) =>
            if pointer_storage:
                return Err("unsupported Body IR shared closure stored as a function pointer")
            if callable_signature(destination)? != signature:
                return Err("invalid Body IR shared closure assignment signature")
            return Ok((source, RvalueKind.Use(value)))
        _ =>
            return Err(
                f"unsupported Body IR noncallable assignment to function value from {source:?} into {destination:?} at {context}",
            )


pub def source_function_item(
    module: &RustModule,
    mut builder: Builder,
    value: &RustRvalue,
    span: SourceSpan,
) -> Result[Option[tuple[str, PlanType, str]], str]:
    """Retain a function item's exact signature and declaration name from its checked named-read or original identity."""
    match value:
        RustRvalue.Closure(params=parameters, captured_operands=captures, body=closure) =>
            match closure.original_callable.as_ref():
                Some(identity) =>
                    if len(captures) != 0 or len(closure.capture_locals) != 0 or len(closure.stmts) != 0:
                        return Err("invalid Body IR original callable computation")
                    for binding in module.decorated_bindings:
                        if binding.original_body.canonical == closure.original_callable:
                            item = original_function_item(module, builder, parameters, binding)?
                            return Ok(Some((item[0], item[1], str(identity.declaration_name))))
                    return Err("unsupported Body IR unretained original callable")
                None => pass
            if not closure.function_item:
                return Ok(None)
            if len(captures) != 0 or len(closure.capture_locals) != 0 or len(closure.stmts) != 1:
                return Err("invalid Body IR function-item forwarding computation")
            return Ok(Some(checked_function_item(module, builder, parameters, closure.stmts[0].kind, span)?))
        _ => return Ok(None)


def checked_function_item(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    statement: &RustStatementKind,
    span: SourceSpan,
) -> Result[tuple[str, PlanType, str], str]:
    """Require the same checked declaration and signature as the named read's retained forwarding call."""
    match statement:
        RustStatementKind.Call(destination=_destination, callee=callee, args=_arguments, may_panic=_panic) =>
            match callee:
                RustCallee.Function(target) =>
                    match target:
                        RustCallableTarget.Named(named) =>
                            return named_function_item(module, builder, parameters, named, span)
                        _ => return Err("invalid Body IR indirect function-item forwarding target")
                _ => return Err("invalid Body IR nonfunction item forwarding target")
        _ => return Err("invalid Body IR function-item body")


def named_function_item(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    target: &RustNamedTarget,
    span: SourceSpan,
) -> Result[tuple[str, PlanType, str], str]:
    """Attach the canonical declaration name to an authenticated function item without reading its signature for a name."""
    item = function_item_identity(module, builder, parameters, target, span)?
    match target.canonical:
        Some(identity) => return Ok((item[0], item[1], str(identity.declaration_name)))
        None => return Err("unsupported Body IR unnamed function item")


def item_component(mut builder: Builder, ty: &RustType) -> Result[PlanType, str]:
    """
    Retain a function item's signature component through its checked frame's ordinary layout context.

    Its inputs and result use the same nominal, scalar, borrowed and collection storage as its own frame. A second
    signature whitelist would reject admitted borrowed scalar inputs before the native callable can be verified.
    """
    return native_source_type(
        builder.constructors,
        builder.nominals,
        builder.enums,
        builder.unions,
        ty,
        builder.intrinsics,
    )


def item_input(mut builder: Builder, ty: &RustType) -> Result[PlanType, str]:
    """Retain an item's explicit input loan against its full nominal context; other inputs use owned components."""
    match ty:
        RustType.Ref(_inner) =>
            return native_source_type(
                builder.constructors,
                builder.nominals,
                builder.enums,
                builder.unions,
                ty,
                builder.intrinsics,
            )
        RustType.RefMut(_inner) =>
            return native_source_type(
                builder.constructors,
                builder.nominals,
                builder.enums,
                builder.unions,
                ty,
                builder.intrinsics,
            )
        _ => return item_component(builder, ty)


def item_result(mut builder: Builder, ty: &RustType) -> Result[PlanType, str]:
    """A function item's result: a lazy generator, as `callable_result` admits one, or any item component."""
    match generator_type(ty):
        Some(Ok(result)) =>
            if is_generator_type(result):
                return Ok(result)
        _ => pass
    return item_component(builder, ty)


def function_item_identity(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    target: &RustNamedTarget,
    span: SourceSpan,
) -> Result[tuple[str, PlanType], str]:
    """A diagnostic source name becomes a plan item only after its canonical and physical identities agree."""
    if len(target.type_args) != 0:
        return Err("unsupported Body IR generic function item")
    match target.canonical:
        None => return Err("unsupported Body IR unproven function item")
        Some(identity) =>
            match module.body_for_canonical_target(identity):
                None =>
                    for declaration in module.loaf_callables:
                        if declaration.canonical == identity:
                            return loaf_item_signature(builder, parameters, declaration, span)
                    index = imported_item_body(module, builder.program.body_indices, target)?
                    return item_signature(module, builder, parameters, module.bodies[index])
                Some(body) =>
                    if target.direct_call_id != Some(body.direct_call_id) or str(target.name) != str(body.name):
                        return Err("invalid Body IR function-item identity")
                    return item_signature(module, builder, parameters, body)


def loaf_item_signature(
    mut builder: Builder,
    parameters: &list[RustParameter],
    declaration: &LoafCallable,
    span: SourceSpan,
) -> Result[tuple[str, PlanType], str]:
    """Read a compiled function value's signature from its Loaf declaration, without requiring its implementation."""
    if len(declaration.type_parameters) != 0 or len(declaration.native_type_arguments) != 0:
        return Err("unsupported Body IR generic Loaf function item")
    if len(parameters) != len(declaration.parameters):
        return Err("invalid Body IR Loaf function-item parameter count")
    mut signature: list[PlanType] = []
    for index in range(len(parameters)):
        parameter = parameters[index]
        if parameter.ty != declaration.parameters[index]:
            return Err("invalid Body IR Loaf function-item parameter contract")
        component = item_input(builder, declaration.parameters[index])?
        mut input = packed_input(component, parameter.kind, parameter.mutable, parameter.native_owned)?
        match declaration.declaration_frame():
            Some(frame) => input = call_parameter_type(builder, frame, frame.params[index])?
            None => pass
        signature.append(input)
    mut result = item_result(builder, declaration.return_type)?
    match declaration.declaration_frame():
        Some(frame) => result = return_representation(frame, result)?
        None => pass
    signature.append(result)
    name = str(declaration.item)
    builder.externals.append(
        ExternalFunction(path=name, parameters=signature[:-1], return_type=signature[-1], span=span),
    )
    return Ok((name, PlanType.FunctionItem(name, signature)))


pub def function_item_callee(mut builder: Builder, name: str, span: SourceSpan) -> Callee:
    """Use the registered external declaration for a Loaf item and the local declaration for a source item."""
    for declaration in builder.externals:
        if declaration.path == name and len(declaration.type_arguments) == 0:
            return Callee(kind=CalleeKind.External(name), span=span)
    return Callee(kind=CalleeKind.Planned(name), span=span)


def imported_item_body(module: &RustModule, bodies: BodyIndex, target: &RustNamedTarget) -> Result[int, str]:
    """
    Find the one retained body, in another module of the project graph, that an imported function item names.

    Its exact canonical identity selects the body, as for a direct call to it. A published package fragment carries no
    source-local call id; a call id that is present must agree with the body.
    """
    mut candidates: list[int] = []
    match target.canonical:
        Some(identity) => candidates = bodies.candidates(identity)
        None => pass
    if len(candidates) == 0:
        return Err("unsupported Body IR imported function item without a retained body")
    if len(candidates) != 1:
        return Err("unsupported Body IR ambiguous imported function item")
    found = candidates[0]
    match target.direct_call_id:
        Some(call_id) =>
            if call_id != module.bodies[found].direct_call_id:
                return Err("invalid Body IR function-item identity")
        None => pass
    return Ok(found)


def item_signature(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    body: &RustBody,
) -> Result[tuple[str, PlanType], str]:
    """Select a checked function's callable item; a generator names its lazy constructor, never its producer frame."""
    if body.is_async:
        return Err("unsupported Body IR async function item")
    if len(parameters) != len(body.params):
        return Err("invalid Body IR function-item parameter count")
    mut signature: list[PlanType] = []
    for index in range(len(parameters)):
        if parameters[index].kind != body.params[index].kind:
            return Err("unsupported Body IR function-item parameter role")
        match receiver_mode(body.locals[parameter_local_index(body, index)].origin):
            Some(mutable) =>
                match parameters[index].ty:
                    RustType.Ref(inner) =>
                        if mutable or not same_receiver_type(inner.as_ref(), body.params[index].ty):
                            return Err("unsupported Body IR original callable shared receiver contract")
                    RustType.RefMut(inner) =>
                        if not mutable or not same_receiver_type(inner.as_ref(), body.params[index].ty):
                            return Err("unsupported Body IR original callable mutable receiver contract")
                    _ => return Err("unsupported Body IR original callable receiver passing contract")
            None =>
                if parameters[index].ty != body.params[index].ty:
                    return Err("unsupported Body IR function-item parameter contract")
        component = item_input(builder, parameters[index].ty)?
        input = packed_input(
            component,
            parameters[index].kind,
            parameters[index].mutable,
            parameters[index].native_owned,
        )?
        if body.is_generator() and input != component:
            return Err("unsupported Body IR generator function item with borrowed parameters")
        signature.append(input)
    signature.append(item_result(builder, body.return_type)?)
    # Generator entrypoints retain their ordinary constructor symbol beside the separately named producer.
    name = evaluator_name(module, body)
    return Ok((name, PlanType.FunctionItem(name, signature)))


def same_receiver_type(left: &RustType, right: &RustType) -> bool:
    """Compare the referenced payloads without the Rust enum pattern's Box storage crossing the equality boundary."""
    return left == right


def original_function_item(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    binding: &DecoratedBinding,
) -> Result[tuple[str, PlanType], str]:
    """Close an explicit original read with the enclosing wrapper's exact declared binding, never operand inference."""
    if binding.initialization == DecoratedInitialization.PerInstantiation:
        return initialized_original_function_item(module, builder, parameters, binding)
    if binding.initializer != None:
        return Err("unsupported Body IR invocation or module decorator with cached initializer")
    body = binding.original_body
    if len(body.type_parameters) != 0:
        if body.is_generator():
            return Err("unsupported Body IR generator original callable with type parameters")
        if (
            binding.initialization != DecoratedInitialization.PerInvocation
            or body.canonical != builder.callable_identity
            or body.type_parameters != builder.type_parameters
        ):
            return Err("unsupported Body IR original callable type-parameter binding")
        mut arguments: list[RustType] = []
        for argument in builder.type_arguments:
            arguments.append(argument.clone())
        mut concrete = instantiate(body, arguments, [])?
        mut inputs: list[RustParameter] = []
        for parameter in parameters:
            mut input = parameter.clone()
            closed: RustType = substitute(parameter.ty, body.type_parameters, arguments)?
            input.ty = closed.clone()
            inputs.append(input)
        # Preserve the checked parameter records in Body IR storage for the borrowed signature boundary.
        mut signature_body = body.clone()
        signature_body.params = inputs
        name, ty = item_signature(module, builder, signature_body.params, concrete)?
        request_instance(builder.instances, body, arguments, [], true)
        match ty:
            PlanType.FunctionItem(_item, signature) =>
                original_name = f"{name}__incan_original"
                return Ok((original_name, PlanType.FunctionItem(original_name, signature)))
            _ => return Err("invalid Body IR original callable signature")
    if binding.initialization != DecoratedInitialization.ModuleStorage:
        return Err("unsupported Body IR invocation replacement without type parameters")
    name, ty = item_signature(module, builder, parameters, body)?
    match ty:
        PlanType.FunctionItem(_item, signature) =>
            original_name = f"{name}__incan_original"
            return Ok((original_name, PlanType.FunctionItem(original_name, signature)))
        _ => return Err("invalid Body IR original callable signature")


def initialized_original_function_item(
    module: &RustModule,
    mut builder: Builder,
    parameters: &list[RustParameter],
    binding: &DecoratedBinding,
) -> Result[tuple[str, PlanType], str]:
    """Select a cached instantiation's original only inside its authenticated closed initializer frame."""
    mut original = binding.original_body.clone()
    if binding.initializer == None or len(original.type_parameters) == 0:
        return Err("unsupported Body IR cached decorator without a generic initializer")
    if (
        builder.initializing_decorator != original.canonical
        or builder.type_parameters != original.type_parameters.clone()
    ):
        return Err("unsupported Body IR original callable outside its closed decorator initializer")
    original = instantiate(original, builder.type_arguments, [])?
    name, ty = item_signature(module, builder, parameters, original)?
    match ty:
        PlanType.FunctionItem(_item, signature) =>
            original_name = f"{name}__incan_original"
            return Ok((original_name, PlanType.FunctionItem(original_name, signature)))
        _ => return Err("invalid Body IR original callable signature")
