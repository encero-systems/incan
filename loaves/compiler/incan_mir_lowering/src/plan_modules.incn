"""A module's admitted plan record: the page a worker restores its functions from, and the note of what it restored."""

pub from pub::internal_models.lowering_events import AdmittedFunction, AdmittedModule, AdmittedPlacement, EventReference
from pub::internal_models.lowering_events import encode_module_note, read_module_admission, write_module_placement
from std.encoding.hex import hexlify
from std.fs import Path
from pub::incan_mir_plan import NominalKind, NominalReference
from pub::internal_models.plan_module_records import ADMITTED_MODULE_NOTE, PARTIAL_MODULE_NOTE, POSITIONED_MODULE_PAGE, REPOSITION_MODULE_PAGE, PlanModuleFunction, decode_plan_module


pub def module_page(products: str, module: str) -> Path:
    """Where Bakery places the plan record of an admitted module: named by the module, never by a product key."""
    basename = hexlify(module.encode("utf-8"))
    placed = Path(products).joinpath(basename + POSITIONED_MODULE_PAGE)
    if placed.is_file():
        return placed
    return Path(products).joinpath(basename + REPOSITION_MODULE_PAGE)


pub model AdmittedPage:
    """An admitted module's final events by native function name."""

    pub events: Dict[str, PlanModuleFunction]
    pub inspect_placement: bool = true

    pub def event(self, function: str) -> Option[PlanModuleFunction]:
        """
        The final event of the body lowered to this native function, when the page holds one. The name carries no
        source position, so a body that moved in its file, as under an added comment, still finds its event.
        """
        if function in self.events:
            return Some(self.events[function])
        return None


pub def admitted_page(products: Option[str], module: str, generation: Option[str]) -> AdmittedPage:
    """
    The final events of an admitted module, by the native function name of the body each belongs to.

    Bakery writes the page only for a module whose every witness still validates. No page, or a page that does not
    decode or names another module, admits nothing: every body then takes the keyed route.
    """
    mut page = AdmittedPage(events={})
    directory = match products:
        Some(value) => value
        None => return page

    if generation is None:
        return page
    path = module_page(directory, module)
    if not path.is_file():
        return page
    encoded = match path.read_bytes():
        Ok(value) => value
        Err(_) => return page

    match decode_plan_module(encoded):
        Err(_) => return page
        Ok(record) =>
            if record.module != module:
                return page
            page.inspect_placement = path.0.endswith(REPOSITION_MODULE_PAGE)
            for function in record.functions:
                page.events[function.function] = function
    return page


pub def admitted_reference(reference: NominalReference) -> EventReference:
    """Keep one resolved declaration position for the note."""
    kind = match reference.kind:
        NominalKind.Enum => "enum"
        NominalKind.Model => "model"
    return EventReference(kind=kind, index=reference.index, name=reference.name)


def note_suffix(complete: bool) -> str:
    """Distinguish fully admitted modules from modules with individual restored functions."""
    if complete:
        return ADMITTED_MODULE_NOTE
    return PARTIAL_MODULE_NOTE


pub def report_admitted(
    report: Option[str], module: str, functions: list[AdmittedFunction], ordinary: int, inspected: bool, products: Option[str],
) -> Result[None, str]:
    """Report each restored function; only a request that restored all ordinary bodies records a whole module."""
    if let Some(root) = report:
        if let Some(directory) = products:
            basename = hexlify(module.encode("utf-8"))
            selected = note_suffix(len(functions) == ordinary)
            private = Path(directory).joinpath("admissions")
            for suffix in [ADMITTED_MODULE_NOTE, PARTIAL_MODULE_NOTE]:
                path = private.joinpath(basename + suffix)
                diagnostic = Path(root).joinpath(basename + suffix)
                if suffix == selected and len(functions) > 0:
                    write_admitted_note(path, diagnostic, module, functions, selected == ADMITTED_MODULE_NOTE, inspected)?
                else:
                    for stale in [path, diagnostic]:
                        if stale.is_file():
                            stale.unlink().map_err((error) => error.message())?
    return Ok(None)


def write_admitted_note(path: Path, diagnostic: Path, module: str, functions: list[AdmittedFunction], complete: bool, inspected: bool) -> Result[None, str]:
    """Publish the restored function positions used to assemble the current native plan."""
    note = AdmittedModule(module=module, complete=complete, functions=functions, inspected=inspected)
    encoded = encode_module_note(note)?
    path.parent().mkdir(true, true).map_err((error) => error.message())?
    write_module_placement(Path(path.0 + ".placement"), note)?
    path.write_bytes(encoded).map_err((error) => error.message())?
    # The usual descriptor-scoped note is retained for external observers. Publication reads the private pair above.
    diagnostic.write_bytes(encoded).map_err((error) => error.message())?
    return Ok(None)


pub def read_admitted(report: Path) -> Result[list[AdmittedModule], str]:
    """Read every module note of a plan report, in name order."""
    mut notes: list[AdmittedModule] = []
    if not report.is_dir():
        return Ok(notes)
    for path in sorted([str(path.0) for path in report.iterdir().map_err((error) => error.message())?]):
        if path.endswith(ADMITTED_MODULE_NOTE) or path.endswith(PARTIAL_MODULE_NOTE):
            note = read_module_admission(Path(path))?
            name = Path(path).name()
            suffix = note_suffix(note.complete)
            if name != hexlify(note.module.encode("utf-8")) + suffix:
                return Err("module admission note disagrees with its filename")
            notes.append(note)
    return Ok(notes)
