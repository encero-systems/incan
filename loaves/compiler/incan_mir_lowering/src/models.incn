"""Scalar, collection, and nominal layout admission from canonical frontend records."""

from table_views import borrowed_at
pub from frame import place_type
from collections import primitive_leaf
from rust::incan_semantics_core import IncanType as RustType, CanonicalSymbolId
from rust::incan_semantics_core::body_ir import (
    NominalDeclaration,
    ConstructorTarget,
    ArgumentBinding,
    Place as RustPlace,
    PlaceElem as RustPlaceElem,
    EnumDeclaration as RustEnumDeclaration,
    nominal_carrier_key,
)
from pub::incan_mir_plan import (
    ListLeaf,
    PlanType,
    Local,
    Place,
    Projection,
    SourceSpan,
    FieldProjection,
    EnumDeclaration,
)
from tuples import generic_tuple_type, type_name, tuple_slot
from pub::incan_mir_plan import tuple_element_type
from generators import generator_type
from nominal_instances import nominal_symbol, template_base
from symbols import model_symbol
from types import primitive_type
from closures import function_pointer_type
from layout_types import native_source_type as retained_type
from layout_types import stored_field_type
from ranges import range_field
from unions import union_slot


pub def model_type(declarations: &list[NominalDeclaration], ty: &RustType) -> Result[PlanType, str]:
    """
    Translate checked types against retained declarations, preserving unsupported types in refusals.

    1. Admit an existing runtime or generator representation.
    2. Resolve scalar, nominal and callable carriers from their checked types.
    3. Resolve collection elements, keeping exact native frozen storage distinct from source frozen views.
    """
    # 1. Admit an existing runtime or generator representation.
    match runtime_storage_marker(ty):
        Some(storage) => return Ok(storage)
        None => pass
    match generator_type(ty):
        Some(result) => return result
        None => pass
    # 2. Resolve scalar, nominal and callable carriers from their checked types.
    match ty:
        RustType.Never => return Ok(PlanType.Never)
        RustType.RustInteropPath(path) => return Err(f"unsupported Body IR type RustInteropPath {path}")
        RustType.Named(name) =>
            retained_name = str(name)
            mut index = 0
            for declaration_position in range(len(declarations)):
                declaration = borrowed_at(declarations, declaration_position)
                if declaration.name == retained_name:
                    return Ok(PlanType.Model(index, model_symbol(retained_name)))
                index += 1
            source_name = rejected_nominal_name(declarations, retained_name)
            return Err(f"unsupported Body IR nominal type {source_name}")
        RustType.Primitive(primitive) => return primitive_type(primitive)
        RustType.TypeToken(represented) =>
            match model_type(declarations, represented)?:
                (PlanType.Int | PlanType.Float | PlanType.Bool | PlanType.String) =>
                    return Ok(PlanType.TypeToken([model_type(declarations, represented)?]))
                _ => return Err("unsupported Body IR nonprimitive TypeToken carrier")
        RustType.Function(params=parameters, return_type=result) => return function_pointer_type(parameters, result)
        RustType.Tuple(_elements) => return retained_model_type(declarations, ty)
        RustType.Decimal(precision=_precision, scale=_scale) => return Ok(PlanType.Decimal)
        RustType.Generic(base=base, args=arguments) =>
            # 3. Collection elements use the same recursive layout boundary as ordinary frame locals.
            if (
                base in ["List", "Set"]
                and len(arguments) == 1
                or base == "Dict"
                and len(arguments) == 2
                or base in [
                    "Tuple",
                    "FrozenList",
                    "FrozenSet",
                    "FrozenDict",
                    "$FrozenList",
                    "$FrozenSet",
                    "$FrozenDict",
                ]
            ):
                return retained_model_type(declarations, ty)
            retained_base = str(base)
            retained_name = nominal_symbol(retained_base, arguments)
            mut index = 0
            for declaration_position in range(len(declarations)):
                declaration = borrowed_at(declarations, declaration_position)
                if (
                    declaration.type_parameter_count != 0
                    and declaration.name == retained_name
                    and template_base(declaration) == retained_base
                ):
                    return Ok(PlanType.Model(index, model_symbol(str(declaration.name))))
                index += 1
            return generic_tuple_type(ty)
        _ => return Err(f"unsupported Body IR type {type_name(ty)} ({ty})")


def retained_model_type(declarations: &list[NominalDeclaration], ty: &RustType) -> Result[PlanType, str]:
    """Resolve a model carrier with typed empty borrowed inventories for the unavailable enum and union context."""
    enums: list[RustEnumDeclaration] = []
    unions: list[RustType] = []
    intrinsics: list[EnumDeclaration] = []
    return retained_type(declarations, enums, unions, ty, intrinsics)


pub def runtime_storage_marker(ty: &RustType) -> Option[PlanType]:
    """Preserve closed native storage without inventing source decimal precision or replacing static loans by owners."""
    match ty:
        RustType.Generic(base=base, args=arguments) =>
            if len(arguments) != 0:
                return None
            if base == "<native-static-text>":
                return Some(PlanType.StaticText)
            if base == "<native-static-bytes>":
                return Some(PlanType.StaticBytes)
            if base == "<native-decimal>":
                return Some(PlanType.Decimal)
        _ => pass
    return None


def rejected_nominal_name(declarations: &list[NominalDeclaration], name: str) -> str:
    """Report a rejected carrier's source name only through its retained canonical owner, without granting layout admission."""
    for declaration_position in range(len(declarations)):
        declaration = borrowed_at(declarations, declaration_position)
        match nominal_carrier_key(declaration.canonical):
            Some(key) =>
                if str(key) == name:
                    return str(declaration.canonical.declaration_name)
            None => pass
    return name


pub def hashed_element(declarations: &list[NominalDeclaration], ty: &RustType) -> Result[ListLeaf, str]:
    """
    Admit a retained model as a set element or dictionary key with derived Hash and derived or canonically selected source Eq.

    Equality can come from a source protocol rather than a derive. Actual native Eq and Hash implementations are
    validated against every runtime call's bounds before MIR; missing source implementations remain unsupported.
    Other elements keep the primitive hashed leaves. Keyed dictionary lookup additionally requires Display.
    """
    match ty:
        RustType.Named(name) =>
            retained_name = str(name)
            mut index = 0
            for declaration_position in range(len(declarations)):
                declaration = borrowed_at(declarations, declaration_position)
                if declaration.name == retained_name and model_equality(declaration) and "Hash" in declaration.derives:
                    return Ok(ListLeaf.Model(index, retained_name))
                index += 1
        _ => pass
    return primitive_leaf(ty, true)


def model_equality(declaration: &NominalDeclaration) -> bool:
    """Require a checked derive or the explicit canonical source equality witness before hashed carrier admission."""
    if "Eq" in declaration.derives:
        return true
    match declaration.comparison_equality:
        Some(_identity) => return true
        None => return false


pub def model_place(
    declarations: &list[NominalDeclaration],
    locals: &list[Local],
    value: &RustPlace,
    span: SourceSpan,
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    intrinsics: &list[EnumDeclaration],
) -> Result[Place, str]:
    """Borrow the frame's tables while requiring each selected field's canonical layout; an unprojected local needs no declaration-table copy."""
    return model_prefix(declarations, locals, value, len(value.projection), span, enums, unions, intrinsics)


pub def model_prefix(
    declarations: &list[NominalDeclaration],
    locals: &list[Local],
    value: &RustPlace,
    count: int,
    span: SourceSpan,
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    intrinsics: &list[EnumDeclaration],
) -> Result[Place, str]:
    """Borrow retained tables to project a checked leading field path without copying or changing the frontend place."""
    if count < 0 or count > len(value.projection):
        return Err("invalid Body IR model field prefix length")
    match value.local_id():
        None => return Err("unsupported Body IR global place")
        Some(local) =>
            index = int(local.index()) + 1
            match receiver_owner(locals[index].ty):
                Some((owner, name)) =>
                    if count == 0:
                        return Ok(
                            Place(local=index, projection=Projection.Deref(PlanType.Model(owner, name)), span=span),
                        )
                    return receiver_field(declarations, index, owner, value, count, span, enums, unions, intrinsics)
                None => pass
            # A `mut str` or enum parameter, an in-place binding or an in-place loop item reads through its reference.
            match exclusive_referent(locals[index].ty):
                Some(referent) =>
                    if count == 0:
                        return Ok(Place(local=index, projection=Projection.Deref(referent), span=span))
                    fields = field_path(declarations, referent, value.projection, count, enums, unions, intrinsics)?
                    return Ok(Place(local=index, projection=Projection.DerefFields(fields), span=span))
                None => pass
            # An enum method's shared receiver reads the whole enum through its reference.
            match locals[index].ty:
                PlanType.TupleRef(elements) =>
                    if count == 0:
                        return Ok(Place(local=index, projection=Projection.Whole, span=span))
                    fields = field_path(
                        declarations,
                        PlanType.Tuple(elements),
                        value.projection,
                        count,
                        enums,
                        unions,
                        intrinsics,
                    )?
                    return Ok(Place(local=index, projection=Projection.DerefFields(fields), span=span))
                PlanType.EnumRef(owner, name) =>
                    if count == 0:
                        return Ok(Place(local=index, projection=Projection.Deref(PlanType.Enum(owner, name)), span=span))
                    return Err("unsupported Body IR projection through an enum receiver")
                _ => pass
            if count == 0:
                return Ok(Place(local=index, projection=Projection.Whole, span=span))
            fields = field_path(declarations, locals[index].ty, value.projection, count, enums, unions, intrinsics)?
            if len(fields) == 1 and fields[0].dereferences == 0:
                if fields[0].variant >= 0:
                    return Ok(
                        Place(
                            local=index,
                            projection=Projection.VariantField(fields[0].variant, fields[0].slot, fields[0].ty),
                            span=span,
                        ),
                    )
                slot = fields[0].slot
                ty = fields[0].ty
                return Ok(Place(local=index, projection=Projection.Field(slot, ty), span=span))
            return Ok(Place(local=index, projection=Projection.Fields(fields), span=span))


pub def field_path(
    declarations: &list[NominalDeclaration],
    root: PlanType,
    projections: list[RustPlaceElem],
    count: int,
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    intrinsics: &list[EnumDeclaration],
) -> Result[list[FieldProjection], str]:
    """Resolve ordered checked carrier payloads and canonical fields; indices and slices keep their separate lowering."""
    mut ty = root
    mut fields: list[FieldProjection] = []
    for position in range(count):
        field = field_projection(declarations, ty, projections[position], enums, unions, intrinsics)?
        fields.append(field)
        ty = field.ty
    return Ok(fields)


pub def field_projection(
    declarations: &list[NominalDeclaration],
    root: PlanType,
    projection: &RustPlaceElem,
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    intrinsics: &list[EnumDeclaration],
) -> Result[FieldProjection, str]:
    """Validate one ordered payload or canonical field through the typed Rust enum boundary required by #459."""
    match field_referent(root):
        Some(referent) =>
            mut field = field_projection(declarations, referent, projection, enums, unions, intrinsics)?
            field.dereferences += 1
            return Ok(field)
        None => pass
    match projection:
        RustPlaceElem.OptionPayload(option_type=container, payload_type=payload) =>
            if retained_type(declarations, enums, unions, container, intrinsics)? != root:
                return Err("invalid Body IR optional projection owner")
            match root:
                PlanType.Enum(owner, _name) =>
                    if owner < len(enums) or owner >= len(enums) + len(intrinsics):
                        return Err("invalid Body IR optional projection carrier")
                    carrier = intrinsics[owner - len(enums)]
                    ty = retained_type(declarations, enums, unions, payload, intrinsics)?
                    if (
                        carrier.carrier != "Option"
                        or len(carrier.variants) != 2
                        or len(carrier.variants[1].fields) != 1
                        or carrier.variants[1].fields[0] != ty
                    ):
                        return Err("invalid Body IR optional projection payload")
                    return Ok(FieldProjection(slot=0, ty=ty, variant=1))
                _ => return Err("invalid Body IR optional projection carrier")
        RustPlaceElem.UnionMember(ty=member) =>
            match root:
                PlanType.Enum(owner, _name) =>
                    ty = retained_type(declarations, enums, unions, member, intrinsics)?
                    variant = union_slot(declarations, enums, unions, owner, ty, intrinsics)?
                    return Ok(FieldProjection(slot=0, ty=ty, variant=variant))
                _ => return Err("invalid Body IR union projection carrier")
        _ => pass
    match root:
        PlanType.Model(owner, _name) =>
            declaration = declarations[owner]
            slot = field_slot(projection, declaration)?
            ty = stored_field_type(declarations, enums, unions, declaration, slot, intrinsics)?
            return Ok(FieldProjection(slot=slot, ty=ty))
        PlanType.Tuple(elements) =>
            slot = tuple_slot(projection, len(elements))?
            return Ok(FieldProjection(slot=slot, ty=tuple_element_type(elements[slot])))
        PlanType.RangeValue => return range_field(projection)
        _ =>
            return Err(
                f"unsupported Body IR model index or slice projection at root {root:?}; projection {projection:?}",
            )


def field_referent(ty: PlanType) -> Option[PlanType]:
    """Retain each reference layer traversed before a canonical field, including references stored in tuple slots."""
    match ty:
        (PlanType.ModelRef(owner, name) | PlanType.ModelMutRef(owner, name)) => return Some(PlanType.Model(owner, name))
        (PlanType.TupleRef(elements) | PlanType.TupleMutRef(elements)) => return Some(PlanType.Tuple(elements))
        (PlanType.ScalarRef(elements) | PlanType.ScalarMutRef(elements)) =>
            if len(elements) == 1:
                return Some(elements[0])
        _ => pass
    return None


pub def field_slot(value: &RustPlaceElem, declaration: &NominalDeclaration) -> Result[int, str]:
    """Require an exact stored field or its checked trait requirement binding; never resolve a missing identity by name."""
    # Legacy #459-like pattern-only imports require the typed enum parameter until dev.8.
    match value:
        RustPlaceElem.Field(name=name, canonical=canonical, structural=structural) =>
            if not structural:
                match canonical:
                    Some(identity) =>
                        selected = checked_field_identity(declaration, identity)?
                        for slot in range(len(declaration.fields)):
                            if (
                                declaration.fields[slot] == str(name)
                                and declaration.field_identities[slot] == selected
                            ):
                                return Ok(slot)
                    None => pass
                return Err(
                    f"unsupported Body IR unproven model field; projection {value:?}; selected owner {declaration.canonical:?}; name {declaration.name:?}; fields {declaration.fields:?}; field identities {declaration.field_identities:?}; field types {declaration.field_types:?}",
                )
            return Err("unsupported Body IR structural model projection")
        _ => return Err("unsupported Body IR model index or slice projection")


def checked_field_identity(
    declaration: &NominalDeclaration,
    identity: &CanonicalSymbolId,
) -> Result[CanonicalSymbolId, str]:
    """Apply an exact required-field witness once, refusing conflicting bindings instead of selecting by field name."""
    mut selected = identity.clone()
    mut bound = false
    for adoption in declaration.trait_adoptions:
        for field in adoption.fields:
            if field.requirement != identity.clone():
                continue
            if bound and selected != field.implementation:
                return Err("invalid Body IR conflicting required field bindings")
            selected = field.implementation.clone()
            bound = true
    return Ok(selected)


pub def constructor_index(
    declarations: &list[NominalDeclaration],
    target: &ConstructorTarget,
    count: int,
    expected: PlanType,
) -> Result[int, str]:
    """Prove the constructor's retained declaration identity, canonical layout, and complete field binding."""
    match target.direct_declaration_id:
        Some(identity) =>
            for index in range(len(declarations)):
                match expected:
                    PlanType.Model(owner, _name) =>
                        if index != owner:
                            continue
                    _ => return Err("unsupported Body IR nonnominal constructor destination")
                declaration = declarations[index]
                if identity != declaration.direct_declaration_id:
                    continue
                if (
                    target.canonical != Some(declaration.canonical)
                    or target.canonical_field_layout != Some(declaration.fields)
                ):
                    return Err("invalid Body IR model constructor identity or layout")
                validate_constructor_binding(target.binding, count, len(declaration.fields))?
                return Ok(index)
            return Err("unsupported Body IR unretained model constructor")
        None => return Err("unsupported Body IR nonlocal model constructor")


def validate_constructor_binding(binding: &ArgumentBinding, count: int, fields: int) -> Result[None, str]:
    """Require every field slot exactly once; Body IR supplies elements in canonical field order."""
    match binding:
        ArgumentBinding.Resolved(arguments=bindings, defaulted_slots=defaults) =>
            if len(bindings) != count or len(bindings) + len(defaults) != fields:
                return Err("unsupported Body IR incomplete model constructor")
            mut slots: list[int] = []
            for binding in bindings:
                slot = int(binding.slot)
                if slot < 0 or slot >= fields or slot in slots:
                    return Err("invalid Body IR model constructor slot map")
                slots.append(slot)
            for default in defaults:
                slot = int(default.clone())
                if slot < 0 or slot >= fields or slot in slots:
                    return Err("invalid Body IR model default slot map")
                slots.append(slot)
                # Aliases change diagnostic spelling, never the retained constructor identity or physical layout.
            return Ok(None)
        _ => return Err("unsupported Body IR unresolved model constructor")


def receiver_field(
    declarations: &list[NominalDeclaration],
    index: int,
    owner: int,
    value: &RustPlace,
    count: int,
    span: SourceSpan,
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    intrinsics: &list[EnumDeclaration],
) -> Result[Place, str]:
    """Project a checked field path through a shared or mutable nominal receiver."""
    fields = field_path(
        declarations,
        PlanType.Model(owner, declarations[owner].name),
        value.projection,
        count,
        enums,
        unions,
        intrinsics,
    )?
    if len(fields) == 1:
        slot = fields[0].slot
        ty = fields[0].ty
        return Ok(Place(local=index, projection=Projection.DerefField(slot, ty), span=span))
    return Ok(Place(local=index, projection=Projection.DerefFields(fields), span=span))


def exclusive_referent(ty: PlanType) -> Option[PlanType]:
    """The text, enum or tuple value an exclusive reference names; model references keep their receiver projection."""
    match ty:
        PlanType.StringMutRef => return Some(PlanType.String)
        PlanType.EnumMutRef(owner, name) => return Some(PlanType.Enum(owner, name))
        PlanType.TupleMutRef(elements) => return Some(PlanType.Tuple(elements))
        _ => return None


def receiver_owner(ty: PlanType) -> Option[tuple[int, str]]:
    """Identify the nominal owner behind either checked receiver-reference shape."""
    match ty:
        PlanType.ModelRef(owner, name) => return Some((owner, name))
        PlanType.ModelMutRef(owner, name) => return Some((owner, name))
        _ => return None
