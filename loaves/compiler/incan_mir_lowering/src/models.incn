"""Plain-model layout admission from canonical frontend records."""

from rust::incan_semantics_core import IncanType as RustType, IncanPrimitiveType as Primitive
from rust::incan_semantics_core::body_ir import NominalDeclaration, Place as RustPlace, PlaceElem as RustPlaceElem
from pub::incan_mir_plan import PlanType, Local, Place, Projection, SourceSpan


pub def model_type(declarations: list[NominalDeclaration], ty: &RustType) -> Result[PlanType, str]:
    """Resolve source-local nominal types only against their retained declaration registry."""
    match ty:
        RustType.Named(name) =>
            for index in range(len(declarations)):
                if declarations[index].name == str(name):
                    return Ok(PlanType.Model(index, str(name)))
            return Err(f"unsupported Body IR nominal type {name}")
        RustType.Primitive(primitive) =>
            match primitive:
                Primitive.Int => return Ok(PlanType.Int)
                Primitive.Float => return Ok(PlanType.Float)
                Primitive.Bool => return Ok(PlanType.Bool)
                Primitive.Unit => return Ok(PlanType.Unit)
                Primitive.Str => return Ok(PlanType.String)
                _ => return Err(f"unsupported Body IR primitive type {primitive}")
        _ => return Err(f"unsupported Body IR type {ty}")


pub def model_place(
    declarations: list[NominalDeclaration],
    locals: list[Local],
    value: &RustPlace,
    span: SourceSpan,
) -> Result[Place, str]:
    """Require the checker-selected field identity before selecting its canonical layout slot."""
    match value.local_id():
        Some(local) =>
            index = int(local.index()) + 1
            if len(value.projection) == 0:
                return Ok(Place(local=index, projection=Projection.Whole, span=span))
            if len(value.projection) != 1:
                return Err("unsupported Body IR nested model projection")
            match locals[index].ty:
                PlanType.Model(owner, _name) =>
                    declaration = declarations[owner]
                    slot = field_slot(value.projection[0], declaration)?
                    ty = model_type(declarations, declaration.field_types[slot])?
                    return Ok(Place(local=index, projection=Projection.Field(slot, ty), span=span))
                _ => return Err("unsupported Body IR nonmodel place projection")
        None => return Err("unsupported Body IR global place")


pub def place_type(locals: list[Local], value: Place) -> PlanType:
    """Read a projected destination's actual type rather than its owner's type."""
    match value.projection:
        Projection.Field(_slot, ty) => return ty
        Projection.Value => return PlanType.Int
        Projection.Overflow => return PlanType.Bool
        Projection.Whole => return locals[value.local].ty


pub def field_slot(value: &RustPlaceElem, declaration: &NominalDeclaration) -> Result[int, str]:
    """Decode the imported projection enum through a typed boundary that retains its Rust import."""
    # Legacy #459-like pattern-only imports require the typed enum parameter until dev.8.
    match value:
        RustPlaceElem.Field(name=name, canonical=canonical, structural=structural) =>
            # Legacy borrowed-pattern payloads remain references; materialize the owned comparison values until dev.8.
            if structural.clone():
                return Err("unsupported Body IR structural model projection")
            match canonical:
                Some(identity) =>
                    for slot in range(len(declaration.fields)):
                        if declaration.fields[slot] == str(name) and declaration.field_identities[slot] == identity.clone():
                            return Ok(slot)
                None => pass
            return Err("unsupported Body IR unproven model field")
        _ => return Err("unsupported Body IR model index or slice projection")
