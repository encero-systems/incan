"""Concrete source-trait specialization and checker-selected static dispatch."""

from rust::incan_semantics_core import (
    IncanCallableParam as RustCallableParam,
    IncanType as RustType,
    CanonicalSymbolId,
    SymbolOrigin,
    SemanticSourceTargetKind,
    function_type,
    generic,
)
from rust::std::cmp import PartialEq
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    Body,
    MethodTarget,
    NamedCallableTarget,
    ArgumentElement,
    Operand as RustOperand,
    TraitImplementation,
    TraitTypeArgument,
    NominalDeclaration,
)
from pub::incan_mir_plan import Local, SourceSpan, PlanType, EnumDeclaration
from body_index import BodyIndex
from classes import receiver_mode, frame_type
from models import model_type, model_place, place_type
from enums import enum_type
from decls import library_item, library_enum_item


pub def specialize_project_traits(module: &BodyIrModule, modules: &list[BodyIrModule]) -> Result[BodyIrModule, str]:
    """
    Instantiate this module's open defaults for every adopter of the project the frontend retained.

    An imported trait's default lives in the module that declares the trait, while its adopter's implementation records live in the adopter's module, so the records of every module are consulted. Each instance keeps the default's canonical identity, and with it the declaring module's source provenance. A generic receiver keeps its owner's ordered parameters until nominal specialization closes the checked instance.
    """
    mut implementations: list[TraitImplementation] = []
    mut owners: list[NominalDeclaration] = []
    for adopter in modules:
        append_records(implementations, adopter)
        append_owners(owners, adopter)
    return specialize_for(module, implementations, owners)


pub def is_default_body(module: &BodyIrModule, body: &Body) -> bool:
    """Identify a retained trait instance method so only the selected adopter schedules its default."""
    if len(body.locals) == 0 or receiver_mode(body.locals[0].origin) == None:
        return false
    match body.canonical:
        None => return false
        Some(identity) =>
            for owner in module.trait_declarations:
                if owner.origin == identity.origin and owner.declaration_span.start <= identity.declaration_span.start and identity.declaration_span.end <= owner.declaration_span.end:
                    return true
    return false


pub def is_lazy_method_body(module: &BodyIrModule, body: &Body) -> bool:
    """Keep dependency generic-owner methods governed until a call or native bridge selects them.

    Discovering an imported layout does not authorize execution of every closed receiver method. Source methods keep
    their ordinary root policy, and trait defaults retain their existing call-driven scheduling.
    """
    if is_default_body(module, body):
        return true
    if len(body.locals) == 0 or receiver_mode(body.locals[0].origin) == None:
        return false
    match body.canonical:
        None => return false
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method:
                return false
            match identity.origin:
                SymbolOrigin.Package(library=_library, module_path=_path) => pass
                _ => return false
            for owner in module.nominal_declarations:
                if len(owner.type_parameters) != 0 and owner.canonical.origin == identity.origin and owner.canonical.declaration_span.start <= identity.declaration_span.start and identity.declaration_span.end <= owner.canonical.declaration_span.end:
                    return true
    return false


def append_records(mut records: list[TraitImplementation], module: &BodyIrModule) -> None:
    """Copy one module's implementation records through the explicit interop clone the opaque Rust type needs."""
    for implementation in module.trait_implementations:
        records.append(implementation.clone())


def append_owners(mut owners: list[NominalDeclaration], module: &BodyIrModule) -> None:
    """Retain the checked owner frames whose parameters a default's Self must carry into layout specialization."""
    for declaration in module.nominal_declarations:
        owners.append(declaration.clone())


def specialize_for(
    module: &BodyIrModule,
    implementations: list[TraitImplementation],
    mut owners: list[NominalDeclaration],
) -> Result[BodyIrModule, str]:
    """Replace each open default of the module by one instance per adopter whose implementation it is."""
    mut result = module.clone()
    result.bodies.clear()
    for body in module.bodies:
        if len(body.locals) == 0 or body.locals[0].ty != RustType.SelfType:
            result.bodies.push(body.clone())
            continue
        # One default can fill several slots of one adopter (its own and the supertrait slots it refines); the
        # adopter still receives a single instantiation of it.
        mut instantiated: list[TraitImplementation] = []
        for implementation in implementations:
            if body.canonical != Some(implementation.implementation):
                continue
            if not first_instantiation(instantiated, implementation)?:
                continue
            instantiated.append(implementation.clone())
            concrete: RustType = concrete_self_type(implementation.owner, owners)?
            # A default with overlapping owner/method scopes is not representable by the current flat binding
            # environment. Do not construct that unused instance; selecting it still refuses at method_index.
            # In particular, never substitute the adopter's U for the default's independent method U.
            if deferred_shadowed_default(body, concrete, implementation.type_arguments):
                continue
            result.bodies.push(specialize_body(body, concrete, implementation.type_arguments))
    return Ok(result)


def deferred_shadowed_default(body: &Body, concrete: &RustType, arguments: list[TraitTypeArgument]) -> bool:
    """Leave an unsupported default unavailable without rejecting unrelated used methods of its adopter (#1698)."""
    match concrete:
        RustType.Generic(base=_base, args=owner_arguments) =>
            for parameter in body.type_parameters:
                if is_adoption_parameter(str(parameter), arguments):
                    continue
                for owner_argument in owner_arguments:
                    match owner_argument:
                        RustType.TypeVar(name) =>
                            if str(name) == str(parameter):
                                return true
                        _ => pass
        _ => pass
    return false


def first_instantiation(retained: list[TraitImplementation], candidate: &TraitImplementation) -> Result[bool, str]:
    """Report whether this adopter has no instantiation of the default yet; a conflicting second one refuses."""
    for implementation in retained:
        if implementation.owner != candidate.owner:
            continue
        if implementation.type_arguments != candidate.type_arguments:
            return Err("unsupported Body IR trait default at several instantiations for one adopter")
        return Ok(false)
    return Ok(true)


def specialize_body(body: &Body, concrete: &RustType, arguments: list[TraitTypeArgument]) -> Body:
    """Instantiate a trait default for one adopter: same statements and identities, Self and type parameters closed."""
    mut result = body.clone()
    mut parameters: list[str] = []
    for parameter in body.type_parameters:
        if not is_adoption_parameter(str(parameter), arguments):
            parameters.append(str(parameter))
    result.type_parameters = parameters
    for index in range(len(result.locals)):
        local_type: RustType = instantiate_type(result.locals[index].ty, concrete, arguments)
        result.locals[index].ty = local_type
    for index in range(len(result.params)):
        parameter_type: RustType = instantiate_type(result.params[index].ty, concrete, arguments)
        result.params[index].ty = parameter_type
    return_type: RustType = instantiate_type(result.return_type, concrete, arguments)
    result.return_type = return_type
    return result


def is_adoption_parameter(name: str, arguments: list[TraitTypeArgument]) -> bool:
    """Whether the checked adoption binds one declared trait parameter, leaving method parameters open."""
    for argument in arguments:
        if str(argument.parameter) == name:
            return true
    return false


def instantiate_type(ty: &RustType, concrete: &RustType, arguments: list[TraitTypeArgument]) -> RustType:
    """
    Close `Self` and the checker-recorded trait type arguments inside one checked type.

    Generic types, tuples and callable signatures are rebuilt around their closed arguments. Callable parameter metadata is preserved while its type and the result are instantiated. Other types keep unrepresented parameters, so native translation refuses instead of guessing a layout. Rebuilt elements append through an explicit interop clone because `List.append` cannot prove `Clone` for the opaque imported type.
    """
    match ty:
        RustType.SelfType => return concrete.clone()
        RustType.TypeVar(name) => return type_argument(ty, str(name), arguments)
        RustType.Generic(base=base, args=elements) =>
            mut closed: list[RustType] = []
            for element in elements:
                item: RustType = instantiate_type(element, concrete, arguments)
                closed.append(item.clone())
            # Work around legacy struct-variant construction (#2093); removed in dev.8.
            return generic(str(base), closed)
        RustType.Tuple(elements) =>
            mut closed: list[RustType] = []
            for element in elements:
                item: RustType = instantiate_type(element, concrete, arguments)
                closed.append(item.clone())
            return tuple_type_of(closed)
        RustType.Function(params=parameters, return_type=result) =>
            mut closed_parameters: list[RustCallableParam] = []
            for parameter in parameters:
                mut closed_parameter = parameter.clone()
                # Keep private recursive calls in a typed local so legacy preserves their canonical target.
                closed_parameter_type: RustType = instantiate_type(parameter.ty, concrete, arguments)
                closed_parameter.ty = closed_parameter_type
                closed_parameters.append(closed_parameter)
            closed_result: RustType = instantiate_type(result, concrete, arguments)
            return function_type(closed_parameters, closed_result)
        _ => return ty.clone()


def type_argument(ty: &RustType, name: str, arguments: list[TraitTypeArgument]) -> RustType:
    """Select the recorded argument for one trait type parameter, keeping a parameter no adoption bound."""
    for argument in arguments:
        if str(argument.parameter) == name:
            return argument.argument.clone()
    return ty.clone()


def tuple_type_of(elements: list[RustType]) -> RustType:
    """Rebuild one tuple type at an explicit typed return boundary for the legacy route that compiles this Loaf."""
    return RustType.Tuple(elements)


def concrete_self_type(owner: &CanonicalSymbolId, mut owners: list[NominalDeclaration]) -> Result[RustType, str]:
    """
    Retain the implementing owner's own parameters in Self until checked nominal instance scheduling closes them.

    A canonical owner lookup supplies the template carrier and declared frame; the trait's arguments never stand in for independent owner arguments. Enums use their already-retained non-generic owner name. No missing class or model layout is guessed.
    """
    for declaration in owners:
        if not PartialEq.eq(declaration.canonical, owner):
            continue
        if len(declaration.type_parameters) == 0:
            return Ok(RustType.Named(str(declaration.carrier_name())))
        mut arguments: list[RustType] = []
        for parameter in declaration.type_parameters:
            placeholder: RustType = RustType.TypeVar(str(parameter))
            arguments.append(placeholder.clone())
        return Ok(generic(str(declaration.template_carrier_name()), arguments))
    if owner.kind == SemanticSourceTargetKind.Enum:
        return Ok(RustType.Named(str(owner.declaration_name)))
    return Err("unsupported Body IR trait default without retained owner layout")


pub def receiver_fills_slot(
    module: &BodyIrModule,
    target: &MethodTarget,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> bool:
    """
    Whether a retained implementation record fills the selected slot for the receiver's concrete nominal.

    Such a slot dispatches to that body, ahead of any behavior a standard derive gives the slot, because the adopter's
    own method is what legacy calls. A receiver that is not a retained nominal has no record.
    """
    match receiver_owner(module, locals, argument, span, unions, intrinsics):
        Ok(owner) =>
            match owner_identity(module, owner):
                Ok(identity) =>
                    for implementation in module.trait_implementations:
                        if implementation.owner == identity and Some(implementation.method) == target.canonical:
                            return true
                    return false
                Err(_error) => return false
        Err(_error) => return false


pub def receiver_fills_source_slot(
    module: &BodyIrModule,
    target: &MethodTarget,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> bool:
    """Keep a checked source adopter on its own slot even when its required published default is unavailable."""
    match receiver_owner(module, locals, argument, span, unions, intrinsics):
        Err(_error) => return false
        Ok(owner) =>
            match owner:
                PlanType.Model(index, _name) =>
                    if library_item(module.nominal_declarations[index]) != "":
                        return false
                PlanType.Enum(index, _name) =>
                    if index >= len(module.enum_declarations):
                        return false
                    if library_enum_item(module.enum_declarations[index]) != "":
                        return false
                _ => return false
            return receiver_fills_slot(module, target, locals, argument, span, unions, intrinsics)


pub def receiver_fills_retained_slot(
    module: &BodyIrModule,
    target: &MethodTarget,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> bool:
    """Prefer an adopter's checked implementation only when its executable body is retained in this program."""
    match receiver_owner(module, locals, argument, span, unions, intrinsics):
        Err(_error) => return false
        Ok(owner) =>
            match owner_identity(module, owner):
                Err(_error) => return false
                Ok(identity) =>
                    for implementation in module.trait_implementations:
                        if implementation.owner != identity or Some(implementation.method) != target.canonical:
                            continue
                        for body in module.bodies:
                            if body.canonical == Some(implementation.implementation):
                                return true
                    return false


pub def method_index(
    module: &BodyIrModule,
    bodies: BodyIndex,
    target: &MethodTarget,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> Result[int, str]:
    """Select the checked implementation using the concrete receiver's retained layout identity."""
    owner = receiver_owner(module, locals, argument, span, unions, intrinsics)?
    return owner_method_index(module, bodies, target, owner, intrinsics)


def owner_method_identity(
    module: &BodyIrModule,
    target: &MethodTarget,
    owner: PlanType,
) -> Result[CanonicalSymbolId, str]:
    """Select the retained implementation once for both compiled Loaf calls and locally instantiated method bodies."""
    match target.canonical:
        None => return Err("unsupported Body IR unproven Method")
        Some(_identity) => pass
    identity = owner_identity(module, owner)?
    mut canonical = target.canonical.clone()
    for declaration in module.nominal_declarations:
        if declaration.canonical != identity:
            continue
        match declaration.class_inheritance:
            None => pass
            Some(inheritance) =>
                for implementation in inheritance.methods:
                    if Some(implementation.method) == canonical:
                        canonical = Some(implementation.implementation.clone())
                        break
    mut selected: Option[TraitImplementation] = None
    for implementation in module.trait_implementations:
        if implementation.owner == identity and Some(implementation.method) == canonical:
            match selected:
                Some(previous) =>
                    if previous.implementation != implementation.implementation or previous.type_arguments != implementation.type_arguments:
                        return Err("unsupported Body IR trait method at several instantiations for one receiver")
                None =>
                    selected = Some(implementation.clone())
    match selected:
        Some(implementation) =>
            canonical = Some(implementation.implementation.clone())
        None => pass
    match canonical:
        Some(identity) => return Ok(identity.clone())
        None => return Err("unsupported Body IR unproven Method")


pub def owner_method_index(
    module: &BodyIrModule,
    bodies: BodyIndex,
    target: &MethodTarget,
    owner: PlanType,
    mut intrinsics: list[EnumDeclaration],
) -> Result[int, str]:
    """Find the selected body's exact receiver frame; a compiled Loaf implementation uses its callable record instead."""
    identity = owner_identity(module, owner)?
    selected_identity = owner_method_identity(module, target, owner)?
    canonical = Some(selected_identity)
    candidate_indices = bodies.candidates(selected_identity)
    mut selected_index = -1
    for index in candidate_indices:
        body = module.bodies[index]
        if body.canonical != canonical or len(body.params) == 0:
            continue
        receiver = frame_type(module, body.locals[0], intrinsics)?
        if not receiver_matches(receiver, owner):
            continue
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) => pass
            None => return Err("unsupported Body IR Method without receiver")
        if selected_index >= 0:
            # Repeated publication of the same checked body is harmless; differing executable facts are ambiguous.
            if body != module.bodies[selected_index]:
                return Err("unsupported Body IR conflicting selected method executable bodies")
        else:
            selected_index = index
    if selected_index >= 0:
        return Ok(selected_index)
    # Diagnose only the existing refusal path; no candidate or receiver check above changes.
    mut candidate_count = 0
    mut candidates = ""
    for index in candidate_indices:
        body = module.bodies[index]
        if body.canonical != canonical:
            continue
        candidate_count += 1
        if candidate_count > 6:
            continue
        if len(body.locals) == 0:
            candidates += f"{body.name}(params={len(body.params)}, receiver=<no locals>); "
            continue
        match frame_type(module, body.locals[0], intrinsics):
            Ok(receiver) =>
                candidates += f"{body.name}(params={len(body.params)}, raw_receiver={body.locals[0].ty}, frame={receiver:?}); "
            Err(error) =>
                candidates += f"{body.name}(params={len(body.params)}, raw_receiver={body.locals[0].ty}, frame_error={error}); "
    return Err(
        f"unsupported Body IR nonlocal or trait-object Method; target={target.canonical:?}; owner={owner:?}; owner_identity={identity:?}; implementation={canonical:?}; canonical_candidates={candidate_count}; candidates_limit=6; candidates=[{candidates}]",
    )


pub def receiver_method_target(
    module: &BodyIrModule,
    target: &MethodTarget,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> Result[MethodTarget, str]:
    """Read an implementation target from a retained concrete receiver; nonnominal calls keep their original target."""
    match receiver_owner(module, locals, argument, span, unions, intrinsics):
        Ok(owner) => return implementation_target(module, target, owner)
        Err(_reason) => return Ok(target.clone())


pub def implementation_target(module: &BodyIrModule, target: &MethodTarget, owner: PlanType) -> Result[MethodTarget, str]:
    """Name the retained concrete implementation rather than its trait slot when calling an already compiled method."""
    mut selected = target.clone()
    canonical = owner_method_identity(module, target, owner)?
    selected.canonical = Some(canonical)
    if selected.canonical != target.canonical:
        # The selected item is the implementation's ordinary compiled entry, not the trait's native generic item.
        selected.loaf_trait = None
        selected.native_trait_delegation = None
    return Ok(selected)


def owner_identity(module: &BodyIrModule, owner: PlanType) -> Result[CanonicalSymbolId, str]:
    """The retained declaration identity a model or source enum receiver owner fills its trait slots under."""
    match owner:
        PlanType.Model(index, _name) => return Ok(module.nominal_declarations[index].canonical.clone())
        PlanType.Enum(index, _name) =>
            if index < len(module.enum_declarations):
                return Ok(module.enum_declarations[index].canonical.clone())
        _ => pass
    return Err("unsupported Body IR trait-object receiver")


def receiver_matches(receiver: PlanType, owner: PlanType) -> bool:
    """Match the declared receiver frame against the caller's checked concrete model or enum carrier."""
    match owner:
        PlanType.Model(owner_index, _owner_name) =>
            match receiver:
                PlanType.ModelRef(index, _name) => return index == owner_index
                PlanType.ModelMutRef(index, _name) => return index == owner_index
                _ => pass
        PlanType.Enum(owner_index, _owner_name) =>
            match receiver:
                PlanType.EnumRef(index, _name) => return index == owner_index
                _ => pass
        _ => pass
    return false


def receiver_owner(
    module: &BodyIrModule,
    locals: list[Local],
    argument: &ArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Read the concrete model or source enum receiver from its native place, reporting the refused frame carrier."""
    match argument.as_one():
        Some(value) =>
            match value:
                RustOperand.Place(read) =>
                    mut declarations = module.nominal_declarations
                    mut enums = module.enum_declarations
                    mut frame_locals = locals
                    mut union_layouts = unions
                    place = model_place(
                        declarations,
                        frame_locals,
                        read.place,
                        span,
                        enums,
                        union_layouts,
                        intrinsics,
                    )?
                    actual = place_type(locals, place)
                    match actual:
                        PlanType.Model(owner, name) => return Ok(PlanType.Model(owner, name))
                        PlanType.Enum(owner, name) =>
                            if owner < len(module.enum_declarations):
                                return Ok(PlanType.Enum(owner, name))
                        _ => pass
                    return Err(f"unsupported Body IR trait-object receiver {actual:?} at {span.line}:{span.column}")
                _ => return Err("unsupported Body IR Method nonplace receiver")
        None => return Err("unsupported Body IR Method spread receiver")


pub def validate_static_receiver(module: &BodyIrModule, target: &NamedCallableTarget) -> Result[None, str]:
    """Require a concrete retained model or source enum for associated calls, never execute a bare trait's default."""
    match target.receiver_type:
        Some(ty) =>
            match enum_type(list(module.enum_declarations), ty):
                Some(_owner) => return Ok(None)
                None => pass
            match model_type(list(module.nominal_declarations), ty)?:
                PlanType.Model(_owner, _name) => return Ok(None)
                _ => return Err("unsupported Body IR nonnominal static receiver")
        None => return Ok(None)
