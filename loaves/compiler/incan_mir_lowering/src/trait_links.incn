"""Validation of trait implementation records whose trait another module, the standard library or an SDK declares."""

from rust::incan_semantics_core import CanonicalSymbolId, SemanticSourceTargetKind, SymbolNamespace, SymbolOrigin
from rust::incan_semantics_core::body_ir import BodyIrModule, TraitImplementation, loaf_item_path
from nominal_frames import closed_arguments
from table_views import borrowed_at


pub def has_open_trait_arguments(implementation: &TraitImplementation) -> bool:
    """Identify a generic owner's open slot or inherited default arguments before validating concrete records."""
    return (
        not closed_arguments(implementation.slot_arguments)
        or not closed_arguments([binding.argument.clone() for binding in implementation.type_arguments])
    )


pub def validate_project_implementation(
    module: &BodyIrModule,
    implementation: &TraitImplementation,
    modules: &list[BodyIrModule],
    retained: &BodyIrModule,
) -> Result[None, str]:
    """
    Validate one trait implementation record against the current module slice and retained joined project authority.

    A record whose trait and filling body belong to this module is the module's own to validate. A record of an
    imported trait names a slot another module declares: it holds only when this module retains the adopter's layout,
    the adopter's own method or the slot's own default fills it, and an adopter-owned body remains retained. A package
    default holds by its checked identity until a call demands its executable body ([`is_imported_slot`]). Nor has a
    Rust trait's slot: it holds when the adopter's own adoption lists it and some module retains the filling body.
    A continuation may carry an unchanged declaring module only in `retained`; matching spellings never establish any
    of these facts.
    """
    if module.is_well_formed_trait_implementation(implementation):
        return Ok(None)
    if not module.trait_arguments_are_owner_bound(implementation):
        return Err("invalid Body IR trait implementation arguments")
    if not fills_its_slot(implementation):
        return Err("invalid Body IR trait implementation slot filling")
    if not retains_owner(module, implementation.owner):
        return Err("invalid Body IR trait implementation owner")
    if is_imported_slot(implementation.method):
        if (
            implementation.implementation == implementation.method
            or retains_body(modules, implementation.implementation)
            or retained_body(retained, implementation.implementation)
        ):
            return Ok(None)
        return Err("invalid Body IR trait implementation without a retained declaration")
    # A Rust trait has no declaring project module; the adopter's own adoption record names its slots instead.
    if adopted_rust_slot(module, implementation):
        if (
            retains_body(modules, implementation.implementation)
            or retained_body(retained, implementation.implementation)
        ):
            return Ok(None)
        return Err("invalid Body IR Rust trait implementation without a retained declaration")
    if not declares_slot(modules, implementation.method) and not retained_declares_slot(retained, implementation.method):
        return Err("invalid Body IR trait implementation without its declaring trait")
    if (
        not retains_body(modules, implementation.implementation)
        and not retained_body(retained, implementation.implementation)
    ):
        return Err("invalid Body IR trait implementation without a retained declaration")
    return Ok(None)


def is_imported_slot(slot: &CanonicalSymbolId) -> bool:
    """
    Whether a slot belongs to a standard module or an authenticated package, by its checked provider identity.

    Such a slot is filled by the adopter's own method, which a module must retain, or by the provider's own default. A
    call to that default demands its executable representation; an unavailable body refuses there, so the adoption
    record itself holds by the exact slot identity without eagerly loading every unused default.
    """
    match slot.origin:
        SymbolOrigin.Module(path) => return len(path) > 0 and path[0] == "std"
        SymbolOrigin.Package(library=_library, module_path=_path) => return true
        _ => return false


def fills_its_slot(implementation: &TraitImplementation) -> bool:
    """Require a method slot filled by its default or checked own method, or a property filled by its own getter."""
    slot = implementation.method
    filled = implementation.implementation
    if slot.namespace != SymbolNamespace.Member:
        return false
    if slot.kind != SemanticSourceTargetKind.Method and slot.kind != SemanticSourceTargetKind.Property:
        return false
    if filled.kind != slot.kind:
        return false
    if filled == slot:
        return slot.kind == SemanticSourceTargetKind.Method
    if slot.kind == SemanticSourceTargetKind.Property and slot.declaration_name != filled.declaration_name:
        return false
    # The adopter's own method shares its module, and spans of different files may nest, so the origin is compared too.
    return filled.origin == implementation.owner.origin and contains(implementation.owner, filled)


def adopted_rust_slot(module: &BodyIrModule, implementation: &TraitImplementation) -> bool:
    """Whether the adopter's own Rust trait adoption lists this slot; rustc checks the implementation itself."""
    match implementation.method.origin:
        SymbolOrigin.RustCrate(_path) => pass
        _ => return false
    for nominal_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, nominal_position)
        if declaration.canonical != implementation.owner.clone():
            continue
        for adoption in declaration.trait_adoptions:
            if adoption.trait_identity.origin != implementation.method.origin:
                continue
            match adoption.methods:
                Some(slots) =>
                    for slot in slots:
                        if slot == implementation.method:
                            return true
                None => pass
    return false


def retains_owner(module: &BodyIrModule, owner: &CanonicalSymbolId) -> bool:
    """Whether this module retains the adopter's well-formed model, class or enum layout."""
    for nominal_position in range(len(module.nominal_declarations)):
        declaration = borrowed_at(module.nominal_declarations, nominal_position)
        if declaration.canonical == owner.clone() and module.is_well_formed_nominal_declaration(declaration):
            return true
    for enum_position in range(len(module.enum_declarations)):
        declaration = borrowed_at(module.enum_declarations, enum_position)
        if declaration.canonical == owner.clone() and module.is_well_formed_native_enum_declaration(declaration):
            return true
    return false


def declares_slot(modules: &list[BodyIrModule], slot: &CanonicalSymbolId) -> bool:
    """Whether the module that declares the slot's trait retains that trait around the slot."""
    for module_position in range(len(modules)):
        module = borrowed_at(modules, module_position)
        if module_declares_slot(module, slot):
            return true
    return false


def module_declares_slot(module: &BodyIrModule, slot: &CanonicalSymbolId) -> bool:
    """Whether one module declares, as its own trait, the trait whose span encloses the slot."""
    for protocol_position in range(len(module.trait_declarations)):
        declaration = borrowed_at(module.trait_declarations, protocol_position)
        if declaration.origin != slot.origin or not contains(declaration, slot):
            continue
        match module.declaration_id_for_canonical(
            declaration,
            SymbolNamespace.OrdinaryLexical,
            SemanticSourceTargetKind.Trait,
        ):
            Some(_id) => return true
            None => pass
    return false


def retained_declares_slot(retained: &BodyIrModule, slot: &CanonicalSymbolId) -> bool:
    """Whether the already validated joined context retains the trait identity enclosing this slot."""
    for protocol_position in range(len(retained.trait_declarations)):
        declaration = borrowed_at(retained.trait_declarations, protocol_position)
        if declaration.origin == slot.origin and contains(declaration, slot):
            return true
    return false


def retains_body(modules: &list[BodyIrModule], identity: &CanonicalSymbolId) -> bool:
    """Whether some module retains the filling body under its canonical direct-call identity."""
    for module_position in range(len(modules)):
        module = borrowed_at(modules, module_position)
        if module_retains_body(module, identity):
            return true
    return false


def module_retains_body(module: &BodyIrModule, identity: &CanonicalSymbolId) -> bool:
    """Whether one module retains a checked body or the exact compiled Loaf declaration that implements the slot."""
    for body_position in range(len(module.bodies)):
        body = borrowed_at(module.bodies, body_position)
        if body.canonical == Some(identity.clone()) and module.body_has_canonical_direct_call_id(body):
            return true
    for callable_position in range(len(module.loaf_callables)):
        declaration = borrowed_at(module.loaf_callables, callable_position)
        if declaration.canonical != identity.clone():
            continue
        match loaf_item_path(identity):
            Some(path) =>
                if (
                    declaration.item == path
                    and identity.namespace == SymbolNamespace.Member
                    and identity.scope_discriminant == None
                    and (
                        identity.kind == SemanticSourceTargetKind.Method
                        or identity.kind == SemanticSourceTargetKind.Property
                    )
                ):
                    return true
            None => pass
    return false


def retained_body(retained: &BodyIrModule, identity: &CanonicalSymbolId) -> bool:
    """Whether the already validated joined context retains this canonical body or linked declaration."""
    for body_position in range(len(retained.bodies)):
        body = borrowed_at(retained.bodies, body_position)
        if body.canonical == Some(identity.clone()):
            return true
    return module_retains_body(retained, identity)


pub def contains(owner: CanonicalSymbolId, member: CanonicalSymbolId) -> bool:
    """Whether the owner's declaration span encloses the member's; callers compare origins, as spans of files nest."""
    return (
        owner.declaration_span.start <= member.declaration_span.start
        and member.declaration_span.end <= owner.declaration_span.end
    )
