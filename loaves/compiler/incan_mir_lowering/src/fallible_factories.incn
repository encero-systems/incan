"""Concrete native factory ABIs for authenticated published fallible-iterator defaults."""

from rust::incan_semantics_core import (
    CanonicalSymbolId,
    IncanType as RustType,
    SemanticSourceTargetKind,
    SymbolNamespace,
)
from rust::incan_semantics_core::body_ir import BodyIrModule, MethodTarget, NominalDeclaration
from pub::incan_mir_plan import (
    PlanType,
    EnumDeclaration,
    ModelDeclaration,
    ExternalFunction,
    Function,
    Local,
    Operand,
    OperandKind,
    Callee,
    CalleeKind,
    TerminatorKind,
    Unwind,
    Statement,
)
from pub::incan_mir_plan import block as plan_block, place as plan_place
from classes import function_name
from fallible_methods import standard_protocol
from trait_links import contains
from nominal_instances import instance_arguments
from decls import library_item
from layout_types import native_source_type
from native_type_identity import ConstructorIndex
from unions import collect_unions


pub model NativeFactory:
    """One checked default and the runtime helper's explicit concrete native arguments."""

    pub path: str
    pub arguments: list[PlanType]


pub def fallible_factory(
    constructors: &ConstructorIndex,
    module: &BodyIrModule,
    target: &MethodTarget,
    result: PlanType,
    mut intrinsics: list[EnumDeclaration],
) -> Result[Option[NativeFactory], str]:
    """Select only a published standard factory with its retained concrete return and actual SDK storage; argument refusals retain the checked type and slot position."""
    match target.canonical:
        None => return Ok(None)
        Some(slot) =>
            if not published_factory(module, slot):
                return Ok(None)
            carrier, arity = factory_carrier(str(slot.declaration_name))
            if arity == 0:
                return Ok(None)
            match result:
                PlanType.Model(owner, _name) =>
                    declaration = module.nominal_declarations[owner]
                    if (
                        library_item(declaration) == ""
                        or declaration.canonical.origin != slot.origin
                        or declaration.canonical.declaration_name != carrier
                    ):
                        return Err("the standard library factory has no checked canonical result type")
                    if not concrete_return(module, slot, declaration):
                        return Ok(None)
                    mut arguments: list[PlanType] = []
                    for argument in instance_arguments(declaration)?:
                        match native_source_type(
                            constructors,
                            list(module.nominal_declarations),
                            list(module.enum_declarations),
                            collect_unions(module),
                            argument,
                            intrinsics,
                        ):
                            Ok(value) => arguments.append(value)
                            Err(error) =>
                                return Err(
                                    f"{error}; standard {slot.declaration_name} factory argument {len(arguments) + 1} ({argument})",
                                )
                    if len(arguments) != arity:
                        return Err("unsupported Body IR standard factory native argument count")
                    return Ok(
                        Some(
                            NativeFactory(
                                path=f"incan_native_runtime::fallible_{slot.declaration_name}",
                                arguments=arguments,
                            ),
                        ),
                    )
                _ => return Ok(None)


def published_factory(module: &BodyIrModule, slot: &CanonicalSymbolId) -> bool:
    """A spelling grants no factory: the actual standard trait must enclose the checked member identity."""
    if slot.kind != SemanticSourceTargetKind.Method or slot.namespace != SymbolNamespace.Member:
        return false
    for root in module.trait_declarations:
        if root.origin == slot.origin and standard_protocol(root) and contains(root, slot):
            return true
    return false


def concrete_return(module: &BodyIrModule, slot: &CanonicalSymbolId, declaration: &NominalDeclaration) -> bool:
    """Require the exact published body and its return binding's canonical owner before substituting a runtime ABI."""
    for body in module.bodies:
        if body.canonical != Some(slot.clone()) or body.first_representation_gap() != None:
            continue
        match body.return_type:
            RustType.Generic(base=base, args=_arguments) =>
                match body.named_type_identities.get(str(base)):
                    Some(identity) =>
                        if declaration.canonical == identity.clone():
                            return true
                    None => pass
            RustType.Named(name) =>
                match body.named_type_identities.get(str(name)):
                    Some(identity) =>
                        if declaration.canonical == identity.clone():
                            return true
                    None => pass
            _ => pass
    return false


def factory_carrier(name: str) -> tuple[str, int]:
    """List the concrete public factory signatures mirrored by the existing Incan runtime helpers."""
    match name:
        "map" => return ("MapFallibleIterator", 5)
        "filter" => return ("FilterFallibleIterator", 4)
        "flat_map" => return ("FlatMapFallibleIterator", 5)
        "take" => return ("TakeFallibleIterator", 3)
        "inspect" => return ("InspectFallibleIterator", 4)
        "map_err" => return ("MapErrFallibleIterator", 5)
        "inspect_err" => return ("InspectErrFallibleIterator", 4)
        _ => return ("", 0)


model FactoryCallableStorage:
    """One concrete return owner and the checked signature of its shared callback."""

    pub owner: int
    pub signature: list[PlanType]


pub def retain_factory_callable_storage(
    module: &BodyIrModule,
    mut functions: list[Function],
    mut models: list[ModelDeclaration],
    mut externals: list[ExternalFunction],
) -> Result[None, str]:
    """Carry an authenticated factory's proven shared callback ABI into its concrete return carrier and generic call slot."""
    mut selected: list[FactoryCallableStorage] = []
    for external in externals:
        if external.path != "incan_native_runtime::fallible_map_err":
            continue
        if len(external.parameters) != 2 or len(external.type_arguments) != 5:
            return Err("invalid Body IR fallible error-map factory signature")
        match external.parameters[1]:
            PlanType.SharedCallable(signature) =>
                if len(signature) != 2:
                    return Err("invalid Body IR fallible error-map callable arity")
                match external.return_type:
                    PlanType.Model(owner, name) =>
                        if owner < 0 or owner >= len(models):
                            return Err("invalid Body IR fallible error-map return owner")
                        carrier = models[owner]
                        if (
                            carrier.name != name
                            or carrier.library_item != "incan_stdlib_core::derives::collection::MapErrFallibleIterator"
                        ):
                            return Err("unsupported Body IR fallible error-map return identity")
                        if carrier.library_type_arguments != external.type_arguments:
                            return Err("unsupported Body IR fallible error-map return arguments")
                        if (
                            external.type_arguments[4] != PlanType.FunctionPointer(signature)
                            or external.type_arguments[1] != signature[0]
                            or external.type_arguments[3] != signature[1]
                        ):
                            return Err("unsupported Body IR fallible error-map callback identity")
                        if external.type_arguments[2] != external.parameters[0] or len(carrier.fields) != 5:
                            return Err("unsupported Body IR fallible error-map source identity")
                        if (
                            carrier.fields[0].name != "source"
                            or carrier.fields[0].ty != external.parameters[0]
                            or carrier.fields[1].name != "f"
                            or carrier.fields[1].ty != PlanType.FunctionPointer(signature)
                        ):
                            return Err("unsupported Body IR fallible error-map callback field")
                        for prior in selected:
                            if prior.owner == owner and prior.signature != signature:
                                return Err("unsupported Body IR conflicting fallible callback storage")
                        selected.append(FactoryCallableStorage(owner=owner, signature=signature))
                    _ => return Err("unsupported Body IR fallible error-map return carrier")
            _ => pass
    # Validate every factory producing a selected carrier before updating any native type arguments.
    for storage in selected:
        owner = storage.owner
        signature = storage.signature
        for external in externals:
            if (
                external.path == "incan_native_runtime::fallible_map_err"
                and external.return_type == PlanType.Model(owner, models[owner].name)
            ):
                if external.parameters[1] != PlanType.SharedCallable(signature):
                    return Err("unsupported Body IR mixed fallible callback storage")
    for storage in selected:
        owner = storage.owner
        signature = storage.signature
        models[owner].library_type_arguments[4] = PlanType.SharedCallable(signature)
        models[owner].fields[1].ty = PlanType.SharedCallable(signature)
        for index in range(len(externals)):
            if (
                externals[index].path == "incan_native_runtime::fallible_map_err"
                and externals[index].return_type == PlanType.Model(owner, models[owner].name)
            ):
                previous_arguments = externals[index].type_arguments.clone()
                externals[index].type_arguments[4] = PlanType.SharedCallable(signature)
                retain_factory_call_arguments(
                    functions,
                    externals[index].path,
                    previous_arguments,
                    externals[index].type_arguments,
                )
        retain_shared_factory_poll(module, models, owner, functions, externals)?
    return Ok(None)


def retain_shared_factory_poll(
    module: &BodyIrModule,
    models: list[ModelDeclaration],
    owner: int,
    mut functions: list[Function],
    mut externals: list[ExternalFunction],
) -> Result[None, str]:
    """Forward the exact published error-map poll to its linked SDK implementation with the proven callback storage."""
    declaration = module.nominal_declarations[owner]
    if library_item(declaration) != "incan_stdlib_core::derives::collection::MapErrFallibleIterator":
        return Err("unsupported Body IR shared factory poll owner")
    mut found = false
    for body in module.bodies:
        match body.canonical:
            Some(identity) =>
                if (
                    identity.origin != declaration.canonical.origin
                    or identity.declaration_name != "__next__"
                    or identity.kind != SemanticSourceTargetKind.Method
                    or identity.namespace != SymbolNamespace.Member
                ):
                    continue
                if (
                    identity.declaration_span.start < declaration.canonical.declaration_span.start
                    or identity.declaration_span.end > declaration.canonical.declaration_span.end
                ):
                    continue
            None => continue
        name = function_name(module, body)
        for index in range(len(functions)):
            if functions[index].name != name:
                continue
            original = functions[index]
            reference = PlanType.ModelMutRef(owner, models[owner].name)
            if len(original.parameters) != 1 or original.parameters[0].ty != reference:
                continue
            if original.is_async or original.future_callee != None or len(body.params) != 1:
                return Err("unsupported Body IR shared factory poll signature")
            span = original.span
            arguments = [
                models[owner].library_type_arguments[0],
                models[owner].library_type_arguments[3],
                PlanType.Model(owner, models[owner].name),
            ]
            path = "incan_native_runtime::fallible_next"
            invocation = TerminatorKind.Call(
                Callee(kind=CalleeKind.Instantiated(path, arguments), span=span),
                [Operand(kind=OperandKind.Move(plan_place(1, span)), span=span)],
                plan_place(0, span),
                1,
                Unwind.Continue,
            )
            functions[index] = Function(
                name=name,
                parameters=original.parameters,
                return_type=original.return_type,
                locals=[Local(ty=original.return_type, span=span), Local(ty=reference, span=span)],
                blocks=[plan_block([], invocation, span), plan_block([], TerminatorKind.Return, span)],
                span=span,
            )
            externals.append(
                ExternalFunction(
                    path=path,
                    type_arguments=arguments,
                    parameters=[reference],
                    return_type=original.return_type,
                    span=span,
                ),
            )
            found = true
    if not found:
        return Err("unsupported Body IR missing authenticated shared factory poll")
    return Ok(None)


def retain_factory_call_arguments(
    mut functions: list[Function],
    path: str,
    previous: list[PlanType],
    selected: list[PlanType],
) -> None:
    """Keep call-site instantiations equal to the exact authenticated factory signature after callback storage selection."""
    for function_index in range(len(functions)):
        for block_index in range(len(functions[function_index].blocks)):
            original = functions[function_index].blocks[block_index].terminator.kind.clone()
            match original:
                TerminatorKind.Call(callee, operands, destination, target, unwind) =>
                    match callee.kind:
                        CalleeKind.Instantiated(called_path, arguments) =>
                            if called_path == path and arguments == previous:
                                updated = Callee(kind=CalleeKind.Instantiated(path, selected), span=callee.span)
                                invocation = TerminatorKind.Call(updated, operands, destination, target, unwind)
                                functions[function_index].blocks[block_index].terminator.kind = invocation
                        _ => pass
                _ => pass
