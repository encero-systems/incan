"""Admission table for Body IR's canonical text operations."""

from rust::incan_semantics_core::body_ir import HelperOp
from rust::incan_lang::lang::types::stringlike import StringLikeId, as_str as stringlike_name
from pub::incan_mir_plan import PlanType, ListLeaf, Operand, Place, SourceSpan
from frame import Builder, temporary, external_call
from lists import is_list


pub def text_helper(helper: &HelperOp) -> Option[tuple[str, PlanType]]:
    """Select text-only helpers whose parameters borrow strings and whose runtime semantics match legacy."""
    match helper:
        HelperOp.StrConcat => return Some(("concat_text", PlanType.String))
        HelperOp.StrEq => return Some(("equal_text", PlanType.Bool))
        HelperOp.StrNe => return Some(("unequal_text", PlanType.Bool))
        HelperOp.StrLt => return Some(("less_text", PlanType.Bool))
        HelperOp.StrLe => return Some(("less_equal_text", PlanType.Bool))
        HelperOp.StrGt => return Some(("greater_text", PlanType.Bool))
        HelperOp.StrGe => return Some(("greater_equal_text", PlanType.Bool))
        HelperOp.StrLen => return Some(("length_text", PlanType.Int))
        HelperOp.StrUpper => return Some(("upper_text", PlanType.String))
        HelperOp.StrLower => return Some(("lower_text", PlanType.String))
        HelperOp.StrStrip => return Some(("strip_text", PlanType.String))
        HelperOp.StrReplace => return Some(("replace_text", PlanType.String))
        HelperOp.StrNotContains => return Some(("not_contains_text", PlanType.Bool))
        HelperOp.StrContains => return Some(("contains_text", PlanType.Bool))
        HelperOp.TextCodecEncodingValid => return Some(("text_codec_encoding_valid", PlanType.Bool))
        HelperOp.TextCodecErrorsValid => return Some(("text_codec_errors_valid", PlanType.Bool))
        _ => return None


pub def text_helper_arity(name: str) -> int:
    """Retain the positional runtime signatures for text-only helpers."""
    if name in ["length_text", "upper_text", "lower_text", "strip_text", "clone_text", "split_whitespace_text", "text_codec_encoding_valid", "text_codec_errors_valid"]:
        return 1
    if name == "replace_text":
        return 3
    return 2


pub def text_method(member: str, receiver: PlanType) -> Option[tuple[str, PlanType]]:
    """Select canonical string methods without admitting a same-named user declaration."""
    if receiver not in [PlanType.String, PlanType.StringRef, PlanType.FrozenStr]:
        return None
    for owner in [stringlike_name(StringLikeId.Str), stringlike_name(StringLikeId.FrozenStr)]:
        if member == f"{owner}.to_string":
            return Some(("clone_text", PlanType.String))
        if member == f"{owner}.startswith":
            return Some(("starts_text", PlanType.Bool))
        if member == f"{owner}.endswith":
            return Some(("ends_text", PlanType.Bool))
        if member == f"{owner}.split_whitespace":
            return Some(("split_whitespace_text", PlanType.List(ListLeaf.Str, 1)))
    return None


pub def emit_text_helper(
    mut builder: Builder,
    name: str,
    result: PlanType,
    parameters: list[PlanType],
    operands: list[Operand],
    span: SourceSpan,
) -> Place:
    """Emit one canonical borrowed-text call and retain its owned result for transfer or discard."""
    text = temporary(builder, result, span)
    external_call(builder, f"incan_native_runtime::{name}", parameters, result, operands, text, span)
    if is_list(result):
        builder.owned.append(text.local)
    return text
