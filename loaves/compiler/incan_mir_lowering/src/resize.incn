"""Checked builtin numeric resize calls reuse legacy casts and core policy functions."""

from pub::incan_mir_plan import Carrier
from pub::incan_mir_plan import PlanType, Operand, Place, SourceSpan, RvalueKind, CalleeKind, ExternalFunction
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, terminate_call, place_type
from numerics import numeric_carrier
from options import carrier_layout
from rust::incan_lang::lang::types::numerics import NumericResizeMethodId as RustNumericResizeMethodId


pub def emit_resize(
    mut builder: Builder,
    policy: RustNumericResizeMethodId,
    source: PlanType,
    operand: Operand,
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Use the checked output carrier, including the retained Some payload for checked resizing."""
    result = place_type(builder.locals, output)
    mut target = result
    if policy == RustNumericResizeMethodId.Try:
        _owner, declaration = carrier_layout(builder, result)?
        if declaration.carrier != Carrier.Option or len(declaration.variants) != 2:
            return Err("invalid Body IR checked resize carrier")
        # An Option carrier lays out None then Some, so the payload is the second variant's.
        payloads = declaration.variants[1].fields
        if len(payloads) != 1:
            return Err("invalid Body IR checked resize payload")
        target = payloads[0]
    if not numeric_carrier(target):
        return Err("unsupported Body IR resize destination outside numeric carriers")
    if policy in [RustNumericResizeMethodId.Lossless, RustNumericResizeMethodId.Wrapping]:
        builder.emit(plan_assign(output, RvalueKind.NumericCast(operand, source, target), span))
        return Ok(None)
    policy_name = match policy:
        RustNumericResizeMethodId.Try => "try_resize"
        RustNumericResizeMethodId.Saturating => "saturating_resize"
        _ => return Err("unsupported Body IR numeric resize policy")
    path = f"incan_std_primitives::num::{policy_name}"
    builder.externals.append(
        ExternalFunction(path=path, type_arguments=[source, target], parameters=[source], return_type=result, span=span),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, [source, target]), [operand], output, span)
    return Ok(None)
