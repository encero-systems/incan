"""Lower checked operators: arithmetic and bit operations, and equality and ordering comparisons."""

from pub::incan_mir_plan import (
    Carrier,
    BinaryOp,
    CalleeKind,
    ExternalFunction,
    Constant,
    ListLeaf,
    Operand,
    OperandKind,
    Place,
    PlanType,
    TupleElement,
    RvalueKind,
    SourceSpan,
    UnaryOp,
    assign as plan_assign,
    place as plan_place,
)
from bytes_plan import bytes_literal
from text_ownership import drop_borrowed_text_temporaries
from decimal_plan import decimal_comparison
from rust::incan_semantics_core::body_ir import (
    BinOp,
    Constant as RustConstant,
    Operand as RustOperand,
    OwnershipFact,
    Rvalue as RustRvalue,
    UnOp,
)
from rust::incan_semantics_core import SemanticSourceTargetKind
from frozen_equality import compare_frozen
from optional_text_equality import optional_text_equality
from element_places import is_element_place
from enums import unit_variant, validate_unit_comparison, validate_unit_ordering
from enum_display import native_enum_owner
from value_enums import value_variant
from options import carrier_layout
from numbers import float_operand
from numerics import integer_carrier
from strings import emit_text_helper
