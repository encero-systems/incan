"""Checked primitive, tuple, source-local model and carrier pattern tests for direct-route match dispatch."""

from rust::incan_semantics_core::body_ir import (
    Pattern as RustPattern,
    Constant as RustConstant,
    NominalPatternTarget,
    OwnershipFact,
)
from pub::incan_mir_plan import (
    PlanType,
    Place,
    SourceSpan,
    RvalueKind,
    BinaryOp,
    Constant,
    TerminatorKind,
    FieldProjection,
    Projection,
)
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, temporary, place_type, read_place, literal, external_call, drop_owned, appended_field
from tuples import tuple_fields, is_tuple_type
from text_plan import owned_literal
from layout_types import native_source_type as retained_type
from enums import pattern_variant
from unions import union_pattern_slot
from options import intrinsic_pattern, variant_condition
from numerics import numeric_constant


pub def enum_pattern_place(mut builder: Builder, source: Place, span: SourceSpan) -> Place:
    """Inspect a stored shared enum reference without moving its owner or losing a preceding payload projection."""
    mut ty = PlanType.Unit
    match place_type(builder.locals, source):
        PlanType.EnumRef(owner, name) =>
            ty = PlanType.Enum(owner, name)
        PlanType.EnumMutRef(owner, name) =>
            if source.projection == Projection.Whole:
                return Place(local=source.local, projection=Projection.Deref(PlanType.Enum(owner, name)), span=span)
            return source
        _ => return source
    mut reference = source
    if source.projection != Projection.Whole:
        reference = temporary(builder, place_type(builder.locals, source), span)
        builder.emit(plan_assign(reference, RvalueKind.Use(read_place(source, false, span)), span))
    return Place(local=reference.local, projection=Projection.Deref(ty), span=span)


pub def pattern_tests(
    mut builder: Builder,
    source: Place,
    pattern: &RustPattern,
    selected: int,
    rejected: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Test retained literals and tuple components before any arm binding becomes initialized."""
    match pattern:
        RustPattern.Wildcard => builder.finish(TerminatorKind.Goto(selected), span)
        RustPattern.Var(_binding) => builder.finish(TerminatorKind.Goto(selected), span)
        RustPattern.Literal(value) =>
            # `None` names a carrier variant; every other literal compares a primitive value.
            if value.clone() == RustConstant.None:
                return carrier_tests(builder, source, pattern, selected, rejected, span)
            condition = literal_test(builder, source, value, span)?
            builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), rejected, selected), span)
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=_fields) =>
            return carrier_tests(builder, source, pattern, selected, rejected, span)
        RustPattern.Result(variant=_variant, fields=_fields) =>
            return carrier_tests(builder, source, pattern, selected, rejected, span)
        RustPattern.FieldlessEnumVariant(_target) =>
            return carrier_tests(builder, source, pattern, selected, rejected, span)
        RustPattern.UnionMember(ty=_ty, fields=_fields) =>
            return carrier_tests(builder, source, pattern, selected, rejected, span)
        RustPattern.Tuple(items) =>
            ty = place_type(builder.locals, source)
            if not is_tuple_type(ty):
                return Err("invalid Body IR tuple pattern carrier")
            fields = tuple_fields(source, ty, span)?
            if len(fields) != len(items):
                return Err("invalid Body IR tuple pattern layout")
            for index in range(len(items)):
                next_component = builder.new_block(span)
                pattern_tests(builder, fields[index], items[index], next_component, rejected, span)?
                builder.current = next_component
            builder.finish(TerminatorKind.Goto(selected), span)
        RustPattern.Nominal(target=target, fields=fields) =>
            # Named fields are tested in written order, each against its own field of the borrowed scrutinee.
            for name, field_pattern in fields:
                next_field = builder.new_block(span)
                field = nominal_field(builder, source, target, str(name), span)?
                pattern_tests(builder, field, field_pattern, next_field, rejected, span)?
                builder.current = next_field
            builder.finish(TerminatorKind.Goto(selected), span)
        RustPattern.Or(alternatives) =>
            # An alternation that binds nothing selects on its first matching alternative; each failure tries the next.
            if pattern_binds(pattern):
                return Err("unsupported Body IR binding alternation")
            for alternative in alternatives:
                next_alternative = builder.new_block(span)
                pattern_tests(builder, source, alternative, selected, next_alternative, span)?
                builder.current = next_alternative
            builder.finish(TerminatorKind.Goto(rejected), span)
        _ => return Err("unsupported Body IR structural match pattern")
    return Ok(None)


pub def carrier_pattern_slot(builder: Builder, owner: int, pattern: &RustPattern) -> Result[int, str]:
    """Select the variant a source enum, union, `Option` or `Result` pattern names; a wildcard names none (-1)."""
    if owner < len(builder.enums):
        return pattern_variant(builder.enums[owner], pattern)
    declaration = builder.intrinsics[owner - len(builder.enums)]
    if declaration.carrier == "":
        return union_pattern_slot(builder.nominals, builder.enums, builder.unions, owner, pattern, builder.intrinsics)
    return intrinsic_pattern(declaration, pattern)


pub def carrier_payload_types(builder: Builder, owner: int, slot: int) -> Result[list[PlanType], str]:
    """The declared payload types of one variant of a retained source enum or standard carrier."""
    if owner < len(builder.enums):
        mut types: list[PlanType] = []
        for ty in builder.enums[owner].variants[slot].fields:
            types.append(retained_type(builder.nominals, builder.enums, builder.unions, ty, builder.intrinsics)?)
        return Ok(types)
    return Ok(builder.intrinsics[owner - len(builder.enums)].variants[slot].fields)


pub def has_refutable_payload(pattern: &RustPattern) -> bool:
    """Report whether a carrier pattern tests more than its variant: a literal or a nested pattern in a payload, or an alternation."""
    match pattern:
        RustPattern.Or(_alternatives) => return true
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=fields) =>
            return any_refutable(fields)
        RustPattern.Result(variant=_variant, fields=fields) => return any_refutable(fields)
        RustPattern.UnionMember(ty=_ty, fields=fields) => return any_refutable(fields)
        _ => return false


def any_refutable(fields: &list[RustPattern]) -> bool:
    """Report whether any payload pattern can reject a value of its type."""
    for field in fields:
        match field:
            RustPattern.Wildcard => pass
            RustPattern.Var(_binding) => pass
            _ => return true
    return false


def carrier_tests(
    mut builder: Builder,
    source: Place,
    pattern: &RustPattern,
    selected: int,
    rejected: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Test a carrier pattern's variant, then each payload pattern against its projected payload, in order."""
    carrier = enum_pattern_place(builder, source, span)
    mut owner = -1
    match place_type(builder.locals, carrier):
        PlanType.Enum(index, _name) =>
            owner = index
        _ => return Err(f"invalid Body IR carrier pattern scrutinee {place_type(builder.locals, carrier):?}")
    slot = carrier_pattern_slot(builder, owner, pattern)?
    if slot < 0:
        builder.finish(TerminatorKind.Goto(selected), span)
        return Ok(None)
    matched = builder.new_block(span)
    condition = variant_condition(builder, carrier, slot, span)
    builder.finish(TerminatorKind.SwitchBool(condition, rejected, matched), span)
    builder.current = matched
    match pattern:
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=fields) =>
            return payload_tests(builder, carrier, owner, slot, fields, selected, rejected, span)
        RustPattern.Result(variant=_variant, fields=fields) =>
            return payload_tests(builder, carrier, owner, slot, fields, selected, rejected, span)
        RustPattern.UnionMember(ty=_ty, fields=fields) =>
            return payload_tests(builder, carrier, owner, slot, fields, selected, rejected, span)
        _ => builder.finish(TerminatorKind.Goto(selected), span)
    return Ok(None)


def payload_tests(
    mut builder: Builder,
    source: Place,
    owner: int,
    slot: int,
    fields: &list[RustPattern],
    selected: int,
    rejected: int,
    span: SourceSpan,
) -> Result[None, str]:
    """Test each payload pattern of a selected variant against its payload, rejecting at the first mismatch."""
    types = carrier_payload_types(builder, owner, slot)?
    if len(types) != len(fields):
        return Err("invalid Body IR carrier pattern payload layout")
    for index in range(len(fields)):
        payload = appended_field(source, FieldProjection(slot=index, ty=types[index], variant=slot), span)?
        next_payload = builder.new_block(span)
        pattern_tests(builder, payload, fields[index], next_payload, rejected, span)?
        builder.current = next_payload
    builder.finish(TerminatorKind.Goto(selected), span)
    return Ok(None)


pub def pattern_binds(pattern: &RustPattern) -> bool:
    """Report whether any position of a pattern binds a name."""
    return len(bound_in_place(pattern)) != 0


pub def binds_in_place(pattern: &RustPattern) -> bool:
    """Report whether a pattern binds a name its arm changes in place, as an exclusive borrow of the scrutinee."""
    return true in bound_in_place(pattern)


def bound_in_place(pattern: &RustPattern) -> list[bool]:
    """For every name a pattern binds, in source order, whether the name borrows its part of the scrutinee exclusively."""
    mut bound: list[bool] = []
    match pattern:
        RustPattern.Var(binding) => bound.append(binding.fact == OwnershipFact.MutBorrow)
        RustPattern.Tuple(items) => bound.extend(all_bound_in_place(items))
        RustPattern.Or(alternatives) => bound.extend(all_bound_in_place(alternatives))
        RustPattern.Enum(canonical=_identity, name=_name, variant=_variant, fields=fields) =>
            bound.extend(all_bound_in_place(fields))
        RustPattern.Result(variant=_variant, fields=fields) => bound.extend(all_bound_in_place(fields))
        RustPattern.UnionMember(ty=_ty, fields=fields) => bound.extend(all_bound_in_place(fields))
        RustPattern.Nominal(target=_target, fields=fields) =>
            for _name, field_pattern in fields:
                bound.extend(bound_in_place(field_pattern))
        RustPattern.Struct(canonical=_identity, name=_name, fields=fields) =>
            for _name, field_pattern in fields:
                bound.extend(bound_in_place(field_pattern))
        _ => pass
    return bound


def all_bound_in_place(patterns: &list[RustPattern]) -> list[bool]:
    """Collect `bound_in_place` across several patterns, in order."""
    mut bound: list[bool] = []
    for pattern in patterns:
        bound.extend(bound_in_place(pattern))
    return bound


pub def nominal_field(
    builder: Builder,
    source: Place,
    target: &NominalPatternTarget,
    name: str,
    span: SourceSpan,
) -> Result[Place, str]:
    """Project one canonical field of a model scrutinee once the pattern proves it names the scrutinee's declaration."""
    match place_type(builder.locals, source):
        PlanType.Model(owner, _name) =>
            declaration = builder.nominals[owner]
            if target.direct_declaration_id != declaration.direct_declaration_id or target.canonical != declaration.canonical:
                return Err("invalid Body IR nominal pattern target")
            for slot in range(len(declaration.fields)):
                if declaration.fields[slot] == name:
                    ty = retained_type(
                        builder.nominals,
                        builder.enums,
                        builder.unions,
                        declaration.field_types[slot],
                        builder.intrinsics,
                    )?
                    return appended_field(source, FieldProjection(slot=slot, ty=ty), span)
            return Err("invalid Body IR nominal pattern field")
        _ => return Err("invalid Body IR nominal pattern carrier")


def literal_test(mut builder: Builder, source: Place, value: &RustConstant, span: SourceSpan) -> Result[Place, str]:
    """Compare an exact primitive literal carrier, borrowing strings through the existing equality runtime."""
    ty = place_type(builder.locals, source)
    match value:
        RustConstant.Str(text) =>
            if ty != PlanType.String:
                return Err("invalid Body IR string pattern carrier")
            return text_literal_test(builder, source, str(text), span)
        _ => pass
    mut constant = Constant.Unit
    mut expected = PlanType.Unit
    match value.clone():
        RustConstant.Int(number) =>
            constant = Constant.Int(number)
            expected = PlanType.Int
        RustConstant.Float(text) =>
            constant = Constant.Float(float(str(text)))
            expected = PlanType.Float
        RustConstant.Bool(flag) =>
            constant = Constant.Bool(flag)
            expected = PlanType.Bool
        RustConstant.TypedNumeric(number) =>
            constant = numeric_constant(number)?
            match constant:
                Constant.Numeric(_spelling, carrier) =>
                    expected = carrier
                _ => return Err("unsupported Body IR nonprimitive numeric literal pattern")
        RustConstant.Unit => pass
        _ => return Err("unsupported Body IR nonprimitive literal pattern")
    if ty != expected:
        return Err("invalid Body IR literal pattern carrier")
    result = temporary(builder, PlanType.Bool, span)
    if ty == PlanType.Unit:
        builder.emit(plan_assign(result, RvalueKind.Use(literal(Constant.Bool(true), span)), span))
    else:
        builder.emit(
            plan_assign(
                result,
                RvalueKind.Binary(BinaryOp.Equal, read_place(source, false, span), literal(constant, span)),
                span,
            ),
        )
    return Ok(result)


def text_literal_test(mut builder: Builder, source: Place, text: str, span: SourceSpan) -> Result[Place, str]:
    """Borrow both strings for equality and keep the materialized literal in the frame's owner ledger."""
    value = owned_literal(builder, text, span)
    builder.owned.append(value.local)
    source_ref = temporary(builder, PlanType.StringRef, span)
    value_ref = temporary(builder, PlanType.StringRef, span)
    builder.emit(plan_assign(source_ref, RvalueKind.Borrow(source), span))
    builder.emit(plan_assign(value_ref, RvalueKind.Borrow(value), span))
    result = temporary(builder, PlanType.Bool, span)
    external_call(
        builder,
        "incan_native_runtime::equal_text",
        [PlanType.StringRef, PlanType.StringRef],
        PlanType.Bool,
        [read_place(source_ref, false, span), read_place(value_ref, false, span)],
        result,
        span,
    )
    # Release the literal before branching: a rejected earlier tuple field never initializes later literals.
    drop_owned(builder, value.local, span)
    return Ok(result)
