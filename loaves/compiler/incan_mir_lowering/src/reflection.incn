"""Checked generated field reflection over retained concrete storage, with legacy's typed and string contracts."""

from rust::incan_semantics_core import SemanticSourceTargetKind
from rust::incan_semantics_core::body_ir import (
    MethodTarget,
    NamedCallableTarget,
    ReflectionOperation,
    ArgumentElement,
    Place as RustPlace,
)
from pub::incan_mir_plan import (
    PlanType,
    Place,
    Operand,
    RvalueKind,
    FieldProjection,
    SourceSpan,
    TerminatorKind,
    CalleeKind,
)
from pub::incan_mir_plan import assign as plan_assign, tuple_element_type
from frame import (
    Builder,
    temporary,
    read_place,
    place_type,
    appended_field,
    external_call,
    track_rvalue_moves,
    value_type,
    drop_owned,
    terminate_call,
)
from model_values import nominal_place
from options import carrier_layout, carrier_payload_value, assign_carrier, variant_condition, replace_owned_destination
from option_tests import is_union_carrier
from unions import union_slot
from layout_types import native_source_type
from tuples import tuple_aggregate
from lists import list_shape, list_element
from builtins import list_call
from text_plan import owned_literal
from lowering import scalar_place, text_argument, display_plan_value, append_list_value


pub def lower_reflection(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[ArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """Admit only a retained generated operation and an eligible checked nominal field policy."""
    if lower_field_metadata(builder, target, arguments, destination, span)?:
        return Ok(true)
    mut string = false
    mut items = false
    match target.reflection:
        None => return Ok(false)
        Some(operation) =>
            match operation:
                ReflectionOperation.Metadata =>
                    return Err("unsupported Body IR field metadata without a retained declaration")
                ReflectionOperation.TypedValue => pass
                ReflectionOperation.TypedItems =>
                    items = true
                ReflectionOperation.StringValue =>
                    string = true
                ReflectionOperation.StringItems =>
                    string = true
                    items = true
    if len(arguments) != 1 + int(not items) or len(target.type_args) != 0:
        return Err("unsupported Body IR reflection argument contract")
    match target.canonical:
        None => return Err("unsupported Body IR reflection without generated identity")
        Some(_identity) => pass
    match arguments[0].as_one():
        None => return Err("unsupported Body IR reflection receiver spread")
        Some(value) =>
            match nominal_place(builder, value, span)?:
                None => return Err("unsupported Body IR reflection receiver storage")
                Some(receiver) =>
                    match place_type(builder.locals, receiver):
                        PlanType.Model(owner, _name) =>
                            match builder.nominals[owner].reflection_fields:
                                None => return Err("unsupported Body IR reflection field policy")
                                Some(slots) =>
                                    if len(builder.nominals[owner].type_parameters) != 0:
                                        return Err("unsupported Body IR reflection over generic fields")
                                    mut fields: list[int] = []
                                    # Indexed reads copy Rust's primitive slot; a borrowed loop item cannot be cast by legacy.
                                    for index in range(len(slots)):
                                        fields.append(int(slots[index]))
                                    validate_reflection_fields(builder, owner, receiver, fields, string, target, span)?
                                    match destination:
                                        None => return Err("unsupported Body IR discarded reflection result")
                                        Some(place) =>
                                            output = scalar_place(builder, place, span)?
                                            if items:
                                                reflect_items(builder, owner, receiver, fields, string, output, span)?
                                            else:
                                                reflect_value(
                                                    builder,
                                                    owner,
                                                    receiver,
                                                    fields,
                                                    string,
                                                    arguments,
                                                    output,
                                                    span,
                                                )?
                                            return Ok(true)
                        _ => return Err("unsupported Body IR reflection receiver carrier")


pub def lower_field_metadata(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[ArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """Return immutable declaration metadata only for the checker-selected generated hook and exact native FieldInfo layout."""
    if target.reflection != Some(ReflectionOperation.Metadata):
        return Ok(false)
    if len(arguments) != 1 or len(target.type_args) != 0:
        return Err("unsupported Body IR field metadata arguments")
    match arguments[0].as_one():
        None => return Err("unsupported Body IR field metadata receiver spread")
        Some(value) =>
            match nominal_place(builder, value, span)?:
                None => return Err("unsupported Body IR field metadata receiver")
                Some(receiver) =>
                    match place_type(builder.locals, receiver):
                        PlanType.Model(owner, _name) =>
                            match target.canonical:
                                None => return Err("unsupported Body IR field metadata identity")
                                Some(identity) =>
                                    declaration = builder.nominals[owner].canonical
                                    if identity.origin != declaration.origin or identity.declaration_span != declaration.declaration_span or identity.scope_discriminant != declaration.scope_discriminant or identity.declaration_name != "__fields__":
                                        return Err("unsupported Body IR field metadata owner mismatch")
                            return emit_field_metadata(builder, owner, destination, span)
                        _ => return Err("unsupported Body IR field metadata receiver carrier")


pub def lower_static_field_metadata(
    mut builder: Builder,
    target: &NamedCallableTarget,
    arguments: &list[ArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """Use the checked static owner and generated member identity; authored methods have their own independent spans."""
    match target.canonical:
        None => return Ok(false)
        Some(identity) =>
            if identity.kind != SemanticSourceTargetKind.Method or identity.declaration_name != "__fields__":
                return Ok(false)
            match target.receiver_type:
                None => return Ok(false)
                Some(receiver) =>
                    match native_source_type(
                        builder.nominals,
                        builder.enums,
                        builder.unions,
                        receiver,
                        builder.intrinsics,
                    )?:
                        PlanType.Model(owner, _name) =>
                            declaration = builder.nominals[owner].canonical
                            if identity.origin != declaration.origin or identity.declaration_span != declaration.declaration_span or identity.scope_discriminant != declaration.scope_discriminant:
                                return Ok(false)
                            if len(arguments) != 0 or len(target.type_args) != 0:
                                return Err("unsupported Body IR static field metadata arguments")
                            return emit_field_metadata(builder, owner, destination, span)
                        _ => return Err("unsupported Body IR static field metadata owner")


def emit_field_metadata(
    mut builder: Builder,
    owner: int,
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[bool, str]:
    """Share the value/type hook's immutable declaration records and exact SDK result carrier."""
    match builder.nominals[owner].reflection_metadata:
        None => return Err("unsupported Body IR field metadata declaration")
        Some(_fields) => pass
    for info in range(len(builder.nominals)):
        if builder.nominals[info].native_item != "incan_std_core::reflection::FieldInfo":
            continue
        ty = PlanType.FrozenCollection("FrozenList", [PlanType.Model(info, str(builder.nominals[info].name))])
        mut output = temporary(builder, ty, span)
        match destination:
            Some(place) =>
                output = scalar_place(builder, place, span)?
                if place_type(builder.locals, output) != ty:
                    return Err("unsupported Body IR field metadata output carrier")
            None => pass
        terminate_call(builder, CalleeKind.FieldMetadata(owner, info), [], output, span)
        return Ok(true)
    return Err("unsupported Body IR field metadata SDK layout")


def reflected_field(mut builder: Builder, owner: int, source: Place, slot: int, span: SourceSpan) -> Result[Place, str]:
    """Project only an in-range retained source field using its canonical declared type."""
    if slot < 0 or slot >= len(builder.nominals[owner].fields):
        return Err("unsupported Body IR reflection field slot")
    field_type = builder.nominals[owner].field_types[slot]
    ty = native_source_type(
        builder.nominals,
        builder.enums,
        builder.unions,
        field_type,
        builder.intrinsics,
    )?
    return appended_field(source, FieldProjection(slot=slot, ty=ty), span)


def scalar_reflection_type(ty: PlanType) -> bool:
    """Admit supported scalar Display carriers; other scalar variants retain a named frontier."""
    return ty == PlanType.String or ty == PlanType.Int or ty == PlanType.Float or ty == PlanType.Bool


def validate_reflection_fields(
    mut builder: Builder,
    owner: int,
    receiver: Place,
    fields: list[int],
    string: bool,
    target: &MethodTarget,
    span: SourceSpan,
) -> Result[None, str]:
    """Prove generated ownership and the whole generic capability before lowering a single lookup."""
    if not string:
        match target.canonical:
            Some(identity) =>
                declaration = builder.nominals[owner].canonical
                if identity.origin != declaration.origin or identity.declaration_span != declaration.declaration_span or identity.scope_discriminant != declaration.scope_discriminant:
                    return Err("unsupported Body IR reflection generated owner mismatch")
            None => return Err("unsupported Body IR reflection generated owner")
        return Ok(None)
    if "FieldInfo" not in builder.nominals[owner].derives:
        return Err("unsupported Body IR generic reflection without field metadata")
    for slot in fields:
        field = reflected_field(builder, owner, receiver, slot, span)?
        ty = place_type(builder.locals, field)
        if scalar_reflection_type(ty):
            continue
        _index, layout = carrier_layout(builder, ty)?
        if layout.carrier != "Option" or len(layout.variants[1].fields) != 1 or not scalar_reflection_type(
            layout.variants[1].fields[0],
        ):
            return Err("unsupported Body IR generic reflection field capability")
    return Ok(None)


def scalar_string(mut builder: Builder, field: Place, span: SourceSpan) -> Result[Operand, str]:
    """Use Rust Display for an eligible scalar, cloning owned text before transferring it to the formatter."""
    ty = place_type(builder.locals, field)
    if not scalar_reflection_type(ty):
        return Err("unsupported Body IR generic field reflection scalar")
    value = carrier_payload_value(builder, field, span)?
    output = display_plan_value(builder, value, span, true)?
    return Ok(read_place(output, true, span))


def string_field(mut builder: Builder, field: Place, span: SourceSpan) -> Result[Operand, str]:
    """Stringify optional scalar fields as their contained Display value or literal None, never Option Debug."""
    ty = place_type(builder.locals, field)
    match ty:
        PlanType.Enum(_owner, _name) =>
            _index, layout = carrier_layout(builder, ty)?
            if layout.carrier != "Option" or len(layout.variants[1].fields) != 1:
                return Err("unsupported Body IR generic field reflection optional carrier")
            output = temporary(builder, PlanType.String, span)
            selected = builder.new_block(span)
            missing = builder.new_block(span)
            join = builder.new_block(span)
            owners = builder.owned
            condition = variant_condition(builder, field, 1, span)
            builder.finish(TerminatorKind.SwitchBool(condition, missing, selected), span)
            builder.current = selected
            payload = appended_field(field, FieldProjection(slot=0, ty=layout.variants[1].fields[0], variant=1), span)?
            value = scalar_string(builder, payload, span)?
            replace_owned_destination(builder, output, RvalueKind.Use(value), span)
            builder.finish(TerminatorKind.Goto(join), span)
            builder.current = missing
            builder.owned = owners
            text = owned_literal(builder, "None", span)
            replace_owned_destination(builder, output, RvalueKind.Use(read_place(text, true, span)), span)
            retained = builder.owned
            builder.finish(TerminatorKind.Goto(join), span)
            builder.current = join
            builder.owned = retained
            return Ok(read_place(output, true, span))
        _ => return scalar_string(builder, field, span)


def field_value(
    mut builder: Builder,
    field: Place,
    string: bool,
    expected: PlanType,
    span: SourceSpan,
) -> Result[Operand, str]:
    """Clone a typed field and wrap its exact union member, or stringify under the checked generic contract."""
    if string:
        if expected != PlanType.String:
            return Err("unsupported Body IR reflection string result contract")
        return string_field(builder, field, span)
    value = carrier_payload_value(builder, field, span)?
    if value_type(builder, value)? == expected:
        return Ok(value)
    match expected:
        PlanType.Enum(owner, _name) =>
            if not is_union_carrier(builder, owner):
                return Err("unsupported Body IR reflection typed overlay")
            member = value_type(builder, value)?
            slot = union_slot(
                builder.nominals,
                builder.enums,
                builder.unions,
                owner,
                member,
                builder.intrinsics,
            )?
            output = temporary(builder, expected, span)
            replace_owned_destination(builder, output, RvalueKind.Enum(owner, slot, [value]), span)
            return Ok(read_place(output, true, span))
        _ => return Err("unsupported Body IR reflection field result contract")


def reflect_items(
    mut builder: Builder,
    owner: int,
    receiver: Place,
    fields: list[int],
    string: bool,
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Build owned name/value tuples in retained source order, transferring tuple owners into the list."""
    ty = place_type(builder.locals, output)
    match list_shape(ty):
        None => return Err("unsupported Body IR reflection items list")
        Some((leaf, depth)) =>
            element = list_element(leaf, depth)
            match element:
                PlanType.Tuple(elements) =>
                    if len(elements) != 2:
                        return Err("unsupported Body IR reflection items tuple")
                    expected = tuple_element_type(elements[1])
                    list_call(builder, "empty_list", element, [], ty, [], output, span)
                    for slot in fields:
                        field = reflected_field(builder, owner, receiver, slot, span)?
                        value = field_value(builder, field, string, expected, span)?
                        name = owned_literal(builder, str(builder.nominals[owner].fields[slot]), span)
                        tuple = temporary(builder, element, span)
                        operation = tuple_aggregate([read_place(name, true, span), value])
                        track_rvalue_moves(builder, operation)
                        builder.emit(plan_assign(tuple, operation, span))
                        builder.owned.append(tuple.local)
                        append_list_value(builder, output, read_place(tuple, true, span), leaf, depth, span)?
                    return Ok(None)
                _ => return Err("unsupported Body IR reflection items element")


def reflect_value(
    mut builder: Builder,
    owner: int,
    receiver: Place,
    fields: list[int],
    string: bool,
    arguments: &list[ArgumentElement],
    output: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Compare names and aliases once, clone only a matched field, and construct checked Some or None results."""
    index, layout = carrier_layout(builder, place_type(builder.locals, output))?
    if layout.carrier != "Option" or len(layout.variants[1].fields) != 1:
        return Err("unsupported Body IR reflection lookup result")
    key = text_argument(builder, arguments, 1, span)?
    join = builder.new_block(span)
    owners = builder.owned
    for slot in fields:
        mut keys = [str(builder.nominals[owner].fields[slot])]
        if len(builder.nominals[owner].field_aliases) == len(builder.nominals[owner].fields):
            match builder.nominals[owner].field_aliases[slot]:
                Some(alias) =>
                    if str(alias) != keys[0]:
                        keys.append(str(alias))
                None => pass
        for name in keys:
            yes = builder.new_block(span)
            no = builder.new_block(span)
            condition = temporary(builder, PlanType.Bool, span)
            text = owned_literal(builder, name, span)
            reference = temporary(builder, PlanType.StringRef, span)
            builder.emit(plan_assign(reference, RvalueKind.Borrow(text), span))
            literal = read_place(reference, false, span)
            external_call(
                builder,
                "incan_native_runtime::equal_text",
                [PlanType.StringRef, PlanType.StringRef],
                PlanType.Bool,
                [key, literal],
                condition,
                span,
            )
            drop_owned(builder, text.local, span)
            builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), no, yes), span)
            builder.current = yes
            field = reflected_field(builder, owner, receiver, slot, span)?
            value = field_value(builder, field, string, layout.variants[1].fields[0], span)?
            assign_carrier(builder, output, index, 1, [value], span)
            builder.finish(TerminatorKind.Goto(join), span)
            builder.current = no
            builder.owned = owners
    assign_carrier(builder, output, index, 0, [], span)
    retained = builder.owned
    builder.finish(TerminatorKind.Goto(join), span)
    builder.current = join
    builder.owned = retained
    return Ok(None)
