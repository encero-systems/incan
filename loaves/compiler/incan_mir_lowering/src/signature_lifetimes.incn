"""Preserve generic reference binders before specialization erases their relationship in concrete frame types."""

from rust::incan_semantics_core import IncanInputAccess, IncanType as RustType
from rust::incan_semantics_core::body_ir import Body
from pub::incan_mir_plan import GenericLoan, PlanType


pub def generic_loans(body: &Body, arguments: list[PlanType]) -> list[GenericLoan]:
    """1. Retain parameter occurrences. 2. Retain result occurrences under the same source type identities."""
    mut loans: list[GenericLoan] = []
    # 1. A source type parameter keeps its identity at every structural occurrence in an input.
    for slot in range(len(body.params)):
        type_generic_loans(body.params[slot].ty, body.type_parameters, arguments, slot, [], loans)
    # 2. Return occurrences carry exactly the same identity, including loans hidden inside native values.
    type_generic_loans(body.return_type, body.type_parameters, arguments, len(body.params), [], loans)
    return loans


def type_generic_loans(
    ty: &RustType,
    names: list[str],
    arguments: list[PlanType],
    slot: int,
    path: list[int],
    mut loans: list[GenericLoan],
) -> None:
    """Record type-parameter provenance through references, tuples and declaration-ordered generic arguments."""
    match ty:
        RustType.TypeVar(name) =>
            for index in range(len(names)):
                if names[index] == str(name):
                    loans.append(GenericLoan(slot=slot, path=path, parameter=index, ty=arguments[index]))
                    return
        RustType.Ref(inner) => type_generic_loans(inner, names, arguments, slot, path + [0], loans)
        RustType.RefMut(inner) => type_generic_loans(inner, names, arguments, slot, path + [0], loans)
        RustType.Tuple(elements) => element_generic_loans(elements, names, arguments, slot, path, loans)
        RustType.Generic(base=_base, args=elements) =>
            element_generic_loans(elements, names, arguments, slot, path, loans)
        _ => pass


def element_generic_loans(
    elements: &list[RustType],
    names: list[str],
    arguments: list[PlanType],
    slot: int,
    path: list[int],
    mut loans: list[GenericLoan],
) -> None:
    """Keep distinct source type parameters distinct even when their concrete native types happen to be equal."""
    for index in range(len(elements)):
        type_generic_loans(elements[index], names, arguments, slot, path + [index], loans)


pub def signature_lifetimes(body: &Body, arguments: list[RustType]) -> Result[list[list[str]], str]:
    """
    Retain generic loans: 1. Visit original parameters. 2. Visit the result. 3. Tie a returned view to its source.
    4. Preserve source elision made ambiguous by specialization. 5. Omit unneeded annotations.

    Each reference introduced by one type argument has a distinct binder, reused at every occurrence of that
    argument. Source-written references remain elided; they never acquire a substituted argument's binder.
    """
    mut signature: list[list[str]] = []
    # 1. Visit original parameters while the source type parameters still exist.
    for parameter in body.params:
        signature.append(type_lifetimes(parameter.ty, body.type_parameters, arguments, ""))
    # 2. Visit the original result under the same binder identities.
    signature.append(type_lifetimes(body.return_type, body.type_parameters, arguments, ""))
    # 3. A returned view's reference shares its source parameter's outer borrow, and nothing else. A direct view's
    # reference is the result itself; a carried view's is the first reference of its carrying payload.
    match body.returned_view:
        Some(view) =>
            if view.access != IncanInputAccess.Owned:
                slot = int(view.slot)
                signature[slot] = ["view"] + signature[slot]
                result = signature[len(signature) - 1]
                match view.carried:
                    Some(payload) =>
                        position = payload_reference(body.return_type, int(payload), body.type_parameters, arguments)
                        if position >= len(result):
                            return Err("carried returned view has no payload reference")
                        signature[len(signature) - 1] = result[:position] + ["view"] + result[position + 1:]
                    None => signature[len(signature) - 1] = ["view"] + result
                return Ok(signature)
        None => pass
    # 4. A generic source signature with one elided input loan ties an elided output to it. If substituting a
    # reference type adds another loan, retain that original relationship explicitly instead of asking rustc to
    # reconstruct it from the now-concrete signature.
    if has_generic_loans(signature):
        retain_unique_source_elision(signature)
    # 5. Omit annotations when specialization introduces no generic loans, including transformed generators.
    if has_generic_loans(signature):
        return Ok(signature)
    return Ok([])


def retain_unique_source_elision(mut signature: list[list[str]]) -> None:
    """Name the one source-written input loan and every source-elided result loan after generic substitution adds ambiguity."""
    if len(signature) < 2:
        return
    mut input_elisions = 0
    for slot in range(len(signature) - 1):
        for name in signature[slot]:
            if name == "":
                input_elisions += 1
    if input_elisions != 1:
        return
    result = signature[len(signature) - 1]
    if "" not in result:
        return
    for slot in range(len(signature) - 1):
        signature[slot] = named_source_elisions(signature[slot])
    signature[len(signature) - 1] = named_source_elisions(result)


def named_source_elisions(names: list[str]) -> list[str]:
    """Replace source-written elision markers while preserving generic loan names and reference order."""
    mut retained: list[str] = []
    for name in names:
        if name == "":
            retained.append("elided")
        else:
            retained.append(name)
    return retained


def payload_reference(result: &RustType, payload: int, names: list[str], arguments: list[RustType]) -> int:
    """
    The position of a carried view's reference among its result's references: after every earlier payload's, or
    every earlier tuple element's.
    """
    match result:
        RustType.Generic(base=_base, args=elements) => return references_before(elements, payload, names, arguments)
        RustType.Tuple(elements) => return references_before(elements, payload, names, arguments)
        _ => return 0


def references_before(elements: &list[RustType], payload: int, names: list[str], arguments: list[RustType]) -> int:
    """Count the references of the components before the one carrying a view."""
    mut position = 0
    for index in range(payload):
        position += len(type_lifetimes(elements[index], names, arguments, ""))
    return position


def has_generic_loans(signature: list[list[str]]) -> bool:
    """Decide whether specialization introduced any reference binder the concrete signature must preserve."""
    for loans in signature:
        for loan in loans:
            if loan != "":
                return true
    return false


def type_lifetimes(ty: &RustType, names: list[str], arguments: list[RustType], binder: str) -> list[str]:
    """Collect references in structural preorder, naming only loans introduced by a retained generic argument."""
    mut loans: list[str] = []
    match ty:
        RustType.TypeVar(name) =>
            for index in range(len(names)):
                if names[index] == str(name):
                    return type_lifetimes(arguments[index], [], [], f"t{index}")
        RustType.Ref(inner) =>
            loans.append(binder)
            loans.extend(type_lifetimes(inner, names, arguments, child_binder(binder, 0)))
        RustType.RefMut(inner) =>
            loans.append(binder)
            loans.extend(type_lifetimes(inner, names, arguments, child_binder(binder, 0)))
        RustType.Generic(base=_base, args=elements) =>
            loans.extend(element_lifetimes(elements, names, arguments, binder))
        RustType.Tuple(elements) => loans.extend(element_lifetimes(elements, names, arguments, binder))
        _ => pass
    return loans


def element_lifetimes(elements: &list[RustType], names: list[str], arguments: list[RustType], binder: str) -> list[str]:
    """Keep independent references within one generic argument distinct by their structural position."""
    mut loans: list[str] = []
    for index in range(len(elements)):
        loans.extend(type_lifetimes(elements[index], names, arguments, child_binder(binder, index)))
    return loans


def child_binder(binder: str, index: int) -> str:
    """Extend only a generic loan's identity; source references retain ordinary independent elision."""
    if binder == "":
        return ""
    return f"{binder}_{index}"
