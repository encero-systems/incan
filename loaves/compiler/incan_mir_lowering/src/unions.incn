"""Anonymous unions reuse native enum layouts and legacy's normalized payload order and names."""

from rust::incan_semantics_core import IncanType as RustType
from rust::std::collections import BTreeSet
from rust::std::sync import Arc
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    Body,
    NominalDeclaration,
    NativeUnionDeclaration,
    EnumDeclaration as RustEnumDeclaration,
    StaticInitializer,
)
from pub::incan_mir_plan import (
    ListLeaf,
    list_leaf_type,
    PlanType,
    EnumDeclaration,
    EnumVariant,
    SourceSpan,
    Operand,
    RvalueKind,
    Place,
    Projection,
    BinaryOp,
    Constant,
    TerminatorKind,
)
from pub::incan_mir_plan import assign as plan_assign
from frame import Builder, temporary, read_place, literal
from rust::incan_semantics_core::body_ir import Pattern as RustPattern, Place as RustPlace, PlaceElem as RustPlaceElem
from enums import validate_payload_patterns, enum_owner
from layout_types import native_source_type
from nominal_frames import declaration_storage


pub def collect_unions(module: &BodyIrModule) -> list[RustType]:
    """Retain each union shape once across checked frame and declaration types."""
    mut unions: list[RustType] = []
    mut added: BTreeSet[RustType] = BTreeSet.new()
    empty: BTreeSet[RustType] = BTreeSet.new()
    retained: Arc[BTreeSet[RustType]] = Arc.new(empty)
    for ty in declaration_storage(module):
        retain_union(unions, retained.as_ref(), added, ty)
    for delegation in module.loaf_callables:
        if len(delegation.type_parameters) != 0:
            continue
        for parameter in delegation.parameters:
            retain_union(unions, retained.as_ref(), added, parameter)
        retain_union(unions, retained.as_ref(), added, delegation.return_type)
    for body in module.bodies:
        retain_union(unions, retained.as_ref(), added, body.return_type)
        for local in body.locals:
            retain_union(unions, retained.as_ref(), added, local.ty)
    for declaration in module.nominal_declarations:
        for ty in declaration.field_types:
            retain_union(unions, retained.as_ref(), added, ty)
    for declaration in module.enum_declarations:
        for variant in declaration.variants:
            for ty in variant.fields:
                retain_union(unions, retained.as_ref(), added, ty)
    for declaration in module.static_declarations:
        retain_union(unions, retained.as_ref(), added, declaration.ty)
        match declaration.initial:
            StaticInitializer.Computed(body) => retain_body_union_types(unions, retained.as_ref(), added, body)
            _ => pass
    return unions


pub def union_index(unions: list[RustType]) -> Arc[BTreeSet[RustType]]:
    """Index exact checked types once, independently of the list order that fixes native union slots."""
    mut retained: BTreeSet[RustType] = BTreeSet.new()
    for ty in unions:
        retained.insert(ty.clone())
    return Arc.new(retained)


pub def retain_body_unions(mut unions: list[RustType], retained: &BTreeSet[RustType], body: &Body) -> None:
    """Append only closed instance shapes absent from the shared program index, preserving every existing owner slot."""
    mut added: BTreeSet[RustType] = BTreeSet.new()
    retain_body_union_types(unions, retained, added, body)


def retain_body_union_types(
    mut unions: list[RustType],
    retained: &BTreeSet[RustType],
    mut added: BTreeSet[RustType],
    body: &Body,
) -> None:
    """Visit a body's types against the caller's accumulated index, including computed statics during collection."""
    retain_union(unions, retained, added, body.return_type)
    for local in body.locals:
        retain_union(unions, retained, added, local.ty)


def retain_union(
    mut unions: list[RustType],
    retained: &BTreeSet[RustType],
    mut added: BTreeSet[RustType],
    ty: &RustType,
) -> None:
    """Test exact borrowed keys before copying a new union into its ordered slot and the instance's membership index."""
    match ty:
        RustType.Generic(base=base, args=arguments) =>
            for argument in arguments:
                retain_union(unions, retained, added, argument)
            if str(base) == "Union" and not retained.contains(ty) and not added.contains(ty):
                added.insert(ty.clone())
                unions.append(ty.clone())
        RustType.Function(params=parameters, return_type=result) =>
            for parameter in parameters:
                retain_union(unions, retained, added, parameter.ty)
            retain_union(unions, retained, added, result)
        RustType.Tuple(elements) =>
            for element in elements:
                retain_union(unions, retained, added, element)
        RustType.Ref(inner) => retain_union(unions, retained, added, inner)
        RustType.RefMut(inner) => retain_union(unions, retained, added, inner)
        _ => pass


pub def union_members(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    ty: &RustType,
    intrinsics: &list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Normalize by legacy Rust payload spelling, retaining only scalar and previously admitted nominal members."""
    mut members: list[PlanType] = []
    mut keys: list[str] = []
    unions: list[RustType] = []
    match ty:
        RustType.Generic(base=base, args=args) =>
            if str(base) != "Union":
                return Err(f"unsupported Body IR union type {ty}")
            for arg in args:
                member = native_source_type(nominals, enums, unions, arg, intrinsics)?
                if member == PlanType.Unit:
                    return Err("unsupported Body IR optional union")
                mut key = ""
                match legacy_spelling(member):
                    Ok(spelling) => key = spelling
                    Err(reason) => return Err(f"unsupported Body IR union member {arg}: {reason}")
                if key not in keys:
                    keys.append(key)
                    members.append(member)
        _ => return Err(f"unsupported Body IR union type {ty}")
    mut ordered: list[PlanType] = []
    for key in sorted(keys):
        for index in range(len(keys)):
            if keys[index] == key:
                ordered.append(members[index])
    if len(ordered) < 2:
        return Err("unsupported Body IR degenerate union")
    return Ok(ordered)


def legacy_spelling(ty: PlanType) -> Result[str, str]:
    """Retain the legacy Rust payload keys used for normalization and generated union identity."""
    match ty:
        PlanType.Int => return Ok("i64")
        PlanType.Float => return Ok("f64")
        PlanType.Bool => return Ok("bool")
        PlanType.String => return Ok("String")
        PlanType.FrozenStr => return Ok("FrozenStr")
        PlanType.U8 => return Ok("u8")
        PlanType.Model(_index, name) => return Ok(name)
        PlanType.Enum(_index, name) => return Ok(name)
        PlanType.List(leaf, depth) => return list_spelling(leaf, depth)
        _ => return Err("unsupported Body IR union member")


def list_spelling(leaf: ListLeaf, depth: int) -> Result[str, str]:
    """Spell a scalar-leaf list member as legacy's nested `Vec` payload key; tuple leaves stay refused."""
    mut spelling = legacy_spelling(list_leaf_type(leaf))?
    for _level in range(depth):
        spelling = f"Vec<{spelling}>"
    return Ok(spelling)


def union_name(members: list[PlanType]) -> Result[str, str]:
    """Mirror legacy's FNV-1a name over normalized Rust payload keys, using explicit wrapping u64 arithmetic."""
    mut keys: list[str] = []
    for member in members:
        keys.append(legacy_spelling(member)?)
    mut hash: u64 = 14695981039346656037
    prime: u64 = 1099511628211
    for byte in "|".join(keys).encode():
        word: u64 = int(byte).wrapping_resize()
        hash ^= word
        hash = hash.wrapping_mul(prime)
    # Incan format strings currently admit only Debug; render legacy's fixed-width hex explicitly.
    digits = "0123456789abcdef"
    mut suffix = ""
    for _index in range(16):
        nibble: int = (hash % 16).wrapping_resize()
        suffix = digits[nibble] + suffix
        hash >>= 4
    return Ok("__IncanUnion" + suffix)


pub def publish_unions(
    module: &BodyIrModule,
    intrinsics: &list[EnumDeclaration],
    mut published: list[NativeUnionDeclaration],
) -> Result[None, str]:
    """Publish the emitted wrapper and payload order, preserving the checker's semantic carrier and nominal owners."""
    unions: list[RustType] = []
    for ty in collect_unions(module):
        for index in range(len(intrinsics)):
            declaration = intrinsics[index]
            if declaration.source_type != str(ty) or declaration.carrier != "" or declaration.library_item != "":
                continue
            mut members: list[RustType] = []
            match ty:
                RustType.Generic(base=_base, args=arguments) =>
                    for variant in declaration.variants:
                        for index in range(len(arguments)):
                            argument = arguments[index]
                            mut native = native_source_type(
                                module.nominal_declarations,
                                module.enum_declarations,
                                unions,
                                argument,
                                intrinsics,
                            )?
                            for retained in module.native_union_declarations:
                                if retained.ty == ty.clone():
                                    native = native_union_payload(module, retained, argument, intrinsics)?
                                    break
                            if variant.fields == [native]:
                                members.append(argument.clone())
                _ => return Err("invalid Body IR published union carrier")
            if len(members) != len(declaration.variants):
                return Err("invalid Body IR published union payloads")
            mut closure_members: list[RustType] = []
            for member in members:
                for retained in module.native_union_declarations:
                    if (
                        retained.ty == ty.clone()
                        and member in retained.closure_members
                        and member not in closure_members
                    ):
                        closure_members.append(member.clone())
            mut closure_items: list[str] = []
            for item in declaration.closure_items:
                closure_items.append(item)
            native = NativeUnionDeclaration(
                ty=ty.clone(),
                rust_item=declaration.name,
                members=members,
                closure_members=closure_members,
                closure_items=closure_items,
            )
            published.append(native.clone())
    return Ok(None)


pub def require_native_union_signature(
    ty: &RustType,
    intrinsics: &list[EnumDeclaration],
    source_carriers: bool = false,
) -> Result[None, str]:
    """Require retained union carriers: checked Rust generics admit source carriers; linked Loaves need their owner."""
    match ty:
        RustType.Generic(base=base, args=arguments) =>
            for argument in arguments:
                _ = require_native_union_signature(argument, intrinsics, source_carriers)?
            if str(base) != "Union":
                return Ok(None)
            for declaration in intrinsics:
                if declaration.source_type == str(ty) and (source_carriers or declaration.library_item != ""):
                    return Ok(None)
            return Err("unsupported Body IR Loaf union without admitted native representation")
        RustType.Tuple(elements) =>
            for element in elements:
                _ = require_native_union_signature(element, intrinsics, source_carriers)?
        RustType.Ref(inner) => return require_native_union_signature(inner, intrinsics, source_carriers)
        RustType.RefMut(inner) => return require_native_union_signature(inner, intrinsics, source_carriers)
        _ => pass
    return Ok(None)


pub def lower_union_declaration(
    module: &BodyIrModule,
    ty: &RustType,
    file: str,
    intrinsics: &list[EnumDeclaration],
) -> Result[EnumDeclaration, str]:
    """
    Construct a normalized union only after its nested payload layouts have been retained.

    A source-owned union derives Clone and exposes Debug only when every payload supports it. An admitted Loaf alias
    uses its owner's implementations and callable object types.
    """
    mut members: list[PlanType] = []
    mut native_item = ""
    mut name = ""
    mut closure_items: list[str] = []
    mut foreign_owner = false
    for declaration in module.native_union_declarations:
        if declaration.ty == ty.clone() and "::" in str(declaration.rust_item):
            foreign_owner = true
    for declaration in module.native_union_declarations:
        if declaration.ty != ty.clone():
            continue
        if foreign_owner and "::" not in str(declaration.rust_item):
            continue
        if native_item != "" and native_item != str(declaration.rust_item):
            return Err("unsupported Body IR conflicting published native union owners")
        ordered = published_union_members(module, declaration, intrinsics)?
        if native_item != "" and members != ordered:
            return Err("unsupported Body IR conflicting published union payload order")
        members = ordered
        closure_items = []
        for item in declaration.closure_items:
            closure_items.append(str(item))
        item = str(declaration.rust_item)
        if "::" in item:
            native_item = item
        segments = item.split("::")
        name = segments[len(segments) - 1]
    if name == "":
        members = union_members(list(module.nominal_declarations), list(module.enum_declarations), ty, intrinsics)?
        name = union_name(members)?
    mut variants: list[EnumVariant] = []
    for index in range(len(members)):
        variants.append(EnumVariant(name=f"V{index}", fields=[members[index]]))
    if native_item == "":
        closure_items = []
        for index in range(len(members)):
            match members[index]:
                PlanType.Closure(_signature) => closure_items.append(f"{name}_callable_{index}")
                _ => pass
    derives: list[str] = ["Clone"]
    mut member_debug = native_item == ""
    for member in members:
        match member:
            PlanType.Closure(_signature) => member_debug = false
            _ => pass
    return Ok(
        EnumDeclaration(
            comparison_methods=[],
            name=name,
            public=true,
            variants=variants,
            derives=derives,
            library_item=native_item,
            span=SourceSpan(file=file, line=1, column=1),
            source_type=str(ty),
            member_debug=member_debug,
            closure_items=closure_items,
        ),
    )


def published_union_members(
    module: &BodyIrModule,
    declaration: &NativeUnionDeclaration,
    intrinsics: &list[EnumDeclaration],
) -> Result[list[PlanType], str]:
    """Validate published payloads against checked semantic members without sorting them or hashing a local name."""
    mut ordered: list[PlanType] = []
    for member in declaration.members:
        ordered.append(native_union_payload(module, declaration, member, intrinsics)?)
    match declaration.ty:
        RustType.Generic(base=base, args=arguments) =>
            if str(base) != "Union" or len(arguments) != len(ordered):
                return Err("unsupported Body IR admitted union payload mismatch")
            for argument in arguments:
                if argument not in declaration.members:
                    return Err("unsupported Body IR admitted union payload mismatch")
        _ => return Err("invalid Body IR published union carrier")
    return Ok(ordered)


def native_union_payload(
    module: &BodyIrModule,
    declaration: &NativeUnionDeclaration,
    member: &RustType,
    intrinsics: &list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Read checked payload ownership once; the explicit enum Clone keeps the #2256 bootstrap compatible."""
    unions: list[RustType] = []
    payload = native_source_type(module.nominal_declarations, module.enum_declarations, unions, member, intrinsics)?
    if member.clone() not in declaration.closure_members:
        return Ok(payload)
    match payload:
        PlanType.FunctionPointer(signature) => return Ok(PlanType.Closure(signature))
        _ => return Err("invalid Body IR callable union payload")


def retained_union(
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    owner: int,
    intrinsics: &list[EnumDeclaration],
) -> Result[RustType, str]:
    """Resolve a union by its exact retained layout slot, independently of neighboring Option and Result layouts."""
    index = owner - len(enums)
    if index < 0 or index >= len(intrinsics) or intrinsics[index].carrier != "":
        return Err("unsupported Body IR nonunion enum isinstance")
    for ty in unions:
        if str(ty) == intrinsics[index].source_type:
            return Ok(ty)
    return Err("invalid Body IR unretained union layout")


pub def union_slot(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    owner: int,
    member: PlanType,
    intrinsics: &list[EnumDeclaration],
) -> Result[int, str]:
    """Find one exact normalized member; widening and unrepresented narrowing stay refused."""
    slot = union_test_slot(nominals, enums, unions, owner, member, intrinsics)?
    if slot < 0:
        return Err("unsupported Body IR union member conversion")
    return Ok(slot)


pub def union_pattern_slot(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    owner: int,
    pattern: &RustPattern,
    intrinsics: &list[EnumDeclaration],
) -> Result[int, str]:
    """Dispatch checker-retained member patterns; subset, literal and binding fallback refinements stay refused."""
    match pattern:
        RustPattern.Wildcard => return Ok(-1)
        RustPattern.UnionMember(ty=ty, fields=fields) =>
            if len(fields) > 1:
                return Err("unsupported Body IR union payload pattern arity")
            validate_payload_patterns(fields)?
            member = native_source_type(nominals, enums, unions, ty, intrinsics)?
            return union_slot(nominals, enums, unions, owner, member, intrinsics)
        _ => return Err("unsupported Body IR union pattern")


pub def union_test_slot(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    owner: int,
    member: PlanType,
    intrinsics: &list[EnumDeclaration],
) -> Result[int, str]:
    """A primitive target absent from the union is always false; source enum tests remain refused."""
    _ = retained_union(enums, unions, owner, intrinsics)?
    variants = intrinsics[owner - len(enums)].variants
    for slot in range(len(variants)):
        if variants[slot].fields == [member]:
            return Ok(slot)
        match member:
            PlanType.FunctionPointer(signature) =>
                if variants[slot].fields == [PlanType.Closure(signature)]:
                    return Ok(slot)
            _ => pass
    return Ok(-1)


pub def carrier_injection(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    operand: Operand,
    source: PlanType,
    target: PlanType,
    intrinsics: &list[EnumDeclaration],
) -> Result[RvalueKind, str]:
    """Inject an exact checked Option payload or union member at the shared assignment, argument and return boundary."""
    match target:
        PlanType.Enum(owner, _name) =>
            if owner < len(enums) or source == target:
                return Ok(RvalueKind.Use(operand))
            index = owner - len(enums)
            if index >= len(intrinsics):
                return Err("invalid Body IR union destination owner")
            if intrinsics[index].carrier == "Option":
                if intrinsics[index].variants[1].fields != [source]:
                    return Err("unsupported Body IR implicit Option payload type")
                return Ok(RvalueKind.Enum(owner, 1, [operand]))
            if intrinsics[index].carrier != "":
                return Ok(RvalueKind.Use(operand))
            slot = union_slot(nominals, enums, unions, owner, source, intrinsics)?
            return Ok(RvalueKind.Enum(owner, slot, [operand]))
        _ => return Ok(RvalueKind.Use(operand))


pub def union_test_slots(
    nominals: &list[NominalDeclaration],
    enums: &list[RustEnumDeclaration],
    unions: &list[RustType],
    owner: int,
    member: PlanType,
    intrinsics: &list[EnumDeclaration],
) -> Result[list[int], str]:
    """Match either string identity against both carriers while preserving exact construction and narrowing slots."""
    _ = retained_union(enums, unions, owner, intrinsics)?
    mut slots: list[int] = []
    variants = intrinsics[owner - len(enums)].variants
    for slot in range(len(variants)):
        payload = variants[slot].fields
        same_string_identity = member in [PlanType.String, PlanType.FrozenStr] and payload in [
            [PlanType.String],
            [PlanType.FrozenStr],
        ]
        if payload == [member] or same_string_identity:
            slots.append(slot)
    return Ok(slots)


pub def test_union_tag(mut builder: Builder, tag: Place, slots: list[int], span: SourceSpan) -> RvalueKind:
    """Join tag comparisons through native boolean branches without consuming any union payload."""
    output = temporary(builder, PlanType.Bool, span)
    builder.emit(plan_assign(output, RvalueKind.Use(literal(Constant.Bool(false), span)), span))
    matched = builder.new_block(span)
    joined = builder.new_block(span)
    for slot in slots:
        condition = temporary(builder, PlanType.Bool, span)
        operation = RvalueKind.Binary(BinaryOp.Equal, read_place(tag, false, span), literal(Constant.Int(slot), span))
        builder.emit(plan_assign(condition, operation, span))
        missed = builder.new_block(span)
        builder.finish(TerminatorKind.SwitchBool(read_place(condition, false, span), missed, matched), span)
        builder.current = missed
    builder.finish(TerminatorKind.Goto(joined), span)
    builder.current = matched
    builder.emit(plan_assign(output, RvalueKind.Use(literal(Constant.Bool(true), span)), span))
    builder.finish(TerminatorKind.Goto(joined), span)
    builder.current = joined
    return RvalueKind.Use(read_place(output, false, span))


pub def union_projection(mut builder: Builder, value: &RustPlace, span: SourceSpan) -> Result[Option[Place], str]:
    """Borrow the frame to map a checker-selected union member; ordinary locals never copy declaration tables or frame locals just to decline this projection."""
    if len(value.projection) != 1:
        return Ok(None)
    match projected_member(value.projection[0]):
        Some(ty) =>
            match value.local_id():
                Some(local) =>
                    index = int(local.index()) + 1 + builder.local_offset
                    owner = enum_owner(builder.locals[index].ty)?
                    member = native_source_type(builder.nominals, builder.enums, builder.unions, ty, builder.intrinsics)?
                    slot = union_slot(builder.nominals, builder.enums, builder.unions, owner, member, builder.intrinsics)?
                    payload = builder.intrinsics[owner - len(builder.enums)].variants[slot].fields[0]
                    return Ok(Some(Place(local=index, projection=Projection.VariantField(slot, 0, payload), span=span)))
                None => return Err("unsupported Body IR global union narrowing")
        None => return Ok(None)


def projected_member(projection: &RustPlaceElem) -> Option[RustType]:
    """Read the checker-selected payload type from one explicit union projection."""
    # The typed boundary also retains the pattern-only Rust import (the compiler gap tracked by #459).
    match projection:
        RustPlaceElem.UnionMember(ty=ty) => return Some(ty.clone())
        _ => return None
