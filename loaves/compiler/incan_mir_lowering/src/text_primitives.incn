"""Calls into primitive-owned UTF-8 conversion selected by compiler-introduced operations."""

from pub::incan_mir_plan import ListLeaf, Operand, Place, PlanType, SourceSpan, TupleElement
from frame import Builder, external_call, temporary


pub def encode_utf8(
    mut builder: Builder,
    value: Operand,
    frozen: bool,
    span: SourceSpan,
) -> Place:
    """Copy a borrowed or frozen text value through the authenticated primitive provider."""
    output = temporary(builder, PlanType.List(ListLeaf.U8, 1), span)
    if frozen:
        external_call(
            builder,
            "incan_stdlib_primitives::encode_frozen_utf8",
            [PlanType.FrozenStr],
            PlanType.List(ListLeaf.U8, 1),
            [value],
            output,
            span,
        )
    else:
        external_call(
            builder,
            "incan_stdlib_primitives::encode_utf8",
            [PlanType.StringRef],
            PlanType.List(ListLeaf.U8, 1),
            [value],
            output,
            span,
        )
    builder.owned.append(output.local)
    return output


pub def copy_frozen_bytes(mut builder: Builder, value: Operand, span: SourceSpan) -> Place:
    """Copy frozen byte storage through the authenticated primitive provider."""
    ty = PlanType.List(ListLeaf.U8, 1)
    output = temporary(builder, ty, span)
    external_call(
        builder,
        "incan_stdlib_primitives::copy_frozen_bytes",
        [PlanType.FrozenBytes],
        ty,
        [value],
        output,
        span,
    )
    builder.owned.append(output.local)
    return output


pub def decode_utf8(
    mut builder: Builder,
    value: Operand,
    value_type: PlanType,
    replace_invalid: Operand,
    span: SourceSpan,
) -> Place:
    """Return the primitive decoder's explicit success flag and owned text-or-detail payload."""
    result = PlanType.Tuple([TupleElement.Bool, TupleElement.String])
    output = temporary(builder, result, span)
    external_call(
        builder,
        "incan_stdlib_primitives::decode_utf8",
        [value_type, PlanType.Bool],
        result,
        [value, replace_invalid],
        output,
        span,
    )
    builder.owned.append(output.local)
    return output
