"""Admission of monomorphic scalar builtins by checked identity and representation."""

from rust::incan_semantics_core::body_ir import BuiltinFnId
from pub::incan_mir_plan import PlanType, Place, SourceSpan, Operand, ExternalFunction, CalleeKind, ListLeaf
from frame import (
    Builder,
    terminate_call,
    external_call,
    value_type,
    temporary,
    read_place,
    drop_owned,
    forget_owned,
    place_type,
)
from options import carrier_layout
from pub::incan_mir_plan import Projection, RvalueKind
from pub::incan_mir_plan import assign as plan_assign
from collections import is_owned_collection
from tuples import tuple_has_owners


pub def scalar_builtin(builtin: &BuiltinFnId, ty: PlanType) -> Option[tuple[str, PlanType]]:
    """Select runtime entry points only for representations whose legacy contract is retained."""
    match builtin:
        BuiltinFnId.Abs =>
            if ty == PlanType.Int:
                return Some(("absolute_int", PlanType.Int))
        BuiltinFnId.Bool =>
            match ty:
                PlanType.Int => return Some(("truth_int", PlanType.Bool))
                PlanType.Float => return Some(("truth_float", PlanType.Bool))
                PlanType.Bool => return Some(("truth_bool", PlanType.Bool))
                _ => pass
        _ => pass
    return None


pub def extremum_entry(builtin: &BuiltinFnId, leaf: ListLeaf) -> Result[tuple[str, PlanType], str]:
    """Select the runtime wrapper whose legacy body reaches the same copied, cloned, or float min or max helper."""
    mut operation = "min"
    if builtin == BuiltinFnId.Max:
        operation = "max"
    match leaf:
        ListLeaf.Int => return Ok((f"{operation}_int", PlanType.Int))
        ListLeaf.Float => return Ok((f"{operation}_float", PlanType.Float))
        ListLeaf.Bool => return Ok((f"{operation}_bool", PlanType.Bool))
        ListLeaf.Str => return Ok((f"{operation}_text", PlanType.String))
        _ => return Err(f"unsupported Body IR builtin {builtin:?} element")


pub def file_builtin_entry(builtin: &BuiltinFnId) -> tuple[str, int, PlanType]:
    """Name the runtime wrapper, text arity, and Ok payload of the checked read_file or write_file contract."""
    if builtin == BuiltinFnId.WriteFile:
        return ("write_text_file", 2, PlanType.Unit)
    return ("read_text_file", 1, PlanType.String)


pub def emit_file_builtin(
    mut builder: Builder,
    name: str,
    payload: PlanType,
    operands: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> Result[None, str]:
    """Require the checked Result[payload, str] carrier, then move the runtime's owned result into the destination."""
    if destination.projection != Projection.Whole:
        return Err("unsupported Body IR projected file builtin destination")
    ty = place_type(builder.locals, destination)
    _owner, declaration = carrier_layout(builder, ty)?
    success = declaration.variants[0].fields
    failure = declaration.variants[1].fields
    if declaration.carrier != "Result" or success != [payload] or failure != [PlanType.String]:
        return Err("unsupported Body IR file builtin result type")
    mut parameters: list[PlanType] = []
    for _operand in operands:
        parameters.append(PlanType.StringRef)
    path = f"incan_native_runtime::{name}"
    builder.externals.append(ExternalFunction(path=path, parameters=parameters, return_type=ty, span=span))
    result = temporary(builder, ty, span)
    terminate_call(builder, CalleeKind.External(path), operands, result, span)
    builder.owned.append(result.local)
    drop_owned(builder, destination.local, span)
    forget_owned(builder, result.local)
    builder.emit(plan_assign(destination, RvalueKind.Use(read_place(result, true, span)), span))
    builder.owned.append(destination.local)
    return Ok(None)


pub def list_call(
    mut builder: Builder,
    name: str,
    element: PlanType,
    parameters: list[PlanType],
    result: PlanType,
    arguments: list[Operand],
    destination: Place,
    span: SourceSpan,
) -> None:
    """Retain one generic instantiation and its exact safe runtime signature."""
    path = f"incan_native_runtime::{name}"
    builder.externals.append(
        ExternalFunction(path=path, type_arguments=[element], parameters=parameters, return_type=result, span=span),
    )
    terminate_call(builder, CalleeKind.Instantiated(path, element), arguments, destination, span)
    match result:
        PlanType.Model(_index, _name) => builder.owned.append(destination.local)
        _ =>
            if result == PlanType.String or is_owned_collection(result) or tuple_has_owners(result):
                builder.owned.append(destination.local)


pub def emit_boolean_operator(
    mut builder: Builder,
    destination: Place,
    operands: list[Operand],
    name: str,
    span: SourceSpan,
) -> Result[None, str]:
    """Combine pure Body IR operands; source short-circuiting is retained by frontend branches."""
    if value_type(builder, operands[0])? != PlanType.Bool or value_type(builder, operands[1])? != PlanType.Bool:
        return Err("unsupported Body IR non-boolean logical operands")
    external_call(
        builder,
        f"incan_native_runtime::{name}",
        [PlanType.Bool, PlanType.Bool],
        PlanType.Bool,
        operands,
        destination,
        span,
    )
    return Ok(None)


pub def emit_power_operator(
    mut builder: Builder,
    destination: Place,
    operands: list[Operand],
    span: SourceSpan,
) -> Result[None, str]:
    """Bind exponentiation only when both operands retain the legacy scalar carrier."""
    ty = value_type(builder, operands[0])?
    if value_type(builder, operands[1])? != ty:
        return Err("unsupported Body IR mixed Pow operands")
    mut name = "power_i64"
    if ty == PlanType.Float or ty == PlanType.F64:
        name = "power_f64"
    elif ty == PlanType.F32:
        name = "power_f32"
    elif ty != PlanType.Int:
        return Err("unsupported Body IR Pow carrier")
    external_call(builder, f"incan_native_runtime::{name}", [ty, ty], ty, operands, destination, span)
    return Ok(None)
