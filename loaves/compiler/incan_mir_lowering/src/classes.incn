"""Class receiver frames and canonical source method admission."""

from rust::incan_semantics_core import IncanType as RustType, SemanticSourceTargetKind, canonical_module_identity
from rust::incan_semantics_core::body_ir import (
    Body,
    LocalOrigin,
    LocalDecl as RustLocal,
    BodyIrModule,
    Operand as RustOperand,
    OwnershipFact,
    ArgumentElement as RustArgumentElement,
    NamedCallableTarget,
)
from pub::incan_mir_plan import PlanType, Local, RvalueKind, SourceSpan, EnumDeclaration
from models import model_place
from unions import native_source_type, collect_unions
from symbols import symbol_component, type_component


pub def frame_type(
    module: &BodyIrModule,
    local: &RustLocal,
    intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """Turn only checker-retained receiver origins into borrowed native frame slots."""
    ty = native_source_type(
        module.nominal_declarations,
        module.enum_declarations,
        collect_unions(module),
        local.ty,
        intrinsics,
    )?
    match receiver_mode(local.origin):
        Some(mutable) =>
            match ty:
                PlanType.Model(index, name) =>
                    if mutable:
                        return Ok(PlanType.ModelMutRef(index, name))
                    return Ok(PlanType.ModelRef(index, name))
                _ => return Err("unsupported Body IR nonnominal receiver")
        None => return Ok(ty)


pub def function_name(module: &BodyIrModule, body: &Body) -> str:
    """Keep entry symbols and encode dependency module identities so equal spellings and spans remain distinct."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) =>
                    if owner != module.module_id.path():
                        return module_function_symbol(owner, body)
                None => pass
            if identity.kind == SemanticSourceTargetKind.Function:
                return str(body.name)
        None => pass
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) =>
                mut symbol = f"__incan_body_{body.span.start}{type_component(body.locals[0].ty)}"
                if len(body.type_parameters) != 0:
                    symbol += symbol_component(str(body.name))
                return symbol
            None => pass
    if len(body.type_parameters) != 0:
        return f"__incan_body_{body.span.start}{symbol_component(str(body.name))}"
    return f"__incan_body_{body.span.start}"


pub def static_type_arguments(module: &BodyIrModule, target: &NamedCallableTarget) -> Result[list[RustType], str]:
    """Prefix method arguments with the checked generic class receiver's ordered owner arguments."""
    mut arguments = static_owner_arguments(module, target)?
    for argument in target.type_args:
        arguments.append(argument.clone())
    return Ok(arguments)


def static_owner_arguments(module: &BodyIrModule, target: &NamedCallableTarget) -> Result[list[RustType], str]:
    """Read class bindings from the checked receiver, retaining no borrowed foreign vector."""
    match target.receiver_type:
        Some(ty) =>
            match ty:
                RustType.Generic(base=base, args=arguments) =>
                    for declaration in module.nominal_declarations:
                        if declaration.canonical.kind != SemanticSourceTargetKind.Class or declaration.canonical.declaration_name != str(
                            base,
                        ):
                            continue
                        if int(declaration.type_parameter_count) != len(arguments):
                            return Err(f"unsupported Body IR static class type argument arity on {base}")
                        mut retained: list[RustType] = []
                        for argument in arguments:
                            retained.append(argument.clone())
                        return Ok(retained)
                    return Err(f"unsupported Body IR static class receiver {base}")
                _ => pass
        None => pass
    return Ok([])


pub def body_module_identity(body: &Body) -> Result[str, str]:
    """Read the validated body's declaring module independently of the project entry module."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) => return Ok(owner)
                None => return Err("invalid Body IR body without source module owner")
        None => return Err("invalid Body IR body without canonical identity")


pub def body_type_bindings(
    module: &BodyIrModule,
    body: &Body,
    arguments: list[RustType],
) -> Result[tuple[list[str], list[RustType]], str]:
    """Retain the scheduled method's checked class bindings alongside its own ordered call arguments."""
    names = body.type_parameters.clone()
    if len(names) != len(arguments):
        return Err(f"unsupported Body IR active type argument arity on {body.name}")
    if len(body.locals) == 0:
        return Ok((names, arguments))
    match receiver_mode(body.locals[0].origin):
        None => return Ok((names, arguments))
        Some(_mutable) => pass
    match body.locals[0].ty:
        RustType.Generic(base=base, args=owner_arguments) =>
            for declaration in module.nominal_declarations:
                if declaration.canonical.declaration_name != str(base):
                    continue
                if len(declaration.type_parameters) != len(owner_arguments):
                    return Err(f"unsupported Body IR active class type argument arity on {base}")
                for name in declaration.type_parameters:
                    if str(name) in names:
                        return Err(f"unsupported Body IR shadowed class and method type parameter {name}")
                mut bindings: list[RustType] = []
                for argument in owner_arguments:
                    bindings.append(argument.clone())
                for argument in arguments:
                    bindings.append(argument.clone())
                return Ok((declaration.type_parameters.clone() + names, bindings))
        _ => pass
    return Ok((names, arguments))


def module_function_symbol(owner: str, body: &Body) -> str:
    """Encode the full owner and declaration span using identifier-safe bytes without punctuation collisions."""
    mut symbol = "__incan_module"
    for segment in owner.split("::"):
        symbol += symbol_component(segment)
    # A trait default can have the same canonical declaration and span in several concrete receiver frames.
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) =>
                symbol += f"_receiver{symbol_component(str(body.locals[0].ty))}"
            None => pass
    if len(body.type_parameters) != 0:
        symbol += symbol_component(str(body.name))
    return f"{symbol}_{body.span.start}_{body.span.end}"


pub def method_receiver(
    module: &BodyIrModule,
    locals: list[Local],
    local_offset: int,
    index: int,
    argument: &RustArgumentElement,
    span: SourceSpan,
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Require a single receiver argument before lowering its checked borrow in the active local frame."""
    match argument.as_one():
        Some(value) => return receiver_borrow(module, locals, local_offset, index, value, span)
        None => return Err("unsupported Body IR Method spread receiver")


def receiver_borrow(
    module: &BodyIrModule,
    locals: list[Local],
    local_offset: int,
    index: int,
    value: &RustOperand,
    span: SourceSpan,
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Lower the checked receiver to a shared borrow or mutable reborrow without moving its owner."""
    body = module.bodies[index]
    receiver_type = frame_type(module, body.locals[0], [])?
    match value:
        RustOperand.Place(read) =>
            match read.fact:
                OwnershipFact.Borrow => pass
                OwnershipFact.MutBorrow => pass
                _ => return Err("unsupported Body IR Method receiver ownership")
            mut receiver = model_place(module.nominal_declarations, locals, read.place, span)?
            receiver.local += local_offset
            match receiver_type:
                PlanType.ModelRef(_owner, _name) => return Ok((receiver_type, RvalueKind.Borrow(receiver)))
                PlanType.ModelMutRef(_owner, _name) => return Ok((receiver_type, RvalueKind.MutBorrow(receiver)))
                _ => return Err("invalid Body IR Method receiver type")
        _ => return Err("unsupported Body IR Method nonplace receiver")


pub def receiver_mode(value: &LocalOrigin) -> Option[bool]:
    """Read receiver origins through the typed Rust-enum boundary used for imported struct variants."""
    match value:
        LocalOrigin.Receiver(mutable=mutable) => return Some(mutable.clone())
        _ => return None
