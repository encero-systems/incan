"""Class receiver frames and canonical source method admission."""

from rust::incan_semantics_core import (
    IncanType as RustType,
    CanonicalSymbolId,
    SemanticSourceTargetKind,
    canonical_module_identity,
)
from rust::incan_semantics_core::body_ir import (
    Body,
    LocalOrigin,
    LocalDecl as RustLocal,
    BodyIrModule,
    Operand as RustOperand,
    OwnershipFact,
    ArgumentElement as RustArgumentElement,
    NominalDeclaration,
    EnumDeclaration as RustEnumDeclaration,
)
from pub::incan_mir_plan import PlanType, Local, RvalueKind, SourceSpan, EnumDeclaration
from models import model_place
from ranges import range_value_local
from unions import native_source_type
from symbols import symbol_component, type_component
pub from type_parameters import static_type_arguments


pub def parameter_local_index(body: &Body, index: int) -> int:
    """Read a parameter's retained local identity after materializing its native Copy field (#2256 bootstrap)."""
    parameter = body.params[index]
    return int(parameter.local.index())


pub def frame_type(
    mut nominals: list[NominalDeclaration],
    mut enums: list[RustEnumDeclaration],
    local: &RustLocal,
    mut intrinsics: list[EnumDeclaration],
) -> Result[PlanType, str]:
    """
    Turn only checker-retained receiver origins into borrowed native frame slots, borrowing the caller's cached declaration tables.

    A source enum's receiver is a shared reference; a `mut self` enum method would replace the value its caller holds,
    which no enum receiver frame retains, so it refuses.
    Union storage is resolved from the already retained intrinsic declarations; a local never rediscovers program unions.
    """
    if range_value_local(local.ty, local.origin):
        return Ok(PlanType.RangeValue)
    ty = native_source_type(nominals, enums, [], local.ty, intrinsics)?
    match receiver_mode(local.origin):
        Some(mutable) =>
            match ty:
                PlanType.Model(index, name) =>
                    if mutable:
                        return Ok(PlanType.ModelMutRef(index, name))
                    return Ok(PlanType.ModelRef(index, name))
                PlanType.Enum(index, name) =>
                    if mutable:
                        return Err("unsupported Body IR mutable enum receiver")
                    if index < len(enums):
                        return Ok(PlanType.EnumRef(index, name))
                _ => pass
            return Err("unsupported Body IR nonnominal receiver")
        None => return Ok(ty)


pub def function_name(module: &BodyIrModule, body: &Body) -> str:
    """Keep entry symbols and encode dependency module identities so equal spellings and spans remain distinct."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) =>
                    if owner != module.module_id.path():
                        return module_function_symbol(owner, body)
                None => pass
            if identity.kind == SemanticSourceTargetKind.Function:
                # Overloads share their source name, so each takes its own declaration span as well.
                if has_overloaded_name(module, body, identity):
                    return f"__incan_overload_{body.span.start}{symbol_component(str(body.name))}"
                return str(body.name)
        None => pass
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) =>
                mut symbol = f"__incan_body_{body.span.start}{type_component(body.locals[0].ty)}"
                if len(body.type_parameters) != 0:
                    symbol += symbol_component(str(body.name))
                return symbol
            None => pass
    # Instances of one associated method share its span; the instantiated name tells their frames apart.
    if len(body.type_parameters) != 0:
        return f"__incan_body_{body.span.start}{symbol_component(str(body.name))}"
    return f"__incan_body_{body.span.start}"


pub def is_program_entry(module: &BodyIrModule, body: &Body) -> bool:
    """Read explicit checked entry identities; an ordinary imported main keeps ordinary function semantics."""
    if str(body.name) != "main":
        return false
    if function_name(module, body) == "main":
        return true
    match body.canonical:
        Some(identity) =>
            for selected in module.program_entrypoints:
                if selected.clone() == identity:
                    return true
        None => pass
    return false


def has_overloaded_name(module: &BodyIrModule, body: &Body, identity: &CanonicalSymbolId) -> bool:
    """Report whether another function of the same module declares this body's source name, as overloads do."""
    owner = canonical_module_identity(identity)
    for other in module.bodies:
        if other.name != body.name or other.span.start == body.span.start:
            continue
        match other.canonical:
            Some(other_identity) =>
                same_module = canonical_module_identity(other_identity) == owner
                if other_identity.kind == SemanticSourceTargetKind.Function and same_module:
                    return true
            None => pass
    return false


pub def body_module_identity(body: &Body) -> Result[str, str]:
    """Read the validated body's declaring module independently of the project entry module."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) => return Ok(owner)
                None => return Err("invalid Body IR body without source module owner")
        None => return Err("invalid Body IR body without canonical identity")


pub def body_type_bindings(
    module: &BodyIrModule,
    body: &Body,
    arguments: list[RustType],
) -> Result[tuple[list[str], list[RustType]], str]:
    """Retain the scheduled method's checked class bindings alongside its own ordered call arguments."""
    names = body.type_parameters.clone()
    if len(names) != len(arguments):
        return Err(f"unsupported Body IR active type argument arity on {body.name}")
    if len(body.nominal_instantiation) != 0:
        mut owner_names: list[str] = []
        mut owner_arguments: list[RustType] = []
        for binding in body.nominal_instantiation:
            if str(binding.parameter) in names:
                return Err(f"unsupported Body IR shadowed class and method type parameter {binding.parameter}")
            owner_names.append(str(binding.parameter))
            owner_arguments.append(binding.argument.clone())
        for argument in arguments:
            owner_arguments.append(argument.clone())
        return Ok((owner_names + names, owner_arguments))
    if len(body.locals) == 0:
        return Ok((names, arguments))
    match receiver_mode(body.locals[0].origin):
        None => return Ok((names, arguments))
        Some(_mutable) => pass
    match body.locals[0].ty:
        RustType.Generic(base=base, args=owner_arguments) =>
            for declaration in module.nominal_declarations:
                if declaration.template_carrier_name() != str(base):
                    continue
                if len(declaration.type_parameters) != len(owner_arguments):
                    return Err(f"unsupported Body IR active class type argument arity on {base}")
                for name in declaration.type_parameters:
                    if str(name) in names:
                        return Err(f"unsupported Body IR shadowed class and method type parameter {name}")
                mut bindings: list[RustType] = []
                for argument in owner_arguments:
                    bindings.append(argument.clone())
                for argument in arguments:
                    bindings.append(argument.clone())
                return Ok((declaration.type_parameters.clone() + names, bindings))
        _ => pass
    return Ok((names, arguments))


def module_function_symbol(owner: str, body: &Body) -> str:
    """Encode the full owner and declaration span using identifier-safe bytes without punctuation collisions."""
    mut symbol = "__incan_module"
    for segment in owner.split("::"):
        symbol += symbol_component(segment)
    # A trait default can have the same canonical declaration and span in several concrete receiver frames.
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) => symbol += f"_receiver{symbol_component(str(body.locals[0].ty))}"
            None => pass
    if len(body.type_parameters) != 0:
        symbol += symbol_component(str(body.name))
    return f"{symbol}_{body.span.start}_{body.span.end}"


pub def method_receiver(
    module: &BodyIrModule,
    locals: list[Local],
    local_offset: int,
    index: int,
    argument: &RustArgumentElement,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Require a single receiver argument before lowering its checked borrow in the active local frame."""
    match argument.as_one():
        Some(value) => return receiver_borrow(module, locals, local_offset, index, value, span, unions, intrinsics)
        None => return Err("unsupported Body IR Method spread receiver")


def receiver_borrow(
    module: &BodyIrModule,
    locals: list[Local],
    local_offset: int,
    index: int,
    value: &RustOperand,
    span: SourceSpan,
    unions: list[RustType],
    mut intrinsics: list[EnumDeclaration],
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Lower the checked receiver to a shared borrow or mutable reborrow without moving its owner."""
    body = module.bodies[index]
    mut declarations = module.nominal_declarations
    mut enums = module.enum_declarations
    receiver_type = frame_type(declarations, enums, body.locals[0], intrinsics)?
    match value:
        RustOperand.Place(read) =>
            match read.fact:
                OwnershipFact.Borrow => pass
                OwnershipFact.MutBorrow => pass
                _ => return Err("unsupported Body IR Method receiver ownership")
            mut frame_locals = locals
            mut union_layouts = unions
            mut receiver = model_place(declarations, frame_locals, read.place, span, enums, union_layouts, intrinsics)?
            receiver.local += local_offset
            match receiver_type:
                PlanType.ModelRef(_owner, _name) => return Ok((receiver_type, RvalueKind.Borrow(receiver)))
                PlanType.ModelMutRef(_owner, _name) => return Ok((receiver_type, RvalueKind.MutBorrow(receiver)))
                PlanType.EnumRef(_owner, _name) => return Ok((receiver_type, RvalueKind.Borrow(receiver)))
                _ => return Err("invalid Body IR Method receiver type")
        _ => return Err("unsupported Body IR Method nonplace receiver")


pub def receiver_mode(value: &LocalOrigin) -> Option[bool]:
    """Read receiver origins through the typed Rust-enum boundary used for imported struct variants."""
    match value:
        LocalOrigin.Receiver(mutable=mutable) =>
            if not mutable:
                return Some(false)
            return Some(true)
        _ => return None
