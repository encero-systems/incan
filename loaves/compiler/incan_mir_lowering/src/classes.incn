"""Class receiver frames and canonical source method admission."""

from rust::incan_semantics_core import SemanticSourceTargetKind, canonical_module_identity
from rust::incan_semantics_core::body_ir import (
    Body,
    LocalOrigin,
    LocalDecl as RustLocal,
    BodyIrModule,
    Operand as RustOperand,
    OwnershipFact,
    ArgumentElement as RustArgumentElement,
)
from pub::incan_mir_plan import PlanType, Local, RvalueKind, SourceSpan
from models import model_place
from enums import native_source_type


pub def frame_type(module: &BodyIrModule, local: &RustLocal) -> Result[PlanType, str]:
    """Turn only checker-retained receiver origins into borrowed native frame slots."""
    ty = native_source_type(module.nominal_declarations, module.enum_declarations, local.ty)?
    match receiver_mode(local.origin):
        Some(mutable) =>
            match ty:
                PlanType.Model(index, name) =>
                    if mutable:
                        return Ok(PlanType.ModelMutRef(index, name))
                    return Ok(PlanType.ModelRef(index, name))
                _ => return Err("unsupported Body IR nonnominal receiver")
        None => return Ok(ty)


pub def function_name(module: &BodyIrModule, body: &Body) -> str:
    """Keep entry symbols and encode dependency module identities so equal spellings and spans remain distinct."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) =>
                    if owner != module.module_id.path():
                        return module_function_symbol(owner, body)
                None => pass
            if identity.kind == SemanticSourceTargetKind.Function:
                return str(body.name)
        None => pass
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) => return f"__incan_body_{body.span.start}_{body.locals[0].ty}"
            None => pass
    return f"__incan_body_{body.span.start}"


pub def body_module_identity(body: &Body) -> Result[str, str]:
    """Read the validated body's declaring module independently of the project entry module."""
    match body.canonical:
        Some(identity) =>
            match canonical_module_identity(identity):
                Some(owner) => return Ok(owner)
                None => return Err("invalid Body IR body without source module owner")
        None => return Err("invalid Body IR body without canonical identity")


def module_function_symbol(owner: str, body: &Body) -> str:
    """Encode the full owner and declaration span using identifier-safe bytes without punctuation collisions."""
    mut symbol = "__incan_module"
    for segment in owner.split("::"):
        symbol += symbol_component(segment)
    # A trait default can have the same canonical declaration and span in several concrete receiver frames.
    if len(body.locals) != 0:
        match receiver_mode(body.locals[0].origin):
            Some(_mutable) =>
                symbol += f"_receiver{symbol_component(str(body.locals[0].ty))}"
            None => pass
    return f"{symbol}_{body.span.start}_{body.span.end}"


def symbol_component(value: str) -> str:
    """Encode one length-delimited UTF-8 component without admitting punctuation into a native identifier."""
    encoded = value.encode()
    mut component = f"_{len(encoded)}"
    for byte in encoded:
        component += f"_{byte}"
    return component


pub def method_receiver(
    module: &BodyIrModule,
    locals: list[Local],
    index: int,
    argument: &RustArgumentElement,
    span: SourceSpan,
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Require a single receiver argument before lowering its checked borrow."""
    match argument.as_one():
        Some(value) => return receiver_borrow(module, locals, index, value, span)
        None => return Err("unsupported Body IR Method spread receiver")


def receiver_borrow(
    module: &BodyIrModule,
    locals: list[Local],
    index: int,
    value: &RustOperand,
    span: SourceSpan,
) -> Result[tuple[PlanType, RvalueKind], str]:
    """Lower the checked receiver to a shared borrow or mutable reborrow without moving its owner."""
    body = module.bodies[index]
    receiver_type = frame_type(module, body.locals[0])?
    match value:
        RustOperand.Place(read) =>
            match read.fact:
                OwnershipFact.Borrow => pass
                OwnershipFact.MutBorrow => pass
                _ => return Err("unsupported Body IR Method receiver ownership")
            receiver = model_place(module.nominal_declarations, locals, read.place, span)?
            match receiver_type:
                PlanType.ModelRef(_owner, _name) => return Ok((receiver_type, RvalueKind.Borrow(receiver)))
                PlanType.ModelMutRef(_owner, _name) => return Ok((receiver_type, RvalueKind.MutBorrow(receiver)))
                _ => return Err("invalid Body IR Method receiver type")
        _ => return Err("unsupported Body IR Method nonplace receiver")


pub def receiver_mode(value: &LocalOrigin) -> Option[bool]:
    """Read receiver origins through the typed Rust-enum boundary used for imported struct variants."""
    match value:
        LocalOrigin.Receiver(mutable=mutable) => return Some(mutable.clone())
        _ => return None
