"""
Typed record reads for one compilation: a key names one record, a read answers found, absent or error, and every
answer is kept as a witness of what the compilation depended on.

The source behind the reads is a boundary. `memory_records` answers from the checked modules the driver already
holds; a store-backed source answers the same keys from a pinned snapshot. Callers never see which one answers.
"""

from rust::incan_semantics_core::body_ir import BodyIrModule
from table_views import borrowed_at


# The family of a runtime facade: its public path, `incan_native_runtime::<name>`, names one checked callable.
pub const RUNTIME_FACADE: str = "runtime-facade"
# The prefix of a lowering refusal that only a missing record caused; the driver reads the key after it.
pub const ABSENT_PREFIX: str = "record absent: "


pub model RecordKey:
    """One record's full key: its family and its identity inside that family."""

    pub family: str
    pub identity: str

    def text(self) -> str:
        """The key as one line, `family identity`."""
        return f"{self.family} {self.identity}"


pub enum RecordRead:
    """What a read found: the record's position in the source's table, no record under the key, or a failure."""

    Found(int)
    Absent
    Failed(str)


pub model ReadWitness:
    """One read and its outcome; absence is a witness too, so adding the record later invalidates the reader."""

    pub key: RecordKey
    pub found: bool


pub model RecordReads:
    """
    The reads of one compilation over one source.

    `keyed` is the switch: when it is false the source is the whole joined closure and a miss is an ordinary
    answer; when it is true a miss is a demand the driver satisfies before lowering again.
    """

    pub keyed: bool
    pub facades: dict[str, int]
    pub witnesses: list[ReadWitness]

    def require(mut self, key: RecordKey) -> RecordRead:
        """Read one record by key and keep the witness."""
        if key.family != RUNTIME_FACADE:
            return RecordRead.Failed(f"unknown record family {key.family}")
        match self.facades.get(key.identity):
            Some(position) =>
                self.witnesses.append(ReadWitness(key=key, found=true))
                return RecordRead.Found(position)
            None =>
                self.witnesses.append(ReadWitness(key=key, found=false))
                return RecordRead.Absent

    def absent(self) -> list[RecordKey]:
        """The keys read and not found, in first-read order, each once."""
        mut keys: list[RecordKey] = []
        mut seen: list[str] = []
        for position in range(len(self.witnesses)):
            witness = borrowed_at(self.witnesses, position)
            if witness.found or listed(seen, witness.key.identity):
                continue
            seen.append(witness.key.identity)
            keys.append(witness.key.clone())
        return keys


pub def memory_records(entry: &BodyIrModule, loaded: &list[str], keyed: bool) -> RecordReads:
    """
    An in-memory source over the facades the driver loaded: `loaded` lists the facade paths whose bodies are present.

    The entry module's runtime bindings are the key directory; a binding whose body was not loaded reads absent.
    """
    mut facades: dict[str, int] = {}
    for position in range(len(entry.runtime_callable_bindings)):
        binding = borrowed_at(entry.runtime_callable_bindings, position)
        if not keyed or listed(loaded, binding.path):
            facades[binding.path] = position
    return RecordReads(keyed=keyed, facades=facades, witnesses=[])


pub def absent_refusal(key: &RecordKey) -> str:
    """The lowering refusal for a keyed miss, which the driver parses back into a demand."""
    return f"{ABSENT_PREFIX}{key.text()}"


def listed(paths: &list[str], path: str) -> bool:
    """Whether `path` is one of `paths`, read by position so no element is copied."""
    for position in range(len(paths)):
        if borrowed_at(paths, position) == path:
            return true
    return false
