"""Lower builtin members on text, integers, floats, and generators."""

from pub::incan_mir_plan import (
    Carrier,
    BinaryOp,
    ListLeaf,
    Operand,
    Place,
    PlanType,
    Projection,
    RvalueKind,
    SourceSpan,
    TerminatorKind,
    TupleElement,
    assign as plan_assign,
    place as plan_place,
)
from text_ownership import drop_borrowed_text_temporaries
from derived_methods import lower_derived_clone
from rust::incan_semantics_core::body_ir import (
    ArgumentElement as RustArgumentElement,
    Operand as RustOperand,
    OwnershipFact,
    Place as RustPlace,
    MethodTarget,
)
from rust::incan_lang::lang::surface::frozen_list_methods import FrozenListMethodId as RustFrozenListMethodId
from rust::incan_lang::lang::surface::frozen_dict_methods import FrozenDictMethodId as RustFrozenDictMethodId
from rust::incan_lang::lang::surface::frozen_set_methods import FrozenSetMethodId as RustFrozenSetMethodId
from rust::incan_lang::lang::surface::string_methods import StringMethodId as RustStringMethodId
from rust::incan_lang::lang::surface::bytes_methods import BytesMethodId as RustBytesMethodId
from rust::incan_lang::lang::surface::frozen_bytes_methods import FrozenBytesMethodId as RustFrozenBytesMethodId
from rust::incan_lang::lang::surface::iterator_methods import IteratorMethodId as RustIteratorMethodId
from rust::incan_lang::lang::surface::option_methods import OptionMethodId as RustOptionMethodId
from rust::incan_lang::lang::surface::float_methods import FloatMethodId as RustFloatMethodId
from rust::incan_lang::lang::types::numerics import (
    IntegerHelperFamily as RustIntegerHelperFamily,
    IntegerHelperOperation as RustIntegerHelperOperation,
)
from generator_adapters import generator_adapter
from generator_consumers import is_generator_consumer, consumer_result, generator_consumer
from element_places import is_element_place
from options import assign_carrier, carrier_layout, replace_owned_destination
from tuples import tuple_fields
from text_primitives import copy_frozen_bytes, decode_utf8 as primitive_decode_utf8, encode_utf8 as primitive_encode_utf8
from numerics import numeric_carrier, integer_carrier
from strings import emit_text_helper, text_method
from resize import emit_resize
from frame import place_type, Builder, temporary, drop_owned, external_call, forget_owned, read_place
from lists import require_list_shape
from checked_values import scalar_operand, scalar_place
from operators import operand_type
from builtin_calls import coerce_numeric_operand
from operand_borrows import assign_text_result, borrow_text_operand, lower_text_helper
from list_methods import (
    argument_place,
    argument_value,
    borrowed_list_argument,
    call_destination,
    lower_list_builtin,
    lower_list_iter,
    lower_list_method,
    lower_bytes_as_slice,
    lower_iterator_method,
)
from list_iteration import frozen_dictionary_contains, list_root_place
from list_values import list_borrow
from hashed_collections import collection_contains, dictionary_method, set_method
from sequence_builtins import argument_type, text_argument


pub def lower_builtin_method(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch retained builtin registry members to text, numeric resize, or collection boundaries."""
    if target.has_builtin_selection():
        if not target.has_valid_builtin_selection():
            return Err("unsupported Body IR builtin method operation without matching canonical provenance")
        return lower_typed_builtin_method(builder, target, arguments, destination, span)
    return Err(
        f"unsupported Body IR Method {str(target.name)} without checker-selected builtin identity in {builder.name} at {span.file}:{span.line}:{span.column}",
    )


def lower_typed_builtin_method(
    mut builder: Builder,
    target: &MethodTarget,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Dispatch one checker-selected builtin operation without reclassifying its canonical name."""
    match target.builtin_str():
        Some(method) => return lower_string_method(builder, target, method, false, arguments, destination, span)
        None => pass
    match target.builtin_frozen_str():
        Some(method) => return lower_string_method(builder, target, method, true, arguments, destination, span)
        None => pass
    match target.builtin_bytes():
        Some(RustBytesMethodId.Decode) =>
            return lower_text_codec_method(builder, false, true, arguments, destination, span)
        Some(RustBytesMethodId.AsSlice) => return lower_bytes_as_slice(builder, arguments, destination, span)
        None => pass
    match target.builtin_frozen_bytes():
        Some(RustFrozenBytesMethodId.Len) => return lower_list_builtin(builder, arguments, destination, span)
        Some(RustFrozenBytesMethodId.Decode) =>
            return lower_text_codec_method(builder, true, true, arguments, destination, span)
        Some(RustFrozenBytesMethodId.IsEmpty) =>
            return Err("unsupported Body IR remaining builtin Method frozenbytes.is_empty")
        None => pass
    match target.builtin_iterator():
        Some(method) => return lower_iterator_method(builder, method, arguments, destination, span)
        None => pass
    match target.builtin_generator():
        Some(method) => return lower_iterator_method(builder, method, arguments, destination, span)
        None => pass
    match target.builtin_option():
        Some(RustOptionMethodId.Clone) => return lower_derived_clone(builder, arguments, destination, span)
        Some(_method) => return refuse_remaining_builtin_method(target)
        None => pass
    match target.builtin_result():
        Some(_method) => return refuse_remaining_builtin_method(target)
        None => pass
    match target.builtin_clone():
        Some(_method) => return lower_derived_clone(builder, arguments, destination, span)
        None => pass
    match target.builtin_float():
        Some(method) => return lower_selected_float(builder, target, method, arguments, destination, span)
        None => pass
    match target.builtin_integer_helper_family():
        Some(family) =>
            match target.builtin_integer_helper_operation():
                Some(operation) =>
                    return lower_integer_helper(builder, target, family, operation, arguments, destination, span)
                None => return Err("unsupported Body IR incomplete integer helper identity")
        None => pass
    match target.builtin_numeric_resize():
        Some(policy) =>
            if len(arguments) != 1:
                return Err("invalid Body IR resize arity")
            receiver_type = argument_type(builder, arguments, 0, span)?
            match destination:
                Some(place) =>
                    output = scalar_place(builder, place, span)?
                    operand = numeric_receiver(builder, arguments, span)?
                    return emit_resize(builder, policy, receiver_type, operand, output, span)
                None => return Err("unsupported Body IR resize without checked destination")
        None => pass
    match target.builtin_list():
        Some(method) => return lower_list_method(builder, method, arguments, destination, span)
        None => pass
    if target.is_builtin_list_iter():
        return lower_list_iter(builder, arguments, destination, span)
    match target.builtin_dict():
        Some(method) => return dictionary_method(builder, method, arguments, destination, span)
        None => pass
    match target.builtin_set():
        Some(method) => return set_method(builder, method, arguments, destination, span)
        None => pass
    match target.builtin_frozen_list():
        Some(RustFrozenListMethodId.Len) => return lower_list_builtin(builder, arguments, destination, span)
        Some(RustFrozenListMethodId.IsEmpty) =>
            return refuse_unsupported_frozen_collection_method(builder, "FrozenList.is_empty", arguments, span)
        None => pass
    match target.builtin_frozen_dict():
        Some(RustFrozenDictMethodId.Len) => return lower_list_builtin(builder, arguments, destination, span)
        Some(RustFrozenDictMethodId.ContainsKey) =>
            return frozen_dictionary_contains(builder, arguments, destination, false, span)
        Some(RustFrozenDictMethodId.IsEmpty) =>
            return refuse_unsupported_frozen_collection_method(builder, "FrozenDict.is_empty", arguments, span)
        None => pass
    match target.builtin_frozen_set():
        Some(RustFrozenSetMethodId.Len) => return lower_list_builtin(builder, arguments, destination, span)
        Some(RustFrozenSetMethodId.Contains) =>
            return collection_contains(builder, false, arguments, destination, span)
        Some(RustFrozenSetMethodId.IsEmpty) =>
            return refuse_unsupported_frozen_collection_method(builder, "FrozenSet.is_empty", arguments, span)
        None => pass
    return Err("unsupported Body IR builtin method operation")


def lower_string_method(
    mut builder: Builder,
    target: &MethodTarget,
    method: RustStringMethodId,
    frozen: bool,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower one checker-selected runtime or frozen string operation."""
    if method == RustStringMethodId.Encode:
        return lower_text_codec_method(builder, frozen, false, arguments, destination, span)
    if method == RustStringMethodId.Slice:
        if frozen:
            return Err("unsupported Body IR frozen string slice operation")
        return lower_string_slice(builder, arguments, destination, span)
    receiver_type = argument_type(builder, arguments, 0, span)?
    match text_method(method, receiver_type):
        Some((name, result)) => return lower_text_helper(builder, name, result, arguments, destination, span)
        None => return refuse_remaining_builtin_method(target)


def refuse_unsupported_frozen_collection_method(
    mut builder: Builder,
    member: str,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[None, str]:
    """Preserve the existing non-list refusal for an unsupported frozen-collection member."""
    receiver = argument_type(builder, arguments, 0, span)?
    description = f"unsupported Body IR list Method {member} on non-list in {builder.name}"
    source_location = f"{span.file}:{span.line}:{span.column}"
    _shape = require_list_shape(receiver, f"{description} at {source_location}")?
    return Err(f"unsupported Body IR list Method {member}")


def lower_integer_helper(
    mut builder: Builder,
    target: &MethodTarget,
    family: RustIntegerHelperFamily,
    operation: RustIntegerHelperOperation,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower wrapping arithmetic directly and call native checked and saturating u8 methods at their exact widths."""
    receiver = argument_type(builder, arguments, 0, span)?
    if family == RustIntegerHelperFamily.Wrapping and operation in [
        RustIntegerHelperOperation.Add,
        RustIntegerHelperOperation.Sub,
        RustIntegerHelperOperation.Mul,
    ]:
        return lower_wrapping_integer(builder, operation, receiver, arguments, destination, span)
    if receiver != PlanType.U8:
        return refuse_remaining_builtin_method(target)
    if len(arguments) != 2:
        return Err("unsupported Body IR integer helper arity")
    mut operand_type = PlanType.U8
    if operation == RustIntegerHelperOperation.Pow:
        operand_type = PlanType.U32
    mut result = PlanType.U8
    if family == RustIntegerHelperFamily.Checked:
        match destination:
            Some(place) =>
                output = scalar_place(builder, place, span)?
                result = place_type(builder.locals, output)
            None => return Err("unsupported Body IR checked integer helper without destination")
    output = call_destination(builder, destination, result, span)?
    value = argument_value(builder, arguments, 1, span)?
    operands = [
        numeric_receiver(builder, arguments, span)?,
        coerce_numeric_operand(builder, value, operand_type, span)?,
    ]
    external_call(
        builder,
        f"u8::{integer_helper_name(family, operation)}",
        [PlanType.U8, operand_type],
        result,
        operands,
        output,
        span,
    )
    return Ok(None)


def lower_wrapping_integer(
    mut builder: Builder,
    method: RustIntegerHelperOperation,
    receiver: PlanType,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Emit the checked integer member as native modular arithmetic without invoking a runtime wrapper recursively."""
    if not integer_carrier(receiver):
        return Err("unsupported Body IR wrapping helper on a non-integer receiver")
    binary = match method:
        RustIntegerHelperOperation.Add => BinaryOp.Add
        RustIntegerHelperOperation.Sub => BinaryOp.Subtract
        RustIntegerHelperOperation.Mul => BinaryOp.Multiply
        RustIntegerHelperOperation.Pow => return Err("unsupported Body IR direct wrapping pow")
    if len(arguments) != 2:
        return Err("unsupported Body IR wrapping integer arity")
    output = call_destination(builder, destination, receiver, span)?
    left = numeric_receiver(builder, arguments, span)?
    value = argument_value(builder, arguments, 1, span)?
    right = coerce_numeric_operand(builder, value, receiver, span)?
    if receiver == PlanType.Int:
        pair = temporary(builder, PlanType.CheckedInt, span)
        builder.emit(plan_assign(pair, RvalueKind.Binary(binary, left, right), span))
        wrapped = Place(local=pair.local, projection=Projection.Value, span=span)
        builder.emit(plan_assign(output, RvalueKind.Use(read_place(wrapped, false, span)), span))
        return Ok(None)
    builder.emit(plan_assign(output, RvalueKind.Binary(binary, left, right), span))
    return Ok(None)


def integer_helper_name(
    family: RustIntegerHelperFamily,
    operation: RustIntegerHelperOperation,
) -> str:
    """Choose the native primitive spelling after typed integer-helper dispatch."""
    prefix = match family:
        RustIntegerHelperFamily.Checked => "checked"
        RustIntegerHelperFamily.Wrapping => "wrapping"
        RustIntegerHelperFamily.Saturating => "saturating"
    suffix = match operation:
        RustIntegerHelperOperation.Add => "add"
        RustIntegerHelperOperation.Sub => "sub"
        RustIntegerHelperOperation.Mul => "mul"
        RustIntegerHelperOperation.Pow => "pow"
    return f"{prefix}_{suffix}"


def lower_string_slice(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Consume the checked primitive slice member with its borrowed receiver and two signed int endpoints."""
    if len(arguments) != 3:
        return Err("unsupported Body IR string slice argument count")
    incoming = builder.owned
    mut operands: list[Operand] = []
    match arguments[0].as_one():
        Some(value) => operands.append(borrow_text_operand(builder, value, span)?)
        None => return Err("unsupported Body IR string slice receiver spread")
    for index in [1, 2]:
        match arguments[index].as_one():
            Some(value) =>
                operand = scalar_operand(builder, value, span)?
                if operand_type(builder, operand)? != PlanType.Int:
                    return Err("unsupported Body IR non-int string slice bound")
                operands.append(operand)
            None => return Err("unsupported Body IR string slice bound spread")
    text = emit_text_helper(
        builder,
        "slice_text_bounds",
        PlanType.String,
        [PlanType.StringRef, PlanType.Int, PlanType.Int],
        operands,
        span,
    )
    drop_borrowed_text_temporaries(builder, incoming, text.local, span)
    return assign_text_result(builder, text, destination, span)


def lower_text_codec_method(
    mut builder: Builder,
    frozen: bool,
    decoding: bool,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call the exact borrowed UTF-8 runtime boundary after the frontend fills all checked codec slots."""
    mut arity = 2
    if decoding:
        arity = 3
    if len(arguments) != arity:
        return Err("unsupported Body IR incomplete builtin codec arguments")
    incoming = builder.owned
    receiver_type = argument_type(builder, arguments, 0, span)?
    mut operands: list[Operand] = []
    if not decoding and not frozen and receiver_type in [PlanType.String, PlanType.StringRef]:
        operands.append(text_argument(builder, arguments, 0, span)?)
    elif not decoding and frozen and receiver_type == PlanType.FrozenStr:
        operands.append(argument_value(builder, arguments, 0, span)?)
    elif decoding and not frozen:
        leaf, depth = require_list_shape(receiver_type, "unsupported Body IR nonbytes codec receiver")?
        if leaf != ListLeaf.U8 or depth != 1:
            return Err("unsupported Body IR nonbytes codec receiver")
        operands.append(borrowed_list_argument(builder, arguments, 0, false, span)?)
    elif decoding and frozen and receiver_type == PlanType.FrozenBytes:
        operands.append(argument_value(builder, arguments, 0, span)?)
    else:
        return Err("unsupported Body IR builtin codec identity with a different receiver")
    for index in range(1, arity):
        operands.append(text_argument(builder, arguments, index, span)?)
    mut result = PlanType.List(ListLeaf.U8, 1)
    mut output = plan_place(0, span)
    if decoding:
        match destination:
            Some(place) =>
                output = list_root_place(builder, place, span)?
                result = place_type(builder.locals, output)
            None => return Err("unsupported Body IR discarded codec result without a checked carrier")
        _owner, declaration = carrier_layout(builder, result)?
        if declaration.carrier != Carrier.Result or declaration.variants[0].fields != [PlanType.String]:
            return Err("unsupported Body IR decode result carrier")
        if len(declaration.variants[1].fields) != 1:
            return Err("unsupported Body IR decode error carrier")
        match declaration.variants[1].fields[0]:
            PlanType.ValidationError => pass
            PlanType.Model(owner, _name) =>
                if builder.nominals[owner].native_item != "incan_std_core::validation::ValidationError":
                    return Err("unsupported Body IR decode error identity")
            _ => return Err("unsupported Body IR decode error identity")
    else:
        output = call_destination(builder, destination, result, span)?
        if place_type(builder.locals, output) != result:
            return Err("unsupported Body IR encode result carrier")
    if decoding:
        lower_primitive_decode(builder, frozen, operands, output, result, span)?
    else:
        lower_primitive_encode(builder, frozen, operands, output, span)
    drop_borrowed_text_temporaries(builder, incoming, output.local, span)
    return Ok(None)


def lower_primitive_encode(
    mut builder: Builder,
    frozen: bool,
    operands: list[Operand],
    output: Place,
    span: SourceSpan,
) -> None:
    """Preserve the codec's label error in its owner, then transfer primitive-owned bytes to the checked result."""
    validated = temporary(builder, PlanType.Unit, span)
    external_call(
        builder,
        "incan_native_runtime::validate_encoder_label",
        [PlanType.StringRef],
        PlanType.Unit,
        [operands[1]],
        validated,
        span,
    )
    encoded = primitive_encode_utf8(builder, operands[0], frozen, span)
    replace_owned_destination(builder, output, RvalueKind.Use(read_place(encoded, true, span)), span)


def lower_primitive_decode(
    mut builder: Builder,
    frozen: bool,
    operands: list[Operand],
    output: Place,
    result: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Validate surface options before primitive decoding, then adapt only malformed UTF-8 to the public error carrier.

    The frozen receiver first becomes an owned byte buffer. Both receivers then use the same primitive decoder and
    explicit `(accepted, payload)` result, so the primitive never owns codec labels or ValidationError construction.
    """
    policy_type = PlanType.Tuple([TupleElement.Bool, TupleElement.Bool])
    policy = temporary(builder, policy_type, span)
    external_call(
        builder,
        "incan_native_runtime::decode_replacement_policy",
        [PlanType.StringRef, PlanType.StringRef],
        policy_type,
        [operands[1], operands[2]],
        policy,
        span,
    )
    policy_fields = tuple_fields(policy, policy_type, span)?
    rejected = builder.new_block(span)
    accepted = builder.new_block(span)
    after = builder.new_block(span)
    builder.finish(TerminatorKind.SwitchBool(read_place(policy_fields[0], false, span), rejected, accepted), span)

    # Rejected options construct the legacy error without reading the receiver.
    policy_owners = builder.owned
    builder.current = rejected
    error = temporary(builder, PlanType.ValidationError, span)
    external_call(
        builder,
        "incan_native_runtime::invalid_decoder_options",
        [PlanType.StringRef, PlanType.StringRef],
        PlanType.ValidationError,
        [operands[1], operands[2]],
        error,
        span,
    )
    owner, _declaration = carrier_layout(builder, result)?
    assign_carrier(builder, output, owner, 1, [read_place(error, true, span)], span)
    builder.finish(TerminatorKind.Goto(after), span)
    retained = builder.owned

    # Accepted options decode through one byte-level implementation, then adapt only its strict failure detail.
    builder.current = accepted
    builder.owned = policy_owners
    mut decoded = plan_place(0, span)
    if frozen:
        copied = copy_frozen_bytes(builder, operands[0], span)
        encoded = list_borrow(builder, copied, false, span)?
        decoded = primitive_decode_utf8(
            builder,
            encoded,
            PlanType.ListRef(ListLeaf.U8, 1),
            read_place(policy_fields[1], false, span),
            span,
        )
        drop_owned(builder, copied.local, span)
    else:
        decoded = primitive_decode_utf8(
            builder,
            operands[0],
            PlanType.ListRef(ListLeaf.U8, 1),
            read_place(policy_fields[1], false, span),
            span,
        )
    decoded_type = PlanType.Tuple([TupleElement.Bool, TupleElement.String])
    decoded_fields = tuple_fields(decoded, decoded_type, span)?
    invalid = builder.new_block(span)
    valid = builder.new_block(span)
    decoded_after = builder.new_block(span)
    builder.finish(TerminatorKind.SwitchBool(read_place(decoded_fields[0], false, span), invalid, valid), span)
    forget_owned(builder, decoded.local)
    decoded_owners = builder.owned

    builder.current = invalid
    adapted = temporary(builder, PlanType.ValidationError, span)
    external_call(
        builder,
        "incan_native_runtime::invalid_utf8_error",
        [PlanType.String],
        PlanType.ValidationError,
        [read_place(decoded_fields[1], true, span)],
        adapted,
        span,
    )
    assign_carrier(builder, output, owner, 1, [read_place(adapted, true, span)], span)
    builder.finish(TerminatorKind.Goto(decoded_after), span)
    decoded_retained = builder.owned

    builder.current = valid
    builder.owned = decoded_owners
    assign_carrier(builder, output, owner, 0, [read_place(decoded_fields[1], true, span)], span)
    builder.finish(TerminatorKind.Goto(decoded_after), span)
    builder.current = decoded_after
    builder.owned = decoded_retained
    builder.finish(TerminatorKind.Goto(after), span)

    builder.current = after
    builder.owned = retained
    return Ok(None)


def lower_selected_float(
    mut builder: Builder,
    target: &MethodTarget,
    method: RustFloatMethodId,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Lower one checker-selected float operation without reclassifying its canonical name."""
    receiver = argument_type(builder, arguments, 0, span)?
    if method == RustFloatMethodId.Powf and receiver == PlanType.F32:
        return Err("unsupported Body IR f32 powf: its checked float result differs from the carrier's f32 powf")
    if method == RustFloatMethodId.Sqrt:
        return lower_float_square_root(builder, receiver, arguments, destination, span)
    match float_method(method, receiver):
        Some((name, parameters, result)) =>
            return lower_float_method(builder, name, parameters, result, arguments, destination, span)
        None => return refuse_remaining_builtin_method(target)


def refuse_remaining_builtin_method(target: &MethodTarget) -> Result[None, str]:
    """Preserve the established lowering refusal after typed dispatch identifies an unsupported operation."""
    match target.builtin_label():
        Some(member) => return Err(f"unsupported Body IR remaining builtin Method {member}")
        None => return Err("unsupported Body IR builtin method operation")


def lower_float_square_root(
    mut builder: Builder,
    receiver: PlanType,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call native square root at the checker's float result type, widening an f32 receiver before evaluation."""
    if len(arguments) != 1:
        return Err("invalid Body IR square-root arity")
    if receiver != PlanType.F32 and receiver != PlanType.Float and receiver != PlanType.F64:
        return Err("invalid Body IR square-root receiver")
    output = call_destination(builder, destination, PlanType.Float, span)?
    operand = numeric_receiver(builder, arguments, span)?
    widened = coerce_numeric_operand(builder, operand, PlanType.Float, span)?
    external_call(builder, "std::primitive::f64::sqrt", [PlanType.Float], PlanType.Float, [widened], output, span)
    return Ok(None)


def float_method(method: RustFloatMethodId, receiver: PlanType) -> Option[tuple[str, list[PlanType], PlanType]]:
    """Select the checked native float member; these primitives must not reenter their runtime wrappers."""
    mut width = ""
    if receiver == PlanType.F32:
        width = "f32"
    elif receiver == PlanType.Float or receiver == PlanType.F64:
        width = "f64"
    else:
        return None
    if method == RustFloatMethodId.Powf and receiver != PlanType.F32:
        return Some(("f64::powf", [receiver, receiver], receiver))
    if method == RustFloatMethodId.Abs and receiver != PlanType.F32:
        return Some(("f64::abs", [receiver], PlanType.Float))
    if method == RustFloatMethodId.IsFinite:
        return Some((f"{width}::is_finite", [receiver], PlanType.Bool))
    if method == RustFloatMethodId.IsNan:
        return Some((f"{width}::is_nan", [receiver], PlanType.Bool))
    return None


def lower_float_method(
    mut builder: Builder,
    name: str,
    parameters: list[PlanType],
    result: PlanType,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    span: SourceSpan,
) -> Result[None, str]:
    """Call the native float member with the copied receiver and each argument at its checked carrier."""
    if len(arguments) != len(parameters):
        return Err("unsupported Body IR float Method arity")
    mut operands = [numeric_receiver(builder, arguments, span)?]
    for index in range(1, len(parameters)):
        argument = argument_value(builder, arguments, index, span)?
        operands.append(coerce_numeric_operand(builder, argument, parameters[index], span)?)
    output = call_destination(builder, destination, result, span)?
    external_call(builder, name, parameters, result, operands, output, span)
    return Ok(None)


def numeric_receiver(
    mut builder: Builder,
    arguments: &list[RustArgumentElement],
    span: SourceSpan,
) -> Result[Operand, str]:
    """Read a canonical numeric method's shared receiver without consuming its Copy storage."""
    match arguments[0].as_one():
        Some(RustOperand.Place(read)) =>
            # A list or dictionary element has no storage to copy from; its materialized value is read below.
            if read.fact == OwnershipFact.Borrow and not is_element_place(builder, read.place)?:
                place = scalar_place(builder, read.place, span)?
                if not numeric_carrier(place_type(builder.locals, place)):
                    return Err("invalid Body IR numeric receiver outside numeric storage")
                return Ok(read_place(place, false, span))
        _ => pass
    return argument_value(builder, arguments, 0, span)


pub def lower_generator_member(
    mut builder: Builder,
    method: RustIteratorMethodId,
    arguments: &list[RustArgumentElement],
    destination: &Option[RustPlace],
    receiver_ty: PlanType,
    span: SourceSpan,
) -> Result[None, str]:
    """
    Move the owned generator receiver into one runtime adapter or consumer, as legacy's member consumes its receiver.

    An adapter's result is another owned generator; a consumer drains the receiver into its checked destination.
    """
    receiver = argument_place(builder, arguments, 0, span)?
    if receiver.projection != Projection.Whole or place_type(builder.locals, receiver) != receiver_ty:
        return Err("unsupported Body IR generator member receiver")
    mut operands: list[Operand] = []
    for index in range(1, len(arguments)):
        operands.append(argument_value(builder, arguments, index, span)?)
    source = read_place(receiver, true, span)
    if is_generator_consumer(method):
        output = call_destination(builder, destination, consumer_result(method, receiver_ty), span)?
        drop_owned(builder, output.local, span)
        return generator_consumer(builder, method, source, operands, output, span)
    output = call_destination(builder, destination, receiver_ty, span)?
    drop_owned(builder, output.local, span)
    generator_adapter(builder, method, source, operands, output, span)?
    builder.owned.append(output.local)
    return Ok(None)
