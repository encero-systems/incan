"""Native fail-fast extraction of source-local checked newtype construction results."""

from rust::incan_semantics_core::body_ir import ArgumentElement, Place as RustPlace
from pub::incan_mir_plan import PlanType, SourceSpan
from frame import Builder, place_type
from options import result_layout
from lowering import argument_type, fixed_arguments, scalar_place, instantiated_external_call


pub def lower_newtype_hook_result(
    mut builder: Builder,
    arguments: &list[ArgumentElement],
    destination: &Option[RustPlace],
    aggregate_field: bool,
    span: SourceSpan,
) -> Result[None, str]:
    """Validate the retained Result and dispatch the chosen fail-fast or sole-field extraction contract."""
    if len(arguments) != 3:
        return Err("invalid Body IR NewtypeHookExtract arity")
    match destination:
        None => return Err("unsupported Body IR checked-newtype extraction without a destination")
        Some(place) =>
            output = scalar_place(builder, place, span)?
            target = place_type(builder.locals, output)
            input = argument_type(builder, arguments, 0, span)?
            _owner, declaration = result_layout(builder, input)?
            if len(declaration.variants[0].fields) != 1 or declaration.variants[0].fields[0] != target:
                return Err("unsupported Body IR checked-newtype extraction payload")
            if len(declaration.variants[1].fields) != 1:
                return Err("unsupported Body IR checked-newtype extraction error")
            error = declaration.variants[1].fields[0]
            if argument_type(builder, arguments, 1, span)? != PlanType.String or argument_type(
                builder,
                arguments,
                2,
                span,
            )? != PlanType.String:
                return Err("unsupported Body IR checked-newtype extraction labels")
            operands = fixed_arguments(builder, arguments, span)?
            mut path = "incan_native_runtime::checked_newtype_result"
            if aggregate_field:
                path = "incan_native_runtime::checked_newtype_field_result"
            return instantiated_external_call(
                builder,
                path,
                [target, error],
                [input, PlanType.String, PlanType.String],
                target,
                operands,
                output,
                span,
            )
