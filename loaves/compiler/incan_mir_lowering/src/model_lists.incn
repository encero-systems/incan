"""Checked list reads through canonical model fields, retaining the parent's storage."""

from rust::incan_semantics_core::body_ir import Place as RustPlace, PlaceElem
from pub::incan_mir_plan import PlanType, SourceSpan, Operand, Constant, Place as OperandPlace
from frame import Builder, place_type, temporary, read_place, literal
from models import model_prefix, field_projection
from tuples import is_tuple_type
from lists import require_list_shape, list_element, is_owned_list
from lowering import scalar_operand, read_list_element, list_borrow
from builtins import list_call


pub def model_list_read(mut builder: Builder, source: &RustPlace, span: SourceSpan) -> Result[Option[Operand], str]:
    """Read an index or slice after a retained nominal field or tuple element prefix, cloning its result instead of moving the parent."""
    match structural_prefix(builder, source)?:
        None => return Ok(None)
        Some((count, _through_tuple)) =>
            if count == len(source.projection):
                return Ok(None)
            if count == 0:
                return Err("unsupported Body IR model indexing without a field")
            return Ok(Some(prefixed_list_read(builder, source, count, span)?))


pub def structural_prefix(builder: Builder, source: &RustPlace) -> Result[Option[tuple[int, bool]], str]:
    """
    Count the leading field, payload and tuple-element steps of a place rooted at a model, enum or tuple.

    The walk tracks each step's type, so a constant index into a tuple stays part of the prefix like a field, while the
    first index into a list ends it. The flag reports whether the prefix passed through a tuple. A place rooted at
    anything else has no structural prefix.
    """
    mut ty = PlanType.Unit
    mut through_tuple = false
    match source.local_id():
        None => return Ok(None)
        Some(local) =>
            root = builder.locals[int(local.index()) + 1 + builder.local_offset].ty
            match root:
                PlanType.Model(_owner, _name) =>
                    ty = root
                PlanType.Enum(_owner, _name) =>
                    ty = root
                PlanType.Tuple(_elements) =>
                    ty = root
                PlanType.ModelRef(owner, name) =>
                    ty = PlanType.Model(owner, name)
                PlanType.ModelMutRef(owner, name) =>
                    ty = PlanType.Model(owner, name)
                _ => return Ok(None)
    mut count = 0
    for projection in source.projection:
        if is_tuple_type(ty):
            through_tuple = true
        match projection:
            PlaceElem.Field(name=_name, canonical=_canonical, structural=_structural) => pass
            PlaceElem.OptionPayload(option_type=_container, payload_type=_payload) => pass
            PlaceElem.UnionMember(ty=_member) => pass
            PlaceElem.Index(_index) =>
                if not is_tuple_type(ty):
                    break
            _ => break
        ty = field_projection(builder.nominals, ty, projection, builder.enums, builder.unions, builder.intrinsics)?.ty
        count += 1
    return Ok(Some((count, through_tuple)))


pub def prefix_place(builder: Builder, source: &RustPlace, count: int, span: SourceSpan) -> Result[OperandPlace, str]:
    """Project the first `count` structural steps of a place without reading or copying anything."""
    mut place = model_prefix(
        builder.nominals,
        builder.locals[builder.local_offset:],
        source,
        count,
        span,
        builder.enums,
        builder.unions,
        builder.intrinsics,
    )?
    place.local += builder.local_offset
    return Ok(place)


def prefixed_list_read(mut builder: Builder, source: &RustPlace, count: int, span: SourceSpan) -> Result[Operand, str]:
    """Read the list indexes and slices that follow a structural prefix, cloning an owned result."""
    mut place = prefix_place(builder, source, count, span)?
    for position in range(count, len(source.projection)):
        match source.projection[position]:
            PlaceElem.Index(index) =>
                argument = scalar_operand(builder, index, span)?
                place = read_list_element(builder, place, argument, span)?
            PlaceElem.Slice(start=start, end=end, step=step) =>
                place = sliced_list(builder, place, source.projection[position], span)?
            _ => return Err("unsupported Body IR model field after collection projection")
    ty = place_type(builder.locals, place)
    return Ok(read_place(place, ty == PlanType.String or is_owned_list(ty) or model_element(ty), span))


def model_element(ty: PlanType) -> bool:
    """Nominal list elements are cloned owners, while primitive elements remain copyable."""
    match ty:
        PlanType.Model(_owner, _name) => return true
        PlanType.Enum(_owner, _name) => return true
        _ => return false


def sliced_list(
    mut builder: Builder,
    source: OperandPlace,
    projection: &PlaceElem,
    span: SourceSpan,
) -> Result[OperandPlace, str]:
    """Pass each retained optional bound to legacy slicing without replacing an omitted bound with zero."""
    leaf, depth = require_list_shape(place_type(builder.locals, source), "unsupported Body IR model slice on non-list")?
    reference = list_borrow(builder, source, false, span)?
    mut arguments = [reference]
    match projection:
        PlaceElem.Slice(start=start, end=end, step=step) =>
            for bound in [start, end, step]:
                match bound:
                    Some(value) =>
                        arguments.append(literal(Constant.Bool(true), span))
                        arguments.append(scalar_operand(builder, value, span)?)
                    None =>
                        arguments.append(literal(Constant.Bool(false), span))
                        arguments.append(literal(Constant.Int(0), span))
        _ => return Err("invalid Body IR list slice projection")
    result = PlanType.List(leaf, depth)
    output = temporary(builder, result, span)
    list_call(
        builder,
        "slice_list",
        list_element(leaf, depth),
        [PlanType.ListRef(leaf, depth), PlanType.Bool, PlanType.Int, PlanType.Bool, PlanType.Int, PlanType.Bool, PlanType.Int],
        result,
        arguments,
        output,
        span,
    )
    return Ok(output)
