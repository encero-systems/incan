"""Forward `@rust.extern` declarations to the Rust items they name, as legacy's generated wrapper does."""

from pub::incan_mir_plan import (
    Callee,
    CalleeKind,
    ExternalFunction,
    Function,
    Local,
    Operand,
    OperandKind,
    Parameter,
    PlanType,
    SourceSpan,
    Statement,
    TerminatorKind,
    Unwind,
)
from pub::incan_mir_plan import block, place


pub def delegated_function(
    name: str,
    path: str,
    type_arguments: list[PlanType],
    parameters: list[Parameter],
    result: PlanType,
    span: SourceSpan,
) -> Result[tuple[Function, list[ExternalFunction]], str]:
    """Pass parameters in declaration order to the exact checked Rust instantiation, moving owned values."""
    if name == "main":
        return Err("unsupported Body IR ExternDelegation entrypoint")
    if not delegated_type(result):
        return Err("unsupported Body IR ExternDelegation return type")
    mut locals = [Local(ty=result, span=span)]
    mut types: list[PlanType] = []
    mut arguments: list[Operand] = []
    for index in range(len(parameters)):
        ty = parameters[index].ty
        if not delegated_type(ty):
            return Err("unsupported Body IR ExternDelegation parameter type")
        locals.append(Local(ty=ty, span=span))
        types.append(ty)
        arguments.append(Operand(kind=OperandKind.Move(place(index + 1, span)), span=span))
    mut callee = CalleeKind.External(path)
    if len(type_arguments) != 0:
        callee = CalleeKind.Instantiated(path, type_arguments)
    call = TerminatorKind.Call(
        Callee(kind=callee, span=span),
        arguments,
        place(0, span),
        1,
        Unwind.Continue,
    )
    function = Function(
        name=name,
        parameters=parameters,
        return_type=result,
        locals=locals,
        blocks=[block([], call, span), block([], TerminatorKind.Return, span)],
        span=span,
    )
    return Ok((function, [ExternalFunction(path=path, type_arguments=type_arguments, parameters=types, return_type=result, span=span)]))


def delegated_type(ty: PlanType) -> bool:
    """
    Admit every carrier a function signature holds, which the wrapper moves into the call unchanged.

    The driver compares the planned instantiation with the Rust item's own signature, so an item that takes another
    carrier is refused there by name. Only body-internal carriers, which never cross a signature, are refused here.
    """
    match ty:
        (PlanType.Never | PlanType.EnumTag | PlanType.CheckedInt | PlanType.CheckedNumeric(_) | PlanType.CallableArguments(_)) =>
            return false
        (PlanType.StringArray(_) | PlanType.StrArray(_) | PlanType.StringArrayRef(_) | PlanType.StrArrayRef(_)) =>
            return false
        _ => return true
