"""Lower one function: its body builder, frame parameters, locals, scopes, and entrypoint effects."""

from pub::incan_mir_plan import (
    ExternalFunction,
    Constant,
    Function,
    Local,
    EnumDeclaration,
    Parameter,
    PlanType,
    RvalueKind,
    SourceSpan,
    TerminatorKind,
    assign as plan_assign,
    place as plan_place,
)
from layout_types import native_source_type
from signature_lifetimes import signature_lifetimes
from rust::incan_semantics_core import (
    IncanInputAccess,
    IncanType as RustType,
    CanonicalSymbolId as RustCanonicalSymbolId,
)
from rust::incan_semantics_core::body_ir import (
    NominalDeclaration as RustNominalDeclaration,
    EnumDeclaration as RustEnumDeclaration,
    Body as RustBody,
    CallableParamDefault,
    CallableParam as RustCallableParam,
    LocalDecl as RustLocalDecl,
    EntrypointEffect as RustEntrypointEffect,
)
from classes import (
    parameter_local_index,
    frame_type,
    function_name,
    is_program_entry,
    body_module_identity,
    body_type_bindings,
)
from tuple_iterators import zip_shape
from generators import generator_shape, producer_frame, producer_name
from pair_generators import pair_generator_locals, pair_generator_type
