    validate_callable_representation,
    function_pointer_storage,
    parameter_representation,
    local_representation,
    return_representation,
)
from attributes import native_attributes
from externs import delegated_function
from lowering import BodyIrModule
from checked_values import builder_location, indexed_location, line_starts, location
from statements import is_nominal_type, is_owned_callable, lower_block
