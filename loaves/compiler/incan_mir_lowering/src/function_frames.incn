from native_type_identity import ConstructorIndex
from table_views import borrowed_at, borrowed_table
from decorator_caches import DecoratorFrame, frame_name, validate_binding_policy, callable_name_profile
from traits import append_default_type_bindings
from unions import retain_body_unions
from text_plan import owned_literal
from frame import Builder, temporary, drop_all_owned, external_call, read_place, literal
from lists import list_iterator_locals, taking_iterator_locals, list_parameter_type
from async_ import future_type, integer_entry, evaluator_name, is_future
from defaults import default_type
from type_parameters import Instance, substitute
from computed_statics import enters_module_initialization, initialize_module_statics
