"""Generic native ADTs published by their declaring Loaf, without consumer-owned replacement structs."""

from rust::incan_semantics_core import IncanType as RustType, SemanticSourceTargetKind
from rust::incan_semantics_core::body_ir import BodyIrModule, NominalDeclaration
from pub::incan_mir_plan import GenericLayoutType, GenericLayoutField, GenericModelDeclaration, SourceSpan
from nominal_instances import NominalInstance
from decls import library_item
from unions import native_source_type


pub def generic_models(
    module: &BodyIrModule,
    instances: list[NominalInstance],
    file: str,
) -> Result[list[GenericModelDeclaration], str]:
    """Retain public and instantiated local templates; linked Loaves already own their generic ADTs."""
    mut models: list[GenericModelDeclaration] = []
    for declaration in module.nominal_declarations:
        if len(declaration.type_parameters) == 0 or library_item(declaration) != "":
            continue
        mut reached = declaration.public
        for instance in instances:
            if instance.declaration.canonical == declaration.canonical:
                reached = true
        if not reached:
            continue
        if declaration.canonical.kind == SemanticSourceTargetKind.Newtype:
            return Err("unsupported Body IR generic Loaf newtype layout")
        mut fields: list[GenericLayoutField] = []
        for index in range(len(declaration.fields)):
            fields.append(GenericLayoutField(
                name=str(declaration.fields[index]),
                ty=generic_field_type(module, declaration.field_types[index], declaration.type_parameters.clone())?,
                public=declaration.field_public[index],
            ))
        mut derives: list[str] = []
        for derive in declaration.derives:
            # Construction defaults and reflection stay in their checked Incan records, rather than native derives.
            if derive in ["Default", "FieldInfo", "IncanClass"]:
                continue
            if derive not in ["Clone", "Debug", "PartialEq", "Eq", "PartialOrd", "Ord", "Hash"]:
                return Err(f"unsupported Body IR generic Loaf derive {derive}")
            derives.append(str(derive))
        models.append(GenericModelDeclaration(
            name=str(declaration.name),
            source_name=str(declaration.canonical.declaration_name),
            parameters=declaration.type_parameters.clone(),
            fields=fields,
            derives=derives,
            span=SourceSpan(file=file, line=1, column=1),
        ))
    return Ok(models)


def generic_field_type(module: &BodyIrModule, ty: &RustType, parameters: list[str]) -> Result[GenericLayoutType, str]:
    """Translate a checked field structurally, preserving binders and exact nominal owners before native instantiation."""
    match ty:
        RustType.TypeVar(name) =>
            if str(name) not in parameters:
                return Err(f"invalid Body IR generic layout parameter {name}")
            return Ok(GenericLayoutType.Parameter(str(name)))
        RustType.Generic(base=base, args=arguments) =>
            path = generic_layout_path(module, str(base))?
            mut args: list[GenericLayoutType] = []
            for argument in arguments:
                args.append(generic_field_type(module, argument, parameters)?)
            return Ok(GenericLayoutType.Applied(path, args))
        RustType.Tuple(elements) =>
            mut fields: list[GenericLayoutType] = []
            for element in elements:
                fields.append(generic_field_type(module, element, parameters)?)
            return Ok(GenericLayoutType.Tuple(fields))
        _ => return Ok(GenericLayoutType.Concrete(native_source_type(module.nominal_declarations, module.enum_declarations, [], ty, [])?))


def generic_layout_path(module: &BodyIrModule, base: str) -> Result[str, str]:
    """Use the checked declaration's native item or its local carrier; collection heads have fixed native ADTs."""
    if base == "List":
        return Ok("std::vec::Vec")
    if base == "Option":
        return Ok("std::option::Option")
    if base == "Result":
        return Ok("std::result::Result")
    for declaration in module.nominal_declarations:
        if str(declaration.name) != base:
            continue
        item = library_item(declaration)
        if item != "":
            return Ok(item)
        return Ok("crate::" + base)
    return Err(f"unsupported Body IR generic Loaf field owner {base}")
