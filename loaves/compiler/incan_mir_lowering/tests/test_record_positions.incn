"""A plan product holds no source line: moved lines inside a body change only its request-local position map."""

from std.fs import Path
from std.tempfile import TemporaryDirectory
from pub::incan_mir_plan import decode_plan_function_record
from record_positions import index_positions, indexed_product, place_positions, positioned_product, relocate_product
from pub::incan_mir_plan import (
    encode_product,
    BasicBlock,
    ExternalFunction,
    Function,
    Local,
    PlanType,
    ProductNominal,
    NominalReference,
    SourceSpan,
    Terminator,
    TerminatorKind,
    source_span,
    unit_nominals,
)
from scalar_store import finalize_scalar, record_scalar_inputs, retain_scalar, retained_scalar


pub def test_moved_body_lines_keep_the_plan_product() -> Result[None, str]:
    """
    A comment inserted inside a body moves its second node down one line.

    The record key and the stored product bytes stay the same, and restoring the product places its spans at the
    nodes' new lines.
    """
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products = scratch.path().joinpath("products")
    products.mkdir(true, true).map_err((error) => error.message())?
    owner = source_span(file="positions.incn", line=10, column=1)
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    before_nodes = [(0, 1), (1, 5), (2, 5)]
    before = positioned("relay", owner, 11, 12)
    inputs = record_scalar_inputs("checked-meaning", before.name, owner, false, "reads", len(before_nodes))
    retain_scalar(products.0, inputs, before, empty_runtime, empty_nominals, before_nodes)?
    stored = only_product(products)?
    after_nodes = [(0, 1), (1, 5), (3, 5)]
    record = decode_plan_function_record(stored)?
    placed = place_positions(record.function, after_nodes)?
    assert positioned_product(record.function, after_nodes, "moved.incn", 20)? == relocate_product(placed, "moved.incn", 20)?
    missing_nodes: list[tuple[int, int]] = []
    assert positioned_product(record.function, missing_nodes, "moved.incn", 20).is_err()
    after = positioned("relay", owner, 11, 13)
    assert record_scalar_inputs("checked-meaning", after.name, owner, false, "reads", len(after_nodes)) == inputs
    no_models: list[ProductNominal] = []
    no_names: list[str] = []
    unit = unit_nominals(no_models, list(no_models), no_names, list(no_names))
    match retained_scalar(products.0, inputs, unit, Some(owner), after_nodes):
        None => assert false, "a comment that moved lines inside the body made the product a miss"
        Some(product) =>
            function, _runtime, _references, _frames, _requests = product
            assert function == after, "the reused product kept the lines of the body it was captured from"
    retain_scalar(products.0, inputs, after, empty_runtime, empty_nominals, after_nodes)?
    assert only_product(products)? == stored, "moved lines changed the plan product's bytes"
    return Ok(None)


pub def test_indexed_product_matches_both_position_passes_and_refusals() -> Result[None, str]:
    owner = source_span(file="positions.incn", line=10, column=1)
    function = positioned("relay", owner, 11, 12)
    helper = positioned("helper", owner, 12, 11)
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    wire = encode_product(function, empty_runtime, empty_nominals, [helper])?
    nodes = [(0, 1), (1, 5), (2, 5), (1, 5)]
    relative = relocate_product(wire, "<owner>", 1)?
    assert indexed_product(wire, nodes, "positions.incn", 10)? == index_positions(relative, nodes)?
    assert indexed_product(wire, [(0, 1)], "positions.incn", 10).is_err()
    assert indexed_product(wire, nodes, "other.incn", 10).is_err()
    return Ok(None)


pub def test_unlocated_body_span_refuses_a_position_free_product() -> Result[None, str]:
    """A span below the owner line that no Body IR node carries refuses capture rather than go stale."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    owner = source_span(file="positions.incn", line=10, column=1)
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    nodes = [(0, 1), (1, 5)]
    function = positioned("relay", owner, 11, 12)
    inputs = record_scalar_inputs("checked-meaning", function.name, owner, false, "reads", len(nodes))
    match retain_scalar(scratch.path().0, inputs, function, empty_runtime, empty_nominals, nodes):
        Ok(_) => assert false, "a span no node locates was retained with its line"
        Err(message) => assert "locates no Body IR node" in message, message
    return Ok(None)


pub def test_finalization_matches_every_carried_frame_before_reusing_capture() -> Result[None, str]:
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    directory = scratch.path()
    owner = source_span(file="positions.incn", line=10, column=1)
    function = positioned("work", owner, 11, 12)
    frame = positioned("helper", owner, 11, 12)
    nodes = [(0, 1), (1, 5), (2, 5)]
    inputs = record_scalar_inputs("meaning", function.name, owner, false, "reads", len(nodes))
    runtime: list[ExternalFunction] = []
    nominals: list[ProductNominal] = []
    references: list[NominalReference] = []
    retain_scalar(directory.0, inputs, function, runtime, nominals, nodes, [frame])?
    for path in directory.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".incnfunction"):
            captured = path.read_bytes().map_err((error) => error.message())?
            key = path.stem()
            mut names: list[str] = []
            product = decode_plan_function_record(captured)?.function
            placed = positioned_product(product, nodes, "positions.incn", 10, names)?
            assert names == ["helper"]
            assert placed == positioned_product(product, nodes, "positions.incn", 10)?
            exact, _positions = finalize_scalar(directory.0, key, function, false, references, nodes, [frame], captured)?
            assert exact == captured
            retained, _retained_positions = finalize_scalar(directory.0, key, function, true, references, nodes, [frame], captured)?
            assert retained == captured
            changed = positioned("helper", owner, 12, 11)
            assert finalize_scalar(directory.0, key, function, true, references, nodes, [changed], captured).is_err()
            replaced, _new_positions = finalize_scalar(directory.0, key, function, false, references, nodes, [changed], captured)?
            assert replaced != captured
            assert path.read_bytes().map_err((error) => error.message())? == replaced
            return Ok(None)
    return Err("missing captured test product")


def positioned(name: str, owner: SourceSpan, statement_line: int, exit_line: int) -> Function:
    """A function whose block starts on one body line and whose return sits on another."""
    block_span = source_span(file="positions.incn", line=statement_line, column=5)
    exit_span = source_span(file="positions.incn", line=exit_line, column=5)
    return Function(
        name=name,
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=owner)],
        blocks=[
            BasicBlock(
                statements=[],
                terminator=Terminator(kind=TerminatorKind.Return, span=exit_span),
                cleanup=false,
                span=block_span,
            ),
        ],
        span=owner,
    )


def only_product(products: Path) -> Result[bytes, str]:
    """Read the single retained product record as its binary Crumb envelope."""
    for path in products.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".incnfunction"):
            return path.read_bytes().map_err((error) => error.message())
    return Err("no plan product was retained")
