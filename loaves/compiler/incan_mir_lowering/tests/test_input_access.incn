"""Checked input modes survive native representation normalization and distinguish source instance symbols."""

from rust::incan_semantics_core import (
    CanonicalSymbolId,
    CompilerNodeId,
    HirSourceSpan,
    IncanCallableParam,
    IncanCallableParamKind,
    IncanInputAccess,
    IncanType as RustType,
    IncanPrimitiveType as Primitive,
    SemanticSourceTargetKind,
    function_type,
    generic,
)
from rust::incan_semantics_core::body_ir import (
    Body as RustBody,
    CheckedInputProfile,
    EnumDeclaration,
    EnumVariantDeclaration,
    NominalDeclaration,
)
from rust::std::collections import BTreeMap
from rust::incan_semantics_core::body_ir import nominal_carrier_key
from type_parameters import source_nominal_owner
from rust::std::sync import Arc
from body_ir_record_adapters import native_body
from decls import ViewLifetimeLayout
from native_type_identity import constructor_index, representation_arguments
from pub::internal_models.body_ir_declarations import CompilerBody
from pub::internal_models.body_ir_values import CompilerBlock
from pub::internal_models.checked_types import CheckedPrimitiveType, CheckedType
from pub::internal_models.compiler_records import HirSourceSpan as CompilerHirSourceSpan
from symbols import type_component
from result_requirements import independent_result, independent_result_with_layout, validate_result_requirements


def callable_with_access(access: IncanInputAccess) -> RustType:
    """Vary only the checked access mode, retaining equal value types and ordinary binding flags."""
    parameters: list[IncanCallableParam] = [
        IncanCallableParam(
            name=None,
            ty=RustType.Primitive(Primitive.Int),
            kind=IncanCallableParamKind.Normal,
            has_default=false,
            is_partial_preset=false,
            is_mut=false,
            native_owned=false,
            input_access=access,
        ),
    ]
    return function_type(parameters, RustType.Primitive(Primitive.Unit))


pub def test_callable_symbols_distinguish_input_access() -> None:
    """All four modes have distinct deterministic keys; no other signature field differs."""
    modes = [IncanInputAccess.Inferred, IncanInputAccess.Shared, IncanInputAccess.Exclusive, IncanInputAccess.Owned]
    for left in range(len(modes)):
        key = type_component(callable_with_access(modes[left]))
        assert key == type_component(callable_with_access(modes[left]))
        for right in range(left + 1, len(modes)):
            assert key != type_component(callable_with_access(modes[right]))


pub def test_native_callable_normalization_preserves_input_access() -> None:
    """Removing source-only binding metadata must retain shared, exclusive and owned access facts."""
    declarations: list[NominalDeclaration] = []
    constructors = constructor_index(declarations)
    modes = [IncanInputAccess.Inferred, IncanInputAccess.Shared, IncanInputAccess.Exclusive, IncanInputAccess.Owned]
    for mode in modes:
        arguments = [callable_with_access(mode)]
        normalized = representation_arguments(declarations, constructors, arguments)
        assert len(normalized) == 1
        match normalized[0]:
            RustType.Function(params=parameters, return_type=_result) =>
                assert len(parameters) == 1
                assert parameters[0].input_access == mode
                assert not parameters[0].is_mut
                assert not parameters[0].native_owned
            _ =>
                assert false


pub def test_generic_result_requires_independent_closed_storage() -> None:
    """A scalar failure closes the obligation; symbolic, nominal and borrowed failures cannot discharge it."""
    unit = RustType.Primitive(Primitive.Unit)
    text = RustType.Primitive(Primitive.Str)
    assert not independent_result(generic("Result", [text]))
    assert not independent_result(generic("Option", [text, unit]))
    assert independent_result(generic("Result", [unit, text]))
    assert independent_result(generic("Result", [unit, generic("Option", [text])]))
    assert not independent_result(generic("Result", [unit, RustType.TypeVar("E")]))
    assert not independent_result(generic("Result", [unit, RustType.Named("E")]))
    assert not independent_result(generic("Result", [unit, generic("Borrowed", [text])]))
    assert not independent_result(generic("Result", [unit, generic("Reference", [text])]))


pub def test_source_nominal_lookup_respects_direct_and_legacy_carriers() -> Result[None, str]:
    """A missing spelling needs a checked carrier, and a direct checked alias wins."""
    source = CanonicalSymbolId.module_declaration(
        ["local_packet"], "Payload", SemanticSourceTargetKind.Model, HirSourceSpan.new(0, 10),
    )
    mut scope: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = scope.insert("Payload", source.clone())
    assert source_nominal_owner(scope, "Payload")
    assert not source_nominal_owner(scope, "Optional")
    match nominal_carrier_key(source):
        Some(key) =>
            assert source_nominal_owner(scope, key)
            shadow = CanonicalSymbolId.module_declaration(
                ["local_packet"], "Plain", SemanticSourceTargetKind.TypeAlias, HirSourceSpan.new(11, 20),
            )
            _ = scope.insert(key.clone(), shadow)
            assert not source_nominal_owner(scope, key)
        None => return Err("source declaration has no carrier")
    return Ok(None)


def source_identity(module: str, name: str, kind: SemanticSourceTargetKind) -> CanonicalSymbolId:
    return CanonicalSymbolId.module_declaration(
        ["std", str(module)], name, kind, HirSourceSpan.new(0, 10),
    )


def source_enum(name: str, fields: list[RustType]) -> EnumDeclaration:
    """Build one exact nongeneric source enum with one payload variant and its own identity map."""
    canonical = source_identity("result_requirements", name, SemanticSourceTargetKind.Enum)
    mut identities: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = identities.insert(str(name), canonical.clone())
    return EnumDeclaration(
        record_package_identity=None,
        native_item="",
        direct_declaration_id=CompilerNodeId.declaration_span("std::result_requirements", 0, 10),
        canonical=canonical,
        name=str(name),
        public=false,
        type_parameters=[],
        native_type_arguments=[],
        variants=[
            EnumVariantDeclaration(
                direct_declaration_id=CompilerNodeId.declaration_span("std::result_requirements", 11, 20),
                canonical=source_identity("result_requirements", f"{name}Value", SemanticSourceTargetKind.Variant),
                name=f"{name}Value",
                fields=fields,
            ),
        ],
        derives=[],
        named_type_identities=Arc.new(identities),
    )


def empty_native_body(name: str) -> Result[RustBody, str]:
    """Construct a complete Body through the existing authored adapter, then attach native proof facts in tests."""
    return native_body(
        CompilerBody(
            nominal_instantiation=[],
            trait_default_instantiation=None,
            type_parameters=[],
            declaration_id=CompilerNodeId.declaration("result_requirements", name),
            direct_call_id=CompilerNodeId.declaration_span("result_requirements", 0, 10),
            canonical=None,
            name=str(name),
            span=CompilerHirSourceSpan(file="result_requirements.incn", start=0, end=10),
            return_type=CheckedType.Primitive(CheckedPrimitiveType.Unit),
            callable_representation=None,
            checked_input_profile=None,
            explicit_input_bindings=[],
            returned_view=None,
            named_type_identities=[],
            locals=[],
            params=[],
            param_locals=[],
            scopes=[],
            block=CompilerBlock(scope=0, statements=[]),
            runtime_requirements=[],
            panic_facts=[],
            is_async=false,
            retired_rust_facade_wire=None,
            native_attributes=[],
        ),
    )


def checked_requirement(
    ty: &RustType,
    identities: &BTreeMap[str, CanonicalSymbolId],
    enums: &list[EnumDeclaration],
) -> bool:
    declarations: list[NominalDeclaration] = []
    mut layouts = ViewLifetimeLayout.start(declarations, enums)
    return independent_result_with_layout(ty, identities, declarations, enums, layouts)


pub def test_result_requirements_use_exact_owned_source_declaration_closure() -> Result[None, str]:
    """Owned nominal recursion closes; every unresolved, ambiguous, borrowed, native or open edge refuses."""
    text = RustType.Primitive(Primitive.Str)
    bytes_value = RustType.Primitive(Primitive.Bytes)
    unit = RustType.Primitive(Primitive.Unit)

    mut value = source_enum("Value", [])
    value.variants[0].fields = [text.clone(), generic("List", [RustType.Named("Value")])]
    fault = source_enum("CodecFault", [text.clone(), RustType.Primitive(Primitive.Int)])
    mut identities: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = identities.insert("Value", value.canonical.clone())
    _ = identities.insert("CodecFault", fault.canonical.clone())
    enums = [value.clone(), fault.clone()]
    assert checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]), identities, enums,
    )
    assert checked_requirement(
        generic("Result", [bytes_value.clone(), RustType.Named("CodecFault")]), identities, enums,
    )
    assert checked_requirement(
        generic("Result", [unit, RustType.Named("CodecFault")]), identities, enums,
    )
    empty: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    no_enums: list[EnumDeclaration] = []
    assert checked_requirement(generic("Result", [generic("List", [bytes_value]), text]), empty, no_enums)

    assert not checked_requirement(generic("Result", [text]), empty, no_enums)
    assert not checked_requirement(generic("Option", [text, text]), empty, no_enums)
    assert not checked_requirement(generic("Result", [RustType.TypeVar("E"), text]), empty, no_enums)
    assert not checked_requirement(generic("Result", [RustType.Named("E"), text]), empty, no_enums)
    assert not checked_requirement(generic("Result", [generic("List", [text, text]), text]), empty, no_enums)
    assert not checked_requirement(generic("Result", [generic("Dict", [text, text]), text]), empty, no_enums)
    assert not checked_requirement(generic("Result", [RustType.RustInteropPath("rust::String"), text]), empty, no_enums)

    duplicated = [value.clone(), value.clone(), fault.clone()]
    assert not checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]), identities, duplicated,
    )
    mut missing: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = missing.insert("CodecFault", fault.canonical.clone())
    assert not checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]), missing, enums,
    )
    mut foreign = value.clone()
    foreign.canonical = CanonicalSymbolId.module_declaration(
        ["other"], "Value", SemanticSourceTargetKind.Enum, HirSourceSpan.new(0, 10),
    )
    mut foreign_scope: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = foreign_scope.insert("Value", foreign.canonical.clone())
    foreign.named_type_identities = Arc.new(foreign_scope)
    mut repointed = identities.clone()
    _ = repointed.insert("Value", foreign.canonical.clone())
    assert not checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]),
        repointed,
        [value.clone(), fault.clone(), foreign],
    )
    assert not checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]),
        repointed,
        [value.clone(), fault.clone()],
    )
    mut alias_cycle = value.clone()
    alias_cycle.variants[0].fields = [RustType.Named("Wrong")]
    mut alias_cycle_scope = alias_cycle.named_type_identities.as_ref().clone()
    _ = alias_cycle_scope.insert("Wrong", alias_cycle.canonical.clone())
    alias_cycle.named_type_identities = Arc.new(alias_cycle_scope)
    assert not checked_requirement(
        generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")]),
        identities,
        [alias_cycle, fault.clone()],
    )

    borrowed = source_enum("BorrowedPayload", [RustType.Ref(text.clone())])
    mut borrowed_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = borrowed_ids.insert("BorrowedPayload", borrowed.canonical.clone())
    assert not checked_requirement(
        generic("Result", [RustType.Named("BorrowedPayload"), text.clone()]), borrowed_ids, [borrowed.clone()],
    )
    borrowed_mut = source_enum("BorrowedMutPayload", [RustType.RefMut(text.clone())])
    mut borrowed_mut_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = borrowed_mut_ids.insert("BorrowedMutPayload", borrowed_mut.canonical.clone())
    assert not checked_requirement(
        generic("Result", [RustType.Named("BorrowedMutPayload"), text.clone()]),
        borrowed_mut_ids,
        [borrowed_mut],
    )
    for wrapper in ["Borrowed", "BorrowedMut", "Reference"]:
        mut wrapped = borrowed.clone()
        wrapped.name = f"{wrapper}Payload"
        wrapped.canonical = source_identity(
            "result_requirements", f"{wrapper}Payload", SemanticSourceTargetKind.Enum,
        )
        mut wrapped_scope: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
        _ = wrapped_scope.insert(f"{wrapper}Payload", wrapped.canonical.clone())
        wrapped.named_type_identities = Arc.new(wrapped_scope)
        wrapped.variants[0].fields = [generic(wrapper, [text.clone()])]
        mut wrapped_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
        _ = wrapped_ids.insert(f"{wrapper}Payload", wrapped.canonical.clone())
        assert not checked_requirement(
            generic("Result", [RustType.Named(f"{wrapper}Payload"), text.clone()]), wrapped_ids, [wrapped],
        )
    mut hidden = borrowed.clone()
    hidden.name = "HiddenBorrow"
    hidden.canonical = source_identity("result_requirements", "HiddenBorrow", SemanticSourceTargetKind.Enum)
    mut hidden_scope: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = hidden_scope.insert("HiddenBorrow", hidden.canonical.clone())
    hidden.named_type_identities = Arc.new(hidden_scope)
    hidden.variants[0].fields = [generic("List", [RustType.Ref(text.clone())])]
    mut hidden_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = hidden_ids.insert("HiddenBorrow", hidden.canonical.clone())
    assert not checked_requirement(
        generic("Result", [RustType.Named("HiddenBorrow"), text.clone()]), hidden_ids, [hidden],
    )

    mut left = source_enum("Left", [RustType.Named("Right")])
    mut right = source_enum("Right", [RustType.Named("Left"), RustType.Ref(text.clone())])
    mut left_scope = left.named_type_identities.as_ref().clone()
    _ = left_scope.insert("Right", right.canonical.clone())
    left.named_type_identities = Arc.new(left_scope)
    mut right_scope = right.named_type_identities.as_ref().clone()
    _ = right_scope.insert("Left", left.canonical.clone())
    right.named_type_identities = Arc.new(right_scope)
    mut cycle_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = cycle_ids.insert("Left", left.canonical.clone())
    borrow_cycle_enums = [left.clone(), right.clone()]
    assert not checked_requirement(
        generic("Result", [RustType.Named("Left"), text.clone()]), cycle_ids, [left.clone(), right.clone()],
    )
    right.variants[0].fields = [RustType.Named("Left")]
    assert checked_requirement(
        generic("Result", [RustType.Named("Left"), text.clone()]), cycle_ids, [left, right],
    )

    mut open = source_enum("Open", [text.clone()])
    open.type_parameters = ["T"]
    mut open_ids: BTreeMap[str, CanonicalSymbolId] = BTreeMap.new()
    _ = open_ids.insert("Open", open.canonical.clone())
    assert not checked_requirement(generic("Result", [RustType.Named("Open"), text]), open_ids, [open])

    mut body = empty_native_body("list_result")?
    body.checked_input_profile = Some(
        CheckedInputProfile(
            result_requirements=[
                (HirSourceSpan.new(3, 17), generic("Result", [generic("List", [RustType.Primitive(Primitive.Bytes)]), RustType.Primitive(Primitive.Str)])),
            ],
            version=3,
            owner=source_identity("result_requirements", "list_result", SemanticSourceTargetKind.Function),
            parameters=[],
            owned_initializers=[],
        ),
    )
    declarations: list[NominalDeclaration] = []
    validate_result_requirements(body, declarations, no_enums)?

    mut nominal_body = empty_native_body("nominal_result")?
    nominal_body.named_type_identities = Arc.new(identities.clone())
    nominal_body.checked_input_profile = Some(
        CheckedInputProfile(
            result_requirements=[
                (HirSourceSpan.new(3, 17), generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")])),
            ],
            version=3,
            owner=source_identity("result_requirements", "nominal_result", SemanticSourceTargetKind.Function),
            parameters=[],
            owned_initializers=[],
        ),
    )
    validate_result_requirements(nominal_body, declarations, enums)?

    mut wrong_body = empty_native_body("wrong_nominal")?
    wrong_body.named_type_identities = Arc.new(repointed)
    wrong_body.checked_input_profile = Some(
        CheckedInputProfile(
            result_requirements=[
                (HirSourceSpan.new(3, 17), generic("Result", [RustType.Named("Value"), RustType.Named("CodecFault")])),
            ],
            version=3,
            owner=source_identity("result_requirements", "wrong_nominal", SemanticSourceTargetKind.Function),
            parameters=[],
            owned_initializers=[],
        ),
    )
    assert validate_result_requirements(wrong_body, declarations, enums).is_err()

    mut borrowed_body = empty_native_body("borrowed_nominal")?
    borrowed_body.named_type_identities = Arc.new(borrowed_ids)
    borrowed_body.checked_input_profile = Some(
        CheckedInputProfile(
            result_requirements=[
                (HirSourceSpan.new(3, 17), generic("Result", [RustType.Named("BorrowedPayload"), RustType.Primitive(Primitive.Str)])),
            ],
            version=3,
            owner=source_identity("result_requirements", "borrowed_nominal", SemanticSourceTargetKind.Function),
            parameters=[],
            owned_initializers=[],
        ),
    )
    assert validate_result_requirements(borrowed_body, declarations, [borrowed]).is_err()

    mut cycle_body = empty_native_body("borrow_cycle")?
    cycle_body.named_type_identities = Arc.new(cycle_ids)
    cycle_body.checked_input_profile = Some(
        CheckedInputProfile(
            result_requirements=[
                (HirSourceSpan.new(3, 17), generic("Result", [RustType.Named("Left"), RustType.Primitive(Primitive.Str)])),
            ],
            version=3,
            owner=source_identity("result_requirements", "borrow_cycle", SemanticSourceTargetKind.Function),
            parameters=[],
            owned_initializers=[],
        ),
    )
    assert validate_result_requirements(cycle_body, declarations, borrow_cycle_enums).is_err()
    return Ok(None)
