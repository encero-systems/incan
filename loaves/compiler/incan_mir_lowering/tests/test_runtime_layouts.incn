"""Lowering reads the runtime's generic-decorator binding state only for a program that declares a decorated binding."""

from rust::incan_semantics_core import (
    CanonicalSymbolId as RustCanonicalSymbolId,
    HirSourceSpan as RustHirSourceSpan,
    SemanticSourceTargetKind as RustDeclarationKind,
)
from rust::incan_semantics_core::body_ir import BodyIrModule, RuntimeCallableBinding
from pub::incan_mir_plan import ExternalFunction, PlanType, source_span
from runtime_calls import layout_runtime_requirements, selected_runtime_requirements


pub def test_undecorated_program_reads_no_binding_state_layouts() -> None:
    """The entry's runtime facade table names `initialize_binding`, but nothing in the program calls it."""
    mut entry = BodyIrModule.declarations_only("main")
    entry.runtime_callable_bindings.append(
        RuntimeCallableBinding(
            path="incan_native_runtime::initialize_binding",
            canonical=RustCanonicalSymbolId.module_declaration(
                ["generic_decorators"],
                "initialize_binding",
                RustDeclarationKind.Function,
                RustHirSourceSpan.new(0, 0),
            ),
        ),
    )
    requirements = layout_runtime_requirements([entry], "main.incn")
    assert len(requirements) == 0, "an undecorated program loaded the generic-decorator binding layouts"

pub def test_planning_requests_the_one_selected_sealed_runtime_path() -> Result[None, str]:
    """Unreached paths do no work. A selected native-only path is queried once and remains external on retry."""
    mut entry = BodyIrModule.declarations_only("main")
    used = "incan_native_runtime::used"
    external = "incan_native_runtime::unpublished"
    span = source_span(file="main.incn", line=1, column=1)
    mut calls: list[ExternalFunction] = []
    for path in [used, used, external, "unrelated::external"]:
        calls.append(ExternalFunction(path=path, parameters=[], return_type=PlanType.Unit, span=span))
    entry.runtime_binding_scopes = [("incan_native_runtime", [])]
    first = selected_runtime_requirements(entry, calls, [])?
    assert [request.path for request in first] == [used, external]
    entry.runtime_binding_scopes = [("incan_native_runtime", [external])]
    retry = selected_runtime_requirements(entry, calls, [])?
    assert len(retry) == 1
    assert retry[0].path == used and retry[0].canonical == None
    return Ok(None)
