"""Lowering reads the runtime's generic-decorator binding state only for a program that declares a decorated binding."""

from rust::incan_semantics_core import (
    CanonicalSymbolId as RustCanonicalSymbolId,
    HirSourceSpan as RustHirSourceSpan,
    SemanticSourceTargetKind as RustDeclarationKind,
)
from rust::incan_semantics_core::body_ir import BodyIrModule, RuntimeCallableBinding
from runtime_calls import layout_runtime_requirements


pub def test_undecorated_program_reads_no_binding_state_layouts() -> None:
    """The entry's runtime facade table names `initialize_binding`, but nothing in the program calls it."""
    mut entry = BodyIrModule.declarations_only("main")
    entry.runtime_callable_bindings.append(
        RuntimeCallableBinding(
            path="incan_native_runtime::initialize_binding",
            canonical=RustCanonicalSymbolId.module_declaration(
                ["generic_decorators"],
                "initialize_binding",
                RustDeclarationKind.Function,
                RustHirSourceSpan.new(0, 0),
            ),
        ),
    )
    requirements = layout_runtime_requirements([entry], "main.incn")
    assert len(requirements) == 0, "an undecorated program loaded the generic-decorator binding layouts"
