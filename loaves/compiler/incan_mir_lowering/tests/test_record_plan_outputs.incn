"""Keyed plan functions are byte-identical to the functions the whole-program plan compiles."""

from std.fs import Path
from pub::internal_models.lowering_events import (
    INTERFACE_REPORT, LoweringRefusal, decode_lowering_event, decode_lowering_refusal, decode_native_interface, encode_lowering_refusal,
)
from std.tempfile import TemporaryDirectory
from pub::internal_models.plan_function_records import decode_plan_function_record
from pub::incan_mir_plan import (
    BasicBlock,
    ModelDeclaration,
    NominalKind,
    Parameter,
    ProductNominal,
    ExternalFunction,
    Function,
    Local,
    Plan,
    PlanType,
    SourceSpan,
    Terminator,
    TerminatorKind,
    source_span,
    product_nominals,
)
from record_plan_codec import decode_record_plan
from record_plan_outputs import publish_plan_records
from scalar_store import record_scalar_inputs, report_scalar, retain_scalar


pub def test_fresh_keyed_plan_retains_the_whole_program_function() -> Result[None, str]:
    """A product captured before unit-level runtime resolution is replaced by the function the unit compiles."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products, report = record_directories(scratch.path())?
    span = source_span(file="keyed_plan.incn", line=4, column=1)
    whole = unit_function("main", span, 1)
    plan = Plan(enums=[], models=[], functions=[whole], externals=[], programs=[], span=span)
    key = retain_product(products, report, unit_function("main", span, 2), false)?
    publish_plan_records(plan, products.0, report.0)?
    assert decode_record_plan(interface_plan(report)?)? == plan
    event = decode_lowering_event(read(report.joinpath(f"{key}.event"))?)?
    retained = read(products.joinpath(f"{key}.incnfunction"))?
    assert event.product == retained
    assert decode_plan_function_record(event.product)?.inputs == record_scalar_inputs("checked-meaning", whole.name, span, false, "reads", 0)
    return Ok(None)


pub def test_reused_keyed_plan_must_equal_whole_program_plan() -> Result[None, str]:
    """A reused product that differs from its whole-plan function refuses, even when the unit publishes no interface."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products, report = record_directories(scratch.path())?
    span = source_span(file="keyed_plan.incn", line=4, column=1)
    plan = Plan(
        enums=[],
        models=[],
        functions=[unit_function("main", span, 1), unit_function("helper", span, 1)],
        externals=[],
        programs=[],
        span=span,
    )
    refusal = LoweringRefusal(identity="helper", function="helper", refusal="checker supplied no complete scalar body witness")
    report.joinpath("helper.refusal").write_bytes(encode_lowering_refusal(refusal)?).map_err((error) => error.message())?
    _key = retain_product(products, report, unit_function("main", span, 2), true)?
    match publish_plan_records(plan, products.0, report.0):
        Ok(_) =>
            assert false, "a reused keyed plan that differs from the whole-program plan was accepted"
        Err(message) =>
            assert "plan-function main differs from the whole-program plan" in message, message
    return Ok(None)


pub def test_keyed_plan_naming_a_model_publishes_its_interface() -> Result[None, str]:
    """A fresh product that names a model by declaration identity finalizes against the whole-program plan."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products, report = record_directories(scratch.path())?
    span = source_span(file="keyed_plan.incn", line=4, column=1)
    point = ModelDeclaration(
        name="Point_0_37",
        public=true,
        fields=[Parameter(name="x", ty=PlanType.Int, span=span)],
        field_public=[true],
        derives=[],
        span=span,
    )
    mut function = unit_function("main", span, 1)
    function.locals.append(Local(ty=PlanType.Model(0, "Point_0_37"), span=span))
    plan = Plan(enums=[], models=[point], functions=[function], externals=[], programs=[], span=span)
    inputs = record_scalar_inputs("checked-meaning", function.name, function.span, false, "reads", 0)
    empty_runtime: list[ExternalFunction] = []
    references = product_nominals(function, empty_runtime)?
    identity = ProductNominal(kind=NominalKind.Model, identity="model:keyed_plan::Point", digest="point-v1")
    retain_scalar(products.0, inputs, function, empty_runtime, [identity])?
    report_scalar(Some(report.0), products.0, inputs, function.name, function.name, false, 0, references)?
    publish_plan_records(plan, products.0, report.0)?
    assert decode_record_plan(interface_plan(report)?)? == plan
    return Ok(None)


pub def test_keyed_plan_carrying_a_frame_refuses_the_interface() -> Result[None, str]:
    """A unit whose keyed product carries a helper frame publishes no interface, and reports why."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products, report = record_directories(scratch.path())?
    span = source_span(file="keyed_plan.incn", line=4, column=1)
    caller = unit_function("main", span, 1)
    frame = unit_function("__incan_closure_main_0", span, 2)
    plan = Plan(enums=[], models=[], functions=[caller, frame], externals=[], programs=[], span=span)
    inputs = record_scalar_inputs("checked-meaning", caller.name, caller.span, false, "reads", 0)
    empty_runtime: list[ExternalFunction] = []
    no_nominals: list[ProductNominal] = []
    no_positions: list[tuple[int, int]] = []
    retain_scalar(products.0, inputs, caller, empty_runtime, no_nominals, no_positions, [frame])?
    report_scalar(Some(report.0), products.0, inputs, caller.name, caller.name, false, 0)?
    publish_plan_records(plan, products.0, report.0)?
    assert not report.joinpath(INTERFACE_REPORT).is_file(), "a unit with a carried frame published an interface"
    mut refused = false
    for path in report.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".refusal") and "helper frame carried" in decode_lowering_refusal(read(path)?)?.refusal:
            refused = true
    assert refused, "an omitted interface carried no lowering refusal"
    return Ok(None)


pub def test_keyed_plan_with_a_generated_runtime_frame_refuses_the_interface() -> Result[None, str]:
    """A unit whose plan gains a runtime frame no product witnesses publishes no interface, and names the frame."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products, report = record_directories(scratch.path())?
    span = source_span(file="keyed_plan.incn", line=4, column=1)
    caller = unit_function("main", span, 1)
    adapter = unit_function("__incan_module_runtime_assert__runtime_frame", span, 2)
    plan = Plan(enums=[], models=[], functions=[caller, adapter], externals=[], programs=[], span=span)
    _ = retain_product(products, report, caller, false)?
    publish_plan_records(plan, products.0, report.0)?
    assert not report.joinpath(INTERFACE_REPORT).is_file(), "an unwitnessed runtime frame published an interface"
    mut refused = false
    for path in report.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".refusal"):
            reason = decode_lowering_refusal(read(path)?)?
            refused = adapter.name == reason.function and "generated function" in reason.refusal
    assert refused, "an omitted interface did not name its unwitnessed generated function"
    return Ok(None)


def record_directories(root: Path) -> Result[tuple[Path, Path], str]:
    """Create one request's product store and report directory with its producer generation."""
    products = root.joinpath("products")
    report = root.joinpath("report")
    products.mkdir(true, true).map_err((error) => error.message())?
    report.mkdir(true, true).map_err((error) => error.message())?
    products
        .joinpath("producer-profile")
        .write_text("keyed-plan-test", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    return Ok((products, report))


def retain_product(products: Path, report: Path, function: Function, reused: bool) -> Result[str, str]:
    """Retain and report one product exactly as ordinary-frame lowering does, returning its key."""
    inputs = record_scalar_inputs("checked-meaning", function.name, function.span, false, "reads", 0)
    empty_runtime: list[ExternalFunction] = []
    retain_scalar(products.0, inputs, function, empty_runtime)?
    report_scalar(Some(report.0), products.0, inputs, function.name, function.name, reused, 0)?
    for path in report.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".event"):
            return Ok(path.name().replace(".event", ""))
    return Err("lowering reported no plan-function event")


def unit_function(name: str, span: SourceSpan, locals: int) -> Function:
    """Build one synchronous unit function whose local count distinguishes two native functions."""
    return Function(
        name=name,
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=span) for _ in range(locals)],
        blocks=[
            BasicBlock(
                statements=[],
                terminator=Terminator(kind=TerminatorKind.Return, span=span),
                cleanup=false,
                span=span,
            ),
        ],
        span=span,
    )


def interface_plan(report: Path) -> Result[str, str]:
    """Read the encoded plan from the published native-interface record."""
    return Ok(decode_native_interface(read(report.joinpath(INTERFACE_REPORT))?)?.plan)


def read(path: Path) -> Result[bytes, str]:
    """Read one complete producer record."""
    return path.read_bytes().map_err((error) => error.message())
