"""A Rust runtime publishes no governed bodies: its generic calls and its async functions stay native externals."""

from rust::std::collections import BTreeMap, BTreeSet
from rust::std::sync import Arc
from rust::incan_semantics_core import CanonicalSymbolId, IncanType as RustType
from rust::incan_semantics_core::body_ir import (
    BodyIrModule,
    StaticDeclaration,
    NominalDeclaration,
    EnumDeclaration as RustEnumDeclaration,
    ValueEnumDeclaration,
    DecoratedBinding,
)
from pub::incan_mir_plan import (
    Callee,
    CalleeKind,
    EnumDeclaration,
    ExternalFunction,
    Function,
    ListLeaf,
    Local,
    PlanType,
    source_span,
)
from body_index import empty_body_index
from native_type_identity import ConstructorIndex
from nominal_instances import NominalInstance
from program_context import DisplayFunction, ProgramContext
from runtime_calls import retain_runtime_instances, runtime_redirects
from type_parameters import Instance


def empty_constructors() -> ConstructorIndex:
    """Build the empty constructor index of a program that declares no nominal."""
    named: BTreeMap[str, list[int]] = BTreeMap.new()
    files: BTreeMap[str, str] = BTreeMap.new()
    versions: BTreeMap[str, str] = BTreeMap.new()
    validated: BTreeSet[CanonicalSymbolId] = BTreeSet.new()
    return ConstructorIndex(
        owners={},
        generic_owners={},
        generic_arities={},
        named=named,
        source_files=files,
        package_versions=versions,
        validated_constructors=validated,
        count=0,
    )


def empty_program_context() -> ProgramContext:
    """Build the immutable empty declaration owner of a program that only calls the runtime."""
    displays: list[DisplayFunction] = []
    statics: list[StaticDeclaration] = []
    comparisons: list[list[str]] = []
    unions: BTreeSet[RustType] = BTreeSet.new()
    nominals: list[NominalDeclaration] = []
    enums: list[RustEnumDeclaration] = []
    value_enums: list[ValueEnumDeclaration] = []
    bindings: list[DecoratedBinding] = []
    return ProgramContext(
        body_indices=empty_body_index(),
        display_functions=Arc.new(displays),
        statics=Arc.new(statics),
        comparison_functions=Arc.new(comparisons),
        union_types=Arc.new(unions),
        nominals=Arc.new(nominals),
        constructors=Arc.new(empty_constructors()),
        enums=Arc.new(enums),
        value_enums=Arc.new(value_enums),
        decorated_bindings=Arc.new(bindings),
    )


pub def test_generic_rust_runtime_call_stays_a_native_instantiated_external() -> Result[None, str]:
    """`append_list[int]` keeps its exact external signature; nothing is redirected to a planned instance."""
    span = source_span(file="main.incn", line=1, column=1)
    path = "incan_native_runtime::append_list"
    external = ExternalFunction(
        path=path,
        type_arguments=[PlanType.Int],
        parameters=[PlanType.ListMutRef(ListLeaf.Int, 1), PlanType.Int],
        return_type=PlanType.Unit,
        span=span,
    )
    constructors = empty_constructors()
    mut program = empty_program_context()
    mut module = BodyIrModule.declarations_only("main")
    templates = BodyIrModule.declarations_only("main")
    mut functions: list[Function] = []
    mut externals = [external.clone()]
    mut instances: list[Instance] = []
    mut intrinsics: list[EnumDeclaration] = []
    mut nominal_instances: list[NominalInstance] = []
    mut unions: list[RustType] = []
    mut redirects = runtime_redirects()
    retain_runtime_instances(
        constructors,
        program,
        module,
        templates,
        functions,
        externals,
        instances,
        intrinsics,
        nominal_instances,
        unions,
        redirects,
    )?
    assert len(externals) == 1 and externals[0] == external, "the native generic runtime call lost its external"
    assert len(redirects.bindings) == 0, "a native generic runtime call was redirected"
    assert len(instances) == 0 and len(redirects.missing) == 0, "a native generic runtime call requested a body"
    return Ok(None)


pub def test_rust_runtime_async_function_stays_the_native_future_callee() -> Result[None, str]:
    """`race_pair`'s boxing shim keeps the native async function as its callee when no coroutine body is published."""
    span = source_span(file="main.incn", line=1, column=1)
    future = PlanType.Future([PlanType.Int])
    types = [PlanType.Int, PlanType.Int, PlanType.Int, future, future]
    callee = Callee(kind=CalleeKind.Instantiated("incan_native_runtime::race_pair", types), span=span)
    shim = Function(
        name="__incan_future_ctor_race_0",
        parameters=[],
        return_type=future,
        locals=[Local(ty=future, span=span)],
        blocks=[],
        span=span,
        future_callee=Some(callee.clone()),
    )
    constructors = empty_constructors()
    mut program = empty_program_context()
    mut module = BodyIrModule.declarations_only("main")
    templates = BodyIrModule.declarations_only("main")
    mut functions = [shim]
    mut externals: list[ExternalFunction] = []
    mut instances: list[Instance] = []
    mut intrinsics: list[EnumDeclaration] = []
    mut nominal_instances: list[NominalInstance] = []
    mut unions: list[RustType] = []
    mut redirects = runtime_redirects()
    retain_runtime_instances(
        constructors,
        program,
        module,
        templates,
        functions,
        externals,
        instances,
        intrinsics,
        nominal_instances,
        unions,
        redirects,
    )?
    assert functions[0].future_callee == Some(callee), "the native runtime future callee was replaced"
    assert len(instances) == 0, "a native runtime future requested a coroutine instance"
    return Ok(None)
