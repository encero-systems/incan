"""A plan product carries the generic instance requests its lowering made, authenticated with its function."""

from pub::incan_mir_plan import encode_instance_request, decode_instance_request
from pub::internal_models.checked_types import CheckedType, CheckedPrimitiveType
from std.fs import Path
from std.tempfile import TemporaryDirectory
from pub::incan_mir_plan import decode_plan_function_record, encode_plan_function_record
from pub::incan_mir_plan import (
    BasicBlock,
    ExternalFunction,
    Function,
    Local,
    PlanType,
    ProductNominal,
    SourceSpan,
    Terminator,
    TerminatorKind,
    source_span,
    unit_nominals,
)
from scalar_store import record_scalar_inputs, retain_scalar, retained_scalar


pub def test_a_caller_product_returns_its_instance_requests() -> Result[None, str]:
    """A reused caller still schedules the instances its lowering requested, in request order."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products = scratch.path().joinpath("products")
    products.mkdir(true, true).map_err((error) => error.message())?
    owner = source_span(file="requests.incn", line=10, column=1)
    function = entry_function("main", owner)
    nodes = [(0, 1), (1, 5)]
    inputs = record_scalar_inputs("checked-meaning", function.name, owner, false, "reads", len(nodes))
    requests = [instance_row(CheckedType.Primitive(CheckedPrimitiveType.Int))?, instance_row(CheckedType.Primitive(CheckedPrimitiveType.Str))?]
    assert requests[0][:4] == b"CRMB"
    declaration, arguments, slots, original = decode_instance_request(requests[0])?
    assert declaration == "generic.pick" and arguments == [CheckedType.Primitive(CheckedPrimitiveType.Int)]
    assert slots == [1, 3] and original
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    no_frames: list[Function] = []
    retain_scalar(products.0, inputs, function, empty_runtime, empty_nominals, nodes, no_frames, requests)?
    no_models: list[ProductNominal] = []
    no_names: list[str] = []
    unit = unit_nominals(no_models, list(no_models), no_names, list(no_names))
    match retained_scalar(products.0, inputs, unit, Some(owner), nodes):
        None => assert false, "a caller product with instance requests was a miss"
        Some(product) =>
            _function, _runtime, _references, _frames, restored = product
            assert restored == requests, "the reused caller lost or reordered its instance requests"
    return Ok(None)


pub def test_a_retained_product_is_a_crumb_row() -> Result[None, str]:
    """The private plan-function record is one Crumb envelope, never a JSON document with an embedded product."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products = scratch.path().joinpath("products")
    products.mkdir(true, true).map_err((error) => error.message())?
    owner = source_span(file="requests.incn", line=10, column=1)
    function = entry_function("main", owner)
    nodes = [(0, 1), (1, 5)]
    inputs = record_scalar_inputs("checked-meaning", function.name, owner, false, "reads", len(nodes))
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    retain_scalar(products.0, inputs, function, empty_runtime, empty_nominals, nodes)?
    encoded = only_product(products)?.read_bytes().map_err((error) => error.message())?
    assert decode_plan_function_record(encoded)?.function[:4] == b"CRMB"
    assert encoded[:4] == b"CRMB", "a retained plan-function product is not a Crumb envelope"
    return Ok(None)


pub def test_an_altered_instance_request_makes_the_product_a_miss() -> Result[None, str]:
    """A product's requests are authenticated with its function, so an edited request is never scheduled."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    products = scratch.path().joinpath("products")
    products.mkdir(true, true).map_err((error) => error.message())?
    owner = source_span(file="requests.incn", line=10, column=1)
    function = entry_function("main", owner)
    nodes = [(0, 1), (1, 5)]
    inputs = record_scalar_inputs("checked-meaning", function.name, owner, false, "reads", len(nodes))
    empty_runtime: list[ExternalFunction] = []
    empty_nominals: list[ProductNominal] = []
    no_frames: list[Function] = []
    retain_scalar(products.0, inputs, function, empty_runtime, empty_nominals, nodes, no_frames, [instance_row(CheckedType.Primitive(CheckedPrimitiveType.Int))?])?
    path = only_product(products)?
    mut record = decode_plan_function_record(path.read_bytes().map_err((error) => error.message())?)?
    record.requests = [instance_row(CheckedType.Primitive(CheckedPrimitiveType.Str))?]
    path.write_bytes(encode_plan_function_record(record)?).map_err((error) => error.message())?
    no_models: list[ProductNominal] = []
    no_names: list[str] = []
    unit = unit_nominals(no_models, list(no_models), no_names, list(no_names))
    assert retained_scalar(products.0, inputs, unit, Some(owner), nodes) is None, "an edited request was trusted"
    return Ok(None)


def entry_function(name: str, owner: SourceSpan) -> Function:
    """A unit function whose block and return sit on the owner's first two body lines."""
    block_span = source_span(file="requests.incn", line=11, column=5)
    exit_span = source_span(file="requests.incn", line=11, column=5)
    return Function(
        name=name,
        parameters=[],
        return_type=PlanType.Unit,
        locals=[Local(ty=PlanType.Unit, span=owner)],
        blocks=[
            BasicBlock(
                statements=[],
                terminator=Terminator(kind=TerminatorKind.Return, span=exit_span),
                cleanup=false,
                span=block_span,
            ),
        ],
        span=owner,
    )


def only_product(products: Path) -> Result[Path, str]:
    """Name the single retained product record."""
    for path in products.iterdir().map_err((error) => error.message())?:
        if path.name().endswith(".incnfunction"):
            return Ok(path)
    return Err("no plan product was retained")


def instance_row(argument: CheckedType) -> Result[bytes, str]:
    return encode_instance_request("generic.pick", [argument], [1, 3], true)
