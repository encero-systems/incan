pub def test_native_body_positions_keep_nested_order_and_utf8_offsets() -> Result[None, str]:
    """Child statement spans precede their owners; identity metadata contributes no positional nodes."""
    mut body = empty_body("walk")
    file = "src/main.incn"
    child = CompilerStatement(kind=CompilerStatementKind.Continue, span=HirSourceSpan(file=file, start=7, end=8))
    block = CompilerBlock(scope=0, statements=[child])
    body.block.statements = [CompilerStatement(kind=CompilerStatementKind.Loop(block), span=HirSourceSpan(file=file, start=3, end=9))]
    owner = source_span(file=file, line=1, column=1)
    assert body_position_map(native_body(body)?, "é\nabcdx\n", file, owner) == [(1, 5), (1, 1), (0, 1)]
    return Ok(None)


pub def test_body_record_round_trip_preserves_shared_identities_and_statements() -> Result[None, str]:
    """Round-trip an independent named-identity map and recursive statements without depending on Arc identity."""
    mut body = empty_body("render")
    body.block.statements = [
        CompilerStatement(
            kind=CompilerStatementKind.Unsupported("adapter sentinel"),
            span=HirSourceSpan(file="src/main.incn", start=2, end=4),
        ),
        CompilerStatement(kind=CompilerStatementKind.Continue, span=HirSourceSpan(file="src/main.incn", start=5, end=6)),
    ]
    native = native_body(body)?
    authored = authored_body(native, provenance())?
    assert len(authored.named_type_identities) == 1
    assert authored.named_type_identities[0].name == "Packet"
    assert authored.named_type_identities[0].identity.declaration_span.file == "src/main.incn"
    assert len(authored.block.statements) == 2
    match authored.block.statements[0].kind:
        CompilerStatementKind.Unsupported(description) =>
            assert description == "adapter sentinel"
        _ =>
            assert false
    return Ok(None)


pub def test_body_record_round_trip_keeps_async_and_refuses_tombstone() -> Result[None, str]:
    """Retain stored async state and reject the retired positional payload before native reconstruction."""
    mut body = empty_body("fetch")
    body.is_async = true
    native = native_body(body.clone())?
    authored = authored_body(native, provenance())?
    assert authored.is_async
    body.retired_rust_facade_wire = Some(("provider", "method"))
    assert native_body(body).is_err()
    return Ok(None)


pub def test_nominal_and_callable_adapters_keep_witnesses_defaults_and_frame() -> Result[None, str]:
    """Round-trip adoption and validation witnesses, defaults, owned slots and an authenticated callable frame."""
    owner = identity("Packet", DeclarationKind.Model)
    method = identity("render", DeclarationKind.Function)
    mut frame = empty_body("render")
    frame.canonical = Some(method.clone())
    adoption = CompilerTraitAdoption(
        adopter=owner.clone(),
        trait_identity=identity("Readable", DeclarationKind.Trait),
        arguments=[],
        methods=Some([]),
        fields=[
            TraitFieldWitness(
                requirement=identity("value", DeclarationKind.Field),
                implementation=identity("payload", DeclarationKind.Field),
            ),
        ],
        primitive_adapter=None,
    )
    nominal = CompilerNominalDeclaration(
        trait_adoptions=[adoption],
        native_item="",
        class_inheritance=None,
        native_type_arguments=[],
        direct_declaration_id=CompilerNodeId.declaration_span("app", 0, 10),
        canonical=owner,
        name="Packet",
        fields=["payload"],
        field_identities=[identity("payload", DeclarationKind.Field)],
        field_types=[CheckedType.Primitive(CheckedPrimitiveType.Int)],
        owned_callable_fields=[0],
        field_public=[false],
        field_aliases=[None],
        reflection_fields=None,
        reflection_metadata=None,
        comparison_equality=None,
        public=false,
        has_field_defaults=true,
        field_default_body=[empty_body("field_default")],
        validated_constructor=Some(
            CompilerValidatedConstructor(
                constructor=identity("new", DeclarationKind.Method),
                validator=identity("validate", DeclarationKind.Method),
                required_fields=[0],
            ),
        ),
        method_partial_defaults=[],
        display_method=None,
        newtype_deserialize=NewtypeDeserialize.Unselected,
        newtype_string_conversion=NewtypeStringConversion.Unselected,
        derives=[],
        named_type_identities=[],
        type_parameters=[],
        type_parameter_count=0,
        record_package_identity=None,
    )
    callable = CompilerLoafCallable(
        canonical=method,
        item="packet::render",
        parameters=[],
        return_type=CheckedType.Primitive(CheckedPrimitiveType.Unit),
        type_parameters=[],
        native_type_arguments=[],
        native_callable_parameters=[],
        parameter_defaults=[],
        declaration_frame=[frame],
    )
    mut module = empty_module()
    module.nominal_declarations = [nominal]
    module.loaf_callables = [callable]
    native = native_body_ir_module(module)?
    authored = authored_body_ir_module(native, provenance())?
    assert len(authored.nominal_declarations[0].trait_adoptions[0].fields) == 1
    assert len(authored.nominal_declarations[0].field_default_body) == 1
    assert authored.nominal_declarations[0].owned_callable_fields == [0]
    match authored.nominal_declarations[0].validated_constructor:
        Some(contract) =>
            assert contract.constructor.declaration_name == "new"
            assert contract.validator.declaration_name == "validate"
            assert contract.required_fields == [0]
        None => assert false
    assert len(authored.loaf_callables[0].declaration_frame) == 1
    return Ok(None)


pub def test_module_adapter_keeps_invocation_selections_explicit() -> Result[None, str]:
    """Round-trip a selected main as invocation data instead of deriving it from every dependency declaration."""
    mut module = empty_module()
    module.program_entrypoints = [identity("main", DeclarationKind.Function)]
    native = native_body_ir_module(module)?
    authored = authored_body_ir_module(native, provenance())?
    assert len(authored.program_entrypoints) == 1
    assert authored.program_entrypoints[0].declaration_name == "main"
    return Ok(None)


pub def test_model_type_selects_exact_imported_carrier_and_legacy_name() -> Result[None, str]:
    """Resolve an imported carrier by its authenticated owner while preserving unique legacy source-name lookup."""
    owner = imported_identity("CanonicalSymbolId")
    carrier = carrier_key(owner)?
    target = nominal(
        owner.clone(),
        "CanonicalSymbolId",
        [NamedTypeIdentity(name=carrier.clone(), identity=owner.clone())],
    )
    decoy_owner = identity("Shadow", DeclarationKind.Model)
    decoy = nominal(
        decoy_owner.clone(),
        carrier.clone(),
        [NamedTypeIdentity(name=carrier.clone(), identity=decoy_owner)],
    )
    before = native_nominals([decoy.clone(), target.clone()])?
    before_index = constructor_index(before)
    assert model_type(before_index, before, RustType.Named(carrier.clone()))? == PlanType.Model(
        1,
        model_symbol("CanonicalSymbolId"),
    )
    after = native_nominals([target.clone(), decoy])?
    after_index = constructor_index(after)
    assert model_type(after_index, after, RustType.Named(carrier))? == PlanType.Model(
        0,
        model_symbol("CanonicalSymbolId"),
    )

    legacy_owner = identity("LegacyPacket", DeclarationKind.Model)
    legacy = native_nominals([nominal(legacy_owner, "LegacyPacket", [])])?
    legacy_index = constructor_index(legacy)
    assert model_type(legacy_index, legacy, RustType.Named("LegacyPacket"))? == PlanType.Model(
        0,
        model_symbol("LegacyPacket"),
    )
    return Ok(None)


pub def test_stored_layout_identity_follows_nested_arguments_across_a_source_move() -> Result[None, str]:
    """Nested specializations survive a rebound source carrier; meaningful changes to arguments or fields still miss."""
    owner = identity("Wrapper", DeclarationKind.Model)
    first = imported_identity("Packet")
    mut second = imported_identity("Packet")
    second.declaration_span = HirSourceSpan(file="src/moved.incn", start=27, end=44)
    mut before = nominal(owner.clone(), "generated_before", [NamedTypeIdentity(name=carrier_key(first)?, identity=first.clone())])
    mut after = nominal(owner, "generated_after", [NamedTypeIdentity(name=carrier_key(second)?, identity=second.clone())])
    before.native_type_arguments = [CheckedType.Generic("Option", [CheckedType.Named(carrier_key(first)?)])]
    after.native_type_arguments = [CheckedType.Generic("Option", [CheckedType.Named(carrier_key(second)?)])]
    after.direct_declaration_id = CompilerNodeId.declaration_span("app", 27, 44)
    previous = model_layout_witness(native_nominal_declaration(before)?).map_err((error) => str(error))?
    same = model_layout_witness(native_nominal_declaration(after)?).map_err((error) => str(error))?
    assert previous == same
    after.derives = ["Clone"]
    changed = model_layout_witness(native_nominal_declaration(after)?).map_err((error) => str(error))?
    assert changed.0 == same.0 and changed.1 != same.1
    after.native_type_arguments = [CheckedType.Generic("Option", [CheckedType.Primitive(CheckedPrimitiveType.Str)])]
    next_instance = model_layout_witness(native_nominal_declaration(after)?).map_err((error) => str(error))?
    assert next_instance.0 != same.0
    return Ok(None)


pub def test_native_enum_layout_authenticates_its_variant_payload() -> Result[None, str]:
    """A changed variant payload changes the version of the same closed enum specialization."""
    no_parameters: list[str] = []
    payloads: list[tuple[str, list[RustType]]] = [("Some", [RustType.Named("X")])]
    changed: list[tuple[str, list[RustType]]] = [("Some", [RustType.Named("Y")])]
    before = match native_enum_declaration("std::option::Option", no_parameters, payloads):
        Some(value) => value
        None => return Err("native enum fixture could not be constructed")
    after = match native_enum_declaration("std::option::Option", no_parameters, changed):
        Some(value) => value
        None => return Err("changed native enum fixture could not be constructed")
    a = enum_layout_witness(before).map_err((error) => str(error))?
    b = enum_layout_witness(after).map_err((error) => str(error))?
    assert a.0 == b.0 and a.1 != b.1
    return Ok(None)


pub def test_model_type_refuses_unauthenticated_or_ambiguous_nominal_owners() -> Result[None, str]:
    """Refuse carrier aliases without one closed self-bound owner and legacy spellings with multiple declarations."""
    owner = imported_identity("CanonicalSymbolId")
    carrier = carrier_key(owner)?
    missing = native_nominals([nominal(owner.clone(), "CanonicalSymbolId", [])])?
    missing_index = constructor_index(missing)
    assert model_type(missing_index, missing, RustType.Named(carrier.clone())).is_err()

    foreign = imported_identity("ForeignCanonicalSymbolId")
    foreign_binding = native_nominals(
        [nominal(
            owner.clone(),
            "CanonicalSymbolId",
            [NamedTypeIdentity(name=carrier.clone(), identity=foreign.clone())],
        )],
    )?
    foreign_index = constructor_index(foreign_binding)
    assert model_type(foreign_index, foreign_binding, RustType.Named(carrier.clone())).is_err()

    absent: list[RustNominalDeclaration] = []
    absent_index = constructor_index(absent)
    assert model_type(absent_index, absent, RustType.Named(carrier.clone())).is_err()

    decoy_owner = identity("Shadow", DeclarationKind.Model)
    no_owner = native_nominals(
        [nominal(
            decoy_owner.clone(),
            carrier.clone(),
            [NamedTypeIdentity(name=carrier.clone(), identity=decoy_owner)],
        )],
    )?
    no_owner_index = constructor_index(no_owner)
    assert model_type(no_owner_index, no_owner, RustType.Named(carrier.clone())).is_err()

    mut open = nominal(
        owner.clone(),
        "CanonicalSymbolId",
        [NamedTypeIdentity(name=carrier.clone(), identity=owner.clone())],
    )
    open.type_parameters = ["T"]
    open.type_parameter_count = 1
    open_declarations = native_nominals([open])?
    open_index = constructor_index(open_declarations)
    assert model_type(open_index, open_declarations, RustType.Named(carrier.clone())).is_err()

    authenticated = nominal(
        owner.clone(),
        "CanonicalSymbolId",
        [NamedTypeIdentity(name=carrier.clone(), identity=owner.clone())],
    )
    duplicate = native_nominals([authenticated.clone(), authenticated.clone()])?
    duplicate_index = constructor_index(duplicate)
    assert model_type(duplicate_index, duplicate, RustType.Named(carrier.clone())).is_err()

    unbound_duplicate = nominal(owner.clone(), "CanonicalSymbolId", [])
    for mixed in [
        [authenticated.clone(), unbound_duplicate.clone()],
        [unbound_duplicate, authenticated],
    ]:
        mixed_declarations = native_nominals(mixed)?
        mixed_index = constructor_index(mixed_declarations)
        assert model_type(mixed_index, mixed_declarations, RustType.Named(carrier.clone())).is_err()

    foreign_carrier = carrier_key(foreign)?
    wrong_carrier = native_nominals(
        [nominal(
            owner,
            "CanonicalSymbolId",
            [NamedTypeIdentity(name=foreign_carrier.clone(), identity=foreign)],
        )],
    )?
    wrong_index = constructor_index(wrong_carrier)
    assert model_type(wrong_index, wrong_carrier, RustType.Named(foreign_carrier)).is_err()

    legacy_duplicate = native_nominals(
        [
            nominal(identity("LegacyPacket", DeclarationKind.Model), "LegacyPacket", []),
            nominal(identity("OtherLegacyPacket", DeclarationKind.Model), "LegacyPacket", []),
        ],
    )?
    legacy_duplicate_index = constructor_index(legacy_duplicate)
    assert model_type(legacy_duplicate_index, legacy_duplicate, RustType.Named("LegacyPacket")).is_err()
    return Ok(None)


pub def test_nested_option_list_retains_exact_imported_model_carrier() -> Result[None, str]:
    """Retain Option[List[model]] only through the same exact imported carrier authority used by scalar layouts."""
    owner = imported_identity("CanonicalSymbolId")
    carrier = carrier_key(owner)?
    target = nominal(
        owner.clone(),
        "CanonicalSymbolId",
        [NamedTypeIdentity(name=carrier.clone(), identity=owner.clone())],
    )
    mut authored = empty_module()
    authored.nominal_declarations = [target]
    constructors = constructor_index(native_nominals(authored.nominal_declarations.clone())?)
    native = native_body_ir_module(authored)?
    mut intrinsics: list[PlanEnumDeclaration] = []
    ty = generic("Option", [generic("List", [RustType.Named(carrier.clone())])])
    retain_carrier(constructors, native, intrinsics, ty, "src/main.incn")?
    assert len(intrinsics) == 1
    assert intrinsics[0].carrier == Carrier.Option
    assert intrinsics[0].variants[0].fields == []
    assert intrinsics[0].variants[1].fields == [
        PlanType.List(ListLeaf.Model(0, model_symbol("CanonicalSymbolId")), 1),
    ]

    mut rejected_authored = empty_module()
    rejected_authored.nominal_declarations = [nominal(owner, "CanonicalSymbolId", [])]
    rejected_index = constructor_index(native_nominals(rejected_authored.nominal_declarations.clone())?)
    rejected = native_body_ir_module(rejected_authored)?
    mut rejected_intrinsics: list[PlanEnumDeclaration] = []
    assert retain_carrier(rejected_index, rejected, rejected_intrinsics, ty, "src/main.incn").is_err()
    assert len(rejected_intrinsics) == 0
    return Ok(None)


def empty_body(name: str) -> CompilerBody:
    """Build one complete scalar Body for reversible adapter controls."""
    return CompilerBody(
        nominal_instantiation=[],
        trait_default_instantiation=None,
        type_parameters=[],
        declaration_id=CompilerNodeId.declaration("app", name),
        direct_call_id=CompilerNodeId.declaration_span("app", 0, 10),
        canonical=Some(identity(name, DeclarationKind.Function)),
        name=str(name),
        span=HirSourceSpan(file="src/main.incn", start=0, end=10),
        return_type=CheckedType.Primitive(CheckedPrimitiveType.Unit),
        callable_representation=None,
        checked_input_profile=None,
        explicit_input_bindings=[],
        returned_view=None,
        named_type_identities=[NamedTypeIdentity(name="Packet", identity=identity("Packet", DeclarationKind.Model))],
        locals=[],
        params=[],
        param_locals=[],
        scopes=[],
        block=CompilerBlock(scope=0, statements=[]),
        runtime_requirements=[],
        panic_facts=[],
        is_async=false,
        retired_rust_facade_wire=None,
        native_attributes=[],
    )


def empty_module() -> CompilerBodyIrModule:
    """Build one complete module record without declarations or invocation selection."""
    return CompilerBodyIrModule(
        runtime_callable_bindings=[],
        decorated_bindings=[],
        entrypoint_effects=[],
        program_entrypoints=[],
        string_conversion_contract=StringConversionContract.Unselected,
        constant_declarations=[],
        type_alias_declarations=[],
        enum_declarations=[],
        loaf_callables=[],
        native_union_declarations=[],
        static_declarations=[],
        module_id=CompilerNodeId.module("app"),
        nominal_declarations=[],
        fieldless_enum_declarations=[],
        value_enum_declarations=[],
        trait_declarations=[],
        trait_implementations=[],
        bodies=[],
    )


def provenance() -> BodyIrRecordProvenance:
    """Bind the sample module to its exact source file and an empty package selection."""
    mut files: BTreeMap[str, str] = BTreeMap.new()
    files.insert("app", "src/main.incn")
    return BodyIrRecordProvenance(
        fallback_source_file="src/main.incn",
        source_files=files,
        package_versions=BTreeMap.new(),
    )


def identity(name: str, kind: DeclarationKind) -> CanonicalSymbolId:
    """Build one authored module declaration identity with complete source provenance."""
    return CanonicalSymbolId(
        namespace=SymbolNamespace.OrdinaryLexical,
        origin=SymbolOrigin.Module(["app"]),
        declaration_name=str(name),
        kind=kind,
        scope_discriminant=None,
        declaration_span=HirSourceSpan(file="src/main.incn", start=0, end=10),
    )


def imported_identity(name: str) -> CanonicalSymbolId:
    """Build one package-owned model identity whose carrier key differs from its source declaration name."""
    return CanonicalSymbolId(
        namespace=SymbolNamespace.OrdinaryLexical,
        origin=SymbolOrigin.Package(
            PackageIdentity(name="internal_models", version="0.6.0-dev.9"),
            ["compiler_records"],
        ),
        declaration_name=str(name),
        kind=DeclarationKind.Model,
        scope_discriminant=None,
        declaration_span=HirSourceSpan(file="registry/internal_models/compiler_records.incn", start=0, end=10),
    )


def carrier_key(owner: &CanonicalSymbolId) -> Result[str, str]:
    """Read the exact native carrier spelling for one valid authored source identity."""
    native = native_canonical_symbol_id(owner)?
    match nominal_carrier_key(native):
        Some(key) => return Ok(str(key))
        None => return Err("test identity has no nominal carrier key")


def native_nominals(declarations: list[CompilerNominalDeclaration]) -> Result[list[RustNominalDeclaration], str]:
    """Restore one authored nominal inventory without adding unselected declaration authority."""
    mut native: list[RustNominalDeclaration] = []
    for declaration in declarations:
        native.append(native_nominal_declaration(declaration)?)
    return Ok(native)


def nominal(
    owner: CanonicalSymbolId,
    name: str,
    identities: list[NamedTypeIdentity],
) -> CompilerNominalDeclaration:
    """Build one complete fieldless source model while exposing only the identity facts varied by each control."""
    return CompilerNominalDeclaration(
        trait_adoptions=[],
        native_item="",
        class_inheritance=None,
        native_type_arguments=[],
        direct_declaration_id=CompilerNodeId.declaration_span("app", 0, 10),
        canonical=owner,
        name=str(name),
        fields=[],
        field_identities=[],
        field_types=[],
        owned_callable_fields=[],
        field_public=[],
        field_aliases=[],
        reflection_fields=None,
        reflection_metadata=None,
        comparison_equality=None,
        public=false,
        has_field_defaults=false,
        field_default_body=[],
        validated_constructor=None,
        method_partial_defaults=[],
        display_method=None,
        newtype_deserialize=NewtypeDeserialize.Unselected,
        newtype_string_conversion=NewtypeStringConversion.Unselected,
        derives=[],
        named_type_identities=identities,
        type_parameters=[],
        type_parameter_count=0,
        record_package_identity=None,
    )
