"""Concrete f32 display preserves its width, fractional digits, and signed zero."""


def show(value: f32) -> None:
    """Exercise the three concrete scalar display boundaries without conversion."""
    println(value)
    println(str(value))
    println(f"{value}")


def main() -> None:
    """Print integral, fractional, rounded, small, and large exact f32 values."""
    whole: f32 = -1.0
    zero: f32 = 0.0
    negative_zero: f32 = -0.0
    fraction: f32 = 1.25
    rounded: f32 = 1.23456789
    small: f32 = 0.0000001
    large: f32 = 10000000000.0
    show(whole)
    show(zero)
    show(negative_zero)
    show(fraction)
    show(rounded)
    show(small)
    show(large)
