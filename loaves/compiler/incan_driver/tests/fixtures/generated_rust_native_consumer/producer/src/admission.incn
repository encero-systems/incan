pub model AllPublic:
  """Expose a fully public model as the native-construction control."""
  pub value: int


pub def make_all_public(value: int) -> AllPublic:
  """Construct the all-public control through ordinary Incan code."""
  return AllPublic(value=value)


pub model Admission:
  """Keep a required admission flag private while exposing a safe factory."""
  _allowed: bool

  @staticmethod
  def admitted() -> Admission:
    """Create an admitted value without exposing its private constructor input."""
    return Admission(_allowed=true)

  pub property allowed -> bool:
    """Return the private admission decision through a public projection."""
    return self._allowed


pub model Mixed:
  """Combine one public field with one required private field."""
  pub label: str
  _allowed: bool

  @staticmethod
  def sample() -> Mixed:
    """Create the mixed-visibility model through its public factory."""
    return Mixed(label="mixed", _allowed=true)

  pub property allowed -> bool:
    """Return the private flag through a public projection."""
    return self._allowed


class PrivateToken:
  """Represent a provider-private nominal value."""
  pub code: int


pub model PrivateTypeModel:
  """Keep a private nominal type out of the generated public constructor surface."""
  _token: PrivateToken

  @staticmethod
  def locked() -> PrivateTypeModel:
    """Create the value without leaking its private token type."""
    return PrivateTypeModel(_token=PrivateToken(code=7))

  pub property code -> int:
    """Project the token code through the public model API."""
    return self._token.code


pub model Defaulted:
  """Keep a default-backed private field provider-owned while accepting public native input."""
  _allowed: bool = true
  pub label: str

  pub property allowed -> bool:
    """Return the provider-owned default through a public projection."""
    return self._allowed
