incan_std_core::__incan_stdlib_version_check!("<INCAN_STDLIB_VERSION>");
fn has_manifest(files: std::collections::HashMap<String, String>) -> bool {
    return files.contains_key(<_ as AsRef<str>>::as_ref(&"loaf.toml"));
}
fn has_id(counts: &mut std::collections::HashMap<i64, i64>, id: i64) -> bool {
    return counts.contains_key(&id);
}
