incan_std_core::__incan_stdlib_version_check!("<INCAN_STDLIB_VERSION>");
fn match_index(xs: Vec<String>, y: i64) -> i64 {
    let mut idx = 0;
    while idx < ::std::convert::identity(xs.len() as i64) {
        if incan_std_core::strings::str_len(
            &(incan_std_core::collections::list_get(&xs, (idx) as i64).clone()),
        ) == y
        {
            return idx;
        }
        idx = idx + 1;
    }
    return -1;
}
fn helper_loop(xs: Vec<String>, ys: Vec<i64>) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::<i64>::new();
    for y in ys.iter().copied() {
        let _ = out.push(match_index(xs.clone(), y));
    }
    return out;
}
fn helper_list(xs: Vec<String>, ys: Vec<i64>) -> Vec<i64> {
    return (ys).iter().copied().map(|y| match_index(xs.clone(), y)).collect::<Vec<_>>();
}
fn main() {
    std::panic::set_hook(
        std::boxed::Box::new(|panic_info| {
            if let Some(message) = panic_info.payload().downcast_ref::<&str>() {
