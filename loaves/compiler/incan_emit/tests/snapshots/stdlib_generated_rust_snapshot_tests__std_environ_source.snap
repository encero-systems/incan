                        {
                            let __parts: [&str; 2usize] = [
                                "argument ",
                                " cannot be represented as Unicode text",
                            ];
                            let __args: Vec<String> = vec![format!("{}", position)];
                            incan_std_core::strings::fstring(&__parts, &__args)
                        },
                    ),
                );
            }
        };
    }
    return Ok::<Vec<String>, EnvironError>(out);
