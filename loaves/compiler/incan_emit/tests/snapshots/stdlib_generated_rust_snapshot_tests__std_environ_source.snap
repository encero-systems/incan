///     ```ignore
///     arguments = args()?
///     if len(arguments) < 2:
///         println("usage: tool <command>")
///     ```
pub fn args() -> Result<
    Vec<String>,
    EnvironError,
> {
    let _ = "\n    Return the current process argument vector.\n\n    The program name comes first, exactly as the host supplied it, followed by each argument in order. Slice from\n    index 1 to skip the program name.\n\n    Every entry is Unicode text. Like `get()`, this function never converts a non-Unicode host value silently: the\n    first argument that is not valid Unicode is reported as a `NotUnicode` error whose key names its position\n    (`argv[2]`), and the observed bytes never appear in the error.\n\n    Returns:\n        `Ok(arguments)` with the program name followed by the process arguments, each as a `str`, or\n        `Err(EnvironError)` with kind `NotUnicode` when an argument cannot be represented as text.\n\n    Example:\n        Treat the first argument as a subcommand:\n\n        ```incan\n        arguments = args()?\n        if len(arguments) < 2:\n            println(\"usage: tool <command>\")\n        ```\n    ";
    let mut out: Vec<String> = Vec::<String>::new();
    for argument in args_os() {
        let _ = match argument.into_string() {
            Ok(text) => out.push(text.clone()),
            Err(_) => {
                let position = ::std::convert::identity(out.len() as i64);
