        }
        _ => {
            let _ = ();
        }
    };
    return EnvironError::from_kind(
        EnvironErrorKind::Other.clone(),
        key.to_string(),
        {
            let __parts: [&str; 2usize] = [
                "environment variable `",
                "` could not be read",
            ];
            let __args: Vec<String> = vec![format!("{}", key)];
            incan_std_core::strings::fstring(&__parts, &__args)
        },
    );
}
