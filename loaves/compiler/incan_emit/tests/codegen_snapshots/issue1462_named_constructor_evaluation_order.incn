"""Issue #1462: named constructor arguments evaluate in written order, then fill declared fields."""

model Evidence:
    source: str

model Document:
    evidence: Evidence
    intent: str

def inspect(source: str) -> str:
    return source

def main() -> None:
    source = "manifest"
    result = Document(intent=inspect(source), evidence=Evidence(source=source))
    println(result.intent)
