def names(d: Dict[str, int]) -> list[str]:
    return sorted(d.keys())


def has(d: Dict[str, int], key: str) -> bool:
    return key in d.keys()


def count_keys(d: Dict[str, int]) -> int:
    keys = d.keys()
    return len(keys)


def total(d: Dict[str, int]) -> int:
    mut sum = 0
    for value in d.values():
        sum += value
    return sum


def collect_keys(d: Dict[str, int]) -> list[str]:
    mut out: list[str] = []
    for key in d.keys():
        out.append(key)
    return out


def doubled(d: Dict[str, int]) -> list[int]:
    return sorted([value * 2 for value in d.values()])


def ordered_values(d: Dict[str, int]) -> list[int]:
    return sorted(d.values())


def main() -> None:
    mut d: Dict[str, int] = {}
    d["b"] = 2
    d["a"] = 1
    println(names(d))
    println(has(d, "a"))
    println(count_keys(d))
    println(total(d))
    println(len(collect_keys(d)))
    println(doubled(d))
    println(ordered_values(d))
