"""Issue #1116: module bindings shadow ambient builtins, with an explicit builtin escape hatch."""


def len(value: int) -> int:
    """Return a source-defined length-like value."""
    return value + 1


def main() -> None:
    """Exercise both the shadowed and explicit builtin calls."""
    println(len(4))
    println(std.builtins.len([10, 20, 30]))
