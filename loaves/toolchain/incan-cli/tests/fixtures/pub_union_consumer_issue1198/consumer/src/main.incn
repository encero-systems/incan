"""Consumer regression for #1198's public nested-union payload ordering."""

from pub::issue1198_union_provider import Frame, always_true, frame

@derive(Clone)
model Order:
  """Represent the minimal row consumed through the provider's Frame API."""
  id: int

def main() -> None:
  """Build the nested provider expression whose emitted variant must be canonical."""
  orders: Frame[Order] = frame()
  transformed = orders.filter(always_true()).limit(1)
