"""
Public projection-expression models for #1198's provider/consumer ordering regression.

`ColumnExpr` nests `UntypedColumnExpr`, so consumers must lower each payload using
the provider's flattened canonical union ordering.
"""

@derive(Clone)
pub model ColumnRefExpr:
  """Refer to one named input column."""
  pub column_name: str

@derive(Clone)
pub model IntLiteralExpr:
  """Carry an integer literal payload."""
  pub value: int

@derive(Clone)
pub model FloatLiteralExpr:
  """Carry a floating-point literal payload."""
  pub value: float

@derive(Clone)
pub model StringLiteralExpr:
  """Carry a text literal payload."""
  pub value: str

@derive(Clone)
pub model BoolLiteralExpr:
  """Carry a boolean literal payload."""
  pub value: bool

@derive(Clone)
pub model ScalarFunctionOption:
  """Name one scalar-function option supplied alongside its arguments."""
  pub name: str
  pub value: str

@derive(Clone)
pub model ScalarFunctionApplicationExpr:
  """Describe a scalar function with expression arguments and named options."""
  pub function_ref: str
  pub canonical_name: str
  pub arguments: list[ColumnExpr]
  pub options: list[ScalarFunctionOption]

# The inner union contributes the first six provider-owned payload positions.
pub type UntypedColumnExpr = Union[ColumnRefExpr, IntLiteralExpr, FloatLiteralExpr, StringLiteralExpr, BoolLiteralExpr, ScalarFunctionApplicationExpr]

@derive(Clone)
pub model BoolColumnExpr:
  """Wrap an untyped expression as a boolean column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model IntColumnExpr:
  """Wrap an untyped expression as an integer column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model FloatColumnExpr:
  """Wrap an untyped expression as a floating-point column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model NumberColumnExpr:
  """Wrap an untyped expression as a generic numeric column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model StringColumnExpr:
  """Wrap an untyped expression as a text column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model TimestampColumnExpr:
  """Wrap an untyped expression as a timestamp column expression."""
  pub expr: UntypedColumnExpr

@derive(Clone)
pub model TemporalColumnExpr:
  """Wrap an untyped expression as a temporal column expression."""
  pub expr: UntypedColumnExpr

# This outer union preserves the inner payload positions before wrapper variants.
pub type ColumnExpr = Union[UntypedColumnExpr, BoolColumnExpr, IntColumnExpr, FloatColumnExpr, NumberColumnExpr, StringColumnExpr, TimestampColumnExpr, TemporalColumnExpr]

@derive(Clone)
pub model ProjectionAssignment:
  """Associate one output name with a provider-owned column expression."""
  pub output_name: str
  pub expr: ColumnExpr

pub def bool_expr(value: bool) -> BoolLiteralExpr:
  """Construct the boolean-literal member of the public projection union."""
  return BoolLiteralExpr(value=value)
