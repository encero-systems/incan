"""Minimal public dataset API that accepts the provider's nested projection union."""

from projection_builders import ColumnExpr

@derive(Clone)
pub class Frame[T with Clone]:
  """Represent a typed collection with a projection-expression filter surface."""
  pub rows: list[T]

  def filter(self, predicate: ColumnExpr) -> Self:
    """Accept a provider-owned projection expression and preserve this frame."""
    return self

  def limit(self, count: int) -> Self:
    """Preserve this frame after accepting a row-limit value for the call chain."""
    return self

pub def frame[T with Clone]() -> Frame[T]:
  """Create an empty typed frame for the public-consumer regression."""
  return Frame(rows=[])
