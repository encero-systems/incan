"""Application-facing string adapters for primitive advisory file locks."""

pub from std.primitives.fs.locking import FileLock
from std.primitives.fs.locking import (
    exclusive as primitive_exclusive,
    shared as primitive_shared,
    try_exclusive as primitive_try_exclusive,
    try_shared as primitive_try_shared,
)
from std.primitives.fs.path import PrimitivePath


pub def shared(path: str) -> Result[FileLock, str]:
    """Acquire a blocking shared advisory lock for `path`."""
    return primitive_shared(PrimitivePath(value=path))


pub def exclusive(path: str) -> Result[FileLock, str]:
    """Acquire a blocking exclusive advisory lock for `path`."""
    return primitive_exclusive(PrimitivePath(value=path))


pub def try_shared(path: str) -> Result[Option[FileLock], str]:
    """Try to acquire a shared advisory lock without blocking."""
    return primitive_try_shared(PrimitivePath(value=path))


pub def try_exclusive(path: str) -> Result[Option[FileLock], str]:
    """Try to acquire an exclusive advisory lock without blocking."""
    return primitive_try_exclusive(PrimitivePath(value=path))
