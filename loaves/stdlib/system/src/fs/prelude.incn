"""
Path-centric filesystem APIs.

Use `Path` for lexical path manipulation and filesystem operations. Whole-file helpers are convenient for small
payloads; `File` handles returned by `Path.open()` and `OpenOptions.open()` support bounded reads, writes, seeking,
flushing, and durability requests.

Operations that can fail return `Result[..., IoError]` with normalized error kinds and optional path context.

Example:

```incan
from std.fs import Path

root = Path("build")
root.mkdir(parents=true, exist_ok=true)?
artifact = root / "output.txt"
artifact.write_text("ready\n", encoding="utf-8", errors="strict", newline=None)?
println(artifact.read_text(encoding="utf-8", errors="strict")?)
```
"""

pub from crate.fs.path import Path
pub from crate.fs.file import File, OpenFileMode, OpenOptions
pub from crate.fs.locking import FileLock
pub from crate.fs.mapping import MappedFile, MappedView
pub from crate.fs.metadata import DirEntry, PathStat, DiskUsage
pub from std.io import IoError
