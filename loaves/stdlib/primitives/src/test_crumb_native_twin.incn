"""Byte-identical checks between native Crumb framing and its retained Incan twin."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.errors import CrumbError
from crate.primitives.crumb.framing import (
    Reader,
    encode_integer,
    encode_native_signed,
    encode_native_unsigned,
    encode_wide_unsigned,
    frame,
)
from crate.primitives.crumb.values import IntegerValue
from crate.primitives.crumb.wide_integer import WideInteger


def allowance() -> Result[Budget, CrumbError]:
    """Return an independent allowance large enough for one framing comparison."""
    return Budget.create(bytes=1048576, elements=1048576, depth=8)


def incan_signed(value: i128, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Run the retained Incan Z and U implementation."""
    return encode_wide_unsigned(WideInteger.from_signed(value).zigzag(budget)?, budget)


def incan_unsigned(value: u128, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Run the retained Incan U implementation."""
    return encode_wide_unsigned(WideInteger.from_unsigned(value), budget)


def incan_unsigned_end(data: bytes, offset: int, mut budget: Budget) -> Result[int, CrumbError]:
    """Run the retained Incan U scanner without committing a reader cursor."""
    mut end = offset + 0
    loop:
        if end == len(data):
            return Err(CrumbError.truncated(end))
        budget.charge_bytes(1)?
        budget.charge_elements(1)?
        value = int(data[end])
        end += 1
        if value < 128:
            if end - offset > 1 and value == 0:
                return Err(CrumbError.nonminimal(offset))
            return Ok(end)


def incan_length(data: bytes, offset: int, end: int) -> Result[u64, CrumbError]:
    """Run the retained Incan L value reconstruction."""
    count = end - offset
    if count > 10 or (count == 10 and data[end - 1] > 1u8):
        return Err(CrumbError.overflow(offset))
    mut value: u64 = 0
    mut index = end - 1
    while index >= offset:
        group: u64 = (data[index] & 127u8).saturating_resize()
        value = value * 128u64 + group
        index -= 1
    return Ok(value)


def test_native_framing_matches_incan_boundaries() -> Result[None, CrumbError]:
    """Native integer and frame bytes equal the Incan twin at zero and carrier endpoints."""
    signed = [
        -170141183460469231731687303715884105727i128 - 1i128,
        -18446744073709551616i128,
        -128i128,
        -1i128,
        0i128,
        1i128,
        127i128,
        128i128,
        18446744073709551616i128,
        170141183460469231731687303715884105727i128,
    ]
    for value in signed:
        if encode_native_signed(value, allowance()?)? != incan_signed(value, allowance()?)?:
            return Err(CrumbError.invalid_input(f"signed twin mismatch: {value}"))
    unsigned = [
        0u128,
        1u128,
        127u128,
        128u128,
        18446744073709551616u128,
        340282366920938463463374607431768211455u128,
    ]
    for value in unsigned:
        if encode_native_unsigned(value, allowance()?)? != incan_unsigned(value, allowance()?)?:
            return Err(CrumbError.invalid_input(f"unsigned twin mismatch: {value}"))
        expected = encode_wide_unsigned(WideInteger.from_unsigned(value).zigzag(allowance()?)?, allowance()?)?
        if encode_integer(IntegerValue.Unsigned(value), allowance()?)? != expected:
            return Err(CrumbError.invalid_input(f"logical unsigned twin mismatch: {value}"))
    if frame(b"", allowance()?)? != b"\x00":
        return Err(CrumbError.invalid_input("empty frame twin mismatch"))
    if frame(b"comic corpus payload", allowance()?)? != b"\x14comic corpus payload":
        return Err(CrumbError.invalid_input("payload frame twin mismatch"))
    return Ok(None)


def test_native_framing_matches_real_shape_integer_stream() -> Result[None, CrumbError]:
    """A few hundred 32-field records retain the same byte stream under both integer encoders."""
    mut native: list[u8] = []
    mut incan: list[u8] = []
    for record in range(300):
        for field in range(32):
            value = (record * 4096 + field * 257 - 524288).saturating_resize[i128]()
            for byte in encode_native_signed(value, allowance()?)?:
                native.append(byte.saturating_resize[u8]())
            for byte in incan_signed(value, allowance()?)?:
                incan.append(byte.saturating_resize[u8]())
    assert native == incan
    return Ok(None)


def test_native_reader_matches_incan_twin() -> Result[None, CrumbError]:
    """Native U and L decoding equals the retained Incan scanner on boundary and real-shape values."""
    mut values = [0u128, 1u128, 127u128, 128u128, 16384u128, 18446744073709551615u128]
    for record in range(300):
        for field in range(32):
            values.append((record * 4096 + field * 257).saturating_resize[u128]())
    for value in values:
        data = incan_unsigned(value, allowance()?)?
        end = incan_unsigned_end(data, 0, allowance()?)?
        expected = data[0:end]
        mut native = Reader.from_bytes(data)
        if native.read_unsigned(allowance()?)? != expected:
            return Err(CrumbError.invalid_input(f"reader twin mismatch for {value}"))
        if incan_length(data, 0, end)? != Reader.from_bytes(expected).read_length(allowance()?)?:
            return Err(CrumbError.invalid_input(f"length twin mismatch for {value}"))
        assert native.position() == len(data)
    return Ok(None)
