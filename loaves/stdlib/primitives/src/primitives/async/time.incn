"""
Foundational async time primitives backed by the standard native executor.

This module exposes reusable waits and timeouts without task-group or durable-join policy:

- `sleep(seconds)` for floating-point second delays
- `sleep_ms(milliseconds)` for integer millisecond delays
- `timeout(seconds, task)` for deadline-bound async work
- `timeout_ms(milliseconds, task)` for integer millisecond deadlines

Cancellation contracts:

- `sleep()` and `sleep_ms()` are cancel-safe: cancelling the sleep future stops waiting and has no side effect.
- `timeout()` and `timeout_ms()` cancel the supplied future when the deadline expires.
- Cancelling a `timeout()` or `timeout_ms()` call before it resolves also drops the supplied future.

Examples:
    await sleep(0.25)
    await sleep_ms(50)

    match await timeout(1.5, fetch_user()):
        Ok(user) => println(user.name)
        Err(err) => println(err.message())

    match await timeout_ms(500, poll_once()):
        Ok(value) => println(value)
        Err(err) => println(err.message())
"""

import std.primitives.async
from std.rust import Send, Static
from std.primitives.errors import Error
from rust::incan_std_async::task import RuntimeFuture
from rust::incan_std_async::time import clamp_seconds, clamp_millis
from rust::incan_std_async::__private::tokio::time import (
    sleep as tokio_sleep,
    timeout as tokio_timeout,
)

pub model TimeoutError with Error:
    """
    Error returned when a timeout expires before the awaited task completes.

    Example:
        match await timeout(1.0, work()):
            Ok(value) => println(value)
            Err(err) => println(err.message())
    """

    def message(self) -> str:
        return "operation timed out"

    def source(self) -> Option[str]:
        return None


pub model AsyncDuration:
    """
    A simple duration value for user code and documentation examples.

    `std.primitives.async.time` currently accepts primitive `float`/`int` delays directly, but `Duration` remains useful as a
    lightweight value object when your own APIs want to bundle a span of time explicitly.
    """
    pub secs: int
    pub nanos: int

    @staticmethod
    pub def from_secs(secs: int) -> AsyncDuration:
        """
        Create a nonnegative duration from whole seconds.

        Nonpositive values produce zero. Positive integers retain their exact value.
        """
        if secs <= 0:
            return AsyncDuration(secs=0, nanos=0)
        return AsyncDuration(secs=secs, nanos=0)

    @staticmethod
    pub def from_millis(millis: int) -> AsyncDuration:
        """
        Create a nonnegative duration from whole milliseconds.

        Nonpositive values produce zero. Positive integers are decomposed exactly without floating-point conversion.
        """
        if millis <= 0:
            return AsyncDuration(secs=0, nanos=0)
        secs = millis // 1000
        nanos = (millis % 1000) * 1000000
        return AsyncDuration(secs=secs, nanos=nanos)

    @staticmethod
    pub def from_secs_f64(secs: float) -> AsyncDuration:
        """Create a duration from floating-point seconds, clamping negatives to zero."""
        if secs <= 0:
            return AsyncDuration(secs=0, nanos=0)
        whole = int(secs)
        fractional = secs - whole
        nanos = int(fractional * 1000000000)
        return AsyncDuration(secs=whole, nanos=nanos)


pub async def sleep(seconds: float) -> None:
    """
    Sleep for a floating-point second duration.

    Example:
        await sleep(0.1)
    """
    await tokio_sleep(clamp_seconds(seconds))


pub async def sleep_ms(milliseconds: int) -> None:
    """
    Sleep for an integer millisecond duration.

    Example:
        await sleep_ms(100)
    """
    await tokio_sleep(clamp_millis(milliseconds))


pub async def timeout[T with (Send, Static), TaskFuture with RuntimeFuture[T]](seconds: float, task: TaskFuture) -> Result[T, TimeoutError]:
    """
    Await `task` with a floating-point second timeout.

    If the deadline expires, the supplied future is cancelled by being dropped. This is cancel-safe for futures that do
    not need to finish after their final suspension point; spawn the work first if it must be durable once spawned.
    """
    match await tokio_timeout(clamp_seconds(seconds), task):
        Ok(value) => return Ok(value)
        Err(_err) => return Err(TimeoutError())


pub async def timeout_ms[T with (Send, Static), TaskFuture with RuntimeFuture[T]](milliseconds: int, task: TaskFuture) -> Result[T, TimeoutError]:
    """
    Await `task` with an integer millisecond timeout.

    If the deadline expires, the supplied future is cancelled by being dropped. This is cancel-safe for futures that do
    not need to finish after their final suspension point; spawn the work first if it must be durable once spawned.
    """
    match await tokio_timeout(clamp_millis(milliseconds), task):
        Ok(value) => return Ok(value)
        Err(_err) => return Err(TimeoutError())
