"""Foundational async tasks, channels, synchronization, waits, timeouts, and their shared vocabulary entry."""


pub trait Send:
    """Require a value to be transferable across a native thread boundary."""
    pass


pub trait Sync:
    """Require a value to permit shared access across a native thread boundary."""
    pass


pub trait Static:
    """Require a value to retain no borrowed storage shorter than the program lifetime."""
    pass


pub trait Fn:
    """Require an immutable callable with the parameter types named in a generic bound."""
    pass


pub trait FnMut:
    """Require a mutable callable with the parameter types named in a generic bound."""
    pass


pub trait FnOnce:
    """Require a single-use callable with the parameter types named in a generic bound."""
    pass


pub from crate.primitives.async.channel import (
    OneshotReceiver,
    OneshotSender,
    Receiver,
    RecvError,
    SendError,
    Sender,
    SenderPermit,
    channel,
    oneshot,
    unbounded_channel,
)
pub from crate.primitives.async.sync import (
    Barrier,
    Mutex,
    MutexGuard,
    RwLock,
    RwLockReadGuard,
    RwLockWriteGuard,
    Semaphore,
    SemaphoreAcquireError,
    SemaphorePermit,
)
pub from crate.primitives.async.task import JoinHandle, TaskJoinError, spawn, spawn_blocking, yield_now
pub from crate.primitives.async.time import AsyncDuration as Duration, TimeoutError, sleep, sleep_ms, timeout, timeout_ms
