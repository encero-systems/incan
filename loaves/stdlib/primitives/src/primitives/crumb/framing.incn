"""Exact U/Z and bounded L/F framing, independent of any Crumb record codec."""

from rust::incan_std_primitives::crumb import (
    Encoded as NativeEncoded,
    Reader as NativeReader,
    Scan as NativeScan,
    encode_integer_unsigned as native_encode_integer_unsigned,
    encode_native_signed as native_encode_signed,
    encode_native_unsigned as native_encode_unsigned,
    frame as native_frame,
)
from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.errors import CrumbError
from crate.primitives.crumb.values import IntegerValue
from crate.primitives.crumb.wide_integer import WideInteger


pub class Reader:
    """An owned input cursor; failed operations retain its position but not spent budget."""

    native: NativeReader

    @staticmethod
    pub def from_bytes(data: bytes) -> Self:
        """Take input bytes; returned payload slices are owned copies, not retained views."""
        return Reader(native=NativeReader.new(data))

    pub def position(self) -> int:
        """Return the next unread byte offset."""
        return self.native.position().saturating_resize[int]()

    pub def remaining(self) -> int:
        """Return unread input length without exposing the backing allocation."""
        return self.native.remaining().saturating_resize[int]()

    pub def read_unsigned(mut self, mut budget: Budget) -> Result[bytes, CrumbError]:
        """Read a shortest U value as exact encoded bytes, without imposing a numeric width."""
        byte_limit, element_limit = budget.codec_allowance()
        scan = self.native.scan_unsigned(byte_limit.saturating_resize[i64](), element_limit.saturating_resize[i64]())
        _scanned(scan, budget)?
        return Ok(self.native.take_to(scan.end))

    pub def read_length(mut self, mut budget: Budget) -> Result[u64, CrumbError]:
        """Read L, which shares U's spelling but is limited to unsigned 64 bits."""
        byte_limit, element_limit = budget.codec_allowance()
        scan = self.native.scan_length(byte_limit.saturating_resize[i64](), element_limit.saturating_resize[i64]())
        _scanned(scan, budget)?
        self.native.commit(scan.end)
        return Ok(scan.value)

    pub def read_frame(mut self, mut budget: Budget) -> Result[bytes, CrumbError]:
        """Read L-sized bytes, refusing before allocation if host size, input or budget is insufficient."""
        byte_limit, element_limit = budget.codec_allowance()
        scan = self.native.scan_length(byte_limit.saturating_resize[i64](), element_limit.saturating_resize[i64]())
        _scanned(scan, budget)?
        converted: Option[int] = scan.value.try_resize()
        match converted:
            None => return Err(CrumbError.limit("host length"))
            Some(size) =>
                prefix = scan.end.saturating_resize[int]() - self.position()
                if size > self.remaining() - prefix:
                    return Err(CrumbError.truncated(self.position() + self.remaining()))
                budget.charge_bytes(size)?
                return Ok(self.native.take_frame(scan.end, size.saturating_resize[i64]()))


def _scanned(scan: NativeScan, mut budget: Budget) -> Result[None, CrumbError]:
    """Apply native scan work in contract order and restore the typed Incan error surface."""
    budget.charge_bytes(scan.byte_charge.saturating_resize[int]())?
    budget.charge_elements(scan.element_charge.saturating_resize[int]())?
    match scan.kind:
        0u8 => return Ok(None)
        1u8 => return Err(CrumbError.truncated(scan.detail.saturating_resize[int]()))
        2u8 => return Err(CrumbError.nonminimal(scan.detail.saturating_resize[int]()))
        3u8 => return Err(CrumbError.overflow(scan.detail.saturating_resize[int]()))
        4u8 => return Err(CrumbError.limit("bytes"))
        5u8 => return Err(CrumbError.limit("elements"))
        _ => return Err(CrumbError.invalid_input("native scan status"))


pub def encode_native_unsigned(value: u128, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Encode one native unsigned value as shortest U without decimal formatting."""
    return _charged(native_encode_unsigned(value), budget)


pub def encode_native_signed(value: i128, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Encode one native signed value through Z without decimal formatting."""
    return _charged(native_encode_signed(value), budget)


pub def encode_integer(value: IntegerValue, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Encode a signed or unsigned logical integer through the shared mathematical Z mapping."""
    match value:
        IntegerValue.Signed(number) => return encode_native_signed(number, budget)
        IntegerValue.Unsigned(number) =>
            return _charged(native_encode_integer_unsigned(number), budget)


pub def encode_wide_unsigned(value: WideInteger, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Encode a nonnegative widened physical value as shortest U directly from its bits."""
    if value.is_negative():
        return Err(CrumbError.invalid_input("negative unsigned integer"))
    width = value.bit_length(budget)?
    if width == 0:
        return _pack_groups([0], budget)
    magnitude = value.bytes()
    mut groups: list[int] = []
    mut position = 0
    while position < width:
        budget.charge_elements(1)?
        mut group = 0
        for bit in range(7):
            source = position + bit
            if source < width:
                byte = int(magnitude[source // 8])
                group |= ((byte >> (source % 8)) & 1) << bit
        groups.append(group)
        position += 7
    return _pack_groups(groups, budget)


pub def decode_native_signed(groups: list[int], mut budget: Budget) -> Result[i128, CrumbError]:
    """Decode one Z value into i128, refusing physical values outside the logical decimal domain."""
    value = WideInteger.from_base128(groups, budget)?.unzigzag(budget)?.to_signed()
    match value:
        Some(number) => return Ok(number)
        None => return Err(CrumbError.invalid_input("signed integer overflow"))


pub def frame(data: bytes, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Encode F with exact byte length; charge the payload copy before creating it."""
    return _charged(native_frame(data), budget)


def _charged(encoded: NativeEncoded, mut budget: Budget) -> Result[bytes, CrumbError]:
    """Apply the codec contract's exact logical work charges before returning native bytes."""
    budget.charge_bytes(encoded.byte_charge.saturating_resize[int]())?
    budget.charge_elements(encoded.element_charge.saturating_resize[int]())?
    return Ok(encoded.data)


def _pack_groups(groups: list[int], mut budget: Budget) -> Result[bytes, CrumbError]:
    """Frame seven-bit groups; each checked conversion preserves an exact octet."""
    budget.charge_bytes(len(groups))?
    mut output: list[u8] = []
    for index in range(len(groups)):
        mut value = groups[index] + 0
        if index + 1 < len(groups):
            value += 128
        converted: Option[u8] = value.try_resize()
        match converted:
            Some(byte) => output.append(byte)
            None => return Err(CrumbError.invalid_input("base-128 group"))
    return Ok(output)
