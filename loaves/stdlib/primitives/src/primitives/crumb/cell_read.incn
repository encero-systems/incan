"""Typed recursive binary admission and explicit logical materialization over bounded retained cells."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.identity import closed_selector
from crate.primitives.crumb.ordering import compare, compare_selectors
from crate.primitives.crumb.encoding_cursor import EncodingCursor
from crate.primitives.crumb.descriptions import StoredDescription, StoredField
from crate.primitives.crumb.description_dictionary import Dictionary, slot
from crate.primitives.crumb.encoding_errors import BinaryError, BinaryFailure, failure, primitive, in_field, in_variant
from crate.primitives.crumb.encoding_index import CellIndex, RecordIndex, read_record_index, read_index, selected, bit
from crate.primitives.crumb.scalar_read import scalar, decimal
from crate.primitives.crumb.types import TypeNode, NominalKind, ContainerKind, AbsentPolicy, ScalarKind
from crate.primitives.crumb.values import Value, ValueField, MapEntry, Projection
from crate.primitives.views import MappedView


pub model DecodedRoot:
    """Transient logical row plus an index retained only after the entire containing envelope is admitted."""

    pub value: Value
    pub index: RecordIndex
    pub variant: Option[int]


pub def read_root(
    written: StoredDescription,
    view: MappedView,
    origin: int,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[DecodedRoot, BinaryError]:
    """Resolve enum variants in identity order; decode every reachable cell before returning its row index."""
    mut cursor = EncodingCursor.create(view, origin)?
    if written.kind == NominalKind.Record:
        index = read_record_index(written.fields, cursor, budget)?
        fields = read_fields(written.fields, index, dictionary, budget)?
        return Ok(DecodedRoot(value=Value.Record(fields), index=index, variant=None))
    variant = cursor.length(budget)?
    if variant >= len(written.variants):
        return Err(failure(BinaryFailure.VariantIndex, origin))
    index = read_record_index(written.variants[variant].fields, cursor, budget).map_err(
        (e) => in_variant(e, written.variants[variant].identity),
    )?
    fields = read_fields(written.variants[variant].fields, index, dictionary, budget).map_err(
        (e) => in_variant(e, written.variants[variant].identity),
    )?
    return Ok(
        DecodedRoot(value=Value.Enum(written.variants[variant].identity, fields), index=index, variant=Some(variant)),
    )


def read_fields(
    shape: list[StoredField],
    index: RecordIndex,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[list[ValueField], BinaryError]:
    """Build only a transient logical record; the admitted set retains offsets, not every decoded record."""
    mut fields: list[ValueField] = []
    mut eligible = 0
    mut position = 0
    for field in shape:
        budget.charge_elements(1).map_err((e) => primitive(e, index.bitmap_origin))?
        budget.charge_bytes(6).map_err((e) => primitive(e, index.bitmap_origin))?
        mut present = true
        if field.shape.absent != AbsentPolicy.Required:
            present = bit(index.bitmap, eligible, index.bitmap_origin)?
            eligible += 1
        mut value = Value.NoneValue
        if present:
            view, origin = selected(index.cells, position, budget)?
            value = read_field_cell(field, view, origin, dictionary, budget).map_err(
                (e) => in_field(e, field.shape.identity),
            )?
            position += 1
        else:
            value = absent(field, index.bitmap_origin)?
        fields.append(
            ValueField(
                identity=field.shape.identity,
                canonical=field.shape.canonical,
                absent=field.shape.absent,
                value=value,
            ),
        )
    return Ok(fields)


pub def absent(field: StoredField, origin: int) -> Result[Value, BinaryError]:
    """Restore only the explicit stored absence, never a constructor default or missing-data guess."""
    if field.shape.absent == AbsentPolicy.NoneValue:
        return Ok(Value.NoneValue)
    if field.shape.absent == AbsentPolicy.Empty:
        match field.shape.storage_type:
            TypeNode.Container(ContainerKind.List, _) => return Ok(Value.List([]))
            TypeNode.Container(ContainerKind.Set, _) => return Ok(Value.Set([]))
            TypeNode.Container(ContainerKind.Map, _) => return Ok(Value.Map([]))
            _ => pass
    return Err(failure(BinaryFailure.InvalidDescription, origin))


pub def read_field_cell(
    field: StoredField,
    view: MappedView,
    origin: int,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """The presence bit substitutes only one outer Option tag; redundant empty presence is invalid."""
    if field.shape.absent == AbsentPolicy.NoneValue:
        match field.shape.storage_type:
            TypeNode.Container(ContainerKind.Option, arguments) =>
                value = cell(arguments[0], view, origin, dictionary, budget)?
                return Ok(Value.Some([value]))
            _ => return Err(failure(BinaryFailure.InvalidDescription, origin))
    value = cell(field.shape.storage_type, view, origin, dictionary, budget)?
    if field.shape.absent == AbsentPolicy.Empty:
        match value:
            Value.List(items) | Value.Set(items) =>
                if len(items) == 0:
                    return Err(failure(BinaryFailure.RedundantPresence, origin))
            Value.Map(entries) =>
                if len(entries) == 0:
                    return Err(failure(BinaryFailure.RedundantPresence, origin))
            _ => return Err(failure(BinaryFailure.InvalidDescription, origin))
    return Ok(value)


pub def cell(
    node: TypeNode,
    view: MappedView,
    origin: int,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """Every entered typed cell consumes shared depth; failure unwinds the balanced entry before returning."""
    budget.charge_elements(1).map_err((e) => primitive(e, origin))?
    budget.enter().map_err((e) => primitive(e, origin))?
    result = cell_inner(node, view, origin, dictionary, budget)
    budget.leave().map_err((e) => primitive(e, origin))?
    return result


def cell_inner(
    node: TypeNode,
    view: MappedView,
    origin: int,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """Only the admitted written selector chooses interpretation; no application constructor is invoked."""
    match node:
        TypeNode.Scalar(kind) => return scalar(kind, view, origin, budget)
        TypeNode.Decimal(precision, scale) => return decimal(precision, scale, view, origin, budget)
        TypeNode.Reference(arguments) =>
            if len(arguments) != 1:
                return Err(failure(BinaryFailure.InvalidSelector, origin))
            return scalar(ScalarKind.Reference, view, origin, budget)
        TypeNode.Nominal(_, _, _, _) =>
            key = closed_selector(node, budget).map_err((e) => primitive(e, origin, BinaryFailure.InvalidSelector))?
            position = slot(dictionary, key, budget).map_err((e) => primitive(e, origin, BinaryFailure.InvalidSelector))?
            decoded = read_root(dictionary.entries[position], view, origin, dictionary, budget)?
            return Ok(decoded.value)
        TypeNode.Container(kind, arguments) => return container(kind, arguments, view, origin, dictionary, budget)
        _ => return Err(failure(BinaryFailure.InvalidSelector, origin))


def container(
    kind: ContainerKind,
    arguments: list[TypeNode],
    view: MappedView,
    origin: int,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """Check tags/counts before indexing, and consume the complete frame selected by the enclosing offsets."""
    mut cursor = EncodingCursor.create(view, origin)?
    if kind == ContainerKind.Option:
        tag = cursor.byte(budget)?
        mut value = Value.NoneValue
        if tag == 1:
            child = cursor.frame(budget)?
            child_origin = cursor.absolute() - child.len()
            value = Value.Some([cell(arguments[0], child, child_origin, dictionary, budget)?])
        elif tag != 0:
            return Err(failure(BinaryFailure.InvalidCell, origin))
        if cursor.remaining() != 0:
            return Err(failure(BinaryFailure.InvalidCell, cursor.absolute()))
        return Ok(value)
    if kind == ContainerKind.Union:
        return union_cell(arguments, cursor, dictionary, budget)
    count = cursor.length(budget)?
    budget.charge_elements(count).map_err((e) => primitive(e, origin))?
    if kind == ContainerKind.Tuple and count != len(arguments):
        return Err(failure(BinaryFailure.ArityMismatch, origin))
    mut slots = count + 0
    if kind == ContainerKind.Map:
        if count > (9223372036854775807 - 1) // 2:
            return Err(failure(BinaryFailure.LimitExceeded, origin))
        slots = count * 2
    index = read_index(cursor, slots, budget)?
    if kind == ContainerKind.Map:
        return map_cell(arguments, index, dictionary, budget)
    mut values: list[Value] = []
    for position in range(count):
        child, child_origin = selected(index, position, budget)?
        mut type_index = 0
        if kind == ContainerKind.Tuple:
            type_index = position
        value = cell(arguments[type_index], child, child_origin, dictionary, budget)?
        if kind == ContainerKind.Set and position > 0:
            checked_order(values[position - 1], value, child_origin, budget)?
        values.append(value)
    match kind:
        ContainerKind.List => return Ok(Value.List(values))
        ContainerKind.Tuple => return Ok(Value.Tuple(values))
        ContainerKind.Set => return Ok(Value.Set(values))
        _ => return Err(failure(BinaryFailure.InvalidSelector, origin))


def map_cell(
    arguments: list[TypeNode],
    index: CellIndex,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """Keys are strictly ordered under object comparison; no user equality or last-write-wins operation runs."""
    mut entries: list[MapEntry] = []
    for position in range(index.count // 2):
        key_view, key_origin = selected(index, position * 2, budget)?
        value_view, value_origin = selected(index, position * 2 + 1, budget)?
        key = cell(arguments[0], key_view, key_origin, dictionary, budget)?
        value = cell(arguments[1], value_view, value_origin, dictionary, budget)?
        if position > 0:
            checked_order(entries[position - 1].key, key, key_origin, budget)?
        entries.append(MapEntry(key=key, value=value))
    return Ok(Value.Map(entries))


def checked_order(previous: Value, current: Value, origin: int, mut budget: Budget) -> Result[None, BinaryError]:
    """Reject duplicates and descending physical order before any canonical projection can erase distinctions."""
    relation = compare(previous, current, Projection.Object, budget).map_err((e) => primitive(e, origin))?
    if relation == 0:
        return Err(failure(BinaryFailure.DuplicateKey, origin))
    if relation > 0:
        return Err(failure(BinaryFailure.CollectionOrder, origin))
    return Ok(None)


def union_cell(
    arguments: list[TypeNode],
    mut cursor: EncodingCursor,
    dictionary: Dictionary,
    mut budget: Budget,
) -> Result[Value, BinaryError]:
    """The physical index selects the written descriptor's N/K ordering, never source declaration order."""
    offset = cursor.absolute()
    requested = cursor.length(budget)?
    if requested >= len(arguments):
        return Err(failure(BinaryFailure.UnionIndex, offset))
    for candidate in arguments:
        mut rank = 0
        for other in arguments:
            relation = compare_selectors(other, candidate, budget).map_err((e) => primitive(e, offset))?
            if relation < 0:
                rank += 1
        if rank == requested:
            origin = cursor.absolute()
            view = cursor.take(cursor.remaining(), budget)?
            value = cell(candidate, view, origin, dictionary, budget)?
            return Ok(Value.Union(candidate, [value]))
    return Err(failure(BinaryFailure.UnionIndex, offset))
