"""Typed COMIC value reading through document-owned descriptions."""

from rust::std::primitive import f32 as RustF32, f64 as RustF64, i128 as RustI128, u128 as RustU128
from rust::std::str import FromStr
from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.native_numbers import integer_compare, integer_spelling
from crate.primitives.crumb.text_names import require_name, require_path
from crate.primitives.crumb.text_syntax import description_at, last_segment, resolve_named, type_spelling
from crate.primitives.crumb.text_tokens import TextToken, TextTokenKind, TextTokens
from crate.primitives.crumb.text_types import TextDescription, TextError, TextFailure, TextPosition, TextRootValue
from crate.primitives.crumb.types import AbsentPolicy, ContainerKind, FieldShape, NominalKind, ScalarKind, TypeNode
from crate.primitives.crumb.values import IntegerValue, MapEntry, Value, ValueField
from crate.primitives.hex import hexlify
from crate.primitives.text import encode_utf8


const STORE_KEYS: FrozenSet[str] = {"___id", "___revision", "___model_hash", "___canonical_hash", "___object_hash"}
const BOOLEAN_SPELLINGS: FrozenSet[str] = {"true", "false"}
const NONFINITE_SPELLINGS: FrozenSet[str] = {"inf", "-inf", "nan"}


pub def parse_root_values(
    mut tokens: TextTokens,
    descriptions: list[TextDescription],
    mut budget: Budget,
) -> Result[list[TextRootValue], TextError]:
    """Read one root value or table after requiring its prior unique description."""
    type_token = tokens.take()?
    type_name = require_path(tokens.text(type_token)?, type_token.position, TextFailure.UnknownDescription)?
    description = description_at(descriptions, type_name, type_token.position)?
    tokens.require("<<")?
    mut values: list[TextRootValue] = []
    root_type = description_type(description)
    if tokens.accepts("[")?:
        while not tokens.accepts("]")?:
            if tokens.peek()?.kind == TextTokenKind.End:
                return Err(TextError(kind=TextFailure.UnexpectedEnd, position=tokens.peek()?.position))
            values.append(
                TextRootValue(
                    storage_type=root_type,
                    value=parse_described(description, descriptions, tokens, true, budget)?,
                ),
            )
            if tokens.accepts("]")?:
                break
            tokens.require(",")?
    else:
        values.append(
            TextRootValue(
                storage_type=root_type,
                value=parse_described(description, descriptions, tokens, false, budget)?,
            ),
        )
    return Ok(values)


def parse_described(
    description: TextDescription,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    row: bool,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Read one record or enum through its admitted declaration."""
    if description.shape == NominalKind.Record:
        token = tokens.peek()?
        if tokens.text(token)? != "(":
            return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
        fields = parse_cells(description.fields, descriptions, tokens, budget)?
        return Ok(Value.Record(fields))
    if description.shape == NominalKind.Enum:
        return parse_enum(description, descriptions, tokens, budget)
    return Err(TextError(kind=TextFailure.UnknownKind, position=tokens.peek()?.position))


def parse_cells(
    fields: list[FieldShape],
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[list[ValueField], TextError]:
    """Apply positions first, then names or indexes, and materialize every declared absence."""
    match budget.enter():
        Err(_) => return Err(limit_error(tokens.peek()?.position))
        Ok(_) => pass
    tokens.require("(")?
    # Explicit appends preserve the recursive Option payload through native lowering.
    # #2803: a comprehension loses the recursive Option element type here.
    mut values: list[Option[Value]] = []
    for _ in fields:
        values.append(None)
    mut positional = 0
    mut saw_key = false
    while not tokens.accepts(")")?:
        if tokens.peek()?.kind == TextTokenKind.End:
            return Err(TextError(kind=TextFailure.UnexpectedEnd, position=tokens.peek()?.position))
        key_token = tokens.peek()?
        key_text = tokens.text(key_token)?
        mut selected = positional
        next = tokens.peek_at(1)?
        if tokens.text(next)? == "=":
            saw_key = true
            key = tokens.text(tokens.take()?)?
            tokens.take()?
            if not canonical_unsigned(key) and not key.startswith("___"):
                selected = field_index(
                    fields,
                    require_name(key, key_token.position, TextFailure.UnknownField)?,
                    key_token,
                )?
            else:
                selected = field_index(fields, key, key_token)?
        elif saw_key:
            return Err(TextError(kind=TextFailure.PositionalAfterKey, position=key_token.position))
        else:
            positional += 1
            if selected >= len(fields):
                if key_text.startswith("___"):
                    return Err(TextError(kind=TextFailure.UnknownStoreKey, position=key_token.position))
                return Err(TextError(kind=TextFailure.FieldIndexOutOfRange, position=key_token.position))
        if selected >= len(fields):
            return Err(TextError(kind=TextFailure.FieldIndexOutOfRange, position=key_token.position))
        match values[selected]:
            Some(_) => return Err(TextError(kind=TextFailure.DuplicateField, position=key_token.position))
            None => values[selected] = Some(parse_value(fields[selected].storage_type, descriptions, tokens, budget)?)
        if tokens.accepts(")")?:
            break
        tokens.require(",")?
        if tokens.accepts(")")?:
            break
    closing = tokens.peek_at(-1)?.position
    result = fill_fields(fields, values, closing)?
    budget.leave().map_err((_) => limit_error(closing))?
    return Ok(result)


def field_index(fields: list[FieldShape], key: str, token: TextToken) -> Result[int, TextError]:
    """Resolve an input-only declaration index or an exact field name."""
    if key.startswith("___"):
        if key not in STORE_KEYS:
            return Err(TextError(kind=TextFailure.UnknownStoreKey, position=token.position))
        return Err(TextError(kind=TextFailure.UnsupportedStoreKey, position=token.position))
    if canonical_unsigned(key):
        index = int(key)
        if index < 0 or index >= len(fields):
            return Err(TextError(kind=TextFailure.FieldIndexOutOfRange, position=token.position))
        return Ok(index)
    for index in range(len(fields)):
        if fields[index].name == key:
            return Ok(index)
    return Err(TextError(kind=TextFailure.UnknownField, position=token.position))


def fill_fields(
    fields: list[FieldShape],
    values: list[Option[Value]],
    closing: TextPosition,
) -> Result[list[ValueField], TextError]:
    """Supply only the description's explicit outer absence or empty collection."""
    mut result: list[ValueField] = []
    for index in range(len(fields)):
        match values[index]:
            Some(value) => result.append(value_field(fields[index], value))
            None =>
                match absent_value(fields[index]):
                    Some(value) => result.append(value_field(fields[index], value))
                    None => return Err(TextError(kind=TextFailure.MissingRequiredField, position=closing))
    return Ok(result)


def value_field(field: FieldShape, value: Value) -> ValueField:
    """Attach a read value to the identity and storage policy established by its description."""
    return ValueField(identity=field.identity, canonical=field.canonical, absent=field.absent, value=value)


def absent_value(field: FieldShape) -> Option[Value]:
    """Return a declared absent value without inventing a constructor default."""
    match field.absent:
        AbsentPolicy.NoneValue => return Some(Value.NoneValue)
        AbsentPolicy.Empty =>
            match field.storage_type:
                TypeNode.Container(ContainerKind.List, _) => return Some(Value.List([]))
                TypeNode.Container(ContainerKind.Set, _) => return Some(Value.Set([]))
                TypeNode.Container(ContainerKind.Map, _) => return Some(Value.Map([]))
                _ => return None
        AbsentPolicy.Required => return None


def parse_value(
    storage_type: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Read through the declared slot; inspect refusal position without capturing the owned token snapshot."""
    # #2831: capturing this mutable cursor in map_err copies every token on each value.
    match budget.charge_elements(1):
        Err(_) => return Err(limit_error(tokens.peek()?.position))
        Ok(_) => pass
    match storage_type:
        TypeNode.Scalar(kind) => return parse_scalar(kind, tokens, budget)
        TypeNode.Decimal(precision, scale) => return parse_decimal(precision, scale, tokens)
        TypeNode.Container(ContainerKind.Option, items) => return parse_optional(items[0], descriptions, tokens, budget)
        TypeNode.Container(ContainerKind.List, items) => return parse_list(items[0], descriptions, tokens, budget)
        TypeNode.Container(ContainerKind.Set, items) => return parse_set(items[0], descriptions, tokens, budget)
        TypeNode.Container(ContainerKind.Map, items) =>
            return parse_map(items[0], items[1], descriptions, tokens, budget)
        TypeNode.Container(ContainerKind.Union, items) => return parse_union(items, descriptions, tokens, budget)
        TypeNode.Reference(items) => return parse_reference(items[0], descriptions, tokens)
        TypeNode.Nominal(_, path, _, _) =>
            description = resolve_named(descriptions, path, tokens.peek()?.position)?
            return parse_described(description, descriptions, tokens, false, budget)
        _ => pass
    return Err(TextError(kind=TextFailure.TypeMismatch, position=tokens.peek()?.position))


def parse_scalar(kind: ScalarKind, mut tokens: TextTokens, mut budget: Budget) -> Result[Value, TextError]:
    """Read one core scalar with exact integer widths, float bits and secret withholding."""
    token = tokens.peek()?
    spelling = tokens.text(token)?
    if kind == ScalarKind.Boolean:
        if spelling not in BOOLEAN_SPELLINGS:
            return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
        tokens.take()?
        return Ok(Value.Boolean(spelling == "true"))
    if kind.integer_facts().is_some():
        tokens.take()?
        if spelling in NONFINITE_SPELLINGS:
            return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
        return parse_integer(kind, spelling, token.position)
    if kind == ScalarKind.Fp32 or kind == ScalarKind.Fp64:
        tokens.take()?
        return parse_float(kind, spelling, token.position)
    if kind == ScalarKind.String:
        if token.kind != TextTokenKind.String:
            if token.kind == TextTokenKind.Marker:
                return Err(TextError(kind=TextFailure.UnsupportedMarker, position=token.position))
            return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
        return Ok(Value.Text(tokens.text(tokens.take()?)?))
    if kind == ScalarKind.Binary:
        if token.kind != TextTokenKind.Binary:
            return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
        return Ok(Value.Binary(tokens.data(tokens.take()?)?))
    if kind == ScalarKind.SecretString or kind == ScalarKind.SecretBytes:
        if spelling != "<secret>":
            return Err(TextError(kind=TextFailure.UnsupportedMarker, position=token.position))
        tokens.take()?
        return Ok(Value.Withheld)
    return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))


def parse_integer(kind: ScalarKind, value: str, position: TextPosition) -> Result[Value, TextError]:
    """Validate canonical decimal spelling and the declared exact storage range."""
    if not canonical_integer(value):
        return Err(TextError(kind=TextFailure.InvalidInteger, position=position))
    match kind.integer_facts():
        Some((true, bits)) =>
            match RustI128.from_str(value):
                Ok(number) =>
                    if signed_in_width(number, bits):
                        return Ok(Value.Integer(IntegerValue.Signed(number)))
                Err(_) => pass
        Some((false, bits)) =>
            match RustU128.from_str(value):
                Ok(number) =>
                    if unsigned_in_width(number, bits):
                        return Ok(Value.Integer(IntegerValue.Unsigned(number)))
                Err(_) => pass
        None => pass
    return Err(TextError(kind=TextFailure.IntegerOutOfRange, position=position))


def parse_float(kind: ScalarKind, spelling: str, position: TextPosition) -> Result[Value, TextError]:
    """Parse through Rust's exact-width scalar and retain canonical IEEE bits."""
    if spelling not in NONFINITE_SPELLINGS and not valid_finite_float(spelling):
        return Err(TextError(kind=TextFailure.InvalidFloat, position=position))
    if kind == ScalarKind.Fp32:
        match RustF32.from_str(spelling):
            Ok(value) => return Ok(Value.Float(32, u32_bytes(value.to_bits())))
            Err(_) => return Err(TextError(kind=TextFailure.TypeMismatch, position=position))
    match RustF64.from_str(spelling):
        Ok(value) => return Ok(Value.Float(64, u64_bytes(value.to_bits())))
        Err(_) => return Err(TextError(kind=TextFailure.TypeMismatch, position=position))


def parse_decimal(precision: int, scale: int, mut tokens: TextTokens) -> Result[Value, TextError]:
    """Require exactly the declared fractional scale and retain an exact coefficient string."""
    token = tokens.take()?
    spelling = tokens.text(token)?
    if not spelling.endswith("d"):
        return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
    number = spelling[0:len(spelling) - 1]
    parts = number.split(".")
    if (
        len(parts) != 2
        or len(parts[1]) != scale
        or not decimal_digits(parts[0], true)
        or not decimal_digits(parts[1], false)
    ):
        return Err(TextError(kind=TextFailure.DecimalScaleMismatch, position=token.position))
    mut coefficient = parts[0] + parts[1]
    if coefficient.startswith("-") and coefficient[1:2] == "0" and all_zero(coefficient[1:]):
        coefficient = "0"
    if len(coefficient.replace("-", "")) > precision:
        return Err(TextError(kind=TextFailure.DecimalPrecision, position=token.position))
    match RustI128.from_str(coefficient):
        Ok(value) => return Ok(Value.Decimal(value, scale))
        Err(_) => return Err(TextError(kind=TextFailure.DecimalPrecision, position=token.position))


def parse_optional(
    inner: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Keep every absent layer distinct from a present nested optional."""
    if tokens.accepts("None")?:
        return Ok(Value.NoneValue)
    if tokens.accepts("Some")?:
        tokens.require("(")?
        value = parse_value(inner, descriptions, tokens, budget)?
        tokens.require(")")?
        return Ok(Value.Some([value]))
    return Ok(Value.Some([parse_value(inner, descriptions, tokens, budget)?]))


def parse_list(
    item_type: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Read an ordered list, including row-shaped records and variants."""
    tokens.require("[")?
    mut items: list[Value] = []
    while not tokens.accepts("]")?:
        items.append(parse_value(item_type, descriptions, tokens, budget)?)
        if tokens.accepts("]")?:
            break
        tokens.require(",")?
    return Ok(Value.List(items))


def parse_set(
    item_type: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Read a set and place its admitted values in stored scalar order."""
    tokens.require("{")?
    mut items: list[Value] = []
    while not tokens.accepts("}")?:
        item = parse_value(item_type, descriptions, tokens, budget)?
        if value_index(items, item) >= 0:
            return Err(TextError(kind=TextFailure.DuplicateKey, position=tokens.peek_at(-1)?.position))
        insert_ordered(items, item)
        if tokens.accepts("}")?:
            break
        tokens.require(",")?
    return Ok(Value.Set(items))


def parse_map(
    key_type: TypeNode,
    value_type: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Refuse duplicate keys before sorting admitted pairs by the stored key order."""
    tokens.require("{")?
    mut entries: list[MapEntry] = []
    while not tokens.accepts("}")?:
        key_position = tokens.peek()?.position
        key = parse_value(key_type, descriptions, tokens, budget)?
        tokens.require(":")?
        value = parse_value(value_type, descriptions, tokens, budget)?
        if entry_index(entries, key) >= 0:
            return Err(TextError(kind=TextFailure.DuplicateKey, position=key_position))
        insert_entry(entries, MapEntry(key=key, value=value))
        if tokens.accepts("}")?:
            break
        tokens.require(",")?
    return Ok(Value.Map(entries))


def parse_union(
    members: list[TypeNode],
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Select a union only from an explicit wrapper or an unambiguous qualified enum variant."""
    token = tokens.peek()?
    spelling = tokens.text(token)?
    next = tokens.peek_at(1)?
    if tokens.text(next)? == "<<":
        selector_token = tokens.take()?
        selector = require_path(tokens.text(selector_token)?, selector_token.position, TextFailure.AmbiguousUnion)?
        tokens.take()?
        member = union_member(members, selector, descriptions, token.position)?
        value = parse_value(member, descriptions, tokens, budget)?
        return Ok(Value.Union(resolved_type(member, descriptions, token.position)?, [value]))
    selected = qualified_variant_member(members, spelling, descriptions)
    match selected:
        Some(member) =>
            value = parse_value(member, descriptions, tokens, budget)?
            return Ok(Value.Union(resolved_type(member, descriptions, token.position)?, [value]))
        None => return Err(TextError(kind=TextFailure.AmbiguousUnion, position=token.position))


def union_member(
    members: list[TypeNode],
    selector: str,
    descriptions: list[TextDescription],
    position: TextPosition,
) -> Result[TypeNode, TextError]:
    """Resolve one explicit union selector by exact or unambiguous short spelling."""
    mut found: list[TypeNode] = []
    for member in members:
        spelling = type_spelling(member)
        if spelling == selector or last_segment(spelling) == selector:
            found.append(member)
    if len(found) != 1:
        return Err(TextError(kind=TextFailure.AmbiguousUnion, position=position))
    return Ok(found[0])


def qualified_variant_member(
    members: list[TypeNode],
    spelling: str,
    descriptions: list[TextDescription],
) -> Option[TypeNode]:
    """Find the sole enum union member admitted by `EnumName.Variant`."""
    parts = spelling.split(".")
    if len(parts) < 2:
        return None
    enum_name = parts[len(parts) - 2]
    variant = parts[len(parts) - 1]
    mut found: list[TypeNode] = []
    for member in members:
        match member:
            TypeNode.Nominal(_, path, _, _) =>
                if last_segment(path) == enum_name and enum_has_variant(descriptions, path, variant):
                    found.append(member)
            _ => pass
    if len(found) == 1:
        return Some(found[0])
    return None


def parse_enum(
    description: TextDescription,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
    mut budget: Budget,
) -> Result[Value, TextError]:
    """Read one enum name, accepting an optional owning-enum qualifier."""
    token = tokens.take()?
    mut name = require_path(tokens.text(token)?, token.position, TextFailure.UnknownVariant)?
    parts = name.split(".")
    if len(parts) > 1:
        if parts[len(parts) - 2] != last_segment(description.path):
            return Err(TextError(kind=TextFailure.UnknownVariant, position=token.position))
        name = parts[len(parts) - 1]
    for variant in description.variants:
        if variant.name == name:
            mut fields: list[ValueField] = []
            if len(variant.fields) > 0:
                fields = parse_cells(variant.fields, descriptions, tokens, budget)?
            else:
                next = tokens.peek()?
                if tokens.text(next)? == "(":
                    fields = parse_cells([], descriptions, tokens, budget)?
            return Ok(Value.Enum(variant.identity, fields))
    return Err(TextError(kind=TextFailure.UnknownVariant, position=token.position))


def parse_reference(
    target: TypeNode,
    descriptions: list[TextDescription],
    mut tokens: TextTokens,
) -> Result[Value, TextError]:
    """Read an inert typed identity without following it."""
    token = tokens.take()?
    if token.kind != TextTokenKind.Word:
        return Err(TextError(kind=TextFailure.TypeMismatch, position=token.position))
    resolved = resolved_type(target, descriptions, token.position)?
    target_identity = match resolved:
        TypeNode.Nominal(_, _, Some(identity), _) => identity
        TypeNode.Nominal(_, _, None, _) => b""
        _ => return Err(TextError(kind=TextFailure.InvalidType, position=token.position))

    return Ok(Value.Reference(target_identity, encode_utf8(tokens.text(token)?)))


def description_type(description: TextDescription) -> TypeNode:
    """Project a text declaration into the shared nominal node used by values and references."""
    return TypeNode.Nominal(description.shape, description.path, description.identity, [])


def resolved_type(
    node: TypeNode,
    descriptions: list[TextDescription],
    position: TextPosition,
) -> Result[TypeNode, TextError]:
    """Resolve every display path before a logical type leaves the text layer."""
    match node:
        TypeNode.Nominal(_, path, _, _) => return Ok(description_type(resolve_named(descriptions, path, position)?))
        TypeNode.Container(kind, items) =>
            mut resolved: list[TypeNode] = []
            for item in items:
                resolved.append(resolved_type(item, descriptions, position)?)
            return Ok(TypeNode.Container(kind, resolved))
        TypeNode.Reference(items) =>
            if len(items) != 1:
                return Err(TextError(kind=TextFailure.InvalidType, position=position))
            return Ok(TypeNode.Reference([resolved_type(items[0], descriptions, position)?]))
        _ => return Ok(node)


def enum_has_variant(descriptions: list[TextDescription], path: str, name: str) -> bool:
    """Return whether the exact enum declaration owns a named variant."""
    for description in descriptions:
        if description.path == path and description.shape == NominalKind.Enum:
            for variant in description.variants:
                if variant.name == name:
                    return true
    return false


def canonical_integer(value: str) -> bool:
    """Accept decimal digits with an optional minus and no leading zeros or negative zero."""
    if value == "" or value.startswith("+") or "_" in value:
        return false
    mut digits = value
    if value.startswith("-"):
        digits = value[1:]
        if digits == "0":
            return false
    return canonical_unsigned(digits)


def canonical_unsigned(value: str) -> bool:
    """Return whether text is nonempty decimal digits without leading zeros."""
    if value == "" or (len(value) > 1 and value.startswith("0")):
        return false
    for digit in value:
        if digit < "0" or digit > "9":
            return false
    return true


def signed_in_width(value: i128, bits: int) -> bool:
    """Check one parsed signed value against its declared storage width."""
    if bits == 128:
        return true
    limit: i128 = 1i128 << (bits - 1)
    return value >= 0i128 - limit and value < limit


def unsigned_in_width(value: u128, bits: int) -> bool:
    """Check one parsed unsigned value against its declared storage width."""
    if bits == 128:
        return true
    limit: u128 = 1u128 << bits
    return value < limit


def valid_finite_float(value: str) -> bool:
    """Refuse integer spellings, separators, plus signs and malformed decimal exponents."""
    if value == "" or value.startswith("+") or "_" in value:
        return false
    if "." not in value and "e" not in value:
        return false
    mut exponent_parts = value.split("e")
    if len(exponent_parts) > 2:
        return false
    base = exponent_parts[0]
    if not decimal_float_base(base):
        return false
    if len(exponent_parts) == 2:
        exponent = exponent_parts[1]
        if exponent.startswith("+") or not decimal_digits(exponent, true):
            return false
    return true


def decimal_float_base(value: str) -> bool:
    """Validate digits around an optional point, retaining a leading minus only."""
    parts = value.split(".")
    if len(parts) > 2:
        return false
    if not decimal_digits(parts[0], true):
        return false
    if len(parts) == 2 and not decimal_digits(parts[1], false):
        return false
    return true


def decimal_digits(value: str, signed: bool) -> bool:
    """Return whether text is a nonempty decimal digit run with an optional leading minus."""
    mut digits = value
    if signed and digits.startswith("-"):
        digits = digits[1:]
    if digits == "":
        return false
    for digit in digits:
        if digit < "0" or digit > "9":
            return false
    return true


def all_zero(value: str) -> bool:
    """Return whether every scalar is the decimal zero digit."""
    for digit in value:
        if digit != "0":
            return false
    return true


def u32_bytes(value: u32) -> bytes:
    """Write one IEEE binary32 bit pattern in network order."""
    return [
        ((value >> 24) & 255u32).saturating_resize[u8](),
        ((value >> 16) & 255u32).saturating_resize[u8](),
        ((value >> 8) & 255u32).saturating_resize[u8](),
        (value & 255u32).saturating_resize[u8](),
    ]


def u64_bytes(value: u64) -> bytes:
    """Write one IEEE binary64 bit pattern in network order."""
    return [
        ((value >> 56) & 255u64).saturating_resize[u8](),
        ((value >> 48) & 255u64).saturating_resize[u8](),
        ((value >> 40) & 255u64).saturating_resize[u8](),
        ((value >> 32) & 255u64).saturating_resize[u8](),
        ((value >> 24) & 255u64).saturating_resize[u8](),
        ((value >> 16) & 255u64).saturating_resize[u8](),
        ((value >> 8) & 255u64).saturating_resize[u8](),
        (value & 255u64).saturating_resize[u8](),
    ]


def value_index(items: list[Value], candidate: Value) -> int:
    """Find an equal supported scalar value without invoking user equality code."""
    key = order_key(candidate)
    for index in range(len(items)):
        if order_key(items[index]) == key:
            return index
    return -1


def entry_index(entries: list[MapEntry], candidate: Value) -> int:
    """Find an equal supported map key before insertion."""
    key = order_key(candidate)
    for index in range(len(entries)):
        if order_key(entries[index].key) == key:
            return index
    return -1


def insert_ordered(mut items: list[Value], candidate: Value) -> None:
    """Insert one supported scalar into stored order."""
    mut index = 0
    while index < len(items) and compare_text_values(items[index], candidate) < 0:
        index += 1
    items.append(candidate)
    mut current = len(items) - 1
    while current > index:
        previous = items[current - 1]
        items[current - 1] = items[current]
        items[current] = previous
        current -= 1


def insert_entry(mut entries: list[MapEntry], candidate: MapEntry) -> None:
    """Insert one map pair by its supported stored key order."""
    mut index = 0
    while index < len(entries) and compare_text_values(entries[index].key, candidate.key) < 0:
        index += 1
    entries.append(candidate)
    mut current = len(entries) - 1
    while current > index:
        previous = entries[current - 1]
        entries[current - 1] = entries[current]
        entries[current] = previous
        current -= 1


def compare_text_values(left: Value, right: Value) -> int:
    """Compare the core scalar kinds currently admitted as text map and set keys."""
    match left:
        Value.Integer(left_value) =>
            match right:
                Value.Integer(right_value) => return integer_compare(left_value, right_value)
                _ => pass
        _ => pass
    left_key = order_key(left)
    right_key = order_key(right)
    if left_key < right_key:
        return -1
    if left_key > right_key:
        return 1
    return 0


def order_key(value: Value) -> str:
    """Return a collision-free key for the supported primitive text cases."""
    match value:
        Value.Boolean(flag) =>
            if flag:
                return "b1"
            return "b0"
        Value.Integer(number) => return "i" + integer_spelling(number)
        Value.Text(text) => return "s" + text
        Value.Binary(data) => return "x" + hexlify(data)
        Value.NoneValue => return "n"
        _ => return "unsupported"


def limit_error(position: TextPosition) -> TextError:
    """Keep resource limits distinct from malformed data."""
    return TextError(kind=TextFailure.Limit, position=position)
