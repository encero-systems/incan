"""Finite column envelopes sharing the row codec's descriptions, values and logical seal."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.column_group_write import write_group
from crate.primitives.crumb.column_types import GroupChoice
from crate.primitives.crumb.errors import CrumbError
from crate.primitives.crumb.hashes import start_seal, append_seal
from crate.primitives.crumb.registrations import KindRegistry
from crate.primitives.crumb.row_buffer import RowBuffer, indexed, offset_width, offset_table_length
from crate.primitives.crumb.row_descriptions import Description, encode_entry
from crate.primitives.crumb.row_dictionary import admit_dictionary, slot
from crate.primitives.crumb.row_writer import RowRecord
from crate.primitives.crumb.value_admission import validate
from crate.primitives.crumb.values import Value


pub def write_columns(
    descriptions: list[Description],
    records: list[RowRecord],
    registry: KindRegistry,
    sealed: bool,
    choices: list[GroupChoice],
    mut budget: Budget,
) -> Result[bytes, CrumbError]:
    """
    Admit complete input and return one owned crumb-columns/1 envelope under the shared budget.

    Empty choices selects indexed blocks everywhere. Otherwise supply one complete choice for each
    maximal consecutive nominal run. Choices affect physical bytes, never record order or the seal.
    This finite writer transposes groups in memory; no streaming sink or minimum-size promise is made.
    """
    dictionary = admit_dictionary(descriptions, registry, budget)?
    mut body = RowBuffer.create()
    body.count(len(dictionary.entries), budget)?
    for description in dictionary.entries:
        body.append(encode_entry(description, budget)?, budget)?
    mut groups: list[bytes] = []
    mut prefixes: list[int] = [0]
    mut start = 0
    while start < len(records):
        budget.charge_elements(1)?
        index = slot(dictionary, records[start].key, budget)?
        mut end = start + 1
        while end < len(records) and records[end].key == records[start].key:
            budget.charge_elements(1)?
            end += 1
        mut values: list[Value] = []
        for position in range(start, end):
            budget.charge_elements(1)?
            validate(records[position].value, budget)?
            values.append(records[position].value)
        mut choice: Option[GroupChoice] = None
        if len(choices) != 0:
            if len(groups) >= len(choices):
                return Err(CrumbError.invalid_input("missing column group choices"))
            choice = Some(choices[len(groups)])
        groups.append(write_group(index, dictionary.entries[index], values, choice, dictionary, budget)?)
        prefixes.append(end)
        start = end
    if len(choices) != 0 and len(choices) != len(groups):
        return Err(CrumbError.invalid_input("excess column group choices"))
    body.count(len(records), budget)?
    body.count(len(groups), budget)?
    width = offset_width(len(records))?
    offset_table_length(len(groups), width)?
    body.octet(width, budget)?
    for prefix in prefixes:
        body.offset(prefix, width, budget)?
    body.append(indexed(groups, budget)?, budget)?
    if sealed:
        mut seal = start_seal(len(records), budget)?
        for record in records:
            append_seal(record.value, seal, budget)?
        body.count(len(records), budget)?
        body.append(seal.digest(budget)?, budget)?
    mut envelope = RowBuffer.create()
    envelope.append(b"CRMB\x02\x01", budget)?
    if sealed:
        envelope.octet(1, budget)?
    else:
        envelope.octet(0, budget)?
    envelope.frame(body.finish(budget)?, budget)?
    return envelope.finish(budget)
