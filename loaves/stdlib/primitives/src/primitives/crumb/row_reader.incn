"""Admit finite Crumb envelopes completely before exposing records or independently retained field views."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.hash_stream import HashOutput, OutputMode
from crate.primitives.crumb.hashes import start_seal, append_seal
from crate.primitives.crumb.registrations import KindRegistry
from crate.primitives.crumb.row_cell_read import read_root
from crate.primitives.crumb.row_cursor import RowCursor, copied
from crate.primitives.crumb.row_description_read import read_dictionary
from crate.primitives.crumb.row_descriptions import Description
from crate.primitives.crumb.row_dictionary import Dictionary
from crate.primitives.crumb.row_errors import RowError, RowFailure, failure, primitive, in_variant
from crate.primitives.crumb.row_index import RecordIndex
from crate.primitives.crumb.row_metadata import charge_copy
from crate.primitives.crumb.row_projection import project_view, project_value
from crate.primitives.crumb.row_writer import RowRecord
from crate.primitives.crumb.values import Value
from crate.primitives.views import MappedView


model StoredRow:
    """A root frame/index with its written dictionary selection; no decoded logical record is retained."""

    pub description: int
    pub variant: Option[int]
    pub raw: MappedView
    pub origin: int
    pub index: RecordIndex


pub class RowSet:
    """An admitted finite set with independently retained immutable backing and written descriptions."""

    dictionary: Dictionary
    rows: list[StoredRow]
    backing: MappedView
    sealed: bool

    @staticmethod
    pub def create(dictionary: Dictionary, rows: list[StoredRow], backing: MappedView, sealed: bool) -> Self:
        """Retain one fully admitted envelope and its independently owned backing view."""
        return RowSet(dictionary=dictionary, rows=rows, backing=backing, sealed=sealed)

    pub def len(self) -> int:
        """Return the admitted record count, which also matched the trailer for a sealed set."""
        return len(self.rows)

    pub def is_sealed(self) -> bool:
        """True means the complete logical seal was verified, not merely that its header bit was set."""
        return self.sealed

    pub def descriptions(self, mut budget: Budget) -> Result[list[Description], RowError]:
        """Copy complete written descriptions and original modes for explicit original-shape re-encoding."""
        mut result: list[Description] = []
        for description in self.dictionary.entries:
            charge_copy(description.source.metadata, budget).map_err((e) => primitive(e, 0))?
            result.append(description.source)
        return Ok(result)

    pub def read_record(self, index: int, mut budget: Budget) -> Result[RowRecord, RowError]:
        """Explicitly materialize one format record; no application constructor or normalization runs."""
        self.check_index(index)?
        decoded = read_root(
            self.dictionary.entries[self.rows[index].description],
            self.rows[index].raw,
            self.rows[index].origin,
            self.dictionary,
            budget,
        )?
        budget
            .charge_bytes(len(self.dictionary.entries[self.rows[index].description].key))
            .map_err((e) => primitive(e, self.rows[index].origin))?
        return Ok(RowRecord(key=self.dictionary.entries[self.rows[index].description].key, value=decoded.value))

    pub def field_view(self, index: int, identity: bytes, mut budget: Budget) -> Result[Option[MappedView], RowError]:
        """Retain only the encoded cell range; None means declared absence, while an unknown field is an error."""
        self.check_index(index)?
        description = self.rows[index].description
        match self.rows[index].variant:
            None =>
                return project_view(
                    self.dictionary.entries[description].fields,
                    self.rows[index].index,
                    identity,
                    budget,
                )
            Some(variant) =>
                return project_view(
                    self.dictionary.entries[description].variants[variant].fields,
                    self.rows[index].index,
                    identity,
                    budget,
                ).map_err((e) => in_variant(e, self.dictionary.entries[description].variants[variant].identity))

    pub def read_field(self, index: int, identity: bytes, mut budget: Budget) -> Result[Value, RowError]:
        """Read one selected final stored value after full admission; other fields are not reconstructed here."""
        self.check_index(index)?
        description = self.rows[index].description
        match self.rows[index].variant:
            None =>
                return project_value(
                    self.dictionary.entries[description].fields,
                    self.rows[index].index,
                    identity,
                    self.dictionary,
                    budget,
                )
            Some(variant) =>
                return project_value(
                    self.dictionary.entries[description].variants[variant].fields,
                    self.rows[index].index,
                    identity,
                    self.dictionary,
                    budget,
                ).map_err((e) => in_variant(e, self.dictionary.entries[description].variants[variant].identity))

    def check_index(self, index: int) -> Result[None, RowError]:
        """A caller cannot index past the admitted set, including negative host indexes."""
        if index < 0 or index >= len(self.rows):
            return Err(failure(RowFailure.RecordIndex, 0))
        return Ok(None)


pub def read_rows(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    mut budget: Budget,
) -> Result[RowSet, RowError]:
    """Admit exactly one envelope; bytes after its boundary are refused even if they form another valid envelope."""
    result, _ = read_envelope(view, supplied, registry, require_sealed, true, budget)?
    return Ok(result)


pub def read_prefix(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    mut budget: Budget,
) -> Result[tuple[RowSet, int], RowError]:
    """Admit one complete leading envelope and report its length; the caller owns transport completion."""
    return read_envelope(view, supplied, registry, require_sealed, false, budget)


def read_envelope(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    exact: bool,
    mut budget: Budget,
) -> Result[tuple[RowSet, int], RowError]:
    """Check header and frame before descriptions, then admit all values and any seal before returning a set."""
    mut cursor = RowCursor.create(view)?
    magic = copied(cursor.take(4, budget)?, 0, budget)?
    if magic != b"CRMB":
        return Err(failure(RowFailure.BadMagic, 0))
    codec = cursor.length(budget)?
    profile = cursor.length(budget)?
    if codec != 1 or profile != 1:
        return Err(failure(RowFailure.UnsupportedProfile, 4))
    flags = cursor.byte(budget)?
    if flags & 254 != 0:
        return Err(failure(RowFailure.ReservedFlags, cursor.absolute() - 1))
    payload = cursor.frame(budget)?
    payload_origin = cursor.absolute() - payload.len()
    if exact:
        cursor.finished()?
    sealed = flags == 1
    if require_sealed and not sealed:
        return Err(failure(RowFailure.SealRequired, 6))
    mut body = RowCursor.create(payload, payload_origin)?
    dictionary = read_dictionary(body, supplied, registry, budget)?
    rows = read_records(body, dictionary, sealed, budget)?
    body.finished()?
    consumed = cursor.consumed()
    retained = view.slice(0, consumed)
    match retained:
        None => return Err(failure(RowFailure.Truncated, consumed))
        Some(backing) => return Ok((RowSet.create(dictionary, rows, backing, sealed), consumed))


def read_records(
    mut cursor: RowCursor,
    dictionary: Dictionary,
    sealed: bool,
    mut budget: Budget,
) -> Result[list[StoredRow], RowError]:
    """Transient values feed the logical seal; the returned index retains no fully decoded record trees."""
    count_offset = cursor.absolute()
    count = cursor.length(budget)?
    budget.charge_elements(count).map_err((e) => primitive(e, count_offset))?
    if count > cursor.remaining():
        return Err(failure(RowFailure.Truncated, cursor.absolute() + cursor.remaining()))
    mut seal = HashOutput.create(OutputMode.Hash)
    if sealed:
        seal = start_seal(count, budget).map_err((e) => primitive(e, count_offset))?
    mut rows: list[StoredRow] = []
    for _ in range(count):
        offset = cursor.absolute()
        description = cursor.length(budget)?
        if description >= len(dictionary.entries):
            return Err(failure(RowFailure.DescriptionIndex, offset))
        raw = cursor.frame(budget)?
        origin = cursor.absolute() - raw.len()
        decoded = read_root(dictionary.entries[description], raw, origin, dictionary, budget)?
        if sealed:
            append_seal(decoded.value, seal, budget).map_err((e) => primitive(e, origin))?
        budget.charge_bytes(64).map_err((e) => primitive(e, origin))?
        rows.append(
            StoredRow(description=description, variant=decoded.variant, raw=raw, origin=origin, index=decoded.index),
        )
    if sealed:
        offset = cursor.absolute()
        actual_count = cursor.length(budget)?
        if actual_count != count:
            return Err(failure(RowFailure.SealCount, offset))
        expected = copied(cursor.take(32, budget)?, offset, budget)?
        actual = seal.digest(budget).map_err((e) => primitive(e, offset))?
        if actual != expected:
            return Err(failure(RowFailure.SealMismatch, offset))
    return Ok(rows)
