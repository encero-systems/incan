"""Admit finite Crumb envelopes completely, through the native codec, before exposing records or field views."""

from rust::incan_std_primitives::crumb import RowAdmission, RowRequest
from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.descriptions import Description, DescriptionMode
from crate.primitives.crumb.encoding_errors import BinaryError, BinaryFailure, failure, primitive
from crate.primitives.crumb.metadata_values import encode
from crate.primitives.crumb.records import RowRecord
from crate.primitives.crumb.registrations import KindRegistry
from crate.primitives.crumb.row_values import build_metadata, build_value, refusal, settle
from crate.primitives.crumb.types import NominalKind
from crate.primitives.crumb.values import Value
from crate.primitives.views import MappedView


pub class RowSet:
    """An admitted finite set, read by the native codec, with independently retained immutable backing."""

    native: RowAdmission
    supplied: list[Description]
    backing: MappedView

    @staticmethod
    pub def create(native: RowAdmission, supplied: list[Description], backing: MappedView) -> Self:
        """Retain one natively admitted envelope, the descriptions supplied for it, and its owned backing view."""
        return RowSet(native=native, supplied=supplied, backing=backing)

    pub def len(self) -> int:
        """Return the admitted record count, which also matched the trailer for a sealed set."""
        return self.native.records

    pub def is_sealed(self) -> bool:
        """True means the complete logical seal was verified, not merely that its header bit was set."""
        return self.native.sealed

    pub def descriptions(self, mut budget: Budget) -> Result[list[Description], BinaryError]:
        """Copy complete written descriptions and original modes for explicit original-shape re-encoding."""
        mut result: list[Description] = []
        for index in range(self.native.description_count()):
            bytes_left, elements_left = budget.codec_allowance()
            mut read = self.native.description(index, bytes_left, elements_left, budget.depth_allowance())
            settle(read, budget)?
            if read.supplied >= 0:
                result.append(self.supplied[read.supplied])
            else:
                result.append(Description(metadata=build_metadata(read)?, mode=DescriptionMode.Inline))
        return Ok(result)

    pub def read_record(self, index: int, mut budget: Budget) -> Result[RowRecord, BinaryError]:
        """Explicitly materialize one format record; no application constructor or normalization runs."""
        bytes_left, elements_left = budget.codec_allowance()
        mut read = self.native.read_record(index, bytes_left, elements_left, budget.depth_allowance())
        settle(read, budget)?
        return Ok(RowRecord(key=self.native.key(index), value=build_value(read)?))

    pub def field_view(
        self,
        index: int,
        identity: bytes,
        mut budget: Budget,
    ) -> Result[Option[MappedView], BinaryError]:
        """Retain only the encoded cell range; None means declared absence, while an unknown field is an error."""
        bytes_left, elements_left = budget.codec_allowance()
        read = self.native.field_cell(index, identity, bytes_left, elements_left, budget.depth_allowance())
        settle(read, budget)?
        if not read.present:
            return Ok(None)
        match self.backing.slice(read.origin, read.length):
            None => return Err(failure(BinaryFailure.InvalidOffsets, read.origin))
            Some(view) => return Ok(Some(view))

    pub def read_field(self, index: int, identity: bytes, mut budget: Budget) -> Result[Value, BinaryError]:
        """Read one selected final stored value after full admission; other fields are not reconstructed here."""
        bytes_left, elements_left = budget.codec_allowance()
        mut read = self.native.read_field(index, identity, bytes_left, elements_left, budget.depth_allowance())
        settle(read, budget)?
        return build_value(read)


pub def read_rows(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    mut budget: Budget,
) -> Result[RowSet, BinaryError]:
    """Admit exactly one envelope; bytes after its boundary are refused even if they form another valid envelope."""
    result, _ = admit(view, supplied, registry, require_sealed, true, budget)?
    return Ok(result)


pub def read_prefix(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    mut budget: Budget,
) -> Result[tuple[RowSet, int], BinaryError]:
    """Admit one complete leading envelope and report its length; the caller owns transport completion."""
    return admit(view, supplied, registry, require_sealed, false, budget)


def admit(
    view: MappedView,
    supplied: list[Description],
    registry: KindRegistry,
    require_sealed: bool,
    exact: bool,
    mut budget: Budget,
) -> Result[tuple[RowSet, int], BinaryError]:
    """Hand the native codec the view's bytes, each supplied description D-encoded, and the registered kinds."""
    mut request = RowRequest.new(view.to_bytes(), require_sealed, exact)
    # Encoding the caller's own descriptions is boundary work, not the request's, so it has its own allowance.
    mut boundary = Budget
        .create(bytes=9223372036854775807, elements=9223372036854775807, depth=9223372036854775807)
        .map_err((e) => primitive(e, 0))?
    for description in supplied:
        request.supply(encode(description.metadata, boundary).map_err((e) => primitive(e, 0))?)
    for registration in registry.registered():
        request.register(registration.kind, registration.shape == NominalKind.Record)
    bytes_left, elements_left = budget.codec_allowance()
    request.allow(bytes_left, elements_left, budget.depth_allowance())
    admission = request.admit()
    budget.charge_bytes(admission.bytes_charged).map_err((e) => primitive(e, admission.offset))?
    budget.charge_elements(admission.elements_charged).map_err((e) => primitive(e, admission.offset))?
    if not admission.admitted():
        return Err(refusal(admission.category, admission.offset, admission.field, admission.variant))
    consumed = admission.consumed
    match view.slice(0, consumed):
        None => return Err(failure(BinaryFailure.Truncated, consumed))
        Some(backing) => return Ok((RowSet.create(admission, supplied, backing), consumed))
