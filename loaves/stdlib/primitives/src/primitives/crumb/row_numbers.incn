"""Exact decimal reconstruction from bounded binary groups without host-width or float coercion."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.row_errors import RowError, RowFailure, failure, primitive


pub def unsigned_decimal(groups: list[int], radix: int, offset: int, mut budget: Budget) -> Result[str, RowError]:
    """Convert little-endian base128/base256 groups using bounded decimal digit multiply/add steps."""
    if radix not in [128, 256] or len(groups) == 0:
        return Err(failure(RowFailure.InvalidCell, offset))
    budget.charge_elements(len(groups)).map_err((e) => primitive(e, offset))?
    for group in groups:
        if group < 0 or group >= radix:
            return Err(failure(RowFailure.InvalidCell, offset))
    budget.charge_bytes(8).map_err((e) => primitive(e, offset))?
    mut digits: list[int] = [0]
    for group_index in range(len(groups) - 1, -1, -1):
        mut carry = groups[group_index] + 0
        for index in range(len(digits)):
            budget.charge_elements(1).map_err((e) => primitive(e, offset))?
            value = digits[index] * radix + carry
            digits[index] = value % 10
            carry = value // 10
        while carry > 0:
            budget.charge_elements(1).map_err((e) => primitive(e, offset))?
            budget.charge_bytes(8).map_err((e) => primitive(e, offset))?
            digits.append(carry % 10)
            carry = carry // 10
    budget.charge_bytes(len(digits)).map_err((e) => primitive(e, offset))?
    return Ok("".join([str(digits[index]) for index in range(len(digits) - 1, -1, -1)]))


pub def signed_decimal(groups: list[int], offset: int, mut budget: Budget) -> Result[str, RowError]:
    """Invert Z exactly: negative values are -(floor(U/2)+1); no negative zero is introduced."""
    if len(groups) == 0:
        return Err(failure(RowFailure.InvalidCell, offset))
    budget.charge_elements(len(groups)).map_err((e) => primitive(e, offset))?
    for group in groups:
        if group < 0 or group >= 128:
            return Err(failure(RowFailure.InvalidCell, offset))
    for _ in range(8):
        budget.charge_bytes(len(groups)).map_err((e) => primitive(e, offset))?
    mut magnitude: list[int] = [0 for _ in groups]
    mut carry = 0
    for index in range(len(groups) - 1, -1, -1):
        budget.charge_elements(1).map_err((e) => primitive(e, offset))?
        value = carry * 128 + groups[index]
        magnitude[index] = value // 2
        carry = value % 2
    negative = carry != 0
    if negative:
        mut increment = 1
        for index in range(len(magnitude)):
            value = magnitude[index] + increment
            magnitude[index] = value % 128
            increment = value // 128
        if increment != 0:
            budget.charge_bytes(8).map_err((e) => primitive(e, offset))?
            magnitude.append(increment)
    result = unsigned_decimal(magnitude, 128, offset, budget)?
    if negative:
        budget.charge_bytes(len(result) + 1).map_err((e) => primitive(e, offset))?
        return Ok("-" + result)
    return Ok(result)


pub def fixed_integer(data: bytes, signed: bool, offset: int, mut budget: Budget) -> Result[str, RowError]:
    """Read exact-width little-endian integer bytes, including u64 max and the signed minimum."""
    for _ in range(8):
        budget.charge_bytes(len(data)).map_err((e) => primitive(e, offset))?
    if len(data) not in [1, 2, 4, 8]:
        return Err(failure(RowFailure.InvalidCell, offset))
    mut groups: list[int] = [int(byte) for byte in data]
    negative = signed and len(data) > 0 and data[len(data) - 1] >= 128u8
    if negative:
        mut carry = 1
        for index in range(len(groups)):
            value = 255 - groups[index] + carry
            groups[index] = value % 256
            carry = value // 256
    result = unsigned_decimal(groups, 256, offset, budget)?
    if negative:
        budget.charge_bytes(len(result) + 1).map_err((e) => primitive(e, offset))?
        return Ok("-" + result)
    return Ok(result)
