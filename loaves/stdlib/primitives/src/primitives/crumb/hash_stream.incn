"""Incremental digest output with explicit bounded capture and counting modes."""

from crate.primitives.crumb.budget import Budget
from crate.primitives.crumb.errors import CrumbError
from crate.primitives.crumb.framing import encode_integer, encode_native_signed, encode_native_unsigned
from crate.primitives.crumb.native_numbers import normalize_decimal
from crate.primitives.crumb.ordering import absence_depth, fields_in_order, order_values, order_entries
from crate.primitives.crumb.scalars import float64_bits
from crate.primitives.crumb.spelling import selector_spelling
from crate.primitives.crumb.values import MapEntry, Projection, Value, ValueField
from crate.primitives.hash import Sha256Hasher, sha256
from crate.primitives.text import encode_utf8


pub enum OutputMode:
    """Capture is for inspecting exact preimages; ordinary hashing never retains the full output."""

    Hash
    Capture
    Count


pub class HashOutput:
    """A private operation's output state; only a completely successful traversal returns its digest."""

    mode: OutputMode
    hasher: Sha256Hasher
    data: list[u8]
    length: int = 0

    @staticmethod
    pub def create(mode: OutputMode) -> Self:
        """Start independent output; nested contributions share this output and their caller's budget."""
        return HashOutput(mode=mode, hasher=sha256.new(), data=[])

    pub def write(mut self, chunk: bytes, mut budget: Budget) -> Result[None, CrumbError]:
        """Charge before processing or retaining bytes, and check length arithmetic before incrementing."""
        budget.charge_bytes(len(chunk))?
        if len(chunk) > 9223372036854775807 - self.length:
            return Err(CrumbError.limit("output length"))
        self.length += len(chunk)
        if self.mode != OutputMode.Count:
            self.hasher.update(chunk)
        if self.mode == OutputMode.Capture:
            for byte in chunk:
                self.data.append(byte.saturating_resize[u8]())
        return Ok(None)

    pub def count(self) -> int:
        """Return processed octets, usable for framing a repeatable logical contribution."""
        return self.length

    pub def digest(mut self, mut budget: Budget) -> Result[bytes, CrumbError]:
        """Finish only a hashing mode; counting must never return an empty-input digest as success."""
        if self.mode == OutputMode.Count:
            return Err(CrumbError.invalid_input("counting output has no digest"))
        budget.charge_bytes(32)?
        return Ok(self.hasher.finalize_bytes())

    pub def captured(self, mut budget: Budget) -> Result[Option[bytes], CrumbError]:
        """Return an independent captured preimage only when the caller explicitly requested capture."""
        if self.mode != OutputMode.Capture:
            return Ok(None)
        budget.charge_bytes(self.length)?
        copy: bytes = self.data.clone()
        return Ok(Some(copy))

    pub def unsigned(mut self, value: int, mut budget: Budget) -> Result[None, CrumbError]:
        """Write an exact nonnegative count with the shared shortest-U implementation."""
        return self.write(encode_native_unsigned(value.wrapping_resize[u128](), budget)?, budget)

    pub def framed(mut self, value: bytes, mut budget: Budget) -> Result[None, CrumbError]:
        """Stream a known byte length and payload separately instead of concatenating a frame."""
        self.unsigned(len(value), budget)?
        return self.write(value, budget)

    pub def text(mut self, value: str, mut budget: Budget) -> Result[None, CrumbError]:
        """Charge a UTF-8 upper bound before encoding, without normalizing source text."""
        for _ in range(4):
            budget.charge_bytes(len(value))?
        return self.framed(encode_utf8(value), budget)

    pub def emit(mut self, value: Value, projection: Projection, mut budget: Budget) -> Result[None, CrumbError]:
        """Balance recursive depth on every error; a caller exposes the digest only after complete success."""
        budget.charge_elements(1)?
        budget.enter()?
        result = self.emit_inner(value, projection, budget)
        budget.leave()?
        return result

    def emit_inner(mut self, value: Value, projection: Projection, mut budget: Budget) -> Result[None, CrumbError]:
        """Tags and framing belong to the value profile, independently of any row codec or storage width."""
        match value:
            Value.NoneValue | Value.Some(_) =>
                if let Some(depth) = absence_depth(value, budget)?:
                    self.write(b"\x00", budget)?
                    return self.unsigned(depth, budget)
                if let Value.Some(items) = value:
                    return self.emit(items[0], projection, budget)
            Value.Boolean(flag) =>
                if flag:
                    return self.write(b"\x01\x01", budget)
                return self.write(b"\x01\x00", budget)
            Value.Integer(number) =>
                self.write(b"\x02", budget)?
                return self.write(encode_integer(number, budget)?, budget)
            Value.Float(width, bits) =>
                self.write(b"\x03", budget)?
                return self.write(float64_bits(width, bits, budget)?, budget)
            Value.Decimal(coefficient, scale) =>
                normalized = normalize_decimal(coefficient, scale)?
                self.write(b"\x04", budget)?
                self.write(encode_native_signed(normalized.coefficient, budget)?, budget)?
                return self.write(encode_native_signed(normalized.scale.wrapping_resize[i128](), budget)?, budget)
            Value.Text(text) =>
                self.write(b"\x05", budget)?
                return self.text(text, budget)
            Value.Binary(data) =>
                self.write(b"\x06", budget)?
                return self.framed(data, budget)
            Value.Withheld => return self.write(b"\x07", budget)
            Value.List(items) =>
                self.write(b"\x08", budget)?
                return self.emit_sequence(items, projection, budget)
            Value.Tuple(items) =>
                self.write(b"\x09", budget)?
                return self.emit_sequence(items, projection, budget)
            Value.Set(items) =>
                self.write(b"\x0a", budget)?
                self.unsigned(len(items), budget)?
                for index in order_values(items, projection, budget)?:
                    self.emit(items[index], projection, budget)?
            Value.Map(entries) => return self.emit_map(entries, projection, budget)
            Value.Record(fields) => return self.emit_record(fields, projection, budget)
            Value.Enum(identity, fields) =>
                self.write(b"\x0d", budget)?
                self.write(identity, budget)?
                return self.emit_record(fields, projection, budget)
            Value.Union(member, items) =>
                self.write(b"\x0e", budget)?
                self.text(selector_spelling(member, budget)?, budget)?
                return self.emit(items[0], projection, budget)
            Value.Reference(target, identity) =>
                self.write(b"\x0f", budget)?
                self.framed(target, budget)?
                return self.framed(identity, budget)
        return Ok(None)

    def emit_sequence(
        mut self,
        items: Borrowed[list[Value]],
        projection: Projection,
        mut budget: Budget,
    ) -> Result[None, CrumbError]:
        """Sequence order and multiplicity are significant; counts describe elements, not encoded bytes."""
        self.unsigned(len(items), budget)?
        for at in range(len(items)):
            self.emit(items[at], projection, budget)?
        return Ok(None)

    def emit_map(
        mut self,
        entries: Borrowed[list[MapEntry]],
        projection: Projection,
        mut budget: Budget,
    ) -> Result[None, CrumbError]:
        """Keep every admitted object entry even when several keys project to the same canonical value."""
        self.write(b"\x0b", budget)?
        self.unsigned(len(entries), budget)?
        for index in order_entries(entries, projection, budget)?:
            self.emit(entries[index].key, projection, budget)?
            self.emit(entries[index].value, projection, budget)?
        return Ok(None)

    def emit_record(
        mut self,
        fields: Borrowed[list[ValueField]],
        projection: Projection,
        mut budget: Budget,
    ) -> Result[None, CrumbError]:
        """Projection chooses fields before their identity-ordered contributions are emitted."""
        indices = fields_in_order(fields, projection, budget)?
        self.write(b"\x0c", budget)?
        self.unsigned(len(indices), budget)?
        for index in indices:
            self.write(fields[index].identity, budget)?
            self.emit(fields[index].value, projection, budget)?
        return Ok(None)
