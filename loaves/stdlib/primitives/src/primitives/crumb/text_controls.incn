"""Closed Unicode controls shared by COMIC token admission and canonical printing."""


pub const BIDIRECTIONAL_CONTROLS: FrozenSet[str] = {
    "‪",
    "‫",
    "‬",
    "‭",
    "‮",
    "⁦",
    "⁧",
    "⁨",
    "⁩",
}


pub def bidirectional_escape(character: str) -> Option[str]:
    """Return the canonical escape for one bidirectional control without encoding or hexadecimal allocation."""
    match character:
        "‪" => return Some("\\u{202a}")
        "‫" => return Some("\\u{202b}")
        "‬" => return Some("\\u{202c}")
        "‭" => return Some("\\u{202d}")
        "‮" => return Some("\\u{202e}")
        "⁦" => return Some("\\u{2066}")
        "⁧" => return Some("\\u{2067}")
        "⁨" => return Some("\\u{2068}")
        "⁩" => return Some("\\u{2069}")
        _ => return None
