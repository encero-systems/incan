"""One mutable allowance shared by all nested work in a Crumb request."""

from crate.primitives.crumb.errors import CrumbError


pub class Budget:
    """Caller-selected byte, work and nesting limits; failures never refund consumed work."""

    bytes_left: int
    elements_left: int
    depth_limit: int
    active_depth: int = 0

    @staticmethod
    pub def create(bytes: int, elements: int, depth: int) -> Result[Self, CrumbError]:
        """Create nonnegative allowances; there is no format-wide default budget."""
        if bytes < 0 or elements < 0 or depth < 0:
            return Err(CrumbError.invalid_input("budget"))
        return Ok(Budget(bytes_left=bytes, elements_left=elements, depth_limit=depth))

    pub def charge_bytes(mut self, count: int) -> Result[None, CrumbError]:
        """Charge bytes before reading or allocating, using subtraction-safe comparisons."""
        if count < 0:
            return Err(CrumbError.invalid_input("byte count"))
        if count > self.bytes_left:
            return Err(CrumbError.limit("bytes"))
        self.bytes_left -= count
        return Ok(None)

    pub def charge_elements(mut self, count: int) -> Result[None, CrumbError]:
        """Charge logical elements or bounded arithmetic steps before performing them."""
        if count < 0:
            return Err(CrumbError.invalid_input("element count"))
        if count > self.elements_left:
            return Err(CrumbError.limit("elements"))
        self.elements_left -= count
        return Ok(None)

    pub def enter(mut self) -> Result[None, CrumbError]:
        """Enter one nested value, refusing before the depth counter can exceed its limit."""
        if self.active_depth >= self.depth_limit:
            return Err(CrumbError.limit("depth"))
        self.active_depth += 1
        return Ok(None)

    pub def leave(mut self) -> Result[None, CrumbError]:
        """Balance one successful enter; an unmatched leave is an application error."""
        if self.active_depth == 0:
            return Err(CrumbError.invalid_input("unmatched depth leave"))
        self.active_depth -= 1
        return Ok(None)

    pub def snapshot(self) -> Self:
        """Return an independent allowance for a codec object that must retain its own mutable state."""
        return Budget(
            bytes_left=self.bytes_left,
            elements_left=self.elements_left,
            depth_limit=self.depth_limit,
            active_depth=self.active_depth,
        )
