"""
Foundational descriptor types of the feature catalog and the canonical forms and documentation references its entries describe.

The registry and its entries stay in `features`, whose registry identity the compiler and the generated inventory
select. Each entry records these values as its own.
"""


@derive(Clone, Eq)
pub type FeatureId = newtype str:
    """The stable typed identity of one documented Incan capability."""


pub enum FeatureCategory:
    """The user-facing area to which a capability belongs."""

    Syntax
    TypeSystem
    Stdlib
    Interop
    Testing
    Async
    Tooling
    Libraries


pub enum FeatureStability:
    """The compatibility commitment associated with a capability."""

    Stable
    Beta
    Experimental


@derive(Descriptor)
pub model CapabilityReference:
    """One human-readable document link recorded for a capability."""

    pub label: FrozenStr
    pub path: FrozenStr


@derive(Descriptor)
pub model FeatureDescriptor:
    """The checked, source-authored description of one public capability."""

    pub id: FeatureId
    pub name: str
    pub category: FeatureCategory
    pub since: str
    pub rfc: str
    pub stability: FeatureStability
    pub activation: str
    pub summary: str
    pub canonical_forms: FrozenList[str]
    pub prefer_over: str
    pub references: FrozenList[CapabilityReference]


