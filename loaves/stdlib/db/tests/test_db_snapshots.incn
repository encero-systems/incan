"""Snapshots keep one selection however the view moves on, and forks start at exactly a snapshot's selection."""

from std.fs import Path
from std.tempfile import TemporaryDirectory
from pub::incan_platform.store import begin, commit, put, snapshot as substrate_snapshot
from pub::incan_platform.store.disk import root as disk_root
from db.errors import DbError, DbErrorKind, DbOperation
from db.store import memory, open


pub def test_a_snapshot_keeps_its_selection_after_later_publications() -> Result[None, str]:
    """A snapshot names its store and view, and a later publication moves the view but never the snapshot."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    path = scratch.path().joinpath("site.db")
    store = checked(open(path))?
    published = checked(store.view("published"))?
    before = checked(published.snapshot())?
    assert before.store() == store.identity() and before.view() == "published"
    assert before.revision() == "", "an empty view selected contents"
    publish(path, "published", "page")?
    after = checked(published.snapshot())?
    assert after.revision() != "" and after.generation() > before.generation()
    assert before.revision() == "", "a later publication reached an older snapshot"
    return Ok(None)


pub def test_a_fork_starts_at_its_snapshot_and_never_replaces_a_view() -> Result[None, str]:
    """A fork selects its snapshot's root however the source moved since; a taken name is refused, not replaced."""
    scratch = TemporaryDirectory.try_new().map_err((error) => error.message())?
    path = scratch.path().joinpath("site.db")
    store = checked(open(path))?
    published = checked(store.view("published"))?
    publish(path, "published", "first")?
    base = checked(published.snapshot())?
    publish(path, "published", "second")?
    preview = checked(store.fork(base, "preview"))?
    assert checked(preview.snapshot())?.revision() == base.revision(), "the fork took the source's later root"
    assert checked(published.snapshot())?.revision() != base.revision()
    for taken in ["preview", "published"]:
        refused(store.fork(base, taken), DbErrorKind.Exists)?
    refused(store.fork(base, "two words"), DbErrorKind.InvalidName)?
    other = checked(memory())?
    foreign = checked(checked(other.view("published"))?.snapshot())?
    refused(store.fork(foreign, "foreign"), DbErrorKind.Scope)?
    mut released = checked(published.snapshot())?
    released.release()
    refused(store.fork(released, "late"), DbErrorKind.Closed)?
    assert checked(store.views())? == ["preview", "published"], "a refused fork published a view"
    return Ok(None)


pub def test_a_closed_store_refuses_new_snapshots_and_forks() -> Result[None, str]:
    """After `close()`, taking a snapshot or forking one is refused; a snapshot taken before keeps its selection."""
    store = checked(memory())?
    published = checked(store.view("published"))?
    taken = checked(published.snapshot())?
    checked(store.close())?
    match published.snapshot():
        Ok(_) =>
            assert false, "a closed store took a snapshot"
        Err(error) =>
            assert error.kind == DbErrorKind.Closed and error.operation == DbOperation.Snapshot, error.message()
    refused(store.fork(taken, "preview"), DbErrorKind.Closed)?
    assert taken.view() == "published" and not taken.is_released()
    return Ok(None)


def publish(path: Path, view: str, key: str) -> Result[None, str]:
    """Publish one record to `view` straight through the substrate, as another writer of the store would."""
    selected = substrate_snapshot(disk_root(path.0), view).map_err((error) => error.message())?
    _ = commit(put(begin(selected), key, b"value")).map_err((error) => error.message())?
    return Ok(None)


def refused[T](result: Result[T, DbError], kind: DbErrorKind) -> Result[None, str]:
    """Require a refusal of `kind`; an accepted operation or another kind fails the case."""
    match result:
        Ok(_) => return Err(f"accepted an operation that must be refused as {kind.value()}")
        Err(error) =>
            if error.kind != kind:
                return Err(f"expected {kind.value()}, got {error.message()}")
            return Ok(None)


def checked[T](result: Result[T, DbError]) -> Result[T, str]:
    """A `std.db` result with its failure as the test's message."""
    return result.map_err((error) => error.message())
