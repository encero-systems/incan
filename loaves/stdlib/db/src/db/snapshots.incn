"""Snapshots: one immutable, leased selection of a view, unchanged by every later publication."""

from pub::incan_platform.store import BindingLookup, Snapshot as Selection, lookup_binding
from crate.db.errors import DbError, DbErrorKind, DbOperation, store_failure
from crate.db.handle import StoreHandle
from crate.db.records import RecordKey, RecordState, RecordVersion, Tombstone, check_record_key


pub class Snapshot:
    """
    One immutable selection of a view.

    It never changes after it is taken: later publications reach new snapshots, never this one. It holds a lease on
    what it selects, so it stays readable after its store is closed, until `release()`.
    """

    handle: StoreHandle
    selection: Selection
    released: bool = false

    @staticmethod
    pub def of(handle: StoreHandle, selection: Selection) -> Snapshot:
        """A snapshot of `selection`, taken through the store `handle` opened."""
        return Snapshot(handle=handle, selection=selection)

    pub def store(self) -> str:
        """The identity of the store it was taken from."""
        return self.handle.identity

    pub def view(self) -> str:
        """The name of the view it selects."""
        return self.selection.view

    pub def revision(self) -> str:
        """The view revision it selects: equal revisions select equal contents, and an empty view's is empty."""
        return self.selection.index

    pub def generation(self) -> int:
        """The store generation it was taken from: a physical position, never part of what it selects."""
        return self.selection.generation

    pub def is_released(self) -> bool:
        """Whether `release()` gave up its lease."""
        return self.released

    pub def release(mut self) -> None:
        """Give up the lease. Later operations through this snapshot are refused; releasing twice does nothing."""
        self.released = true
        self.selection.pin = None

    pub def require_held(self, operation: DbOperation) -> Result[None, DbError]:
        """Refuse `operation` through a released snapshot."""
        if self.released:
            return Err(DbError.refused(DbErrorKind.Closed, operation, self.selection.view, "the snapshot was released"))
        return Ok(None)

    pub def read(self, key: RecordKey) -> Result[RecordState[bytes], DbError]:
        """
        The encoded value this snapshot holds under `key` with the revision holding it, its tombstone, or absence.

        The value is an owned copy. Damage is a corruption error, never absence or an older value. It reads through
        the snapshot's lease, so closing the store does not stop it; releasing the snapshot does.
        """
        self.require_held(DbOperation.Read)?
        check_record_key(DbOperation.Read, key)?
        found = lookup_binding(self.selection, key.store_key())
        return Ok(stored_state(found.map_err((error) => store_failure(DbOperation.Read, error))?))


pub def selection_of(snapshot: Snapshot) -> Selection:
    """The substrate selection a snapshot pins, for `std.db`'s own modules; the prelude does not export it."""
    return snapshot.selection


def stored_state(found: BindingLookup) -> RecordState[bytes]:
    """The record state of one authenticated substrate binding, keeping the revision of its frame."""
    match found:
        BindingLookup.Present(present) =>
            return RecordState.Present(RecordVersion(value=present.value, revision=Some(present.revision)))
        BindingLookup.Deleted(deleted) => return RecordState.Deleted(Tombstone(revision=Some(deleted.revision)))
        BindingLookup.Absent(_) => return RecordState.Absent
