"""Opening and closing a store, and naming and forking its views; foreign files are never adopted as a store."""

from std.fs import Path
from pub::incan_platform.store import HOME_VIEW, check_format, read_store_identity, store_identity
from pub::incan_platform.store import fork as substrate_fork, fork_selection, snapshot as substrate_snapshot
from pub::incan_platform.store.disk import root as disk_root
from pub::incan_platform.store.memory import root as memory_root
from pub::incan_platform.store.path import StorePath
from crate.db.errors import DbError, DbErrorKind, DbOperation, store_failure
from crate.db.handle import Placement, StoreHandle
from crate.db.snapshots import Snapshot, selection_of
from crate.db.names import check_name
from crate.db.views import View


pub class Store:
    """An opened store, accepting work until `close`."""

    handle: StoreHandle

    pub def placement(self) -> Placement:
        """Where the store keeps its contents."""
        return self.handle.placement

    pub def identity(self) -> str:
        """The store's persistent identity; moving a disk store's directory does not change it."""
        return self.handle.identity

    pub def is_open(self) -> bool:
        """Whether the store still accepts new work."""
        return self.handle.is_open()

    pub def close(self) -> Result[None, DbError]:
        """
        Stop new work through this store and every view taken from it.

        A snapshot already taken stays readable until it is released, because it holds its own lease. Closing a
        closed store does nothing.
        """
        self.handle.close()
        return Ok(None)

    pub def view(self, name: str) -> Result[View, DbError]:
        """
        The view named `name`, created empty when the store has no view of that name.

        Creating a view is one atomic publication. Two callers creating the same name at once both receive that one
        view; neither replaces the other.
        """
        self.handle.require_open(DbOperation.View)?
        check_name(DbOperation.View, "view name", name)?
        if name not in self.views()?:
            create_view(self.handle, name)?
        return Ok(View.of(self.handle.clone(), name))

    pub def views(self) -> Result[list[str], DbError]:
        """The names of the store's views in its current generation, in name order."""
        self.handle.require_open(DbOperation.View)?
        return view_names(self.handle, DbOperation.View)

    pub def fork(self, snapshot: Snapshot, name: str) -> Result[View, DbError]:
        """
        A new view `name` that starts at exactly `snapshot`'s selection.

        1. Refuse a closed store, a name the store cannot record, and a released snapshot or one of another store.
        2. Refuse a name that is taken: an existing view is never replaced.
        3. Publish the view at the snapshot's root. It shares every record with its source and copies none, and
           neither side's later writes reach the other.
        """
        # 1. The snapshot must be held, and taken from this store.
        self.handle.require_open(DbOperation.Fork)?
        check_name(DbOperation.Fork, "view name", name)?
        snapshot.require_held(DbOperation.Fork)?
        if snapshot.store() != self.handle.identity:
            detail = "the snapshot is of another store"
            return Err(DbError.refused(DbErrorKind.Scope, DbOperation.Fork, snapshot.store(), detail))

        # 2. A taken name is refused before publishing anything.
        if name in view_names(self.handle, DbOperation.Fork)?:
            return Err(view_exists(name))

        # 3. A concurrent fork of the same name loses under the publication lock and is refused the same way.
        match fork_selection(selection_of(snapshot), name):
            Ok(_) => return Ok(View.of(self.handle.clone(), name))
            Err(error) =>
                failed = store_failure(DbOperation.Fork, error)
                if failed.kind == DbErrorKind.Conflict:
                    return Err(view_exists(name))
                return Err(failed)


pub def memory() -> Result[Store, DbError]:
    """
    Open an isolated memory store.

    Its contents stay in this process's memory and never reach a file; they last while the store or a snapshot of
    it is held. Another memory store never sees them.
    """
    root = memory_root()
    identity = store_identity(root).map_err((error) => store_failure(DbOperation.Open, error))?
    return Ok(Store(handle=StoreHandle.opened(root, identity, Placement.Memory)))


pub def open(path: Path) -> Result[Store, DbError]:
    """
    Open the disk store at `path`, creating it when `path` is missing or an empty directory.

    1. Refuse a path that holds anything but a store, so foreign contents are never adopted or overwritten.
    2. Provision the store's persistent identity once, or read the one it has.
    3. Refuse a store written in a format this release does not read.
    """
    root = disk_root(path.0)

    # 1. A file, or a directory with contents and no store identity, is not a store.
    refuse_foreign(root)?

    # 2. Provisioning holds the store's own lock, so two processes opening one new store agree on its identity.
    identity = store_identity(root).map_err((error) => store_failure(DbOperation.Open, error))?

    # 3. An unknown format is refused, never read as an empty store.
    check_format(root).map_err((error) => store_failure(DbOperation.Open, error))?
    return Ok(Store(handle=StoreHandle.opened(root, identity, Placement.Disk)))


def refuse_foreign(root: StorePath) -> Result[None, DbError]:
    """Refuse a path that exists but is not a store: a file, or a directory with contents and no store identity."""
    if not root.exists():
        return Ok(None)
    if not root.is_dir():
        return Err(not_a_store(root, "the path is not a directory"))
    if read_store_identity(root).is_ok():
        return Ok(None)
    children = root.store_children().map_err(
        (error) => DbError.refused(DbErrorKind.Io, DbOperation.Open, root.value, error.message()),
    )?
    if len(children) > 0:
        return Err(not_a_store(root, "the directory holds files and has no store identity"))
    return Ok(None)


def not_a_store(root: StorePath, detail: str) -> DbError:
    """The refusal to open a path that holds something other than a store."""
    return DbError.refused(DbErrorKind.Scope, DbOperation.Open, root.value, detail)


def view_names(handle: StoreHandle, operation: DbOperation) -> Result[list[str], DbError]:
    """The view names the store's current generation records, in name order."""
    current = substrate_snapshot(handle.root, HOME_VIEW).map_err((error) => store_failure(operation, error))?
    return Ok([entry.view for entry in current.views])


def view_exists(name: str) -> DbError:
    """The refusal to fork onto a name that is already a view."""
    return DbError.refused(DbErrorKind.Exists, DbOperation.Fork, name, "a view of this name already exists")


def create_view(handle: StoreHandle, name: str) -> Result[None, DbError]:
    """
    Publish an empty view `name`.

    The substrate forks the absent view of that name, whose root is empty, under its publication lock. When another
    caller published the name first, the fork is refused as a conflict and the name exists: that is the same view.
    """
    absent = substrate_snapshot(handle.root, name).map_err((error) => store_failure(DbOperation.View, error))?
    match substrate_fork(absent, name):
        Ok(_) => return Ok(None)
        Err(error) =>
            failed = store_failure(DbOperation.View, error)
            if failed.kind == DbErrorKind.Conflict and name in view_names(handle, DbOperation.View)?:
                return Ok(None)
            return Err(failed)
