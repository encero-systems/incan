"""
Typed embedded storage over the platform's store substrate (RFC 165).

Open a store with `memory()` or `open(path)` and select a named view with `store.view(name)`. Read a view through
`view.snapshot()`, change it through `view.begin()` and the transaction's `commit()` or `abort()`, and start a new view
from a snapshot with `store.fork(snapshot, name)`. Release the store with `close()`. Every operation returns
`Result[..., DbError]`; match on `DbError.kind`, never on its detail text.
"""

pub from crate.db.errors import DbError, DbErrorKind, DbOperation
pub from crate.db.handle import Placement
pub from crate.db.receipts import CommitReceipt, Durability
pub from crate.db.records import RecordKey, RecordState, RecordVersion, Tombstone
pub from crate.db.snapshots import Snapshot
pub from crate.db.store import Store, memory, open
pub from crate.db.transactions import Transaction, TransactionState
pub from crate.db.views import View
