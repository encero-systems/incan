static checked_c_binding: RegistryEntry[FeatureId, FeatureDescriptor] = features.entry(
    key=FeatureId("CheckedCBindingFoundation"),
    subject=RegistrySubject.current_unit(),
    descriptor=FeatureDescriptor(
        id=FeatureId("CheckedCBindingFoundation"),
        name="Checked C binding foundation",
        category=FeatureCategory.Interop,
        since="0.5",
        rfc="RFC 116",
        stability=FeatureStability.Experimental,
        activation="Import `c` from `std.interop`, then declare a `binding` in the importing module.",
        summary="Explicit C headers, exact scalar signatures (`i8`–`i128`, `u8`–`u128`, `usize`, `f32`, `f64`), opaque resources, output positions, paired byte or `f32` spans, bounded C-string text bridges, enum carriers, and plain layouts are verified before private generated C ABI calls.",
        canonical_forms=checked_c_binding_forms,
        prefer_over="Unverified Rust wrappers, ambient header discovery, string-based dynamic symbol lookup, or general raw-pointer access.",
        references=checked_c_binding_references,
    ),
)
