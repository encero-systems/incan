"""
Reflection helpers for models and classes.
"""

pub class FieldInfo:
    """
    Compiler-provided field metadata returned by __fields__().
    Instances are immutable and read-only.
    """
    pub name: FrozenStr
    pub alias: Option[FrozenStr]
    pub description: Option[FrozenStr]
    pub wire_name: FrozenStr
    pub type_name: FrozenStr
    pub has_default: bool
    pub extra: FrozenDict[FrozenStr, FrozenStr]
