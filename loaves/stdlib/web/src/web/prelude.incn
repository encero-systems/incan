"""
Web Framework Prelude

Re-exports common types for convenient imports.

Example:
    from std.web import App, route, Response, Json

    @route("/")
    async def index() -> Response:
        return Response.html("<h1>Hello from Incan!</h1>")

    @route("/api/greet/{name}")
    async def greet(name: str) -> Json[Greeting]:
        return Json(Greeting(message=f"Hello, {name}!"))

    model Greeting with Serialize:
        message: str

    def main():
        App.run(host="127.0.0.1", port=8080)

Compiles to Axum with Tokio — native Rust performance, no GC.

Note: ``from std.web import route`` relies on this prelude re-exporting ``route``
from ``std.web.routing`` with ``pub from``.
"""

pub from crate.web.app import App
pub from crate.web.response import Json, Html, Response
pub from crate.web.request import Query, Path
pub from crate.web.macros import IntoResponse, FromRequestParts
pub from crate.web.routing import route
pub from crate.web.routing import GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS
