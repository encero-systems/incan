"""Dense graph slots and per-node insertion-order adjacency shared by in-memory graph containers."""

from crate.graph._ids import (
    EdgeId,
    GraphError,
    NodeId,
    duplicate_edge,
    insert_sorted_node,
    missing_edge,
    unknown_edge,
    unknown_node,
)


model _NodeSlot[T]:
    """One never-reused node slot and its adjacency accounting."""

    pub payload: T
    pub active: bool
    pub outgoing: list[EdgeId]
    pub incoming: list[EdgeId]
    pub outgoing_by_target: list[EdgeId]
    pub outgoing_live: int
    pub incoming_live: int
    pub outgoing_tombstones: int
    pub incoming_tombstones: int


model _EdgeSlot:
    """One never-reused edge slot."""

    pub from_: NodeId
    pub to: NodeId
    pub active: bool


pub model _GraphStore[T]:
    """Indexed storage with dense id slots and local adjacency lists."""

    next_node_id: int = 0
    next_edge_id: int = 0
    nodes: list[_NodeSlot[T]] = []
    edges: list[_EdgeSlot] = []

    @staticmethod
    def __incan_new() -> Self:
        """Create an empty indexed store."""
        return _GraphStore(next_node_id=0, next_edge_id=0, nodes=[], edges=[])

    pub def add_node(mut self, payload: T) -> NodeId:
        """Append one dense node slot and return its never-reused id."""
        id = NodeId(self.next_node_id)
        self.next_node_id += 1
        self.nodes.append(
            _NodeSlot(
                payload=payload,
                active=true,
                outgoing=[],
                incoming=[],
                outgoing_by_target=[],
                outgoing_live=0,
                incoming_live=0,
                outgoing_tombstones=0,
                incoming_tombstones=0,
            ),
        )
        return id

    pub def remove_node(mut self, node: NodeId) -> Result[None, GraphError]:
        """Tombstone `node` and every incident edge."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        mut incident = self.nodes[index].outgoing
        for edge in self.nodes[index].incoming:
            incident.append(edge)
        for edge in incident:
            self.remove_edge_if_live(edge)
        self.nodes[index].active = false
        return Ok(None)

    pub def contains_node(self, node: NodeId) -> bool:
        """Return whether `node` names a live dense slot."""
        return self.node_index(node) >= 0

    pub def node_payload(self, node: NodeId) -> Result[T, GraphError]:
        """Return the payload value stored for `node`."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        return Ok(self.nodes[index].payload)

    pub def insert_edge(mut self, from_: NodeId, to: NodeId, allow_parallel: bool) -> Result[EdgeId, GraphError]:
        """Append one edge and index it in both endpoint adjacency lists."""
        if not self.contains_node(from_):
            return Err(unknown_node(from_))
        if not self.contains_node(to):
            return Err(unknown_node(to))
        if not allow_parallel and self.contains_pair(from_, to):
            return Err(duplicate_edge(from_, to))
        edge = EdgeId(self.next_edge_id)
        self.next_edge_id += 1
        self.edges.append(_EdgeSlot(from_=from_, to=to, active=true))
        if not allow_parallel:
            self.index_simple_edge(from_, edge)
        self.attach_outgoing(from_, edge)
        self.attach_incoming(to, edge)
        return Ok(edge)

    pub def remove_pair(mut self, from_: NodeId, to: NodeId) -> Result[None, GraphError]:
        """Remove the first live edge connecting `from_ -> to`."""
        from_index = self.node_index(from_)
        if from_index < 0:
            return Err(unknown_node(from_))
        if self.node_index(to) < 0:
            return Err(unknown_node(to))
        edge = self.simple_edge(from_, to)
        if self.edge_index(edge) >= 0:
            return self.remove_edge(edge)
        return Err(missing_edge(from_, to))

    pub def remove_edge(mut self, edge: EdgeId) -> Result[None, GraphError]:
        """Tombstone one edge and update both endpoint adjacency lists."""
        if self.edge_index(edge) < 0:
            return Err(unknown_edge(edge))
        self.remove_edge_if_live(edge)
        return Ok(None)

    pub def contains_pair(self, from_: NodeId, to: NodeId) -> bool:
        """Return whether a live edge connects `from_ -> to`."""
        if self.node_index(from_) < 0 or self.node_index(to) < 0:
            return false
        return self.edge_index(self.simple_edge(from_, to)) >= 0

    pub def contains_edge(self, edge: EdgeId) -> bool:
        """Return whether `edge` names a live edge slot."""
        return self.edge_index(edge) >= 0

    pub def edge_endpoints(self, edge: EdgeId) -> Result[Tuple[NodeId, NodeId], GraphError]:
        """Return the endpoints stored for one live edge."""
        index = self.edge_index(edge)
        if index < 0:
            return Err(unknown_edge(edge))
        slot = self.edges[index]
        return Ok((slot.from_, slot.to))

    pub def edges_between(self, from_: NodeId, to: NodeId) -> Result[list[EdgeId], GraphError]:
        """Return live parallel edges in insertion order."""
        from_index = self.node_index(from_)
        if from_index < 0:
            return Err(unknown_node(from_))
        if self.node_index(to) < 0:
            return Err(unknown_node(to))
        mut found: list[EdgeId] = []
        for edge in self.nodes[from_index].outgoing:
            if self.edge_connects(edge, from_, to):
                found.append(edge)
        return Ok(found)

    pub def successors(self, node: NodeId) -> Result[list[NodeId], GraphError]:
        """Return distinct live targets in ascending `NodeId` order."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        mut found: list[NodeId] = []
        for edge in self.nodes[index].outgoing:
            edge_index = self.edge_index(edge)
            if edge_index >= 0:
                insert_sorted_node(found, self.edges[edge_index].to)
        return Ok(found)

    pub def predecessors(self, node: NodeId) -> Result[list[NodeId], GraphError]:
        """Return distinct live sources in ascending `NodeId` order."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        mut found: list[NodeId] = []
        for edge in self.nodes[index].incoming:
            edge_index = self.edge_index(edge)
            if edge_index >= 0:
                insert_sorted_node(found, self.edges[edge_index].from_)
        return Ok(found)

    pub def active_node_ids(self) -> list[NodeId]:
        """Return live node ids in ascending allocation order."""
        mut ids: list[NodeId] = []
        for index in range(len(self.nodes)):
            if self.nodes[index].active:
                ids.append(NodeId(index))
        return ids

    pub def active_edge_ids(self) -> list[EdgeId]:
        """Return live edge ids in ascending allocation order."""
        mut ids: list[EdgeId] = []
        for index in range(len(self.edges)):
            if self.edges[index].active:
                ids.append(EdgeId(index))
        return ids

    pub def adjacency_physical_count(self, node: NodeId) -> Result[int, GraphError]:
        """Return the number of physical outgoing adjacency entries."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        return Ok(len(self.nodes[index].outgoing))

    pub def adjacency_live_count(self, node: NodeId) -> Result[int, GraphError]:
        """Return the number of live outgoing adjacency entries."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        return Ok(self.nodes[index].outgoing_live)

    pub def adjacency_tombstone_count(self, node: NodeId) -> Result[int, GraphError]:
        """Return the number of tombstoned outgoing adjacency entries."""
        index = self.node_index(node)
        if index < 0:
            return Err(unknown_node(node))
        return Ok(self.nodes[index].outgoing_tombstones)

    pub def node_index(self, node: NodeId) -> int:
        """Return the dense live node slot, or `-1`."""
        index = node.to_int()
        if index < 0 or index >= len(self.nodes) or not self.nodes[index].active:
            return -1
        return index

    pub def edge_index(self, edge: EdgeId) -> int:
        """Return the dense live edge slot, or `-1`."""
        index = edge.to_int()
        if index < 0 or index >= len(self.edges) or not self.edges[index].active:
            return -1
        return index

    def edge_connects(self, edge: EdgeId, from_: NodeId, to: NodeId) -> bool:
        """Return whether one live edge has the requested endpoints."""
        index = self.edge_index(edge)
        if index < 0:
            return false
        slot = self.edges[index]
        return slot.from_ == from_ and slot.to == to

    def simple_edge(self, from_: NodeId, to: NodeId) -> EdgeId:
        """Find a simple edge by target through the source node's sorted local index."""
        index = self.node_index(from_)
        if index < 0:
            return EdgeId(-1)
        mut left = 0
        mut right = len(self.nodes[index].outgoing_by_target)
        while left < right:
            middle = (left + right) // 2
            candidate = self.nodes[index].outgoing_by_target[middle]
            target = self.edges[candidate.to_int()].to
            if target == to:
                return candidate
            if target.to_int() < to.to_int():
                left = middle + 1
            else:
                right = middle
        return EdgeId(-1)

    def index_simple_edge(mut self, from_: NodeId, edge: EdgeId) -> None:
        """Insert or replace one edge in the source node's target-sorted local index."""
        index = from_.to_int()
        target = self.edges[edge.to_int()].to
        mut left = 0
        mut right = len(self.nodes[index].outgoing_by_target)
        while left < right:
            middle = (left + right) // 2
            existing = self.nodes[index].outgoing_by_target[middle]
            existing_target = self.edges[existing.to_int()].to
            if existing_target == target:
                self.nodes[index].outgoing_by_target[middle] = edge
                return
            if existing_target.to_int() < target.to_int():
                left = middle + 1
            else:
                right = middle
        self.nodes[index].outgoing_by_target.append(edge)
        mut position = len(self.nodes[index].outgoing_by_target) - 1
        while position > left:
            self.nodes[index].outgoing_by_target.swap(position - 1, position)
            position -= 1

    def attach_outgoing(mut self, node: NodeId, edge: EdgeId) -> None:
        """Append one outgoing adjacency entry."""
        index = node.to_int()
        self.nodes[index].outgoing.append(edge)
        self.nodes[index].outgoing_live += 1

    def attach_incoming(mut self, node: NodeId, edge: EdgeId) -> None:
        """Append one incoming adjacency entry."""
        index = node.to_int()
        self.nodes[index].incoming.append(edge)
        self.nodes[index].incoming_live += 1

    def remove_edge_if_live(mut self, edge: EdgeId) -> None:
        """Tombstone a live edge once and update endpoint counters."""
        index = self.edge_index(edge)
        if index < 0:
            return
        mut stored = self.edges[index]
        stored.active = false
        self.edges[index] = stored
        self.record_outgoing_tombstone(stored.from_)
        self.record_incoming_tombstone(stored.to)

    def record_outgoing_tombstone(mut self, node: NodeId) -> None:
        """Update outgoing degree and compact when tombstones outnumber live entries."""
        index = node.to_int()
        self.nodes[index].outgoing_live -= 1
        self.nodes[index].outgoing_tombstones += 1
        if self.nodes[index].outgoing_tombstones > self.nodes[index].outgoing_live:
            self.compact_outgoing(index)

    def record_incoming_tombstone(mut self, node: NodeId) -> None:
        """Update incoming degree and compact when tombstones outnumber live entries."""
        index = node.to_int()
        self.nodes[index].incoming_live -= 1
        self.nodes[index].incoming_tombstones += 1
        if self.nodes[index].incoming_tombstones > self.nodes[index].incoming_live:
            self.compact_incoming(index)

    def compact_outgoing(mut self, index: int) -> None:
        """Discard outgoing tombstone references in insertion order."""
        mut compacted: list[EdgeId] = []
        for edge in self.nodes[index].outgoing:
            if self.edge_index(edge) >= 0:
                compacted.append(edge)
        self.nodes[index].outgoing = compacted
        self.nodes[index].outgoing_tombstones = 0

    def compact_incoming(mut self, index: int) -> None:
        """Discard incoming tombstone references in insertion order."""
        mut compacted: list[EdgeId] = []
        for edge in self.nodes[index].incoming:
            if self.edge_index(edge) >= 0:
                compacted.append(edge)
        self.nodes[index].incoming = compacted
        self.nodes[index].incoming_tombstones = 0
