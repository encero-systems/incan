"""
Indexed directed graph primitives implemented in Incan.

RFC 047's value-owned containers remain available while RFC 166 seals their physical layout behind an indexed store.
"""

pub from std.traits.error import Error
pub from crate.graph._ids import EdgeId, GraphError, NodeId
pub from crate.graph._legacy import Dag, DiGraph, MultiDiGraph
pub from crate.graph._read import (
    EdgePage,
    GraphEdgeItem,
    GraphOrdering,
    GraphPageBudget,
    GraphPageToken,
    GraphProvider,
    GraphRead,
    GraphReadError,
    GraphReadErrorKind,
    GraphScope,
    GraphSelection,
    MemoryGraphFailure,
    NodePage,
    PageCounters,
    RelationGraph,
    ScopedEdgeId,
    ScopedNodeId,
)


pub model GraphNode[T]:
    """Standalone node record with a graph-local identifier, payload, and active flag."""

    pub id: NodeId
    pub payload: T
    pub active: bool


pub model GraphEdge:
    """Standalone directed edge record with graph-local identifiers and an active flag."""

    pub id: EdgeId
    pub from_: NodeId
    pub to: NodeId
    pub active: bool
