"""
Indexed directed graph primitives implemented in Incan.

RFC 047's value-owned containers remain available while RFC 166 seals their physical layout behind an indexed store.
"""

pub from crate.graph._ids import EdgeId, GraphError, NodeId
pub from crate.graph._legacy import Dag, DiGraph, MultiDiGraph


@made_private(since="0.6", message="Graph storage records are private; use node ids and graph operations", replacement=NodeId)
model GraphNode[T]:
    """Former public node-storage record retained only as a migration tombstone."""

    id: NodeId
    payload: T
    active: bool


@made_private(since="0.6", message="Graph storage records are private; use edge ids and graph operations", replacement=EdgeId)
model GraphEdge:
    """Former public edge-storage record retained only as a migration tombstone."""

    id: EdgeId
    from_: NodeId
    to: NodeId
    active: bool
