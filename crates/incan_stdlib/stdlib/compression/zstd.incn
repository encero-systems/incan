from rust::std::io import Cursor
from rust::zstd::stream @ "0.13" import decode_all, encode_all
from std.compression.common import Codec, CompressionError, _codec_error, _level_or_default, _read_all, _validate_chunk_size, _write_all
from std.io import _BytesIO


pub def compress(data: bytes, level: Option[int] = None) -> Result[bytes, CompressionError]:
    """
    Compress bytes as a zstd frame.
    """
    match encode_all(Cursor.new(data), _zstd_level(level)?):
        Ok(out) => return Ok(out)
        Err(err) => return Err(_codec_error(Codec.Zstd, "compress", err))


pub def decompress(data: bytes) -> Result[bytes, CompressionError]:
    """
    Decompress a zstd frame.
    """
    match decode_all(Cursor.new(data)):
        Ok(out) => return Ok(out)
        Err(err) => return Err(_codec_error(Codec.Zstd, "decompress", err))


pub def compress_stream(
    source: _BytesIO,
    target: _BytesIO,
    level: Option[int] = None,
    chunk_size: int = 65536,
) -> Result[None, CompressionError]:
    _validate_chunk_size(Some(Codec.Zstd), chunk_size, "compress_stream")?
    data = _read_all(source, chunk_size, "compress_stream")?
    _write_all(target, compress(data, level)?, "compress_stream")?
    return Ok(None)


pub def decompress_stream(
    source: _BytesIO,
    target: _BytesIO,
    chunk_size: int = 65536,
) -> Result[None, CompressionError]:
    _validate_chunk_size(Some(Codec.Zstd), chunk_size, "decompress_stream")?
    data = _read_all(source, chunk_size, "decompress_stream")?
    _write_all(target, decompress(data)?, "decompress_stream")?
    return Ok(None)


def _zstd_level(level: Option[int]) -> Result[i32, CompressionError]:
    selected = _level_or_default(Codec.Zstd, level, 0, -7, 22)?
    maybe: Option[i32] = selected.try_resize()
    match maybe:
        Some(value) => return Ok(value)
        None => return Err(_codec_error(Codec.Zstd, "compress", "level does not fit i32"))
