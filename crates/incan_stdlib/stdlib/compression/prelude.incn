"""
Codec-based compression and decompression.

`std.compression` exposes explicit codec submodules for normal workflows and top-level autodetection helpers for
decompression when the caller deliberately opts in.
"""

from std.io import _BytesIO
from std.compression.common import (
    Codec,
    CompressionError,
    _allowed,
    _looks_like_bz2,
    _looks_like_gzip,
    _looks_like_snappy_frame,
    _looks_like_xz,
    _looks_like_zlib,
    _looks_like_zstd,
    _read_all,
    _validate_allowed,
    _write_all,
)
from std.compression.gzip import compress as _gzip_compress, decompress as _gzip_decompress
from std.compression.zlib import compress as _zlib_compress, decompress as _zlib_decompress
from std.compression.deflate import compress as _deflate_compress, decompress as _deflate_decompress
from std.compression.zstd import compress as _zstd_compress, decompress as _zstd_decompress
from std.compression.bz2 import compress as _bz2_compress, decompress as _bz2_decompress
from std.compression.lzma import compress as _lzma_compress, decompress as _lzma_decompress
from std.compression.snappy import compress as _snappy_compress, decompress as _snappy_decompress


pub def decompress_auto(data: bytes, allowed: list[Codec] = Codec.all()) -> Result[tuple[Codec, bytes], CompressionError]:
    """
    Decompress bytes by explicit signature-based autodetection.
    """
    _validate_allowed(allowed)?
    if _allowed(allowed.clone(), Codec.Gzip) and _looks_like_gzip(data):
        return Ok((Codec.Gzip, _gzip_decompress(data)?))
    elif _allowed(allowed, Codec.Zstd) and _looks_like_zstd(data):
        return Ok((Codec.Zstd, _zstd_decompress(data)?))
    elif _allowed(allowed, Codec.Bz2) and _looks_like_bz2(data):
        return Ok((Codec.Bz2, _bz2_decompress(data)?))
    elif _allowed(allowed, Codec.Lzma) and _looks_like_xz(data):
        return Ok((Codec.Lzma, _lzma_decompress(data)?))
    elif _allowed(allowed, Codec.Snappy) and _looks_like_snappy_frame(data):
        return Ok((Codec.Snappy, _snappy_decompress(data)?))
    elif _allowed(allowed, Codec.Zlib) and _looks_like_zlib(data):
        return Ok((Codec.Zlib, _zlib_decompress(data)?))
    return Err(
        CompressionError(
            kind="unsupported_codec",
            codec=None,
            operation="decompress_auto",
            detail="no allowed compression codec matched the input signature",
        ),
    )


pub def decompress_auto_stream(
    source: _BytesIO,
    target: _BytesIO,
    allowed: list[Codec] = Codec.all(),
    chunk_size: int = 65536,
) -> Result[Codec, CompressionError]:
    """
    Decompress a binary stream by explicit signature-based autodetection.
    """
    data = _read_all(source, chunk_size, "decompress_auto_stream")?
    codec, _plain = decompress_auto(data, allowed)?
    _write_all(target, _plain, "decompress_auto_stream")?
    return Ok(codec)
