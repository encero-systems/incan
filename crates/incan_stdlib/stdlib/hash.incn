def _digest_bytes(data: bytes, algorithm: str, length: int) -> Result[bytes, HashError]:
    if algorithm == "sha224":
        return Ok(Sha224.digest(data).to_vec())
    elif algorithm == "sha256":
        return Ok(Sha256.digest(data).to_vec())
    elif algorithm == "sha384":
        return Ok(Sha384.digest(data).to_vec())
    elif algorithm == "sha512":
        return Ok(Sha512.digest(data).to_vec())
    elif algorithm == "sha3_224":
        return Ok(Sha3_224.digest(data).to_vec())
    elif algorithm == "sha3_256":
        return Ok(Sha3_256.digest(data).to_vec())
    elif algorithm == "sha3_384":
        return Ok(Sha3_384.digest(data).to_vec())
    elif algorithm == "sha3_512":
        return Ok(Sha3_512.digest(data).to_vec())
    elif algorithm == "shake128":
        if length <= 0:
            return Err(_invalid_error(algorithm, "invalid_length", "SHAKE digest length must be positive"))
        mut hasher = shake128.new()
        hasher.update(data)
        return hasher.finalize_bytes(length)
    elif algorithm == "shake256":
        if length <= 0:
            return Err(_invalid_error(algorithm, "invalid_length", "SHAKE digest length must be positive"))
        mut hasher = shake256.new()
        hasher.update(data)
        return hasher.finalize_bytes(length)
    elif algorithm == "blake2b":
        return Ok(Blake2b512.digest(data).to_vec())
    elif algorithm == "blake2s":
        return Ok(Blake2s256.digest(data).to_vec())
    elif algorithm == "blake3":
        return Ok(blake3_hash(data.as_slice()).as_bytes().to_vec())
    elif algorithm == "md5":
        return Ok(Md5.digest(data).to_vec())
    elif algorithm == "sha1":
        return Ok(Sha1.digest(data).to_vec())
    elif algorithm == "xxh32":
        return Ok(u32_to_le_bytes(_xxh32_hash(data)))
    elif algorithm == "xxh64":
        return Ok(u64_to_le_bytes(_xxh64_hash(data)))
    elif algorithm == "xxh3_64":
        return Ok(u64_to_le_bytes(_xxh3_64_hash(data)))
    elif algorithm == "xxh3_128":
        return Ok(u128_to_le_bytes(_xxh3_128_hash(data)))
    return Err(_invalid_error(algorithm, "unknown_algorithm", f"unknown hash algorithm: {algorithm}"))


def _hash_u32(data: bytes, algorithm: str) -> Result[u32, HashError]:
    if algorithm == "xxh32":
        return Ok(_xxh32_hash(data))
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u32 hash"))


def _hash_u64(data: bytes, algorithm: str) -> Result[u64, HashError]:
    if algorithm == "xxh3_64":
        return Ok(_xxh3_64_hash(data))
    elif algorithm == "xxh64":
        return Ok(_xxh64_hash(data))
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u64 hash"))


def _hash_u128(data: bytes, algorithm: str) -> Result[u128, HashError]:
    if algorithm == "xxh3_128":
        return Ok(_xxh3_128_hash(data))
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u128 hash"))


def _xxh32_hash(data: bytes) -> u32:
    mut hasher = xxh32.new()
    hasher.update(data)
    return hasher.finalize_u32()


def _xxh64_hash(data: bytes) -> u64:
    mut hasher = xxh64.new()
    hasher.update(data)
    return hasher.finalize_u64()


def _xxh3_64_hash(data: bytes) -> u64:
    mut hasher = xxh3_64.new()
    hasher.update(data)
    return hasher.finalize_u64()


def _xxh3_128_hash(data: bytes) -> u128:
    mut hasher = xxh3_128.new()
    hasher.update(data)
    return hasher.finalize_u128()


def _must_digest_bytes(data: bytes, algorithm: str, length: int) -> bytes:
    match _digest_bytes(data, algorithm, length):
        Ok(value) => return value
        Err(err) => return raise_value_error(err.detail)


def _must_hash_u32(data: bytes, algorithm: str) -> u32:
    match _hash_u32(data, algorithm):
        Ok(value) => return value
        Err(err) => return raise_value_error(err.detail)


def _must_hash_u64(data: bytes, algorithm: str) -> u64:
    match _hash_u64(data, algorithm):
        Ok(value) => return value
        Err(err) => return raise_value_error(err.detail)


def _must_hash_u128(data: bytes, algorithm: str) -> u128:
    match _hash_u128(data, algorithm):
        Ok(value) => return value
        Err(err) => return raise_value_error(err.detail)


def _hash_path(input: Union[Path, File]) -> Path:
    if isinstance(input, File):
        return input.path
    elif isinstance(input, Path):
        return input


def _zeros(size: int) -> bytes:
    mut out = Vec.new()
    mut index = 0
    while index < size:
        out.push(ZERO_BYTE)
        index += 1
    return out


def _invalid_error(algorithm: str, kind: str, detail: str) -> HashError:
    return HashError(kind=kind, algorithm=algorithm, detail=detail)


def _io_error(algorithm: str, kind: str, detail: str) -> HashError:
    return HashError(kind=kind, algorithm=algorithm, detail=detail)


def _is_shake(algorithm: str) -> bool:
    return algorithm == "shake128" or algorithm == "shake256"
