def _file_digest_handle(file: File, algorithm: str, chunk_size: int, length: int) -> Result[bytes, HashError]:
    if algorithm == "sha224":
        return _feed_digest_hasher(sha224.new(), file, algorithm, chunk_size)
    elif algorithm == "sha256":
        return _feed_digest_hasher(sha256.new(), file, algorithm, chunk_size)
    elif algorithm == "sha384":
        return _feed_digest_hasher(sha384.new(), file, algorithm, chunk_size)
    elif algorithm == "sha512":
        return _feed_digest_hasher(sha512.new(), file, algorithm, chunk_size)
    elif algorithm == "sha3_224":
        return _feed_digest_hasher(sha3_224.new(), file, algorithm, chunk_size)
    elif algorithm == "sha3_256":
        return _feed_digest_hasher(sha3_256.new(), file, algorithm, chunk_size)
    elif algorithm == "sha3_384":
        return _feed_digest_hasher(sha3_384.new(), file, algorithm, chunk_size)
    elif algorithm == "sha3_512":
        return _feed_digest_hasher(sha3_512.new(), file, algorithm, chunk_size)
    elif algorithm == "shake128":
        return _feed_shake_hasher(shake128.new(), file, algorithm, chunk_size, length)
    elif algorithm == "shake256":
        return _feed_shake_hasher(shake256.new(), file, algorithm, chunk_size, length)
    elif algorithm == "blake2b":
        return _feed_digest_hasher(blake2b.new(), file, algorithm, chunk_size)
    elif algorithm == "blake2s":
        return _feed_digest_hasher(blake2s.new(), file, algorithm, chunk_size)
    elif algorithm == "blake3":
        return _feed_digest_hasher(blake3.new(), file, algorithm, chunk_size)
    elif algorithm == "md5":
        return _feed_digest_hasher(md5.new(), file, algorithm, chunk_size)
    elif algorithm == "sha1":
        return _feed_digest_hasher(sha1.new(), file, algorithm, chunk_size)
    elif algorithm == "xxh32":
        return _feed_hash32_hasher(xxh32.new(), file, algorithm, chunk_size)
    elif algorithm == "xxh64":
        return _feed_hash64_hasher(xxh64.new(), file, algorithm, chunk_size)
    elif algorithm == "xxh3_64":
        return _feed_hash64_hasher(xxh3_64.new(), file, algorithm, chunk_size)
    elif algorithm == "xxh3_128":
        return _feed_hash128_hasher(xxh3_128.new(), file, algorithm, chunk_size)
    return Err(_invalid_error(algorithm, "unknown_algorithm", f"unknown hash algorithm: {algorithm}"))


def _file_hash_u32_handle(file: File, algorithm: str, chunk_size: int) -> Result[u32, HashError]:
    if algorithm == "xxh32":
        return _feed_hash32_value(xxh32.new(), file, algorithm, chunk_size)
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u32 hash"))


def _file_hash_u64_handle(file: File, algorithm: str, chunk_size: int) -> Result[u64, HashError]:
    if algorithm == "xxh3_64":
        return _feed_hash64_value(xxh3_64.new(), file, algorithm, chunk_size)
    elif algorithm == "xxh64":
        return _feed_hash64_value(xxh64.new(), file, algorithm, chunk_size)
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u64 hash"))


def _file_hash_u128_handle(file: File, algorithm: str, chunk_size: int) -> Result[u128, HashError]:
    if algorithm == "xxh3_128":
        return _feed_hash128_value(xxh3_128.new(), file, algorithm, chunk_size)
    return Err(_invalid_error(algorithm, "unsupported_width", f"{algorithm} does not expose a u128 hash"))


def _feed_digest_hasher[H with ByteDigestHasher](
    mut hasher: H,
    file: File,
    algorithm: str,
    chunk_size: int,
) -> Result[bytes, HashError]:
    while true:
        match file.read_bytes(chunk_size):
            Ok(chunk) =>
                if len(chunk) == 0:
                    return Ok(hasher.finalize_bytes())
                hasher.update(chunk)
            Err(err) => return Err(_io_error(algorithm, err.kind, err.detail))


def _feed_shake_hasher[H with ShakeDigestHasher](
    mut hasher: H,
    file: File,
    algorithm: str,
    chunk_size: int,
    length: int,
) -> Result[bytes, HashError]:
    while true:
        match file.read_bytes(chunk_size):
            Ok(chunk) =>
                if len(chunk) == 0:
                    return hasher.finalize_bytes(length)
                hasher.update(chunk)
            Err(err) => return Err(_io_error(algorithm, err.kind, err.detail))


