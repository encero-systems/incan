pub class _Xxh3_128Hasher with Hash128DigestHasher:
    handle: Xxh3Default

    def update(mut self, chunk: bytes) -> None:
        self.handle.update(chunk.as_slice())

    def finalize_bytes(mut self) -> bytes:
        return u128_to_le_bytes(self.finalize_u128())

    def finalize_u128(mut self) -> u128:
        return self.handle.digest128()


pub class sha224:
    @staticmethod
    def digest(data: bytes) -> bytes:
        return _must_digest_bytes(data, "sha224", 0)

    @staticmethod
    def new() -> _Sha224Hasher:
        return _Sha224Hasher(handle=Sha224.new())


