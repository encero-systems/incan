@route("/oven-loaf", methods=[GET])
async def oven_loaf_route() -> Response:
    """Provide one checked web-routing surface for the foundation Loaf."""
    return Response.ok()


def main() -> None:
    """Verify filesystem and external UUID behavior without relying on ambient Cargo state."""
    assert_true(Path(".").exists())
    identifier = Uuid.new_v4().to_string()
    assert_true(len(identifier) > 0)
