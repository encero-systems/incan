"""Exercise integer-list sorting while proving that the input list remains reusable."""


def sorted_int_list() -> int:
    """Return a deterministic score that combines original and sorted traversal order."""
    values = [3, -1, 3, 2]
    ordered = sorted(values)
    mut original_score = 0
    for original_value in values:
        original_score = original_score * 10 + original_value
    mut ordered_score = 0
    for ordered_value in ordered:
        ordered_score = ordered_score * 10 + ordered_value
    println("sorted int list")
    return original_score * 10000 + ordered_score + 1000
