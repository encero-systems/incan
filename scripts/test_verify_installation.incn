"""Verify the installed-verification gate plan and the checks the census carries for the other gates."""

from std.tempfile import TemporaryDirectory
from oven_tests import selected_builder_bakery
from release_support import builder_bakery, check_baseline
from std.fs import Path
from verify_installation import (
    CENSUS_WORKER_RESERVATION_BYTES,
    LSP_CONTRACT_CASE,
    census_jobs,
    require_lsp_contract,
    verification_gate_width,
    verification_phase_arguments,
    verification_phase_names,
    verification_phase_plans,
)

const BASELINE: str = "behavior/a/a\n"


def census(graph_verdict: str) -> str:
    """A complete eight-family census whose language-server case has the given verdict."""
    mut log = "PASS behavior/a/a\nPASS check/a/a\nPASS library/a/a\nPASS interop/a/a\n"
    log += "PASS testing/a/a\nPASS project/a/a\nPASS format/a/a\n"
    log += f"{graph_verdict} {LSP_CONTRACT_CASE}\n"
    mut passed = 7
    mut failed = 0
    mut pending = 0
    if graph_verdict == "PASS":
        passed += 1
    elif graph_verdict == "FAIL":
        failed += 1
    else:
        pending += 1
    log += f"total: {passed} passed, {failed} failed, {pending} pending\n"
    return log


def test_the_language_server_contract_runs_once_inside_the_installed_census() -> Result[None, str]:
    """No gate repeats the census's live language-server case; the census, which runs it with the server, remains."""
    names = verification_phase_names(2)
    assert "lsp" not in names
    assert "census" in names
    assert names == ["relocation", "oven", "rust-facets", "driver-integration", "census", "memory"]
    return Ok(None)


def test_the_installed_census_must_pass_the_language_server_contract() -> Result[None, str]:
    """A census that does not pass the live language-server case fails verification even when the baseline lacks it."""
    assert LSP_CONTRACT_CASE == "graph/incan/relationships"
    require_lsp_contract(check_baseline(BASELINE, census("PASS"))?)?
    for verdict in ["FAIL", "PEND"]:
        match require_lsp_contract(check_baseline(BASELINE, census(verdict))?):
            Ok(_) => return Err(f"a census with {verdict} {LSP_CONTRACT_CASE} passed the language-server gate")
            Err(message) =>
                assert LSP_CONTRACT_CASE in message
                assert verdict in message
    return Ok(None)


def test_installed_release_tests_reuse_the_bakery_the_builder_compiled_into() -> Result[None, str]:
    """
    The release names the bakery its builds used: the one `INCAN_BAKERY` selected, else the build home's own. The
    installed Loaf and Rust-facet tests ask that bakery, and the build home's only when the release named none.
    """
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    root = temporary.path()
    selected = root.joinpath("selected-bakery")
    home = root.joinpath("build-home")
    assert builder_bakery(selected.0, home) == selected.0
    assert builder_bakery("", home) == home.joinpath("bakery").0
    assert selected_builder_bakery("", "") == ""
    assert selected_builder_bakery(selected.0, home.0) == ""
    selected.mkdir(true, true).map_err((error) => error.message())?
    assert selected_builder_bakery(selected.0, home.0) == selected.0
    assert selected_builder_bakery("", home.0) == ""
    home.joinpath("bakery").mkdir(true, true).map_err((error) => error.message())?
    assert selected_builder_bakery("", home.0) == home.joinpath("bakery").0
    assert selected_builder_bakery(selected.0, home.0) == selected.0
    return Ok(None)


def test_every_installed_gate_starts_at_once_and_keeps_the_release_jobs_for_its_own_children() -> Result[None, str]:
    """
    The gates are independent, so the pool admits all of them together and only their memory reservations bound it;
    each gate still runs at most the release's jobs of its own children.
    """
    for jobs in [1, 2, 6]:
        assert verification_gate_width(jobs) == len(verification_phase_names(jobs))
    assert verification_phase_arguments("census", Path("/run"), Path("/runner"), 2, 900)[4] == "2"
    return Ok(None)


def test_the_census_runs_twice_the_release_jobs_and_reserves_its_measured_share() -> Result[None, str]:
    """
    The census outlasts every other gate, so it runs twice the release's jobs; each of its workers reserves 2 GiB, more
    than twice the 0.87 GB a worker took at the measured 1.73 GB peak of a whole census at two jobs.
    """
    gib = 1073741824
    assert census_jobs(1) == 2
    assert census_jobs(2) == 4
    assert CENSUS_WORKER_RESERVATION_BYTES == 2 * gib
    reservations = [plan.reservation for plan in verification_phase_plans(2)]
    assert verification_phase_names(2)[4] == "census"
    assert reservations[4] == 4 * CENSUS_WORKER_RESERVATION_BYTES
    return Ok(None)
