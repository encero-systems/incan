"""Refresh run 75's single source-matched proof generation in place."""

from std.fs import Path
from std.json import JsonValue
from native_build import (
    NativeContext,
    StandardGeneration,
    build_runtime,
    build_source_interfaces,
    build_standard_packages,
    publish_support,
    standard_profiles,
)


const REPO: str = "/Volumes/Builds/incan-dev9-work/b4/lane/run74/repo"
const LANE: str = "/Volumes/Builds/incan-dev9-work/b4/lane/run75"
const HOME: str = "/Volumes/Builds/incan-dev9-work/b4/lane/run75/proof-home3"
const BUILDER: str = "/Volumes/Builds/incan-dev9-work/b4/home-r51b/bin/incan"
const HELPER: str = "/Volumes/Builds/incan-dev9-work/b4/lane/run74/support-build/workspaces/oven/target/incan/release/bin/oven"


def main() -> Result[None, str]:
    """Withdraw the old selection, then publish support, interfaces, runtime and release standard providers."""
    context = NativeContext(
        repo=Path(REPO),
        lane=Path(LANE),
        home=Path(HOME),
        builder=BUILDER,
        stdlib=REPO + "/loaves/stdlib",
        evidence=Path(LANE + "/proof-evidence"),
        timings=Path(LANE + "/proof-timings.tsv"),
        jobs=1,
        memory=8589934592,
        timeout_seconds=600,
    )
    helper = Path(HELPER)
    if not Path(HOME + "/native-support").exists():
        manifest = Path(HOME + "/toolchains/0.6.0-dev.8/toolchain.json")
        mut fields = JsonValue
            .parse(manifest.read_text("utf-8", "strict").map_err((error) => error.message())?)
            .map_err((error) => error.message())?
            .expect_object()
            .map_err((error) => error.message())?
        fields["externs"] = JsonValue.array([])
        fields["search"] = JsonValue.array([])
        manifest
            .write_text(JsonValue.object(fields).to_json().map_err((error) => error.message())?, "utf-8", "strict", None)
            .map_err((error) => error.message())?
        publish_support(context, helper)?
    interfaces = build_source_interfaces(context, helper)?
    _ = build_runtime(context, helper, Some(interfaces), true, "run75-")?
    build_standard_packages(context, helper, "run75-", standard_profiles(StandardGeneration.SourceClosure))?
    return Ok(None)
