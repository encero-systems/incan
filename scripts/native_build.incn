"""Native release build steps over the existing Oven-owned unit-description authority."""

from rust::std::process import Command
from rust::std::string import String as RustString
from rust::std::time import Instant
from std.fs import Path
from std.json import JsonValue
from std.tempfile import TemporaryDirectory
from release_support import (
    STANDARD_PACKAGES,
    TOOLCHAIN_DIRECTORY,
    BackgroundStep,
    ReservedStep,
    ReleaseSpan,
    ReleaseTrace,
    Step,
    append_timing,
    cancel_background_step,
    digest,
    finish_background_step,
    log_tail,
    run_reserved_steps,
    run_step,
    same_bytes,
    start_background_step,
)

const GIB: int = 1073741824
pub const LOWERING_RESERVATION_BYTES: int = 6 * GIB
pub const PROJECT_RESERVATION_BYTES: int = 2 * GIB
pub const STANDARD_RESERVATION_BYTES: int = 2 * GIB
const SUPPORT_PROGRAM: str = "workspaces/oven/src/toolchain_native.incn"
const RUNTIME_NAME: str = "incan_native_runtime"
const RUNTIME_PROJECT: str = "loaves/compiler/incan_native_runtime"


pub model NativeContext:
    """Repository, release home, selected Oven, evidence root, and process budget for native production."""

    pub repo: Path
    pub lane: Path
    pub home: Path
    pub builder: str
    pub stdlib: str
    pub evidence: Path
    pub timings: Path
    pub jobs: int
    pub memory: int
    pub timeout_seconds: int
    pub trace: Option[ReleaseTrace] = None


pub model NativeBuildPlan:
    """One native child plus the output and stable destination published only after it succeeds."""

    pub name: str
    pub output: Path
    pub destination: Path
    pub child: Step
    pub reservation: int


pub model PendingToolBuild:
    """One tool child retained while later release production consumes the remaining bounded capacity."""

    pub plan: NativeBuildPlan
    pub worker: BackgroundStep


model PreparedStandardPackage:
    """One identified standard unit whose temporary outputs remain private until compilation and publication succeed."""

    package: str
    name: str
    profile: str
    unit: Path
    staged: Path
    parent: Path
    requested_graph: bool
    temporary: TemporaryDirectory
    child: Step


pub enum StandardProfile(str):
    """Native standard-package profiles admitted into a release generation."""

    Release = "release"
    Debug = "debug"


pub enum StandardGeneration(str):
    """Release generations with distinct downstream standard-package consumers."""

    SourceClosure = "source-closure"
    Candidate = "candidate"


pub def standard_profiles(generation: StandardGeneration) -> list[StandardProfile]:
    """Select only profiles consumed by the source closure or shipped candidate generation."""
    match generation:
        StandardGeneration.SourceClosure => return [StandardProfile.Release]
        StandardGeneration.Candidate => return [StandardProfile.Release, StandardProfile.Debug]


pub def build_support_tool(context: NativeContext, builder_home: Path) -> Result[Path, str]:
    """Build and install the isolated Incan native-description helper before source providers exist."""
    plan = support_build_plan(context, builder_home)?
    run_build_plans(context, [plan])?
    return complete_build_plan(plan)


pub def build_source_tools(context: NativeContext, builder_home: Path) -> Result[tuple[Path, Path], str]:
    """Build the conductor and isolated support helper concurrently through the released seed."""
    conductor = tool_build_plan(context, "oven", false, "conductor-build")?
    helper = support_build_plan(context, builder_home)?
    run_build_plans(context, [conductor, helper])?
    return Ok((complete_build_plan(conductor)?, complete_build_plan(helper)?))


pub def publish_support(context: NativeContext, helper: Path) -> Result[None, str]:
    """Publish the source-selected Rust support closure into the fresh candidate home."""
    require_native_step(
        context,
        step(
            context,
            "support-build",
            helper.0,
            [context.repo.0],
            common_environment(context),
            context.repo,
            context.evidence.joinpath("support-build.log"),
        ),
    )?
    return readmit_build_home(context, helper, "support-readmit")


pub def readmit_build_home(context: NativeContext, helper: Path, phase: str) -> Result[None, str]:
    """Explicitly replace the page in the unfinished build home's own installation catalog."""
    return require_native_step(
        context,
        step(
            context,
            phase,
            helper.0,
            ["--readmit"],
            common_environment(context),
            context.repo,
            context.evidence.joinpath(f"{phase}.log"),
        ),
    )


pub def build_source_interfaces(context: NativeContext, helper: Path, phase_prefix: str = "") -> Result[Path, str]:
    """Check and publish the three source interfaces through the selected compiler generation."""
    toolchain = context.home.joinpath(TOOLCHAIN_DIRECTORY)
    manifest = read_json(toolchain.joinpath("toolchain.json"))?
    driver = absolute(manifest_text(manifest, "driver")?, toolchain)
    sysroot = absolute(manifest_text(manifest, "sysroot")?, toolchain)
    interfaces = context.home.joinpath("source-interfaces")
    interfaces.mkdir(true, true).map_err((error) => error.message())?
    inventory = interfaces.joinpath("loaves.json")
    write_json(inventory, JsonValue.array([]))?
    for package in ["primitives", "async"]:
        build_source_interface(context, helper, package, driver, sysroot, inventory, interfaces, phase_prefix)?
    return Ok(inventory)


pub def build_runtime(
    context: NativeContext,
    helper: Path,
    source_interfaces: Option[Path],
    install: bool,
    phase_prefix: str = "",
) -> Result[Path, str]:
    """Compile checked runtime source without an earlier runtime or compiled standard provider in its closure."""
    toolchain = context.home.joinpath(TOOLCHAIN_DIRECTORY)
    manifest = read_json(toolchain.joinpath("toolchain.json"))?
    driver = absolute(manifest_text(manifest, "driver")?, toolchain)
    sysroot = absolute(manifest_text(manifest, "sysroot")?, toolchain)
    requested_graph = codegraph_on_request(manifest)?
    output = context.repo.joinpath(f"{RUNTIME_PROJECT}/target/incan/native/release")
    output.mkdir(true, true).map_err((error) => error.message())?
    unit = output.joinpath(f"{RUNTIME_NAME}.unit.json")
    prepared = helper_json(
        context,
        helper,
        [context.repo.0, "runtime", "release"],
        {},
        f"{phase_prefix}runtime-describe",
    )?
    write_json(unit, runtime_unit(prepared, source_interfaces)?)?
    identify(context, helper, unit, false, f"{phase_prefix}runtime-identify")?
    compile_library(
        context,
        driver,
        sysroot,
        unit,
        RUNTIME_NAME,
        output,
        f"{phase_prefix}runtime-build",
    )?
    publish(context, helper, unit, output, false, f"{phase_prefix}runtime-publish")?
    require_requested_codegraph(requested_graph, output, RUNTIME_NAME)?
    if not install:
        return Ok(output.joinpath(f"lib{RUNTIME_NAME}.rlib"))
    return install_runtime(context, helper, unit, output)


pub def build_standard_packages(
    context: NativeContext,
    helper: Path,
    phase_prefix: str,
    profiles: list[StandardProfile],
) -> Result[None, str]:
    """Build each profile in dependency-ready waves while compiling independent standard packages concurrently."""
    standards = context.evidence.joinpath(f"{phase_prefix}standards")
    standards.mkdir(true, true).map_err((error) => error.message())?
    for selected in profiles:
        profile = standard_profile_name(selected)
        admitted = standards.joinpath(f"{profile}-admitted.txt")
        admitted.write_text("", "utf-8", "strict", None).map_err((error) => error.message())?
        build_standard_package(context, helper, STANDARD_PACKAGES[0], profile, admitted, phase_prefix)?
        for wave in standard_build_waves():
            build_standard_wave(context, helper, wave, profile, admitted, phase_prefix)?
    return Ok(None)


pub def build_candidate_standard_and_start_lsp(
    context: NativeContext,
    helper: Path,
    phase_prefix: str,
) -> Result[tuple[Path, Option[PendingToolBuild]], str]:
    """
    Build candidate release providers while the independent Rust-only language server builds.

    The language-server project contains no Incan source and reads the selected driver, sysroot, compiler Loaves, and
    Rust dependency closure that already exist after candidate relinking. It does not consume the standard providers
    being produced here. One project slot and its memory reservation remain unavailable to standard-package waves until
    the language-server child finishes.
    """
    lsp = tool_build_plan(context, "lsp", false, "lsp-build")?
    remaining = overlapping_project_capacity(context.jobs, context.memory)
    match remaining:
        None =>
            build_standard_packages(context, helper, phase_prefix, [StandardProfile.Release])?
            run_build_plans(context, [lsp])?
            return Ok((complete_build_plan(lsp)?, None))
        Some(_) => pass

    worker = start_background_step(lsp.child)?
    jobs, memory = match remaining:
        Some(capacity) => capacity
        None =>
            _ = cancel_background_step(worker)
            return Err("project capacity disappeared before the language-server build started")

    reserved = reserve_project_capacity(context, jobs, memory)
    match build_standard_packages(reserved, helper, phase_prefix, [StandardProfile.Release]):
        Ok(_) => pass
        Err(message) =>
            _ = cancel_background_step(worker)
            return Err(message)
    return Ok((Path(""), Some(PendingToolBuild(plan=lsp, worker=worker))))


pub def finish_tool_build(context: NativeContext, pending: PendingToolBuild) -> Result[Path, str]:
    """Join, time, validate, and publish a tool child retained across release phases."""
    code, elapsed = finish_background_step(pending.worker, context.timeout_seconds)?
    append_timing(context.timings, pending.plan.child.name, elapsed)?
    if code != 0:
        return Err(
            f"{pending.plan.child.name} failed with status {code}; log: {pending.plan.child.log.0}\n{log_tail(
                pending.plan.child.log,
            )}",
        )
    return complete_build_plan(pending.plan)


pub def cancel_tool_build(pending: PendingToolBuild) -> Result[None, str]:
    """Stop and reap one retained tool child after another required build has failed."""
    return cancel_background_step(pending.worker)


pub def overlapping_project_capacity(jobs: int, memory: int) -> Option[tuple[int, int]]:
    """Return the standard-build capacity left after reserving one project child, or refuse unsafe overlap."""
    if jobs < 2 or memory < PROJECT_RESERVATION_BYTES + STANDARD_RESERVATION_BYTES:
        return None
    return Some((jobs - 1, memory - PROJECT_RESERVATION_BYTES))


def reserve_project_capacity(context: NativeContext, jobs: int, memory: int) -> NativeContext:
    """Reserve one worker and one project-scale memory allowance for an overlapping tool build."""
    return NativeContext(
        repo=context.repo,
        lane=context.lane,
        home=context.home,
        builder=context.builder,
        stdlib=context.stdlib,
        evidence=context.evidence,
        timings=context.timings,
        jobs=jobs,
        memory=memory,
        timeout_seconds=context.timeout_seconds,
        trace=context.trace,
    )


def standard_profile_name(profile: StandardProfile) -> str:
    """Map the closed native profile set to the spelling consumed by unit description and rustc."""
    match profile:
        StandardProfile.Release => return "release"
        StandardProfile.Debug => return "debug"


pub def standard_build_waves() -> list[list[str]]:
    """Admit only packages whose source-level standard-library providers were published by earlier waves."""
    return [
        ["testing", "async", "system", "web", "observability"],
        ["codecs", "compression", "data"],
        ["vocab"],
        ["interop"],
    ]


pub def build_tool(context: NativeContext, name: str, rebuild: bool, phase: str) -> Result[Path, str]:
    """Build and atomically install Oven, the contract runner, or the language server."""
    plan = tool_build_plan(context, name, rebuild, phase)?
    run_build_plans(context, [plan])?
    return complete_build_plan(plan)


pub def build_oven_with_standard_profile(
    context: NativeContext,
    helper: Path,
    phase_prefix: str,
    profile: StandardProfile,
    reserve_project: bool,
) -> Result[Path, str]:
    """Reserve any retained tool child, then start Oven with the first dependency-ready standard wave."""
    if reserve_project:
        match overlapping_project_capacity(context.jobs, context.memory):
            Some((jobs, memory)) =>
                return build_oven_and_standard_profile(
                    reserve_project_capacity(context, jobs, memory),
                    helper,
                    phase_prefix,
                    profile,
                )
            None => return Err("cannot run Oven while the language server holds the only available project capacity")
    return build_oven_and_standard_profile(context, helper, phase_prefix, profile)


def build_oven_and_standard_profile(
    context: NativeContext,
    helper: Path,
    phase_prefix: str,
    profile: StandardProfile,
) -> Result[Path, str]:
    """Start Oven beside independent standard compilation and publish every successful output."""
    selected = standard_profile_name(profile)
    standards = context.evidence.joinpath(f"{phase_prefix}standards")
    standards.mkdir(true, true).map_err((error) => error.message())?
    admitted = standards.joinpath(f"{selected}-admitted.txt")
    admitted.write_text("", "utf-8", "strict", None).map_err((error) => error.message())?
    build_standard_package(context, helper, STANDARD_PACKAGES[0], selected, admitted, phase_prefix)?

    waves = standard_build_waves()
    mut packages: list[PreparedStandardPackage] = []
    for package in waves[0]:
        packages.append(prepare_standard_package(context, helper, package, selected, admitted, phase_prefix)?)
    oven = tool_build_plan(context, "oven", true, "oven-build")?
    mut planned = [ReservedStep(child=package.child, reservation=STANDARD_RESERVATION_BYTES) for package in packages]
    planned.append(ReservedStep(child=oven.child, reservation=oven.reservation))
    require_reserved_success(context, planned)?

    for package in packages:
        complete_standard_package(context, helper, package, admitted)?
    for index in range(1, len(waves)):
        build_standard_wave(context, helper, waves[index], selected, admitted, phase_prefix)?
    completed_oven = complete_build_plan(oven)?
    return Ok(completed_oven)


pub def require_unique_runtime_root(context: NativeContext) -> Result[None, str]:
    """Require every direct native root name in the candidate manifest to occur exactly once."""
    manifest = read_json(context.home.joinpath(f"{TOOLCHAIN_DIRECTORY}/toolchain.json"))?
    mut seen: set[str] = set()
    for entry in entries(manifest, "externs")?:
        name = manifest_text(entry, "name")?
        if name in seen:
            return Err(f"native runtime closure has conflicting direct root: {name}")
        seen.add(name)
    return Ok(None)


def build_source_interface(
    context: NativeContext,
    helper: Path,
    package: str,
    driver: Path,
    sysroot: Path,
    inventory: Path,
    interfaces: Path,
    phase_prefix: str,
) -> Result[None, str]:
    """Describe, check, and admit one checking-only source interface without compiled standard providers."""
    project = context.repo.joinpath(f"loaves/stdlib/{package}")
    name = project_name(project.joinpath("loaf.toml"))?
    temporary = TemporaryDirectory.try_new_with(f"{package}.", "", Some(interfaces)).map_err((error) => error.message())?
    directory = temporary.persist().map_err((error) => error.message())?
    unit = directory.joinpath("unit.json")
    prepared = helper_json(
        context,
        helper,
        [context.repo.0, package, "release"],
        {"SELFBUILD_LIBRARY_OUTPUT": ""},
        f"{phase_prefix}source-interface-{package}-describe",
    )?
    interfaces_value = read_json(inventory)?.expect_array().map_err((error) => error.message())?
    write_json(unit, source_interface_unit(prepared, interfaces_value)?)?
    identify(context, helper, unit, true, f"{phase_prefix}source-interface-{package}-identify")?
    require_native_step(
        context,
        step(
            context,
            f"{phase_prefix}source-interface-{package}",
            driver.0,
            ["--source-interface", unit.0, sysroot.0, directory.0],
            common_environment(context),
            context.repo,
            context.evidence.joinpath(f"{phase_prefix}source-interface-{package}.log"),
        ),
    )?
    publish(context, helper, unit, directory, true, f"{phase_prefix}source-interface-{package}-publish")?
    append_interface(inventory, name, directory)?
    return Ok(None)


def source_interface_unit(prepared: JsonValue, interfaces: list[JsonValue]) -> Result[JsonValue, str]:
    """Replace compiled standard providers with prior interfaces in one metadata-only standard unit."""
    mut fields = prepared.expect_object().map_err((error) => error.message())?
    fields["kind"] = JsonValue.string("library")
    mut loaves = nonstandard(entries(JsonValue.object(fields), "loaves")?)?
    loaves += interfaces
    fields["loaves"] = JsonValue.array(loaves)
    return Ok(JsonValue.object(fields))


def runtime_unit(prepared: JsonValue, source_interfaces: Option[Path]) -> Result[JsonValue, str]:
    """Remove earlier runtime providers and substitute explicit checked source interfaces when supplied."""
    mut fields = prepared.expect_object().map_err((error) => error.message())?
    fields["kind"] = JsonValue.string("library")
    mut externs: list[JsonValue] = []
    for entry in entries(JsonValue.object(fields), "externs")?:
        name = manifest_text(entry, "name")?
        if name != RUNTIME_NAME and not name.startswith("incan_stdlib_"):
            externs.append(entry)
    mut loaves: list[JsonValue] = []
    for entry in entries(JsonValue.object(fields), "loaves")?:
        if manifest_text(entry, "name")? != RUNTIME_NAME:
            loaves.append(entry)
    fields["externs"] = JsonValue.array(externs)
    fields["loaves"] = JsonValue.array(loaves)
    if let Some(inventory) = source_interfaces:
        fields["loaves"] = JsonValue.array(nonstandard(loaves)? + entries(read_json(inventory)?, "")?)
        fields["search"] = JsonValue.array(unique_paths(externs)?)
    return Ok(JsonValue.object(fields))


def nonstandard(loaves: list[JsonValue]) -> Result[list[JsonValue], str]:
    """Keep only nonstandard Loaf bindings before checked source interfaces are injected."""
    mut selected: list[JsonValue] = []
    for entry in loaves:
        standard = entry
            .require("standard")
            .and_then((value) => value.expect_bool())
            .map_err((error) => error.message())?
        if not standard:
            selected.append(entry)
    return Ok(selected)


def unique_paths(externs: list[JsonValue]) -> Result[list[JsonValue], str]:
    """Return sorted unique directories that contain the selected native externs."""
    mut paths: set[str] = set()
    for entry in externs:
        paths.add(Path(manifest_text(entry, "path")?).parent().0)
    return Ok([JsonValue.string(path) for path in sorted([path for path in paths])])


def install_runtime(context: NativeContext, helper: Path, unit: Path, output: Path) -> Result[Path, str]:
    """Stage the complete runtime generation, bind it by content, and update the candidate manifest."""
    toolchain = context.home.joinpath(TOOLCHAIN_DIRECTORY)
    runtime_root = toolchain.joinpath("runtime")
    runtime_root.mkdir(true, true).map_err((error) => error.message())?
    temporary = TemporaryDirectory.try_new_with(".staged.", "", Some(runtime_root)).map_err((error) => error.message())?
    staged = temporary.path()
    artifacts = runtime_artifacts()
    for artifact in artifacts:
        _ = output.joinpath(artifact).copy(staged.joinpath(artifact), true, true).map_err((error) => error.message())?
    rewrite_native_paths(staged.joinpath(f"{RUNTIME_NAME}.native.json"), output)?
    publish(context, helper, unit, staged, false, "runtime-install-publish")?
    write_artifact_digests(staged, artifacts)?
    generation = digest(staged.joinpath("artifacts.sha256"))?
    installed = runtime_root.joinpath(generation)
    if installed.exists():
        require_same_generation(staged, installed, artifacts + ["artifacts.sha256"])?
        publish(context, helper, unit, installed, false, "runtime-existing-publish")?
    else:
        persisted = temporary.persist().map_err((error) => error.message())?
        _ = persisted.move(installed).map_err((error) => error.message())?
    update_runtime_manifest(toolchain, installed)?
    readmit_build_home(context, helper, "runtime-readmit")?
    return Ok(installed.joinpath(f"lib{RUNTIME_NAME}.rlib"))


def rewrite_native_paths(document: Path, directory: Path) -> Result[None, str]:
    """Make runtime sidecar extern, macro, and search paths absolute against their producer directory."""
    mut fields = read_json(document)?.expect_object().map_err((error) => error.message())?
    for key in ["externs", "macro_externs"]:
        mut rewritten: list[JsonValue] = []
        for entry in entries(JsonValue.object(fields), key)?:
            mut pair = entry.expect_array().map_err((error) => error.message())?
            pair[1] = JsonValue.string(absolute(pair[1].expect_str().map_err((error) => error.message())?, directory).0)
            rewritten.append(JsonValue.array(pair))
        fields[key] = JsonValue.array(rewritten)
    mut search: list[JsonValue] = []
    for path in entries(JsonValue.object(fields), "search")?:
        search.append(JsonValue.string(absolute(path.expect_str().map_err((error) => error.message())?, directory).0))
    fields["search"] = JsonValue.array(search)
    return write_json(document, JsonValue.object(fields))


def update_runtime_manifest(toolchain: Path, installed: Path) -> Result[None, str]:
    """Replace the direct runtime binding and its search directory in `toolchain.json`."""
    path = toolchain.joinpath("toolchain.json")
    mut fields = read_json(path)?.expect_object().map_err((error) => error.message())?
    mut externs: list[JsonValue] = []
    mut previous: list[str] = []
    for entry in entries(JsonValue.object(fields), "externs")?:
        if manifest_text(entry, "name")? == RUNTIME_NAME:
            previous.append(Path(manifest_text(entry, "path")?).parent().0)
        else:
            externs.append(entry)
    externs.append(
        JsonValue.object(
            {"name": JsonValue.string(RUNTIME_NAME), "path": JsonValue.string(
                installed.joinpath(f"lib{RUNTIME_NAME}.rlib").0,
            )},
        ),
    )
    mut search: set[str] = set()
    for entry in entries(JsonValue.object(fields), "search")?:
        value = entry.expect_str().map_err((error) => error.message())?
        if value not in previous:
            search.add(value)
    search.add(installed.0)
    fields["externs"] = JsonValue.array(externs)
    fields["search"] = JsonValue.array([JsonValue.string(value) for value in sorted([value for value in search])])
    return replace_json(path, JsonValue.object(fields))


def build_standard_package(
    context: NativeContext,
    helper: Path,
    package: str,
    profile: str,
    admitted: Path,
    phase_prefix: str,
) -> Result[None, str]:
    """Describe, compile, publish, and atomically select one standard package profile."""
    prepared = prepare_standard_package(context, helper, package, profile, admitted, phase_prefix)?
    require_native_step(context, prepared.child)?
    return complete_standard_package(context, helper, prepared, admitted)


def prepare_standard_package(
    context: NativeContext,
    helper: Path,
    package: str,
    profile: str,
    admitted: Path,
    phase_prefix: str,
) -> Result[PreparedStandardPackage, str]:
    """Describe and identify one standard unit in a private directory without publishing partial outputs."""
    project = context.repo.joinpath(f"loaves/stdlib/{package}")
    if not project.joinpath("loaf.toml").is_file():
        return Err(f"unknown standard package: {package}")
    name = project_name(project.joinpath("loaf.toml"))?
    toolchain = context.home.joinpath(TOOLCHAIN_DIRECTORY)
    manifest = read_json(toolchain.joinpath("toolchain.json"))?
    driver = absolute(manifest_text(manifest, "driver")?, toolchain)
    sysroot = absolute(manifest_text(manifest, "sysroot")?, toolchain)
    requested_graph = codegraph_on_request(manifest)?
    parent = toolchain.joinpath(f"loaves/{name}")
    parent.mkdir(true, true).map_err((error) => error.message())?
    temporary = TemporaryDirectory.try_new_with(f".{profile}.", "", Some(parent)).map_err((error) => error.message())?
    staged = temporary.path()
    unit = staged.joinpath(f"{name}.unit.json")
    environment = {"SELFBUILD_LIBRARY_OUTPUT": staged.0, "SELFBUILD_ADMITTED_STDLIB": admitted.0}
    prepared = helper_json(
        context,
        helper,
        [context.repo.0, package, profile],
        environment,
        f"std-{package}-{profile}-describe",
    )?
    write_json(unit, prepared)?
    identify(context, helper, unit, false, f"std-{package}-{profile}-identify")?
    phase = f"{phase_prefix}std-{package}-{profile}"
    return Ok(
        PreparedStandardPackage(
            package=package,
            name=name,
            profile=profile,
            unit=unit,
            staged=staged,
            parent=parent,
            requested_graph=requested_graph,
            temporary=temporary,
            child=compile_library_step(context, driver, sysroot, unit, name, staged, phase)?,
        ),
    )


def complete_standard_package(
    context: NativeContext,
    helper: Path,
    package: PreparedStandardPackage,
    admitted: Path,
) -> Result[None, str]:
    """Publish and select one fully compiled standard unit, prove its requested graph, and admit it to consumers."""
    publish(context, helper, package.unit, package.staged, false, f"std-{package.package}-{package.profile}-publish")?
    require_requested_codegraph(package.requested_graph, package.staged, package.name)?
    output = package.parent.joinpath(package.profile)
    replace_directory(package.temporary, output)?
    if package.profile == "release":
        replace_symlink(Path("release"), package.parent.joinpath("debug"))?
    append_line(admitted, package.name)?
    readmit_build_home(context, helper, f"std-{package.package}-{package.profile}-readmit")?
    return Ok(None)


def build_standard_wave(
    context: NativeContext,
    helper: Path,
    packages: list[str],
    profile: str,
    admitted: Path,
    phase_prefix: str,
) -> Result[None, str]:
    """Describe, compile, and publish one dependency-ready wave before dependent package descriptions begin."""
    mut prepared: list[PreparedStandardPackage] = []
    for package in packages:
        prepared.append(prepare_standard_package(context, helper, package, profile, admitted, phase_prefix)?)
    run_standard_compiles(context, prepared)?
    for package in prepared:
        complete_standard_package(context, helper, package, admitted)?
    return Ok(None)


def run_standard_compiles(context: NativeContext, packages: list[PreparedStandardPackage]) -> Result[None, str]:
    """Compile independent standard units together under the release's count and memory reservations."""
    planned = [ReservedStep(child=package.child, reservation=STANDARD_RESERVATION_BYTES) for package in packages]
    return require_reserved_success(context, planned)


def compile_library_step(
    context: NativeContext,
    driver: Path,
    sysroot: Path,
    unit: Path,
    name: str,
    output: Path,
    phase: str,
) -> Result[Step, str]:
    """Describe one native library compiler child that retains its graph from the same checked activation."""
    arguments_file = Path(f"{unit.0}.arguments")
    flags = lines(arguments_file.read_text("utf-8", "strict").map_err((error) => error.message())?)
    arguments = ["--unit", unit.0, name, output.joinpath(f"lib{name}.rlib").0, sysroot.0, "--library"] + flags
    return Ok(
        Step(
            name=phase,
            executable=driver.0,
            arguments=arguments,
            environment=common_environment(context),
            remove_environment=["RUSTC_BOOTSTRAP"],
            directory=Some(context.repo),
            log=context.evidence.joinpath(f"{phase}.log"),
            timeout_seconds=context.timeout_seconds,
            trace=context.trace,
        ),
    )


def compile_library(
    context: NativeContext,
    driver: Path,
    sysroot: Path,
    unit: Path,
    name: str,
    output: Path,
    phase: str,
) -> Result[None, str]:
    """Compile one prepared unit through the candidate driver with its exact emitted native arguments."""
    return require_native_step(context, compile_library_step(context, driver, sysroot, unit, name, output, phase)?)


def identify(context: NativeContext, helper: Path, unit: Path, metadata_only: bool, phase: str) -> Result[None, str]:
    """Retain one prepared unit identity and its native compiler arguments before compilation."""
    mut environment = common_environment(context)
    if metadata_only:
        environment["SELFBUILD_METADATA_ONLY"] = "1"
    return require_native_step(
        context,
        step(
            context,
            phase,
            helper.0,
            [context.repo.0, "identify", unit.0],
            environment,
            context.repo,
            context.evidence.joinpath(f"{phase}.log"),
        ),
    )


def publish(
    context: NativeContext,
    helper: Path,
    unit: Path,
    directory: Path,
    metadata_only: bool,
    phase: str,
) -> Result[None, str]:
    """Publish one completed unit under the identity retained before compilation."""
    mut environment = common_environment(context)
    if metadata_only:
        environment["SELFBUILD_METADATA_ONLY"] = "1"
    return require_native_step(
        context,
        step(
            context,
            phase,
            helper.0,
            [context.repo.0, "publish", unit.0, directory.0],
            environment,
            context.repo,
            context.evidence.joinpath(f"{phase}.log"),
        ),
    )


def require_requested_codegraph(requested: bool, directory: Path, name: str) -> Result[None, str]:
    """Require a requested graph retained by the native compiler's existing checked activation."""
    if not requested:
        return Ok(None)
    graph = directory.joinpath(f"{name}.incngraph")
    if not graph.is_file():
        return Err(f"native compilation produced no requested graph: {graph.0}")
    return Ok(None)


def helper_json(
    context: NativeContext,
    helper: Path,
    arguments: list[str],
    environment: Dict[str, str],
    phase: str,
) -> Result[JsonValue, str]:
    """Run the native-description helper and parse its sole JSON document."""
    started = Instant.now()
    span = begin_native_trace(context.trace, phase)?
    mut command = Command.new(helper.0)
    command.current_dir(context.repo.0)
    for argument in arguments:
        command.arg(argument)
    mut merged = common_environment(context)
    for key in environment.keys():
        merged[key] = environment[key]
    for key in merged.keys():
        command.env(key, merged[key])
    output = command.output().map_err((error) => f"cannot run {phase}: {error}")?
    stdout = RustString.from_utf8_lossy(output.stdout).into_owned()
    stderr = RustString.from_utf8_lossy(output.stderr).into_owned()
    context.evidence
        .joinpath(f"{phase}.log")
        .write_text(stdout + stderr, "utf-8", "strict", None)
        .map_err((error) => error.message())?
    append_timing(context.timings, phase, started.elapsed().as_secs_f64())?
    finish_native_trace(context.trace, span)?
    if not output.status.success():
        log = context.evidence.joinpath(f"{phase}.log")
        return Err(f"{phase} failed; log: {log.0}\n{log_tail(log)}")
    return JsonValue.parse(stdout).map_err((error) => f"{phase}: {error.message()}")


def require_native_step(context: NativeContext, child: Step) -> Result[None, str]:
    """Run one native phase, append its wall duration, and preserve the failing phase's exact log."""
    name = str(child.name)
    log = child.log.clone()
    started = Instant.now()
    outcome = run_step(child)
    append_timing(context.timings, name, started.elapsed().as_secs_f64())?
    code = match outcome:
        Ok(observed) => observed
        Err(message) => return Err(f"{message}\n{log_tail(log)}")

    if code != 0:
        return Err(f"{name} failed with status {code}; log: {log.0}\n{log_tail(log)}")
    return Ok(None)


def common_environment(context: NativeContext) -> Dict[str, str]:
    """Return the explicit candidate build environment shared by native release producers."""
    return {"INCAN_HOME": context.home.0, "INCAN_STDLIB": context.stdlib, "INCAN_NO_BANNER": "1", "OVEN_OWNER": "off", "RUSTUP_TOOLCHAIN": "1.98.0", "INCAN_RUST_INCREMENTAL": "0", "DEV8_LANE": context.lane.0, "SELFBUILD_HOME": context.home.0, "SELFBUILD_OVEN": context.builder, "SELFBUILD_STDLIB": context.stdlib}


def step(
    context: NativeContext,
    name: str,
    executable: str,
    arguments: list[str],
    environment: Dict[str, str],
    directory: Path,
    log: Path,
) -> Step:
    """Create one native build child specification under the release timeout."""
    return Step(
        name=name,
        executable=executable,
        arguments=arguments,
        environment=environment,
        remove_environment=[],
        directory=Some(directory),
        log=log,
        timeout_seconds=context.timeout_seconds,
        trace=context.trace,
    )


def begin_native_trace(trace: Option[ReleaseTrace], name: str) -> Result[Option[ReleaseSpan], str]:
    """Open a directly executed native-helper span when release tracing is active."""
    match trace:
        Some(selected) => return Ok(Some(selected.begin(name)?))
        None => return Ok(None)


def finish_native_trace(trace: Option[ReleaseTrace], span: Option[ReleaseSpan]) -> Result[None, str]:
    """Close a directly executed native-helper span when release tracing is active."""
    match (trace, span):
        (Some(selected), Some(opened)) => return selected.finish(opened)
        _ => return Ok(None)


def tool_build_plan(context: NativeContext, name: str, rebuild: bool, phase: str) -> Result[NativeBuildPlan, str]:
    """Plan one project-scale tool build whose executable is copied only after successful completion."""
    project, output, destination = tool_paths(context, name)?
    if rebuild:
        stamp = Path(f"{output.0}.oven-inputs")
        if stamp.is_file():
            stamp.unlink().map_err((error) => error.message())?
    mut environment = common_environment(context)
    environment["OVEN_TRACE"] = "-"
    return Ok(
        NativeBuildPlan(
            name=name,
            output=output,
            destination=destination,
            child=step(
                context,
                phase,
                context.builder,
                ["build", project.0, "--profile", "release"],
                environment,
                context.repo,
                context.evidence.joinpath(f"{phase}.log"),
            ),
            reservation=PROJECT_RESERVATION_BYTES,
        ),
    )


def support_build_plan(context: NativeContext, builder_home: Path) -> Result[NativeBuildPlan, str]:
    """Plan the support helper in a private Oven project so it may build beside the release conductor."""
    project = prepare_support_project(context)?
    output = project.joinpath("target/incan/release/bin/oven")
    mut environment = common_environment(context)
    environment["INCAN_HOME"] = builder_home.0
    return Ok(
        NativeBuildPlan(
            name="support",
            output=output,
            destination=context.lane.joinpath("out/native-builds/toolchain-native"),
            child=step(
                context,
                "support-tool-build",
                context.builder,
                ["build", project.joinpath("src/toolchain_native.incn").0, "--profile", "release"],
                environment,
                project,
                context.evidence.joinpath("support-tool-build.log"),
            ),
            reservation=PROJECT_RESERVATION_BYTES,
        ),
    )


def prepare_support_project(context: NativeContext) -> Result[Path, str]:
    """Copy Oven sources into a release-owned root while sharing only immutable Loaf source inputs."""
    root = context.lane.joinpath("support-build")
    project = root.joinpath("workspaces/oven")
    project.mkdir(true, true).map_err((error) => error.message())?
    _ = context.repo
        .joinpath("workspaces/oven/loaf.toml")
        .copy(project.joinpath("loaf.toml"), true, false)
        .map_err((error) => error.message())?
    _ = context.repo
        .joinpath("workspaces/oven/src")
        .copy(project.joinpath("src"), true, false)
        .map_err((error) => error.message())?
    root.joinpath("loaves").symlink_to(context.repo.joinpath("loaves")).map_err((error) => error.message())?
    return Ok(project)


def run_build_plans(context: NativeContext, plans: list[NativeBuildPlan]) -> Result[None, str]:
    """Run project build plans together under the release's process and host-memory budgets."""
    planned = [ReservedStep(child=plan.child, reservation=plan.reservation) for plan in plans]
    return require_reserved_success(context, planned)


def require_reserved_success(context: NativeContext, planned: list[ReservedStep]) -> Result[None, str]:
    """Require every reserved child to pass and include each failing log tail in the refusal."""
    failed = run_reserved_steps(planned, context.jobs, context.memory, context.timings)?
    if len(failed) == 0:
        return Ok(None)
    mut details: list[str] = []
    for index in failed:
        details.append(
            f"{planned[index].child.name}: {planned[index].child.log.0}\n{log_tail(planned[index].child.log)}",
        )
    return Err("native build failures:\n" + "\n".join(details))


def complete_build_plan(plan: NativeBuildPlan) -> Result[Path, str]:
    """Atomically copy one successful native build to its stable lane destination."""
    if not plan.output.is_file():
        return Err(f"{plan.name} build produced no executable: {plan.output.0}")
    plan.destination.parent().mkdir(true, true).map_err((error) => error.message())?
    replace_copy(plan.output, plan.destination)?
    if plan.name == "lsp":
        replace_symlink(Path("../oven-bin/incan"), plan.destination.parent().joinpath("incan"))?
    return Ok(plan.destination)


def tool_paths(context: NativeContext, name: str) -> Result[tuple[Path, Path, Path], str]:
    """Resolve source output and stable lane destination for one shipped or qualification tool."""
    if name == "oven" or name == "contracts":
        project = context.repo.joinpath(f"workspaces/{name}")
        output = project.joinpath(f"target/incan/release/bin/{name}")
        mut destination = context.lane.joinpath("oven-bin/incan")
        if name == "contracts":
            destination = context.lane.joinpath("contracts-bin/contracts")
        return Ok((project, output, destination))
    if name == "lsp":
        project = context.repo.joinpath("loaves/toolchain/incan-lsp")
        output = project.joinpath("target/incan/rust/release/bin/incan-lsp")
        return Ok((project, output, context.lane.joinpath("lsp-bin/incan-lsp")))
    return Err(f"unknown native tool: {name}")


def project_name(manifest: Path) -> Result[str, str]:
    """Read the first project `name` declaration from a Loaf manifest."""
    text = manifest.read_text("utf-8", "strict").map_err((error) => error.message())?
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped.startswith("name = \"") and stripped.endswith("\""):
            return Ok(stripped[8:-1])
    return Err(f"manifest has no project name: {manifest.0}")


def append_interface(inventory: Path, name: str, directory: Path) -> Result[None, str]:
    """Append one source interface to the checking-only inventory."""
    mut values = read_json(inventory)?.expect_array().map_err((error) => error.message())?
    values.append(
        JsonValue.object(
            {"key": JsonValue.string(name), "name": JsonValue.string(name), "dir": JsonValue.string(directory.0), "standard": JsonValue.bool(
                true,
            )},
        ),
    )
    return replace_json(inventory, JsonValue.array(values))


def runtime_artifacts() -> list[str]:
    """Return the native runtime generation artifacts and its separately proved requested inspection graph."""
    return [
        f"lib{RUNTIME_NAME}.rlib",
        f"{RUNTIME_NAME}.incnlib",
        f"{RUNTIME_NAME}.incnbody",
        f"{RUNTIME_NAME}.native.json",
        f"{RUNTIME_NAME}.rustabi",
        f"{RUNTIME_NAME}.incngraph",
    ]


def write_artifact_digests(directory: Path, artifacts: list[str]) -> Result[None, str]:
    """Write names and content digests so both contribute to the runtime generation identity."""
    mut rows: list[str] = []
    for artifact in artifacts:
        rows.append(f"{digest(directory.joinpath(artifact))?}  {artifact}")
    return directory
        .joinpath("artifacts.sha256")
        .write_text("\n".join(rows) + "\n", "utf-8", "strict", None)
        .map_err((error) => error.message())


def require_same_generation(staged: Path, installed: Path, artifacts: list[str]) -> Result[None, str]:
    """Refuse a content-named runtime directory whose retained bytes disagree with the staged generation."""
    for artifact in artifacts:
        if not same_bytes(staged.joinpath(artifact), installed.joinpath(artifact))?:
            return Err(f"runtime generation has conflicting {artifact} bytes: {installed.0}")
    return Ok(None)


def replace_directory(temporary: TemporaryDirectory, output: Path) -> Result[None, str]:
    """Replace one profile only after its complete staged directory exists."""
    previous = Path(f"{output.0}.previous")
    if previous.exists():
        previous.remove_tree().map_err((error) => error.message())?
    if output.exists() or output.is_symlink():
        _ = output.move(previous).map_err((error) => error.message())?
    persisted = temporary.persist().map_err((error) => error.message())?
    _ = persisted.move(output).map_err((error) => error.message())?
    if previous.exists() or previous.is_symlink():
        if previous.is_dir() and not previous.is_symlink():
            previous.remove_tree().map_err((error) => error.message())?
        else:
            previous.unlink().map_err((error) => error.message())?
    return Ok(None)


def replace_copy(source: Path, destination: Path) -> Result[None, str]:
    """Copy a complete executable beside its destination, then replace the directory entry."""
    staged = Path(f"{destination.0}.next")
    if staged.exists() or staged.is_symlink():
        staged.unlink().map_err((error) => error.message())?
    _ = source.copy(staged, true, true).map_err((error) => error.message())?
    if destination.exists() or destination.is_symlink():
        destination.unlink().map_err((error) => error.message())?
    _ = staged.move(destination).map_err((error) => error.message())?
    return Ok(None)


def replace_symlink(source: Path, destination: Path) -> Result[None, str]:
    """Replace a symlink without exposing a partial file."""
    staged = Path(f"{destination.0}.next")
    if staged.exists() or staged.is_symlink():
        if staged.is_dir() and not staged.is_symlink():
            staged.remove_tree().map_err((error) => error.message())?
        else:
            staged.unlink().map_err((error) => error.message())?
    staged.symlink_to(source).map_err((error) => error.message())?
    if destination.exists() or destination.is_symlink():
        if destination.is_dir() and not destination.is_symlink():
            destination.remove_tree().map_err((error) => error.message())?
        else:
            destination.unlink().map_err((error) => error.message())?
    _ = staged.move(destination).map_err((error) => error.message())?
    return Ok(None)


def append_line(path: Path, line: str) -> Result[None, str]:
    """Append one newline-terminated item to a small release inventory."""
    mut text = ""
    if path.is_file():
        text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
    return path.write_text(text + line + "\n", "utf-8", "strict", None).map_err((error) => error.message())


def lines(text: str) -> list[str]:
    """Return nonempty file lines while ignoring one final newline."""
    return [line for line in text.split("\n") if line != ""]


def read_json(path: Path) -> Result[JsonValue, str]:
    """Read one UTF-8 JSON document."""
    text = path.read_text("utf-8", "strict").map_err((error) => f"{path.0}: {error.message()}")?
    return JsonValue.parse(text).map_err((error) => f"{path.0}: {error.message()}")


def write_json(path: Path, value: JsonValue) -> Result[None, str]:
    """Write one pretty JSON document with a trailing newline."""
    text = value.to_pretty_json().map_err((error) => error.message())? + "\n"
    return path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())


def replace_json(path: Path, value: JsonValue) -> Result[None, str]:
    """Publish one JSON document through a same-directory staged file."""
    staged = Path(f"{path.0}.next")
    write_json(staged, value)?
    if path.exists() or path.is_symlink():
        path.unlink().map_err((error) => error.message())?
    _ = staged.move(path).map_err((error) => error.message())?
    return Ok(None)


def entries(value: JsonValue, key: str) -> Result[list[JsonValue], str]:
    """Read an array field, or a root array when `key` is empty."""
    if key == "":
        return value.expect_array().map_err((error) => error.message())
    match value.get(key):
        Some(found) => return found.expect_array().map_err((error) => error.message())
        None => return Ok([])


def codegraph_on_request(value: JsonValue) -> Result[bool, str]:
    """Use separate graph publication only after the selected compiler generation advertises support."""
    match value.get("codegraph_on_request"):
        None => return Ok(false)
        Some(found) => return found.expect_bool().map_err((error) => f"codegraph_on_request: {error.message()}")


def manifest_text(value: JsonValue, key: str) -> Result[str, str]:
    """Read one required string field from a JSON object."""
    return value.require(key).and_then((found) => found.expect_str()).map_err((error) => f"{key}: {error.message()}")


def absolute(value: str, base: Path) -> Path:
    """Resolve a manifest path against the directory that owns the document."""
    if value.startswith("/"):
        return Path(value)
    return base.joinpath(value)
