"""Generate the native plan's Crumb schemas and projections from the compiler's retained DTO declarations."""

from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from check_support import read, repository_root

const PROFILE: str = "incan.native-plan/5."
const GENERATED: str = "# Generated native-plan wire projections."
const LOWER: str = "abcdefghijklmnopqrstuvwxyz"
const UPPER: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const ASCII: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"


model Member:
    name: str
    types: list[str]


model Shape:
    owner: str
    name: str
    record: bool
    public: bool
    members: list[Member]


def owners() -> list[str]:
    return ["layout_type_records", "body_records", "nominal_identities", "function_records", "layout_records"]


def roots() -> list[str]:
    return [
        "function_records.StoredProduct", "function_records.StoredFunction", "function_records.StoredExternal",
        "layout_records.StoredLayoutModelDeclaration", "layout_records.StoredLayoutEnumDeclaration",
        "layout_records.StoredLayoutZipCarrier",
    ]


def scalars() -> dict[str, str]:
    return {"int": "i64", "u8": "u8", "u64": "u64", "float": "fp64", "str": "string", "bool": "boolean", "bytes": "binary"}


def slug(name: str) -> str:
    """Spell CamelCase or list[StoredField] as the local projection function's snake-case stem."""
    mut result = ""
    mut previous = ""
    for char in name:
        if char in UPPER and (previous in LOWER or previous in "0123456789") and previous != "":
            result += "_"
        if char in LOWER or char in UPPER or char in "0123456789_":
            result += char.lower()
        elif not result.endswith("_"):
            result += "_"
        previous = char
    if result.endswith("_"):
        return result[:-1]
    return result


def identity(name: str) -> str:
    return hexlify(sha256.digest(name.encode()))[:12]


def literal(name: str, selector: bool = false) -> str:
    """Six profile-local identity bytes, followed by zero closed arguments only for a nominal selector."""
    data = sha256.digest(name.encode())
    text = hexlify(data)
    mut result = "b\""
    for index in range(6):
        numeric = int(data[index])
        if numeric >= 32 and numeric < 127 and numeric != 34 and numeric != 92:
            result += ASCII[numeric - 32]
        else:
            result += "\\x" + text[index * 2:index * 2 + 2]
    if selector:
        result += "\\x00"
    return result + "\""


def declarations(owner: str, source: str) -> Result[list[Shape], str]:
    """Read the closed stored model/enum declaration grammar and reject unfamiliar members."""
    mut shapes: list[Shape] = []
    mut active = false
    mut doc = false
    for line in source.split("\n"):
        text = line.strip()
        if text == GENERATED:
            break
        if doc:
            if "\"\"\"" in text:
                doc = false
            continue
        if text.startswith("\"\"\""):
            doc = len(text) < 6 or not text.endswith("\"\"\"")
            continue
        if text == "" or text.startswith("#"):
            continue
        if not line.startswith(" "):
            active = false
            mut header = text.clone()
            public = header.startswith("pub ")
            if public:
                header = header[4:]
            record = header.startswith("model ")
            if not (record or header.startswith("enum ")):
                continue
            name = header.split(" ")[1].split("(")[0].split(":")[0]
            if not (name.startswith("Stored") or name in ["ProductNominal", "NominalKind"]):
                continue
            shapes.append(Shape(owner=owner, name=name, record=record, public=public, members=[]))
            active = true
            continue
        if not active:
            continue
        mut member = text.split("#")[0].strip()
        if member.startswith("pub "):
            member = member[4:]
        mut name = ""
        mut types: list[str] = []
        if shapes[len(shapes) - 1].record:
            fields = member.split(":")
            if len(fields) != 2:
                return Err(f"unrecognized retained field in {owner}: {member}")
            name = fields[0].strip()
            types.append(fields[1].split(" =")[0].strip())
        else:
            signature = member.split(" =")[0].split("(")
            name = signature[0].strip()
            if len(signature) > 1:
                if len(signature) != 2 or not member.endswith(")"):
                    return Err(f"unrecognized retained alternative in {owner}: {member}")
                types = [item.strip() for item in signature[1][:-1].split(",")]
        shapes[len(shapes) - 1].members.append(Member(name=name, types=types))
    return Ok(shapes)


def children(shape: Shape, inventory: dict[str, Shape]) -> Result[list[str], str]:
    mut result: list[str] = []
    for member in shape.members:
        for ty in member.types:
            mut item = ty.clone()
            while "[" in item:
                item = item[len(item.split("[")[0]) + 1:-1]
            if item not in scalars():
                result.append(resolve(shape.owner, item, inventory)?)
    return Ok(result)


def resolve(owner: str, name: str, inventory: dict[str, Shape]) -> Result[str, str]:
    local = owner + "." + name
    if local in inventory:
        return Ok(local)
    if name == "StoredSpan":
        return Ok("body_records.StoredSpan")
    candidates: list[str] = [str(key) for key in inventory.keys() if str(key).endswith("." + name)]
    if len(candidates) != 1:
        return Err(f"ambiguous or missing native wire type {owner}.{name}")
    return Ok(candidates[0])


def closure(key: str, inventory: dict[str, Shape]) -> Result[list[str], str]:
    mut visited: set[str] = set()
    mut queue = [key]
    while len(queue) > 0:
        item = queue.pop()
        if item not in visited:
            visited.add(item)
            for dependency in children(inventory[item], inventory)?:
                queue.append(dependency)
    return Ok(sorted([name for name in visited]))


def storage(owner: str, ty: str, inventory: dict[str, Shape]) -> Result[str, str]:
    if "[" in ty:
        opening = len(ty.split("[")[0])
        return Ok(ty[:opening].lower() + "<" + storage(owner, ty[opening + 1:-1], inventory)? + ">")
    primitives = scalars()
    if ty in primitives:
        return Ok(primitives[ty])
    key = resolve(owner, ty, inventory)?
    match inventory.get(key):
        Some(shape) =>
            if shape.record:
                return Ok("record@" + identity(PROFILE + key))
            return Ok("enum@" + identity(PROFILE + key))
        None => return Err("unresolved native wire declaration " + key)


def schema_name(shape: Shape) -> str:
    if shape.name == "StoredSpan":
        return "schema_" + shape.owner + "_span"
    return "schema_" + slug(shape.name)


def field(owner: str, name: str, ty: str, inventory: dict[str, Shape]) -> Result[str, str]:
    kind = storage(owner, ty, inventory)?
    return Ok("ModelField(identity=" + literal(name) + ", name=\"" + name + "\", storage=\"" + kind + "\")")


def unique(names: list[str]) -> Result[None, str]:
    mut seen: set[str] = set()
    for name in names:
        key = identity(name)
        if key in seen:
            return Err(f"collision in native plan wire profile at {name}")
        seen.add(key)
    return Ok(None)


def schema(shape: Shape, inventory: dict[str, Shape]) -> Result[list[str], str]:
    name = str(PROFILE) + shape.owner + "." + shape.name
    mut kind = "enum_schema"
    if shape.record:
        kind = "model_description"
    mut lines = ["", "", "def " + schema_name(shape) + "() -> Description:",
        "    return " + kind + "(" + literal(name, true) + ", \"" + name + "\", ["]
    unique([member.name for member in shape.members])?
    for member in shape.members:
        if shape.record:
            lines.append("        " + field(shape.owner, member.name, member.types[0], inventory)? + ",")
        else:
            mut parts: list[str] = []
            unique([str(index) for index in range(len(member.types))])?
            for index in range(len(member.types)):
                parts.append(field(shape.owner, str(index), member.types[index], inventory)?)
            lines.append("        variant_schema(" + literal(member.name) + ", \"" + member.name + "\", [" + ", ".join(parts) + "]),")
    lines.append("    ])")
    return Ok(lines)


def convert(ty: str, value: str, writing: bool, depth: int, mut options: set[str]) -> Result[str, str]:
    """A projection follows the declared nodes, preserving the distinction between list, option, scalar and nominal."""
    if ty.startswith("list["):
        name = "item" + str(depth)
        inner = convert(ty[5:-1], name, writing, depth + 1, options)?
        if writing:
            return Ok("Value.List([" + inner + " for " + name + " in " + value + "])")
        return Ok("[" + inner + " for " + name + " in items(" + value + ")?]")
    if ty.startswith("Option["):
        inner = ty[7:-1]
        options.add(inner)
        name = slug(inner)
        if writing:
            return Ok("wire_optional_" + name + "(" + value + ")")
        return Ok("read_optional_" + name + "(" + value + ", positions)?")
    if writing:
        if ty == "u8" or ty == "u64":
            return Ok("Value.Integer(IntegerValue.Unsigned(" + value + ".wrapping_resize[u128]()))")
        types = {"int": "wire_integer", "float": "float_value", "bool": "Value.Boolean", "str": "Value.Text", "bytes": "Value.Binary"}
        if ty in types:
            return Ok(types[ty] + "(" + value + ")")
        return Ok("wire_" + slug(ty) + "(" + value + ")")
    if ty == "u8":
        return Ok("unsigned_value(" + value + ")?.wrapping_resize[u8]()")
    types = {"int": "number", "float": "read_float", "bool": "boolean_value", "str": "text", "u64": "unsigned_value", "bytes": "binary_value"}
    if ty in types:
        return Ok(types[ty] + "(" + value + ")?")
    return Ok("read_wire_" + slug(ty) + "(" + value + ", positions)?")


def slots(names: list[str]) -> dict[str, int]:
    mut ordered: list[tuple[str, str]] = []
    for name in names:
        ordered.append((identity(name), name))
    ordered = sorted(ordered)
    mut result: dict[str, int] = {}
    for index in range(len(ordered)):
        result[ordered[index][1]] = index
    return result


def reading(slot: int) -> str:
    return "fields[" + str(slot) + "].value"


def positional(name: str, arguments: list[str]) -> str:
    if len(arguments) == 0:
        return name
    return name + "(" + ", ".join(arguments) + ")"


def projections(shape: Shape, mut options: set[str]) -> Result[list[str], str]:
    mut public = ""
    if shape.public:
        public = "pub "
    stem = slug(shape.name)
    mut output = ["", "", public + "def wire_" + stem + "(value: " + shape.name + ") -> Value:"]
    mut restored = ["", "", public + "def read_wire_" + stem + "(value: Value, positions: &WirePositions) -> Result[" + shape.name + ", str]:"]
    if shape.record:
        output.append("    return Value.Record([")
        restored.append("    fields = wire_fields(value, " + str(len(shape.members)) + ")?")
        fields = slots([member.name for member in shape.members])
        for member in shape.members:
            projected = convert(member.types[0], "value." + member.name, true, 0, options)?
            output.append("        required_value(" + literal(member.name) + ", " + projected + "),")
        output.append("    ])")
        if shape.name == "StoredSpan":
            restored.append("    file, line, column = positions.apply(text(" + reading(fields["file"]) + ")?, number(" + reading(fields["line"]) + ")?, number(" + reading(fields["column"]) + ")?)?")
            restored.append("    return Ok(StoredSpan(file=file, line=line, column=column))")
        else:
            restored.append("    return Ok(" + shape.name + "(")
            for member in shape.members:
                expression = convert(member.types[0], reading(fields[member.name]), false, 0, options)?
                restored.append("        " + member.name + "=" + expression + ",")
            restored.append("    ))")
    else:
        output.append("    match value:")
        restored.append("    identity, fields = wire_variant(value)?")
        for member in shape.members:
            names = [str(index) for index in range(len(member.types))]
            fields = slots(names)
            mut bindings: list[str] = []
            mut projected: list[str] = []
            mut constructor: list[str] = []
            for index in range(len(member.types)):
                key = str(names[index])
                binding = "field" + key
                bindings.append(binding)
                projected.append("required_value(" + literal(key) + ", " + convert(member.types[index], binding, true, 0, options)? + ")")
                constructor.append(convert(member.types[index], reading(fields[key]), false, 0, options)?)
            name = shape.name + "." + member.name
            tag = literal(member.name)
            output.append("        " + positional(name, bindings) + " => return Value.Enum(" + tag + ", [" + ", ".join(projected) + "])")
            restored.append("    if identity == " + tag + " and len(fields) == " + str(len(names)) + ":")
            restored.append("        return Ok(" + positional(name, constructor) + ")")
        restored.append("    return Err(\"unknown or incomplete " + shape.name + " alternative\")")
    return Ok(output + restored)


def optional(ty: str) -> Result[list[str], str]:
    mut nested: set[str] = set()
    suffix = slug(ty)
    return Ok(["", "", "def wire_optional_" + suffix + "(value: Option[" + ty + "]) -> Value:",
        "    match value:", "        Some(item) => return Value.Some([" + convert(ty, "item", true, 0, nested)? + "])",
        "        None => return Value.NoneValue", "", "",
        "def read_optional_" + suffix + "(value: Value, positions: &WirePositions) -> Result[Option[" + ty + "], str]:",
        "    match value:", "        Value.NoneValue => return Ok(None)", "        Value.Some(children) =>",
        "            if len(children) == 1:", "                return Ok(Some(" + convert(ty, "children[0]", false, 0, nested)? + "))",
        "        _ => pass", "    return Err(\"invalid native plan option\")"])


def run() -> Result[None, str]:
    root = repository_root()?
    directory = root.joinpath("loaves/compiler/incan_mir_plan/src")
    mut files: dict[str, str] = {}
    mut inventory: dict[str, Shape] = {}
    for owner in owners():
        source = read(directory.joinpath(owner + ".incn"))?
        files[owner] = source
        for shape in declarations(owner, source)?:
            inventory[owner + "." + shape.name] = shape
    mut reachable: set[str] = set()
    for key in roots():
        for child in closure(key, inventory)?:
            reachable.add(child)
    order = sorted([name for name in reachable])
    unique([str(PROFILE) + key for key in order])?
    mut descriptions = ["\"\"\"Generated schema descriptions for the compiler-owned native-plan profile.\"\"\"", "",
        "from std.primitives.crumb.descriptions import Description", "from crumb_rows import ModelField, model_description",
        "from plan_wire_rows import enum_schema, variant_schema"]
    for key in order:
        descriptions += schema(inventory[key], inventory)?
    for key in roots():
        descriptions += ["", "", "pub def " + slug(inventory[key].name) + "_descriptions() -> list[Description]:", "    return ["]
        for child in closure(key, inventory)?:
            descriptions.append("        " + schema_name(inventory[child]) + "(),")
        descriptions.append("    ]")
    mut outputs: dict[str, str] = {}
    outputs[root.joinpath("loaves/compiler/internal_models/src/plan_wire_schema.incn").0] = "\n".join(descriptions) + "\n"
    for owner in owners():
        mut lines: list[str] = []
        mut options: set[str] = set()
        for key in order:
            if inventory[key].owner == owner:
                lines += projections(inventory[key], options)?
        for ty in sorted([name for name in options]):
            lines += optional(ty)?
        parts = files[owner].split(GENERATED)
        if len(parts) != 2:
            return Err("native plan source requires exactly one generated projection section: " + owner)
        outputs[directory.joinpath(owner + ".incn").0] = parts[0] + GENERATED + "\n" + "\n".join(lines) + "\n"
    for name in outputs.keys():
        if read(Path(name))? != outputs[name]:
            Path(name).write_text(outputs[name], "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(None)


def main() -> Result[None, str]:
    return run()
