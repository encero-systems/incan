"""Verify reference prose rules, their exclusions and untracked-page discovery."""

from rust::std::process import Command
from rust::std::string import String as RustString
from std.environ import get_or
from std.fs import Path
from std.tempfile import TemporaryDirectory
from check_reference_contract import page_findings, changed_pages
from check_support import git, repository_root
from check_test_support import Outcome


def test_flags_each_rule_in_prose() -> Result[None, str]:
    """Every lexical rule reports a violating source line."""
    for rule, text in [
        ("comparison with another language", "Renders as Python spells it.\n"),
        ("time-bound wording", "This is currently refused.\n"),
        ("issue or RFC number", "Refused (#1767).\n"),
        ("advice", "Prefer `@derive(Eq, Hash)`.\n"),
        ("rationale", "It is refused because the type has no fields.\n"),
        ("walkthrough heading", "## Example: chaining errors\n"),
        ("compiler-internal vocabulary", "The call lowers to a method.\n"),
        ("quoted diagnostic output", "```bash\ntype error: Unknown derive 'Debg'\n```\n"),
        ("example comment", "```incan\nx = f(1)   # the first alternative binds x\n```\n"),
    ]:
        assert rule in findings(text)?
    return Ok(None)


def test_example_comments_say_accepted_or_refused() -> Result[None, str]:
    """Accepted and refused annotations, file labels and hashes inside strings pass."""
    text = (
        "```incan\n# accounts.incn\nx = f(1)          # accepted\n"
        + "y = g(\"#tag\")    # refused: g takes an int\n```\n"
    )
    assert findings(text)? == []
    return Ok(None)


def test_ignores_code_links_and_see_also() -> Result[None, str]:
    """Code, inline code, link targets and See also sections are outside prose rules."""
    text = (
        "Refused with `INCAN-T0001` (see [RFC notes](../x/rfc-123.md)).\n"
        + "| Alternation | <code>p1 &#124; p2</code> |\n"
        + "```incan\n# refused: currently refused, because\n```\n"
        + "## See also\n\n- [Rust types for Python developers](../how-to/rust.md)\n"
    )
    assert findings(text)? == []
    return Ok(None)


def test_internal_vocabulary_applies_to_language_pages_only() -> Result[None, str]:
    """Tooling reference pages may document compiler internals."""
    assert findings("Shows the generated Rust.\n", "tooling/reference/cli.md")? == []
    return Ok(None)


def test_changed_pages_include_untracked_reference_pages() -> Result[None, str]:
    """Working-tree discovery includes a real untracked reference page in an isolated repository."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    root = temporary.path()
    _ = git(root, ["init", "-q"])?
    path = root.joinpath("workspaces/docs-site/docs/tooling/reference/new_contract.md")
    path.parent().mkdir(True, True).map_err((error) => error.message())?
    path.write_text("Contract.\n", "utf-8", "strict", None).map_err((error) => error.message())?
    assert changed_pages(root, "")? == ["tooling/reference/new_contract.md"]
    return Ok(None)


def test_make_checks_every_reference_page() -> Result[None, str]:
    """Check both reference gates and the commands printed by the repository checkers."""
    root = repository_root()?
    for target in ["docs", "pre-commit"]:
        output = Command.new("make").current_dir(root.0).arg("-n").arg(target).output().map_err(
            (error) => error.to_string(),
        )?
        assert output.status.success()
        commands = RustString.from_utf8(output.stdout).map_err((error) => error.to_string())?
        assert "run scripts/check_reference_contract.incn -- --all" in commands, target
    check_repository_checker_usage(root)?
    return Ok(None)


def check_repository_checker_usage(root: Path) -> Result[None, str]:
    """Require accurate help and malformed-option output from the normal checker entry points."""
    mut mismatches: list[str] = []
    for name in ["check_changed_rustdocs", "check_doc_paths", "check_reference_contract", "check_us_english"]:
        invocation = f"usage: incan run scripts/{name}.incn --"
        help = invoke_checker(root, name, "--help")?
        if help.code != 0 or invocation not in help.stdout:
            mismatches.append(f"{name} help exited {help.code} or did not name the current invocation")
        refused = invoke_checker(root, name, "--unknown-option")?
        expected_error = f"{name}: error: unrecognized arguments: --unknown-option"
        if refused.code != 2 or invocation not in refused.stderr or expected_error not in refused.stderr:
            mismatches.append(f"{name} did not report the invalid option with its current invocation")
    assert mismatches == [], "\n".join(mismatches)
    return Ok(None)


def invoke_checker(root: Path, name: str, flag: str) -> Result[Outcome, str]:
    """Run one checker from the checkout and capture its exit status and both text streams."""
    mut command = Command.new(get_or("INCAN", "incan"))
    command.current_dir(root.0).arg("run").arg(f"scripts/{name}.incn").arg("--").arg(flag)
    output = command.output().map_err((error) => f"cannot run {name}: {error}")?
    stdout = RustString.from_utf8(output.stdout).map_err((error) => f"invalid {name} stdout: {error}")?
    stderr = RustString.from_utf8(output.stderr).map_err((error) => f"invalid {name} stderr: {error}")?
    return Ok(Outcome(code=output.status.code().unwrap_or(-1), stdout=stdout, stderr=stderr))


def findings(text: str, page: str = "language/reference/sample.md") -> Result[list[str], str]:
    """Read the rule names reported for one in-memory reference page."""
    return Ok([finding.rule for finding in page_findings(text, page, [])?])
