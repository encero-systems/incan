"""Share source-location, text, and subprocess operations across repository checks."""

from rust::std::env import current_exe
from rust::std::io import Write, stderr
from rust::std::path import Path as RustPath
from rust::std::process import Command
from rust::std::string import String as RustString
from std.fs import Path
from std.regex import Regex


pub def repository_root() -> Result[Path, str]:
    """Find the repository above the scripts project's Oven output directory."""
    binary = current_exe().map_err((error) => error.to_string())?
    return repository_above(Path(binary.to_string_lossy().into_owned()).parent())


pub def repository_above(start: Path) -> Result[Path, str]:
    """Find a checkout above an absolute directory, refusing a root without one instead of cycling path spellings."""
    if not RustPath.new(start.0).is_absolute():
        return Err(f"cannot find repository above a relative path: {start.0}")
    mut directory = start
    while true:
        if directory.joinpath("AGENTS.md").is_file() and directory.joinpath("scripts/check_support.incn").is_file():
            return Ok(directory)
        parent = directory.parent()
        if parent.0 in [directory.0, "", "."]:
            return Err(f"cannot find repository above {start.0}")
        directory = parent


pub def read(path: Path) -> Result[str, str]:
    """Read a repository file as strict UTF-8."""
    return path.read_text("utf-8", "strict").map_err((error) => error.message())


pub def git(root: Path, arguments: list[str]) -> Result[str, str]:
    """Capture a Git command in the selected repository and propagate command failures."""
    mut command = Command.new("git")
    command.current_dir(root.0)
    for argument in arguments:
        command.arg(argument)
    output = command.output().map_err((error) => error.to_string())?
    if not output.status.success():
        return Err(RustString.from_utf8(output.stderr).map_err((error) => error.to_string())?)
    return RustString.from_utf8(output.stdout).map_err((error) => error.to_string())


pub def write_stderr(message: str) -> None:
    """Write a complete diagnostic, ignoring a closed diagnostic stream."""
    mut err = stderr()
    _ = err.write_all(RustString.from(message).into_bytes())


pub def source_lines(source: str) -> Result[list[str], str]:
    """Split Python-compatible Unicode line boundaries without an artificial final empty line."""
    if source == "":
        return Ok([])
    separator = Regex("\\r\\n|[\\n\\r\\x0b\\x0c\\x1c-\\x1e\\u0085\\u2028\\u2029]")
        .map_err((error) => error.message())?
    mut lines: list[str] = [line for line in separator.split(source)]
    if len(lines) > 0 and lines[len(lines) - 1] == "":
        lines = lines[:-1]
    return Ok(lines)
