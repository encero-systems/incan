"""
Preserve each release registry unit's source checksum under its admitted provenance.

Legacy seed units use the pinned upstream package digest. Issued units retain the authenticated Loaf archive digest and
publisher revision. The candidate writes its own closure while sharing the seed's compiled entries and producer choices.
"""

from std.fs import Path
from std.json import JsonValue
from release_support import write_json

pub const REGISTRY_CHECKSUMS: str = "scripts/registry-checksums.json"


model SourceArchivePin:
    """An already authenticated Loaf publisher, decimal revision and archive digest."""

    issuer: str
    revision: str
    checksum: str


pub def write_checksummed_registry(toolchain: Path, pins: Path) -> Result[None, str]:
    """
    Write the candidate's checked registry closure and name it from the candidate manifest.

    1. Validate the complete selected seed closure and release pins before touching the candidate registry.
    2. Link the admitted compiled entries and producer records beside the new closure.
    3. Write that closure and make its manifest path relative. The seed's own closure is never written.
    """
    # 1. Resolve and check the admitted source before creating the candidate's registry.
    manifest = toolchain.joinpath("toolchain.json")
    document = read_json(manifest)?
    seed_closure = optional_text(document, "registry_units")?
    if seed_closure == "":
        return Ok(None)
    if not seed_closure.startswith("/"):
        return Err(f"the candidate manifest names its seed registry closure by a relative path: {seed_closure}")
    source = Path(seed_closure)
    closure = checksummed_closure(read_json(source)?, read_json(pins)?)?
    mut fields = document.expect_object().map_err((error) => error.message())?
    fields["registry_units"] = JsonValue.string("registry/closure.json")
    siblings = source.parent().iterdir().map_err((error) => error.message())?

    # 2. Keep the seed's compiled artifacts and selection under their original identities.
    registry = toolchain.joinpath("registry")
    registry.mkdir(true, true).map_err((error) => error.message())?
    for child in siblings:
        if child.name() != source.name():
            registry.joinpath(child.name()).symlink_to(child).map_err((error) => error.message())?

    # 3. Publish the checked closure before naming it from the candidate manifest.
    write_json(registry.joinpath("closure.json"), closure)?
    return write_json(manifest, JsonValue.object(fields))


pub def checksummed_closure(closure: JsonValue, pins: JsonValue) -> Result[JsonValue, str]:
    """
    Validate source checksums for an already admitted compiled registry closure.

    Every unit keeps its upstream pin. Legacy rows carry that digest in the closure. Issued rows keep the source archive
    digest, under an independently admitted issuer and revision in the release policy. Compiled identity is unchanged.
    """
    checksums = pins.require("checksums").map_err((error) => f"{REGISTRY_CHECKSUMS}: {error.message()}")?
    mut units: list[JsonValue] = []
    mut unpinned: list[str] = []
    listed: list[JsonValue] = closure.require("units").map_err((error) => error.message())?.expect_array().map_err(
        (error) => error.message(),
    )?
    for item in listed:
        loaf = optional_text(item, "loaf")?
        version = optional_text(item, "version")?
        upstream = pinned_checksum(checksums, loaf, version)?
        if upstream == "":
            if f"{loaf} {version}" not in unpinned:
                unpinned.append(f"{loaf} {version}")
            continue
        checksum = unit_source_checksum(item, pins, loaf, version, upstream)?
        mut unit = item.expect_object().map_err((error) => error.message())?
        unit["checksum"] = JsonValue.string(checksum)
        units.append(JsonValue.object(unit))
    if len(unpinned) > 0:
        return Err(f"{REGISTRY_CHECKSUMS} pins no checksum for: {", ".join(sorted(unpinned))}")
    mut fields = closure.expect_object().map_err((error) => error.message())?
    fields["units"] = JsonValue.array(units)
    return Ok(JsonValue.object(fields))


def unit_source_checksum(item: JsonValue, pins: JsonValue, loaf: str, version: str, upstream: str) -> Result[str, str]:
    """Return the digest belonging to the unit's admitted source domain."""
    issuer = optional_text(item, "registry")?
    revision = optional_text(item, "revision")?
    recorded = optional_text(item, "checksum")?
    if issuer == "" and revision == "":
        if recorded != "" and recorded != upstream:
            return Err(f"the registry unit of {loaf} {version} records {recorded}; {REGISTRY_CHECKSUMS} pins {upstream}")
        return Ok(upstream)

    if issuer == "":
        return Err(f"the registry unit of {loaf} {version} records a revision without a registry")
    if not is_issued_revision(revision):
        return Err(f"the registry unit of {loaf} {version} needs a decimal-string revision")
    archive = pinned_source_archive(pins, loaf, version)?
    if issuer != archive.issuer:
        return Err(f"{loaf} {version} records registry {issuer}; source archive pins {archive.issuer}")
    if revision != archive.revision:
        return Err(f"{loaf} {version} records revision {revision}; source archive pins {archive.revision}")
    if recorded != archive.checksum:
        return Err(f"{loaf} {version} records source archive checksum {recorded}; pins {archive.checksum}")
    return Ok(recorded)


def pinned_source_archive(pins: JsonValue, loaf: str, version: str) -> Result[SourceArchivePin, str]:
    """Read one exact issued source pin independently of the upstream checksum map."""
    archive = pins
        .require("source_archives")
        .and_then((loaves) => loaves.require(loaf))
        .and_then((versions) => versions.require(version))
        .map_err((error) => f"{REGISTRY_CHECKSUMS} source archive for {loaf} {version}: {error.message()}")?
    issuer = optional_text(archive, "registry")?
    revision = optional_text(archive, "revision")?
    checksum = optional_text(archive, "checksum")?
    if issuer == "":
        return Err(f"the source archive pin for {loaf} {version} needs a registry")
    if not is_issued_revision(revision):
        return Err(f"the source archive pin for {loaf} {version} needs a decimal-string revision")
    if not is_sha256(checksum):
        return Err(f"the source archive pin for {loaf} {version} needs a sha256 checksum")
    return Ok(SourceArchivePin(issuer=issuer, revision=revision, checksum=checksum))


def is_issued_revision(value: str) -> bool:
    """Check the registry's positive decimal revision spelling without changing the wire value."""
    if value == "" or value.startswith("0"):
        return false
    for character in value:
        if character not in "0123456789":
            return false
    return true


def pinned_checksum(checksums: JsonValue, loaf: str, version: str) -> Result[str, str]:
    """The `sha256:` checksum pinned for one Loaf version, or empty when none is pinned."""
    match checksums.get(loaf):
        None => return Ok("")
        Some(versions) =>
            pinned = optional_text(versions, version)?
            if pinned != "" and not is_sha256(pinned):
                return Err(f"{REGISTRY_CHECKSUMS} pins {loaf} {version} to `{pinned}`, not a `sha256:` digest")
            return Ok(pinned)


pub def is_sha256(value: str) -> bool:
    """Whether `value` is `sha256:` followed by 64 lowercase hexadecimal digits."""
    if not value.startswith("sha256:") or len(value) != 71:
        return false
    for character in value[7:]:
        if character not in "0123456789abcdef":
            return false
    return true


def optional_text(value: JsonValue, key: str) -> Result[str, str]:
    """One optional JSON object string, empty when absent."""
    match value.get(key):
        Some(entry) => return entry.expect_str().map_err((error) => f"{key}: {error.message()}")
        None => return Ok("")


def read_json(path: Path) -> Result[JsonValue, str]:
    """Read one UTF-8 JSON document, naming its path on failure."""
    text = path.read_text("utf-8", "strict").map_err((error) => f"{path.0}: {error.message()}")?
    return JsonValue.parse(text).map_err((error) => f"{path.0}: {error.message()}")
