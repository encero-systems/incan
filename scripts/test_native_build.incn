"""Verify how native release production schedules the shipped tools beside the debug standard providers."""

from std.fs import Path
from native_build import (
    NativeContext,
    PROJECT_RESERVATION_BYTES,
    STANDARD_RESERVATION_BYTES,
    ShippedToolOverlap,
    common_environment,
    shipped_tool_overlap,
    tool_build_plan,
)

const GIB: int = 1073741824


def test_oven_starts_first_and_never_waits_for_the_debug_providers_it_does_not_read() -> Result[None, str]:
    """
    Oven is the longest shipped build: with two children it runs beside the debug waves and the language server, which
    take turns in the other; with three every one runs beside the others; with one, or without memory for a second
    project child beside a standard one, they run in turn.
    """
    assert shipped_tool_overlap(1, 64 * GIB) == ShippedToolOverlap.Serial
    assert shipped_tool_overlap(2, 64 * GIB) == ShippedToolOverlap.OvenBeside
    assert shipped_tool_overlap(3, 64 * GIB) == ShippedToolOverlap.AllBeside
    assert shipped_tool_overlap(8, 64 * GIB) == ShippedToolOverlap.AllBeside
    one_beside = PROJECT_RESERVATION_BYTES + STANDARD_RESERVATION_BYTES
    assert shipped_tool_overlap(3, one_beside) == ShippedToolOverlap.OvenBeside
    assert shipped_tool_overlap(3, one_beside + PROJECT_RESERVATION_BYTES) == ShippedToolOverlap.AllBeside
    assert shipped_tool_overlap(4, one_beside - 1) == ShippedToolOverlap.Serial
    return Ok(None)


def test_every_production_step_names_its_own_builder_as_the_engine() -> Result[None, str]:
    """
    Oven hands a scheduled unit to `OVEN_ENGINE_BINARY`. A release's step must name the Oven building it there, the
    seed's in the seed context and the conductor in the candidate's, so no unit is keyed by another Oven's identities.
    """
    context = NativeContext(
        repo=Path("/repo"),
        lane=Path("/lane"),
        home=Path("/home"),
        builder="/lane/oven-bin/incan",
        stdlib="/repo/loaves/stdlib",
        evidence=Path("/evidence"),
        timings=Path("/evidence/timings.tsv"),
        jobs=2,
        memory=0,
        timeout_seconds=60,
    )
    environment = common_environment(context)
    assert environment["OVEN_ENGINE_BINARY"] == "/lane/oven-bin/incan"
    assert environment["SELFBUILD_OVEN"] == environment["OVEN_ENGINE_BINARY"]
    return Ok(None)


def test_the_oven_build_observer_runs_as_the_release_runner_and_hands_the_build_its_own_context() -> Result[None, str]:
    """
    The shipped Oven build is sampled by the release program's own observer script. The observer is the runner's tool:
    it runs on the runner's Oven in the runner's inherited home, standard library and Bakery, and names that Oven as
    its engine, so it never compiles against a build home whose debug providers are still being published. The build
    it observes is the candidate's, and gets the candidate context whole, as every production step does.
    """
    context = NativeContext(
        repo=Path("/repo"),
        lane=Path("/lane"),
        home=Path("/home"),
        builder="/lane/conductor",
        stdlib="/repo/loaves/stdlib",
        evidence=Path("/evidence"),
        timings=Path("/evidence/timings.tsv"),
        jobs=2,
        memory=0,
        timeout_seconds=60,
        runner="/seed/bin/incan",
    )
    observer = tool_build_plan(context, "oven", false, "oven-build")?.child
    assert observer.executable == "/seed/bin/incan"
    assert observer.environment["OVEN_ENGINE_BINARY"] == "/seed/bin/incan"
    for name in ["INCAN_HOME", "INCAN_STDLIB", "INCAN_BAKERY", "SELFBUILD_OVEN"]:
        assert name not in observer.environment
    candidate = common_environment(context)
    handed = [argument for argument in observer.arguments if "=" in argument and argument.split("=")[0] in candidate]
    assert len(handed) == len(candidate)
    assert "OVEN_ENGINE_BINARY=/lane/conductor" in handed
    assert "INCAN_HOME=/home" in handed
    assert "INCAN_STDLIB=/repo/loaves/stdlib" in handed
    assert "/lane/conductor" in observer.arguments
    lsp = tool_build_plan(context, "lsp", false, "lsp-build")?.child
    assert lsp.executable == "/lane/conductor"
    assert lsp.environment["OVEN_ENGINE_BINARY"] == "/lane/conductor"
    assert lsp.environment["INCAN_HOME"] == "/home"
    return Ok(None)
