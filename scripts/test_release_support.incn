"""Verify release argument, baseline, receipt, and byte-comparison contracts without native production."""

from std.fs import Path
from std.json import JsonValue
from std.tempfile import TemporaryDirectory
from native_build import (
    LOWERING_RESERVATION_BYTES,
    PROJECT_RESERVATION_BYTES,
    STANDARD_RESERVATION_BYTES,
    StandardGeneration,
    StandardProfile,
    standard_build_waves,
    standard_profiles,
)
from release_support import (
    FAMILIES,
    BaselineReport,
    Counts,
    ReleaseTrace,
    append_bytes,
    append_timing_file,
    check_baseline,
    parse_release_options,
    parse_verification_options,
    reference_cache_identity,
    reference_cache_root,
    reference_census_jobs,
    reference_worker_arguments,
    reuse_reference_log,
    release_receipt,
    release_rust_cache_root,
    reserved_admitted,
    require_candidate_census,
    same_bytes,
    shared_relocated_sysroot,
    store_reference_log,
    tree_bytes,
    tree_digest,
    verification_program,
)
from verify_installation import census_arguments

const SHA: str = "0123456789abcdef0123456789abcdef01234567"
const COMPLETE_LOG: str = """PASS behavior/a/a
PASS check/a/a
PASS library/a/a
PASS interop/a/a
PASS testing/a/a
PASS project/a/a
PASS format/a/a
PASS graph/a/a
total: 8 passed, 0 failed, 0 pending
"""


def test_release_build_admission_uses_declared_lowering_project_and_standard_memory() -> Result[None, str]:
    """Lowering reserves 6 GiB while project and standard work reserve 2 GiB under one shared budget."""
    gib = 1073741824
    assert LOWERING_RESERVATION_BYTES == 6 * gib
    assert PROJECT_RESERVATION_BYTES == 2 * gib
    assert STANDARD_RESERVATION_BYTES == 2 * gib
    reservations = [LOWERING_RESERVATION_BYTES, PROJECT_RESERVATION_BYTES, STANDARD_RESERVATION_BYTES]
    assert reserved_admitted(reservations, [0, 1, 2], [], 3, 10 * gib) == [0, 1, 2]
    assert reserved_admitted(reservations, [1, 2], [LOWERING_RESERVATION_BYTES], 3, 8 * gib) == [1]
    waves = standard_build_waves()
    assert "vocab" not in waves[0]
    assert "system" in waves[0]
    assert waves[1] == ["codecs", "compression", "data"]
    assert waves[2] == ["vocab"]
    assert waves[3] == ["interop"]
    return Ok(None)


def test_release_census_shares_compilation_without_dropping_a_family() -> Result[None, str]:
    """The installed census keeps every family while leaving shared compilation enabled across its 1,491 cases."""
    arguments = census_arguments(Path("oven"), Path("fixtures"), Path("scratch"), 4, 120)
    assert "--isolated" not in arguments
    assert arguments[0:8] == ["oven", "fixtures", "--scratch", "scratch", "--jobs", "4", "--timeout", "120"]
    assert arguments[8] == "--serial-families"
    assert arguments[9:] == [family for family in FAMILIES]
    assert reference_census_jobs(1) == 1
    assert reference_census_jobs(4) == 2
    worker = reference_worker_arguments(Path("source"), Path("out"), Path("home"), Path("lsp"), 4, 120)
    assert worker == [
        "run",
        "source/scripts/release.incn",
        "--",
        "--reference-census",
        "source",
        "out",
        "home",
        "lsp",
        "2",
        "120",
    ]
    return Ok(None)


def test_release_profiles_keep_seed_consumption_and_candidate_shipping_distinct() -> Result[None, str]:
    """The seed generation needs release providers; the candidate ships release and debug providers."""
    assert standard_profiles(StandardGeneration.SourceClosure) == [StandardProfile.Release]
    assert standard_profiles(StandardGeneration.Candidate) == [StandardProfile.Release, StandardProfile.Debug]
    return Ok(None)


def test_release_arguments_keep_fixed_point_and_process_budgets_explicit() -> Result[None, str]:
    """The two operands and optional retention, proof, jobs, and timeout choices parse in any option position."""
    options = parse_release_options(
        ["--jobs", "6", SHA, "out", "--keep-trees", "--prove-fixed-point", "--timeout", "900"],
    )?
    assert options.source_sha == SHA
    assert options.output.0 == "out"
    assert options.keep_trees
    assert options.prove_fixed_point
    assert options.jobs == 6
    assert options.timeout_seconds == 900
    defaults = parse_release_options([SHA, "out"])?
    assert not defaults.keep_trees
    assert defaults.jobs == 4
    return Ok(None)


def test_release_arguments_refuse_ambiguous_or_unbounded_invocations() -> Result[None, str]:
    """Missing operands, abbreviated SHAs, unknown options, and nonpositive budgets fail closed."""
    assert refused_release([SHA]) == "usage: release.incn SHA OUT [--keep-trees] [--prove-fixed-point] [--jobs N] [--timeout SECONDS]"
    assert refused_release(["deadbeef", "out"]) == "SHA must be a full lowercase source commit"
    assert refused_release([SHA, "out", "--fast"]) == "unknown option `--fast`"
    assert refused_release([SHA, "out", "--jobs", "0"]) == "--jobs needs a positive integer"
    return Ok(None)


def test_verification_arguments_have_independent_defaults() -> Result[None, str]:
    """Installed verification defaults to two workers and a 120-second command timeout."""
    defaults = parse_verification_options(["evidence"])?
    assert defaults.output.0 == "evidence"
    assert defaults.jobs == 2
    assert defaults.timeout_seconds == 120
    selected = parse_verification_options(["--timeout", "300", "evidence", "--jobs", "5"])?
    assert selected.jobs == 5
    assert selected.timeout_seconds == 300
    return Ok(None)


def test_baseline_requires_complete_unique_results_and_preserves_every_pass() -> Result[None, str]:
    """All eight families, one total, unique keys, and every baseline PASS are one indivisible contract."""
    report = check_baseline("# measured\nbehavior/a/a\ngraph/a/a\n", COMPLETE_LOG)?
    assert report.counts == Counts(passed=8, failed=0, pending=0), "counts"
    assert report.baseline_keys == 2, "baseline keys"
    assert report.lost_passes == [], "lost passes"
    failed_behavior = COMPLETE_LOG
        .replace("PASS behavior/a/a", "FAIL behavior/a/a")
        .replace("total: 8 passed, 0 failed", "total: 7 passed, 1 failed")
    lost = refused_baseline("behavior/a/a\n", failed_behavior)
    assert lost == "lost PASS behavior/a/a -> FAIL", lost
    without_graph = COMPLETE_LOG.replace("PASS graph/a/a\n", "").replace("total: 8 passed", "total: 7 passed")
    missing = refused_baseline("behavior/a/a\n", without_graph)
    assert missing == "family absent: graph", missing
    return Ok(None)


def test_one_installed_candidate_census_keeps_seed_inventory_and_passes() -> Result[None, str]:
    """The installed candidate report supplies receipt counts while retaining the independent seed comparison."""
    reference = check_baseline("graph/a/a\n", COMPLETE_LOG)?
    candidate = check_baseline("behavior/a/a\n", COMPLETE_LOG)?
    require_candidate_census(reference, candidate)?
    failed = COMPLETE_LOG
        .replace("PASS behavior/a/a", "FAIL behavior/a/a")
        .replace("total: 8 passed, 0 failed", "total: 7 passed, 1 failed")
    regressed = check_baseline("graph/a/a\n", failed)?
    assert candidate_refusal(reference, regressed) == "candidate lost integration PASS: behavior/a/a"
    return Ok(None)


def test_receipt_keeps_refusal_evidence_distinct_from_success() -> Result[None, str]:
    """The stable receipt carries exact phase, compiler mode, artifacts, counts, and parity state."""
    receipt = release_receipt(
        SHA,
        "aarch64-apple-darwin",
        "passed",
        "complete",
        0,
        42,
        JsonValue.object({"total": JsonValue.int(99)}),
        {"incan": JsonValue.string("abc")},
        "native-fixed-point",
        JsonValue.object({"pass": JsonValue.int(8)}),
        JsonValue.object({"passed": JsonValue.int(141)}),
        JsonValue.bool(true),
    )
    schema = receipt.require("schema").and_then((value) => value.expect_str()).map_err((error) => error.message())?
    assert schema == "incan.release-rehearsal/1"
    assert receipt.require("phase").and_then((value) => value.expect_str()).map_err((error) => error.message())? == "complete"
    compiler_build = receipt
        .require("compiler_build")
        .and_then((value) => value.expect_str())
        .map_err((error) => error.message())?
    assert compiler_build == "native-fixed-point"
    measured = receipt.require("tree_bytes").map_err((error) => error.message())?
    total = measured.require("total").map_err((error) => error.message())?
    total_bytes = total.expect_int().map_err((error) => error.message())?
    assert total_bytes == 99
    assert receipt.require("baseline_parity").and_then((value) => value.expect_bool()).map_err(
        (error) => error.message(),
    )?
    return Ok(None)


def test_byte_comparison_reads_complete_content() -> Result[None, str]:
    """Fixed-point equality accepts identical bytes and refuses a same-sized differing file."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    left = temporary.path().joinpath("left")
    right = temporary.path().joinpath("right")
    left.write_bytes(b"alpha").map_err((error) => error.message())?
    right.write_bytes(b"alpha").map_err((error) => error.message())?
    assert same_bytes(left, right)?
    right.write_bytes(b"alpHa").map_err((error) => error.message())?
    assert not same_bytes(left, right)?
    return Ok(None)


def test_reference_cache_identity_covers_seed_bundle_and_committed_contract_tree() -> Result[None, str]:
    """Changing any seed component or the committed contract tree yields a distinct reference cache key."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    oven = temporary.path().joinpath("incan")
    lsp = temporary.path().joinpath("incan-lsp")
    manifest = temporary.path().joinpath("toolchain.json")
    oven.write_bytes(b"oven-a").map_err((error) => error.message())?
    lsp.write_bytes(b"lsp-a").map_err((error) => error.message())?
    manifest.write_bytes(b"manifest-a").map_err((error) => error.message())?
    original = reference_cache_identity(oven, lsp, manifest, "tree-a")?
    assert reference_cache_root(temporary.path()).0 == temporary.path().joinpath("cache/release-reference").0
    assert release_rust_cache_root(temporary.path()).0 == temporary.path().joinpath("cache/release-rust").0
    assert reference_cache_identity(oven, lsp, manifest, "tree-b")? != original
    lsp.write_bytes(b"lsp-b").map_err((error) => error.message())?
    assert reference_cache_identity(oven, lsp, manifest, "tree-a")? != original
    return Ok(None)


def test_reference_cache_store_moves_then_reuses_complete_evidence() -> Result[None, str]:
    """Cache publication retains the release log, and reuse materializes the same complete bytes."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    log = temporary.path().joinpath("release/reference-contracts.log")
    cached = temporary.path().joinpath("cache/key/contracts.log")
    reused = temporary.path().joinpath("next/reference-contracts.log")
    log.parent().mkdir(true, true).map_err((error) => error.message())?
    reused.parent().mkdir(true, true).map_err((error) => error.message())?
    log.write_text(COMPLETE_LOG, "utf-8", "strict", None).map_err((error) => error.message())?
    store_reference_log(log, cached)?
    assert log.read_text("utf-8", "strict").map_err((error) => error.message())? == COMPLETE_LOG
    assert cached.read_text("utf-8", "strict").map_err((error) => error.message())? == COMPLETE_LOG
    reuse_reference_log(cached, reused)?
    assert reused.read_text("utf-8", "strict").map_err((error) => error.message())? == COMPLETE_LOG
    timings = temporary.path().joinpath("timings.tsv")
    worker_timings = temporary.path().joinpath("reference-timings.tsv")
    timings.write_text("source-closure\t1.0\n", "utf-8", "strict", None).map_err((error) => error.message())?
    worker_timings.write_text("reference-contracts\t2.0\n", "utf-8", "strict", None).map_err((error) => error.message())?
    append_timing_file(timings, worker_timings)?
    assert timings.read_text("utf-8", "strict").map_err((error) => error.message())? == ("source-closure\t1.0\nreference-contracts\t2.0\n")
    return Ok(None)


def test_tree_measurement_walks_regular_files_once_and_records_bytes() -> Result[None, str]:
    """Tree evidence measures bytes, hashes content, and reuses only a verified read-only relocated copy."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    rustup = temporary.path().joinpath("rustup")
    tree = rustup.joinpath("toolchains/tree")
    tree.joinpath("nested").mkdir(true, true).map_err((error) => error.message())?
    rustup.joinpath("update-hashes").mkdir(true, true).map_err((error) => error.message())?
    rustup
        .joinpath("update-hashes/tree")
        .write_text("pinned\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    tree.joinpath("one").write_bytes(b"one").map_err((error) => error.message())?
    tree.joinpath("nested/two").write_bytes(b"two!!").map_err((error) => error.message())?
    tree.joinpath("alias").symlink_to(tree.joinpath("nested/two")).map_err((error) => error.message())?
    assert tree_bytes(tree)? == 8

    timings = temporary.path().joinpath("timings.tsv")
    append_bytes(timings, "build-home", 8)?
    assert timings.read_text("utf-8", "strict").map_err((error) => error.message())? == "bytes/build-home\t8\n"

    identity = tree_digest(tree)?
    cache = temporary.path().joinpath("cache")
    home = shared_relocated_sysroot(tree, cache)?
    cached = home.joinpath("toolchains/tree/nested/two")
    assert home.name() == identity
    settings = home.joinpath("settings.toml").read_text("utf-8", "strict").map_err((error) => error.message())?
    assert settings == "version = \"12\"\n\n[overrides]\n"
    assert home.joinpath("update-hashes/tree").read_text("utf-8", "strict").map_err((error) => error.message())? == "pinned\n"
    assert cached.read_bytes().map_err((error) => error.message())? == b"two!!"
    match cached.write_bytes(b"changed"):
        Ok(_) => return Err("the shared relocated tree remained writable")
        Err(_) => pass
    assert shared_relocated_sysroot(tree, cache)?.0 == home.0
    rustup
        .joinpath("update-hashes/tree")
        .write_text("changed\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    match shared_relocated_sysroot(tree, cache):
        Ok(_) => return Err("a stale Rust update hash was reused")
        Err(message) =>
            assert message.contains("update hash disagrees"), message
    rustup
        .joinpath("update-hashes/tree")
        .write_text("pinned\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    make_tree_writable(cache)?
    cached.write_bytes(b"changed").map_err((error) => error.message())?
    match shared_relocated_sysroot(tree, cache):
        Ok(_) => return Err("a damaged shared relocated tree was reused")
        Err(message) =>
            assert message.contains("cached relocated tree digest disagrees"), message
    make_tree_writable(cache)?
    return Ok(None)


def test_release_trace_uses_invocation_records_and_phase_parent_links() -> Result[None, str]:
    """The release trace is directly consumable as invocation JSONL and parents every step to its active phase."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    directory = temporary.path().joinpath("trace")
    mut trace = ReleaseTrace.open(directory)?
    trace.phase("checkout")?
    step = trace.begin("materialize-source")?
    trace.finish(step)?
    trace.complete()?
    paths = directory.glob("*.jsonl").map_err((error) => error.message())?
    assert len(paths) == 1
    lines = [line for line in paths[0].read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n") if line != ""]
    assert len(lines) == 5
    records = [JsonValue.parse(line).map_err((error) => error.message())? for line in lines]
    assert json_text(records[0], "schema")? == "incan.invocations/1"
    assert json_text(records[0], "kind")? == "process"
    assert json_text(records[1], "function")? == "checkout"
    assert json_text(records[2], "function")? == "materialize-source"
    phase_id = json_text(records[1], "id")?
    assert json_text(records[2], "parent")? == phase_id
    assert json_text(records[3], "id")? == json_text(records[2], "id")?
    assert json_text(records[4], "id")? == phase_id
    return Ok(None)


def test_installed_verification_uses_only_the_clean_checkout() -> Result[None, str]:
    """An ignored launching-checkout fixture cannot enter verification through the selected program source."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    launching = temporary.path().joinpath("launching")
    verification = temporary.path().joinpath("verification-source")
    for source in [launching, verification]:
        source.joinpath("scripts").mkdir(true, true).map_err((error) => error.message())?
        source
            .joinpath("scripts/verify_installation.incn")
            .write_text("# verifier\n", "utf-8", "strict", None)
            .map_err((error) => error.message())?
        source.joinpath("workspaces/contracts/fixtures").mkdir(true, true).map_err((error) => error.message())?
    ignored = launching.joinpath("workspaces/contracts/fixtures/project/example/target/ignored")
    ignored.parent().mkdir(true, true).map_err((error) => error.message())?
    ignored.write_text("stale\n", "utf-8", "strict", None).map_err((error) => error.message())?

    program = verification_program(verification)?
    selected_source = program.parent().parent()
    assert program.0 == verification.joinpath("scripts/verify_installation.incn").0
    assert ignored.is_file()
    assert not selected_source.joinpath("workspaces/contracts/fixtures/project/example/target/ignored").exists()
    return Ok(None)


def refused_release(arguments: list[str]) -> str:
    """Return a release parser refusal for concise assertions."""
    match parse_release_options(arguments):
        Ok(_) => return "accepted"
        Err(message) => return message


def refused_baseline(baseline: str, log: str) -> str:
    """Return a baseline checker refusal for concise assertions."""
    match check_baseline(baseline, log):
        Ok(_) => return "accepted"
        Err(message) => return message


def candidate_refusal(reference: &BaselineReport, candidate: &BaselineReport) -> str:
    """Return one candidate-census refusal for concise assertions."""
    match require_candidate_census(reference, candidate):
        Ok(_) => return "accepted"
        Err(message) => return message


def json_text(value: JsonValue, key: str) -> Result[str, str]:
    """Read one required string field from a trace test record."""
    return value.require(key).and_then((field) => field.expect_str()).map_err((error) => error.message())


def make_tree_writable(root: Path) -> Result[None, str]:
    """Restore temporary cache permissions so the test can mutate and remove its fixture."""
    for entry in root.rglob("*").map_err((error) => error.message())?:
        entry.chmod(false).map_err((error) => error.message())?
    root.chmod(false).map_err((error) => error.message())?
    return Ok(None)
