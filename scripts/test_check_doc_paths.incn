"""Verify contributor path discovery, scoped exceptions, glob expansion and failure propagation."""

from rust::std::env import var
from rust::std::process import Command
from rust::std::string import String as RustString
from std.fs import Path
from std.tempfile import TemporaryDirectory
from check_test_support import Outcome, run_check, write
from check_support import git, read, repository_root


def test_missing_file_and_directory_report_document_and_line() -> Result[None, str]:
    """A missing file and directory each retain their document and line number."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "`src/missing.rs`\n`loaves/missing/`\n")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "AGENTS.md:1: src/missing.rs" in result.stdout
    assert "AGENTS.md:2: loaves/missing/" in result.stdout
    return Ok(None)


def test_discovers_ring_readmes_and_agent_docs_but_not_runtime_state() -> Result[None, str]:
    """Loaf READMEs and agent docs are checked while runtime state stays private."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "loaves/kernel/example/README.md", "`src/absent.rs`")?
    write(root, ".agents/test-suite.md", "`tests/absent.rs`")?
    write(root, ".agents/state/private.md", "`src/private.rs`")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "loaves/kernel/example/README.md" in result.stdout
    assert ".agents/test-suite.md" in result.stdout
    assert "private.rs" not in result.stdout
    return Ok(None)


def test_shell_commands_and_diagrams_both_check_concrete_paths() -> Result[None, str]:
    """Fenced commands and diagrams retain concrete paths, including the archive install command."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "```text\nsrc/diagram.rs\n```\n```sh\ncat src/missing.rs\n```\n")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "AGENTS.md:5: src/missing.rs" in result.stdout
    assert "AGENTS.md:2: src/diagram.rs" in result.stdout
    repository = repository_root()?
    require_archive_command_match(root, repository)?
    require_contributor_commands(repository)?
    require_component_manifest_diagnostic(root, repository)?
    return Ok(None)


def test_nested_fences_do_not_hide_concrete_paths() -> Result[None, str]:
    """Nested and tilde fences cannot hide concrete repository mentions."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "````text\n```\nsrc/diagram.rs\n````\n~~~sh\ncat src/missing.rs\n~~~\n")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "src/diagram.rs" in result.stdout
    assert "src/missing.rs" in result.stdout
    return Ok(None)


def test_scoped_exception_does_not_hide_same_path_in_other_documents() -> Result[None, str]:
    """An exception applies to its declared document only."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "`src/example.rs`")?
    write(root, "CONTRIBUTING.md", "`src/example.rs`")?
    write(root, "scripts/check_doc_paths.allow", "AGENTS.md\tsrc/example.rs\tIllustrative name\n")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "AGENTS.md:1:" not in result.stdout
    assert "CONTRIBUTING.md:1:" in result.stdout
    return Ok(None)


def test_runtime_prefix_exception_does_not_hide_other_agent_paths() -> Result[None, str]:
    """A subtree exception respects its slash boundary."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "`.agents/state/report.md` `.agents/missing.md`")?
    write(root, "scripts/check_doc_paths.allow", "*\t.agents/state/**\tRuntime state\n")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "AGENTS.md:1: .agents/state/report.md" not in result.stdout
    assert "AGENTS.md:1: .agents/missing.md" in result.stdout
    return Ok(None)


def test_missing_or_malformed_allowlist_fails_closed() -> Result[None, str]:
    """Missing and malformed exception files both use configuration status 2."""
    temporary = fixture()?
    root = temporary.path()
    result = run_check("check_doc_paths", root, ["--allow", root.joinpath("absent.allow").0])?
    assert result.code == 2
    write(root, "scripts/check_doc_paths.allow", "src/missing.rs\n")?
    assert run_check("check_doc_paths", root)?.code == 2
    return Ok(None)


def test_brace_alternatives_and_globs_require_matching_paths() -> Result[None, str]:
    """Every brace alternative must resolve and a filename glob needs a real match."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "`src/{one,two}.rs` `tests/*.rs`\n")?
    write(root, "src/one.rs", "")?
    write(root, "tests/works.rs", "")?
    result = run_check("check_doc_paths", root)?
    assert result.code == 1
    assert "src/two.rs" in result.stdout
    write(root, "src/two.rs", "")?
    assert run_check("check_doc_paths", root)?.code == 0
    return Ok(None)


def test_links_and_line_suffixes_resolve_without_external_url_fragments() -> Result[None, str]:
    """Anchors and line suffixes do not change source paths, and URL path fragments are excluded."""
    temporary = fixture()?
    root = temporary.path()
    write(root, "AGENTS.md", "[file](src/one.rs#anchor) `src/one.rs:42`. https://example.test/src/missing.rs\n")?
    write(root, "src/one.rs", "")?
    result = run_check("check_doc_paths", root, ["--list"])?
    assert result.code == 0
    assert "src/one.rs" in result.stdout
    assert "missing.rs" not in result.stdout
    return Ok(None)


def test_doc_path_gate_stops_before_following_work() -> Result[None, str]:
    """The real pre-commit recipe stops after a failed path audit and continues after success."""
    temporary = fixture()?
    root = temporary.path()
    repository = repository_root()?
    # Give the real pre-commit Rust source discovery an empty inventory.
    _ = git(root, ["init", "-q"])?
    write(root, "AGENTS.md", "`src/missing.incn`\n")?
    for source in ["check_doc_paths.incn", "check_support.incn"]:
        write(root, f"scripts/{source}", read(repository.joinpath(f"scripts/{source}"))?)?
    write(root, "Makefile", read(repository.joinpath("Makefile"))?)?
    write(root, "scripts/doc_path_fixture.incn", fixture_launcher())?

    sentinel = root.joinpath("checks-started")
    failed = run_pre_commit(root)?
    assert failed.code != 0
    assert "  AGENTS.md:1: src/missing.incn\n" in failed.stdout, f"{failed.stdout}\n{failed.stderr}"
    assert not sentinel.exists()

    write(root, "src/missing.incn", "")?
    recovered = run_pre_commit(root)?
    assert recovered.code == 0, recovered.stderr
    assert "doc path audit passed: 1 mentions, 0 explicit exceptions\n" in recovered.stdout
    assert read(sentinel)? == "reference check reached"
    return Ok(None)


def run_pre_commit(root: Path) -> Result[Outcome, str]:
    """Preserve the Make recipe and select the check-specific command fixture."""
    executable: str = var("INCAN").unwrap_or("incan")
    mut command = Command.new("make")
    command.current_dir(root.0).env("DOC_PATH_TEST_INCAN", executable)
    command.arg("-s").arg("pre-commit").arg("INCAN=\"$${DOC_PATH_TEST_INCAN}\" run scripts/doc_path_fixture.incn --")
    result = command.output().map_err((error) => error.to_string())?
    stdout = RustString.from_utf8(result.stdout).map_err((error) => error.to_string())?
    stderr = RustString.from_utf8(result.stderr).map_err((error) => error.to_string())?
    return Ok(Outcome(code=result.status.code().unwrap_or(-1), stdout=stdout, stderr=stderr))


def fixture_launcher() -> str:
    """Delegate the actual path audit and mark the next real recipe command."""
    return '''from rust::std::process import Command, exit
from std.environ import args, get_or
from std.fs import Path
from check_support import write_stderr


def main() -> None:
    """Forward the recipe command and report unexpected invocations."""
    match run(args().unwrap_or([])[1:]):
        Ok(code) => exit(code)
        Err(message) =>
            write_stderr(f"{message}\\n")
            exit(1)


def run(arguments: list[str]) -> Result[i32, str]:
    """Dispatch only the commands in the pre-commit recipe."""
    if arguments == ["run", "scripts/check_doc_paths.incn"]:
        mut command = Command.new(get_or("DOC_PATH_TEST_INCAN", "incan"))
        for argument in arguments:
            command.arg(argument)
        status = command.status().map_err((error) => error.to_string())?
        return Ok(status.code().unwrap_or(1))
    if arguments == ["run", "scripts/check_reference_contract.incn", "--", "--all"]:
        sentinel = Path("checks-started")
        sentinel.write_text("reference check reached", "utf-8", "strict", None).map_err((error) => error.message())?
        return Ok(0)
    if arguments in [
        ["run", "scripts/check_us_english.incn"],
        ["test", "scripts/test_check_changed_rustdocs.incn"],
        ["run", "scripts/check_changed_rustdocs.incn"],
        ["run", "scripts/check_agents_doc_sync.incn"],
        ["run", "scripts/check_std_reexports.incn"],
    ]:
        return Ok(0)
    return Err(f"unexpected pre-commit command: {arguments}")
'''


def fixture() -> Result[TemporaryDirectory, str]:
    """Create an isolated tree with its mandatory empty exception file."""
    temporary = TemporaryDirectory.try_new().map_err((error) => error.message())?
    write(temporary.path(), "scripts/check_doc_paths.allow", "")?
    return Ok(temporary)


def require_archive_command_match(root: Path, repository: Path) -> Result[None, str]:
    """Change only the README archive path and require the ordinary learning check to report the difference."""
    relative = "workspaces/docs-site"
    site = root.joinpath(relative)
    source_site = repository.joinpath(relative)
    for name in ["check_learning_journey.incn", "docs_check_support.incn"]:
        write(site, f"scripts/{name}", read(source_site.joinpath(f"scripts/{name}"))?)?
    for name in ["docs", "mkdocs.yml"]:
        site.joinpath(name).symlink_to(source_site.joinpath(name)).map_err((error) => error.message())?
    manifest = "workspaces/oven/loaf.toml"
    write(root, manifest, read(repository.joinpath(manifest))?)?

    readme = read(repository.joinpath("README.md"))?
    archive_commands = [line for line in readme.split("\n") if line.startswith("incan toolchain install ")]
    assert len(archive_commands) == 1
    wrong_archive = "incan toolchain install ./wrong-archive.tar.zst"
    write(root, "README.md", readme.replace(archive_commands[0], wrong_archive))?

    executable: str = var("INCAN").unwrap_or("incan")
    mut command = Command.new(executable)
    command.current_dir(site.0).arg("run").arg("scripts/check_learning_journey.incn")
    result = command.output().map_err((error) => f"cannot run the learning check: {error}")?
    output = RustString.from_utf8(result.stdout).map_err((error) => f"invalid learning check output: {error}")?
    stderr = RustString.from_utf8(result.stderr).map_err((error) => f"invalid learning check error output: {error}")?
    assert result.status.code().unwrap_or(-1) == 1, stderr
    expected = "README and install guide must use the same archive installation command"
    assert expected in output, f"{output}\n{stderr}"
    return Ok(None)


def require_component_manifest_diagnostic(root: Path, repository: Path) -> Result[None, str]:
    """Name the actual input path when the component checker cannot parse its manifest."""
    site = root.joinpath("component-check-site")
    source_site = repository.joinpath("workspaces/docs-site")
    for name in ["check_incapunk_components.incn", "docs_check_support.incn"]:
        write(site, f"scripts/{name}", read(source_site.joinpath(f"scripts/{name}"))?)?
    relative = "docs/shared/incapunk/incus-library/manifest.json"
    write(site, relative, "{")?
    canonical_site = site.resolve().map_err((error) => error.message())?
    manifest = canonical_site.joinpath(relative)

    executable: str = var("INCAN").unwrap_or("incan")
    mut command = Command.new(executable)
    command.current_dir(canonical_site.0).arg("run").arg("scripts/check_incapunk_components.incn")
    result = command.output().map_err((error) => f"cannot run the component check: {error}")?
    stdout = RustString.from_utf8(result.stdout).map_err((error) => f"invalid component check output: {error}")?
    stderr = RustString.from_utf8(result.stderr).map_err((error) => f"invalid component check error: {error}")?
    assert result.status.code().unwrap_or(-1) == 1, f"{stdout}\n{stderr}"
    assert "Incapunk component contract passed" not in stdout, stdout
    cause = "JSONDecodeError: EOF while parsing an object"
    diagnostics = [line for line in stderr.split("\n") if cause in line]
    assert len(diagnostics) == 1, stderr
    diagnostic = diagnostics[0]
    assert f"cannot parse {manifest.0}: {cause}" in diagnostic, f"missing component manifest path\n{diagnostic}"
    return Ok(None)


def require_contributor_commands(repository: Path) -> Result[None, str]:
    """Keep documented local serving and contributor toolchain setup usable from the checkout."""
    readme = read(repository.joinpath("README.md"))?
    serve_lines = [line for line in readme.split("\n") if line.startswith("make ") and "docs-serve" in line]
    assert len(serve_lines) == 1
    mut command = Command.new("make")
    command.current_dir(repository.0).arg("-n")
    for argument in serve_lines[0].split(" ")[1:]:
        command.arg(argument)
    result = command.output().map_err((error) => f"cannot inspect the documented docs serve target: {error}")?
    stdout = RustString.from_utf8(result.stdout).map_err((error) => f"invalid make output: {error}")?
    contributors = read(repository.joinpath("CONTRIBUTING.md"))?
    mut failures: list[str] = []
    if not result.status.success() or "mkdocs serve" not in stdout:
        failures.append("README must name the executable docs-site serve target")
    if "dev.8" in contributors:
        failures.append("CONTRIBUTING must describe the installed toolchain for the current checkout")
    assert failures == [], "\n".join(failures)
    return Ok(None)
