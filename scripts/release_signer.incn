"""
The release's signer file, and the stamp that carries it into the shipped `incan` (DD-0016).

`scripts/release-signer.json` names the workflow that signs releases and its token issuer, and holds the Sigstore
trusted root in its `trusted_root` slot. While the slot is `null` the release has no signer: its `incan` is built
unstamped, verifies nothing, and says so when it installs. Once the slot holds a trusted root, the release stamps the
whole file into the program it ships and carries the same file in the toolchain it packs.
"""

from std.encoding.base64 import b64encode
from std.fs import Path
from std.json import JsonValue

pub const RELEASE_SIGNER: str = "scripts/release-signer.json"
pub const STAMP_MODULE: str = "workspaces/oven/src/release_stamp.incn"
pub const CARRIED_TRUST: str = "release-signer.json"


pub def release_signer(source: Path) -> Result[Option[str], str]:
    """
    The text of the checkout's signer file, or none while its trusted-root slot is empty.

    A file that names no workflow, no issuer or no slot is refused: only `null` in the slot means no signer.
    """
    path = source.joinpath(RELEASE_SIGNER)
    text = path.read_text("utf-8", "strict").map_err((error) => f"cannot {error.message()}")?
    document = JsonValue.parse(text).map_err((error) => f"malformed {path.0}: {error.message()}")?
    signer = document.require("signer").map_err((error) => f"malformed {path.0}: {error.message()}")?
    for key in ["workflow", "issuer"]:
        value = signer
            .require(key)
            .map_err((error) => f"malformed {path.0}: {error.message()}")?
            .expect_str()
            .map_err((error) => f"malformed {path.0}: {error.message()}")?
        if value == "":
            return Err(f"malformed {path.0}: the signer's {key} is empty")
    root = document.require("trusted_root").map_err((error) => f"malformed {path.0}: {error.message()}")?
    if root.is_null():
        return Ok(None)
    if not root.is_object():
        return Err(f"malformed {path.0}: trusted_root is neither null nor a Sigstore trusted root")
    return Ok(Some(text))


pub def stamp_module(signer: str) -> str:
    """The source of the Oven's stamp module for one signer file's text."""
    return (
        "\"\"\"\nThe release signer this build of `incan` carries (DD-0016).\n\n" +
        "Written by the release script from `" + RELEASE_SIGNER + "`, in base64.\n\"\"\"\n\n" +
        "pub const RELEASE_SIGNER: str = \"" + b64encode(signer.encode("utf-8")) + "\"\n"
    )


pub def stamp_release_signer(source: Path, toolchain: Path) -> Result[bool, str]:
    """
    Stamp the release's signer into the checkout its `incan` is about to be built from, and report whether it has one.

    1. A release whose signer file has an empty trusted-root slot stamps and ships nothing.
    2. Otherwise the Oven's stamp module carries the file, so the program verifies what it installs.
    3. The candidate toolchain carries the same file, which `toolchain pack` ships.
    """
    # 1. No signer is a stated outcome, never a silent one.
    match release_signer(source)?:
        None =>
            println(f"release signer: none, {RELEASE_SIGNER} has no trusted root; this incan installs unverified")
            return Ok(false)
        Some(signer) =>
            # 2. The program's own source carries the signer; no archive supplies it.
            module = source.joinpath(STAMP_MODULE)
            if not module.is_file():
                return Err(f"cannot stamp the release signer: {module.0} is missing")
            module.write_text(stamp_module(signer), "utf-8", "strict", None).map_err(
                (error) => f"cannot {error.message()}",
            )?
            # 3. Homes record this file from the archive once the archive has verified.
            toolchain.joinpath(CARRIED_TRUST).write_text(signer, "utf-8", "strict", None).map_err(
                (error) => f"cannot {error.message()}",
            )?
            println(f"release signer: stamped from {RELEASE_SIGNER}")
            return Ok(true)
