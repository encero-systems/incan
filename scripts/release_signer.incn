"""
The release's signer file, the stamp that carries it into the shipped `incan`, and the signed bundle's way back into
the release (DD-0016).

`scripts/release-signer.json` names the workflow that signs releases and its token issuer, and holds Sigstore's
trusted root in its `trusted_root` slot. Signing is keyless from the release workflow's identity, in a job that runs
nothing the release built, so the release script runs twice there. The first invocation stamps the whole file into
the program it ships, carries the same file in the toolchain it packs, and stops before installed verification. The
workflow signs each asset. The second invocation takes the signed bundle and verifies the installation with the
stamped program, which admits only what that signer signed. Every other run of the release script builds an unstamped
`incan`, which verifies nothing and says so when it installs.
"""

from std.encoding.base64 import b64encode
from std.fs import Path
from std.json import JsonValue

pub const RELEASE_SIGNER: str = "scripts/release-signer.json"
pub const STAMP_MODULE: str = "workspaces/oven/src/release_stamp.incn"
pub const CARRIED_TRUST: str = "release-signer.json"
pub const BUNDLE_SUFFIX: str = ".sigstore.json"
# The assets a release publishes, each signed on its own.
pub const SIGNED_ASSETS: FrozenList[str] = ["toolchain.tar.zst", "incan", "incan-lsp"]


pub def release_signer(source: Path) -> Result[Option[str], str]:
    """
    The text of the checkout's signer file, or none while its trusted-root slot is empty.

    A file that names no workflow, no issuer or no slot is refused: only `null` in the slot means no signer.
    """
    path = source.joinpath(RELEASE_SIGNER)
    text = path.read_text("utf-8", "strict").map_err((error) => f"cannot {error.message()}")?
    document = JsonValue.parse(text).map_err((error) => f"malformed {path.0}: {error.message()}")?
    signer = document.require("signer").map_err((error) => f"malformed {path.0}: {error.message()}")?
    for key in ["workflow", "issuer"]:
        value = signer
            .require(key)
            .map_err((error) => f"malformed {path.0}: {error.message()}")?
            .expect_str()
            .map_err((error) => f"malformed {path.0}: {error.message()}")?
        if value == "":
            return Err(f"malformed {path.0}: the signer's {key} is empty")
    root = document.require("trusted_root").map_err((error) => f"malformed {path.0}: {error.message()}")?
    if root.is_null():
        return Ok(None)
    if not root.is_object():
        return Err(f"malformed {path.0}: trusted_root is neither null nor a Sigstore trusted root")
    return Ok(Some(text))


pub def stamp_module(signer: str) -> str:
    """The source of the Oven's stamp module for one signer file's text."""
    return (
        "\"\"\"\nThe release signer this build of `incan` carries (DD-0016).\n\n" +
        "Written by the release script from `" + RELEASE_SIGNER + "`, in base64.\n\"\"\"\n\n" +
        "pub const RELEASE_SIGNER: str = \"" + b64encode(signer.encode("utf-8")) + "\"\n"
    )


pub def stamp_release_signer(source: Path, toolchain: Path, stamping: bool) -> Result[bool, str]:
    """
    Stamp the release's signer into the checkout its `incan` is about to be built from, and report whether it did.

    1. Only the release workflow's packing invocation stamps. A stamped `incan` installs nothing unsigned, and
       signing is keyless from the release workflow's identity, so a local qualification never stamps and says so.
    2. A stamped release needs the trusted root: an empty slot stops it.
    3. The Oven's stamp module carries the file, so the program verifies what it installs.
    4. The candidate toolchain carries the same file, which `toolchain pack` ships.
    """
    # 1. No signer is a stated outcome, never a silent one.
    if not stamping:
        println("release signer: not stamped, only the release workflow signs; this incan installs unverified")
        return Ok(false)
    # 2. The slot is read before anything is written.
    match release_signer(source)?:
        None => return Err(f"cannot stamp the release: {RELEASE_SIGNER} has no trusted root")
        Some(signer) =>
            # 3. The program's own source carries the signer; no archive supplies it.
            module = source.joinpath(STAMP_MODULE)
            if not module.is_file():
                return Err(f"cannot stamp the release signer: {module.0} is missing")
            module.write_text(stamp_module(signer), "utf-8", "strict", None).map_err(
                (error) => f"cannot {error.message()}",
            )?
            # 4. Homes record this file from the archive once the archive has verified.
            toolchain.joinpath(CARRIED_TRUST).write_text(signer, "utf-8", "strict", None).map_err(
                (error) => f"cannot {error.message()}",
            )?
            println(f"release signer: stamped from {RELEASE_SIGNER}")
            return Ok(true)


pub def adopt_signed_bundle(signed: Path, bundle: Path) -> Result[int, str]:
    """
    Take the bundle the workflow signed into the release's own bundle directory, and report how many assets it holds.

    Each asset must come with `ASSET.sigstore.json`: the stamped `incan` looks for it beside the asset it installs, so
    a missing signature is named here, before anything is installed.
    """
    mut adopted = 0
    for asset in SIGNED_ASSETS:
        for name in [asset, asset + BUNDLE_SUFFIX]:
            source = signed.joinpath(name)
            if not source.is_file():
                return Err(f"the signed bundle {signed.0} has no {name}")
            _ = source.copy(bundle.joinpath(name), true, true).map_err((error) => f"cannot {error.message()}")?
        adopted += 1
    println(f"signed bundle: {adopted} assets with their signatures from {signed.0}")
    return Ok(adopted)
