"""Verify one installed release toolchain against this checkout's complete contract and native-test surface."""

from rust::std::process import Command, exit
from rust::std::string import String as RustString
from rust::std::time import Instant
from std.environ import args, get_or
from std.fs import Path
from std.json import JsonValue
from std.tempfile import TemporaryDirectory
from check_support import repository_root, write_stderr
from oven_tests import (
    LOWERING_RESERVATION_BYTES,
    PROJECT_RESERVATION_BYTES as OVEN_PROJECT_RESERVATION_BYTES,
    Invocation,
    host_memory,
    run_all_failures,
    shared_memory,
)
from release_support import (
    FAMILIES,
    BaselineReport,
    TOOLCHAIN_DIRECTORY,
    Step,
    append_timing,
    baseline_summary,
    check_baseline,
    counts_json,
    digest,
    parse_verification_options,
    require_step,
    run_step,
    write_json,
)

const GIB: int = 1073741824
const FACET_RESERVATION_BYTES: int = 2 * GIB
const SMALL_PROJECT_RESERVATION_BYTES: int = 2 * GIB


pub enum VerificationPhase(str):
    """Independent installed-verification gates with stable child-process spellings."""

    Oven = "oven"
    RustFacets = "rust-facets"
    DriverIntegration = "driver-integration"
    Lsp = "lsp"
    Census = "census"
    Memory = "memory"


pub model VerificationPhasePlan:
    """One independently executable verification phase and its whole-process memory reservation."""

    pub phase: VerificationPhase
    pub reservation: int


pub model Installation:
    """Installed commands, source checkout, selected standard sources, and retained evidence."""

    pub root: Path
    pub home: Path
    pub oven: Path
    pub lsp: Path
    pub stdlib: str
    pub run: Path
    pub jobs: int
    pub timeout_seconds: int


def main() -> None:
    """Verify the selected installation, reporting option refusals as status 2 and gate failures as status 1."""
    arguments = args().unwrap_or([])
    if len(arguments) > 1 and arguments[1] == "--phase":
        match run_phase(arguments[2:]):
            Ok(_) => exit(0)
            Err(message) =>
                write_stderr(message + "\n")
                exit(1)
    match parse_verification_options(arguments[1:]):
        Ok(options) =>
            match verify(options.output, options.jobs, options.timeout_seconds):
                Ok(_) => exit(0)
                Err(message) =>
                    write_stderr(message + "\n")
                    exit(1)
        Err(message) =>
            write_stderr(message + "\n")
            exit(2)


pub def verify(output: Path, jobs: int, timeout_seconds: int) -> Result[Path, str]:
    """
    Verify an installed toolchain in four steps.

    1. Audit installation paths and select only shipped standard packages.
    2. Build this checkout's contract runner with the installed compiler.
    3. Concurrently run Oven, every Rust facet, direct-driver integration, LSP, census, and cold memory gates.
    4. Preserve every committed PASS key and all per-phase evidence.
    """
    installation = prepare(output, jobs, timeout_seconds)?

    # 1. Installed records may name only this installation and never a builder path.
    mut phase_started = Instant.now()
    audit_relocation(installation.home, [get_or("INCAN_BUILDER_HOME", ""), get_or("INCAN_BUILDER_SOURCE", "")])?
    retain_phase_timing(installation, "relocation", phase_started)?

    # 2. A checkout runner proves the installed compiler can read the current source contracts.
    phase_started = Instant.now()
    runner = build_runner(installation)?
    retain_phase_timing(installation, "runner-build", phase_started)?

    # 3. Independent projects and scratch roots share only the content-addressed installed home.
    phase_started = Instant.now()
    report, suites = run_concurrent_gates(installation, runner)?
    retain_phase_timing(installation, "concurrent-gates", phase_started)?

    # 4. The caller receives one durable evidence directory even on hosts with shared temporary storage.
    summary = baseline_summary(report) + f"; {suites} Rust facet suites\n"
    installation.run
        .joinpath("summary.txt")
        .write_text(summary, "utf-8", "strict", None)
        .map_err((error) => error.message())?
    println(summary.strip())
    return Ok(installation.run)


def retain_phase_timing(installation: Installation, phase: str, started: Instant) -> Result[None, str]:
    """Append one installed-verification phase's wall duration to the retained evidence."""
    return append_timing(installation.run.joinpath("phase-timings.tsv"), phase, started.elapsed().as_secs_f64())


def run_concurrent_gates(installation: Installation, runner: Path) -> Result[tuple[BaselineReport, int], str]:
    """Run independent installed gates under one host-memory budget and recover their typed results."""
    plans = verification_phase_plans(installation.jobs)
    mut invocations: list[Invocation] = []
    compiler = installation.home.joinpath("bin/incan")
    program = installation.root.joinpath("scripts/verify_installation.incn")
    retain_traces = get_or("INCAN_VERIFY_TRACES", "") == "1"
    for plan in plans:
        name = verification_phase_name(plan.phase)
        trace_environment = verification_trace_environment(installation.run, name, retain_traces)
        if retain_traces:
            Path(trace_environment["INCAN_TRACE_DIR"])
                .mkdir(true, true)
                .map_err((error) => error.message())?
        invocations.append(
            Invocation(
                arguments=[
                    "run",
                    program.0,
                    "--",
                    "--phase",
                    name,
                    installation.run.0,
                    runner.0,
                    str(installation.jobs),
                    str(installation.timeout_seconds),
                ],
                directory=installation.root.0,
                reservation=plan.reservation,
                log=installation.run.joinpath(f"phase-{name}.log"),
                environment=trace_environment,
                timeout_seconds=installation.timeout_seconds * 20,
            ),
        )
    memory = shared_memory(host_memory())
    failed = run_all_failures(compiler.0, invocations, len(invocations), memory)?
    if len(failed) > 0:
        return Err(
            "installed verification phase failures: " + ", ".join(
                [verification_phase_name(plans[index].phase) for index in failed],
            ),
        )
    for plan in plans:
        name = verification_phase_name(plan.phase)
        timing = installation.run.joinpath(f"phase-timing-{name}.txt")
        seconds = float(timing.read_text("utf-8", "strict").map_err((error) => error.message())?.strip())
        append_timing(installation.run.joinpath("phase-timings.tsv"), name, seconds)?
    report = installed_contract_report(installation)?
    suites = int(
        installation.run
            .joinpath("rust-facet-count.txt")
            .read_text("utf-8", "strict")
            .map_err((error) => error.message())?.strip(),
    )
    return Ok((report, suites))


pub def verification_trace_environment(run: Path, phase: str, enabled: bool) -> Dict[str, str]:
    """Select one process-safe phase-owned compiler trace directory when installed tracing is requested."""
    if not enabled:
        return {}
    stem = run.joinpath("traces").joinpath(phase)
    return {
        "INCAN_TRACE_DIR": stem.joinpath("compiler").0,
        "INCAN_NATIVE_TIMING": "1",
    }


pub def verification_phase_plans(jobs: int) -> list[VerificationPhasePlan]:
    """Plan independent gates with their aggregate lowering-scale or project-scale memory reservations."""
    workers = verification_workers(jobs)
    return [
        VerificationPhasePlan(phase=VerificationPhase.Oven, reservation=workers * OVEN_PROJECT_RESERVATION_BYTES),
        VerificationPhasePlan(phase=VerificationPhase.RustFacets, reservation=workers * FACET_RESERVATION_BYTES),
        VerificationPhasePlan(phase=VerificationPhase.DriverIntegration, reservation=LOWERING_RESERVATION_BYTES),
        VerificationPhasePlan(phase=VerificationPhase.Lsp, reservation=SMALL_PROJECT_RESERVATION_BYTES),
        VerificationPhasePlan(phase=VerificationPhase.Census, reservation=workers * LOWERING_RESERVATION_BYTES),
        VerificationPhasePlan(phase=VerificationPhase.Memory, reservation=LOWERING_RESERVATION_BYTES),
    ]


def verification_workers(jobs: int) -> int:
    """Normalize an external worker count without retaining an alias to its caller-owned place."""
    if jobs < 1:
        return 1
    return jobs


def verification_phase_name(phase: VerificationPhase) -> str:
    """Map the closed phase enum to its stable child-process spelling without cross-module method dispatch."""
    match phase:
        VerificationPhase.Oven => return "oven"
        VerificationPhase.RustFacets => return "rust-facets"
        VerificationPhase.DriverIntegration => return "driver-integration"
        VerificationPhase.Lsp => return "lsp"
        VerificationPhase.Census => return "census"
        VerificationPhase.Memory => return "memory"


def run_phase(arguments: list[str]) -> Result[None, str]:
    """Run one internal installed-verification phase in the existing evidence directory."""
    if len(arguments) != 5:
        return Err("internal verification phase needs NAME RUN RUNNER JOBS TIMEOUT")
    phase = parse_verification_phase(arguments[0])?
    run = Path(arguments[1]).resolve().map_err((error) => error.message())?
    runner = Path(arguments[2])
    jobs = phase_positive(arguments[3], "jobs")?
    timeout_seconds = phase_positive(arguments[4], "timeout")?
    installation = phase_installation(run, jobs, timeout_seconds)?
    started = Instant.now()
    match phase:
        VerificationPhase.Oven => run_oven_tests(installation)?
        VerificationPhase.RustFacets =>
            suites = run_rust_facets(installation)?
            installation.run
                .joinpath("rust-facet-count.txt")
                .write_text(str(suites) + "\n", "utf-8", "strict", None)
                .map_err((error) => error.message())?
        VerificationPhase.DriverIntegration => run_driver_integration(installation)?
        VerificationPhase.Lsp => verify_lsp(installation, runner)?
        VerificationPhase.Census => _ = run_contracts(installation, runner)?
        VerificationPhase.Memory => measure_memory(installation)?
    installation.run
        .joinpath(f"phase-timing-{verification_phase_name(phase)}.txt")
        .write_text(str(started.elapsed().as_secs_f64()) + "\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    return Ok(None)


def parse_verification_phase(text: str) -> Result[VerificationPhase, str]:
    """Parse only the five internal verification phase spellings."""
    match text:
        "oven" => return Ok(VerificationPhase.Oven)
        "rust-facets" => return Ok(VerificationPhase.RustFacets)
        "driver-integration" => return Ok(VerificationPhase.DriverIntegration)
        "lsp" => return Ok(VerificationPhase.Lsp)
        "census" => return Ok(VerificationPhase.Census)
        "memory" => return Ok(VerificationPhase.Memory)
        _ => return Err(f"unknown verification phase `{text}`")


def phase_positive(text: str, name: str) -> Result[int, str]:
    """Parse one positive internal phase count without accepting signs or whitespace."""
    if text == "":
        return Err(f"phase {name} must be positive")
    for character in text:
        if character not in "0123456789":
            return Err(f"phase {name} must be positive")
    value = int(text)
    if value < 1:
        return Err(f"phase {name} must be positive")
    return Ok(value)


def phase_installation(run: Path, jobs: int, timeout_seconds: int) -> Result[Installation, str]:
    """Reconstruct immutable installed paths for a child phase without creating another evidence run."""
    root = repository_root()?
    home_text = get_or("INCAN_HOME", "")
    if home_text == "":
        return Err("INCAN_HOME must select the installed release")
    home = Path(home_text).resolve().map_err((error) => error.message())?
    oven = home.joinpath("bin/incan")
    lsp = Path(get_or("INCAN_LSP", home.joinpath("bin/incan-lsp").0))
    if not oven.is_file() or not lsp.is_file():
        return Err("the installed Oven and language server are required")
    stdlib = run.joinpath("selected-stdlib.txt").read_text("utf-8", "strict").map_err((error) => error.message())?
    return Ok(
        Installation(
            root=root,
            home=home,
            oven=oven,
            lsp=lsp,
            stdlib=stdlib,
            run=run,
            jobs=jobs,
            timeout_seconds=timeout_seconds,
        ),
    )


def installed_contract_report(installation: Installation) -> Result[BaselineReport, str]:
    """Read and validate the census retained by the completed concurrent child phase."""
    baseline = installation.root.joinpath("workspaces/contracts/pass-baseline.txt")
    log = installation.run.joinpath("contracts.log")
    return check_baseline(
        baseline.read_text("utf-8", "strict").map_err((error) => error.message())?,
        log.read_text("utf-8", "strict").map_err((error) => error.message())?,
    )


pub def audit_relocation(home: Path, builder_paths: list[str]) -> Result[None, str]:
    """Refuse stale generations and absolute JSON paths outside the selected installation."""
    installation = home.resolve().map_err((error) => error.message())?
    toolchain = installation.joinpath(TOOLCHAIN_DIRECTORY)
    if not toolchain.is_dir():
        return Err(f"missing installed toolchain: {toolchain.0}")
    if len(toolchain.rglob("*.previous.*").map_err((error) => error.message())?) > 0:
        return Err("stale toolchain generation")
    for document in release_json_documents(toolchain)?:
        value = JsonValue
            .parse(document.read_text("utf-8", "strict").map_err((error) => error.message())?)
            .map_err((error) => f"{document.0}: {error.message()}")?
        for observed in strings_and_keys(value)?:
            if observed.startswith("/") and observed != installation.0 and not observed.startswith(installation.0 + "/"):
                return Err(f"nonportable toolchain JSON {document.0}: {observed}")
    for builder in builder_paths:
        if builder == "":
            continue
        for document in toolchain.rglob("*").map_err((error) => error.message())?:
            if document.is_file():
                match document.read_text("utf-8", "strict"):
                    Ok(text) =>
                        if f"{builder}/" in text:
                            return Err(f"installed records name the builder: {builder}")
                    Err(_) => pass
    return Ok(None)


def release_json_documents(toolchain: Path) -> Result[list[Path], str]:
    """Select release-owned metadata, excluding vendored registry sources and the Rust sysroot."""
    mut documents = [toolchain.joinpath("toolchain.json")]
    for name in ["native", "loaves"]:
        directory = toolchain.joinpath(name)
        if directory.is_dir():
            documents += directory.rglob("*.json").map_err((error) => error.message())?
    for name in ["closure.json", "selected.json"]:
        document = toolchain.joinpath("registry").joinpath(name)
        if document.is_file():
            documents.append(document)
    return Ok(documents)


def prepare(output: Path, jobs: int, timeout_seconds: int) -> Result[Installation, str]:
    """Resolve installed commands and create one retained `run.*` evidence directory."""
    root = repository_root()?
    home_text = get_or("INCAN_HOME", "")
    if home_text == "":
        return Err("INCAN_HOME must select the installed release")
    home = Path(home_text).resolve().map_err((error) => error.message())?
    oven = home.joinpath("bin/incan")
    lsp = Path(get_or("INCAN_LSP", home.joinpath("bin/incan-lsp").0))
    if not oven.is_file() or not lsp.is_file():
        return Err("the installed Oven and language server are required")
    output.mkdir(true, true).map_err((error) => error.message())?
    temporary = TemporaryDirectory.try_new_with("run.", "", Some(output)).map_err((error) => error.message())?
    run = temporary.persist().map_err((error) => error.message())?
    standard = select_standard_sources(root, home, run)?
    run
        .joinpath("selected-stdlib.txt")
        .write_text(standard, "utf-8", "strict", None)
        .map_err((error) => error.message())?
    retain_input_digests(run, oven, lsp)?
    return Ok(
        Installation(
            root=root,
            home=home,
            oven=oven,
            lsp=lsp,
            stdlib=standard,
            run=run,
            jobs=jobs,
            timeout_seconds=timeout_seconds,
        ),
    )


def select_standard_sources(root: Path, home: Path, run: Path) -> Result[str, str]:
    """Expose checkout sources only for standard packages whose compiled artifacts the archive shipped."""
    toolchain = home.joinpath(TOOLCHAIN_DIRECTORY)
    if toolchain.joinpath("stdlib/primitives/loaf.toml").is_file():
        return Ok("")
    stdlib = run.joinpath("stdlib")
    stdlib.mkdir(true, true).map_err((error) => error.message())?
    mut packages: list[str] = []
    for artifact in toolchain.joinpath("loaves").iterdir().map_err((error) => error.message())?:
        if not artifact.is_dir():
            continue
        name = artifact.name()
        if not name.startswith("incan_stdlib_"):
            return Err(f"unknown standard package: {name}")
        package = name[13:]
        source = root.joinpath(f"loaves/stdlib/{package}")
        if not source.joinpath("loaf.toml").is_file():
            return Err(f"missing standard source: {package}")
        stdlib.joinpath(package).symlink_to(source).map_err((error) => error.message())?
        packages.append(package)
    if "primitives" not in packages:
        return Err("archive has no primitive standard package")
    run
        .joinpath("standard-packages.txt")
        .write_text("\n".join(sorted(packages)) + "\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    return Ok(stdlib.0)


def build_runner(installation: Installation) -> Result[Path, str]:
    """Build a private copy of the contract runner with the installed compiler."""
    project = installation.run.joinpath("runner")
    project.mkdir(true, true).map_err((error) => error.message())?
    _ = installation.root
        .joinpath("workspaces/contracts/loaf.toml")
        .copy(project.joinpath("loaf.toml"), true, true)
        .map_err((error) => error.message())?
    _ = installation.root
        .joinpath("workspaces/contracts/src")
        .copy(project.joinpath("src"), true, true)
        .map_err((error) => error.message())?
    require_step(
        command_step(
            installation,
            "runner-build",
            installation.oven.0,
            ["build", project.joinpath("src/main.incn").0],
            project,
            installation.run.joinpath("runner-build.log"),
        ),
    )?
    runner = project.joinpath("target/incan/debug/bin/contracts")
    if not runner.is_file():
        return Err(f"runner build produced no executable: {runner.0}")
    return Ok(runner)


def run_oven_tests(installation: Installation) -> Result[None, str]:
    """Run the stable Oven and Loaf Incan-test inventory through the installed toolchain."""
    return require_step(
        command_step(
            installation,
            "oven-tests",
            installation.oven.0,
            [
                "run",
                installation.root.joinpath("scripts/oven_tests.incn").0,
                "--",
                installation.oven.0,
                installation.run.0,
                "--jobs",
                str(installation.jobs),
            ],
            installation.root,
            installation.run.joinpath("oven-tests-command.log"),
        ),
    )


def run_rust_facets(installation: Installation) -> Result[int, str]:
    """
    Run every production Loaf test suite that owns a Rust facet, retaining one log per project.

    The rustc-driver facet is not a duplicate of producing the release driver: its test harness runs seven unit tests
    that a release binary build does not execute.
    """
    output = installation.run.joinpath("rust-tests")
    output.mkdir(true, true).map_err((error) => error.message())?
    mut planned: list[Invocation] = []
    mut projects: list[str] = []
    manifests = sorted(
        [path.0 for path in installation.root.joinpath("loaves").rglob("loaf.toml").map_err((error) => error.message())?],
    )
    for manifest_text in manifests:
        manifest = Path(manifest_text)
        text = manifest.read_text("utf-8", "strict").map_err((error) => error.message())?
        if not owns_rust_facet(text):
            continue
        project = manifest.parent()
        relative = project.0[len(installation.root.0) + 1:]
        label = relative.replace("/", "-")
        projects.append(relative)
        planned.append(
            Invocation(
                arguments=["test", project.0, "--profile", "release"],
                directory=installation.root.0,
                reservation=FACET_RESERVATION_BYTES,
                log=output.joinpath(f"{label}.log"),
                timeout_seconds=installation.timeout_seconds,
            ),
        )
    if len(planned) == 0:
        return Err("no Rust facets found")
    failed = run_all_failures(installation.oven.0, planned, installation.jobs, shared_memory(host_memory()))?
    if len(failed) > 0:
        return Err("Rust facet test failures: " + ", ".join([projects[index] for index in failed]))
    return Ok(len(projects))


def run_driver_integration(installation: Installation) -> Result[None, str]:
    """Build direct-driver fixtures and run the Incan identity and runtime-closure verification programs."""
    evidence = installation.run.joinpath("driver-integration")
    evidence.mkdir(true, true).map_err((error) => error.message())?
    oven = installation.home.joinpath("bin/oven")
    if not oven.is_file():
        return Err("the installed Oven project command is required for direct-driver integration")
    toolchain = installation.home.joinpath(TOOLCHAIN_DIRECTORY)
    manifest = JsonValue
        .parse(toolchain.joinpath("toolchain.json").read_text("utf-8", "strict").map_err((error) => error.message())?)
        .map_err((error) => error.message())?
    driver = installed_path(toolchain, json_text(manifest, "driver")?)
    sysroot = installed_path(toolchain, json_text(manifest, "sysroot")?)

    helper_source = installation.root.joinpath("workspaces/oven/src/toolchain_native.incn")
    require_step(
        command_step(
            installation,
            "driver-helper-build",
            installation.oven.0,
            ["build", helper_source.0, "--profile", "release"],
            installation.root.joinpath("workspaces/oven"),
            evidence.joinpath("helper-build.log"),
        ),
    )?
    helper = installation.root.joinpath("workspaces/oven/target/incan/release/bin/oven")
    if not helper.is_file():
        return Err(f"native description helper was not built: {helper.0}")

    identity_project = evidence.joinpath("identity-probe")
    identity_project.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    identity_project
        .joinpath("loaf.toml")
        .write_text(
            "[project]\nname = \"identity_probe\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n",
            "utf-8",
            "strict",
            None,
        )
        .map_err((error) => error.message())?
    identity_project
        .joinpath("src/main.incn")
        .write_text(
            "def main() -> None:\n    \"\"\"Run the direct-driver identity probe.\"\"\"\n    println(\"identity\")\n",
            "utf-8",
            "strict",
            None,
        )
        .map_err((error) => error.message())?
    identity_unit = evidence.joinpath("identity.unit.json")
    describe_unit(installation, oven, identity_project.joinpath("src/main.incn"), identity_unit)?
    identity_program = evidence.joinpath("verify_identity.incn")
    _ = installation.root
        .joinpath("loaves/toolchain/incan-rustc-driver/tests/verify_identity.incn")
        .copy(identity_program, true, true)
        .map_err((error) => error.message())?
    require_step(
        command_step(
            installation,
            "driver-identity",
            installation.oven.0,
            ["run", identity_program.0, "--", driver.0, sysroot.0, identity_unit.0, evidence.joinpath("identity").0],
            installation.root,
            evidence.joinpath("identity.log"),
        ),
    )?

    fixture = installation.root.joinpath(
        "loaves/toolchain/incan-rustc-driver/tests/fixtures/runtime_dependencies/empty.incn",
    )
    template_source = evidence.joinpath("runtime-template.incn")
    _ = fixture.copy(template_source, true, true).map_err((error) => error.message())?
    runtime_unit = evidence.joinpath("runtime.unit.json")
    describe_unit(installation, oven, template_source, runtime_unit)?
    runtime_program = evidence.joinpath("verify_runtime_requirements.incn")
    _ = installation.root
        .joinpath("loaves/toolchain/incan-rustc-driver/tests/verify_runtime_requirements.incn")
        .copy(runtime_program, true, true)
        .map_err((error) => error.message())?
    require_step(
        command_step(
            installation,
            "driver-runtime-requirements",
            installation.oven.0,
            [
                "run",
                runtime_program.0,
                "--",
                driver.0,
                sysroot.0,
                helper.0,
                installation.root.0,
                runtime_unit.0,
                evidence.joinpath("runtime").0,
            ],
            installation.root,
            evidence.joinpath("runtime.log"),
        ),
    )?
    return Ok(None)


def describe_unit(installation: Installation, oven: Path, source: Path, output: Path) -> Result[None, str]:
    """Describe one source with the installed project command and retain a clean JSON unit document."""
    mut command = Command.new(oven.0)
    command
        .current_dir(installation.root.0)
        .env("INCAN_HOME", installation.home.0)
        .env("INCAN_STDLIB", installation.stdlib)
        .env("INCAN_NO_BANNER", "1")
        .env("OVEN_OWNER", "off")
        .env("RUSTUP_TOOLCHAIN", "1.98.0")
        .env_remove("RUSTC_BOOTSTRAP")
        .arg("describe-unit")
        .arg(source.0)
    result = command.output().map_err((error) => f"cannot describe {source.0}: {error}")?
    if not result.status.success():
        diagnostic = RustString.from_utf8_lossy(result.stderr).into_owned()
        return Err(f"cannot describe {source.0}: {diagnostic}")
    source_text = RustString.from_utf8(result.stdout).map_err((error) => error.to_string())?
    _ = JsonValue.parse(source_text).map_err((error) => f"invalid unit for {source.0}: {error.message()}")?
    return output.write_text(source_text, "utf-8", "strict", None).map_err((error) => error.message())


def installed_path(toolchain: Path, value: str) -> Path:
    """Resolve one installed manifest path against its toolchain root when relative."""
    if value.startswith("/"):
        return Path(value)
    return toolchain.joinpath(value)


def json_text(value: JsonValue, key: str) -> Result[str, str]:
    """Return one required JSON string field."""
    return value.require(key).and_then((entry) => entry.expect_str()).map_err((error) => error.message())


def verify_lsp(installation: Installation, runner: Path) -> Result[None, str]:
    """Require the installed server's live initialization, navigation, call hierarchy, and stale-buffer contract."""
    mut environment = command_environment(installation)
    environment["INCAN_LSP"] = installation.lsp.0
    return require_step(
        Step(
            name="lsp-contract",
            executable=runner.0,
            arguments=[
                installation.oven.0,
                installation.root.joinpath("workspaces/contracts/fixtures").0,
                "--scratch",
                installation.run.joinpath("lsp-scratch").0,
                "--jobs",
                "1",
                "--timeout",
                str(installation.timeout_seconds),
                "graph/incan/relationships",
            ],
            environment=environment,
            remove_environment=["RUSTC_BOOTSTRAP"],
            directory=Some(installation.root),
            log=installation.run.joinpath("lsp-contract.log"),
            timeout_seconds=installation.timeout_seconds * 2,
        ),
    )


def run_contracts(installation: Installation, runner: Path) -> Result[BaselineReport, str]:
    """Run all families once, accept runner status 0 or 1, then enforce completeness and the committed baseline."""
    mut environment = command_environment(installation)
    environment["INCAN_LSP"] = installation.lsp.0
    log = installation.run.joinpath("contracts.log")
    code = run_step(
        Step(
            name="contracts",
            executable=runner.0,
            arguments=census_arguments(
                installation.oven,
                installation.root.joinpath("workspaces/contracts/fixtures"),
                installation.run.joinpath("scratch"),
                installation.jobs,
                installation.timeout_seconds,
            ),
            environment=environment,
            remove_environment=["RUSTC_BOOTSTRAP"],
            directory=Some(installation.root),
            log=log,
            timeout_seconds=installation.timeout_seconds * 20,
        ),
    )?
    if code > 1:
        return Err(f"contract runner exited {code}; evidence: {installation.run.0}")
    baseline = installation.root.joinpath("workspaces/contracts/pass-baseline.txt")
    report = check_baseline(
        baseline.read_text("utf-8", "strict").map_err((error) => error.message())?,
        log.read_text("utf-8", "strict").map_err((error) => error.message())?,
    )?
    write_json(installation.run.joinpath("counts.json"), counts_json(report.counts))?
    return Ok(report)


pub def census_arguments(oven: Path, fixtures: Path, scratch: Path, jobs: int, timeout_seconds: int) -> list[str]:
    """Select every contract family with shared compilation while retaining the release's worker and timeout budgets."""
    return [
        oven.0,
        fixtures.0,
        "--scratch",
        scratch.0,
        "--jobs",
        str(jobs),
        "--timeout",
        str(timeout_seconds),
        "--serial-families",
    ] + [family for family in FAMILIES]


def measure_memory(installation: Installation) -> Result[None, str]:
    """Record one cold footprint run per command and enforce release-owned budgets through the installed toolchain."""
    return require_step(
        Step(
            name="memory-budget",
            executable=installation.oven.0,
            arguments=[
                "run",
                installation.root.joinpath("scripts/memory_budget.incn").0,
                "--",
                installation.oven.0,
                installation.run.0,
                "--runs",
                "1",
            ],
            environment=command_environment(installation),
            remove_environment=["RUSTC_BOOTSTRAP", "INCAN_LSP"],
            directory=Some(installation.root),
            log=installation.run.joinpath("memory-budget.log"),
            timeout_seconds=installation.timeout_seconds * 20,
        ),
    )


def command_step(
    installation: Installation,
    name: str,
    executable: str,
    arguments: list[str],
    directory: Path,
    log: Path,
) -> Step:
    """Create one installed-verification child specification."""
    return Step(
        name=name,
        executable=executable,
        arguments=arguments,
        environment=command_environment(installation),
        remove_environment=["RUSTC_BOOTSTRAP"],
        directory=Some(directory),
        log=log,
        timeout_seconds=installation.timeout_seconds,
    )


def command_environment(installation: Installation) -> Dict[str, str]:
    """Return the explicit environment selected for every installed-verification child."""
    return {"INCAN_HOME": installation.home.0, "INCAN_STDLIB": installation.stdlib, "INCAN_NO_BANNER": "1", "OVEN_OWNER": "off", "RUSTUP_TOOLCHAIN": "1.98.0"}


def owns_rust_facet(manifest: str) -> bool:
    """Return whether a production Loaf manifest declares a Rust library or binary facet."""
    for line in manifest.split("\n"):
        selected = line.split("#")[0].strip()
        if selected == "[rust]" or selected == "[[rust.bin]]":
            return true
    return false


def strings_and_keys(value: JsonValue) -> Result[list[str], str]:
    """Collect every JSON string and object key for the relocation audit."""
    mut values: list[str] = []
    if value.is_str():
        values.append(value.expect_str().map_err((error) => error.message())?)
    elif value.is_array():
        for entry in value.expect_array().map_err((error) => error.message())?:
            values += strings_and_keys(entry)?
    elif value.is_object():
        fields = value.expect_object().map_err((error) => error.message())?
        for key in fields.keys():
            values.append(key)
            values += strings_and_keys(fields[key])?
    return Ok(values)


def retain_input_digests(run: Path, oven: Path, lsp: Path) -> Result[None, str]:
    """Retain the installed commands' and optional source archive's exact SHA-256 identities."""
    run
        .joinpath("oven.sha256")
        .write_text(f"{digest(oven)?}  {oven.0}\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    run
        .joinpath("lsp.sha256")
        .write_text(f"{digest(lsp)?}  {lsp.0}\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    archive = Path(get_or("INCAN_RELEASE_ARCHIVE", ""))
    if archive.is_file():
        run
            .joinpath("archive.sha256")
            .write_text(f"{digest(archive)?}  {archive.0}\n", "utf-8", "strict", None)
            .map_err((error) => error.message())?
    return Ok(None)
