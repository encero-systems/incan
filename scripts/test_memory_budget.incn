"""Verify memory-budget option, process-table, tree-walk, budget and report contracts without compiling projects."""

from pub::incan_platform.probes import ProcessResource, parse_process_table
from check_support import repository_root
from memory_budget import (
    MIB,
    Measurement,
    budget_outcome,
    commands,
    measurements_report,
    measurements_tsv,
    observation_request,
    parse_options,
    process_tree,
)


def test_options_keep_runs_and_budget_explicit() -> Result[None, str]:
    """Two operands and positive run and MiB choices parse in any option position."""
    options = parse_options(["--runs", "1", "/usr/bin/true", "evidence", "--budget", "1536"])?
    assert options.oven == "/usr/bin/true"
    assert options.runs == 1
    assert options.budget_bytes == 1536 * MIB
    assert parse_options(["/usr/bin/true", "evidence"])?.runs == 3
    return Ok(None)


def test_an_existing_oven_observation_replaces_only_the_duplicate_oven_build() -> Result[None, str]:
    """A release reuses its sampled candidate Oven while still measuring the other three informational commands."""
    options = parse_options(["oven", "evidence", "--reuse-oven", "observed/memory-oven-1"])?
    assert options.reused_oven == "observed/memory-oven-1"
    assert [planned.name for planned in commands(options.reused_oven != "")] == [
        "stdlib-primitives",
        "contracts",
        "hello",
    ]
    return Ok(None)


def test_options_refuse_missing_or_nonpositive_values() -> Result[None, str]:
    """Missing operands, unknown options and nonpositive numeric choices fail closed."""
    assert refusal(["/usr/bin/true"]) == "OVEN and OUT are required"
    assert refusal(["/usr/bin/true", "out", "--fast"]) == "unknown option `--fast`"
    assert refusal(["/usr/bin/true", "out", "--runs", "0"]) == "--runs needs a positive integer"
    return Ok(None)


def test_process_rows_and_tree_keep_only_current_descendants() -> Result[None, str]:
    """Rows carry both footprint readings and the closure follows complete parent chains independent of row order."""
    rows = parse_process_table(
        "30\t20\t300\t330\t390\tworker\n10\t1\t100\t110\t150\toven\n20\t10\t200\t220\t260\tdriver\n40\t1\t400\t440\t480\tother\n",
    )
    tree = process_tree(rows, 10)
    assert [row.pid for row in tree] == [30, 10, 20]
    assert tree[0].footprint == 300
    assert tree[0].lifetime_peak == 330
    return Ok(None)


def test_a_completed_plan_folds_carrier_positions_in_place() -> Result[None, str]:
    """The final carrier fold folds its owned plan in place instead of cloning a second complete plan at lowering's peak."""
    source = repository_root()?.joinpath(
        "loaves/compiler/incan_mir_plan_native/src/carriers.rs",
    ).read_text("utf-8", "strict").map_err((error) => error.message())?
    assert "pub fn fold_carrier_positions(mut plan: Plan" in source, "the carrier fold does not own one input plan"
    assert "plan.clone()" not in source, "the carrier fold keeps a second complete plan beside lowering state"
    assert "    Ok(plan)\n" in source, "the carrier fold does not return its input plan folded in place"
    return Ok(None)


def test_a_completed_plan_releases_retry_state_before_publication() -> Result[None, str]:
    """A completed lowering attempt releases the retry-only snapshot before it assembles the published plan."""
    source = repository_root()?.joinpath(
        "loaves/compiler/incan_lowering/src/lowering.rs",
    ).read_text("utf-8", "strict").map_err((error) => error.message())?
    release = """RuntimeRetention::Complete => {
            // A completed attempt releases the retry-only snapshot before it assembles the published plan.
            drop(retry_intrinsic_layouts);
            drop(retry_externals);
            drop(retry_instances);"""
    assert release in source, "completed lowering retains the retry-only plan snapshot through publication"
    return Ok(None)


def test_budget_and_records_keep_exact_bytes_and_human_units_distinct() -> Result[None, str]:
    """The machine record keeps bytes while the human report alone renders MiB and whole seconds."""
    under = measured("oven", 1, 2048 * MIB, 90_000)
    over = measured("contracts", 2, 2048 * MIB + 1, 1_500)
    assert budget_outcome(under.tree_peak_bytes, 2048 * MIB) == "under"
    assert budget_outcome(over.tree_peak_bytes, 2048 * MIB) == "over"
    tsv = measurements_tsv([under, over], 2048 * MIB)
    assert tsv.startswith("command\trun\ttree_peak_bytes\tlargest_process\tlargest_process_peak_bytes\tbudget_bytes\n")
    assert f"contracts\t2\t{2048 * MIB + 1}\tincan-rustc-driver\t{2048 * MIB + 1}\t{2048 * MIB}\n" in tsv
    report = measurements_report([under, over], 2048 * MIB)
    assert "oven\t1\t2048\tincan-rustc-driver\t2048\t90\tunder" in report
    assert "contracts\t2\t2048\tincan-rustc-driver\t2048\t1\tover" in report
    return Ok(None)


def test_oven_is_reported_against_the_lowering_budget() -> Result[None, str]:
    """Oven reports against 6 GiB while other observed builds keep the selected informational budget."""
    budget = 2048 * MIB
    lowering = 6144 * MIB
    within = measured("oven", 1, lowering, 300_000)
    over = measured("oven", 2, lowering + 1, 300_000)
    assert f"oven\t2\t{lowering + 1}\tincan-rustc-driver\t{lowering + 1}\t{lowering}\n" in measurements_tsv(
        [over],
        budget,
    )
    report = measurements_report([within, over], budget)
    assert "oven\t1\t6144\tincan-rustc-driver\t6144\t300\tunder" in report
    assert "oven\t2\t6144\tincan-rustc-driver\t6144\t300\tover" in report
    return Ok(None)


def test_the_oven_observation_hands_the_observed_build_exactly_its_named_environment() -> Result[None, str]:
    """
    The observer runs in the release runner's environment; the build it samples runs in the one the release names after
    the five operands, each `NAME=VALUE` once and a value keeping any later `=`, over what the observer inherited.
    """
    request = observation_request(
        [
            "/lane/conductor",
            "/repo/workspaces/oven",
            "/repo",
            "/evidence/oven-build.log",
            "/evidence/memory-oven",
            "INCAN_HOME=/home",
            "OVEN_ENGINE_BINARY=/lane/conductor",
            "RUSTFLAGS=-C opt-level=3",
        ],
    )?
    assert request.oven.0 == "/lane/conductor"
    assert len(request.environment) == 3
    assert request.environment["INCAN_HOME"] == "/home"
    assert request.environment["OVEN_ENGINE_BINARY"] == "/lane/conductor"
    assert request.environment["RUSTFLAGS"] == "-C opt-level=3"
    assert len(observation_request(["oven", "project", "directory", "log", "prefix"])?.environment) == 0
    assert observation_request(["oven", "project", "directory", "log"]).is_err()
    assert observation_request(["oven", "project", "directory", "log", "prefix", "=value"]).is_err()
    assert observation_request(["oven", "project", "directory", "log", "prefix", "NAME"]).is_err()
    return Ok(None)


def measured(command: str, run: int, peak: int, wall_ms: int) -> Measurement:
    """Create one deterministic report row."""
    return Measurement(
        command=command,
        run=run,
        status=0,
        tree_peak_bytes=peak,
        peak_at_ms=wall_ms - 100,
        peak_holder="incan-rustc-driver",
        peak_holder_bytes=peak,
        largest_process="incan-rustc-driver",
        largest_process_peak_bytes=peak,
        wall_ms=wall_ms,
    )


def refusal(arguments: list[str]) -> str:
    """Return one option refusal for concise assertions."""
    match parse_options(arguments):
        Ok(_) => return "accepted"
        Err(message) => return message
