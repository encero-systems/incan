"""
Producer library for the pro-level markform embedded-fragment example (RFC 081, #1023).

The consumer imports this library through `pub::markform`, which activates the sibling vocab companion metadata
during `incan build --lib`.
"""

pub def markform_name() -> str:
    """Return this library's display name, proving the import activated before any `markup:` block runs."""
    return "markform"
