"""
Producer library for the pro-level styleforge embedded-fragment example (RFC 081, #1023).

The consumer imports this library through `pub::styleforge`, which activates the sibling vocab companion metadata
during `incan build --lib`.
"""

pub def styleforge_name() -> str:
    """Return this library's display name, proving the import activated before any `style:`/`spacing:` block runs."""
    return "styleforge"
