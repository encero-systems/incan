"""
Demonstrates public visibility on models and functions.

## Notes
- `pub model` exports the type, while each field still follows the ordinary visibility rule.
- A field is public only when it has `pub`; an unmodified field is type-private.
"""

pub model Point:
    pub x: int
    pub y: int
    secret: int = 0

    pub def secret_value(self) -> int:
        return self.secret

pub def origin() -> Point:
    return Point(x=0, y=0)

def length_squared(p: Point) -> int:
    return p.x * p.x + p.y * p.y

pub def demo() -> int:
    p = origin()
    return length_squared(p) + p.secret_value()
