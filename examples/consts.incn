"""Const bindings (module-level) example.

This example demonstrates:
- Rust-native constants (ints/bools)
- Frozen constants (strings and frozen collections)
- Const-to-const references
"""


# A `const` is deeply immutable. `str` and `bytes` annotations freeze silently
# (`FrozenStr` / `FrozenBytes` read wherever `str` / `bytes` is expected), while a
# collection must be spelled as the frozen type it actually has -- or left
# unannotated to infer it -- because `list[T]` and `FrozenList[T]` are different
# types at every use site:
# - `FrozenList[T]`
# - `FrozenDict[K, V]`
# - `FrozenSet[T]`
const MAX_RETRIES: int = 5
const BASE: int = 10
const LIMIT: int = BASE * 2
const GREETING: str = "hello"
const WELCOME: str = "hi " + "there"  # string concatenation is allowed in consts
const NUMS: FrozenList[int] = [1, 2, 3]
const HEADERS: FrozenDict[str, str] = {"User-Agent": "incan"}
const DATA: bytes = b"\x00\x01"
const FULL_GREETING: str = GREETING + " world"

def main() -> None:
    print(MAX_RETRIES)
    print(LIMIT)
    print(GREETING)
    print(WELCOME)
    print(NUMS.len())
    print(HEADERS.len())
    print(DATA.len())
