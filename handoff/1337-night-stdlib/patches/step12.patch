+    terminate_call(builder, CalleeKind.External(path), operands, result, span)
+    builder.owned.append(result.local)
+    drop_owned(builder, destination.local, span)
+    forget_owned(builder, result.local)
+    builder.emit(plan_assign(destination, RvalueKind.Use(read_place(result, true, span)), span))
