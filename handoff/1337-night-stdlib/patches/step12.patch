+    success = declaration.variants[0].fields
+    failure = declaration.variants[1].fields
+    if declaration.carrier != "Result" or success != [payload] or failure != [PlanType.String]:
+        return Err("unsupported Body IR file builtin result type")
+    mut parameters: list[PlanType] = []
+    for _operand in operands:
+        parameters.append(PlanType.StringRef)
+    path = f"incan_native_runtime::{name}"
+    builder.externals.append(ExternalFunction(path=path, parameters=parameters, return_type=ty, span=span))
