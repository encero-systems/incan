model Profile:
    name: str
    nick: Option[str] = None
    count: Option[int] = None
    tags: Option[list[int]] = None


def label(profile: Profile) -> str:
    nick = profile.nick
    match nick:
        Some(value) => return value
        None => return "anonymous"


def main() -> None:
    first = Profile(name="ada")
    println(label(first))
