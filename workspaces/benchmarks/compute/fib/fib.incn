# Fibonacci Benchmark
# Compute fib(N) iteratively, mod 10^9+7 to avoid overflow
# N = 1,000,000

def fib_mod(n: int, modulo: int) -> int:
    """The `n`th Fibonacci number modulo `modulo`, computed iteratively; `fib(0)` is 0 and `fib(1)` is 1."""
    if n <= 1:
        return n
    
    mut prev = 0
    mut curr = 1
    
    for i in range(2, n + 1):
        next = (prev + curr) % modulo
        prev = curr
        curr = next
    
    return curr

def main() -> None:
    """Print the 1,000,000th Fibonacci number modulo 1,000,000,007."""
    n = 1_000_000
    modulo = 1_000_000_007
    result = fib_mod(n, modulo)
    println(f"fib({n}) mod {modulo} = {result}")
