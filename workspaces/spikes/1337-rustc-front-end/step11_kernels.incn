# Step 11's Incan source: the kernels of the `fib`, `collatz` and `mandelbrot` benchmarks, unchanged.

def fib_mod(n: int, modulo: int) -> int:
    if n <= 1:
        return n

    mut prev = 0
    mut curr = 1

    for i in range(2, n + 1):
        next = (prev + curr) % modulo
        prev = curr
        curr = next

    return curr

def collatz_steps(n: int) -> int:
    mut count = 0
    mut num = n
    while num != 1:
        if num % 2 == 0:
            num = num // 2
        else:
            num = 3 * num + 1
        count += 1
    return count

def mandelbrot_escape(cr: float, ci: float, max_iter: int) -> int:
    mut zr = 0.0
    mut zi = 0.0

    for i in 0..max_iter:
        zr2 = zr * zr
        zi2 = zi * zi

        if zr2 + zi2 > 4.0:
            return i

        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr

    return max_iter
