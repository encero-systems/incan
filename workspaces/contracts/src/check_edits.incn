"""
A check case's replay contract: unchanged content replays the same report, a copy of the project at another path
replays it in the copy's own paths, and a new content identity checks again before its own unchanged repeat replays,
whether the bakery was already populated or not.
"""

from std.fs import Path
from std.tempfile import TemporaryDirectory
from compare import compare
from fixture import Fixture, fixture_files, materialize_files
from header import Header
from run import Outcome, clear_trace, invoke, trace_file, unit_notes

const REPLAYED: str = " check: replayed"
const CHECKED: str = " check: checked"


model Traced:
    """What one check showed, with the notes Oven traced about the units it prepared and the check itself."""

    outcome: Outcome
    notes: list[str]


pub def compare_check_edits(
    incan: str,
    project: Path,
    header: Header,
    command: list[str],
    fixture: Fixture,
) -> Result[list[str], str]:
    """
    Return the expectations broken by a check, its unchanged repeat, a copy at another path and each listed edit.

    1. Check once and compare the report with the case's expectations.
    2. Check again unchanged: the same streams and status, replayed rather than checked.
    3. Check a copy of the project at another path: replayed, and byte for byte a fresh check of the copy.
    4. Give each edit a new identity: the same report, checked once then replayed; restore the original file.
    """
    # 1. The first check is the case's ordinary comparison.
    first = traced(incan, command, project)?
    mut failures = compare("check", header, first.outcome)
    # 2. An unchanged unit replays its stored report byte for byte.
    repeat = traced(incan, command, project)?
    failures = failures + differences("the unchanged repeat", first.outcome, repeat.outcome)
    if not noted(repeat.notes, REPLAYED):
        failures.append(f"the unchanged repeat was not replayed; Oven noted: {listing(repeat.notes)}")
    # 3. The record is keyed by content and rendered in the requesting project's paths.
    failures = failures + relocated_check(incan, command, fixture_files(fixture)?)?
    # 4. A fresh directory name makes edited content new even in a bakery populated by earlier contract runs.
    nonce = TemporaryDirectory.try_new().map_err((error) => error.message())?
    edit = f"\n# check-edits {nonce.path().0}\n"
    for item in header.items("check-edits"):
        failures = failures + edited_check(incan, command, project, item, first.outcome, edit)?
    return Ok(failures)


def traced(incan: str, command: list[str], project: Path, environment: list[str] = []) -> Result[Traced, str]:
    """Run the check with a fresh trace, so its notes are this invocation's alone."""
    clear_trace(project)?
    outcome = invoke(incan, command, project, environment)?
    return Ok(Traced(outcome=outcome, notes=unit_notes(trace_file(project))))


def relocated_check(incan: str, command: list[str], files: Dict[str, bytes]) -> Result[list[str], str]:
    """
    Check a copy of the case project in a new directory: it replays the case's stored report, and shows exactly what
    a fresh check of the copy shows when the copy has a bakery of its own.
    """
    location = TemporaryDirectory.try_new().map_err((error) => error.message())?
    copy = materialize_files(location.path().joinpath("relocated"), files)?
    replayed = traced(incan, command, copy)?
    alone = TemporaryDirectory.try_new().map_err((error) => error.message())?
    fresh = traced(incan, command, copy, [f"INCAN_BAKERY={alone.path().0}"])?
    label = "the check of a copy at another path"
    mut failures = differences(label, fresh.outcome, replayed.outcome)
    if not noted(replayed.notes, REPLAYED):
        failures.append(f"{label} was not replayed; Oven noted: {listing(replayed.notes)}")
    if not noted(fresh.notes, CHECKED):
        failures.append(f"the copy's check with its own bakery was not checked; Oven noted: {listing(fresh.notes)}")
    return Ok(failures)
def edited_check(
    incan: str,
    command: list[str],
    project: Path,
    item: str,
    first: Outcome,
    edit: str,
) -> Result[list[str], str]:
    """Check and replay a new content identity, restoring the original file even when either invocation fails."""
    path = project.joinpath(item)
    original = path.read_text("utf-8", "strict").map_err((error) => f"{item}: {error.message()}")?
    path.write_text(original + edit, "utf-8", "strict", None).map_err((error) => f"{item}: {error.message()}")?
    checked = traced(incan, command, project)
    replayed = traced(incan, command, project)
    path.write_text(original, "utf-8", "strict", None).map_err((error) => f"{item}: {error.message()}")?
    result = checked?
    label = f"the check after editing {item}"
    mut failures = differences(label, first, result.outcome)
    if noted(result.notes, REPLAYED) or not noted(result.notes, CHECKED):
        failures.append(f"{label} did not check the unit again; Oven noted: {listing(result.notes)}")
    repeat = replayed?
    failures = failures + differences(f"{label}'s unchanged repeat", result.outcome, repeat.outcome)
    if not noted(repeat.notes, REPLAYED):
        failures.append(f"{label}'s unchanged repeat was not replayed; Oven noted: {listing(repeat.notes)}")
    return Ok(failures)


def differences(label: str, expected: Outcome, actual: Outcome) -> list[str]:
    """How `actual` differs from the first check's stdout, stderr and status; empty when every byte agrees."""
    mut failures: list[str] = []
    if actual.stdout != expected.stdout:
        failures.append(f"{label} printed a different stdout")
    if actual.stderr != expected.stderr:
        failures.append(f"{label} printed a different stderr")
    if actual.code != expected.code:
        failures.append(f"{label} exited {actual.exit_text()}, the first check {expected.exit_text()}")
    return failures


def noted(notes: list[str], marker: str) -> bool:
    """Whether Oven traced a note containing `marker`."""
    for note in notes:
        if marker in note:
            return true
    return false


def listing(notes: list[str]) -> str:
    """Traced notes as a report shows them, or `nothing` when there were none."""
    if len(notes) == 0:
        return "nothing"
    return "; ".join(notes)
