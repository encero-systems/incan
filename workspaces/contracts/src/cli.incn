"""Compare each public CLI invocation in a project case with the case's output and status contract."""

from std.fs import Path
from std.json import parse
from compare import compare
from header import Header
from run import Outcome, invoke, surface, trace_file, trace_lines, traced_setting
from workers import Invocation, invoke_many

# What an expected stdout line writes for the case's own project directory, which differs from run to run.
pub const PROJECT: str = "<project>"


pub def compare_cli(incan: str, project: Path, header: Header) -> Result[list[str], str]:
    """
    Return the expectations broken by each command, identifying the invocation beside every failure.

    1. Run each whitespace-separated command in the fixture project with the case's declared settings; under
       `trace-invariant:` run it traced first, and require the same bytes and status and a trace of every category.
    2. Compare each command's streams and status independently.
    3. Require each declared trace substring in the Oven trace that command added.
    4. Launch the `cli-concurrent:` commands together, comparing each the same way.
    5. Require each `expect-trace-at-most-once:` substring at most once in everything the case traced.
    """
    mut failures: list[str] = []
    start = trace_lines(trace_file(project))
    mut index = 0
    for command in header.items("cli-commands"):
        # 1. Each command runs afresh with its own streams and status; under `trace-invariant:` it first runs traced.
        name, arguments = surface(words(command))
        mut traced: Option[Outcome] = None
        channel = project.joinpath("target").joinpath("trace-invariant").joinpath(str(index))
        index += 1
        if header.trace_invariant:
            channel.mkdir(true, true).map_err((error) => error.message())?
            environment = header.items("environment") + [f"INCAN_ENGINE_TRACE={channel.0}"]
            traced = Some(invoke(incan, arguments, project, environment, name)?)
        before = trace_lines(trace_file(project))
        # Under `trace-invariant:` the comparison run has tracing off.
        mut plain = settings(project, header)?
        if header.trace_invariant:
            plain.append("INCAN_ENGINE_TRACE=")
        outcome = invoke(incan, arguments, project, plain, name)?
        if let Some(seen) = traced:
            for failure in trace_invariance(seen, outcome, channel)?:
                failures.append(f"{shown(command)}: {failure}")
        # 2. A successful sibling cannot hide another command's failure.
        for failure in compare("cli", header, located(outcome, project)):
            failures.append(f"{shown(command)}: {failure}")
        # 3. Only the lines this command traced can satisfy its trace expectations.
        added = since(before, trace_lines(trace_file(project)))
        for expected in header.items("expect-trace-contains"):
            if expected not in added:
                failures.append(f"{shown(command)}: Oven's trace does not contain `{expected}`")
    # 4. Concurrent commands start at once, each in its own process.
    failures = failures + concurrent(incan, project, header)?
    # 5. Work that must happen once across every command, concurrent ones included.
    traced = since(start, trace_lines(trace_file(project)))
    for expected in header.items("expect-trace-at-most-once"):
        count = len(traced.split(expected)) - 1
        if count > 1:
            failures.append(f"Oven's trace contains `{expected}` {count} times, not at most once")
    return Ok(failures)


def concurrent(incan: str, project: Path, header: Header) -> Result[list[str], str]:
    """Run every `cli-concurrent:` command at the same time and compare each outcome."""
    commands = header.items("cli-concurrent")
    if len(commands) == 0:
        return Ok([])
    mut requests: list[Invocation] = []
    for index in range(len(commands)):
        name, arguments = surface(words(commands[index]))
        requests.append(
            Invocation(
                program=incan,
                arguments=arguments,
                project=project,
                selector=None,
                environment=settings(project, header)?,
                capture=f"-concurrent-{index}",
                arg0=name,
            ),
        )
    outcomes = invoke_many(requests, len(requests))
    mut failures: list[str] = []
    for index in range(len(commands)):
        outcome = outcomes[index]?
        for failure in compare("cli", header, located(outcome, project)):
            failures.append(f"{shown(commands[index])} (concurrent): {failure}")
    return Ok(failures)


pub def located(outcome: Outcome, project: Path) -> Outcome:
    """
    `outcome` with the case's project directory written `<project>` in stdout, so a case can expect a path Oven
    prints. The directory is replaced as resolved and as given made absolute, the longer spelling first; stderr, whose
    expectations are substrings, and the status stay as they were.
    """
    mut spellings: list[str] = []
    match project.resolve():
        Ok(resolved) => spellings.append(resolved.0)
        Err(_) => pass
    match project.absolute():
        Ok(absolute) =>
            if absolute.0 not in spellings:
                spellings.append(absolute.0)
        Err(_) => pass
    if len(spellings) == 2 and len(spellings[1]) > len(spellings[0]):
        spellings = [spellings[1], spellings[0]]
    mut stdout = outcome.stdout
    for spelling in spellings:
        stdout = stdout.replace(spelling, PROJECT)
    return Outcome(stdout=stdout, stderr=outcome.stderr, code=outcome.code)


def settings(project: Path, header: Header) -> Result[list[str], str]:
    """
    A command's declared settings, after the case's channel when the case reads Oven's trace; a case's own
    `INCAN_ENGINE_TRACE` setting still wins.
    """
    if header.declares("expect-trace-contains") or header.declares("expect-trace-at-most-once"):
        return Ok(traced_setting(project)? + header.items("environment"))
    return Ok(header.items("environment"))


def words(command: str) -> list[str]:
    """A command line's whitespace-separated arguments."""
    return [item for item in command.split(" ") if item != ""]


def shown(command: str) -> str:
    """A command line as invoked, naming its surface: lines that name none are `incan` commands."""
    if command.startswith("oven ") or command.startswith("incan "):
        return command
    return f"incan {command}"


def since(before: list[str], after: list[str]) -> str:
    """The trace lines `after` holds beyond those `before` held, one to a line; a repeated line counts each time."""
    mut seen: Dict[str, int] = {}
    for line in before:
        seen[line] = seen.get(line).unwrap_or(0) + 1
    mut added: list[str] = []
    for line in after:
        count = seen.get(line).unwrap_or(0)
        if count > 0:
            seen[line] = count - 1
        else:
            added.append(line)
    return "\n".join(added)


def trace_invariance(traced: Outcome, plain: Outcome, channel: Path) -> Result[list[str], str]:
    """
    A command traced into `channel` printed exactly what it printed untraced; its trace holds Oven's reasoning, and
    every compiler process that wrote to the channel wrote its invocation records there too.
    """
    mut failures: list[str] = []
    if traced.stdout != plain.stdout:
        failures.append(f"tracing changed stdout: traced `{traced.stdout}`, untraced `{plain.stdout}`")
    if traced.stderr != plain.stderr:
        failures.append(f"tracing changed stderr: traced `{traced.stderr}`, untraced `{plain.stderr}`")
    if traced.code != plain.code:
        failures.append(f"tracing changed the exit status: traced {traced.exit_text()}, untraced {plain.exit_text()}")
    mut reasoned = false
    for path in channel.iterdir().map_err((error) => error.message())?:
        categories = file_categories(path)?
        if "reason" in categories:
            reasoned = true
        compiler = path.name().startswith("engine-compiler-") or path.name().startswith("engine-worker-")
        if compiler and "invocation" not in categories:
            failures.append(f"the compiler's trace file {path.name()} holds no `invocation` record")
    if not reasoned:
        failures.append(f"the trace channel {channel.0} holds no `reason` record")
    return Ok(failures)


def file_categories(path: Path) -> Result[list[str], str]:
    """The `operation` of every record in one trace file."""
    mut found: list[str] = []
    text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
    for line in text.split("\n"):
        if line == "":
            continue
        record = parse(line).map_err((error) => f"{path.0}: {error.message()}")?
        if let Some(value) = record.get("operation"):
            category = value.expect_str().map_err((error) => error.message())?
            if category not in found:
                found.append(category)
    return Ok(found)
