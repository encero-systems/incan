"""Optional git evidence and expiring MCP memory extend the existing graph relationship cases."""

from rust::std::fs import rename
from rust::std::process import Command
from rust::std::thread import sleep
from rust::std::time import Duration
from std.fs import Path
from std.json import JsonValue, parse
from files import optional_text as text
from protocol_peer import Peer, decode, start
from run import invoke


pub def check_process(incan: str, project: Path) -> Result[None, str]:
    """Verify process evidence: 1. Prove absence. 2. Observe fixture history. 3. Check identity and MCP expiry."""
    # 1. Prove absent inputs produce no observations.
    saved = project.joinpath(".git-contract-history")
    if project.joinpath(".git").is_dir():
        rename(project.joinpath(".git").0, saved.0).map_err((error) => str(error))?
    absent = graph(incan, project, true)?
    if project.joinpath(".git-contract-history").is_dir():
        rename(project.joinpath(".git-contract-history").0, project.joinpath(".git").0).map_err((error) => str(error))?
    if len(risks(absent)) != 0:
        return Err("unavailable git history invented process observations")
    # 2. Observe deterministic, opt-in fixture history.
    git(project, ["init"])?
    mut paths: list[str] = []
    for record in absent:
        path = text(record, "path")
        if local_source(record, project):
            paths.append(path)
    note = project.joinpath("co_change_note.txt")
    note.write_text("co-change fixture\n", "utf-8", "strict", None).map_err((error) => error.message())?
    paths.append("co_change_note.txt")
    git(project, ["add", "--"] + paths)?
    git(project, ["commit", "--allow-empty", "--no-gpg-sign", "-m", "graph process observation fixture"])?
    observed = graph(incan, project, true)?
    repeated = graph(incan, project, true)?
    if serialized(observed)? != serialized(repeated)?:
        return Err("process observations are not deterministic for unchanged inputs")
    if len(risks(observed)) == 0:
        return Err("available git history produced no process observations")
    for record in risks(observed):
        if not git_provenance(record):
            return Err("a process observation lacks git provenance")
        present = [populated(record, key) for key in ["evidence", "ownership", "co_changes"]]
        if false in present:
            return Err("a process observation omitted raw churn, ownership or co-change evidence")
    if len(risks(graph(incan, project, false)?)) != 0:
        return Err("process observations escaped the explicit opt-in")
    # 3. Verify key separation and session-only feedback expiry.
    check_package_keys(incan, project)?
    return check_memory(incan, project)


def check_package_keys(incan: str, project: Path) -> Result[None, str]:
    """The same authored source in a differently named package cannot reuse that package's declaration keys."""
    original = graph(incan, project, false)?
    manifest = project.joinpath("loaf.toml")
    before = manifest.read_text("utf-8", "strict").map_err((error) => error.message())?
    mut lines = before.split("\n")
    for index in range(len(lines)):
        if lines[index].startswith("name = "):
            lines[index] = 'name = "graph_identity_scope_probe"'
            break
    manifest.write_text("\n".join(lines), "utf-8", "strict", None).map_err((error) => error.message())?
    renamed = graph(incan, project, false)
    manifest.write_text(before, "utf-8", "strict", None).map_err((error) => error.message())?
    after = renamed?
    left = sorted([text(record, "stable_key") for record in original if text(record, "record") == "declaration"])
    right = sorted([text(record, "stable_key") for record in after if text(record, "record") == "declaration"])
    if left == right:
        return Err("distinct package identities share the same declaration key set")
    return Ok(None)


def check_memory(incan: str, project: Path) -> Result[None, str]:
    """Feedback stays in MCP, affects ranking, and expires on a changed snapshot or elapsed TTL."""
    records = graph(incan, project, false)?
    mut key = ""
    for record in records:
        if text(record, "record") == "declaration" and text(record, "name") == "helper":
            key = text(record, "stable_key")
    if key == "":
        return Err("feedback fixture has no proved helper identity")
    snapshot = text(records[0], "snapshot_id")
    mut peer = start(incan, project, ["mcp", "."], "jsonl")?
    peer.request(1, "initialize", JsonValue.object({
        "protocolVersion": JsonValue.string("2025-11-25"), "capabilities": JsonValue.object({}),
        "clientInfo": JsonValue.object({
            "name": JsonValue.string("graph-memory-contract"), "version": JsonValue.string("1")
        })
    }))?
    peer.notify("notifications/initialized", JsonValue.object({}))?
    feedback = observation(key, snapshot, 3600)
    tool(peer, 2, "record_feedback", feedback)?
    retained = memory(peer, 3)?
    if len(retained) != 1:
        return Err("MCP did not retain explicit task feedback")
    request = JsonValue.object({"task": JsonValue.string("helper"), "budget": JsonValue.int(4096)})
    packed = tool(peer, 4, "context_for_task", request)?
    if "session feedback" not in packed:
        return Err("current feedback did not explain its context ranking")
    mut source = project.joinpath("src").joinpath("lib.rs")
    if not source.is_file():
        source = project.joinpath("src").joinpath("main.incn")
    before = source.read_text("utf-8", "strict").map_err((error) => error.message())?
    source.write_text(f"\n{before}", "utf-8", "strict", None).map_err((error) => error.message())?
    expired = memory(peer, 5)
    source.write_text(before, "utf-8", "strict", None).map_err((error) => error.message())?
    if len(expired?) != 0:
        return Err("changed source retained stale feedback")
    mut label = "provider::helper"
    if source.name().endswith(".rs"):
        label = "rust_relationships::provider::helper"
    short = observation(label, snapshot, 1)
    tool(peer, 6, "record_feedback", short)?
    sleep(Duration.from_secs(2))
    timed = memory(peer, 7)?
    if len(timed) != 0:
        return Err("feedback outlived its TTL")
    tool(peer, 8, "process_risk", JsonValue.object({}))?
    peer.finish()?
    for record in graph(incan, project, false)?:
        if text(record, "provenance") == "session_feedback":
            return Err("session feedback escaped into compiler graph records")
    return Ok(None)


def tool(mut peer: Peer, identifier: int, name: str, arguments: JsonValue) -> Result[str, str]:
    """Read one successful textual MCP tool result, surfacing execution refusals as contract failures."""
    request = JsonValue.object({"name": JsonValue.string(name), "arguments": arguments})
    result = peer.request(identifier, "tools/call", request)?
    error = result.require("isError").map_err((error) => error.message())?
    if error.expect_bool().map_err((error) => error.message())?:
        return Err(f"MCP tool {name} refused: {result.to_json().unwrap_or('')}")
    blocks = result.require("content").map_err((error) => error.message())?
    content = blocks.expect_array().map_err((error) => error.message())?
    document = content[0].require("text").map_err((error) => error.message())?
    return document.expect_str().map_err((error) => error.message())


def graph(incan: str, project: Path, risk: bool) -> Result[list[JsonValue], str]:
    """Read the public graph format with optional observations, never a test-private extractor."""
    mut arguments = ["inspect", "codegraph", ".", "--format", "json"]
    if risk:
        arguments.append("--risk")
    output = invoke(incan, arguments, project)?
    if output.code != Some(0):
        return Err(f"graph export failed: {output.stderr}")
    return parse(output.stdout).map_err((error) => error.message())?.expect_array().map_err((error) => error.message())


def risks(records: list[JsonValue]) -> list[JsonValue]:
    """Select optional process records independently of compiler facts."""
    return [record for record in records if text(record, "record") == "risk_signal"]


def git(project: Path, arguments: list[str]) -> Result[None, str]:
    """Write only synthetic fixture history, with a local identity and external hooks disabled for the invocation."""
    mut command = Command.new("git")
    configuration = [
        "-c", "core.hooksPath=/dev/null", "-c", "user.name=Graph Fixture",
        "-c", "user.email=graph-fixture@example.invalid", "-c", "commit.gpgSign=false"
    ]
    for argument in configuration + arguments:
        command.arg(argument)
    command.current_dir(project.0)
    output = command.output().map_err((error) => str(error))?
    if not output.status.success():
        return Err(f"fixture git operation failed: {decode(output.stderr)?}")
    return Ok(None)


def local_source(record: JsonValue, project: Path) -> bool:
    """Select only represented, task-owned source files for synthetic history."""
    path = text(record, "path")
    extension = path.endswith(".incn") or path.endswith(".rs")
    return text(record, "record") == "file" and path.startswith(f"{project.0}/") and extension


def git_provenance(record: JsonValue) -> bool:
    """Require an observed git source and a full SHA-1 or SHA-256 commit identity."""
    observed = text(record, "provenance") == "process_observed" and text(record, "source") == "git"
    return observed and len(text(record, "head")) in [40, 64]


def populated(record: JsonValue, key: str) -> bool:
    """Require raw evidence in either the array or object shape defined for the observation."""
    match record.get(key):
        None => return false
        Some(value) =>
            if key == "evidence":
                return len(value.expect_array().unwrap_or([])) > 0
            return len(value.expect_object().unwrap_or({})) > 0


def serialized(records: list[JsonValue]) -> Result[str, str]:
    """Compare deterministic whole documents, including their provenance and snapshot identity."""
    return JsonValue.array(records).to_json().map_err((error) => error.message())


def observation(declaration: str, snapshot: str, ttl: int) -> JsonValue:
    """Build an explicit usefulness observation against this exact task and snapshot."""
    return JsonValue.object({
        "task": JsonValue.string("helper"), "declaration": JsonValue.string(declaration),
        "snapshot": JsonValue.string(snapshot), "ttl_seconds": JsonValue.int(ttl)
    })


def memory(mut peer: Peer, identifier: int) -> Result[list[JsonValue], str]:
    """Read current task memory through the public MCP tool and require its JSON array contract."""
    output = tool(peer, identifier, "task_memory", JsonValue.object({"task": JsonValue.string("helper")}))?
    return parse(output).map_err((error) => error.message())?.expect_array().map_err((error) => error.message())
