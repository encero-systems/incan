"""A bounded pool for fresh child invocations, independent of compilation groups."""

from rust::std::cell import RefCell
from rust::std::process import Child, ExitStatus
from rust::std::rc import Rc
from rust::std::thread import sleep
from rust::std::time import Duration, Instant
from std.fs import Path
from processes import Outcome, expired, finish, launch, terminate_group
from timing import elapsed_hint, record_elapsed
from timing import report as report_time


pub model Invocation:
    """One executable, its arguments, and the case's working directory."""

    pub program: str
    pub arguments: list[str]
    pub project: Path
    pub selector: Option[str]
    # A speculative attempt may shorten the user deadline; zero leaves an ordinary command's policy intact.
    pub deadline_seconds: int = 0
    # A selected entry starts only after this request compiled quietly and successfully in the same pool.
    pub after: Option[int] = None
    # Optional scheduling evidence from another scratch directory; it never authorizes compilation reuse.
    pub duration_hint: int = 0
    # `NAME=value` settings a project case's `environment:` block adds to this command's inherited environment.
    pub environment: list[str] = []


model Started:
    """One owned child with its request position, capture directory and individual deadline origin."""

    child: Rc[RefCell[Child]]
    index: int
    project: Path
    clock: Instant
    deadline_seconds: int
    measure: bool


# The runner enters one pool at a time; active records own child handles and their request metadata together.
static pool_outcomes: dict[int, Result[Outcome, str]] = {}
static pool_ready: list[int] = []
static pool_followups: dict[int, list[int]] = {}


pub def invoke_many(requests: list[Invocation], jobs: int) -> list[Result[Outcome, str]]:
    """
    Own at most `jobs` children, preserving each request's deadline and result position.

    1. Allocate one result slot per request.
    2. Launch, poll and refill the bounded child queue, releasing verified follow-ups.
    3. Return ordered outcomes and release the pool's callback state.
    """
    # 1. Every request has a result slot even when launching its child fails.
    pool_outcomes = {}
    pool_ready = []
    pool_followups = {}
    for index in range(len(requests)):
        waiting: Result[Outcome, str] = Err("invocation not started")
        pool_outcomes[index] = waiting
    prepare_order(requests)
    mut active: list[Started] = []
    mut next = 0
    limit = max([1, jobs])
    # 2. Launch, poll and refill the bounded child queue.
    while next < len(pool_ready) or len(active) > 0:
        while next < len(pool_ready):
            count = len(active)
            if count >= limit:
                break
            index = pool_ready[next]
            request = requests[index]
            clock = Instant.now()
            match launch(request.program, request.arguments, request.project, request.selector, request.environment):
                Err(error) => record_failure(index, error)
                Ok(child) =>
                    handle = Rc.new(RefCell.new(child))
                    active.append(
                        Started(
                            child=handle,
                            index=index,
                            project=request.project,
                            clock=clock,
                            deadline_seconds=request.deadline_seconds,
                            measure=measured_command(request),
                        ),
                    )
            next += 1
        previous = len(active)
        mut running: list[Started] = []
        for child in active:
            match pending_child(child):
                Some(pending) => running.append(pending)
                None => pass
        active = running
        if previous == len(active) and len(active) > 0:
            sleep(Duration.from_millis(2))
    # 3. No child remains active when the pool metadata is released.
    outcomes = [pool_outcomes[index] for index in range(len(requests))]
    pool_outcomes = {}
    pool_ready = []
    pool_followups = {}
    return outcomes


def prepare_order(requests: list[Invocation]) -> None:
    """Queue independent commands by duration and retain follow-up indices under their prerequisite."""
    for index in invocation_order(requests):
        match requests[index].after:
            None => pool_ready.append(index)
            Some(parent) =>
                if parent < 0 or parent >= len(requests) or parent == index:
                    record_failure(index, "invalid invocation prerequisite")
                    continue
                retain_followup(parent, index)


def retain_followup(parent: int, index: int) -> None:
    """Append through a local owner and publish the complete child list back into the prerequisite table."""
    mut children: list[int] = []
    if parent in pool_followups:
        children = pool_followups[parent]
    children.append(index)
    pool_followups[parent] = children


def release_followups(index: int) -> None:
    """Admit selected entries only after a quiet successful compilation; failures never execute dependents."""
    if index not in pool_followups:
        return
    for child in pool_followups[index]:
        if quiet_success(pool_outcomes[index]):
            pool_ready.append(child)
        else:
            record_failure(child, "prerequisite compilation did not succeed quietly")


def quiet_success(result: Result[Outcome, str]) -> bool:
    """Use the shared-build acceptance rule before any selected program can execute."""
    match result:
        Err(_) => return false
        Ok(outcome) => return outcome.code == Some(0) and outcome.stdout == "" and outcome.stderr == ""


def invocation_order(requests: list[Invocation]) -> list[int]:
    """Start historically longer commands first while ties and returned outcomes retain input order."""
    mut priorities: list[tuple[int, int]] = []
    for index in range(len(requests)):
        request = requests[index]
        mut duration = 0
        if measured_command(request):
            duration = max([elapsed_hint(request.project), request.duration_hint])
        priorities.append((-duration, index))
    mut order: list[int] = []
    for _duration, index in sorted(priorities):
        order.append(index)
    return order


def measured_command(request: Invocation) -> bool:
    """Measure original commands and shared builds; selected executions never determine compilation priority."""
    return request.selector == None


def pending_child(info: Started) -> Option[Started]:
    """Return a still-running handle; reap a completed child or enforce its deadline before releasing it."""
    pid = int(info.child.borrow().id())
    completed = info.child.borrow_mut().try_wait()
    match completed:
        Err(error) => record_failure(info.index, str(error))
        Ok(status) =>
            match status:
                Some(status) => settle(info, status, false)
                None =>
                    if not expired(info.clock, info.deadline_seconds):
                        return Some(info)
                    match terminate_group(pid):
                        Err(error) =>
                            record_failure(info.index, error)
                            return None
                        Ok(_) => pass
                    waited = info.child.borrow_mut().wait()
                    match waited:
                        Err(error) => record_failure(info.index, str(error))
                        Ok(status) => settle(info, status, true)
    return None


def settle(info: Started, status: ExitStatus, timed_out: bool) -> None:
    """Preserve exit-code versus signal identity before collecting this child's own captured streams."""
    mut code: Option[int] = None
    match status.code():
        Some(value) => code = Some(int(value))
        None => pass
    if info.measure:
        record_elapsed(info.project, info.clock)
    record_outcome(info.index, finish(info.project, code, timed_out, info.deadline_seconds))
    report_time(f"invocation {info.project.0}", info.clock)


def record_failure(index: int, error: str) -> None:
    """Retain one typed failure at the original request position, including children that never started."""
    failure: Result[Outcome, str] = Err(error)
    record_outcome(index, failure)


def record_outcome(index: int, outcome: Result[Outcome, str]) -> None:
    """Store one outcome by its request position before releasing verified follow-ups."""
    pool_outcomes[index] = outcome
    release_followups(index)
