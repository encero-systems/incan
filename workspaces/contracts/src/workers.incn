"""A bounded pool for fresh child invocations, independent of compilation groups."""

from rust::std::collections import VecDeque
from rust::std::process import Child, ExitStatus
from rust::std::thread import sleep
from rust::std::time import Duration, Instant
from std.fs import Path
from processes import Outcome, expired, finish, launch, terminate_group


pub model Invocation:
    """One executable, its arguments, and the case's working directory."""

    pub program: str
    pub arguments: list[str]
    pub project: Path
    pub selector: Option[str]


model Started:
    """One child's input position, capture directory and individual deadline origin."""

    index: int
    project: Path
    clock: Instant


# The runner enters one pool at a time. The native callback borrows Child; only its metadata is copied.
static pool_started: dict[int, Started] = {}
static pool_outcomes: list[Result[Outcome, str]] = []


pub def invoke_many(requests: list[Invocation], jobs: int) -> list[Result[Outcome, str]]:
    """
    Own at most `jobs` children and return results in request order.

    1. Initialize one result slot per request.
    2. Refill completed slots immediately while owning every active child.
    3. Return the ordered results and clear the pool metadata.
    """
    # 1. Every request has a result slot even when launching its child fails.
    pool_started = {}
    pool_outcomes = []
    for request in requests:
        waiting: Result[Outcome, str] = Err("invocation not started")
        pool_outcomes.append(waiting)
    # 2. A completed child releases capacity immediately for the next request.
    mut active = VecDeque.new()
    mut next = 0
    limit = max([1, jobs])
    while next < len(requests) or not active.is_empty():
        while next < len(requests):
            count = int(active.len())
            if count >= limit:
                break
            request = requests[next]
            clock = Instant.now()
            match launch(request.program, request.arguments, request.project, request.selector):
                Err(error) => record_failure(next, error)
                Ok(child) =>
                    pid = int(child.id())
                    pool_started[pid] = Started(index=next, project=request.project, clock=clock)
                    active.push_back(child)
            next += 1
        previous = int(active.len())
        active.retain_mut(keep_child)
        if previous == int(active.len()) and not active.is_empty():
            sleep(Duration.from_millis(2))
    # 3. No child remains active when the pool metadata is released.
    outcomes = pool_outcomes.clone()
    pool_outcomes = []
    pool_started = {}
    return outcomes


def keep_child(child: &mut Child) -> bool:
    """Reap each completed child or enforce its deadline, retaining only a still-running handle."""
    pid = int(child.id())
    info = pool_started[pid]
    match child.try_wait():
        Err(error) => record_failure(info.index, str(error))
        Ok(status) =>
            match status:
                Some(status) => settle(info, status, false)
                None =>
                    if not expired(info.clock):
                        return true
                    match terminate_group(pid):
                        Err(error) =>
                            record_failure(info.index, error)
                            return false
                        Ok(_) => pass
                    match child.wait():
                        Err(error) => record_failure(info.index, str(error))
                        Ok(status) => settle(info, status, true)
    return false


def settle(info: Started, status: ExitStatus, timed_out: bool) -> None:
    """Preserve exit-code versus signal identity before collecting this child's own captured streams."""
    mut code: Option[int] = None
    match status.code():
        Some(value) => code = Some(int(value))
        None => pass
    pool_outcomes[info.index] = finish(info.project, code, timed_out)


def record_failure(index: int, error: str) -> None:
    """Retain one typed failure at the original request position, including children that never started."""
    failure: Result[Outcome, str] = Err(error)
    pool_outcomes[index] = failure
