"""A bounded pool for fresh child invocations, independent of compilation groups."""

from rust::std::cell import RefCell
from rust::std::process import Child, ExitStatus
from rust::std::rc import Rc
from rust::std::thread import sleep
from rust::std::time import Duration, Instant
from std.fs import Path
from processes import Outcome, expired, finish, launch, terminate_group
from timing import elapsed_hint, record_elapsed
from timing import report as report_time


pub model Invocation:
    """One executable, its arguments, and the case's working directory."""

    pub program: str
    pub arguments: list[str]
    pub project: Path
    pub selector: Option[str]
    # A speculative attempt may shorten the user deadline; zero leaves an ordinary command's policy intact.
    pub deadline_seconds: int = 0
    # A selected entry starts only after this request compiled successfully in the same pool.
    pub after: Option[int] = None
    # Commands that run in one project at the same time capture their streams under distinct names.
    pub capture: str = ""
    # Optional scheduling evidence from another scratch directory; it never authorizes compilation reuse.
    pub duration_hint: int = 0
    # `NAME=value` settings a project case's `environment:` block adds to this command's inherited environment.
    pub environment: list[str] = []
    # Large protocol responses stay in an owned file and are selected by their consumer after reaping.
    pub stdout_file: Option[Path] = None
    # The program name the child is started under; `oven` selects the project surface of the same program (RFC 118).
    pub arg0: Option[str] = None


model Started:
    """One owned child with its request position, capture directory and individual deadline origin."""

    child: Rc[RefCell[Child]]
    index: int
    project: Path
    clock: Instant
    deadline_seconds: int
    measure: bool
    stdout_file: Option[Path]
    capture: str


# The runner enters one pool at a time; active records own child handles and their request metadata together.
static pool_outcomes: dict[int, Result[Outcome, str]] = {}
static pool_ready: list[int] = []
static pool_followups: dict[int, list[int]] = {}
# The requests that settled since the pool's owner last stepped it, in the order they settled.
static pool_settled: list[int] = []


pub model Pool:
    """
    At most `limit` children of one run, which more requests may join while it runs: a requester that learns what
    to run next from a settled request adds it at once, without waiting for the requests still running.
    """

    requests: list[Invocation] = []
    active: list[Started] = []
    next: int = 0
    pub limit: int = 1

    pub def size(self) -> int:
        """How many requests joined the pool; the next one to join gets this index."""
        return len(self.requests)

    pub def busy(self) -> bool:
        """Whether a request is still queued or running."""
        return self.next < len(pool_ready) or len(self.active) > 0

    pub def add(mut self, added: list[Invocation], first: bool = false) -> None:
        """
        Give each added request the next result slot, queue the independent ones longest first, ahead of the requests
        still queued when `first` asks, and hold each follow-up under its prerequisite, which joins the pool no later
        than the follow-up.
        """
        base = len(self.requests)
        for request in added:
            waiting: Result[Outcome, str] = Err("invocation not started")
            pool_outcomes[len(self.requests)] = waiting
            self.requests.append(request)
        mut ready: list[int] = []
        for offset in invocation_order(added):
            index = base + offset
            match added[offset].after:
                None => ready.append(index)
                Some(parent) =>
                    if parent < 0 or parent >= len(self.requests) or parent == index:
                        record_failure(index, "invalid invocation prerequisite")
                        continue
                    retain_followup(parent, index)
        if first:
            pool_ready = pool_ready[0:self.next] + ready + pool_ready[self.next:]
        else:
            pool_ready.extend(ready)

    pub def step(mut self) -> list[int]:
        """Launch queued requests up to the limit and reap finished children; the requests that settled meanwhile."""
        while self.next < len(pool_ready) and len(self.active) < self.limit:
            self.start(pool_ready[self.next])
            self.next += 1
        previous = len(self.active)
        mut running: list[Started] = []
        for child in self.active:
            match pending_child(child):
                Some(pending) => running.append(pending)
                None => pass
        self.active = running
        if previous == len(self.active) and len(self.active) > 0:
            sleep(Duration.from_millis(2))
        # A copy, since the static is emptied before the list is returned.
        settled = [index for index in pool_settled]
        pool_settled = []
        return settled

    def start(mut self, index: int) -> None:
        """Start request `index`, or record why it could not start."""
        request = self.requests[index]
        clock = Instant.now()
        match launch(
            request.program,
            request.arguments,
            request.project,
            request.selector,
            request.environment,
            request.stdout_file,
            request.capture,
            request.arg0,
        ):
            Err(error) => record_failure(index, error)
            Ok(child) =>
                self.active.append(
                    Started(
                        child=Rc.new(RefCell.new(child)),
                        index=index,
                        project=request.project,
                        clock=clock,
                        deadline_seconds=request.deadline_seconds,
                        measure=measured_command(request),
                        stdout_file=request.stdout_file,
                        capture=request.capture,
                    ),
                )


pub def open_pool(jobs: int) -> Pool:
    """An empty pool of at most `jobs` children; the runner enters one pool at a time."""
    pool_outcomes = {}
    pool_ready = []
    pool_followups = {}
    pool_settled = []
    return Pool(limit=max([1, jobs]))


pub def pool_outcome(index: int) -> Result[Outcome, str]:
    """What request `index` of the open pool showed, once it settled."""
    return pool_outcomes[index]


pub def close_pool(pool: Pool) -> list[Result[Outcome, str]]:
    """Every outcome of an idle pool in request order, releasing the pool's callback state."""
    outcomes = [pool_outcomes[index] for index in range(pool.size())]
    pool_outcomes = {}
    pool_ready = []
    pool_followups = {}
    pool_settled = []
    return outcomes


pub def invoke_many(requests: list[Invocation], jobs: int) -> list[Result[Outcome, str]]:
    """Own at most `jobs` children, preserving each request's deadline and result position."""
    mut pool = open_pool(jobs)
    pool.add(requests)
    while pool.busy():
        _ = pool.step()
    return close_pool(pool)


def retain_followup(parent: int, index: int) -> None:
    """Append through a local owner and publish the complete child list back into the prerequisite table."""
    mut children: list[int] = []
    if parent in pool_followups:
        children = pool_followups[parent]
    children.append(index)
    pool_followups[parent] = children


def release_followups(index: int) -> None:
    """
    Admit selected entries once their compilation succeeded, even one that printed output: its program is valid, and
    the requester decides which case owns the output. A failed compilation never executes its dependents.
    """
    if index not in pool_followups:
        return
    for child in pool_followups[index]:
        if succeeded(pool_outcomes[index]):
            pool_ready.append(child)
        else:
            record_failure(child, "prerequisite compilation did not succeed")


def succeeded(result: Result[Outcome, str]) -> bool:
    """Whether a prerequisite compilation exited successfully, so the program it built may execute."""
    match result:
        Err(_) => return false
        Ok(outcome) => return outcome.code == Some(0)


def invocation_order(requests: list[Invocation]) -> list[int]:
    """Start historically longer commands first while ties and returned outcomes retain input order."""
    mut priorities: list[tuple[int, int]] = []
    for index in range(len(requests)):
        request = requests[index]
        mut duration = 0
        if measured_command(request):
            duration = max([elapsed_hint(request.project), request.duration_hint])
        priorities.append((-duration, index))
    mut order: list[int] = []
    for _duration, index in sorted(priorities):
        order.append(index)
    return order


def measured_command(request: Invocation) -> bool:
    """Measure original commands and shared builds; selected executions never determine compilation priority."""
    return request.selector == None


def pending_child(info: Started) -> Option[Started]:
    """Return a still-running handle; reap a completed child or enforce its deadline before releasing it."""
    pid = int(info.child.borrow().id())
    completed = info.child.borrow_mut().try_wait()
    match completed:
        Err(error) => record_failure(info.index, str(error))
        Ok(status) =>
            match status:
                Some(status) => settle(info, status, false)
                None =>
                    if not expired(info.clock, info.deadline_seconds):
                        return Some(info)
                    match terminate_group(pid):
                        Err(error) =>
                            record_failure(info.index, error)
                            return None
                        Ok(_) => pass
                    waited = info.child.borrow_mut().wait()
                    match waited:
                        Err(error) => record_failure(info.index, str(error))
                        Ok(status) => settle(info, status, true)
    return None


def settle(info: Started, status: ExitStatus, timed_out: bool) -> None:
    """Preserve exit-code versus signal identity before collecting this child's own captured streams."""
    mut code: Option[int] = None
    match status.code():
        Some(value) => code = Some(int(value))
        None => pass
    if info.measure:
        record_elapsed(info.project, info.clock)
    record_outcome(info.index, finish(info.project, code, timed_out, info.deadline_seconds, info.stdout_file, info.capture))
    report_time(f"invocation {info.project.0}", info.clock)


def record_failure(index: int, error: str) -> None:
    """Retain one typed failure at the original request position, including children that never started."""
    failure: Result[Outcome, str] = Err(error)
    record_outcome(index, failure)


def record_outcome(index: int, outcome: Result[Outcome, str]) -> None:
    """Store one outcome by its request position, report it settled, and release its verified follow-ups."""
    pool_outcomes[index] = outcome
    pool_settled.append(index)
    release_followups(index)
