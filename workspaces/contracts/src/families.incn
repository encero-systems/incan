"""
The contract families: what each one runs and which expectations it admits.

- `behavior`: a program runs and shows what it declares, or is refused at check time with the codes it declares.
- `check`: a program is only checked: accepted cleanly (`expect-accepted:`) or refused with its codes.
- `library`: a project consumes the libraries it carries as path dependencies; Oven bakes them before the run.
- `interop`: a program reaches Rust through `rust::` imports and runs.
- `testing`: `incan test` runs one test file and reports each test by outcome.
- `format`: `incan fmt` preserves the expected text and is stable; `--check` reports changes without writing.
- `project`: what `incan describe-unit` reports for a project: its dependencies, its standard packages and its
  active features, or a refusal; explicit CLI invocation lists instead compare each command's output and status.
"""

from files import read
from fixture import Fixture
from header import Header, parse_header

pub const FAMILIES: FrozenList[str] = [
    "behavior", "check", "library", "interop", "testing", "project", "format", "graph",
]
# The expectations a run compares.
const RUN: FrozenList[str] = ["expect-stdout", "expect-stdout-contains", "expect-stderr-contains", "expect-exit"]
# Every expectation a header can declare; `behavior:`, `retires:` and `pending:` belong to every family.
const EXPECTATIONS: FrozenList[str] = [
    "expect-formatted", "expect-stdout", "expect-stdout-contains", "expect-stderr-contains", "expect-exit",
    "expect-diagnostic", "expect-accepted", "expect-dependencies", "expect-std-packages", "expect-active-features",
]


pub model AdmittedProgram:
    """A fixture's source and validated expectations, read through one intake boundary."""

    pub source: str
    pub header: Header


pub def read_program(fixture: Fixture) -> Result[AdmittedProgram, str]:
    """
    Read and admit one fixture, retaining its source path on every refusal.

    1. Read the fixture's program.
    2. Parse the header it begins with.
    3. Admit the header and the fixture's shape for its family.
    """
    program = fixture.program
    # 1. The program is read whole, and a refusal names the path it came from.
    source = read(program).map_err((reason) => f"{program.0}: {reason}")?
    # 2. The header the program begins with is parsed from that source.
    header = parse_header(source).map_err((reason) => f"{program.0}: {reason}")?
    # 3. The header and the fixture's shape are admitted for the fixture's family before anything is run.
    admit(fixture, header).map_err((reason) => f"{program.0}: {reason}")?
    return Ok(AdmittedProgram(source=source, header=header))


def admitted(family: str, cli: bool = false) -> list[str]:
    """The expectations the family compares for its default command or an explicit CLI command list."""
    if family == "format":
        return ["expect-formatted", "expect-exit"]
    if family == "graph":
        return list(RUN)
    if family == "check":
        return ["expect-diagnostic", "expect-accepted"]
    if family == "testing":
        return ["expect-stdout-contains", "expect-stderr-contains", "expect-exit"]
    if family == "project":
        if cli:
            return list(RUN)
        return [
            "expect-dependencies", "expect-std-packages", "expect-active-features",
            "expect-stderr-contains", "expect-exit",
        ]
    mut run = list(RUN)
    run.append("expect-diagnostic")
    return run


pub def admit(fixture: Fixture, header: Header) -> Result[None, str]:
    """
    Refuse a header that declares an expectation its family does not compare, or no expectation at all, and a fixture
    whose shape its family cannot run.

    1. Command-list directives belong to their named family; graph fixtures require their inspection commands.
    2. A header declares at least one expectation, and only those its family compares.
    3. The fixture has the shape its family runs.
    """
    # 1. Each command list belongs to its family; graph fixtures always declare their inspection invocations.
    if fixture.family == "graph" and len(header.items("graph-commands")) == 0:
        return Err("a graph fixture declares its inspection invocations in `graph-commands:`")
    if fixture.family != "graph" and header.declares("graph-commands"):
        return Err("only graph fixtures declare `graph-commands:`")
    if header.declares("cli-commands"):
        if fixture.family != "project":
            return Err("only project fixtures declare `cli-commands:`")
        commands = header.items("cli-commands")
        if len(commands) == 0 or "" in commands:
            return Err("`cli-commands:` requires nonempty command lines")
    # 2. The header declares at least one expectation, and only ones its family compares.
    check_expectations(fixture, header)?
    # 3. The fixture has the shape its family runs.
    return check_shape(fixture, header)


def check_expectations(fixture: Fixture, header: Header) -> Result[None, str]:
    """Refuse a header that declares nothing to compare, or an expectation the fixture's family does not compare."""
    allowed = admitted(fixture.family, header.declares("cli-commands"))
    mut declared = 0
    for key in EXPECTATIONS:
        if header.declares(key):
            if key not in allowed:
                return Err(f"the {fixture.family} family does not compare `{key}:`; it compares {", ".join(allowed)}")
            declared += 1
    if declared == 0:
        return Err(f"the header declares nothing to compare; the {fixture.family} family compares {", ".join(allowed)}")
    return Ok(None)


def check_shape(fixture: Fixture, header: Header) -> Result[None, str]:
    """Refuse a fixture shaped in a way its family cannot run."""
    if fixture.family == "library" and fixture.shape != "project":
        return Err("a library fixture is a project that carries its libraries as path dependencies")
    if fixture.family == "format" and (fixture.shape == "module" or not header.declares("expect-formatted")):
        return Err("a format fixture is one file or a project with `expect-formatted:`")
    if fixture.family == "testing" and (fixture.shape != "file" or not fixture.name.startswith("test_")):
        return Err("a testing fixture is one test file named `test_<subject>.incn`")
    return Ok(None)


pub def command(fixture: Fixture, header: Header) -> list[str]:
    """The family's default single invocation; command lists, formatting and graph comparison select their own."""
    if fixture.family == "project":
        return ["describe-unit", "src/main.incn"]
    if fixture.family == "testing":
        return ["test", f"tests/{fixture.name}.incn"]
    if header.accepted or len(header.diagnostics) > 0:
        return ["check", "src/main.incn", "--format", "json"]
    return ["run", "src/main.incn"]
