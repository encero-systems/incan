"""
The contract families: what each one runs and which expectations it admits.

- `behavior`: a program runs and shows what it declares, or is refused at check time with the codes it declares.
- `check`: a program is only checked: accepted cleanly (`expect-accepted:`) or refused with its codes.
- `library`: a project consumes the libraries it carries as path dependencies; Oven bakes them before the run.
- `interop`: a program reaches Rust through `rust::` imports and runs.
- `testing`: `incan test` runs one test file and reports each test by outcome.
- `format`: `incan fmt` preserves the expected text and is stable; `--check` reports changes without writing.
- `project`: what `incan describe-unit` reports for a project: its dependencies, its standard packages and its
  active features, or the refusal of a project Oven cannot describe.
"""

from fixture import Fixture
from header import Header


pub const FAMILIES: FrozenList[str] = ["behavior", "check", "library", "interop", "testing", "project", "format"]

# The expectations a run compares.
const RUN: FrozenList[str] = ["expect-stdout", "expect-stdout-contains", "expect-stderr-contains", "expect-exit"]

# Every expectation a header can declare; `behavior:`, `retires:` and `pending:` belong to every family.
const EXPECTATIONS: FrozenList[str] = [
    "expect-formatted",
    "expect-stdout",
    "expect-stdout-contains",
    "expect-stderr-contains",
    "expect-exit",
    "expect-diagnostic",
    "expect-accepted",
    "expect-dependencies",
    "expect-std-packages",
    "expect-active-features",
]


def admitted(family: str) -> list[str]:
    """The expectations `family` admits."""
    if family == "format":
        return ["expect-formatted", "expect-exit"]
    if family == "check":
        return ["expect-diagnostic", "expect-accepted"]
    if family == "testing":
        return ["expect-stdout-contains", "expect-stderr-contains", "expect-exit"]
    if family == "project":
        return ["expect-dependencies", "expect-std-packages", "expect-active-features", "expect-stderr-contains", "expect-exit"]
    mut run = list(RUN)
    run.append("expect-diagnostic")
    return run


pub def admit(fixture: Fixture, header: Header) -> Result[None, str]:
    """Refuse a header that declares an expectation its family does not compare, or no expectation at all, and a
    fixture whose shape its family cannot run."""
    allowed = admitted(fixture.family)
    mut declared = 0
    for key in EXPECTATIONS:
        if header.declares(key):
            if key not in allowed:
                return Err(f"the {fixture.family} family does not compare `{key}:`; it compares {', '.join(allowed)}")
            declared += 1
    if declared == 0:
        return Err(f"the header declares nothing to compare; the {fixture.family} family compares {', '.join(allowed)}")
    if fixture.family == "library" and fixture.shape != "project":
        return Err("a library fixture is a project that carries its libraries as path dependencies")
    if fixture.family == "format" and (fixture.shape == "module" or not header.declares("expect-formatted")):
        return Err("a format fixture is one file or a project with `expect-formatted:`")
    if fixture.family == "testing" and (fixture.shape != "file" or not fixture.name.startswith("test_")):
        return Err("a testing fixture is one test file named `test_<subject>.incn`")
    return Ok(None)


pub def command(fixture: Fixture, header: Header) -> list[str]:
    """The `incan` command line the case runs in its project."""
    if fixture.family == "project":
        return ["describe-unit", "src/main.incn"]
    if fixture.family == "testing":
        return ["test", f"tests/{fixture.name}.incn"]
    if header.accepted or len(header.diagnostics) > 0:
        return ["check", "src/main.incn", "--format", "json"]
    return ["run", "src/main.incn"]
