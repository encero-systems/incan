"""
Fixture discovery and materialization.

A fixtures root holds one directory per family, a family one directory per area, and an area one entry per fixture.
An entry is one of three shapes: `<name>.incn` (a single-file program), `<name>/main.incn` (a module fixture whose
siblings are importable modules) or `<name>/loaf.toml` (a complete project whose program is `src/main.incn`). Hidden
entries are skipped; anything else, and an area with nothing in it, is refused: something in the tree that proves
nothing is what the families exist to prevent.
"""

from std.fs import IoError, Path


# The manifest every single-file and module fixture runs under.
const MINIMAL_MANIFEST: str = "[project]\nname = \"{name}\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n"

# The manifest a testing fixture runs under: a project with no program.
const PROJECT_ONLY_MANIFEST: str = "[project]\nname = \"{name}\"\nversion = \"0.1.0\"\n"


pub model Fixture:
    """One fixture: where it lives and what shape it has."""

    pub family: str
    pub area: str
    pub name: str
    # `file`, `module` or `project`.
    pub shape: str
    # The fixture's entry in its area: the `.incn` file or the directory.
    pub entry: Path
    # The program that carries the header.
    pub program: Path

    def case_name(self) -> str:
        """The case's name in reports and selectors: `<family>/<area>/<name>`."""
        return f"{self.family}/{self.area}/{self.name}"

    def project_path(self, scratch: Path) -> Path:
        """The stable working directory and Oven output owner for this case."""
        return scratch.joinpath(f"{self.family}-{self.area}-{self.name}")


pub def discover_family(root: Path, family: str) -> Result[list[Fixture], str]:
    """Every fixture of `family` under `root`, area by area in name order."""
    directory = root.joinpath(family)
    if not directory.is_dir():
        return Err(f"{directory.0}: the family `{family}` has no directory")
    mut fixtures: list[Fixture] = []
    for area in children(directory)?:
        name = area.name()
        if not area.is_dir():
            if name == "README.md":
                continue
            return Err(f"{area.0}: a family holds area directories and its README.md; this file is neither")
        found = discover_area(area, family, name)?
        if len(found) == 0:
            return Err(f"{area.0}: the area holds no fixture")
        for fixture in found:
            fixtures.append(fixture)
    return Ok(fixtures)


def discover_area(area: Path, family: str, area_name: str) -> Result[list[Fixture], str]:
    """The fixtures of one area, refusing an entry of no known shape."""
    mut fixtures: list[Fixture] = []
    for entry in children(area)?:
        file_name = entry.name()
        if entry.is_file():
            if not file_name.endswith(".incn"):
                return Err(f"{entry.0}: an area holds `<name>.incn`, `<name>/main.incn` or `<name>/loaf.toml` fixtures; this file is none of them")
            name = file_name[0:len(file_name) - 5]
            check_name(entry, name)?
            fixtures.append(Fixture(family=family, area=area_name, name=name, shape="file", entry=entry, program=entry))
            continue
        check_name(entry, file_name)?
        if entry.joinpath("loaf.toml").is_file():
            program = entry.joinpath("src").joinpath("main.incn")
            if not program.is_file():
                return Err(f"{entry.0}: a project fixture's program is `src/main.incn`, which it does not have")
            fixtures.append(Fixture(family=family, area=area_name, name=file_name, shape="project", entry=entry, program=program))
            continue
        program = entry.joinpath("main.incn")
        if not program.is_file():
            return Err(f"{entry.0}: a fixture directory holds `main.incn` (a module fixture) or `loaf.toml` (a project fixture)")
        fixtures.append(Fixture(family=family, area=area_name, name=file_name, shape="module", entry=entry, program=program))
    return Ok(fixtures)


def children(directory: Path) -> Result[list[Path], str]:
    """The visible entries of `directory`, in name order."""
    mut by_name: dict[str, Path] = {}
    match directory.iterdir():
        Ok(entries) =>
            for entry in entries:
                if not entry.name().startswith("."):
                    by_name[entry.name()] = entry
        Err(error) => return Err(f"{directory.0}: {error.message()}")
    return Ok([by_name[name] for name in sorted([name for name in by_name.keys()])])


def check_name(entry: Path, name: str) -> Result[None, str]:
    """Refuse a fixture name that is not lowercase letters, digits and `_`, starting with a letter or `_`."""
    if name == "":
        return Err(f"{entry.0}: a fixture needs a name")
    for index in range(len(name)):
        character = name[index]
        if character not in "abcdefghijklmnopqrstuvwxyz0123456789_":
            return Err(f"{entry.0}: name a fixture with lowercase letters, digits and `_`; `{character}` is none of them")
    if name[0] in "0123456789":
        return Err(f"{entry.0}: a fixture name starts with a letter or `_`")
    return Ok(None)


pub def materialize(fixture: Fixture, scratch: Path) -> Result[Path, str]:
    """Synchronize a case's files while retaining the stable project and Oven's prepared outputs."""
    return materialize_files(fixture.project_path(scratch), fixture_files(fixture)?)


pub def materialize_files(project: Path, desired: Dict[str, bytes]) -> Result[Path, str]:
    """
    Write only changed fixture bytes and prune stale inputs, retaining the project's target directory.

    1. Write each desired file whose bytes differ from what is there, so unchanged inputs keep their metadata and Oven
       can reuse what it built from them.
    2. Remove what the fixture no longer provides.
    """
    # 1. A file is written only when its bytes differ, so unchanged inputs keep the metadata Oven reuses builds by.
    for relative in sorted([name for name in desired.keys()]):
        write_if_different(project.joinpath(relative), desired[relative])?
    # 2. Whatever the fixture no longer provides is removed, except the project's target directory.
    prune(project, "", desired)?
    return Ok(project)


pub def fixture_files(fixture: Fixture) -> Result[Dict[str, bytes], str]:
    """The fixture's complete source and data projection, including its project manifest."""
    mut files: Dict[str, bytes] = {}
    if fixture.shape == "project":
        collect(fixture.entry, "", files)?
        return Ok(files)
    mut manifest = MINIMAL_MANIFEST.replace("{name}", fixture.name)
    if fixture.family == "testing":
        # A test file runs from the project's `tests/` directory; the project has no program of its own.
        collect(fixture.entry, f"tests/{fixture.name}.incn", files)?
        manifest = PROJECT_ONLY_MANIFEST.replace("{name}", fixture.name)
    elif fixture.shape == "module":
        collect(fixture.entry, "src", files)?
    else:
        collect(fixture.entry, "src/main.incn", files)?
    files["loaf.toml"] = manifest.encode("utf-8")
    return Ok(files)


def collect(source: Path, relative: str, mut files: Dict[str, bytes]) -> Result[None, str]:
    """Add a file or directory tree under its project-relative path."""
    if source.is_file():
        files[relative] = contents(source)?
        return Ok(None)
    for entry in listed(source)?:
        name = entry.name()
        if relative == "":
            collect(entry, name, files)?
        else:
            collect(entry, f"{relative}/{name}", files)?
    return Ok(None)


def write_if_different(path: Path, content: bytes) -> Result[None, str]:
    """Write content only when the existing file's bytes differ."""
    if path.is_file() and contents(path)? == content:
        return Ok(None)
    io(path.parent().mkdir(true, true), path.parent())?
    io(path.write_bytes(content), path)?
    return Ok(None)


def prune(directory: Path, relative: str, desired: Dict[str, bytes]) -> Result[None, str]:
    """
    Remove stale fixture inputs while leaving Oven's target directory in place.

    A directory is pruned in turn and removed when nothing is left in it; a file the fixture does not provide goes.
    """
    for entry in listed(directory)?:
        name = entry.name()
        if relative == "" and name == "target":
            continue
        path = f"{relative}{name}"
        if entry.is_dir():
            prune(entry, f"{path}/", desired)?
            if len(listed(entry)?) == 0:
                io(entry.rmdir(), entry)?
        elif path not in desired:
            io(entry.unlink(), entry)?
    return Ok(None)


def listed(directory: Path) -> Result[list[Path], str]:
    """The entries of a directory, a failure named after it."""
    return directory.iterdir().map_err((error) => f"{directory.0}: {error.message()}")


def contents(path: Path) -> Result[bytes, str]:
    """The bytes of a file, a failure named after it."""
    return path.read_bytes().map_err((error) => f"{path.0}: {error.message()}")


def io(result: Result[None, IoError], path: Path) -> Result[None, str]:
    """An I/O result with its error named after `path`."""
    match result:
        Ok(_) => return Ok(None)
        Err(error) => return Err(f"{path.0}: {error.message()}")
