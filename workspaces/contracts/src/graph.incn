"""Public graph command contracts, including warm-query equality and wire-format agreement."""

from std.fs import Path
from std.json import JsonValue
from rust::std::fs import OpenOptions, metadata
from rust::std::os::unix::fs import MetadataExt
from compare import compare
from files import (
    items,
    json_text,
    optional_text as string_field,
    parse_json,
    read,
    read_bytes,
    remove,
    required,
    required_text,
    string_of,
    write,
    write_bytes,
)
from header import Header
from run import Outcome, invoke
from graph_context_contract import check_context
from graph_mcp_contract import check_mcp
from graph_lsp_contract import check_lsp
from graph_process_contract import check_process


pub def compare_graph(incan: str, selected: Path, header: Header) -> Result[list[str], str]:
    """
    Run the declared inspections twice, compare warm answers, and compare their observable output.

    1. Resolve the fixture path and run each inspection twice; the warm answer must equal the first.
    2. Their answers together, with the project path removed, meet the header's expectations.
    3. When every inspection succeeded, the exported documents are checked too.
    """
    # Resolve once so graph file records, git history and editor URIs share the same project identity.
    project = selected.resolve().map_err((error) => error.message())?
    mut stdout = ""
    mut stderr = ""
    mut code: Option[int] = Some(0)
    mut failures: list[str] = []
    # 1. Every declared inspection runs twice, and its warm second answer must equal the first.
    existing = library_artifacts(project)?
    for invocation in header.items("graph-commands"):
        arguments = ["inspect", "codegraph"] + invocation.split(" ")
        outcome = invoke(incan, arguments, project)?
        repeated = invoke(incan, arguments, project)?
        failures = failures + inspection_failures(invocation, outcome, repeated)
        stdout += outcome.stdout.replace(f"{project.0}/", "")
        stderr += outcome.stderr
        if outcome.code != Some(0):
            code = outcome.code
    # 2. The answers together, with the project path removed, meet the header's expectations.
    for failure in compare("graph", header, Outcome(stdout=stdout, stderr=stderr, code=code)):
        failures.append(failure)
    if len(failures) > 0 and stderr.strip() != "":
        failures.append(stderr)
    # 3. Only when every inspection succeeded are the exported documents checked as well.
    if code == Some(0):
        for failure in check_documents(incan, project, existing)?:
            failures.append(failure)
    return Ok(failures)


def inspection_failures(invocation: str, outcome: Outcome, repeated: Outcome) -> list[str]:
    """What is wrong with one inspection: an import hit without identity or path, or a warm answer that differs."""
    mut failures: list[str] = []
    for line in outcome.stdout.split("\n"):
        if line.startswith("import  "):
            failures.append(f"an import hit has no identity or source path: {invocation}")
    if repeated.stdout != outcome.stdout or repeated.code != outcome.code:
        failures.append(f"warm inspection differs: {invocation}")
    return failures


def document(incan: str, project: Path, format: str) -> Result[str, str]:
    """Read one public export, surfacing compiler refusal rather than comparing an empty document."""
    result = invoke(incan, ["inspect", "codegraph", ".", "--format", format], project)?
    if result.code != Some(0):
        return Err(f"{format} export failed: {result.stderr}")
    return Ok(result.stdout)


def declaration_identities(document: str) -> Result[list[str], str]:
    """Compare only declaration identities across a position-only source edit; spans must change independently."""
    records = items(parse_json(document)?)?
    check_expansion_sites(records)?
    meanings = required(records[0], "declaration_digests")?
    mut identities: list[str] = []
    for record in records:
        if required_text(record, "record")? != "declaration":
            continue
        # Published standard graphs may retain declarations whose executable signature is unproven.
        # Position edits in this fixture must preserve its own declarations and those of its local providers.
        if string_field(record.get("span").unwrap_or(JsonValue.null()), "file").startswith("@std/"):
            continue
        stable = required(record, "stable_identity")?
        if stable.is_null():
            return Err("a checked fixture declaration has no stable identity")
        key = string_field(record, "stable_key")
        if stable.get("signature").unwrap_or(JsonValue.null()).is_null():
            if key != "":
                return Err("a declaration without a proved signature has a portable identity key")
            continue
        if not key.startswith("symbol:"):
            return Err("a checked fixture declaration has no portable identity key")
        meaning = required(meanings, key)?
        digest = record.get("semantic_digest").unwrap_or(JsonValue.null())
        if json_text(meaning)? != json_text(digest)?:
            return Err("a declaration digest is not indexed by its own identity")
        identities.append(key)
    return Ok(sorted(identities))


def check_expansion_sites(records: list[JsonValue]) -> Result[None, str]:
    """The vocabulary fixture retains both generated helper calls and references at one authored range."""
    package = records[0].get("package").unwrap_or(JsonValue.null())
    if string_field(package, "name") != "vocabulary_graph":
        return Ok(None)
    for kind in ["call", "reference"]:
        mut sites: Dict[str, list[str]] = {}
        mut repeated = false
        for record in records:
            if string_field(record, "record") != kind:
                continue
            identity = record.get("canonical_identity").unwrap_or(JsonValue.null())
            if string_field(identity, "declaration_name") != "helper":
                continue
            if record.get("target_id").unwrap_or(JsonValue.null()).is_null():
                return Err(f"a generated {kind} has no checked target")
            span = json_text(record.get("span").unwrap_or(JsonValue.null()))?
            identifier = string_field(record, "id")
            mut retained = sites.get(span).unwrap_or([])
            if identifier not in retained:
                retained.append(identifier)
            sites[span] = retained
            if len(retained) >= 2:
                repeated = true
        if not repeated:
            return Err(f"generated {kind} records sharing one authored range were lost")
    return Ok(None)


def check_documents(incan: str, project: Path, existing: list[str]) -> Result[list[str], str]:
    """
    JSON and JSONL agree; changed bytes invalidate the cache while declaration identities survive line movement.

    1. The JSON export answers identity queries consistently, built no Incan library, and links its Rust facts.
    2. The JSONL export holds the same records as the JSON one.
    3. A source edit changes the export's spans, not its declaration identities; broken source is exported as an
       unchecked unit, and refused with `--strict`.
    4. A unit that fails checking costs its siblings nothing, and a published provider graph is read as published.
    """
    # 1. The JSON export answers identity queries consistently, built no Incan library, and links its Rust facts.
    original = document(incan, project, "json")?
    original_records = items(parse_json(original)?)?
    snapshot = string_field(original_records[0], "snapshot_id")
    if not snapshot.startswith("snapshot:"):
        return Err("an export has no content-addressed snapshot identity")
    fresh = invoke(incan, ["inspect", "codegraph", ".", "--stale", snapshot], project)?
    if fresh.code != Some(0) or snapshot_stale(fresh.stdout)?:
        return Err("an unchanged snapshot is stale")
    check_identity_queries(incan, project, original)?
    check_context(incan, project)?
    check_mcp(incan, project)?
    if library_artifacts(project)? != existing:
        return Err("graph inspection created or changed a compiled Incan library")
    check_rust_links(original)?
    # 2. The JSONL export holds exactly the records the JSON export does.
    jsonl = document(incan, project, "jsonl")?
    lines = json_lines(jsonl)?
    canonical = json_text(parse_json(original)?)?
    mut failures: list[str] = []
    if canonical != json_text(JsonValue.array(lines))?:
        failures.append("JSON and JSONL exports disagree")
    # 3. A source edit changes the export's spans but not its declaration identities, and broken source is unchecked.
    failures = failures + check_source_edits(incan, project, original, snapshot)?
    # 4. A failing unit costs its siblings nothing, and a published provider graph is read as it was published.
    check_tolerant_export(incan, project)?
    check_published_graph(incan, project)?
    check_lsp(incan, project)?
    check_process(incan, project)?
    return Ok(failures)


def json_lines(text: str) -> Result[list[JsonValue], str]:
    """The JSON value on each nonempty line of a JSONL document."""
    mut lines: list[JsonValue] = []
    for line in text.split("\n"):
        if line != "":
            lines.append(parse_json(line)?)
    return Ok(lines)


def check_source_edits(incan: str, project: Path, original: str, snapshot: str) -> Result[list[str], str]:
    """
    Edit the project's source and restore it: a moved line reuses no stale span and keeps declaration identities, and
    broken source is exported as an unchecked unit with a warning, while `--strict` refuses it.
    """
    mut source = project.joinpath("src").joinpath("lib.rs")
    if not source.is_file():
        source = project.joinpath("src").joinpath("main.incn")
    before = read(source)?
    mut failures: list[str] = []
    check_nominal_body_edit(incan, project, source, before, original)?
    check_comment_freshness(incan, project, source, before)?
    write(source, f"\n{before}")?
    moved = document(incan, project, "json")?
    stale = invoke(incan, ["inspect", "codegraph", ".", "--stale", snapshot], project)?
    if stale.code != Some(0) or not snapshot_stale(stale.stdout)?:
        return Err("changed source did not invalidate the snapshot")
    if original == moved:
        failures.append("source edit reused stale source spans")
    if declaration_identities(original)? != declaration_identities(moved)?:
        failures.append("line movement changed a declaration identity")
    if declaration_meanings(original, "")? != declaration_meanings(moved, "")?:
        failures.append("line movement changed a declaration's checked meaning")
    write(source, "this is invalid in both languages {")?
    invalid = invoke(incan, ["inspect", "codegraph", ".", "--format", "json"], project)?
    refused = invoke(incan, ["inspect", "codegraph", ".", "--strict"], project)?
    write(source, before)?
    if refused.code == Some(0):
        failures.append("strict export of broken source reused a checked cached graph")
    if invalid.code != Some(0) or "is unchecked" not in invalid.stderr or invalid.stdout.strip() == original.strip():
        failures.append(f"broken source was not exported as an unchecked unit with a warning: {invalid.stderr}")
    return Ok(failures)


def check_nominal_body_edit(incan: str, project: Path, source: Path, before: str, original: str) -> Result[None, str]:
    """
    Prove nominal identity and meaning survive a private body edit.

    1. Change only the earlier private body, restoring the source before checking the result.
    2. Require every other declaration's stable identity and meaning to stay byte-identical.
    3. Change one callable signature and require exactly it and its caller's meaning to change.
    """
    if "def identity_before(" not in before:
        return Ok(None)
    # 1. The conjunction shifts later carrier coordinates without changing their source or meaning.
    write(source, before.replace("if enabled:", "if enabled and true:"))?
    movement = document(incan, project, "json")
    write(source, before)?
    # 2. The edited body changes meaning while all other declaration products survive.
    baseline = declaration_meanings(original, "identity_before")?
    moved = movement?
    actual = declaration_meanings(moved, "identity_before")?
    if baseline != actual:
        return Err("private body edit changed another declaration's stable identity or meaning")
    if declaration_meanings(original, "")? == declaration_meanings(moved, "")?:
        return Err("the edited private body kept its old meaning digest")
    check_nominal_reordering(incan, project, source, before, original)?
    # 3. Another module's Item stays distinct inside the changed generic signature and return.
    changed = before.replace("take(values: list[Item]) -> Item", "take(values: list[OtherItem]) -> OtherItem")
    write(source, changed)?
    revision = document(incan, project, "json")
    write(source, before)?
    revised = revision?
    if declaration_meanings(original, "take|take_value")? != declaration_meanings(revised, "take|take_value")?:
        return Err("signature edit changed an independent declaration's identity or meaning")
    if declaration_meanings(original, "take_value")? == declaration_meanings(revised, "take_value")?:
        return Err("different nominal signature reused the original identity and meaning")
    if declaration_meanings(original, "take")? == declaration_meanings(revised, "take")?:
        return Err("nominal signature edit did not change its dependent caller's meaning")
    return Ok(None)


def check_nominal_reordering(incan: str, project: Path, source: Path, before: str, original: str) -> Result[None, str]:
    """Move the private declaration after its nominal users without changing any declaration's identity or meaning."""
    parts = before.split("def identity_before(")
    tail = parts[1].split("pub model Item:")
    private = "def identity_before(" + tail[0]
    write(source, parts[0] + "pub model Item:" + tail[1] + "\n\n" + private)?
    moved = document(incan, project, "json")
    write(source, before)?
    if declaration_meanings(original, "")? != declaration_meanings(moved?, "")?:
        return Err("declaration reordering changed a stable identity or meaning")
    return Ok(None)


def declaration_meanings(document: str, excluded: str) -> Result[list[str], str]:
    """Compare checked declaration identities and digests, preserving all type arguments and nominal owners."""
    mut result: list[str] = []
    for record in items(parse_json(document)?)?:
        if string_field(record, "record") != "declaration" or string_field(record, "name") in excluded.split("|"):
            continue
        stable = record.get("stable_identity").unwrap_or(JsonValue.null())
        digest = string_field(record, "semantic_digest")
        if (
            string_field(record, "name") in ["make", "take", "take_value", "other", "ignore", "identity_before"]
            and digest == ""
        ):
            return Err("nominal identity probe has no proven declaration digest")
        if digest == "":
            continue
        result.append(json_text(stable)? + ":" + digest)
    return Ok(sorted(result))


def library_artifacts(project: Path) -> Result[list[str], str]:
    """Record ordinary library observations; executable vocabulary providers are an inspection prerequisite."""
    mut result: list[str] = []
    for artifact in project.rglob("*.incnbody").map_err((error) => error.message())?:
        if executed_vocabulary(artifact)?:
            continue
        name = f"{artifact.0}"
        info = metadata(artifact.0).map_err((error) => str(error))?
        identity = f"{name}:{info.dev()}:{info.ino()}:{info.size()}"
        clock = f"{info.mtime()}.{info.mtime_nsec()}:{info.ctime()}.{info.ctime_nsec()}"
        result.append(f"{identity}:{clock}")
    return Ok(sorted(result))


def executed_vocabulary(artifact: Path) -> Result[bool, str]:
    """A published vocabulary worker requires its provider's executable body before the consumer can be checked."""
    package = artifact.name()[:-len(".incnbody")]
    manifest = parse_json(read(artifact.parent().joinpath(f"{package}.incnlib"))?)?
    vocabulary = manifest.get("vocab").unwrap_or(JsonValue.null())
    return Ok(not vocabulary.get("desugarer_artifact").unwrap_or(JsonValue.null()).is_null())


def check_comment_freshness(incan: str, project: Path, source: Path, before: str) -> Result[None, str]:
    """Equal-size comment edits with a restored modification time must expire the retained source snapshot."""
    mut prefix = "#"
    if source.name().endswith(".rs"):
        prefix = "//"
    write(source, f"{before}\n{prefix} snapshot a\n")?
    records = items(parse_json(document(incan, project, "json")?)?)?
    snapshot = string_field(records[0], "snapshot_id")
    replace_with_time_preserved(source, f"{before}\n{prefix} snapshot b\n")?
    status = invoke(incan, ["inspect", "codegraph", ".", "--stale", snapshot], project)?
    write(source, before)?
    if status.code != Some(0) or not snapshot_stale(status.stdout)?:
        return Err("an equal-size comment edit left the source snapshot fresh")
    return Ok(None)


def snapshot_stale(document: str) -> Result[bool, str]:
    """Read the public snapshot-status flag without accepting absent or malformed responses."""
    return required(parse_json(document)?, "stale")?.expect_bool().map_err((error) => error.message())


def replace_with_time_preserved(path: Path, content: str) -> Result[None, str]:
    """Replace source bytes in place and restore mtime, leaving ctime as the evidence of an equal-size edit."""
    modified = metadata(f"{path.0}").map_err((error) => str(error))?.modified().map_err((error) => str(error))?
    write(path, content)?
    mut options = OpenOptions.new()
    options.write(true)
    file = options.open(f"{path.0}").map_err((error) => str(error))?
    file.set_modified(modified).map_err((error) => str(error))?
    return Ok(None)


def check_tolerant_export(incan: str, project: Path) -> Result[None, str]:
    """
    A unit that fails checking is named in one warning and contributes only unchecked facts, never costing the others.

    1. Add a function that does not type check to the context unit, and ask four questions about it.
    2. A sibling unit's answer is unchanged, and the failing unit is named by exactly one warning.
    3. The failing unit's own facts are marked unchecked, a warm query repeats the warning, and `--strict` refuses.
    """
    source = project.joinpath("context").joinpath("src").joinpath("lib.incn")
    if not source.is_file():
        return Ok(None)
    # 1. A function that does not type check is added to the context unit, and four questions are asked about it.
    before = read(source)?
    write(source, before + "\n\npub def refused() -> int:\n    return \"not an int\"\n")?
    query = ["inspect", "codegraph", ".", "--query", "defs"]
    sibling = invoke(incan, query + ["checked_helper"], project)?
    broken = invoke(incan, query + ["contextual_helper"], project)?
    repeated = invoke(incan, query + ["contextual_helper"], project)?
    strict = invoke(incan, query + ["contextual_helper", "--strict"], project)?
    write(source, before)?
    # 2. A sibling unit's answer is unchanged, and the failing unit is named by exactly one warning.
    warnings = [line for line in sibling.stderr.split("\n") if line.startswith("warning:")]
    if sibling.code != Some(0) or "graph_checked::main::checked_helper" not in sibling.stdout:
        return Err(f"a failing sibling unit changed a checked answer: {sibling.stderr}")
    if "(unchecked)" in sibling.stdout:
        return Err(f"a failing sibling unit changed a checked answer: {sibling.stderr}")
    if len(warnings) != 1 or "graph_context is unchecked" not in warnings[0]:
        return Err(f"a failing unit was not named by exactly one warning line: {sibling.stderr}")
    # 3. The failing unit's facts are marked unchecked, a warm query repeats the warning, and `--strict` refuses.
    if broken.code != Some(0) or "contextual_helper" not in broken.stdout or "(unchecked)" not in broken.stdout:
        return Err(f"an unchecked unit's parseable facts were not marked: {broken.stdout}{broken.stderr}")
    if repeated.stdout != broken.stdout or repeated.stderr != broken.stderr or repeated.code != broken.code:
        return Err("a warm query dropped or changed the unchecked warning")
    if strict.code == Some(0) or "graph_context" not in strict.stderr:
        return Err(f"strict export accepted a unit that fails checking: {strict.stderr}")
    return Ok(None)


def check_identity_queries(incan: str, project: Path, document: str) -> Result[None, str]:
    """Unique short names and their full exported IDs select the same checked callers, across package boundaries."""
    records = items(parse_json(document)?)?
    declarations = [record for record in records if string_field(record, "record") == "declaration"]
    for declaration in declarations:
        match declaration.get("span"):
            Some(span) =>
                if not string_field(span, "file").startswith(f"{project.0}/"):
                    continue
            None => continue
        name = string_field(declaration, "name")
        if name == "" or len([item for item in declarations if string_field(item, "name") == name]) != 1:
            continue
        identifier = string_field(declaration, "id")
        short = invoke(incan, ["inspect", "codegraph", ".", "--query", "callers", name], project)?
        if short.stdout == "":
            continue
        full = invoke(incan, ["inspect", "codegraph", ".", "--query", "callers", identifier], project)?
        if short.code != Some(0) or full.code != Some(0) or short.stdout != full.stdout:
            return Err(f"full declaration ID and short name select different callers: {name}")
    return Ok(None)


def check_published_graph(incan: str, project: Path) -> Result[None, str]:
    """
    An explicitly built provider ships a portable binary graph; consumers read it despite unbuilt source edits.

    1. Build the provider. Its compiled Loaf carries a version-one binary graph that names no physical project root.
    2. A consumer reads the published graph, though the provider's source has since become invalid.
    3. A corrupt published graph is refused, not silently replaced or reused.
    4. A provider with no published graph is exported once, and the export is stable.
    """
    provider = project.joinpath("deps").joinpath("checked")
    source = provider.joinpath("src").joinpath("lib.incn")
    if not source.is_file():
        return Ok(None)
    checked = invoke(incan, ["inspect", "codegraph", provider.0, "--format", "json"], project)?
    if checked.code != Some(0):
        return Err(f"provider inspection failed: {checked.stderr}")
    checked_digest = helper_digest(checked.stdout)?
    # 1. The provider's compiled Loaf carries a version-one binary graph that names no physical project root.
    built = invoke(incan, ["build", source.0], project)?
    if built.code != Some(0):
        return Err(f"provider build failed: {built.stderr}")
    consumer = invoke(incan, ["build", "src/main.incn"], project)?
    if consumer.code != Some(0):
        return Err(f"consumer preparation failed: {consumer.stderr}")
    publications = published_graphs(project, provider)
    if len(publications) == 0:
        return Err("provider build published no graph")
    check_binary_graph(read_bytes(publications[0])?, project)?
    compiled = document(incan, project, "json")?
    if helper_digest(compiled)? != checked_digest:
        return Err("the inspected cross-module library body differs from its compiled publication")
    # 2. A consumer reads the published graph, though the provider's source has since become invalid.
    arguments = ["inspect", "codegraph", ".", "--query", "defs", "checked_helper"]
    original = invoke(incan, arguments, project)?
    before = read(source)?
    write(source, "invalid dependency source {")?
    published = invoke(incan, arguments, project)?
    if original.code != Some(0) or published.code != Some(0) or original.stdout != published.stdout:
        return Err(f"published dependency graph was rechecked from source: {published.stderr}")
    write(source, before)?
    # 3. A corrupt published graph is refused, never silently replaced or reused.
    for graph in publications:
        write_bytes(graph, b"\x7f\x00\x00\x00")?
    corrupt = invoke(incan, arguments, project)?
    if corrupt.code == Some(0):
        return Err("a corrupt published graph was silently replaced or reused")
    # 4. A provider with no published graph is exported once, and a second export gives the same answer.
    for graph in publications:
        remove(graph)?
    legacy = invoke(incan, arguments, project)?
    repeated = invoke(incan, arguments, project)?
    stable = legacy.stdout == repeated.stdout and legacy.code == repeated.code
    if legacy.code != Some(0) or legacy.stdout != original.stdout or not stable:
        return Err(f"older artifact did not receive a stable cached graph export: {legacy.stderr}")
    return Ok(None)


def helper_digest(document: str) -> Result[str, str]:
    """Read a proved helper digest and portable identity from either source inspection or its publication."""
    for record in items(parse_json(document)?)?:
        if string_field(record, "record") != "declaration" or string_field(record, "name") != "checked_helper":
            continue
        digest = string_field(record, "semantic_digest")
        if not digest.startswith("sha256:"):
            return Err("the checked library helper has no proved semantic digest")
        return Ok(string_field(record, "stable_key") + ":" + digest)
    return Err("the library graph omitted its checked helper")


def check_binary_graph(data: bytes, project: Path) -> Result[None, str]:
    """A published graph starts with the version-one header and never contains the physical project root."""
    if data[:4] != b"\x01\x00\x00\x00":
        return Err("compiled Loaf has no version-one binary graph")
    needle = project.0.encode("utf-8")
    for offset in range(len(data) - len(needle) + 1):
        if data[offset:offset + len(needle)] == needle:
            return Err("compiled Loaf graph contains a physical project root")
    return Ok(None)


def published_graphs(project: Path, provider: Path) -> list[Path]:
    """Find the consumer and provider copies so corruption cannot fall through to an intact publication."""
    mut graphs: list[Path] = []
    for root in [project, provider]:
        directory = root.joinpath("target").joinpath("incan").joinpath("loaves").joinpath("graph_checked")
        graph = directory.joinpath("debug").joinpath("graph_checked.incngraph")
        if graph.is_file():
            graphs.append(graph)
    return graphs


def check_rust_links(document: str) -> Result[None, str]:
    """
    Resolved Rust targets and navigable caller owners link to declarations, including dependency methods and closure
    expressions.

    1. Collect the Rust declarations and the crates they belong to.
    2. Every Rust call has a declaration as its owner, and one that resolves into a represented crate has a declaration
       as its target.
    """
    records = items(parse_json(document)?)?
    # 1. The Rust declarations are collected, with the crates they belong to.
    mut declarations: Dict[str, bool] = {}
    mut crates: list[str] = []
    for record in records:
        if string_field(record, "record") != "declaration" or string_field(record, "language") != "rust":
            continue
        declarations[string_field(record, "id")] = true
        stable = required(record, "stable_identity")?
        path = items(required(required(stable, "origin")?, "path")?)?
        if len(path) > 0:
            root = string_of(path[0])?
            if root not in crates:
                crates.append(root)
    # 2. Every Rust call is owned by a declaration, and one resolving into a represented crate targets a declaration.
    for record in records:
        if string_field(record, "record") != "call" or string_field(record, "language") != "rust":
            continue
        owner = string_field(record, "owner_id")
        if owner != "" and owner not in declarations:
            return Err(f"Rust call has no navigable declaration owner: {owner}")
        callee = string_field(record, "callee")
        for root in crates:
            if callee.startswith(f"{root}::") and string_field(record, "target_id") not in declarations:
                return Err(f"resolved Rust call has no declaration in its represented crate: {callee}")
    return Ok(None)
