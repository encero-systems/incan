"""Contract batch scheduling keeps semantic incompatibility separate from elapsed compilation time."""

from rust::std::process import Command
from std.fs import Path
from std.tempfile import TemporaryDirectory
from batch import SHARED_ENTRIES_REFUSED, compilation_refusal, group_compilation_request, run_batches
from files import make_directory, read, write
from fixture import Fixture
from run import Outcome


def test_compatible_batch_compilation_has_no_automatic_deadline() -> None:
    """A valid compatible batch may compile for as long as its caller's explicit deadline permits."""
    request = group_compilation_request("incan", ["build", "/case/src/main.incn"], Path("/case"), 37)
    assert request.deadline_seconds == 0
    assert request.duration_hint == 37
    assert request.selector is None


def test_an_engine_without_shared_entries_is_not_a_semantic_refusal() -> None:
    """
    An engine that cannot select program entries refuses every shared compilation alike, so its refusal says nothing
    about which cases are incompatible and must not be bisected; a compiler's refusal of the cases still is.
    """
    # Oven's refusal since `--interop-target` joined the options the records engine does not implement.
    options = "feature, substitution, program-entry or interop-target options"
    engine = Outcome(stdout="", stderr=f"incan build: unit records do not implement {options}\n", code=Some(1))
    refusal, evidence = compilation_refusal(Ok(engine))
    assert refusal == SHARED_ENTRIES_REFUSED
    assert "program-entry" in evidence
    compiler = Outcome(stdout="", stderr="error[INCAN-T0001]: src/case_3.incn: unknown name\n", code=Some(1))
    refused, diagnostics = compilation_refusal(Ok(compiler))
    assert refused == "combined compilation refused"
    assert "case_3" in diagnostics
    clean, nothing = compilation_refusal(Ok(Outcome(stdout="", stderr="", code=Some(0))))
    assert clean == "" and nothing == ""


def executable(path: Path, text: str) -> Path:
    """Write `text` to `path` and make it executable."""
    write(path, text).unwrap()
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(path.0).status().unwrap().success()
    return path


def warning_incan(scratch: Path) -> Path:
    """
    An `incan` that records each command it runs. A shared build succeeds, warns about its second case and leaves a
    program that prints the case it was started for; a case's own command prints `own command`.
    """
    program = executable(scratch.joinpath("program"), "#!/bin/sh\necho \"case $INCAN_CONTRACT_CASE\"\n")
    mut script = f"#!/bin/sh\nprintf '%s\\n' \"$1\" >> '{scratch.joinpath("commands").0}'\n"
    script += "if [ \"$1\" = build ]; then\n  mkdir -p target/incan/debug/bin\n"
    script += f"  cp '{program.0}' target/incan/debug/bin/contract_batch\n"
    script += "  echo \"warning: $(dirname \"$2\")/case_1.incn:1:1: unused binding\" >&2\n  exit 0\nfi\n"
    script += "echo 'own command'\n"
    return executable(scratch.joinpath("incan"), script)


def behavior_case(root: Path, name: str) -> Fixture:
    """A behavior program `name` that prints its name."""
    path = root.joinpath(f"{name}.incn")
    write(
        path,
        f"# behavior: prints its name\n# expect-stdout:\n#   {name}\n\ndef main() -> None:\n    println(\"{name}\")\n",
    ).unwrap()
    return Fixture(family="behavior", area="area", name=name, shape="file", entry=path, program=path)


def stdout_of(outcomes: dict[str, Result[Outcome, str]], name: str) -> str:
    """What the case `behavior/area/<name>` printed, or why it has no outcome."""
    match outcomes[f"behavior/area/{name}"]:
        Ok(outcome) => return outcome.stdout
        Err(reason) => return reason


def test_a_successful_shared_build_that_warns_is_kept_for_the_cases_it_does_not_name() -> None:
    """
    A shared build that succeeds and prints a warning about one case still built every case's program: the cases the
    warning does not name run from it, and only the named case runs its own command to own the warning.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    fixtures = [behavior_case(root, name) for name in ["a", "b", "c"]]
    incan = warning_incan(scratch.path())
    batch = run_batches(incan.0, scratch.path().joinpath("work"), fixtures, 1)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert len([command for command in commands if command == "build"]) == 1, " ".join(commands)
    assert len([command for command in commands if command == "run"]) == 1, " ".join(commands)
    assert stdout_of(batch.outcomes, "a") == "case 0\n"
    assert stdout_of(batch.outcomes, "b") == "own command\n"
    assert stdout_of(batch.outcomes, "c") == "case 2\n"


def slow_incan(scratch: Path) -> Path:
    """
    An `incan` that records the commands it finishes. The build of the group that starts with case `a` takes two
    seconds and succeeds quietly, any other build refuses its first case, and a case's own command prints
    `own command`.
    """
    program = executable(scratch.joinpath("program"), "#!/bin/sh\necho \"case $INCAN_CONTRACT_CASE\"\n")
    log = scratch.joinpath("commands").0
    mut script = f"#!/bin/sh\nif [ \"$1\" != build ]; then\n  echo run >> '{log}'\n  echo 'own command'\n  exit 0\nfi\n"
    script += f"mkdir -p target/incan/debug/bin\ncp '{program.0}' target/incan/debug/bin/contract_batch\n"
    script += f"case \"$2\" in\n  */batch-behavior-area-a-2/src/main.incn)\n    sleep 2\n    echo 'slow build' >> '{log}'\n"
    script += "    exit 0 ;;\nesac\necho \"error: $(dirname \"$2\")/case_0.incn:1:1: refused\" >&2\nexit 1\n"
    return executable(scratch.joinpath("incan"), script)


def test_a_refused_group_is_retried_while_another_group_still_compiles() -> None:
    """
    The retries a refused shared build calls for start as soon as it is refused: they do not wait for a slower build of
    another group to finish.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    fixtures = [behavior_case(root, name) for name in ["a", "b", "c", "d"]]
    incan = slow_incan(scratch.path())
    batch = run_batches(incan.0, scratch.path().joinpath("work"), fixtures, 2)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert commands == ["run", "run", "slow build"], " ".join(commands)
    assert stdout_of(batch.outcomes, "a") == "case 0\n"
    assert stdout_of(batch.outcomes, "b") == "case 1\n"
    assert stdout_of(batch.outcomes, "c") == "own command\n"
    assert stdout_of(batch.outcomes, "d") == "own command\n"


def queued_incan(scratch: Path) -> Path:
    """
    An `incan` that records the commands it finishes, by case. The build of the group that starts with case `a` takes
    two seconds and succeeds quietly, any other build refuses its first case, and each own command of a case named
    `x...` takes a second.
    """
    program = executable(scratch.joinpath("program"), "#!/bin/sh\necho \"case $INCAN_CONTRACT_CASE\"\n")
    log = scratch.joinpath("commands").0
    mut script = "#!/bin/sh\nif [ \"$1\" != build ]; then\n  case \"$PWD\" in\n    *-x*) sleep 1 ;;\n  esac\n"
    script += f"  echo \"run $(basename \"$PWD\")\" >> '{log}'\n  echo 'own command'\n  exit 0\nfi\n"
    script += f"mkdir -p target/incan/debug/bin\ncp '{program.0}' target/incan/debug/bin/contract_batch\n"
    script += f"case \"$2\" in\n  */batch-behavior-area-a-2/src/main.incn)\n    sleep 2\n    echo 'slow build' >> '{log}'\n"
    script += "    exit 0 ;;\nesac\necho \"error: $(dirname \"$2\")/case_0.incn:1:1: refused\" >&2\nexit 1\n"
    return executable(scratch.joinpath("incan"), script)


def decorated_case(root: Path, name: str) -> Fixture:
    """A behavior program `name` with a decorator, which keeps its own command."""
    path = root.joinpath(f"{name}.incn")
    write(path, f"# behavior: runs alone\n# expect-stdout:\n#   {name}\n\n@inline\ndef main() -> None:\n    pass\n").unwrap()
    return Fixture(family="behavior", area="area", name=name, shape="file", entry=path, program=path)


def test_a_refused_group_is_retried_before_the_commands_queued_behind_it() -> None:
    """
    A refused shared build's retries start before the own commands that were already queued: each retry may unlock a
    group, while a queued own command unlocks nothing.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    mut fixtures = [behavior_case(root, name) for name in ["a", "b", "c", "d"]]
    fixtures.extend([decorated_case(root, name) for name in ["x1", "x2", "x3", "x4"]])
    incan = queued_incan(scratch.path())
    batch = run_batches(incan.0, scratch.path().joinpath("work"), fixtures, 2)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert commands.index("run behavior-area-c") < commands.index("slow build"), ", ".join(commands)
    assert commands.index("run behavior-area-d") < commands.index("slow build"), ", ".join(commands)
    assert stdout_of(batch.outcomes, "a") == "case 0\n"
    assert stdout_of(batch.outcomes, "x4") == "own command\n"


def unnamed_refusal_incan(scratch: Path) -> Path:
    """
    An `incan` that records the size of each group it builds. A build that holds case `e` is refused with an error that
    names no case; any other build succeeds quietly. A case's own command prints `own command`.
    """
    program = executable(scratch.joinpath("program"), "#!/bin/sh\necho \"case $INCAN_CONTRACT_CASE\"\n")
    log = scratch.joinpath("commands").0
    mut script = "#!/bin/sh\nif [ \"$1\" != build ]; then\n  echo 'own command'\n  exit 0\nfi\n"
    script += f"dir=$(dirname \"$2\")\necho \"build $(ls \"$dir\" | grep -c '^case_')\" >> '{log}'\n"
    script += "if grep -q '\"e\"' \"$dir\"/case_*.incn; then\n"
    script += "  echo 'error: invalid governed runtime intrinsic enum owner' >&2\n  exit 1\nfi\n"
    script += f"mkdir -p target/incan/debug/bin\ncp '{program.0}' target/incan/debug/bin/contract_batch\n"
    return executable(scratch.joinpath("incan"), script)


def test_a_group_refused_without_naming_a_case_splits_into_a_job_s_worth_of_parts() -> None:
    """
    A refusal that names no case says nothing about where its cause is, so the group is split at once into as many
    parts as there are jobs, not halved again and again: each part builds beside the others, and only the refused
    part's cases are left to run alone.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    names = ["a", "b", "c", "d", "e", "f", "g", "h"]
    fixtures = [behavior_case(root, name) for name in names]
    work = scratch.path().joinpath("work")
    make_directory(work).unwrap()
    # One partition row holds every case, so the first build is the whole group.
    row = "\t".join([f"behavior/area/{name}" for name in names])
    write(work.joinpath("batch-behavior-groups.tsv"), row + "\n").unwrap()
    incan = unnamed_refusal_incan(scratch.path())
    batch = run_batches(incan.0, work, fixtures, 4)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert commands == ["build 8", "build 2", "build 2", "build 2", "build 2"], ", ".join(commands)
    assert stdout_of(batch.outcomes, "a") == "case 0\n"
    assert stdout_of(batch.outcomes, "e") == "own command\n"
    assert stdout_of(batch.outcomes, "f") == "own command\n"
    assert stdout_of(batch.outcomes, "h") == "case 1\n"


def root_import_incan(scratch: Path) -> Path:
    """
    An `incan` that records the size of each group it builds. Like Oven, a build refuses a module case whose nested
    file imports a module only the case's own source root defines, naming that file; any other build succeeds quietly.
    A case's own command prints `own command`.
    """
    program = executable(scratch.joinpath("program"), "#!/bin/sh\necho \"case $INCAN_CONTRACT_CASE\"\n")
    log = scratch.joinpath("commands").0
    mut script = "#!/bin/sh\nif [ \"$1\" != build ]; then\n  echo 'own command'\n  exit 0\nfi\n"
    script += f"dir=$(dirname \"$2\")\necho \"build $(ls \"$dir\" | grep -c '^case_')\" >> '{log}'\n"
    script += "for case in \"$dir\"/case_*; do\n  if [ -d \"$case/nested\" ]; then\n"
    script += "    echo 'error[INCAN-I0001]: Module `helpers` does not exist' >&2\n"
    script += "    echo \" --> $case/nested/user.incn:1:1\" >&2\n    exit 1\n  fi\ndone\n"
    script += f"mkdir -p target/incan/debug/bin\ncp '{program.0}' target/incan/debug/bin/contract_batch\n"
    return executable(scratch.joinpath("incan"), script)


def nested_import_case(root: Path, name: str) -> Fixture:
    """A behavior module program `name` whose nested module imports a module of the program's source root."""
    directory = root.joinpath(name)
    make_directory(directory.joinpath("nested")).unwrap()
    header = f"# behavior: a nested module imports a root module\n# expect-stdout:\n#   {name}\n\n"
    main = header + "from nested.user import shout\n\n\ndef main() -> None:\n    shout()\n"
    write(directory.joinpath("main.incn"), main).unwrap()
    write(directory.joinpath("helpers.incn"), f"pub def label() -> str:\n    return \"{name}\"\n").unwrap()
    user = "from helpers import label\n\n\npub def shout() -> None:\n    println(label())\n"
    write(directory.joinpath("nested/user.incn"), user).unwrap()
    program = directory.joinpath("main.incn")
    return Fixture(family="behavior", area="area", name=name, shape="module", entry=directory, program=program)


def test_a_module_case_whose_nested_import_only_its_root_resolves_keeps_its_own_command() -> None:
    """
    In a group, a module case's sources sit under their own directory, so a nested file's import that only the case's
    source root defines names no module there. The case keeps its own command from admission on instead of costing its
    group a refused build.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    mut fixtures = [behavior_case(root, name) for name in ["a", "b", "c"]]
    fixtures.append(nested_import_case(root, "m"))
    incan = root_import_incan(scratch.path())
    batch = run_batches(incan.0, scratch.path().joinpath("work"), fixtures, 1)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert commands == ["build 3"], ", ".join(commands)
    assert stdout_of(batch.outcomes, "a") == "case 0\n"
    assert stdout_of(batch.outcomes, "m") == "own command\n"


def test_a_large_family_starts_from_groups_of_at_most_seventeen_cases() -> None:
    """
    A group's build takes longer per case the more cases it holds, and the longest first build bounds the family, so a
    family with more cases than its jobs' groups of seventeen can hold starts from balanced groups of at most seventeen.
    """
    scratch = TemporaryDirectory.try_new().unwrap()
    root = scratch.path().joinpath("fixtures")
    make_directory(root).unwrap()
    # The fake refuses only a build holding case `e`, which these names leave out: every build succeeds quietly.
    fixtures = [behavior_case(root, f"c{index}") for index in range(30)]
    incan = unnamed_refusal_incan(scratch.path())
    batch = run_batches(incan.0, scratch.path().joinpath("work"), fixtures, 1)
    commands = read(scratch.path().joinpath("commands")).unwrap().strip().split("\n")
    assert commands == ["build 15", "build 15"], ", ".join(commands)
    assert stdout_of(batch.outcomes, "c0") == "case 0\n"
    assert stdout_of(batch.outcomes, "c29") == "case 14\n"
