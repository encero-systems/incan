"""Compile compatible program cases together, bisecting refusals down to isolated cases."""

from std.fs import Path
from families import command, read_program
from files import make_directory, read, write
from fixture import Fixture, fixture_files, materialize, materialize_files
from group_hints import retain_hint
from run import Outcome, clear_trace, trace_file, unit_notes
from workers import Invocation, invoke_many


# The largest partition file read back; a bigger one is discarded and discovered again.
const MAX_PLAN_BYTES: int = 2_000_000

# An expensive shared attempt can split without limiting any case's original command.
const GROUP_COMPILATION_SECONDS: int = 5


model Entry:
    """A program whose canonical entry can be selected without moving entry setup."""

    fixture: Fixture
    source: str


model GroupProject:
    """Selected entries and their materialized shared project, prepared or successfully compiled."""

    entries: list[Entry]
    project: Path


pub model BatchOutcomes:
    """Fresh per-case results and the shared compilation work Oven actually reported."""

    pub outcomes: dict[str, Result[Outcome, str]]
    pub notes: list[str]


pub def run_batches(
    incan: str,
    scratch: Path,
    fixtures: list[Fixture],
    jobs: int,
    hint: Option[Path] = None,
) -> BatchOutcomes:
    """
    Use optional case-name partition hints while Oven validates current group inputs; absent cases keep isolation.

    1. Admit the cases whose entry can be compiled together with others; the rest keep their own command.
    2. Partition them into groups: this scratch's previous partition, or a full-family hint, or one group to discover
       the partition from.
    3. Compile groups and run their verified entries in one pool, refining refusals before splitting them.
    4. Retain the partition for the next run.
    """
    # 1. Only the cases whose entry can be compiled together with others are shared; the rest keep their own command.
    entries, refusals = admitted_entries(fixtures)
    # 2. The groups come from this scratch's previous partition or a family hint, else one group to learn them from.
    mut groups: list[list[Entry]] = [entries]
    mut overlapping: list[Fixture] = []
    mut plan = scratch.joinpath("batch-empty-groups.tsv")
    if len(fixtures) > 0:
        family = fixtures[0].family
        report_refusals(scratch, family, refusals)
        plan = scratch.joinpath(f"batch-{family}-groups.tsv")
        groups, reused = load_groups(plan, hint, entries)
        if not reused:
            groups = initial_groups(entries, jobs)
        overlapping = isolated_fixtures(fixtures, groups)
    # 3. Compile groups and run verified entries while refusals refine the next compilation wave.
    mut notes: list[str] = []
    mut partition: list[str] = []
    mut built: list[GroupProject] = []
    mut outcomes: dict[str, Result[Outcome, str]] = {}
    compile_groups(incan, scratch, groups, built, notes, partition, overlapping, outcomes, jobs)
    # 4. Retain the partition whose entries ran fresh in the owning pool.
    for group in built:
        partition.append("\t".join([candidate.fixture.case_name() for candidate in group.entries]))
    if len(entries) > 0:
        match write(plan, "\n".join(partition) + "\n"):
            Err(error) => println(f"batch plan: {error}")
            Ok(_) => pass
        retain_hint(hint, partition)
    return BatchOutcomes(outcomes=outcomes, notes=notes)


def admitted_entries(fixtures: list[Fixture]) -> tuple[list[Entry], list[str]]:
    """The cases that can be compiled together, and for each of the others a line saying why it cannot."""
    mut entries: list[Entry] = []
    mut refusals: list[str] = []
    for fixture in fixtures:
        match entry(fixture):
            Err(reason) => refusals.append(f"{fixture.case_name()}\t{reason}")
            Ok(candidate) => entries.append(candidate)
    return (entries, refusals)


def report_refusals(scratch: Path, family: str, refusals: list[str]) -> None:
    """Write the cases that keep their own command, with their reasons, to the scratch directory."""
    # A scratch that cannot be created fails the write below, which reports it.
    _ = make_directory(scratch)
    match write(scratch.joinpath(f"batch-{family}-refusals.tsv"), "\n".join(refusals) + "\n"):
        Err(error) => println(f"batch report: {error}")
        Ok(_) => pass


def isolated_fixtures(fixtures: list[Fixture], groups: list[list[Entry]]) -> list[Fixture]:
    """Select original commands outside retained shared groups; hinted singletons still execute afresh."""
    mut shared: set[str] = set()
    for group in groups:
        if len(group) > 1:
            for candidate in group:
                shared.add(candidate.fixture.case_name())
    return [
        fixture for fixture in fixtures
        if fixture.case_name() not in shared and fixture.family not in ["format", "graph"]
    ]


def load_groups(plan: Path, hint: Option[Path], entries: list[Entry]) -> tuple[list[list[Entry]], bool]:
    """Prefer this scratch's partition, then a full-family hint; missing or unusable rows trigger discovery."""
    groups, reused = planned_groups(plan, entries)
    if reused:
        return (groups, true)
    match hint:
        None => pass
        Some(path) =>
            hinted, usable = planned_groups(path, entries)
            if usable:
                println(f"BATCH-HINT candidates={len(entries)} partitions={len(hinted)}")
                return (hinted, true)
    return (groups, false)


def initial_groups(entries: list[Entry], jobs: int) -> list[list[Entry]]:
    """Start discovery with balanced optimistic groups so one refused giant compilation cannot serialize workers."""
    mut groups: list[list[Entry]] = []
    width = max([1, (len(entries) + max([1, jobs]) - 1) // max([1, jobs])])
    mut offset = 0
    while offset < len(entries):
        groups.append(entries[offset:min([offset + width, len(entries)])])
        offset += width
    return groups


def planned_groups(plan: Path, entries: list[Entry]) -> tuple[list[list[Entry]], bool]:
    """
    Keep previous compilation boundaries, never outcomes; Oven still validates every group's current inputs.

    1. Each row of the plan names the cases of one group; a case belongs to the first row that names it.
    2. The cases no row names form one group more.
    3. The partition is reusable when any case was named.
    """
    mut groups: list[list[Entry]] = []
    mut assigned: set[str] = set()
    # 1. Each row of the plan is one group, and a case belongs to the first row that names it.
    for line in plan_rows(plan):
        mut group: list[Entry] = []
        names = line.split("\t")
        for candidate in entries:
            name = candidate.fixture.case_name()
            if name in names and name not in assigned:
                group.append(candidate)
                assigned.add(name)
        if len(group) > 0:
            groups.append(group)
    # 2. The cases no row names form one group more, so none is left out.
    remaining = [candidate for candidate in entries if candidate.fixture.case_name() not in assigned]
    if len(remaining) > 0:
        groups.append(remaining)
    # 3. The partition is reusable only when some row named a case.
    return (groups, len(assigned) > 0)


def plan_rows(plan: Path) -> list[str]:
    """The rows of a partition file; a missing, unreadable or oversized one has none."""
    if not plan.is_file():
        return []
    match read(plan):
        Err(_) => return []
        Ok(text) =>
            if len(text) < MAX_PLAN_BYTES:
                return text.split("\n")
            return []


def entry(fixture: Fixture) -> Result[Entry, str]:
    """Keep context-observing cases and unproven entry semantics on the canonical isolated path."""
    if fixture.family not in ["behavior", "interop"] or fixture.shape == "project":
        return Err("this family or project shape keeps its original command")
    program = read_program(fixture)?
    if program.header.accepted or len(program.header.diagnostics) > 0:
        return Err("check-only cases keep their own diagnostic context")
    admit_source(program.source)?
    if fixture.shape == "module":
        for relative in fixture_files(fixture)?.keys():
            if relative.startswith("src/") and relative.endswith(".incn"):
                admit_source(read(fixture.entry.joinpath(relative[4:]))?)?
    return Ok(Entry(fixture=fixture, source=program.source))


def admit_source(source: str) -> Result[None, str]:
    """Refuse context observations and unproven initialization effects anywhere in a module case."""
    if "__file__" in source or "current_exe" in source or "import this" in source:
        return Err("source paths, executable identity and entry effects require isolated compilation")
    if "static " in source:
        return Err("computed-static failure precedes canonical main's panic-hook initialization")
    for line in source.split("\n"):
        if line.startswith("@"):
            return Err("decorator initialization has not been proven equivalent before entry setup")
    return Ok(None)


pub def run_separate(
    incan: str,
    scratch: Path,
    fixtures: list[Fixture],
    mut outcomes: dict[str, Result[Outcome, str]],
    jobs: int,
) -> None:
    """Run check-only, project, library and unbatchable cases under the same worker budget."""
    mut requests: list[Invocation] = []
    mut names: list[str] = []
    for fixture in fixtures:
        if fixture.case_name() in outcomes or fixture.family in ["format", "graph"]:
            continue
        match isolated_request(incan, scratch, fixture):
            Err(_) =>
                continue
            Ok(request) =>
                requests.append(request)
                names.append(fixture.case_name())
    results = invoke_many(requests, jobs)
    for index in range(len(requests)):
        outcomes[names[index]] = results[index]


def isolated_request(incan: str, scratch: Path, fixture: Fixture) -> Result[Invocation, str]:
    """Prepare the original command without changing its manifest, entry point or expectations."""
    program = read_program(fixture)?
    project = materialize(fixture, scratch)?
    clear_trace(project)?
    return Ok(Invocation(program=incan, arguments=command(fixture, program.header), project=project, selector=None))


def compile_groups(
    incan: str,
    scratch: Path,
    groups: list[list[Entry]],
    mut built: list[GroupProject],
    mut notes: list[str],
    mut partition: list[str],
    separate: list[Fixture],
    mut outcomes: dict[str, Result[Outcome, str]],
    jobs: int,
) -> None:
    """
    Compile each partition wave through the same child budget used for fresh execution and isolated commands.

    1. Retain singleton names and prepare each shared compilation.
    2. Queue original commands alongside shared compilation waves, including newly isolated cases.
    3. Run builds and their verified entries under one child budget, recording original results once.
    4. Retain successful builds and refine refused groups for the next wave.
    """
    mut pending = groups
    mut isolated = separate
    while len(pending) > 0 or len(isolated) > 0:
        mut requests: list[Invocation] = []
        mut attempts: list[GroupProject] = []
        mut retry: list[list[Entry]] = []
        # 1. Singletons keep their own command; every shared group contributes one compilation request.
        mut queued = set([fixture.case_name() for fixture in isolated])
        for entries in pending:
            if len(entries) < 2:
                if len(entries) == 1:
                    partition.append(entries[0].fixture.case_name())
                    name = entries[0].fixture.case_name()
                    if name not in outcomes and name not in queued:
                        isolated.append(entries[0].fixture)
                        queued.add(name)
                continue
            match prepare_group(scratch, entries):
                Err(_) => split_group(entries, retry, "combined preparation failed")
                Ok(group) =>
                    requests.append(Invocation(
                        program=incan,
                        arguments=group_arguments("build", group.project, entries),
                        project=group.project,
                        selector=None,
                        deadline_seconds=GROUP_COMPILATION_SECONDS,
                    ))
                    attempts.append(group)
        # 2. Retained original commands join the first wave under the same budget.
        mut names: list[str] = []
        for fixture in isolated:
            match isolated_request(incan, scratch, fixture):
                Err(_) => pass
                Ok(request) =>
                    requests.append(request)
                    names.append(fixture.case_name())
        isolated = []
        # 3. Queue gated entries alongside builds and record original commands once.
        mut executions: list[tuple[int, list[str]]] = []
        for parent in range(len(attempts)):
            first = len(requests)
            selected = queue_entries(incan, scratch, attempts[parent], parent, requests)
            executions.append((first, selected))
        results = invoke_many(requests, jobs)
        for index in range(len(names)):
            outcomes[names[index]] = results[len(attempts) + index]
        # 4. Only clean compilations are shared; refusal diagnostics guide another attempt.
        for index in range(len(attempts)):
            group = attempts[index]
            for note in unit_notes(trace_file(group.project)):
                notes.append(note)
            refusal, evidence = compilation_refusal(results[index])
            if refusal == "":
                built.append(group)
                first, selected = executions[index]
                for offset in range(len(selected)):
                    outcomes[selected[offset]] = results[first + offset]
            else:
                refine_group(group, retry, refusal, evidence)
        pending = retry


def compilation_refusal(result: Result[Outcome, str]) -> tuple[str, str]:
    """The refusal and its diagnostic evidence; an empty refusal means compilation succeeded without output."""
    match result:
        Err(_) => return ("combined compilation refused", "")
        Ok(outcome) =>
            evidence = outcome.stdout + outcome.stderr
            if "contract invocation timed out" in outcome.stderr:
                return ("combined compilation exceeded its deadline", evidence)
            if outcome.code != Some(0):
                return ("combined compilation refused", evidence)
            if outcome.stdout != "" or outcome.stderr != "":
                return ("compiler output requires isolated attribution", evidence)
            return ("", "")


def refine_group(group: GroupProject, mut retry: list[list[Entry]], refusal: str, evidence: str) -> None:
    """Use diagnostic paths only as partition advice; recompile the remainder and run named cases in isolation."""
    mut named: list[Entry] = []
    mut remaining: list[Entry] = []
    for index in range(len(group.entries)):
        path = group.project.joinpath("src").joinpath(f"case_{index}").0
        if path + ".incn" in evidence or path + "/" in evidence:
            named.append(group.entries[index])
        else:
            remaining.append(group.entries[index])
    if len(named) == 0 or len(remaining) == 0:
        split_group(group.entries, retry, refusal)
        return
    println(
        f"BATCH-REFINE {len(group.entries)} cases: {len(named)} diagnostic owners isolated; {len(remaining)} retried",
    )
    for candidate in named:
        retry.append([candidate])
    retry.append(remaining)


def prepare_group(scratch: Path, entries: list[Entry]) -> Result[GroupProject, str]:
    """Materialize one attempt without starting a child outside the shared worker budget."""
    first = entries[0].fixture
    project = scratch.joinpath(f"batch-{first.family}-{first.area}-{first.name}-{len(entries)}")
    materialize_group(project, entries)?
    clear_trace(project)?
    return Ok(GroupProject(entries=entries, project=project))


def split_group(entries: list[Entry], mut retry: list[list[Entry]], refusal: str) -> None:
    """Retain canonical isolation when preparation, compilation or compiler-output attribution refuses sharing."""
    first = entries[0].fixture.case_name()
    last = entries[-1].fixture.case_name()
    println(f"BATCH-SPLIT {first} .. {last} ({len(entries)} cases): {refusal}; retrying separately")
    middle = len(entries) // 2
    retry.append(entries[0:middle])
    retry.append(entries[middle:])


def queue_entries(
    incan: str, scratch: Path, group: GroupProject, parent: int, mut requests: list[Invocation],
) -> list[str]:
    """Prepare fresh selected executions gated on their group's successful build in the owning worker pool."""
    mut names: list[str] = []
    executable = built_program(group.project, "contract_batch")
    for index in range(len(group.entries)):
        fixture = group.entries[index].fixture
        match materialize(fixture, scratch):
            Err(_) => pass
            Ok(case_project) =>
                match clear_trace(case_project):
                    Err(_) =>
                        continue
                    Ok(_) => pass
                original = built_program(case_project, fixture.name)
                arguments = ["_run-built", executable.0, "--argv0", original.0]
                requests.append(Invocation(
                    program=incan, arguments=arguments, project=case_project,
                    selector=Some(str(index)), after=Some(parent),
                ))
                names.append(fixture.case_name())
    return names


def built_program(project: Path, name: str) -> Path:
    """Where a debug build of a project stores the program `name`."""
    return project.joinpath("target").joinpath("incan").joinpath("debug").joinpath("bin").joinpath(name)


def group_arguments(command: str, project: Path, entries: list[Entry]) -> list[str]:
    """Describe selected entries for a shared build; execution uses its already-verified binary through Oven."""
    mut arguments = [command, project.joinpath("src").joinpath("main.incn").0]
    for index in range(len(entries)):
        mut path = f"src/case_{index}.incn"
        if entries[index].fixture.shape == "module":
            path = f"src/case_{index}/main.incn"
        arguments.extend(["--program-entry", path])
    return arguments


def materialize_group(project: Path, entries: list[Entry]) -> Result[None, str]:
    """
    Keep each program intact; the unit selects its checked main through canonical entry lowering.

    The group's project holds each case as a module of its own, a manifest, and a `main` that imports them all.
    """
    mut files: Dict[str, bytes] = {}
    files["loaf.toml"] = group_manifest().encode("utf-8")
    mut imports = ""
    for index in range(len(entries)):
        candidate = entries[index]
        module = f"case_{index}"
        mut path = f"src/{module}.incn"
        mut import_path = module
        if candidate.fixture.shape == "module":
            original = fixture_files(candidate.fixture)?
            for relative in sorted([relative for relative in original.keys()]):
                if relative.startswith("src/"):
                    files[f"src/{module}/{relative[4:]}"] = original[relative]
            path = f"src/{module}/main.incn"
            import_path = f"{module}.main"
        files[path] = candidate.source.encode("utf-8")
        imports += f"import {import_path} as selected_{index}\n"
    files["src/main.incn"] = group_main(imports).encode("utf-8")
    materialize_files(project, files)?
    return Ok(None)


def group_manifest() -> str:
    """The manifest of a group's project: one program, `src/main.incn`."""
    return "[project]\nname = \"contract_batch\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n"


def group_main(imports: str) -> str:
    """The `src/main.incn` of a group's project: the imports of its cases and an entry the selected entries replace."""
    entry_note = "The unit's selected program entries supply the native process entry."
    return imports + f"\n\ndef main() -> None:\n    \"\"\"{entry_note}\"\"\"\n    pass\n"
