# behavior: an Err test reports failure while later Result tests complete and the command fails (#1530, #2256)
# expect-stdout-contains:
#   test_failure.incn::test_fails FAILED
#   test_failure.incn::test_later PASSED
# expect-stderr-contains:
#   deliberate failure
# expect-exit: 1

"""A failure cannot hide a later collected test."""


def test_fails() -> Result[None, str]:
    """An error return fails this test alone, just as a failed assertion does."""
    return Err("deliberate failure")


def test_later() -> Result[None, str]:
    """The runner must reach this test after the failure."""
    assert true
    result: Result[None, str] = Ok(None)
    result?
    return Ok(None)
