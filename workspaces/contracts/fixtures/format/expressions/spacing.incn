# behavior: Annotations, operators, parameters and strings receive canonical spacing; wrapped builder lists put each element on its own line.
# expect-formatted:
#   const ITEMS: list[int] = [1, 2, 3]
#   const TEXT: str = "hello"
#
#
#   def add(a: int, b: int) -> int:
#       """Add the two parameters."""
#       return a + b
#
#
#   def greet() -> None:
#       """Print two greeting words."""
#       println("hello", "world")
#
#
#   def descriptors() -> None:
#       """Keep each long descriptor on its own list line."""
#       registry
#           .with_descriptors(
#               [
#                   Descriptor.named("query.field").in_declaration_body("query").with_receiver("owning-declaration"),
#                   Descriptor.named("query.pipe").in_declaration_body("query").with_receiver("owning-declaration"),
#               ],
#           )
#           .finish()

const ITEMS:list[int]=[1,2,3]
const TEXT:str='hello'
def add(a:int,b:int)->int:
    """Add the two parameters."""
    return a+b
def greet()->None:
    """Print two greeting words."""
    println('hello','world')
def descriptors()->None:
    """Keep each long descriptor on its own list line."""
    registry.with_descriptors([Descriptor.named("query.field").in_declaration_body("query").with_receiver("owning-declaration"),Descriptor.named("query.pipe").in_declaration_body("query").with_receiver("owning-declaration")]).finish()
