# behavior: A wrapped match scrutinee ends explicitly before its arms start.
# expect-formatted:
#   def choose(value: str) -> int:
#       match (
#           value
#               .strip()
#               .replace("before_first", "after_first")
#               .replace("before_second", "after_second")
#               .replace("before_third", "after_third")
#       ):
#           _ => return 1

def choose(value: str) -> int:
    match value.strip().replace("before_first", "after_first").replace("before_second", "after_second").replace("before_third", "after_third"):
        _ => return 1
