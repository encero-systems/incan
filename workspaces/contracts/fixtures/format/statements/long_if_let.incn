# behavior: A long method chain in an if let header stays parseable through grouping.
# expect-formatted:
#   def present(value: Option[str]) -> bool:
#       if let Some(text) = (
#           value
#               .map((text) => text.strip())
#               .map((text) => text.lower())
#               .map((text) => text.upper())
#               .map((text) => text.strip())
#       ):
#           return true
#       return false

def present(value: Option[str]) -> bool:
    if let Some(text) = value.map((text) => text.strip()).map((text) => text.lower()).map((text) => text.upper()).map((text) => text.strip()):
        return true
    return false
