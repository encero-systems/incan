# behavior: A top-level comment after a two-paragraph docstring keeps both surrounding gaps.
# expect-formatted:
#   def count() -> int:
#       """
#       First paragraph.
#
#       Second paragraph.
#       """
#       return 0
#
#
#   # Section comment
#
#
#   def other() -> int:
#       """Return the value after the separated comment."""
#       return 1

def count() -> int:
    """
    First paragraph.

    Second paragraph.
    """
    return 0


# Section comment


def other() -> int:
    """Return the value after the separated comment."""
    return 1
