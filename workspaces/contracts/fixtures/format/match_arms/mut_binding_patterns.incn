# behavior: a binding pattern written `mut name` keeps its `mut` through formatting, in a constructor, a tuple and an `if let` pattern (RFC 129 writable alias rule 8, #1846).
# expect-formatted:
#   def grow(found: Result[list[int], str]) -> int:
#       """Change the payload a `mut` binding owns."""
#       match found:
#           Ok(mut items) =>
#               items.append(1)
#               return len(items)
#           Err(_) => return 0
#
#
#   def first(pair: tuple[list[int], int]) -> int:
#       """Bind one tuple element writable and one read-only."""
#       match pair:
#           (mut items, extra) =>
#               items.append(extra)
#               return len(items)
#
#
#   def keep(found: Option[list[int]]) -> int:
#       """Bind a writable payload in an `if let`."""
#       if let Some(mut items) = found:
#           items.append(1)
#           return len(items)
#       return 0

def grow(found: Result[list[int], str]) -> int:
    """Change the payload a `mut` binding owns."""
    match found:
        Ok( mut   items ) =>
            items.append(1)
            return len(items)
        Err(_) => return 0

def first(pair: tuple[list[int], int]) -> int:
    """Bind one tuple element writable and one read-only."""
    match pair:
        (mut items,extra) =>
            items.append(extra)
            return len(items)

def keep(found: Option[list[int]]) -> int:
    """Bind a writable payload in an `if let`."""
    if let Some(mut  items) = found:
        items.append(1)
        return len(items)
    return 0
