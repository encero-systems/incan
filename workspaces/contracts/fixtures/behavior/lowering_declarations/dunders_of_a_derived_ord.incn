# behavior: each comparison dunder called on a type that derives Eq or Ord, including payload and nested-payload enums (#2806), a model, an enum, a generic model and a newtype, on a value and on self, is the operator it defines
# expect-stdout:
#   false
#   true
#   false
#   true
#   true
#   false
#   true
#   true
#   true
#   true
#   false

@derive(Eq, Ord)
model Score:
    points: int

    def at_least(self, other: Score) -> bool:
        return self.__ge__(other)


@derive(Eq, Ord)
enum Level:
    Low
    High


@derive(Eq, Ord)
model PackageOrigin:
    scope: str
    name: str


@derive(Eq, Ord)
enum Origin:
    Module
    Package(str)
    Nested(PackageOrigin)


@derive(Eq)
model Source:
    origin: Origin


@derive(Eq, Ord)
model Pair[T]:
    left: T
    right: T


@derive(Eq, Ord)
type Rank = newtype int


def matches_source(source: Source, expected: Origin) -> bool:
    """Compare an enum read through a model field with a parameter."""
    return source.origin == expected


def matches_origin(actual: Origin, expected: Origin) -> bool:
    """Compare two payload-enum parameters without consuming either."""
    return actual == expected


def main() -> None:
    origin = Origin.Module
    assert origin == Origin.Module
    source = Source(origin=Origin.Package("std"))
    assert source == Source(origin=Origin.Package("std"))
    assert matches_source(source, Origin.Package("std"))
    assert matches_origin(Origin.Package("std"), Origin.Package("std"))
    assert Origin.Nested(PackageOrigin(scope="std", name="core")) != Origin.Nested(
        PackageOrigin(scope="app", name="core"),
    )
    assert Origin.Package("app") < Origin.Package("std")
    assert Origin.Package("app") <= Origin.Package("std")
    assert Origin.Package("std") > Origin.Package("app")
    assert Origin.Nested(PackageOrigin(scope="std", name="core")) >= Origin.Package("std")
    a = Score(points=2)
    b = Score(points=3)
    println(a.__ge__(b))
    println(a.__le__(b))
    println(a.__gt__(b))
    println(a.__lt__(b))
    println(a.__ne__(b))
    println(a.__eq__(b))
    println(a.__ge__(b) == (a >= b))
    println(b.at_least(a))
    println(Level.High.__gt__(Level.Low))
    println(Pair(left=1, right=2).__lt__(Pair(left=1, right=3)))
    println(Rank(1).__ge__(Rank(2)))
