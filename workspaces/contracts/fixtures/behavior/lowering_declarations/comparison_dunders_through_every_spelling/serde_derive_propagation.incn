# Former case serde_derive_propagation: deriving Serialize on a model propagates the derive to the enum inside its set field and to its newtype field, so the whole payload serializes

from std.serde.json import Serialize


@derive(Serialize)
model Payload:
    tags: set[Tag]
    id: UserId


@derive(Eq, Hash)
enum Tag:
    A
    B


type UserId = newtype int


pub def main() -> None:
    println(Payload(tags={Tag.A}, id=UserId(7)).to_json())
