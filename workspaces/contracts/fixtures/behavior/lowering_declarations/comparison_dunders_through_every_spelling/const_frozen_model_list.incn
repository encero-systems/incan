# Former case const_frozen_model_list: a const frozen list of model values is measured, passed to a function and stored in a model field

model Ref:
    label: FrozenStr


model Holder:
    refs: FrozenList[Ref]


const refs: FrozenList[Ref] = [Ref(label="a"), Ref(label="b")]


def count(values: FrozenList[Ref]) -> int:
    return len(values)


pub def main() -> None:
    println(len(refs))
    println(count(refs))
    holder = Holder(refs=refs)
    println(len(holder.refs))
