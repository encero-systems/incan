# Former case frozen_collections_display_structurally: frozen list, set and dict values display through the same structural forms as their mutable collection counterparts

const NUMBERS: FrozenList[int] = [1, 2]
const TAGS: FrozenSet[int] = {3}
const VALUES: FrozenDict[str, int] = {"x": 4}


pub def main() -> None:
    println(NUMBERS)
    println(TAGS)
    println(VALUES)
