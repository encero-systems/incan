# behavior: iterating a const frozen list of models with automatic Clone reads each element in order
# expect-stdout:
#   a
#   b

model Ref:
    """A frozen list element with automatic Clone and no Copy derive."""

    label: FrozenStr


const refs: FrozenList[Ref] = [Ref(label="a"), Ref(label="b")]


def main() -> None:
    """Read each model's label in declaration order."""
    for r in refs:
        println(r.label)
