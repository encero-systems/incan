# behavior: iterating a const frozen list of models that do not derive Clone reads each element in order
# pending: the native route iterates a frozen list through a Clone snapshot; a frozen list of models must be borrowed
# expect-stdout:
#   a
#   b

model Ref:
    label: FrozenStr


const refs: FrozenList[Ref] = [Ref(label="a"), Ref(label="b")]


def main() -> None:
    for r in refs:
        println(r.label)
