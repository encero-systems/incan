# behavior: a foreign model's private field remains inaccessible through a list inside a caller type with the same name
# expect-diagnostic: INCAN-T0001

"""Refuse a private field read despite a colliding caller type name."""

from vault import Bag, make


class Vault:
    """A different type cannot borrow the provider's private access rights."""

    def observe(self, bag: Bag) -> None:
        """Attempt to read the provider's private field on an unimported element."""
        for vault in bag.entries:
            println(vault.label)
            println(vault.secret)


def main() -> None:
    """Check the private read through the caller's own type."""
    Vault().observe(make())
