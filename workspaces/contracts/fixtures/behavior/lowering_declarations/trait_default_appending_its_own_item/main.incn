"""Run the program of each former case in order."""

import trait_default_appending_its_own_item
import trait_default_calls_on_self
import trait_default_passes_self_by_value


def main() -> None:
    """Run each former case's program in turn."""
    trait_default_appending_its_own_item.main()
    trait_default_calls_on_self.main()
    trait_default_passes_self_by_value.main()
