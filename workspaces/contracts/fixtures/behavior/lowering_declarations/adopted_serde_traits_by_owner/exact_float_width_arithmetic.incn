# Former case exact_float_width_arithmetic: arithmetic between two f32 values stays f32 for every binary operator, so 0.1 + 0.2 rounds as single precision while the same f64 sum shows the double-precision residue

pub def main() -> None:
    a: f32 = 0.1
    b: f32 = 0.2
    c: f64 = 0.1
    d: f64 = 0.2
    println(f"f32 add {a + b}")
    println(f"f64 add {c + d}")
    x: f32 = 1.2
    y: f32 = 0.1
    println(f"f32 sub {x - y}")
    scale: f32 = 2.5
    println(f"f32 mul {x * y * scale}")
    one: f32 = 1.0
    three: f32 = 3.0
    println(f"f32 div {one / three}")
    wide_one: f64 = 1.0
    wide_three: f64 = 3.0
    println(f"f64 div {wide_one / wide_three}")
    ten: f32 = 10.0
    println(f"f32 floordiv {ten // three}")
    println(f"f32 mod {x % one}")
    base: f32 = 1.1
    two: f32 = 2.0
    println(f"f32 pow {base ** two}")
