"""Run the program of each former case in order."""

import enum_constructor_match
import enum_methods_and_traits
import enums
import for_in_list_enum_equality
import if_let_while_let
import match_statements
import pattern_alternation
import patterns
import trailing_match_expression
import tuple_pattern_bindings


def main() -> None:
    """Run each former case's program in turn."""
    enum_constructor_match.main()
    enum_methods_and_traits.main()
    enums.main()
    for_in_list_enum_equality.main()
    if_let_while_let.main()
    match_statements.main()
    pattern_alternation.main()
    patterns.main()
    trailing_match_expression.main()
