"""Run the program of each former case in order."""

import isinstance_explicit_builtin_and_aliases
import newtype_union_isinstance
import option_union_payloads


def main() -> None:
    """Run each former case's program in turn."""
    isinstance_explicit_builtin_and_aliases.main()
    newtype_union_isinstance.main()
    option_union_payloads.main()
