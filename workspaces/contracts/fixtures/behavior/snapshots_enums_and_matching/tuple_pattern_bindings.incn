# behavior: tuple patterns retain their element types and clone owned enum bindings nested in optional payloads (#2256)
# expect-stdout:
#   42 hello
#   zero
#   43 HELLO
#   payload
#   payload
#   none

"""Issue #1714: the names a tuple pattern binds are usable, typed as the tuple's elements."""


enum Choice:
    """Keep an owned non-Copy payload inside a tuple pattern."""

    Text(str)


def selected(value: Option[tuple[Choice, int]]) -> Choice:
    """Return the nested enum binding while retaining its matched tuple's storage."""
    match value:
        Some((choice, _number)) => return choice
        None => return Choice.Text("none")


def show(choice: Choice) -> None:
    """Observe the enum's owned text without relying on an additional formatter."""
    match choice:
        Choice.Text(word) => println(word)


def describe(pair: tuple[int, str]) -> str:
    """Bind both items and use them with their element types."""
    match pair:
        (0, _) => return "zero"
        (number, word) => return f"{number + 1} {word.upper()}"


def main() -> None:
    """The issue's program, then the same bindings through a function parameter."""
    pair: tuple[int, str] = (42, "hello")
    match pair:
        (0, _) => println("zero")
        (number, word) => println(f"{number} {word}")
    zero: tuple[int, str] = (0, "zero")
    println(describe(zero))
    println(describe(pair))
    value: Option[tuple[Choice, int]] = Some((Choice.Text("payload"), 7))
    show(selected(value))
    show(selected(value))
    absent: Option[tuple[Choice, int]] = None
    show(selected(absent))
