# behavior: Deque[str] keeps appended str literals and applies constructor owner arguments once (#1494, #2256)
# expect-stdout:
#   3
#   default
#   1
#   fresh

from std.collections import Deque


pub def probe(requested: list[str]) -> Deque[str]:
    mut pending = Deque[str].from_iter(requested)
    pending.append("default")
    return pending


def main() -> None:
    pending = probe(["a", "b"])
    println(len(pending))
    println(pending.to_list()[2])
    mut empty = Deque[str]()
    empty.append("fresh")
    println(len(empty))
    println(empty.to_list()[0])
