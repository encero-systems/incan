# behavior: primitive buffers provide bounded owned-byte reads, std.io preserves shared declarations, and a BytesIO reader streams into SHA-256
# expect-stdout:
#   4
#   true
#   true
#   unexpected_eof
#   no source
#   32
#   true
#   true
#   true
#   2
#   true
#   1
#   3
#   true
#   true
#   true
#   5
#   true
#   invalid_input
#   invalid_input
#   2
#   3
#   true
#   true
#   true
#   true
#   truncated
#   limit_exceeded

from std.io import BytesIO, Endian as StreamEndian
from std.hash import reader_digest
from std.primitives.io import ByteReader, Endian as PrimitiveEndian, IoError as PrimitiveIoError, WriteBuffer, advance_cursor, read_cursor, read_slice_len, remaining_bytes
from std.traits.error import Error


pub def oven_bytes() -> bytes:
    return BytesIO(b"oven").getvalue()


def show_error_kind() -> None:
    match BytesIO(b"AB").read_exact(4):
        Ok(data) => println(len(data))
        Err(error) =>
            println(error.kind)
            match error.source():
                Some(source) => println(source)
                None => println("no source")


def is_little_endian(value: PrimitiveEndian) -> bool:
    return value == PrimitiveEndian.Little


def error_kind(error: PrimitiveIoError) -> str:
    return error.kind


def show_write_buffer() -> Result[None, PrimitiveIoError]:
    mut buffer = WriteBuffer.from_bytes(b"abcd")
    println(buffer.read(2)? == b"ab")
    println(buffer.write(b"XY")?)
    println(buffer.snapshot() == b"abXY")
    println(buffer.seek(1)?)
    println(buffer.truncate(3)?)
    snapshot = buffer.snapshot()
    buffer.seek(0)?
    buffer.write(b"Z")?
    println(snapshot == b"abX")
    println(buffer.snapshot() == b"ZbX")
    println(is_little_endian(StreamEndian.Little))
    println(buffer.truncate(5)?)
    println(buffer.snapshot() == b"ZbX\x00\x00")
    match buffer.seek(0, 3):
        Ok(position) => println(position)
        Err(error) => println(error.kind)
    match buffer.truncate(Some(-1)):
        Ok(size) => println(size)
        Err(error) => println(error.kind)
    return Ok(None)


def show_independent_read_cursors() -> None:
    """Advance two cursors independently while their unread byte slices borrow the same source."""
    data = b"abcd"
    mut first = read_cursor(data)
    mut second = read_cursor(data)
    advance_cursor(first)
    advance_cursor(first)
    advance_cursor(second)
    mut first_remaining = remaining_bytes(first)
    mut second_remaining = remaining_bytes(second)
    println(read_slice_len(first_remaining))
    println(read_slice_len(second_remaining))


def show_owned_byte_reads() -> None:
    """Read scalars and a bounded length-prefixed payload without indexing beyond the owned bytes."""
    mut reader = ByteReader.from_bytes(b"\x01\x02\x03\x04\x05\x06\x07\x08\x03\x00\x00\x00\x00\x00\x00\x00abc")
    println(reader.read_u16_le() == Some(513u16))
    reader = ByteReader.from_bytes(b"\x01\x02\x03\x04")
    println(reader.read_u32_le() == Some(67305985u32))
    reader = ByteReader.from_bytes(b"\x01\x02\x03\x04\x05\x06\x07\x08")
    println(reader.read_u64_le() == Some(578437695752307201u64))
    reader = ByteReader.from_bytes(b"\x03\x00\x00\x00\x00\x00\x00\x00abc")
    match reader.read_length_prefixed(3):
        Ok(payload) => println(payload == b"abc")
        Err(error) => println(error.kind)
    reader = ByteReader.from_bytes(b"\x04\x00\x00\x00\x00\x00\x00\x00abc")
    match reader.read_length_prefixed(4):
        Ok(payload) => println(len(payload))
        Err(error) => println(error.kind)
    reader = ByteReader.from_bytes(b"\x04\x00\x00\x00\x00\x00\x00\x00abcd")
    match reader.read_length_prefixed(3):
        Ok(payload) => println(len(payload))
        Err(error) => println(error.kind)


def main() -> None:
    println(len(oven_bytes()))
    println(oven_bytes() == b"oven")
    match BytesIO(b"oven").read(2):
        Ok(head) => println(head == b"ov")
        Err(error) => println(error.kind)
    show_error_kind()
    match reader_digest(BytesIO(b"oven"), "sha256", chunk_size=4):
        Ok(digest) =>
            println(len(digest))
            match reader_digest(BytesIO(b"oven"), "sha256", chunk_size=1):
                Ok(again) => println(digest == again)
                Err(error) => println(error.message())
        Err(error) => println(error.message())
    match BytesIO(b"A").read_exact(2):
        Ok(value) => println(len(value))
        Err(error) => println(error_kind(error) == "unexpected_eof")
    match show_write_buffer():
        Ok(_) => pass
        Err(error) => println(error.message())
    show_independent_read_cursors()
    show_owned_byte_reads()
