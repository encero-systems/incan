# Former case empty_list_uses_expected_constructor_argument: a bare generic constructor returned from a generic method types its empty list field with the method's result argument

class Cursor[T with Clone]:
    pub items: list[T]

    pub def select[U with Clone](self, value: U) -> Cursor[U]:
        return Cursor(items=[])


pub def main() -> None:
    cursor = Cursor[int](items=[1])
    selected = cursor.select[str]("picked")
    println(len(selected.items))
