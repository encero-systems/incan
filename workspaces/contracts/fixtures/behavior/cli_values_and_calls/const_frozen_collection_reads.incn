# behavior: frozen dictionaries support borrowed text probes; frozen list comprehensions yield owned text
# expect-stdout:
#   2
#   true
#   alpha beta
#   false
#   ALPHA
#   2
#   9
#   ex
#   ex
#   2
#   true
#   false

"""Observe frozen reads, text comprehension results and computed borrowed dictionary probes."""

const TABLE: FrozenDict[str, FrozenList[str]] = {"names": ["alpha", "beta"], "empty": []}
const NAMES: FrozenList[str] = ["alpha", "beta"]
const CODES: FrozenDict[FrozenStr, int] = {"a": 1, "b": 2}
const SQUARES: FrozenDict[int, int] = {2: 4, 3: 9}
const LABELS: FrozenDict[str, str] = {"x": "ex"}


def main() -> None:
    """Read nested frozen values and then check a computed text probe without consuming the dictionary."""
    # 1. Retain nested collections and owned text values from the original frozen declarations.
    names = TABLE["names"]
    println(len(names))
    println(TABLE.contains_key("names"))
    println(" ".join([name for name in NAMES]))
    key = "missing"
    println(TABLE.contains_key(key))
    println(", ".join([name.upper() for name in NAMES if name != "beta"]))
    println(CODES["b"])
    println(SQUARES[3])
    println(LABELS["x"])
    label: str = LABELS["x"]
    println(label)
    # 2. A computed string probes FrozenStr storage through exact borrowed text identity.
    dynamic_key = "".join(["b"])
    println(CODES[dynamic_key])
    println(CODES.contains_key(dynamic_key))
    println(CODES.contains_key("missing"))
