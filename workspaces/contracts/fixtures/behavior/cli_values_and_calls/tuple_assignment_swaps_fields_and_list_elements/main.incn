"""Run the program of each former case in order."""

import tuple_assignment_swaps_fields_and_list_elements
import tuple_assignment_takes_a_bare_tuple_value
import tuple_unpacking_reassigns_names_inside_a_loop


def main() -> None:
    """Run each former case's program in turn."""
    tuple_assignment_swaps_fields_and_list_elements.main()
    tuple_assignment_takes_a_bare_tuple_value.main()
    tuple_unpacking_reassigns_names_inside_a_loop.main()
