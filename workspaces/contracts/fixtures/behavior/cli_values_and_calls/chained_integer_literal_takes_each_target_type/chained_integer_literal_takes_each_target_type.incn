# Former case chained_integer_literal_takes_each_target_type: a chained assignment of an integer literal over an int binding and a float or f32 binding stores the integer in the int binding and the float in the float binding, whichever target comes last, under a negation, inside list and dict literals, and for a name the chain declares

pub def main() -> None:
    mut n: int = 0
    mut f: float = 0.5
    n = f = 1
    println(n)
    println(f)
    f = n = -2
    println(n)
    println(f)
    mut g: f32 = 0.5
    g = n = 3
    println(n)
    println(g + 0.5)
    mut ints: list[int] = []
    mut floats: list[float] = []
    ints = floats = [4, -4]
    println(ints[0])
    println(floats[1])
    mut counts: dict[str, int] = {}
    mut weights: dict[str, float] = {}
    counts = weights = {"a": 5}
    println(weights["a"])
    x = n = f = 6
    println(x + n)
