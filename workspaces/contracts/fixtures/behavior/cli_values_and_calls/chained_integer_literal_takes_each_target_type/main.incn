"""Run the program of each former case in order."""

import chained_integer_literal_takes_each_target_type
import channel_constructors_with_an_explicit_element_type
import collection_copies_leave_their_source
import compound_assignment_keeps_operator_result_type
import display_positions_render_collections_alike
import empty_list_assigned_to_optional_binding_is_wrapped
import exact_width_integer_arithmetic_keeps_its_type
import expected_literal_followups
import generator_mut_parameter_advanced_by_the_callee
import int_spellings_are_one_type


async def main() -> None:
    """Run each former case's program in turn."""
    chained_integer_literal_takes_each_target_type.main()
    await channel_constructors_with_an_explicit_element_type.main()
    collection_copies_leave_their_source.main()
    compound_assignment_keeps_operator_result_type.main()
    display_positions_render_collections_alike.main()
    empty_list_assigned_to_optional_binding_is_wrapped.main()
    exact_width_integer_arithmetic_keeps_its_type.main()
    expected_literal_followups.main()
    generator_mut_parameter_advanced_by_the_callee.main()
    int_spellings_are_one_type.main()
