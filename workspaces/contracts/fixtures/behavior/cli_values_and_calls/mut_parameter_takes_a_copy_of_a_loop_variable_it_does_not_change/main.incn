"""Run the program of each former case in order."""

import mut_parameter_takes_a_copy_of_a_loop_variable_it_does_not_change
import mutation_ownership_regressions
import numeric_resize_policies_and_decimal
import passing_channel_senders_and_locks_on
import passing_each_task_handle_of_a_list_on
import power_with_literal_base
import set_constructor_over_generator
import trait_default_method_mutable_parameter
import trait_mut_scalar_parameter_is_a_local_copy
import tuple_assignment_declares_a_name_beside_a_place


async def main() -> None:
    """Run each former case's program in turn."""
    mut_parameter_takes_a_copy_of_a_loop_variable_it_does_not_change.main()
    mutation_ownership_regressions.main()
    numeric_resize_policies_and_decimal.main()
    await passing_channel_senders_and_locks_on.main()
    await passing_each_task_handle_of_a_list_on.main()
    power_with_literal_base.main()
    set_constructor_over_generator.main()
    trait_default_method_mutable_parameter.main()
    trait_mut_scalar_parameter_is_a_local_copy.main()
    tuple_assignment_declares_a_name_beside_a_place.main()
