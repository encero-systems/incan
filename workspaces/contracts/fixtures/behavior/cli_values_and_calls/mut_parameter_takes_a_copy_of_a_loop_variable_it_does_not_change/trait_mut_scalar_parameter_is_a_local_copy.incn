# Former case trait_mut_scalar_parameter_is_a_local_copy: a `mut` scalar parameter of a trait method, abstract or with a default body and also through a type alias, is the method's own copy: the method changes it and prints the changed value, and the caller's value is unchanged

type Count = int


trait Stepper:
    def step(self, mut n: Count) -> int

    def bumped(self, mut x: float) -> float:
        x += 1.0
        return x


class Walker with Stepper:
    def step(self, mut n: Count) -> int:
        n += 2
        return n


pub def main() -> None:
    walker = Walker()
    count: Count = 1
    ratio = 1.5
    println(walker.step(count))
    println(walker.bumped(ratio))
    println(count)
    println(ratio)
