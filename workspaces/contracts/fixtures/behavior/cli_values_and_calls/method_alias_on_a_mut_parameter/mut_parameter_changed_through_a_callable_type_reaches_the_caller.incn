# Former case mut_parameter_changed_through_a_callable_type_reaches_the_caller: a mut class parameter changed by a function called through a local bound to it, a callable-typed parameter or an annotated callable local changes the caller's mut binding

class Counter:
    pub value: int


def grow(mut counter: Counter) -> int:
    counter.value += 1
    return counter.value


def apply(step: (mut Counter) -> int, mut counter: Counter) -> int:
    return step(counter)


pub def main() -> None:
    mut counter = Counter(value=1)
    g = grow
    println(g(counter))
    println(apply(grow, counter))
    handler: (mut Counter) -> int = grow
    println(handler(counter))
    println(counter.value)
