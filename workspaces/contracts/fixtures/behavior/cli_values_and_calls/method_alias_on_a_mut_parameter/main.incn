"""Run the program of each former case in order."""

import method_alias_on_a_mut_parameter
import mut_local_changed_through_a_pattern_binding
import mut_parameter_changed_through_a_callable_type_reaches_the_caller
import mut_parameter_changed_through_a_loop_variable_reaches_the_caller
import mut_parameter_changed_through_a_pattern_binding
import mut_parameter_of_a_scalar_alias
import mut_parameter_read_through_a_pattern_or_a_trait_method


def main() -> None:
    """Run each former case's program in turn."""
    method_alias_on_a_mut_parameter.main()
    mut_local_changed_through_a_pattern_binding.main()
    mut_parameter_changed_through_a_callable_type_reaches_the_caller.main()
    mut_parameter_changed_through_a_loop_variable_reaches_the_caller.main()
    mut_parameter_changed_through_a_pattern_binding.main()
    mut_parameter_of_a_scalar_alias.main()
    mut_parameter_read_through_a_pattern_or_a_trait_method.main()
