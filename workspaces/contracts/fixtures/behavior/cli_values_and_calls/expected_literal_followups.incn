# behavior: nested Option arguments and None payloads keep every layer, a str field assignment stores owned text, an Option list element can call unwrap_or, and an Error adopter displays its message through a generic Display bound
# expect-stdout:
#   5
#   0
#   y
#   1
#   bad
#   bad

from std.traits.error import Error


model Box:
    label: str


model Failure with Error:
    detail: str

    def message(self) -> str:
        return self.detail


def nested(value: Option[Option[int]]) -> int:
    return value.unwrap().unwrap_or(0)


def show[T with Display](value: T) -> str:
    return f"{value}"


def main() -> None:
    println(nested(5))
    value: Option[Option[int]] = Some(None)
    println(value.unwrap_or(None).unwrap_or(0))
    mut box = Box(label="x")
    box.label = "y"
    println(box.label)
    slots: list[Option[int]] = [Some(1)]
    println(slots[0].unwrap_or(0))
    failure = Failure(detail="bad")
    println(show(failure))
    println(failure.message())
