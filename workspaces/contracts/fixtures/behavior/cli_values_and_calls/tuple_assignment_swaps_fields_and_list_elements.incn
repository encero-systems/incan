# behavior: a tuple assignment writes fields and list elements from the values read before the first write, so swapping two fields or two list elements exchanges them, and a field and a name can be assigned together
# expect-stdout:
#   2 1
#   8 7
#   30 10 20
#   5 2

class Grid:
    pub width: int
    pub height: int
    pub cells: list[int]

    def swap_dimensions(mut self) -> None:
        self.width, self.height = (self.height, self.width)

    def swap_cells(mut self) -> None:
        self.cells[0], self.cells[1] = (self.cells[1], self.cells[0])


def main() -> None:
    mut grid = Grid(width=1, height=2, cells=[7, 8])
    grid.swap_dimensions()
    println(f"{grid.width} {grid.height}")
    grid.swap_cells()
    println(f"{grid.cells[0]} {grid.cells[1]}")
    mut items = [10, 20, 30]
    items[0], items[2] = (items[2], items[0])
    items[1], items[2] = (items[2], items[1])
    println(f"{items[0]} {items[1]} {items[2]}")
    mut total = 1
    grid.width, total = (total + 4, grid.width)
    println(f"{grid.width} {total}")
