"""Run the program of each former case in order."""

import annotated_collection_literals
import annotated_tuple_literal_types_its_elements
import awaiting_each_task_handle_of_a_list
import awaiting_task_handles_of_a_call_result_and_a_literal
import awaiting_task_handles_of_nested_and_parenthesized_lists
import bitwise_operators_keep_the_integer_type
import callable_presets_of_constructors_and_declaration_safe_values
import callable_stored_in_a_field_is_called
import capturing_closures_as_result_combinator_callbacks
import integer_literal_assigned_to_float_binding


async def main() -> None:
    """Run each former case's program in turn."""
    annotated_collection_literals.main()
    annotated_tuple_literal_types_its_elements.main()
    await awaiting_each_task_handle_of_a_list.main()
    await awaiting_task_handles_of_a_call_result_and_a_literal.main()
    await awaiting_task_handles_of_nested_and_parenthesized_lists.main()
    bitwise_operators_keep_the_integer_type.main()
    callable_presets_of_constructors_and_declaration_safe_values.main()
    callable_stored_in_a_field_is_called.main()
    capturing_closures_as_result_combinator_callbacks.main()
    integer_literal_assigned_to_float_binding.main()
