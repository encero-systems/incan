# behavior: f64 and float returns preserve parsed infinities, overflowing exponents, finite values and NaN
# expect-stdout:
#   inf
#   -inf
#   inf
#   1.25
#   nan
#   nan


"""Runtime non finite float values flow through f64."""
def exact(value: str) -> f64:
  """Return the fixture expression `float(value)`."""
  return float(value)

def ordinary(value: str) -> float:
  """Return the fixture expression `float(value)`."""
  return float(value)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(exact("inf"))
    println(exact("-inf"))
    println(exact("1e9999"))
    println(exact("1.25"))
    println(exact("NaN"))
    println(ordinary("NaN"))
