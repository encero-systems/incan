# behavior: float parameter defaults apply when omitted and str renders explicit and default arguments inside a returned f-string
# expect-stdout:
#   1.5
#   3.14 1.5
#   3.14 1.5

"""A float parameter default applies when the argument is omitted, and str() renders both the passed and the default value."""
def render(value: float = 1.5) -> str:
    """Return the fixture expression `str(value)`."""
    return str(value)


def both() -> str:
    """Return the fixture expression `f"{render(3.14)} {render()}"`."""
    return f"{render(3.14)} {render()}"


def main() -> None:
    """Print the fixture values in the expected order."""
    println(render())
    println(both())
    println(both())
