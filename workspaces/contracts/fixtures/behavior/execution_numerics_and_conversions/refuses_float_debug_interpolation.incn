# behavior: refuses float debug interpolation
# expect-stdout:
#   1.5


"""Refuses float debug interpolation."""
def program_result() -> str:
  """Compute and return `f"{value:?}"`."""
  value: float = 1.5
  return f"{value:?}"


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
