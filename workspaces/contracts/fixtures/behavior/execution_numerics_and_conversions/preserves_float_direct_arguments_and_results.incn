# behavior: preserves float direct arguments and results
# expect-stdout:
#   argument ran
#   1.5


"""Preserves float direct arguments and results."""
def show(value: float) -> str:
  """Print the call marker and render the float argument."""
  println("argument ran")
  return str(value)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(show(1.5))
