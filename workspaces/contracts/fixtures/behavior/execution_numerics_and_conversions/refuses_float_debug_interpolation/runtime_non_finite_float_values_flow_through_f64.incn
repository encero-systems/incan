# Former case runtime_non_finite_float_values_flow_through_f64: f64 and float returns preserve parsed infinities, overflowing exponents, finite values and NaN

"""Runtime non finite float values flow through f64."""
def exact(value: str) -> f64:
  """Return the fixture expression `float(value)`."""
  return float(value)

def ordinary(value: str) -> float:
  """Return the fixture expression `float(value)`."""
  return float(value)


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(exact("inf"))
    println(exact("-inf"))
    println(exact("1e9999"))
    println(exact("1.25"))
    println(exact("NaN"))
    println(ordinary("NaN"))
