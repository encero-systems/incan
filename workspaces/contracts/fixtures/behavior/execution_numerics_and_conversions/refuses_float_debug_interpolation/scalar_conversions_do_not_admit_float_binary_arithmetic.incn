# Former case scalar_conversions_do_not_admit_float_binary_arithmetic: scalar conversions do not admit float binary arithmetic

"""Scalar conversions do not admit float binary arithmetic."""
def program_result() -> float:
    """Return the fixture expression `float("1") + float("2")`."""
    return float("1") + float("2")


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
