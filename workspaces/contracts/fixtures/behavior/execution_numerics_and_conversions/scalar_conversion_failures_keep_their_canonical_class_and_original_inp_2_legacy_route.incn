# behavior: scalar conversion failures keep their canonical class and original input
# expect-stdout:
#   before conversion
# expect-exit: 101
# expect-stderr-contains:
#   ValueError: cannot convert 'AssertionError overflow division by zero' to float

"""Scalar conversion failures keep their canonical class and original input."""
def parse(value: str) -> str:
    """Print the conversion marker and attempt to parse the supplied text."""
    println("before conversion")
    parsed = float(value)
    return str(parsed)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(parse("AssertionError overflow division by zero"))
