# behavior: typed resizing uses its expected destination or an explicit policy-bearing destination, including int to i32 and u64
# expect-stdout:
#   must-not-print
#   127
#   42
#   Some(42)


"""Resize integers through explicit destination and overflow policies."""
def program_result() -> i8:
    """Clamp a wide integer to the function's declared destination type."""
    println("must-not-print")
    wide: i16 = 240
    return wide.saturating_resize()


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
    value: int = 42
    println(value.wrapping_resize[i32]())
    println(value.try_resize[u64]())
