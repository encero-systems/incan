# behavior: f32 widens to f64 and float with its binary value intact, and u8 widens through a u16 local and parameter
# expect-stdout:
#   1.2345678806304932
#   1.2345678806304932
#   255

"""An f32 widened to f64 or to float takes the exact binary value of the f32, not its decimal spelling."""
def widen_explicit_float(value: f32) -> f64:
    """Widen an f32 value to f64 through a typed local."""
    widened: f64 = value
    return widened


def widen_ordinary_float(value: f32) -> float:
    """Widen an f32 value to the ordinary float type."""
    widened: float = value
    return widened


def accept_wide(value: u16) -> u16:
    """Return the widened unsigned argument."""
    return value


def widen_integer(value: u8) -> u16:
    """Widen through an annotated local and a function argument."""
    widened: u16 = value
    return accept_wide(widened)


def observed_unsigned() -> None:
    """Observe the maximum byte after widening."""
    value: u8 = 255
    println(widen_integer(value))


def main() -> None:
    """Print `widen_explicit_float(value)` after preparing the fixture inputs."""
    value: f32 = 1.2345679
    println(widen_explicit_float(value))
    println(widen_ordinary_float(value))
    observed_unsigned()
