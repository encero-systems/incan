# behavior: model and enum trait overloads dispatch by result type, including calls through generic bounds, while ordinary class method overloads dispatch by argument types and counts (#2256, #2890; RFC 174)
# expect-stdout:
#   1 1.5
#   1 1.5
#   3
#   7

trait Convert[T]:
    def convert(self) -> T: ...


model Reading with Convert[int], Convert[float]:
    value: int

    def convert(self) -> int:
        return self.value

    def convert(self) -> float:
        return 1.5


enum Token with Convert[int], Convert[float]:
    Number

    def convert(self) -> int:
        return 1

    def convert(self) -> float:
        return 1.5


class Writer:
    count: int = 0

    pub def write(self, data: bytes) -> int:
        return len(data)

    pub def write(self, value: int, endian: str) -> int:
        return value


def convert_bound[T, Source with Convert[T]](source: Source) -> T:
    """Dispatch the checked trait instantiation after the concrete adopter and result type are supplied."""
    return source.convert()


def main() -> None:
    reading = Reading(value=1)
    whole: int = reading.convert()
    precise: float = reading.convert()
    println(f"{whole} {precise}")
    token: Token = Token.Number
    token_whole: int = token.convert()
    token_precise: float = token.convert()
    println(f"{token_whole} {token_precise}")
    assert convert_bound[int, Reading](reading) == whole
    assert convert_bound[float, Reading](reading) == precise
    assert convert_bound[int, Token](token) == token_whole
    assert convert_bound[float, Token](token) == token_precise
    writer = Writer()
    println(writer.write(b"abc"))
    println(writer.write(7, "little"))
