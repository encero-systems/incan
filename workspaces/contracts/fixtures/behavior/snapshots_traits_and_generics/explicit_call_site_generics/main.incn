"""Run the program of each former case in order."""

import explicit_call_site_generics
import fallible_iteration_protocol
import fallible_iterator_adapter_chain
import frozen_trait_arguments
import generic_bounds_return_type
import generic_fallible_iterator_consumer
import generic_method_defaults
import generic_methods
import item_from_iterable_bound
import iterator_flat_map_over_iterables


def main() -> None:
    """Run each former case's program in turn."""
    explicit_call_site_generics.main()
    fallible_iteration_protocol.main()
    fallible_iterator_adapter_chain.main()
    frozen_trait_arguments.main()
    generic_bounds_return_type.main()
    generic_fallible_iterator_consumer.main()
    generic_method_defaults.main()
    generic_methods.main()
    item_from_iterable_bound.main()
    iterator_flat_map_over_iterables.main()
