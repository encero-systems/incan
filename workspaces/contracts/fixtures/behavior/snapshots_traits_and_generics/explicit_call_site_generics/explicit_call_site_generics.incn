# Former case explicit_call_site_generics: explicit call-site type arguments on a function and on a method select the instantiation and return the passed value (RFC 054)

"""RFC 054: explicit call-site type arguments lower to Rust turbofish on calls and method calls."""


def id[T](x: T) -> T:
    return x


class Boxed:
    pub def pick[T](self, value: T) -> T:
        return value


pub def main() -> None:
    let a = id[int](1)
    let b = Boxed()
    let c = b.pick[int](2)
    println(a + c)
    println(b.pick[str]("text"))
