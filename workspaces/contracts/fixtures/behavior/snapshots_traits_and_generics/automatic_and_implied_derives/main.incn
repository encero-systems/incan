"""Run the program of each former case in order."""

import automatic_and_implied_derives
import callable_bound_closure_and_model
import derived_default_takes_declared_field_defaults
import derived_display_prints_the_value_structure
import enum_automatic_eq_in_derived_models
import enum_eq_dunder_and_display_derive
import sorted_list_of_ordered_types
import static_trait_default
import standard_rust_capability_bounds
import standard_traits_convert_usage
import trait_bound_default


def main() -> None:
    """Run each former case's program in turn."""
    automatic_and_implied_derives.main()
    callable_bound_closure_and_model.main()
    derived_default_takes_declared_field_defaults.main()
    derived_display_prints_the_value_structure.main()
    enum_automatic_eq_in_derived_models.main()
    enum_eq_dunder_and_display_derive.main()
    sorted_list_of_ordered_types.main()
    static_trait_default.main()
    standard_rust_capability_bounds.main()
    standard_traits_convert_usage.main()
    trait_bound_default.main()
