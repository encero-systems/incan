# behavior: a generic BinaryReader consumer loops over mapped chunks, retaining and invoking a captured error prefix when polling fails
# expect-stdout:
#   16
#   4
#   done

from std.io import BinaryReader, BytesIO


pub def consume[R with BinaryReader](reader: R, size: int = 16) -> Result[None, str]:
    """Drain mapped chunks and retain the captured prefix through the adapter's error path."""
    prefix = "read failed: "
    for chunk in reader.chunks(size).map_err((error) => f"{prefix}{error.detail}")?:
        println(len(chunk))
    return Ok(None)


def main() -> None:
    match consume(BytesIO(b"0123456789abcdefghij")):
        Ok(_) => println("done")
        Err(error) => println(error)
    match consume(BytesIO(b""), 0):
        Ok(_) => assert false
        Err(error) => assert error == "read failed: chunk_size must be greater than zero"
