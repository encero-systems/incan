# behavior: structural Debug uses Incan field separators for ordinary, nested, empty and generic models while a Rust-defined field keeps its own text, and Display delegates to that structure
# expect-stdout:
#   Point { x = 1, y = 2 }
#   Point { x = 1, y = 2 }
#   Point { x = 1, y = 2 } and Empty
#   Account { owner = "Ada", balance = 3 }
#   Circle(1.5)
#   UserId(5)
#   Box { value = "x" }
#   <Point { x = 1, y = 2 }>
#   <UserId(6)>
#   Box { value = 7 }
#   [Box { value = 7 }] Box { value = 7 }
#   Point { x = 10, y = 20 }
#   Nested { point = Point { x = 10, y = 20 } }
#   Marker
#   Box { value = 7 }
#   NativeHolder { duration = 2s }

from rust::std::time import Duration


@derive(Display)
model Point:
    x: int
    y: int


@derive(Display)
class Account:
    pub owner: str
    pub balance: int


@derive(Display)
enum Shape:
    Circle(float)
    Empty


@derive(Display)
type UserId = newtype int


@derive(Display)
model Box[T]:
    value: T


@derive(Debug)
model Nested:
    point: Point


@derive(Debug)
model Marker:
    def marked(self) -> bool:
        return true


@derive(Debug)
model NativeHolder:
    duration: Duration


def show[T with Display](value: T) -> str:
    return f"<{value}>"


def describe[U](b: Box[U]) -> str:
    println(b)
    return f"[{b}] {str(b)}"


def main() -> None:
    p = Point(x=1, y=2)
    println(p)
    println(str(p))
    println(f"{p} and {Shape.Empty}")
    println(Account(owner="Ada", balance=3))
    println(Shape.Circle(1.5))
    println(UserId(5))
    println(Box(value="x"))
    println(show(p))
    println(show(UserId(6)))
    println(describe(Box(value=7)))
    println(f"{Point(x=10, y=20):?}")
    println(f"{Nested(point=Point(x=10, y=20)):?}")
    println(f"{Marker():?}")
    println(f"{Box(value=7):?}")
    println(f"{NativeHolder(duration=Duration.from_secs(2)):?}")
