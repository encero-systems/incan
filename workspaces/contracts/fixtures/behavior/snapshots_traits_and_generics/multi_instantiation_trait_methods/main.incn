"""Run the program of each former case in order."""

import multi_instantiation_trait_methods
import newtype_trait_targets
import protocol_hooks
import standard_fallible_iterator_loop
import structural_coercion
import trait_bound_explicit
import trait_bound_inference
import trait_supertrait_assignability
import traits


def main() -> None:
    """Run each former case's program in turn."""
    multi_instantiation_trait_methods.main()
    newtype_trait_targets.main()
    protocol_hooks.main()
    standard_fallible_iterator_loop.main()
    structural_coercion.main()
    trait_bound_explicit.main()
    trait_bound_inference.main()
    trait_supertrait_assignability.main()
    traits.main()
