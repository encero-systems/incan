# Former case trait_bound_explicit: explicit with-bounds on type parameters accept arguments of types that satisfy them (RFC 023)

# RFC 023: Explicit `with` bounds on type parameters


def identity[T with Clone](value: T) -> T:
    return value


def format_pair[T with (Eq, Debug)](a: T, b: T) -> None:
    println("pair")


pub def main() -> None:
    println(identity(1))
    format_pair(1, 2)
    println(identity("ok"))
