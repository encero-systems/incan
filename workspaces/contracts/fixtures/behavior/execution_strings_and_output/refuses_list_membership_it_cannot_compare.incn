# behavior: nested list membership compares complete child lists (#2256)
# expect-stdout:
#   true

"""Compare nested list elements without flattening their native slice storage."""


def program_result() -> bool:
    """Compare complete child lists while preserving the source collection."""
    xs = [[1], [2]]
    assert [2] in xs
    assert [3] not in xs
    return [1] in xs


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
