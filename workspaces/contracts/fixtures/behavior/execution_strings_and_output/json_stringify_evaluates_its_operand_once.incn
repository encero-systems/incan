# behavior: json stringify evaluates its operand once
# expect-stdout:
#   direct JSON operand
#   7


"""Json stringify evaluates its operand once."""
def observed_operand() -> int:
  """Print the JSON operand marker and return the integer."""
  println("direct JSON operand")
  return 7

def program_result() -> str:
  """Return the fixture expression `json_stringify(observed_operand())`."""
  return json_stringify(observed_operand())


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
