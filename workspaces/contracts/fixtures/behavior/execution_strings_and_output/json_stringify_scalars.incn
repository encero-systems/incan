# behavior: json_stringify renders the largest int, a string with escapes and None as JSON scalars
# expect-stdout:
#   9223372036854775807|"line\né\t\\\""|null

"""json_stringify over scalar values."""
def program_result() -> str:
  """Compute and return `f"{maximum}|{escaped}|{absent}"`."""
  maximum = json_stringify(9223372036854775807)
  escaped = json_stringify("line\né\t\\\"")
  absent = json_stringify(None)
  return f"{maximum}|{escaped}|{absent}"


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
