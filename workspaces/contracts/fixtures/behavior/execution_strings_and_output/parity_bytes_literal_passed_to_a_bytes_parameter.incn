# behavior: bytes parameters, fields and frozen values support signed indexing with u8 elements, including typed list comprehensions (parity corpus case 15)
# expect-stdout:
#   1
#   105
#   [0, 255]
#   []
#   90
#   255

"""A bytes literal is passed to a bytes parameter (parity corpus case 15)."""
const RAW: FrozenBytes = b"\x00\xff"


model Packet:
    """Keep byte storage behind an ordinary source field."""

    data: bytes


def byte_at(payload: bytes, index: int) -> u8:
    """Read the exact byte element through a signed source index."""
    return payload[index]


def ordinal_key_bytes(payload: bytes) -> list[u8]:
    """Retain byte element types inside a list comprehension."""
    return [payload[index] for index in range(len(payload))]


def send(payload: bytes) -> int:
    """Return `1` for this fixture."""
    return 1


def main() -> None:
    """Print `send(greeting)` after preparing the fixture inputs."""
    greeting = b"hi"
    println(send(greeting))
    println(byte_at(greeting, -1))
    println(f"{ordinal_key_bytes(b'\x00\xff'):?}")
    println(f"{ordinal_key_bytes(b''):?}")
    packet = Packet(data=b"AZ")
    element: u8 = packet.data[-1]
    println(element)
    frozen_element: u8 = RAW[1]
    println(frozen_element)
