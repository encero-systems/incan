# Former case short_writes_preserve_output_and_identity: short writes preserve output and identity

"""Short writes preserve output and identity."""
def program_result() -> int:
  """Compute and return `42`."""
  println("a\nb")
  println("c", 2)
  return 42


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
