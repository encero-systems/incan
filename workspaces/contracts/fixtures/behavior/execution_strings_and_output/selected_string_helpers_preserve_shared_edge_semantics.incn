# behavior: Runtime and frozen string helpers preserve Unicode semantics and sliced-list arguments (#2256)
# expect-stdout:
#   STRASSE
#   héllo
#   hi
#   xba
#   -é-
#   α, β
#   |é|
#   a||b|

"""Observe checked string helpers with runtime text, frozen text and sliced list arguments."""

# A constant annotated as str still has the frozen receiver that fixture templates use.
const TEMPLATE: str = "name = {name}"
const FROZEN: FrozenStr = "é"


def result() -> str:
    """Return the fixture expression `"Straße".upper()`."""
    return "Straße".upper()


def lower_text() -> str:
    """Lowercase accented text."""
    return "HÉLLO".lower()


def stripped() -> str:
    """Strip Unicode whitespace around text."""
    return " hi ".strip()


def replaced_overlap() -> str:
    """Replace the first nonoverlapping match."""
    return "ababa".replace("aba", "x")


def replaced_empty() -> str:
    """Replace the empty pattern around a Unicode scalar."""
    return "é".replace("", "-")


def joined() -> str:
    """Join Unicode list elements with the written separator."""
    return ", ".join(["α", "β"])


def split_empty() -> str:
    """Keep boundary items when splitting on the empty separator."""
    return "|".join("é".split(""))


def split_repeated() -> str:
    """Keep interior and trailing empty fields."""
    return "|".join("a,,b,".split(","))


def main() -> None:
    """Print the existing string observations, then check frozen receivers and sliced arguments."""
    println(result())
    println(lower_text())
    println(stripped())
    println(replaced_overlap())
    println(replaced_empty())
    println(joined())
    println(split_empty())
    println(split_repeated())
    frozen_helpers()
    sliced_join()


def frozen_helpers() -> None:
    """Retain selected string helpers on frozen receivers, including constant template replacement."""
    assert TEMPLATE.replace("{name}", "case") == "name = case"
    assert FROZEN.upper() == "É"
    assert FROZEN.lower() == "é"
    assert FROZEN.strip() == "é"
    assert FROZEN.replace("", "-") == "-é-"
    assert FROZEN.join(["a", "b"]) == "aéb"
    assert FROZEN.split("") == ["", "é", ""]
    assert FROZEN.contains("é")
    assert FROZEN.len() == 1


def sliced_join() -> None:
    """Borrow copied slices once for joining while keeping their source list readable."""
    parts = ["first", "second", "third"]
    assert ":".join(parts[1:]) == "second:third"
    assert ":".join(parts[::-1]) == "third:second:first"
    assert parts == ["first", "second", "third"]
