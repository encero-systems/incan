# behavior: dispatches a lexical json stringify function by declaration identity
# expect-stdout:
#   42


"""Dispatches a lexical json stringify function by declaration identity."""
def json_stringify(value: int) -> int:
  """Return the fixture expression `value + 1`."""
  return value + 1

def program_result() -> int:
  """Return the fixture expression `json_stringify(41)`."""
  return json_stringify(41)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
