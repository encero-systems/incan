# Former case unselected_string_methods_refuse_before_program_output: unselected string methods refuse before program output

"""Unselected string methods refuse before program output."""
def result(text: str) -> str:
    """Print the marker before calling the string method under test."""
    println("must not run")
    return text.to_string()


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(result("x"))
