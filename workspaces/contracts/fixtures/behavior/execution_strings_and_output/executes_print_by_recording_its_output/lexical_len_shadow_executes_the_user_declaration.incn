# Former case lexical_len_shadow_executes_the_user_declaration: lexical len shadow executes the user declaration

"""Lexical len shadow executes the user declaration."""
def len(value: str) -> int:
    """Return `99` for this fixture."""
    return 99

def length(value: str) -> int:
    """Return the fixture expression `len(value)`."""
    return len(value)


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(length("é"))
