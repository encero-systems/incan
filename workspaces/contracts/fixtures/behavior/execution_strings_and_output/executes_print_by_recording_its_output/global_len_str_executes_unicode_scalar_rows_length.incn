# Former case global_len_str_executes_unicode_scalar_rows_length: len and str.len count Unicode scalars in empty, ASCII, accented, astral and combining text

"""Global len str executes unicode scalar rows."""
def length(value: str) -> int:
    """Return the fixture expression `len(value)`."""
    return len(value)


def method_length(value: str) -> int:
    """Count scalars through the string method rather than the builtin."""
    return value.len()


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(length(""))
    println(length("abc"))
    println(length("é"))
    println(length("😀"))
    println(length("é"))
    println(method_length(""))
    println(method_length("abc"))
    println(method_length("é"))
    println(method_length("😀"))
    println(method_length("é"))
