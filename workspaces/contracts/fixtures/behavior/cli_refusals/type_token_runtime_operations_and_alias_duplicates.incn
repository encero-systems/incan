# behavior: primitive and trait type tokens refuse comparison, hashing, serialization, pattern matching, field and method access; bare traits remain compile-time names; overloads whose transparent aliases normalize to one token key are duplicate declarations; and method declarations whose accepted argument ranges and types overlap are refused (#1033; RFC 174)
# expect-diagnostic: INCAN-T0001

type Count = int


type Total = Count


trait Renderable:
    def render(self) -> str: ...


def choose(value: Type[Count]) -> str:
    return "count"


def choose(value: Type[Total]) -> str:
    return "total"


class ConflictingWriter:
    def write(self, value: int) -> int:
        return value

    def write(self, value: int, radix: int = 10) -> int:
        return value + radix


def refuse_operations(token: Type[int]) -> None:
    println(token == token)
    println(token < token)
    tokens: set[Type[int]] = {int}
    println(json_stringify(token))
    match token:
        _ => pass
    println(token.value)
    println(token.__class_name__())


def refuse_trait_operations(token: Type[Renderable]) -> None:
    println(token == token)
    traits: set[Type[Renderable]] = {Renderable}
    println(json_stringify(token))
    match token:
        _ => pass
    println(token.value)
    println(token.render())


def main() -> None:
    refuse_operations(int)
    refuse_trait_operations(Renderable)
    println(Renderable)
    println(choose(int))
