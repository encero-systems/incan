# behavior: type tokens refuse comparison, hashing, serialization, pattern matching, field and method access, and overloads whose transparent aliases normalize to one token key are duplicate declarations (#1033)
# expect-diagnostic: INCAN-T0001

type Count = int


type Total = Count


def choose(value: Type[Count]) -> str:
    return "count"


def choose(value: Type[Total]) -> str:
    return "total"


def refuse_operations(token: Type[int]) -> None:
    println(token == token)
    println(token < token)
    tokens: set[Type[int]] = {int}
    println(json_stringify(token))
    match token:
        _ => pass
    println(token.value)
    println(token.__class_name__())


def main() -> None:
    refuse_operations(int)
    println(choose(int))
