# behavior: unions published by dependencies work at every consumer call: every member of a four-model union dispatches to its own arm in the provider and in a consumer match whose arm derives a mutable local from the bound payload, a renamed model constructor still fits its union, a union-returning call and a str pass to an Option[union] parameter and a model to an Option[model | str] one, both defaulting to None, unions nested in a tuple and beside a consumer-local union each keep their provider, function aliases and overload aliases keep their union results, and two providers' same-shaped unions stay apart
# expect-stdout:
#   bool column active
#   number column amount
#   bool literal true
#   str literal name
#   consumer bool column active 7
#   consumer number column amount
#   consumer bool literal true
#   consumer str literal name
#   105
#   7
#   int 4
#   text hello
#   nothing
#   int expr 4
#   nothing
#   bool literal false / number column total
#   number column x + local 3
#   number column x + local text
#   first 5
#   first zero
#   second 6
#   second zero
#   pick 2
#   pick yes true
#   pick no false
#   select 8
#   other column region
#   other position 2
#   envelope 4
#   plain 5
#   8

from pub::querykit import BoolColumnExpr, NumberColumnExpr, BoolLiteralExpr, StringLiteralExpr, ColumnExpr, IntExpr, Surcharge as Charge, describe, describe_pair, column, literal, accept_optional, accept_expr, lit, first, second, select, pick, charge_total
from pub::other import ProviderColumn, render


model LocalValue:
    pub value: int


type Local = LocalValue | str
type Envelope = IntExpr | int


def describe_mixed(exprs: tuple[ColumnExpr, Local]) -> str:
    match exprs[1]:
        LocalValue(local) => return f"{describe(exprs[0])} + local {local.value}"
        str(text) => return f"{describe(exprs[0])} + local {text}"


def local(value: int) -> Local:
    return LocalValue(value=value)


def local_text(text: str) -> Local:
    return text


def show_expr(expr: ColumnExpr) -> str:
    match expr:
        BoolColumnExpr(column) =>
            mut width = len(column.name)
            width += 1
            return f"consumer bool column {column.name} {width}"
        NumberColumnExpr(column) => return f"consumer number column {column.name}"
        BoolLiteralExpr(literal) => return f"consumer bool literal {literal.value}"
        StringLiteralExpr(literal) => return f"consumer str literal {literal.value}"


def show_first(value: int | str, label: str) -> str:
    match value:
        int(number) => return f"{label} {number}"
        str(text) => return f"{label} {text}"


def show_envelope(value: Envelope) -> str:
    match value:
        IntExpr(expr) => return f"envelope {expr.value}"
        int(plain) => return f"plain {plain}"


def bump(value: Envelope) -> int:
    match value:
        IntExpr(expr) =>
            mut total = expr.value
            total += 4
            return total
        int(plain) => return plain


def main() -> None:
    println(describe(BoolColumnExpr(name="active")))
    println(describe(NumberColumnExpr(name="amount")))
    println(describe(BoolLiteralExpr(value=true)))
    println(describe(StringLiteralExpr(value="name")))
    println(show_expr(BoolColumnExpr(name="active")))
    println(show_expr(column("amount")))
    println(show_expr(literal(true)))
    println(show_expr(StringLiteralExpr(value="name")))
    println(charge_total(Charge(value=5)))
    println(charge_total(7))
    println(accept_optional(lit(4)))
    println(accept_optional("hello"))
    println(accept_optional())
    println(accept_expr(IntExpr(value=4)))
    println(accept_expr())
    println(describe_pair((literal(false), column("total"))))
    println(describe_mixed((column("x"), local(3))))
    println(describe_mixed((column("x"), local_text("text"))))
    println(show_first(first(5), "first"))
    println(show_first(first(0), "first"))
    println(show_first(second(6), "second"))
    println(show_first(second(0), "second"))
    println(show_first(pick(2), "pick"))
    yes = pick("yes")
    no = pick("no")
    println(f"pick yes {yes}")
    println(f"pick no {no}")
    println(show_first(select(8), "select"))
    println(render(ProviderColumn(name="region")))
    println(render(2))
    println(show_envelope(IntExpr(value=4)))
    println(show_envelope(5))
    println(bump(IntExpr(value=4)))
