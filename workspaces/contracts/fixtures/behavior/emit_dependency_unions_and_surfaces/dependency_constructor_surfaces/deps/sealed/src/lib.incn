pub class Vault:
    secret: int
    pub label: str = "sealed"

    pub def reveal(self) -> str:
        return f"{self.label}:{self.secret}"

    @staticmethod
    pub def create(secret: int, label: str = "sealed") -> Vault:
        """Construct a vault through the dependency's public surface."""
        return Vault(secret=secret, label=label)


pub model Envelope:
    secret: bool = true
    pub label: str

    pub def describe(self) -> str:
        return f"{self.label} {self.secret}"


pub model Columns[T, Stored with Display]:
    pub sql: str
    pub sample: Stored

    pub def describe(self) -> str:
        return f"{self.sql} {self.sample}"


@derive(Validate)
pub model Checked:
    """Publish one generated validated constructor through the dependency surface."""

    pub value: int
    pub label: str = "published"

    def validate(self) -> Result[Checked, str]:
        """Accept single-digit values and preserve the complete constructed record."""
        if self.value > 9:
            return Err("dependency value too large")
        return Ok(self)
