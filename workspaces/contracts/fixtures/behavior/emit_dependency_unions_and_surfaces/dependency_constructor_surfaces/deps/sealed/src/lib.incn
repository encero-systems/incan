pub class Vault:
    secret: int
    pub label: str = "sealed"

    pub def reveal(self) -> str:
        return f"{self.label}:{self.secret}"


pub model Envelope:
    secret: bool = true
    pub label: str

    pub def describe(self) -> str:
        return f"{self.label} {self.secret}"


pub model Columns[T, Stored with Display]:
    pub sql: str
    pub sample: Stored

    pub def describe(self) -> str:
        return f"{self.sql} {self.sample}"
