# behavior: dependency types construct through their published surface: a class with private required state is built under an import alias through a public provider factory, while same-named classes and models retain their identities through the remaining constructor surfaces (RFC 149: private fields reserve construction and hide data; RFC 122: inaccessible private state cannot be bound through another construction path)
# expect-stdout:
#   sealed:42
#   named:7
#   decoy true
#   public true
#   q1 sample
#   12
#   3
#   3

from pub::sealed import Vault as PublicVault, Envelope, Columns
from pub::decoy import Vault as DecoyVault
from pub::modulelib import hyperquant


def main() -> None:
    println(PublicVault.create(secret=42).reveal())
    println(PublicVault.create(secret=7, label="named").reveal())
    println(DecoyVault(unrelated=true).reveal())
    println(Envelope(label="public").describe())
    columns = Columns[int, str](sql="q1", sample="sample")
    println(columns.describe())
    index = hyperquant.HyperquantIndex(size=hyperquant.DEFAULT_SIZE)
    println(index.size)
    builder = hyperquant.IndexBuilder()
    println(builder.size)
    println(builder.build().size)
