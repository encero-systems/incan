# behavior: dependency types construct through their published surface: a class with private required state is built under an import alias through a public provider factory, a validated model publishes its generated checked constructor, and same-named classes and models retain their identities through the remaining constructor surfaces (#2811; RFC 149: private fields reserve construction and hide data; RFC 122: inaccessible private state cannot be bound through another construction path)
# expect-stdout:
#   sealed:42
#   named:7
#   decoy true
#   public true
#   q1 sample
#   12
#   3
#   3
#   4 published
#   dependency value too large

from pub::sealed import Checked, Vault as PublicVault, Envelope, Columns
from pub::decoy import Vault as DecoyVault
from pub::modulelib import hyperquant


def main() -> None:
    println(PublicVault.create(secret=42).reveal())
    println(PublicVault.create(secret=7, label="named").reveal())
    println(DecoyVault(unrelated=true).reveal())
    println(Envelope(label="public").describe())
    columns = Columns[int, str](sql="q1", sample="sample")
    println(columns.describe())
    index = hyperquant.HyperquantIndex(size=hyperquant.DEFAULT_SIZE)
    println(index.size)
    builder = hyperquant.IndexBuilder()
    println(builder.size)
    println(builder.build().size)
    match Checked.new(value=4):
        Ok(value) => println(f"{value.value} {value.label}")
        Err(error) => println(error)
    match Checked.new(value=14):
        Ok(_value) => println("accepted")
        Err(error) => println(error)
