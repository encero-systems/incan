"""Run the program of each former case in order."""

import loops_over_calls_returning_iterator_adopters
import standard_async_module_error_names
import standard_data_module_names
import standard_logging_telemetry_names
import standard_prelude_and_traits_names


def main() -> None:
    """Run each former case's program in turn."""
    loops_over_calls_returning_iterator_adopters.main()
    standard_async_module_error_names.main()
    standard_data_module_names.main()
    standard_logging_telemetry_names.main()
    standard_prelude_and_traits_names.main()
