from std.graph import Error


model GraphFailure with Error:
    detail: str

    def message(self) -> str:
        return self.detail

    def source(self) -> Option[str]:
        return None


pub def graph_line() -> str:
    """Use the Error name std.graph published in 0.5.1."""
    return f"graph {GraphFailure(detail="cycle").message()}"
