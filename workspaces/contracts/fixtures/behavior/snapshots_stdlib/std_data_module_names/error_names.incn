from std.datetime.error import Error
from std.datetime.runtime import DateTimeError
from std.json import Index
from std.regex.types import Clone, Iterator


model ClockFailure with Error:
    detail: str

    def message(self) -> str:
        return self.detail

    def source(self) -> Option[str]:
        return None


def duplicate[T with Clone](value: T) -> T:
    """Name std.regex.types' Clone as a bound."""
    return value.clone()


def advance[I with Iterator[str]](items: I) -> Option[str]:
    """Name std.regex.types' Iterator as a bound."""
    return items.__next__()


def first_letter[T with Index[int, str]](values: T) -> str:
    """Name std.json's Index as a bound."""
    return values[0]


def runtime_error(error: Option[DateTimeError]) -> bool:
    match error:
        Some(_) => return false
        None => return true


pub def error_line() -> str:
    """Use the Error, DateTimeError, Index, Clone and Iterator names these modules published in 0.5.1."""
    return f"errors {ClockFailure(detail="clock").message()} {runtime_error(None)}"
