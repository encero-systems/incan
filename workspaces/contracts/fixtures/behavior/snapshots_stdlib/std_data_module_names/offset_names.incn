from std.datetime.civil.offset import (
    DateTime,
    DateTimeError,
    DateTimeInterval,
    FixedOffset,
    OrdinalKey,
    OrdinalMapError,
    TimeDelta,
    YearMonthInterval,
    ordinal_key_bytes,
    ordinal_key_read_signed_magnitude_i64,
    ordinal_key_signed_magnitude_i64,
    ordinal_key_signed_magnitude_i64_is_canonical,
    utc,
)


def offset_seconds(offset: FixedOffset) -> int:
    return offset.seconds


def keyed[K with OrdinalKey](key: K) -> bool:
    return true


pub def offset_line() -> str:
    """Use each name std.datetime.civil.offset published in 0.5.1."""
    encoded = ordinal_key_signed_magnitude_i64(-5)
    data = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    decoded = ordinal_key_read_signed_magnitude_i64(data, 0)
    canonical = ordinal_key_signed_magnitude_i64_is_canonical(data, 0)
    when: Option[DateTime] = None
    error: Option[DateTimeError] = None
    interval: Option[DateTimeInterval] = None
    map_error: Option[OrdinalMapError] = None
    delta: Option[TimeDelta] = None
    months: Option[YearMonthInterval] = None
    mut empty = 0
    match when:
        Some(_) => pass
        None => empty += 1
    match error:
        Some(_) => pass
        None => empty += 1
    match interval:
        Some(_) => pass
        None => empty += 1
    match map_error:
        Some(_) => pass
        None => empty += 1
    match delta:
        Some(_) => pass
        None => empty += 1
    match months:
        Some(_) => pass
        None => empty += 1
    return f"offset {offset_seconds(utc())} {len(encoded)} {len(ordinal_key_bytes(b"ab"))} {decoded} {canonical} {empty}"
