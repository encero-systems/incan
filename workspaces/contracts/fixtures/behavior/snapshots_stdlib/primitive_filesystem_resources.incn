# behavior: primitive filesystem resources read and decode source bytes, file and owned-byte views share one bounded type, and placement-neutral guards retain resources (#2501, #2519)
# expect-stdout:
#   0
#   3 3 3 1
#   7
#   97 97
#   true
#   true
#   true
#   true
#   true
#   true
#   true
#   true
#   true
#   source café
#   true
#   bad�tail
#   true
#   cut�
#   99 97 102 195 169 0
#   true

"""Exercise source reading, UTF-8 decoding and retained resources without importing higher standard facades."""

from std.primitives.fs import Path, map_read, open_read, open_write, read_chunk, try_exclusive, write_all
from std.primitives.fs.file import read_remaining
from std.primitives.locking import LockGuard
from std.primitives.native_strings import nul_terminated_utf8
from std.primitives.text import decode_utf8
from std.primitives.views import MappedFile, MappedView


def read_source_chunks(path: Path, chunk_size: int) -> Result[list[bytes], str]:
    """Open one owned source handle and return every non-empty bounded chunk."""
    file = open_read(path)?
    mut chunks: list[bytes] = []

    loop:
        chunk = read_chunk(file, chunk_size)?
        if len(chunk) == 0:
            break
        chunks.append(chunk)

    return Ok(chunks)


def write_source(path: Path, data: bytes) -> Result[None, str]:
    """Replace one source file through an owned primitive handle."""
    file = open_write(path)?
    _ = write_all(file, data)?
    return Ok(None)


def read_source(path: Path, replace_invalid: bool) -> Result[str, str]:
    """Read one source file as bytes and decode it through the primitive UTF-8 boundary."""
    file = open_read(path)?
    data = read_remaining(file)?
    accepted, text_or_detail = decode_utf8(data, replace_invalid)
    if accepted:
        return Ok(text_or_detail)
    return Err(text_or_detail)


def first_byte(path: Path) -> Result[int, str]:
    """Read one byte and return while the owned handle is still in scope."""
    file = open_read(path)?
    chunk = read_chunk(file, 1)?
    return Ok(int(chunk[0]))


def retained_view(path: Path) -> Result[MappedView, str]:
    """Return a mapped view after the local mapping handle leaves scope."""
    mapping = map_read(path)?
    match mapping.view(1, 3):
        Some(view) => return Ok(view)
        None => return Err("expected a valid mapped view")


def retained_owned_view() -> Result[MappedView, str]:
    """Return a bounded view after the local owned-byte handle leaves scope."""
    mapping = MappedFile.owned(b"abcdefg")?
    match mapping.view(1, 3):
        Some(view) => return Ok(view)
        None => return Err("expected a valid owned-byte view")


def constructs_guard() -> bool:
    """Clone an in-process guard and observe that both values retain one anchor."""
    guard = LockGuard.memory()
    clone = guard.clone()
    return guard.reference_count() == 2 and clone.reference_count() == 2


def lock_conflicts(path: Path) -> Result[bool, str]:
    """Hold one exclusive lock and report whether a second acquisition conflicts."""
    first = try_exclusive(path)?
    match first:
        Some(held) =>
            second = try_exclusive(path)?
            match second:
                Some(_) => return Ok(false)
                None => return Ok(true)
        None => return Err("the first lock acquisition was unexpectedly contended")


def lock_released(path: Path) -> Result[bool, str]:
    """Report whether a lock can be reacquired after the prior guard leaves scope."""
    match try_exclusive(path)?:
        Some(_) => return Ok(true)
        None => return Ok(false)


def open_failed() -> bool:
    """Report whether opening an absent source returns an error."""
    match open_read(Path(value="primitive-source-absent")):
        Ok(_) => return false
        Err(_) => return true


def read_failed() -> Result[bool, str]:
    """Report whether reading a directory handle returns an error."""
    directory = open_read(Path(value="."))?
    match read_chunk(directory, 1):
        Ok(_) => return Ok(false)
        Err(_) => return Ok(true)


def decode_failed(path: Path) -> bool:
    """Report whether strict primitive decoding refuses one malformed source file."""
    match read_source(path, false):
        Ok(_) => return false
        Err(_) => return true


def main() -> Result[None, str]:
    """
    Exercise primitive filesystem resources.

    1. Read empty, multi-chunk and short final reads.
    2. Keep two owned readers at independent cursor positions.
    3. Report open and read failures and release a handle on early return.
    4. Retain mapped and owned-byte views and release placement-neutral lock guards.
    5. Decode valid, malformed and truncated source bytes with strict and replacement behavior.
    6. Build independent NUL-terminated UTF-8 storage and reject an interior NUL.
    """
    empty_path = Path(value="primitive-source-empty")
    source_path = Path(value="primitive-source-data")
    write_source(empty_path, b"")?
    write_source(source_path, b"abcdefg")?

    # 1. Read empty, multi-chunk and short final reads.
    empty = read_source_chunks(empty_path, 4)?
    chunks = read_source_chunks(source_path, 3)?
    short = read_source_chunks(source_path, 64)?
    println(len(empty))
    println(f"{len(chunks)} {len(chunks[0])} {len(chunks[1])} {len(chunks[2])}")
    println(len(short[0]))

    # 2. Keep two owned readers at independent cursor positions.
    first = open_read(source_path)?
    second = open_read(source_path)?
    first_value = read_chunk(first, 1)?
    second_value = read_chunk(second, 1)?
    println(f"{int(first_value[0])} {int(second_value[0])}")

    # 3. Report failures and observe that an early-return handle no longer prevents removal.
    println(open_failed())
    println(read_failed()?)
    early_path = Path(value="primitive-source-early-return")
    write_source(early_path, b"x")?
    println(first_byte(early_path)? == 120)
    early_path.remove()?
    match open_read(early_path):
        Ok(_) => println(false)
        Err(_) => println(true)

    # 4. Keep mapped and owned bytes after their owner handles leave scope, then release and reacquire one lock.
    view = retained_view(source_path)?
    println(view.to_bytes() == b"bcd")
    lock_path = Path(value="primitive-source-lock")
    println(lock_conflicts(lock_path)?)
    println(lock_released(lock_path)?)
    println(retained_owned_view()?.to_bytes() == b"bcd")
    println(constructs_guard())

    # 5. Source loading uses the same strict and replacement byte decoder as generated programs.
    valid_path = Path(value="primitive-source-valid-utf8")
    malformed_path = Path(value="primitive-source-malformed-utf8")
    truncated_path = Path(value="primitive-source-truncated-utf8")
    write_source(valid_path, b"source caf\xc3\xa9")?
    write_source(malformed_path, b"bad\xfftail")?
    write_source(truncated_path, b"cut\xe2\x82")?
    println(read_source(valid_path, false)?)
    println(decode_failed(malformed_path))
    println(read_source(malformed_path, true)?)
    println(decode_failed(truncated_path))
    println(read_source(truncated_path, true)?)

    # 6. The returned buffer owns its copy and contains exactly one trailing terminator.
    terminated = nul_terminated_utf8("café")?
    println(" ".join([str(int(byte)) for byte in terminated]))
    interior = b"a\x00b".decode().unwrap_or("")
    match nul_terminated_utf8(interior):
        Ok(_) => println(false)
        Err(_) => println(true)
    return Ok(None)
