"""Run the program of each former case in order."""

import standard_async_race
import standard_async_race_timeout
import standard_async_tasks_and_time
import standard_graph
import standard_graph_adjacency_counters
import standard_graph_legacy_invariants
import standard_graph_legacy_orders
import standard_graph_read_pages
import standard_math
import standard_regex


async def main() -> None:
    """Run each former case's program in turn."""
    await standard_async_race.main()
    await standard_async_race_timeout.main()
    await standard_async_tasks_and_time.main()
    standard_graph.main()
    standard_graph_adjacency_counters.main()
    standard_graph_legacy_invariants.main()
    standard_graph_legacy_orders.main()
    standard_graph_read_pages.main()
    standard_math.main()
    standard_regex.main()
