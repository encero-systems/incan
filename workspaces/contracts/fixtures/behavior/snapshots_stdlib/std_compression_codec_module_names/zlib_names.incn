from std.compression.zlib import Codec, CompressionError, File, decompress


pub def refusal_line(data: bytes) -> str:
    """Name the refusal `std.compression.zlib` gives malformed input, through the names it publishes."""
    match decompress(data):
        Ok(_) => return "zlib accepted"
        Err(error) => return describe(error)


def describe(error: CompressionError) -> str:
    """Report whether the refusal explains itself and whether its codec is this module's."""
    return f"zlib {len(error.detail) > 0} {error.codec == Some(Codec.Zlib)}"


pub def no_file() -> bool:
    """Hold the file type the module's stream helpers write, empty."""
    slot: Option[File] = None
    match slot:
        Some(_) => return false
        None => return true
