from std.compression.snappy.raw import Codec, CompressionError, decompress


pub def refusal_line(data: bytes) -> str:
    """Name the refusal raw Snappy gives a malformed block, through the names the module publishes."""
    match decompress(data):
        Ok(_) => return "raw snappy accepted"
        Err(error) => return describe(error)


def describe(error: CompressionError) -> str:
    """Report whether the refusal explains itself and whether its codec is Snappy."""
    return f"raw snappy {len(error.detail) > 0} {error.codec == Some(Codec.Snappy)}"
