# behavior: extern functions and static methods delegate to their Rust module, and a failing native assertion aborts the run
# expect-stdout:
#   true
#   before
# expect-exit: 101

rust.module("incan_std_testing")


class NativeTesting:
    """Expose a native module function through a static source method."""

    @staticmethod
    @rust.extern
    def platform() -> str:
        """Return the platform name from the native testing module."""
        ...


@rust.extern
def fail_t(msg: str) -> None:
    ...


def assert_true(value: bool) -> None:
    if not value:
        fail_t("assertion failed: expected true")


def main() -> None:
    println(len(NativeTesting.platform()) > 0)
    assert_true(true)
    println("before")
    assert_true(false)
    println("after")
