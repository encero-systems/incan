# behavior: direct Rust function imports can back source wrappers, including a generic return-only type parameter, and a failing native assertion aborts the run (RFC 171)
# expect-stdout:
#   true
#   before
# expect-exit: 101

from rust::incan_std_testing import fail_t as native_fail, platform as native_platform


class NativeTesting:
    """Expose a native module function through a static source method."""

    @staticmethod
    pub def platform() -> str:
        """Return the platform name from the native testing module."""
        return native_platform()


def fail_t[T](msg: str) -> T:
    """Infer the imported Rust function's return-only type parameter from this wrapper's return type."""
    return native_fail(msg)


def assert_true(value: bool) -> None:
    if not value:
        return fail_t("assertion failed: expected true")


def main() -> None:
    println(len(NativeTesting.platform()) > 0)
    assert_true(true)
    println("before")
    assert_true(false)
    println("after")
