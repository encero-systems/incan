# Former case std_derives_surface: derived Eq, Ord, Hash, Clone, Copy, Default and Debug compare (==, !=, <, >, <=, >=), key, copy, default and render models

from std.derives.comparison import Eq, Ord, Hash
from std.derives.copying import Clone, Copy, Default
from std.derives.string import Debug


@derive(Eq, Ord, Hash, Clone, Copy, Default, Debug)
model Point:
    x: int = 0
    y: int = 0


pub def main() -> None:
    a = Point(x=1, y=2)
    b = Point(x=1, y=2)
    c = Point(x=2, y=0)
    println(f"{a == b} {a == c}")
    println(f"{a < c} {c > b}")
    println(f"{a != b} {a <= b} {b >= c}")
    mut seen: Dict[Point, int] = {}
    seen[a] = 1
    seen[b] = 2
    seen[c] = 3
    println(len(seen))
    println(f"{a:?}")
    origin = Point.default()
    println(f"{origin.x} {origin.y}")
    copied = a
    println(f"{copied.x} {a.y}")
