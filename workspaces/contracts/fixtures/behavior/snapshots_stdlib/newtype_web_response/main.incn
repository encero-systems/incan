"""Run the program of each former case in order."""

import newtype_web_response
import ordinal_map_expected_type_specialization
import standard_derives_collection_adapters
import standard_derives_collection_adapters_with_imported_clone
import standard_derives_surface
import standard_serde_json_import
import standard_testing_assertions
import std_testing_collections_and_async_in_one_program
import std_uuid
import std_web_response_into_response_name
import standard_traits_surface
import web_extractor_field_reads


async def main() -> None:
    """Run each former case's program in turn."""
    newtype_web_response.main()
    ordinal_map_expected_type_specialization.main()
    standard_derives_collection_adapters.main()
    standard_derives_collection_adapters_with_imported_clone.main()
    standard_derives_surface.main()
    standard_serde_json_import.main()
    standard_testing_assertions.main()
    await std_testing_collections_and_async_in_one_program.main()
    std_uuid.main()
    std_web_response_into_response_name.main()
    standard_traits_surface.main()
    await web_extractor_field_reads.main()
