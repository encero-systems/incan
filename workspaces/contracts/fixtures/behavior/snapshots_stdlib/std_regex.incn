# behavior: Regex flags, indexed and named optional capture iteration, and invalid pattern errors preserve their values
# expect-stdout:
#   true false
#   refused

from std.regex import Regex, RegexError


def build() -> Result[None, RegexError]:
    """Check constructor flags and keep named and nonparticipating capture groups distinct."""
    regex = Regex("x+", ignore_case=true)?
    println(f"{regex.is_match("aXXb")} {regex.is_match("ab")}")
    named = Regex("(?P<word>ab)(c)?")?
    match named.captures("ab"):
        Some(captures) =>
            assert captures.group("word") == Some("ab")
            assert captures.group(2) == None
            assert len(captures.groupdict()) == 1
        None =>
            assert false
    mut matches: list[Option[str]] = []
    mut optional: list[Option[str]] = []
    for captures in named.captures_iter("ab abc"):
        matches.append(captures.group("word"))
        optional.append(captures.group(2))
        match captures.full_match():
            Some(found) =>
                assert captures.group(0) == Some(found.as_str())
            None =>
                assert false
        assert len(captures.groupdict()) == 1
    assert matches == [Some("ab"), Some("ab")]
    assert optional == [None, Some("c")]
    return Ok(None)


def main() -> None:
    match build():
        Ok(_) => pass
        Err(error) => println(error.message())
    match Regex("(unclosed"):
        Ok(_) => println("accepted")
        Err(_) => println("refused")
