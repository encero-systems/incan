from std.encoding.base58 import BytesIO, EncodingError, Path, b58decode, encode_stream


pub def refusal_line(text: str) -> str:
    """Name the refusal `std.encoding.base58` gives malformed text, through the names it publishes."""
    match b58decode(text):
        Ok(_) => return "base58 accepted"
        Err(error) => return describe(error)


def describe(error: EncodingError) -> str:
    """Report the refusal's encoding and whether it explains itself."""
    return f"base58 {error.encoding} {len(error.detail) > 0}"


pub def stream_line(data: bytes) -> str:
    """Encode through the module's stream helper between two BytesIO buffers."""
    source = BytesIO(data)
    target = BytesIO(b"")
    match encode_stream(source, target):
        Ok(_) => return f"base58 stream {len(target.getvalue()) > 0}"
        Err(error) => return describe(error)


pub def no_path() -> bool:
    """Hold the path type the module's path helpers take, empty."""
    slot: Option[Path] = None
    match slot:
        Some(_) => return false
        None => return true
