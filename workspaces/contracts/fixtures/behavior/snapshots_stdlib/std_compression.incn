# behavior: every std.compression codec round-trips bytes, decompress_auto detects the codec, streams round-trip through files, and raw snappy round-trips
# expect-stdout:
#   gzip round trip ok
#   zlib round trip ok
#   deflate round trip ok
#   zstd round trip ok
#   bz2 round trip ok
#   lzma round trip ok
#   snappy round trip ok
#   raw snappy round trip ok
#   file stream round trip ok
#   gzip member rules ok
#   zstd frame rules ok
#   bzip2 stream rules ok
#   xz stream rules ok
#   snappy frame rules ok
#   zlib stream boundary rules ok
#   deflate stream boundary rules ok

from std.compression import (
    Codec,
    CompressionError,
    bz2,
    deflate,
    decompress_auto,
    decompress_auto_stream,
    gzip,
    lzma,
    snappy,
    zlib,
    zstd,
)
from std.compression.snappy.raw import compress as raw_snappy_compress, decompress as raw_snappy_decompress
from std.fs import Path
from std.io import BytesIO, IoError
from std.tempfile import TemporaryDirectory


def assert_round_trip(name: str, plain: bytes, decoded: bytes) -> None:
    assert decoded == plain
    println(f"{name} round trip ok")


def assert_auto(compressed: bytes, expected: Codec, plain: bytes) -> Result[None, CompressionError]:
    codec, decoded = decompress_auto(compressed, [expected])?
    assert codec == expected
    assert decoded == plain

    target = BytesIO()
    stream_codec = decompress_auto_stream(BytesIO(compressed), target, [expected], 2)?
    assert stream_codec == expected
    assert target.getvalue() == plain
    return Ok(None)


def joined(first: bytes, second: bytes) -> bytes:
    out = BytesIO()
    match out.write_bytes(first):
        Ok(_) => pass
        Err(_) =>
            assert false
    match out.write_bytes(second):
        Ok(_) => pass
        Err(_) =>
            assert false
    return out.getvalue()


def assert_decoded(result: Result[bytes, CompressionError], expected: bytes) -> None:
    match result:
        Ok(decoded) =>
            assert decoded == expected
        Err(_) =>
            assert false


def assert_error_kind(result: Result[bytes, CompressionError], expected: str) -> None:
    match result:
        Ok(_) =>
            assert false
        Err(error) =>
            assert error.kind == expected


def assert_four_decoded(
    direct: Result[bytes, CompressionError],
    stream: Result[bytes, CompressionError],
    automatic: Result[bytes, CompressionError],
    automatic_stream: Result[bytes, CompressionError],
    expected: bytes,
) -> None:
    assert_decoded(direct, expected)
    assert_decoded(stream, expected)
    assert_decoded(automatic, expected)
    assert_decoded(automatic_stream, expected)


def assert_four_errors(
    direct: Result[bytes, CompressionError],
    stream: Result[bytes, CompressionError],
    automatic: Result[bytes, CompressionError],
    automatic_stream: Result[bytes, CompressionError],
    expected: str,
) -> None:
    assert_error_kind(direct, expected)
    assert_error_kind(stream, expected)
    assert_error_kind(automatic, expected)
    assert_error_kind(automatic_stream, expected)


def auto_bytes(data: bytes, expected: Codec) -> Result[bytes, CompressionError]:
    codec, decoded = decompress_auto(data)?
    assert codec == expected
    return Ok(decoded)


def auto_stream_bytes(data: bytes, expected: Codec) -> Result[bytes, CompressionError]:
    target = BytesIO()
    codec = decompress_auto_stream(BytesIO(data), target)?
    assert codec == expected
    return Ok(target.getvalue())


def gzip_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    gzip.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def zlib_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    zlib.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def deflate_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    deflate.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def zstd_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    zstd.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def bz2_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    bz2.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def lzma_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    lzma.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def snappy_stream(data: bytes) -> Result[bytes, CompressionError]:
    target = BytesIO()
    snappy.decompress_stream(BytesIO(data), target, 2)?
    return Ok(target.getvalue())


def with_empty(first: bytes, empty: bytes, second: bytes) -> bytes:
    return joined(joined(first, empty), second)


def without_last(data: bytes) -> bytes:
    return data[:len(data) - 1]


def exercise_gzip_members(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_member = gzip.compress(first)?
    second_member = gzip.compress(second)?
    members = with_empty(first_member, gzip.compress(b"")?, second_member)
    expected = joined(first, second)
    assert_four_decoded(
        gzip.decompress(members),
        gzip_stream(members),
        auto_bytes(members, Codec.Gzip),
        auto_stream_bytes(members, Codec.Gzip),
        expected,
    )

    truncated = joined(first_member, without_last(second_member))
    assert_four_errors(
        gzip.decompress(truncated),
        gzip_stream(truncated),
        auto_bytes(truncated, Codec.Gzip),
        auto_stream_bytes(truncated, Codec.Gzip),
        "truncated_input",
    )
    return Ok(None)


def exercise_zstd_frames(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_frame = zstd.compress(first)?
    second_frame = zstd.compress(second)?
    frames = with_empty(first_frame, zstd.compress(b"")?, second_frame)
    expected = joined(first, second)
    assert_four_decoded(
        zstd.decompress(frames),
        zstd_stream(frames),
        auto_bytes(frames, Codec.Zstd),
        auto_stream_bytes(frames, Codec.Zstd),
        expected,
    )

    truncated = joined(first_frame, without_last(second_frame))
    assert_four_errors(
        zstd.decompress(truncated),
        zstd_stream(truncated),
        auto_bytes(truncated, Codec.Zstd),
        auto_stream_bytes(truncated, Codec.Zstd),
        "truncated_input",
    )
    return Ok(None)


def exercise_bz2_streams(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_stream = bz2.compress(first)?
    second_stream = bz2.compress(second)?
    streams = with_empty(first_stream, bz2.compress(b"")?, second_stream)
    expected = joined(first, second)
    assert_four_decoded(
        bz2.decompress(streams),
        bz2_stream(streams),
        auto_bytes(streams, Codec.Bz2),
        auto_stream_bytes(streams, Codec.Bz2),
        expected,
    )

    truncated = joined(first_stream, without_last(second_stream))
    assert_four_errors(
        bz2.decompress(truncated),
        bz2_stream(truncated),
        auto_bytes(truncated, Codec.Bz2),
        auto_stream_bytes(truncated, Codec.Bz2),
        "truncated_input",
    )
    return Ok(None)


def exercise_lzma_streams(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_stream = lzma.compress(first)?
    second_stream = lzma.compress(second)?
    streams = with_empty(first_stream, lzma.compress(b"")?, second_stream)
    expected = joined(first, second)
    assert_four_decoded(
        lzma.decompress(streams),
        lzma_stream(streams),
        auto_bytes(streams, Codec.Lzma),
        auto_stream_bytes(streams, Codec.Lzma),
        expected,
    )

    truncated = joined(first_stream, without_last(second_stream))
    assert_four_errors(
        lzma.decompress(truncated),
        lzma_stream(truncated),
        auto_bytes(truncated, Codec.Lzma),
        auto_stream_bytes(truncated, Codec.Lzma),
        "truncated_input",
