    return Ok(None)


def exercise_snappy_frames(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_frame = snappy.compress(first)?
    second_frame = snappy.compress(second)?
    frames = with_empty(first_frame, snappy.compress(b"")?, second_frame)
    expected = joined(first, second)
    assert_four_decoded(
        snappy.decompress(frames),
        snappy_stream(frames),
        auto_bytes(frames, Codec.Snappy),
        auto_stream_bytes(frames, Codec.Snappy),
        expected,
    )

    truncated = joined(first_frame, without_last(second_frame))
    assert_four_errors(
        snappy.decompress(truncated),
        snappy_stream(truncated),
        auto_bytes(truncated, Codec.Snappy),
        auto_stream_bytes(truncated, Codec.Snappy),
        "truncated_input",
    )
    return Ok(None)


def exercise_zlib_trailing_bytes(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_stream = zlib.compress(first)?
    second_stream = zlib.compress(second)?
    streams = joined(first_stream, second_stream)
    assert_four_errors(
        zlib.decompress(streams),
        zlib_stream(streams),
        auto_bytes(streams, Codec.Zlib),
        auto_stream_bytes(streams, Codec.Zlib),
        "invalid_data",
    )

    truncated = without_last(first_stream)
    assert_four_errors(
        zlib.decompress(truncated),
        zlib_stream(truncated),
        auto_bytes(truncated, Codec.Zlib),
        auto_stream_bytes(truncated, Codec.Zlib),
        "truncated_input",
    )
    return Ok(None)


def exercise_deflate_trailing_bytes(first: bytes, second: bytes) -> Result[None, CompressionError]:
    first_stream = deflate.compress(first)?
    second_stream = deflate.compress(second)?
    streams = joined(first_stream, second_stream)
    assert_error_kind(deflate.decompress(streams), "invalid_data")
    assert_error_kind(deflate_stream(streams), "invalid_data")

    truncated = without_last(first_stream)
    assert_error_kind(deflate.decompress(truncated), "truncated_input")
    assert_error_kind(deflate_stream(truncated), "truncated_input")
    return Ok(None)


def exercise_concatenated_input() -> Result[None, CompressionError]:
    first = b"first "
    second = b"second-payload"
    exercise_gzip_members(first, second)?
    println("gzip member rules ok")
    exercise_zstd_frames(first, second)?
    println("zstd frame rules ok")
    exercise_bz2_streams(first, second)?
    println("bzip2 stream rules ok")
    exercise_lzma_streams(first, second)?
    println("xz stream rules ok")
    exercise_snappy_frames(first, second)?
    println("snappy frame rules ok")
    exercise_zlib_trailing_bytes(first, second)?
    println("zlib stream boundary rules ok")
    exercise_deflate_trailing_bytes(first, second)?
    println("deflate stream boundary rules ok")
    return Ok(None)


def must_compression_none(result: Result[None, CompressionError]) -> None:
    match result:
        Ok(_) => return
        Err(_) =>
            assert false


def exercise_file_stream(data: bytes) -> Result[None, IoError]:
    scratch = TemporaryDirectory.try_new()?
    root: Path = scratch.path()
    source_path = root.joinpath("plain.bin")
    compressed_path = root.joinpath("plain.bin.gz")
    output_path = root.joinpath("plain.out")

    source_path.write_bytes(data)?
    source = source_path.open("rb")?
    compressed = compressed_path.open("wb")?
    must_compression_none(gzip.compress_stream(source, compressed, None, 4))
    compressed.flush()?

    compressed_source = compressed_path.open("rb")?
    output = output_path.open("wb")?
    must_compression_none(gzip.decompress_stream(compressed_source, output, 3))
    output.flush()?

    assert output_path.read_bytes()? == data
    println("file stream round trip ok")
    return Ok(None)


def exercise_compression() -> Result[None, CompressionError]:
    data = b"Incan compression dogfood"

    gzip_data = gzip.compress(data, None)?
    assert_round_trip("gzip", data, gzip.decompress(gzip_data)?)
    assert_auto(gzip_data, Codec.Gzip, data)?

    zlib_data = zlib.compress(data, None)?
    zstd_data = zstd.compress(data, None)?
    bz2_data = bz2.compress(data, None)?
    lzma_data = lzma.compress(data, None)?
    snappy_data = snappy.compress(data, None)?

    assert_round_trip("zlib", data, zlib.decompress(zlib_data)?)
    assert_round_trip("deflate", data, deflate.decompress(deflate.compress(data, None)?)?)
    assert_round_trip("zstd", data, zstd.decompress(zstd_data)?)
    assert_round_trip("bz2", data, bz2.decompress(bz2_data)?)
    assert_round_trip("lzma", data, lzma.decompress(lzma_data)?)
    assert_round_trip("snappy", data, snappy.decompress(snappy_data)?)
    assert_round_trip("raw snappy", data, raw_snappy_decompress(raw_snappy_compress(data)?)?)
    return Ok(None)


def main() -> None:
    match exercise_compression():
        Ok(_) => pass
        Err(error) => println(f"compression failed: {error.message()}")
    match exercise_file_stream(b"Incan compression dogfood"):
        Ok(_) => pass
        Err(error) => println(f"io failed: {error.message()}")
    match exercise_concatenated_input():
        Ok(_) => pass
        Err(error) => println(f"concatenated compression failed: {error.kind}: {error.message()}")
