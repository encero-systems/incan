"""Run the program of each former case in order."""

import awaitable_bound_join_handle
import generator_iterator_surface
import imported_stdlib_defaults
import iterator_adopters_reach_the_protocol_methods
import iterator_adopters_spelled_through_their_module
import primitive_async_tasks_sync_and_time
import regex_lazy_full_match_issue2228
import result_combinators
import result_inspect_named_observer_copy_payload
import std_async_channels_and_sync


async def main() -> None:
    """Run each former case's program in turn."""
    await awaitable_bound_join_handle.main()
    generator_iterator_surface.main()
    imported_stdlib_defaults.main()
    iterator_adopters_reach_the_protocol_methods.main()
    iterator_adopters_spelled_through_their_module.main()
    await primitive_async_tasks_sync_and_time.main()
    regex_lazy_full_match_issue2228.main()
    result_combinators.main()
    result_inspect_named_observer_copy_payload.main()
    await std_async_channels_and_sync.main()
