# behavior: propagation yields an awaited local function's successful value and an awaited error exits async main (#2231)
# expect-stdout:
#   7
# expect-stderr-contains:
#   local awaited failure
# expect-exit: 1

import std.async


async def fail() -> Result[None, str]:
    """Return an application error through an async function's output."""
    return Err("local awaited failure")


async def succeed() -> Result[int, str]:
    """Expose the success payload after awaiting rather than the future itself."""
    return Ok(7)


async def main() -> Result[None, str]:
    """Propagate the awaited error before the following statement."""
    value = await (succeed())?
    println(value)
    await fail()?
    println("unreachable")
    return Ok(None)
