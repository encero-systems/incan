from std.environ import Error, TryFrom


model Port with TryFrom[int]:
    value: int

    @classmethod
    def try_from(cls, value: int) -> Result[Self, str]:
        if value <= 0:
            return Err("port must be positive")
        return Ok(Port(value=value))


model UnsetVariable with Error:
    name: str

    def message(self) -> str:
        return f"{self.name} is not set"

    def source(self) -> Option[str]:
        return None


def port_text(value: int) -> str:
    """Convert through the TryFrom adoption the module's name spells."""
    match Port.try_from(value):
        Ok(port) => return f"{port.value}"
        Err(reason) => return reason


pub def environ_line() -> str:
    """Use std.environ's Error and TryFrom names."""
    missing = UnsetVariable(name="PARITY_HOME")
    return f"environ {port_text(8080)} {port_text(0)} {missing.message()}"
