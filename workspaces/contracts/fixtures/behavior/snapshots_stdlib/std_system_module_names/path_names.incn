from std.fs.path import (
    DirEntry,
    DiskUsage,
    File,
    FileLock,
    IoError,
    Path,
    PathStat,
    lock_exclusive,
    lock_shared,
    matches,
    try_lock_exclusive,
    try_lock_shared,
)


def entry_names(entries: list[DirEntry]) -> int:
    return len(entries)


def stat_size(stat: PathStat) -> Result[int, IoError]:
    return stat.size()


def usage_total(usage: Option[DiskUsage]) -> bool:
    match usage:
        Some(_) => return true
        None => return false


def opened(file: File) -> bool:
    return true


def held(lock: Result[FileLock, str]) -> bool:
    match lock:
        Ok(_) => return true
        Err(_) => return false


def lock_text(path: str) -> str:
    """Take and release each lock the module publishes in turn."""
    mut taken = 0
    if held(lock_exclusive(path)):
        taken += 1
    if held(lock_shared(path)):
        taken += 1
    match try_lock_exclusive(path):
        Ok(Some(_)) => taken += 1
        Ok(None) => pass
        Err(_) => pass
    match try_lock_shared(path):
        Ok(Some(_)) => taken += 1
        Ok(None) => pass
        Err(_) => pass
    return f"{taken}"


pub def path_line(root: Path) -> Result[str, IoError]:
    """Use every name std.fs.path published in 0.5.1."""
    target = root / "path.txt"
    target.write_text("abcd", encoding="utf-8", errors="strict", newline=None)?
    file = target.open("r")?
    usage: Option[DiskUsage] = None
    return Ok(
        f"path {entry_names(root.scandir()?)} {stat_size(target.stat()?)?} {usage_total(usage)} {opened(file)} "
        + f"{matches("path.txt", "*.txt")} {lock_text(target.0)}",
    )
