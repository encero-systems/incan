from std.fs.file import BinaryReader, IoError, Path


def first_chunk[R with BinaryReader](reader: R) -> Result[bytes, IoError]:
    """Read through the BinaryReader bound std.fs.file publishes."""
    return reader.read_bytes(2)


pub def file_line(root: Path) -> Result[str, IoError]:
    """Open a file under a Path and read it as a BinaryReader."""
    target = root / "file.bin"
    target.write_bytes(b"incan")?
    reader = target.open("rb")?
    chunk = first_chunk(reader)?
    return Ok(f"file {len(chunk)}")
