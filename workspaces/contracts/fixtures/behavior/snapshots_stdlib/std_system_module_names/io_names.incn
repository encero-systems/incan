from std.io import BytesIO, Error, FallibleIterator, IoError


model ReadFailure with Error:
    detail: str

    def message(self) -> str:
        return self.detail

    def source(self) -> Option[str]:
        return None


def count_chunks[S with FallibleIterator[bytes, IoError]](stream: S) -> Result[int, IoError]:
    """Consume a fallible stream through the FallibleIterator bound std.io publishes."""
    mut count = 0
    for _ in stream?:
        count += 1
    return Ok(count)


pub def io_line() -> Result[str, IoError]:
    reader = BytesIO(b"abcdef")
    chunks = count_chunks(reader.chunks(4))?
    return Ok(f"io {chunks} {ReadFailure(detail="short read").message()}")
