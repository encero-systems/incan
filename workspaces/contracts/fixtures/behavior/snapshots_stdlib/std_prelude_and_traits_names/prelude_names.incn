from std.prelude import (
    Add,
    Bool,
    Callable0,
    Callable1,
    Callable2,
    Clone,
    Contains,
    Copy,
    Debug,
    Default,
    Display,
    Div,
    Eq,
    Error,
    From,
    Hash,
    Index,
    IndexMut,
    Into,
    Iterable,
    Iterator,
    Len,
    Mod,
    Mul,
    Neg,
    Ord,
    Sliceable,
    Sub,
    Sum,
    TryFrom,
    TryInto,
)


model Money with Add[Money, Money]:
    cents: int

    def __add__(self, other: Money) -> Money:
        return Money(cents=self.cents + other.cents)


model Bag with Len:
    items: list[int]

    def __len__(self) -> int:
        return len(self.items)


def total[T with Add[T, T]](a: T, b: T) -> T:
    return a + b


def size[T with Len](value: T) -> int:
    return len(value)


def shown[T with (Debug, Display, Eq, Ord, Hash, Clone, Copy, Default)](value: T) -> T:
    return value


def checked[T with (Bool, Contains[int], Iterable[int], Iterator[int], Sum[int], Sliceable[int])](value: T) -> T:
    return value


def converted[T with (From[int], Into[int], TryFrom[int], TryInto[int], Error)](value: T) -> T:
    return value


def arithmetic[T with (Sub[T, T], Mul[T, T], Div[T, T], Mod[T, T], Neg[T])](value: T) -> T:
    return value


def indexed[T with (Index[int, str], IndexMut[int, str])](value: T) -> T:
    return value


def called[A with Callable0[int], B with Callable1[int, int], C with Callable2[int, int, int]](a: A, b: B, c: C) -> int:
    return c(b(a()), 1)


pub def prelude_line() -> str:
    """Adopt Add and Len through std.prelude and name every other trait it published in 0.5.1 as a bound."""
    money = total(Money(cents=2), Money(cents=3))
    return f"prelude {money.cents} {size(Bag(items=[1, 2, 3]))}"
