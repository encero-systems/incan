from std.logging import (
    Attributes,
    InstrumentationScope,
    Resource,
    SpanId,
    TelemetryValue,
    Timestamp,
    TraceFlags,
    TraceId,
)


def empty[T](slot: Option[T]) -> int:
    match slot:
        Some(_) => return 0
        None => return 1


pub def logging_line() -> str:
    """Name each telemetry type std.logging published in 0.5.1."""
    attributes: Option[Attributes] = None
    scope: Option[InstrumentationScope] = None
    resource: Option[Resource] = None
    span: Option[SpanId] = None
    value: Option[TelemetryValue] = None
    stamp: Option[Timestamp] = None
    flags: Option[TraceFlags] = None
    trace: Option[TraceId] = None
    count = (
        empty(attributes) + empty(scope) + empty(resource) + empty(span) + empty(value) + empty(stamp) + empty(flags)
        + empty(trace)
    )
    return f"logging {count}"
