# Former case callable_trait_accepts_functions_and_closures: a Callable[int, int] parameter accepts a named function and a closure and calls either

def double(value: int) -> int:
    return value * 2


def apply(f: Callable[int, int], value: int) -> int:
    return f(value)


def apply_twice(f: Callable[int, int], value: int) -> int:
    return f(f(value))


pub def main() -> None:
    println(apply(double, 4))
    println(apply((value) => value + 1, 4))
    println(apply_twice((value) => value + 5, 4))
