# Former case user_trait_named_like_stdlib_callable: a user trait named Callable1 with its own apply method is an ordinary trait: a class adopts it and dispatches through it, unrelated to the stdlib callable of the same name

trait Callable1[A, R]:
    def apply(self, arg: A) -> R


class Adder with Callable1[int, int]:
    pub amount: int

    def apply(self, arg: int) -> int:
        return arg + self.amount


def run[C with Callable1[int, int]](callable: C, value: int) -> int:
    return callable.apply(value)


pub def main() -> None:
    println(Adder(amount=3).apply(4))
    println(run(Adder(amount=10), 2))
