# behavior: a `mut` list local is extended in place and a `mut` int local reassigned later reads back its last value
# expect-stdout:
#   2
#   false
#   2

def main() -> None:
    flags_src: list[bool] = [true]
    mut flags = flags_src
    flags.append(false)
    println(len(flags))
    println(flags[1])
    mut current = 1
    current = 2
    println(current)
