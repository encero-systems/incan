# behavior: a model imported from another module with a required private field, plain or of a private nominal type, cannot be constructed from its public fields alone
# expect-diagnostic: INCAN-T0001

from vaults import Vault, Sealed


def main() -> None:
    vault = Vault(label="x")
    sealed = Sealed(label="y")
    println(vault.label)
    println(sealed.label)
