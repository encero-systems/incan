# behavior: a trait default method taking a `mut` list parameter appends to the caller's list and returns the new length, and the caller reads the appended length back
# expect-stdout:
#   3
#   3

trait Replacer:
    def replace(self, mut items: list[int]) -> int:
        items.append(9)
        return len(items)


model Widget with Replacer:
    id: int


def main() -> None:
    mut items: list[int] = [1, 2]
    println(Widget(id=1).replace(items))
    println(len(items))
