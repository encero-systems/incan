# behavior: a default argument that calls a function imported from a sibling module is evaluated when the parameter is omitted, at a call from a module that does not import that function itself and at a call from main, and an explicit argument replaces it
# expect-stdout:
#   8
#   8
#   3
#   7

from ops import combine
from defaults import fallback
from caller import combined


def main() -> None:
    println(combined())
    println(combine(1))
    println(combine(1, 2))
    println(fallback())
