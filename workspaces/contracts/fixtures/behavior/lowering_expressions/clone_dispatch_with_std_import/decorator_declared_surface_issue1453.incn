# Former case decorator_declared_surface_issue1453: a decorator declared after the function it decorates and a factory decorator both keep the decorated function's declared union surface, and an undecorated function is untouched (#1453)

type Answer = int | str


@preserve
def echo(value: Answer) -> Answer:
    return value


@configure()
def twice(value: Answer) -> Answer:
    return value


def preserve(func: (Answer) -> Answer) -> ((Answer) -> Answer):
    println("preserve wrapped")
    return func


def configure() -> (((Answer) -> Answer) -> ((Answer) -> Answer)):
    println("configure wrapped")
    return preserve


def plain(value: int) -> int:
    return value + 1


def show(label: str, value: Answer) -> None:
    match value:
        case int(number):
            println(f"{label} int {number}")
        case str(text):
            println(f"{label} str {text}")


pub def main() -> None:
    show("echo", echo(42))
    show("echo", echo("hello"))
    show("twice", twice(7))
    println(f"plain {plain(2)}")
