# behavior: nested Option assignments wrap each layer in declarations and reassignments, including an existing None payload as Some(None)
# expect-stdout:
#   5
#   0
#   1
#   6
#   none

def main() -> None:
    a: Option[Option[int]] = 5
    println(a.unwrap().unwrap())
    mut b: Option[Option[list[int]]] = None
    b = []
    println(len(b.unwrap().unwrap()))
    c: Option[Option[list[int]]] = [1]
    println(len(c.unwrap().unwrap()))
    mut inner: Option[Option[int]] = None
    inner = 6
    match inner:
        Some(value) => println(value.unwrap_or(7))
        None => println("none")
    outer: Option[Option[int]] = None
    match outer:
        Some(value) => println(value.unwrap_or(7))
        None => println("none")
    missing: Option[int] = None
    wrapped_missing: Option[Option[int]] = missing
    match wrapped_missing:
        Some(value) =>
            match value:
                None => pass
                Some(_value) => assert false
        None => assert false
