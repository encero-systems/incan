# Former case empty_list_argument_takes_instantiated_element_type: an empty list passed to a generic list parameter takes the element type another argument or the explicit type argument gives its type parameter

def first_or[T](items: list[T], default: T) -> T:
    println(len(items))
    return default


def count[T](items: list[T]) -> int:
    return len(items)


pub def main() -> None:
    println(first_or([], 5))
    println(count[str]([]))
