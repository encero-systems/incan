# behavior: set and dict len execute from canonical builtin identity
# expect-stdout:
#   2200

"""Set and dict len execute from canonical builtin identity."""
def observe() -> int:
  """Encode lengths of populated and empty sets and dictionaries."""
  values = {1, 1, 2}
  mapping = {"a": 1, "a": 2, "b": 3}
  empty_values: set[int] = Set()
  empty_mapping: dict[str, int] = Dict()
  return len(values) * 1000 + len(mapping) * 100 + len(empty_values) * 10 + len(empty_mapping)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(observe())
