# behavior: `+` between two lists concatenates them (parity corpus case 23)
# expect-stdout:
#   [1, 2, 3]

"""`+` between two lists concatenates them (parity corpus case 23)."""
def joined(xs: List[int], ys: List[int]) -> List[int]:
    """Return the fixture expression `xs + ys`."""
    return xs + ys


def main() -> None:
    """Print the fixture values in the expected order."""
    println(joined([1], [2, 3]))
