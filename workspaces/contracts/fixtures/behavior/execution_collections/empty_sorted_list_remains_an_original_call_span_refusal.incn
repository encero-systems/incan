# behavior: empty sorted list remains an original call span refusal
# expect-stdout:
#   0

"""Empty sorted list remains an original call span refusal."""
def observe() -> int:
  """Attempt to sort a typed empty list and return its length."""
  values: list[int] = []
  return len(sorted(values))


def main() -> None:
    """Print the fixture values in the expected order."""
    println(observe())
