# behavior: sorting and sum preserve frozen and owned lists, handle empty lists, and evaluate operands once (#2256)
# expect-stdout:
#   sorted int list
#   29320233
#   sorted operand
#   12
#   sorted int list
#   29320233
#   0
#   2
#   [1, 2, 3]
#   6
#   a b
#   b

"""Exercise integer-list sorting while proving that the input list remains reusable."""

const NUMBERS: FrozenList[int] = [3, 1, 2]
const NAMES: FrozenList[str] = ["b", "a"]


def sorted_int_list() -> int:
    """Return a deterministic score that combines original and sorted traversal order."""
    values = [3, -1, 3, 2]
    ordered = sorted(values)
    mut original_score = 0
    for original_value in values:
        original_score = original_score * 10 + original_value
    mut ordered_score = 0
    for ordered_value in ordered:
        ordered_score = ordered_score * 10 + ordered_value
    println("sorted int list")
    return original_score * 10000 + ordered_score + 1000


def marked() -> list[int]:
    """Print once when the sorted operand is evaluated."""
    println("sorted operand")
    return [2, 1]


def observe() -> int:
    """Encode the sorted order of the marked operand."""
    ordered = sorted(marked())
    mut score = 0
    for value in ordered:
        score = score * 10 + value
    return score


def program_result() -> int:
    """Return the sorting profile through a source call."""
    return sorted_int_list()


def empty_sorted() -> int:
    """Sort a typed empty list without inventing elements."""
    values: list[int] = []
    return len(sorted(values))


def ordinary_sorted() -> int:
    """Retain the result of an ordinary sorted call."""
    return len(sorted([2, 1]))


def main() -> None:
    """Print the fixture values in the expected order."""
    println(sorted_int_list())
    println(observe())
    println(program_result())
    println(empty_sorted())
    println(ordinary_sorted())
    println(sorted(NUMBERS))
    println(sum(NUMBERS))
    names = sorted(NAMES)
    println(f"{names[0]} {names[1]}")
    println(NAMES[0])
