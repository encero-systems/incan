# behavior: a mut list parameter is written through an index and read into a tuple (parity corpus row replacement-body-v0-012)
# expect-stdout:
#   42

"""A mut list parameter is written through an index and read into a tuple (parity corpus row replacement-body-v0-012)."""
def score(mut values: list[int]) -> int:
    """Mutate the first list element and score the resulting tuple."""
    values[0] = 40
    pair = (values[0], 2)
    return pair.0 + pair.1

def structural_values() -> int:
    """Pass a mutable list to the scoring function."""
    mut values = [1, 2]
    return score(values)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(structural_values())
