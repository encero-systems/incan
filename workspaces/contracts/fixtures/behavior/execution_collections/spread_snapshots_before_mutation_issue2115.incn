# behavior: list spreads observe their sources once in written order around a mutation (#2115)
# pending: #2115 the leading spread observes the later source mutation
# expect-stdout:
#   4
#   1 7 1 9
#   2

def change(mut source: list[int]) -> int:
    """Make the later spread observe an additional element."""
    source.append(9)
    return 7


def main() -> None:
    """Read the same source before and after the mutating element."""
    mut source = [1]
    result = [*source, change(source), *source]
    println(len(result))
    println(f"{result[0]} {result[1]} {result[2]} {result[3]}")
    println(len(source))
