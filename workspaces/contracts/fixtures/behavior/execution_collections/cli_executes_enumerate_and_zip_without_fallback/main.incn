"""Run the program of each former case in order."""

import cli_executes_enumerate_and_zip_without_fallback
import cli_refuses_nonlist_enumerate_without_a_successful_receipt
import clone_of_a_value_from_a_fallible_method_chain
import collection_len_matches_the_receipt_backed_native_route
import enumerate_and_zip_follow_bare_local_aliases
import executes_deferred_enumerate_and_zip_frames_with_distinct_bindings
import executes_scalar_tuple_collection_destructuring_with_a_replacement_rece
import hashed_construction_preserves_source_side_effect_order
import hashed_membership_matches_the_receipt_backed_native_route
import hashed_non_membership_operations_remain_refused


def main() -> None:
    """Run each former case's program in turn."""
    cli_executes_enumerate_and_zip_without_fallback.main()
    cli_refuses_nonlist_enumerate_without_a_successful_receipt.main()
    clone_of_a_value_from_a_fallible_method_chain.main()
    collection_len_matches_the_receipt_backed_native_route.main()
    enumerate_and_zip_follow_bare_local_aliases.main()
