# behavior: dictionaries index and update, sets and dictionaries iterate silently and display or compare structurally, and tuple keys support membership
# expect-stdout:
#   2
#   true
#   {1}
#   {1: 2}
#   true
#   true
#   true
#   true

"""Observe dictionary operations and structural hashed-container behavior."""
def program_result() -> int:
  """Compute and return `values[1]`."""
  values = {1: 2}
  return values[1]


def updated_dictionary() -> bool:
    """Update a dictionary entry before testing its key."""
    mut values = {1: 2}
    values[1] = 3
    return 1 in values


def silent_set_iteration() -> None:
    """Iterate a set without producing output."""
    values = {1, 2}
    for value in values:
        pass


def silent_dict_iteration() -> None:
    """Iterate a dictionary without producing output."""
    values = {1: 2}
    for value in values:
        pass


def set_equality() -> bool:
    """Compare sets structurally."""
    return {1} == {1}


def dict_equality() -> bool:
    """Compare dictionaries structurally."""
    return {1: 2} == {1: 2}


def tuple_set_key() -> bool:
    """Find a tuple key in a set."""
    values = {(1, 2)}
    return (1, 2) in values


def tuple_dict_key() -> bool:
    """Test a tuple key's absence in a typed empty dictionary."""
    values: dict[tuple[int, int], int] = {}
    return (1, 2) not in values


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
    println(updated_dictionary())
    silent_set_iteration()
    silent_dict_iteration()
    println({1})
    println({1: 2})
    println(set_equality())
    println(dict_equality())
    println(tuple_set_key())
    println(tuple_dict_key())
