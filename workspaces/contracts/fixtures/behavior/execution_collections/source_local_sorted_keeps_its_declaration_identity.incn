# behavior: source local sorted keeps its declaration identity
# expect-stdout:
#   42

"""Source local sorted keeps its declaration identity."""
def sorted(value: int) -> int:
  """Return the fixture expression `value + 1`."""
  return value + 1

def observe() -> int:
  """Return the fixture expression `sorted(41)`."""
  return sorted(41)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(observe())
