# behavior: a generic model whose method interpolates its type parameter renders an int, a str and a float payload through that method
# expect-stdout:
#   boxed 7
#   boxed seven
#   boxed 7.5

model Boxed[T with Display]:
    value: T

    def render(self) -> str:
        return f"boxed {self.value}"


def main() -> None:
    println(Boxed(value=7).render())
    println(Boxed(value="seven").render())
    println(Boxed(value=7.5).render())
