# behavior: a generic value passed to a method twice from a generic function comes back in both results, and a generic field of a wrapper passed to a generic function is still readable from the wrapper
# expect-stdout:
#   ["x", "x"]
#   taken 4 kept 4

model Client:
    def send[T](self, value: T) -> list[T]:
        return [value]


model Wrapper[T]:
    cursor: T


def send_twice[T](client: Client, value: T) -> list[T]:
    first = client.send(value)
    second = client.send(value)
    return first + second


def take[T with Display](value: T) -> str:
    return f"taken {value}"


def read_cursor[T with Display](other: Wrapper[T]) -> str:
    return take(other.cursor) + f" kept {other.cursor}"


def main() -> None:
    sent = send_twice(Client(), "x")
    println(f"{sent:?}")
    println(read_cursor(Wrapper(cursor=4)))
