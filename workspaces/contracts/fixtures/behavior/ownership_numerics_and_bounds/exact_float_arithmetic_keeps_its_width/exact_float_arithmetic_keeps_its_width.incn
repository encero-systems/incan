# Former case exact_float_arithmetic_keeps_its_width: arithmetic between two f32 values stays f32 (0.1 + 0.2 prints as 0.3, and subtraction, multiplication, division and modulo keep that precision), an f32 mixed with a float, an f64 or an int widens to float precision on either side, and float values are accepted at f64 destinations, since an f64 is a float

def widened(value: float) -> f64:
    return value


pub def main() -> None:
    narrow_left: f32 = 0.1
    narrow_right: f32 = 0.2
    println(narrow_left + narrow_right)
    half: f32 = 0.5
    println(f"{half - narrow_right} {half * half} {half / narrow_right} {narrow_left % half}")
    wide_left: f64 = 0.1
    wide_right: f64 = 0.2
    println(wide_left + wide_right)
    mixed: float = 0.2
    println(narrow_left + mixed)
    println(mixed + narrow_left)
    println(narrow_left + wide_right)
    println(wide_right + narrow_left)
    println(half * 1.0)
    println(half + 2)
    println(3 + half)
    exact: f64 = 1.25
    println(f"{exact} {widened(1.25)}")
