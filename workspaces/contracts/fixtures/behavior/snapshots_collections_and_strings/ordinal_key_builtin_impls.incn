# behavior: generic OrdinalKey calls preserve primitive and value-enum encodings and reject malformed key records
# expect-stdout:
#   str:4
#   i32:4
#   bool:bool:u8
#   decimal:17:decimal128:coefficient-i128-le:scale-u8
#   status:4:value-enum:str:main.Status:4:paid;4:open;:v1
#   http:8

from std.collections import OrdinalKey, OrdinalMapError


enum Status(str):
    Paid = "paid"
    Open = "open"


enum HttpStatus(int):
    Ok = 200
    NotFound = 404


pub def key_bytes[T with OrdinalKey](value: T) -> bytes:
    return value.ordinal_bytes()


pub def key_encoding[T with OrdinalKey](_value: T) -> str:
    return T.ordinal_encoding()


pub def str_bytes(value: str) -> bytes:
    return key_bytes(value)


pub def i32_bytes(value: i32) -> bytes:
    return key_bytes(value)


pub def bool_encoding(value: bool) -> str:
    return key_encoding(value)


pub def decimal_bytes(value: decimal[5, 2]) -> bytes:
    return key_bytes(value)


pub def decimal_encoding(value: decimal[5, 2]) -> str:
    return key_encoding(value)


pub def status_bytes(value: Status) -> bytes:
    return key_bytes(value)


pub def status_encoding(value: Status) -> str:
    return key_encoding(value)


pub def http_status_bytes(value: HttpStatus) -> bytes:
    return key_bytes(value)


pub def decoded_key[T with OrdinalKey](data: bytes) -> Result[T, OrdinalMapError]:
    """Decode a primitive key through its checked associated trait slot.

    1. Invoke the target key type's decoder and preserve its structured error.
    """
    # 1. Invoke the checked decoder and preserve its structured error.
    return T.from_ordinal_bytes(data)


def check_primitive_decoding() -> None:
    """Verify signed and decimal round trips and rejection of malformed records."""
    match decoded_key[i32](b"\xff\xff\xff\xff"):
        Ok(value) => assert value == -1i32
        Err(_error) => assert false
    match decoded_key[int](b"\xff\xff\xff\xff\xff\xff\xff\xff"):
        Ok(value) => assert value == -1
        Err(_error) => assert false
    match decoded_key[i32](b"\x01"):
        Ok(_value) => assert false
        Err(_error) => pass
    match decoded_key[bool](b"\x01"):
        Ok(value) => assert value
        Err(_error) => assert false
    match decoded_key[bool](b"\x00"):
        Ok(value) => assert not value
        Err(_error) => assert false
    match decoded_key[bool](b"\x02"):
        Ok(_value) => assert false
        Err(_error) => pass
    price: decimal[5, 2] = 19.99d
    match decoded_key[decimal[5, 2]](decimal_bytes(price)):
        Ok(value) => assert value == price
        Err(_error) => assert false
    match decoded_key[decimal[5, 2]](b""):
        Ok(_value) => assert false
        Err(_error) => pass


def main() -> None:
    """Observe primitive and value-enum ordinal keys through the public generic contract.

    1. Check primitive encodings and exact integer and decimal bytes.
    2. Check value-enum bytes and ordered encoding schemas.
    3. Check primitive decoders and their malformed-record errors.
    """
    # 1. Check primitive encodings and exact integer and decimal bytes.
    println(f"str:{len(str_bytes("paid"))}")
    narrow: i32 = 7
    assert i32_bytes(narrow) == b"\x07\x00\x00\x00"
    assert i32_bytes(-1i32) == b"\xff\xff\xff\xff"
    println(f"i32:{len(i32_bytes(narrow))}")
    println(f"bool:{bool_encoding(true)}")
    assert key_bytes(true) == b"\x01"
    assert key_bytes(false) == b"\x00"
    price: decimal[5, 2] = 19.99d
    encoded_price = decimal_bytes(price)
    assert encoded_price[0] == 207u8
    assert encoded_price[1] == 7u8
    assert encoded_price[16] == 2u8
    for index in range(2, 16):
        assert encoded_price[index] == 0u8
    println(f"decimal:{len(decimal_bytes(price))}:{decimal_encoding(price)}")
    # 2. Check value-enum bytes and ordered encoding schemas.
    println(f"status:{len(status_bytes(Status.Paid))}:{status_encoding(Status.Open)}")
    println(f"http:{len(http_status_bytes(HttpStatus.NotFound))}")
    # 3. Check primitive decoders and their malformed-record errors.
    check_primitive_decoding()
