# behavior: stored hashers preserve incremental updates, and SHA-224 and HMAC retain their associated output lengths (#969, #2256)
# expect-stdout:
#   true
#   false

from std.hash import Sha256Hasher, hmac_sha256, sha224, sha256


model StructuralSink:
    hasher: Sha256Hasher

    def append(mut self, chunk: bytes) -> None:
        self.hasher.update(chunk)

    def finalize(mut self) -> bytes:
        return self.hasher.finalize_bytes()


def main() -> None:
    assert len(sha224.digest(b"")) == 28
    assert len(hmac_sha256.digest(b"", b"")) == 32
    mut sink = StructuralSink(hasher=sha256.new())
    sink.append(b"a")
    sink.append(b"bc")
    println(sink.finalize() == sha256.digest(b"abc"))
    mut other = StructuralSink(hasher=sha256.new())
    other.append(b"abd")
    println(other.finalize() == sha256.digest(b"abc"))
