# Former case list_str_append_literal: a str list accepts an element from another list and a string literal through append (#391)

pub def columns(input_columns: list[str]) -> list[str]:
    mut columns: list[str] = []
    columns.append(input_columns[0])
    columns.append("count")
    return columns


pub def main() -> None:
    result = columns(["orders_total"])
    println(" ".join(result))
