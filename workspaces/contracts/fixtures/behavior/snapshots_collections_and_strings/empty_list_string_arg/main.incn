"""Run the program of each former case in order."""

import empty_list_string_arg
import enumerate_tuple_unpack
import generator_expression_and_yield
import imported_stdlib_value_fragment
import iterator_adapter_sources
import json_stringify_builtin
import list_and_comprehension_over_generator
import list_append_takes_a_fresh_task_handle
import list_repeat
import list_str_append_literal


async def main() -> None:
    """Run each former case's program in turn."""
    empty_list_string_arg.main()
    enumerate_tuple_unpack.main()
    generator_expression_and_yield.main()
    imported_stdlib_value_fragment.main()
    iterator_adapter_sources.main()
    json_stringify_builtin.main()
    list_and_comprehension_over_generator.main()
    await list_append_takes_a_fresh_task_handle.main()
    list_repeat.main()
    list_str_append_literal.main()
