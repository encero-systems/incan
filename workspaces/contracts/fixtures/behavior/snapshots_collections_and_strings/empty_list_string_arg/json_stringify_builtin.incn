# Former case json_stringify_builtin: json_stringify evaluates its operand exactly once through both spellings, serializes None as null and keeps the full width of an int

def next_value() -> str:
    println("evaluated")
    return "line\né"


pub def main() -> None:
    println(json_stringify(next_value()))
    println(std.builtins.json_stringify(next_value()))
    println(json_stringify(None))
    println(json_stringify(9223372036854775807))
