"""An async main awaits an async function's value (parity corpus case 10)."""

async def fetch() -> int:
    """Return `7` for this fixture."""
    return 7


pub async def main() -> None:
    """Print `value` after preparing the fixture inputs."""
    value = await fetch()
    println(value)
