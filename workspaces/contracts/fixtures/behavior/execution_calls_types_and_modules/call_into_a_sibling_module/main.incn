# behavior: a direct import and a module alias both call the same sibling function
# expect-stdout:
#   42
#   42

"""Observe the direct and module-qualified calls with one sibling helper."""

from direct import observe as observe_direct
from renamed import observe as observe_renamed


def main() -> None:
    """Run the direct and module-qualified observations in order."""
    observe_direct()
    observe_renamed()
