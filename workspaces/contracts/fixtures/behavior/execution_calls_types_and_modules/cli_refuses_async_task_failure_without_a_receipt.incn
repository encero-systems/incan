# behavior: cli refuses async task failure without a receipt
# expect-stdout:
# expect-exit: 101

"""Cli refuses async task failure without a receipt."""
import std.async

async def child() -> int:
  """Fail the assertion when this callable is reached."""
  assert false
  return 7

async def program_result() -> int:
  """Return the fixture expression `await child()`."""
  return await child()


async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
