"""Run the program of each former case in order."""

import executes_lazy_generator_adapters_with_local_callbacks
import executes_partial_presets_source_defaults_and_named_overrides
import executes_source_local_fieldless_enum_values_through_a_direct_callable
import executes_source_local_nominal_model_values_through_a_direct_callable
import executes_source_local_value_enum_members_through_a_direct_callable
