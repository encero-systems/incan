import keeps_an_unconsumed_generator_expression_deferred
import keeps_an_unconsumed_generator_function_out_of_execution_evidence


async def main() -> None:
    """Run each former case's program in turn."""
    executes_lazy_generator_adapters_with_local_callbacks.main()
    executes_partial_presets_source_defaults_and_named_overrides.main()
    executes_source_local_fieldless_enum_values_through_a_direct_callable.main()
    executes_source_local_nominal_model_values_through_a_direct_callable.main()
