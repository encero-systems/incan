# Former case executes_source_order_async_race_ties_with_loser_cancellation: executes source order async race ties with loser cancellation

"""Executes source order async race ties with loser cancellation."""

async def first() -> int:
  """Return `1` for this fixture."""
  return 1

async def second() -> int:
  """Return `2` for this fixture."""
  return 2

async def program_result() -> int:
  """Compute and return `winner`."""
  winner = race for value:
    await first() => value
    await second() =>
      assert value == 999
      value
  return winner


pub async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
