def main() -> None:
    """Print the fixture values in the expected order."""
    println(local_lexical_function_scope())
    println(local_lexical_block_scope())
    println(imported_lexical_function_scope())
    println(imported_lexical_block_scope())
    println(aliased_lexical_function_scope())
    println(aliased_lexical_block_scope())
    println(reexported_lexical_function_scope())
    println(reexported_lexical_block_scope())
    println(local_member_function_scope())
    println(local_member_block_scope())
    println(imported_member_function_scope())
    println(imported_member_block_scope())
    println(aliased_member_function_scope())
    println(aliased_member_block_scope())
    println(reexported_member_function_scope())
    println(reexported_member_block_scope())
    println(imported_path_function_scope())
