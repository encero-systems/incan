def reexported_lexical_block_scope() -> int:
    """Resolve the reexported lexical block scope call and return its value."""
    if true:
        return lexical_reexport(7)
    return 0

def local_member_function_scope() -> int:
    """Resolve the local member function scope call and return its value."""
    local = LocalMember(value=9)
    return local.read()

def local_member_block_scope() -> int:
    """Resolve the local member block scope call and return its value."""
    local = LocalMember(value=10)
    if true:
        return local.read()
    return 0

def imported_member_function_scope() -> int:
    """Resolve the imported member function scope call and return its value."""
    imported = ImportedMember(value=11)
    return imported.read()

def imported_member_block_scope() -> int:
    """Resolve the imported member block scope call and return its value."""
    imported = ImportedMember(value=12)
    if true:
        return imported.read()
    return 0

def aliased_member_function_scope() -> int:
    """Resolve the aliased member function scope call and return its value."""
    aliased = MemberAlias(value=13)
    return aliased.read()

def aliased_member_block_scope() -> int:
    """Resolve the aliased member block scope call and return its value."""
    aliased = MemberAlias(value=14)
    if true:
        return aliased.read()
    return 0

def reexported_member_function_scope() -> int:
    """Resolve the reexported member function scope call and return its value."""
    relayed = MemberReexport(value=15)
    return relayed.read()

def reexported_member_block_scope() -> int:
    """Resolve the reexported member block scope call and return its value."""
    relayed = MemberReexport(value=16)
    if true:
        return relayed.read()
    return 0

def imported_path_function_scope() -> int:
    """Return the fixture expression `identity_provider.imported_path(17)`."""
    return identity_provider.imported_path(17)

def imported_path_block_scope() -> int:
    """Resolve the imported path block scope call and return its value."""
    if true:
        return identity_provider.imported_path(17)
    return 0

def aliased_path_function_scope() -> int:
    """Return the fixture expression `provider_alias.aliased_path(19)`."""
