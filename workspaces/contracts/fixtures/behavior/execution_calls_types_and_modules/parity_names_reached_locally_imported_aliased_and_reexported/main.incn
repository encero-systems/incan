"""Functions, model methods and module paths reached locally, imported, aliased and re-exported through a facade, each from function and block scope (parity corpus identity matrix)."""
from identity_provider import ImportedMember, imported_lexical
from identity_provider import AliasedMember as MemberAlias, aliased_lexical as lexical_alias
from identity_facade import RelayedMember as MemberReexport, relayed_lexical as lexical_reexport
import identity_provider
import identity_provider as provider_alias

def local_lexical(value: int) -> int:
    """Return `value` for this fixture."""
    return value

model LocalMember:
    """Hold value used by this fixture."""
    value: int

    def read(self) -> int:
        """Return `self.value` for this fixture."""
        return self.value

def local_lexical_function_scope() -> int:
    """Return the fixture expression `local_lexical(1)`."""
    return local_lexical(1)

def local_lexical_block_scope() -> int:
    """Resolve the local lexical block scope call and return its value."""
    if true:
        return local_lexical(1)
    return 0

def imported_lexical_function_scope() -> int:
    """Return the fixture expression `imported_lexical(3)`."""
    return imported_lexical(3)

def imported_lexical_block_scope() -> int:
    """Resolve the imported lexical block scope call and return its value."""
    if true:
        return imported_lexical(3)
    return 0

def aliased_lexical_function_scope() -> int:
    """Return the fixture expression `lexical_alias(5)`."""
    return lexical_alias(5)

def aliased_lexical_block_scope() -> int:
    """Resolve the aliased lexical block scope call and return its value."""
    if true:
