# behavior: cli executes same error result routing with a replacement receipt
# expect-stdout:
#   2

"""Cli executes same error result routing with a replacement receipt."""
enum Failure:
  """Represent the Odd alternatives in this fixture."""
  Odd

def half(value: int) -> Result[int, Failure]:
  """Halve an even value or return the odd-value error."""
  if value % 2 != 0:
    return Err(Failure.Odd)
  return Ok(value // 2)

def quarter(value: int) -> Result[int, Failure]:
  """Apply checked halving twice, propagating either error."""
  half_value = half(value)?
  return half(half_value)

def program_result() -> int:
  """Choose the result by matching `quarter(8)`."""
  match quarter(8):
    case Ok(value):
      return value
    case Err(_):
      return 0
  return 0


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
