# behavior: non scalar checked value types refuse before effects
# expect-stdout:
#   must not run
#   true

"""Non scalar checked value types refuse before effects."""
def probe(value: int | List[int]) -> bool:
  """Emit the pre-check marker before testing the value."""
  println("must not run")
  return isinstance(value, int)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(probe(1))
