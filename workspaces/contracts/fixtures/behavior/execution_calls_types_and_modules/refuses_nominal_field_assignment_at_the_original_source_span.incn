# behavior: refuses nominal field assignment at the original source span
# expect-stdout:
#   41


"""Refuses nominal field assignment at the original source span."""
model Pair:
  """Hold left and right used by this fixture."""
  left: int
  right: int

def program_result() -> int:
  """Compute and return `pair.left`."""
  mut pair = Pair(left=40, right=2)
  pair.left = 41
  return pair.left


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
