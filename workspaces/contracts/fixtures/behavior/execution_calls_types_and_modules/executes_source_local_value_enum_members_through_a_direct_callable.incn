# behavior: value enum members preserve their integer or string values through source parameters, direct calls and from_value construction
# expect-stdout:
#   404
#   404
#   404
#   404
#   404
#   42


"""Executes source local value enum members through a direct callable."""
enum HttpStatus(int):
  """Represent the Ok, NotFound alternatives in this fixture."""
  Ok = 200
  NotFound = 404

enum Environment(str):
  """Represent the Development, Production alternatives in this fixture."""
  Development = "development"
  Production = "production"

def status_code(status: HttpStatus) -> int:
  """Return the fixture expression `status.value()`."""
  return status.value()

def extract_environment(environment: Environment) -> str:
  """Return the fixture expression `environment.value()`."""
  return environment.value()

def environment_name() -> str:
  """Return the fixture expression `extract_environment(Environment.Production)`."""
  return extract_environment(Environment.Production)

def program_result() -> int:
  """Return the fixture expression `status_code(HttpStatus.NotFound)`."""
  return status_code(HttpStatus.NotFound)


enum Status(int):
    """Keep a second enum with its own integer member identity."""
    Ok = 200
    Missing = 404


def direct_status_code() -> int:
    """Read a member without passing it as an argument."""
    return HttpStatus.NotFound.value()


def value_enum_values() -> int:
    """Pass the selected member through the value-parameter caller."""
    return status_code(HttpStatus.NotFound)


def other_status() -> int:
    """Read the other enum's declared member."""
    return Status.Missing.value()


def constructed_status() -> int:
    """Construct from a known value before returning the marker."""
    parsed = HttpStatus.from_value(404)
    return 42


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
    println(direct_status_code())
    println(value_enum_values())
    println(direct_status_code())
    println(other_status())
    println(constructed_status())
