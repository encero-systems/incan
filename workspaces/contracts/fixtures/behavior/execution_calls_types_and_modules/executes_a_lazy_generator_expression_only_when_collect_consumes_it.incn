# behavior: executes a lazy generator expression only when collect consumes it
# expect-stdout:
#   70


"""Executes a lazy generator expression only when collect consumes it."""
def program_result() -> int:
  """Compute and return `values[0] + values[1]`."""
  values = (value * 10 for value in range(1, 5) if value > 2).collect()
  return values[0] + values[1]


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
