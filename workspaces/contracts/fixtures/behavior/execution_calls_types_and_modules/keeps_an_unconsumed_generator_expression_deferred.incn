# behavior: keeps an unconsumed generator expression deferred
# expect-stdout:
#   7


"""Keeps an unconsumed generator expression deferred."""
def program_result() -> int:
  """Compute and return `7`."""
  unused = (value // 0 for value in range(1, 2))
  return 7


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
