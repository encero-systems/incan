"""Run the program of each former case in order."""

import a_function_passed_as_a_value
import a_shadow_request_does_not_alter_replacement_execution
import assert_is_none_passes_on_an_absent_option
import checked_nominal_target_refuses_at_its_retained_reference_span
import cli_executes_direct_named_callable_with_a_replacement_receipt
import cli_executes_exact_std_async_activation_with_task_receipts
import cli_executes_typed_body_ir_and_persists_a_replacement_receipt
import cli_executes_typed_empty_scalar_tuple_list_with_a_replacement_receipt
import cli_json_report_projects_canonical_execution_evidence
import cli_refuses_an_unsupported_sibling_without_a_receipt
import a_model_declared_in_an_import_cycle
import a_rust_import_in_an_imported_module
import call_into_a_module_lowered_on_its_own
import facade_chain_shares_one_declaration
import parity_names_reached_locally_imported_aliased_and_reexported
import typed_list_in_a_callee_module


async def main() -> None:
    """Run each former case's program in turn."""
    a_function_passed_as_a_value.main()
    a_shadow_request_does_not_alter_replacement_execution.main()
    assert_is_none_passes_on_an_absent_option.main()
    checked_nominal_target_refuses_at_its_retained_reference_span.main()
    cli_executes_direct_named_callable_with_a_replacement_receipt.main()
    await cli_executes_exact_std_async_activation_with_task_receipts.main()
    cli_executes_typed_body_ir_and_persists_a_replacement_receipt.main()
    cli_executes_typed_empty_scalar_tuple_list_with_a_replacement_receipt.main()
    cli_json_report_projects_canonical_execution_evidence.main()
    cli_refuses_an_unsupported_sibling_without_a_receipt.main()
    a_model_declared_in_an_import_cycle.main()
    a_rust_import_in_an_imported_module.main()
    call_into_a_module_lowered_on_its_own.main()
    facade_chain_shares_one_declaration.main()
    parity_names_reached_locally_imported_aliased_and_reexported.main()
    typed_list_in_a_callee_module.main()
