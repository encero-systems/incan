# Former case cli_executes_exact_std_async_activation_with_task_receipts: checked async syntax selects the runtime without a standard-library import, and awaited task receipts reach the caller

"""Execute async syntax and task receipts without an activation import."""

async def child() -> int:
  """Return `7` for this fixture."""
  return 7

async def program_result() -> int:
  """Return the fixture expression `await child()`."""
  return await child()


pub async def main() -> None:
    """Print the fixture values in the expected order."""
    println(await program_result())
