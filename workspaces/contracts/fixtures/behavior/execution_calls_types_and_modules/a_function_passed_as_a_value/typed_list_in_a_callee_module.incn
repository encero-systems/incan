# Former case typed_list_in_a_callee_module: a u8 list built in a callee module returns its element to the caller

"""A u8 list built in a callee module returns its element to the caller."""
from helper import widen


def program_result() -> u8:
    """Compute and return `widen(start)`."""
    start: u8 = 41
    return widen(start)


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
