# behavior: refuses an unsupported callable default at its original span
# expect-stdout:
#   1


"""Refuses an unsupported callable default at its original span."""
def keep(payload: bytes = b"x") -> bytes:
  """Return `payload` for this fixture."""
  return payload

def program_result() -> int:
  """Compute and return `1`."""
  keep()
  return 1


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
