# behavior: refuses enum targets whose canonical member disagrees with the physical record
# expect-stdout:
#   false

"""Refuses enum targets whose canonical member disagrees with the physical record."""
enum Signal:
  """Represent the Ready, Stop alternatives in this fixture."""
  Ready
  Stop

def program_result() -> bool:
  """Return the fixture expression `Signal.Ready == Signal.Stop`."""
  return Signal.Ready == Signal.Stop


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
