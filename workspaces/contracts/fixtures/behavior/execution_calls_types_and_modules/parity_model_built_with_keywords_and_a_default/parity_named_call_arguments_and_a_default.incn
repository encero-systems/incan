# Former case parity_named_call_arguments_and_a_default: a call binds keyword arguments by name and falls back to a default (parity corpus case 9)

"""A call binds keyword arguments by name and falls back to a default (parity corpus case 9)."""
def scale(value: int, factor: int = 2) -> int:
    """Return the fixture expression `value * factor`."""
    return value * factor


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(scale(factor=3, value=4))
    println(scale(5))
