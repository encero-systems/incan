"""Run the program of each former case in order."""

import index_trait_adoption
import local_serde_named_marker_traits
import newtype_builder_methods
import newtype_checked_construction
import newtype_implicit_coercion
import newtype_with_serialize_trait


def main() -> None:
    """Run each former case's program in turn."""
    index_trait_adoption.main()
    local_serde_named_marker_traits.main()
    newtype_builder_methods.main()
    newtype_checked_construction.main()
    newtype_implicit_coercion.main()
    newtype_with_serialize_trait.main()
