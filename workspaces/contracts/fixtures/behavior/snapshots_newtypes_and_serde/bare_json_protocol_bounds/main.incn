"""Run the program of each former case in order."""

import bare_json_protocol_bounds
import json_protocol_supertraits
import newtype_generic
import newtype_json_validation
import partial_alias_derive
import qualified_json_derives
import qualified_json_trait_dispatch
import serialize_trait_adoption
import cross_module_validation_issue2009
import facade_reexported_serde_traits
import user_module_derivables


def main() -> None:
    """Run each former case's program in turn."""
    bare_json_protocol_bounds.main()
    json_protocol_supertraits.main()
    newtype_generic.main()
    newtype_json_validation.main()
    partial_alias_derive.main()
    qualified_json_derives.main()
    qualified_json_trait_dispatch.main()
    serialize_trait_adoption.main()
    cross_module_validation_issue2009.main()
    facade_reexported_serde_traits.main()
    user_module_derivables.main()
