# behavior: explicit newtype construction through a direct or renamed import calls from_underlying once per value (#2009)
# expect-stdout:
#   validated
#   0.5
#   validated
#   0.5

from percentile import Percentile


def main() -> None:
    """Construct a valid value through the imported newtype."""
    checked = Percentile(0.5)
    println(checked.0)
