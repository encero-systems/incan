# Former case cross_module_validation_issue2009: explicit newtype construction through a direct or renamed import calls from_underlying once per value (#2009)

"""Observe both newtype import forms with one shared producer."""

from direct import observe as observe_direct
from renamed import observe as observe_renamed


pub def main() -> None:
    """Run the direct and renamed constructions in order."""
    observe_direct()
    observe_renamed()
