# behavior: appending through a mut list parameter, directly and through a helper that forwards the parameter twice, changes the caller's list, which is then searched, indexed and measured in place
# expect-stdout:
#   [1, 2, 3]
#   [1, 2, 3, 3, 3]
#   true
#   2
#   5

def push_three(mut items: list[int]) -> None:
    items.append(3)


def push_twice(mut items: list[int]) -> None:
    push_three(items)
    push_three(items)


def main() -> None:
    mut items = [1, 2]
    push_three(items)
    println(f"{items:?}")
    push_twice(items)
    println(f"{items:?}")
    println(3 in items)
    println(items.index(3))
    println(len(items))
