# behavior: appending through a mut list parameter changes the caller's list, including a scalar argument read from that same list before its mutable borrow (#2256)
# expect-stdout:
#   [1, 2, 3]
#   [1, 2, 3, 3, 3]
#   true
#   2
#   5
#   [1, 2, 3, 3, 3, 3]

def push_three(mut items: list[int]) -> None:
    items.append(3)


def push_twice(mut items: list[int]) -> None:
    push_three(items)
    push_three(items)


def push_value(mut items: list[int], value: int) -> None:
    """Append a scalar argument evaluated before the call borrows its container."""
    items.append(value)


def main() -> None:
    """Observe forwarded mutations and a sibling argument reading its mutable owner."""
    mut items = [1, 2]
    push_three(items)
    println(f"{items:?}")
    push_twice(items)
    println(f"{items:?}")
    println(3 in items)
    println(items.index(3))
    println(len(items))
    push_value(items, items[-1])
    println(f"{items:?}")
