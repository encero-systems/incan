"""Run the program of each former case in order."""

import generic_list_comprehension_consumes_parameter
import method_frame_borrows_receiver_and_input
import mut_self_call_on_a_loop_item_inside_an_expression
import mut_tuple_parameter_elements_changed_in_place
import mutable_list_parameter_changes_reach_the_caller
import mutable_string_parameter_from_literal_and_variable
import result_methods_leave_their_receiver_usable
import self_and_wrapped_fields_returned_as_values
import view_type_from_one_source
import zip_loop_changing_one_operand_in_place


def main() -> None:
    """Run each former case's program in turn."""
    generic_list_comprehension_consumes_parameter.main()
    method_frame_borrows_receiver_and_input.main()
    mut_self_call_on_a_loop_item_inside_an_expression.main()
    mut_tuple_parameter_elements_changed_in_place.main()
    mutable_list_parameter_changes_reach_the_caller.main()
    mutable_string_parameter_from_literal_and_variable.main()
    result_methods_leave_their_receiver_usable.main()
    self_and_wrapped_fields_returned_as_values.main()
    view_type_from_one_source.main()
