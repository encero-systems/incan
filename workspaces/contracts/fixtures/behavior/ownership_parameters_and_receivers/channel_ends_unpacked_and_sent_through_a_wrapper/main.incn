"""Run the program of each former case in order."""

import channel_ends_unpacked_and_sent_through_a_wrapper
import dict_lookups_through_a_mutable_parameter
import explicit_async_bodies
import explicit_body_accepts_borrowed_nested_len
import explicit_body_accepts_compound_loop_conditions
import explicit_body_accepts_for_loops
import explicit_body_accepts_fresh_model_arguments
import explicit_body_accepts_generic_method_calls
import explicit_body_accepts_index_assignment
import explicit_body_accepts_nested_list_literals


async def main() -> None:
    """Run each former case's program in turn."""
    await channel_ends_unpacked_and_sent_through_a_wrapper.main()
    dict_lookups_through_a_mutable_parameter.main()
    await explicit_async_bodies.main()
    explicit_body_accepts_borrowed_nested_len.main()
    explicit_body_accepts_compound_loop_conditions.main()
    explicit_body_accepts_for_loops.main()
    explicit_body_accepts_fresh_model_arguments.main()
    explicit_body_accepts_generic_method_calls.main()
    explicit_body_accepts_index_assignment.main()
    explicit_body_accepts_nested_list_literals.main()
