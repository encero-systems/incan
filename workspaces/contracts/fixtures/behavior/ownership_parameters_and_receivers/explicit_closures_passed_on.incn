# behavior: an explicit body can pass a closure local, including one borrowing a non-Copy place, to a parameter its callee only calls; the callee borrows the closure and its captures for the call (#2500).
# expect-stdout:
#   7
#   12
#   9
#   3
#   10

"""Closures passed on to parameters that only call them."""


class Counter:
    pub value: int
    pub name: str


def apply(read: (int) -> int, value: int) -> int:
    return read(value)


def twice(read: (int) -> int, value: int) -> int:
    return read(read(value))


def apply_zero(read: () -> int) -> int:
    """Call a closure while borrowing its captured places for this call."""
    return read()


def total(amount: Borrowed[int], extra: int) -> int:
    add: (int) -> int = (step) => amount + step
    return apply(add, extra)


def again(amount: Borrowed[int]) -> int:
    add: (int) -> int = (step) => amount + step
    first = apply(add, 3)
    return first + add(3)


def nested(amount: Borrowed[int]) -> int:
    add: (int) -> int = (step) => amount + step
    return twice(add, 3)


def passed_reference(counter: Borrowed[Counter]) -> int:
    """Lend a closure's non-Copy capture to a callee that only calls it."""
    read: () -> int = () => len(counter.name)
    return apply_zero(read)


def indirect(read: (int) -> int, value: Borrowed[int]) -> int:
    return read(value)


def main() -> None:
    amount = 3
    println(total(amount, 4))
    println(again(amount))
    println(nested(amount))
    counter = Counter(value=1, name="abc")
    println(passed_reference(counter))
    double: (int) -> int = (value) => value * 2
    println(indirect(double, 5))
