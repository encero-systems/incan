# behavior: bounded BytesIO reads continue from the prior position; native chained readers retain mutable cursor arguments through a generic reader constructor (#2256)
# expect-stdout:
#   2 true
#   4 true
#   0
#   4 true

from std.io import BytesIO, IoError
from rust::std::io import BufReader, Cursor, Read


def report(outcome: Result[bytes, IoError], expected: bytes) -> None:
    match outcome:
        Ok(data) => println(f"{len(data)} {data == expected}")
        Err(error) => println(f"error {error.kind}")


def main() -> None:
    """Observe bounded and chained reads without losing the borrowed reader's native type."""
    buffer = BytesIO(b"abcdef")
    report(buffer.read(2), b"ab")
    report(buffer.read(10), b"cdef")
    match buffer.read(1):
        Ok(data) => println(len(data))
        Err(error) => println(f"error {error.kind}")

    mut tail = Cursor.new(b"cd")
    mut joined = BufReader.new(Cursor.new(b"ab").chain(Read.by_ref(tail)))
    mut data = b""
    match joined.read_to_end(data):
        Ok(size) => println(f"{size} {data == b'abcd'}")
        Err(error) => println(error)
