# behavior: comprehensions and list constructors preserve their sources; an annotated list comprehension contextually types its element, including when nested (#2803); uniform range comprehensions evaluate bounds once, preserve empty ranges, indexing, sum and independent mutable storage (#2256)
# expect-stdout:
#   ["ab", "def"] 3
#   [3, 1, 2] 9 4
#   [4, 2]
#   ["ab", "c", "def"] ["ab", "c", "def", "z"] 4
#   ["h", "e", "y"]
#   ["x", "y"] 2 2
#   bound
#   3 true 3
#   2 3
#   0 0 0
#   4 5
#   1 2
#   1
#   1
#   1

const FROZEN_TEXT: FrozenList[str] = ["x", "y"]
const FROZEN_NUMBERS: FrozenSet[int] = {7, 8}


enum RecursiveValue:
    Items(list[RecursiveValue])


def doubled(mut items: list[int]) -> list[int]:
    items.append(1)
    return [x * 2 for x in items]


def copied(items: list[str]) -> list[str]:
    return list(items)


def from_mut_param(mut items: list[str]) -> list[str]:
    items.append("z")
    return list(items)


def bound() -> int:
    """Expose the range bound's single evaluation before list observations."""
    println("bound")
    return 3


def uniform_ranges() -> None:
    """Observe exact scalar fills, empty ranges, independent storage and non-unit fallback iteration."""
    mut flags = [true for item in range(bound())]
    copy = flags
    println(f"{len(flags)} {flags[-1]} {sum(flags)}")
    flags[1] = false
    println(f"{sum(flags)} {sum(copy)}")
    negative = [7 for item in range(-2)]
    empty = [1.5 for item in range(0)]
    explicit = [false for item in range(0, 0, 1)]
    println(f"{len(negative)} {len(empty)} {len(explicit)}")
    regular = [4 for item in range(0, 2)]
    stepped = [5 for item in range(1, 6, 2)]
    println(f"{regular[1]} {stepped[2]}")


def annotated_option_comprehension() -> int:
    """Take the Option element type from the annotated comprehension destination."""
    fields = [1]
    values: list[Option[RecursiveValue]] = [None for _ in fields]
    return len(values)


def annotated_option_comprehension_control() -> int:
    """Fill the same annotated Option list through the established loop control."""
    fields = [1]
    mut values: list[Option[RecursiveValue]] = []
    for _ in fields:
        values.append(None)
    return len(values)


def nested_annotated_option_comprehension() -> int:
    """Carry the destination element type through both nested comprehensions."""
    fields = [1]
    values: list[list[Option[RecursiveValue]]] = [[None for _ in fields] for _ in fields]
    return len(values[0])


def main() -> None:
    """Compare source-preserving constructors and exact scalar range comprehensions."""
    names = ["ab", "c", "def"]
    long_names = [name for name in names if len(name) > 1]
    println(f"{long_names:?} {len(names)}")
    ints = [3, 1, 2]
    same = [x for x in ints]
    squares = {x: x * x for x in ints if x > 1}
    three = squares[3]
    two = squares[2]
    println(f"{same:?} {three} {two}")
    println(f"{doubled([2]):?}")
    mut words = ["ab", "c", "def"]
    before = copied(words)
    after = from_mut_param(words)
    println(f"{before:?} {after:?} {len(words)}")
    letters = list("hey")
    println(f"{letters:?}")
    keyed: dict[str, int] = {"k": 1, "j": 2}
    println(f"{list(FROZEN_TEXT):?} {len(list(FROZEN_NUMBERS))} {len(list(keyed))}")
    uniform_ranges()
    races = [1, 2]
    println(" ".join([str(race) for race in races]))
    println(annotated_option_comprehension())
    println(annotated_option_comprehension_control())
    println(nested_annotated_option_comprehension())
