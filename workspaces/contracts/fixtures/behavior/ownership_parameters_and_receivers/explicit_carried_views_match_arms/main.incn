"""Run the program of each former case in order."""

import explicit_carried_views_match_arms
import explicit_closures_capturing_borrowed_locals
import explicit_closures_capturing_inputs
import explicit_closures_holding_references
import explicit_closures_passed_on
import explicit_input_loop_reads_each_item
import explicit_inputs_used_on_one_branch
import explicit_parameter_views
import explicit_tuple_views
import for_loops_over_strings_bytes_and_enum_lists


def main() -> None:
    """Run each former case's program in turn."""
    explicit_carried_views_match_arms.main()
    explicit_closures_capturing_borrowed_locals.main()
    explicit_closures_capturing_inputs.main()
    explicit_closures_holding_references.main()
    explicit_closures_passed_on.main()
    explicit_input_loop_reads_each_item.main()
    explicit_inputs_used_on_one_branch.main()
    explicit_parameter_views.main()
    explicit_tuple_views.main()
    for_loops_over_strings_bytes_and_enum_lists.main()
