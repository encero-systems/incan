# behavior: a field declared directly with Borrowed remains outside explicit ownership's accepted surface and points to a generic carrier parameter instead (#2500)
# expect-diagnostic: INCAN-T0123


class Reader:
    pub values: list[int]


class Selection:
    pub reader: Borrowed[Reader]


def main() -> None:
    reader = Reader(values=[1])
    selection = Selection(reader=reader)
    println(selection.reader.values[0])
