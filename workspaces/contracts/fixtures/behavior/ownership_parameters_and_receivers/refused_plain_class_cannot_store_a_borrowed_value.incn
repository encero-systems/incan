# behavior: a non-generic class field with owned layout cannot store a borrowed value; the refusal names the generic carrier spelling that gives the field reference layout (#2500)
# expect-diagnostic: INCAN-T0123


class Reader:
    pub values: list[int]


class Selection:
    pub reader: Reader


def select(reader: Borrowed[Reader]) -> Selection:
    return Selection(reader=reader)


def main() -> None:
    reader = Reader(values=[1])
    println(select(reader).reader.values[0])
