# Former case field_assigned_into_a_reassigned_local: a method that starts a local from a literal and then overwrites it with a str field of self returns the field's text, and the field is still readable afterwards

pub class Holder:
    pub name: str

    pub def copy_name(self) -> str:
        mut current = ""
        current = self.name
        return current


pub def main() -> None:
    holder = Holder(name="holder")
    println(holder.copy_name())
    println(f"{holder.copy_name()} {holder.name}")
