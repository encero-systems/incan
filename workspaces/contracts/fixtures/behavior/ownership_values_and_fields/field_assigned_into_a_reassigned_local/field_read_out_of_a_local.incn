# Former case field_read_out_of_a_local: a list field read out of a local keeps the local intact when the local is used again, a field read from self leaves self intact across two calls, and a field read at the local's last use reaches its new home

model Record:
    tags: list[str]


model Decoded:
    value: list[str]

    def record(self) -> Record:
        return Record(tags=self.value)


pub def main() -> None:
    kept = Decoded(value=["a", "b"])
    first = Record(tags=kept.value)
    println(len(kept.value))
    rows = [kept.value]
    println(len(rows))
    once = kept.record()
    twice = kept.record()
    println(f"{once.tags:?} {twice.tags:?}")
    last = Decoded(value=["x"])
    second = Record(tags=last.value)
    println(f"{first.tags:?} {second.tags:?}")
