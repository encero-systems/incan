"""Run the program of each former case in order."""

import field_assigned_into_a_reassigned_local
import field_read_out_of_a_local
import fluent_view_chain_edits_the_nested_field
import generator_sources_consumed_and_reused
import loop_binding_stored_into_a_result
import loop_over_a_list_field_of_an_element
import loop_reuses_enclosing_owners
import model_value_passed_then_used_again
import mut_pattern_binding_owns_or_borrows_its_payload
import mut_self_call_on_a_collection_element


def main() -> None:
    """Run each former case's program in turn."""
    field_assigned_into_a_reassigned_local.main()
    field_read_out_of_a_local.main()
    fluent_view_chain_edits_the_nested_field.main()
    generator_sources_consumed_and_reused.main()
    loop_binding_stored_into_a_result.main()
    loop_over_a_list_field_of_an_element.main()
    loop_reuses_enclosing_owners.main()
    model_value_passed_then_used_again.main()
    mut_pattern_binding_owns_or_borrows_its_payload.main()
    mut_self_call_on_a_collection_element.main()
