"""Run the program of each former case in order."""

import borrowed_enum_fields
import explicit_input_makes_native_bytes
import explicit_input_reads_a_module_constant
import indexed_field_reads_preserve_storage
import loop_return_moves_owner
import native_mut_reference_is_a_borrowed_mut_value
import web_extractor_field_read_at_three_sinks


def main() -> None:
    """Run each former case's program in turn."""
    borrowed_enum_fields.main()
    explicit_input_makes_native_bytes.main()
    explicit_input_reads_a_module_constant.main()
    indexed_field_reads_preserve_storage.main()
    loop_return_moves_owner.main()
    native_mut_reference_is_a_borrowed_mut_value.main()
