# behavior: generator expressions snapshot lists, retain callbacks across polls and collect generators (#2256)
# expect-stdout:
#   [2, 3]
#   [1, 2, 3]
#   3 1
#   [0, 4, 16]
#   [6, 7]

from std.rust import Static
from std.traits.callable import Callable1


def transformed[F with (Callable1[int, int], Static)](step: F) -> Generator[int]:
    """Keep a captured callable alive for every deferred step."""
    return (step(value) for value in [1, 2])

def positive_last_use(values: list[int]) -> Generator[int]:
    return (x for x in values if x > 0)


def positive_one_shot() -> Generator[int]:
    return (x for x in [1, 2, 3] if x > 0)


def count_and_first(values: list[int]) -> str:
    generated = (x for x in values if x > 0).collect()
    first = values[0]
    return f"{len(generated)} {first}"


def squares(limit: int) -> Generator[int]:
    for i in range(limit):
        yield i * i


def main() -> None:
    println(f"{positive_last_use([-1, 2, 3]).collect():?}")
    println(f"{positive_one_shot().collect():?}")
    println(count_and_first([1, 2, 3]))
    produced = squares(5)
    evens = [x for x in produced if x % 2 == 0]
    println(f"{evens:?}")
    offset = 5
    changed = transformed((value) => value + offset)
    println(f"{changed.collect():?}")
