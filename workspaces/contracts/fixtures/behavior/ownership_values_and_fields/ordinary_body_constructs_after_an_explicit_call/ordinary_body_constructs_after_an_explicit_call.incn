# Former case ordinary_body_constructs_after_an_explicit_call: An ordinary body that calls an explicit input and then constructs a value from its own parameter (RFC 164).

model Label:
    text: str


def bounded(value: Borrowed[str]) -> bool:
    return len(value) < 10


def label(text: str) -> Result[Label, str]:
    """An ordinary body that calls an explicit input and then constructs from its own parameter."""
    if not bounded(text):
        return Err("long")
    return Ok(Label(text=text))


pub def main() -> None:
    println(label("abc").unwrap().text)
