# behavior: tuple places retain mutation, borrowed equality and dictionary/set Result payload owners (#1530, #2256)
# expect-stdout:
#   2 3 4 5 6
#   2 8
#   6 19

"""Mutate tuple locations and compare shared tuple fields containing owned data."""

from std.fs import Path

class Holder:
    pub pair: tuple[list[int], int]

    def add(mut self, value: int) -> None:
        self.pair[0].append(value)


class Counter:
    pub count: int

    def bump(mut self) -> None:
        self.count += 1


def main() -> None:
    """Exercise tuple mutation and borrowed equality.

    1. Mutate list elements through tuple and loop places.
    2. Mutate tuple fields, nested lists and model elements.
    3. Compare shared tuple fields without consuming their data.
    4. Unpack dictionary and set fields from a Result payload without losing their owned values.
    """
    # 1. Reach mutable list elements through local, nested and iterated tuples.
    mut pair: tuple[list[int], int] = ([], 0)
    pair[0].append(1)
    pair[0].append(2)
    mut outer: tuple[int, tuple[list[int], int]] = (0, ([], 0))
    outer[1][0].append(3)
    mut rows: list[tuple[list[int], int]] = [([], 0)]
    rows[0][0].append(4)
    for row in rows:
        row[0].append(5)
    mut tail: tuple[int, list[int]] = (0, [])
    tail[-1].append(6)
    println(f"{len(pair[0])} {outer[1][0][0]} {rows[0][0][0]} {rows[0][0][1]} {tail[1][0]}")
    # 2. Preserve mutation through fields and nested model elements.
    mut holder = Holder(pair=([], 0))
    holder.add(7)
    holder.pair[0].append(8)
    println(f"{len(holder.pair[0])} {holder.pair[0][1]}")
    mut items: tuple[list[int], int] = ([0], 0)
    items[0][0] = 5
    items[0][0] += 1
    mut counted: tuple[Counter, int] = (Counter(count=1), 0)
    counted[0].count = 10
    counted[0].bump()
    mut spare = 0
    counted[0].count, spare = (counted[0].count + 1, 7)
    println(f"{items[0][0]} {counted[0].count + spare}")
    # 3. Borrow both tuple values for equality and inequality, then read them again.
    assert same_pair(holder, ([7, 8], 0))
    assert not same_pair(holder, ([9], 0))
    assert holder.pair != ([0], 0)
    assert holder.pair[0] == [7, 8]
    # 4. Preserve nominal collection elements and both hash collection owners through tuple extraction.
    match observe_collections():
        Ok(_) => pass
        Err(_) => assert false


def same_pair(holder: Holder, expected: tuple[list[int], int]) -> bool:
    """Compare an owned tuple field with a tuple parameter through their shared structural layout."""
    return holder.pair == expected


def observe_collections() -> Result[None, str]:
    """Unpack a successful tuple payload and read every retained collection more than once."""
    ordered, keyed, labels = collection_payload()?
    assert ordered[0].0 == "first"
    assert keyed["root"].0 == "second"
    assert "first" in labels
    assert len(ordered) == 1 and len(keyed) == 1 and len(labels) == 2
    return Ok(None)


def collection_payload() -> Result[tuple[list[Path], dict[str, Path], set[str]], str]:
    """Return exact nominal list/dictionary leaves and an independently owned set in one tuple."""
    return Ok(([Path("first")], {"root": Path("second")}, {"first", "second"}))
