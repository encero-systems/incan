"""Run the program of each former case in order."""

import comprehension_binding_shadowing_a_parameter
import comprehensions_changing_their_items
import dict_values_changed_in_place
import enum_match_read_only_inputs
import explicit_assertion_message_laziness
import explicit_borrowed_operation_reads
import explicit_input_body_passes_an_ordinary_argument
import explicit_input_calls_a_native_method
import explicit_input_short_circuit_field_reads
import explicit_shared_scalar_value_reads


def main() -> None:
