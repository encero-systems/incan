# Former case explicit_input_body_passes_an_ordinary_argument: An exclusive input body passes an ordinary parameter to an ordinary function and writes through its input (RFC 164).

model State:
    count: int


def counted(data: bytes) -> int:
    return len(data)


def place(data: bytes, mut state: BorrowedMut[State]) -> int:
    """An exclusive input body that passes an ordinary parameter to an ordinary function."""
    state.count += counted(data)
    return state.count


pub def main() -> None:
    mut state = State(count=0)
    println(place(b"ab", state))
