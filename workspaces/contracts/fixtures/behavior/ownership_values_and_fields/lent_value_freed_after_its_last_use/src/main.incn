# behavior: a local that a callee only reads is lent to it, and its storage ends right after its last use, never at the end of its scope, so the statements that follow run without the memory it held (#1604)
# expect-stdout:
#   lent to a reader: freed after its last use
#   lent in a branch: freed after its last use
#   lent in a branch to a call that returns text: freed after its last use

"""Measure the live heap right after the last use of a large local that was only ever lent."""

from rust::drop_probe import live_heap_bytes

const SIZE: int = 4096


def build(size: int) -> list[str]:
    """Build a list whose items each own heap storage."""
    mut items: list[str] = []
    for index in range(size):
        items.append(f"item number {index} with heap storage of its own")
    return items


def measure(items: list[str]) -> int:
    """Only read the list, so a caller lends it."""
    return len(items)


def described(items: list[str]) -> str:
    """Only read the list and return text of its own, so a caller lends the list and owns the result."""
    return f"{len(items)} items"


def lent_to_a_reader() -> int:
    """Lend a local at its last use and return what the heap still holds after that call."""
    before = live_heap_bytes()
    items = build(SIZE)
    counted = measure(items)
    held = live_heap_bytes() - before
    return held + counted * 0


def lent_in_a_branch(flag: bool) -> int:
    """Lend a local on one branch only; after the branches join, neither path reads it again."""
    before = live_heap_bytes()
    items = build(SIZE)
    mut counted = 0
    if flag:
        counted = measure(items)
    held = live_heap_bytes() - before
    return held + counted * 0


def lent_in_a_branch_for_text(flag: bool) -> int:
    """Lend a local on one branch only, to a call whose result the frame keeps."""
    before = live_heap_bytes()
    items = build(SIZE)
    mut label = "none"
    if flag:
        label = described(items)
    held = live_heap_bytes() - before
    return held + len(label) * 0


def held_once(shape: int) -> int:
    """Run one shape and return what the heap held after its last use of the list."""
    if shape == 0:
        return lent_to_a_reader()
    if shape == 1:
        return lent_in_a_branch(true)
    return lent_in_a_branch_for_text(true)


def least(shape: int) -> int:
    """
    The least the heap holds after a shape's last use of its list, over several runs.

    The allocator's count of bytes in use settles late now and then, so one run can report bytes that no value holds;
    a list still held shows in every run.
    """
    mut held = held_once(shape)
    for _ in range(8):
        next = held_once(shape)
        if next < held:
            held = next
    return held


def report(label: str, held: int) -> None:
    """Print whether the heap was back where it started, from `held` bytes measured before printing."""
    if held < SIZE:
        println(f"{label}: freed after its last use")
    else:
        println(f"{label}: still holds {held} bytes after its last use")


def main() -> None:
    report("lent to a reader", least(0))
    report("lent in a branch", least(1))
    report("lent in a branch to a call that returns text", least(2))
