# behavior: a public model re-exported through two facades is constructible from the consumer with only its public field, private defaults staying provider-owned (#964)
# expect-stdout:
#   visible
#   sealed 7

from crate.public_api import ExportedVault as PublicVault


def main() -> None:
    vault = PublicVault(label="visible")
    println(vault.label)
    println(vault.describe())
