# behavior: an imported alias keeps its callable name through direct private imports and through facades that re-export it without its target, rename it again, list it before its target or also import the target for their own use (#1710, #1750)
# expect-stdout:
#   6
#   42
#   8
#   10
#   14
#   6

from both_names import scale
from facade import scale_alias
from private_then_public import doubled, scale_alias as mixed_scale
from public_api import exported_scale
from provider import scale as direct_scale, scale_alias as direct_alias


def main() -> None:
    println(scale(3))
    println(scale_alias(21))
    println(exported_scale(4))
    println(mixed_scale(5))
    println(doubled(7))
    println(direct_scale(1) + direct_alias(2))
