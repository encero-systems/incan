# behavior: an imported trait's default method returns and constructs a model of the trait's own module, which the adopting module never imports
# expect-stdout:
#   12

from shapes import Measured


model Card with Measured:
    size: int

    def width(self) -> int:
        return self.size

    def height(self) -> int:
        return self.size + 1


def main() -> None:
    println(Card(size=3).extent().area())
