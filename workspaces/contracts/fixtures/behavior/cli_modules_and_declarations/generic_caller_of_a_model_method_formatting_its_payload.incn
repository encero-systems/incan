# behavior: generic functions that call methods of generic models run for the payloads they are given: one walks a stream through a trait the stream adopts, one calls a model method whose sibling formats the payload
# expect-stdout:
#   walked 7
#   walked seven
#   held 5
#   7

trait Walk:
    def walk(self) -> str: ...


model Stream[R with (Clone, Display)] with Walk:
    item: R

    def walk(self) -> str:
        return f"walked {self.item}"


model Holder[V with Display]:
    value: V

    def show(self) -> str:
        return f"held {self.value}"

    def get(self) -> V:
        return self.value


def consume[T with (Clone, Display)](stream: Stream[T]) -> str:
    return stream.walk()


def describe[U with Display](held: Holder[U]) -> str:
    return held.show()


def first[U with Display](held: Holder[U]) -> U:
    return held.get()


def main() -> None:
    println(consume(Stream(item=7)))
    println(consume(Stream(item="seven")))
    println(describe(Holder(value=5)))
    println(first(Holder(value=7)))
