# Former case aliased_builtin_bound_maps_to_rust_trait: a builtin trait imported under an alias (`Eq as Equality`) works as a generic bound on a type that derives it

from std.derives.comparison import Eq as Equality


@derive(Eq)
model Point:
    x: int


def require_equality[T with Equality](value: T) -> T:
    return value


pub def main() -> None:
    println(require_equality(Point(x=1)).x)
