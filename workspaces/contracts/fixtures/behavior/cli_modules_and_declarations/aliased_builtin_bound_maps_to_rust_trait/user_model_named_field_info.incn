# Former case user_model_named_field_info: a model named FieldInfo, a name std.reflection also uses, is the program's own type in a program that does not import std.reflection

model FieldInfo:
    label: str

    @staticmethod
    def made() -> FieldInfo:
        return FieldInfo(label="made")


def describe(info: FieldInfo) -> str:
    return info.label


pub def main() -> None:
    println(FieldInfo(label="custom").label)
    println(FieldInfo.made().label)
    println(describe(FieldInfo.made()))
