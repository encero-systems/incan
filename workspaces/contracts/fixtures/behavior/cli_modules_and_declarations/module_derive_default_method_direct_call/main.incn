# behavior: the default method a user module's derive bundle gives a model is callable directly on the model, whether the bundle is applied under its plain or its aliased import binding, or the trait is derived by its imported name
# expect-stdout:
#   1
#   encoded
#   2
#   encoded
#   3
#   encoded

import codec
import codec as formats
from codec import Encode


@derive(codec)
model Item:
    value: int


@derive(formats)
model Other:
    value: int


@derive(Encode)
model Third:
    value: int


def main() -> None:
    item = Item(value=1)
    println(item.value)
    println(item.tag())
    other = Other(value=2)
    println(other.value)
    println(other.tag())
    third = Third(value=3)
    println(third.value)
    println(third.tag())
