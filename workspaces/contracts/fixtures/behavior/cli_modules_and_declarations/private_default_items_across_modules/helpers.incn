from cards import Card


const CHUNK: int = 4
const PREFIX: str = "chunk"
const GREETING: str = "hello"


def _unit() -> str:
    return "bytes"


model _Limits:
    size: int = 16


enum _Mode:
    Fast
    Slow


pub def read(n: int = CHUNK) -> int:
    return n


pub def describe(n: int = CHUNK, prefix: str = PREFIX, unit: str = _unit()) -> str:
    return f"{prefix} {n} {unit}"


pub def limit(limits: _Limits = _Limits()) -> int:
    return limits.size


pub def speed(mode: _Mode = _Mode.Fast) -> str:
    match mode:
        _Mode.Fast => return "fast"
        _Mode.Slow => return "slow"


pub model Greeter:
    pub name: str

    def greet(self, greeting: str) -> str:
        return f"{greeting} {self.name}"

    hello = partial greet(greeting=GREETING)


pub def card_area(card: Card = Card(label="y")) -> int:
    return card.area()
