# behavior: a decorated generic function in a nested module reflects its type argument's class name and field count through a helper imported from another nested module
# expect-stdout:
#   Row:2:clone
#   Point:3:clone

from functions.csv.from_csv import from_csv


@derive(Clone)
model Row:
    name: str
    count: int


@derive(Clone)
model Point:
    x: int
    y: int
    z: int


def main() -> None:
    println(from_csv[Row]())
    println(from_csv[Point]())
