# behavior: a module-qualified plain or generic type names the same declaration as its direct import and provider return in result, field, optional field, parameter and local annotations, while same-named declarations from another provider stay distinct, and reflected fields retain the declaration name (#1437, #2712)
# expect-stdout:
#   x
#   ok
#   TomlError
#   Option[TomlError]
#   direct:x
#   failed
#   direct failed
#   other failed
#   7
#   7
#   8

import errors
import other
from errors import DbError
from errors import Envelope
from errors import TomlError


pub model Report:
    pub failure: errors.TomlError
    pub maybe: Option[errors.TomlError]


pub def result() -> Result[None, errors.TomlError]:
    return Ok(None)


pub def direct_result() -> Result[None, TomlError]:
    return Ok(None)


pub def describe(failure: errors.TomlError) -> str:
    held: errors.TomlError = failure.clone()
    return held.message


pub def fetch() -> Result[int, errors.DbError]:
    value = errors.fetch()?
    return Ok(value)


pub def fetch_other() -> Result[int, other.DbError]:
    value = other.fetch()?
    return Ok(value)


pub def fetch_direct() -> Result[int, DbError]:
    return fetch()


pub def envelope() -> errors.Envelope[int]:
    return errors.envelope()


pub def direct_envelope() -> Envelope[int]:
    return envelope()


pub def other_envelope() -> other.Envelope[int]:
    return other.envelope()


def main() -> None:
    report = Report(failure=errors.make(), maybe=None)
    println(describe(report.failure))
    match result():
        Ok(_) => println("ok")
        Err(error) => println(error.message)
    for field in Report.__fields__():
        println(field.type_name)
    direct: TomlError = errors.make()
    println(f"direct:{direct.message}")
    match fetch():
        Ok(value) => println(value)
        Err(_) => println("failed")
    match fetch_direct():
        Ok(value) => println(value)
        Err(_) => println("direct failed")
    match fetch_other():
        Ok(value) => println(value)
        Err(_) => println("other failed")
    println(envelope().value)
    println(direct_envelope().value)
    println(other_envelope().value)
