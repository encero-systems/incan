# behavior: root TOML imports preserve derived model, list and provider datetime round trips and table snapshot entries (#1434, #2256)
# expect-stdout:
#   demo
#   name = "demo"
#   name = "other"

from std import toml
from std import toml as manifest


@derive(toml)
model Project:
    name: str


@derive(manifest)
model Other:
    name: str


@derive(toml)
model Timed:
    """Round-trip a provider-owned newtype through a source model's serde fields."""

    stamp: toml.TomlDatetime


@derive(toml)
model Samples:
    """Round-trip a typed list through the same imported codec contract."""

    values: list[int]


def show(encoded: Result[str, toml.TomlError]) -> str:
    match encoded:
        Ok(text) => return text.strip()
        Err(error) => return error.message()


def main() -> None:
    """Round-trip source models and inspect a table snapshot while preserving the serialized output contract."""
    project = Project(name="demo")
    println(project.name)
    println(show(toml.serialize(project)))
    println(show(manifest.serialize(Other(name="other"))))
    match toml.deserialize[Project]("name = \"demo\""):
        Ok(decoded) => assert decoded.name == "demo"
        Err(_error) => assert false
    match toml.deserialize[Timed]("stamp = 1979-05-27T07:32:00Z"):
        Ok(decoded) =>
            assert decoded.stamp.as_str() == "1979-05-27T07:32:00Z"
            assert show(toml.serialize(decoded)) == "stamp = 1979-05-27T07:32:00Z"
        Err(_error) => assert false
    match toml.deserialize[Samples]("values = [1, 2]"):
        Ok(decoded) =>
            assert len(decoded.values) == 2
            assert decoded.values[0] == 1
            assert decoded.values[1] == 2
            match toml.deserialize[Samples](show(toml.serialize(decoded))):
                Ok(again) => assert len(again.values) == 2
                Err(_error) => assert false
        Err(_error) => assert false
    match manifest.parse("name = \"demo\""):
        Ok(document) =>
            match document.as_table():
                Ok(table) => assert len(table) == 1
                Err(_error) => assert false
        Err(_error) => assert false
