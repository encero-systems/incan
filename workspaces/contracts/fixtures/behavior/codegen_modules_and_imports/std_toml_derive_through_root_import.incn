# behavior: root TOML imports preserve derived model round trips and table snapshot entries (#1434, #2256)
# expect-stdout:
#   demo
#   name = "demo"
#   name = "other"

from std import toml
from std import toml as manifest


@derive(toml)
model Project:
    name: str


@derive(manifest)
model Other:
    name: str


def show(encoded: Result[str, toml.TomlError]) -> str:
    match encoded:
        Ok(text) => return text.strip()
        Err(error) => return error.message()


def main() -> None:
    """Round-trip source models and inspect a table snapshot while preserving the serialized output contract."""
    project = Project(name="demo")
    println(project.name)
    println(show(toml.serialize(project)))
    println(show(manifest.serialize(Other(name="other"))))
    match toml.deserialize[Project]("name = \"demo\""):
        Ok(decoded) => assert decoded.name == "demo"
        Err(_error) => assert false
    match manifest.parse("name = \"demo\""):
        Ok(document) =>
            match document.as_table():
                Ok(table) => assert len(table) == 1
                Err(_error) => assert false
        Err(_error) => assert false
