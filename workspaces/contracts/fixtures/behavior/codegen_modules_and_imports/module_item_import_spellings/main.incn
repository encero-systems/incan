# behavior: a module function imported as `import module::item`, `import module::item as alias`, `from module import item` and `from module import item as alias` is the same callable under each binding
# expect-stdout:
#   42
#   42
#   7
#   7

import helper::value
from helper import value as answer
import other::count as total
from other import count


def main() -> None:
    println(value())
    println(answer())
    println(total())
    println(count())
