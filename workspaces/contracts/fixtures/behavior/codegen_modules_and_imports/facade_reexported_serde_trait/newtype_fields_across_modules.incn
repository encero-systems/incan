# Former case newtype_fields_across_modules: a newtype imported from another module retains its wrapped field in function parameters and nested calls

from paths import Path
from files import text, forwarded, native


pub def main() -> None:
    """Read a provider newtype through a sibling module's parameter."""
    path = Path("root")
    println(text(path))
    println(forwarded(path))
    println(native(path))
    println(path.text())
