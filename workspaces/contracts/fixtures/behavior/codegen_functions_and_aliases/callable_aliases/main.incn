def main() -> None:
    """Run each former case's program in turn."""
    callable_aliases.main()
    closure_shapes_call_local_functions.main()
    eq_magic_method.main()
    explicit_type_arguments.main()
    function_item_lends_with_a_defaulted_input.main()
    local_partials_of_methods_of_values.main()
    overloaded_functions.main()
    partial_function_presets.main()
