# behavior: map_err callbacks see concrete errors, including a shared collection view of an owned payload
# expect-stdout:
#   ok:7
#   err:disk full
#   err:malformed
#   err:wire:bad

pub model Failure:
    pub detail: str

    def message(self) -> str:
        return self.detail


pub def describe(result: Result[int, Failure]) -> Result[int, str]:
    return result.map_err((error) => error.message())


pub def normalize(result: Result[int, int]) -> Result[int, str]:
    return result.map_err((_error) => "malformed")


def show(result: Result[int, str]) -> str:
    match result:
        Ok(value) => return f"ok:{value}"
        Err(message) => return f"err:{message}"


def main() -> None:
    """Print scalar, model and collection error mappings in order."""
    println(show(describe(Ok(7))))
    println(show(describe(Err(Failure(detail="disk full")))))
    println(show(normalize(Err(1))))
    messages: Result[int, list[str]] = Err(["wire", "bad"])
    println(show(messages.map_err(describe_messages)))


def describe_messages(messages: list[str]) -> str:
    """Borrow a collection payload while constructing its replacement error."""
    return messages[0] + ":" + messages[1]
