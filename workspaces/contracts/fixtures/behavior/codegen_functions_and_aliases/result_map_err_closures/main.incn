"""Run the program of each former case in order."""

import result_map_err_closures
import trait_method_alias_adopts_required_method
import unused_declarations_run


def main() -> None:
    """Run each former case's program in turn."""
    result_map_err_closures.main()
    trait_method_alias_adopts_required_method.main()
    unused_declarations_run.main()
