# behavior: a unit-variant enum's variants are distinct values a match can tell apart
# expect-stdout:
#   active
#   inactive

pub enum Status:
    Active
    Inactive


def describe(status: Status) -> str:
    match status:
        Status.Active => return "active"
        Status.Inactive => return "inactive"


def main() -> None:
    println(describe(Status.Active))
    println(describe(Status.Inactive))
