# behavior: `not in` on a set inside a loop leaves the loop binding usable in the branch that follows (#1057)
# expect-stdout:
#   missing:missing

def names() -> list[str]:
    return ["orders", "missing"]


def first_missing() -> str:
    registered = set(["orders"])
    for name in names():
        if name not in registered:
            return f"missing:{name}"
    return ""


def main() -> None:
    println(first_missing())
