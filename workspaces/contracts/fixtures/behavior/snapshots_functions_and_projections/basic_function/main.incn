import param_mut_unused
import power_operator_receivers
import returns
import trait_method_and_adopted_default
import validated_newtype_hook_and_coercion
import variadic_calls


def main() -> None:
    """Run each former case's program in turn."""
    basic_function.main()
    fixed_call_unpack.main()
    function_alias_and_partial.main()
    function_calls.main()
    function_references.main()
