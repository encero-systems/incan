# Former case param_mut_unused: a list parameter that is only read is summed by a loop with a locally mutable accumulator

"""Ensure parameters are not marked mut when never mutated."""


def energy(bodies: list[int]) -> int:
    mut total: int = 0
    for b in bodies:
        total += b
    return total


pub def main() -> None:
    println(energy([1, 2, 3]))
