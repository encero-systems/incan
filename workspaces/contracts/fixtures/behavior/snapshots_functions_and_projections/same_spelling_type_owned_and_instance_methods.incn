# behavior: a static method and an instance method that share one spelling are each selected by their receiver, while a type-owned static factory may share a stored field's spelling without changing instance field reads
# expect-stdout:
#   5
#   -5

model Counter:
    value: int

    @staticmethod
    def next(value: int) -> Counter:
        return Counter(value=value)

    def next(self) -> int:
        return self.value + 1


model Span:
    days: int

    @staticmethod
    def days(value: int) -> Span:
        return Span(days=value)

    def advance(self, value: int) -> Span:
        return Span(days=self.days + value)


def main() -> None:
    counter = Counter.next(4)
    println(counter.next())
    span = Span.days(-7).advance(2)
    println(span.days)
