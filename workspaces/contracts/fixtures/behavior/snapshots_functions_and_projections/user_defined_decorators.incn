# behavior: user decorators initialize once and replace the callable and its checked input signature (RFC 036)
# expect-stdout:
#   decorating label
#   main
#   7
#   9
#   11

# RFC 036: user-defined decorators


def parse(value: int) -> int:
    return value


def as_int(func: (int) -> str) -> (int) -> int:
    println("decorating label")
    return parse


@as_int
def label(value: int) -> str:
    return "value"


def run(value: int) -> int:
    return label(value)


def parse_text(value: str) -> int:
    """Parse the replacement's text input independently of the original integer signature."""
    return int(value)


def from_text(func: (int) -> int) -> ((str) -> int):
    """Replace the original with a required ordinary parameter of a different checked type."""
    return parse_text


@from_text
def number(value: int) -> int:
    """Retain the original integer callable separately from its text-input replacement."""
    return value


def main() -> None:
    println("main")
    println(run(7))
    println(run(9))
    println(number("11"))
