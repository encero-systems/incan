# Former case classmethod_with_explicit_type_arguments: a classmethod called on an explicitly instantiated generic class builds the instance with the given value

@derive(Clone)
class FactoryBox[T with Clone]:
    pub value: T

    @classmethod
    pub def make(cls, value: T) -> Self:
        return cls(value=value)


pub def main() -> None:
    boxed = FactoryBox[int].make(1)
    println(boxed.value)
    named = FactoryBox[str].make("two")
    println(named.value)
