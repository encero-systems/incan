# Former case user_defined_mutable_method_decorators: a user-defined decorator on a mutating method runs once, when the method binding is initialized before main starts, keeps the method callable and leaves its mutation of the receiver visible after each call (RFC 036)

# RFC 036: user-defined mutable method decorators


class Counter:
    pub value: int

    @keep
    pub def bump(mut self, by: int) -> int:
        self.value += by
        return self.value


def keep(func: (mut Counter, int) -> int) -> (mut Counter, int) -> int:
    println("decorating bump")
    return func


pub def main() -> None:
    println("main")
    mut counter = Counter(value=1)
    println(counter.bump(2))
    println(counter.bump(2))
