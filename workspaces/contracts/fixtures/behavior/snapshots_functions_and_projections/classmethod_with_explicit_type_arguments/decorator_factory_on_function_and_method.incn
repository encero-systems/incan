# Former case decorator_factory_on_function_and_method: one generic decorator factory runs once per decorated declaration, when the bindings are initialized before main starts, decorates a free function and a method, and both remain callable with their original results

def preserve[F]() -> ((F) -> F):
    println("preserving")
    return (func) => func


@preserve()
def decorated_total(first: int, second: int) -> int:
    return first + second


class Box:
    pub base: int

    @preserve()
    pub def total(self, extra: int) -> int:
        return self.base + extra


pub def main() -> None:
    println("main")
    box = Box(base=5)
    println(decorated_total(1, 2))
    println(box.total(6))
    println(decorated_total(1, 2) + box.total(6))
