"""Run the program of each former case in order."""

import classmethod_with_explicit_type_arguments
import decorated_variadic_function
import decorator_factory_on_function_and_method
import derived_default_associated_function
import method_classmethod_staticmethod_property
import public_model_static_method_and_property
import same_spelling_type_owned_and_instance_methods
import static_factory_named_like_field
import user_defined_method_decorators
import user_defined_mutable_method_decorator_replacement
import user_defined_mutable_method_decorators


def main() -> None:
    """Run each former case's program in turn."""
    classmethod_with_explicit_type_arguments.main()
    decorated_variadic_function.main()
    decorator_factory_on_function_and_method.main()
    derived_default_associated_function.main()
    method_classmethod_staticmethod_property.main()
    public_model_static_method_and_property.main()
    same_spelling_type_owned_and_instance_methods.main()
    static_factory_named_like_field.main()
    user_defined_method_decorators.main()
    user_defined_mutable_method_decorator_replacement.main()
