# behavior: a user-defined decorator on an instance method runs once, when the method binding is initialized before main starts and not again per call, and replaces the method with the callable it returns, which is what each call runs (RFC 036)
# expect-stdout:
#   decorating label
#   main
#   8
#   10

# RFC 036: user-defined method decorators


class Box:
    value: int

    @as_int
    def label(self, value: int) -> str:
        return "value"


def parse(box: Box, value: int) -> int:
    return value + 1


def as_int(func: (Box, int) -> str) -> (Box, int) -> int:
    println("decorating label")
    return parse


def run(box: Box, value: int) -> int:
    return box.label(value)


def main() -> None:
    println("main")
    box = Box(value=1)
    println(run(box, 7))
    println(run(box, 9))
