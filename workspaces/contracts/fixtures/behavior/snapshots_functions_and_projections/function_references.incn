# behavior: function references pass through typed parameters and optional fields (RFC 035, #2256)
# expect-stdout:
#   10 9
#   7 12
#   42
#   2 4 6 2 4 6

# RFC 035: First-class named function references


model Transform:
    """Keep an optional function pointer without owning a captured environment."""

    callback: Option[Callable[int, int]]


def call_stored(transform: Transform, value: int) -> int:
    """Copy the stored pointer from a borrowed field and invoke it."""
    match transform.callback:
        Some(apply) => return apply(value)
        None => return 0


def double(x: int) -> int:
    return x * 2


def square(x: int) -> int:
    return x * x


def apply_transform(func: (int) -> int, value: int) -> int:
    return func(value)


def test_function_references() -> (int, int):
    """Exercise direct parameters and a function pointer stored in an optional field."""
    assert call_stored(Transform(callback=Some(double)), 5) == 10
    doubled = apply_transform(double, 5)
    squared = apply_transform(square, 3)
    return (doubled, squared)


def map_list(items: list[int], transformer: Callable[int, int]) -> list[int]:
    mut result: list[int] = []
    for item in items:
        result.append(transformer(item))
    return result


def test_callable_syntax() -> list[int]:
    nums = [1, 2, 3]
    mut doubled_arrows = map_list(nums, double)
    doubled_callable = map_list(nums, double)
    # Concatenate lists using extend
    for item in doubled_callable:
        doubled_arrows.append(item)
    return doubled_arrows


def apply_binary(func: (int, int) -> int, a: int, b: int) -> int:
    return func(a, b)


def add(x: int, y: int) -> int:
    return x + y


def multiply(x: int, y: int) -> int:
    return x * y


def test_multi_param() -> (int, int):
    sum_result = apply_binary(add, 3, 4)
    product_result = apply_binary(multiply, 3, 4)
    return (sum_result, product_result)


def constant() -> int:
    return 42


def invoke_zero_param(func: () -> int) -> int:
    return func()


def test_zero_param() -> int:
    return invoke_zero_param(constant)


def show_pair(pair: (int, int)) -> None:
    match pair:
        case (first, second):
            println(f"{first} {second}")


def main() -> None:
    show_pair(test_function_references())
    show_pair(test_multi_param())
    println(test_zero_param())
    rendered: list[str] = [str(value) for value in test_callable_syntax()]
    println(" ".join(rendered))
