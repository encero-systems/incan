from rust::std::collections import BTreeMap


def inspect[T](values: &BTreeMap[str, T]) -> None:
    """Infer each key query from the iterator's retained Item associated type."""
    for key in values.keys():
        found = values.get(key)


def main() -> None:
    """Execute after checking the generic Rust iterator declaration."""
    println("checked")
