from std.derives.collection import Iterator, ListIterator
from std.derives.copying import Clone


def preserve[T with Clone](values: ListIterator[T]) -> Iterator[T]:
    """Accept the imported adopter through its checked trait adoption."""
    return values


def main() -> None:
    """Run after the generic trait conversion has checked."""
    println("checked")
