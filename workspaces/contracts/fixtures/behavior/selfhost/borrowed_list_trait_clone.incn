# behavior: shared lists borrow owned and temporary arguments, preserve the caller and clone through a native trait into independent storage
# expect-stdout:
#   [3.0, 1.0]
#   [9.0, 1.0]
#   2
#   3
#   2

from rust::std::clone import Clone as RuntimeClone


def copy_values(values: &list[float]) -> list[float]:
    """Keep the annotated owned result of a native Clone call on shared list storage."""
    owned: list[float] = RuntimeClone.clone(values)
    return owned


def size(values: &list[int]) -> int:
    """Read a shared list without consuming its owned storage."""
    return len(values)


def shared_arguments() -> None:
    """Borrow places and materialized values, then reuse the original."""
    values = [1, 2]
    println(size(values))
    println(size([3, 4, 5]))
    println(len(values))


def main() -> None:
    """Mutate the result while retaining the borrowed original."""
    values = [3.0, 1.0]
    mut copied = copy_values(values)
    copied[0] = 9.0
    println(values)
    println(copied)
    shared_arguments()
