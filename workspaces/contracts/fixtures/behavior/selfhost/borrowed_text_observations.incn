# behavior: shared text supports display, debug, parsing, JSON, Unicode iteration and native String cloning without consuming its owner
# expect-stdout:
#   value: 42
#   42
#   "42"
#   42
#   42.0
#   "42"
#   42!
#   a
#   ç
#   retained
#   retained

from rust::std::string import String as RustString

def observe(value: &str) -> None:
    """Read shared text through formatting and conversion boundaries."""
    println(f"value: {value}")
    println(str(value))
    println(f"{value:?}")
    println(int(value))
    println(float(value))
    println(json_stringify(value))


def inspect(values: &str) -> None:
    """Read each Unicode scalar through borrowed text."""
    for value in values:
        println(value)


def copy(value: &RustString) -> RustString:
    """Clone the native referent into independently owned text."""
    return value.clone()


def copied_native_text() -> None:
    """Copy the same borrowed native text twice."""
    value: RustString = "retained"
    println(copy(value))
    println(copy(value))


def main() -> None:
    """Keep the source string available after each borrowed observation."""
    mut value = "42"
    observe(value)
    value += "!"
    println(value)
    inspect("aç")
    copied_native_text()
