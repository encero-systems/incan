# behavior: a Rust enum payload keeps its declared unsigned integer carrier in a function with type parameters
# expect-stdout:
#   checked

from rust::std::io import SeekFrom


def offset[T](position: SeekFrom, unused: T) -> u64:
    """Keep the exact unsigned carrier stored by an absolute seek position."""
    match position:
        SeekFrom.Start(value) => return value
        _ => return 0


def main() -> None:
    """Run after the unsigned payload's declaration has checked."""
    println("checked")
