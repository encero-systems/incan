# behavior: a Rust vector field retains its source list methods when cloned
# expect-stdout:
#   checked

from rust::incan_lang::interop import RustTypeInfo


def inspect[T](value: RustTypeInfo) -> bool:
    """Use the cloned field as the list type checking already established."""
    names = value.type_params.clone()
    return "T" in names


def main() -> None:
    """Execute after checking the cloned vector's source item type."""
    println("checked")
