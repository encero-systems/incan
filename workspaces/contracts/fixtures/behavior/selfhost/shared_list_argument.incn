# behavior: a shared list parameter borrows an owned binding or a fresh list argument
# expect-stdout:
#   2
#   3
#   2


def size(values: &list[int]) -> int:
    """Read a shared list without consuming the caller's owned storage."""
    return len(values)


def main() -> None:
    """Borrow both places and materialized values, then reuse the original binding."""
    values = [1, 2]
    println(size(values))
    println(size([3, 4, 5]))
    println(len(values))
