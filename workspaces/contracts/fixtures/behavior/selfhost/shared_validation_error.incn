# behavior: a shared native validation error preserves its display and owned payload
# expect-stdout:
#   invalid
#   invalid

from rust::incan_std_core::validation import ValidationError as NativeValidationError


def describe(value: &NativeValidationError) -> str:
    """Format the native error through its shared carrier."""
    return str(value)


def main() -> None:
    """Borrow the same error twice without consuming it."""
    value = NativeValidationError.new("invalid")
    println(describe(value))
    println(describe(value))
