# behavior: a public field behind nested native boxes retains its own optional payload type
# expect-stdout:
#   3
#   4

from rust::std::boxed import Box
from rust::std::ops import Range


def main() -> None:
    """Read both boxed fields without borrowing their types from another operand."""
    owner = Box.new(Box.new(Range(start=3, end=4)))
    value = Some(owner.start)
    match value:
        Some(number) => println(number)
        None => println("missing")
    println(owner.end)
