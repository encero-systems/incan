"""Run the program of each former case in order."""

import borrowed_list_trait_clone
import borrowed_native_vector_field
import borrowed_text_observations
import boxed_model_argument
import computed_codec_label
import native_callable_alias
import native_generic_future
import native_result_error
import native_scalar_parse_error
import native_value_comparisons


def main() -> None:
    """Run each former case's program in turn."""
    borrowed_list_trait_clone.main()
    borrowed_native_vector_field.main()
    borrowed_text_observations.main()
    boxed_model_argument.main()
    computed_codec_label.main()
    native_callable_alias.main()
    native_generic_future.main()
    native_result_error.main()
    native_scalar_parse_error.main()
    native_value_comparisons.main()
