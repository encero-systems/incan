"""Run the program of each former case in order."""

import codec_evaluation_order
import codec_rejected_labels
import collection_callable_field
import generator_function_capture
import generator_set_sources
import usize_list_operations
import wrapping_integer_methods


def main() -> None:
    """Run each former case's program in turn."""
    codec_evaluation_order.main()
    codec_rejected_labels.main()
    collection_callable_field.main()
    generator_function_capture.main()
    generator_set_sources.main()
    usize_list_operations.main()
    wrapping_integer_methods.main()
