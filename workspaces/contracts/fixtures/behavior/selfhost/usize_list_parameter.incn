# behavior: a shared list of native unsigned integers preserves its element carrier
# expect-stdout:
#   1
#   3


def count(values: &list[usize]) -> int:
    """Observe the shared list without converting its element carrier."""
    return len(values)


def main() -> None:
    """Construct, borrow and index an unsigned list."""
    values: list[usize] = [3]
    println(count(values))
    println(values[0])
