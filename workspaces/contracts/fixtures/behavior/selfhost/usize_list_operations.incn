# behavior: native unsigned list elements survive mutation, cloning and iteration
# expect-stdout:
#   3
#   3
#   5
#   3


def main() -> None:
    """Exercise collection operations with the exact native unsigned carrier."""
    mut values: list[usize] = [3, 5]
    values.append(values[0])
    copy = values.clone()
    println(len(copy))
    for value in copy:
        println(int(value))
