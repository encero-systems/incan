# behavior: native and source payloads and associated array constants retain identities through shared references, reference collections, optional results, borrowed and copied fields, boxed construction, nested re-exported variants and exact unsigned payload carriers (#2256)
# expect-stdout:
#   checked
#   7
#   native
#   not ready
#   7
#   7
#   7
#   7
#   native message
#   Record { count: 7, text: "native", ready: false }
#   Wrapped(Record { count: 7, text: "native", ready: false })
#   category
#   missing category
#   7
#   Record { count: 7, text: "native", ready: false }
#   native result
#   9
#   9
#   Empty
#   true
#   true
#   Wrapped(Record { count: 7, text: "native", ready: false })
#   7
#   true
#   true
#   true
#   true
#   7
#   true
#   7
#   native message
#   native message
#   1
#   checked

from rust::messages import CopyNumber, Envelope, Message, category, message, boxed_message, message_envelope, wrapped_message
from rust::messages::category import Kind as Category
from rust::std::net import IpAddr
from rust::std::io import SeekFrom
from copying import borrowed_copy, maybe_record


model MessageHolder:
    """Retain a native enum owner across an ordinary read through a shared source field."""

    value: Message


def copy_field(holder: &MessageHolder) -> Message:
    """Copy a borrowed enum field into independent value storage before returning it."""
    copied = holder.value
    return copied


def loopback[T](value: &IpAddr, unused: T) -> bool:
    """Inspect the concrete borrowed payload of either address variant."""
    match value:
        IpAddr.V4(address) => return address.is_loopback()
        IpAddr.V6(address) => return address.is_loopback()


def offset[T](position: SeekFrom, unused: T) -> u64:
    """Keep the unsigned carrier stored by an absolute seek position."""
    match position:
        SeekFrom.Start(value) => return value
        _ => return 0


def inspect(value: &Message) -> None:
    """Read both fields from the selected native record without transferring its owner."""
    match value:
        Message.Record(text=message, ready=ready, count=number) =>
            println(number)
            println(message)
            if ready:
                println("ready")
            else:
                println("not ready")
        Message.Empty => pass
        _ => pass


def inspect_count(value: &Message) -> None:
    """Omit the other payload fields while borrowing the same native owner again."""
    match value:
        Message.Record(count=number) => println(number)
        Message.Empty => pass
        _ => pass


def inspect_wrapped(value: &Message) -> None:
    """Use the named payload's exact native Box carrier before borrowing its content."""
    match value:
        Message.NamedBox(inner=inner) => inspect_count(inner.as_ref())
        _ => pass


def constructed_result() -> Result[Message, str]:
    """Retain a native enum identity when construction supplies a Result payload."""
    return Ok(Message.Wrapped(message()))


def inspect_positional(value: &Message) -> None:
    """Borrow the exact Box stored in a positional native payload before borrowing its content."""
    match value:
        Message.Wrapped(inner) => inspect_count(inner.as_ref())
        _ => pass


def inspect_optional(values: &list[Message]) -> None:
    """Resolve an indexed native method and copy its stored shared enum reference into the arm binding."""
    match values[0].borrowed_message():
        Some(value) => inspect_count(value)
        None => println("missing message")


def inspect_nested_optional(values: &list[Message]) -> None:
    """Match a native enum through the shared reference stored in an Option payload."""
    match values[0].borrowed_message():
        Some(Message.Record(count=number)) => println(number)
        _ => println("missing nested record")


def borrowed_record(envelope: &Envelope) -> bool:
    """Bind a native shared result and pass its reference to a separate source function."""
    frame = envelope.message.as_ref()
    return has_record(frame)


def has_record(value: &Message) -> bool:
    """Observe a shared native enum without moving its referent."""
    match value:
        Message.Record(count=number) => return number == 7
        _ => return false


def reference_records(left: &Message, right: &Message) -> bool:
    """Keep a temporary list's native references while visiting both original owners."""
    for value in [left, right]:
        if not has_record(value):
            return false
    return true


def main() -> None:
    """Observe retained native layouts, methods and associated text-array constants."""
    match maybe_record():
        Some(record) => assert record.value == 7
        None => assert false
    labels = Message.LABELS
    assert len(labels) == 4
    assert str(labels[0]) == "start"
    assert str(labels[-1]) == "inclusive"
    for index in range(len(labels)):
        assert len(str(labels[index])) > 0
    println("checked")
    value = message()
    assert reference_records(value, value)
    borrowed = value.borrowed_message()
    assert f"{borrowed:?}" == 'Some(Record { count: 7, text: "native", ready: false })'
    inspect(value)
    inspect_count(value)
    boxed = boxed_message()
    inspect_count(boxed.as_ref())
    envelope = message_envelope()
    assert borrowed_record(envelope)
    assert borrowed_record(envelope)
    inspect_count(envelope.message.as_ref())
    wrapped = wrapped_message()
    inspect_wrapped(wrapped)
    println(value)
    println(f"{value:?}")
    constructed = Message.Wrapped(message())
    println(f"{constructed:?}")
    match category(true):
        Some(Category.Present) => println("category")
        _ => println("wrong category")
    match category(false):
        Some(Category.Missing) => println("missing category")
        _ => println("wrong category")
    inspect_positional(constructed)
    values: list[Message] = [message()]
    copied = values[0].clone()
    println(f"{copied:?}")
    match constructed_result():
        Ok(_value) => println("native result")
        Err(error) => println(error)
    number = CopyNumber(value=9)
    println(borrowed_copy(number))
    println(number.value)
    empty = Message.Empty
    println(f"{empty:?}")
    println(empty == constructed)
    println(empty != value)
    println(f"{constructed:?}")
    inspect_optional([message()])
    left_option: Option[Message] = Some(empty)
    same_option: Option[Message] = Some(constructed)
    other_option: Option[Message] = Some(value)
    println(left_option == same_option)
    println(left_option != other_option)
    left_result: Result[Message, str] = Ok(empty)
    other_result: Result[Message, str] = Ok(value)
    println(left_result != other_result)
    first_error: Result[Message, str] = Err("first")
    other_error: Result[Message, str] = Err("other")
    println(first_error != other_error)
    inspect_nested_optional([message()])
    holder = MessageHolder(value=message())
    println(copy_field(holder) == value)
    inspect_count(holder.value)
    indexed = [value]
    println(f"{indexed[0]}")
    println(f"{indexed[0]}")
    println(len(indexed))
    println("checked")
