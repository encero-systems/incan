"""A native Copy receiver selected independently from the module that constructs its public layout."""

from rust::messages import CopyNumber


pub def borrowed_copy(value: &CopyNumber) -> int:
    """Copy a by-value native receiver without invoking its observable Clone implementation."""
    return value.into_value()


pub model ReturnedRecord:
    """Carry a source model identity through an imported function's optional result."""

    pub value: int


pub def maybe_record() -> Option[ReturnedRecord]:
    """Return a model whose type the consumer does not import directly."""
    return Some(ReturnedRecord(value=7))
