"""Run the program of each former case in order."""

import const_str_as_a_carrier_payload
import frozen_strings_at_parameters_fields_and_collections
import model_fields_from_literals_and_variables
import primitives_and_literals_as_arguments
import string_literal_and_variable_to_str_parameter


def main() -> None:
    """Run each former case's program in turn."""
    const_str_as_a_carrier_payload.main()
    frozen_strings_at_parameters_fields_and_collections.main()
    model_fields_from_literals_and_variables.main()
    primitives_and_literals_as_arguments.main()
    string_literal_and_variable_to_str_parameter.main()
