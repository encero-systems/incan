# behavior: a FrozenStr const is printed, passed to a str parameter, kept frozen through a FrozenStr parameter, assigned into a str local that is then extended, stored in a model field and collected into a list
# expect-stdout:
#   strict
#   [strict]
#   policy
#   strict!
#   strict
#   2 strict

const POLICY: FrozenStr = "strict"


model Config:
    name: str


def label(text: str) -> str:
    return f"[{text}]"


def keep(value: FrozenStr) -> FrozenStr:
    return value


def pick() -> FrozenStr:
    return keep("policy")


def main() -> None:
    println(POLICY)
    println(label(POLICY))
    println(pick())
    mut name: str = POLICY
    name += "!"
    println(name)
    config = Config(name=POLICY)
    println(config.name)
    names = [POLICY, POLICY]
    println(f"{len(names)} {names[0]}")
