# behavior: frozen text retains parameter, field, collection and tuple values, displays as ordinary text when printed or formatted from a shared parameter (incan-4.4), and shares checked text methods (#2256); a `str` constant in a `tuple[str, str]` becomes owned text (once refused in lowering with `expected String, found FrozenStr`), in a list too, beside a tuple of literals (once refused with `tuple value with differing checked field carriers`)
# expect-stdout:
#   strict
#   [strict]
#   policy
#   strict!
#   strict
#   <strict>
#   named
#   <named>
#   strict
#   2 strict
#   local named, final literal
#   named value

"""Observe frozen text across parameters, fields, collections and shared text operations."""

const POLICY: FrozenStr = "strict"
const NAME: str = "named"


model Config:
    name: str


def label(text: str) -> str:
    return f"[{text}]"


def keep(value: FrozenStr) -> FrozenStr:
    return value


def pick() -> FrozenStr:
    return keep("policy")


def labeled() -> tuple[str, str]:
    return (NAME, "value")


def show(value: FrozenStr) -> None:
    println(value)
    println(f"<{value}>")


def main() -> None:
    """Observe frozen values across authoring boundaries.

    1. Pass frozen values through text and frozen parameters, then extend an owned value.
    2. Retain frozen values through model fields, collection elements and tuple elements.
    3. Validate the shared text methods on frozen receivers.
    """
    # 1. Preserve frozen arguments and turn one value into an extensible owned string.
    println(POLICY)
    println(label(POLICY))
    println(pick())
    mut name: str = POLICY
    name += "!"
    println(name)
    show(POLICY)
    show(NAME)

    # 2. Read the same immutable text through ordinary fields and collection storage.
    config = Config(name=POLICY)
    println(config.name)
    names = [POLICY, POLICY]
    println(f"{len(names)} {names[0]}")
    for family, profile in [("local", NAME)]:
        assert family == "local" and profile == NAME
    pairs = [("local", NAME), ("final", "literal")]
    println(f"{pairs[0][0]} {pairs[0][1]}, {pairs[1][0]} {pairs[1][1]}")
    first, second = labeled()
    println(f"{first} {second}")

    # 3. Use checked text operations without treating their frozen receiver as a list.
    observe_frozen_methods()


def observe_frozen_methods() -> None:
    """Apply the shared positional text contracts and registry-owned observations to frozen values."""
    assert POLICY.upper() == "STRICT"
    assert keep("STRICT").lower() == "strict"
    assert keep(" strict ").strip() == "strict"
    assert POLICY.replace("s", "S") == "Strict"
    assert POLICY.split("r") == ["st", "ict"]
    assert keep(":").join(["a", "b"]) == "a:b"
    assert POLICY.contains("ri")
    assert POLICY.len() == 6
    assert POLICY.startswith("st")
    assert POLICY.endswith("ct")
    assert keep(" strict ").split_whitespace() == ["strict"]
    assert POLICY.to_string() == "strict"
