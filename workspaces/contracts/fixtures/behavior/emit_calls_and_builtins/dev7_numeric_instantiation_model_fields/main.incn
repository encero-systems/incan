"""Run the program of each former case in order."""

import dev7_numeric_instantiation_model_fields
import dict_literal_into_optional_union_values
import dict_lookups_with_str_keys
import enumerate_as_a_list_value_and_over_generic_tuples
import fallible_iterator_take
import file_builtins_report_errors_as_strings
import frozen_str_return_from_literal
import generic_list_of_tuples_literal_argument
import identifiers_named_like_host_keywords
import imported_surface_functions


async def main() -> None:
    """Run each former case's program in turn."""
    dev7_numeric_instantiation_model_fields.main()
    dict_literal_into_optional_union_values.main()
    dict_lookups_with_str_keys.main()
    enumerate_as_a_list_value_and_over_generic_tuples.main()
    fallible_iterator_take.main()
    file_builtins_report_errors_as_strings.main()
    frozen_str_return_from_literal.main()
    generic_list_of_tuples_literal_argument.main()
    identifiers_named_like_host_keywords.main()
    await imported_surface_functions.main()
