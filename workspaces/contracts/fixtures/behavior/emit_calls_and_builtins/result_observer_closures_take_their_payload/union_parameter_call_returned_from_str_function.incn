# Former case union_parameter_call_returned_from_str_function: a str literal passed to a `str | bool | float | int` parameter inside a `return` of a str function is matched as the str member, and the other members dispatch by their own patterns

def lit(value: str | bool | float | int) -> str:
    match value:
        str(text) => return f"str:{text}"
        bool(truth) => return f"bool:{truth}"
        float(number) => return f"float:{number}"
        int(number) => return f"int:{number}"


def state() -> str:
    return lit("open")


pub def main() -> None:
    println(state())
    println(lit(true))
    println(lit(2.5))
    println(lit(3))
