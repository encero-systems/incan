# behavior: generic equality and inequality preserve scalar, text, and nested tuple operands, including tuple fields with owned lists (#1442)
# expect-stdout:
#   true
#   true
#   false
#   true
#   true
#   false
#   猫
#   猫
#   true
#   true
#   true
#   false
#   true
#   true
#   false
#   true
#   猫
#   2

from std.testing import assert_eq

model Comparator:
    def same[T](self, left: T, right: T) -> bool:
        return left == right

    def different[T](self, left: T, right: T) -> bool:
        return left != right


def same[T](left: T, right: T) -> bool:
    return left == right


def different[T](left: T, right: T) -> bool:
    return left != right


def method_same[T](comparator: Comparator, left: T, right: T) -> bool:
    return comparator.same(left, right)


def method_different[T](comparator: Comparator, left: T, right: T) -> bool:
    return comparator.different(left, right)


def main() -> None:
    """Compare each closed carrier and read its owned fields again after comparison."""
    left = "猫"
    right = "猫"
    comparator = Comparator()
    println(method_same(comparator, left, right))
    println(same(left, right))
    println(method_different(comparator, left, right))
    println(different(left, "é"))
    println(same("", ""))
    println(method_same(comparator, "", "猫"))
    println(left)
    println(right)
    println(method_same(comparator, 3, 3))
    println(different(3, 4))
    println(same(true, true))
    println(method_different(comparator, false, false))
    pair = (1, "猫")
    assert_eq(pair, (1, "猫"))
    println(same(pair, (1, "猫")))
    println(method_different(comparator, pair, (2, "猫")))
    println(different(pair, (1, "猫")))
    nested = ((true, "猫"), [1, 2])
    println(method_same(comparator, nested, ((true, "猫"), [1, 2])))
    println(pair.1)
    println(len(nested.1))
