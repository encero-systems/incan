# behavior: import std.async binds the reserved module name through ordinary namespace lookup, so its timer runs beside a task spawned through the prelude binding
# expect-stdout:
#   slept
#   spawned

import std.async
import std.async.prelude


async def main() -> None:
    await async.sleep(0.01)
    await async.sleep_ms(1)
    println("slept")
    handle = prelude.spawn(async.sleep_ms(1))
    match await handle:
        Ok(_) => println("spawned")
        Err(_) => println("failed")
