# behavior: parameters, locals and a function named like host-language keywords (struct, where, mod, use, move, impl, dyn, box) are ordinary Incan names
# expect-stdout:
#   5
#   9
#   10
#   3
#   11

def mod(struct: int, where: int) -> int:
    return struct + where


def main() -> None:
    use = mod(2, 3)
    move = [1, use]
    impl = move[0] + move[1] + 3
    dyn = impl + 1
    box = "abc"
    println(use)
    println(impl)
    println(dyn)
    println(len(box))
    println(dyn + 1)
