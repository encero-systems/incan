# behavior: checked generic model fields widen i8 to int in either written argument order and f32 to an explicitly selected float carrier, while equal i8 fields retain their carrier
# expect-stdout:
#   3
#   5
#   3
#   5
#   1.5
#   2.5
#   3
#   4

model Pair[T]:
    first: T
    second: T


def main() -> None:
    small: i8 = 3
    wide: int = 5
    forward = Pair(first=small, second=wide)
    println(forward.first)
    println(forward.second)
    reversed = Pair(second=wide, first=small)
    println(reversed.first)
    println(reversed.second)
    single: f32 = 1.5
    floating = Pair[float](first=single, second=2.5)
    println(floating.first)
    println(floating.second)
    other: i8 = 4
    unchanged = Pair(first=small, second=other)
    println(unchanged.first)
    println(unchanged.second)
