# Former case open_result_sides_take_the_enclosing_function_side: an open side of an or_else result or a bound Ok takes the enclosing function's Result side and prints there, and elsewhere runs when it is never read

def recover(e: Result[int, str]) -> Result[int, str]:
    r = e.or_else((m) => Ok(1))
    match r:
        Ok(v) => println(v)
        Err(m) => println(m)
    x = Ok(2)
    match x:
        Ok(v) => println(v)
        Err(m) => println(m)
    return Ok(0)


pub def main() -> None:
    println(recover(Err("x")).unwrap_or(9))
    e: Result[int, str] = Err("abc")
    r = e.or_else((m) => Ok(len(m)))
    match r:
        Ok(v) => println(v)
        Err(_) => println("never")
    x = Ok(4)
    println(x.unwrap_or(0))
    println(x)
