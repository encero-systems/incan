"""Run the program of each former case in order."""

import abs_and_sum_are_overflow_checked
import isinstance_str_over_const_union_and_option
import minimum_integer_constants
import static_method_with_str_argument
import standard_testing_assert_helpers


def main() -> None:
    """Run each former case's program in turn."""
    abs_and_sum_are_overflow_checked.main()
    isinstance_str_over_const_union_and_option.main()
    minimum_integer_constants.main()
    static_method_with_str_argument.main()
    standard_testing_assert_helpers.main()
