"""Run the program of each former case in order."""

import abs_and_sum_are_overflow_checked
import isinstance_str_over_const_union_and_option
import minimum_integer_constants
import static_method_with_str_argument
import standard_testing_assert_helpers
import arguments_binding_one_type_parameter_widen_to_one_type
import await_through_a_module_binding
import bounded_type_arguments_the_call_settles_or_expects
import closure_parameters_from_their_context
import closures_returning_constructors_have_their_own_result
import collection_literals_of_constructors_share_one_result_type
import compiled_stdlib_module_function_call
import constructor_arguments_take_the_type_arguments_the_call_infers
import dev7_numeric_instantiation_concrete_model_fields
import dev7_numeric_instantiation_generic_equality


async def main() -> None:
    """Run each former case's program in turn."""
    abs_and_sum_are_overflow_checked.main()
    isinstance_str_over_const_union_and_option.main()
    minimum_integer_constants.main()
    static_method_with_str_argument.main()
    standard_testing_assert_helpers.main()
    arguments_binding_one_type_parameter_widen_to_one_type.main()
    await await_through_a_module_binding.main()
    bounded_type_arguments_the_call_settles_or_expects.main()
    closure_parameters_from_their_context.main()
    closures_returning_constructors_have_their_own_result.main()
    collection_literals_of_constructors_share_one_result_type.main()
    compiled_stdlib_module_function_call.main()
    constructor_arguments_take_the_type_arguments_the_call_infers.main()
    dev7_numeric_instantiation_concrete_model_fields.main()
    dev7_numeric_instantiation_generic_equality.main()
