# Former case dev7_numeric_instantiation_concrete_model_fields: a checked concrete numeric model field widens its input without changing a same-carrier field

model Numbers:
    wide: int
    floating: float
    small: i8


pub def main() -> None:
    narrow: i8 = 3
    single: f32 = 1.5
    unchanged: i8 = 4
    numbers = Numbers(wide=narrow, floating=single, small=unchanged)
    println(numbers.wide)
    println(numbers.floating)
    println(numbers.small)
