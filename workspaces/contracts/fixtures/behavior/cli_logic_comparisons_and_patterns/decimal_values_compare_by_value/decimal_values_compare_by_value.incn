# Former case decimal_values_compare_by_value: decimal equality, ordering and set membership compare values whatever scale each was written with, and a decimal widens to a type that keeps its digits

pub def main() -> None:
    a: decimal[4, 2] = 1.50d
    b: decimal[3, 1] = 1.5d
    c: decimal[4, 2] = 1.49d
    widened: decimal[4, 2] = b
    println(a == widened)
    println(b < c)
    println(c < b)
    println(len({a, b}))
    println(a)
    println(b)
