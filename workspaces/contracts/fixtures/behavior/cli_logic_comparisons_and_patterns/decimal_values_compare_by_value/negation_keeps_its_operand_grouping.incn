# Former case negation_keeps_its_operand_grouping: not and unary minus over an operator expression apply to the whole expression rather than to its first operand

pub def main() -> None:
    println(not (1 == 2))
    println(not 1 == 2)
    println(-(2 + 3))
    println(not (true and false))
    println(not (1 < 2 or false))
    println(not bool(5))
    println(~(1 | 2))
