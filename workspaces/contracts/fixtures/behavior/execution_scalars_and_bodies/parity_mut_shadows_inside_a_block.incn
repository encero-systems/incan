# behavior: a `mut` binding inside a block shadows the outer one only inside it (parity corpus identity row)
# expect-stdout:
#   11

"""A `mut` binding inside a block shadows the outer one only inside it (parity corpus identity row)."""
def shadow_mut() -> int:
    """Combine the inner mutable binding with the outer value."""
    mut total = 0
    mut x = 4
    if true:
        mut x = 7
        total += x
    return total + x


def main() -> None:
    """Print the fixture values in the expected order."""
    println(shadow_mut())
