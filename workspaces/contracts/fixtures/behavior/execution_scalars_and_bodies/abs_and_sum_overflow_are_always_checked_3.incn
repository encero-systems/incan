# behavior: abs and sum overflow are always checked
# expect-stdout:
#   before abs
# expect-exit: 101

"""Abs and sum overflow are always checked."""
def abs_min(value: int) -> int:
    """Print the marker before taking the absolute value."""
    println("before abs")
    return abs(value)


def main() -> None:
    """Print the fixture values in the expected order."""
    println(abs_min(-9223372036854775808))
