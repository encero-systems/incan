# Former case executes_source_local_tuple_list_index_and_mutation_through_a_direct_c: executes source local tuple list index and mutation through a direct callable

"""Executes source local tuple list index and mutation through a direct callable."""
def score(mut values: list[int]) -> int:
  """Mutate the first list element and score the resulting tuple."""
  values[0] = 40
  pair = (values[0], 2)
  return pair.0 + pair.1

def program_result() -> int:
  """Compute and return `score(values)`."""
  mut values = [1, 2]
  return score(values)


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
