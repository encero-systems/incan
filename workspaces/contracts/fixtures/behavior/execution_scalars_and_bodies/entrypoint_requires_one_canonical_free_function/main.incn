"""Run the program of each former case in order."""

import entrypoint_requires_one_canonical_free_function
import executes_core_body_and_binds_a_real_receipt
import executes_let_shadowing_by_local_identity
import executes_plain_collection_index_projection
import executes_plain_scalar_tuple_collection_loop
import executes_source_local_tuple_list_index_and_mutation_through_a_direct_c
import executes_the_exact_same_module_overload_selected_by_the_typechecker
import executes_the_selected_string_ownership_control_flow_and_assertion_case
import float_bool_remains_an_original_call_span_refusal
import integer_power


def main() -> None:
    """Run each former case's program in turn."""
    entrypoint_requires_one_canonical_free_function.main()
    executes_core_body_and_binds_a_real_receipt.main()
    executes_let_shadowing_by_local_identity.main()
    executes_plain_collection_index_projection.main()
    executes_plain_scalar_tuple_collection_loop.main()
    executes_source_local_tuple_list_index_and_mutation_through_a_direct_c.main()
    executes_the_exact_same_module_overload_selected_by_the_typechecker.main()
    executes_the_selected_string_ownership_control_flow_and_assertion_case.main()
    float_bool_remains_an_original_call_span_refusal.main()
    integer_power.main()
