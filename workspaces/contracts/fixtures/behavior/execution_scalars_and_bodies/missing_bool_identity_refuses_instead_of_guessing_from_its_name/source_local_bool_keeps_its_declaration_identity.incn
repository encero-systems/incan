# Former case source_local_bool_keeps_its_declaration_identity: source local bool keeps its declaration identity

"""Source local bool keeps its declaration identity."""
def bool(value: int) -> int:
  """Return the fixture expression `value + 1`."""
  return value + 1

def observe() -> int:
  """Return the fixture expression `bool(41)`."""
  return bool(41)


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(observe())
