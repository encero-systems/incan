# behavior: element updates and whole-list assignment through a mut list parameter reach the caller (#2022, RFC 129)
# expect-stdout:
#   310
#   [0]

"""Observe both element updates and whole-list assignment through a mutable parameter."""
def bump(mut items: List[int]) -> None:
  """Increment the first element of the caller-owned list."""
  items[0] = items[0] + 1

def inc(mut n: int) -> None:
  """Increment the caller-owned mutable integer."""
  n = n + 1

def program_result() -> int:
  """Compute and return `items[0] * 100 + n`."""
  mut items: List[int] = [1, 5]
  bump(items)
  bump(items)
  mut n = 10
  inc(n)
  return items[0] * 100 + n


def reset(mut items: list[int]) -> None:
    """Replace the caller's list through its mutable parameter."""
    items = [0]


def main() -> None:
    """Print the fixture values in the expected order."""
    println(program_result())
    mut items = [1, 2]
    reset(items)
    println(items)
