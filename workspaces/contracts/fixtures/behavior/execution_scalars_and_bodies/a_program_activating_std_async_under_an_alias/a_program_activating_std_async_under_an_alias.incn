# Former case a_program_activating_std_async_under_an_alias: from std import async binds the reserved module name through ordinary namespace lookup, and async.sleep runs

"""Call the async library through the module binding named by the reserved word."""

from std import async


def program_result() -> int:
    """Return `42` for this fixture."""
    return 42


pub async def main() -> None:
    """Print the fixture values in the expected order."""
    await async.sleep(0.0)
    println(program_result())
