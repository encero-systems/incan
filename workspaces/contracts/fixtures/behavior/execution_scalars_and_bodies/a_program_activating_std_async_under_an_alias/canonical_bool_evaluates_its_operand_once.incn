# Former case canonical_bool_evaluates_its_operand_once: canonical bool evaluates its operand once

"""Canonical bool evaluates its operand once."""
def marked() -> str:
  """Print the operand marker before returning the operand."""
  println("bool operand")
  return ""

def observe() -> bool:
  """Return the fixture expression `bool(marked())`."""
  return bool(marked())


pub def main() -> None:
    """Print the fixture values in the expected order."""
    println(observe())
