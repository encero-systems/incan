# behavior: module statics are mutable shared storage: reassignment and += update an int static, and a list static appended through a live alias shows the change (RFC 052)
# expect-stdout:
#   3
#   2
#   2

static counter: int = 0
static items: list[int] = []


def main() -> None:
    counter = counter + 1
    counter += 2
    items.append(counter)
    let live = items
    live.append(4)
    println(counter)
    println(len(items))
    println(len(live))
