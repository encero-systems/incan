# Former case literals: int, float, scientific, string, escaped, single-quoted, bool and None literals hold the values written

def test_literals() -> None:
    # Integer literals
    x: int = 42
    y: int = -10
    big: int = 1_000_000
    println(f"{x} {y} {big}")

    # Float literals
    pi: float = 3.14
    neg: float = -2.5
    sci: float = 1.5e10
    println(f"{pi} {neg} {sci}")

    # String literals
    greeting: str = "hello"
    multiline: str = "hello\nworld"
    quote: str = 'single'
    println(f"{greeting} {quote}")
    println(multiline)

    # Boolean literals
    yes: bool = true
    no: bool = false
    println(f"{yes} {no}")

    # None literal (Optional type)
    maybe: Option[int] = None
    match maybe:
        Some(value) => println(value)
        None => println("none")


pub def main() -> None:
    test_literals()
