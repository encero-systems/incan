"""Run the program of each former case in order."""

import assignments
import control_flow
import inferred_reassign
import literals
import loop_expressions
import mixed_f32_arithmetic
import mixed_numeric_and_float_display
import operators
import type_annotations
import user_defined_operators


def main() -> None:
    """Run each former case's program in turn."""
    assignments.main()
    control_flow.main()
    inferred_reassign.main()
    literals.main()
    loop_expressions.main()
    mixed_f32_arithmetic.main()
    mixed_numeric_and_float_display.main()
    operators.main()
    type_annotations.main()
    user_defined_operators.main()
