# Former case mixed_numeric_and_float_display: int and float operands mix in arithmetic, and a float renders with its decimal point in println, str() and f-strings, an f64 included since it is a float, while :? keeps the plain rendering (#1372)

def mixed_ops(x: int, y: float) -> float:
    a = x + y
    b = y + x
    c = x * y
    d = y / x
    e = x / y
    f = x - y
    return a + b + c + d + e + f


model Reading:
    value: float


def describe(reading: Reading, exact: f64) -> str:
    total: float = 100.0
    quarter = total / 4.0
    interpolated = f"total={total} quarter={quarter} field={reading.value} debug={total:?} exact={exact}"
    converted = str(total) + " " + str(reading.value)
    println(total, quarter)
    println(str(quarter))
    return f"{interpolated} {converted}"


pub def main() -> None:
    result = mixed_ops(2, 3.5)
    println(result)
    println(describe(Reading(value=2.0), 3.0))
