"""Declare identifiers and containers whose element identity belongs to this module."""

from rust::std::sync import Arc


@derive(Clone)
pub model EvidenceId:
    """An identifier owned by this module."""
    pub text: str


pub model Decision:
    """Collection and optional fields whose leaf owner belongs to this module."""
    pub evidence_ids: list[EvidenceId]
    pub first: Option[EvidenceId]
    pub by_name: Dict[str, EvidenceId]


pub def count(values: list[EvidenceId], first: Option[EvidenceId], by_name: Dict[str, EvidenceId]) -> int:
    """Count the collection values without requiring a populated identifier."""
    return len(values) + len(by_name)


pub def make() -> EvidenceId:
    """Return a populated identifier owned by this module."""
    return EvidenceId(text="foreign")


pub def text_of(value: EvidenceId) -> str:
    """Read an identifier under its own declaring module's field identity."""
    return value.text


pub model Shared:
    """Hold identifiers inside a shared native container without exporting its element binding."""
    pub evidence_ids: Arc[list[EvidenceId]]


pub def make_shared() -> Shared:
    """Return a shared collection whose element belongs to this module."""
    return Shared(evidence_ids=Arc.new([make()]))
