# behavior: replacing graph storage while a generic selection carrying its reader is used later is refused at the replacement, with the later carrying-field read retaining the dependency (#2500)
# expect-diagnostic: INCAN-T0126


class Reader:
    pub values: list[int]


class Selection[R]:
    pub reader: R


def select(reader: Borrowed[Reader]) -> Selection[Borrowed[Reader]] from reader:
    return Selection[Borrowed[Reader]](reader=reader)


def conflict(mut reader: BorrowedMut[Reader]) -> int:
    selection = select(reader)
    reader.values = [9]
    return selection.reader.values[0]


def main() -> int:
    mut reader = Reader(values=[1])
    return conflict(reader)
