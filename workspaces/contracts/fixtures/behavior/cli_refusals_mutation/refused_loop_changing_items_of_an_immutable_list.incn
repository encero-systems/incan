# behavior: a for loop or a list comprehension that changes its items through its variable, over a local declared without mut read directly, through enumerate, zip or values(), through a field, a list element or a tuple element, is refused at check time; replacing the borrowed list or its parent is also refused (#2498)
# expect-diagnostic: INCAN-T0001
# expect-diagnostic: INCAN-T0121

class Holder:
    pub rows: list[list[int]]


def main() -> None:
    rows: list[list[int]] = [[1]]
    for row in rows:
        row.append(2)
    for i, row in enumerate(rows):
        row.append(i)
    for row, n in zip(rows, [3]):
        row.append(n)
    table: dict[str, list[int]] = {"a": [1]}
    for value in table.values():
        value.append(4)
    holder = Holder(rows=[[1]])
    for row in holder.rows:
        row.append(5)
    groups: list[list[list[int]]] = [[[1]]]
    for row in groups[0]:
        row.append(6)
    pair: tuple[list[list[int]], int] = ([[1]], 0)
    for row in pair[0]:
        row.append(7)
    popped = [row.pop() for row in rows]
    println(len(rows[0]))


model Pending:
    pub token: str


class Client:
    pub pending: list[Pending]


def settle(mut client: Client) -> None:
    for pending in client.pending:
        client.pending = [item for item in client.pending if item.token != pending.token]


def replace_parent() -> None:
    mut client = Client(pending=[Pending(token="one")])
    for pending in client.pending:
        client = Client(pending=[])
        println(pending.token)


def replace_list() -> None:
    mut values = [1, 2]
    for value in values:
        values = []
        println(value)
