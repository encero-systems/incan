# behavior: a branch that replaces graph storage is refused when its join reaches a later generic-selection use carrying the original reader (#2500)
# expect-diagnostic: INCAN-T0126


class Reader:
    pub values: list[int]


class Selection[R]:
    pub reader: R


def select(reader: Borrowed[Reader]) -> Selection[Borrowed[Reader]] from reader:
    return Selection[Borrowed[Reader]](reader=reader)


def conflict(mut reader: BorrowedMut[Reader], replace: bool) -> int:
    selection = select(reader)
    if replace:
        reader.values = [9]
    return selection.reader.values[0]


def main() -> int:
    mut reader = Reader(values=[1])
    return conflict(reader, true)
