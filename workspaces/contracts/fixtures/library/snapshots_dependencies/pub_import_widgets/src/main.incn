# behavior: compiled packages preserve generic FallibleIterator bounds, named and module imports, shared static lists, and owned Result, Option and model returns from static receivers (#1280, #2481, RFC 031, RFC 052)
# expect-stdout:
#   2
#   default
#   default
#   default
#   2

from pub::widgets import Widget, make_widget, DEFAULT_NAME, SHARED_ITEMS, SHARED_WIDGET, Stream
import pub::widgets
import pub::widgets as w


pub def drain[R](stream: Stream[R]) -> Result[int, str]:
    mut count = 0
    for _item in stream?:
        count += 1
    return Ok(count)


def show_drained_stream() -> None:
    match drain(Stream(value="text")):
        Ok(count) => println(count)
        Err(error) => println(error)


def show_package_imports() -> None:
    mut first: Widget = make_widget(DEFAULT_NAME)
    println(first.name)
    println(widgets.make_widget(DEFAULT_NAME).name)
    println(w.make_widget(DEFAULT_NAME).name)
    SHARED_ITEMS.append(1)
    let live = SHARED_ITEMS
    live.append(2)
    println(len(SHARED_ITEMS))


def show_static_results() -> None:
    """Keep delegated owned results alive while later calls mutate the guarded receiver."""
    optional = SHARED_WIDGET.optional(true)
    snapshot = SHARED_WIDGET.snapshot()
    match SHARED_WIDGET.optional(false):
        None => pass
        Some(_) =>
            assert false
    match SHARED_WIDGET.record(true):
        Ok(_) => pass
        Err(_) =>
            assert false
    error = SHARED_WIDGET.record(false)
    match optional:
        Some(value) =>
            assert value.name == "initial"
        None =>
            assert false
    assert snapshot.name == "initial"
    assert SHARED_WIDGET.name == "recorded"
    match error:
        Ok(_) =>
            assert false
        Err(message) =>
            assert message == "refused"


def main() -> None:
    show_drained_stream()
    show_package_imports()
    show_static_results()
