from std.derives.collection import FallibleIterator


pub model Widget:
    pub name: str

    def record(mut self, accepted: bool) -> Result[None, str]:
        """Keep the updated name in static storage and return an owned status."""
        if not accepted:
            return Err("refused")
        self.name = "recorded"
        return Ok(None)

    def optional(self, present: bool) -> Option[Widget]:
        """Return an optional owned snapshot across the package boundary."""
        if present:
            return Some(Widget(name=self.name))
        return None

    def snapshot(self) -> Widget:
        """Return an owned model across the package boundary."""
        return Widget(name=self.name)


pub const DEFAULT_NAME: str = "default"
pub static SHARED_COUNT: int = 0
pub static SHARED_ITEMS: list[int] = []
pub static SHARED_WIDGET: Widget = Widget(name="initial")


pub def make_widget(name: str) -> Widget:
    return Widget(name=name)


pub model Stream[R] with FallibleIterator[int, str]:
    pub value: R
    pub remaining: int = 2

    def __next__(mut self) -> Result[Option[int], str]:
        if self.remaining == 0:
            return Ok(None)
        self.remaining -= 1
        return Ok(Some(self.remaining))
