"""Exercise process-crash isolation at the provider boundary."""

from rust::std::process import abort
from std.vocab import (
    ClauseSurface, DeclarationSurface, DesugarError, DesugarRequest, DesugarResponse, DslSurface, VocabRegistration,
)


pub def library_vocab() -> VocabRegistration:
    """Register a query whose provider deliberately aborts."""
    query = DeclarationSurface.named("query").with_clause_body().desugars_to_expression()
    surface = DslSurface.on_import("words").with_declaration(query.with_clause(ClauseSurface.expr("FROM").required()))
    return VocabRegistration.new().with_surface(surface).with_desugarer()


pub def desugar(request: DesugarRequest) -> Result[DesugarResponse, DesugarError]:
    """Terminate the worker abnormally so its owner must diagnose the source node."""
    abort()
    return Err(DesugarError.at(request.node.span(), "unreachable after abort"))
