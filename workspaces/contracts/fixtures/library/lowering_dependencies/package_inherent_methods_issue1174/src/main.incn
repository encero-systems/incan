# behavior: a package's module calls an inherent method of a model from a sibling module of the same package, and a consumer calls that method on the dependency's type directly (#1174)
# expect-stdout:
#   base=10 tax=2
#   total=12

from pub::pricing import Entry, summary


def main() -> None:
    println(summary())
    println(Entry(key="total", amount=12).describe())
