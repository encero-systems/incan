# behavior: package callables retain mut inputs, partial defaults, decorated native tuple-reference parameters, and inferred shared access for plain non-Clone parameters
# expect-stdout:
#   2
#   3
#   4
#   flat of size 3
#   idx of size 4
#   tall of size 3
#   3
#   6
#   6

"""Exercise package callables through values, defaults, source mutation, and decorated native references."""

from pub::callability import Counter, default_build, grow, hyperquant, keep_refs, map_owned, new_counter, plus_one, poisoned
from rust::std::vec import Vec
from rust::std::sync import Mutex
from pub::callability import Adder, ForwardedUnary, NativeDebug, Unary, apply_custom, apply_unary
from std.io import BinaryReader
from std.traits.callable import Callable1 as DirectUnary
import std.traits.callable as callable_traits


def apply_forwarded[F with Unary[int, int]](operation: F, value: int) -> int:
    """A forwarded alias still selects the standard callable declaration."""
    return operation(value)


def apply_transitive[F with ForwardedUnary[int, int]](operation: F, value: int) -> int:
    """A local facade and compiled provider retain the original callable trait."""
    return operation(value)


def render_forwarded[F with ForwardedUnary[int, str]](operation: F, value: int) -> str:
    """Keep input and result type arguments distinct through the forwarded trait."""
    return operation(value)


def apply_direct[F with DirectUnary[int, int]](operation: F, value: int) -> int:
    """A direct alias preserves the same contextual closure contract."""
    return operation(value)


def apply_qualified[F with callable_traits.Callable1[int, int]](operation: F, value: int) -> int:
    """A module alias preserves the same contextual closure contract."""
    return operation(value)


def consume[R with BinaryReader](input: R) -> Result[None, str]:
    """The published iterator method supplies IoError to its unannotated error-mapping closure."""
    for chunk in input.chunks(1).map_err((error) => error.detail)?:
        pass
    return Ok(None)


def apply(step: (mut Counter, int) -> int, mut counter: Counter) -> int:
    return step(counter, 3)


def show_callable_values() -> None:
    mapped = map_owned([1, 2, 3], plus_one)
    for item in mapped:
        println(item)


def show_partial_defaults() -> None:
    println(default_build())
    println(hyperquant.default_index())
    println(default_build(label="tall"))


def show_mut_parameters() -> None:
    mut counter = new_counter(1)
    println(grow(counter, 2))
    println(apply(grow, counter))
    println(counter.value)


def main() -> None:
    """1. Bind native owners across the package boundary. 2. Exercise callable values, defaults, and mutation."""
    # 1. Keep the owned vector ABI and its nested exclusive references across the package boundary.
    keep_refs(Vec.new())
    lock = Mutex.new(7)
    assert not poisoned(lock)
    assert not poisoned(lock)
    # 2. Retain the existing callable, default, and caller mutation observations.
    show_callable_values()
    show_partial_defaults()
    show_mut_parameters()
    assert apply_unary((value) => value + 2, 40) == 42
    assert apply_forwarded((value) => value + 3, 40) == 43
    assert apply_direct((value) => value + 4, 40) == 44
    assert apply_qualified((value) => value + 5, 40) == 45
    assert apply_custom(Adder(amount=7), 40) == 47
    assert apply_transitive((value) => value + 6, 40) == 46
    assert render_forwarded((value) => f"n={value}", 42) == "n=42"
