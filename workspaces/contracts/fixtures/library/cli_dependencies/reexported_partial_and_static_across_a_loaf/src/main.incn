# behavior: a public model's partial and a static, re-exported through a facade module of a path-dependency Loaf, are callable and readable under a consumer alias, and the partial's model keeps its fields
# expect-stdout:
#   core
#   portable
#   1

from pub::caselib.facade import portable as make_spec
from pub::caselib.facade import counter as shared


def main() -> None:
    let spec = make_spec(policy="portable")
    println(spec.namespace)
    println(spec.policy)
    println(shared)
