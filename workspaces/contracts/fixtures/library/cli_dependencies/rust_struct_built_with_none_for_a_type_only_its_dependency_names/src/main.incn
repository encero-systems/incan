# behavior: a consumer constructs a Rust struct with `None` for an Option field whose type only its dependency names, then hands the struct to that dependency
# expect-stdout:
#   7
#   badge 7 depth -1

from pub::badges import described
from rust::scopes import Badge


def main() -> None:
    """Build a badge without naming its scope type."""
    badge = Badge(id=7, scope=None)
    println(badge.id)
    println(described(badge))
