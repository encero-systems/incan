# behavior: a library value enum keeps its generated getter and parser under imported and returned values
# expect-stdout:
#   loud
#   quiet
#   loud
#   missing

from pub::levels import selected
from pub::levels.kinds import Level as Volume


def main() -> None:
    """Call generated enum members on each library boundary surface."""
    println(selected().value())
    println(Volume.Quiet.value())
    match Volume.from_value("loud"):
        Some(level) => println(level.value())
        None => println("unexpected")
    match Volume.from_value("absent"):
        Some(level) => println(level.value())
        None => println("missing")
