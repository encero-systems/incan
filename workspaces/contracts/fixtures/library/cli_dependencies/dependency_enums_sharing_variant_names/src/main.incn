# behavior: a dependency's enums keep their own variants and layouts: enums that share variant names (a value enum beside payload enums of other arities, in both declaration orders, and enums imported from a sibling module) each publish their own variants, and a variant whose payload type is declared after its enum publishes that type, with the dependency building and the consumer constructing, matching and printing each (#1561); a library value enum keeps its generated getter and parser under imported and returned values; and dependency enum aliases through two reexports retain their owner and payload layout even when another enum has the same member names in a different order (#1337, #1698)
# expect-stdout:
#   loud
#   quiet
#   loud
#   missing
#   enter intro
#   leave
#   enter
#   leave
#   entering
#   leaving
#   intro at gate 1
#   gone
#   north at gate 4
#   enter 1,2
#   leave done
#   start
#   start
#   start 4
#   2
#   3
#   41
#   0
#   42
#   -1

from enum_reexports import run_enum_reexports
from value_enum_helpers import run_value_enum_helpers
from variant_names import run_variant_names


def main() -> None:
    """Run each dependency enum observation in the order of the cases it carries."""
    run_value_enum_helpers()
    run_variant_names()
    run_enum_reexports()
