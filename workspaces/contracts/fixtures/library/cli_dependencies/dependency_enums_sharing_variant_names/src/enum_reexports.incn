"""A consumer matching enum aliases the dependency reexports through two modules."""

from pub::enums import RelayedPacket as LocalPacket, Other


def packet_value(packet: LocalPacket) -> int:
    match packet:
        case LocalPacket.Value(value):
            return value
        case LocalPacket.Empty:
            return 0


def other_value(packet: Other) -> int:
    match packet:
        case Other.Empty:
            return -1
        case Other.Value(value):
            return value


pub def run_enum_reexports() -> None:
    """Read the payload of each enum that shares member names with the other."""
    println(packet_value(LocalPacket.Value(41)))
    println(packet_value(LocalPacket.Empty))
    println(other_value(Other.Value(42)))
    println(other_value(Other.Empty))
