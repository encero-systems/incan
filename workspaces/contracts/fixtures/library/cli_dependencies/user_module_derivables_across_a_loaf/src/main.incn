# behavior: the modules of a path-dependency Loaf supply traits to @derive by the names their __derives__ lists, declared or imported under another spelling, beside the stdlib json derive (RFC 024)
# expect-stdout:
#   yaml
#   {"value":1}
#   schema
#   {"value":7}
#   8
#   {"value":9}
#   schema
#   {"value":11}
#   12

from std.serde import json
import pub::caselib.yaml as yaml
import pub::caselib.schema as schema
import pub::caselib.formats as formats
import pub::caselib.formats as aliases
import pub::caselib.descriptions as descriptions
import pub::caselib.relayed_formats as relayed_formats


@derive(json, yaml)
model Payload:
    value: int


@derive(schema)
model Schematic:
    value: int


def encode_yaml[T with yaml.Serialize](value: T) -> str:
    return value.to_yaml()


def encode_json[T with json.Serialize](value: T) -> str:
    return value.to_json()


def name[T with schema.Named](value: T) -> str:
    return value.schema_name()


def main() -> None:
    println(encode_yaml(Payload(value=1)))
    println(encode_json(Payload(value=1)))
    println(name(Schematic(value=1)))
    println(encode_json(Encoded(value=7)))
    match formats.restore[Encoded]('{"value":8}'):
        Ok(value) => println(value.value)
        Err(error) => println(error)
    println(encode_json(Combined(value=9)))
    println(name(Described(value=1)))
    println(encode_json(Relayed(value=11)))
    match relayed_formats.restore[Relayed]('{"value":12}'):
        Ok(value) => println(value.value)
        Err(error) => println(error)


@derive(formats)
model Encoded:
    value: int


@derive(aliases, json)
model Combined:
    value: int


@derive(descriptions)
model Described:
    value: int


@derive(relayed_formats)
model Relayed:
    value: int
