from standard_reexports import run_standard_reexports
from library_module_import import run_library_module_import
from renamed_export import run_renamed_export
from submodule_reexports import run_submodule_reexports
from type_identity import run_type_identity
from linked_type_members import run_linked_type_members


def main() -> None:
    """Run each re-export observation in the order of the cases it carries."""
    run_standard_reexports()
    run_type_identity()
    run_renamed_export()
    run_submodule_reexports()
    run_linked_type_members()
    run_library_module_import()
