"""A consumer spelling one dependency type through its declaring module, a facade and the package root."""

from pub::facades import SearchProfile, best_outcome, build_index, entry_id, entry_id_text, exact_query, Outcome
from pub::facades import Nomination as RootNomination, Candidate
from pub::facades.search import Nomination as FacadeNomination, SearchProfile as FacadeProfile
from pub::facades.search.models import Nomination as DeclaredNomination


def root_label(nomination: RootNomination) -> str:
    return nomination.label()


def facade_rank(nomination: FacadeNomination) -> int:
    return nomination.rank


def profile_name(profile: FacadeProfile) -> str:
    match profile:
        case FacadeProfile.Exact:
            return "exact"
        case FacadeProfile.Approximate:
            return "approximate"


pub def run_type_identity() -> None:
    """Pass values spelled through one path where another path's type is expected."""
    match build_index([entry_id("a"), entry_id("b"), entry_id("c")]):
        case Ok(index):
            match exact_query(index, 2):
                case Ok(result):
                    println(len(result.nominations))
                    println(f"{result.nominations[0].rank} {result.nominations[0].label()}")
                    println(f"{entry_id_text(result.nominations[1].entry_id)} {result.nominations[1].relevance_bps}")
                    first = result.nominations[0]
                    println(f"{root_label(first)} {facade_rank(first)}")
                    declared: DeclaredNomination = first
                    println(f"{declared.rank} {len(result.candidates) - 1}")
                    println(f"{profile_name(result.profile)} {profile_name(SearchProfile.Exact)}")
                    rooted: RootNomination = FacadeNomination(entry_id=entry_id("z"), rank=9, relevance_bps=1)
                    println(f"{root_label(rooted)} {facade_rank(rooted)}")
                    root_candidate = Candidate(label="root")
                    println(f"{entry_id_text(result.candidates[1].entry_id)} {result.candidates[1].score} {root_candidate.label}")
                case Err(error):
                    println(error.message())
            match best_outcome(index):
                case Outcome.Found(RootNomination(rank=rank)):
                    println(f"found {rank}")
                case Outcome.Missing:
                    println("missing")
        case Err(error):
            println(error.message())
