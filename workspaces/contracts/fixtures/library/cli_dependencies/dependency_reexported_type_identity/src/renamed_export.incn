"""A consumer calling a function a sibling module re-exports under a further name."""

from facade import b_calculate, relayed_scalar, measure, echo
from pub::facades import format_scalar, WrappedValue as ProviderValue
from relay import scalar_again


model WrappedValue:
    """A local namesake must not replace the provider's parameter identity."""
    pub value: int


def apply_scalar(relayed_scalar: Callable[int, int]) -> int:
    """A parameter shadows the imported source bridge in this scope."""
    return relayed_scalar(4)


def double(value: int) -> int:
    return value * 2


pub def run_renamed_export() -> None:
    """Call the twice-renamed function by its final name."""
    println(b_calculate(41))
    direct_number = format_scalar(1)
    relayed_number = relayed_scalar(1)
    direct_text = format_scalar("a")
    relayed_text = relayed_scalar("a")
    assert direct_number == 2
    assert relayed_number == direct_number
    assert direct_text == "a!"
    assert relayed_text == direct_text
    assert scalar_again(1) == direct_number
    assert scalar_again("a") == direct_text
    local_value = WrappedValue(value=100)
    assert local_value.value == 100
    assert measure(ProviderValue(value=7)) == 7
    assert measure("abc") == 3
    assert echo[int](5) == 5
    assert echo("x", 2) == "x"
    assert apply_scalar(double) == 8
