from std.traits.callable import Callable1
from std.traits.callable import Callable1 as Mapper


pub model Holder[V]:
    pub value: V

    def get(self) -> V:
        return self.value

    def first[T](self, items: list[T]) -> T:
        return items[0]


pub def first[K](items: list[K]) -> K:
    return items[0]


pub trait Picker:
    def pick[K](self, items: list[K]) -> K:
        return items[0]

    def plain(self) -> int:
        return 1

    def required(self) -> int: ...


pub model Selector with Picker:
    pub id: int

    def required(self) -> int:
        return self.id


pub def apply[F with Mapper[int, int]](f: F, value: int) -> int:
    return f(value)


pub trait Failing[E]:
    def failure(self) -> E: ...

    def describe[F with Clone, Describe with (Clone, Callable1[E, F])](self, f: Describe) -> F:
        return f(self.failure())


pub model Lookup with Failing[str]:
    pub key: str

    def failure(self) -> str:
        return self.key


pub trait Labeled:
    """Describe values through one required method and one reusable default."""

    def text(self) -> str:
        """Return the receiver's own label."""
        ...

    def decorated(self) -> str:
        """Call the receiver's selected implementation from the inherited default."""
        return f"<{self.text()}>"

    def set(mut self, value: str) -> None:
        """Replace the receiver's label."""
        ...

    def replace(mut self, first: str, second: str) -> str:
        """Retain the exclusive receiver across two compiled mutations and a shared read."""
        self.set(first)
        self.set(second)
        return self.text()


pub model Item with Labeled:
    """Supply the label in a compiled library method."""

    pub value: str

    def text(self) -> str:
        """Read the library-owned value."""
        return self.value

    def set(mut self, value: str) -> None:
        """Update the library-owned field in place."""
        self.value = value
