# behavior: a dependency's trait is one trait under every spelling a consumer uses: a consumer's model that adopts it under one spelling meets a bound that names the trait under another (the trait, an import alias, the dependency's alias and a module-bound spelling), a dependency's trait named through a module binding, as the trait or as the dependency's alias of it, is the dependency's own trait, so the dependency's model reached through the binding meets a bound on either spelling, and a trait imported under an alias or exported under one makes the dependency's model meet a bound on either spelling while a consumer's model adopts it with its own methods
# expect-stdout:
#   mine
#   YOURS
#   mine
#   OURS
#   theirs
#   theirs
#   dep!
#   dep
#   MINE
#   yours
#   dep!
#   dep
#   MINE
#   yours

from alias_spelling import run_alias_spelling
from bound_spellings import run_bound_spellings
from module_binding import run_module_binding


def main() -> None:
    """Run each spelling observation in the order of the cases it carries."""
    run_bound_spellings()
    run_module_binding()
    run_alias_spelling()
