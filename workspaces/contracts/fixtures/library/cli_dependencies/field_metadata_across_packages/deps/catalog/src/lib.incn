from std.primitives import copy_frozen_bytes, hexlify


pub model Account:
    pub type_ [alias="type", description="Account type", renamed_from="email"]: str
    pub balance [description="Balance in cents", renamed_from=["mail", "cached_at"], canonical=false]: int = 0
    pub external_id as "externalId": str
    pub title: str = ""
    hidden: str = "x"


pub def local_fields() -> list[str]:
    """Describe the public fields from inside the provider."""
    return [f"{info.name}:{info.wire_name}" for info in Account.__fields__()]


pub def local_record_metadata() -> list[str]:
    """Describe the provider's compiler-derived field identity facts."""
    mut result: list[str] = []
    for info in Account.__fields__():
        if str(info.name) in ["type_", "balance", "title"]:
            result.append(
                f"{info.name}:{hexlify(copy_frozen_bytes(info.identity))}:{info.canonical}:{','.join([str(name) for name in info.renamed_from])}",
            )
    return result
