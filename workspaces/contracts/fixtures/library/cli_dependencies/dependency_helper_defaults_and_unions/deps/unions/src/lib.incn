pub from search import ExactResult, Nomination, exact_query, weigh


pub model Box:
    pub value: int

    pub def answer(self) -> Union[int, str]:
        if self.value > 0:
            return self.value
        return "empty"

    pub def answers(self) -> list[Union[int, str]]:
        return [self.answer()]

    pub def maybe(self) -> Option[Union[int, str]]:
        if self.value > 0:
            return Some(self.answer())
        return None


pub model NumberExpr:
    """A numeric expression's name."""

    pub name: str


pub model BoolExpr:
    """A Boolean expression's name."""

    pub name: str


pub type Expr = Union[NumberExpr, BoolExpr]


pub def number(name: str) -> NumberExpr:
    """Return a single member of the public union."""
    return NumberExpr(name=name)


pub def assign(name: str, expr: Expr) -> str:
    """Accept either public expression member."""
    return name
