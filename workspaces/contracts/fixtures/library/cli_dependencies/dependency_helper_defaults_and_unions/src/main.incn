from element_fields import run_element_fields
from helper_defaults import run_helper_defaults
from member_argument import run_member_argument
from method_unions import run_method_unions
from option_unions import run_option_unions
from same_named import run_same_named


def main() -> None:
    """Run each union observation in the order of the cases it carries."""
    run_helper_defaults()
    run_method_unions()
    run_same_named()
    run_element_fields()
    run_option_unions()
    run_member_argument()
