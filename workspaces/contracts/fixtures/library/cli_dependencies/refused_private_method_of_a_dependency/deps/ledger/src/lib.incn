"""Keep a helper method private to its type in a compiled library (#2570)."""


pub class Ledger:
    pub total: int
    secret [made_private { message="Use report", replacement=Ledger.report }]: int

    pub def report(self) -> int:
        return self.checksum() + self.secret

    @made_private(message="Use report", replacement=Ledger.report)
    def checksum(self) -> int:
        return self.total * 31


@made_private(message="Use Ledger", replacement=Ledger)
class LegacyLedger:
    pub total: int


def legacy_total() -> int:
    legacy = LegacyLedger(total=4)
    return legacy.total
