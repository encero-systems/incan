pub model Item:
    pub value: int


pub def make() -> Item:
    return Item(value=11)


pub model Box[T]:
    pub value: T


pub enum State:
    Ready
    Failed


pub enum Outcome[T]:
    Value(T)
    Empty


pub enum Label(str):
    Ready = "ready"
    Failed = "failed"


pub model Node:
    pub children: list[Node]


pub model Record:
    pub item: Item
    hidden: bool = false
    pub boxed: Box[int]
    pub nested: list[Option[Item]]
    pub state: State
    pub nested_box: Box[list[Item]]
    pub tree: Node
    pub outcome: Outcome[Item]
    pub label: Label


pub def own_selector() -> str:
    match Record.__fields__()[0].stored_type:
        Some(value) => return str(value)
        None => return "missing"
