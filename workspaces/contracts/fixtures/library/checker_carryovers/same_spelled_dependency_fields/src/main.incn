# behavior: provider fields keep their owners through annotations and unimported reads beside same-named caller types
# expect-stdout:
#   0
#   true
#   local
#   foreign
#   1
#   foreign

"""Keep caller and provider declarations distinct while reading populated dependency fields."""

from pub::records import Decision, populated
from pub::records import EvidenceId as ForeignEvidenceId
from observe import first_text


model EvidenceId:
    """The caller's own identifier, independent of the dependency's type."""

    text: str


def main() -> None:
    """
    Read dependency collections without confusing their elements with the caller's identifier.

    1. Construct empty fields under the dependency's declared element type.
    2. Read the caller's own identifier independently.
    3. Read populated collections through imported annotations and unimported field owners.
    """
    # 1. Empty fields take the provider's declared context.
    decision = Decision(evidence_ids=[], first=None)
    println(len(decision.evidence_ids))
    println(decision.first is None)
    # 2. The caller's identifier keeps its own declaration.
    own = EvidenceId(text="local")
    println(own.text)
    # 3. Both imported annotations and unimported elements retain the provider's fields.
    println(count_foreign(populated().evidence_ids))
    println(first_text(populated()))


def count_foreign(values: list[ForeignEvidenceId]) -> int:
    """Inspect and count provider identifiers under their imported element declaration."""
    println(values[0].text)
    return len(values)
