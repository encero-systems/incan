# behavior: generic libraries retain source fields, native frozen storage and unimported records (#2256); a native frozen text result closed by a written type argument keeps its owned elements through a local and as an argument (#2447)
# expect-stdout:
#   Parcel(value=7)
#   ok
#   Marker(label="hidden")
#   visible
#   ["visible"]
#   2
#   2

from pub::parcels import Marker, Parcel, entries, freeze_native, freeze_values, frozen_count, unpack, wrap


def main() -> None:
    """Round-trip generic model instances through compiled provider functions."""
    packet = wrap(7)
    println(f"{packet:?}")
    println(unpack(Parcel[str](value="ok")))
    marker = Marker[int](label="hidden")
    println(f"{marker:?}")
    for entry in entries():
        println(entry.value)
    values = [entry.value for entry in entries()]
    println(f"{values:?}")
    assert frozen_count(freeze_values([4, 5])) == 2
    value = freeze_native[str](["native", "storage"])
    println(value.len())
    println(frozen_count(freeze_native[str](["a", "b"])))
