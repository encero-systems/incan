# behavior: a native encoding result retains its unsized byte slice type argument until consumed into owned bytes
# expect-stdout:
#   2

from rust::encoding_rs import Encoding


def main() -> None:
    """Read an encoding's Cow<[u8]> result as owned bytes."""
    match Encoding.for_label(b"utf-8"):
        Some(encoding) =>
            encoded = encoding.encode("ab")
            println(len(encoded.0.into_owned()))
        None => println("missing")
