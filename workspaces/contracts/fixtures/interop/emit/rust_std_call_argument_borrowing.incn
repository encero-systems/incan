# behavior: Incan values passed to Rust standard-library functions borrow as the signature declares: two models swap through mutable borrows, a model and an int are measured by size_of_val through shared borrows, and a list is taken by mutable borrow leaving an empty list behind; a Rust reader mutates owned byte storage through its exact exclusive slice argument; and owned byte storage lends a native byte slice to a Rust function without becoming a borrowed vector
# expect-stdout:
#   2 1
#   8
#   16
#   2
#   0
#   xy
#   ab

from rust::std::io import Cursor, Read
from rust::std::mem import size_of_val, swap, take
from rust::std::str import from_utf8


model Thing:
    value: int


model Wide:
    left: int
    right: int


def show_value_borrows() -> None:
    mut first = Thing(value=1)
    mut second = Thing(value=2)
    swap(first, second)
    println(f"{first.value} {second.value}")
    println(size_of_val(first))
    println(size_of_val(Wide(left=1, right=2)))
    mut items: list[int] = [1, 2]
    taken = take(items)
    println(len(taken))
    println(len(items))


def show_mutable_slice() -> None:
    """Read into a native mutable slice and observe the updated byte owner."""
    mut cursor = Cursor.new(b"xy")
    mut buffer = b"ab"
    match cursor.read_exact(buffer):
        Ok(_) =>
            match from_utf8(buffer):
                Ok(text) => println(text)
                Err(_) => println("invalid")
        Err(_) => println("failed")


def show_shared_slice() -> None:
    """Decode borrowed bytes through the exact native slice signature."""
    data = b"ab"
    match from_utf8(data):
        Ok(text) => println(text)
        Err(_) => println("invalid")


def main() -> None:
    show_value_borrows()
    show_mutable_slice()
    show_shared_slice()
