# behavior: a string literal is accepted as the default of a Rust method's Option of borrowed str (#2232)
# pending: #2232 PathBuf construction leaves an unknown Body IR frame type
# expect-stdout:
#   present

from rust::std::path import PathBuf


def main() -> None:
    """Supply a literal default to an inspected borrowed-string option."""
    path: PathBuf = PathBuf.from("present")
    println(path.to_str().unwrap_or("fallback"))
