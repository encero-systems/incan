# behavior: a Rust HashMap retains its default generic owner and borrowed scalar results across repeated lookups, while a source model's same-named insert uses its own defaulted signature
# expect-stdout:
#   2
#   1
#   missing
#   2
#   3

from rust::std::collections import HashMap


model Counter:
    total: int

    def insert(mut self, key: str, value: int = 1) -> None:
        self.total += value


def lookup(counts: HashMap[str, int], word: str) -> str:
    match counts.get(word):
        Some(count) => return str(count)
        None => return "missing"


def main() -> None:
    mut counts = HashMap.new[str, int]()
    counts.insert("the", 2)
    counts.insert("cat", 1)
    match counts.get("the"):
        Some(count) => println(count)
        None => println("missing")
    println(lookup(counts, "cat"))
    println(lookup(counts, "dog"))
    println(lookup(counts, "the"))
    mut counter = Counter(total=0)
    counter.insert("a")
    counter.insert("b", 2)
    println(counter.total)
