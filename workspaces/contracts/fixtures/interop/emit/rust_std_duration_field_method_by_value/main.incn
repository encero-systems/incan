"""Run the program of each former case in order."""

import case_rust_std_duration_field_method_by_value
import case_rust_std_hashmap_get_and_same_named_methods
import case_rust_std_into_string_argument
import case_rust_std_read_by_ref_over_cursor
import case_rust_std_read_by_ref_through_a_field_guard
import case_rust_std_rusttype_surface_calls
import typed_c_spans


def main() -> None:
    """Run each former case's program in turn."""
    case_rust_std_duration_field_method_by_value.main()
    case_rust_std_hashmap_get_and_same_named_methods.main()
    case_rust_std_into_string_argument.main()
    case_rust_std_read_by_ref_over_cursor.main()
    case_rust_std_read_by_ref_through_a_field_guard.main()
    case_rust_std_rusttype_surface_calls.main()
    typed_c_spans.main()
