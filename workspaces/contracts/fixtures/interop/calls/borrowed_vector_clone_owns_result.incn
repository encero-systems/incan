# behavior: cloning a borrowed native byte vector returns owned bytes that outlive the cursor
# expect-stdout:
#   2

from rust::std::io import Cursor


def copied() -> bytes:
    """Clone the vector behind a borrowed native cursor view."""
    cursor = Cursor.new(b"ab")
    return cursor.get_ref().clone()


def main() -> None:
    """Observe an owned result after its native cursor has gone out of scope."""
    println(len(copied()))
