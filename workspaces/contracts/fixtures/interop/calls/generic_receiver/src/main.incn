# behavior: native receivers retain owners, iterator outputs, primitive views, callbacks and lazy captures (#2256)
# expect-stdout:
#   1
#   770
#   2
#   7
#   8
#   2
#   97
#   2
#   11
#   word
#   [1, 2, 3]
#   [3, 1, 2]
#   ["a", "z"]
#   captured chain created
#   2

"""Keep generic inherent, trait and extension receiver calls of registry crates in one area case."""

from rust::blake2 import Blake2b512
from rust::blake3 import hash as blake3_hash
from rust::byteorder import BigEndian, LittleEndian, ReadBytesExt, WriteBytesExt
from rust::encoding_rs import Encoding
from rust::rand import Rng, thread_rng
from rust::sha2 import Digest, Sha224
from rust::sha3 import Shake128
from rust::sha3::digest import ExtendableOutputReset, Update, XofReader
from rust::incan_std_core::frozen import FrozenList as RuntimeFrozenList
from rust::std::cell import Cell
from rust::std::clone import Clone as NativeClone
from rust::std::collections import HashSet
from rust::std::collections::hash_set import Iter as SetIter
from rust::std::iter import Iterator, FlatMap, IntoIterator
from rust::std::convert import Into as RuntimeInto
from rust::std::io import Cursor
from rust::std::mem import size_of_val
from rust::std::net import Ipv4Addr
from rust::std::ops import Range
from rust::std::primitive import str as RustStr
from rust::std::string import String as RustString
from rust::std::time import Duration
from rust::std::vec import Vec, IntoIter as VectorIterator
from rust::xxhash_rust::xxh32 import Xxh32, xxh32
from rust::xxhash_rust::xxh64 import Xxh64, xxh64
from rust::xxhash_rust::xxh3 import Xxh3Default, xxh3_64, xxh3_128
from rust::incan_std_core::iter import nonnegative_count
from rust::incan_std_core::iter import Generator as NativeGenerator
from rust::incan_std_core::errors import raise_index_error
from std.derives.copying import Clone
from std.derives.comparison import Ord
from std.traits.callable import Callable1
from std.rust import Static


model DecodedValue[T with Clone]:
    """Keep a generic method's intermediate value out of its caller's result signature."""

    item: T


class GenericReader:
    """Close an internal wrapper layout through checked generic method calls."""

    def decode[T with Clone](self, value: T) -> Result[DecodedValue[T], str]:
        """Construct the private intermediate specialization."""
        return Ok(DecodedValue(item=value))

    def read[T with Clone](self, value: T) -> Result[T, str]:
        """Consume the wrapper after an inferred generic method call."""
        decoded = self.decode(value)?
        return Ok(decoded.item)

    def integer(self) -> Result[int, str]:
        """Close the scalar frame without exposing its intermediate layout."""
        return self.read(7)

    def native(self) -> Result[Duration, str]:
        """Close a native-value frame through the same method chain."""
        return self.read(Duration.from_secs(9u64))

    def apply[F with Callable1[int, int]](self, value: int, transform: F) -> int:
        """Invoke a generic callback while retaining its captured environment."""
        return transform(value)

    def keep[F with Callable1[int, int]](self, transform: F) -> F:
        """Return a callback with its captured environment owned by the caller."""
        return transform


class DigestOwner:
    """Retain a native digest behind a source field."""

    handle: Sha224

    def update(mut self, chunk: bytes) -> None:
        """Bind the native method's anonymous by-value input parameter."""
        Digest.update(self.handle, chunk.as_slice())

    def finish(mut self) -> bytes:
        """Return the selected digest output and reset the native owner."""
        return self.handle.finalize_reset().to_vec()


def choose(low: int, high: int) -> int:
    """Infer independent method arguments for a blanket trait implementation."""
    mut rng = thread_rng()
    return rng.gen_range(Range(start=low, end=high))


def choose_source(low: int, high: int) -> int:
    """Pass a source half-open range through the same checked native argument contract."""
    mut rng = thread_rng()
    return rng.gen_range(low..high)


def bound(mut observed: list[int], value: int) -> int:
    """Record each range endpoint evaluation before returning its value."""
    observed.append(value)
    return value


def encoded_bytes() -> bytes:
    """Return a slice method's owned result through an explicit bytes boundary."""
    match Encoding.for_label(b"utf-8"):
        Some(encoding) =>
            encoded = encoding.encode("ab")
            return encoded.0.to_vec()
        None => return b""


def show_extension_traits() -> None:
    """Read and write binary values through the imported cursor extension methods."""
    mut input = Cursor.new(b"\x01\x02\x03")
    match input.read_u8():
        Ok(value) => println(int(value))
        Err(_) => println(-1)
    match input.read_u16[LittleEndian]():
        Ok(value) => println(int(value))
        Err(_) => println(-1)
    mut output = Cursor.new(b"")
    match output.write_u16[BigEndian](16706u16):
        Ok(_) => println(len(output.into_inner()))
        Err(_) => println(-1)


def show_generic_receivers() -> None:
    """Retain the cell's element type and a deterministic singleton random range."""
    value = Cell.new(7)
    println(value.get())
    value.set(8)
    println(value.get())
    text = "borrowed"
    shared: Cell[&str] = Cell.new(text)
    assert len(shared.get()) == 8
    assert len(shared.get()) == 8
    assert text == "borrowed"
    assert choose(7, 8) == 7
    assert choose_source(9, 10) == 9
    mut observed: list[int] = []
    mut rng = thread_rng()
    selected: int = rng.gen_range(bound(observed, 11)..bound(observed, 12))
    assert selected == 11
    assert observed == [11, 12]
    inferred: u8 = rng.gen_range(13..14).wrapping_resize()
    assert inferred == 13u8
    native: Sha224 = Sha224.default()
    mut digest = DigestOwner(handle=native)
    digest.update(b"abc")
    output = digest.finish()
    assert len(output) == 28
    assert output == b"\x23\x09\x7d\x22\x34\x05\xd8\x22\x86\x42\xa4\x77\xbd\xa2\x55\xb3\x2a\xad\xbc\xe4\xbd\xa0\xb3\xf7\xe3\x6c\x9d\xa7"
    mut other = Blake2b512.default()
    Digest.update(other, b"abc".as_slice())
    assert len(other.finalize_reset().to_vec()) == 64
    mut shake = Shake128.default()
    Update.update(shake, b"abc".as_slice())
    mut reader = ExtendableOutputReset.finalize_xof_reset(shake)
    mut output = b"\x00\x00\x00\x00"
    reader.read(output)
    assert output == b"\x58\x81\x09\x2d"
    owner = blake3_hash(b"abc".as_slice())
    assert size_of_val(owner.as_bytes()) == 32
    view = owner.as_bytes()
    copied = view.to_vec()
    assert len(copied) == 32
    assert copied == owner.as_bytes().to_vec()
    octets = Ipv4Addr.new(127u8, 0u8, 0u8, 1u8).octets()
    assert octets.to_vec() == b"\x7f\x00\x00\x01"
    input = b"abc"
    mut small = Xxh32.default()
    small.update(input.as_slice())
    assert small.digest() == xxh32(input.as_slice(), 0u32)
    mut large = Xxh64.default()
    large.update(input.as_slice())
    assert large.digest() == xxh64(input.as_slice(), 0u64)
    mut wide = Xxh3Default.default()
    wide.update(input.as_slice())
    assert wide.digest() == xxh3_64(input.as_slice())
    assert wide.digest128() == xxh3_128(input.as_slice())
    match GenericReader().integer():
        Ok(decoded) => assert decoded == 7
        Err(_error) => assert false
    match GenericReader().native():
        Ok(decoded) => assert decoded.as_secs() == 9u64
        Err(_error) => assert false
    increment = 3
    assert GenericReader().apply(transform=(value) => value + increment, value=4) == 7
    retained = GenericReader().keep((value) => value + increment)
    assert retained(5) == 8


def show_slice_methods() -> None:
    """Copy bytes through a slice method and keep the Cow available for another read."""
    match Encoding.for_label(b"utf-8"):
        Some(encoding) =>
            encoded = encoding.encode("ab")
            copied = encoded.0.to_vec()
            println(len(copied))
            println(copied[0])
            println(len(encoded.0.to_vec()))
        None => println("missing")
    assert len(encoded_bytes()) == 2


def sorted_snapshot[T with (Clone, Ord)](values: &list[T]) -> list[T]:
    """Sort a copied generic vector through its exclusive native slice."""
    mut owned: Vec[T] = NativeClone.clone(values)
    mut view = owned.as_mut_slice()
    view.sort()
    return owned


def set_cursor[T with Clone](values: &HashSet[T], index: int) -> T:
    """Copy an indexed native iterator item without reentering a language set loop."""
    mut iterator: SetIter[T] = values.iter()
    match iterator.nth(nonnegative_count(index)):
        Some(value) =>
            element: &T = value
            return element.clone()
        None => return raise_index_error("set cursor outside collection")


def first_set_item(values: &HashSet[int]) -> int:
    """Read a borrowed iterator's normalized associated item without consuming its set."""
    mut iterator = values.iter()
    match iterator.next():
        Some(value) => return value.clone()
        None => return 0


def clone_parameter[T with NativeClone](value: &T) -> T:
    """Keep the receiver's type parameter as the explicit native Clone call's result."""
    return NativeClone.clone(value)


def copy_frozen[T with (NativeClone, Static)](value: RuntimeFrozenList[T]) -> list[T]:
    """Keep a generic borrowed slice's structural element carrier through its inherent copy method."""
    return value.as_slice().to_vec()


def check_primitive_and_parameter_receivers() -> None:
    """Exercise primitive re-export methods and bound native receivers without changing the observations above."""
    value = 17
    assert clone_parameter(value) == 17
    frozen: RuntimeFrozenList[int] = RuntimeFrozenList.leak([2, 3])
    assert copy_frozen[int](frozen) == [2, 3]
    mut pieces: list[str] = []
    for piece in RustStr.split_whitespace(" one\t two\n"):
        pieces.append(str(piece))
    assert pieces == ["one", "two"]
    source = b"ab"
    assert copy_slice_bytes(source) == b"ab"
    assert source == b"ab"
    copied: str = RustString.from_utf8_lossy(source.as_slice()).into_owned()
    assert copied == "ab"
    text: RustString = "ab"
    assert forward_native_text(text) == b"ab"


def copy_slice_bytes(value: bytes) -> bytes:
    """Keep a borrowed slice as Into's Self while the owned destination closes the trait's result binder."""
    return RuntimeInto.into(value.as_slice())


def copy_native_text(value: &RustString) -> bytes:
    """Clone shared native text before consuming its owned byte buffer."""
    copied: RustString = value.clone()
    return copied.into_bytes()


def forward_native_text(value: &RustString) -> bytes:
    """Forward a shared native reference without changing the native Clone receiver's Self."""
    return copy_native_text(value)


def native_snapshot_length[Element with Clone](values: &list[Element]) -> int:
    """Count a snapshot: 1. Clone an independent vector. 2. Consume its iterator without changing the source."""
    # 1. Clone an independent vector.
    snapshot: list[Element] = NativeClone.clone(values)
    # 2. Consume its iterator without changing the source.
    mut iterator: VectorIterator[Element] = IntoIterator.into_iter(snapshot)
    return int(iterator.count())


def singleton(value: int) -> Generator[int]:
    """Defer one value until a native chain polls it."""
    yield value


def captured_chain[F with (Callable1[int, Generator[int]], Static)](
    source: Generator[int], step: F,
) -> Generator[int]:
    """1. Retain the native source. 2. Return its lazy chain with the callable's owned environment."""
    # 1. Retain the native source.
    native: NativeGenerator[int] = source
    # 2. Return its lazy chain with the callable's owned environment.
    adapted: FlatMap[NativeGenerator[int], NativeGenerator[int], F] = native.flat_map(step)
    return NativeGenerator.new(adapted)


def main() -> None:
    """Run each registry-crate observation in the order of the cases it carries."""
    show_extension_traits()
    show_generic_receivers()
    show_slice_methods()
    println(first_set_item({11}))
    println(set_cursor[str]({"word"}, 0))
    values = [3, 1, 2]
    println(f"{sorted_snapshot[int](values):?}")
    println(f"{values:?}")
    words = ["z", "a"]
    println(f"{sorted_snapshot[str](words):?}")
    check_primitive_and_parameter_receivers()
    offset = 5
    deferred = captured_chain(singleton(1), (value) => singleton(value + offset))
    println("captured chain created")
    println(native_snapshot_length[str](words))
