# behavior: a dependency's unit enum values compare by their exact enum identities
# expect-stdout:
#   true
#   true

from rust::rustix::fs import FlockOperation


def main() -> None:
    """Compare the shared and exclusive file-lock operations as native values."""
    shared = FlockOperation.LockShared
    same = FlockOperation.LockShared
    exclusive = FlockOperation.LockExclusive
    println(shared == same)
    println(shared != exclusive)
