# behavior: Rust scalar reference parameters borrow caller storage, and mutable references update both caller bindings
# expect-stdout:
#   true
#   2
#   1

"""Use shared scalar loans and an in-place generic Rust swap."""

from rust::std::mem import size_of_val, swap


def main() -> None:
    """Observe the caller's values after their mutable Rust loans end."""
    mut left = 1
    mut right = 2
    println(size_of_val(left) == size_of_val(7))
    swap(left, right)
    println(left)
    println(right)
