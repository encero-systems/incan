# behavior: a native directory iterator retains its Result Item and allows methods on successful entries
# expect-stdout:
#   true

from rust::std::fs import read_dir


def main() -> None:
    """Read entries from the materialized contract project without assuming their order."""
    mut count = 0
    match read_dir("."):
        Ok(entries) =>
            for entry in entries:
                match entry:
                    Ok(value) =>
                        text = value.path().to_string_lossy().into_owned()
                        if len(text) > 0:
                            count += 1
                    Err(_) => println("entry error")
        Err(_) => println("directory error")
    println(count > 0)
