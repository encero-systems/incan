# behavior: a generic Rust function retains Incan model identity and borrows the caller's values
# expect-stdout:
#   2 1
#   8

"""Pass Incan values through Rust generic functions without losing their declaration identities."""

from rust::std::mem import size_of_val, swap


model Item:
    """A source model whose native layout contains one integer."""

    value: int


def main() -> None:
    """Swap the caller's values and inspect the same native layout."""
    mut first = Item(value=1)
    mut second = Item(value=2)
    swap(first, second)
    println(f"{first.value} {second.value}")
    println(size_of_val(first))
