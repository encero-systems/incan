# behavior: native public fields preserve named construction order and writable storage
# expect-stdout:
#   2
#   4

from rust::std::ops import Range


def main() -> None:
    """Read and update a native struct built with reversed named arguments."""
    mut span = Range(end=4, start=1)
    span.start = 2
    println(span.start)
    println(span.end)
