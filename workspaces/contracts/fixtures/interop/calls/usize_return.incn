# behavior: an Incan int return converts a Rust usize result through the ordinary int conversion
# expect-stdout:
#   true
#   true

"""Keep the native result exact until the declared Incan return boundary."""

from rust::std::mem import size_of_val
from rust::std::path import Path


def size() -> int:
    """Return one native size through an Incan integer signature."""
    return size_of_val("leaf")


def text_size() -> int:
    """Convert a parenthesized native method result at its declared return boundary."""
    path = Path.new("leaf")
    return ((path.as_os_str().len()))


def main() -> None:
    """Compare the implicit return boundary with the explicit conversion."""
    println(size() == int(size_of_val("leaf")))
    println(text_size() == 4)
