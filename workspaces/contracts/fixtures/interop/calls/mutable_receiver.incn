# behavior: Rust mutable receiver methods borrow the caller's value exclusively
# expect-stdout:
#   2

"""Update an opaque Rust value through a mutable inherent method."""

from rust::std::io import Cursor


def main() -> None:
    """Observe the mutation through a subsequent shared method."""
    mut value = Cursor.new(b"abcd")
    value.set_position(2)
    println(value.position())
