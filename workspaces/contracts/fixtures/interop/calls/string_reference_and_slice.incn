# behavior: native text references retain their owners, checked dereferences preserve shared receivers, and source text indexing observes Unicode scalars through locals and fields
# expect-stdout:
#   true
#   leaf
#   ea

"""Distinguish a generic reference to owned text from a native str slice."""

from rust::std::mem import size_of_val
from rust::std::sync import Arc
from rust::incan_std_core::strings import str_slice_byte_range


model TextView:
    """Keep text owned by a source receiver while reading individual Unicode scalars."""
    value: str

    def at(self, index: int) -> str:
        """Read one scalar without consuming the receiver's text."""
        return self.value[index]


def main() -> None:
    """Keep the owner usable after both reference forms cross Rust boundaries."""
    text = "leaf"
    println(size_of_val(text) == size_of_val("leaf"))
    println(text)
    println(str_slice_byte_range(text, 1, 3))
    shared: Arc[str] = Arc.new(text)
    assert shared.as_str() == "leaf"
    assert shared.as_str() == "leaf"
    assert text[0] == "l"
    assert text[-1] == "f"
    unicode_text = "Aé🙂"
    assert unicode_text[1] == "é"
    assert unicode_text[-1] == "🙂"
    view = TextView(value=unicode_text)
    assert view.at(1) == "é"
    assert view.at(-1) == "🙂"
    assert view.value == unicode_text
