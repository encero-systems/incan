# behavior: a Rust Default constructor supplies an owned value usable by its inherent methods
# expect-stdout:
#   true

"""Select a native Default implementation before calling methods on its result."""

from rust::std::path import PathBuf


def main() -> None:
    """Read the empty path produced by its declared native Default implementation."""
    path = PathBuf.default()
    println(path.as_os_str().len() == 0)
