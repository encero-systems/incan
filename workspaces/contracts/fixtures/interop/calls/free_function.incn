# behavior: imported Rust free functions retain ordinary results and nonreturning results in source return expressions
# expect-stdout:
#   false

"""Call a Rust free function with a concrete signature."""

from rust::std::thread import panicking
from rust::std::process import exit


def finish() -> int:
    """A native nonreturning result ends a source function with an ordinary return type."""
    return exit(0i32)


def main() -> None:
    """Print the result of the selected Rust function."""
    println(panicking())
    finish()
    println("unreachable")
