# behavior: matching a borrowed native enum retains its borrowed payload's owner
# expect-stdout:
#   borrowed

from rust::std::env import VarError
from rust::std::ffi import OsString


def borrowed_kind(value: &VarError) -> str:
    """Call a borrowed native payload while retaining the native enum owner's shared reference."""
    match value:
        VarError.NotPresent => return "missing"
        VarError.NotUnicode(raw) => return raw.to_string_lossy().into_owned()
        _ => return "unknown"


def main() -> None:
    """Keep the native enum live across a source function's shared argument."""
    invalid = VarError.NotUnicode(OsString.from("borrowed"))
    println(borrowed_kind(invalid))
