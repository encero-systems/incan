"""A known native owner does not authorize a guessed associated method signature, and no refused call executes."""

from rust::std::cell import RefCell
from rust::std::cmp import Ordering
from rust::std::collections import HashMap
from rust::std::convert import AsRef, identity
from rust::std::env import VarError, set_var
from rust::std::io import Read, Write
from rust::std::iter import Iterator as NativeIterator
from rust::std::mem import MaybeUninit, size_of_val
from rust::std::os::unix::net import UnixStream
from rust::std::os::unix::process import CommandExt
from rust::std::path import Path, PathBuf
from rust::std::process import Command
from rust::std::rc import Rc
from rust::std::sync import Mutex
from rust::std::string import String as RustString
from rust::std::thread import spawn
from rust::std::vec import Vec


type Lock = rusttype Mutex[int]:
    """Retain the native owner's Clone obligation through a transparent alias."""


model ForeignModel:
    """Require the automatic Clone obligation of a directly imported foreign owner."""

    handle: Mutex[int]


class ForeignClass:
    """Require the same owned-field obligation for a class."""

    pub handle: Mutex[int]


model AliasModel:
    """Require the native owner's Clone evidence through a rusttype alias."""

    handle: Lock


model Value:
    """A source value whose mutation requires exclusive receiver access."""

    number: int

    def change(mut self) -> None:
        """Change the stored value through an exclusive receiver."""
        self.number = 2


def classify(value: Ordering) -> str:
    """Refuse a variant from a different native enum owner."""
    match value:
        VarError.NotPresent => return "wrong owner"
        _ => return "ordering"


def guessed_method() -> None:
    """Request an associated method absent from the native owner's public contract."""
    path = Path.missing_contract("leaf")
    println(path)


def shared_mutation() -> None:
    """Refuse a mutable source method through a native shared payload."""
    cell = RefCell.new(Some(Value(number=1)))
    match cell.borrow().as_ref():
        Some(value) => value.change()
        None => pass


def size() -> int:
    """Refuse an ordinary usize value at a narrowing return boundary."""
    value = size_of_val("leaf")
    return value


def unavailable_constructors() -> None:
    """Refuse sized integer and byte-buffer calls whose types declare no constructor."""
    value: int = 42
    println(u64(value))
    println(i32(value))
    println(bytes([1u8, 2u8]))


def unsafe_rust_call() -> None:
    """Keep checked C acknowledgment from authorizing unsafe Rust calls."""
    unsafe:
        set_var("INCAN_INTEROP_UNSAFE_PROBE", "unused")


def unsafe_rust_members() -> None:
    """Refuse unsafe instance and associated calls under the same policy as free functions."""
    value: MaybeUninit[int] = MaybeUninit.new(65)
    value.assume_init()
    unsafe:
        RustString.from_utf8_unchecked([65u8])


def captured_thread_callback() -> None:
    """Name the captured non-Send value before a Rust thread can retain it."""
    handle = Rc.new(3)
    worker = spawn(() => Rc.strong_count(handle))


def stored_native_callback() -> None:
    """Refuse captured environments passed through an unbounded native binder."""
    text = "owned"
    callback = identity(() => text)
    println(callback())


def owned_tuple_fields() -> None:
    """Refuse inferred and explicitly owned copies when a foreign tuple field has no Clone evidence."""
    handles = (Mutex.new(3), 7)
    copied = handles.0
    typed: Mutex[int] = handles.0
    indexed = handles[0]
    typed_tuple: Tuple[Mutex[int], int] = (Mutex.new(4), 8)
    annotated = typed_tuple[0]
    println(copied.is_poisoned())
    println(typed.is_poisoned())


def borrowed_tuple_owner(handles: &Tuple[Mutex[int], int]) -> None:
    """Require the same owned-copy evidence when the tuple owner is itself borrowed."""
    through_reference = handles[0]
    println(through_reference.is_poisoned())


def oversized_process_group() -> None:
    """Refuse an unsuffixed literal outside the native extension method's integer parameter range."""
    mut command = Command.new("true")
    command.process_group(2147483648)


def unselected_callees() -> None:
    """Refuse native calls whose arguments check but whose callee cannot be selected."""
    mut text = RustString.from("a")
    text.flush()
    path = PathBuf.from("a")
    path.as_ref()
    mut command = Command.new("true")
    command.args(("one", "two"))
    command.args(range(3))
    unfixed = HashMap.new()
    println(unfixed)


def conflicting_first_use() -> None:
    """Refuse a later use that conflicts with the owner arguments a local's first use fixed."""
    mut table = HashMap.new()
    table.insert("a", 1)
    table.insert(2, "b")


def unfixed_method_result() -> None:
    """Refuse a method's own open result parameter with its open-parameter reason."""
    values: Vec[int] = Vec.new()
    total = values.into_iter().sum()


def borrowed_scalar_key() -> None:
    """Refuse a native callback that would return its borrowed scalar input without a lifetime contract."""
    mut values: Vec[int] = Vec.new()
    values.push(1)
    values.sort_by_key((value) => value)


def read_through_a_shared_binding() -> None:
    """Refuse `Read for &UnixStream`, which lends the shared reference itself exclusively, on an immutable binding."""
    match UnixStream.pair():
        Ok(pair) =>
            left, _right = pair
            cell = RefCell.new(Some(left))
            match cell.borrow().as_ref():
                Some(shared_socket) =>
                    mut got = b"x"
                    _ = shared_socket.read_exact(got)
                None => pass
        Err(_) => pass


def main() -> None:
    """
    Request refused native calls before anything can execute.

    1. Check native owners, mutation, numeric boundaries, and unavailable constructors.
    2. Check that C acknowledgment does not authorize unsafe Rust calls.
    3. Check captured callbacks against retained native storage bounds.
    4. Check that foreign tuple fields require a borrow or retained Clone evidence.
    5. Check that a native call needs one selectable callee, that later uses agree with a fixed local, and that only a
       `mut` binding lends its shared reference exclusively.
    """
    # 1. Check native owners, mutation, numeric boundaries, and unavailable constructors.
    println(classify(Ordering.Equal))
    guessed_method()
    shared_mutation()
    println(size())
    unavailable_constructors()
    oversized_process_group()
    # 2. Check that C acknowledgment does not authorize unsafe Rust calls.
    unsafe_rust_call()
    unsafe_rust_members()
    # 3. Check captured callbacks against retained native storage bounds.
    captured_thread_callback()
    stored_native_callback()
    # 4. Check that foreign tuple fields require a borrow or retained Clone evidence.
    owned_tuple_fields()
    borrowed_tuple_owner((Mutex.new(3), 7))
    # 5. Check that a native call needs one selectable callee, that later uses agree with a fixed local, and that only a
    # `mut` binding lends its shared reference exclusively.
    unselected_callees()
    conflicting_first_use()
    unfixed_method_result()
    borrowed_scalar_key()
    read_through_a_shared_binding()
