# behavior: a native Cow retains its unsized text argument and resolves its associated owned output
# expect-stdout:
#   a/b

from rust::std::path import Path as RustPath


def main() -> None:
    """Own a path display through Cow's ToOwned projection without exposing native enum variants."""
    println(RustPath.new("a/b").to_string_lossy().into_owned())
