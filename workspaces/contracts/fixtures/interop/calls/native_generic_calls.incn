# behavior: Native generic calls preserve loans, source binders, owned callbacks and independent owners (#2256)
# expect-stdout:
#   7
#   leaf
#   8
#   16
#   8
#   16
#   true
#   2
#   1
#   true
#   leaf
#   ea
#   typed channel
#   thread 42
#   stored 3
#   false

"""Retain generic instantiations, scalar and text loans, and a nonreturning native result in one case."""

from rust::incan_std_core::strings import str_slice_byte_range
from rust::std::convert import identity
from rust::std::collections import HashMap
from rust::std::hash import DefaultHasher, Hash, Hasher
from rust::std::mem import size_of_val, swap
from rust::std::path import Path
from rust::std::process import exit
from rust::std::string import String as RustString
from rust::std::sync import Arc, Mutex
from rust::std::sync::mpsc import Sender as NativeSender, Receiver as NativeReceiver, channel as native_channel
from rust::std::thread import panicking, spawn


model Pair:
    """Two integer fields with a distinct native size."""

    first: int
    second: int


model TextView:
    """Keep text owned by a source receiver while reading individual Unicode scalars."""

    value: str

    def at(self, index: int) -> str:
        """Read one scalar without consuming the receiver's text."""
        return self.value[index]


def measure[Payload](value: Payload) -> int:
    """Query the size of the instantiated source value without moving it."""
    return size_of_val(value)


def measure_again[Element](value: Element) -> int:
    """Retain a second declaration's binder environment on the same native item."""
    return size_of_val(value)


def finish() -> int:
    """A native nonreturning result ends a source function with an ordinary return type."""
    return exit(0i32)


def show_generic_instantiations() -> None:
    """Observe concrete identity results and separately instantiated source binders."""
    println(identity(7))
    println(identity("leaf"))
    println(measure(1))
    println(measure(Pair(first=2, second=3)))
    println(measure_again(4))
    println(size_of_val(Pair(first=5, second=6)))


def show_scalar_references() -> None:
    """Observe the caller's values after their mutable Rust loans end."""
    mut left = 1
    mut right = 2
    println(size_of_val(left) == size_of_val(7))
    swap(left, right)
    println(left)
    println(right)


def show_text_references() -> None:
    """Keep the owner usable after both reference forms cross Rust boundaries."""
    text = "leaf"
    println(size_of_val(text) == size_of_val("leaf"))
    println(text)
    println(str_slice_byte_range(text, 1, 3))
    shared: Arc[str] = Arc.new(text)
    assert shared.as_str() == "leaf"
    assert shared.as_str() == "leaf"
    assert text[0] == "l"
    assert text[-1] == "f"
    unicode_text = "Aé🙂"
    assert unicode_text[1] == "é"
    assert unicode_text[-1] == "🙂"
    view = TextView(value=unicode_text)
    assert view.at(1) == "é"
    assert view.at(-1) == "🙂"
    assert view.value == unicode_text


def show_typed_factory() -> None:
    """Infer a native factory's element from the tuple destination and use both returned handles."""
    pair: Tuple[NativeSender[str], NativeReceiver[str]] = native_channel()
    tx, rx = pair
    match tx.send("typed channel"):
        Ok(_) => pass
        Err(_) =>
            assert false
    match rx.recv():
        Ok(value) => println(value)
        Err(_) =>
            assert false


def retained_callback() -> () -> str:
    """Return an owned callback whose captured string outlives its creating frame."""
    text = "retained"
    return () => text


def show_thread_capture() -> None:
    """Join direct and locally retained Rust callbacks that own integer and string captures."""
    number = 42
    text = "thread"
    worker = spawn(() => f"{text} {number}")
    match worker.join():
        Ok(value) => println(value)
        Err(_) =>
            assert false
    count = 3
    label = "stored"
    callback = () => f"{label} {count}"
    retained_worker = spawn(callback)
    match retained_worker.join():
        Ok(value) => println(value)
        Err(_) =>
            assert false


def native_mapping() -> HashMap[RustString, int]:
    """Return an imported map without changing another foreign owner's receiver frame."""
    return HashMap.new()


def borrowed_tuple_is_poisoned(value: &Tuple[Mutex[int], int]) -> bool:
    """Borrow a foreign element through the checked shared tuple-parameter frame."""
    handle: &Mutex[int] = value[0]
    return handle.is_poisoned()


def check_foreign_values() -> None:
    """Verify escaping captures, tuple field loans, concrete trait returns, and independent native frames."""
    callback = retained_callback()
    assert callback() == "retained"
    assert callback() == "retained"
    handles = (Mutex.new(3), 7)
    assert not handles.0.is_poisoned()
    assert not handles.0.is_poisoned()
    handle: &Mutex[int] = handles.0
    assert not handle.is_poisoned()
    assert not handles.0.is_poisoned()
    indexed: &Mutex[int] = handles[0]
    assert not indexed.is_poisoned()
    typed_tuple: Tuple[Mutex[int], int] = (Mutex.new(4), 8)
    typed_view: &Mutex[int] = typed_tuple[0]
    assert not typed_view.is_poisoned()
    assert not borrowed_tuple_is_poisoned(handles)
    mut state = DefaultHasher.new()
    Hash.hash(RustString.from("item"), state)
    value: u64 = Hasher.finish(state)
    assert value > 0u64
    method_value: u64 = state.finish()
    assert method_value == value
    assert Path.new(".").exists()
    assert native_mapping().len() == 0usize


def show_nonreturning_call() -> None:
    """Print the result of the selected Rust function, then end the program through a nonreturning one."""
    println(panicking())
    query = panicking
    assert not query()
    assert not query()
    finish()
    println("unreachable")


def main() -> None:
    """
    Observe checked native calls and keep the nonreturning observation last.

    1. Exercise generic instantiations and scalar references.
    2. Exercise text references and typed native factories.
    3. Check owned captures, joined Rust callbacks, tuple loans, trait returns, and independent native frames.
    4. Observe a native nonreturning call, which ends the program.
    """
    # 1. Exercise generic instantiations and scalar references.
    show_generic_instantiations()
    show_scalar_references()
    # 2. Exercise text references and typed native factories.
    show_text_references()
    show_typed_factory()
    # 3. Check owned captures, joined Rust callbacks, tuple loans, trait returns, and independent native frames.
    check_foreign_values()
    show_thread_capture()
    # 4. Observe a native nonreturning call, which ends the program.
    show_nonreturning_call()
