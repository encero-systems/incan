# behavior: native enum patterns retain exact payloads, nested variants, Rust discriminants, source field value arguments, and shared payload clones
# expect-stdout:
#   missing
#   opaque
#   7
#   -3
#   less
#   equal
#   greater

from rust::std::cell import RefCell
from rust::std::cmp import Ordering
from rust::std::env import VarError
from rust::std::ffi import OsString
from rust::std::io import SeekFrom
from rust::std::num import Wrapping
from rust::std::ops import ControlFlow


model Envelope:
    """Keep a non-Copy native enum behind an ordinary source receiver."""
    value: ControlFlow[int, str]

    def score(self) -> int:
        """Pass the field's value to an ordinary source function while retaining the owner."""
        return flow_score(self.value)

    def cloned_score(self) -> int:
        """Clone a native enum through a borrowed Option payload while retaining its guard."""
        saved = RefCell.new(Some(self.value))
        match saved.borrow().as_ref():
            Some(value) => return flow_score(value.clone())
            None => return -1


def environment_kind(value: Result[str, VarError]) -> str:
    """Read nested Rust variants inside an ordinary source Result."""
    match value:
        Ok(text) => return text
        Err(VarError.NotPresent) => return "missing"
        Err(VarError.NotUnicode(raw)) => return raw.to_string_lossy().into_owned()


def seek_offset(value: SeekFrom) -> int:
    """Read the native unsigned or signed payload selected by each seek variant."""
    match value:
        SeekFrom.Start(offset) => return int(offset)
        SeekFrom.End(offset) => return offset
        SeekFrom.Current(offset) => return offset
        _ => return 0


def comparison_name(value: Ordering) -> str:
    """Distinguish native variants whose discriminants are negative, zero, and positive."""
    match value:
        Ordering.Less => return "less"
        Ordering.Equal => return "equal"
        Ordering.Greater => return "greater"
        _ => return "unknown"


def flow_score(value: ControlFlow[int, str]) -> int:
    """Close native enum payload binders in their declaration order."""
    match value:
        ControlFlow.Break(score) => return score
        ControlFlow.Continue(text) => return len(text)
        _ => return -1


def text_length(value: str) -> int:
    """Observe the native error's ordinary implicit text conversion."""
    return len(value)


def wrapped_flow(value: ControlFlow[Wrapping[int], bool]) -> bool:
    """Retain the closed layout of an unselected native generic payload."""
    match value:
        ControlFlow.Continue(result) => return result
        _ => return false


def main() -> None:
    """Observe native unit and payload variants through direct and nested patterns."""
    println(environment_kind(Err(VarError.NotPresent)))
    println(environment_kind(Err(VarError.NotUnicode(OsString.from("opaque")))))
    println(seek_offset(SeekFrom.Start(7u64)))
    println(seek_offset(SeekFrom.Current(-3)))
    println(comparison_name(Ordering.Less))
    println(comparison_name(Ordering.Equal))
    println(comparison_name(Ordering.Greater))
    stopped: ControlFlow[int, str] = ControlFlow.Break(9)
    continued: ControlFlow[int, str] = ControlFlow.Continue("abc")
    assert flow_score(stopped) == 9
    assert flow_score(continued) == 3
    envelope = Envelope(value=continued)
    assert envelope.score() == 3
    assert envelope.score() == 3
    assert envelope.cloned_score() == 3
    assert envelope.cloned_score() == 3
    wrapped: ControlFlow[Wrapping[int], bool] = ControlFlow.Continue(true)
    assert wrapped_flow(wrapped)
    missing = VarError.NotPresent
    assert text_length(missing) > 0
    assert text_length(missing) > 0
