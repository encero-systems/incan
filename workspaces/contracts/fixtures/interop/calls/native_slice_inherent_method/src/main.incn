# behavior: an encoding's native byte slice exposes its inherent methods through a shared Cow receiver
# expect-stdout:
#   2
#   97
#   2

from rust::encoding_rs import Encoding


def encoded_bytes() -> bytes:
    """Return a slice method's owned result through an explicit bytes boundary."""
    match Encoding.for_label(b"utf-8"):
        Some(encoding) =>
            encoded = encoding.encode("ab")
            return encoded.0.to_vec()
        None => return b""


def main() -> None:
    """Copy bytes through a slice method and keep the Cow available for another read."""
    match Encoding.for_label(b"utf-8"):
        Some(encoding) =>
            encoded = encoding.encode("ab")
            copied = encoded.0.to_vec()
            println(len(copied))
            println(copied[0])
            println(len(encoded.0.to_vec()))
        None => println("missing")
    assert len(encoded_bytes()) == 2
