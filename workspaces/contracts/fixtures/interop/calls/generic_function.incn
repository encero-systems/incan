# behavior: a Rust generic function retains concrete instantiations and source function binders (#2256)
# expect-stdout:
#   7
#   leaf
#   8
#   16
#   8
#   16

"""Retain the existing identity calls and source-bound native size queries in one case."""

from rust::std::convert import identity
from rust::std::mem import size_of_val


model Pair:
    """Two integer fields with a distinct native size."""

    first: int
    second: int


def measure[Payload](value: Payload) -> int:
    """Query the size of the instantiated source value without moving it."""
    return size_of_val(value)


def measure_again[Element](value: Element) -> int:
    """Retain a second declaration's binder environment on the same native item."""
    return size_of_val(value)


def main() -> None:
    """Observe concrete identity results and separately instantiated source binders."""
    println(identity(7))
    println(identity("leaf"))
    println(measure(1))
    println(measure(Pair(first=2, second=3)))
    println(measure_again(4))
    println(size_of_val(Pair(first=5, second=6)))
