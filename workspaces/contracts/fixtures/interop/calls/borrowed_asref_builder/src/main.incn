# behavior: borrowed AsRef builder inputs and AsFd lock calls preserve their reusable native owners (#2256)
# expect-stdout:
#   configured
#   locked

from rust::std::string import String as RustString
from rust::tempfile import Builder
from rust::std::fs import File
from rust::std::os::fd import AsFd
from rust::rustix::fs import flock, FlockOperation


def main() -> None:
    """Configure borrowed builder inputs without losing the native result or lifetime arguments."""
    mut builder = Builder.new()
    prefix = RustString.from("lane-")
    suffix = RustString.from(".txt")
    prefix_ref = prefix.as_str()
    suffix_ref = suffix.as_str()
    builder.prefix(prefix_ref)
    builder.suffix(suffix_ref)
    println("configured")
    match File.open("loaf.toml"):
        Ok(file) =>
            match flock(file.as_fd(), FlockOperation.NonBlockingLockShared):
                Ok(_) =>
                    match file.metadata():
                        Ok(_metadata) => println("locked")
                        Err(error) => println(f"{error}")
                Err(error) => println(f"{error}")
        Err(error) => println(f"{error}")
