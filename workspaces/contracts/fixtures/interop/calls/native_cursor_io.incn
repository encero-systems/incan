# behavior: native cursor loans, guard reads and boxed enum pattern loans preserve their actual referents (#2256)
# expect-stdout:
#   2
#   0
#   2
#   2
#   true
#   true
#   2
#   1
#   2
#   2

"""Observe one native cursor through every receiver, ownership and trait shape the area cases cover."""

from rust::std::cell import RefCell
from rust::std::boxed import Box
from rust::std::cmp import Ordering
from rust::std::io import Cursor, Read, Seek, SeekFrom
from rust::std::ops import Bound
from rust::std::rc import Rc


class Buffer:
    """Keep one native cursor in shared interior-mutable storage."""

    handle: Rc[RefCell[Cursor[bytes]]]

    def read(self, size: u64) -> bytes:
        """Read at most the requested number of bytes through a temporary exclusive guard."""
        mut out = b""
        mut cursor = self.handle.borrow_mut()
        match Read.by_ref(cursor).take(size).read_to_end(out):
            Ok(_) => return out
            Err(_) => return b""


def copied() -> bytes:
    """Clone the vector behind a borrowed native cursor view."""
    cursor = Cursor.new(b"ab")
    return cursor.get_ref().clone()


def show_owned_clone() -> None:
    """Observe an owned result after its native cursor has gone out of scope."""
    println(len(copied()))


def show_deref_receivers() -> None:
    """Read and update a cursor through native dereference adjustments."""
    handle = Rc.new(RefCell.new(Cursor.new(b"abcd")))
    mut cursor = handle.borrow_mut()
    println(cursor.position())
    cursor.set_position(2)
    println(cursor.position())


def show_mutable_receiver() -> None:
    """Observe a mutation through a subsequent shared method."""
    mut value = Cursor.new(b"abcd")
    value.set_position(2)
    println(value.position())


def show_io_error_display() -> None:
    """Display a native I/O error twice without consuming its owned value."""
    mut cursor = Cursor.new(b"")
    mut buffer = b"ab"
    match cursor.read_exact(buffer):
        Ok(_) => println("read")
        Err(err) =>
            expected = err.to_string()
            println(f"{err}" == expected)
            println(f"{err}" == expected)


def show_seek_variants() -> None:
    """Construct native seek variants and observe the resulting cursor positions."""
    mut cursor = Cursor.new(b"abcd")
    match cursor.seek(SeekFrom.Start(2u64)):
        Ok(position) => println(int(position))
        Err(_) => println(-1)
    match cursor.seek(SeekFrom.Current(-1)):
        Ok(position) => println(int(position))
        Err(_) => println(-1)


def show_guard_reads() -> None:
    """Observe that bounded reads advance the original cursor."""
    buffer = Buffer(handle=Rc.new(RefCell.new(Cursor.new(b"abcd"))))
    println(len(buffer.read(2u64)))
    println(len(buffer.read(2u64)))


def inspect_boxed_enum(value: &Bound[Box[Ordering]]) -> bool:
    """Pass a boxed native pattern loan to the enum referent's source parameter."""
    match value:
        Bound.Included(ordering) => return is_greater(ordering)
        _ => return false


def is_greater(value: &Ordering) -> bool:
    """Inspect the enum selected through the native box's shared dereference."""
    match value:
        Ordering.Greater => return true
        _ => return false


def contains_bound(values: list[Bound[Box[Ordering]]], value: &Bound[Box[Ordering]]) -> bool:
    """Compare a borrowed non-Copy native enum through the list's owned element boundary."""
    return value in values


def main() -> None:
    """
    Observe native loans.

    1. Observe cursor methods, traits and guard reads.
    2. Inspect a borrowed boxed enum without changing its owner.
    """
    # 1. Observe cursor methods, traits and guard reads.
    show_owned_clone()
    show_deref_receivers()
    show_mutable_receiver()
    show_io_error_display()
    show_seek_variants()
    show_guard_reads()

    # 2. Inspect a borrowed boxed enum without changing its owner.
    bound = Bound.Included(Box.new(Ordering.Greater))
    assert inspect_boxed_enum(bound)
    assert inspect_boxed_enum(bound)
    bounds = [bound]
    assert contains_bound(bounds, bound)
    assert contains_bound(bounds, bound)
