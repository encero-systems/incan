# behavior: a rusttype over the Rust String adapts into str through its declared into edge when passed where a str is expected, and a str adapts into it through its from edge
# expect-stdout:
#   ADA
#   BOB

from rust::std::string import String as RustString


type Name = rusttype RustString:
    def from(raw: str) -> Name:
        ...

    def as_str(self) -> str:
        ...

    interop:
        from str via Name.from
        into str via Name.as_str


def shout(text: str) -> str:
    return text.upper()


def label(name: Name) -> str:
    return shout(name)


def main() -> None:
    name: Name = "ada"
    println(shout(name))
    println(label("bob"))
