# behavior: a Rust extension trait imported without inspected metadata and never called leaves the program buildable and its functions runnable (#1450)
# expect-stdout:
#   kept

from rust::std::borrow import Borrow
from rust::std::path import PathBuf


pub def keep(value: PathBuf) -> PathBuf:
    return value


def main() -> None:
    _ = keep(PathBuf.new())
    println("kept")
