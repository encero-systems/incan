# behavior: a list of str passed to a Rust function taking a Vec of a type built from String has each element converted without consuming its source, and an empty list literal passes as an empty Vec
# expect-stdout:
#   3
#   0

from rust::name_list import total_length


def main() -> None:
    names = ["ab", "c"]
    println(total_length(names))
    assert names == ["ab", "c"]
    assert total_length(["", "abc"]) == 3
    println(total_length([]))
