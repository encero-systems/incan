# behavior: return and break transfer an enclosing non-Clone value on terminal loop paths
# expect-stdout:
#   false
#   false

from rust::std::sync import Mutex


def make() -> Mutex[int]:
    """Return an owned mutex without cloning it."""
    value = Mutex.new(7)
    while true:
        return value


def make_with_break() -> Mutex[int]:
    """Move the owner through the value of a loop expression."""
    value = Mutex.new(9)
    return loop:
        break value


def main() -> None:
    """Observe the transferred native owner."""
    value = make()
    println(value.is_poisoned())
    other = make_with_break()
    println(other.is_poisoned())
