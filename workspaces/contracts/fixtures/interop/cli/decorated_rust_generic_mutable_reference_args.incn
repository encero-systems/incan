# behavior: a decorated method, a decorated function and its adapter all accept an aliased Rust generic over `tuple[&mut int, &mut int]`
# expect-stdout:
#   7
#   decorated explicit mutable Rust generic CLI path

from rust::std::vec import Vec as ProviderHandle


def preserve[F]() -> ((F) -> F):
    return (function) => function


def adapted(value: int) -> int:
    return value


def to_int(function: (ProviderHandle[tuple[BorrowedMut[int], BorrowedMut[int]]]) -> int) -> ((int) -> int):
    return adapted


class Container:
    @preserve()
    pub def replace(self, mut items: ProviderHandle[tuple[BorrowedMut[int], BorrowedMut[int]]]) -> None:
        pass


@to_int
def transformed(mut items: ProviderHandle[tuple[BorrowedMut[int], BorrowedMut[int]]]) -> int:
    return 0


def main() -> None:
    Container().replace(ProviderHandle.new())
    println(transformed(7))
    println("decorated explicit mutable Rust generic CLI path")
