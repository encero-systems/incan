# behavior: Rust interop preserves constructors, loans, trait calls, callbacks and facade macros (#2256)
# expect-stdout:
#   1 2 3 2
#   7
#   7 marker
#   1 2
#   3 4
#   0.55
#   2
#   11 21
#   1 2
#   5 6
#   3 4
#   1 2
#   0
#   1.5
#   6
#   https://example.invalid 1
#   6
#   3
#   3 true 3
#   3 true 3
#   true
#   8

from rust::demo import (
    Builder,
    ClearColor,
    Color,
    Commands,
    Component,
    Dynamic,
    Engine,
    Entity,
    Expression,
    File,
    FooBar,
    FooBar2,
    Gadget,
    JoinRel,
    Kind,
    Mac,
    Message,
    Packet,
    Pair,
    PairFactory,
    PlainBar,
    Predicate,
    SessionContext,
    Static,
    Widget,
    WriteOptions,
    accept_f32,
    flock,
)
from rust::demo_derive import Component as ComponentMacro
from rust::client_probe import Client
from native_macros import Component as NativeComponent


def identity(value: int) -> int:
    return value


pub def build(values: list[int]) -> list[Kind]:
    return [Kind.Tuple(1), Kind.Tuple(identity(2)), Kind.Tuple(values[0]), Kind.Tuple(len(values))]


pub def retain(file: File) -> File:
    flock(file)
    return file


pub def build_pair() -> PairFactory[int, str]:
    return PairFactory.new(7, "marker")


pub def make_pair() -> Pair:
    return Pair(1, 2)


pub def make_named_pair() -> Pair:
    return Pair(zeta=3, alpha=4)


pub def clear() -> ClearColor:
    return ClearColor(Color.srgb(0.15, 0.55, 0.95))


pub def setup(mut commands: Commands) -> int:
    commands.spawn_empty()
    commands.spawn_empty()
    return commands.spawned


pub def move_items(first: &mut Widget, second: &mut Gadget) -> None:
    """Mutate references stored in a native tuple while their owner stays in this frame."""
    mut items = FooBar.pair(first, second)
    for widget, gadget in items.iter_mut():
        widget.value += 10
        gadget.value += 20


pub def inspect_plain(items: PlainBar[tuple[Widget, Gadget]]) -> str:
    widget, gadget = items.inner
    return f"{widget.value} {gadget.value}"


pub def inspect_dynamic(values: FooBar[Dynamic]) -> int:
    return len(values)


pub def inspect_static(values: FooBar[Static]) -> int:
    return len(values)


@rust.derive(ComponentMacro)
model Velocity:
    x: f32


@derive(NativeComponent)
model FacadeComponent:
    """Select a dependency's exported derive through its source facade and an alias."""

    value: int


@derive(NativeComponent)
type FacadeWrapper = newtype int:
    """Forward the same checked macro to a tuple newtype declaration."""


pub def inspect_velocity(mut values: FooBar[Velocity]) -> int:
    return len(values)


pub def inspect_two(items: FooBar2[Widget, Gadget]) -> str:
    return f"{items.first.value} {items.second.value}"


trait Replacer:
    def replace(self, items: PlainBar[tuple[Widget, Gadget]]) -> str


model Swapper with Replacer:
    def replace(self, items: PlainBar[tuple[Widget, Gadget]]) -> str:
        return inspect_plain(items)


pub def translate(time: f32, velocity: f32) -> f32:
    return accept_f32(-time + time * velocity)


pub def get_type(join: JoinRel) -> int:
    return join.type + join.match + join.type_


pub def rebuild(join: JoinRel) -> JoinRel:
    return JoinRel(type=join.type, match=join.match, type_=join.type_)


model Payload:
    name: str


pub def forward(payload: Payload) -> int:
    builder = Builder.new()
    return builder.json(payload)


pub def post(payload: Payload) -> str:
    builder = Client.new().post("https://example.invalid")
    sent = builder.json(payload)
    return f"{sent.url} {sent.payloads}"


pub def write(uri: str) -> int:
    ctx = SessionContext.new()
    return ctx.write_csv(uri, WriteOptions.new(), None)


pub def encode_packet(packet: Packet) -> int:
    return len(packet.encode_to_vec())


pub class Signer:
    handle: Engine

    def update(mut self, chunk: bytes) -> None:
        Mac.update(self.handle, chunk.as_slice())

    def is_ready(self) -> bool:
        return Mac.is_ready(self.handle)

    def finish(self) -> bytes:
        return Mac.finalize(self.handle)


pub def sign_field(chunk: bytes) -> str:
    mut signer = Signer(handle=Engine.default())
    signer.update(chunk)
    return f"{len(chunk)} {signer.is_ready()} {len(signer.finish())}"


pub def sign_local(chunk: bytes) -> str:
    mut input = Engine.default()
    Mac.update(input, chunk.as_slice())
    _ = Mac.by_ref(input)
    ready = Mac.is_ready(input)
    return f"{len(chunk)} {ready} {len(Mac.finalize(input))}"


model CfgSnapshot:
    target: str


def cfg_predicate(predicate: &Predicate, snapshot: CfgSnapshot) -> Option[bool]:
    return Some(predicate.value > 0 and len(snapshot.target) > 0)


pub def evaluate(expression: Expression, snapshot: CfgSnapshot) -> Option[bool]:
    return expression.eval((predicate) => cfg_predicate(predicate, snapshot))


def main() -> None:
    kinds = build([3])
    println(f"{kinds[0].payload()} {kinds[1].payload()} {kinds[2].payload()} {kinds[3].payload()}")
    println(retain(File(number=7)).number)
    pair = build_pair()
    println(f"{pair.first} {pair.second}")
    made = make_pair()
    println(f"{made.zeta} {made.alpha}")
    named = make_named_pair()
    println(f"{named.zeta} {named.alpha}")
    println(clear().0.green)
    println(setup(Commands.new()))
    mut widget = Widget(value=1)
    mut gadget = Gadget(value=1)
    move_items(widget, gadget)
    println(f"{widget.value} {gadget.value}")
    println(inspect_plain(PlainBar.new((Widget(value=1), Gadget(value=2)))))
    println(inspect_two(FooBar2(first=Widget(value=5), second=Gadget(value=6))))
    println(Swapper().replace(PlainBar.new((Widget(value=3), Gadget(value=4)))))
    println(inspect_plain(PlainBar.new((Widget(value=1), Gadget(value=2)))))
    println(inspect_dynamic(FooBar.new()) + inspect_static(FooBar.new()) + inspect_velocity(FooBar.new()))
    println(translate(1.0, 2.5))
    join = rebuild(JoinRel(type=1, match=2, type_=3))
    println(get_type(join))
    println(post(Payload(name="demo")))
    println(write("a.csv") + forward(Payload(name="demo")))
    println(encode_packet(Packet()))
    println(sign_field(b"abc"))
    println(sign_local(b"abc"))
    match evaluate(Expression(seed=1), CfgSnapshot(target="x")):
        Some(value) => println(value)
        None => println("none")
    println(FacadeComponent(value=5).value + FacadeWrapper(3).0)
