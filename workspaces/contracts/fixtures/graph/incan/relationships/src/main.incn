# behavior: graph CLI, MCP and LSP agree on edit-stable nominal identities, bounded context and freshness
# graph-commands:
#   src/main.incn --query defs helper
#   src/main.incn --query callers helper
#   src/main.incn --query callees main
#   src/main.incn --query refs helper
#   src/main.incn --query imports main --limit 1000
#   src/main.incn --query defs checked_helper
#   src/main.incn --query callers checked_helper
#   src/main.incn --query defs contextual_helper
#   src/main.incn --query callers contextual_helper
# expect-stdout-contains:
#   declaration provider::helper src/provider.incn:1
#   call main src/main.incn:29
#   call provider::helper src/main.incn:29
#   reference provider::helper src/main.incn:29
#   import provider::helper src/main.incn:22
#   declaration graph_checked::main::checked_helper deps/checked/src/lib.incn:6
#   call main src/main.incn:30
#   declaration graph_context::main::contextual_helper context/src/lib.incn:1
#   call graph_context::main::contextual context/src/lib.incn:8
from provider import helper, Item as OtherItem
from pub::checked import checked_helper
from rust::serde_json import Value


def main() -> None:
    """Call a provider whose definition lives in another module."""
    println(helper())
    println(checked_helper())


def native_value(value: Value) -> bool:
    """Expose a checked Rust type supplied by the project's declared registry dependency."""
    return value.is_null()


def identity_before(enabled: bool) -> None:
    """Grow this private body without changing later nominal declarations or signatures."""
    if enabled:
        println("before")


pub model Item:
    """Keep a source-defined nominal after the edited private declaration."""

    pub value: int


pub def make() -> Item:
    """Retain a nominal result across earlier private-body edits."""
    return Item(value=1)


pub def take(values: list[Item]) -> Item:
    """Preserve generic arguments while projecting their checked nominal identity."""
    return values[0]


pub def take_value() -> int:
    """Read a field after a call whose inferred nominal argument and result can change."""
    return take([]).value


pub def other(value: OtherItem) -> OtherItem:
    """Keep another module's same-named nominal distinct from this module's Item."""
    return value


pub def ignore(_value: Item) -> int:
    """Unused bindings still have checked owners and must not discard a proved declaration digest."""
    for _index in range(1):
        pass
    return 1
