# behavior: graph inspection checks a vocabulary consumer and keeps dependency records in their published graphs (#2484)
# graph-commands:
#   src/main.incn --query defs main
# expect-stdout-contains:
#   declaration main src/main.incn:10

from provider import helper


def main() -> None:
    """Expand the registered query while retaining the ordinary library binding."""
    value = query:
        FROM helper()
    println(value)
    println(helper())
