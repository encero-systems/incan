# behavior: a call whose tuple carries a view is unpacked into names; binding the whole tuple to one local is refused (#2500).
# expect-diagnostic: INCAN-T0123

class Tag:
    pub name: str
    pub hits: int

    def label(self) -> Tuple[int, Borrowed[str]] from self.name:
        return (self.hits, self.name)


def show(tag: Borrowed[Tag]) -> int:
    pair = tag.label()
    return 0
