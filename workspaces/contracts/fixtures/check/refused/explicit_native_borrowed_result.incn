# behavior: a native method whose result borrows its receiver, such as `HashMap.get`, cannot yet be called from an explicit body; its result would keep the receiver borrowed (#2500).
# expect-diagnostic: INCAN-T0123

from rust::std::collections import HashMap


def lookup(counts: Borrowed[HashMap[str, int]], key: str) -> int:
    match counts.get(key):
        Some(value) => return value
        None => return 0
