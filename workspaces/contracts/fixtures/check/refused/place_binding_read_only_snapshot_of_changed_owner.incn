# behavior: a bare local declared from a place is a read-only view, not a snapshot; changing the owner while a later use still needs the view is refused, and the snapshot is spelled `.clone()` (RFC 129 read-only local borrowing rules 1 and 3, #1846).
# pending: a bare local declared from a place is still an independent copy, so the check accepts the program.
# expect-diagnostic: INCAN-T0126

class Cart:
    pub items: list[str]


def main() -> None:
    mut cart = Cart(items=["apple"])
    before = cart.items
    cart.items.append("plum")
    println(f"{before} {cart.items}")
