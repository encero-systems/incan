# behavior: a carried view stays in its `Result` until `?` or a `match` takes it out; binding the carrier itself to a local is refused (#2500).
# expect-diagnostic: INCAN-T0123

class Counter:
    pub value: int

    def bump(mut self) -> Result[Reference[Self], str] from self:
        self.value += 1
        return Ok(self)


def bump_once(mut counter: BorrowedMut[Counter]) -> None:
    result = counter.bump()
    match result:
        Ok(_) => pass
        Err(_) => pass
