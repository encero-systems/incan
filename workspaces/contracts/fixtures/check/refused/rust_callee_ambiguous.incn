# behavior: a Rust method call that several trait implementations of the receiver's type supply equally, with nothing in the call choosing one, is refused at check time instead of stopping the build (#2481)
# expect-diagnostic: INCAN-T0122

"""Nothing in the call chooses between the receiver's conversions."""

from rust::std::convert import AsRef
from rust::std::path import PathBuf


def main() -> None:
    """Request a borrowed view that the path offers as more than one type."""
    path = PathBuf.from("a")
    path.as_ref()
