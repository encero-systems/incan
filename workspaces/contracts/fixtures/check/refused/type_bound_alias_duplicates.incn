# behavior: overloads whose type bounds name one type, through transparent aliases or either builtin spelling, are duplicate declarations even when nothing calls them (#1033)
# expect-diagnostic: INCAN-T0001

type Count = int


type Total = Count


def choose[T with Count]() -> str:
    return "count"


def choose[T with Total]() -> str:
    return "total"


def main() -> None:
    println("no call")
