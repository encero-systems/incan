# behavior: named native enum payloads require complete typed coverage; borrowed lifetime-bearing Rust signatures are refused before compilation (#2368)
# expect-diagnostic: INCAN-T0001
# expect-diagnostic: INCAN-T0120

from rust::messages import Message
from rust::regex import Regex, Captures as NativeCaptures


def incomplete_owned(value: Message) -> int:
    """The first match in the unit must check complete native payload coverage too."""
    match value:
        Message.Record(count=0, text=_) => return 0
        Message.Empty => return 0


def inspect(value: &Message) -> int:
    """Returning the named text field as an integer must fail even when the fields are written out of order."""
    match value:
        Message.Record(text=message, count=number) => return message
        Message.Empty => return 0


def incomplete(value: &Message) -> int:
    """Naming every native variant leaves nonzero record payloads uncovered."""
    match value:
        Message.Record(text=_, count=0) => return 0
        Message.Empty => return 0


def observe(captures: &NativeCaptures) -> bool:
    """Refuse the erased-region source boundary before rustc outlives checking."""
    if let Some(found) = captures.name("word"):
        return found.as_str() == "ab"
    return false


def main() -> None:
    """Exercise the original lifetime-bearing native parameter program from #2368."""
    match Regex.new("(?P<word>ab)(c)?"):
        Ok(pattern) =>
            match pattern.captures("ab"):
                Some(captures) => println(observe(captures))
                None => println("no captures")
        Err(_error) => println("invalid pattern")
