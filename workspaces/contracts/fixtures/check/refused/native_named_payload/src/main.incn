# behavior: named native enum payloads require complete typed coverage
# expect-diagnostic: INCAN-T0001

from rust::messages import Message


def incomplete_owned(value: Message) -> int:
    """The first match in the unit must check complete native payload coverage too."""
    match value:
        Message.Record(count=0, text=_) => return 0
        Message.Empty => return 0


def inspect(value: &Message) -> int:
    """Returning the named text field as an integer must fail even when the fields are written out of order."""
    match value:
        Message.Record(text=message, count=number) => return message
        Message.Empty => return 0


def incomplete(value: &Message) -> int:
    """Naming every native variant leaves nonzero record payloads uncovered."""
    match value:
        Message.Record(text=_, count=0) => return 0
        Message.Empty => return 0


def main() -> None:
    """Keep the incomplete and incorrectly typed native payload declarations in one checked unit."""
    pass
