# behavior: a closure in an explicit body that holds a reference to a borrowed value cannot yet be passed to another callable, whose closure parameter holds only a closure that borrows nothing (#2500).
# expect-diagnostic: INCAN-T0123

class Counter:
    pub value: int
    pub name: str


def apply(read: () -> int) -> int:
    return read()


def passed(counter: Borrowed[Counter]) -> int:
    read: () -> int = () => len(counter.name)
    return apply(read)
