# behavior: a closure in an explicit body cannot yet capture a view a call returned (#2500).
# expect-diagnostic: INCAN-T0123

class Counter:
    pub value: int

    def bump(mut self) -> Reference[Self] from self:
        self.value += 1
        return self


def total(mut counter: BorrowedMut[Counter]) -> int:
    view = counter.bump()
    read: () -> int = () => view.value
    return read()
