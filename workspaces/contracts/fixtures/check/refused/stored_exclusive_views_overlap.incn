# behavior: one list cannot store two exclusive returned views of the same place because both loans would remain usable through the aggregate (#2500).
# expect-diagnostic: INCAN-T0126

class Entry:
    pub key: str


def edit_key(mut entry: BorrowedMut[Entry]) -> Reference[str] from entry.key:
    return entry.key


def overlap(mut entry: BorrowedMut[Entry]) -> int:
    keys = [edit_key(entry), edit_key(entry)]
    return len(keys)
