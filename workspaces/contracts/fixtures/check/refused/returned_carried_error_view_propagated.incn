# behavior: `?` on a call whose error carries a view is refused when the enclosing result does not carry an error view of the same source (#2500).
# expect-diagnostic: INCAN-T0123

class Account:
    pub name: str
    pub balance: int

    def withdraw(mut self, amount: int) -> Result[int, Borrowed[str]] from self.name:
        if amount > self.balance:
            return Err(self.name)
        self.balance -= amount
        return Ok(self.balance)


def propagate(mut account: BorrowedMut[Account]) -> Result[int, str]:
    left = account.withdraw(5)?
    return Ok(left)
