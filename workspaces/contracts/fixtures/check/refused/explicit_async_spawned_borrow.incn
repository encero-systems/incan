# behavior: a spawned task retains its dependencies and is refused when it could outlive the borrowed input it holds (#2500).
# expect-diagnostic: INCAN-T0123

from std.async import spawn


class Buffer:
    pub items: list[int]


async def measure(buffer: Borrowed[Buffer]) -> int:
    return len(buffer.items)


async def start(buffer: Borrowed[Buffer]) -> None:
    spawn(measure(buffer))
