# behavior: checked zero/multiple/nested enum payloads preserve an unrelated explicit borrowed input (#2834).
# expect-accepted:

model Dictionary:
    pub values: list[str]


enum Node:
    Scalar(str)
    Pair(str, int)
    Other


def inspect_node(node: Node, dictionary: Borrowed[Dictionary]) -> int:
    """Read an unrelated borrowed model through every checked enum arm."""
    match node:
        Node.Scalar(name) => return len(name) + len(dictionary.values)
        Node.Pair(name, extra) => return len(name) + extra + len(dictionary.values)
        Node.Other => return len(dictionary.values)
    return 0


def inspect_pair(node: Node, extra: Option[int], dictionary: Borrowed[Dictionary]) -> int:
    """Nested enum patterns in a tuple retain their checked payload bindings."""
    match (node, extra):
        (Node.Scalar(name), Some(amount)) => return len(name) + amount + len(dictionary.values)
        _ => return len(dictionary.values)
    return 0
