# behavior: Rust associated functions infer owner arguments and normalize instantiated iterator outputs
# expect-accepted:

"""Rust associated functions infer their owner's type parameters."""

from rust::std::rc import Rc
from rust::std::vec import Vec, IntoIter
from rust::std::iter import IntoIterator


def iterator(values: Vec[int]) -> IntoIter[int]:
    """Check the owned iterator's associated output before assigning its concrete return type."""
    return values.into_iter()


def main() -> None:
    """Require the inferred allocation to match its concrete Rust type."""
    inferred = Rc.new(7)
    value: Rc[int] = inferred
