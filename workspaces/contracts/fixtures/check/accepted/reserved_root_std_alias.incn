# behavior: a standard module import may bind its own reserved root and resolve a type through that binding
# expect-accepted:

"""Keep a same-root alias usable through a compiled standard module."""

import std.web as std


def keep(response: std.Response) -> std.Response:
    """Resolve both sides of a signature through the selected module alias."""
    return response


def main() -> None:
    """Check the module binding without constructing a response."""
    pass
