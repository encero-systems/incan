# behavior: `incan inspect bindings PATH` prints the project's compiler-checked C binding declarations, one binding with its header, link and members, from the same facts the codegraph records (#3137)
# cli-commands:
#   inspect bindings .
# expect-stdout:
#   binding Bridge in src/main.incn: header interop/include/bridge.h, link system_library("c")
#     symbol absolute(value: c.i32) -> c.i32 is abs
#     enum Limit: c.i32
#       MAX is BRIDGE_LIMIT

from std.interop import c


binding Bridge:
    header = "interop/include/bridge.h"
    link = c.system_library("c")

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"
    enum Limit:
        MAX: c.i32 = BRIDGE_LIMIT


def main() -> None:
    unsafe:
        println(Bridge.absolute(-5))
