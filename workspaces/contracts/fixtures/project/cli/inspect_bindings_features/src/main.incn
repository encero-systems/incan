# behavior: `incan inspect bindings` takes 0.5.1's `--features`, `--no-default-features` and `--all-features` and inspects the source graph that selection checks; here the module that declares the binding needs an optional dependency only a feature selects (#3132)
# cli-commands:
#   inspect bindings --features extras
#   inspect bindings --all-features
# expect-stdout:
#   binding LibC in src/main.incn: header stdlib.h, link system_library("c")
#     symbol absolute(value: c.i32) -> c.i32 is abs

from std.interop import c
from pub::extra import extra_value


binding LibC:
    header = "stdlib.h"
    link = c.system_library("c")

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"


def main() -> None:
    """Call through the binding and print the optional dependency's value."""
    println(extra_value())
    unsafe:
        println(LibC.absolute(-5))
