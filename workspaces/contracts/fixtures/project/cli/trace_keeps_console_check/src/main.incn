# cli-commands:
#   check src/main.incn
# expect-stderr-contains:
#   Assignment to 'count' has type mismatch: expected 'Int', found 'Str'
# expect-stdout:
# expect-exit: 1

def main() -> None:
    count: int = "seven"
    println(f"{count}")
