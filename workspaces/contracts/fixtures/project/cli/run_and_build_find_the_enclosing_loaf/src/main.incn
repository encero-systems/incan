# behavior: `incan run` with no PATH, or with a directory inside a Loaf, runs the enclosing Loaf's program, as 0.5.1 runs the project's main script (#3143).
# cli-commands:
#   run
#   run .
#   run src
#   run src/nested
#   oven run src
# expect-stdout:
#   main ran

def main() -> None:
    println("main ran")
