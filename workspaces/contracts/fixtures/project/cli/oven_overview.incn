#   oven init [PATH] [--name NAME] [--version VERSION] [--description TEXT] [--author AUTHOR] [--license LICENSE] [--force] [--detect] [--yes]
#   oven version [BUMP | --set VERSION] [--dry-run] [--keep-prerelease] [--project PATH]
