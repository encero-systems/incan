# behavior: `incan test` runs a selected source file's inline test module (#2450), its fixtures included, as 0.5.1 does (#3149).
# cli-commands:
#   test src/main.incn
# expect-stdout-contains:
#   main.incn::test_addition PASSED
#   main.incn::test_fixture_addition PASSED

def add(left: int, right: int) -> int:
    return left + right


def main() -> None:
    println(add(1, 2))


module tests:
    from std.testing import fixture

    @fixture
    def seed() -> int:
        return 40

    def test_addition() -> None:
        assert add(2, 3) == 5

    def test_fixture_addition(seed: int) -> None:
        assert add(seed, 2) == 42
