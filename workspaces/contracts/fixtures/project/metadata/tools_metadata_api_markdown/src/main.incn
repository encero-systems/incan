# behavior: `incan tools metadata api PATH --format markdown` renders compact checked signatures (#3142) and shows the type bounds that select overloads with different return types (#1033).
# cli-commands:
#   tools metadata api src/main.incn --format markdown
# expect-stdout:
#   # tools_metadata_api_markdown API
#
#   Version: `0.1.0`
#
#   ## Module `main`
#
#   ### `LIMIT`
#
#   ```incan
#   pub const LIMIT: int
#   ```
#
#   ### `Point`
#
#   ```incan
#   pub model Point
#   ```
#
#   ### `add`
#
#   ```incan
#   pub def add(a: int, b: int = ...) -> int
#   ```
#
#   Add two numbers.
#
#   ### `convert`
#
#   ```incan
#   pub def convert[T with Int](value: int) -> int
#   ```
#
#   ### `convert`
#
#   ```incan
#   pub def convert[T with Float](value: int) -> float
#   ```
#
# expect-stderr:
# expect-exit: 0


"""A small module for metadata."""

pub const LIMIT: int = 3


pub model Point:
    """A point."""

    pub x: int
    pub y: int = 0


pub def add(a: int, b: int = 2) -> int:
    """Add two numbers."""
    return a + b


pub def convert[T with Int](value: int) -> int:
    return value


pub def convert[T with Float](value: int) -> float:
    return float(value)


def main() -> None:
    println(add(1))
