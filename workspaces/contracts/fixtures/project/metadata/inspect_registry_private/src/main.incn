# behavior: `incan inspect registry` includes the inspected package's private registries, named under the program's own module, as RFC 113 and 0.5.1 do (#3142).
# cli-commands:
#   inspect registry main::drafts
# expect-stdout-contains:
#   {
#       "identity": "main::drafts",
#       "public": false,
#         "registry_public": false,
#         "subject_identity": "main.draft",
#                   "value": "Draft text"
# expect-stderr:
# expect-exit: 0

from std.registry import Registry, SubjectKind, describe


@derive(Clone, Eq)
type FunctionId = newtype str


@derive(Descriptor)
model FunctionSpec:
    summary: str


static drafts: Registry[FunctionId, FunctionSpec] = Registry.define(
    subjects=[SubjectKind.Function],
)


@describe(drafts, FunctionId("draft"), FunctionSpec(summary="Draft text"))
def draft(value: str) -> str:
    return value.strip()


def main() -> None:
    println(draft("  incan  "))
