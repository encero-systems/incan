# behavior: an editor's overlay check stops before an untrusted path Loaf's vocabulary registration and names the Loaf
# cli-commands:
#   incan check src/main.incn --overlay src/main.incn
# expect-stderr-contains:
#   error[INCAN-T0134]
#   Loaf `words`
#   oven trust add project
# expect-exit: 1

from pub::words import marker


def main() -> None:
    """Keep the path Loaf in the selected dependency graph without explicitly executing it."""
    println(marker())
