# behavior: an integer identity reaches no package: its runtime operations are native calls into the Rust runtime, and the ambient logging prelude reaches no standard package when unused
# cli-commands:
#   oven inspect dependencies src/main.incn
# expect-stdout:
#   program `closure_of_an_integer_identity` reaches 0 packages
# expect-exit: 0

def identity(value: int) -> int:
    return value


def main() -> None:
    println(identity(3))
