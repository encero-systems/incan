# behavior: a loop over bytes reaches no package: its list operations are native calls into the Rust runtime, and no standard package is reached
# cli-commands:
#   oven inspect dependencies src/main.incn
# expect-stdout-contains:
#   program `closure_of_a_byte_loop` reaches 0 packages
# expect-exit: 0

def total(data: bytes) -> int:
    mut sum = 0
    for byte in data:
        sum += byte
    return sum


def main() -> None:
    println(total(b"abc"))
