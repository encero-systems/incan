# behavior: a custom source root links a Rust dependency whose artifact path contains equals, while direct run bypasses its Loaf (#2214, RFC 118)
# cli-commands:
#   run app=source/code/main.incn
#   run --direct src/main.incn
# expect-stdout:
#   42

def main() -> None:
    """Describe the dependency without needing any Rust declarations."""
    println(42)
