# behavior: `--interop-target` selects only a target the package declares, refused by name otherwise (#3135)
# cli-commands:
#   oven check --interop-target aarch64-linux-android src/main.incn
# expect-exit: 1
# expect-stderr-contains:
#   `--interop-target aarch64-linux-android` is not a target `interop_target_undeclared` declares; its `[[interop.c.targets]]` are aarch64-apple-darwin, x86_64-unknown-linux-gnu

from std.interop import c


binding Probe:
    header = "interop/include/probe.h"
    link = c.system_library("c")

    struct Pair:
        native = "struct probe_pair"
        first: c.i32 = first
        padding: c.i32 = padding
        second: c.i32 = second

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"


def main() -> None:
    """Call through a binding verified against the selected target's layout."""
    unsafe:
        println(Probe.absolute(-5))
