#   INCAN_WORKER_FOOTPRINT_BOUND=1
# cli-commands:
#   fmt --check src/plain.incn
#   fmt --check src/plain.incn
# expect-exit: 0
# expect-trace-contains:
#   compiler worker: started pid
#   compiler worker: retired after its request

