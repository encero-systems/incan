# behavior: `[interop.c]` accepts 0.5.1's `schema = 1`, so a `[oven.interop]` table moved to `[interop.c]` keeps working (#3132)
# cli-commands:
#   oven run src/main.incn
# expect-stdout:
#   5

from std.interop import c


binding Bridge:
    header = "interop/include/bridge.h"
    link = c.system_library("c")

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"


def main() -> None:
    """Call through a binding whose header a schema-1 table declares."""
    unsafe:
        println(Bridge.absolute(-5))
