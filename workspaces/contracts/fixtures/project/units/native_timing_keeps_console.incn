# behavior: requesting native phase timing never changes what a build and run print: the timing records go to the Oven trace, so stdout and stderr are byte-identical to an untimed run
# environment:
#   INCAN_NATIVE_TIMING=1
# cli-commands:
#   run src/main.incn
#   run src/main.incn
# expect-stdout:
#   timed
# expect-stderr:
# expect-exit: 0

def main() -> None:
    println("timed")
