# behavior: `--interop-target TRIPLE` verifies a package's checked C bindings against that declared `[[interop.c.targets]]` entry, its ABI and its definitions, instead of the host, as 0.5's `--interop-target` did; the program is still built and run for the host, nothing is cross-compiled (#3135)
# cli-commands:
#   oven run --interop-target x86_64-unknown-linux-gnu src/main.incn
# expect-stdout:
#   5

from std.interop import c


binding Probe:
    header = "interop/include/probe.h"
    link = c.system_library("c")

    struct Pair:
        native = "struct probe_pair"
        first: c.i32 = first
        padding: c.i32 = padding
        second: c.i32 = second

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"


def main() -> None:
    """Call through a binding verified against the selected target's layout."""
    unsafe:
        println(Probe.absolute(-5))
