# behavior: a binding verifies against a header the project declares under [interop.c] and calls the bound symbol
# cli-commands:
#   oven run src/main.incn
# expect-stdout:
#   7
# expect-exit: 0

from std.interop import c


binding Magnitude:
    header = "interop/include/magnitude.h"
    link = c.system_library("c")

    symbol absolute(value: c.i32) -> c.i32:
        native = "abs"


def magnitude(value: int) -> int:
    """Call the checked native symbol at one private boundary."""
    unsafe:
        return Magnitude.absolute(value)


def main() -> None:
    println(magnitude(-7))
