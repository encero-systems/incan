# behavior: a name one module imports without pub stays importable from that module on the records route: the first entry checks the providers from source and publishes their namespaces, and the second entry, checked against those published namespaces, imports it too, as Oven's toolchain takes PayloadAdmission from unit_publication on a warm records rebuild
# environment:
#   INCAN_ENGINE=records
# cli-commands:
#   run src/main.incn
#   run src/again.incn
# expect-stdout:
#   unit

"""Print the identity of the toolchain's admitted unit."""

from toolchain import installed


def main() -> None:
    """Print the first payload's identity."""
    println(installed().payloads[0].identity)
