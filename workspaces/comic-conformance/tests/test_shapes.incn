"""Structural folding and compatibility must preserve typed distinctions and shared refusal budgets."""

from std.primitives.crumb import Budget, CrumbError
from std.primitives.hex import hexlify
from std.primitives.crumb.spelling import selector_spelling, shape_spelling
from std.primitives.crumb.types import (
    AbsentPolicy,
    ContainerKind,
    FieldShape,
    NominalKind,
    ScalarKind,
    TypeNode,
    VariantShape,
)
from std.primitives.crumb.admission import AdmissionFailure, RecordShape, ValuePlan, check_written, plan_adaptation

const AGE: bytes = b"\x01?T@\x0c\x82"
const EMAIL: bytes = b"\x82$D\x17\xf9V"


def field(identity: bytes, node: TypeNode, policy: AbsentPolicy = AbsentPolicy.Required) -> FieldShape:
    """Keep independently chosen field facts visible in each test."""
    return FieldShape(identity=identity, storage_type=node, canonical=true, absent=policy)


def test_shape_identity_order_and_recursive_enum_payload() -> Result[None, CrumbError]:
    """Declaration order does not enter S, and an anonymous enum payload adds no ancestor."""
    mut budget = Budget.create(bytes=16384, elements=16384, depth=32)?
    shape = TypeNode.Record(
        "Customer",
        [field(EMAIL, TypeNode.Scalar(ScalarKind.String)), field(AGE, TypeNode.Scalar(ScalarKind.I32))],
    )
    assert shape_spelling(shape, budget)? == "record{013f54400c82:i32:1:r;82244417f956:string:1:r}"
    payload = [field(AGE, TypeNode.Recursive("Tree"))]
    tree = TypeNode.Enum("Tree", [VariantShape(identity=EMAIL, fields=payload)])
    assert shape_spelling(tree, budget)? == "enum{82244417f956:record{013f54400c82:^0:1:r}}"
    assert shape_spelling(TypeNode.Recursive("missing"), budget).is_err()
    return Ok(None)


def test_model_shape_multiplicity_is_not_union_selector_ambiguity() -> Result[None, CrumbError]:
    """Two admitted nominal alternatives can share structural shape, but equal selectors are ambiguous."""
    mut budget = Budget.create(bytes=16384, elements=16384, depth=32)?
    structural = TypeNode.Container(ContainerKind.Union, [TypeNode.Record("A", []), TypeNode.Record("B", [])])
    assert shape_spelling(structural, budget)? == "union<record{},record{}>"
    duplicate = TypeNode.Container(ContainerKind.Union, [TypeNode.Scalar(ScalarKind.I8), TypeNode.Scalar(ScalarKind.I8)])
    assert selector_spelling(duplicate, budget).is_err()
    assert ScalarKind.from_value("unknown").is_none()
    return Ok(None)


def test_failed_spelling_balances_depth_without_refunding_work() -> Result[None, CrumbError]:
    """A child that exhausts work does not leave the caller's active depth artificially elevated."""
    mut budget = Budget.create(bytes=128, elements=1, depth=1)?
    nested = TypeNode.Container(ContainerKind.Option, [TypeNode.Scalar(ScalarKind.String)])
    assert selector_spelling(nested, budget).is_err()
    budget.enter()?
    budget.leave()?
    assert budget.charge_elements(1).is_err()
    return Ok(None)


def test_adaptation_uses_identities_and_declared_ranges() -> Result[None, str]:
    """Requested order changes the plan, while narrowing fails even when a row could hold a small value."""
    mut budget = Budget.create(bytes=16384, elements=16384, depth=32).map_err((error) => error.message())?
    original = RecordShape(
        nominal=b"customer",
        fields=[field(AGE, TypeNode.Scalar(ScalarKind.I32)), field(EMAIL, TypeNode.Scalar(ScalarKind.String))],
    )
    requested = RecordShape(
        nominal=b"customer",
        fields=[field(EMAIL, TypeNode.Scalar(ScalarKind.String)), field(AGE, TypeNode.Scalar(ScalarKind.I64))],
    )
    plan = plan_adaptation(original, requested, budget).map_err((error) => error.message())?
    assert plan[0].source == Some(1)
    assert plan[1].source == Some(0)
    match plan[1].conversion:
        ValuePlan.Widen(name) =>
            assert name == ScalarKind.I64
        _ => return Err("integer widening plan missing")
    narrowed = RecordShape(nominal=b"customer", fields=[field(AGE, TypeNode.Scalar(ScalarKind.I8))])
    match plan_adaptation(original, narrowed, budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.IncompatibleType
            assert error.path == "/fields/013f54400c82"
        _ => return Err("integer narrowing was not refused")
    return Ok(None)


def test_nested_optional_plan_keeps_the_inner_conversion() -> Result[None, str]:
    """Adding an Option inside an existing Option cannot be flattened to an outer wrapping count."""
    mut budget = Budget.create(bytes=16384, elements=16384, depth=32).map_err((error) => error.message())?
    optional = TypeNode.Container(ContainerKind.Option, [TypeNode.Scalar(ScalarKind.String)])
    nested = TypeNode.Container(ContainerKind.Option, [optional])
    original = RecordShape(nominal=b"customer", fields=[field(EMAIL, optional)])
    requested = RecordShape(nominal=b"customer", fields=[field(EMAIL, nested)])
    plan = plan_adaptation(original, requested, budget).map_err((error) => error.message())?
    match plan[0].conversion:
        ValuePlan.Optional(children) =>
            match children[0]:
                ValuePlan.Wrap(inner) =>
                    assert len(inner) == 1
                _ => return Err("inner optional conversion lost")
        _ => return Err("outer optional conversion lost")
    return Ok(None)


def test_written_corruption_and_limits_cannot_be_hidden_by_projection() -> Result[None, str]:
    """Even an empty request validates the original table, and a caller limit stays a limit."""
    mut budget = Budget.create(bytes=16384, elements=16384, depth=32).map_err((error) => error.message())?
    item = field(EMAIL, TypeNode.Scalar(ScalarKind.String))
    original = RecordShape(nominal=b"customer", fields=[item, item])
    requested = RecordShape(nominal=b"customer", fields=[])
    match plan_adaptation(original, requested, budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.DuplicateIdentity
            assert error.path == "/fields/82244417f956"
        _ => return Err("bad written table survived empty projection")
    mut limited = Budget.create(bytes=0, elements=1, depth=1).map_err((error) => error.message())?
    match check_written([item], limited):
        Err(error) =>
            assert error.kind == AdmissionFailure.ResourceLimit
            assert error.cause.is_some()
        _ => return Err("limit was disguised as malformed data")
    return Ok(None)


def test_nested_nominal_identity_and_record_conversion() -> Result[None, str]:
    """A nested shape evolves only within its own binding; optional children keep their field plans."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    nominal = TypeNode.Nominal(NominalKind.Record, EMAIL, [])
    original = TypeNode.Bound([nominal, TypeNode.Record("Old", [field(AGE, TypeNode.Scalar(ScalarKind.I32))])])
    requested = TypeNode.Bound([nominal, TypeNode.Record("New", [field(AGE, TypeNode.Scalar(ScalarKind.I64))])])
    source = RecordShape(nominal=b"root", fields=[field(EMAIL, original)])
    target = RecordShape(nominal=b"root", fields=[field(EMAIL, requested)])
    plan = plan_adaptation(source, target, budget).map_err((error) => error.message())?
    match plan[0].conversion:
        ValuePlan.Record(fields) =>
            match fields[0].conversion:
                ValuePlan.Widen(name) =>
                    assert name == ScalarKind.I64
                _ => return Err("nested widening lost")
        _ => return Err("nested record plan lost")
    other = TypeNode.Bound(
        [
            TypeNode.Nominal(NominalKind.Record, AGE, []),
            TypeNode.Record("New", [field(AGE, TypeNode.Scalar(ScalarKind.I64))]),
        ],
    )
    wrong = RecordShape(nominal=b"root", fields=[field(EMAIL, other)])
    match plan_adaptation(source, wrong, budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.NominalMismatch
            assert error.path == "/fields/82244417f956"
        _ => return Err("nested nominal mismatch was ignored")
    return Ok(None)


def test_nested_written_order_is_not_repaired_by_shape_sorting() -> Result[None, str]:
    """S sorts for hashing; admission must still reject an unsorted original nested field table."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    bad = TypeNode.Record(
        "Nested",
        [field(EMAIL, TypeNode.Scalar(ScalarKind.String)), field(AGE, TypeNode.Scalar(ScalarKind.I32))],
    )
    match check_written([field(EMAIL, bad)], budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.IdentityOrder
            assert error.path == "/fields/82244417f956/fields"
        _ => return Err("nested written order was silently sorted")
    return Ok(None)


def test_recursive_adaptation_plan_is_finite() -> Result[None, str]:
    """A recursive reference selects the existing record conversion rather than expanding forever."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    left = TypeNode.Record(
        "Old",
        [
            field(AGE, TypeNode.Scalar(ScalarKind.I32)),
            field(EMAIL, TypeNode.Container(ContainerKind.Option, [TypeNode.Recursive("Old")]), AbsentPolicy.NoneValue),
        ],
    )
    right = TypeNode.Record(
        "New",
        [
            field(AGE, TypeNode.Scalar(ScalarKind.I64)),
            field(EMAIL, TypeNode.Container(ContainerKind.Option, [TypeNode.Recursive("New")]), AbsentPolicy.NoneValue),
        ],
    )
    source = RecordShape(nominal=b"root", fields=[field(EMAIL, left)])
    target = RecordShape(nominal=b"root", fields=[field(EMAIL, right)])
    plan = plan_adaptation(source, target, budget).map_err((error) => error.message())?
    match plan[0].conversion:
        ValuePlan.Record(fields) =>
            match fields[1].conversion:
                ValuePlan.Optional(children) =>
                    match children[0]:
                        ValuePlan.Recur(depth) =>
                            assert depth == 0
                        _ => return Err("recursive conversion missing")
                _ => return Err("optional recursive conversion missing")
        _ => return Err("record conversion missing")
    return Ok(None)


def test_enum_payload_widening_and_unknown_variant_refusal() -> Result[None, str]:
    """Variants retain their identity while their payload uses ordinary nested field adaptation."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    left = TypeNode.Enum("Old", [VariantShape(identity=EMAIL, fields=[field(AGE, TypeNode.Scalar(ScalarKind.I32))])])
    right = TypeNode.Enum("New", [VariantShape(identity=EMAIL, fields=[field(AGE, TypeNode.Scalar(ScalarKind.I64))])])
    source = RecordShape(nominal=b"root", fields=[field(EMAIL, left)])
    target = RecordShape(nominal=b"root", fields=[field(EMAIL, right)])
    plan = plan_adaptation(source, target, budget).map_err((error) => error.message())?
    match plan[0].conversion:
        ValuePlan.Enum(variants) =>
            assert hexlify(variants[0].identity) == "82244417f956"
            match variants[0].fields[0].conversion:
                ValuePlan.Widen(name) =>
                    assert name == ScalarKind.I64
                _ => return Err("enum payload conversion missing")
        _ => return Err("enum conversion missing")
    empty = RecordShape(nominal=b"root", fields=[field(EMAIL, TypeNode.Enum("Empty", []))])
    assert plan_adaptation(source, empty, budget).is_err()
    return Ok(None)


def test_union_reorder_uses_closed_identity() -> Result[None, str]:
    """Two same-shaped bound records cannot collapse when requested union alternatives are reordered."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    first = TypeNode.Bound([TypeNode.Nominal(NominalKind.Record, AGE, []), TypeNode.Record("A", [])])
    second = TypeNode.Bound([TypeNode.Nominal(NominalKind.Record, EMAIL, []), TypeNode.Record("B", [])])
    source = RecordShape(
        nominal=b"root",
        fields=[field(EMAIL, TypeNode.Container(ContainerKind.Union, [first, second]))],
    )
    target = RecordShape(
        nominal=b"root",
        fields=[field(EMAIL, TypeNode.Container(ContainerKind.Union, [second, first]))],
    )
    plan = plan_adaptation(source, target, budget).map_err((error) => error.message())?
    match plan[0].conversion:
        ValuePlan.Union(members) =>
            assert members[0].written_index == 0
            assert members[0].requested_index == 1
            assert members[1].written_index == 1
            assert members[1].requested_index == 0
        _ => return Err("union identity mapping missing")
    return Ok(None)


def test_missing_definition_and_empty_binding_are_refused() -> Result[None, str]:
    """A selector alone cannot supply fields; even an empty projection cannot authenticate an absent binding."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    unresolved = field(EMAIL, TypeNode.Nominal(NominalKind.Record, AGE, []))
    match check_written([unresolved], budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.MissingDescription
            assert error.path == "/fields/82244417f956"
        _ => return Err("missing definition was accepted or disguised")
    empty = RecordShape(nominal=b"", fields=[])
    match plan_adaptation(empty, empty, budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.InvalidType
            assert error.path == "/nominal"
        _ => return Err("empty nominal binding was accepted")
    return Ok(None)


def test_malformed_bound_inside_nominal_definition_is_refused() -> Result[None, str]:
    """A valid outer selector cannot hide an invalid nested binding behind its unexpanded fields."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    broken = TypeNode.Bound([])
    outer = TypeNode.Bound(
        [TypeNode.Nominal(NominalKind.Record, EMAIL, []), TypeNode.Record("Outer", [field(AGE, broken)])],
    )
    match check_written([field(EMAIL, outer)], budget):
        Err(error) =>
            assert error.kind == AdmissionFailure.InvalidType
            assert error.path == "/fields/82244417f956/fields/013f54400c82"
        _ => return Err("malformed nested binding was not refused")
    return Ok(None)


def test_bound_definition_cannot_hide_ambiguous_union_selectors() -> Result[None, str]:
    """Equal structural shape is legal, but duplicate N inside a nominal definition is still ambiguous."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    ambiguous = TypeNode.Container(ContainerKind.Union, [TypeNode.Scalar(ScalarKind.I8), TypeNode.Scalar(ScalarKind.I8)])
    outer = TypeNode.Bound(
        [TypeNode.Nominal(NominalKind.Record, EMAIL, []), TypeNode.Record("Outer", [field(AGE, ambiguous)])],
    )
    assert check_written([field(EMAIL, outer)], budget).is_err()
    return Ok(None)


def test_bound_definition_keeps_outer_recursion_context() -> Result[None, str]:
    """Nested nominal definitions may refer to an outer structural ancestor without losing its context."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    back = TypeNode.Container(ContainerKind.Option, [TypeNode.Recursive("Outer")])
    inner = TypeNode.Bound(
        [
            TypeNode.Nominal(NominalKind.Record, AGE, []),
            TypeNode.Record("Inner", [field(AGE, back, AbsentPolicy.NoneValue)]),
        ],
    )
    outer = TypeNode.Bound(
        [TypeNode.Nominal(NominalKind.Record, EMAIL, []), TypeNode.Record("Outer", [field(EMAIL, inner)])],
    )
    check_written([field(EMAIL, outer)], budget).map_err((error) => error.message())?
    return Ok(None)


def test_generic_argument_cannot_capture_enclosing_shape_recursion() -> Result[None, str]:
    """A field's ancestor is not a substitution for an independently closed generic argument."""
    mut budget = Budget.create(bytes=65536, elements=65536, depth=64).map_err((error) => error.message())?
    inner = TypeNode.Bound(
        [TypeNode.Nominal(NominalKind.Record, AGE, [TypeNode.Recursive("Outer")]), TypeNode.Record("Inner", [])],
    )
    outer = TypeNode.Record("Outer", [field(EMAIL, inner)])
    assert selector_spelling(outer, budget).is_err()
    return Ok(None)
