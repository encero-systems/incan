"""Public writer admission, exact field contracts and all-or-error resource behavior."""

from std.primitives.crumb import Budget
from std.primitives.hex import hexlify
from std.primitives.crumb.registrations import KindRegistry
from std.primitives.crumb.row_descriptions import Description, DescriptionMode
from std.primitives.crumb.row_writer import RowRecord, write_rows
from std.primitives.crumb.types import AbsentPolicy
from std.primitives.crumb.values import Metadata, MetadataEntry, Value, ValueField


def description(storage: str = "i8", absent: str = "required", kind: str = "Record") -> Description:
    """One complete independent declaration with a preserved unknown metadata property."""
    member = Metadata.Map(
        [
            MetadataEntry(key="id", value=Metadata.Binary(b"field1")),
            MetadataEntry(key="name", value=Metadata.Text("amount")),
            MetadataEntry(key="type", value=Metadata.Text(storage)),
            MetadataEntry(key="canonical", value=Metadata.Boolean(true)),
            MetadataEntry(key="absent", value=Metadata.Text(absent)),
            MetadataEntry(key="properties", value=Metadata.Map([])),
        ],
    )
    complete = Metadata.Map(
        [
            MetadataEntry(key="kind", value=Metadata.Text(kind)),
            MetadataEntry(key="nominal", value=Metadata.Binary(b"record\x00")),
            MetadataEntry(key="path", value=Metadata.Text("example.Amount")),
            MetadataEntry(key="properties", value=Metadata.Map([])),
            MetadataEntry(key="annotation", value=Metadata.Text("preserve this")),
            MetadataEntry(key="fields", value=Metadata.List([member])),
        ],
    )
    return Description(metadata=complete, mode=DescriptionMode.Inline)


def record(value: Value, absent: AbsentPolicy = AbsentPolicy.Required) -> RowRecord:
    """The logical input retains explicit field identity and final storage facts."""
    member = ValueField(identity=b"field1", canonical=true, absent=absent, value=value)
    return RowRecord(key=b"record\x00", value=Value.Record([member]))


def test_writer_checks_dictionary_before_any_rows() -> Result[None, str]:
    """Duplicate K, unknown kinds and missing nominal dependencies refuse even without a row."""
    mut budget = Budget.create(bytes=1048576, elements=1048576, depth=64).map_err((e) => e.message())?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    original = description()
    assert write_rows([original, original], [], registry, false, budget).is_err()
    assert write_rows([description(kind="Unregistered")], [], registry, false, budget).is_err()
    assert write_rows([description(storage="record@616263646566")], [], registry, false, budget).is_err()
    assert write_rows([description(storage="i8", absent="none")], [], registry, false, budget).is_err()
    assert write_rows([description(storage="unknown")], [], registry, false, budget).is_err()
    assert budget.leave().is_err()
    return Ok(None)


def test_writer_refuses_wrong_field_type_and_contract() -> Result[None, str]:
    """Logical validity alone cannot authorize the wrong declared type or alter a stored field contract."""
    mut budget = Budget.create(bytes=1048576, elements=1048576, depth=64).map_err((e) => e.message())?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    original = description()
    assert write_rows([original], [record(Value.Text("7"))], registry, false, budget).is_err()
    assert write_rows([original], [record(Value.Integer("128"))], registry, false, budget).is_err()
    wrong = ValueField(identity=b"field1", canonical=false, absent=AbsentPolicy.Required, value=Value.Integer("7"))
    assert write_rows([original], [RowRecord(key=b"record\x00", value=Value.Record([wrong]))], registry, false, budget).is_err()
    missing = RowRecord(key=b"record\x00", value=Value.Record([]))
    assert write_rows([original], [missing], registry, false, budget).is_err()
    unknown = RowRecord(key=b"absent\x00", value=Value.Record([]))
    assert write_rows([original], [unknown], registry, false, budget).is_err()
    assert budget.leave().is_err()
    return Ok(None)


def test_empty_absence_cannot_hide_wrong_collection_type() -> Result[None, str]:
    """An empty map is not an absent list; only the exact stored type can omit its cell."""
    mut budget = Budget.create(bytes=1048576, elements=1048576, depth=64).map_err((e) => e.message())?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    original = description(storage="list<i8>", absent="empty")
    correct = record(Value.List([]), AbsentPolicy.Empty)
    wrong = record(Value.Map([]), AbsentPolicy.Empty)
    assert write_rows([original], [correct], registry, false, budget).is_ok()
    assert write_rows([original], [wrong], registry, false, budget).is_err()
    return Ok(None)


def test_writer_budget_and_depth_fail_without_a_successful_prefix() -> Result[None, str]:
    """A failed complete write has no returned bytes and releases balanced recursion state."""
    mut setup = Budget.create(bytes=65536, elements=65536, depth=64).map_err((e) => e.message())?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    mut tiny = Budget.create(bytes=8, elements=65536, depth=64).map_err((e) => e.message())?
    assert write_rows([description()], [record(Value.Integer("7"))], registry, true, tiny).is_err()
    mut shallow = Budget.create(bytes=65536, elements=65536, depth=1).map_err((e) => e.message())?
    assert write_rows([description()], [], registry, false, shallow).is_err()
    assert shallow.leave().is_err()
    return Ok(None)


def test_inline_writer_retains_unknown_metadata() -> Result[None, str]:
    """Uninterpreted description properties survive inline encoding rather than disappearing at admission."""
    mut budget = Budget.create(bytes=1048576, elements=1048576, depth=64).map_err((e) => e.message())?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    encoded = write_rows([description()], [record(Value.Integer("7"))], registry, false, budget).map_err(
        (e) => e.message(),
    )?
    # Independently literal UTF-8 bytes for the annotation's stored value.
    assert "70726573657276652074686973" in hexlify(encoded)
    return Ok(None)
