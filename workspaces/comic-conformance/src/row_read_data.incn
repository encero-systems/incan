"""Translate decoder facts to test notation and typed failures to independent corpus categories."""

from std.json import JsonValue
from std.primitives.crumb.row_errors import RowFailure
from std.primitives.crumb.values import Metadata
from std.primitives.hex import hexlify


pub def metadata_notation(value: Metadata) -> JsonValue:
    """Retain every decoded description property; only expected field flags consume these facts."""
    mut result: dict[str, JsonValue] = {}
    match value:
        Metadata.Null => result["kind"] = JsonValue.string("null")
        Metadata.Boolean(item) =>
            result["kind"] = JsonValue.string("boolean")
            result["value"] = JsonValue.bool(item)
        Metadata.Integer(item) =>
            result["kind"] = JsonValue.string("int")
            result["value"] = JsonValue.string(item)
        Metadata.Text(item) =>
            result["kind"] = JsonValue.string("string")
            result["value"] = JsonValue.string(item)
        Metadata.Binary(item) =>
            result["kind"] = JsonValue.string("binary")
            result["hex"] = JsonValue.string(hexlify(item))
        Metadata.List(items) =>
            result["kind"] = JsonValue.string("list")
            result["items"] = JsonValue.array([metadata_notation(item) for item in items])
        Metadata.Map(entries) =>
            mut items: list[JsonValue] = []
            for entry in entries:
                key = metadata_notation(Metadata.Text(entry.key))
                items.append(JsonValue.array([key, metadata_notation(entry.value)]))
            result["kind"] = JsonValue.string("map")
            result["entries"] = JsonValue.array(items)
    return JsonValue.object(result)


pub def category(kind: RowFailure) -> str:
    """Match typed refusal categories; diagnostic wording is never parsed as a test outcome."""
    match kind:
        RowFailure.BadMagic => return "bad_magic"
        RowFailure.UnsupportedProfile => return "unsupported_profile"
        RowFailure.ReservedFlags => return "reserved_flags"
        RowFailure.NoncanonicalInteger => return "noncanonical_integer"
        RowFailure.IntegerOverflow => return "integer_overflow"
        RowFailure.Truncated => return "truncated"
        RowFailure.TrailingBytes => return "trailing_bytes"
        RowFailure.MissingDescription => return "missing_description"
        RowFailure.DescriptionMismatch => return "description_mismatch"
        RowFailure.DuplicateSelector => return "duplicate_selector"
        RowFailure.DescriptionOrder => return "description_order"
        RowFailure.DescriptionIndex => return "description_index"
        RowFailure.InvalidDescription => return "invalid_description"
        RowFailure.InvalidSelector => return "invalid_selector"
        RowFailure.DuplicateMember => return "duplicate_member"
        RowFailure.MemberPosition => return "member_position"
        RowFailure.MemberOrder => return "member_order"
        RowFailure.InvalidOffsets => return "invalid_offsets"
        RowFailure.InvalidOffsetWidth => return "invalid_offset_width"
        RowFailure.NonminimalOffsetWidth => return "nonminimal_offset_width"
        RowFailure.InvalidCell => return "invalid_cell"
        RowFailure.InvalidUtf8 => return "invalid_utf8"
        RowFailure.BitmapPadding => return "bitmap_padding"
        RowFailure.RedundantPresence => return "redundant_presence"
        RowFailure.NoncanonicalNan => return "noncanonical_nan"
        RowFailure.ArityMismatch => return "arity_mismatch"
        RowFailure.DuplicateKey => return "duplicate_key"
        RowFailure.CollectionOrder => return "collection_order"
        RowFailure.UnionIndex => return "union_index"
        RowFailure.VariantIndex => return "variant_index"
        RowFailure.SealRequired => return "seal_required"
        RowFailure.SealCount => return "seal_count"
        RowFailure.SealMismatch => return "seal_mismatch"
        RowFailure.LimitExceeded => return "limit_exceeded"
        RowFailure.MissingField => return "missing_field"
        RowFailure.RecordIndex => return "record_index"
