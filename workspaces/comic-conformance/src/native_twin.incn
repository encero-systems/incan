"""The independent Incan twin of every native semantic-codec operation, in the native comparison frames."""

from std.json import JsonValue
from std.primitives.crumb import Budget
from std.primitives.crumb.admission import RecordShape, check_written, plan_adaptation
from std.primitives.crumb.column_block_read import read_block
from std.primitives.crumb.column_block_write import write_block
from std.primitives.crumb.column_data_read import column_at, read_column
from std.primitives.crumb.column_data_write import write_column
from std.primitives.crumb.column_key_read import ColumnKeys, key_at, read_keys
from std.primitives.crumb.column_presence import cell_type
from std.primitives.crumb.column_reader import read_columns
from std.primitives.crumb.column_types import ColumnChoice
from std.primitives.crumb.column_writer import write_columns
from std.primitives.crumb.column_value_dictionary import ColumnDictionary, build_keys, dictionary_type, encode_keys
from std.primitives.crumb.description_dictionary import Dictionary, admit_dictionary
from std.primitives.crumb.descriptions import Description, DescriptionMode
from std.primitives.crumb.encoding_buffer import EncodingBuffer
from std.primitives.crumb.encoding_errors import BinaryError
from std.primitives.crumb.framing import Reader, frame
from std.primitives.crumb.hashes import HashResult, description_hash, model_hash, seal_hash, value_hash
from std.primitives.crumb.identity import member_identity, declaration_identity, declaration_preimage
from std.primitives.crumb.identity import closed_selector, check_arity
from std.primitives.crumb.records import RowRecord
from std.primitives.crumb.registrations import KindRegistry
from std.primitives.crumb.row_twin import read_twin_rows
from std.primitives.crumb.row_writer import write_rows
from std.primitives.crumb.selectors import parse_type
from std.primitives.crumb.spelling import selector_spelling
from std.primitives.crumb.text_printer import print_comic
from std.primitives.crumb.text_reader import read_comic
from std.primitives.crumb.types import AbsentPolicy, NominalKind, TypeNode
from std.primitives.crumb.values import Projection, Value
from std.primitives.hash import sha256
from std.primitives.hex import hexlify
from std.primitives.text import encode_utf8
from adaptation_cases import absent_value, convert
from case_data import (
    CaseOperation,
    FixtureScalarAlias,
    HashKind,
    absence,
    array,
    field,
    fields as fixture_fields,
    hex_bytes,
    node,
    nodes,
    text,
)
from column_case_data import encoding, key_values
from column_read_data import case_budget, category
from corpus import CorpusCase
from encoding_test_support import backing
from fixture_adapter import integer, logical, logical_items, metadata, record
from text_cases import case_context, corpus_document


pub def twin_encode(item: CorpusCase) -> Result[Option[bytes], str]:
    """Encode one case through the Incan codec; None marks an operation without an Incan twin yet."""
    match item.operation:
        CaseOperation.MemberIdentity =>
            mut budget = twin_budget()?
            identity = member_identity(text(item.document, "earliest_name")?, budget).map_err((e) => e.message())?
            return Ok(Some(identity))
        CaseOperation.NominalIdentity => return Ok(Some(nominal_twin(item.document)?))
        CaseOperation.TypeSelector => return Ok(Some(selector_twin(item.document)?))
        CaseOperation.ShapeAdmission => return Ok(Some(admission_twin(item.document)?))
        CaseOperation.ValueRelation => return Ok(Some(relation_twin(item.document)?))
        CaseOperation.HashPreimage => return Ok(Some(hash_twin(item.document)?))
        CaseOperation.Adaptation => return Ok(Some(adaptation_twin(item.document)?))
        CaseOperation.TextPrint => return Ok(Some(print_twin(item.document)?))
        CaseOperation.TextRead => return Ok(Some(read_twin(item.document)?))
        CaseOperation.ColumnCodec => return column_twin_encode(item.document)
        CaseOperation.BinaryDecode => return row_twin_encode(item.document)
        _ => return Ok(None)


pub def twin_decode(item: CorpusCase, encoded: bytes) -> Result[bytes, str]:
    """Decode one twin result back to its comparison bytes; semantic results without a wire form are copied."""
    match item.operation:
        CaseOperation.HashPreimage => return hash_decode(encoded)
        CaseOperation.ColumnCodec => return column_twin_decode(item.document)
        CaseOperation.BinaryDecode => return row_twin_decode(item.document)
        _ => return Ok(encoded)


def twin_budget() -> Result[Budget, str]:
    """Give every twin operation the same generous independent allowance."""
    return Budget.create(bytes=1048576, elements=1048576, depth=128).map_err((error) => error.message())


def nominal_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the nominal identity, its framed preimage and the complete digest."""
    mut budget = twin_budget()?
    registry = text(document, "registry")?
    package = text(document, "package")?
    earliest_path = text(document, "earliest_path")?
    identity = declaration_identity(registry, package, earliest_path, budget).map_err((error) => error.message())?
    preimage = declaration_preimage(registry, package, earliest_path, budget).map_err((error) => error.message())?
    digest = sha256.digest(preimage)
    mut output = EncodingBuffer.create()
    output.append(identity, budget).map_err((error) => error.message())?
    output
        .append(frame(preimage, budget).map_err((error) => error.message())?, budget)
        .map_err((error) => error.message())?
    output.append(digest, budget).map_err((error) => error.message())?
    return output.finish(budget).map_err((error) => error.message())


def selector_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the selector spelling and key."""
    mut budget = twin_budget()?
    input = field(document, "input")?
    mut arguments: list[TypeNode] = []
    if let Some(items) = input.get("arguments"):
        arguments = nodes(items.expect_array().map_err((error) => error.message())?)?
    kind = match NominalKind.from_value(text(input, "kind")?):
        Some(value) => value
        None => return Err("unknown nominal kind")

    selector = TypeNode.Nominal(kind, "", Some(hex_bytes(text(input, "declaration_hex")?)?), arguments)
    if let Some(parameters) = input.get("parameter_names"):
        check_arity(selector, len(parameters.expect_array().map_err((error) => error.message())?)).map_err(
            (error) => error.message(),
        )?
    spelling = encode_utf8(selector_spelling(selector, budget).map_err((error) => error.message())?)
    key = closed_selector(selector, budget).map_err((error) => error.message())?
    mut output = EncodingBuffer.create()
    output
        .append(frame(spelling, budget).map_err((error) => error.message())?, budget)
        .map_err((error) => error.message())?
    output.append(key, budget).map_err((error) => error.message())?
    return output.finish(budget).map_err((error) => error.message())


def admission_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the written-shape admission result without reading the expected corpus verdict."""
    mut budget = twin_budget()?
    match check_written(fixture_fields(field(document, "written")?)?, budget):
        Ok(_) => return Ok(b"\x00")
        Err(error) =>
            mut output = EncodingBuffer.create()
            output.octet(1, budget).map_err((failure) => failure.message())?
            output
                .append(frame(encode_utf8(error.kind.value()), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            output
                .append(frame(encode_utf8(error.path), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            return output.finish(budget).map_err((failure) => failure.message())


def relation_twin(document: JsonValue) -> Result[bytes, str]:
    """Compare independently derived production object hashes without reading the expected relation."""
    mut budget = twin_budget()?
    left = value_hash(logical(field(document, "left")?)?, Projection.Object, budget).map_err((error) => error.message())?
    right = value_hash(logical(field(document, "right")?)?, Projection.Object, budget).map_err(
        (error) => error.message(),
    )?
    if left.digest == right.digest:
        return Ok(b"\x00")
    return Ok(b"\x01")


def hash_twin(document: JsonValue) -> Result[bytes, str]:
    """Derive one captured preimage from the logical input and frame it before its complete digest."""
    mut budget = twin_budget()?
    kind = match HashKind.from_value(text(document, "projection")?):
        Some(selected) => selected
        None => return Err("unknown hash projection")

    result = projected_hash(kind, field(document, "input")?, budget)?
    match result.preimage:
        Some(preimage) =>
            mut output = EncodingBuffer.create()
            output
                .append(frame(preimage, budget).map_err((error) => error.message())?, budget)
                .map_err((error) => error.message())?
            output.append(result.digest, budget).map_err((error) => error.message())?
            return output.finish(budget).map_err((error) => error.message())
        None => return Err("hash request did not capture its derived preimage")


def projected_hash(kind: HashKind, input: JsonValue, mut budget: Budget) -> Result[HashResult, str]:
    """Dispatch one hash domain over its logical input, never over expected bytes."""
    match kind:
        HashKind.Object =>
            return value_hash(logical(input)?, Projection.Object, budget, true).map_err((e) => e.message())
        HashKind.Canonical =>
            return value_hash(logical(input)?, Projection.Canonical, budget, true).map_err((e) => e.message())
        HashKind.Model => return model_hash(node(field(input, "type")?)?, budget, true).map_err((e) => e.message())
        HashKind.Description =>
            return description_hash(metadata(field(input, "description")?)?, budget, true).map_err((e) => e.message())
        HashKind.Seal =>
            return seal_hash(logical_items(array(input, "values")?)?, budget, true).map_err((e) => e.message())


def hash_decode(encoded: bytes) -> Result[bytes, str]:
    """Read the preimage frame back, require the trailing digest to match it, and rebuild the comparison bytes."""
    mut budget = twin_budget()?
    mut reader = Reader.from_bytes(encoded)
    preimage = reader.read_frame(budget).map_err((error) => error.message())?
    mut trailing: list[u8] = []
    for index in range(reader.position(), len(encoded)):
        trailing.append(encoded[index])
    digest: bytes = trailing.clone()
    if sha256.digest(preimage) != digest:
        return Err("hash twin digest does not match its preimage")
    mut output = EncodingBuffer.create()
    output.append(frame(preimage, budget).map_err((error) => error.message())?, budget).map_err((e) => e.message())?
    output.append(digest, budget).map_err((error) => error.message())?
    return output.finish(budget).map_err((error) => error.message())


def adaptation_twin(document: JsonValue) -> Result[bytes, str]:
    """Plan and apply one adaptation, then encode the adapted object preimage and three digest relations."""
    mut budget = twin_budget()?
    written = field(document, "written")?
    requested = field(document, "requested")?
    source = RecordShape(nominal=encode_utf8(text(written, "nominal")?), fields=fixture_fields(written)?)
    target = RecordShape(nominal=encode_utf8(text(requested, "nominal")?), fields=fixture_fields(requested)?)
    match plan_adaptation(source, target, budget):
        Err(error) =>
            mut refused = EncodingBuffer.create()
            refused.octet(1, budget).map_err((failure) => failure.message())?
            refused
                .append(frame(encode_utf8(error.kind.value()), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            refused
                .append(frame(encode_utf8(error.path), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            return refused.finish(budget).map_err((failure) => failure.message())
        Ok(plan) =>
            values = array(document, "values")?
            mut adapted: list[JsonValue] = []
            for item in plan:
                match item.source:
                    Some(index) => adapted.append(convert(values[index], item.conversion)?)
                    None => adapted.append(absent_value(item)?)
            before = record(written, values)?
            after = record(requested, adapted)?
            after_object = value_hash(after, Projection.Object, budget, true).map_err((e) => e.message())?
            preimage = match after_object.preimage:
                Some(captured) => captured
                None => return Err("adaptation twin did not capture its object preimage")

            before_object = value_hash(before, Projection.Object, budget).map_err((e) => e.message())?
            before_canonical = value_hash(before, Projection.Canonical, budget).map_err((e) => e.message())?
            after_canonical = value_hash(after, Projection.Canonical, budget).map_err((e) => e.message())?
            source_model = model_hash(TypeNode.Record("source", fixture_fields(written)?), budget).map_err(
                (e) => e.message(),
            )?
            target_model = model_hash(TypeNode.Record("target", fixture_fields(requested)?), budget).map_err(
                (e) => e.message(),
            )?
            mut output = EncodingBuffer.create()
            output.octet(0, budget).map_err((e) => e.message())?
            output.append(frame(preimage, budget).map_err((e) => e.message())?, budget).map_err((e) => e.message())?
            output.octet(changed(before_object, after_object), budget).map_err((e) => e.message())?
            output.octet(changed(before_canonical, after_canonical), budget).map_err((e) => e.message())?
            output.octet(changed(source_model, target_model), budget).map_err((e) => e.message())?
            return output.finish(budget).map_err((e) => e.message())


def changed(left: HashResult, right: HashResult) -> int:
    """One when two digests differ, zero when they are the same."""
    if left.digest == right.digest:
        return 0
    return 1


def print_twin(document: JsonValue) -> Result[bytes, str]:
    """Print the independently built typed document through the Incan COMIC printer."""
    mut budget = twin_budget()?
    context = case_context(document, budget)?
    typed = corpus_document(field(document, "document")?, context, budget)?
    return print_comic(typed, context, budget).map_err((error) => error.message())


def column_twin_encode(document: JsonValue) -> Result[Option[bytes], str]:
    """Dispatch one column case's encode stage to its dictionary, block, complete-column or envelope twin."""
    operation = text(document, "operation")?
    if operation == CaseOperation.BinaryDecode.value():
        return envelope_twin_encode(document)
    if operation == CaseOperation.ColumnData.value():
        return data_twin_encode(document)
    if operation == CaseOperation.ColumnBlock.value():
        return block_twin_encode(document)
    if operation != CaseOperation.ColumnDictionary.value():
        return Ok(None)
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    name = text(document, "type")?
    node = parse_type(name, setup).map_err((e) => e.message())?
    keys = key_values(field(document, "expected")?, name, "keys_hex", "values")?
    if len(keys) == 0:
        return Ok(Some(b""))
    built = build_keys(node, keys, dictionary, setup).map_err((e) => e.message())?
    return Ok(Some(encode_keys(node, built, dictionary, setup).map_err((e) => e.message())?))


def column_twin_decode(document: JsonValue) -> Result[bytes, str]:
    """Read the literal dictionary, or each proper prefix when asked, into keys or one typed refusal category."""
    if text(document, "operation")? == CaseOperation.BinaryDecode.value():
        return envelope_twin_decode(document)
    if text(document, "operation")? == CaseOperation.ColumnData.value():
        return data_twin_decode(document)
    if text(document, "operation")? == CaseOperation.ColumnBlock.value():
        return block_twin_decode(document)
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    node = parse_type(text(document, "type")?, setup).map_err((e) => e.message())?
    data = hex_bytes(text(document, "input_hex")?)?
    mut lengths: list[int] = [len(data)]
    if document.get("transform").is_some():
        lengths = [length for length in range(len(data))]
    mut output = EncodingBuffer.create()
    for length in lengths:
        mut budget = case_budget(document)?
        match read_keys(node, backing(data[:length])?, 0, dictionary, budget):
            Err(error) =>
                output.octet(1, setup).map_err((e) => e.message())?
                output
                    .append(frame(encode_utf8(category(error)?), setup).map_err((e) => e.message())?, setup)
                    .map_err((e) => e.message())?
            Ok(keys) =>
                mut values: list[Value] = []
                for code in range(keys.count):
                    values.append(key_at(keys, code, dictionary, setup).map_err((e) => e.message())?)
                result = value_hash(Value.List(values), Projection.Object, setup, true).map_err((e) => e.message())?
                preimage = match result.preimage:
                    Some(captured) => captured
                    None => return Err("column twin did not capture its keys preimage")

                output.octet(0, setup).map_err((e) => e.message())?
                output.append(frame(preimage, setup).map_err((e) => e.message())?, setup).map_err((e) => e.message())?
    return output.finish(setup).map_err((e) => e.message())


def column_setup() -> Result[Budget, str]:
    """The harness's separate setup allowance for type parsing, expectations and re-encoding."""
    return Budget.create(bytes=134217728, elements=8388608, depth=128).map_err((error) => error.message())


def block_twin_encode(document: JsonValue) -> Result[Option[bytes], str]:
    """Write a column block's authored values with its authored encoding; a refused case writes nothing."""
    expected = field(document, "expected")?
    if expected.get("values").is_none():
        return Ok(Some(b""))
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    node = block_type(document, setup)?
    absent = block_absence(document)?
    writer_keys, _ = block_keys(document, node, absent, dictionary, setup)?
    values = logical_items(array(expected, "values")?)?
    selected = encoding(integer(expected, "encoding")?)?
    return Ok(
        Some(write_block(node, absent, values, selected, writer_keys, dictionary, setup).map_err((e) => e.message())?),
    )


def block_twin_decode(document: JsonValue) -> Result[bytes, str]:
    """Read the literal block into its encoding and logical values, or one typed refusal category."""
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    node = block_type(document, setup)?
    absent = block_absence(document)?
    _, keys = block_keys(document, node, absent, dictionary, setup)?
    data = hex_bytes(text(document, "input_hex")?)?
    rows = integer(document, "logical_count")?
    mut lengths: list[int] = [len(data)]
    if document.get("transform").is_some():
        lengths = [length for length in range(len(data))]
    mut output = EncodingBuffer.create()
    for length in lengths:
        mut budget = case_budget(document)?
        match read_block(node, absent, rows, backing(data[:length])?, 0, keys, dictionary, budget):
            Err(error) =>
                output.octet(1, setup).map_err((e) => e.message())?
                output
                    .append(frame(encode_utf8(category(error)?), setup).map_err((e) => e.message())?, setup)
                    .map_err((e) => e.message())?
            Ok((block, values)) =>
                result = value_hash(Value.List(values), Projection.Object, setup, true).map_err((e) => e.message())?
                preimage = match result.preimage:
                    Some(captured) => captured
                    None => return Err("block twin did not capture its values preimage")

                output.octet(0, setup).map_err((e) => e.message())?
                output.count(block.encoding.value(), setup).map_err((e) => e.message())?
                output.append(frame(preimage, setup).map_err((e) => e.message())?, setup).map_err((e) => e.message())?
    return output.finish(setup).map_err((e) => e.message())


def block_type(document: JsonValue, mut setup: Budget) -> Result[TypeNode, str]:
    """Parse the declared block type, translating the legacy negative-vector spelling explicitly."""
    mut name = text(document, "type")?
    if let Some(alias) = FixtureScalarAlias.from_value(name):
        name = alias.scalar_kind().value()
    return parse_type(name, setup).map_err((e) => e.message())


def block_absence(document: JsonValue) -> Result[AbsentPolicy, str]:
    """The declared absence policy, required when the case names none."""
    if let Some(value) = document.get("absent"):
        return absence(value.expect_str().map_err((e) => e.message())?)
    return Ok(AbsentPolicy.Required)


def block_keys(
    document: JsonValue,
    node: TypeNode,
    absent: AbsentPolicy,
    dictionary: Dictionary,
    mut setup: Budget,
) -> Result[tuple[Option[ColumnDictionary], Option[ColumnKeys]], str]:
    """Build the case's external dictionary for the writer and admit its encoding for the reader."""
    stored_type = cell_type(node, absent, setup).map_err((e) => e.message())?
    input_keys = key_values(document, text(document, "type")?, "dictionary_keys_hex", "dictionary_values")?
    if len(input_keys) == 0:
        return Ok((None, None))
    mut key_type = stored_type.clone()
    if not dictionary_type(stored_type):
        supplied = array(document, "dictionary_values")?
        key_type = parse_type(text(supplied[0], "type")?, setup).map_err((e) => e.message())?
    built = build_keys(key_type, input_keys, dictionary, setup).map_err((e) => e.message())?
    raw = encode_keys(key_type, built, dictionary, setup).map_err((e) => e.message())?
    keys = read_keys(key_type, backing(raw)?, 0, dictionary, setup).map_err((e) => e.message())?
    return Ok((Some(built), Some(keys)))


def data_twin_encode(document: JsonValue) -> Result[Option[bytes], str]:
    """Write a complete column's authored values with its authored block encodings."""
    expected = field(document, "expected")?
    if expected.get("values").is_none():
        return Ok(Some(b""))
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    node = block_type(document, setup)?
    absent = block_absence(document)?
    mut choices = ColumnChoice(blocks=[])
    for item in array(expected, "encodings")?:
        choices.blocks.append(encoding(item.expect_int().map_err((e) => e.message())?)?)
    values = logical_items(array(expected, "values")?)?
    return Ok(Some(write_column(node, absent, values, choices, dictionary, setup).map_err((e) => e.message())?))


def data_twin_decode(document: JsonValue) -> Result[bytes, str]:
    """Read a complete column into its block encodings and logical values, or one typed refusal category."""
    mut setup = column_setup()?
    registry = KindRegistry.create([], setup).map_err((e) => e.message())?
    dictionary = admit_dictionary([], registry, setup).map_err((e) => e.message())?
    node = block_type(document, setup)?
    absent = block_absence(document)?
    data = hex_bytes(text(document, "input_hex")?)?
    mut budget = case_budget(document)?
    mut output = EncodingBuffer.create()
    match read_column(node, absent, integer(document, "logical_count")?, backing(data)?, 0, dictionary, budget):
        Err(error) =>
            output.octet(1, setup).map_err((e) => e.message())?
            output
                .append(frame(encode_utf8(category(error)?), setup).map_err((e) => e.message())?, setup)
                .map_err((e) => e.message())?
        Ok(column) =>
            mut values: list[Value] = []
            for position in range(column.rows):
                values.append(column_at(column, position, dictionary, setup).map_err((e) => e.message())?)
            result = value_hash(Value.List(values), Projection.Object, setup, true).map_err((e) => e.message())?
            preimage = match result.preimage:
                Some(captured) => captured
                None => return Err("column data twin did not capture its values preimage")

            output.octet(0, setup).map_err((e) => e.message())?
            output.count(len(column.blocks), setup).map_err((e) => e.message())?
            for block in column.blocks:
                output.count(block.encoding.value(), setup).map_err((e) => e.message())?
            output.append(frame(preimage, setup).map_err((e) => e.message())?, setup).map_err((e) => e.message())?
    return output.finish(setup).map_err((e) => e.message())


pub def with_input(item: CorpusCase, texts: dict[str, bytes]) -> Result[CorpusCase, str]:
    """Carry a text-read case's pinned source bytes inside its document, so both codecs read the same input."""
    if item.operation != CaseOperation.TextRead:
        return Ok(item)
    mut object = item.document.expect_object().map_err((error) => error.message())?
    object["input_hex"] = JsonValue.string(hexlify(texts[text(item.document, "input_file")?]))
    return Ok(CorpusCase(id=item.id, operation=item.operation, document=JsonValue.object(object)))


def read_twin(document: JsonValue) -> Result[bytes, str]:
    """Read the pinned source through the Incan COMIC reader; print an accepted document canonically."""
    mut budget = twin_budget()?
    context = case_context(document, budget)?
    source = hex_bytes(text(document, "input_hex")?)?
    mut output = EncodingBuffer.create()
    match read_comic(source, context, budget):
        Ok(document_value) =>
            printed = print_comic(document_value, context, budget).map_err((error) => error.message())?
            output.octet(0, budget).map_err((error) => error.message())?
            output
                .append(frame(printed, budget).map_err((error) => error.message())?, budget)
                .map_err((error) => error.message())?
        Err(error) =>
            output.octet(1, budget).map_err((failure) => failure.message())?
            output
                .append(frame(encode_utf8(error.kind.value()), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            output.count(error.position.line, budget).map_err((failure) => failure.message())?
            output.count(error.position.column, budget).map_err((failure) => failure.message())?
    return output.finish(budget).map_err((error) => error.message())


def row_twin_encode(document: JsonValue) -> Result[Option[bytes], str]:
    """Decode the complete row envelope, then write its descriptions and records back; a refusal writes nothing."""
    data = hex_bytes(text(document, "input_hex")?)?
    supplied = row_supplied(document)?
    mut budget = row_budget(document)?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    match read_twin_rows(backing(data)?, supplied, registry, row_require_sealed(document)?, budget):
        Err(_) => return Ok(Some(b""))
        Ok(rows) =>
            mut setup = Budget.create(bytes=67108864, elements=4194304, depth=128).map_err((e) => e.message())?
            descriptions = rows.descriptions(setup).map_err((e) => e.message())?
            mut records: list[RowRecord] = []
            for index in range(rows.len()):
                records.append(rows.read_record(index, setup).map_err((e) => e.message())?)
            writer = KindRegistry.create([], setup).map_err((e) => e.message())?
            encoded = write_rows(descriptions, records, writer, rows.is_sealed(), setup).map_err((e) => e.message())?
            return Ok(Some(encoded))


def row_twin_decode(document: JsonValue) -> Result[bytes, str]:
    """Read the literal envelope, or each proper prefix when asked, into records or one typed refusal category."""
    data = hex_bytes(text(document, "input_hex")?)?
    supplied = row_supplied(document)?
    mut lengths: list[int] = [len(data)]
    if document.get("transform").is_some():
        lengths = [length for length in range(len(data))]
    mut setup = Budget.create(bytes=67108864, elements=4194304, depth=128).map_err((e) => e.message())?
    mut output = EncodingBuffer.create()
    for length in lengths:
        mut budget = row_budget(document)?
        registry = KindRegistry.create([], budget).map_err((e) => e.message())?
        match read_twin_rows(backing(data[:length])?, supplied, registry, row_require_sealed(document)?, budget):
            Err(error) =>
                output.octet(1, setup).map_err((e) => e.message())?
                row_refusal(output, error, setup)?
            Ok(rows) =>
                output.octet(0, setup).map_err((e) => e.message())?
                mut sealed = 0
                if rows.is_sealed():
                    sealed = 1
                output.octet(sealed, setup).map_err((e) => e.message())?
                output.count(rows.len(), setup).map_err((e) => e.message())?
                for index in range(rows.len()):
                    record = rows.read_record(index, setup).map_err((e) => e.message())?
                    result = value_hash(record.value, Projection.Object, setup, true).map_err((e) => e.message())?
                    preimage = match result.preimage:
                        Some(captured) => captured
                        None => return Err("row twin did not capture its record preimage")

                    output
                        .append(frame(record.key, setup).map_err((e) => e.message())?, setup)
                        .map_err((e) => e.message())?
                    output
                        .append(frame(preimage, setup).map_err((e) => e.message())?, setup)
                        .map_err((e) => e.message())?
    return output.finish(setup).map_err((e) => e.message())


def row_refusal(mut output: EncodingBuffer, error: BinaryError, mut setup: Budget) -> Result[None, str]:
    """Write a refusal's category, envelope offset, and stored field and variant when known."""
    output
        .append(frame(encode_utf8(error.kind.value()), setup).map_err((e) => e.message())?, setup)
        .map_err((e) => e.message())?
    output.count(error.offset, setup).map_err((e) => e.message())?
    refusal_member(output, error.field, setup)?
    return refusal_member(output, error.variant, setup)


def refusal_member(mut output: EncodingBuffer, member: Option[bytes], mut setup: Budget) -> Result[None, str]:
    """Write a zero for an unknown member, or a one and the member's framed identity."""
    match member:
        Some(identity) =>
            output.octet(1, setup).map_err((e) => e.message())?
            output.append(frame(identity, setup).map_err((e) => e.message())?, setup).map_err((e) => e.message())?
        None => output.octet(0, setup).map_err((e) => e.message())?
    return Ok(None)


def row_supplied(document: JsonValue) -> Result[list[Description], str]:
    """The case's supplied complete descriptions, admitted by reference only."""
    mut supplied: list[Description] = []
    for item in array(document, "supplied_descriptions")?:
        supplied.append(Description(metadata=metadata(item)?, mode=DescriptionMode.Reference))
    return Ok(supplied)


def row_require_sealed(document: JsonValue) -> Result[bool, str]:
    """Whether the case requires a sealed envelope."""
    if let Some(value) = document.get("require_sealed"):
        return value.expect_bool().map_err((e) => e.message())
    return Ok(false)


def row_budget(document: JsonValue) -> Result[Budget, str]:
    """The row decoder's one allowance, tightened by the case's byte, element and depth limits."""
    mut bytes = 16777216
    mut elements = 1048576
    mut depth = 128
    if let Some(limits) = document.get("limits"):
        if let Some(value) = limits.get("bytes"):
            bytes = value.expect_int().map_err((e) => e.message())?
        if let Some(value) = limits.get("elements"):
            elements = value.expect_int().map_err((e) => e.message())?
        if let Some(value) = limits.get("depth"):
            depth = value.expect_int().map_err((e) => e.message())?
    return Budget.create(bytes=bytes, elements=elements, depth=depth).map_err((e) => e.message())


def envelope_twin_encode(document: JsonValue) -> Result[Option[bytes], str]:
    """Decode the complete column envelope, then write it back with its original choices; a refusal writes nothing."""
    data = hex_bytes(text(document, "input_hex")?)?
    supplied = envelope_supplied(document)?
    mut budget = case_budget(document)?
    registry = KindRegistry.create([], budget).map_err((e) => e.message())?
    match read_columns(backing(data)?, supplied, registry, row_require_sealed(document)?, budget):
        Err(_) => return Ok(Some(b""))
        Ok(rows) =>
            mut setup = Budget.create(bytes=134217728, elements=8388608, depth=128).map_err((e) => e.message())?
            descriptions = rows.descriptions(setup).map_err((e) => e.message())?
            mut records: list[RowRecord] = []
            for index in range(rows.len()):
                records.append(rows.read_record(index, setup).map_err((e) => e.message())?)
            choices = rows.choices(setup).map_err((e) => e.message())?
            writer = KindRegistry.create([], setup).map_err((e) => e.message())?
            encoded = write_columns(descriptions, records, writer, rows.is_sealed(), choices, setup).map_err(
                (e) => e.message(),
            )?
            return Ok(Some(encoded))


def envelope_twin_decode(document: JsonValue) -> Result[bytes, str]:
    """Read the literal column envelope, or each proper prefix when asked, into records or one refusal category."""
    data = hex_bytes(text(document, "input_hex")?)?
    supplied = envelope_supplied(document)?
    mut lengths: list[int] = [len(data)]
    if document.get("transform").is_some():
        lengths = [length for length in range(len(data))]
    mut setup = Budget.create(bytes=134217728, elements=8388608, depth=128).map_err((e) => e.message())?
    mut output = EncodingBuffer.create()
    for length in lengths:
        mut budget = case_budget(document)?
        registry = KindRegistry.create([], budget).map_err((e) => e.message())?
        match read_columns(backing(data[:length])?, supplied, registry, row_require_sealed(document)?, budget):
            Err(error) =>
                output.octet(1, setup).map_err((e) => e.message())?
                output
                    .append(frame(encode_utf8(category(error)?), setup).map_err((e) => e.message())?, setup)
                    .map_err((e) => e.message())?
            Ok(rows) =>
                output.octet(0, setup).map_err((e) => e.message())?
                mut sealed = 0
                if rows.is_sealed():
                    sealed = 1
                output.octet(sealed, setup).map_err((e) => e.message())?
                output.count(rows.len(), setup).map_err((e) => e.message())?
                for index in range(rows.len()):
                    record = rows.read_record(index, setup).map_err((e) => e.message())?
                    result = value_hash(record.value, Projection.Object, setup, true).map_err((e) => e.message())?
                    preimage = match result.preimage:
                        Some(captured) => captured
                        None => return Err("envelope twin did not capture its record preimage")

                    output
                        .append(frame(record.key, setup).map_err((e) => e.message())?, setup)
                        .map_err((e) => e.message())?
                    output
                        .append(frame(preimage, setup).map_err((e) => e.message())?, setup)
                        .map_err((e) => e.message())?
    return output.finish(setup).map_err((e) => e.message())


def envelope_supplied(document: JsonValue) -> Result[list[Description], str]:
    """The case's supplied complete descriptions, when it names any."""
    if document.get("supplied_descriptions").is_none():
        return Ok([])
    return row_supplied(document)
