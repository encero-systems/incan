"""The independent Incan twin of every native semantic-codec operation, in the native comparison frames."""

from std.json import JsonValue
from std.primitives.crumb import Budget
from std.primitives.crumb.admission import check_written
from std.primitives.crumb.encoding_buffer import EncodingBuffer
from std.primitives.crumb.framing import frame
from std.primitives.crumb.hashes import value_hash
from std.primitives.crumb.identity import member_identity, declaration_identity, declaration_preimage
from std.primitives.crumb.identity import closed_selector, check_arity
from std.primitives.crumb.spelling import selector_spelling
from std.primitives.crumb.types import NominalKind, TypeNode
from std.primitives.crumb.values import Projection
from std.primitives.hash import sha256
from std.primitives.text import encode_utf8
from case_data import CaseOperation, field, fields as fixture_fields, hex_bytes, nodes, text
from corpus import CorpusCase
from fixture_adapter import logical


pub def twin_encode(item: CorpusCase) -> Result[Option[bytes], str]:
    """Encode one case through the Incan codec; None marks an operation without an Incan twin yet."""
    match item.operation:
        CaseOperation.MemberIdentity =>
            mut budget = twin_budget()?
            identity = member_identity(text(item.document, "earliest_name")?, budget).map_err((e) => e.message())?
            return Ok(Some(identity))
        CaseOperation.NominalIdentity => return Ok(Some(nominal_twin(item.document)?))
        CaseOperation.TypeSelector => return Ok(Some(selector_twin(item.document)?))
        CaseOperation.ShapeAdmission => return Ok(Some(admission_twin(item.document)?))
        CaseOperation.ValueRelation => return Ok(Some(relation_twin(item.document)?))
        _ => return Ok(None)


pub def twin_decode(operation: CaseOperation, encoded: bytes) -> Result[bytes, str]:
    """Decode one twin result back to its comparison bytes; semantic results without a wire form are copied."""
    match operation:
        _ => return Ok(encoded)


def twin_budget() -> Result[Budget, str]:
    """Give every twin operation the same generous independent allowance."""
    return Budget.create(bytes=1048576, elements=1048576, depth=128).map_err((error) => error.message())


def nominal_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the nominal identity, its framed preimage and the complete digest."""
    mut budget = twin_budget()?
    registry = text(document, "registry")?
    package = text(document, "package")?
    earliest_path = text(document, "earliest_path")?
    identity = declaration_identity(registry, package, earliest_path, budget).map_err((error) => error.message())?
    preimage = declaration_preimage(registry, package, earliest_path, budget).map_err((error) => error.message())?
    digest = sha256.digest(preimage)
    mut output = EncodingBuffer.create()
    output.append(identity, budget).map_err((error) => error.message())?
    output
        .append(frame(preimage, budget).map_err((error) => error.message())?, budget)
        .map_err((error) => error.message())?
    output.append(digest, budget).map_err((error) => error.message())?
    return output.finish(budget).map_err((error) => error.message())


def selector_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the selector spelling and key."""
    mut budget = twin_budget()?
    input = field(document, "input")?
    mut arguments: list[TypeNode] = []
    if let Some(items) = input.get("arguments"):
        arguments = nodes(items.expect_array().map_err((error) => error.message())?)?
    kind = match NominalKind.from_value(text(input, "kind")?):
        Some(value) => value
        None => return Err("unknown nominal kind")

    selector = TypeNode.Nominal(kind, "", Some(hex_bytes(text(input, "declaration_hex")?)?), arguments)
    if let Some(parameters) = input.get("parameter_names"):
        check_arity(selector, len(parameters.expect_array().map_err((error) => error.message())?)).map_err(
            (error) => error.message(),
        )?
    spelling = encode_utf8(selector_spelling(selector, budget).map_err((error) => error.message())?)
    key = closed_selector(selector, budget).map_err((error) => error.message())?
    mut output = EncodingBuffer.create()
    output
        .append(frame(spelling, budget).map_err((error) => error.message())?, budget)
        .map_err((error) => error.message())?
    output.append(key, budget).map_err((error) => error.message())?
    return output.finish(budget).map_err((error) => error.message())


def admission_twin(document: JsonValue) -> Result[bytes, str]:
    """Encode the written-shape admission result without reading the expected corpus verdict."""
    mut budget = twin_budget()?
    match check_written(fixture_fields(field(document, "written")?)?, budget):
        Ok(_) => return Ok(b"\x00")
        Err(error) =>
            mut output = EncodingBuffer.create()
            output.octet(1, budget).map_err((failure) => failure.message())?
            output
                .append(frame(encode_utf8(error.kind.value()), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            output
                .append(frame(encode_utf8(error.path), budget).map_err((failure) => failure.message())?, budget)
                .map_err((failure) => failure.message())?
            return output.finish(budget).map_err((failure) => failure.message())


def relation_twin(document: JsonValue) -> Result[bytes, str]:
    """Compare independently derived production object hashes without reading the expected relation."""
    mut budget = twin_budget()?
    left = value_hash(logical(field(document, "left")?)?, Projection.Object, budget).map_err((error) => error.message())?
    right = value_hash(logical(field(document, "right")?)?, Projection.Object, budget).map_err(
        (error) => error.message(),
    )?
    if left.digest == right.digest:
        return Ok(b"\x00")
    return Ok(b"\x01")
