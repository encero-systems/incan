"""Translate independent row-value notation for writer inputs and decoder expectations."""

from std.json import JsonValue
from std.primitives.crumb.values import Value, ValueField, MapEntry
from case_data import array, field, text, hex_bytes, absence, selector_text
from hash_data import logical


def property_value(description: JsonValue, name: str) -> Result[JsonValue, str]:
    """Read the independent tagged metadata notation, without using production description admission."""
    for item in array(description, "entries")?:
        pair = item.expect_array().map_err((e) => e.message())?
        if len(pair) != 2:
            return Err("invalid writer metadata pair")
        if text(pair[0], "value")? == name:
            return Ok(pair[1])
    return Err("missing writer metadata property: " + name)


def find_description(key: str, descriptions: list[JsonValue]) -> Result[JsonValue, str]:
    """Use the caller-supplied K labels for nested record inputs, never a computed model hash."""
    for description in descriptions:
        if text(property_value(description, "nominal")?, "hex")? == key:
            return Ok(description)
    return Err("missing writer input description")


pub def record_value(record: JsonValue, descriptions: list[JsonValue]) -> Result[Value, str]:
    """Attach explicitly authored field facts to stored values; do not construct or normalize a model."""
    description = find_description(text(record, "selector_hex")?, descriptions)?
    if let Some(tag) = record.get("variant_id"):
        identity = tag.expect_str().map_err((e) => e.message())?
        for variant in array(property_value(description, "variants")?, "items")?:
            if text(property_value(variant, "id")?, "hex")? == identity:
                fields = record_fields(record, variant, descriptions)?
                return Ok(Value.Enum(hex_bytes(identity)?, fields))
        return Err("missing writer input variant")
    return Ok(Value.Record(record_fields(record, description, descriptions)?))


def record_fields(
    record: JsonValue,
    description: JsonValue,
    descriptions: list[JsonValue],
) -> Result[list[ValueField], str]:
    """Field identities match independent metadata; canonical/absence flags are copied from that input."""
    mut output: list[ValueField] = []
    declared = array(property_value(description, "fields")?, "items")?
    for item in array(record, "fields")?:
        identity = text(item, "id")?
        mut found = false
        for member in declared:
            if text(property_value(member, "id")?, "hex")? == identity:
                flag = field(property_value(member, "canonical")?, "value")?
                canonical = flag.expect_bool().map_err((e) => e.message())?
                absent = absence(text(property_value(member, "absent")?, "value")?)?
                output.append(
                    ValueField(
                        identity=hex_bytes(identity)?,
                        canonical=canonical,
                        absent=absent,
                        value=row_value(field(item, "value")?, descriptions)?,
                    ),
                )
                found = true
        if not found:
            return Err("missing writer input field")
    return Ok(output)


def row_value(value: JsonValue, descriptions: list[JsonValue]) -> Result[Value, str]:
    """Translate nested logical input notation without decoding any expected physical bytes."""
    kind = text(value, "kind")?
    match kind:
        "record" | "enum" => return record_value(value, descriptions)
        "some" => return Ok(Value.Some([row_value(field(value, "value")?, descriptions)?]))
        "list" => return Ok(Value.List(row_items(array(value, "items")?, descriptions)?))
        "tuple" => return Ok(Value.Tuple(row_items(array(value, "items")?, descriptions)?))
        "set" => return Ok(Value.Set(row_items(array(value, "items")?, descriptions)?))
        "map" =>
            mut entries: list[MapEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((e) => e.message())?
                if len(pair) != 2:
                    return Err("writer map pair")
                entries.append(MapEntry(key=row_value(pair[0], descriptions)?, value=row_value(pair[1], descriptions)?))
            return Ok(Value.Map(entries))
        "union" =>
            return Ok(
                Value.Union(
                    selector_text(text(value, "member_type")?)?,
                    [row_value(field(value, "value")?, descriptions)?],
                ),
            )
        _ => return logical(value)


def row_items(items: list[JsonValue], descriptions: list[JsonValue]) -> Result[list[Value], str]:
    """Preserve the independent input sequence; production code owns its physical ordering rules."""
    mut values: list[Value] = []
    for item in items:
        values.append(row_value(item, descriptions)?)
    return Ok(values)
