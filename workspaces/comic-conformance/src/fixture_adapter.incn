"""Translate independently written corpus fixtures to the one logical Crumb value model."""

from std.json import JsonValue
from std.primitives.crumb.values import Value, ValueField, MapEntry, Metadata, MetadataEntry
from std.primitives.crumb.text_types import TextDescription
from std.primitives.crumb.types import FieldShape, NominalKind, ScalarKind, TypeNode
from std.primitives.hex import hexlify
from std.primitives.text import encode_utf8
from case_data import (
    FixtureMetadataKind,
    FixturePropertyKind,
    FixtureValueKind,
    array,
    field,
    fields,
    hex_bytes,
    nodes,
    text,
    absence,
    selector_text,
)


pub def integer(value: JsonValue, key: str) -> Result[int, str]:
    """Small notation parameters use checked JSON integers; stored arbitrary integers stay strings."""
    return field(value, key)?.expect_int().map_err((error) => error.message())


pub def logical(value: JsonValue) -> Result[Value, str]:
    """Preserve explicit absence, exact bits and original collection order before production admission."""
    # A local retains match-capture ownership until direct call matching is fixed (#2800).
    kind = value_kind(value)?
    match kind:
        FixtureValueKind.NoneValue => return Ok(Value.NoneValue)
        FixtureValueKind.Some => return Ok(Value.Some([logical(field(value, "value")?)?]))
        FixtureValueKind.Boolean =>
            return Ok(Value.Boolean(field(value, "value")?.expect_bool().map_err((error) => error.message())?))
        FixtureValueKind.Integer => return Ok(Value.Integer(text(value, "value")?))
        FixtureValueKind.Float => return Ok(Value.Float(integer(value, "width")?, hex_bytes(text(value, "bits")?)?))
        FixtureValueKind.Decimal => return Ok(Value.Decimal(text(value, "coefficient")?, str(integer(value, "scale")?)))
        FixtureValueKind.String => return Ok(Value.Text(text(value, "value")?))
        FixtureValueKind.Binary => return Ok(Value.Binary(hex_bytes(text(value, "hex")?)?))
        FixtureValueKind.Withheld => return Ok(Value.Withheld)
        FixtureValueKind.List => return Ok(Value.List(logical_items(array(value, "items")?)?))
        FixtureValueKind.Tuple => return Ok(Value.Tuple(logical_items(array(value, "items")?)?))
        FixtureValueKind.Set => return Ok(Value.Set(logical_items(array(value, "items")?)?))
        FixtureValueKind.Map =>
            mut entries: list[MapEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((error) => error.message())?
                if len(pair) != 2:
                    return Err("map entry must have two items")
                entries.append(MapEntry(key=logical(pair[0])?, value=logical(pair[1])?))
            return Ok(Value.Map(entries))
        FixtureValueKind.Record =>
            mut result: list[ValueField] = []
            for item in array(value, "fields")?:
                identity = hex_bytes(text(item, "id")?)?
                canonical = field(item, "canonical")?.expect_bool().map_err((error) => error.message())?
                result.append(
                    ValueField(
                        identity=identity,
                        canonical=canonical,
                        absent=absence(text(item, "absent")?)?,
                        value=logical(field(item, "value")?)?,
                    ),
                )
            return Ok(Value.Record(result))
        FixtureValueKind.Enum =>
            identity = hex_bytes(text(value, "variant_id")?)?
            match logical(field(value, "payload")?)?:
                Value.Record(payload) => return Ok(Value.Enum(identity, payload))
                _ => return Err("enum corpus payload must be a record")
        FixtureValueKind.Union =>
            return Ok(Value.Union(member(field(value, "member_type")?)?, [logical(field(value, "value")?)?]))
        FixtureValueKind.Reference =>
            # observed_target is deliberately not an input to the reference contribution.
            return Ok(Value.Reference(opaque(value, "target_type")?, opaque(value, "identity")?))


pub def logical_items(items: list[JsonValue]) -> Result[list[Value], str]:
    """Translate each item without sorting or merging distinct original entries."""
    mut values: list[Value] = []
    for item in items:
        values.append(logical(item)?)
    return Ok(values)


def opaque(value: JsonValue, key: str) -> Result[bytes, str]:
    """Use exact identity bytes when present; textual labels in older vectors are opaque UTF-8."""
    if let Some(encoded) = value.get(key + "_hex"):
        return hex_bytes(encoded.expect_str().map_err((error) => error.message())?)
    return Ok(encode_utf8(text(value, key)?))


def member(value: JsonValue) -> Result[TypeNode, str]:
    """Closed nominal discriminators retain arguments, independently of payload structural shape."""
    kind = match NominalKind.from_value(text(value, "kind")?):
        Some(selected) => selected
        None => return Err("unknown fixture nominal kind")

    mut arguments: list[TypeNode] = []
    if let Some(items) = value.get("arguments"):
        arguments = nodes(items.expect_array().map_err((error) => error.message())?)?
    return Ok(TypeNode.Nominal(kind, "", Some(hex_bytes(text(value, "nominal_hex")?)?), arguments))


pub def metadata(value: JsonValue) -> Result[Metadata, str]:
    """Preserve the complete tagged metadata tree, including uninterpreted property entries."""
    # A local retains match-capture ownership until direct call matching is fixed (#2800).
    kind = metadata_kind(value)?
    match kind:
        FixtureMetadataKind.Null => return Ok(Metadata.Null)
        FixtureMetadataKind.Boolean =>
            return Ok(Metadata.Boolean(field(value, "value")?.expect_bool().map_err((error) => error.message())?))
        FixtureMetadataKind.Integer => return Ok(Metadata.Integer(text(value, "value")?))
        FixtureMetadataKind.String => return Ok(Metadata.Text(text(value, "value")?))
        FixtureMetadataKind.Binary => return Ok(Metadata.Binary(hex_bytes(text(value, "hex")?)?))
        FixtureMetadataKind.Symbol => return Ok(Metadata.Symbol(text(value, "name")?))
        FixtureMetadataKind.List =>
            mut items: list[Metadata] = []
            for item in array(value, "items")?:
                items.append(metadata(item)?)
            return Ok(Metadata.List(items))
        FixtureMetadataKind.Map =>
            mut entries: list[MetadataEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((error) => error.message())?
                if len(pair) != 2 or metadata_kind(pair[0])? != FixtureMetadataKind.String:
                    return Err("metadata map requires string keys and pairs")
                entries.append(MetadataEntry(key=text(pair[0], "value")?, value=metadata(pair[1])?))
            return Ok(Metadata.Map(entries))


def value_kind(value: JsonValue) -> Result[FixtureValueKind, str]:
    """Parse a logical fixture tag once before translating its payload."""
    match FixtureValueKind.from_value(text(value, "kind")?):
        Some(kind) => return Ok(kind)
        None => return Err("unsupported logical notation")


def metadata_kind(value: JsonValue) -> Result[FixtureMetadataKind, str]:
    """Parse a metadata fixture tag once before translating its payload."""
    match FixtureMetadataKind.from_value(text(value, "kind")?):
        Some(kind) => return Ok(kind)
        None => return Err("unsupported metadata notation")


pub def metadata_notation(value: Metadata) -> JsonValue:
    """Translate decoded metadata back to the independent fixture notation without discarding properties."""
    mut result: dict[str, JsonValue] = {}
    match value:
        Metadata.Null => result["kind"] = JsonValue.string(FixtureMetadataKind.Null.value())
        Metadata.Boolean(item) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.Boolean.value())
            result["value"] = JsonValue.bool(item)
        Metadata.Integer(item) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.Integer.value())
            result["value"] = JsonValue.string(item)
        Metadata.Text(item) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.String.value())
            result["value"] = JsonValue.string(item)
        Metadata.Binary(item) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.Binary.value())
            result["hex"] = JsonValue.string(hexlify(item))
        Metadata.Symbol(item) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.Symbol.value())
            result["name"] = JsonValue.string(item)
        Metadata.List(items) =>
            result["kind"] = JsonValue.string(FixtureMetadataKind.List.value())
            result["items"] = JsonValue.array([metadata_notation(item) for item in items])
        Metadata.Map(entries) =>
            mut items: list[JsonValue] = []
            for entry in entries:
                key = metadata_notation(Metadata.Text(entry.key))
                items.append(JsonValue.array([key, metadata_notation(entry.value)]))
            result["kind"] = JsonValue.string(FixtureMetadataKind.Map.value())
            result["entries"] = JsonValue.array(items)
    return JsonValue.object(result)


pub def record(shape: JsonValue, items: list[JsonValue]) -> Result[Value, str]:
    """Attach the declared field facts to actual adaptation outputs, not expected output values."""
    declared = fields(shape)?
    if len(declared) != len(items):
        return Err("record field/value arity")
    mut result: list[ValueField] = []
    for index in range(len(items)):
        result.append(
            ValueField(
                identity=declared[index].identity,
                canonical=declared[index].canonical,
                absent=declared[index].absent,
                value=logical(items[index])?,
            ),
        )
    return Ok(Value.Record(result))


def property_value(description: JsonValue, name: str) -> Result[JsonValue, str]:
    """Read independent tagged metadata notation without invoking production description admission."""
    for item in array(description, "entries")?:
        pair = item.expect_array().map_err((error) => error.message())?
        if len(pair) != 2:
            return Err("invalid writer metadata pair")
        if text(pair[0], "value")? == name:
            return Ok(pair[1])
    return Err("missing writer metadata property: " + name)


def find_description(key: str, descriptions: list[JsonValue]) -> Result[JsonValue, str]:
    """Use caller-supplied selector labels for nested inputs, never a computed model hash."""
    for description in descriptions:
        if text(property_value(description, "nominal")?, "hex")? == key:
            return Ok(description)
    return Err("missing writer input description")


pub def record_value(record: JsonValue, descriptions: list[JsonValue]) -> Result[Value, str]:
    """Attach explicitly authored field facts to stored values without normalizing a model."""
    description = find_description(text(record, "selector_hex")?, descriptions)?
    if let Some(tag) = record.get("variant_id"):
        identity = tag.expect_str().map_err((error) => error.message())?
        for variant in array(property_value(description, "variants")?, "items")?:
            if text(property_value(variant, "id")?, "hex")? == identity:
                return Ok(Value.Enum(hex_bytes(identity)?, record_fields(record, variant, descriptions)?))
        return Err("missing writer input variant")
    return Ok(Value.Record(record_fields(record, description, descriptions)?))


def record_fields(
    record: JsonValue,
    description: JsonValue,
    descriptions: list[JsonValue],
) -> Result[list[ValueField], str]:
    """Copy field identity, canonical, and absence facts from independent description fixtures."""
    mut output: list[ValueField] = []
    declared = array(property_value(description, "fields")?, "items")?
    for item in array(record, "fields")?:
        identity = text(item, "id")?
        mut found = false
        for member in declared:
            if text(property_value(member, "id")?, "hex")? == identity:
                canonical = field(property_value(member, "canonical")?, "value")?.expect_bool().map_err(
                    (error) => error.message(),
                )?
                absent = absence(text(property_value(member, "absent")?, "value")?)?
                output.append(
                    ValueField(
                        identity=hex_bytes(identity)?,
                        canonical=canonical,
                        absent=absent,
                        value=fixture_value(field(item, "value")?, descriptions)?,
                    ),
                )
                found = true
        if not found:
            return Err("missing writer input field")
    return Ok(output)


pub def fixture_value(value: JsonValue, descriptions: list[JsonValue]) -> Result[Value, str]:
    """Translate a fixture value, resolving identity-bearing record and enum forms through supplied descriptions."""
    kind = value_kind(value)?
    match kind:
        FixtureValueKind.Record | FixtureValueKind.Enum => return record_value(value, descriptions)
        FixtureValueKind.Some => return Ok(Value.Some([fixture_value(field(value, "value")?, descriptions)?]))
        FixtureValueKind.List => return Ok(Value.List(fixture_values(array(value, "items")?, descriptions)?))
        FixtureValueKind.Tuple => return Ok(Value.Tuple(fixture_values(array(value, "items")?, descriptions)?))
        FixtureValueKind.Set => return Ok(Value.Set(fixture_values(array(value, "items")?, descriptions)?))
        FixtureValueKind.Map =>
            mut entries: list[MapEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((error) => error.message())?
                if len(pair) != 2:
                    return Err("writer map pair")
                entries.append(
                    MapEntry(key=fixture_value(pair[0], descriptions)?, value=fixture_value(pair[1], descriptions)?),
                )
            return Ok(Value.Map(entries))
        FixtureValueKind.Union =>
            return Ok(
                Value.Union(
                    selector_text(text(value, "member_type")?)?,
                    [fixture_value(field(value, "value")?, descriptions)?],
                ),
            )
        _ => return logical(value)


def fixture_values(items: list[JsonValue], descriptions: list[JsonValue]) -> Result[list[Value], str]:
    """Preserve fixture sequence order while resolving nested nominal values."""
    mut values: list[Value] = []
    for item in items:
        values.append(fixture_value(item, descriptions)?)
    return Ok(values)


pub def text_property_value(value: JsonValue) -> Result[Metadata, str]:
    """Translate one text property fixture into the shared metadata domain."""
    kind = match FixturePropertyKind.from_value(text(value, "kind")?):
        Some(selected) => selected
        None => return Err("unknown corpus property value")

    match kind:
        FixturePropertyKind.Symbol => return Ok(Metadata.Symbol(text(value, "name")?))
        FixturePropertyKind.String => return Ok(Metadata.Text(text(value, "value")?))
        FixturePropertyKind.Boolean =>
            flag = field(value, "value")?.expect_bool().map_err((error) => error.message())?
            return Ok(Metadata.Boolean(flag))
        FixturePropertyKind.Integer => return Ok(Metadata.Integer(text(value, "value")?))
        FixturePropertyKind.Null => return Ok(Metadata.Null)
        FixturePropertyKind.Binary => return Ok(Metadata.Binary(hex_bytes(text(value, "hex")?)?))
        FixturePropertyKind.List =>
            mut items: list[Metadata] = []
            for item in array(value, "items")?:
                items.append(text_property_value(item)?)
            return Ok(Metadata.List(items))
        FixturePropertyKind.PropertyGroup =>
            mut properties: list[MetadataEntry] = []
            for item in array(value, "properties")?:
                properties.append(
                    MetadataEntry(key=text(item, "name")?, value=text_property_value(field(item, "value")?)?),
                )
            return Ok(Metadata.Map(properties))


pub def text_value(value: JsonValue, descriptions: list[TextDescription]) -> Result[Value, str]:
    """Translate one fully tagged text fixture into the shared logical value domain."""
    kind = match FixtureValueKind.from_value(text(value, "kind")?):
        Some(selected) => selected
        None => return Err("unknown corpus text value")

    match kind:
        FixtureValueKind.NoneValue => return Ok(Value.NoneValue)
        FixtureValueKind.Some => return Ok(Value.Some([text_value(field(value, "value")?, descriptions)?]))
        FixtureValueKind.Boolean =>
            flag = field(value, "value")?.expect_bool().map_err((error) => error.message())?
            return Ok(Value.Boolean(flag))
        FixtureValueKind.Integer => return Ok(Value.Integer(text(value, "value")?))
        FixtureValueKind.Float => return text_float(value)
        FixtureValueKind.Decimal =>
            scale = field(value, "scale")?.expect_int().map_err((error) => error.message())?
            return Ok(Value.Decimal(text(value, "coefficient")?, str(scale)))
        FixtureValueKind.String => return Ok(Value.Text(text(value, "value")?))
        FixtureValueKind.Binary => return Ok(Value.Binary(hex_bytes(text(value, "hex")?)?))
        FixtureValueKind.Withheld => return Ok(Value.Withheld)
        FixtureValueKind.List => return Ok(Value.List(text_values(array(value, "items")?, descriptions)?))
        FixtureValueKind.Set => return Ok(Value.Set(text_values(array(value, "items")?, descriptions)?))
        FixtureValueKind.Map => return text_map(value, descriptions)
        FixtureValueKind.Record => return text_record(value, descriptions)
        FixtureValueKind.Enum => return text_enum(value, descriptions)
        FixtureValueKind.Union =>
            member = text_member_type(text(value, "member")?, descriptions)?
            item = text_value(field(value, "value")?, descriptions)?
            return Ok(Value.Union(member, [item]))
        FixtureValueKind.Reference =>
            target = text_description_at(descriptions, text(value, "target_type")?)?
            target_identity = match target.identity:
                Some(identity) => identity
                None => b""

            return Ok(Value.Reference(target_identity, encode_utf8(text(value, "identity")?)))
        FixtureValueKind.Tuple => return Err("tuple is not a COMIC text value")


def text_member_type(name: str, descriptions: list[TextDescription]) -> Result[TypeNode, str]:
    """Resolve a corpus union member through the same scalar and document type domains as COMIC text."""
    if let Some(kind) = ScalarKind.from_value(name):
        return Ok(TypeNode.Scalar(kind))
    return Ok(description_type(text_description_at(descriptions, name)?))


pub def text_values(values: list[JsonValue], descriptions: list[TextDescription]) -> Result[list[Value], str]:
    """Translate an ordered text-value sequence without host collection coercion."""
    mut result: list[Value] = []
    for value in values:
        result.append(text_value(value, descriptions)?)
    return Ok(result)


def text_float(value: JsonValue) -> Result[Value, str]:
    """Retain exact IEEE bytes without deriving expected spelling in the adapter."""
    width = field(value, "width")?.expect_int().map_err((error) => error.message())?
    return Ok(Value.Float(width, hex_bytes(text(value, "bits")?)?))


def text_map(value: JsonValue, descriptions: list[TextDescription]) -> Result[Value, str]:
    """Translate explicit text map pairs without JSON object key semantics."""
    mut entries: list[MapEntry] = []
    for item in array(value, "entries")?:
        pair = item.expect_array().map_err((error) => error.message())?
        if len(pair) != 2:
            return Err("corpus map entry arity")
        entries.append(MapEntry(key=text_value(pair[0], descriptions)?, value=text_value(pair[1], descriptions)?))
    return Ok(Value.Map(entries))


def text_record(value: JsonValue, descriptions: list[TextDescription]) -> Result[Value, str]:
    """Order a text record fixture's object fields by its independent description."""
    storage_type = text(value, "type")?
    description = text_description_at(descriptions, storage_type)?
    source = field(value, "fields")?
    mut values: list[ValueField] = []
    for declared in description.fields:
        values.append(text_field(declared, text_value(field(source, declared.name)?, descriptions)?))
    return Ok(Value.Record(values))


def text_enum(value: JsonValue, descriptions: list[TextDescription]) -> Result[Value, str]:
    """Order a text enum fixture's payload fields by its declared variant."""
    storage_type = text(value, "type")?
    variant_name = text(value, "variant")?
    description = text_description_at(descriptions, storage_type)?
    source = field(value, "fields")?
    mut values: list[ValueField] = []
    for variant in description.variants:
        if variant.name == variant_name:
            for declared in variant.fields:
                item = text_value(field(source, declared.name)?, descriptions)?
                values.append(text_field(declared, item))
            return Ok(Value.Enum(variant.identity, values))
    return Err("unknown corpus enum variant")


def text_field(field_shape: FieldShape, value: Value) -> ValueField:
    """Attach independent fixture data to the description's identity-bearing field facts."""
    return ValueField(
        identity=field_shape.identity,
        canonical=field_shape.canonical,
        absent=field_shape.absent,
        value=value,
    )


def description_type(description: TextDescription) -> TypeNode:
    """Project a fixture description to the same nominal node used by production text APIs."""
    return TypeNode.Nominal(description.shape, description.path, description.identity, [])


def text_description_at(descriptions: list[TextDescription], path: str) -> Result[TextDescription, str]:
    """Find exactly one value-bearing text description by absolute path."""
    mut found: list[TextDescription] = []
    for description in descriptions:
        if description.path == path:
            found.append(description)
    if len(found) != 1:
        return Err("corpus value type has no single description")
    return Ok(found[0])
