"""Translate independent test notation to explicit primitive inputs, without deriving expectations."""

from std.json import JsonValue
from std.encoding.hex import unhexlify
from std.primitives.crumb.types import (
    AbsentPolicy,
    ContainerKind,
    FieldShape,
    NominalKind,
    ScalarKind,
    TypeNode,
    VariantShape,
)


pub enum CaseOperation(str):
    """Every operation admitted from the pinned corpus manifest, including operations implemented later in the stack."""

    MemberIdentity = "member_identity"
    NominalIdentity = "nominal_identity"
    TypeSelector = "type_selector"
    ShapeAdmission = "shape_admission"
    Adaptation = "adaptation"
    HashPreimage = "hash_preimage"
    ValueRelation = "value_relation"
    BinaryDecode = "binary_decode"
    TextRead = "text_read"
    TextPrint = "text_print"
    ColumnCodec = "column_codec"
    ColumnBlock = "column_block"
    ColumnData = "column_data"
    ColumnDictionary = "column_dictionary"


pub enum ExpectedStatus(str):
    """The corpus contract's closed accepted/refused outcome vocabulary."""

    Accepted = "accepted"
    Refused = "refused"


pub enum CaseStatus(str):
    """Per-case execution states emitted by the conformance runner."""

    Passed = "passed"
    Failed = "failed"
    Unsupported = "unsupported"


pub enum ReceiptStatus(str):
    """Aggregate execution states emitted after all selected cases finish."""

    Passed = "passed"
    Failed = "failed"
    Incomplete = "incomplete"


pub enum CaseTransform(str):
    """Closed corpus transformations applied before a codec invocation."""

    AllProperPrefixes = "all_proper_prefixes"


pub enum HashExpectation(str):
    """Closed digest relations authored independently in the corpus."""

    Same = "same"
    Changed = "changed"
    Distinct = "distinct"


pub enum HashKind(str):
    """Closed hash domains selected by hash-preimage fixtures."""

    Object = "object"
    Canonical = "canonical"
    Model = "model"
    Description = "description"
    Seal = "seal"


pub enum FixtureValueKind(str):
    """The tagged logical-value forms admitted from corpus JSON."""

    NoneValue = "none"
    Some = "some"
    Boolean = "boolean"
    Integer = "int"
    Float = "float"
    Decimal = "decimal"
    String = "string"
    Binary = "binary"
    Withheld = "withheld"
    List = "list"
    Tuple = "tuple"
    Set = "set"
    Map = "map"
    Record = "record"
    Enum = "enum"
    Union = "union"
    Reference = "reference"


pub enum FixtureMetadataKind(str):
    """The tagged metadata forms admitted from corpus JSON."""

    Null = "null"
    Boolean = "boolean"
    Integer = "int"
    String = "string"
    Binary = "binary"
    Symbol = "symbol"
    List = "list"
    Map = "map"


pub enum FixtureTypeKind(str):
    """The structured type-node forms admitted from corpus JSON."""

    Record = "record"
    Enum = "enum"
    Recursive = "recur"


pub enum FixtureNominalShape(str):
    """The uppercase nominal-shape spelling used by independent text fixtures."""

    Record = "Record"
    Enum = "Enum"

    pub def nominal_kind(self) -> NominalKind:
        """Convert fixture notation to the shared logical shape."""
        match self:
            FixtureNominalShape.Record => return NominalKind.Record
            FixtureNominalShape.Enum => return NominalKind.Enum


pub enum FixturePropertyKind(str):
    """The tagged property-value forms admitted by COMIC text fixtures."""

    Symbol = "symbol"
    String = "string"
    Boolean = "boolean"
    Integer = "int"
    Null = "null"
    Binary = "binary"
    List = "list"
    PropertyGroup = "property_group"


pub enum FixtureScalarAlias(str):
    """Legacy scalar spellings retained by independently pinned negative vectors."""

    F64 = "f64"

    pub def scalar_kind(self) -> ScalarKind:
        """Map a fixture-only spelling to the shared scalar vocabulary."""
        match self:
            FixtureScalarAlias.F64 => return ScalarKind.Fp64


pub def text(value: JsonValue, key: str) -> Result[str, str]:
    """Require one string; numeric expectations remain exact strings rather than JSON numbers."""
    return value.require(key).and_then((item) => item.expect_str()).map_err((error) => error.message())


pub def expected_status(value: JsonValue) -> Result[ExpectedStatus, str]:
    """Parse one expected outcome at the corpus boundary so checkers never dispatch on raw status text."""
    match ExpectedStatus.from_value(text(value, "status")?):
        Some(status) => return Ok(status)
        None => return Err("unknown expected status")


pub def field(value: JsonValue, key: str) -> Result[JsonValue, str]:
    """Require a named case input without inventing a default for missing test data."""
    return value.require(key).map_err((error) => error.message())


pub def array(value: JsonValue, key: str) -> Result[list[JsonValue], str]:
    """Require the corpus's declared sequence order."""
    return field(value, key)?.expect_array().map_err((error) => error.message())


pub def hex_bytes(value: str) -> Result[bytes, str]:
    """Decode literal test octets through the existing strict standard hex decoder."""
    return unhexlify(value).map_err((error) => error.message())


pub def fields(value: JsonValue) -> Result[list[FieldShape], str]:
    """Translate stored field facts without sorting or repairing their identities."""
    mut result: list[FieldShape] = []
    for item in array(value, "fields")?:
        identity = hex_bytes(text(item, "id")?)?
        storage_type = node(field(item, "type")?)?
        canonical = field(item, "canonical")?.expect_bool().map_err((error) => error.message())?
        absent = absence(text(item, "absent")?)?
        result.append(
            FieldShape(
                identity=identity,
                storage_type=storage_type,
                canonical=canonical,
                absent=absent,
                name="",
                renamed_from=[],
            ),
        )
    return Ok(result)


pub def absence(name: str) -> Result[AbsentPolicy, str]:
    """No test-side constructor default repairs an omitted field."""
    match AbsentPolicy.from_value(name):
        Some(policy) => return Ok(policy)
        None => return Err("unknown corpus absence policy")


pub def node(value: JsonValue) -> Result[TypeNode, str]:
    """Decode the corpus's scalar/container nodes; unsupported notation is an explicit test error."""
    if value.is_str():
        return selector_text(value.expect_str().map_err((error) => error.message())?)
    kind = text(value, "kind")?
    match ContainerKind.from_value(kind):
        Some(container) =>
            match container:
                ContainerKind.Option | ContainerKind.List | ContainerKind.Set =>
                    return Ok(TypeNode.Container(container, [node(field(value, "item")?)?]))
                ContainerKind.Map =>
                    key = node(field(value, "key_type")?)?
                    item = node(field(value, "value_type")?)?
                    return Ok(TypeNode.Container(container, [key, item]))
                ContainerKind.Tuple | ContainerKind.Union =>
                    return Ok(TypeNode.Container(container, nodes(array(value, "items")?)?))
        None => pass
    match FixtureTypeKind.from_value(kind):
        Some(FixtureTypeKind.Record) => return Ok(TypeNode.Record(text(value, "key")?, fields(value)?))
        Some(FixtureTypeKind.Enum) =>
            mut variants: list[VariantShape] = []
            for variant in array(value, "variants")?:
                variants.append(
                    VariantShape(
                        identity=hex_bytes(text(variant, "id")?)?,
                        fields=fields(variant)?,
                        name="",
                        renamed_from=[],
                    ),
                )
            return Ok(TypeNode.Enum(text(value, "key")?, variants))
        Some(FixtureTypeKind.Recursive) => return Ok(TypeNode.Recursive(text(value, "key")?))
        None => return Err("unsupported corpus type notation: " + kind)


pub def nodes(values: list[JsonValue]) -> Result[list[TypeNode], str]:
    """Preserve generic argument and container element order exactly."""
    mut result: list[TypeNode] = []
    for value in values:
        result.append(node(value)?)
    return Ok(result)


pub def selector_text(spelling: str) -> Result[TypeNode, str]:
    """Decode the corpus's nominal selector strings; production receives typed nodes instead."""
    if spelling.startswith("decimal<") and spelling.endswith(">"):
        parts = spelling[8:len(spelling) - 1].split(",")
        if len(parts) != 2:
            return Err("decimal corpus parameters")
        return Ok(TypeNode.Decimal(int(parts[0]), int(parts[1])))
    mut prefix = 0
    mut kind = NominalKind.Record
    if spelling.startswith("record@"):
        prefix = 7
    elif spelling.startswith("enum@"):
        prefix = 5
        kind = NominalKind.Enum
    else:
        match ScalarKind.from_value(spelling):
            Some(scalar) => return Ok(TypeNode.Scalar(scalar))
            None => return Err("unknown scalar in corpus")

    if len(spelling) < prefix + 12:
        return Err("short nominal selector in corpus")
    identity = hex_bytes(spelling[prefix:prefix + 12])?
    tail = spelling[prefix + 12:]
    mut arguments: list[TypeNode] = []
    if tail != "":
        if not tail.startswith("<") or not tail.endswith(">"):
            return Err("malformed corpus selector arguments")
        for part in split_arguments(tail[1:len(tail) - 1])?:
            arguments.append(selector_text(part)?)
    return Ok(TypeNode.Nominal(kind, "", Some(identity), arguments))


def split_arguments(contents: str) -> Result[list[str], str]:
    """Split only top-level commas; nested closed selectors keep their complete argument text."""
    mut depth = 0
    mut part = ""
    mut parts: list[str] = []
    for character in contents:
        if character == "<":
            depth += 1
        elif character == ">":
            depth -= 1
            if depth < 0:
                return Err("unbalanced corpus selector")
        if character == "," and depth == 0:
            if part == "":
                return Err("empty corpus selector argument")
            parts.append(part)
            part = ""
        else:
            part += character
    if depth != 0 or part == "":
        return Err("unbalanced or empty corpus selector")
    parts.append(part)
    return Ok(parts)
