"""Translate independently written logical corpus inputs; no expected contribution bytes enter production."""

from std.json import JsonValue
from std.primitives.crumb.values import Value, ValueField, MapEntry, Metadata, MetadataEntry
from std.primitives.crumb.types import NominalKind, TypeNode
from std.primitives.text import encode_utf8
from case_data import FixtureMetadataKind, FixtureValueKind, array, field, fields, hex_bytes, nodes, text, absence


pub def integer(value: JsonValue, key: str) -> Result[int, str]:
    """Small notation parameters use checked JSON integers; stored arbitrary integers stay strings."""
    return field(value, key)?.expect_int().map_err((error) => error.message())


pub def logical(value: JsonValue) -> Result[Value, str]:
    """Preserve explicit absence, exact bits and original collection order before production admission."""
    # A local retains match-capture ownership until direct call matching is fixed (#2800).
    kind = value_kind(value)?
    match kind:
        FixtureValueKind.NoneValue => return Ok(Value.NoneValue)
        FixtureValueKind.Some => return Ok(Value.Some([logical(field(value, "value")?)?]))
        FixtureValueKind.Boolean =>
            return Ok(Value.Boolean(field(value, "value")?.expect_bool().map_err((error) => error.message())?))
        FixtureValueKind.Integer => return Ok(Value.Integer(text(value, "value")?))
        FixtureValueKind.Float => return Ok(Value.Float(integer(value, "width")?, hex_bytes(text(value, "bits")?)?))
        FixtureValueKind.Decimal => return Ok(Value.Decimal(text(value, "coefficient")?, str(integer(value, "scale")?)))
        FixtureValueKind.String => return Ok(Value.Text(text(value, "value")?))
        FixtureValueKind.Binary => return Ok(Value.Binary(hex_bytes(text(value, "hex")?)?))
        FixtureValueKind.Withheld => return Ok(Value.Withheld)
        FixtureValueKind.List => return Ok(Value.List(logical_items(array(value, "items")?)?))
        FixtureValueKind.Tuple => return Ok(Value.Tuple(logical_items(array(value, "items")?)?))
        FixtureValueKind.Set => return Ok(Value.Set(logical_items(array(value, "items")?)?))
        FixtureValueKind.Map =>
            mut entries: list[MapEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((error) => error.message())?
                if len(pair) != 2:
                    return Err("map entry must have two items")
                entries.append(MapEntry(key=logical(pair[0])?, value=logical(pair[1])?))
            return Ok(Value.Map(entries))
        FixtureValueKind.Record =>
            mut result: list[ValueField] = []
            for item in array(value, "fields")?:
                identity = hex_bytes(text(item, "id")?)?
                canonical = field(item, "canonical")?.expect_bool().map_err((error) => error.message())?
                result.append(
                    ValueField(
                        identity=identity,
                        canonical=canonical,
                        absent=absence(text(item, "absent")?)?,
                        value=logical(field(item, "value")?)?,
                    ),
                )
            return Ok(Value.Record(result))
        FixtureValueKind.Enum =>
            identity = hex_bytes(text(value, "variant_id")?)?
            match logical(field(value, "payload")?)?:
                Value.Record(payload) => return Ok(Value.Enum(identity, payload))
                _ => return Err("enum corpus payload must be a record")
        FixtureValueKind.Union =>
            return Ok(Value.Union(member(field(value, "member_type")?)?, [logical(field(value, "value")?)?]))
        FixtureValueKind.Reference =>
            # observed_target is deliberately not an input to the reference contribution.
            return Ok(Value.Reference(opaque(value, "target_type")?, opaque(value, "identity")?))


pub def logical_items(items: list[JsonValue]) -> Result[list[Value], str]:
    """Translate each item without sorting or merging distinct original entries."""
    mut values: list[Value] = []
    for item in items:
        values.append(logical(item)?)
    return Ok(values)


def opaque(value: JsonValue, key: str) -> Result[bytes, str]:
    """Use exact identity bytes when present; textual labels in older vectors are opaque UTF-8."""
    if let Some(encoded) = value.get(key + "_hex"):
        return hex_bytes(encoded.expect_str().map_err((error) => error.message())?)
    return Ok(encode_utf8(text(value, key)?))


def member(value: JsonValue) -> Result[TypeNode, str]:
    """Closed nominal discriminators retain arguments, independently of payload structural shape."""
    kind = match NominalKind.from_value(text(value, "kind")?):
        Some(selected) => selected
        None => return Err("unknown fixture nominal kind")

    mut arguments: list[TypeNode] = []
    if let Some(items) = value.get("arguments"):
        arguments = nodes(items.expect_array().map_err((error) => error.message())?)?
    return Ok(TypeNode.Nominal(kind, hex_bytes(text(value, "nominal_hex")?)?, arguments))


pub def metadata(value: JsonValue) -> Result[Metadata, str]:
    """Preserve the complete tagged metadata tree, including uninterpreted property entries."""
    # A local retains match-capture ownership until direct call matching is fixed (#2800).
    kind = metadata_kind(value)?
    match kind:
        FixtureMetadataKind.Null => return Ok(Metadata.Null)
        FixtureMetadataKind.Boolean =>
            return Ok(Metadata.Boolean(field(value, "value")?.expect_bool().map_err((error) => error.message())?))
        FixtureMetadataKind.Integer => return Ok(Metadata.Integer(text(value, "value")?))
        FixtureMetadataKind.String => return Ok(Metadata.Text(text(value, "value")?))
        FixtureMetadataKind.Binary => return Ok(Metadata.Binary(hex_bytes(text(value, "hex")?)?))
        FixtureMetadataKind.List =>
            mut items: list[Metadata] = []
            for item in array(value, "items")?:
                items.append(metadata(item)?)
            return Ok(Metadata.List(items))
        FixtureMetadataKind.Map =>
            mut entries: list[MetadataEntry] = []
            for item in array(value, "entries")?:
                pair = item.expect_array().map_err((error) => error.message())?
                if len(pair) != 2 or metadata_kind(pair[0])? != FixtureMetadataKind.String:
                    return Err("metadata map requires string keys and pairs")
                entries.append(MetadataEntry(key=text(pair[0], "value")?, value=metadata(pair[1])?))
            return Ok(Metadata.Map(entries))


def value_kind(value: JsonValue) -> Result[FixtureValueKind, str]:
    """Parse a logical fixture tag once before translating its payload."""
    match FixtureValueKind.from_value(text(value, "kind")?):
        Some(kind) => return Ok(kind)
        None => return Err("unsupported logical notation")


def metadata_kind(value: JsonValue) -> Result[FixtureMetadataKind, str]:
    """Parse a metadata fixture tag once before translating its payload."""
    match FixtureMetadataKind.from_value(text(value, "kind")?):
        Some(kind) => return Ok(kind)
        None => return Err("unsupported metadata notation")


pub def record(shape: JsonValue, items: list[JsonValue]) -> Result[Value, str]:
    """Attach the declared field facts to actual adaptation outputs, not expected output values."""
    declared = fields(shape)?
    if len(declared) != len(items):
        return Err("record field/value arity")
    mut result: list[ValueField] = []
    for index in range(len(items)):
        result.append(
            ValueField(
                identity=declared[index].identity,
                canonical=declared[index].canonical,
                absent=declared[index].absent,
                value=logical(items[index])?,
            ),
        )
    return Ok(Value.Record(result))
