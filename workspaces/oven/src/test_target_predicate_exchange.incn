"""Canonical target-selection exchange contracts before wiring test dependency admission."""

from std.json import JsonValue
from std.hash import sha256
from std.encoding.hex import hexlify
from target_predicate_exchange import evaluate
from core_engine import evaluate as dispatch


def request(conditions: list[str], snapshot: bool = true, windows: bool = false) -> Result[str, str]:
    """Keep target configuration explicit, including absence of a complete cfg snapshot."""
    mut cfg = JsonValue.null()
    mut triple = "aarch64-apple-darwin"
    if windows:
        triple = "x86_64-pc-windows-msvc"
    if snapshot:
        mut flags = [JsonValue.string("unix")]
        mut os = "macos"
        if windows:
            flags = [JsonValue.string("windows")]
            os = "windows"
        cfg = JsonValue.object({"flags": JsonValue.array(flags), "values": JsonValue.object({"target_os": JsonValue.array([JsonValue.string(os)])})})
    return JsonValue.object({
        "schema": JsonValue.string("incan.oven.target-predicates/1"),
        "toolchain": JsonValue.string("explicit-toolchain"), "declaration": JsonValue.string("explicit-manifest-digest"),
        "target": JsonValue.object({"triple": JsonValue.string(triple), "cfg": cfg}),
        "conditions": JsonValue.array([JsonValue.string(value) for value in conditions]),
    }).to_json().map_err((e) => e.message())


def text(value: JsonValue, key: str) -> Result[str, str]:
    """Preserve fixture setup errors instead of substituting successful-looking defaults."""
    return value.require(key).map_err((e) => e.message())?.expect_str().map_err((e) => e.message())


def decisions(value: JsonValue) -> Result[list[bool], str]:
    """Read the complete ordered response, including every negative decision."""
    entries = value.require("matches").map_err((e) => e.message())?.expect_array().map_err((e) => e.message())?
    mut result: list[bool] = []
    for entry in entries:
        result.append(entry.expect_bool().map_err((e) => e.message())?)
    return Ok(result)


pub def test_target_conditions_keep_false_results() -> Result[None, str]:
    """Unknown atoms in a complete snapshot are false; false conditions are retained in original order."""
    source = request(["cfg(unix)", "cfg(target_arch = \"wasm32\")", "cfg(missing)", "aarch64-apple-darwin", "x86_64-pc-windows-msvc"])?
    response = dispatch(source)
    assert text(response, "status")? == "selected"
    assert decisions(response)? == [true, false, false, true, false]
    assert text(response, "request_digest")? == "sha256:" + hexlify(sha256.digest(source.encode("utf-8")))
    return Ok(None)


pub def test_target_snapshot_changes_decision_and_binding() -> Result[None, str]:
    """The selected target, rather than this process's host, controls evaluation and response identity."""
    first = evaluate(request(["cfg(windows)"])?)
    second = evaluate(request(["cfg(windows)"], windows=true)?)
    assert decisions(first)? == [false]
    assert decisions(second)? == [true]
    assert text(first, "request_digest")? != text(second, "request_digest")?
    return Ok(None)


pub def test_missing_cfg_is_refused_but_exact_triple_needs_no_snapshot() -> Result[None, str]:
    """An absent snapshot cannot turn a conditional dependency into an inactive one."""
    response = evaluate(request(["cfg(unix)"], snapshot=false)?)
    assert text(response, "status")? == "refused"
    assert "matches" not in response.keys()
    assert text(response, "reason")? != ""
    exact = evaluate(request(["aarch64-apple-darwin"], snapshot=false)?)
    assert decisions(exact)? == [true]
    return Ok(None)


pub def test_malformed_condition_never_returns_partial_decisions() -> Result[None, str]:
    """A successful prefix and a dead boolean branch cannot conceal a malformed condition."""
    for condition in ["cfg(not())", "cfg(any(unix, unknown(windows)))", "cfg(target_os=\"macos\")"]:
        response = evaluate(request(["cfg(unix)", condition])?)
        assert text(response, "status")? == "refused"
        assert "matches" not in response.keys()
    return Ok(None)


pub def test_missing_unknown_or_wrong_schema_fields_are_refused() -> Result[None, str]:
    """The transport requires all binding fields and rejects unsupported request shape."""
    for source in ["{}", "null", "not json", "{\"schema\":\"incan.oven.target-predicates/2\"}"]:
        response = evaluate(source)
        assert text(response, "status")? == "refused"
        assert "matches" not in response.keys()
    valid = request([])?
    extra = valid[:-1] + ",\"unknown\":true}"
    assert text(evaluate(extra), "status")? == "refused"
    assert decisions(evaluate(valid))? == []
    return Ok(None)
