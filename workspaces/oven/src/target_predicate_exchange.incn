"""Evaluate declared target conditions through the shared cfg policy, bound to the exact request bytes.

The caller owns the complete toolchain snapshot and original declaration. A response is neither source admission
nor dependency resolution: it carries one checked boolean per supplied condition, including false conditions.
"""

from std.json import JsonValue, parse
from std.hash import sha256
from std.encoding.hex import hexlify
from plan_json import exact_object, field, strings, text_field
from rust_policy_exchange import decode_target
from rust_activation import target_matches

const SCHEMA: str = "incan.oven.target-predicates/1"


def select(document: JsonValue) -> Result[list[bool], str]:
    """Reject incomplete envelopes before evaluating every predicate against the same explicit target snapshot."""
    exact_object(document, ["schema", "target", "conditions", "toolchain", "declaration"], []).map_err((e) => e.message())?
    if text_field(document, "schema", []).map_err((e) => e.message())? != SCHEMA:
        return Err("unsupported target predicate schema")
    for key in ["toolchain", "declaration"]:
        if text_field(document, key, []).map_err((e) => e.message())? == "":
            return Err(f"missing target predicate binding: {key}")
    target = decode_target(field(document, "target", []).map_err((e) => e.message())?, ["target"]).map_err((e) => e.message())?
    conditions = strings(field(document, "conditions", []).map_err((e) => e.message())?, ["conditions"]).map_err((e) => e.message())?
    mut matches: list[bool] = []
    for index in range(len(conditions)):
        matches.append(target_matches(conditions[index], target, "declaration", ["conditions", str(index)]).map_err((e) => e.message())?)
    return Ok(matches)


pub def evaluate(source: str) -> JsonValue:
    """Bind success and refusal to the complete request so stale or partial answers cannot select dependencies."""
    mut result: Result[list[bool], str] = Err("invalid target predicate JSON")
    match parse(source):
        Ok(document) => result = select(document)
        Err(error) => result = Err(error.message())
    mut response = {
        "schema": JsonValue.string(SCHEMA),
        "request_digest": JsonValue.string("sha256:" + hexlify(sha256.digest(source.encode("utf-8")))),
    }
    match result:
        Ok(matches) =>
            response["status"] = JsonValue.string("selected")
            response["matches"] = JsonValue.array([JsonValue.bool(value) for value in matches])
        Err(reason) =>
            response["status"] = JsonValue.string("refused")
            response["reason"] = JsonValue.string(reason)
    return JsonValue.object(response)
