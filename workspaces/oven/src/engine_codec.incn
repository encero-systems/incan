def encode_needprerequisite(value: NeedPrerequisite) -> Result[bytes, Refusal]:
    """Encode NeedPrerequisite's ordered v1 fields."""
    if value.earlier_rank < 0 or value.earlier_rank > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="NeedPrerequisite.earlier_rank exceeds u32"))
    return Ok(joined([scalar(1, 2), text(value.keys_root)?, scalar(int(value.earlier_rank), 4)]))


def decode_needprerequisite(mut reader: Decoder) -> Result[NeedPrerequisite, Refusal]:
    """Decode NeedPrerequisite's fields only after checking their declared lengths."""
    keys_root = reader.text()?
    earlier_rank = int(reader.number(4)?)
    return Ok(NeedPrerequisite(keys_root=keys_root, earlier_rank=earlier_rank))


