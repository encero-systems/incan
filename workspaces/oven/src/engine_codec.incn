    """Decode Pin's fields only after checking their declared lengths."""
    snapshot = reader.text()?
    allowed_roots = reader.text()?
    lease_id = reader.text()?
    purpose = reader.text()?
    return Ok(Pin(snapshot=snapshot, allowed_roots=allowed_roots, lease_id=lease_id, purpose=purpose))


def encode_release(value: Release) -> Result[bytes, Refusal]:
    """Encode Release's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.lease_id)?]))


def decode_release(mut reader: Decoder) -> Result[Release, Refusal]:
    """Decode Release's fields only after checking their declared lengths."""
    lease_id = reader.text()?
    return Ok(Release(lease_id=lease_id))


def encode_drain(value: Drain) -> Result[bytes, Refusal]:
    """Encode Drain's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.reason)?]))


def decode_drain(mut reader: Decoder) -> Result[Drain, Refusal]:
    """Decode Drain's fields only after checking their declared lengths."""
    reason = reader.text()?
    return Ok(Drain(reason=reason))


def encode_stop(value: Stop) -> Result[bytes, Refusal]:
    """Encode Stop's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.reason)?]))


def decode_stop(mut reader: Decoder) -> Result[Stop, Refusal]:
    """Decode Stop's fields only after checking their declared lengths."""
    reason = reader.text()?
    return Ok(Stop(reason=reason))


def encode_ack(value: Ack) -> Result[bytes, Refusal]:
    """Encode Ack's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), wide(value.sequence, 8)]))


def decode_ack(mut reader: Decoder) -> Result[Ack, Refusal]:
    """Decode Ack's fields only after checking their declared lengths."""
    sequence = reader.number(8)?
    return Ok(Ack(sequence=sequence))


def encode_refused(value: Refused) -> Result[bytes, Refusal]:
    """Encode Refused's ordered v1 fields."""
    if value.code < 0 or value.code > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="Refused.code exceeds u32"))
    return Ok(joined([scalar(1, 2), scalar(int(value.code), 4), text(value.command)?, text(value.detail)?]))


def decode_refused(mut reader: Decoder) -> Result[Refused, Refusal]:
    """Decode Refused's fields only after checking their declared lengths."""
    code = int(reader.number(4)?)
    if code < 1 or code > 14:
        return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required refusal code"))
    command = reader.text()?
    detail = reader.text()?
    return Ok(Refused(code=code, command=command, detail=detail))


def encode_bindingoutcome(value: BindingOutcome) -> int:
    """The stable v1 BindingOutcome variant tag."""
    match value:
        BindingOutcome.Selected => return 1
        BindingOutcome.NotSelected => return 2
        BindingOutcome.Rejected => return 3
        BindingOutcome.Superseded => return 4


def decode_bindingoutcome(tag: int) -> Result[BindingOutcome, Refusal]:
    """Fail closed for an unknown required BindingOutcome variant."""
    if tag == 1:
        return Ok(BindingOutcome.Selected)
    if tag == 2:
        return Ok(BindingOutcome.NotSelected)
    if tag == 3:
        return Ok(BindingOutcome.Rejected)
    if tag == 4:
        return Ok(BindingOutcome.Superseded)
    return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required BindingOutcome variant"))


def encode_completionstatus(value: CompletionStatus) -> int:
    """The stable v1 CompletionStatus variant tag."""
    match value:
        CompletionStatus.Success => return 1
        CompletionStatus.Unavailable => return 2
        CompletionStatus.Failed => return 3
        CompletionStatus.Cancelled => return 4


def decode_completionstatus(tag: int) -> Result[CompletionStatus, Refusal]:
    """Fail closed for an unknown required CompletionStatus variant."""
    if tag == 1:
        return Ok(CompletionStatus.Success)
    if tag == 2:
        return Ok(CompletionStatus.Unavailable)
    if tag == 3:
        return Ok(CompletionStatus.Failed)
    if tag == 4:
        return Ok(CompletionStatus.Cancelled)
    return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required CompletionStatus variant"))


def encode_resolution(value: Resolution) -> int:
    """The stable v1 Resolution variant tag."""
    match value:
        Resolution.Committed => return 1
        Resolution.NotCommitted => return 2
        Resolution.Unknown => return 3


def decode_resolution(tag: int) -> Result[Resolution, Refusal]:
    """Fail closed for an unknown required Resolution variant."""
    if tag == 1:
        return Ok(Resolution.Committed)
    if tag == 2:
        return Ok(Resolution.NotCommitted)
    if tag == 3:
        return Ok(Resolution.Unknown)
    return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required Resolution variant"))


def encode_effectdisposition(value: EffectDisposition) -> int:
    """The stable v1 EffectDisposition variant tag."""
    match value:
        EffectDisposition.Stopped => return 1
        EffectDisposition.Pending => return 2
        EffectDisposition.NoEffects => return 3


def decode_effectdisposition(tag: int) -> Result[EffectDisposition, Refusal]:
    """Fail closed for an unknown required EffectDisposition variant."""
    if tag == 1:
        return Ok(EffectDisposition.Stopped)
    if tag == 2:
        return Ok(EffectDisposition.Pending)
    if tag == 3:
        return Ok(EffectDisposition.NoEffects)
    return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required EffectDisposition variant"))
