    payload_limit = int(reader.number(4)?)
    return Ok(
        Welcome(
            store_id=store_id,
            profile=profile,
            service_generation=service_generation,
            compiler_generation=compiler_generation,
            peer_uid=peer_uid,
            credits=credits,
            payload_limit=payload_limit,
        ),
    )


def encode_submit(value: Submit) -> Result[bytes, Refusal]:
    """Encode Submit's ordered v1 fields."""
    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.command)?,
                text(value.view)?,
                text(value.input_selection)?,
                text(value.requested_roots)?,
                text(value.options)?,
                text(value.observation_policy)?,
            ],
        ),
    )


def decode_submit(mut reader: Decoder) -> Result[Submit, Refusal]:
    """Decode Submit's fields only after checking their declared lengths."""
    command = reader.text()?
    view = reader.text()?
    input_selection = reader.text()?
    requested_roots = reader.text()?
    options = reader.text()?
    observation_policy = reader.text()?
    return Ok(
        Submit(
            command=command,
            view=view,
            input_selection=input_selection,
            requested_roots=requested_roots,
            options=options,
            observation_policy=observation_policy,
        ),
