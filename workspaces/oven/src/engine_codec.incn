    """Decode Evaluate's fields only after checking their declared lengths."""
    work_root = reader.text()?
    snapshot = reader.text()?
    prepared_root = reader.text()?
    reservation = reader.text()?
    cancellation_generation = int(reader.number(4)?)
    return Ok(
        Evaluate(
            work_root=work_root,
            snapshot=snapshot,
            prepared_root=prepared_root,
            reservation=reservation,
            cancellation_generation=cancellation_generation,
