def encode_query(value: Query) -> Result[bytes, Refusal]:
    """Encode Query's ordered v1 fields."""
    if value.row_limit < 0 or value.row_limit > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="Query.row_limit exceeds u32"))
    if value.byte_limit < 0 or value.byte_limit > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="Query.byte_limit exceeds u32"))
    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.snapshot)?,
                text(value.query_root)?,
                text(value.cursor)?,
                scalar(int(value.row_limit), 4),
                scalar(int(value.byte_limit), 4),
            ],
        ),
    )


def decode_query(mut reader: Decoder) -> Result[Query, Refusal]:
    """Decode Query's fields only after checking their declared lengths."""
    snapshot = reader.text()?
    query_root = reader.text()?
    cursor = reader.text()?
    row_limit = int(reader.number(4)?)
    byte_limit = int(reader.number(4)?)
    return Ok(Query(snapshot=snapshot, query_root=query_root, cursor=cursor, row_limit=row_limit, byte_limit=byte_limit))


