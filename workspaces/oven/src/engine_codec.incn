    """Decode Page's fields only after checking their declared lengths."""
    snapshot = reader.text()?
    rows_root = reader.text()?
    cursor = reader.text()?
    return Ok(Page(snapshot=snapshot, rows_root=rows_root, cursor=cursor))


def encode_event(value: Event) -> Result[bytes, Refusal]:
    """Encode Event's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.status)?, text(value.trace_handle)?]))


def decode_event(mut reader: Decoder) -> Result[Event, Refusal]:
    """Decode Event's fields only after checking their declared lengths."""
    status = reader.text()?
    trace_handle = reader.text()?
    return Ok(Event(status=status, trace_handle=trace_handle))


def encode_complete(value: Complete) -> Result[bytes, Refusal]:
    """Encode Complete's ordered v1 fields."""
    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.snapshot)?,
                text(value.admission_proof)?,
                text(value.result_handles)?,
                scalar(encode_bindingoutcome(value.binding_outcome), 2),
                scalar(encode_completionstatus(value.status), 2),
                text(value.observation_handle)?,
            ],
        ),
    )


def decode_complete(mut reader: Decoder) -> Result[Complete, Refusal]:
    """Decode Complete's fields only after checking their declared lengths."""
    snapshot = reader.text()?
    admission_proof = reader.text()?
    result_handles = reader.text()?
    binding_outcome = decode_bindingoutcome(int(reader.number(2)?))?
    status = decode_completionstatus(int(reader.number(2)?))?
    observation_handle = reader.text()?
    return Ok(
        Complete(
            snapshot=snapshot,
            admission_proof=admission_proof,
            result_handles=result_handles,
            binding_outcome=binding_outcome,
            status=status,
            observation_handle=observation_handle,
        ),
    )


def encode_cancel(value: Cancel) -> Result[bytes, Refusal]:
    """Encode Cancel's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.interest_token)?]))


def decode_cancel(mut reader: Decoder) -> Result[Cancel, Refusal]:
    """Decode Cancel's fields only after checking their declared lengths."""
    interest_token = reader.text()?
    return Ok(Cancel(interest_token=interest_token))


def encode_cancelled(value: Cancelled) -> Result[bytes, Refusal]:
    """Encode the exact effect disposition, never a guessed numeric boolean."""
    return Ok(
        joined([scalar(1, 2), text(value.interest_token)?, scalar(encode_effectdisposition(value.effects_stopped), 2)]),
    )


def decode_cancelled(mut reader: Decoder) -> Result[Cancelled, Refusal]:
    """Reject unknown effect dispositions before reporting cancellation complete."""
    token = reader.text()?
    effects = decode_effectdisposition(int(reader.number(2)?))?
    return Ok(Cancelled(interest_token=token, effects_stopped=effects))


def encode_resolve(value: Resolve) -> Result[bytes, Refusal]:
    """Encode Resolve's ordered v1 fields."""
    return Ok(joined([scalar(1, 2), text(value.transaction)?, scalar(encode_resolution(value.outcome), 2)]))


def decode_resolve(mut reader: Decoder) -> Result[Resolve, Refusal]:
    """Decode Resolve's fields only after checking their declared lengths."""
    transaction = reader.text()?
    outcome = decode_resolution(int(reader.number(2)?))?
    return Ok(Resolve(transaction=transaction, outcome=outcome))


