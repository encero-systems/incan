    """Encode Pin's ordered v1 fields."""
    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.snapshot)?,
                text(value.allowed_roots)?,
                text(value.lease_id)?,
                text(value.purpose)?,
            ],
        ),
    )


