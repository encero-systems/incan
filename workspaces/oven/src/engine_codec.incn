"""Versioned, tagged binary bodies; lengths are validated before each decode allocation."""

from engine_messages import (
    BindingOutcome,
    CompletionStatus,
    Resolution,
    EffectDisposition,
    Message,
    Hello,
    Welcome,
    Submit,
    Accepted,
    Captured,
    Prepare,
    NeedPrerequisite,
    Evaluate,
    Produced,
    Query,
    Page,
    Event,
    Complete,
    Cancel,
    Cancelled,
    Resolve,
    Pin,
    Release,
    Drain,
    Stop,
    Ack,
    Refused,
)
from engine_wire import Decoder, MAX_PAYLOAD, Refusal, RefusalKind, joined, scalar, text, wide


pub def encode(message: Message) -> Result[tuple[int, bytes], Refusal]:
    """Encode one v1 body and return its header tag; no records are sent on this channel."""
    match message:
        Message.Hello(value) => return bounded(1, encode_hello(value)?)
        Message.Welcome(value) => return bounded(2, encode_welcome(value)?)
        Message.Submit(value) => return bounded(3, encode_submit(value)?)
        Message.Accepted(value) => return bounded(4, encode_accepted(value)?)
        Message.Captured(value) => return bounded(5, encode_captured(value)?)
        Message.Prepare(value) => return bounded(6, encode_prepare(value)?)
        Message.NeedPrerequisite(value) => return bounded(7, encode_needprerequisite(value)?)
        Message.Evaluate(value) => return bounded(8, encode_evaluate(value)?)
        Message.Produced(value) => return bounded(9, encode_produced(value)?)
        Message.Query(value) => return bounded(10, encode_query(value)?)
        Message.Page(value) => return bounded(11, encode_page(value)?)
        Message.Event(value) => return bounded(12, encode_event(value)?)
        Message.Complete(value) => return bounded(13, encode_complete(value)?)
        Message.Cancel(value) => return bounded(14, encode_cancel(value)?)
        Message.Cancelled(value) => return bounded(15, encode_cancelled(value)?)
        Message.Resolve(value) => return bounded(16, encode_resolve(value)?)
        Message.Pin(value) => return bounded(17, encode_pin(value)?)
        Message.Release(value) => return bounded(18, encode_release(value)?)
        Message.Drain(value) => return bounded(19, encode_drain(value)?)
        Message.Stop(value) => return bounded(20, encode_stop(value)?)
        Message.Ack(value) => return bounded(21, encode_ack(value)?)
        Message.Refused(value) => return bounded(22, encode_refused(value)?)


pub def bounded(tag: int, raw: bytes) -> Result[tuple[int, bytes], Refusal]:
    """Enforce the complete body bound after individually bounded fields have been encoded."""
    if len(raw) > MAX_PAYLOAD:
        return Err(Refusal(kind=RefusalKind.Oversized, detail="engine body exceeds 65536 bytes"))
    return Ok((tag, raw))


pub def decode(tag: int, raw: bytes) -> Result[Message, Refusal]:
    """Decode only the exact known version and tag, rejecting trailing bytes."""
    if len(raw) > MAX_PAYLOAD:
        return Err(Refusal(kind=RefusalKind.Oversized, detail="engine body exceeds 65536 bytes"))
    mut reader = Decoder(raw=raw)
    if reader.number(2)? != 1:
        return Err(Refusal(kind=RefusalKind.Version, detail="unsupported body schema version"))
    message = decode_fields(tag, reader)?
    reader.finish()?
    return Ok(message)


def decode_fields(tag: int, mut reader: Decoder) -> Result[Message, Refusal]:
    """Dispatch required variants without guessing compatibility with another protocol."""
    if tag == 1:
        return Ok(Message.Hello(decode_hello(reader)?))
    if tag == 2:
        return Ok(Message.Welcome(decode_welcome(reader)?))
    if tag == 3:
        return Ok(Message.Submit(decode_submit(reader)?))
    if tag == 4:
        return Ok(Message.Accepted(decode_accepted(reader)?))
    if tag == 5:
        return Ok(Message.Captured(decode_captured(reader)?))
    if tag == 6:
        return Ok(Message.Prepare(decode_prepare(reader)?))
    if tag == 7:
        return Ok(Message.NeedPrerequisite(decode_needprerequisite(reader)?))
    if tag == 8:
        return Ok(Message.Evaluate(decode_evaluate(reader)?))
    if tag == 9:
        return Ok(Message.Produced(decode_produced(reader)?))
    if tag == 10:
        return Ok(Message.Query(decode_query(reader)?))
    if tag == 11:
        return Ok(Message.Page(decode_page(reader)?))
    if tag == 12:
        return Ok(Message.Event(decode_event(reader)?))
    if tag == 13:
        return Ok(Message.Complete(decode_complete(reader)?))
    if tag == 14:
        return Ok(Message.Cancel(decode_cancel(reader)?))
    if tag == 15:
        return Ok(Message.Cancelled(decode_cancelled(reader)?))
    if tag == 16:
        return Ok(Message.Resolve(decode_resolve(reader)?))
    if tag == 17:
        return Ok(Message.Pin(decode_pin(reader)?))
    if tag == 18:
        return Ok(Message.Release(decode_release(reader)?))
    if tag == 19:
        return Ok(Message.Drain(decode_drain(reader)?))
    if tag == 20:
        return Ok(Message.Stop(decode_stop(reader)?))
    if tag == 21:
        return Ok(Message.Ack(decode_ack(reader)?))
    if tag == 22:
        return Ok(Message.Refused(decode_refused(reader)?))
    return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required engine message tag"))


def encode_hello(value: Hello) -> Result[bytes, Refusal]:
    """Encode Hello's ordered v1 fields."""
    if value.credits < 0 or value.credits > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="Hello.credits exceeds u32"))
    if value.payload_limit < 0 or value.payload_limit > 4294967295:
        return Err(Refusal(kind=RefusalKind.Schema, detail="Hello.payload_limit exceeds u32"))
    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.store_id)?,
                text(value.profile)?,
                text(value.service_generation)?,
                text(value.compiler_generation)?,
                scalar(int(value.peer_uid), 4),
                scalar(int(value.credits), 4),
                scalar(int(value.payload_limit), 4),
            ],
        ),
    )


def decode_hello(mut reader: Decoder) -> Result[Hello, Refusal]:
    """Decode Hello's fields only after checking their declared lengths."""
    store_id = reader.text()?
    profile = reader.text()?
    service_generation = reader.text()?
    compiler_generation = reader.text()?
    peer_uid: u32 = reader.number(4)?.wrapping_resize()
    credits = int(reader.number(4)?)
    payload_limit = int(reader.number(4)?)
    return Ok(
        Hello(
            store_id=store_id,
            profile=profile,
            service_generation=service_generation,
            compiler_generation=compiler_generation,
            peer_uid=peer_uid,
            credits=credits,
            payload_limit=payload_limit,
        ),
    )


