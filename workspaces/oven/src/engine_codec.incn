    return Ok(
        joined(
            [
                scalar(1, 2),
                text(value.work_root)?,
                text(value.snapshot)?,
                text(value.prepared_root)?,
                text(value.reservation)?,
                scalar(int(value.cancellation_generation), 4),
            ],
        ),
    )


