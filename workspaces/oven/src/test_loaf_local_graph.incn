"""The production local facet graph preserves features, host domains and inactive targets."""

from std import toml
from std.fs import Path
from std.testing import fail
from loaf_local_graph import LocalDemand, LocalFacet, catalog, local_facets
from rust_activation import CfgSnapshot, DependencyDomain, TargetConfiguration


def root(defaults: bool) -> Result[LocalDemand, str]:
    """Select the authored fixture root with an optional leaf and a host macro."""
    path = Path("tests/fixtures/local-test-graph/root").resolve().map_err((error) => error.message())?
    return Ok(LocalDemand(project=path.0, domain=DependencyDomain.Target, features=[], defaults=defaults))


def configuration() -> TargetConfiguration:
    """Keep the fixture's Windows-only missing child inactive using complete target facts."""
    return TargetConfiguration(
        triple="x86_64-unknown-linux-gnu",
        cfg=Some(CfgSnapshot(flags=["unix"], values={"target_os": ["linux"]})),
    )


pub def test_local_graph_selects_features_and_host_transitives() -> Result[None, str]:
    """Root defaults reach the leaf without its defaults, while the macro and its helper remain host units."""
    facets = local_facets(root(true)?, configuration())?
    assert len(facets) == 4
    for facet in facets:
        if facet.project.endswith("/macro") or facet.project.endswith("/helper"):
            assert facet.domain == DependencyDomain.Host
        else:
            assert facet.domain == DependencyDomain.Target
        if facet.project.endswith("/leaf"):
            assert facet.features == ["extra"]
            assert len(facet.registry) == 1
            defaults = facet.registry[0].require("default-features").map_err((error) => error.message())?
            assert not defaults.expect_bool().map_err((error) => error.message())?
    return Ok(None)


pub def test_local_graph_normal_selection_excludes_test_environment() -> Result[None, str]:
    """Disabling defaults leaves optional and development dependencies out of the production graph."""
    facets = local_facets(root(false)?, configuration())?
    assert len(facets) == 3
    for facet in facets:
        assert not facet.project.endswith("/leaf")
        assert not facet.project.endswith("/support")
    return Ok(None)


pub def test_local_graph_catalog_requires_well_formed_features() -> Result[None, str]:
    """A dependency-only catalog is valid, while present project and feature tables require their declared shapes."""
    document = toml.parse("[dependencies]\nleaf='1'\n").map_err((error) => error.message())?
    assert len(catalog(document)?.features) == 0
    for malformed in ["project=1\n", "[project]\nfeatures=1\n"]:
        invalid = toml.parse(malformed).map_err((error) => error.message())?
        match catalog(invalid):
            Ok(_) => fail("malformed project feature table was accepted")
            Err(_) => pass
    return Ok(None)


pub def test_local_graph_does_not_visit_inactive_targets() -> Result[None, str]:
    """An inactive target edge neither reads its absent source nor enters the selected local edge list."""
    facets = local_facets(root(false)?, configuration())?
    for facet in facets:
        assert not facet.project.endswith("/absent")
        for edge in facet.local:
            assert edge.alias != "absent"
    return Ok(None)
