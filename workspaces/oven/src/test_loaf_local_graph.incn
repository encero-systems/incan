"""The production local facet graph preserves features, host domains and inactive targets."""

from std.fs import Path
from std.testing import fail
from intake import ManifestReader, read_project
from loaf_local_graph import LocalDemand, LocalFacet, catalog, local_facets, local_facet_session
from rust_activation import ActivationPurpose, CfgSnapshot, DependencyDomain, TargetConfiguration
from registry_units import RegistryDemand, RegistrySelection, RegistryUnit, RegistryUnits
from toolchain_native import retain_support_facet


def root(defaults: bool) -> Result[LocalDemand, str]:
    """Select the authored fixture root with an optional leaf and a host macro."""
    path = Path("tests/fixtures/local-test-graph/root").resolve().map_err((error) => error.message())?
    return Ok(LocalDemand(project=path.0, domain=DependencyDomain.Target, features=[], defaults=defaults))


def configuration() -> TargetConfiguration:
    """Keep the fixture's Windows-only missing child inactive using complete target facts."""
    return TargetConfiguration(
        triple="x86_64-unknown-linux-gnu",
        cfg=Some(CfgSnapshot(flags=["unix"], values={"target_os": ["linux"]})),
    )


pub def test_local_graph_builds_a_root_macro_and_its_links_for_the_host() -> Result[None, str]:
    """
    A procedural macro runs in the compiler, so as the root it is a host unit, as it is as a dependency; its test
    harness root stays a target executable.
    """
    path = Path("tests/fixtures/local-test-graph/macro").resolve().map_err((error) => error.message())?
    demand = LocalDemand(project=path.0, domain=DependencyDomain.Target, features=[], defaults=true)
    facets = local_facets(demand, configuration())?
    assert len(facets) == 2
    for facet in facets:
        assert facet.domain == DependencyDomain.Host, facet.key()
    mut harness = demand
    harness.purpose = ActivationPurpose.Test
    for facet in local_facets(harness, configuration())?:
        if facet.project == path.0:
            assert facet.domain == DependencyDomain.Target, facet.key()
    return Ok(None)


pub def test_local_graph_selects_features_and_host_transitives() -> Result[None, str]:
    """Root defaults reach the leaf without its defaults, while the macro and its helper remain host units."""
    facets = local_facets(root(true)?, configuration())?
    assert len(facets) == 4
    for facet in facets:
        if facet.project.endswith("/macro") or facet.project.endswith("/helper"):
            assert facet.domain == DependencyDomain.Host
        else:
            assert facet.domain == DependencyDomain.Target
        if facet.project.endswith("/leaf"):
            assert facet.features == ["extra"]
            assert len(facet.registry) == 1
            defaults = facet.registry[0].require("default-features").map_err((error) => error.message())?
            assert not defaults.expect_bool().map_err((error) => error.message())?
    registry_closure_controls()?
    return Ok(None)


def registry_closure_controls() -> Result[None, str]:
    """Two serde builds must agree with serde_json's exact core; an unanchored choice is a named ambiguity."""
    core_a = registry_fixture("serde_core", "core-a", [], ["alloc", "std"])
    core_b = registry_fixture("serde_core", "core-b", [], ["std"])
    serde_a = registry_fixture("serde", "serde-a", ["core-a"], ["derive", "alloc"])
    serde_b = registry_fixture("serde", "serde-b", ["core-b"], ["derive"])
    json = registry_fixture("serde_json", "json-b", ["core-b"], ["std"])
    registry = RegistryUnits(units=[serde_a, core_a, json, serde_b, core_b], search=[])
    serde = RegistryDemand(
        selection=RegistrySelection(loaf="crates-io/serde", requirement="1", features=["derive"]),
        domain="target",
    )
    json_request = RegistryDemand(
        selection=RegistrySelection(loaf="crates-io/serde_json", requirement="1", features=[]),
        domain="target",
    )
    selected = registry.select([serde, json_request], "release")?
    assert selected.bindings[serde.key()] == "serde-b"
    assert selected.bindings[json_request.key()] == "json-b"
    assert sorted([unit.entry for unit in selected.units]) == ["core-b", "json-b", "serde-b"]
    reversed = RegistryUnits(units=[core_b, serde_b, json, core_a, serde_a], search=[])
    assert reversed.select([json_request, serde], "release")?.bindings == selected.bindings
    incomplete_alternative = RegistryUnits(units=[serde_a, serde_b, core_b, json], search=[])
    assert incomplete_alternative.select([serde, json_request], "release")?.bindings == selected.bindings
    installed = RegistryUnits(units=registry.units, search=[], anchors=[("target", "core-a")])
    assert installed.select([serde], "release")?.bindings[serde.key()] == "serde-a"
    match installed.select([serde, json_request], "release"):
        Ok(_) => fail("a registry graph conflicting with an installed native producer was accepted")
        Err(reason) =>
            assert "no coherent compiled registry closure" in reason
    match registry.select([serde], "release"):
        Ok(_) => fail("two independently coherent serde feature graphs were selected arbitrarily")
        Err(reason) =>
            assert "ambiguous compiled registry closure" in reason
            assert "crates-io/serde" in reason
    json_a = registry_fixture("serde_json", "json-a", ["core-a"], ["std"])
    mut cohorts = RegistryUnits(units=registry.units + [json_a], search=[])
    match cohorts.select([serde, json_request], "release"):
        Ok(_) => fail("two coherent producer cohorts were selected without a record")
        Err(reason) =>
            assert "ambiguous compiled registry closure" in reason
    cohorts.recorded_bindings = [("target", "serde-a"), ("target", "json-a")]
    pinned = cohorts.select([serde, json_request], "release")?
    assert pinned.bindings[serde.key()] == "serde-a"
    assert pinned.bindings[json_request.key()] == "json-a"
    host_serde = RegistryDemand(selection=serde.selection, domain="host")
    domains = RegistryUnits(
        units=registry.units,
        search=[],
        anchors=[("host", "core-a")],
        recorded_bindings=[("host", "serde-a"), ("target", "serde-b")],
    )
    separate = domains.select([serde, host_serde])?
    assert separate.bindings[host_serde.key()] == "serde-a"
    assert separate.bindings[serde.key()] == "serde-b"
    mut incompatible = cohorts
    incompatible.recorded_bindings = [("target", "serde-b")]
    alloc = RegistryDemand(
        selection=RegistrySelection(loaf="crates-io/serde", requirement="1", features=["alloc"]),
        domain="target",
    )
    match incompatible.select([alloc]):
        Ok(_) => fail("an incompatible recorded producer fell back to another catalog entry")
        Err(reason) =>
            assert "recorded registry closure does not satisfy" in reason
    installation = RegistryUnits(
        units=registry.units,
        search=[],
        installation_bindings=[("target", "serde-b")],
    )
    assert installation.select([alloc], "release")?.bindings[alloc.key()] == "serde-a"
    assert installation.select([serde], "release")?.bindings[serde.key()] == "serde-b"
    mut published = installation
    published.anchors = [("target", "core-a")]
    assert published.select([serde], "release")?.bindings[serde.key()] == "serde-a"
    unavailable_requests: list[Tuple[str, list[str]]] = [("999", []), ("1", ["not_a_feature"])]
    for requirement, features in unavailable_requests:
        unavailable = RegistryDemand(
            selection=RegistrySelection(loaf="crates-io/serde", requirement=requirement, features=features),
            domain="target",
        )
        match incompatible.select([unavailable]):
            Ok(_) => fail("an unavailable registry version or feature was accepted")
            Err(reason) =>
                assert "no compiled registry unit of crates-io/serde satisfies" in reason
                assert "recorded registry closure does not satisfy" not in reason
    absent = RegistryDemand(
        selection=RegistrySelection(loaf="crates-io/missing", requirement="1", features=[]),
        domain="target",
    )
    match incompatible.select([absent]):
        Ok(_) => fail("an unpublished registry Loaf was accepted")
        Err(reason) =>
            assert "crates-io/missing is not published in the compiled registry closure" in reason
            # The refusal names the routes a crate outside the registry has.
            assert "declare it as a local Rust facet" in reason and "publish it to the registry" in reason, reason
    missing = RegistryUnits(units=[serde_b], search=[])
    match missing.select([serde], "release"):
        Ok(_) => fail("a producer whose exact dependency is absent was accepted")
        Err(reason) =>
            assert "absent dependency entry core-b" in reason
    return Ok(None)


def registry_fixture(name: str, entry: str, dependencies: list[str], features: list[str]) -> RegistryUnit:
    """Describe a source-free compiled producer identity without filesystem or compiler work."""
    return RegistryUnit(
        loaf=f"crates-io/{name}",
        version="1.0.0",
        domain="target",
        directory=entry,
        entry=entry,
        dependencies=dependencies,
        features=features,
        profile="release",
    )


pub def test_local_graph_normal_selection_excludes_test_environment() -> Result[None, str]:
    """Shared activations preserve independent roots, root-local test overlays and divergent-support refusals."""
    mut session = local_facet_session(configuration())
    enabled = session.facets(root(true)?)?
    facets = session.facets(root(false)?)?
    repeated = session.facets(root(false)?)?
    assert len(facets) == 3
    assert len(repeated) == 3
    for facet in facets:
        assert not facet.project.endswith("/leaf")
        assert not facet.project.endswith("/support")
    mut testing = root(false)?
    testing.purpose = ActivationPurpose.Test
    selected = session.facets(testing)?
    assert len(selected) == 5
    for facet in selected:
        assert not facet.project.endswith("/absent")
        if facet.project.endswith("/leaf"):
            assert facet.features == ["test-only"]
            assert len(facet.registry) == 1
    testing.features = ["leaf"]
    match local_facets(testing, configuration()):
        Ok(_) => fail("a test override introduced a suppressed implicit dependency feature")
        Err(reason) =>
            assert "requested local feature is absent" in reason
    mut admitted: Dict[str, LocalFacet] = {}
    for facet in enabled:
        if facet.project.endswith("/root"):
            retain_support_facet(admitted, facet)?
    mut divergent = false
    for facet in repeated:
        if not facet.project.endswith("/root"):
            continue
        match retain_support_facet(admitted, facet):
            Ok(_) => pass
            Err(reason) =>
                assert "requires unified features" in reason
                divergent = true
    assert divergent
    return Ok(None)


pub def test_local_graph_catalog_projects_admitted_intent() -> Result[None, str]:
    """Activation consumes intake's normalized production and environment dependency models without reparsing TOML."""
    path = Path("tests/fixtures/local-test-graph/root").resolve().map_err((error) => error.message())?
    project = read_project(path, ManifestReader()).map_err((error) => error.message())?
    intent = project.intent
    normal = catalog(intent.clone())?
    testing = catalog(intent, "test")?
    assert len(normal.dependencies) == 3
    assert len(testing.dependencies) == 4
    assert normal.features["chosen"] == ["dep:leaf", "leaf/extra"]
    assert testing.features["chosen"] == ["leaf/extra"]
    return Ok(None)


pub def test_local_graph_does_not_visit_inactive_targets() -> Result[None, str]:
    """An inactive target edge neither reads its absent source nor enters the selected local edge list."""
    facets = local_facets(root(false)?, configuration())?
    for facet in facets:
        assert not facet.project.endswith("/absent")
        for edge in facet.local:
            assert edge.alias != "absent"
    return Ok(None)


def profiled_fixture(name: str, entry: str, dependencies: list[str], profile: str) -> RegistryUnit:
    """A compiled producer of one profile whose library is its own entry, so binding a root reads no file."""
    mut unit = registry_fixture(name, entry, dependencies, [])
    unit.profile = profile
    unit.artifact = f"{entry}.rlib"
    return unit


def registry_demand(name: str) -> RegistryDemand:
    """A target request for any 1.x release of one crate, without features."""
    return RegistryDemand(
        selection=RegistrySelection(loaf=f"crates-io/{name}", requirement="1", features=[]),
        domain="target",
    )


def refuses_profile(registry: RegistryUnits, demand: RegistryDemand, profile: str, loaf: str, other: str) -> None:
    """The selection is refused, naming the crate, the consumer's profile and the profile the registry holds."""
    match registry.select([demand], profile):
        Ok(_) => fail(f"a {profile} consumer was given a {other} entry of {loaf}")
        Err(reason) =>
            assert loaf in reason, reason
            assert f"at {profile}" in reason and f"only at {other}" in reason, reason


pub def test_a_consumer_links_entries_of_its_own_profile_or_is_refused_by_name() -> Result[None, str]:
    """
    A release consumer selects a release entry for every crate in its closure and a debug consumer a debug one. A crate
    the registry holds only at another profile is refused, naming the crate and both profiles: whether it is a root, a
    dependency a producer pins, a procedural macro, or a recorded or installed choice.
    """
    core_release = profiled_fixture("serde_core", "core-release", [], "release")
    core_debug = profiled_fixture("serde_core", "core-debug", [], "debug")
    json_release = profiled_fixture("serde_json", "json-release", ["core-release"], "release")
    json_debug = profiled_fixture("serde_json", "json-debug", ["core-debug"], "debug")
    registry = RegistryUnits(units=[core_debug, json_debug, core_release, json_release], search=[])
    json = registry_demand("serde_json")
    for profile in ["release", "debug"]:
        selected = registry.select([json], profile)?
        assert selected.bindings[json.key()] == f"json-{profile}"
        assert [unit.profile for unit in selected.units] == [profile, profile]
    # A crate held only at debug is no release root.
    snap = profiled_fixture("snap", "snap-debug", [], "debug")
    snap_only = RegistryUnits(units=[snap], search=[])
    refuses_profile(snap_only, registry_demand("snap"), "release", "crates-io/snap", "debug")
    # A release producer that pins a debug dependency does not bring it into a release closure.
    tracing = profiled_fixture("tracing", "tracing-release", ["core-debug"], "release")
    pinned = RegistryUnits(units=[tracing, core_debug], search=[])
    refuses_profile(pinned, registry_demand("tracing"), "release", "crates-io/serde_core", "debug")
    # A procedural macro runs in the compiler, and a release closure still takes it at release.
    mut derive_debug = profiled_fixture("serde_derive", "derive-debug", [], "debug")
    derive_debug.kind = "proc-macro"
    serde = profiled_fixture("serde", "serde-release", ["derive-debug"], "release")
    macros = RegistryUnits(units=[serde, derive_debug], search=[])
    refuses_profile(macros, registry_demand("serde"), "release", "crates-io/serde_derive", "debug")
    # Neither a project lock nor the installation's selection picks another profile for the consumer.
    release_only = [json_release, core_release]
    recorded = RegistryUnits(units=release_only, search=[], recorded_bindings=[("target", "json-release")])
    refuses_profile(recorded, json, "debug", "crates-io/serde_json", "release")
    installed = RegistryUnits(units=release_only, search=[], installation_bindings=[("target", "json-release")])
    refuses_profile(installed, json, "debug", "crates-io/serde_json", "release")
    # A lock that records a producer of each profile gives each consumer its own.
    both = RegistryUnits(
        units=registry.units,
        search=[],
        recorded_bindings=[("target", "json-release"), ("target", "json-debug")],
    )
    for profile in ["release", "debug"]:
        assert both.select([json], profile)?.bindings[json.key()] == f"json-{profile}"
    # A native producer the installation anchors at another profile is no part of the consumer's closure either.
    anchored = RegistryUnits(units=registry.units, search=[], anchors=[("target", "core-release")])
    refuses_profile(anchored, json, "debug", "crates-io/serde_core", "release")
    return Ok(None)


pub def test_a_substituted_registry_edge_compiles_its_loaf_from_the_substitute_directory() -> Result[None, str]:
    """
    A registry edge whose Loaf the build substitutes reaches the substitute directory as a local facet, with the
    features the edge selects. Without the substitute it stays a registry request, and a substitute of a version the
    edge does not admit is refused.
    """
    app = Path("tests/fixtures/registry-substitute/app").resolve().map_err((error) => error.message())?
    leaf = Path("tests/fixtures/registry-substitute/leaf").resolve().map_err((error) => error.message())?
    old = Path("tests/fixtures/registry-substitute/old-leaf").resolve().map_err((error) => error.message())?
    demand = LocalDemand(project=app.0, domain=DependencyDomain.Target, features=[], defaults=true)
    plain = local_facets(demand, configuration())?
    assert len(plain) == 1
    assert len(plain[0].registry) == 1 and len(plain[0].local) == 0
    substituted = local_facets(demand, configuration(), {"crates-io/sub-leaf": leaf.0})?
    assert len(substituted) == 2
    for facet in substituted:
        if facet.project == leaf.0:
            assert facet.domain == DependencyDomain.Target
            assert facet.features == ["fast"], facet.key()
            assert len(facet.registry) == 0 and len(facet.local) == 0
        else:
            assert facet.project == app.0
            assert len(facet.registry) == 0 and facet.registry_aliases == []
            assert [edge.alias for edge in facet.local] == ["sub"]
            assert facet.local[0].project == leaf.0
    match local_facets(demand, configuration(), {"crates-io/sub-leaf": old.0}):
        Ok(_) => fail("a substitute of a version the registry edge does not admit was accepted")
        Err(reason) =>
            assert "does not satisfy" in reason, reason
    return Ok(None)
