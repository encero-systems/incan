"""Select local compiler Loaf features and project their registry requests through the shared activation policy."""

from std.toml import TomlValue, TomlKind
from std.fs import Path
from std.json import JsonValue
from rust_source import (
    RustDependencyCatalog,
    RustDependencyDeclaration,
    RustDependencyRole,
    RustDependencySource,
    RustRegistryRequest,
)
from rust_activation import (
    ActivationContext,
    ActivationPurpose,
    DependencyDomain,
    SlotActivation,
    TargetConfiguration,
    activate_unit,
    version_matches,
)
from intake import FeatureDeclaration, feature_declaration
from toml_fields import optional_flag, optional_string, optional_strings, read_manifest, required_string


@derive(Eq)
pub model LocalDemand:
    """Explicit local path, compilation domain, and monotonic incoming feature selection."""

    pub project: str
    pub domain: DependencyDomain
    pub features: list[str]
    pub defaults: bool
    # `--all-features` asks the root for every feature its manifest declares; dependencies never inherit it.
    pub all_features: bool = false


pub def unique(values: list[str]) -> list[str]:
    """
    Canonicalize feature requests and native paths into sorted distinct strings.

    1. Retain each distinct input through hash membership.
    2. Sort the retained values independently of input order.
    """
    # 1. Retain each distinct input through hash membership.
    mut seen: set[str] = set()
    mut result: list[str] = []
    for value in values:
        if value in seen:
            continue
        seen.add(value)
        result.append(value)
    # 2. Sort the retained values independently of input order.
    return sorted(result)


def declaration(
    alias: str,
    value: TomlValue,
    index: int,
    group: str = "dependencies",
) -> Result[RustDependencyDeclaration, str]:
    """
    Decode one Loaf edge without reading Cargo declarations or losing its target and optional policy.

    1. A bare string is a version requirement on the Loaf the alias names.
    2. A table names the path, version, target, features and flags, and may rename the Loaf (`package`, then `loaf`).
    3. A crate of `[rust-dependencies]` that is not a path is a `crates-io/` Loaf.
    4. A path edge is a local source; any other is a registry one.
    """
    mut package = alias
    mut version: Option[str] = None
    mut path: Option[str] = None
    mut features: list[str] = []
    mut target: Option[str] = None
    mut defaults = true
    mut optional = false
    # 1. A bare string states only a version, for the Loaf the alias names.
    if value.kind() == TomlKind.String:
        version = Some(value.as_str().map_err((error) => error.message())?)
    else:
        # 2. A table states the source, target, features and flags, and may rename the Loaf; `loaf` wins over `package`.
        path = optional_string(value, "path")?
        version = optional_string(value, "version")?
        target = optional_string(value, "target")?
        defaults = optional_flag(value, "default-features", true)?
        optional = optional_flag(value, "optional", false)?
        if let Some(selected) = optional_strings(value, "features")?:
            features = selected
        if let Some(selected) = optional_string(value, "package")?:
            package = selected
        if let Some(selected) = optional_string(value, "loaf")?:
            package = selected
    # 3. A Rust crate that is not a local path is a Loaf of the `crates-io` registry.
    if group == "rust-dependencies" and path is None:
        package = f"crates-io/{package}"
    # 4. A path is a local source; anything else is requested from the registry.
    mut source = RustDependencySource.Registry(RustRegistryRequest.Default)
    if let Some(relative) = path:
        source = RustDependencySource.Path(relative, RustRegistryRequest.Default)
    return Ok(
        RustDependencyDeclaration(
            index=index,
            field=[group, alias],
            role=RustDependencyRole.Normal,
            target_condition=target,
            alias=alias,
            package=package,
            version_requirement=version,
            features=features,
            default_features=Some(defaults),
            optional=Some(optional),
            source=source,
        ),
    )


pub def catalog(document: TomlValue) -> Result[RustDependencyCatalog, str]:
    """
    Build the existing activation catalog from converted Loaf declarations, including target alternatives.

    1. Decode the edges of `[dependencies]` and `[rust-dependencies]` for both languages.
    2. Express each declared feature as the entries the activation policy reads.
    """
    root = catalog_table(document)?
    # 1. Every edge is decoded where it is written.
    mut dependencies: list[RustDependencyDeclaration] = []
    for group in ["dependencies", "rust-dependencies"]:
        if group not in root:
            continue
        table = catalog_table(root[group])?
        for alias in sorted([key for key in table.keys()]):
            value = table[alias]
            if value.kind() == TomlKind.Array:
                for alternative in value.as_array().map_err((error) => error.message())?:
                    dependencies.append(declaration(alias, alternative, len(dependencies), group)?)
            else:
                dependencies.append(declaration(alias, value, len(dependencies), group)?)
    # 2. Each feature is spelled the way the activation policy reads it, whichever way the manifest wrote it.
    features = catalog_features(root)?
    return Ok(RustDependencyCatalog(document=document, dependencies=dependencies, features=features, library_name=None))


def catalog_table(value: TomlValue) -> Result[Dict[str, TomlValue], str]:
    """Read a catalog table through the graph's string error channel."""
    return value.as_table().map_err((error) => error.message())


def catalog_features(root: Dict[str, TomlValue]) -> Result[Dict[str, list[str]], str]:
    """Dependency-only overlays declare no project features; present tables still require valid shapes."""
    mut features: Dict[str, list[str]] = {}
    if "project" not in root:
        return Ok(features)
    project = catalog_table(root["project"])?
    if "features" not in project:
        return Ok(features)
    selected = catalog_table(project["features"])?
    for name in sorted([key for key in selected.keys()]):
        declared = feature_declaration(selected[name], "loaf.toml", ["project", "features", name]).map_err(
            (error) => error.message(),
        )?
        features[name] = feature_entries(declared)
    return Ok(features)


def is_incan_path_edge(group: str, value: TomlValue) -> Result[bool, str]:
    """Whether a `[dependencies]` entry is a table with a path and no `loaf`: an edge to an Incan Loaf."""
    if group != "dependencies" or value.kind() != TomlKind.Table:
        return Ok(false)
    entry = value.as_table().map_err((error) => error.message())?
    return Ok("path" in entry and "loaf" not in entry)


def feature_entries(declared: FeatureDeclaration) -> list[str]:
    """A feature as the activation policy reads it: its includes, `dep:` activations and `alias/feature` requests."""
    mut entries = declared.includes
    for alias in declared.optional_dependencies:
        entries.append(f"dep:{alias}")
    for alias in sorted([key for key in declared.dependency_features.keys()]):
        for feature in declared.dependency_features[alias]:
            entries.append(f"{alias}/{feature}")
    return entries


def incan_optional_aliases(document: TomlValue) -> Result[list[str], str]:
    """Name optional Incan path edges whose features require explicit dependency activation."""
    root = catalog_table(document)?
    if "dependencies" not in root:
        return Ok([])
    dependencies = catalog_table(root["dependencies"])?
    mut aliases: list[str] = []
    for alias in sorted([name for name in dependencies.keys()]):
        value = dependencies[alias]
        if is_incan_path_edge("dependencies", value)? and optional_flag(value, "optional", false)?:
            aliases.append(alias)
    return Ok(aliases)


def key(demand: LocalDemand) -> str:
    """Keep host and target requests separate even when both triples are native."""
    return f"{demand.project}@{demand.domain.value()}"


def add(demands: Dict[str, LocalDemand], demand: LocalDemand) -> Dict[str, LocalDemand]:
    """Merge incoming local features and defaults monotonically; the caller observes whether another round is needed."""
    mut result = demands
    identity = key(demand)
    mut selected = demand
    if identity in result:
        previous = result[identity]
        selected = LocalDemand(
            project=demand.project,
            domain=demand.domain,
            features=unique(previous.features + demand.features),
            defaults=previous.defaults or demand.defaults,
            all_features=previous.all_features or demand.all_features,
        )
    result[identity] = selected
    return result


def child(
    parent: LocalDemand,
    declaration: RustDependencyDeclaration,
    features: list[str],
    defaults: bool,
    substitutes: Dict[str, str] = {},
) -> Result[LocalDemand, str]:
    """
    Resolve an explicitly declared local path, checking its version and procedural-macro domain before selection.

    1. Locate the Loaf: the declared path, or the substitute for its package name.
    2. Its manifest names the package the edge asked for.
    3. Its version satisfies the requirement the edge states.
    4. A procedural macro is built for the host.
    """
    # 1. The Loaf is where the edge's path says, unless the build substitutes another for its package name.
    mut relative = ""
    match declaration.source:
        RustDependencySource.Path(path, _) => relative = path
        _ => return Err("local child requires a path declaration")
    mut located = Path(parent.project).joinpath(relative)
    if declaration.package in substitutes:
        located = Path(substitutes[declaration.package])
    path = located
        .resolve()
        .map_err((error) => f"{parent.project}: dependency `{declaration.alias}` at {located.0}: {error.message()}")?
    document = read_manifest(path)?
    # 2. The Loaf found is the package the edge asked for, so a path that now holds another Loaf is refused.
    named = names_package(parent, declaration)?
    if named and required_string(document, "project.name")? != declaration.package:
        return Err(f"local dependency {declaration.alias} has a different Loaf identity")
    # 3. An edge that states a version accepts only a Loaf of that version.
    if let Some(requirement) = declaration.version_requirement:
        version = required_string(document, "project.version")?
        if not version_matches(requirement, version, declaration.alias).map_err((error) => error.message())?:
            return Err(f"local dependency {declaration.alias} does not satisfy {requirement}")
    # 4. A procedural macro runs in the compiler, so it is built for the host, whatever the edge's own domain.
    mut domain = parent.domain
    if optional_string(document, "rust.type")? == Some("proc-macro"):
        domain = DependencyDomain.Host
    return Ok(LocalDemand(project=path.0, domain=domain, features=features, defaults=defaults))


def names_package(parent: LocalDemand, declaration: RustDependencyDeclaration) -> Result[bool, str]:
    """
    Whether the edge's package name must match the Loaf it reaches.

    An edge of `[dependencies]` that an Incan consumer declares by path only, without a `loaf` key, names no package.
    """
    if declaration.field[0] != "dependencies":
        return Ok(true)
    parent_manifest = read_manifest(Path(parent.project))?
    return Ok(optional_string(parent_manifest, f"dependencies.{declaration.alias}.loaf")? is not None)


def request(
    declaration: RustDependencyDeclaration,
    features: list[str],
    defaults: bool,
    name: str,
) -> Result[JsonValue, str]:
    """Project an active registry requirement using the resolver's public root exchange grammar."""
    mut version = ""
    match declaration.version_requirement:
        Some(selected) => version = selected
        None => return Err(f"registry dependency {declaration.alias} has no version requirement")
    return Ok(
        JsonValue.object(
            {"name": JsonValue.string(name), "loaf": JsonValue.string(declaration.package), "req": JsonValue.string(
                version,
            ), "features": JsonValue.array([JsonValue.string(feature) for feature in features]), "default-features": JsonValue.bool(
                defaults,
            ), "optional": JsonValue.bool(false)},
        ),
    )


pub model ActiveEdge:
    """One active dependency slot of a facet, with the features and defaults it selects."""

    pub declaration: RustDependencyDeclaration
    pub features: list[str]
    pub defaults: bool


pub model LocalEdge:
    """One active path edge of a local facet: the alias its code names and the facet it reaches."""

    pub alias: str
    pub project: str
    pub domain: DependencyDomain

    def key(self) -> str:
        """The key of the facet this edge reaches, as `LocalFacet.key` gives it."""
        return f"{self.project}@{self.domain.value()}"


pub model LocalFacet:
    """One local Loaf's Rust facet as the graph selects it: its features and its active edges."""

    pub project: str
    pub domain: DependencyDomain
    pub features: list[str]
    # Active path edges to other local facets.
    pub local: list[LocalEdge]
    # Active registry edges, each as a root request of the resolver's grammar.
    pub registry: list[JsonValue]
    # The aliases of the active registry edges, in the order of `registry`.
    pub registry_aliases: list[str]

    def key(self) -> str:
        """What names the facet in a build: its project and compilation domain."""
        return f"{self.project}@{self.domain.value()}"


model FacetSelection:
    """One demand's activated facet and child requests, retained only during graph selection."""

    demand: LocalDemand
    facet: LocalFacet
    children: list[LocalDemand]


pub def local_facets(
    root: LocalDemand,
    configuration: TargetConfiguration,
    substitutes: Dict[str, str] = {},
) -> Result[list[LocalFacet], str]:
    """Select both languages' edges with one feature engine; substitutes replace packages wherever reached."""
    mut demands: Dict[str, LocalDemand] = {}
    demands = add(demands, root)
    mut previous: Dict[str, LocalDemand] = {}
    mut facets: list[LocalFacet] = []
    mut selected: Dict[str, FacetSelection] = {}
    while demands != previous:
        previous = demands
        facets = []
        for identity in sorted([name for name in previous.keys()]):
            demand = previous[identity]
            if identity not in selected or selected[identity].demand != demand:
                facet, children = facet_of(demand, configuration, substitutes)?
                selected[identity] = FacetSelection(demand=demand, facet=facet, children=children)
            choice = selected[identity]
            facets.append(choice.facet)
            for child_demand in choice.children:
                demands = add(demands, child_demand)
    return Ok(facets)


def activated(
    demand: LocalDemand,
    configuration: TargetConfiguration,
) -> Result[Tuple[TomlValue, list[str], list[ActiveEdge]], str]:
    """
    One facet's manifest, catalog, effective features and active edges with the features each requests.

    1. Read the facet's manifest and catalog.
    2. Activate the unit's slots for the demanded features.
    3. Each active slot becomes an edge with the features and defaults it selects.
    """
    # 1. The authored manifest is the only feature and dependency authority.
    document = read_manifest(Path(demand.project))?
    inputs = catalog(document)?
    requested = requested_features(demand, inputs)
    # 2. The slots are activated for the features demanded and for the domain the demand is built in.
    context = ActivationContext(
        host=configuration,
        target=configuration,
        purpose=ActivationPurpose.Normal,
        domain=demand.domain,
        requested_features=requested,
        default_features=demand.defaults,
        build_unit_present=false,
        explicit_optional_aliases=incan_optional_aliases(document)?,
    )
    activation = activate_unit(inputs, context, demand.project).map_err((e) => e.message())?
    # 3. An active slot becomes an edge with the features and defaults it selects; an inactive one is dropped.
    mut active: list[ActiveEdge] = []
    for slot in activation.slots:
        match slot.activation:
            SlotActivation.Inactive(_) => pass
            SlotActivation.Active(features, defaults, _) =>
                declared = inputs.dependencies[slot.index]
                active.append(ActiveEdge(declaration=declared, features=features, defaults=defaults))
    return Ok((document, activation.effective_features, active))


def requested_features(demand: LocalDemand, manifest: RustDependencyCatalog) -> list[str]:
    """The features a demand names, plus every feature the facet's own manifest declares when it asks for all."""
    if not demand.all_features:
        return demand.features
    return unique(demand.features + [name for name in manifest.features.keys()])


def facet_of(
    demand: LocalDemand,
    configuration: TargetConfiguration,
    substitutes: Dict[str, str],
) -> Result[Tuple[LocalFacet, list[LocalDemand]], str]:
    """
    One demand's facet, with its effective features and active edges, and the local demands its path edges make.

    1. Activate the facet's edges.
    2. A path edge reaches another local facet, which becomes a demand of its own.
    3. A registry edge becomes a request of the resolver's grammar.
    """
    # 1. Only the edges the demanded features activate take part in the facet.
    document, features, active = activated(demand, configuration)?
    mut local: list[LocalEdge] = []
    mut children: list[LocalDemand] = []
    mut registry: list[JsonValue] = []
    mut aliases: list[str] = []
    for active_edge in active:
        edge = active_edge.declaration
        edge_features = active_edge.features
        defaults = active_edge.defaults
        # 2 and 3. A path edge reaches a local facet that becomes a demand; a registry edge becomes a resolver request.
        match edge.source:
            RustDependencySource.Path(_, _) =>
                selected = child(demand, edge, edge_features, defaults, substitutes)?
                local.append(LocalEdge(alias=edge.alias, project=selected.project, domain=selected.domain))
                children.append(selected)
            RustDependencySource.Registry(_) =>
                registry.append(request(edge, edge_features, defaults, edge.alias)?)
                aliases.append(edge.alias)
            _ => return Err(f"unsupported native local source for {edge.alias}")
    facet = LocalFacet(
        project=demand.project,
        domain=demand.domain,
        features=features,
        local=local,
        registry=registry,
        registry_aliases=aliases,
    )
    return Ok((facet, children))
