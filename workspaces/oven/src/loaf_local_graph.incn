"""Select local compiler Loaf features and project their registry requests through the shared activation policy."""

from std import toml
from std.toml import TomlValue, TomlKind
from std.fs import Path
from std.json import JsonValue
from rust_source import RustDependencyCatalog, RustDependencyDeclaration, RustDependencyRole, RustDependencySource, RustRegistryRequest
from rust_activation import ActivationContext, ActivationPurpose, DependencyDomain, SlotActivation, TargetConfiguration, activate_unit, target_matches, version_matches
from intake import feature_declaration


@derive(Eq)
pub model LocalDemand:
    """Explicit local path, compilation domain, and monotonic incoming feature selection."""

    pub project: str
    pub domain: DependencyDomain
    pub features: list[str]
    pub defaults: bool


pub def unique(values: list[str]) -> list[str]:
    """Canonicalize feature requests without changing activation semantics."""
    mut result: list[str] = []
    for value in values:
        if value not in result:
            result.append(value)
    return sorted(result)


def optional_bool(value: TomlValue, key: str, fallback: bool) -> Result[bool, str]:
    """Use an omitted flag's documented default while preserving malformed-input failures."""
    match value.get_optional[bool](key).map_err((e) => e.message())?:
        Some(selected) => return Ok(selected)
        None => return Ok(fallback)


def declaration(alias: str, value: TomlValue, index: int, group: str = "dependencies") -> Result[RustDependencyDeclaration, str]:
    """Decode one Loaf edge without reading Cargo declarations or losing its target and optional policy."""
    mut package = alias
    mut version: Option[str] = None
    mut path: Option[str] = None
    mut features: list[str] = []
    mut target: Option[str] = None
    mut defaults = true
    mut optional = false
    if value.kind() == TomlKind.String:
        version = Some(value.as_str().map_err((e) => e.message())?)
    else:
        path = value.get_optional[str]("path").map_err((e) => e.message())?
        version = value.get_optional[str]("version").map_err((e) => e.message())?
        target = value.get_optional[str]("target").map_err((e) => e.message())?
        defaults = optional_bool(value, "default-features", true)?
        optional = optional_bool(value, "optional", false)?
        if let Some(selected) = value.get_optional[list[str]]("features").map_err((e) => e.message())?:
            features = selected
        if let Some(selected) = value.get_optional[str]("package").map_err((e) => e.message())?:
            package = selected
        if let Some(selected) = value.get_optional[str]("loaf").map_err((e) => e.message())?:
            package = selected
    if group == "rust-dependencies" and path is None:
        package = f"crates-io/{package}"
    mut source = RustDependencySource.Registry(RustRegistryRequest.Default)
    if let Some(relative) = path:
        source = RustDependencySource.Path(relative, RustRegistryRequest.Default)
    return Ok(RustDependencyDeclaration(
        index=index, field=[group, alias], role=RustDependencyRole.Normal,
        target_condition=target,
        alias=alias, package=package,
        version_requirement=version,
        features=features, default_features=Some(defaults),
        optional=Some(optional), source=source,
    ))


pub def catalog(document: TomlValue) -> Result[RustDependencyCatalog, str]:
    """Build the existing activation catalog from converted Loaf declarations, including target alternatives."""
    root = document.as_table().map_err((e) => e.message())?
    mut dependencies: list[RustDependencyDeclaration] = []
    for group in ["dependencies", "rust-dependencies"]:
        if group not in root:
            continue
        table = root[group].as_table().map_err((e) => e.message())?
        for alias in sorted([key for key in table.keys()]):
            value = table[alias]
            if group == "dependencies" and value.kind() == TomlKind.Table:
                entry = value.as_table().map_err((e) => e.message())?
                if "path" in entry and "loaf" not in entry:
                    continue
            if value.kind() == TomlKind.Array:
                for alternative in value.as_array().map_err((e) => e.message())?:
                    dependencies.append(declaration(alias, alternative, len(dependencies), group)?)
            else:
                dependencies.append(declaration(alias, value, len(dependencies), group)?)
    mut features: Dict[str, list[str]] = {}
    project = root["project"].as_table().map_err((e) => e.message())?
    if "features" in project:
        selected = project["features"].as_table().map_err((e) => e.message())?
        for name in sorted([key for key in selected.keys()]):
            declared = feature_declaration(selected[name], "loaf.toml", ["project", "features", name]).map_err((e) => e.message())?
            mut entries = declared.includes
            for alias in declared.optional_dependencies:
                entries.append(f"dep:{alias}")
            for alias in sorted([key for key in declared.dependency_features.keys()]):
                for feature in declared.dependency_features[alias]:
                    entries.append(f"{alias}/{feature}")
            features[name] = entries
    return Ok(RustDependencyCatalog(document=document, dependencies=dependencies, features=features, library_name=None))


def key(demand: LocalDemand) -> str:
    """Keep host and target requests separate even when both triples are native."""
    return f"{demand.project}@{demand.domain.value()}"


def add(demands: Dict[str, LocalDemand], demand: LocalDemand) -> Dict[str, LocalDemand]:
    """Merge incoming local features and defaults monotonically; the caller observes whether another round is needed."""
    mut result = demands
    identity = key(demand)
    mut selected = demand
    if identity in result:
        previous = result[identity]
        selected = LocalDemand(project=demand.project, domain=demand.domain, features=unique(previous.features + demand.features), defaults=previous.defaults or demand.defaults)
    result[identity] = selected
    return result


def child(parent: LocalDemand, declaration: RustDependencyDeclaration, features: list[str], defaults: bool, substitutes: Dict[str, str] = {}) -> Result[LocalDemand, str]:
    """Resolve an explicitly declared local path, checking its version and procedural-macro domain before selection."""
    mut relative = ""
    match declaration.source:
        RustDependencySource.Path(path, _) => relative = path
        _ => return Err("local child requires a path declaration")
    mut located = Path(parent.project).joinpath(relative)
    if declaration.package in substitutes:
        located = Path(substitutes[declaration.package])
    path = located.resolve().map_err((e) => f"{parent.project}: dependency `{declaration.alias}` at {located.0}: {e.message()}")?
    source = path.joinpath("loaf.toml").read_text("utf-8", "strict").map_err((e) => e.message())?
    document = toml.parse(source).map_err((e) => e.message())?
    if document.get[str]("project.name").map_err((e) => e.message())? != declaration.package:
        return Err(f"local dependency {declaration.alias} has a different Loaf identity")
    if let Some(requirement) = declaration.version_requirement:
        version = document.get[str]("project.version").map_err((e) => e.message())?
        if not version_matches(requirement, version, declaration.alias).map_err((e) => e.message())?:
            return Err(f"local dependency {declaration.alias} does not satisfy {requirement}")
    mut domain = parent.domain
    if document.get_optional[str]("rust.type").map_err((e) => e.message())? == Some("proc-macro"):
        domain = DependencyDomain.Host
    return Ok(LocalDemand(project=path.0, domain=domain, features=features, defaults=defaults))


def request(declaration: RustDependencyDeclaration, features: list[str], defaults: bool, name: str) -> Result[JsonValue, str]:
    """Project an active registry requirement using the resolver's public root exchange grammar."""
    mut version = ""
    match declaration.version_requirement:
        Some(selected) => version = selected
        None => return Err(f"registry dependency {declaration.alias} has no version requirement")
    return Ok(JsonValue.object({
        "name": JsonValue.string(name), "loaf": JsonValue.string(declaration.package), "req": JsonValue.string(version),
        "features": JsonValue.array([JsonValue.string(feature) for feature in features]),
        "default-features": JsonValue.bool(defaults), "optional": JsonValue.bool(false),
    }))


def predicates(document: TomlValue, configuration: TargetConfiguration, project: str) -> Result[list[JsonValue], str]:
    """Carry original local declaration positions through the registry lock's existing predicate wire format."""
    mut selected: list[JsonValue] = []
    inputs = catalog(document)?
    for edge in inputs.dependencies:
        if let Some(condition) = edge.target_condition:
            matched = target_matches(condition, configuration, project, edge.field).map_err((e) => e.message())?
            selected.append(JsonValue.object({
                "declaration": JsonValue.int(edge.index), "target": JsonValue.string(condition),
                "matches": JsonValue.bool(matched),
            }))
    return Ok(selected)


pub model ActiveEdge:
    """One active dependency slot of a facet, with the features and defaults it selects."""

    pub declaration: RustDependencyDeclaration
    pub features: list[str]
    pub defaults: bool


pub model LocalEdge:
    """One active path edge of a local facet: the alias its code names and the facet it reaches."""

    pub alias: str
    pub project: str
    pub domain: DependencyDomain


pub model LocalFacet:
    """One local Loaf's Rust facet as the graph selects it: its features and its active edges."""

    pub project: str
    pub domain: DependencyDomain
    pub features: list[str]
    pub target_predicates: list[JsonValue]
    # Active path edges to other local facets.
    pub local: list[LocalEdge]
    # Active registry edges, each as a root request of the resolver's grammar.
    pub registry: list[JsonValue]
    # The aliases of the active registry edges, in the order of `registry`.
    pub registry_aliases: list[str]


pub def local_facets(
    root: LocalDemand,
    configuration: TargetConfiguration,
    root_environment: Option[TomlValue] = None,
    substitutes: Dict[str, str] = {},
) -> Result[list[LocalFacet], str]:
    """Select one shared graph of local facets. A canonically resolved environment replaces only the root's slots, and
    a substitute replaces the Loaf of its package name wherever the graph reaches it."""
    mut demands: Dict[str, LocalDemand] = {}
    demands = add(demands, root)
    mut previous: Dict[str, LocalDemand] = {}
    mut facets: list[LocalFacet] = []
    while demands != previous:
        previous = demands
        facets = []
        for identity in sorted([name for name in previous.keys()]):
            demand = previous[identity]
            mut environment: Option[TomlValue] = None
            if identity == key(root):
                environment = root_environment
            facet, children = facet_of(demand, configuration, environment, substitutes)?
            facets.append(facet)
            for child_demand in children:
                demands = add(demands, child_demand)
    return Ok(facets)


def activated(demand: LocalDemand, configuration: TargetConfiguration, environment: Option[TomlValue]) -> Result[Tuple[TomlValue, list[str], list[ActiveEdge]], str]:
    """One facet's manifest, catalog, effective features and active edges with the features each requests."""
    path = Path(demand.project).joinpath("loaf.toml")
    source = path.read_text("utf-8", "strict").map_err((e) => e.message())?
    document = toml.parse(source).map_err((e) => e.message())?
    mut inputs = catalog(document)?
    mut authority: Option[RustDependencyCatalog] = None
    mut purpose = ActivationPurpose.Normal
    if let Some(selected) = environment:
        authority = Some(inputs)
        inputs = catalog(selected)?
        purpose = ActivationPurpose.Test
    context = ActivationContext(host=configuration, target=configuration, purpose=purpose,
        domain=demand.domain, requested_features=demand.features, default_features=demand.defaults, build_unit_present=false)
    activation = activate_unit(inputs, context, demand.project, authority).map_err((e) => e.message())?
    mut active: list[ActiveEdge] = []
    for slot in activation.slots:
        match slot.activation:
            SlotActivation.Inactive(_) => pass
            SlotActivation.Active(features, defaults, _) => active.append(ActiveEdge(declaration=inputs.dependencies[slot.index], features=features, defaults=defaults))
    return Ok((document, activation.effective_features, active))


def facet_of(demand: LocalDemand, configuration: TargetConfiguration, environment: Option[TomlValue], substitutes: Dict[str, str]) -> Result[Tuple[LocalFacet, list[LocalDemand]], str]:
    """One demand's facet, with its effective features and active edges, and the local demands its path edges make."""
    document, features, active = activated(demand, configuration, environment)?
    mut local: list[LocalEdge] = []
    mut children: list[LocalDemand] = []
    mut registry: list[JsonValue] = []
    mut aliases: list[str] = []
    for active_edge in active:
        edge = active_edge.declaration
        edge_features = active_edge.features
        defaults = active_edge.defaults
        match edge.source:
            RustDependencySource.Path(_, _) =>
                selected = child(demand, edge, edge_features, defaults, substitutes)?
                local.append(LocalEdge(alias=edge.alias, project=selected.project, domain=selected.domain))
                children.append(selected)
            RustDependencySource.Registry(_) =>
                registry.append(request(edge, edge_features, defaults, edge.alias)?)
                aliases.append(edge.alias)
            _ => return Err(f"unsupported native local source for {edge.alias}")
    facet = LocalFacet(
        project=demand.project, domain=demand.domain, features=features,
        target_predicates=predicates(document, configuration, demand.project)?,
        local=local, registry=registry, registry_aliases=aliases,
    )
    return Ok((facet, children))


pub def select(
    root: LocalDemand,
    configuration: TargetConfiguration,
    root_environment: Option[TomlValue] = None,
) -> Result[JsonValue, str]:
    """The selected graph as the resolver's root grammar: facets, target roots and host roots."""
    mut facets: list[JsonValue] = []
    mut roots: list[JsonValue] = []
    mut host_roots: list[JsonValue] = []
    for facet in local_facets(root, configuration, root_environment)?:
        facets.append(JsonValue.object({
            "project": JsonValue.string(facet.project), "domain": JsonValue.string(facet.domain.value()),
            "features": JsonValue.array([JsonValue.string(feature) for feature in facet.features]),
            "target": JsonValue.string(configuration.triple),
            "target_predicates": JsonValue.array(facet.target_predicates),
        }))
        for index in range(len(facet.registry)):
            name = f"{len(roots) + len(host_roots)}-{facet.registry_aliases[index]}"
            selected = facet.registry[index]
            renamed = JsonValue.object({
                "name": JsonValue.string(name),
                "loaf": selected.require("loaf").map_err((e) => e.message())?,
                "req": selected.require("req").map_err((e) => e.message())?,
                "features": selected.require("features").map_err((e) => e.message())?,
                "default-features": selected.require("default-features").map_err((e) => e.message())?,
                "optional": JsonValue.bool(false),
            })
            if facet.domain == DependencyDomain.Host:
                host_roots.append(renamed)
            else:
                roots.append(renamed)
    return Ok(JsonValue.object({"facets": JsonValue.array(facets), "roots": JsonValue.array(roots), "host-roots": JsonValue.array(host_roots)}))
