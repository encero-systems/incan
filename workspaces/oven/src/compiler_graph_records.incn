"""Atomic ranked-graph publication for compiler values, completed receipts and their forward and reverse edges."""

from std.encoding.hex import hexlify
from std.json import JsonValue
from std.primitives.hash import sha256
from pub::incan_platform.store import Snapshot, begin, commit, put
from pub::internal_models import ProducerRank, ProducerStage, encode_read_receipt, stage_name
from pub::internal_models.records import (
    ReadReceipt,
    ReadWitness,
    READ_SCHEMA,
    RecordKey,
    RecordRequest,
    RecordSelection,
    encode_record_key,
)
from files import json_text

const EVALUATION_SCHEMA: str = "incan.engine.evaluation/1"
const EDGE_SCHEMA: str = "incan.engine.read-edge/1"


pub model PublishedEvaluation:
    """The one selected generation and identities installed by a completed evaluation transaction."""

    pub snapshot: Snapshot
    pub value_key: str
    pub value_digest: str
    pub receipt_key: str
    pub receipt_root: str
    pub evaluation_key: str
    pub edge_count: int


model EdgeFact:
    """One compiler witness normalized once for the receipt and both graph directions."""

    kind: str
    target: str
    request: RecordRequest
    evidence: str


pub def publish_evaluation(
    selected: Snapshot,
    claim_key: str,
    rank: ProducerRank,
    value: bytes,
    receipt: ReadReceipt,
) -> Result[PublishedEvaluation, str]:
    """Publish a value, evaluation, completed receipt and both edge directions in one store transaction."""
    if claim_key == "" or receipt.scope.profile == "" or receipt.schema != READ_SCHEMA:
        return Err("a completed evaluation requires a claim, profile and read-receipt schema")
    if rank.namespace < 0 or rank.dependency < 0:
        return Err("a completed evaluation requires a nonnegative certified rank")
    value_key = encode_record_key(receipt.preparation.output)?
    value_digest = digest(value)
    edges = normalized_edges(receipt.witnesses)?
    receipt_bytes = encode_read_receipt(receipt)?
    receipt_root = digest(receipt_bytes)
    receipt_key = "incan.engine.receipt\t" + receipt_root
    evaluation_key = evaluation_record_key(receipt.scope.profile, value_key)
    evaluation = encode_evaluation(receipt.scope.profile, value_key, claim_key, value_digest, receipt_root, rank)?

    mut transaction = put(begin(selected), value_key, value)
    transaction = put(transaction, receipt_key, receipt_bytes)
    transaction = put(transaction, evaluation_key, evaluation)
    for index in range(len(edges)):
        edge = encode_edge(value_key, receipt.scope.profile, edges[index])?
        identity = digest(edge)
        transaction = put(transaction, f"incan.engine.edge-out\t{evaluation_key}\t{index}", edge)
        transaction = put(
            transaction,
            f"incan.engine.edge-in\t{edges[index].target}\t{edges[index].kind}\t{identity}",
            edge,
        )
    published = commit(transaction).map_err((error) => error.message())?
    return Ok(
        PublishedEvaluation(
            snapshot=published,
            value_key=value_key,
            value_digest=value_digest,
            receipt_key=receipt_key,
            receipt_root=receipt_root,
            evaluation_key=evaluation_key,
            edge_count=len(edges),
        ),
    )


pub def evaluation_record_key(profile: str, output: str) -> str:
    """Return the selected evaluation identity for one output under one exact producer profile."""
    identity = digest((profile + "\n" + output).encode("utf-8"))
    return "incan.engine.evaluation\t" + identity


def normalized_edges(witnesses: list[ReadWitness]) -> Result[list[EdgeFact], str]:
    """Normalize each successful read once so forward and reverse indexes cannot disagree."""
    mut edges: list[EdgeFact] = []
    for witness in witnesses:
        match witness:
            ReadWitness.Found(found, selection_digest) =>
                edges.append(
                    edge(
                        "present",
                        found.request,
                        found.revision + "\n" + found.semantic_digest + "\n" + selection_digest,
                    )?,
                )
            ReadWitness.Deleted(deleted) => edges.append(edge("deleted", deleted.request, deleted.revision)?)
            ReadWitness.Absent(absent) => edges.append(edge("absent", absent.request, absent.exclusion_digest)?)
            ReadWitness.Members(_, request, membership_digest, continuation) =>
                edges.append(edge("members", request, membership_digest + "\n" + continuation)?)
    return Ok(edges)


def edge(kind: str, request: RecordRequest, evidence: str) -> Result[EdgeFact, str]:
    """Bind one typed witness to the exact canonical target key and nonempty evidence."""
    if evidence == "":
        return Err("a graph edge requires witness evidence")
    return Ok(EdgeFact(kind=kind, target=encode_record_key(request.key)?, request=request, evidence=evidence))


def encode_evaluation(
    profile: str,
    output: str,
    claim_key: str,
    value_digest: str,
    receipt_root: str,
    rank: ProducerRank,
) -> Result[bytes, str]:
    """Encode the selected produced outcome and its rank without duplicating receipt witnesses."""
    document = JsonValue.object(
        {"schema": JsonValue.string(EVALUATION_SCHEMA), "outcome": JsonValue.string("produced"), "profile": JsonValue.string(
            profile,
        ), "output": JsonValue.string(output), "claim_key": JsonValue.string(claim_key), "value_digest": JsonValue.string(
            value_digest,
        ), "receipt_root": JsonValue.string(receipt_root), "rank_namespace": JsonValue.int(rank.namespace), "rank_stage": JsonValue.string(
            stage_name(rank.stage),
        ), "rank_dependency": JsonValue.int(rank.dependency)},
    )
    return Ok(json_text(document)?.encode("utf-8"))


def encode_edge(reader: str, profile: str, edge: EdgeFact) -> Result[bytes, str]:
    """Encode one edge value shared byte-for-byte by its outgoing and incoming indexes."""
    document = JsonValue.object(
        {"schema": JsonValue.string(EDGE_SCHEMA), "reader": JsonValue.string(reader), "profile": JsonValue.string(
            profile,
        ), "kind": JsonValue.string(edge.kind), "target": JsonValue.string(edge.target), "selection": selection_document(
            edge.request,
        ), "evidence": JsonValue.string(edge.evidence)},
    )
    return Ok(json_text(document)?.encode("utf-8"))


def selection_document(request: RecordRequest) -> JsonValue:
    """Encode the exact field, payload range or bounded member selector for edge validation."""
    match request.selection:
        RecordSelection.Field(name) =>
            return JsonValue.object({"kind": JsonValue.string("field"), "name": JsonValue.string(name)})
        RecordSelection.Payload(payload) =>
            return JsonValue.object(
                {"kind": JsonValue.string("payload"), "reference": JsonValue.string(payload.reference), "offset": JsonValue.int(
                    payload.offset,
                ), "length": JsonValue.int(payload.length)},
            )
        RecordSelection.Members(members) =>
            return JsonValue.object(
                {"kind": JsonValue.string("members"), "selector": JsonValue.string(members.selector), "order": JsonValue.string(
                    members.order,
                ), "lower": JsonValue.string(members.lower), "upper": JsonValue.string(members.upper), "continuation": JsonValue.string(
                    members.continuation,
                )},
            )


def digest(value: bytes) -> str:
    """Return one lowercase content identity."""
    return hexlify(sha256.digest(value))
