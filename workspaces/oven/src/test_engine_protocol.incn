def kind(result: Result[Header, Refusal]) -> Option[RefusalKind]:
    """Retain a typed header refusal for exact category assertions."""
    match result:
        Ok(_) => return None
        Err(refusal) => return Some(refusal.kind)


pub def test_header_round_trip_and_malformed_frames() -> Result[None, str]:
    """The exact 64-byte layout survives round trips; malformed fields fail closed before payload reads."""
    check_short_transport()?
    check_bodies()?
    header = Header(tag=3, session=zero_id(), request=zero_id(), sequence=72623859790382856u64, length=65536)
    raw = encode_header(header).map_err((error) => error.detail)?
    assert len(raw) == 64
    assert raw[:8] == "INCENG01".encode("utf-8")
    assert raw[48:56] == scalar(72623859790382856, 8)
    decoded = decode_header(raw).map_err((error) => error.detail)?
    assert decoded.sequence == header.sequence
    assert decoded.length == 65536
    assert decoded.request == header.request
    assert kind(decode_header(raw[:63])) == Some(RefusalKind.ShortRead)
    assert kind(decode_header(joined(["BADMAGIC".encode(), raw[8:]]))) == Some(RefusalKind.BadMagic)
    assert kind(decode_header(joined([raw[:8], scalar(2, 2), raw[10:]]))) == Some(RefusalKind.Version)
    assert kind(decode_header(joined([raw[:56], scalar(65537, 4), raw[60:]]))) == Some(RefusalKind.Oversized)
    assert kind(decode_header(joined([raw[:60], scalar(1, 4)]))) == Some(RefusalKind.Reserved)
    assert kind(decode_header(joined([raw[:14], scalar(2, 2), raw[16:]]))) == Some(RefusalKind.Flags)
    return Ok(None)


pub def test_credit_back_pressure_and_control_lane() -> Result[None, str]:
    """The ninth data frame stays with its caller; cancellation and exact acknowledgments still pass."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("e.sock").0
    mut listener = listen(path, true)?
    mut client = Channel(transport=dial(path)?)
    mut server = Channel(transport=listener.accept()?)
    for _index in range(8):
        match client.send(zero_id(), Message.Event(Event(status="progress", trace_handle=""))).map_err(detail)?:
            SendOutcome.Sent(_) => pass
            SendOutcome.Blocked =>
                assert false, "initial data credit blocked"
    blocked = client.send(zero_id(), Message.Event(Event(status="ninth", trace_handle=""))).map_err(detail)?
    match blocked:
        SendOutcome.Blocked => pass
        SendOutcome.Sent(_) =>
            assert false, "ninth frame was sent without credit"
    assert client.sent == 8
    assert client.pending.held() == 8
    _ = client.send(zero_id(), Message.Cancel(Cancel(interest_token="interest"))).map_err(detail)?
    first = server.receive().map_err(detail)?
    server.acknowledge(first).map_err(detail)?
    acknowledged = client.receive().map_err(detail)?
    match client.send(zero_id(), Message.Event(Event(status="resumed", trace_handle=""))).map_err(detail)?:
        SendOutcome.Blocked =>
            assert false, "acknowledged credit did not resume the sender"
        SendOutcome.Sent(_) => pass
    for _index in range(7):
        consumed = server.receive().map_err(detail)?
        server.acknowledge(consumed).map_err(detail)?
    cancel = server.receive().map_err(detail)?
    match cancel.message:
        Message.Cancel(value) =>
            assert value.interest_token == "interest"
        _ =>
            assert false, "control frame was lost behind exhausted data credits"
    # An acknowledgment that names no outstanding frame returns no credit and retires the connection.
    forged = server.send(zero_id(), Message.Ack(Ack(sequence=99u64))).map_err(detail)?
    for _index in range(7):
        returned = client.receive().map_err(detail)?
    match client.receive():
        Ok(_) =>
            assert false, "a forged acknowledgment returned a credit"
        Err(reason) =>
            assert reason.kind == RefusalKind.Credit
    assert client.retired
    return Ok(None)


def detail(refusal: Refusal) -> str:
    """Expose typed test failures through the Oven harness's textual error boundary."""
    return refusal.detail


pub def test_service_handshake_drain_and_idle() -> Result[None, str]:
    """Full identities gate admission, drain settles existing work, and every live interest prevents idle exit."""
    admission = scratch_directory()?
    store = admission.path().joinpath("store")
    store.mkdir(true, true).map_err((error) => error.message())?
    installed = service_identity(store)?
    prefix = toolchain_directory()?.resolve().map_err((error) => error.message())?.0 + "/"
    count_work(prefix)
    assert snapshot(store).map_err((error) => error.message())?.generation == 0
    assert service_identity(store)?.compiler_generation == installed.compiler_generation
    repeated = finish_counting()
    assert repeated.stats == 0 and repeated.reads == 0 and repeated.hashes == 0, f"repeated service identity touched frozen inputs: stats={repeated.stats} reads={repeated.reads} hashes={repeated.hashes}"
    assert snapshot(store).map_err((error) => error.message())?.generation == 0
    admissions = durable_commits()
    other = admission.path().joinpath("another-store")
    other.mkdir(true, true).map_err((error) => error.message())?
    assert service_identity(other)?.compiler_generation == installed.compiler_generation
    assert durable_commits() == admissions, "a fresh store repeated installation admission in the same home"
    assert service_identity(Path(f"{store.0}/."))?.store_id == installed.store_id
    native = NativeUnit(identity="unit", payload="payload", binary="program")
    handle = program_handle("epoch", "compiler", "selection")?
    first_selection = select_program(store, "selection", native, handle)?
    repeat_selection = select_program(store, "selection", native, handle)?
    assert first_selection.encodings == 1 and first_selection.commits == 1
    assert repeat_selection.encodings == 0 and repeat_selection.commits == 0
    assert repeat_selection.snapshot.digest == first_selection.snapshot.digest
    check_collection_before_selection()?
    check_collection_during_execution()?
    process_lifecycle()?
    check_project_directory_selection()?
    check_worker_residency()?
    identity = Identity(
        store_id="store",
        profile="profile",
        service_generation="service",
        compiler_generation="compiler",
        uid=7u32,
    )
    mut state = ServiceState(identity=identity, last_active=100)
    state.negotiate(identity.hello(), 7u32).map_err(detail)?
    mut wrong = identity.hello()
    wrong.profile = "other"
    assert handshake_refused(state, wrong, 7u32)
    wrong = identity.hello()
    wrong.service_generation = "other"
    assert handshake_refused(state, wrong, 7u32)
    wrong = identity.hello()
    wrong.compiler_generation = "other"
    assert handshake_refused(state, wrong, 7u32)
    wrong = identity.hello()
    wrong.store_id = "other"
    assert handshake_refused(state, wrong, 7u32)
    assert handshake_refused(state, identity.hello(), 8u32)
    first = joined([scalar(1, 8), scalar(0, 8)])
    second = joined([scalar(2, 8), scalar(0, 8)])
    state.accept(first, "shared-work", "first").map_err(detail)?
    state.accept(second, "shared-work", "second").map_err(detail)?
    state.pin("reader").map_err(detail)?
    state.draining = true
    match state.accept(joined([scalar(3, 8), scalar(0, 8)]), "work", "third"):
        Ok(_) =>
            assert false, "draining service accepted another request"
        Err(refusal) =>
            assert refusal.kind == RefusalKind.Draining
    assert not state.exits(1000)
    state.detach(first, "first").map_err(detail)?
    assert len(state.interests) == 1
    assert state.interests[0].token == "second"
    state.detach(second, "second").map_err(detail)?
    assert not state.exits(1001)
    state.release("reader").map_err(detail)?
    assert state.exits(1002)
    mut idle = ServiceState(identity=identity, last_active=100)
    assert not idle.exits(101, 2)
    assert idle.exits(102, 2)
    idle.clients = 1
    assert not idle.exits(200, 2)
    idle.clients = 0
    idle.workers = 1
    assert not idle.exits(300, 2)
    idle.workers = 0
    idle.effects = 1
    assert not idle.exits(400, 2)
    idle.effects = 0
    assert not idle.exits(401, 2)
    assert idle.exits(402, 2)
    return Ok(None)


def handshake_refused(state: ServiceState, hello: Hello, uid: u32) -> bool:
    """Whether negotiation refused before accepting any work."""
    match state.negotiate(hello, uid):
        Ok(_) => return false
        Err(_) => return true


def check_project_directory_selection() -> Result[None, str]:
    """The records engine resolves a project directory to its declared main entry."""
    scratch = scratch_directory()?
    root = scratch.path()
    project = root.joinpath("project")
    project.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(
        project.joinpath("loaf.toml"),
        "[project]\nname = \"engine-project\"\nversion = \"0.1.0\"\n[project.scripts]\nmain = \"src/main.incn\"\n",
    )?
    write(project.joinpath("src/main.incn"), "def main() -> None:\n    println(\"hello\")\n")?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(project.0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    if not outcome.status.success() or outcome.stdout != b"hello\x0a" or outcome.stderr != b"":
        error = RustString.from_utf8(outcome.stderr).map_err((decode_error) => str(decode_error))?
        return Err(f"project records run: status={outcome.status.code()} stderr={error}")
    mut identity = service_identity(store)?
    identity.service_generation = fingerprint([binary, observe(Path(binary))?.stamp])?
    mut channel = connect_with(store, identity, binary).map_err(detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="project selection proof completed"))).map_err(detail)?
    stopped = channel.receive().map_err(detail)?
    match stopped.message:
        Message.Event(value) =>
            assert value.status == "Stopping"
        _ => return Err("project selection proof did not stop its engine")
    _ = channel.transport.close()
    return Ok(None)


def check_worker_residency() -> Result[None, str]:
    """One compiler serves both activations under a deep runtime path, retains no bulk manifests, and reads frozen records."""
    scratch = scratch_directory()?
    root = scratch.path()
    mut runtime = root.joinpath("var/folders/yd/1lgl20914vn4nhg0hgpjd4gr0000gn/T")
    while len(runtime.0) <= 100:
        runtime = runtime.joinpath("a-runtime-directory-deeper-than-a-socket-path-may-be")
    runtime.mkdir(true, true).map_err((error) => error.message())?
    fallback_runtime = get_or("XDG_RUNTIME_DIR", "/tmp")
    project = root.joinpath("project")
    project.mkdir(true, true).map_err((error) => error.message())?
    source = project.joinpath("hello.incn")
    write(source, "def main() -> None:\n    println(\"hello\")\n")?
    trace = root.joinpath("worker.trace")
    observations = root.joinpath("observations")
    observations.mkdir(true, true).map_err((error) => error.message())?
    _ = load_toolchain()?
    jec = root.joinpath("jec")
    jec.mkdir(true, true).map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", root.joinpath("store").0)
        .env("INCAN_NATIVE_TIMING", "1")
        .env("OVEN_TRACE", trace.0)
        .env("INCAN_ENGINE_TRACE", observations.0)
        .env("INCAN_JEC_TRACE", jec.0)
        .env("INCAN_ENGINE_RUN", "host-clock-proof")
        .env("INCAN_ENGINE_REQUEST", "worker-order")
        .env("INCAN_TRACE_DIR", observations.0)
        .env("TMPDIR", fallback_runtime)
        .env("XDG_RUNTIME_DIR", runtime.0)
        .output()
        .map_err((error) => str(error))?
    if not outcome.status.success() or outcome.stdout != b"hello\x0a" or outcome.stderr != b"":
        error = RustString.from_utf8(outcome.stderr).map_err((decode_error) => str(decode_error))?
        return Err(f"initial records run: status={outcome.status.code()} stderr={error}")
    initial_manifest_reads = invocation_count(observations, "incan_frontend::read_loaf_manifest")
    initial_record_reads = invocation_count(observations, "incan_frontend::read_compiler_records")
    initial_records = compiler_records_read(observations)?
    write(source, "def main() -> None:\n    println(\"hullo\")\n")?
    edited = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", root.joinpath("store").0)
        .env("INCAN_NATIVE_TIMING", "1")
        .env("OVEN_TRACE", trace.0)
        .env("INCAN_ENGINE_TRACE", observations.0)
        .env("INCAN_JEC_TRACE", jec.0)
        .env("INCAN_ENGINE_RUN", "host-clock-proof")
        .env("INCAN_ENGINE_REQUEST", "worker-order-edited")
        .env("INCAN_TRACE_DIR", observations.0)
        .env("TMPDIR", fallback_runtime)
        .env("XDG_RUNTIME_DIR", runtime.0)
        .output()
        .map_err((error) => str(error))?
    if not edited.status.success() or edited.stdout != b"hullo\x0a" or edited.stderr != b"":
        error = RustString.from_utf8(edited.stderr).map_err((decode_error) => str(decode_error))?
        return Err(f"edited records run: status={edited.status.code()} stderr={error}")
    manifest_reads = invocation_count(observations, "incan_frontend::read_loaf_manifest") - initial_manifest_reads
    if manifest_reads != 0:
        return Err(f"one-body edit reopened {manifest_reads} whole Loaf manifests")
    record_reads = invocation_count(observations, "incan_frontend::read_compiler_records") - initial_record_reads
    if record_reads > 6:
        return Err(f"one-body edit reconstructed {record_reads} compiler-record groups")
    records = compiler_records_read(observations)? - initial_records
    if records > 86:
        return Err(f"one-body edit opened {records} compiler records")
    processes = invocation_processes(observations, "incan_rustc_driver::compile_unit")?
    if processes != 1:
        return Err(f"initial build and one-body edit used {processes} unit compiler processes")
    # Stop this test's disposable engine before the temporary directory leaves scope.
    store = root.joinpath("store")
    mut identity = service_identity(store)?
    identity.service_generation = fingerprint([binary, observe(Path(binary))?.stamp])?
    mut channel = connect_with(store, identity, binary).map_err(detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="retirement proof completed"))).map_err(detail)?
    stopped = channel.receive().map_err(detail)?
    match stopped.message:
        Message.Event(value) =>
            assert value.status == "Stopping"
        _ => return Err("retirement proof did not stop its engine")
    _ = channel.transport.close()
    check_frozen_installation_reads(jec)?
    # Stop acknowledges that the resident service drained its buffered observations.
    lines = trace.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n")
    waits = len([line for line in lines if "worker_observer_joined" in line])
    detached = len([line for line in lines if "worker_observer_detached" in line])
    releases = len([line for line in lines if "worker_heap_released" in line])
    # Both activations restore the same resident worker and release its free heap before the next request.
    assert waits == 2 and detached == 0 and releases == 2, f"worker monitor: {waits} joins, {detached} detachments, {releases} heap releases"
    released_requests = [line for line in lines if "engine request released:" in line]
    assert len(released_requests) == 2, "request teardown did not release its payload verification observations"
    assert "captures=0 verification=0" in released_requests[0]
    check_worker_clock(observations)?
    return Ok(None)


def invocation_count(directory: Path, function: str) -> int:
    """Count completed compiler invocation-span starts with the exact instrumented function name."""
    mut count = 0
    match directory.iterdir():
        Err(_) => return count
        Ok(entries) =>
            for entry in entries:
                if not entry.is_file():
                    continue
                match entry.read_text("utf-8", "strict"):
                    Err(_) => continue
                    Ok(text) =>
                        for line in text.split("\n"):
                            if line == "":
                                continue
                            match parse(line):
                                Err(_) => continue
                                Ok(document) =>
                                    if (
                                        json_text_is(document, "kind", "begin")
                                        and json_text_is(document, "function", function)
                                    ):
                                        count += 1
    return count


def compiler_records_read(directory: Path) -> Result[int, str]:
    """Sum the independently addressed values opened by completed compiler-record group demands."""
    mut count = 0
    for entry in directory.iterdir().map_err((error) => error.message())?:
        if not entry.is_file():
            continue
        text = entry.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in text.split("\n"):
            if line == "":
                continue
            document = parse(line).map_err((error) => error.message())?
            if (
                not json_text_is(document, "kind", "begin")
                or not json_text_is(document, "function", "incan_frontend::read_compiler_records")
            ):
                continue
            fields = document.require("fields").map_err((error) => error.message())?.expect_object().map_err(
                (error) => error.message(),
            )?
            count += fields["records"].expect_int().map_err((error) => error.message())?
    return Ok(count)


def invocation_processes(directory: Path, function: str) -> Result[int, str]:
    """Count invocation files containing the requested compiler entry; one resident process owns one such file."""
    mut count = 0
    for entry in directory.iterdir().map_err((error) => error.message())?:
        if not entry.is_file():
            continue
        text = entry.read_text("utf-8", "strict").map_err((error) => error.message())?
        mut found = false
        for line in text.split("\n"):
            if line == "":
                continue
            document = parse(line).map_err((error) => error.message())?
            if (
                json_text_is(document, "kind", "begin")
                and json_text_is(document, "function", function)
            ):
                found = true
        if found:
            count += 1
    return Ok(count)


def json_text_is(document: JsonValue, key: str, expected: str) -> bool:
    """Whether one optional JSON field is text equal to `expected`, without comparing carrier values."""
    match document.get(key):
        None => return false
        Some(value) =>
            match value.as_str():
                None => return false
                Some(found) => return found == expected


model InstallationReadCounts:
    """Installation selections and completed engine requests grouped by their emitting process."""

    reused: int = 0
    service_requests: Dict[str, int] = {}
    page_selections: Dict[str, int] = {}
    reuse_processes: list[str] = []

    def observe(mut self, event: JsonValue, category: str) -> Result[None, str]:
        """Count one service request or installation-page selection from the compatibility trace."""
        process = str(trace_number(event, "process")?)
        if category == "engine_unit":
            self.service_requests[process] = self.service_requests.get(process, 0) + 1
        if category == "installation_page" or category == "installation_page_reuse":
            self.page_selections[process] = self.page_selections.get(process, 0) + 1
        if category == "installation_page_reuse":
            self.reused += 1
            self.reuse_processes.append(process)
        return Ok(None)

    def check(self) -> None:
        """Require one selection per request while the shared service reuses its decoded first-request page."""
        assert self.reused == 1, f"two service requests reused their process page {self.reused} times instead of once"
        process = self.reuse_processes[0]
        assert self.service_requests.get(process, 0) == 2, "the page reuse did not span the two service requests"
        assert self.page_selections.get(process, 0) == 2, "a service request selected its installation page more than once"


def check_frozen_installation_reads(directory: Path) -> Result[None, str]:
    """After first admission, a service request selects installed facts without touching a frozen input."""
    prefix = toolchain_directory()?.resolve().map_err((error) => error.message())?.0 + "/"
    mut events = 0
    mut reads = 0
    mut frozen_accesses = 0
    mut completed: Dict[str, int] = {}
    mut counts = InstallationReadCounts()
    for file in directory.iterdir().map_err((error) => error.message())?:
        for line in file.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
            if line == "":
                continue
            event = parse(line).map_err((error) => error.message())?
            events += 1
            category = trace_text(event, "category")?
            counts.observe(event, category)?
            process = str(trace_number(event, "process")?)
            if category in ["file_stat", "file_read", "file_hash"]:
                input = trace_text(event, "input")?
                if (input.startswith(prefix) or "/.rustup/" in input) and completed.get(process, 0) > 0:
                    frozen_accesses += 1
                    return Err(f"service process {process} {category} touched frozen input {input}")
            if category == "file_read":
                reads += 1
            if category == "engine_unit":
                completed[process] = completed.get(process, 0) + 1
    assert events > 0 and reads > 0, "the cold invocation must record its actual file reads"
    assert frozen_accesses == 0
    counts.check()
    return Ok(None)


def check_worker_clock(directory: Path) -> Result[None, str]:
    """The engine's request encloses its real compiler worker's activation on one host clock across two processes."""
    mut engines: list[JsonValue] = []
    mut workers: list[JsonValue] = []
    for file in directory.iterdir().map_err((error) => error.message())?:
        for line in file.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
            if line == "":
                continue
            row = parse(line).map_err((error) => error.message())?
            if not json_text_is(row, "operation", "driver_request"):
                continue
            assert trace_text(row, "clock")? == "host-monotonic-raw"
            assert trace_text(row, "run")? == "host-clock-proof"
            assert trace_text(row, "request")? == "worker-order"
            if trace_text(row, "producer")? == "compiler-worker":
                workers.append(row)
            else:
                engines.append(row)
    assert len(workers) > 0 and len(engines) > 0, "both engine and worker must produce trace records"
    for worker in workers:
        mut enclosed = false
        for engine in engines:
            if trace_number(engine, "process")? == trace_number(worker, "process")?:
                continue
            if trace_number(engine, "start_ns")? <= trace_number(worker, "start_ns")?:
                if trace_number(worker, "end_ns")? <= trace_number(engine, "end_ns")?:
                    enclosed = true
        assert enclosed, "worker timestamps must be inside the engine's request interval"
    return Ok(None)


def trace_text(row: JsonValue, key: str) -> Result[str, str]:
    """Read a required schema string without accepting an absent field."""
    return row.require(key).map_err((error) => error.message())?.expect_str().map_err((error) => error.message())


def trace_number(row: JsonValue, key: str) -> Result[int, str]:
    """Read a required nanosecond or process field without coercion."""
    return row.require(key).map_err((error) => error.message())?.expect_int().map_err((error) => error.message())


def check_collection_before_selection() -> Result[None, str]:
    """A published cold unit and a reused warm unit remain selectable when collection runs before selection."""
    scratch = scratch_directory()?
    root = scratch.path()
    project = root.joinpath("project")
    project.mkdir(true, true).map_err((error) => error.message())?
    source = project.joinpath("hello.incn")
    write(source, "def main() -> None:\n    println(\"hello\")\n")?
    store = root.joinpath("store")
    for turn in range(2):
        view = f"selection-{turn}"
        captured = prepare_submit(
            store,
            Submit(
                command="build",
                view=view,
                input_selection="debug",
                requested_roots=source.0,
                options="",
                observation_policy="",
            ),
        )?
        handle = program_handle(captured.identity, "collection-proof", view)?
        produced = obtain(
            store,
            captured.revision,
            handle,
            root.joinpath("console").0,
            Some(captured.epoch),
            "collection-proof",
        )?
        if produced.code != 0:
            console = root.joinpath("console.err").read_text("utf-8", "strict").map_err((error) => error.message())?
            return Err(f"turn {turn} refused with code {produced.code}: {console}")
        assert produced.evaluations == 1 - turn and produced.native_bakes == 1 - turn, f"turn {turn}: {produced.evaluations} evaluations, {produced.native_bakes} native bakes"
        mut group: list[Transaction] = []
        if let Some(transaction) = captured.transaction:
            group.append(transaction)
        if let Some(transaction) = produced.transaction:
            group.append(transaction)
        committed = commit_group(group).map_err((error) => error.message())?
        # The publication handle pins the result while no caller view has selected it.
        collect(store, -1)?
        match produced.unit:
            None => return Err("native publication had no unit")
            Some(unit) =>
                selected = select_program(store, view, unit, handle)?
                assert selected_program(selected.snapshot, handle)? == Some(unit), f"turn {turn} lost its selected program"
                ran = Command.new(unit.binary).output().map_err((error) => str(error))?
                assert ran.status.success() and ran.stdout == b"hello\x0a", f"turn {turn} selected an unusable program"
        assert committed.generation > 0, f"turn {turn} committed no store generation"
    return Ok(None)


def check_collection_during_execution() -> Result[None, str]:
    """
    A running program keeps executing from its selected view while collection retires obsolete layouts.

    The program stops at a barrier: it writes `started`, waits until the test writes `release`, then writes `finished`.
    While it waits, the test supersedes the store's generation and collects it. Collection must remove obsolete layouts
    without retiring the running program's own, so the program still finishes and exits cleanly. The first turn runs
    the program cold, the second warm from the store.

    1. Write the barrier program.
    2. Each turn: run it to the barrier, collect, release it, and check that it finished.
    3. Stop the engine the runs started.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    barrier = Barrier(
        started=root.joinpath("started"),
        release=root.joinpath("release"),
        finished=root.joinpath("finished"),
    )
    # 1. The barrier's marker paths are written into the program as literals.
    source = write_barrier_program(root.joinpath("project"), barrier)?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    # 2. The program is alive at the barrier when collection runs; it must still finish once released.
    for _turn in range(2):
        mut child = run_to_barrier(binary, source, store, barrier)?
        collected = collect_superseded(store)
        alive = child.try_wait().map_err((error) => str(error))? is None
        write(barrier.release, "release")?
        status = child.wait().map_err((error) => str(error))?
        assert alive and status.success() and barrier.finished.is_file(), "collection affected a running view"
        assert collected?.layouts_removed > 0
        barrier.reset()?
    # 3. The records engine the runs started keeps serving until it is told to stop.
    return stop_engine(store, binary)


model Barrier:
    """The three marker files a barrier program and its test exchange."""

    started: Path
    release: Path
    finished: Path

    def reset(self) -> Result[None, str]:
        """Remove all three markers before the next turn."""
        self.started.unlink().map_err((error) => error.message())?
        self.release.unlink().map_err((error) => error.message())?
        self.finished.unlink().map_err((error) => error.message())?
        return Ok(None)


def write_barrier_program(project: Path, barrier: Barrier) -> Result[Path, str]:
    """Write a program that signals `started`, waits for `release`, then signals `finished`."""
    project.mkdir(true, true).map_err((error) => error.message())?
    started = json_text(JsonValue.string(barrier.started.0))?
    release = json_text(JsonValue.string(barrier.release.0))?
    finished = json_text(JsonValue.string(barrier.finished.0))?
    lines = [
        "from std.fs import Path",
        "from rust::std::thread import sleep",
        "from rust::std::time import Duration",
        "",
        "def main() -> Result[None, str]:",
        f"    Path({started}).write_text(\"started\", \"utf-8\", \"strict\", None).map_err((error) => error.message())?",
        f"    while not Path({release}).is_file():",
        "        sleep(Duration.from_millis(2))",
        f"    Path({finished}).write_text(\"finished\", \"utf-8\", \"strict\", None).map_err((error) => error.message())?",
        "    return Ok(None)",
    ]
    source = project.joinpath("hello.incn")
    write(source, "\n".join(lines) + "\n")?
    return Ok(source)


def run_to_barrier(binary: str, source: Path, store: Path, barrier: Barrier) -> Result[Child, str]:
    """
    Run the program on the records engine and wait up to 30 seconds for its `started` signal. A program that exits
    first, or never arrives, is released and reaped before the failure is returned.
    """
    mut child = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .spawn()
        .map_err((error) => str(error))?
    mut arrived = false
    for _poll in range(15000):
        if barrier.started.is_file():
            arrived = true
            break
        if child.try_wait().map_err((error) => str(error))? is not None:
            return Err("program exited before its execution lease could be tested")
        sleep(Duration.from_millis(2))
    # The child is handed out after the loop, where returning it moves it.
    if arrived:
        return Ok(child)
    write(barrier.release, "release")?
    child.kill().map_err((error) => str(error))?
    child.wait().map_err((error) => str(error))?
    return Err("program did not reach its execution barrier")


def stop_engine(store: Path, binary: str) -> Result[None, str]:
    """Stop the records engine serving `store`, and require its acknowledgment."""
    mut identity = service_identity(store)?
    identity.service_generation = fingerprint([binary, observe(Path(binary))?.stamp])?
    mut channel = connect_with(store, identity, binary).map_err(detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="execution collection proof completed"))).map_err(detail)?
    stopped = channel.receive().map_err(detail)?
    match stopped.message:
        Message.Event(value) =>
            assert value.status == "Stopping"
        _ => return Err("execution collection proof did not stop its engine")
    # Stop is acknowledged; peer withdrawal may race the local shutdown.
    _ = channel.transport.close()
    return Ok(None)


def collect_superseded(store: Path) -> Result[Collected, str]:
    """Supersede and compact layouts while another process holds an execution lease over the old generation."""
    fields = store.joinpath("CURRENT").read_text("utf-8", "strict").map_err((error) => error.message())?.strip().split(
        " ",
    )
    manifest = store.joinpath(f"snapshots/{fields[0]}.{fields[1][:16]}.manifest")
    for turn in range(4):
        commit(
            put(begin(snapshot(store).map_err((error) => error.message())?), "execution-test", str(turn).encode("utf-8")),
        ).map_err((error) => error.message())?
    compact(store).map_err((error) => error.message())?
    reclaimed = collect(store, -1)?
    assert manifest.is_file(), "collection discarded a running program's leased generation"
    return Ok(reclaimed)


def check_bodies() -> Result[None, str]:
    """Every message schema round trips byte for byte; bad versions, tags and lengths are refused."""
    messages = [
        Message.Hello(
            Hello(
                store_id="descriptor",
                profile="descriptor",
                service_generation="descriptor",
                compiler_generation="descriptor",
                peer_uid=1u32,
                credits=1,
                payload_limit=1,
            ),
        ),
        Message.Welcome(
            Welcome(
                store_id="descriptor",
                profile="descriptor",
                service_generation="descriptor",
                compiler_generation="descriptor",
                peer_uid=1u32,
                credits=1,
                payload_limit=1,
            ),
        ),
        Message.Submit(
            Submit(
                command="descriptor",
                view="descriptor",
                input_selection="descriptor",
                requested_roots="descriptor",
                options="descriptor",
                observation_policy="descriptor",
            ),
        ),
        Message.Accepted(Accepted(capture_token="descriptor", interest_token="descriptor")),
        Message.Captured(Captured(epoch="descriptor", snapshot="descriptor")),
        Message.Query(
            Query(snapshot="descriptor", query_root="descriptor", cursor="descriptor", row_limit=1, byte_limit=1),
        ),
        Message.Page(Page(snapshot="descriptor", rows_root="descriptor", cursor="descriptor")),
        Message.Event(Event(status="descriptor", trace_handle="descriptor")),
        Message.Complete(
            Complete(
                snapshot="descriptor",
                admission_proof="descriptor",
                result_handles="descriptor",
                binding_outcome=BindingOutcome.NotSelected,
                status=CompletionStatus.Unavailable,
                observation_handle="descriptor",
            ),
        ),
        Message.Cancel(Cancel(interest_token="descriptor")),
        Message.Cancelled(Cancelled(interest_token="descriptor", effects_stopped=EffectDisposition.NoEffects)),
        Message.Resolve(Resolve(transaction="descriptor", outcome=Resolution.Unknown)),
        Message.Pin(Pin(snapshot="descriptor", allowed_roots="descriptor", lease_id="descriptor", purpose="descriptor")),
        Message.Release(Release(lease_id="descriptor")),
        Message.Drain(Drain(reason="descriptor")),
        Message.Stop(Stop(reason="descriptor")),
        Message.Ack(Ack(sequence=1u64)),
        Message.Refused(Refused(code=1, command="descriptor", detail="descriptor")),
    ]
    for message in messages:
        tag, raw = encode(message).map_err(detail)?
        decoded = decode(tag, raw).map_err(detail)?
        again_tag, again_raw = encode(decoded).map_err(detail)?
        assert again_tag == tag
        assert again_raw == raw
        assert refused_body(decode(tag, raw[:len(raw) - 1]))
        assert refused_body(decode(tag, joined([raw, scalar(0, 1)])))
    assert refused_body(decode(16, joined([scalar(1, 2), scalar(0, 4), scalar(999, 2)])))
    assert refused_body(decode(15, joined([scalar(1, 2), scalar(0, 4), scalar(999, 2)])))
    for worker_record_tag in [6, 7, 8, 9]:
        assert refused_body(decode(worker_record_tag, scalar(1, 2)))
    assert refused_body(decode(65535, scalar(1, 2)))
    assert refused_body(decode(1, scalar(2, 2)))
    assert refused_body(decode(1, joined([scalar(1, 2), scalar(4294967295, 4)])))
    return Ok(None)


def refused_body(decoded: Result[Message, Refusal]) -> bool:
    """Whether a body was refused before an unvalidated allocation or unknown variant dispatch."""
    match decoded:
        Ok(_) => return false
        Err(_) => return true


def process_lifecycle() -> Result[None, str]:
    """Two real starters share one lifetime lock; drain settles requests and a disconnected idle service exits."""
    mut configured = spawn_detached(
        "/bin/sh",
        ["-c", "test \"$INCAN_PROCESS_PROBE\" = selected"],
        {"INCAN_PROCESS_PROBE": "selected"},
    )?
    await_exit(configured, true)?
    scratch = scratch_directory()?
    root = scratch.path()
    root.joinpath("project").mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("project/hello.incn")
    write(source, "def main() -> None:\n    println(\"hello\")\n")?
    identity = Identity(
        store_id="process-store",
        profile="v1",
        service_generation="service",
        compiler_generation="compiler",
        uid=owner_uid(root).map_err(detail)?,
    )
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    mut first = launch_service(binary, root, identity)?
    mut second = launch_service(binary, root, identity)?
    mut silent = await_connection(root, identity)?
    mut channel = await_service(root, identity)?
    # The handshake bound ended with the handshake: this client waits for its build as long as a command does.
    channel.transport.wait_at_most(600)
    silent.close()?
    peer = channel.transport.peer()?
    assert peer.pid == Some(first.pid()) or peer.pid == Some(second.pid())
    mut first_done = false
    mut second_done = false
    for _poll in range(2500):
        first_done = first.poll()? is not None
        second_done = second.poll()? is not None
        if first_done or second_done:
            break
        sleep(Duration.from_millis(2))
    assert first_done != second_done, "two concurrent starters did not yield exactly one live service"
    request = joined([scalar(1, 8), scalar(0, 8)])
    later = joined([scalar(2, 8), scalar(0, 8)])
    channel
        .send(
            request,
            Message.Submit(
                Submit(
                    command="build",
                    view="view",
                    input_selection="debug",
                    requested_roots=source.0,
                    options="",
                    observation_policy="",
                ),
            ),
        )
        .map_err(detail)?
    channel.send(zero_id(), Message.Drain(Drain(reason="test"))).map_err(detail)?
    channel
        .send(
            later,
            Message.Submit(
                Submit(
                    command="build",
                    view="view",
                    input_selection="inputs",
                    requested_roots="roots",
                    options="",
                    observation_policy="",
                ),
            ),
        )
        .map_err(detail)?
    mut accepted = false
    mut captured = false
    mut completed = false
    mut refused = false
    for _index in range(10):
        frame = channel.receive().map_err(detail)?
        match frame.message:
            Message.Accepted(_) => accepted = true
            Message.Captured(value) =>
                assert accepted
                assert len(value.epoch) == 64
                assert value.snapshot != ""
                captured = true
            Message.Complete(value) =>
                assert captured
                assert value.binding_outcome == BindingOutcome.Selected
                assert value.status == CompletionStatus.Success
                assert value.admission_proof.startswith("sha256:")
                # Capture, the shared unit and this caller's selection publish atomically once.
                publications = snapshot(root).map_err((error) => error.message())?.generation
                assert publications == 1, f"native request published {publications} generations instead of 1"
                completed = true
            Message.Refused(value) =>
                assert value.code == 13
                assert frame.header.request == later
                refused = true
            _ => pass
        channel.acknowledge(frame).map_err(detail)?
        if completed and refused:
            break
    assert accepted and captured and completed and refused
    channel.transport.close()?
    await_exit(first, not first_done)?
    await_exit(second, not second_done)?
    # A fresh service with a one-second timeout exits after its last client disconnects, without Drain.
    mut idle = launch_service(binary, root, identity)?
    mut idle_channel = await_service(root, identity)?
    check_unchanged_request(idle_channel, root, source)?
    another = root.joinpath("another-project")
    another.mkdir(true, true).map_err((error) => error.message())?
    copied_source = another.joinpath("hello.incn")
    write(copied_source, source.read_text("utf-8", "strict").map_err((error) => error.message())?)?
    for turn in range(50):
        check_service_reuse(idle_channel, root, copied_source, turn)?
    assert not another.joinpath("target/incan/observations").exists(), "a native hit repeated unit preparation"
    idle_channel.transport.close()?
    await_exit(idle, true)?
    return Ok(None)


def check_unchanged_request(mut channel: Channel, root: Path, source: Path) -> Result[None, str]:
    """The first rerun after projection publishes zero durable generations and performs zero capture encodings."""
    before = snapshot(root).map_err((error) => error.message())?
    request = joined([scalar(20, 8), scalar(0, 8)])
    submit = Submit(
        command="run",
        view="view",
        input_selection="debug",
        requested_roots=source.0,
        options="",
        observation_policy="",
    )
    captured = prepare_submit(root, submit)?
    assert captured.encodings == 0 and captured.commits == 0 and captured.identity_encodings == 0
    _ = channel.send(request, Message.Submit(submit)).map_err(detail)?
    mut complete = false
    for _index in range(8):
        frame = channel.receive().map_err(detail)?
        match frame.message:
            Message.Complete(value) =>
                assert value.status == CompletionStatus.Success
                assert snapshot(root).map_err((error) => error.message())?.generation == before.generation
                complete = true
            Message.Refused(value) => return Err(value.detail)
            _ => pass
        channel.acknowledge(frame).map_err(detail)?
        if complete:
            break
    assert complete
    release_service_result(channel, request)?
    return Ok(None)


def check_service_reuse(mut channel: Channel, root: Path, source: Path, turn: int) -> Result[None, str]:
    """A new virtual view reuses the prior build; its unchanged repeat also reads and hashes no source."""
    request = joined([scalar(3 + turn, 8), scalar(0, 8)])
    _ = channel
        .send(
            request,
            Message.Submit(
                Submit(
                    command="run",
                    view="second-view",
                    input_selection="debug",
                    requested_roots=source.0,
                    options="",
                    observation_policy="proofs",
                ),
            ),
        )
        .map_err(detail)?
    mut captured = false
    mut completed = false
    for _index in range(8):
        frame = channel.receive().map_err(detail)?
        match frame.message:
            Message.Captured(_) => captured = true
            Message.Complete(value) =>
                assert captured
                assert value.binding_outcome == BindingOutcome.Selected
                assert value.status == CompletionStatus.Success
                proof = parse(report(root, value.observation_handle)?).map_err((error) => error.message())?
                mut counters = ["unit_evaluations", "native_bakes"]
                if turn > 0:
                    counters.extend(["source_reads", "source_hashes", "epoch_reads"])
                else:
                    assert proof.require("epoch_reads").map_err((error) => error.message())?.expect_int().map_err(
                        (error) => error.message(),
                    )? == 0, "the new virtual view reread its already captured epoch"
                for name in counters:
                    assert proof.require(name).map_err((error) => error.message())?.expect_int().map_err(
                        (error) => error.message(),
                    )? == 0
                match read_program(root, value.result_handles)?:
                    None => return Err("completed program descriptor is missing")
                    Some(unit) =>
                        assert Path(f"{unit.binary}.native-shared.json").is_file()
                        output = Command.new(unit.binary).output().map_err((error) => str(error))?
                        assert output.status.success()
                        assert output.stdout == b"hello\x0a"
                completed = true
            Message.Refused(value) => return Err(value.detail)
            _ => pass
        channel.acknowledge(frame).map_err(detail)?
        if completed:
            break
    assert completed
    release_service_result(channel, request)?
    return Ok(None)


def release_service_result(mut channel: Channel, request: bytes) -> Result[None, str]:
    """A completed request releases its exact execution lease before another request uses the bounded control window."""
    token = f"{hexlify(channel.session)}:{hexlify(request)}"
    _ = channel.send(request, Message.Release(Release(lease_id=token))).map_err(detail)?
    for _index in range(8):
        frame = channel.receive().map_err(detail)?
        channel.acknowledge(frame).map_err(detail)?
        match frame.message:
            Message.Event(event) =>
                if event.status == "Released":
                    return Ok(None)
            Message.Refused(value) => return Err(value.detail)
            _ => pass
    return Err("service did not release the completed request")


def launch_service(binary: str, root: Path, identity: Identity) -> Result[Process, str]:
    """Launch this test's service against installed standard inputs, independent of the source-build override."""
    return spawn_detached(
        binary,
        [
            "--internal-engine",
            root.0,
            identity.store_id,
            identity.profile,
            identity.service_generation,
            identity.compiler_generation,
            "1",
        ],
        {"INCAN_STDLIB": ""},
    )


def await_service(root: Path, identity: Identity) -> Result[Channel, str]:
    """Wait for one of the two starters' endpoints, without starting a third process."""
    return handshake(Channel(transport=await_connection(root, identity)?), identity).map_err(detail)


def await_connection(root: Path, identity: Identity) -> Result[Connection, str]:
    """Wait for a transport to one of the two starters, without beginning its engine handshake."""
    selected = endpoint(root, identity).map_err(detail)?
    for _poll in range(2500):
        match dial(selected.socket):
            Ok(transport) => return Ok(transport)
            Err(_) => sleep(Duration.from_millis(2))
    return Err("test engine did not start")


def await_exit(mut child: Process, expected_success: bool) -> Result[None, str]:
    """Reap this test's child, killing only that child if the lifecycle deadline fails."""
    for _poll in range(2500):
        match child.poll()?:
            Some(status) =>
                assert status == expected_success
                return Ok(None)
            None => sleep(Duration.from_millis(2))
    child.terminate()?
    return Err("test engine did not exit")


def check_short_transport() -> Result[None, str]:
    """A peer disconnecting during the fixed header yields ShortRead and retires only its connection."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("short.sock").0
    mut listener = listen(path, true)?
    mut broken = dial(path)?
    broken.write_part("INCENG01".encode(), "truncated header")?
    broken.close()?
    mut receiver = Channel(transport=listener.accept()?)
    match receiver.receive():
        Ok(_) =>
            assert false, "short transport header was admitted"
        Err(reason) =>
            assert reason.kind == RefusalKind.ShortRead
    assert receiver.retired
    return Ok(None)
