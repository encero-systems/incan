static observed_work: dict[str, int] = {}


def text(found: Result[Lookup, StoreError]) -> str:
    """A lookup as text: the value, `<deleted>`, `<absent>`, or `<integrity>` and the like for an error."""
    match found:
        Err(error) => return f"<{error.kind}>"
        Ok(outcome) =>
            match outcome:
                Lookup.Found(value) =>
                    match RustString.from_utf8(owned(value)):
                        Ok(decoded) => return str(decoded)
                        Err(_) => return "<bytes>"
                Lookup.Deleted => return "<deleted>"
                Lookup.Absent => return "<absent>"


def write_one(root: Path, key: str, value: str, expect: int = 0) -> Result[Snapshot, StoreError]:
    """Commit one value on the latest generation."""
    return commit(put(begin(snapshot(root)?), key, value.encode("utf-8"), expect))


def added_segment(before: Snapshot, after: Snapshot) -> Result[str, str]:
    """The one segment `after` reaches that `before` does not: the segment its commit wrote."""
    earlier = segments(before).map_err((error) => error.message())?
    added = [name for name in segments(after).map_err((error) => error.message())? if name not in earlier]
    if len(added) != 1:
        return Err(f"a commit reached {len(added)} new segments")
    return Ok(added[0])


def error_kind(result: Result[Snapshot, StoreError]) -> str:
    """The kind of a commit's error, or `ok`."""
    match result:
        Ok(_) => return "ok"
        Err(error) => return error.kind


def count_files(directory: Path) -> int:
    """How many entries a directory holds; zero when it does not exist."""
    if not directory.is_dir():
        return 0
    match directory.iterdir():
        Ok(entries) => return len(entries)
        Err(_) => return 0


def placement_trace(root: StorePath) -> Result[list[str], str]:
    """
    Exercise the placement-independent record, transaction, snapshot and fork contract once.

    The same function receives a disk root and an isolated memory root, so neither placement can substitute a second
    transaction engine or a placement-specific expected result.
    """
    empty = placed_snapshot(root).map_err((error) => error.message())?
    first = commit(put(begin(empty), "a", b"one")).map_err((error) => error.message())?
    held = first
    second = commit(put(begin(first), "a", b"two")).map_err((error) => error.message())?
    mut preview = fork(second, "preview").map_err((error) => error.message())?
    preview = commit(put(begin(preview), "b", b"branch")).map_err((error) => error.message())?
    home = placed_snapshot(root).map_err((error) => error.message())?
    unchanged = commit(put(begin(home), "a", b"two")).map_err((error) => error.message())?
    deleted = commit(delete(begin(home), "a")).map_err((error) => error.message())?
    return Ok(
        [
            text(lookup(held, "a")),
            text(lookup(second, "a")),
            text(lookup(preview, "a")),
            text(lookup(preview, "b")),
            text(lookup(home, "b")),
            str(unchanged.generation == home.generation),
            text(lookup(deleted, "a")),
        ],
    )


pub def test_disk_and_memory_placements_share_one_transaction_engine() -> Result[None, str]:
    """
    Disk and memory placements produce the same logical outcomes; memory creates no file or temporary artifact.

    The memory placement owns immutable objects and roots in its state cell, while disk retains the qualified v3
    layout and durability operations behind the same `StorePath` seam.
    """
    scratch = scratch_directory()?
    before = count_files(scratch.path())
    memory = placement_trace(memory_root())?
    assert count_files(scratch.path()) == before, "the memory placement touched the scratch directory"
    disk = placement_trace(store_path(scratch.path().joinpath("disk")))?
    assert memory == disk
    return Ok(None)


pub def test_a_snapshot_keeps_its_generation_and_reads_tell_values_tombstones_and_absence_apart() -> Result[None, str]:
    """
    A reader's snapshot answers from its own generation; a tombstone is not absence, and a full key is not its locator.
    A caller-supplied observer sees publication work independently of the store's consumer.

    1. An empty store is generation 0, and every key is absent.
    2. Each commit adds one generation; a snapshot taken earlier still answers from its own.
    3. A deleted key answers `Deleted`; a never-written key answers `Absent`.
    """
    scratch = scratch_directory()?
    verify_work_observer(scratch.path().joinpath("observed"))?
    root = scratch.path().joinpath("store")
    empty = snapshot(root).map_err((error) => error.message())?
    assert empty.generation == 0
    assert not root.exists(), "opening an absent store created control files"
    root.mkdir(true, true).map_err((error) => error.message())?
    assert snapshot(root).map_err((error) => error.message())?.generation == 0
    assert len(root.iterdir().map_err((error) => error.message())?) == 0, "opening an empty directory changed it"
    empty_lease = lease(empty).map_err((error) => error.message())?
    assert text(lookup(empty, "a")) == "<absent>"
    first = write_one(root, "a", "one").map_err((error) => error.message())?
    second = write_one(root, "a", "two").map_err((error) => error.message())?
    assert first.generation == 1 and second.generation == 2
    assert text(lookup(second, "a")) == "two"
    assert text(lookup(first, "a")) == "one"
    deleted = commit(delete(begin(second), "a")).map_err((error) => error.message())?
    assert text(lookup(deleted, "a")) == "<deleted>"
    assert text(lookup(deleted, "b")) == "<absent>"
    assert keys(deleted).map_err((error) => error.message())? == []
    # Repeated pins of one exact snapshot share one descriptor, without another file publication.
    held = lease(first).map_err((error) => error.message())?
    leases = root.joinpath("leases")
    before = len(leases.iterdir().map_err((error) => error.message())?)
    assert before == deleted.generation + 1, "an execution pin published a duplicate durable descriptor"
    another = lease(first).map_err((error) => error.message())?
    assert len(leases.iterdir().map_err((error) => error.message())?) == before
    unbound = snapshot(root, "unbound").map_err((error) => error.message())?
    unbound_lease = lease(unbound).map_err((error) => error.message())?
    collect_layouts(root).map_err((error) => error.message())?
    assert text(lookup(empty, "a")) == "<absent>"
    assert text(lookup(unbound, "a")) == "<absent>"
    prove_snapshot_collection(scratch.path().joinpath("collection"))?
    return Ok(None)


pub def test_concurrent_disjoint_writes_both_land_and_conflicting_writes_are_refused() -> Result[None, str]:
    """
    Two transactions begun on one generation: disjoint writes both commit; a conflicting one is refused; an equal one
    commits nothing and adds no bytes.
    """
    if get_or("INCAN_STORE_PROOF_CHILD", "") == "writer":
        return writer_child()
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    base = snapshot(root).map_err((error) => error.message())?
    left = put(begin(base), "a", b"one", EXPECT_ABSENT)
    right = put(begin(base), "b", b"two", EXPECT_ABSENT)
    rival = put(begin(base), "a", b"other", EXPECT_ABSENT)
    same = put(begin(base), "a", b"one", EXPECT_ABSENT)
    assert commit(left).map_err((error) => error.message())?.generation > 0
    landed = commit(right).map_err((error) => error.message())?
    assert text(lookup(landed, "a")) == "one" and text(lookup(landed, "b")) == "two"
    assert error_kind(commit(rival)) == "conflict"
    segment_files = count_files(root.joinpath("segments"))
    retained = retained_inventory(root)?
    size_before = retained_bytes(root)?
    unchanged = commit(same).map_err((error) => error.message())?
    assert unchanged.generation == landed.generation
    assert count_files(root.joinpath("segments")) == segment_files
    assert retained_inventory(root)? == retained
    assert retained_bytes(root)? == size_before
    println("S1 unchanged commit: 0 added files, 0 changed bytes, 0 manifest writes")
    # A transaction retains only its final index pages, never intermediate roots from inserting its entries.
    page_store = scratch.path().joinpath("page-store")
    barriers = durable_syncs()
    ordered = graph_barriers()
    mut batch = begin(snapshot(page_store).map_err((error) => error.message())?)
    for key in ["a", "b", "c", "d"]:
        batch = put(batch, key, b"value")
    _ = commit(batch).map_err((error) => error.message())?
    # The graph needs only ordering before CURRENT names it; the acknowledgment is the request's one drive flush.
    assert durable_syncs() - barriers == 1, "a request flushed the drive more than once"
    assert graph_barriers() - ordered == 1, "a request did not order its graph ahead of its selection"
    assert count_files(page_store.joinpath("indexes")) == 1, "publication retained intermediate index pages"
    # One request updates independent views under one CURRENT switch; a conflict changes neither view.
    other = snapshot(root, "project").map_err((error) => error.message())?
    group = [put(begin(landed), "group", b"home"), put(begin(other), "group", b"project")]
    grouped = commit_group(group).map_err((error) => error.message())?
    assert grouped.generation == landed.generation + 1
    selected = snapshot(root, "project").map_err((error) => error.message())?
    assert selected.generation == grouped.generation
    assert text(lookup(grouped, "group")) == "home" and text(lookup(selected, "group")) == "project"
    assert commit_group(group).map_err((error) => error.message())?.generation == grouped.generation
    conflict = [put(begin(grouped), "new", b"hidden"), put(begin(selected), "group", b"wrong", EXPECT_ABSENT)]
    assert error_kind(commit_group(conflict)) == "conflict"
    assert text(lookup(snapshot(root).map_err((error) => error.message())?, "new")) == "<absent>"
    prove_concurrent_writers(scratch.path())?
    return Ok(None)


pub def test_damage_is_an_error_never_absence_or_an_older_value() -> Result[None, str]:
    """
    A damaged frame is an integrity error, and the older value beneath it is never returned; a writer that expects
    damage may replace it. A damaged pointer or manifest refuses the store instead of reading it as empty.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    match sync_ordered(root.joinpath("missing").0):
        Ok(_) => return Err("a missing synchronization target was reported as durable")
        Err(message) =>
            assert message != ""
    older = write_one(root, "a", "old").map_err((error) => error.message())?
    assert older.generation > 0
    newer = write_one(root, "a", "newer").map_err((error) => error.message())?
    damage_last_byte(root.joinpath("segments").joinpath(f"{added_segment(older, newer)?}.seg"))?
    damaged = snapshot(root).map_err((error) => error.message())?
    assert text(lookup(damaged, "a")) == "<integrity>"
    assert error_kind(write_one(root, "a", "plain")) == "integrity"
    quarantine_record(damaged, "a").map_err((error) => error.message())?
    assert count_files(root.joinpath("quarantine")) == 1
    repaired = write_one(root, "a", "repaired", EXPECT_ABSENT_OR_DAMAGED).map_err((error) => error.message())?
    assert text(lookup(repaired, "a")) == "repaired"
    root.joinpath("CURRENT").write_text("garbage", "utf-8", "strict", None).map_err((error) => error.message())?
    match snapshot(root):
        Ok(_) =>
            assert false, "a malformed CURRENT was read"
        Err(error) =>
            assert error.kind == "format", error.message()
    restored = repair_current(repaired).map_err((error) => error.message())?
    assert text(lookup(restored, "a")) == "repaired"
    root.joinpath("CURRENT").unlink().map_err((error) => error.message())?
    assert error_kind(snapshot(root)) == "integrity"
    repair_current(restored).map_err((error) => error.message())?
    manifest = root.joinpath("snapshots").joinpath(f"{restored.generation}.{restored.digest[:16]}.manifest")
    damage_last_byte(manifest)?
    assert error_kind(snapshot(root)) == "integrity"
    assert error_kind(repair_current(restored)) == "integrity"
    return Ok(None)


pub def test_a_commit_interrupted_before_its_switch_leaves_the_last_generation_visible() -> Result[None, str]:
    """
    Objects installed and a manifest written without the `CURRENT` switch are not committed: readers see the last
    generation, and the next commit publishes normally.
    """
    if get_or("INCAN_STORE_PROOF_CHILD", "") == "crash":
        return crash_child()
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    committed = write_one(root, "a", "one").map_err((error) => error.message())?
    other = scratch.path().joinpath("other")
    assert write_one(other, "a", "two").map_err((error) => error.message())?.generation == 1
    # A crashed writer's segment and a next-generation manifest, without the pointer switch.
    for name in ["segments", "snapshots"]:
        for entry in other.joinpath(name).iterdir().map_err((error) => error.message())?:
            entry
                .copy(root.joinpath(name).joinpath(f"{entry.name()}.orphan"), true, true)
                .map_err((error) => error.message())?
    seen = snapshot(root).map_err((error) => error.message())?
    assert seen.generation == committed.generation
    assert text(lookup(seen, "a")) == "one"
    after = write_one(root, "b", "two").map_err((error) => error.message())?
    assert after.generation == committed.generation + 1
    assert text(lookup(after, "a")) == "one" and text(lookup(after, "b")) == "two"
    prove_crash_boundaries(scratch.path())?
    return Ok(None)


pub def test_compaction_preserves_contents_and_gives_a_byte_identical_base() -> Result[None, str]:
    """
    Compaction keeps every key's newest state, tombstones included, and equal contents give the same base however they
    were written.
    """
    scratch = scratch_directory()?
    one = scratch.path().joinpath("one")
    two = scratch.path().joinpath("two")
    assert write_one(one, "a", "x").map_err((error) => error.message())?.generation > 0
    assert write_one(one, "b", "y").map_err((error) => error.message())?.generation > 0
    assert write_one(one, "c", "z").map_err((error) => error.message())?.generation > 0
    assert commit(delete(begin(snapshot(one).map_err((error) => error.message())?), "c")).map_err(
        (error) => error.message(),
    )?.generation > 0
    assert write_one(two, "c", "w").map_err((error) => error.message())?.generation > 0
    assert commit(delete(begin(snapshot(two).map_err((error) => error.message())?), "c")).map_err(
        (error) => error.message(),
    )?.generation > 0
    assert write_one(two, "b", "old").map_err((error) => error.message())?.generation > 0
    assert write_one(two, "b", "y").map_err((error) => error.message())?.generation > 0
    assert write_one(two, "a", "x").map_err((error) => error.message())?.generation > 0
    left = compact(one).map_err((error) => error.message())?
    right = compact(two).map_err((error) => error.message())?
    left_segments = segments(left).map_err((error) => error.message())?
    right_segments = segments(right).map_err((error) => error.message())?
    assert len(left_segments) == 1 and len(right_segments) == 1
    assert left_segments[0] == right_segments[0] and left.index == right.index
    println(f"S2 canonical compaction: equal_base={left_segments[0]} equal_index={left.index}")
    assert text(lookup(right, "b")) == "y"
    assert text(lookup(right, "c")) == "<deleted>"
    source = scratch.path().joinpath("artifact")
    source.write_bytes(b"program").map_err((error) => error.message())?
    digest = put_payload(two, source).map_err((error) => error.message())?
    assert payload_intact(two, digest.digest)
    stored = payload_path(two, digest.digest)
    stored.chmod(false).map_err((error) => error.message())?
    stored.write_bytes(b"damaged").map_err((error) => error.message())?
    match put_payload(two, source):
        Ok(_) =>
            assert false, "a damaged payload was accepted as stored"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    return Ok(None)


def damage_last_byte(path: Path) -> Result[None, str]:
    """Cut the last byte off a file, past its permissions, as a stray tool would."""
    data = path.read_bytes().map_err((error) => error.message())?
    path.chmod(false).map_err((error) => error.message())?
    path.write_bytes(data[:len(data) - 1]).map_err((error) => error.message())?
    return Ok(None)


pub def test_a_family_selection_reads_its_range_however_many_records_earlier_edits_left() -> Result[None, str]:
    """
    Selecting one family's reusable records and one record's readers reads only the index pages of their key range:
    the pages read do not grow with the records every earlier edit left in the store, and a prefix listing returns
    exactly the keys a whole listing would.
    """
    scratch = scratch_directory()?
    output = "incan.engine.output\tp\tbody-ir\tprofile\torigin\tfunction:main\tfacet\tchecked"
    edge = "incan.engine.edge-in\tbody-ir\tprofile\torigin\tfunction:main\tfacet\tchecked\t"
    target = RecordKey(
        family="body-ir",
        identity="function:main",
        identity_profile="profile",
        origin="origin",
        facet="facet",
        context="checked",
    )
    mut pages: list[int] = []
    for scale in [1, 100]:
        root = scratch.path().joinpath(f"store-{scale}")
        _ = write_one(root, output, "evaluation").map_err((error) => error.message())?
        for batch in range(scale):
            mut transaction = begin(snapshot(root).map_err((error) => error.message())?)
            for item in range(10):
                transaction = put(transaction, f"incan.engine.receipt\t{batch}-{item}", b"earlier edit")
                transaction = put(
                    transaction,
                    f"incan.engine.output\tp\tlocal\tprofile\torigin\tfunction:{batch}-{item}\tfacet\tchecked",
                    b"other family",
                )
            commit(transaction).map_err((error) => error.message())?
        latest = snapshot(root).map_err((error) => error.message())?
        before = read_counts()
        assert len(reusable_family_records(latest, "body-ir", "p")?) == 0
        assert len(readers_of(latest, [target], "p")?) == 0
        pages.append(read_counts().pages - before.pages)
        every = keys(latest).map_err((error) => error.message())?
        for prefix in ["incan.engine.output\tp\tbody-ir\t", "incan.engine.output\tp\t", "incan.engine.receipt\t5", edge]:
            assert keys_with_prefix(latest, prefix).map_err((error) => error.message())? == [
                key for key in every if key.startswith(prefix)
            ], prefix
    assert pages[1] <= pages[0] + 10, f"family selection read {pages[0]} pages at scale 1 and {pages[1]} at scale 100"
    return Ok(None)


pub def test_an_edited_declaration_s_edges_replace_their_keys_however_many_edits_came_before() -> Result[None, str]:
    """
    Keys that change together sit together. Each edit evaluates one declaration's slot in a new context that reads the
    same dependency with new evidence, and retires the earlier evaluation. Its edges are written over the earlier ones
    under the same keys, so after any number of edits the edge indexes hold exactly the current evaluation's entries,
    tombstones included, and a reader lookup finds the current evaluation.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    dependency = RecordKey(
        family="final",
        identity="function:helper",
        identity_profile="profile",
        origin="origin",
        facet="facet",
        context="checked",
    )
    read = RecordRequest(key=dependency, selection=RecordSelection.Field("value"))
    mut reader = dependency
    for edit in range(12):
        before = snapshot(root).map_err((error) => error.message())?
        changed = put(begin(before), encode_record_key(dependency)?, f"helper {edit}".encode("utf-8"))
        selected = commit(changed).map_err((error) => error.message())?
        reader = RecordKey(
            family="body-ir",
            identity="function:main",
            identity_profile="profile",
            origin="origin",
            facet="facet",
            context=f"edit {edit}",
        )
        mut transaction = begin(selected)
        rank = ProducerRank(namespace=2, stage=ProducerStage.CheckBody, dependency=1)
        receipt = edge_receipt(selected, reader, [read])?
        _ = prepare_evaluation(transaction, "claim", rank, f"main {edit}".encode("utf-8"), receipt)?
        supersede_outputs(selected, transaction)?
        _ = commit(transaction).map_err((error) => error.message())?
    latest = snapshot(root).map_err((error) => error.message())?
    mut edges: list[str] = []
    for entry in index_entries(store_path(root), latest.index).map_err((error) => error.detail)?:
        if entry.key.startswith("incan.engine.edge-"):
            edges.append(entry.key)
    assert len(edges) == 2, f"after 12 edits of one declaration the edge indexes hold {len(edges)} entries"
    assert readers_of(latest, [dependency], "profile")? == [reader]
    return Ok(None)


pub def test_an_edge_to_a_record_each_edit_replaces_is_written_in_place() -> Result[None, str]:
    """
    Each edit evaluates a dependency in a new context, and one declaration's slot reads it. The reader's edge into the
    dependency is keyed by the dependency's slot, not by the context the edit replaced, so after any number of edits the
    edge indexes hold the one current edge in each direction, tombstones included. A reader lookup still names the
    exact record read: the current dependency has the current reader, and an earlier context has none.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    mut earlier = graph_key("final", "function:helper", "checked")
    mut dependency = earlier
    mut reader = earlier
    for edit in range(12):
        earlier = dependency
        dependency = graph_key("final", "function:helper", f"checked {edit}")
        before = snapshot(root).map_err((error) => error.message())?
        changed = put(begin(before), encode_record_key(dependency)?, f"helper {edit}".encode("utf-8"))
        selected = commit(changed).map_err((error) => error.message())?
        reader = graph_key("body-ir", "function:main", f"edit {edit}")
        publish_reader(selected, reader, [RecordRequest(key=dependency, selection=RecordSelection.Field("value"))])?
    latest = snapshot(root).map_err((error) => error.message())?
    edges = indexed_keys(root, latest, "incan.engine.edge-")?
    assert len(edges) == 2, f"after 12 edits of a replaced dependency the edge indexes hold {len(edges)} entries"
    assert readers_of(latest, [dependency], "profile")? == [reader]
    assert readers_of(latest, [earlier], "profile")? == []
    return Ok(None)


pub def test_a_reader_of_two_contexts_of_one_record_is_found_from_each() -> Result[None, str]:
    """
    One evaluation that makes the same read of two contexts of one record has one incoming edge for each, though both
    sit under the record's slot. When the next evaluation reads only one of them, the other has no reader left.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    first = graph_key("final", "function:helper", "checked 1")
    second = graph_key("final", "function:helper", "checked 2")
    mut transaction = begin(snapshot(root).map_err((error) => error.message())?)
    transaction = put(put(transaction, encode_record_key(first)?, b"one"), encode_record_key(second)?, b"two")
    selected = commit(transaction).map_err((error) => error.message())?
    reader = graph_key("body-ir", "function:main", "edit 0")
    both = [
        RecordRequest(key=first, selection=RecordSelection.Field("value")),
        RecordRequest(key=second, selection=RecordSelection.Field("value")),
    ]
    publish_reader(selected, reader, both)?
    latest = snapshot(root).map_err((error) => error.message())?
    assert readers_of(latest, [first], "profile")? == [reader]
    assert readers_of(latest, [second], "profile")? == [reader]
    edited = graph_key("body-ir", "function:main", "edit 1")
    publish_reader(latest, edited, [both[1]])?
    current = snapshot(root).map_err((error) => error.message())?
    assert readers_of(current, [first], "profile")? == []
    assert readers_of(current, [second], "profile")? == [edited]
    assert len(indexed_keys(root, current, "incan.engine.edge-")?) == 4
    return Ok(None)


def graph_key(family: str, identity: str, context: str) -> RecordKey:
    """A compiler record key in the one identity profile, origin and facet these graph tests use."""
    return RecordKey(
        family=family,
        identity=identity,
        identity_profile="profile",
        origin="origin",
        facet="facet",
        context=context,
    )


def publish_reader(selected: Snapshot, reader: RecordKey, reads: list[RecordRequest]) -> Result[None, str]:
    """Publish an evaluation of `reader` that makes `reads`, retiring its slot's earlier evaluation, in one commit."""
    mut transaction = begin(selected)
    rank = ProducerRank(namespace=2, stage=ProducerStage.CheckBody, dependency=1)
    receipt = edge_receipt(selected, reader, reads)?
    _ = prepare_evaluation(transaction, "claim", rank, f"{reader.context}".encode("utf-8"), receipt)?
    supersede_outputs(selected, transaction)?
    _ = commit(transaction).map_err((error) => error.message())?
    return Ok(None)


def indexed_keys(root: Path, selected: Snapshot, prefix: str) -> Result[list[str], str]:
    """Every key the snapshot's index holds under `prefix`, tombstones included."""
    mut found: list[str] = []
    for entry in index_entries(store_path(root), selected.index).map_err((error) => error.detail)?:
        if entry.key.startswith(prefix):
            found.append(entry.key)
    return Ok(found)


def edge_receipt(selected: Snapshot, output: RecordKey, requests: list[RecordRequest]) -> Result[ReadReceipt, str]:
    """The completed receipt of an evaluation of `output` that reads `requests` through the store, in order."""
    scope = ReadScope(snapshot=selected.digest, profile="profile")
    preparation = PreparationEvidence(output=output, rank_certificate="rank", selector_witnesses="selectors")
    mut roots: list[str] = []
    for request in requests:
        roots.append(encode_record_key(request.key)?)
    source = StoreRecordSource.open(selected, scope, roots)
    mut reads = RecordReads.start(scope, preparation, requests)
    for request in requests:
        match reads.read(source, request):
            RecordRead.Failed(_) => return Err("the dependency read failed")
            _ => pass
    return reads.finish().map_err((_) => "the dependency receipt failed")


pub def test_a_commit_reads_each_index_page_it_changes_once_however_many_keys_it_writes() -> Result[None, str]:
    """
    A commit merges its keys into the index in one pass: writing 64 keys under one leaf reads about the pages that
    writing one key reads, not one root-to-leaf path per key, and every key, old and new, stays listed and found.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    mut transaction = begin(snapshot(root).map_err((error) => error.message())?)
    mut expected: list[str] = []
    for item in range(1000):
        key = f"k-{1000 + item}"
        transaction = put(transaction, key, b"earlier")
        expected.append(key)
    commit(transaction).map_err((error) => error.message())?
    levels = index_levels(snapshot(root).map_err((error) => error.message())?).map_err((error) => error.message())?
    before_one = read_counts()
    _ = write_one(root, "k-1250-x", "one").map_err((error) => error.message())?
    one = read_counts().pages - before_one.pages
    # One path read to check the key and one to merge it; a page the commit wrote is never read back to install it.
    assert one == 2 * levels, f"a one-key commit on a {levels}-level index read {one} index pages"
    expected.append("k-1250-x")
    transaction = begin(snapshot(root).map_err((error) => error.message())?)
    for item in range(64):
        key = f"k-1500-{10 + item}"
        transaction = put(transaction, key, b"concentrated")
        expected.append(key)
    before_many = read_counts()
    commit(transaction).map_err((error) => error.message())?
    many = read_counts().pages - before_many.pages
    assert many <= one + 4, f"a commit of one key read {one} index pages and a commit of 64 keys read {many}"
    transaction = begin(snapshot(root).map_err((error) => error.message())?)
    for item in range(143):
        key = f"k-{1000 + item * 7}-spread"
        transaction = put(transaction, key, b"spread")
        expected.append(key)
    transaction = put(transaction, "k-1007", b"replaced")
    commit(transaction).map_err((error) => error.message())?
    latest = snapshot(root).map_err((error) => error.message())?
    assert keys(latest).map_err((error) => error.message())? == sorted(expected)
    assert text(lookup(latest, "k-1007")) == "replaced"
    assert text(lookup(latest, "k-1500-73")) == "concentrated"
    assert text(lookup(latest, "k-1994-spread")) == "spread"
    assert text(lookup(latest, "k-1999")) == "earlier"
    return Ok(None)


pub def test_a_commit_installs_one_index_file_however_large_the_store() -> Result[None, str]:
    """
    What a commit writes to the index is bounded by the keys it writes, not by the store: each of 1,400 commits of
    scattered keys installs exactly one index file, holding at most one new page per key it writes on each level of the
    index (the path that key changes), at the first generation as after the store has grown.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    keys_per_commit = 16
    for generation in range(1, 1401):
        mut transaction = begin(snapshot(root).map_err((error) => error.message())?)
        for item in range(keys_per_commit):
            transaction = put(transaction, scattered_key(generation, item), b"value")
        files = count_files(root.joinpath("indexes"))
        placed = pages_written()
        published = commit(transaction).map_err((error) => error.message())?
        installed = count_files(root.joinpath("indexes")) - files
        assert installed == 1, f"the commit of generation {published.generation} installed {installed} index files"
        pages = pages_written() - placed
        levels = index_levels(published).map_err((error) => error.message())?
        assert pages <= keys_per_commit * levels, f"generation {published.generation} wrote {pages} index pages"
        if generation == 1 or generation == 1400:
            println(f"S2 generation {published.generation}: {installed} index file, {pages} pages, {levels} levels")
    return Ok(None)


def scattered_key(generation: int, item: int) -> str:
    """A key whose position in the index no earlier key predicts, as a content digest's would be."""
    return "k-" + hexlify(sha256.digest(f"{generation}:{item}".encode("utf-8")))[:24]


pub def test_a_lookup_reads_one_index_path_however_many_segments_hold_other_keys() -> Result[None, str]:
    """
    A key is found through its view's index: the pages read for one lookup do not grow with the number of segments or
    with keys written elsewhere, and every key stays readable.
    """
    scratch = scratch_directory()?
    for scale in [1, 10, 100]:
        root = scratch.path().joinpath(f"store-{scale}")
        selected = write_one(root, "selected", "constant").map_err((error) => error.message())?
        for batch in range(scale):
            mut transaction = begin(snapshot(root).map_err((error) => error.message())?)
            for item in range(10):
                transaction = put(transaction, f"key-{batch}-{item}", b"unrelated")
            commit(transaction).map_err((error) => error.message())?
        latest = snapshot(root).map_err((error) => error.message())?
        before = read_counts()
        assert text(lookup(latest, "selected")) == "constant"
        after = read_counts()
        assert after.pages - before.pages <= 3
        assert after.records - before.records == 1
        assert after.bytes - before.bytes == 24
        assert text(lookup(latest, "missing")) == "<absent>"
        reached = len(segments(latest).map_err((error) => error.message())?)
        println(
            f"S2 selected read: scale={scale} segments={reached} pages={after.pages - before.pages} records={after.records - before.records} frame_bytes={after.bytes - before.bytes}",
        )
    return Ok(None)


pub def test_a_commit_s_manifest_does_not_grow_with_the_store_s_generations() -> Result[None, str]:
    """
    Every commit adds a segment, yet the manifest a commit writes, and every later snapshot reads and checks, holds the
    same lines at generation 3 and at generation 203: a seal costs a long-lived home what it costs a new one.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    mut lines: list[int] = []
    mut written = 0
    for generations in [3, 200]:
        for _item in range(generations):
            written += 1
            write_one(root, f"key-{written}", "value").map_err((error) => error.message())?
        latest = snapshot(root).map_err((error) => error.message())?
        manifest = Path(manifest_path(latest.root, latest.generation, latest.digest).value)
        text = manifest.read_text("utf-8", "strict").map_err((error) => error.message())?
        count = len(text.strip().split("\n"))
        started = Instant.now()
        write_one(root, f"timed-{written}", "value").map_err((error) => error.message())?
        elapsed = started.elapsed().as_secs_f64() * 1000.0
        println(f"S2 manifest: generation={latest.generation} lines={count} bytes={len(text)} next_commit_ms={elapsed}")
        written += 1
        lines.append(count)
    assert lines[1] == lines[0], f"the manifest grew from {lines[0]} to {lines[1]} lines over 200 generations"
    return Ok(None)


pub def test_a_snapshot_reads_its_manifest_once() -> Result[None, str]:
    """
    Opening a snapshot reads, checks and decodes the selected generation's manifest once: its lease is registered
    under the same lifecycle gate, against the manifest just decoded. A cold test case opens about twenty snapshots.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    _ = write_one(root, "key", "value").map_err((error) => error.message())?
    observe_work(WorkObserver(start=Some(observed_start), finish=Some(observed_finish)))
    before = observed_work.get("store_manifest_read", 0)
    held = snapshot(root).map_err((error) => error.message())?
    reads = observed_work.get("store_manifest_read", 0) - before
    observe_work(WorkObserver())
    assert text(lookup(held, "key")) == "value"
    assert reads == 1, f"opening one snapshot read its manifest {reads} times"
    return Ok(None)


pub def test_a_found_value_is_a_view_and_only_owned_copies_it() -> Result[None, str]:
    """
    A lookup answers with a view of the value inside its segment: it copies out the same key and location bytes
    whatever the value's size, and none of the value. Only `owned` copies a value, and it counts every byte it copies.
    """
    scratch = scratch_directory()?
    mut lookup_copies: list[int] = []
    for size in [1, 65536, 4194304]:
        value = repeated(size)?
        root = scratch.path().joinpath(f"value-{size}")
        commit(put(begin(snapshot(root).map_err((error) => error.message())?), "value", value)).map_err(
            (error) => error.message(),
        )?
        latest = snapshot(root).map_err((error) => error.message())?
        before = read_counts()
        found = lookup(latest, "value").map_err((error) => error.message())?
        after = read_counts()
        assert after.decoded == before.decoded, "a lookup decoded its value"
        assert after.bytes - before.bytes == 8 + 5 + size
        lookup_copies.append(after.copied - before.copied)
        match found:
            Lookup.Found(view) =>
                assert view.len() == size
                decoded = owned(view)
                assert read_counts().decoded - after.decoded == size
                assert decoded == value
            Lookup.Deleted =>
                assert false, "the stored value reads as deleted"
            Lookup.Absent =>
                assert false, "the stored value reads as absent"
        println(
            f"S2 mapped view: value_bytes={size} frame_bytes_checked={after.bytes - before.bytes} lookup_copied_bytes={after.copied - before.copied} lookup_decoded_bytes={after.decoded - before.decoded} owned_decoded_bytes={size}",
        )
    assert lookup_copies[0] == lookup_copies[1] and lookup_copies[1] == lookup_copies[2]
    return Ok(None)


def repeated(size: int) -> Result[bytes, str]:
    """`size` bytes, built by doubling."""
    mut data = BytesIO(b"v").getvalue()
    while len(data) < size:
        buffer = BytesIO(data)
        buffer.seek(0, 2).map_err((error) => error.message())?
        buffer.write_bytes(data).map_err((error) => error.message())?
        data = buffer.getvalue()
    return Ok(data[:size])


pub def test_a_forked_view_shares_its_source_and_neither_sees_the_other_s_later_writes() -> Result[None, str]:
    """
    A fork starts at its source's root, or at exactly an older snapshot's root when it forks that selection; writes to
    either side stay on that side, an existing view name is refused, and compaction keeps what each view holds.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    home = write_one(root, "shared", "base").map_err((error) => error.message())?
    source = scratch.path().joinpath("native-payload")
    source.write_bytes(b"shared native bytes").map_err((error) => error.message())?
    put_payload(root, source).map_err((error) => error.message())?
    payloads = retained_inventory(root.joinpath("payloads"))?
    segment_files = count_files(root.joinpath("segments"))
    pages = count_files(root.joinpath("indexes"))
    bytes_before = retained_bytes(root)?
    before_invalid = retained_inventory(root)?
    for invalid in ["", "two words", "line\nbreak"]:
        assert error_kind(fork(home, invalid)) == "format", f"invalid view {invalid} was accepted"
        assert error_kind(snapshot(root, invalid)) == "format"
        if invalid != "":
            mut invalid_transaction = begin(home)
            invalid_transaction.fork = invalid
            assert error_kind(commit(invalid_transaction)) == "format"
        assert retained_inventory(root)? == before_invalid, "an invalid fork changed the committed store"
    test_view = fork(home, "test").map_err((error) => error.message())?
    assert test_view.index == home.index
    assert count_files(root.joinpath("segments")) == segment_files
    assert count_files(root.joinpath("indexes")) == pages
    assert retained_inventory(root.joinpath("payloads"))? == payloads
    println(
        f"S2 fork: root_delta_bytes={retained_bytes(root)? - bytes_before} new_pages=0 new_segments=0 payload_copies=0",
    )
    assert text(lookup(test_view, "shared")) == "base"
    in_test = commit(put(begin(test_view), "only-test", b"t")).map_err((error) => error.message())?
    assert count_files(root.joinpath("indexes")) == pages + 1
    assert retained_inventory(root.joinpath("payloads"))? == payloads
    println("S2 first fork write: new_pages=1 new_segments=1 payload_copies=0")
    in_home = write_one(root, "only-home", "h").map_err((error) => error.message())?
    assert text(lookup(in_test, "only-home")) == "<absent>"
    assert text(lookup(in_home, "only-test")) == "<absent>"
    assert text(lookup(snapshot(root, "test").map_err((error) => error.message())?, "only-test")) == "t"
    match fork(in_home, "test"):
        Ok(_) =>
            assert false, "an existing view was replaced"
        Err(error) =>
            assert error.kind == "conflict", error.message()
    # A fork of an older snapshot starts at that snapshot's selection, not at its source view's latest root.
    pinned = fork_selection(home, "pinned").map_err((error) => error.message())?
    assert pinned.index == home.index and pinned.index != in_home.index
    assert text(lookup(pinned, "shared")) == "base"
    assert text(lookup(pinned, "only-home")) == "<absent>"
    match fork_selection(home, "pinned"):
        Ok(_) =>
            assert false, "an existing view was replaced by a selection fork"
        Err(error) =>
            assert error.kind == "conflict", error.message()
    compacted = compact(root).map_err((error) => error.message())?
    assert len(segments(compacted).map_err((error) => error.message())?) == 1
    assert text(lookup(snapshot(root, "test").map_err((error) => error.message())?, "only-test")) == "t"
    assert text(lookup(snapshot(root, "test").map_err((error) => error.message())?, "only-home")) == "<absent>"
    assert text(lookup(snapshot(root).map_err((error) => error.message())?, "only-home")) == "h"
    assert text(lookup(snapshot(root, "pinned").map_err((error) => error.message())?, "only-home")) == "<absent>"
    return Ok(None)


pub def test_injected_128_bit_locator_collision_resolves_by_full_key() -> Result[None, str]:
    """Equal physical fingerprint accelerators cannot alias distinct full-key frames or their absence witnesses."""
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    base = snapshot(root).map_err((error) => error.message())?
    transaction = put(put(begin(base), "left", b"one"), "right", b"two")
    original = commit(transaction).map_err((error) => error.message())?
    segment = root.joinpath("segments").joinpath(f"{segments(original).map_err((error) => error.message())?[0]}.seg")
    buffer = BytesIO(segment.read_bytes().map_err((error) => error.message())?)
    # Inject the same 128-bit accelerator into both segment-directory slots without changing either full-key frame.
    for offset in [16, 104]:
        buffer.seek(offset, 0).map_err((error) => error.message())?
        buffer.write_bytes(b"00000000000000000000000000000000").map_err((error) => error.message())?
    contents = buffer.getvalue()
    digest = hexlify(sha256.digest(contents))
    root.joinpath("segments").joinpath(f"{digest}.seg").write_bytes(contents).map_err((error) => error.message())?
    mut entries: list[Entry] = []
    for entry in index_entries(store_path(root), original.index).map_err((error) => error.detail)?:
        match entry.location:
            None =>
                assert false, "fixture requires a leaf location"
            Some(location) =>
                entries.append(
                    Entry(
                        key=entry.key,
                        child="",
                        location=Some(
                            Location(
                                segment=digest,
                                offset=location.offset,
                                length=location.length,
                                digest=location.digest,
                                tombstone=location.tombstone,
                            ),
                        ),
                    ),
                )
    mut collided = original
    staging = store_path(root.joinpath("staging/collision"))
    collided.index = write_index(store_path(root), staging, entries).map_err((error) => error.detail)?
    assert text(lookup(collided, "left")) == "one"
    assert text(lookup(collided, "right")) == "two"
    assert text(lookup(collided, "neither")) == "<absent>"
    println("S1 collision: 2 full keys, 1 injected 128-bit locator, 0 aliases")
    return Ok(None)


def retained_inventory(root: Path, prefix: str = "") -> Result[list[str], str]:
    """Every retained file and its full content identity; unchanged commits cannot hide writes behind counts."""
    if not root.is_dir():
        return Ok([])
    mut result: list[str] = []
    for path in root.iterdir().map_err((error) => error.message())?:
        name = prefix + path.name()
        if path.is_dir():
            result.extend(retained_inventory(path, name + "/")?)
        else:
            digest = hexlify(file_digest(path, "sha256").map_err((error) => error.message())?)
            result.append(f"{name} {digest}")
    return Ok(sorted(result))


def retained_bytes(root: Path) -> Result[int, str]:
    """Logical file lengths, explicitly separate from allocated filesystem extents or transient peak space."""
    if not root.is_dir():
        return Ok(0)
    mut size = 0
    for path in root.iterdir().map_err((error) => error.message())?:
        if path.is_dir():
            size += retained_bytes(path)?
        else:
            size += path.stat().map_err((error) => error.message())?.size().map_err((error) => error.message())?
    return Ok(size)


def proof_command(test: str) -> Result[Command, str]:
    """Launch this exact native test again so process failures cannot be mistaken for caught store errors."""
    executable = current_exe().map_err((error) => str(error))?.to_string_lossy().into_owned()
    mut command = Command.new(executable)
    command.arg("--exact").arg(test).arg("--nocapture").arg("--test-threads=1")
    return Ok(command)


def crash_child() -> Result[None, str]:
    """Attempt a pinned multi-view request; the selected publication boundary terminates the process."""
    root = Path(get_or("INCAN_STORE_PROOF_ROOT", ""))
    base = snapshot(root).map_err((error) => error.message())?
    transaction = put(put(begin(base), "b", b"two"), "c", b"three")
    selected = put(begin(snapshot(root, "project").map_err((error) => error.message())?), "selected", b"unit")
    commit_pinned([transaction, selected], "project").map_err((error) => error.message())?
    return Ok(None)


def prove_crash_boundaries(base: Path) -> Result[None, str]:
    """At each real process-exit boundary, reopen either the complete old root or the complete new root."""
    boundaries = [
        "staging-created",
        "delta-written",
        "delta-synced",
        "delta-replaced",
        "segment-installed",
        "pages-staged",
        "pages-installed",
        "manifest-written",
        "manifest-synced",
        "manifest-replaced",
        "manifest-directory-synced",
        "objects-ordered",
        "pin-acquired",
        "current-written",
        "current-synced",
        "current-replaced",
        "current-durable",
        "root-synced",
    ]
    for boundary in boundaries:
        root = base.joinpath(boundary)
        old = write_one(root, "a", "one").map_err((error) => error.message())?
        mut command = proof_command("test_a_commit_interrupted_before_its_switch_leaves_the_last_generation_visible")?
        command.env("INCAN_STORE_PROOF_CHILD", "crash").env("INCAN_STORE_PROOF_ROOT", root.0)
        command.env("INCAN_STORE_CRASH_AFTER", boundary)
        status = command.output().map_err((error) => str(error))?.status
        stopped: i32 = 86
        assert status.code() == Some(stopped), f"boundary {boundary} did not terminate the writer"
        reopened = snapshot(root).map_err((error) => error.message())?
        project = snapshot(root, "project").map_err((error) => error.message())?
        assert text(lookup(reopened, "a")) == "one"
        if reopened.generation == old.generation:
            assert text(lookup(project, "selected")) == "<absent>"
            assert text(lookup(reopened, "b")) == "<absent>"
            assert text(lookup(reopened, "c")) == "<absent>"
        else:
            assert text(lookup(project, "selected")) == "unit"
            assert reopened.generation == old.generation + 1
            assert text(lookup(reopened, "b")) == "two"
            assert text(lookup(reopened, "c")) == "three"
    println(f"S1 process-exit matrix: {len(boundaries)} boundaries, 0 partial snapshots")
    return Ok(None)


def await_file(path: Path) -> Result[None, str]:
    """Bound a subprocess handshake; a failed child cannot leave the proof waiting indefinitely."""
    for attempt in range(5000):
        if path.is_file():
            return Ok(None)
        sleep(Duration.from_millis(2))
    return Err(f"writer handshake timed out: {path.0}")


def writer_child() -> Result[None, str]:
    """Stage against the shared generation before both real writer processes are released together."""
    root = Path(get_or("INCAN_STORE_PROOF_ROOT", ""))
    role = get_or("INCAN_STORE_PROOF_ROLE", "")
    key = get_or("INCAN_STORE_PROOF_KEY", "")
    transaction = put(
        begin(snapshot(root).map_err((error) => error.message())?),
        key,
        role.encode("utf-8"),
        EXPECT_ABSENT,
    )
    root.joinpath(f"ready-{role}").write_bytes(b"ready").map_err((error) => error.message())?
    await_file(root.joinpath("start"))?
    match commit(transaction):
        Ok(_) => return Ok(None)
        Err(error) =>
            if error.kind == "conflict":
                native_exit(23)
            return Err(error.message())


def prove_concurrent_writers(base: Path) -> Result[None, str]:
    """Disjoint simultaneous writers both land; rivals to one absent full key produce one commit and one conflict."""
    for scenario in ["disjoint", "conflicting"]:
        root = base.joinpath(scenario)
        write_one(root, "anchor", "unchanged").map_err((error) => error.message())?
        mut left_command = proof_command("test_concurrent_disjoint_writes_both_land_and_conflicting_writes_are_refused")?
        mut right_command = proof_command("test_concurrent_disjoint_writes_both_land_and_conflicting_writes_are_refused")?
        left_command.env("INCAN_STORE_PROOF_CHILD", "writer").env("INCAN_STORE_PROOF_ROOT", root.0)
        right_command.env("INCAN_STORE_PROOF_CHILD", "writer").env("INCAN_STORE_PROOF_ROOT", root.0)
        left_command.env("INCAN_STORE_PROOF_ROLE", "left").env("INCAN_STORE_PROOF_KEY", "left")
        mut right_key = "right"
        if scenario == "conflicting":
            right_key = "left"
        right_command.env("INCAN_STORE_PROOF_ROLE", "right").env("INCAN_STORE_PROOF_KEY", right_key)
        mut left = left_command.spawn().map_err((error) => str(error))?
        mut right = right_command.spawn().map_err((error) => str(error))?
        await_file(root.joinpath("ready-left"))?
        await_file(root.joinpath("ready-right"))?
        root.joinpath("start").write_bytes(b"start").map_err((error) => error.message())?
        left_status = left.wait().map_err((error) => str(error))?
        right_status = right.wait().map_err((error) => str(error))?
        seen = snapshot(root).map_err((error) => error.message())?
        if scenario == "disjoint":
            assert left_status.success() and right_status.success()
            assert text(lookup(seen, "left")) == "left" and text(lookup(seen, "right")) == "right"
        else:
            conflict: i32 = 23
            assert left_status.success() != right_status.success()
            assert left_status.code() == Some(conflict) or right_status.code() == Some(conflict)
            assert text(lookup(seen, "left")) in ["left", "right"]
        assert text(lookup(seen, "anchor")) == "unchanged"
    println("S1 concurrent processes: 2 disjoint commits; 1 rival commit and 1 conflict")
    return Ok(None)


def prove_snapshot_collection(root: Path) -> Result[None, str]:
    """Lazy old reads survive collection; a released historical descriptor cannot be registered again."""
    expired = pinned_collection(root)?
    reclaimed = collect_layouts(root).map_err((error) => error.message())?
    assert reclaimed.files > 0 and reclaimed.bytes > 0
    assert text(lookup(snapshot(root).map_err((error) => error.message())?, "value")) == "replacement-19"
    match lease(expired):
        Ok(_) => return Err("an expired snapshot registered after collection")
        Err(error) =>
            assert error.kind == "expired", error.message()
    match view_snapshot(expired, expired.view):
        Ok(_) => return Err("view selection reopened an expired descriptor")
        Err(error) =>
            assert error.kind == "expired", error.message()
    match repair_current(expired):
        Ok(_) => return Err("repair selected an expired descriptor")
        Err(error) =>
            assert error.kind == "expired", error.message()
    prove_expired_repair_preserves_current(root.joinpath("repair"))?
    println(f"collection released snapshot: {reclaimed.files} files, {reclaimed.bytes} bytes")
    return Ok(None)


def prove_expired_repair_preserves_current(root: Path) -> Result[None, str]:
    """A peer can retain an old manifest without authorizing another expired view to replace CURRENT."""
    first = write_one(root, "value", "shared").map_err((error) => error.message())?
    peer = fork(first, "peer").map_err((error) => error.message())?
    mut expired = snapshot(root).map_err((error) => error.message())?
    write_one(root, "value", "different").map_err((error) => error.message())?
    write_one(root, "value", "shared").map_err((error) => error.message())?
    expired.pin = None
    collect_layouts(root).map_err((error) => error.message())?
    pointer = root.joinpath("CURRENT")
    before = pointer.read_text("utf-8", "strict").map_err((error) => error.message())?
    match repair_current(expired):
        Ok(_) => return Err("repair accepted an expired view through its peer's manifest")
        Err(error) =>
            assert error.kind == "expired", error.message()
    assert pointer.read_text("utf-8", "strict").map_err((error) => error.message())? == before
    assert text(lookup(peer, "value")) == "shared"
    assert text(lookup(snapshot(root).map_err((error) => error.message())?, "value")) == "shared"
    return Ok(None)


def pinned_collection(root: Path) -> Result[Snapshot, str]:
    """Keep an unopened old value live across twenty superseding generations and a maintenance collection."""
    mut old = write_one(root, "value", "old").map_err((error) => error.message())?
    for turn in range(20):
        write_one(root, "value", f"replacement-{turn}").map_err((error) => error.message())?
    reclaimed = collect_layouts(root).map_err((error) => error.message())?
    assert reclaimed.files > 0 and reclaimed.bytes > 0
    assert text(lookup(old, "value")) == "old", "collection removed a live snapshot's lazy frame"
    println(
        f"collection with pinned snapshot: 20 superseded generations, {reclaimed.files} files, {reclaimed.bytes} bytes",
    )
    old.pin = None
    return Ok(old)


def observed_start() -> Option[Clock]:
    """Use the platform clock without depending on any Oven adapter."""
    return begin_span(true)


def observed_finish(operation: Operation, key: str, clock: Option[Clock], bytes: int) -> None:
    """Record only names and scalar counters; the observer never changes publication."""
    assert key != ""
    assert bytes >= 0
    match clock:
        Some(_) => observed_work[operation.value()] = observed_work.get(operation.value(), 0) + 1
        None =>
            assert false, "enabled store work lost its clock"


def verify_work_observer(root: Path) -> Result[None, str]:
    """A caller sees all seven work spans, and removing it disables further callbacks."""
    observe_work(WorkObserver(start=Some(observed_start), finish=Some(observed_finish)))
    _ = write_one(root, "key", "value").map_err((error) => error.message())?
    for operation in [
        "store_lock",
        "store_file_sync",
        "store_file_write",
        "store_file_rename",
        "store_directory_sync",
        "store_durable_sync",
        "store_graph_barrier",
    ]:
        assert observed_work.get(operation, 0) > 0, f"missing store observation: {operation}"
    calls = observed_work.get("store_lock", 0)
    observe_work(WorkObserver())
    _ = write_one(root, "key", "next").map_err((error) => error.message())?
    assert observed_work.get("store_lock", 0) == calls, "disabled observer still received work"
    return Ok(None)


pub def test_publishing_a_view_compares_the_revision_it_read() -> Result[None, str]:
    """
    A compared publication commits only onto the view revision its transaction read: a second writer that read the
    same revision and writes something else is refused, one whose writes are already there publishes nothing, a
    fresh read publishes, and the source the view was forked from never sees the project's writes.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("store")
    home = write_one(root, "shared", "base").map_err((error) => error.message())?
    _ = fork(home, "project").map_err((error) => error.message())?
    read = snapshot(root, "project").map_err((error) => error.message())?
    first = commit(put(begin_compared(read), "head", b"one")).map_err((error) => error.message())?
    assert text(lookup(first, "head")) == "one"
    assert error_kind(commit(put(begin_compared(read), "head", b"two"))) == "conflict", "a stale revision published"
    already = commit(put(begin_compared(read), "head", b"one"))
    assert error_kind(already) == "ok", "an already published write was refused"
    fresh = snapshot(root, "project").map_err((error) => error.message())?
    second = commit(put(begin_compared(fresh), "head", b"two")).map_err((error) => error.message())?
    assert text(lookup(second, "head")) == "two"
    assert text(lookup(snapshot(root).map_err((error) => error.message())?, "head")) == "<absent>"
    assert text(lookup(second, "shared")) == "base"
    return Ok(None)
