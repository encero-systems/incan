"""Authenticate compiler output before it can supply the prepared graph transaction."""

from std.fs import Path
from rust::std::fs import remove_dir_all
from pub::internal_models import CompiledBodyOutputs, NamespaceOrder
from pub::internal_models.overload_members import MethodReads
from pub::incan_platform.trace import Operation
from compiler_captured_sources import source_origin
from compiler_body_projection import ProjectionRefusalMode, projection_refusal_mode, projection_refusals
from compiler_body_rows import compiled_method_reads, compiled_namespace_order, read_compiled_body_outputs
from compiler_body_values import CoveredBodyOwners, SelectedBodyRecord
from compiler_executable_scopes import ExecutableScopeInputs, compiled_executable_scopes
from compiler_namespace_layouts import read_compiled_layouts
from jec import begin as begin_work, record as record_work
from unit import UnitDescription


pub model AuthenticatedCompiledBodies:
    """Decoded compiler rows and the measured fresh/reused owner counts they authenticate."""

    pub outputs: CompiledBodyOutputs
    pub layouts: Dict[str, bytes]
    pub order: Dict[str, NamespaceOrder]

    pub scopes: ExecutableScopeInputs
    pub methods: MethodReads
    pub origin: str
    pub owner_evaluations: int
    pub owner_reuses: int
    pub body_ir_evaluations: int
    # The invocation restored these owners from selected records, including owners offered via whole modules.
    pub restored_owners: set[str]


pub def authenticate_compiled_bodies(
    unit: UnitDescription,
    output: Path,
    retained: list[SelectedBodyRecord],
    restored: list[str],
    restored_body_ir: list[str],
    covered: Borrowed[CoveredBodyOwners],
) -> Result[AuthenticatedCompiledBodies, str]:
    """Authenticate one compiler row directory, consume it and count the owners checked or restored this activation."""
    authenticating = begin_work()
    if not output.is_dir():
        return Err("successful graph-enabled compile did not publish body output rows")
    outputs = read_compiled_body_outputs(output)?
    layouts = read_compiled_layouts(output, outputs.namespaces)?
    origin = source_origin(unit)
    order = compiled_namespace_order(output, origin, outputs.namespaces)?

    methods = compiled_method_reads(output)?
    scopes = compiled_executable_scopes(output, origin, outputs)?
    remove_dir_all(output.0).map_err((error) => f"cannot consume compiled body output {output.0}: {error}")?
    chosen = set([record.identity for record in retained])
    installed_frames = set(restored_body_ir)
    published = set([value.identity for value in outputs.values])
    for reader in methods.groups.keys():
        if reader not in published:
            return Err("fresh method lookup reader is not a published owner")
    for reader in methods.retained:
        if reader not in published or reader not in restored:
            return Err("retained method lookup reader was not restored")
    for owner in restored_body_ir:
        if owner not in published:
            return Err("compiler reported a restored Body IR frame outside its published owners")
    # A settled-call retry may obtain an originally covered owner directly from this pinned graph.
    restored_identities = set([owner for owner in restored if owner in chosen or owner in covered.owners])
    mut owner_evaluations = len(outputs.fallbacks)
    mut owner_reuses = 0
    mut body_ir_evaluations = len(outputs.fallbacks)
    for value in outputs.values:
        if value.identity not in installed_frames:
            body_ir_evaluations += 1
        if value.identity in restored_identities:
            owner_reuses += 1
        else:
            owner_evaluations += 1
    if projection_refusal_mode()? == ProjectionRefusalMode.List:
        refusals = projection_refusals(unit, origin, outputs.values)
        if len(refusals) > 0:
            return Err(
                f"compiled body projection refusal list ({len(refusals)}):\n" + "\n".join(
                    [f"{index + 1}. {refusals[index]}" for index in range(len(refusals))],
                ),
            )
    record_work(Operation.EngineSidecarAuthentication, output.0, authenticating)
    return Ok(
        AuthenticatedCompiledBodies(
            outputs=outputs,
            layouts=layouts,
            order=order,

            scopes=scopes,
            methods=methods,
            origin=origin,
            owner_evaluations=owner_evaluations,
            owner_reuses=owner_reuses,
            body_ir_evaluations=body_ir_evaluations,
            restored_owners=restored_identities,
        ),
    )
