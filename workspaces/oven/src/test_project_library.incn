"""A project's test and program units link its shared library, which each of them describes the same way."""

from std.fs import Path
from files import make_directory, write
from observation import children
from project_library import (
    LIBRARY_SUFFIX,
    library_loaf,
    library_output,
    planned_program,
    shared_library,
    source_modules,
    with_project_library,
)
from scratch import scratch_directory
from unit import UnitDescription
from unit_freshness import description_digest

const MODULES: FrozenList[str] = [
    "main.incn",
    "reader.incn",
    "test_reader.incn",
    "test_writer.incn",
    "nested/conftest.incn",
    "nested/shape.incn",
    "nested/shape_test.incn",
]


def project_unit(root: Path, source: str, kind: str = "test") -> UnitDescription:
    """A unit of the project at `root` whose entry is `src/<source>`."""
    return UnitDescription(
        source=root.joinpath("src").joinpath(source).0,
        project_root=root.0,
        source_root=root.joinpath("src").0,
        package="demo-app",
        version="1",
        profile="debug",
        declared_features=[],
        active_features=[],
        loaves=[],
        rust_crates=[],
        contract_models=[],
        c_headers=[],
        kind=kind,
    )


def demo_project(root: Path) -> Result[None, str]:
    """A project whose source root holds a program entry, two plain modules and four test modules."""
    make_directory(root.joinpath("src/nested"))?
    write(root.joinpath("loaf.toml"), "[project]\nname = \"demo-app\"\nversion = \"1\"\n")?
    for name in MODULES:
        write(root.joinpath("src").joinpath(name), "\"\"\"A module.\"\"\"\n")?
    return Ok(None)


pub def test_a_test_unit_links_its_projects_shared_library() -> Result[None, str]:
    """A project's test module names the shared library and leaves out every test module of the source root."""
    scratch = scratch_directory()?
    root = scratch.path()
    demo_project(root)?
    linked = with_project_library(project_unit(root, "test_reader.incn"))?
    assert linked.project_library == Some("demo_app" + LIBRARY_SUFFIX)
    src = root.joinpath("src")
    assert linked.excluded_sources == [
        src.joinpath("nested/conftest.incn").0,
        src.joinpath("nested/shape_test.incn").0,
        src.joinpath("test_reader.incn").0,
        src.joinpath("test_writer.incn").0,
    ]
    description = linked.to_json()
    assert description.get("project_library") != None
    assert with_project_library(project_unit(root, "reader.incn"))?.project_library == None
    # A source root of tests and entry files alone has nothing to share.
    for name in ["reader.incn", "nested/shape.incn"]:
        root.joinpath("src").joinpath(name).unlink().map_err((error) => error.message())?
    assert with_project_library(project_unit(root, "test_reader.incn"))?.project_library == None
    return Ok(None)


pub def test_two_test_sources_share_one_shared_library() -> Result[None, str]:
    """Every test unit of a project describes one shared library, checked as a program, so it compiles once."""
    scratch = scratch_directory()?
    root = scratch.path()
    demo_project(root)?
    key = "demo_app" + LIBRARY_SUFFIX
    first = with_project_library(project_unit(root, "test_reader.incn"))?
    second = with_project_library(project_unit(root, "nested/shape_test.incn"))?
    reading = shared_library(first, key)?
    shaping = shared_library(second, key)?
    assert reading.kind == "library"
    assert reading.package == key
    assert reading.program_checks
    assert reading.project_library == None
    assert reading.source == shaping.source
    assert Path(reading.source).is_file()
    assert reading.excluded_sources == shaping.excluded_sources
    assert description_digest(reading)? == description_digest(shaping)?
    assert library_output(first, key, key).0 == library_output(second, key, key).0
    assert library_loaf(first, key, library_output(first, key, key)).key == key
    return Ok(None)


pub def test_a_program_unit_links_the_shared_library_its_projects_tests_link() -> Result[None, str]:
    """
    A project's program, from its root entry or from one of its modules, links the shared library the project's
    tests link: the same test modules left out, the same library unit, as `build` and `run` both plan it. A direct
    source never links it, and a program with further program entries keeps compiling its whole source graph, since
    each entry must stay a module of the program.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    demo_project(root)?
    key = "demo_app" + LIBRARY_SUFFIX
    tested = with_project_library(project_unit(root, "test_reader.incn"))?
    for entry in ["main.incn", "reader.incn"]:
        program = planned_program(project_unit(root, entry, "program"), false)?
        assert program.project_library == Some(key), entry
        assert program.excluded_sources == tested.excluded_sources, entry
        assert description_digest(shared_library(program, key)?)? == description_digest(shared_library(tested, key)?)?
        assert planned_program(project_unit(root, entry, "program"), true)?.project_library == None, entry
    mut entries = project_unit(root, "main.incn", "program")
    entries.program_entries = [root.joinpath("src/reader.incn").0]
    assert with_project_library(entries)?.project_library == None
    assert with_project_library(project_unit(root, "reader.incn", "library"))?.project_library == None
    return Ok(None)


pub def test_a_nested_project_keeps_its_modules_out_of_the_enclosing_shared_library() -> Result[None, str]:
    """
    A directory under a source root that holds its own `loaf.toml` is another project: its modules and tests are its
    own, compiled against its own dependencies, so the enclosing project's shared library and test list stop there.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    demo_project(root)?
    tool = root.joinpath("src/tool")
    make_directory(tool.joinpath("src"))?
    write(tool.joinpath("loaf.toml"), "[project]\nname = \"tool\"\nversion = \"1\"\n")?
    write(tool.joinpath("src/main.incn"), "\"\"\"Another project's entry.\"\"\"\n")?
    write(tool.joinpath("src/test_tool.incn"), "\"\"\"Another project's test.\"\"\"\n")?
    tests, provided = source_modules(root.joinpath("src"))?
    for path in tests + provided:
        assert not path.startswith(tool.0 + "/"), path
    # The source root itself is a project root and is still read.
    own_tests, own = source_modules(tool)?
    assert own_tests == [tool.joinpath("src/test_tool.incn").0]
    assert own == [tool.joinpath("src/main.incn").0]
    return Ok(None)


pub def test_a_change_inside_a_nested_project_leaves_the_enclosing_observation_unchanged() -> Result[None, str]:
    """
    The walk that records a project's source membership stops where its compilation stops: a nested project's
    directory is not entered, so a file added inside it changes nothing the enclosing project observes.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    demo_project(root)?
    tool = root.joinpath("src/tool")
    make_directory(tool.joinpath("src"))?
    write(tool.joinpath("loaf.toml"), "[project]\nname = \"tool\"\nversion = \"1\"\n")?
    before = children(root.joinpath("src"), ".incn")?
    assert "nested" in before.directories
    assert "tool" not in before.directories, "a nested project's directory is observed as the enclosing project's"
    write(tool.joinpath("src/added.incn"), "\"\"\"Another project's new module.\"\"\"\n")?
    after = children(root.joinpath("src"), ".incn")?
    assert after.files == before.files
    assert after.directories == before.directories
    return Ok(None)
