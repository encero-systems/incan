"""Write and compile one prepared unit through the installed compiler, without resolving dependencies."""

from rust::incan_loaf_names import native_crate_name
from rust::std::process import Command, Stdio
from rust::std::fs import remove_dir_all
from std.fs import Path
from std.json import parse
from driver_command import driver_command
from codegen import compiled_arguments
from darwin_executable import normalize_release_executable
from bakery import bakery
from compiler_refusals import compile_or_replay
from compiler_worker import compile_resident, served_resident
from files import discard_file, open_stream, read
from observation import trace_boundary
from publication import publish, publish_binary
from rust_facts import refresh as refresh_rust_facts
from shared_link import shared_arguments
from toolchain import Toolchain
from unit import UnitDescription, dependency_source_roots
from unit_freshness import Key, artifact_identity, unit_key
from compiler_body_values import SelectedBodyPage


pub model PlanRecordCounts:
    """Actual lowering producer work observed for one records-engine compiler activation."""

    pub plan_evaluations: int = 0
    pub plan_reuses: int = 0
    pub lowering_demand_evaluations: int = 0
    pub lowering_demand_reuses: int = 0
    pub native_interface_evaluations: int = 0


pub def compile_prepared_unit(
    unit: UnitDescription,
    toolchain: Toolchain,
    output: Path,
    known_key: Option[Key] = None,
    reason: str = "no stored build",
    development: bool = false,
    graph_body_records: Option[list[SelectedBodyPage]] = None,
) -> Result[i32, str]:
    """
    Compile one prepared unit without dependency selection or recursive preparation.

    1. Publish the description under its reconciled identity and prepare the output directory.
    2. Select profile flags and any requested shared development linkage.
    3. Compile or replay a certified refusal under the complete source identity.
    """
    # 1. The compiler reads the selected inputs and a generation-witnessed description.
    mut key = Key(digest="", parts=[])
    match known_key:
        Some(value) => key = value
        None => key = unit_key(unit, toolchain)?
    compiled = crate_name(unit)
    trace_boundary("unit_write_begin")
    path = write_unit(unit, compiled, None, described_by(key), true)?
    trace_boundary("unit_written")
    output.parent().mkdir(true, true).map_err((error) => f"{output.parent().0}: {error.message()}")?
    # 2. Native flags match the profile and the caller's explicit linkage request.
    executable = unit.kind in ["program", "test"]
    mut native = compiled_arguments(
        unit.profile,
        key.codegen,
        unit.project_root,
        executable,
        dependency_source_roots(unit),
        toolchain.sysroot,
    )? + shared_arguments(unit, development)?
    if let Some(records) = graph_body_records:
        records_path = Path(f"{path.0}.graph-body-records")
        if records_path.exists():
            remove_dir_all(records_path.0).map_err((error) => f"cannot replace selected plan inputs: {error}")?
        records_path.mkdir(true, true).map_err((error) => f"{records_path.0}: {error.message()}")?
        generation = match unit.checked_context:
            Some(value) => value
            None => return Err("records lowering requires the complete compiler context")
        publish_binary(records_path.joinpath("producer-profile"), generation.encode("utf-8"))?
        for page in records:
            publish_binary(records_path.joinpath(page.key), page.value)?
        native += ["--graph-body-records", records_path.0]
        native += ["--plan-record-products", records_path.0]
        output_path = Path(f"{path.0}.graph-body-output")
        discard_file(output_path)
        native += ["--graph-body-output", output_path.0]
        report = Path(f"{path.0}.graph-plan-report")
        if report.exists():
            remove_dir_all(report.0).map_err((error) => f"cannot replace plan record report {report.0}: {error}")?
        report.mkdir(true, true).map_err((error) => f"cannot create plan record report {report.0}: {error.message()}")?
        native += ["--plan-record-report", report.0]
    invocation = ["--unit", path.0, compiled, output.0, toolchain.sysroot]
    # 3. Refusal replay preserves the owner's request-local console routing.
    trace_boundary("compiler_request")
    code = compile_or_replay(unit, toolchain, invocation, native, bakery()?, key, reason)?
    if code == 0 and executable:
        normalize_release_executable(output, unit.profile)?
    return Ok(code)


pub def graph_body_output_path(unit: UnitDescription, key: Key) -> Path:
    """Name the invocation sidecar written beside this exact described unit without publishing another descriptor."""
    directory = Path(unit.project_root).joinpath("target").joinpath("incan").joinpath("units")
    return directory.joinpath(f"{described_by(key)}.unit.json.graph-body-output")


pub def plan_record_counts(unit: UnitDescription, key: Key) -> Result[PlanRecordCounts, str]:
    """Count only loss-checked plan products that the lowering reports as evaluated or reused for this request."""
    report = plan_record_report_path(unit, key)
    mut counts = PlanRecordCounts()
    if not report.is_dir():
        return Ok(counts)
    for entry in report.iterdir().map_err((error) => f"cannot read plan record report {report.0}: {error.message()}")?:
        if not entry.is_file() or not entry.name().endswith(".event"):
            continue
        text = entry.read_text("utf-8", "strict").map_err((error) => f"cannot read plan record event {entry.0}: {error.message()}")?
        event = parse(text).map_err((error) => f"cannot decode plan record event {entry.0}: {error.message()}")?
        reused = event.require("reused").map_err((error) => error.message())?.expect_bool().map_err(
            (error) => error.message(),
        )?
        function = event.require("function").map_err((error) => error.message())?.expect_str().map_err(
            (error) => error.message(),
        )?
        entry_role = event.get("role") is not None
        if reused:
            counts.plan_reuses += 1
            if not entry_role:
                counts.lowering_demand_reuses += 1
        else:
            counts.plan_evaluations += 1
            if not entry_role:
                counts.lowering_demand_evaluations += 1
    interface = report.joinpath("native-interface.json")
    if interface.is_file():
        value = parse(interface.read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
            (error) => error.message(),
        )?
        schema = value.require("schema").and_then((field) => field.expect_str()).map_err((error) => error.message())?
        if schema != "incan.native-interface/1":
            return Err("unsupported native-interface producer report")
        counts.native_interface_evaluations = 1
    return Ok(counts)


pub def plan_record_report_path(unit: UnitDescription, key: Key) -> Path:
    """Name the request-local lowering output consumed by proof counters and atomic Bakery publication."""
    directory = Path(unit.project_root).joinpath("target").joinpath("incan").joinpath("units")
    return directory.joinpath(f"{described_by(key)}.unit.json.graph-plan-report")


pub def crate_name(unit: UnitDescription) -> str:
    """Name the compiled crate from its package, or its source stem for a projectless unit."""
    if unit.package != "":
        return native_crate_name(unit.package)
    return native_crate_name(Path(unit.source).stem())


pub def write_unit(
    unit: UnitDescription,
    compiled: str,
    owner: Option[Path] = None,
    described: str = "",
    rust_facts: bool = false,
) -> Result[Path, str]:
    """
    Publish a description, retaining its generation only while the exact description witness remains valid.

    1. Select a description-specific path under the project or explicit owner.
    2. For a compile or check (`rust_facts`), bake the Rust ABI extractions its last run staged and index them in
       the `<name>.rust-facts` directory beside the description, where the compiler finds them.
    3. Reuse only a complete unchanged generation of that description.
    4. Otherwise publish the complete JSON and its new witness atomically.
    """
    # 1. An explicit owner controls only where the description is stored.
    mut root = Path(unit.project_root)
    if let Some(selected) = owner:
        root = selected
    directory = root.joinpath("target").joinpath("incan").joinpath("units")
    directory.mkdir(true, true).map_err((error) => f"{directory.0}: {error.message()}")?
    mut name = compiled
    if described != "":
        name = described
    path = directory.joinpath(f"{name}.unit.json")
    witness = Path(f"{path.0}.oven-description")
    # 2. The compiler finds the directory by the description's location, so the description itself is unchanged and
    #    a compiler that predates it reads the same description.
    if rust_facts:
        facts = directory.joinpath(f"{name}.rust-facts")
        facts.mkdir(true, true).map_err((error) => f"{facts.0}: {error.message()}")?
        refresh_rust_facts(bakery()?, facts, unit.project_root)?
    # 3. This witness grants descriptor reuse, never source acceptance or artifact reuse.
    if described != "" and description_current(path, witness, described):
        return Ok(path)
    # 4. Missing, changed and unwitnessed descriptions are published again.
    text = unit.to_json().to_pretty_json().map_err((error) => error.message())?
    publish(path, text)?
    if described != "":
        publish(witness, description_witness(described, artifact_identity(path)?))?
    return Ok(path)


pub def described_by(key: Key) -> str:
    """Read the exact descriptor's provenance witness; it must never substitute for portable unit identity."""
    return key.descriptor


def description_current(path: Path, witness: Path, described: str) -> bool:
    """Treat failed witness reads or file observations as reasons to publish the descriptor again."""
    match verified_description(path, witness, described):
        Ok(current) => return current
        Err(_) => return false


def verified_description(path: Path, witness: Path, described: str) -> Result[bool, str]:
    """Bracket the exact witness read with complete file observations before retaining the existing generation."""
    stamp = artifact_identity(path)?
    text = read(witness)?
    if text != description_witness(described, stamp):
        return Ok(false)
    return Ok(artifact_identity(path)? == stamp)


def description_witness(described: str, stamp: str) -> str:
    """Bind a published descriptor's exact generation to its caller's complete description identity."""
    return f"incan.oven.description/1\n{described}\n{stamp}\n"


pub def run_compiler(toolchain: Toolchain, arguments: list[str]) -> Result[i32, str]:
    """
    Run the installed compiler without an inherited bootstrap override, preserving its stream destinations.

    1. Use the resident worker for unit compilation, checking and formatting when it is available.
    2. Otherwise bind the original driver, SDK configuration and request-local streams.
    3. Preserve the process status without retrying a submitted worker request.
    """
    # 1. A submitted worker request is never replayed through another compiler process.
    if served_resident(arguments):
        match compile_resident(toolchain, arguments)?:
            Some(code) => return Ok(code)
            None => pass
    # 2. The cold process retains SDK selection and the owner's explicit console sinks.
    mut command = driver_command(toolchain)?
    for argument in arguments:
        command.arg(argument)
    # Project owners retain the original bytes in their request-local stream files.
    if toolchain.console != "":
        command.stdout(Stdio.from(open_stream(f"{toolchain.console}.out")?))
        command.stderr(Stdio.from(open_stream(f"{toolchain.console}.err")?))
    # 3. Signal termination remains a failure, like any other compiler exit.
    return status_of(command, toolchain.driver)


def status_of(mut command: &mut Command, program: str) -> Result[i32, str]:
    """Run with the caller's streams, mapping a signal termination to exit code one."""
    match command.status():
        Err(error) => return Err(f"cannot run {program}: {error}")
        Ok(status) =>
            match status.code():
                Some(code) => return Ok(code)
                None => return Ok(1)
