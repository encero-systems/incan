"""Adapt Oven's observation switches and compatibility formats to the platform's single span and channel home."""

from rust::std::io import Write, stderr
from rust::std::process import id
from rust::std::string import String as RustString
from rust::std::time import SystemTime, UNIX_EPOCH
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue
from pub::incan_platform.trace import Clock, Counters, Emitter, EngineSpan, Operation, TraceError, append, begin, complete, record
from pub::incan_platform.trace import flush as flush_channels


pub model WorkCounts:
    """Measured input operations in one contract scope, projected from the ordinary work producer."""

    pub reads: int
    pub hashes: int
    pub parses: int
    pub decodes: int
    pub stats: int
    pub pages: int


model ObservationChannels:
    """One invocation's destinations and first observer failure, reported only at command completion."""

    loaded: bool = false
    canonical: str = ""
    legacy_work: str = ""
    legacy_reason: str = ""
    run: str = ""
    request: str = ""
    process: int = 0
    # A scoped contract observer uses this same producer boundary without opening an output channel.
    counting_prefix: str = ""
    counts: Dict[str, int] = {}
    emitter: Option[Emitter] = None
    failure: Option[TraceError] = None
    reported: bool = false

    def load(mut self) -> None:
        """Read observation configuration once, before the invocation's first enabled operation."""
        if self.loaded:
            return
        self.loaded = true
        directory = get_or("INCAN_ENGINE_TRACE", "")
        self.legacy_work = get_or("INCAN_JEC_TRACE", "")
        self.legacy_reason = get_or("OVEN_TRACE", "")
        if directory == "" and self.legacy_work == "" and self.legacy_reason == "":
            return
        self.process = int(id())
        if directory != "":
            self.canonical = Path(directory).joinpath(f"engine-oven-{self.process}.jsonl").0
        self.run = get_or("INCAN_ENGINE_RUN", "")
        self.request = get_or("INCAN_ENGINE_REQUEST", f"oven-{self.process}")
        if self.canonical != "":
            match Emitter.open(self.canonical, "oven", self.run, self.request):
                Ok(emitter) => self.emitter = Some(emitter)
                Err(error) => self.remember(Err(error))

    def work_clock(mut self) -> Option[Clock]:
        """Start only a requested JEC or canonical engine observation."""
        self.load()
        return begin(self.canonical != "" or self.legacy_work != "" or self.counting_prefix != "")

    def work(mut self, category: Operation, key: str, clock: Option[Clock], bytes: int) -> None:
        """Publish a completed operation and its requested compatibility projection."""
        match clock:
            None => return
            Some(started) =>
                self.load()
                if self.counting_prefix != "" and key.startswith(self.counting_prefix):
                    name = category.key()
                    self.counts[name] = self.counts.get(name, 0) + 1
                if self.legacy_work != "":
                    self.export_work(started, category, key, bytes)
                else:
                    self.publish(started, category, key, bytes)

    def export_work(mut self, clock: Clock, operation: Operation, key: str, bytes: int) -> None:
        """Project one completion into both requested formats with identical timing and counters."""
        span = complete(
            clock, "oven", operation.key(), key, Counters(bytes=bytes, calls=1), run=self.run, request=self.request,
            work=f"{self.process}:{clock.span}",
        )
        if self.canonical != "":
            self.remember(record(self.canonical, span))
        self.remember(compatibility_work(self.legacy_work, span))

    def count_work(mut self, prefix: str) -> None:
        """Start a bounded contract observation of operations whose input lies under this prefix."""
        self.counting_prefix = prefix
        self.counts = {}

    def finish_counting(mut self) -> WorkCounts:
        """End the contract scope and return only its operation counts, releasing the prefix and retained table."""
        counts = WorkCounts(
            reads=self.counts.get("file_read", 0),
            hashes=self.counts.get("file_hash", 0),
            parses=self.counts.get("manifest_parse", 0),
            decodes=self.counts.get("json_decode", 0),
            stats=self.counts.get("file_stat", 0),
            pages=self.counts.get("installation_page", 0),
        )
        self.counting_prefix = ""
        self.counts = {}
        return counts

    def reason(mut self, message: str) -> None:
        """Record reasoning once at its producer and export the requested legacy line."""
        self.load()
        if self.canonical == "" and self.legacy_reason == "":
            return
        line = f"oven: {message}"
        if self.canonical != "":
            match begin(true):
                Some(clock) => self.publish(clock, Operation.Reason, line, 0)
                None => pass
        self.relay([line])

    def relay(mut self, lines: list[str]) -> None:
        """Export owner observations without recording a duplicate canonical operation."""
        self.load()
        if self.legacy_reason == "":
            return
        for line in lines:
            self.remember(compatibility_line(self.legacy_reason, line + "\n"))

    def publish(mut self, clock: Clock, operation: Operation, key: str, bytes: int) -> None:
        """Use the retained typed emitter; unavailable observation never writes a program stream."""
        match self.emitter:
            Some(emitter) => self.remember(emitter.emit(clock, operation, key, bytes))
            None => pass

    def remember(mut self, result: Result[None, TraceError]) -> None:
        """Keep the first typed observer failure, even if later records or flushes succeed."""
        match result:
            Err(error) =>
                if self.failure is None:
                    self.failure = Some(error)
            Ok(_) => pass

    def flush(mut self) -> bool:
        """Drain every platform channel without reporting yet; a failed trace needs a returning launch."""
        self.remember(flush_channels())
        return self.failure is not None

    def finish(mut self) -> None:
        """Report a requested observation failure once, after command output and without changing its status."""
        _ = self.flush()
        if self.reported:
            return
        self.reported = true
        match self.failure:
            None => return
            Some(error) =>
                mut output = stderr()
                message = f"incan: trace incomplete: {failure_message(error)}\n"
                _ = output.write_all(RustString.from(message).into_bytes())


static CHANNELS: ObservationChannels = ObservationChannels()


pub def count_work(prefix: str) -> None:
    """Observe work for a contract through the ordinary producer boundary; no extra trace channel is created."""
    CHANNELS.count_work(prefix)


pub def finish_counting() -> WorkCounts:
    """Release the scoped observer and return its measured operation counts."""
    return CHANNELS.finish_counting()


pub def work_clock() -> Option[Clock]:
    """Start work only when its canonical channel or existing JEC export was requested at process start."""
    return CHANNELS.work_clock()


pub def work(category: Operation, key: str, clock: Option[Clock], bytes: int) -> None:
    """Publish one completed platform span and its requested legacy JEC projection."""
    CHANNELS.work(category, key, clock, bytes)


pub def reason(message: str) -> None:
    """Record a local reasoning event and export the requested legacy text representation."""
    CHANNELS.reason(message)


pub def relay(lines: list[str]) -> None:
    """Relay owner reasoning through the same observation adapter as local events."""
    CHANNELS.relay(lines)


pub def flush() -> bool:
    """Drain requested observations before launch; true means completion must return to report the failure."""
    return CHANNELS.flush()


pub def finish() -> None:
    """Drain observations and report at most one failure after the command's own output."""
    CHANNELS.finish()


def failure_message(error: TraceError) -> str:
    """Explain the platform's typed failure without discarding bound or invalid-record refusals."""
    match error:
        TraceError.Channel => return "output channel unavailable"
        TraceError.FieldBound => return "text field exceeds its bound"
        TraceError.RecordBound => return "record exceeds its bound"
        TraceError.InvalidSpan => return "invalid span"


def compatibility_work(directory: str, span: &EngineSpan) -> Result[None, TraceError]:
    """
    Export the old JEC keys from the same completed span for existing measurement scripts. The wall-clock end lets a
    measurement partition nested spans against its own command timestamps without double counting.
    """
    mut ended = 0
    if let Ok(now) = SystemTime.now().duration_since(UNIX_EPOCH):
        ended = int(now.as_nanos())
    fields = JsonValue.object(
        {"schema": JsonValue.string("incan.jec/1"), "process": JsonValue.int(span.process), "category": JsonValue.string(
            span.operation,
        ), "input": JsonValue.string(span.key), "nanoseconds": JsonValue.int(span.end_ns - span.start_ns), "ended_ns": JsonValue.int(
            ended,
        ), "bytes": JsonValue.int(span.counters.bytes), "allocations": JsonValue.null()},
    )
    text = fields.to_json().map_err((_) => TraceError.InvalidSpan)?
    return append(Path(directory).joinpath(f"oven-{span.process}.jsonl").0, text + "\n")


def compatibility_line(destination: str, text: str) -> Result[None, TraceError]:
    """Export a legacy text line; only the explicit legacy `-` request selects stderr."""
    if destination == "-":
        mut output = stderr()
        output.write_all(RustString.from(text).into_bytes()).map_err((_) => TraceError.Channel)?
        return Ok(None)
    return append(destination, text)
