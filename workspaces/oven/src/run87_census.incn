"""Count reusable and fallback callable declarations in one retained compiler sidecar."""

from rust::std::env import args
from rust::std::fs import metadata
from std.fs import Path
from pub::internal_models import CompiledBodyOutput, compiled_body_frame_size, decode_compiled_body_payload


def main() -> Result[None, str]:
    """Decode every independently framed record and report the callable reuse denominator."""
    arguments = [argument for argument in args()]
    if len(arguments) != 2:
        return Err("usage: run87_census SIDECAR")
    path = Path(arguments[1])
    mut file = path.open("rb").map_err((error) => error.message())?
    mut remaining = metadata(path.0).map_err((error) => str(error))?.len()
    mut frames = 0
    mut reusable = 0
    mut fallback = 0
    mut malformed = 0
    mut namespaces = 0
    while remaining > 0u64:
        if remaining < 8u64:
            return Err(f"truncated prefix after frame {frames}")
        prefix = file.read_exact(8).map_err((error) => error.message())?
        size = compiled_body_frame_size(prefix).map_err((error) => f"frame {frames} prefix: {error:?}")?
        converted: Option[u64] = size.try_resize()
        frame_bytes = match converted:
            Some(value) => value
            None => return Err(f"frame {frames} exceeds host range")
        if frame_bytes + 8u64 > remaining:
            return Err(f"frame {frames} is truncated")
        payload = file.read_exact(size).map_err((error) => error.message())?
        remaining -= frame_bytes + 8u64
        match decode_compiled_body_payload(payload):
            Err(_) => malformed += 1
            Ok(CompiledBodyOutput.Namespace(_)) => namespaces += 1
            Ok(CompiledBodyOutput.Value(_)) => reusable += 1
            Ok(CompiledBodyOutput.Fallback(_)) => fallback += 1
        frames += 1
    declarations = reusable + fallback
    println(
        f"FRAMES\t{frames}\nREUSABLE\t{reusable}\nFALLBACK\t{fallback}\nDECLARATIONS\t{declarations}\nMALFORMED\t{malformed}\nNAMESPACES\t{namespaces}",
    )
    return Ok(None)
