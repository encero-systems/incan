"""
The unit description (`incan.unit/1`, DD-0008): everything the compiler knows about one unit, as Oven describes it.
The compiler reads no manifest; it reads this. Its fields are the compiler's `incan_driver::unit::UnitDescription`.
"""

from std.fs import Path
from std.json import JsonValue
from features import ActiveGraph, FeatureRequest, resolve_features
from home import StandardPackage, dependency_artifact_dir, standard_artifact_dir, standard_packages
from intake import LocalIntake, LocalProject, intake, source_root_of
from loaf_local_graph import LocalFacet
from toolchain import NativeCrate

pub const UNIT_DESCRIPTION_SCHEMA: str = "incan.unit/1"


pub model UnitLoaf:
    """One Loaf a unit reaches."""

    # The key the unit names it by: its dependency key, its package name when reached transitively, or a standard
    # package's name.
    pub key: str
    pub name: str
    # Its artifact directory for the unit's profile.
    pub dir: str
    pub standard: bool
    # Compiler-provided facades are inputs rather than dependencies authored in the project manifest.
    pub toolchain_provided: bool = false
    # The authored source root supplied by Oven, never inferred from the consumer's artifact layout.
    pub source_root: Option[str] = None

    def is_dependency(self) -> bool:
        """Identify a project-authored dependency rather than a standard provider or compiler facade."""
        return not self.standard and not self.toolchain_provided

    def to_json(self) -> JsonValue:
        """The Loaf as the description spells it."""
        mut fields = {"key": JsonValue.string(self.key), "name": JsonValue.string(self.name), "dir": JsonValue.string(
            self.dir,
        ), "standard": JsonValue.bool(self.standard)}
        fields["toolchain_provided"] = JsonValue.bool(self.toolchain_provided)
        if let Some(root) = self.source_root:
            fields["source_root"] = JsonValue.string(root)
        return JsonValue.object(fields)


pub model UnitDescription:
    """One unit: its source, its package and every Loaf it reaches."""

    pub source: str
    pub project_root: str
    pub source_root: str
    pub package: str
    pub version: str
    pub profile: str
    pub declared_features: list[str]
    pub active_features: list[str]
    pub loaves: list[UnitLoaf]
    pub rust_crates: list[str]
    pub contract_models: list[str]
    pub c_headers: list[str]
    pub externs: list[NativeCrate] = []
    # The directories beyond the toolchain generation's search index.
    pub search: list[str] = []
    # The toolchain generation's search index, which the compiler merges with `search` (see `search_index`).
    pub search_index: Option[str] = None
    pub rust_abi: list[str] = []
    pub kind: str = "program"
    pub program_entries: list[str] = []
    pub vocab_entry: Option[str] = None
    pub vocab: Option[str] = None
    pub vocabulary: bool = false
    pub vocab_admissions: list[str] = []
    pub vocab_policy: str = "locked-dependencies"
    pub vocab_desugarer: bool = false
    # Oven retains the selected graph in memory; it is not part of the compiler's unit description.
    pub facets: list[LocalFacet] = []

    def to_json(self) -> JsonValue:
        """The description as the compiler reads it."""
        return JsonValue.object(
            {"schema": JsonValue.string(UNIT_DESCRIPTION_SCHEMA), "source": JsonValue.string(self.source), "kind": JsonValue.string(
                self.kind,
            ), "program_entries": texts(self.program_entries), "project_root": JsonValue.string(self.project_root), "source_root": JsonValue.string(
                self.source_root,
            ), "package": JsonValue.string(self.package), "version": JsonValue.string(self.version), "profile": JsonValue.string(
                self.profile,
            ), "declared_features": texts(self.declared_features), "active_features": texts(self.active_features), "loaves": JsonValue.array(
                [loaf.to_json() for loaf in self.loaves],
            ), "rust_crates": texts(self.rust_crates), "contract_models": texts(self.contract_models), "c_headers": texts(
                self.c_headers,
            ), "vocab": optional_text(self.vocab), "vocab_entry": optional_text(self.vocab_entry), "vocabulary": JsonValue.bool(
                self.vocabulary,
            ), "vocab_admissions": texts(self.vocab_admissions), "vocab_policy": JsonValue.string(self.vocab_policy), "vocab_desugarer": JsonValue.bool(
                self.vocab_desugarer,
            ), "externs": JsonValue.array([item.to_json() for item in self.externs]), "search": texts(self.search), "search_index": optional_text(
                self.search_index,
            ), "rust_abi": texts(self.rust_abi)},
        )


def texts(items: list[str]) -> JsonValue:
    """A JSON array of strings."""
    return JsonValue.array([JsonValue.string(item) for item in items])


def optional_text(value: Option[str]) -> JsonValue:
    """Encode an absent descriptor path as null."""
    match value:
        Some(path) => return JsonValue.string(path)
        None => return JsonValue.null()


pub def project_root_of(source: Path) -> Option[Path]:
    """The nearest directory at or above `source`'s directory that holds a `loaf.toml`."""
    mut directory = source.parent()
    while true:
        if directory.joinpath("loaf.toml").is_file():
            return Some(directory)
        parent = directory.parent()
        if parent.0 == directory.0 or parent.0 in ["", "."]:
            return None
        directory = parent
    return None


def standard_loaves(package: str, profile: str) -> Result[list[UnitLoaf], str]:
    """
    The standard packages a unit of `package` reaches. They are ambient: every one is available, the unit's own
    package excepted, and the unit links the ones it uses.
    """
    mut loaves: list[UnitLoaf] = []
    for found in standard_packages()?:
        if found.name != package:
            directory = standard_artifact_dir(found.name, profile)?
            loaves.append(UnitLoaf(key=found.name, name=found.name, dir=directory.0, standard=true))
    return Ok(loaves)


pub def describe(source: Path, profile: str, request: FeatureRequest) -> Result[UnitDescription, str]:
    """Describe the unit whose entry source is `source`, for `profile` and the features `request` asks for."""
    entry = source.absolute().map_err((error) => f"{source.0}: {error.message()}")?
    if not entry.is_file():
        return Err(f"{entry.0}: no such source file")
    match project_root_of(entry):
        None => return Ok(single_file_unit(entry, profile, standard_loaves("", profile)?))
        Some(found) =>
            graph = intake(found).map_err((error) => error.message())?
            root = found.resolve().map_err((error) => f"{found.0}: {error.message()}")?
            active = resolve_features(graph, root.0, request)?
            projects = projects_by_root(graph.projects)
            return project_unit(entry, projects[root.0], profile, root.0, active, projects)


def projects_by_root(found: list[LocalProject]) -> Dict[str, LocalProject]:
    """The projects of a graph, by their root directories."""
    mut projects: Dict[str, LocalProject] = {}
    for project in found:
        projects[project.root] = project
    return projects


def project_unit(
    entry: Path,
    own: LocalProject,
    profile: str,
    artifact_root: str,
    active: ActiveGraph,
    projects: Dict[str, LocalProject],
) -> Result[UnitDescription, str]:
    """Describe one project in the root's selected graph; dependency builds share its artifact layout."""
    return Ok(
        UnitDescription(
            source=entry.0,
            project_root=own.root,
            source_root=source_root_of(own),
            package=own.intent.name,
            version=own.intent.version,
            profile=profile,
            declared_features=sorted([name for name in own.intent.features.keys()]),
            active_features=active.active[own.root],
            loaves=project_loaves(own, profile, artifact_root, active, projects)?,
            rust_crates=rust_crates_of(own),
            contract_models=own.intent.contract_models,
            c_headers=own.intent.c_headers,
            vocab_entry=own.intent.vocab_entry,
            facets=active.facets,
        ),
    )


def project_loaves(
    own: LocalProject,
    profile: str,
    artifact_root: str,
    active: ActiveGraph,
    projects: Dict[str, LocalProject],
) -> Result[list[UnitLoaf], str]:
    """
    List a project's reachable Loaves, preserving direct aliases before transitive package names.

    1. Find every project reachable from this one through the active edges.
    2. The direct dependencies come first, each under the alias this project names it by.
    3. The transitive ones follow, each under its package name.
    4. The standard packages come last.
    """
    # 1. A unit links every project reachable through the active edges, however far.
    reached = reachable_roots(own.root, active)
    # 2. A direct dependency is named in the unit's source by the alias the project gave it.
    mut loaves: list[UnitLoaf] = []
    mut direct: list[str] = []
    for edge in active.edges:
        if edge.requester_root != own.root:
            continue
        dependency = projects[edge.dependency_root]
        directory = dependency_artifact_dir(artifact_root, dependency.intent.name, profile)
        loaves.append(
            UnitLoaf(
                key=edge.alias,
                name=dependency.intent.name,
                dir=directory.0,
                standard=false,
                source_root=Some(source_root_of(dependency)),
            ),
        )
        direct.append(edge.dependency_root)
    # 3. A transitive dependency is named by its package, since no alias of this project reaches it.
    for root in reached[1:]:
        if root in direct:
            continue
        name = projects[root].intent.name
        directory = dependency_artifact_dir(artifact_root, name, profile)
        loaves.append(
            UnitLoaf(
                key=name,
                name=name,
                dir=directory.0,
                standard=false,
                source_root=Some(source_root_of(projects[root])),
            ),
        )
    # 4. Every standard package is available, except the one the unit is.
    return Ok(loaves + standard_loaves(own.intent.name, profile)?)


def reachable_roots(start: str, active: ActiveGraph) -> list[str]:
    """The project at `start` and every project reachable from it through the active edges, in discovery order."""
    mut reached = [start]
    mut index = 0
    while index < len(reached):
        for edge in active.edges:
            if edge.requester_root == reached[index] and edge.dependency_root not in reached:
                reached.append(edge.dependency_root)
        index += 1
    return reached


def single_file_unit(entry: Path, profile: str, standard: list[UnitLoaf]) -> UnitDescription:
    """A program outside any project: its directory is its project and source root, its stem its package."""
    directory = entry.parent()
    return UnitDescription(
        source=entry.0,
        project_root=directory.0,
        source_root=directory.0,
        package=entry.stem(),
        version="0.0.0",
        profile=profile,
        declared_features=[],
        active_features=[],
        loaves=standard,
        rust_crates=[],
        contract_models=[],
        c_headers=[],
    )


def rust_crates_of(project: LocalProject) -> list[str]:
    """
    The Rust crates a package's `rust::` imports may name: its Rust dependencies and the sibling Loaves' crates its
    Rust facet links.
    """
    mut names = [request.alias.replace("-", "_") for request in project.intent.rust_inputs]
    for dependency in project.intent.dependencies:
        alias = dependency.alias.replace("-", "_")
        if dependency.rust_facet and alias not in names:
            names.append(alias)
    return sorted(names)
