"""
Plan the `loaf.toml` changes of the dependency commands from the manifest's text and the published registry
units, without writing a file (RFC 118, RFC 125). An entry is added, changed or removed, nothing else changes, and a
planned text must read back as planned.
"""

from std.toml import TomlValue
from loaf_identity import crate_name, refuse_capitals, validate_loaf_identity
from registry_units import RegistryUnit
from semver_req import (
    Comparator,
    Operator,
    Version,
    VersionReq,
    compare_versions,
    named_version,
    parse_requirement,
    parse_version,
    requirement_matches,
    version_text,
)

const DEPENDENCIES: str = "[dependencies]"


pub model ManifestChange:
    """A planned `loaf.toml` text and the lines the command reports; an unchanged text needs no write."""

    pub text: str
    pub report: list[str]


pub model RegistryDependency:
    """One registry entry of a manifest's `[dependencies]`: its key, its Loaf and its version requirement."""

    pub key: str
    pub loaf: str
    pub requirement: str


model Raise:
    """One requirement's planned raise: its new text, or why it stays; both empty when it is already current."""

    requirement: str = ""
    reason: str = ""


pub def plan_add(
    name: str,
    version: str,
    key: str,
    text: str,
    manifest: str,
    units: list[RegistryUnit],
) -> Result[ManifestChange, str]:
    """
    Add one registry dependency to the manifest's `[dependencies]` (RFC 125).

    1. The name is a full Loaf name without capitals; a short one is refused with the published full names it ends.
    2. The requirement is the one named, else the newest published version, spelled in full.
    3. The key is the name's last part with `-` as `_`, or the one named; a taken key is refused.
    4. One line is written after the table's last entry, or the table is appended, and it must read back.
    """
    # 1. Oven never guesses a full name.
    loaf = full_name(name, [unit.loaf for unit in units if unit.refusal == ""], "published Loaf")?
    # 2. A new dependency starts at the newest published version.
    mut requirement = version
    if requirement == "":
        match newest_published(units, loaf, "")?:
            None => return Err(f"{loaf} is not published in the toolchain's registry")
            Some(newest) => requirement = version_text(newest)
    else:
        _ = parse_requirement(requirement).map_err((reason) => f"`--version {requirement}`: {reason}")?
    # 3. A key names one package; a collision is settled by choosing another key.
    mut chosen = key
    if chosen == "":
        chosen = crate_name(loaf)
    declared = declared_keys(text, manifest)?
    if chosen in declared:
        if declared[chosen] == loaf:
            return Err(f"`{chosen}` already names {loaf} in {manifest}; raise it with `oven update {loaf}`")
        return Err(f"the key `{chosen}` is taken in {manifest}; choose another with `--key KEY`")
    # 4. Only the new line is written.
    line = chosen + " = { loaf = \"" + loaf + "\", version = \"" + requirement + "\" }"
    changed = inserted(text, line)
    read_back(changed, manifest, chosen, loaf, requirement)?
    return Ok(ManifestChange(text=changed, report=[f"added {loaf}, version = \"{requirement}\""]))


pub def plan_update(name: str, text: str, manifest: str, units: list[RegistryUnit]) -> Result[ManifestChange, str]:
    """
    Raise the manifest's registry requirements on request (RFC 125).

    1. With a name, the entries that name that Loaf; without one, every registry entry.
    2. A requirement's one `^`, `~` or `>=` comparator moves to the newest published version it admits, keeping its
       operator and its upper bound. A pin, a wildcard or a requirement with two such bounds is reported and kept.
    3. Only that requirement's quoted value changes, and the result must read back as planned.
    """
    # 1. A named Loaf must be a dependency, named in full.
    dependencies = registry_dependencies(text, manifest)?
    mut selected = dependencies
    if name != "":
        loaf = full_name(name, [dependency.loaf for dependency in dependencies], "registry dependency")?
        selected = [dependency for dependency in dependencies if dependency.loaf == loaf]
        if len(selected) == 0:
            return Err(f"{loaf} is not a registry dependency in {manifest}")
    # 2. and 3. Each raise changes one quoted value.
    mut changed = text
    mut report: list[str] = []
    for dependency in selected:
        planned = raised(dependency, units)?
        if planned.reason != "":
            report.append(f"{dependency.loaf} {dependency.requirement}: kept, {planned.reason}")
        elif planned.requirement != "":
            changed = replaced_requirement(changed, manifest, dependency, planned.requirement)?
            read_back(changed, manifest, dependency.key, dependency.loaf, planned.requirement)?
            report.append(f"{dependency.loaf} {dependency.requirement} → {planned.requirement}")
    if len(report) == 0:
        report.append("nothing to raise")
    return Ok(ManifestChange(text=changed, report=report))


pub def full_name(name: str, candidates: list[str], noun: str) -> Result[str, str]:
    """
    A full, lowercase Loaf name (RFC 125). A capital is refused rather than folded, and a short name is refused with
    every candidate whose last part it is, since several Loaves may share one.
    """
    refuse_capitals(name)?
    if "/" not in name:
        mut matches: list[str] = []
        for candidate in candidates:
            if candidate.split("/")[-1] == name and candidate not in matches:
                matches.append(candidate)
        if len(matches) == 0:
            return Err(f"`{name}` is not a full Loaf name, and no {noun} is named `SCOPE/{name}`")
        listed = ", ".join(sorted(matches))
        return Err(f"`{name}` is not a full Loaf name, and Oven never guesses one; name one of: {listed}")
    validate_loaf_identity(name).map_err((reason) => f"`{name}`: {reason}")?
    return Ok(name)


pub def newest_published(units: list[RegistryUnit], loaf: str, requirement: str) -> Result[Option[Version], str]:
    """The newest published, unrefused version of `loaf` that `requirement` admits; any version when it is empty."""
    mut wanted: list[VersionReq] = []
    if requirement != "":
        wanted.append(parse_requirement(requirement)?)
    mut newest: list[Version] = []
    for unit in units:
        if unit.loaf != loaf or unit.refusal != "":
            continue
        version = parse_version(unit.version)?
        if len(wanted) > 0 and not requirement_matches(wanted[0], version):
            continue
        if len(newest) == 0:
            newest.append(version)
        elif compare_versions(version, newest[0]) > 0:
            newest[0] = version
    if len(newest) == 0:
        return Ok(None)
    return Ok(Some(newest[0]))


pub def registry_dependencies(text: str, manifest: str) -> Result[list[RegistryDependency], str]:
    """The `[dependencies]` entries that name a Loaf with a version requirement and no path, by key."""
    mut found: list[RegistryDependency] = []
    entries = dependency_tables(text, manifest)?
    for key in sorted([name for name in entries.keys()]):
        entry = entries[key]
        if "loaf" not in entry or "version" not in entry or "path" in entry:
            continue
        loaf = entry["loaf"].as_str().map_err((_) => f"{manifest}: `dependencies.{key}.loaf` must be a string")?
        requirement = entry["version"]
            .as_str()
            .map_err((_) => f"{manifest}: `dependencies.{key}.version` must be a string")?
        found.append(RegistryDependency(key=key, loaf=loaf, requirement=requirement))
    return Ok(found)


def declared_keys(text: str, manifest: str) -> Result[Dict[str, str], str]:
    """Every `[dependencies]` key with the Loaf it names, or an empty name when it names none."""
    mut declared: Dict[str, str] = {}
    document = parsed(text, manifest)?
    if "dependencies" not in document:
        return Ok(declared)
    table = document["dependencies"].as_table().map_err((_) => f"{manifest}: `dependencies` must be a table")?
    for key in table.keys():
        declared[key] = ""
    entries = dependency_tables(text, manifest)?
    for key in entries.keys():
        if "loaf" in entries[key]:
            declared[key] = entries[key]["loaf"].as_str().unwrap_or("")
    return Ok(declared)


def dependency_tables(text: str, manifest: str) -> Result[Dict[str, Dict[str, TomlValue]], str]:
    """The `[dependencies]` entries that are tables, by key."""
    mut tables: Dict[str, Dict[str, TomlValue]] = {}
    document = parsed(text, manifest)?
    if "dependencies" not in document:
        return Ok(tables)
    table = document["dependencies"].as_table().map_err((_) => f"{manifest}: `dependencies` must be a table")?
    for key in table.keys():
        match table[key].as_table():
            Ok(entry) => tables[key] = entry
            Err(_) => pass
    return Ok(tables)


def parsed(text: str, manifest: str) -> Result[Dict[str, TomlValue], str]:
    """The manifest's top-level table."""
    document = TomlValue.parse(text).map_err((error) => f"{manifest}: {error.message()}")?
    return document.as_table().map_err((error) => f"{manifest}: {error.message()}")


def read_back(text: str, manifest: str, key: str, loaf: str, requirement: str) -> Result[None, str]:
    """Refuse a planned manifest unless it parses and `key` names `loaf` at `requirement`."""
    for dependency in registry_dependencies(text, manifest)?:
        if dependency.key == key and dependency.loaf == loaf and dependency.requirement == requirement:
            return Ok(None)
    return Err(f"{manifest}: the edit would not read back `{key}` as {loaf} at `{requirement}`; edit it by hand")


def inserted(text: str, line: str) -> str:
    """`text` with `line` after the last entry of its `[dependencies]` table, or with that table appended."""
    lines = text.split("\n")
    mut header = -1
    for index in range(len(lines)):
        if section_of(lines[index]) == DEPENDENCIES:
            header = index
            break
    if header < 0:
        mut appended = text
        if appended != "" and not appended.endswith("\n"):
            appended += "\n"
        if appended != "":
            appended += "\n"
        return appended + DEPENDENCIES + "\n" + line + "\n"
    mut last = header
    mut index = header + 1
    while index < len(lines) and not lines[index].strip().startswith("["):
        if lines[index].strip() != "":
            last = index
        index += 1
    mut changed = lines[:last + 1]
    changed.append(line)
    return "\n".join(changed + lines[last + 1:])


def section_of(line: str) -> str:
    """The table header `line` opens, without a trailing comment, or an empty string."""
    stripped = line.strip()
    if not stripped.startswith("[") or "]" not in stripped:
        return ""
    header = stripped.split("]")[0] + "]"
    rest = stripped[len(header):].strip()
    if rest != "" and not rest.startswith("#"):
        return ""
    return header


def raised(dependency: RegistryDependency, units: list[RegistryUnit]) -> Result[Raise, str]:
    """The requirement `dependency` is raised to, keeping its operator and upper bound, or why it is kept."""
    wanted = parse_requirement(dependency.requirement).map_err(
        (reason) => f"{dependency.loaf} `{dependency.requirement}`: {reason}",
    )?
    mut bounds: list[int] = []
    for index in range(len(wanted.comparators)):
        operator = wanted.comparators[index].operator
        if operator == Operator.Caret or operator == Operator.Tilde or operator == Operator.GreaterEqual:
            bounds.append(index)
    if len(bounds) != 1:
        if len(bounds) == 0:
            return Ok(Raise(reason="it has no `^`, `~` or `>=` bound to raise"))
        return Ok(Raise(reason="it has more than one bound to raise"))
    comparator = wanted.comparators[bounds[0]]
    if len(comparator.prerelease) > 0:
        return Ok(Raise(reason="its bound names a pre-release"))
    match newest_published(units, dependency.loaf, dependency.requirement)?:
        None => return Ok(Raise(reason="no published version satisfies it"))
        Some(newest) =>
            if compare_versions(newest, named_version(comparator)) <= 0:
                return Ok(Raise())
            target = Comparator(
                operator=comparator.operator,
                parts=[newest.major, newest.minor, newest.patch],
                prerelease=[],
            )
            if upper_prefix(target) != upper_prefix(comparator):
                return Ok(Raise(reason=f"raising it to {version_text(newest)} would lower its upper bound"))
            mut members = dependency.requirement.split(",")
            members[bounds[0]] = respelled(members[bounds[0]], version_text(newest))
            return Ok(Raise(requirement=",".join(members)))


def upper_prefix(comparator: Comparator) -> list[str]:
    """
    The components that decide a comparator's exclusive upper bound: `^` raises its first nonzero component, or its
    last; `~` its minor, or its major alone; `>=` has none. Equal prefixes exclude the same versions from above.
    """
    parts = comparator.parts
    if comparator.operator == Operator.GreaterEqual:
        return []
    if comparator.operator == Operator.Tilde:
        if len(parts) == 1:
            return parts
        return parts[:2]
    mut index = 0
    while index < len(parts) - 1 and parts[index] == "0":
        index += 1
    return parts[:index + 1]


def respelled(member: str, version: str) -> str:
    """One comparator's text with its version replaced, keeping its leading spaces and its operator."""
    mut start = 0
    while start < len(member) and member[start] == " ":
        start += 1
    rest = member[start:].strip()
    mut operator = ""
    for prefix in [">=", "^", "~"]:
        if rest.startswith(prefix):
            operator = prefix
            break
    mut gap = ""
    if operator != "" and rest[len(operator):].startswith(" "):
        gap = " "
    return member[:start] + operator + gap + version


def replaced_requirement(
    text: str,
    manifest: str,
    dependency: RegistryDependency,
    requirement: str,
) -> Result[str, str]:
    """`text` with `dependency`'s quoted requirement replaced on the one line that sets it; nothing else changes."""
    lines = text.split("\n")
    old = "\"" + dependency.requirement + "\""
    index = requirement_line(lines, dependency.key)
    if index < 0 or len(lines[index].split(old)) != 2:
        return Err(f"{manifest}: no one line sets `{dependency.key}`'s version as {old}; edit it by hand")
    mut changed = lines
    changed[index] = lines[index].replace(old, "\"" + requirement + "\"")
    return Ok("\n".join(changed))


def requirement_line(lines: list[str], key: str) -> int:
    """The line that sets `key`'s version: `KEY = { ... }` in `[dependencies]`, or `version` in its own table."""
    mut section = ""
    for index in range(len(lines)):
        header = section_of(lines[index])
        if header != "":
            section = header
            continue
        stripped = lines[index].strip()
        if section == DEPENDENCIES and assigns(stripped, key):
            return index
        if section == f"[dependencies.{key}]" and assigns(stripped, "version"):
            return index
    return -1


def assigns(line: str, key: str) -> bool:
    """Whether `line` assigns the bare key `key`."""
    return line.startswith(key) and line[len(key):].strip().startswith("=")


pub def listed_dependencies(text: str, manifest: str) -> Result[list[str], str]:
    """One line per `[dependencies]` entry, by key (RFC 118), or `no dependencies`."""
    entries = dependency_tables(text, manifest)?
    lines = [entry_line(key, entries[key]) for key in sorted([name for name in entries.keys()])]
    if len(lines) == 0:
        return Ok(["no dependencies"])
    return Ok(lines)


pub def plan_remove(name: str, text: str, manifest: str) -> Result[ManifestChange, str]:
    """
    Remove every `[dependencies]` entry that names one Loaf (RFC 118).

    1. The name is a full Loaf name; a short one is refused with the project's dependencies that end in it.
    2. Each entry's line, or its own `[dependencies.KEY]` table, goes; nothing else changes.
    3. The result must read back with exactly those keys gone.
    """
    # 1. Oven never guesses a full name.
    declared = declared_keys(text, manifest)?
    loaf = full_name(name, [named for named in declared.values() if named != ""], "dependency")?
    keys = sorted([key for key in declared.keys() if declared[key] == loaf])
    if len(keys) == 0:
        return Err(f"{loaf} is not a dependency in {manifest}")
    # 2. One line or one table per key.
    entries = dependency_tables(text, manifest)?
    mut changed = text
    mut report: list[str] = []
    for key in keys:
        changed = without_entry(changed, manifest, key)?
        report.append(f"removed {entry_line(key, entries[key])}")
    # 3. Every other key keeps the Loaf it named.
    remaining = declared_keys(changed, manifest)?
    mut intact = len(remaining) == len(declared) - len(keys)
    for key in declared.keys():
        if key not in keys and (key not in remaining or remaining[key] != declared[key]):
            intact = false
    if not intact:
        return Err(f"{manifest}: the edit would not read back without {loaf}; edit it by hand")
    return Ok(ManifestChange(text=changed, report=report))


def entry_line(key: str, entry: Dict[str, TomlValue]) -> str:
    """
    `KEY: NAME REQUIREMENT` for a registry entry; `KEY: path DIR` for a local one, after its Loaf name when it has
    one.
    """
    mut loaf = ""
    if "loaf" in entry:
        loaf = entry["loaf"].as_str().unwrap_or("")
    if "path" in entry:
        path = entry["path"].as_str().unwrap_or("")
        if loaf == "":
            return f"{key}: path {path}"
        return f"{key}: {loaf}, path {path}"
    mut requirement = ""
    if "version" in entry:
        requirement = entry["version"].as_str().unwrap_or("")
    return f"{key}: {loaf} {requirement}".strip()


def without_entry(text: str, manifest: str, key: str) -> Result[str, str]:
    """`text` without `key`'s line in `[dependencies]`, or without its `[dependencies.KEY]` table up to the next one."""
    lines = text.split("\n")
    mut section = ""
    for index in range(len(lines)):
        header = section_of(lines[index])
        if header != "":
            section = header
            if header == f"[dependencies.{key}]":
                mut end = index + 1
                while end < len(lines) and not lines[end].strip().startswith("["):
                    end += 1
                mut changed = "\n".join(lines[:index] + lines[end:])
                if text.endswith("\n") and not changed.endswith("\n"):
                    changed += "\n"
                return Ok(changed)
            continue
        if section == DEPENDENCIES and assigns(lines[index].strip(), key):
            return Ok("\n".join(lines[:index] + lines[index + 1:]))
    return Err(f"{manifest}: no one line or table declares `{key}`; edit it by hand")
