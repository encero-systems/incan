"""Installation admits the compiler records a toolchain ships, without running a compiler or copying them (RFC 179)."""

from rust::std::os::unix::fs import symlink
from rust::std::process import Command
from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import file_digest, sha256
from std.json import JsonValue
from scratch import scratch_directory
from compiler_record_admission import SHIPPED_RECORDS, convert, installed_records


pub def test_shipped_compiler_records_are_admitted_without_running_a_compiler() -> Result[None, str]:
    """
    A toolchain that ships its record export installs with a driver that cannot run.

    1. Ship one record object and the export index beside the toolchain.
    2. Convert with a driver file that is not executable: only admission may happen.
    3. The sealed set and its pin exist.
    """
    scratch = scratch_directory()?
    installed = scratch.path().joinpath("toolchain")
    # 1. and 2. One content-named object, the index that names it, and a driver that would fail to run.
    driver = ship_one_record(installed)?
    pin = convert(driver.0, installed, installed)?
    # 3. Admission published the set the pin names.
    assert pin.root == "compiler-records", "the pin names the installed set"
    assert installed.joinpath("compiler-records").joinpath("manifest.json").is_file(), "the set is published"
    return Ok(None)


pub def test_a_shipped_sealed_set_installs_without_converting_or_copying() -> Result[None, str]:
    """
    An archive that ships its sealed set and its admitted store installs by verification alone.

    1. Seal one record into a toolchain directory, as packing does.
    2. Install it with a driver that cannot run, naming the shipped pin.
    3. The pin is the shipped one, and the transport and the store's objects are unchanged, file for file.
    """
    scratch = scratch_directory()?
    installed = scratch.path().joinpath("toolchain")
    # 1. The sealed set and store an archive carries.
    driver = ship_one_record(installed)?
    sealed = convert(driver.0, installed, installed)?
    before = sealed_inventory(installed)?
    # 2. Installation is handed the archive's pin.
    pin = installed_records(driver.0, installed, Some(sealed))?
    # 3. Nothing was converted, copied or rewritten.
    assert pin.digest == sealed.digest, "the shipped pin is kept"
    assert sealed_inventory(installed)? == before, "admission wrote no object"


pub def test_a_stage_seals_the_records_of_the_manifests_it_links_and_of_no_other() -> Result[None, str]:
    """
    Packing seals the records of the Loaves its stage ships. A manifest the stage links has its records in the set; a
    manifest the builder's installation holds besides, such as a replaced native runtime's, has none.

    1. An installation with two builds of one Loaf, and a stage that links only the newer one.
    2. Seal the stage's records with a driver that, like the compiler, exports the regular manifest files it is shown.
    3. The set holds the shipped build's record and not the other's.
    """
    scratch = scratch_directory()?
    # 1. The stage names what ships by links, as packing stages every artifact.
    installed = scratch.path().joinpath("toolchain")
    replaced = installed.joinpath("native/replaced/fixture.incnlib")
    current = installed.joinpath("native/current/fixture.incnlib")
    for manifest in [replaced, current]:
        manifest.parent().mkdir(true, true).map_err((error) => error.message())?
        manifest.write_bytes(f"manifest of {manifest.parent().name()}".encode("utf-8")).map_err(
            (error) => error.message(),
        )?
    stage = scratch.path().joinpath("stage")
    stage.joinpath("native/current").mkdir(true, true).map_err((error) => error.message())?
    symlink(current.0, stage.joinpath("native/current/fixture.incnlib").0).map_err((error) => str(error))?
    # 2. The export names each record by its manifest's directory and Loaf, as the compiler's does.
    driver = exporting_driver(scratch.path().joinpath("driver"))?
    pin = convert(driver.0, stage, stage)?
    # 3. Only the linked manifest was exported.
    sealed = stage.joinpath(pin.root).joinpath("manifest.json").read_text("utf-8", "strict").map_err(
        (error) => error.message(),
    )?
    assert "loaf/current/fixture/" in sealed, "the shipped Loaf's record is not in the sealed set"
    assert "loaf/replaced/fixture/" not in sealed, "a Loaf the stage does not ship has a record in the sealed set"
    return Ok(None)


def exporting_driver(path: Path) -> Result[Path, str]:
    """A driver that exports one record for each regular `.incnlib` file below the directory it is shown."""
    lines = [
        "#!/bin/sh",
        "[ \"$1\" = --compiler-records ] || exit 1",
        "mkdir -p \"$3/objects\" || exit 1",
        "records=",
        "for manifest in $(/usr/bin/find \"$2\" -type f -name '*.incnlib' | /usr/bin/sort); do",
        "  revision=$(/usr/bin/shasum -a 256 \"$manifest\" | /usr/bin/cut -d' ' -f1)",
        "  /bin/cp \"$manifest\" \"$3/objects/$revision\"",
        "  profile=$(/usr/bin/basename \"$(/usr/bin/dirname \"$manifest\")\")",
        "  key=\"loaf/$profile/$(/usr/bin/basename \"$manifest\" .incnlib)/metadata/00000000/$revision\"",
        "  shape='{\"key\":\"%s\",\"revision\":\"%s\",\"object\":\"objects/%s\"}'",
        "  record=$(printf \"$shape\" \"$key\" \"$revision\" \"$revision\")",
        "  records=\"$records${records:+,}$record\"",
        "done",
        "printf '{\"schema\":\"incan.compiler-record-export/2\",\"records\":[%s]}' \"$records\" > \"$3/index.json\"",
        "",
    ]
    path.write_bytes("\n".join(lines).encode("utf-8")).map_err((error) => error.message())?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(path.0).status().map_err((error) => str(error))?.success(), "chmod failed"
    return Ok(path)


def ship_one_record(installed: Path) -> Result[Path, str]:
    """Ship one content-named record object and its export index, and a driver file that is not executable."""
    export = installed.joinpath(SHIPPED_RECORDS)
    export.joinpath("objects").mkdir(true, true).map_err((error) => error.message())?
    value = b"shipped record"
    revision = hexlify(sha256.digest(value))
    object = f"objects/{revision}"
    export.joinpath(object).write_bytes(value).map_err((error) => error.message())?
    key = JsonValue.string(f"loaf/debug/probe/metadata/00000000/{revision}")
    record = JsonValue.object({"key": key, "revision": JsonValue.string(revision), "object": JsonValue.string(object)})
    schema = JsonValue.string("incan.compiler-record-export/2")
    index = JsonValue.object({"schema": schema, "records": JsonValue.array([record])})
    text = index.to_json().map_err((error) => error.message())?
    export.joinpath("index.json").write_bytes(text.encode("utf-8")).map_err((error) => error.message())?
    # The driver exists, so its digest can name the producer, but running it would fail.
    driver = installed.joinpath("bin").joinpath("incan-rustc-driver")
    driver.parent().mkdir(true, true).map_err((error) => error.message())?
    driver.write_bytes(b"not a program").map_err((error) => error.message())?
    return Ok(driver)


def sealed_inventory(installed: Path) -> Result[list[str], str]:
    """Every file of the set's transport and of its store's objects and segments, with its full digest."""
    store = installed.joinpath("compiler-record-store")
    transport = inventory(installed.joinpath("compiler-records"), "transport/")?
    objects = inventory(store.joinpath("payloads"), "payloads/")?
    segments = inventory(store.joinpath("segments"), "segments/")?
    return Ok(transport + objects + segments)


def inventory(directory: Path, prefix: str) -> Result[list[str], str]:
    """Sorted relative filenames and full digests, so a no-op cannot hide any new or changed file."""
    if not directory.is_dir():
        return Ok([])
    mut entries: list[str] = []
    for entry in directory.iterdir().map_err((error) => error.message())?:
        name = prefix + entry.name()
        if entry.is_dir():
            entries.extend(inventory(entry, name + "/")?)
        else:
            digest = hexlify(file_digest(entry, "sha256").map_err((error) => error.message())?)
            entries.append(f"{name} {digest}")
    return Ok(sorted(entries))
