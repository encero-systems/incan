"""Bind installed compiler capabilities to the driver that proved them."""

from rust::std::process import Command, Output
from std.fs import Path
from std.json import JsonValue
from pub::internal_models.checker_records import CHECKER_PROFILE
from compiler_facts import FactAdmission, verified_fact
from frozen_inputs import Document
from json_fields import required_text
from observation import observe
from rust_target import decoded, host_triple
from toolchain_types import InstalledCompiler

const PLAN_ONLY: str = "incan.driver-capabilities/1"
const WITH_LIBRARY_LOCAL: str = "incan.driver-capabilities/2"
const LIBRARY_LOCAL_PROFILE: str = "incan.library-local-compiled-body-rows/1"
const PLAN_SELECTION_PROFILE: str = "incan.plan-module-selection-sha256/1"
const LEGACY_IDENTITY_USAGE: str = "usage: incan-rustc-driver --identity SYSROOT\n"

pub model DriverCapabilityProof:
    """A supported response bound to the responding driver and its exact filesystem observation."""

    pub fact: FactAdmission
    pub library_local: bool

pub model DriverProfiles:
    """The compiler capabilities authenticated by the selected installation page."""

    pub plan_selection: bool = false
    pub library_local: bool = false

pub enum DriverCapabilityIntake:
    """Which existing admission can speak for the installed driver."""

    Legacy
    Selected
    Staged(Option[DriverCapabilityProof])

pub def driver_profiles(toolchain: InstalledCompiler, documents: list[Document]) -> Result[DriverProfiles, str]:
    """Read the one driver-addressed declaration, refusing misplaced or malformed claims."""
    mut profiles = DriverProfiles()
    for document in documents:
        if document.path == toolchain.driver:
            if profiles.plan_selection or document.path in [toolchain.registry_lock, toolchain.registry_units]:
                return Err(f"{document.path}: duplicate or aliased driver capability")
            library_local = verify_document(toolchain, document)?
            profiles = DriverProfiles(plan_selection=true, library_local=library_local)
        elif capability_schema(document.value).startswith("incan.driver-capabilities/"):
            return Err(f"{document.path}: driver capability belongs at {toolchain.driver}")
    return Ok(profiles)

def capability_schema(document: JsonValue) -> str:
    """Identify the reserved schema family without assigning meaning to ordinary installation documents."""
    match document.get("schema"):
        None => return ""
        Some(value) => return value.as_str().unwrap_or("")

def verify_document(toolchain: InstalledCompiler, document: Document) -> Result[bool, str]:
    """Require the exact protocol, driver SHA-256 and admitted observation at the selected driver path."""
    detail = f"{document.path}: invalid driver capability"
    digest = required_text(document.value, "driver_sha256").map_err((error) => f"{detail}: {error}")?
    profile = required_text(document.value, "plan_selection_profile").map_err((error) => f"{detail}: {error}")?
    schema = capability_schema(document.value)
    fields = document.value.keys()
    if profile != PLAN_SELECTION_PROFILE or (schema != PLAN_ONLY and schema != WITH_LIBRARY_LOCAL):
        return Err(f"{detail}: unsupported declaration")
    library_local = schema == WITH_LIBRARY_LOCAL
    if library_local:
        rows = required_text(document.value, "library_local_profile").map_err((error) => f"{detail}: {error}")?
        checker = required_text(document.value, "checker_profile").map_err((error) => f"{detail}: {error}")?
        if len(fields) != 5 or rows != LIBRARY_LOCAL_PROFILE or checker != CHECKER_PROFILE:
            return Err(f"{detail}: unsupported declaration")
    elif len(fields) != 3:
        return Err(f"{detail}: unsupported declaration")
    if len(digest) != 64:
        return Err(f"{detail}: expected a lowercase SHA-256")
    for character in digest:
        if character not in "0123456789abcdef":
            return Err(f"{detail}: expected a lowercase SHA-256")
    if len(toolchain.compiler_facts) == 0 or toolchain.compiler_facts[0] != digest:
        return Err(f"{detail}: driver SHA-256 differs from the admitted fact")
    if document.stamp == "" or toolchain.driver_observation != document.stamp:
        return Err(f"{detail}: driver observation differs from admission")
    return Ok(library_local)

pub def driver_document(driver: str, proof: DriverCapabilityProof) -> Document:
    """Store only the profiles the responding driver proved, beside its admitted observation."""
    mut fields = {
        "schema": JsonValue.string(PLAN_ONLY),
        "driver_sha256": JsonValue.string(proof.fact.digest),
        "plan_selection_profile": JsonValue.string(PLAN_SELECTION_PROFILE),
    }
    if proof.library_local:
        fields["schema"] = JsonValue.string(WITH_LIBRARY_LOCAL)
        fields["library_local_profile"] = JsonValue.string(LIBRARY_LOCAL_PROFILE)
        fields["checker_profile"] = JsonValue.string(CHECKER_PROFILE)
    return Document(path=driver, stamp=proof.fact.observation, value=JsonValue.object(fields))

pub def probe_driver_capability(driver: str, sysroot: str) -> Result[Option[DriverCapabilityProof], str]:
    """Prove the selected driver's identity and accept only an exact supported profile reply."""
    path = Path(driver)
    before = verified_fact(path)?
    rustc = Path(sysroot).joinpath("bin/rustc")
    rustc_stamp = observe(rustc)?.stamp
    host = host_triple(rustc.0)?
    proof = authenticated_profiles(driver, sysroot, host, before)?
    after = verified_fact(path)?
    if before.digest != after.digest or before.observation != after.observation or rustc_stamp != observe(rustc)?.stamp:
        return Err(f"{driver}: driver or Rust compiler changed during identity verification")
    return Ok(proof)

def authenticated_profiles(
    driver: str, sysroot: str, host: str, fact: FactAdmission,
) -> Result[Option[DriverCapabilityProof], str]:
    """Ask once for the complete profile and recognize only the exact historical unsupported reply."""
    reply = identity_output(driver, ["--identity", sysroot, "--capabilities", WITH_LIBRARY_LOCAL])?
    expected = f"{WITH_LIBRARY_LOCAL}\n{host}\n{PLAN_SELECTION_PROFILE}\n{LIBRARY_LOCAL_PROFILE}\n{CHECKER_PROFILE}\n".encode("utf-8")
    if exact_reply(reply, expected):
        return Ok(Some(DriverCapabilityProof(fact=fact, library_local=true)))
    if legacy_usage(reply):
        return prove_prior_profiles(driver, sysroot, host, fact)
    return Err(f"{driver}: invalid driver capability returned for Rust sysroot {sysroot}: {decoded(reply.stderr)}")

def prove_prior_profiles(driver: str, sysroot: str, host: str, fact: FactAdmission) -> Result[Option[DriverCapabilityProof], str]:
    """Recognize old drivers solely through their exact historical replies after an unsupported request."""
    reply = identity_output(driver, ["--identity", sysroot, "--capabilities", PLAN_ONLY])?
    if exact_reply(reply, f"{PLAN_ONLY}\n{host}\n{PLAN_SELECTION_PROFILE}\n".encode("utf-8")):
        return Ok(Some(DriverCapabilityProof(fact=fact, library_local=false)))
    if not legacy_usage(reply):
        return Err(f"{driver}: invalid driver capability returned for Rust sysroot {sysroot}: {decoded(reply.stderr)}")
    plain = identity_output(driver, ["--identity", sysroot])?
    if not exact_reply(plain, f"{host}\n".encode("utf-8")):
        return Err(f"{driver}: cannot verify legacy identity against Rust sysroot {sysroot}: {decoded(plain.stderr)}")
    return Ok(None)

def exact_reply(reply: Output, expected: bytes) -> bool:
    """Require a successful process and the full byte-exact response with no diagnostics."""
    return reply.status.success() and reply.stderr == b"" and reply.stdout == expected

def legacy_usage(reply: Output) -> bool:
    """The historical unsupported-protocol reply permits one earlier identity contract to be asked."""
    return reply.status.code() == Some(1i32) and reply.stdout == b"" and reply.stderr == LEGACY_IDENTITY_USAGE.encode("utf-8")

def identity_output(driver: str, arguments: list[str]) -> Result[Output, str]:
    """Use the installer's established bootstrap-free identity environment."""
    mut command = Command.new(driver)
    command.env_remove("RUSTC_BOOTSTRAP")
    for argument in arguments:
        command.arg(argument)
    return command.output().map_err((error) => f"{driver}: cannot verify driver identity: {error}")
