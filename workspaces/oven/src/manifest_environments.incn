"""Read `[envs.NAME]`: validate each environment and normalize its dependency overlay against the production graph."""

from std.toml import TomlValue
from manifest_errors import IntakeError, IntakeErrorKind
from loaf_identity import crate_name, validate_loaf_identity
from manifest_fields import (
    allowed,
    first_key,
    refusal,
    request_flag,
    requested_features,
    required,
    requirement,
    table,
    unique_strings,
)
from manifest_models import LocalDependency, RustInputRequest
from manifest_dependencies import (
    dependency_replacement,
    inherited_edge,
    local_dependency,
    rust_request,
    validate_target,
)

# The keys of `[envs.NAME]` (RFC 073, RFC 117).
const ENVIRONMENT_KEYS: FrozenList[str] = [
    "dependencies",
    "extends",
    "requires-incan",
    "cwd",
    "env-vars",
    "scripts",
    "detached",
    "description",
]


def validate_environments(root: Dict[str, TomlValue], manifest: str) -> Result[None, IntakeError]:
    """Admit inactive environment tables without treating their partial dependency overrides as production edges."""
    if "envs" not in root:
        return Ok(None)
    environments = table(root["envs"], manifest, ["envs"])?
    for name in sorted([name for name in environments.keys()]):
        validate_environment(environments[name], manifest, ["envs", name])?
    return Ok(None)


pub def validate_environment(value: TomlValue, manifest: str, field: list[str]) -> Result[None, IntakeError]:
    """
    One environment table, `[envs.NAME]` or a workspace root's `[workspace.envs.NAME]` fragment: its keys, its
    dependency, variable and script tables, and its `requires-incan`.
    """
    environment = table(value, manifest, field)?
    if "rust-dependencies" in environment:
        entries = table(environment["rust-dependencies"], manifest, field + ["rust-dependencies"])?
        alias = first_key(entries)
        replacement = dependency_replacement(alias, entries[alias], manifest, field + ["rust-dependencies", alias])?
        detail = f"use [{".".join(field)}.dependencies] {replacement}"
        return Err(refusal(manifest, field + ["rust-dependencies"], IntakeErrorKind.Unsupported, detail))
    allowed(environment, list(ENVIRONMENT_KEYS), manifest, field)?
    for group in ["dependencies", "env-vars", "scripts"]:
        if group in environment:
            table(environment[group], manifest, field + [group])?
    if "requires-incan" in environment:
        requirement(environment["requires-incan"], manifest, field + ["requires-incan"])?
    return Ok(None)


pub def parse_environment_dependencies(
    root: Dict[str, TomlValue],
    production: list[LocalDependency],
    rust_inputs: list[RustInputRequest],
    manifest: str,
) -> Result[tuple[Dict[str, list[LocalDependency]], Dict[str, list[RustInputRequest]]], IntakeError]:
    """Normalize local and Rust-facet environment overrides against the same production declaration."""
    validate_environments(root, manifest)?
    mut local_overlays: Dict[str, list[LocalDependency]] = {}
    mut rust_overlays: Dict[str, list[RustInputRequest]] = {}
    if "envs" not in root:
        return Ok((local_overlays, rust_overlays))
    environments = table(root["envs"], manifest, ["envs"])?
    for name in sorted([name for name in environments.keys()]):
        environment = table(environments[name], manifest, ["envs", name])?
        mut selected_local = production.clone()
        mut selected_rust = rust_inputs.clone()
        if "dependencies" in environment:
            group = ["envs", name, "dependencies"]
            entries = table(environment["dependencies"], manifest, group)?
            for alias in sorted([alias for alias in entries.keys()]):
                field = group + [alias]
                mut rust_override = false
                for index in range(len(selected_rust)):
                    if selected_rust[index].alias == alias:
                        selected_rust[index] = overlay_rust_request(selected_rust[index], entries[alias], manifest, field)?
                        rust_override = true
                if rust_override:
                    continue
                entry = table(entries[alias], manifest, field)?
                base = local_base(selected_local, alias)
                mut native: Option[RustInputRequest] = None
                if "workspace" in entry:
                    inherited = inherited_edge(alias, entry, manifest, field)?
                    native = inherited.facet
                    if let Some(local) = inherited.local:
                        selected_local = replace_local(selected_local, local)
                elif "loaf" in entry:
                    native = Some(rust_request(alias, entries[alias], manifest, "dependencies")?)
                elif base is not None or "path" in entry:
                    allowed(entry, ["path", "optional", "default-features", "features"], manifest, field)?
                    edge = local_dependency(alias, entry, manifest, field, base)?
                    selected_local = replace_local(selected_local, edge)
                if let Some(request) = native:
                    if base is not None:
                        return Err(refusal(manifest, field, IntakeErrorKind.Invalid, "a local Incan dependency cannot also name a Rust Loaf"))
                    selected_rust.append(request)
        if selected_local != production:
            local_overlays[name] = selected_local
        rust_overlays[name] = selected_rust
    return Ok((local_overlays, rust_overlays))


def local_base(dependencies: list[LocalDependency], alias: str) -> Option[LocalDependency]:
    """Find the production fields a partial local override preserves."""
    for dependency in dependencies:
        if dependency.alias == alias and not dependency.rust_facet:
            return Some(dependency)
    return None


def replace_local(dependencies: list[LocalDependency], edge: LocalDependency) -> list[LocalDependency]:
    """Keep an overridden edge in the same position, or append a new environment-only edge."""
    mut selected = dependencies
    for index in range(len(selected)):
        if selected[index].alias == edge.alias:
            selected[index] = edge
            return selected
    selected.append(edge)
    return selected


def overlay_rust_request(
    base: RustInputRequest,
    value: TomlValue,
    manifest: str,
    field: list[str],
) -> Result[RustInputRequest, IntakeError]:
    """Apply explicit environment fields to one normalized production request without inventing omitted values."""
    entry = table(value, manifest, field)?
    allowed(
        entry,
        ["loaf", "version", "features", "default-features", "optional", "path", "target", "package", "crate"],
        manifest,
        field,
    )?
    for retired in ["package", "crate"]:
        if retired in entry:
            return Err(
                refusal(
                    manifest,
                    field + [retired],
                    IntakeErrorKind.Unsupported,
                    f"use `{base.alias}` with its `loaf` identity under this environment's [dependencies] table",
                ),
            )
    mut result = base.clone()
    if "loaf" in entry:
        identity = required(entry, "loaf", manifest, field + ["loaf"])?
        validate_loaf_identity(identity).map_err(
            (error) => refusal(manifest, field + ["loaf"], IntakeErrorKind.Invalid, error),
        )?
        result.loaf = Some(identity)
        result.package = crate_name(identity)
    if "version" in entry:
        result.version = required(entry, "version", manifest, field + ["version"])?
    if "features" in entry:
        result.features = unique_strings(result.features + requested_features(entry["features"], manifest, field)?)
    if "default-features" in entry:
        result.default_features = request_flag(entry["default-features"], manifest, field)?
    if "optional" in entry:
        result.optional = request_flag(entry["optional"], manifest, field)?
    if "target" in entry:
        predicate = required(entry, "target", manifest, field + ["target"])?
        validate_target(predicate).map_err(
            (error) => refusal(manifest, field + ["target"], IntakeErrorKind.Invalid, error),
        )?
        result.target = Some(predicate)
    if "path" in entry:
        result.path = Some(required(entry, "path", manifest, field + ["path"])?)
    return Ok(result)
