"""Example runs shared by the lowering record tests: building a report fixture, counting engine proofs and stopping
the example engine."""

from rust::std::process import Command
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue, parse
from pub::incan_platform.store import begin, commit, get, stage_delete, stage_put
from pub::internal_models.runtime_requirement_rows import (
    RuntimeRequirementRow, decode_runtime_requirement_batches, encode_runtime_requirement_batches,
)
from pub::internal_models.records import encode_record_key
from pub::internal_models.source_value_records import source_value
from compiler_graph_record_fixtures import required as required_record
from compiler_runtime_requirements import runtime_requirements_key
from compiler_source_projection import project_source, raw_source_key, source_comments_key
from engine_client import service_generation, service_identity
from engine_endpoint import connect_with
from engine_protocol_fixtures import json_text_is
from engine_messages import Message, Stop
from engine_wire import zero_id
from files import write
from json_fields import required_items, required_text
from scratch import scratch_directory
from store_path_conversion import snapshot


pub def stop_example_engine(binary: str, store: Path) -> Result[None, str]:
    """Stop one disposable records engine after its final request."""
    mut identity = service_identity(store)?
    identity.service_generation = service_generation(binary)?
    mut channel = connect_with(store, identity, binary).map_err((refusal) => refusal.detail)?
    channel
        .send(zero_id(), Message.Stop(Stop(reason="lowering example completed")))
        .map_err((refusal) => refusal.detail)?
    stopped = channel.receive().map_err((refusal) => refusal.detail)?
    match stopped.message:
        Message.Event(value) =>
            assert value.status == "Stopping", f"the engine answered {value.status}"
        _ => return Err("lowering example did not stop its engine")
    _ = channel.transport.close()
    return Ok(None)


pub def command_proof(output: bytes) -> Result[JsonValue, str]:
    """Decode the first line emitted by `--engine-report`, leaving the following program stdout independent."""
    text = from_utf8(output).map_err((error) => str(error))?
    lines = text.split("\n")
    if len(lines) < 2:
        return Err("records command emitted no proof report")
    return parse(lines[0]).map_err((error) => error.message())


pub def report_fixture_build(binary: str, project: Path, store: Path, trace: Option[Path] = None) -> Result[JsonValue, str]:
    """Build one fixture through the records engine and decode its requested report."""
    mut command = Command.new(binary)
    command.arg("build")
        .arg(project.0)
        .args(["--profile", "release", "--engine-report"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
    if let Some(directory) = trace:
        command.env("INCAN_ENGINE_TRACE", directory.0)
    outcome = command.output().map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or (errors != "" and (trace is None or "warning[INCAN-T0125]" not in errors)):
        return Err(f"checker report fixture: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


pub def proof_count(report: JsonValue, name: str) -> Result[int, str]:
    """Read one required producer counter without accepting an absent or nonnumeric field."""
    return report.require(name).map_err((error) => error.message())?.expect_int().map_err((error) => error.message())


pub def lowering_example_run(
    binary: str, source: Path, store: Path, expected: str, trace: Option[Path] = None,
) -> Result[JsonValue, str]:
    """Run one real engine request and require both successful native output and its measured proof."""
    mut command = Command.new(binary)
    if let Some(directory) = trace:
        command.env("INCAN_ENGINE_TRACE", directory.0).env("INCAN_TRACE_PRODUCERS", "1")
    outcome = command
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release", "--engine-report"])
        .env("INCAN_NATIVE_PLAN_REPORT", source.parent().joinpath("native.plan").0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or not output.endswith(expected + "\n") or errors != "":
        return Err(f"lowering example: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


pub model PlanReportPredecessor:
    """A fixture's sentinel at the preceding request's descriptor-adjacent report path."""

    requests: Dict[str, str]
    descriptor: str
    path: Path
    sentinel: str

    @staticmethod
    pub def retained(requests: Dict[str, str], descriptor: str, path: Path, sentinel: str) -> Self:
        """Keep the preceding request and its exact sentinel together for successor readback."""
        return PlanReportPredecessor(requests=requests, descriptor=descriptor, path=path, sentinel=sentinel)

    pub def matches_driver_request(self, request: JsonValue) -> bool:
        """Match the exact issued descriptor within the model that owns it."""
        return json_text_is(request, "key", "--unit " + self.descriptor)

    pub def preserved(self, trace: Path, root: Path) -> Result[None, str]:
        """Check the successor issued on the same descriptor and left the predecessor readable."""
        successor = changed_plan_report_request(self.requests, plan_report_requests(trace, root)?)?
        if successor != self.descriptor:
            return Err("the successor used a different Plan report descriptor")
        if not self.path.is_file():
            return Err("the successor removed the preceding Plan report")
        text = self.path.read_text("utf-8", "strict").map_err((error) => error.message())?
        if text != self.sentinel:
            return Err("the successor changed the preceding Plan report sentinel")
        return Ok(None)


pub def mark_plan_report_predecessor(trace: Path, root: Path, prior: Dict[str, str]) -> Result[PlanReportPredecessor, str]:
    """Place the regression sentinel at the actual preceding request's original report path."""
    requests = plan_report_requests(trace, root)?
    descriptor = changed_plan_report_request(prior, requests)?
    report = Path(descriptor + ".graph-plan-report")
    report.mkdir(true, true).map_err((error) => error.message())?
    path = report.joinpath("retained-predecessor")
    sentinel = "previous admitted report remains readable\n"
    write(path, sentinel)?
    return Ok(PlanReportPredecessor.retained(requests, descriptor, path, sentinel))


pub def plan_report_requests(trace: Path, root: Path) -> Result[Dict[str, str], str]:
    """Collect actual unit descriptor requests for this fixture's physical unit directory."""
    units = root.joinpath("target/incan/units").resolve().map_err((error) => error.message())?
    mut requests: Dict[str, str] = {}
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().startswith("engine-oven-"):
            continue
        for line in file.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
            if line == "":
                continue
            row = parse(line).map_err((error) => error.message())?
            if not json_text_is(row, "operation", "driver_request") or not json_text_is(row, "outcome", "done"):
                continue
            key = required_text(row, "key")?
            if not key.startswith("--unit "):
                continue
            descriptor = Path(key[len("--unit "):])
            if descriptor.parent().0 != units.0:
                continue
            work = required_text(row, "work")?
            if work in requests:
                return Err("the fixture trace repeats a unit request")
            requests[work] = descriptor.0
    return Ok(requests)


def changed_plan_report_request(before: Dict[str, str], after: Dict[str, str]) -> Result[str, str]:
    """Read exactly one new request from a cumulative fixture trace with its preceding identities intact."""
    for work in before.keys():
        if after.get(work) != Some(before[work]):
            return Err("a preceding fixture request changed")
    added = [after[work] for work in after.keys() if work not in before]
    if len(added) != 1:
        return Err("the fixture edit did not issue one unit request")
    return Ok(added[0])


pub def plan_report_event_rows(trace: Path, root: Path) -> Result[Dict[str, str], str]:
    """Retain the fixture's actual issued unit, private report and enclosing read windows by raw work identity."""
    units = root.joinpath("target/incan/units").resolve().map_err((error) => error.message())?
    mut rows: Dict[str, str] = {}
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().startswith("engine-oven-") or not file.name().endswith(".jsonl"):
            continue
        for line in file.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
            if line == "":
                continue
            row = parse(line).map_err((error) => error.message())?
            if not json_text_is(row, "outcome", "done"):
                continue
            if not is_plan_report_event_row(row, units)?:
                continue
            if not json_text_is(row, "kind", "span") or not json_text_is(row, "clock", "host-monotonic-raw"):
                return Err("the Plan event trace lacks a complete host-clock span")
            process = proof_count(row, "process")?
            work = required_text(row, "work")?
            if process <= 0 or file.name() != f"engine-oven-{process}.jsonl" or work == "" or work in rows:
                return Err("the Plan event trace has a foreign or repeated work identity")
            rows[work] = line
    return Ok(rows)


def is_plan_report_event_row(row: JsonValue, units: Path) -> Result[bool, str]:
    """Select the three causal boundaries and exact private event reads for this fixture."""
    operation = required_text(row, "operation")?
    key = required_text(row, "key")?
    if operation == "driver_request" and key.startswith("--unit "):
        return Ok(Path(key[len("--unit "):]).parent().0 == units.0)
    if operation == "engine_graph_staging" and key == "compiled-lowering-staging":
        return Ok(true)
    selected = Path(key)
    if operation == "engine_sidecar_authentication":
        return Ok(private_plan_report(selected, units))
    if operation == "file_read" and key.endswith(".event"):
        return Ok(private_plan_report(selected.parent(), units))
    return Ok(false)


def private_plan_report(report: Path, units: Path) -> bool:
    """Recognize a request-owned report directly below the actual descriptor directory."""
    return report.parent().0 == units.0 and report.name().startswith("plan-report-")


def plan_events_same_owner(issue: JsonValue, row: JsonValue) -> Result[bool, str]:
    """Join phase spans on one settlement role and one raw clock."""
    for name in ["run", "request", "thread", "clock_id"]:
        expected = required_text(issue, name)?
        if expected == "" or not json_text_is(row, name, expected):
            return Ok(false)
    return Ok(proof_count(issue, "process")? == proof_count(row, "process")?)


pub def verify_one_module_counts(report: JsonValue) -> Result[None, str]:
    """Preserve the warm request's aggregate lowering and whole-module admission controls."""
    diagnostic = report.to_json().map_err((error) => error.message())?
    assert proof_count(report, "plan_function_evaluations")? == 1, diagnostic
    assert proof_count(report, "plan_module_reuses")? == 3, diagnostic
    return Ok(None)


pub model LoweringReportSnapshot:
    """The engine report and the selected snapshot observed for that request."""

    pub report: JsonValue
    pub selected: str


pub def capture_lowering_report(report: JsonValue, store: Path) -> Result[LoweringReportSnapshot, str]:
    """Read the reported project view immediately after the engine completes this fixture request."""
    if let Some(evidence) = report.get("lowering_work"):
        view = required_text(evidence, "view")?
        if view == "":
            return Err("lowering evidence has no selected project view")
        selected = snapshot(store, view).map_err((error) => error.message())?
        return Ok(LoweringReportSnapshot(report=report, selected=selected.digest))
    # Let both edits finish and keep the ordinary C71 controls before reporting missing evidence.
    return Ok(LoweringReportSnapshot(report=report, selected=""))


pub def require_two_edit_lowering(
    traces: list[Dict[str, str]], proofs: list[LoweringReportSnapshot], predecessor: Borrowed[PlanReportPredecessor],
) -> Result[None, str]:
    """Check each retained report window, then match its complete lowering work to the preceding Body roots."""
    mut issued: list[str] = []
    for edge in [1, 2]:
        report = proofs[edge].report
        issued.append(require_one_read_per_plan_event(traces[edge - 1], traces[edge], report, predecessor)?)
    if not proofs[1].report.get("lowering_work").is_some() or not proofs[2].report.get("lowering_work").is_some():
        return Err("2.5: warm reports omit request-bound Body roots and complete keyed lowering work")
    seed = (selected_body_roots(proofs[0])?)[0]
    beta, beta_names, beta_work = selected_body_roots(proofs[1])?
    alpha, alpha_names, alpha_work = selected_body_roots(proofs[2])?
    require_lowering_match(seed, beta, beta_names, beta_work, issued[0], "lone_beta_one")?
    return require_lowering_match(beta, alpha, alpha_names, alpha_work, issued[1], "lone_alpha_one")


def selected_body_roots(
    proof: Borrowed[LoweringReportSnapshot],
) -> Result[tuple[Dict[str, str], Dict[str, str], JsonValue], str]:
    """Keep each canonical owner and its semantic Body root once at the actual selected snapshot."""
    evidence = proof.report.require("lowering_work").map_err((error) => error.message())?
    if proof.selected == "" or not json_text_is(evidence, "snapshot", proof.selected):
        return Err("lowering evidence names another committed snapshot")
    mut roots: Dict[str, str] = {}
    mut names: Dict[str, str] = {}
    for row in required_items(evidence, "body_roots")?:
        owner = required_text(row, "owner")?
        root = required_text(row, "root")?
        name = required_text(row, "function")?
        if owner == "" or root == "" or name == "" or owner in roots:
            return Err("selected Body root lacks a unique owner, semantic root or function")
        roots[owner] = root
        names[owner] = name
    return Ok((roots, names, evidence))


def require_lowering_match(
    before: Borrowed[Dict[str, str]], after: Borrowed[Dict[str, str]], names: Borrowed[Dict[str, str]],
    evidence: JsonValue, request: str, expected: str,
) -> Result[None, str]:
    """Compare exact ordinary evaluations to changed roots and require admission of every unchanged owner."""
    if request == "" or not json_text_is(evidence, "request", request):
        return Err("lowering evidence names another engine request")
    fixture_functions = [
        "lone_alpha_one", "lone_alpha_two", "lone_beta_one", "lone_beta_two", "lone_gamma_one", "lone_gamma_two", "main",
    ]
    if sorted([name for name in names.values()]) != fixture_functions:
        return Err("selected Body roots differ from the fixture's declared functions")
    if sorted([owner for owner in before.keys()]) != sorted([owner for owner in after.keys()]):
        return Err("selected Body roots omit a fixture owner or publish a foreign owner")
    changed = [owner for owner in after.keys() if after[owner] != before[owner]]
    if len(changed) != 1 or names[changed[0]] != expected:
        return Err(f"expected only {expected} to change its semantic Body root")
    return require_ordinary_dispositions(evidence, after, changed[0])


def require_ordinary_dispositions(
    evidence: JsonValue, roots: Borrowed[Dict[str, str]], changed: str,
) -> Result[None, str]:
    """Check the complete keyed work cohort, keeping synthesized routes separate from ordinary owners."""
    mut keys: set[str] = set()
    mut ordinary: set[str] = set()
    for row in required_items(evidence, "functions")?:
        key = required_text(row, "key")?
        kind = required_text(row, "kind")?
        disposition = required_text(row, "disposition")?
        if key == "" or key in keys or disposition not in ["evaluated", "admitted", "reused"]:
            return Err("lowering work lacks a unique key or a known disposition")
        keys.add(key)
        if kind in ["entry", "synthesized", "recovery", "finalization"]:
            continue
        owner = required_text(row, "owner")?
        if kind != "ordinary" or owner not in roots or owner in ordinary:
            return Err("lowering work names an unknown route or a foreign or repeated ordinary owner")
        ordinary.add(owner)
        if (disposition == "evaluated") != (owner == changed):
            return Err("ordinary lowering evaluations differ from changed semantic Body roots")
    if len(ordinary) != len(roots):
        return Err("lowering work omits an ordinary Body owner")
    return Ok(None)


def require_one_read_per_plan_event(
    before: Borrowed[Dict[str, str]], after: Borrowed[Dict[str, str]],
    edited: JsonValue, predecessor: Borrowed[PlanReportPredecessor],
) -> Result[str, str]:
    """Join one edit's actual request to the exact event files read by census and publication."""
    for work in before.keys():
        if after.get(work) != Some(before[work]):
            return Err("the preceding Plan event trace changed")
    mut rows: list[JsonValue] = []
    mut issued: list[JsonValue] = []
    for work in after.keys():
        if work in before:
            continue
        row = parse(after[work]).map_err((error) => error.message())?
        if json_text_is(row, "operation", "driver_request"):
            issued.append(row)
        else:
            rows.append(row)
    if len(issued) != 1:
        return Err("the edit did not issue one Plan report request")
    if not predecessor.matches_driver_request(issued[0]):
        return Err("the edited report counts name another descriptor")
    require_plan_event_windows(issued[0], rows, edited)?
    return required_text(issued[0], "request")


def require_plan_event_windows(issue: JsonValue, rows: list[JsonValue], edited: JsonValue) -> Result[None, str]:
    """Establish the two disjoint report consumers after the selected compiler request."""
    mut reports: list[JsonValue] = []
    mut lowering: list[JsonValue] = []
    mut reads: list[JsonValue] = []
    for row in rows:
        if not plan_events_same_owner(issue, row)?:
            return Err("the edited Plan event trace spans another request owner")
        match required_text(row, "operation")?:
            "engine_sidecar_authentication" => reports.append(row)
            "engine_graph_staging" => lowering.append(row)
            "file_read" => reads.append(row)
            _ => return Err("unexpected Plan event operation")
    if len(reports) != 1 or len(lowering) != 1:
        return Err("the edited request has no unique Plan census and publication windows")
    report = reports[0]
    after = lowering[0]
    if proof_count(issue, "end_ns")? > proof_count(report, "start_ns")? or proof_count(report, "end_ns")? > proof_count(after, "start_ns")?:
        return Err("the edited Plan event windows overlap or precede compiler completion")
    expected = proof_count(edited, "plan_function_evaluations")? + proof_count(edited, "plan_function_reuses")?
    return require_event_file_cohort(reads, report, after, expected)


def span_contains(outer: JsonValue, inner: JsonValue) -> Result[bool, str]:
    """Check exact interval containment on already joined clocks."""
    start = proof_count(inner, "start_ns")?
    end = proof_count(inner, "end_ns")?
    return Ok(proof_count(outer, "start_ns")? <= start and start < end and end <= proof_count(outer, "end_ns")?)


def require_event_file_cohort(reads: list[JsonValue], census: JsonValue, publication: JsonValue, expected: int) -> Result[None, str]:
    """Demand one whole census cohort and account for any later reads of those files."""
    report = required_text(census, "key")?
    mut first: Dict[str, int] = {}
    mut second: Dict[str, int] = {}
    for row in reads:
        path = required_text(row, "key")?
        size = proof_count(row, "bytes")?
        if Path(path).parent().0 != report or size <= 0 or proof_count(row, "calls")? != 1:
            return Err("the edited Plan reader named a foreign or empty event")
        if span_contains(census, row)? and path not in first:
            first[path] = size
        elif span_contains(publication, row)? and path not in second:
            second[path] = size
        else:
            return Err("a Plan event read was duplicated inside one phase or outside both")
    if expected <= 0 or len(first) != expected or (len(second) != 0 and second != first):
        return Err("the edited Plan event reads lack the complete actual file cohort")
    observed = len(first) + len(second)
    assert observed == expected, f"the edited Plan report read {observed} events; expected {expected} from one read per file"
    return Ok(None)


pub def verify_module_work(previous: Dict[str, int], current: Dict[str, int], edited: str) -> Result[None, str]:
    """Each warm edit checks its own module, builds one module's Body IR, and lowers only that module's bodies."""
    changed = sorted([key for key in current.keys() if current[key] > previous.get(key, 0)])
    expected = sorted(["body-ir", "body-ir:" + edited + ".incn", "check:" + edited + ".incn", "lower:" + edited])
    if changed != expected:
        return Err(f"edit of {edited} entered {changed}, expected {expected}")
    if current["body-ir"] - previous.get("body-ir", 0) != 1:
        return Err(f"edit of {edited} rebuilt more than one module's Body IR")
    return Ok(None)


pub def verify_comment_only_publication(binary: str, source: Path, store: Path, original: str) -> Result[None, str]:
    """Publish new raw and comment values on an ordinary native cache hit without invalidating code or docs."""
    before = snapshot(store).map_err((error) => error.message())?
    edited = original.replace("# inserted above main", "# retained above main")
    assert edited != original and len(edited.encode("utf-8")) == len(original.encode("utf-8"))
    write(source, edited)?
    report = lowering_example_run(binary, source, store, "hullo")?
    diagnostic = report.to_json().map_err((error) => error.message())?
    for counter in ["unit_evaluations", "body_evaluations", "plan_function_evaluations", "native_bakes"]:
        assert proof_count(report, counter)? == 0, diagnostic
    after = snapshot(store).map_err((error) => error.message())?
    assert after.generation > before.generation, "a native cache hit must still publish changed authored source"

    raw = raw_source_key("main", "main.incn")
    comments = source_comments_key("main", "main.incn")
    for key, previous, revised in [
        (raw, original.encode("utf-8"), edited.encode("utf-8")),
        (comments, b"# inserted above main", b"# retained above main"),
    ]:
        slot = encode_record_key(key)?
        old = required_record(before, slot)?
        new = required_record(after, slot)?
        assert old[:4] == b"CRMB" and new[:4] == b"CRMB", "source witnesses must be typed Crumb values"
        assert source_value(key, old)? == previous and source_value(key, new)? == revised

    projection = project_source("main", "main.incn", original)?
    assert len(projection.owners) == 2
    for key in [owner.key for owner in projection.owners] + [projection.documentation_key()]:
        slot = encode_record_key(key)?
        assert required_record(after, slot)? == required_record(before, slot)?, "a comment edit changed code or docs"
    return Ok(None)


pub def attempt_trace(root: Path, name: str) -> Result[Path, str]:
    """Prepare a separate compiler trace for a measured lowering arm."""
    path = root.joinpath(name)
    path.mkdir(true, true).map_err((error) => error.message())?
    return Ok(path)


pub def lowering_attempts(trace: Option[Path]) -> Result[int, str]:
    """Count entry to the driver lowering attempt in the selected fixture's cumulative trace."""
    return compiler_trace_count(trace, "\"kind\":\"begin\"", "\"function\":\"incan_rustc_driver::lower_program\"")


def compiler_trace_count(trace: Option[Path], kind: str, event: str) -> Result[int, str]:
    """Count exact trace event fields from the compiler processes this fixture started."""
    mut attempts = 0
    if let Some(directory) = trace:
        for path in directory.iterdir().map_err((error) => error.message())?:
            if not path.name().startswith("engine-compiler-"):
                continue
            text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
            for line in text.split("\n"):
                if kind in line and event in line:
                    attempts += 1
    return Ok(attempts)


pub def verify_generic_runtime_batches() -> Result[None, str]:
    """Replay two ordered runtime batches across an unrelated edit and compare the independent native result."""
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("probe.incn")
    plan = root.joinpath("native.plan")
    target = root.joinpath("target")
    executable = target.joinpath("incan/release/bin/probe")
    warm_store = root.joinpath("warm-store")
    warm_trace = Some(attempt_trace(root, "warm-trace")?)
    seed = generic_runtime_source()
    write(source, seed)?
    _ = lowering_example_run(binary, source, warm_store, "4\n7\n1\n7\na\n42", trace=warm_trace)?
    require_crumb_runtime_recipe(warm_store, source)?
    seed_attempts = lowering_attempts(warm_trace)?
    carrier_event = "\"operation\":\"carrier_traversal\""
    union_event = "\"operation\":\"carrier_unions\""
    trace_line = "\"kind\":\"line\""
    seed_carriers = compiler_trace_count(warm_trace, trace_line, carrier_event)?
    seed_unions = compiler_trace_count(warm_trace, trace_line, union_event)?
    write(source, seed.replace("value + 1", "value + 2"))?
    output = "4\n7\n1\n7\na\n43"
    _ = lowering_example_run(binary, source, warm_store, output, trace=warm_trace)?
    steady_attempts = lowering_attempts(warm_trace)? - seed_attempts
    steady_carriers = compiler_trace_count(warm_trace, trace_line, carrier_event)? - seed_carriers
    steady_unions = compiler_trace_count(warm_trace, trace_line, union_event)? - seed_unions
    warm_plan = plan.read_bytes().map_err((error) => error.message())?
    warm_executable = executable.read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, warm_store)?
    target.remove_tree().map_err((error) => error.message())?
    fresh_store = root.joinpath("fresh-store")
    fresh_trace = Some(attempt_trace(root, "fresh-trace")?)
    _ = lowering_example_run(binary, source, fresh_store, output, trace=fresh_trace)?
    stop_example_engine(binary, fresh_store)?
    assert warm_plan == plan.read_bytes().map_err((error) => error.message())?, "two-batch plans differ"
    assert warm_executable == executable.read_bytes().map_err((error) => error.message())?, "two-batch executables differ"
    fresh_attempts = lowering_attempts(fresh_trace)?
    verify_stale_runtime_batch(binary, root, source, seed, warm_store)?
    verify_old_runtime_recipe_rebuild(binary, root, source, seed, warm_store)?
    assert seed_attempts == 3 and fresh_attempts == 3, f"two-batch ordinary lowering spans: {seed_attempts}, {fresh_attempts}"
    assert steady_attempts == 1, f"two-batch steady lowering spans: {steady_attempts}"
    assert steady_carriers == 2 and steady_unions == 2, f"steady carrier and union passes: {steady_carriers}, {steady_unions}"
    return Ok(None)


def typed_runtime_fixture_key(source: Path) -> str:
    """Name the new recipe slot independently of the implementation under test."""
    return f"incan.engine.runtime-requirements/2\tprobe\t{source.0}\trelease"


def require_crumb_runtime_recipe(store: Path, source: Path) -> Result[None, str]:
    """Read the compiler-authorized recipe from the fixture's selected home graph."""
    graph = snapshot(store).map_err((error) => error.message())?
    selected = get(graph, typed_runtime_fixture_key(source)).map_err((error) => error.message())?
    if let Some(value) = selected:
        assert value[:4] == b"CRMB", "the selected runtime recipe is not Crumb"
        batches = decode_runtime_requirement_batches(value)?
        assert len(batches) == 2 and len(batches[1]) == 1, "the selected runtime recipe lost the ordered batches"
        return Ok(None)
    return Err("the successful plan did not publish a typed runtime recipe")


def verify_old_runtime_recipe_rebuild(binary: str, root: Path, source: Path, seed: str, store: Path) -> Result[None, str]:
    """An old-only recipe misses on a real edit and retires after the typed plan publication succeeds."""
    old = f"incan.engine.runtime-requirements/1\tprobe\t{source.0}\trelease"
    current = typed_runtime_fixture_key(source)
    graph = snapshot(store).map_err((error) => error.message())?
    mut edit = begin(graph)
    stage_delete(edit, current)
    stage_put(edit, old, b"incan.plan.runtime-requirements/1\n\x00")
    selected = commit(edit).map_err((error) => error.message())?
    assert get(selected, current).map_err((error) => error.message())?.is_none()
    assert get(selected, old).map_err((error) => error.message())?.is_some()
    write(source, seed.replace("value + 1", "value + 4"))?
    trace = Some(attempt_trace(root, "old-runtime-recipe")?)
    _ = lowering_example_run(binary, source, store, "4\n7\n1\n7\na\n45", trace=trace)?
    stop_example_engine(binary, store)?
    require_crumb_runtime_recipe(store, source)?
    after = snapshot(store).map_err((error) => error.message())?
    assert get(after, old).map_err((error) => error.message())?.is_none(), "legacy recipe was not retired with the typed value"
    assert lowering_attempts(trace)? == 3, "the old-only slot did not use ordinary lowering"
    return Ok(None)


def verify_stale_runtime_batch(binary: str, root: Path, source: Path, seed: str, warm_store: Path) -> Result[None, str]:
    """Change only the recorded second batch under the same key and require live resolution without reading that path."""
    stale_saved_runtime_batch(warm_store, source)?
    write(source, seed.replace("value + 1", "value + 3"))?
    target = root.joinpath("target")
    target.remove_tree().map_err((error) => error.message())?
    trace = attempt_trace(root, "stale-batch-trace")?
    output = "4\n7\n1\n7\na\n44"
    _ = lowering_example_run(binary, source, warm_store, output, trace=Some(trace))?
    stop_example_engine(binary, warm_store)?
    plan = root.joinpath("native.plan")
    executable = target.joinpath("incan/release/bin/probe")
    warm_plan = plan.read_bytes().map_err((error) => error.message())?
    warm_executable = executable.read_bytes().map_err((error) => error.message())?
    target.remove_tree().map_err((error) => error.message())?
    fresh_store = root.joinpath("fresh-stale-control")
    _ = lowering_example_run(binary, source, fresh_store, output)?
    stop_example_engine(binary, fresh_store)?
    assert warm_plan == plan.read_bytes().map_err((error) => error.message())?, "stale-batch plan differs from fresh"
    assert warm_executable == executable.read_bytes().map_err((error) => error.message())?, "stale-batch executable differs from fresh"
    for path in trace.iterdir().map_err((error) => error.message())?:
        if path.name().startswith("engine-compiler-"):
            text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
            assert "incan_stdlib_primitives::__incan_v0_" not in text, "stale provider binding was read"
    attempts = lowering_attempts(Some(trace))?
    assert attempts == 2, f"stale second batch lowering spans: {attempts}"
    return Ok(None)


def stale_saved_runtime_batch(store: Path, source: Path) -> Result[None, str]:
    """Replace the second batch's lookup path while retaining the exact typed recipe shape and authority."""
    key = runtime_requirements_key("probe", source.0, "release")
    graph = snapshot(store).map_err((error) => error.message())?
    saved = get(graph, key).map_err((error) => error.message())?
    if let Some(value) = saved:
        batches = decode_runtime_requirement_batches(value)?
        assert len(batches) == 2 and len(batches[1]) == 1, "expected two runtime batches and one late binding"
        selected = batches[1][0]
        assert selected.path.startswith("incan_stdlib_primitives::__incan_v1_"), "expected the exact linked spelling"
        stale = RuntimeRequirementRow(
            path=selected.path.replace("__incan_v1_", "__incan_v0_"),
            canonical=selected.canonical,
            span=selected.span,
        )
        altered = encode_runtime_requirement_batches([batches[0], [stale]])?
        mut transaction = begin(graph)
        stage_put(transaction, key, altered)
        _ = commit(transaction).map_err((error) => error.message())?
        return Ok(None)
    return Err("two-batch fixture has no saved runtime recipe")


def generic_runtime_source() -> str:
    """The ordinary UTF-8 call loads its provider before generic lowering demands the exact linked spelling."""
    unrelated = "def unrelated(value: int) -> int:\n    return value + 1\n\n\n"
    generic = "def pick[T](items: list[T]) -> T:\n    println(len(\"generic\".encode(\"utf-8\")))\n    return items[0]\n\n\n"
    entry = "def main() -> None:\n    println(len(\"text\".encode(\"utf-8\")))\n"
    return unrelated + generic + entry + "    println(pick([1, 2, 3]))\n    println(pick([\"a\", \"b\"]))\n    println(unrelated(41))\n"
