"""Compare a matched cold hello's actual reads with independently inspected facts and published executable ranges."""

from rust::std::process import Command, exit
from rust::std::string import String as RustString
from std.encoding.hex import hexlify
from std.environ import args, get_or
from std.fs import Path
from std.hash import sha256
from std.json import JsonValue
from benchmark_body_ranges import BodyDemand, Surface, indexed_surface, needed_ranges, range_key
from benchmark_graph_frames import GraphFrames, required_graph_frames
from compiler_record_admission import compiler_record_profile
from files import parse_json, read, read_json, write
from json_fields import array_value, required_items, required_text, string_value
from observation import file_digest
from toolchain import located


model Selection:
    """A semantic facet selector can name several independently addressed overloads."""

    directory_digest: str
    directory_bytes: int
    directory_root: str
    lengths: Dict[str, int] = {}
    facets: Dict[str, list[str]] = {}


model Census:
    """Keep all measured reads and all failures, including repeats of one key."""

    overhead_bytes: int = 0
    counts: Dict[str, int] = {}
    sizes: Dict[str, int] = {}
    problems: list[str] = []
    rows: list[str] = ["class\treads\tbytes\tkey"]


def main() -> None:
    """Supply the matched evidence's hello directory and a fresh directory for this independent inspection."""
    arguments = args().unwrap_or([])[1:]
    if len(arguments) != 2 or get_or("INCAN", "") == "" or get_or("INCAN_HOME", "") == "":
        println("set INCAN and INCAN_HOME; supply MATCHED_HELLO_DIRECTORY NEW_ORACLE_DIRECTORY")
        exit(2)
    destination = Path(arguments[1])
    match destination.mkdir(false, false):
        Err(reason) =>
            println(reason.message())
            exit(2)
        Ok(_) => pass
    match compare(Path(arguments[0]), destination):
        Err(reason) =>
            _ = write(destination.joinpath("verdict.txt"), reason + "\n")
            println(reason)
            exit(1)
        Ok(_) => exit(0)


def compare(hello: Path, output: Path) -> Result[None, str]:
    """Use a separate dependency inspection and bakery after the timed cold build has finished."""
    oven = Path(get_or("INCAN", ""))
    home = Path(get_or("INCAN_HOME", ""))
    toolchain = home.joinpath("toolchains/0.6.0-dev.9")
    manifest = read_json(toolchain.joinpath("toolchain.json"))?
    provenance = read(hello.parent().joinpath("identity.txt"))?.split("\n")
    if len(provenance) < 6 or provenance[2] != file_digest(oven)? or provenance[4] != file_digest(Path(located(toolchain, required_text(manifest, "driver")?)))? or provenance[5] != file_digest(toolchain.joinpath("toolchain.json"))?:
        return Err("candidate client, compiler or toolchain pin differs from the measured build")
    selected = sealed_selection(toolchain, manifest)?
    trace = output.joinpath("dependency-trace")
    trace.mkdir(false, false).map_err((error) => error.message())?
    source = hello.joinpath("src/hello.incn")
    if file_digest(source)? != read(hello.joinpath("cold.source.sha256"))?.strip():
        return Err("hello source differs from the measured input")
    inspector = home.joinpath("bin/oven")
    if file_digest(inspector)? != provenance[2]:
        return Err("installed Oven operational surface differs from the measured client")
    executed = Command.new(inspector.0).args(["inspect", "dependencies", source.0, "--profile", "release"])
        .env("INCAN_HOME", home.0).env("INCAN_ENGINE", "records").env("INCAN_ENGINE_TRACE", trace.0)
        .env("INCAN_BAKERY", output.joinpath("inspection-store").0).env("OVEN_OWNER", "off")
        .env_remove("INCAN_STDLIB").env_remove("INCAN_SOURCE_ROOT").current_dir(hello.0)
        .output().map_err((error) => str(error))?
    write(output.joinpath("dependencies.txt"), str(RustString.from_utf8_lossy(executed.stdout).into_owned()))?
    write(output.joinpath("dependencies.stderr"), str(RustString.from_utf8_lossy(executed.stderr).into_owned()))?
    if not executed.status.success():
        return Err("dependency inspection refused; see dependencies.stderr")
    unit = read_json(hello.joinpath("src/target/incan/units/hello.unit.json"))?
    if required_text(unit, "source")? != source.0 or required_text(unit, "profile")? != "release":
        return Err("dependency inspector selected a different source or profile")
    mut profiles: Dict[str, set[str]] = {}
    mut directories: Dict[str, Path] = {}
    for loaf in required_items(unit, "loaves")?:
        name = required_text(loaf, "name")?
        directory = Path(required_text(loaf, "dir")?)
        if name in directories and directories[name].0 != directory.0:
            return Err(f"ambiguous installed loaf: {name}")
        directories[name] = directory
        standard = loaf.require("standard").map_err((error) => error.message())?.expect_bool().map_err((error) => error.message())?
        profile = directory.name()
        if standard and profile in ["release", "debug"]:
            mut names = profiles.get(profile).unwrap_or(set())
            names.add(name)
            profiles[profile] = names
    mut roots: list[BodyDemand] = []
    mut surfaces: Dict[str, Surface] = {}
    mut fragment_digests: Dict[str, str] = {}
    mut expected: Dict[str, int] = {}
    mut census = Census()
    mut runtime: set[str] = set()
    for profile in sorted([key for key in profiles.keys()]):
        names = profiles[profile]
        roster = "\n".join(sorted([name for name in names]))
        selector = f"loaf/{profile}/@compiler/capabilities/" + name_hash(roster)
        records = selected.facets.get(selector, [])
        if len(records) > 1:
            return Err("ambiguous capabilities for the unit's admitted package names")
        for key in records:
            expected[key] = selected.lengths[key]
            census.rows.append(f"required-global-capabilities\t1\t{selected.lengths[key]}\t{key}")
    mut reached: set[str] = set()
    mut declared = -1
    for row in events(trace)?:
        phase = required_text(row, "phase")?
        if phase == "dependency_roots_complete":
            if declared >= 0 or required_text(row, "source")? != source.0:
                return Err("mixed dependency-root completions")
            declared = number(row, "roots")?
            continue
        if phase == "body_fragment_read":
            match row.get("fragment_digest"):
                Some(value) =>
                    member = required_text(row, "loaf")? + "\t" + required_text(row, "identity")?
                    digest = string_value(value)?
                    if member in fragment_digests and fragment_digests[member] != digest:
                        return Err("conflicting fragment digests for " + member)
                    fragment_digests[member] = digest
                None => pass
            continue
        if phase not in ["dependency_root", "dependency_fact", "dependency_family", "body_surface_open"]:
            continue
        name = required_text(row, "loaf")?
        if name not in directories:
            return Err(f"dependency inspector referenced unprepared Loaf {name}")
        prefix = "loaf/" + directories[name].name() + "/" + name + "/"
        if phase in ["dependency_root", "dependency_family"]:
            reached.add(name)
        if phase == "body_surface_open":
            if name not in surfaces:
                surfaces[name] = indexed_surface(row, directories[name])?
            elif surfaces[name].digest != required_text(row, "digest")?:
                return Err(f"dependency inspector selected conflicting surfaces for {name}")
        elif phase == "dependency_root":
            if required_text(row, "source")? != source.0:
                return Err("dependency root has a different source")
            identity = required_text(row, "identity")?
            roots.append(BodyDemand(identity=identity))
            binding = required_text(row, "runtime")?
            census.rows.append(f"semantic-root\t1\tunknown\t{name}\t{identity}")
            if binding != "":
                runtime.add(name + "/" + binding)
        elif phase == "dependency_family":
            family = required_text(row, "family")?
            if family != "vocabulary":
                return Err(f"unrecognized singleton dependency family: {family}")
            keys = [key for key in selected.lengths.keys() if key.startswith(prefix + family + "/")]
            if len(keys) != 1:
                census.problems.append(f"missing or ambiguous {family} for {name}")
            for key in keys:
                expected[key] = selected.lengths[key]
        elif phase == "dependency_fact":
            family = required_text(row, "family")?
            member = required_text(row, "name")?
            selector = prefix + family + "/" + name_hash(member)
            for key in selected.facets.get(selector, []):
                reached.add(name)
                expected[key] = selected.lengths[key]
            if selector not in selected.facets:
                census.rows.append(f"absent-named-fact\t0\t0\t{selector}\t{member}")
                if family in ["public-namespace", "type-scope"]:
                    census.problems.append(f"fallback needed for unaddressed {family}: {name}/{member}")
    if declared != len(roots) or declared < 0:
        census.problems.append("semantic root inventory is incomplete")
    mut selected_surfaces: set[str] = set()
    mut ranges: Dict[str, int] = {}
    mut members: set[str] = set()
    match needed_ranges(roots, surfaces, fragment_digests):
        Ok((found, owners, identities)) =>
            ranges = found
            selected_surfaces = owners
            members = identities
        Err(reason) => census.problems.append("body range closure unresolved: " + reason)
    for owner in selected_surfaces:
        reached.add(owner)
    for name in reached:
        prefix = "loaf/" + directories[name].name() + "/" + name + "/"
        for key in selected.facets.get(prefix + "metadata/" + name_hash(name), []):
            expected[key] = selected.lengths[key]
        if name in selected_surfaces:
            heads = selected.facets.get(prefix + "executable-range-set/" + name_hash(name), [])
            if len(heads) == 1:
                expected[heads[0]] = selected.lengths[heads[0]]
                for member in members:
                    pair = member.split("\t")
                    if pair[0] == name:
                        addressed = selected.facets.get(prefix + "executable-range/" + name_hash(pair[1]), [])
                        if len(addressed) != 1:
                            census.problems.append(f"missing or ambiguous executable member: {member}")
                        for key in addressed:
                            expected[key] = selected.lengths[key]
            else:
                census.problems.append("installed package lacks a unique authenticated range head: " + name)
                for key in selected.facets.get(prefix + "executable-descriptor/" + name_hash(name), []):
                    expected[key] = selected.lengths[key]
    for binding in sorted([item for item in runtime]):
        parts = binding.split("/")
        if len(parts) != 2:
            return Err(f"unexpected runtime binding identity: {binding}")
        selector = "loaf/" + directories[parts[0]].name() + "/" + parts[0] + "/runtime-binding/" + name_hash(parts[1])
        matches = selected.facets.get(selector, [])
        if len(matches) == 0:
            census.rows.append(f"selected-runtime-binding\t1\tunknown\t{binding}")
            census.problems.append(f"installed runtime group lacks a separately addressed binding: {binding}")
        for key in matches:
            expected[key] = selected.lengths[key]
            census.rows.append(f"selected-runtime-binding\t1\t{selected.lengths[key]}\t{binding}")
    for key in ranges.keys():
        expected["body/" + key] = ranges[key]
    observed(hello.joinpath("cold-trace"), selected, surfaces, census)?
    reconcile(expected, census)
    frames(hello.joinpath("cold.stdout"), hello.joinpath("cold-store"), census)?
    match read(hello.joinpath("cold.native-plan.tsv")):
        Err(reason) => census.problems.append("missing emitted function report: " + reason)
        Ok(plan) =>
            mut count = 0
            mut reported = ""
            for line in plan.split("\n"):
                fields = line.split("\t")
                if line.startswith("plan\tfunctions\t") and len(fields) >= 3:
                    reported = fields[2]
                if line.startswith("plan-function\t") and len(fields) >= 4:
                    count += 1
                    census.rows.append("emitted-function\t1\tunknown\t" + fields[len(fields) - 2] + "\t" + fields[len(fields) - 1])
            if count == 0 or str(count) != reported:
                census.problems.append("emitted function inventory is incomplete")
    write(output.joinpath("census.tsv"), "\n".join(census.rows) + "\n")?
    if len(census.problems) > 0:
        return Err("\n".join(sorted([item for item in set(census.problems)])))
    write(output.joinpath("verdict.txt"), "passed\n")?
    return Ok(None)


def sealed_selection(toolchain: Path, manifest: JsonValue) -> Result[Selection, str]:
    """Verify the externally pinned sealed transport and independently index logical object byte lengths."""
    pin = manifest.require("compiler_records").map_err((error) => "installed compiler record pin missing: " + error.message())?
    directory = toolchain.joinpath(required_text(pin, "root")?)
    path = directory.joinpath("manifest.json")
    encoded = path.read_bytes().map_err((error) => error.message())?
    directory_digest = required_text(pin, "digest")?
    directory_bytes = len(encoded)
    if hexlify(sha256.digest(encoded)) != directory_digest:
        return Err("installed directory differs from the measured toolchain pin")
    table = array_value(parse_json(str(RustString.from_utf8(encoded).map_err((error) => str(error))?))?)?
    if len(table) != 10 or string_value(table[0])? != "incan.sealed-set/2":
        return Err("unrecognized installed directory format")
    expected = compiler_record_profile()
    profile = [string_value(field)? for field in array_value(table[1])?]
    if profile != [expected.identity, expected.schema, expected.codec] or string_value(table[2])? != "installed-toolchain" or string_value(table[3])? != file_digest(Path(located(toolchain, required_text(manifest, "driver")?)))?:
        return Err("sealed set has an unrelated profile, origin or compiler producer")
    mut sizes: Dict[str, int] = {}
    for item in array_value(table[8])?:
        pair = array_value(item)?
        digest = string_value(pair[0])?
        size = pair[1].expect_int().map_err((error) => error.message())?
        if digest in sizes or len(digest) != 64 or size < 0:
            return Err("duplicated or malformed object in the authenticated directory")
        sizes[digest] = size
    mut top = ""
    if let Some(value) = pin.get("directory"):
        top = string_value(value)?
        if top == "":
            return Err("empty installed record directory root")
    mut selected = Selection(directory_digest=directory_digest, directory_bytes=directory_bytes, directory_root=top)
    for item in array_value(table[5])?:
        entry = array_value(item)?
        key = string_value(entry[0])?
        value = string_value(entry[2])?
        parts = key.split("/")
        if len(parts) != 6 or parts[0] != "loaf" or key in selected.lengths or value not in sizes or value != string_value(entry[1])?:
            return Err(f"unrecognized installed compiler record {key}")
        selected.lengths[key] = sizes[value]
        selector = "/".join(parts[:4]) + "/" + parts[5]
        selected.facets[selector] = selected.facets.get(selector, []) + [key]
    return Ok(selected)


def observed(trace: Path, selected: Selection, surfaces: Dict[str, Surface], mut census: Census) -> Result[None, str]:
    """Read physical events from the timed build only, including whole-surface authentication and repeat opens."""
    mut paths: Dict[str, str] = {}
    mut reads = 0
    mut directory_reads = 0
    mut directory_bytes = 0
    mut sealed: set[str] = set()
    for row in events(trace)?:
        phase = required_text(row, "phase")?
        if phase == "record_directory_pages":
            size = number(row, "bytes")?
            top = required_text(row, "root")?
            if selected.directory_root == "" or top != selected.directory_root or required_text(row, "digest")? != selected.directory_digest or size < 0:
                census.problems.append("compiler read pages outside the toolchain's authenticated directory")
            directory_reads += 1
            directory_bytes += size
            census.overhead_bytes += size
            selector = required_text(row, "selector")?
            if selector.endswith("/runtime-binding/"):
                mut limit = 0
                match row.get("limit"):
                    Some(_) => limit = number(row, "limit")?
                    None => pass
                if limit != 1:
                    census.problems.append("enumerated runtime bindings beyond the selected calls: " + selector)
            census.rows.append(f"directory-page-selection\t1\t{size}\t{selector}")
        elif phase == "record_directory_read":
            if selected.directory_root != "":
                census.problems.append("compiler read the entire manifest despite an authenticated lookup index")
            size = number(row, "bytes")?
            if required_text(row, "digest")? != selected.directory_digest or size != selected.directory_bytes:
                census.problems.append("opened a compiler directory that differs from the independently pinned manifest")
            directory_reads += 1
            census.overhead_bytes += size
            directory_bytes += size
            census.rows.append(f"sealed-directory\t1\t{size}\t{selected.directory_digest}")
        elif phase == "body_surface_open":
            path = required_text(row, "path")?
            digest = required_text(row, "digest")?
            package = required_text(row, "loaf")?
            if package not in surfaces or surfaces[package].digest != digest:
                census.problems.append("measured a surface outside authenticated selection: " + path)
            paths[path] = digest
            header = number(row, "header_bytes")?
            verified = number(row, "verified_bytes")?
            match row.get("proof"):
                Some(proof) =>
                    if proof.as_str().unwrap_or("") == "sealed-range":
                        sealed.add(path)
                None => pass
            census.overhead_bytes += verified + header
            if verified > 0 or header > 0:
                census.problems.append(f"whole-sidecar verification read {verified} bytes and header read {header} bytes: {path}")
            census.rows.append(f"verification-scan\t1\t{verified}\t{path}")
            census.rows.append(f"surface-header\t1\t{header}\t{path}")
        elif phase in ["body_fragment_read", "record_read"]:
            mut key = ""
            if phase == "record_read":
                key = required_text(row, "record")?
                if key not in selected.lengths:
                    census.problems.append("read outside installed pin: " + key)
            else:
                path = required_text(row, "path")?
                if path not in paths:
                    census.problems.append("unverified body range: " + path)
                if path in sealed:
                    if not row.require("range_authenticated").map_err((error) => error.message())?.expect_bool().map_err((error) => error.message())?:
                        census.problems.append("selected fragment has no range authentication: " + path)
                key = "body/" + range_key(paths.get(path, "unknown"), required_text(row, "identity")?, number(row, "offset")?, number(row, "absolute_offset")?)
            size = number(row, "bytes")?
            census.counts[key] = census.counts.get(key, 0) + 1
            census.sizes[key] = census.sizes.get(key, 0) + size
            reads += 1
    census.rows.append(f"directory-physical-total\t{directory_reads}\t{directory_bytes}\t{selected.directory_digest}")
    if directory_reads == 0 or directory_bytes == 0:
        census.problems.append("missing physical read witness for the installed record directory")
    if reads == 0:
        census.problems.append("no measured compiler reads")
    return Ok(None)


def reconcile(expected: Dict[str, int], mut census: Census) -> None:
    """Require one exact-length read per independently selected key or covered range and no unexplained reads."""
    mut total_required = 0
    mut total_observed = 0
    mut read_count = 0
    mut duplicates = 0
    for key in sorted([item for item in expected.keys()]):
        needed = expected[key]
        total_required += needed
        actual = census.sizes.get(key, 0)
        reads = census.counts.get(key, 0)
        census.rows.append(f"required\t1\t{needed}\t{key}")
        if reads != 1 or actual != needed:
            census.problems.append(f"requested {key}: required 1/{needed}, observed {reads}/{actual}")
    for key in sorted([item for item in census.counts.keys()]):
        actual = census.sizes[key]
        reads = census.counts[key]
        total_observed += actual
        read_count += reads
        duplicates += reads - 1
        mut label = "observed"
        if key not in expected:
            label = "unexplained"
            if "/runtime-bindings/" in key or "/public-identities/" in key or "/contract-metadata/" in key:
                label = "unresolved-group"
            census.problems.append(f"{label}: {reads} reads/{actual} bytes for {key}")
        census.rows.append(f"{label}\t{reads}\t{actual}\t{key}")
    census.rows.append(f"known-required-total\t{len(expected)}\t{total_required}\tsealed-records-and-body-fragments")
    census.rows.append(f"observed-total\t{read_count}\t{total_observed}\tsealed-records-and-body-fragments")
    census.rows.append(f"observed-minus-known-required\t{read_count - len(expected)}\t{total_observed - total_required}\tsealed-records-and-body-fragments")
    census.rows.append(f"observed-physical-bytes\tunknown\t{total_observed + census.overhead_bytes}\tsealed-directory-record-values-and-executable-reads")
    census.rows.append(f"repeated-reads\t{duplicates}\tunknown\tsealed-records-and-body-fragments")
    if len(expected) == 0:
        census.problems.append("empty required record inventory")


def frames(path: Path, store: Path, mut census: Census) -> Result[None, str]:
    """Cross-check graph read totals, preserve framing overhead and refuse frames without a selected-value witness."""
    mut reports = 0
    for line in read(path)?.split("\n"):
        if not line.startswith("{") or "\"store_reads\"" not in line:
            continue
        report = parse_json(line)?
        reports += 1
        mut selection = GraphFrames()
        match required_graph_frames(report, store):
            Ok(verified) => selection = verified
            Err(reason) => census.problems.append("graph selections unresolved: " + reason)
        for root in selection.roots:
            census.rows.append("semantic-graph-selection\t1\tunknown\t" + root)
        census.problems += selection.unknown
        mut covered: set[str] = set()
        mut count = 0
        mut physical = 0
        mut logical = 0
        for item in required_items(report, "store_reads")?:
            key = required_text(item, "key")?
            revision = required_text(item, "revision")?
            reads = number(item, "reads")?
            size = number(item, "value_bytes")?
            frame = number(item, "frame_bytes")?
            identity = revision + "\t" + key
            covered.add(identity)
            if identity not in selection.lengths:
                census.problems.append(f"graph frame outside the independently selected roots: {key} {revision}")
            elif reads != 1 or selection.lengths[identity] != frame:
                census.problems.append(f"required graph frame {key} {revision}: 1/{selection.lengths[identity]}, measured {reads}/{reads * frame}")
            count += reads
            physical += reads * frame
            logical += reads * size
            if reads < 1 or size < 0 or frame - size != 8 + len(key.encode("utf-8")):
                census.problems.append("invalid graph store accounting: " + key)
            census.rows.append(f"graph-frame\t{reads}\t{reads * frame}\t{key}\t{revision}")
            census.rows.append(f"graph-value\t{reads}\t{reads * size}\t{key}\t{revision}")
            census.rows.append(f"frame-overhead\t{reads}\t{reads * (frame - size)}\t{key}\t{revision}")
        if count != number(report, "store_frames_read")? or physical != number(report, "store_frame_bytes")?:
            census.problems.append("graph frame totals do not reconcile")
        copied = number(report, "store_decoded_bytes")?
        census.rows.append(f"graph-owned-copies\tunknown\t{copied}\tall-owned-values")
        for identity in sorted([item for item in selection.lengths.keys()]):
            census.rows.append(f"required-graph-frame\t1\t{selection.lengths[identity]}\t{identity}")
            if identity not in covered:
                census.problems.append("required graph frame was not read: " + identity)
    if reports != 1:
        census.problems.append(f"expected one engine proof, received {reports}")
    return Ok(None)


def events(trace: Path) -> Result[list[JsonValue], str]:
    """Read just the source-owned selection and physical I/O event kinds from each compiler trace."""
    mut result: list[JsonValue] = []
    for name in sorted([path.0 for path in trace.iterdir().map_err((error) => error.message())?]):
        path = Path(name)
        if not path.name().startswith("engine-compiler-") or not path.name().endswith(".jsonl"):
            continue
        for line in read(path)?.split("\n"):
            if "\"kind\":\"event\"" not in line:
                continue
            for phase in ["dependency_root", "dependency_roots_complete", "dependency_fact", "dependency_family", "body_surface_open", "body_fragment_read", "record_read", "record_directory_read", "record_directory_pages"]:
                if f"\"phase\":\"{phase}\"" in line:
                    result.append(parse_json(line)?.require("fields").map_err((error) => error.message())?)
                    break
    return Ok(result)


def number(row: JsonValue, key: str) -> Result[int, str]:
    """Integer-valued trace or report field."""
    return row.require(key).map_err((error) => error.message())?.expect_int().map_err((error) => error.message())


def name_hash(name: str) -> str:
    """The compiler's sealed-record name selector hashes exact UTF-8, including an empty root namespace."""
    return hexlify(sha256.digest(name.encode("utf-8")))
