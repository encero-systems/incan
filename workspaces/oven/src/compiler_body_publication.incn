"""Publish successful compiler body outputs into the ranked record graph."""

from std.fs import File, Path
from std.environ import get_or
from std.json import JsonValue, parse
from rust::std::fs import metadata
from rust::incan_semantics_core import encode_incan_symbol_identity
from rust::incan_semantics_core::executable_representation import decode_owner
from pub::incan_platform.store import Snapshot, Transaction, begin, commit, get, stage_put
from pub::internal_models import (
    CompiledBodyDependencyRead,
    CompiledBodyFallback,
    CompiledNamespaceValue,
    CompiledBodyValue,
    ProducerRank,
    ProducerStage,
    CompiledBodyOutput,
    CompiledBodyOutputs,
    GraphNamespaceValue,
    compiled_body_frame_size,
    decode_compiled_body_payload,
    encode_graph_namespace_value,
    record_root,
)
from pub::internal_models.checker_records import CHECKER_PROFILE
from pub::internal_models.records import (
    PreparationEvidence,
    ReadReceipt,
    ReadScope,
    RecordRead,
    RecordKey,
    RecordReads,
    RecordRequest,
    RecordSelection,
    PayloadSelection,
    ReadWitness,
    encode_record_key,
)
from compiler_graph_records import prepare_evaluation, reusable_evaluation
from compiler_prepared_records import PreparedBodyRecordSource
from compiler_body_fallbacks import fallback_lowering_event, fallback_reasons
from compiler_plan_values import LOWERING_PROFILE
from compiler_body_values import SelectedBodyRecord
from compiler_source_projection import (
    SourceProjection,
    SourceProjectionRecord,
    compiled_owner_source,
    declaration_index_key,
    owner_source_key,
    project_source,
    signature_record,
)
from engine_capture import CapturedInput, InputRole
from files import discard_file
from unit import UnitDescription, dependency_source_roots

const IDENTITY_PROFILE: str = "incan.stable-declaration/1"
const MAX_COMPILED_BODY_FRAMES: int = 4096


model LoweringBody:
    """An actual fresh or graph-selected owner witness; retained owners are never claimed as fresh checker output."""

    identity: str
    symbol: str
    module: str
    final: bytes
    retained: bool = false
    signature_reads: list[RecordKey] = []


pub enum OwnerRecordFault(str):
    """Closed owner-selection failures so retained history skips only an owner that is genuinely absent."""

    Absent = "absent"
    Ambiguous = "ambiguous"


@derive(Eq)
pub enum ProjectionRefusalMode(str):
    """Whether body publication stops at its first projection refusal or lists every preflight refusal."""

    Default = "default"
    List = "list"


class CompiledBodyFrames:
    """Read one independently bounded binary compiler output frame without buffering the sidecar envelope."""

    file: File
    remaining: u64
    count: int = 0
    fallback_phase: bool = false
    owner_phase: bool = false
    previous_namespace: str = ""
    previous_value: str = ""
    previous_fallback: str = ""

    @staticmethod
    pub def open(path: Path) -> Result[CompiledBodyFrames, str]:
        """Open one compiler sidecar and retain its exact remaining byte count for truncation checks."""
        file = path.open("rb").map_err((error) => f"cannot open compiled body output: {error.message()}")?
        size = metadata(path.0).map_err((error) => f"cannot inspect compiled body output: {error}")?.len()
        return Ok(CompiledBodyFrames(file=file, remaining=size))

    pub def next(mut self) -> Result[Option[CompiledBodyOutput], str]:
        """Read, authenticate and order one owner frame, returning `None` only at the exact file boundary."""
        if self.remaining == 0u64:
            return Ok(None)
        if self.remaining < 8u64:
            return Err("compiled body output ends inside a frame prefix")
        prefix = self.file
            .read_exact(8)
            .map_err((error) => f"cannot read compiled body frame prefix: {error.message()}")?
        size = compiled_body_frame_size(prefix).map_err((error) => f"compiled body output refused: {error:?}")?
        converted: Option[u64] = size.try_resize()
        frame_bytes = match converted:
            Some(value) => value
            None => return Err("compiled body frame length exceeds the host range")

        if frame_bytes + 8u64 > self.remaining:
            return Err("compiled body output ends inside an owner frame")
        payload = self.file
            .read_exact(size)
            .map_err((error) => f"cannot read compiled body owner frame: {error.message()}")?
        self.remaining -= frame_bytes + 8u64
        self.count += 1
        if self.count > MAX_COMPILED_BODY_FRAMES:
            return Err("compiled body output contains too many owner frames")
        output = decode_compiled_body_payload(payload).map_err((error) => f"compiled body output refused: {error:?}")?
        self.validate_order(output)?
        return Ok(Some(output))

    def validate_order(mut self, output: CompiledBodyOutput) -> Result[None, str]:
        """Retain canonical value-then-fallback ordering without a whole-program decoder."""
        match output:
            CompiledBodyOutput.Namespace(value) =>
                if self.owner_phase or self.fallback_phase or value.module <= self.previous_namespace:
                    return Err("compiled namespace frames are not in canonical order")
                self.previous_namespace = value.module
            CompiledBodyOutput.Value(value) =>
                self.owner_phase = true
                if self.fallback_phase:
                    return Err("compiled body value follows a fallback frame")
                order = value.module + "\n" + value.identity
                if order <= self.previous_value:
                    return Err("compiled body value frames are not in canonical order")
                self.previous_value = order
            CompiledBodyOutput.Fallback(fallback) =>
                self.owner_phase = true
                self.fallback_phase = true
                identity = match fallback.identity:
                    Some(value) => value
                    None => ""

                order = fallback.module + "\n" + fallback.name + "\n" + identity
                if order <= self.previous_fallback:
                    return Err("compiled body fallback frames are not in canonical order")
                self.previous_fallback = order
        return Ok(None)


def read_compiled_body_outputs(path: Path) -> Result[CompiledBodyOutputs, str]:
    """Read the sidecar as one bounded owner allocation at a time while retaining only decoded semantic values."""
    mut reader = CompiledBodyFrames.open(path)?
    mut values: list[CompiledBodyValue] = []
    mut fallbacks: list[CompiledBodyFallback] = []
    mut namespaces: list[CompiledNamespaceValue] = []
    while true:
        match reader.next()?:
            None => return Ok(CompiledBodyOutputs(namespaces=namespaces, values=values, fallbacks=fallbacks))
            Some(CompiledBodyOutput.Namespace(value)) => namespaces.append(value)
            Some(CompiledBodyOutput.Value(value)) => values.append(value)
            Some(CompiledBodyOutput.Fallback(fallback)) =>
                identity = match fallback.identity:
                    Some(value) => value
                    None => ""

                if identity != "":
                    for value in values:
                        if value.module == fallback.module and value.identity == identity:
                            return Err("compiled body fallback duplicates an eligible owner")
                fallbacks.append(fallback)


pub model PublishedCompiledBodies:
    """The graph generation and eligible/fallback body counts published from one successful whole check."""

    pub snapshot: Snapshot
    pub bodies: int
    pub fallbacks: int
    pub checking_evaluations: int
    pub body_ir_evaluations: int


pub model PreparedCompiledBodies:
    """Body records staged beside a native request's other outputs without publishing another generation."""

    pub transaction: Transaction
    pub bodies: int
    pub fallbacks: int
    pub checking_evaluations: int
    pub body_ir_evaluations: int


pub model PublishedSourceInputs:
    """The graph generation and logical keys rewritten by captured source projection."""

    pub snapshot: Snapshot
    pub keys: list[RecordKey]


pub model PreparedSourceInputs:
    """Captured source projections staged for one atomic native request and the keys whose values changed."""

    pub transaction: Transaction
    pub keys: list[RecordKey]


pub def publish_captured_source_inputs(
    selected: Snapshot,
    unit: UnitDescription,
    inputs: list[CapturedInput],
) -> Result[PublishedSourceInputs, str]:
    """Publish captured Incan source projections in one standalone transaction."""
    prepared = prepare_captured_source_inputs(selected, begin(selected), unit, inputs)?
    published = commit(prepared.transaction).map_err((error) => error.message())?
    return Ok(PublishedSourceInputs(snapshot=published, keys=prepared.keys))


pub def prepare_captured_source_inputs(
    selected: Snapshot,
    transaction: Transaction,
    unit: UnitDescription,
    inputs: list[CapturedInput],
) -> Result[PreparedSourceInputs, str]:
    """Stage captured source projections and report only keys whose semantic values differ from the selected view."""
    mut prepared = transaction
    mut changed: list[RecordKey] = []
    for input in inputs:
        if input.path.endswith(".incn") and input.role in [InputRole.Root, InputRole.Member, InputRole.Resolved]:
            match captured_source_identity(unit, input.path)?:
                None => continue
                Some(identity) =>
                    source = Path(input.path).read_text("utf-8", "strict").map_err((error) => error.message())?
                    projection = project_source(identity[0], identity[1], source)?
                    header_key = encode_record_key(projection.header.key)?
                    header_value = projection.header.text.encode("utf-8")
                    if get(selected, header_key).map_err((error) => error.message())? != Some(header_value):
                        changed.append(projection.header.key)
                    stage_put(prepared, header_key, header_value)
                    declaration_key = encode_record_key(projection.declarations.key)?
                    declaration_value = projection.declarations.text.encode("utf-8")
                    if get(selected, declaration_key).map_err((error) => error.message())? != Some(declaration_value):
                        changed.append(projection.declarations.key)
                    stage_put(prepared, declaration_key, declaration_value)
                    for owner in projection.owners:
                        for record in [owner, signature_record(owner)]:
                            owner_key = encode_record_key(record.key)?
                            owner_value = record.text.encode("utf-8")
                            if get(selected, owner_key).map_err((error) => error.message())? != Some(owner_value):
                                changed.append(record.key)
                            stage_put(prepared, owner_key, owner_value)
    return Ok(PreparedSourceInputs(transaction=prepared, keys=changed))


def captured_source_identity(unit: UnitDescription, path: str) -> Result[Option[Tuple[str, str]], str]:
    """Compare physical input and root paths so symlinked checkouts cannot omit changed source witnesses."""
    mut normalized = ""
    match Path(path).resolve():
        Err(_) => return Ok(None)
        Ok(resolved) => normalized = resolved.0
    for dependency in dependency_source_roots(unit):
        if let Some(relative) = captured_relative_path(normalized, dependency[1])?:
            return Ok(Some((dependency[0], logical_module(relative))))
    if let Some(relative) = captured_relative_path(normalized, unit.project_root)?:
        return Ok(Some((source_origin(unit), relative)))
    return Ok(None)


def captured_relative_path(path: str, root: str) -> Result[Option[str], str]:
    """Resolve the described root with the input's path policy; an unreadable root must refuse reuse."""
    physical = Path(root).resolve().map_err((error) => f"cannot resolve captured source root {root}: {error.message()}")?
    prefix = physical.0 + "/"
    if path.startswith(prefix):
        return Ok(Some(path[len(prefix):]))
    return Ok(None)


def logical_module(relative: str) -> str:
    """Canonicalize an editable dependency source path the same way source-module resolution names its module."""
    mut without_extension = relative
    if without_extension.endswith(".incn"):
        without_extension = without_extension[:len(without_extension) - len(".incn")]
    mut parts = without_extension.split("/")
    if len(parts) > 0 and parts[len(parts) - 1] in ["mod", "__init__"]:
        parts = parts[:len(parts) - 1]
    elif len(parts) > 1 and parts[len(parts) - 1] == "prelude":
        parts = parts[:len(parts) - 1]
    return "/".join(parts)


pub def publish_compiled_bodies(
    selected: Snapshot,
    unit: UnitDescription,
    output: Path,
) -> Result[PublishedCompiledBodies, str]:
    """Publish one successful compiler sidecar in a standalone atomic transaction."""
    prepared = prepare_compiled_bodies(begin(selected), unit, output)?
    published = commit(prepared.transaction).map_err((error) => error.message())?
    return Ok(
        PublishedCompiledBodies(
            snapshot=published,
            bodies=prepared.bodies,
            fallbacks=prepared.fallbacks,
            checking_evaluations=prepared.checking_evaluations,
            body_ir_evaluations=prepared.body_ir_evaluations,
        ),
    )


pub def prepare_compiled_bodies(
    transaction: Transaction,
    unit: UnitDescription,
    output: Path,
    plan_output: Option[Path] = None,
    selected: Option[Snapshot] = None,
    retained: list[SelectedBodyRecord] = [],
) -> Result[PreparedCompiledBodies, str]:
    """
    Stage one successful compiler sidecar through source projections and witnessed checker evaluations.

    1. Authenticate the bounded sidecar through the shared checker codec.
    2. Stage each source projection and declaration value before any body receipt reads them.
    3. Stage local, final and Body IR evaluations in the caller's request transaction.
    """
    # 1. The sidecar is invocation output, not an authority until this graph publication succeeds.
    if not output.is_file():
        return Err("successful graph-enabled compile did not publish body outputs")
    outputs = read_compiled_body_outputs(output)?
    discard_file(output)
    owner_evaluations = len(outputs.values) + len(outputs.fallbacks)
    origin = source_origin(unit)
    if projection_refusal_mode()? == ProjectionRefusalMode.List:
        refusals = projection_refusals(unit, origin, outputs.values)
        if len(refusals) > 0:
            return Err(
                f"compiled body projection refusal list ({len(refusals)}):\n" + "\n".join(
                    [f"{index + 1}. {refusals[index]}" for index in range(len(refusals))],
                ),
            )

    # 2. The prepared source authenticates only values carried by this exact request transaction.
    scope = ReadScope(snapshot=transaction.id, profile=CHECKER_PROFILE)
    mut source = PreparedBodyRecordSource.open(scope)
    mut prepared = transaction
    mut modules: list[str] = []
    for namespace in outputs.namespaces:
        if namespace.module not in modules:
            projection = source_projection(unit, origin, namespace.module)?
            header_key = encode_record_key(projection.header.key)?
            header_value = projection.header.text.encode("utf-8")
            stage_put(prepared, header_key, header_value)
            source.add(header_key, header_value)
            declaration_key = encode_record_key(projection.declarations.key)?
            declaration_value = projection.declarations.text.encode("utf-8")
            stage_put(prepared, declaration_key, declaration_value)
            source.add(declaration_key, declaration_value)
            for owner in projection.owners:
                owner_key = encode_record_key(owner.key)?
                owner_value = owner.text.encode("utf-8")
                stage_put(prepared, owner_key, owner_value)
                source.add(owner_key, owner_value)
            modules.append(namespace.module)
    for value in outputs.values:
        if value.module not in modules:
            projection = source_projection(unit, origin, value.module)?
            header_key = encode_record_key(projection.header.key)?
            header_value = projection.header.text.encode("utf-8")
            stage_put(prepared, header_key, header_value)
            source.add(header_key, header_value)
            declaration_key = encode_record_key(projection.declarations.key)?
            declaration_value = projection.declarations.text.encode("utf-8")
            stage_put(prepared, declaration_key, declaration_value)
            source.add(declaration_key, declaration_value)
            for owner in projection.owners:
                for record in [owner, signature_record(owner)]:
                    owner_key = encode_record_key(record.key)?
                    owner_value = record.text.encode("utf-8")
                    stage_put(prepared, owner_key, owner_value)
                    source.add(owner_key, owner_value)
            modules.append(value.module)
    for fallback in outputs.fallbacks:
        if fallback.module not in modules:
            projection = source_projection(unit, origin, fallback.module)?
            header_key = encode_record_key(projection.header.key)?
            header_value = projection.header.text.encode("utf-8")
            stage_put(prepared, header_key, header_value)
            source.add(header_key, header_value)
            declaration_key = encode_record_key(projection.declarations.key)?
            declaration_value = projection.declarations.text.encode("utf-8")
            stage_put(prepared, declaration_key, declaration_value)
            source.add(declaration_key, declaration_value)
            for owner in projection.owners:
                for record in [owner, signature_record(owner)]:
                    owner_key = encode_record_key(record.key)?
                    owner_value = record.text.encode("utf-8")
                    stage_put(prepared, owner_key, owner_value)
                    source.add(owner_key, owner_value)
            modules.append(fallback.module)
    editable_packages = [dependency[0] for dependency in dependency_source_roots(unit)]
    for value in outputs.values:
        for dependency in value.dependency_reads:
            match dependency.package:
                Some(package) =>
                    if package in editable_packages:
                        owner = signature_record(
                            dependency_owner_record(
                                unit,
                                package,
                                dependency.module,
                                dependency.name,
                                dependency.identity,
                            ).map_err(
                                (error) => dependency_projection_refusal(
                                    error,
                                    value.module,
                                    value.name,
                                    value.identity,
                                    dependency,
                                ),
                            )?,
                        )
                        stage_put(prepared, encode_record_key(owner.key)?, owner.text.encode("utf-8"))
                        source.add(encode_record_key(owner.key)?, owner.text.encode("utf-8"))
                None =>
                    slot = project_declaration_slot(origin, dependency.module, dependency.name)
                    slot_value = dependency.identity.encode("utf-8")
                    stage_put(prepared, encode_record_key(slot)?, slot_value)
                    source.add(encode_record_key(slot)?, slot_value)
                    dependency_module = project_dependency_module(unit, dependency.module)?
                    dependency_projection = source_projection(unit, origin, dependency_module)?
                    declaration_key = encode_record_key(dependency_projection.declarations.key)?
                    declaration_value = dependency_projection.declarations.text.encode("utf-8")
                    stage_put(prepared, declaration_key, declaration_value)
                    source.add(declaration_key, declaration_value)
                    signature = project_signature_record(
                        unit,
                        origin,
                        dependency.module,
                        dependency.name,
                        dependency.identity,
                    ).map_err(
                        (error) => dependency_projection_refusal(
                            error,
                            value.module,
                            value.name,
                            value.identity,
                            dependency,
                        ),
                    )?
                    signature_key = encode_record_key(signature.key)?
                    signature_value = signature.text.encode("utf-8")
                    stage_put(prepared, signature_key, signature_value)
                    source.add(signature_key, signature_value)
    for value in outputs.values:
        declaration_key = encode_record_key(
            body_key("declaration", origin, value.identity, value.name, root(value.declaration)?),
        )?
        stage_put(prepared, declaration_key, value.declaration)
        source.add(declaration_key, value.declaration)
        stage_put(prepared, encode_record_key(eligibility_key(origin, value.identity, value.name))?, b"record-eligible")
    for fallback in outputs.fallbacks:
        match fallback.identity:
            Some(identity) =>
                stage_put(
                    prepared,
                    encode_record_key(eligibility_key(origin, identity, fallback.name))?,
                    ("full-source: " + fallback.reason).encode("utf-8"),
                )
            None => pass

    declarations = module_declarations(outputs.values, origin)?

    # 3. A cold whole check stages the same graph values later edited activations replace independently.
    mut published = 0
    for namespace in outputs.namespaces:
        projection = source_projection(unit, origin, namespace.module)?
        key = namespace_key(origin, namespace.module)
        mut reads = [request(projection.header.key), request(projection.declarations.key)]
        for owner in projection.owners:
            reads.append(request(owner.key))
        for dependency in namespace.dependencies:
            reads.append(request(declaration_index_key(origin, dependency)))
        value = encode_graph_namespace_value(
            GraphNamespaceValue(
                module=namespace.module,
                interface=namespace.interface,
                body_ir=namespace.body_ir,
                lowering_inputs=namespace.lowering_inputs,
            ),
        ).map_err((error) => f"compiled namespace output refused: {error:?}")?
        receipt = prepared_receipt(source, scope, key, reads)?
        _ = prepare_evaluation(
            prepared,
            "compiled-namespace-" + namespace.module,
            ProducerRank(namespace=0, stage=ProducerStage.Signature, dependency=0),
            value,
            receipt,
        )?
    for value in outputs.values:
        projection = source_projection(unit, origin, value.module)?
        owner = compiled_owner_source(projection, value.module, value.name, value.identity)?
        local_key = body_key("local", origin, value.identity, "checked", root(value.local)?)
        mut local_reads = [request(owner.key), request(projection.header.key), request(projection.declarations.key)]
        for declaration in declarations[value.module]:
            local_reads.append(request(declaration))
        for dependency in value.dependency_reads:
            match dependency_read_key(unit, origin, dependency, editable_packages)?:
                Some(key) => local_reads.append(request(key))
                None => pass
            match dependency_invalidation_key(unit, origin, dependency)?:
                Some(key) => local_reads.append(request(key))
                None => pass
            match dependency_signature_key(unit, origin, dependency, editable_packages)?:
                Some(key) => local_reads.append(request(key))
                None => pass
        local_receipt = prepared_receipt(source, scope, local_key, local_reads)?
        _ = prepare_evaluation(
            prepared,
            "compiled-local-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0),
            value.local,
            local_receipt,
        )?
        source.add(encode_record_key(local_key)?, value.local)
        final_key = body_key("final", origin, value.identity, "checked", root(value.final)?)
        mut final_reads = [
            request(owner.key),
            request(projection.header.key),
            request(projection.declarations.key),
            request(local_key),
        ]
        for declaration in declarations[value.module]:
            final_reads.append(request(declaration))
        for dependency in value.dependency_reads:
            match dependency_read_key(unit, origin, dependency, editable_packages)?:
                Some(key) => final_reads.append(request(key))
                None => pass
            match dependency_invalidation_key(unit, origin, dependency)?:
                Some(key) => final_reads.append(request(key))
                None => pass
            match dependency_signature_key(unit, origin, dependency, editable_packages)?:
                Some(key) => final_reads.append(request(key))
                None => pass
        final_receipt = prepared_receipt(source, scope, final_key, final_reads)?
        _ = prepare_evaluation(
            prepared,
            "compiled-final-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=1),
            value.final,
            final_receipt,
        )?
        source.add(encode_record_key(final_key)?, value.final)
        body_ir_key = body_key("body-ir", origin, value.identity, "checked", root(value.final)?)
        body_ir_receipt = prepared_receipt(source, scope, body_ir_key, [request(final_key)])?
        _ = prepare_evaluation(
            prepared,
            "compiled-body-ir-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.BodyIr, dependency=0),
            value.body_ir,
            body_ir_receipt,
        )?
        source.add(encode_record_key(body_ir_key)?, value.body_ir)
        published += 1
    if let Some(report) = plan_output:
        witnesses = lowering_witnesses(outputs.values, retained, source, selected, unit, origin, declarations)?
        prepared = prepare_lowering_records(
            prepared,
            source,
            witnesses,
            outputs.fallbacks,
            origin,
            report,
            unit,
            selected,
        )?
    return Ok(
        PreparedCompiledBodies(
            transaction=prepared,
            bodies=published,
            fallbacks=len(outputs.fallbacks),
            checking_evaluations=owner_evaluations,
            body_ir_evaluations=owner_evaluations,
        ),
    )


def projection_refusal_mode() -> Result[ProjectionRefusalMode, str]:
    """Select the diagnosis-only preflight without changing ordinary fail-first publication."""
    selected = get_or("OVEN_BODY_REFUSALS", ProjectionRefusalMode.Default.value())
    if selected == ProjectionRefusalMode.Default.value():
        return Ok(ProjectionRefusalMode.Default)
    if selected == ProjectionRefusalMode.List.value():
        return Ok(ProjectionRefusalMode.List)
    return Err("OVEN_BODY_REFUSALS must be default or list")


pub def projection_refusals(unit: UnitDescription, origin: str, values: list[CompiledBodyValue]) -> list[str]:
    """Preflight every body and editable-source dependency projection, retaining one refusal per reference."""
    mut refusals: list[str] = []
    editable_packages = [dependency[0] for dependency in dependency_source_roots(unit)]
    for value in values:
        match source_projection(unit, origin, value.module):
            Err(reason) => refusals.append(body_projection_refusal(reason, value))
            Ok(projection) =>
                match compiled_owner_source(projection, value.module, value.name, value.identity):
                    Err(reason) => refusals.append(body_projection_refusal(reason, value))
                    Ok(_) => pass
        for dependency in value.dependency_reads:
            match dependency.package:
                Some(package) =>
                    if package in editable_packages:
                        match dependency_owner_record(
                            unit,
                            package,
                            dependency.module,
                            dependency.name,
                            dependency.identity,
                        ):
                            Err(reason) => refusals.append(
                                dependency_projection_refusal(
                                    reason,
                                    value.module,
                                    value.name,
                                    value.identity,
                                    dependency,
                                ),
                            )
                            Ok(_) => pass
                None =>
                    match project_dependency_module(unit, dependency.module):
                        Err(reason) => refusals.append(
                            dependency_projection_refusal(reason, value.module, value.name, value.identity, dependency),
                        )
                        Ok(module) =>
                            match source_projection(unit, origin, module):
                                Err(reason) => refusals.append(
                                    dependency_projection_refusal(
                                        reason,
                                        value.module,
                                        value.name,
                                        value.identity,
                                        dependency,
                                    ),
                                )
                                Ok(_) =>
                                    match project_signature_record(
                                        unit,
                                        origin,
                                        dependency.module,
                                        dependency.name,
                                        dependency.identity,
                                    ):
                                        Err(reason) => refusals.append(
                                            dependency_projection_refusal(
                                                reason,
                                                value.module,
                                                value.name,
                                                value.identity,
                                                dependency,
                                            ),
                                        )
                                        Ok(_) => pass
    return refusals


def body_projection_refusal(reason: str, value: CompiledBodyValue) -> str:
    """Retain the exact body owner on a source-projection or owner-selection refusal."""
    return (reason + f"; body_owner={value.module}:{value.name}; body_identity={value.identity}; module={value.module}")


def lowering_witnesses(
    fresh: list[CompiledBodyValue],
    retained: list[SelectedBodyRecord],
    mut source: PreparedBodyRecordSource,
    selected: Option[Snapshot],
    unit: UnitDescription,
    origin: str,
    declarations: Dict[str, list[RecordKey]],
) -> Result[list[LoweringBody], str]:
    """Carry only graph-selected inputs with unchanged current owner/header bytes; never invent fresh checker facts."""
    mut witnesses: list[LoweringBody] = []
    editable_packages = [dependency[0] for dependency in dependency_source_roots(unit)]
    for value in fresh:
        mut signatures = [source_projection(unit, origin, value.module)?.declarations.key]
        signatures.extend(declarations[value.module])
        for dependency in value.dependency_reads:
            match dependency_read_key(unit, origin, dependency, editable_packages)?:
                Some(key) => signatures.append(key)
                None => pass
            match dependency_signature_key(unit, origin, dependency, editable_packages)?:
                Some(key) => signatures.append(key)
                None => pass
            match dependency_invalidation_key(unit, origin, dependency)?:
                Some(key) => signatures.append(key)
                None => pass
        witnesses.append(
            LoweringBody(
                identity=value.identity,
                symbol=lowering_symbol(value.identity, value.body_ir)?,
                module=value.module,
                final=value.final,
                signature_reads=signatures,
            ),
        )
    for record in retained:
        if record.identity in [value.identity for value in witnesses]:
            continue
        decoded = decode_owner(record.body_ir).map_err((error) => str(error))?
        if decoded.identity != record.identity:
            return Err("retained Body IR disagrees with its graph owner")
        symbol = match decoded.body.canonical:
            Some(canonical) => encode_incan_symbol_identity(canonical)
            None => ""

        key = body_key("body-ir", origin, record.identity, "checked", root(record.final)?)
        prior = match selected:
            None => return Err("retained Body IR has no selected graph")
            Some(value) => value

        if get(prior, encode_record_key(key)?).map_err((error) => error.message())? != Some(record.body_ir):
            return Err("retained Body IR differs from the selected graph")
        projection = source_projection(unit, origin, decoded.source)?
        owner = match compiled_owner_source(projection, decoded.source, str(decoded.body.name), record.identity):
            Ok(value) => value
            Err(reason) =>
                # A removed or renamed owner remains valid history in the selected graph, but it is not a witness
                # for the current compile. Every other malformed selection state remains a hard refusal.
                if reason.startswith("compiled body output has no matching owner source:"):
                    continue
                return Err(reason)

        for binding in [projection.header, owner]:
            if get(prior, encode_record_key(binding.key)?).map_err((error) => error.message())? != Some(
                binding.text.encode("utf-8"),
            ):
                return Err("retained Body IR has changed current source inputs")
        source.add(encode_record_key(key)?, record.body_ir)
        local_key = body_key("local", origin, record.identity, "checked", root(record.local)?)
        local = match reusable_evaluation(prior, local_key, CHECKER_PROFILE)?:
            None => return Err("retained lowering owner has no witnessed checker inputs")
            Some(value) => value

        mut signatures: list[RecordKey] = []
        for witness in local.receipt.witnesses:
            match witness:
                ReadWitness.Found(found, _) =>
                    input = found.request.key
                    if input.family in ["declaration", "declaration-slot", "declaration-signature", "declaration-index"]:
                        encoded = encode_record_key(input)?
                        value = match get(prior, encoded).map_err((error) => error.message())?:
                            None => return Err("retained lowering signature input is absent")
                            Some(value) => value

                        source.add(encoded, value)
                        signatures.append(input)
                _ => return Err("retained lowering owner has an unsupported checker witness")
        witnesses.append(
            LoweringBody(
                identity=record.identity,
                symbol=symbol,
                module=decoded.source,
                final=record.final,
                retained=true,
                signature_reads=signatures,
            ),
        )
    return Ok(witnesses)


def prepare_lowering_records(
    transaction: Transaction,
    mut source: PreparedBodyRecordSource,
    values: list[LoweringBody],
    fallbacks: list[CompiledBodyFallback],
    origin: str,
    report: Path,
    unit: UnitDescription,
    selected: Option[Snapshot],
) -> Result[Transaction, str]:
    """Stage evaluated lowering-demand and plan-function values through their exact Body IR witnesses."""
    if not report.is_dir():
        return Err("successful records compile did not publish lowering outputs")
    scope = ReadScope(snapshot=transaction.id, profile=LOWERING_PROFILE)
    mut staged_source = source.for_profile(LOWERING_PROFILE)
    mut prepared = transaction
    mut bodies: Dict[str, LoweringBody] = {}
    for value in values:
        if value.symbol == "":
            continue
        if value.symbol in bodies:
            return Err("multiple graph-eligible Body IR owners have the same canonical identity")
        bodies[value.symbol] = value
    mut events: list[JsonValue] = []
    for path in sorted([path.0 for path in report.iterdir().map_err((error) => error.message())?]):
        entry = Path(path)
        if not entry.is_file() or not path.endswith(".event"):
            continue
        event = parse(entry.read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
            (error) => f"lowering output refused: {error.message()}",
        )?
        if event.require("schema").map_err((error) => error.message())?.expect_int().map_err((error) => error.message())? != 2:
            return Err("lowering output has an unsupported schema")
        events.append(event)
    mut plan_keys: list[RecordKey] = []
    # Scalar demand and plan suppliers settle before the entry-binding contribution reads main's demand.
    for event in events:
        if is_entry_event(event)?:
            continue
        event_identity = required_event_text(event, "identity")?
        if fallback_lowering_event(unit, fallbacks, event_identity)?:
            continue
        key = required_event_text(event, "key")?
        function = required_event_text(event, "function")?
        product = required_event_text(event, "product")?.encode("utf-8")
        body = body_value(bodies, fallbacks, event_identity)?
        # A retained body is already byte-matched to this selected graph above. Its native plan may still be fresh
        # when a linked Rust unit changed without changing the checked source body or its callable signature.
        identity = body.identity
        body_ir_key = body_key("body-ir", origin, identity, "checked", root(body.final)?)
        demand_key = body_key("lowering-demand", origin, identity, function, key)
        demand_value = lowering_demand(product)?
        signature_reads = [request(key) for key in body.signature_reads]
        demand_receipt = prepared_receipt(staged_source, scope, demand_key, [request(body_ir_key)] + signature_reads)?
        check_reused_output(selected, event, demand_key, demand_value)?
        _ = prepare_evaluation(
            prepared,
            "lowering-demand-" + identity,
            ProducerRank(namespace=0, stage=ProducerStage.LoweringDemand, dependency=0),
            demand_value,
            demand_receipt,
        )?
        staged_source.add(encode_record_key(demand_key)?, demand_value)
        plan_key = body_key("plan-function", origin, identity, "body:" + function, key)
        check_reused_output(selected, event, plan_key, product)?
        plan_receipt = prepared_receipt(staged_source, scope, plan_key, [request(demand_key)] + signature_reads)?
        _ = prepare_evaluation(
            prepared,
            "plan-function-" + identity,
            ProducerRank(namespace=0, stage=ProducerStage.PlanFunction, dependency=0),
            product,
            plan_receipt,
        )?
        staged_source.add(encode_record_key(plan_key)?, product)
        plan_keys.append(plan_key)
    for event in events:
        if not is_entry_event(event)?:
            continue
        event_identity = required_event_text(event, "identity")?
        if fallback_lowering_event(unit, fallbacks, event_identity)?:
            continue
        body = body_value(bodies, fallbacks, event_identity)?
        demand_key = body_key("lowering-demand", origin, body.identity, "main", required_event_text(event, "demand")?)
        key = body_key("plan-function", origin, body.identity, "entry", required_event_text(event, "key")?)
        product = required_event_text(event, "product")?.encode("utf-8")
        check_reused_output(selected, event, key, product)?
        receipt = prepared_receipt(staged_source, scope, key, [request(demand_key)])?
        _ = prepare_evaluation(
            prepared,
            "plan-entry-" + body.identity,
            ProducerRank(namespace=0, stage=ProducerStage.PlanFunction, dependency=1),
            product,
            receipt,
        )?
        staged_source.add(encode_record_key(key)?, product)
        plan_keys.append(key)
    if not report.joinpath("native-interface.json").is_file():
        require_plan_refusal(report)?
        return Ok(prepared)
    prepare_native_interface(prepared, staged_source, scope, unit, origin, values, report, plan_keys)?
    return Ok(prepared)


def require_plan_refusal(report: Path) -> Result[None, str]:
    """Accept an incomplete native interface only when lowering retained an explicit per-function refusal."""
    for entry in report.iterdir().map_err((error) => error.message())?:
        if entry.is_file() and entry.name().endswith(".refusal"):
            document = parse(entry.read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
                (error) => error.message(),
            )?
            if document.require("schema").and_then((field) => field.expect_int()).map_err((error) => error.message())? != 2:
                return Err("lowering refusal has an unsupported schema")
            _ = required_event_text(document, "function")?
            _ = required_event_text(document, "refusal")?
            return Ok(None)
    return Err("successful records compile omitted its native interface without a lowering refusal")


def is_entry_event(event: JsonValue) -> Result[bool, str]:
    """Distinguish the compiler-owned entry role from an authored function whose name happens to be entry."""
    match event.get("role"):
        None => return Ok(false)
        Some(role) =>
            if role.expect_str().map_err((error) => error.message())? != "entry":
                return Err("unsupported plan-function role")
            return Ok(true)


def lowering_demand(product: bytes) -> Result[bytes, str]:
    """Retain the actual checked inputs and exact runtime signatures discovered by existing scalar lowering."""
    record = parse(product.decode().map_err((_) => "invalid scalar record UTF-8")?).map_err((error) => error.message())?
    native = parse(required_event_text(record, "function")?).map_err((error) => error.message())?
    value = JsonValue.object(
        {"schema": JsonValue.string("incan.lowering-demand/2"), "inputs": record
            .require("inputs")
            .map_err((error) => error.message())?, "runtime": native
            .require("runtime")
            .map_err((error) => error.message())?},
    )
    return Ok(value.to_json().map_err((error) => error.message())?.encode("utf-8"))


def check_reused_output(
    selected: Option[Snapshot],
    event: JsonValue,
    key: RecordKey,
    value: bytes,
) -> Result[None, str]:
    """A compiler reuse event must reproduce the exact value previously selected from the graph."""
    reused = event.require("reused").and_then((value) => value.expect_bool()).map_err((error) => error.message())?
    if reused:
        prior = match selected:
            Some(value) => value
            None => return Err("a reused lowering record has no selected graph snapshot")

        if get(prior, encode_record_key(key)?).map_err((error) => error.message())? != Some(value):
            return Err("a reused lowering record differs from its selected graph authority")
    return Ok(None)


def prepare_native_interface(
    mut transaction: Transaction,
    mut source: PreparedBodyRecordSource,
    scope: ReadScope,
    unit: UnitDescription,
    origin: str,
    bodies: list[LoweringBody],
    report: Path,
    plans: list[RecordKey],
) -> Result[None, str]:
    """Witness the complete loss-checked native plan against its exact function members and current source positions."""
    path = report.joinpath("native-interface.json")
    document = parse(path.read_text("utf-8", "strict").map_err((error) => error.message())?).map_err(
        (error) => error.message(),
    )?
    if required_event_text(document, "schema")? != "incan.native-interface/1":
        return Err("native-interface has an unsupported schema")
    key = body_key("native-interface", origin, origin, unit.profile, unit.checked_context.unwrap_or(""))
    mut reads = [request(plan) for plan in plans]
    mut modules: list[str] = []
    for body in bodies:
        if body.module not in modules:
            projection = source_projection(unit, origin, body.module)?
            source.add(encode_record_key(projection.header.key)?, projection.header.text.encode("utf-8"))
            reads.append(request(projection.header.key))
            for owner in projection.owners:
                source.add(encode_record_key(owner.key)?, owner.text.encode("utf-8"))
                reads.append(request(owner.key))
            modules.append(body.module)
    receipt = prepared_receipt(source, scope, key, reads)?
    _ = prepare_evaluation(
        transaction,
        "native-interface-" + origin,
        ProducerRank(namespace=0, stage=ProducerStage.NativeInterface, dependency=0),
        required_event_text(document, "plan")?.encode("utf-8"),
        receipt,
    )?
    return Ok(None)


def required_event_text(event: JsonValue, key: str) -> Result[str, str]:
    """Read one required lowering-event text field without accepting coercion."""
    return event.require(key).map_err((error) => error.message())?.expect_str().map_err((error) => error.message())


def body_value(
    values: Dict[str, LoweringBody],
    fallbacks: list[CompiledBodyFallback],
    identity: str,
) -> Result[LoweringBody, str]:
    """Authenticate one lowering event against graph-eligible Body IR, retaining an exact checker fallback reason."""
    if identity in values:
        return Ok(values[identity])
    available = sorted([symbol for symbol in values.keys()])
    reasons = "; ".join(fallback_reasons(fallbacks))
    return Err(
        f"lowering output owner {identity} is absent from graph-eligible Body IR: {available}; checker-record fallbacks: {reasons}",
    )


def source_projection(unit: UnitDescription, origin: str, module: str) -> Result[SourceProjection, str]:
    """Recreate one already-published projection to select its logical owner and header keys."""
    path = Path(unit.project_root).joinpath(module)
    source = path.read_text("utf-8", "strict").map_err((error) => error.message())?
    return project_source(origin, module, source)


pub def retained_owner_record(projection: SourceProjection, name: str) -> Result[Option[SourceProjectionRecord], str]:
    """Skip only an absent retained owner while propagating every malformed owner-selection state."""
    match owner_record(projection, name):
        Ok(value) => return Ok(Some(value))
        Err(OwnerRecordFault.Absent) => return Ok(None)
        Err(OwnerRecordFault.Ambiguous) => return Err(owner_record_message(OwnerRecordFault.Ambiguous, name))


def owner_record(projection: SourceProjection, name: str) -> Result[SourceProjectionRecord, OwnerRecordFault]:
    """Select exactly one compiled owner's source record across callable and kind-qualified declaration facets."""
    mut selected: Option[SourceProjectionRecord] = None
    for owner in projection.owners:
        if owner.key.facet == name or owner.key.facet.endswith(":" + name):
            match selected:
                Some(_) => return Err(OwnerRecordFault.Ambiguous)
                None => selected = Some(owner)
    match selected:
        Some(owner) => return Ok(owner)
        None => return Err(OwnerRecordFault.Absent)


def owner_record_message(error: OwnerRecordFault, name: str) -> str:
    """Render one closed owner-selection refusal at the surrounding string-error boundary."""
    match error:
        OwnerRecordFault.Absent => return "compiled body output has no matching owner source: " + name
        OwnerRecordFault.Ambiguous => return "compiled body output has multiple matching owner sources: " + name


pub def dependency_owner(
    projection: SourceProjection,
    module: str,
    name: str,
    identity: str,
) -> Result[SourceProjectionRecord, str]:
    """Select one dependency declaration through the stable identity emitted by its checked consumer."""
    return compiled_owner_source(projection, module, name, identity)


def dependency_owner_record(
    unit: UnitDescription,
    package: str,
    module: str,
    name: str,
    identity: str,
) -> Result[SourceProjectionRecord, str]:
    """Read one compiler-witnessed editable dependency owner from its described logical module root and identity."""
    mut root = ""
    for dependency in dependency_source_roots(unit):
        if dependency[0] == package:
            root = dependency[1]
    if root == "":
        return Err("compiled body output names an unselected editable dependency: " + package)
    base = Path(root).joinpath(module)
    mut candidates = [Path(base.0 + ".incn"), base.joinpath("mod.incn"), base.joinpath("__init__.incn")]
    if "/" in module:
        candidates.append(base.joinpath("prelude.incn"))
    for candidate in candidates:
        if candidate.is_file():
            source = candidate.read_text("utf-8", "strict").map_err((error) => error.message())?
            return dependency_owner(project_source(package, module, source)?, module, name, identity)
    return Err(f"compiled body output dependency module is absent: {package}:{module}")


def module_declarations(values: list[CompiledBodyValue], origin: str) -> Result[Dict[str, list[RecordKey]], str]:
    """Index each cold-checked module's complete immutable declaration environment once."""
    mut declarations: Dict[str, list[RecordKey]] = {}
    for value in values:
        if value.module not in declarations:
            declarations[value.module] = []
        declarations[value.module].append(
            body_key("declaration", origin, value.identity, value.name, root(value.declaration)?),
        )
    return Ok(declarations)


def lowering_symbol(identity: str, body_ir: bytes) -> Result[str, str]:
    """Decode one fresh Body IR owner once and index its canonical lowering identity."""
    decoded = decode_owner(body_ir).map_err((error) => f"cannot decode graph-eligible Body IR owner: {error}")?
    if decoded.identity != identity:
        return Err("graph-eligible Body IR owner disagrees with its stable publication identity")
    match decoded.body.canonical:
        Some(canonical) => return Ok(encode_incan_symbol_identity(canonical))
        None => return Ok("")


def dependency_read_key(
    unit: UnitDescription,
    origin: str,
    dependency: CompiledBodyDependencyRead,
    editable_packages: list[str],
) -> Result[Option[RecordKey], str]:
    """Select the producer declaration for a project read or the existing editable-package source witness."""
    match dependency.package:
        Some(package) =>
            if package in editable_packages:
                return Ok(
                    Some(
                        signature_record(
                            dependency_owner_record(
                                unit,
                                package,
                                dependency.module,
                                dependency.name,
                                dependency.identity,
                            )?,
                        ).key,
                    ),
                )
            return Ok(None)
        None => return Ok(Some(project_declaration_slot(origin, dependency.module, dependency.name)))


def dependency_projection_refusal(
    error: str,
    owner_module: str,
    owner_name: str,
    owner_identity: str,
    dependency: CompiledBodyDependencyRead,
) -> str:
    """Attach the producing body owner and checked reference subject to one dependency source refusal."""
    return (error + f"; body_owner={owner_module}:{owner_name}; body_identity={owner_identity}" + f"; reference_subject={dependency.reference_subject}")


def project_signature_record(
    unit: UnitDescription,
    origin: str,
    module: str,
    name: str,
    identity: str,
) -> Result[SourceProjectionRecord, str]:
    """Bind a checked project callee to its body-independent source header under its stable identity."""
    projection = source_projection(unit, origin, project_dependency_module(unit, module)?)?
    return Ok(signature_record(dependency_owner(projection, module, name, identity)?))


def dependency_signature_key(
    unit: UnitDescription,
    origin: str,
    dependency: CompiledBodyDependencyRead,
    editable_packages: list[str],
) -> Result[Option[RecordKey], str]:
    """Expose each editable callee's signature as a direct checker and lowering invalidation dependency."""
    match dependency.package:
        None =>
            return Ok(
                Some(
                    project_signature_record(unit, origin, dependency.module, dependency.name, dependency.identity)?.key,
                ),
            )
        Some(_) => return Ok(None)


def dependency_invalidation_key(
    unit: UnitDescription,
    origin: str,
    dependency: CompiledBodyDependencyRead,
) -> Result[Option[RecordKey], str]:
    """Select the captured project declaration surface that makes signature and removal edits visible before checking."""
    if dependency.package is not None:
        return Ok(None)
    return Ok(Some(declaration_index_key(origin, project_dependency_module(unit, dependency.module)?)))


def project_dependency_module(unit: UnitDescription, module: str) -> Result[str, str]:
    """Resolve a checked project module identity to the captured source path used by source projection."""
    base = Path(unit.source_root).joinpath(module)
    mut candidates = [Path(base.0 + ".incn"), base.joinpath("mod.incn"), base.joinpath("__init__.incn")]
    if "/" in module:
        candidates.append(base.joinpath("prelude.incn"))
    # Candidates resolve through symlinks (macOS `/var` is `/private/var`), so the root they're compared with must too.
    root = Path(unit.project_root).resolve().map_err((error) => f"cannot resolve project root {error.message()}")?
    prefix = root.0 + "/"
    for candidate in candidates:
        match candidate.resolve():
            Ok(resolved) =>
                if resolved.0.startswith(prefix) and candidate.is_file():
                    return Ok(resolved.0[len(prefix):])
            Err(_) => pass
    # A standalone program's checked root module is `lib` even when its authoritative described source has another
    # file name (for example `main.incn`). Consult that exact unit source only after ordinary module candidates miss.
    if module == "lib":
        source = Path(unit.source)
        match source.resolve():
            Ok(resolved) =>
                if resolved.0.startswith(prefix) and source.is_file():
                    return Ok(resolved.0[len(prefix):])
            Err(_) => pass
    return Err("compiled body output dependency module is absent: project:" + module)


def project_declaration_slot(origin: str, module: str, name: str) -> RecordKey:
    """Name one project declaration slot whose value is the producer's checked stable identity."""
    return RecordKey(
        family="declaration-slot",
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=module,
        facet=name,
        context="checked-signature",
    )


def body_key(family: str, origin: str, identity: str, facet: str, context: str) -> RecordKey:
    """Name one canonical checker value under its stable owner and semantic root."""
    return RecordKey(
        family=family,
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=identity,
        facet=facet,
        context=context,
    )


def namespace_key(origin: str, module: str) -> RecordKey:
    """Name one composite editable namespace under its logical source projection."""
    return RecordKey(
        family="namespace",
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=module,
        facet="checked",
        context="interface-body-ir-plan",
    )


def eligibility_key(origin: str, identity: str, name: str) -> RecordKey:
    """Name the explicit record-fast-path decision for one successfully checked owner."""
    return RecordKey(
        family="eligibility",
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=identity,
        facet=name,
        context="checker-record",
    )


pub def source_origin(unit: UnitDescription) -> str:
    """Use the package authority, or isolate one manifest-free entry by its exact source path."""
    if unit.package != "":
        return unit.package
    return "standalone:" + unit.source


def root(encoded: bytes) -> Result[str, str]:
    """Map codec faults at the engine boundary without weakening checker-record validation."""
    return record_root(encoded).map_err((error) => f"compiled checker root refused: {error:?}")


def request(key: RecordKey) -> RecordRequest:
    """Read complete scalar facts while binding opaque Body IR through a bounded semantic witness."""
    if key.family == "body-ir":
        selected = PayloadSelection(reference=key.context, offset=0, length=0)
        return RecordRequest(key=key, selection=RecordSelection.Payload(selected))
    return RecordRequest(key=key, selection=RecordSelection.Field("value"))


def prepared_receipt(
    source: PreparedBodyRecordSource,
    scope: ReadScope,
    output: RecordKey,
    requests: list[RecordRequest],
) -> Result[ReadReceipt, str]:
    """Authenticate one producer's exact inputs from the caller-owned publication transaction."""
    preparation = PreparationEvidence(
        output=output,
        rank_certificate="compiled-check",
        selector_witnesses="compiled-check",
    )
    mut reads = RecordReads.start(scope, preparation, requests)
    for item in requests:
        match reads.read(source, item):
            RecordRead.Failed(fault) =>
                return Err(
                    f"compiled body publication for {encode_record_key(output)?} could not read " + f"{encode_record_key(
                        item.key,
                    )?}: {fault:?}",
                )
            _ => pass
    return reads.finish().map_err((_) => "compiled body publication produced an incomplete receipt")
