"""Publish successful compiler body outputs into the ranked record graph."""

from std.fs import Path
from std.encoding.hex import hexlify
from std.primitives.hash import sha256
from pub::incan_platform.store import Snapshot, Transaction, begin, commit, get, put
from pub::internal_models import (
    CompiledBodyDependencyRead,
    CompiledBodyValue,
    ProducerRank,
    ProducerStage,
    decode_compiled_body_outputs,
    record_root,
)
from pub::internal_models.checker_records import CHECKER_PROFILE
from pub::internal_models.records import (
    PreparationEvidence,
    ReadReceipt,
    ReadFault,
    ReadScope,
    RevisionEvidence,
    SelectedFact,
    RecordRead,
    RecordSource,
    RecordKey,
    RecordReads,
    RecordRequest,
    RecordSelection,
    encode_record_key,
)
from compiler_graph_records import prepare_evaluation
from compiler_source_projection import (
    SourceProjection,
    SourceProjectionRecord,
    declaration_index_key,
    owner_source_key,
    project_source,
)
from engine_capture import CapturedInput, InputRole
from files import discard_file
from unit import UnitDescription, dependency_source_roots

const IDENTITY_PROFILE: str = "incan.stable-declaration/1"


pub model PublishedCompiledBodies:
    """The graph generation and eligible/fallback body counts published from one successful whole check."""

    pub snapshot: Snapshot
    pub bodies: int
    pub fallbacks: int


pub model PreparedCompiledBodies:
    """Body records staged beside a native request's other outputs without publishing another generation."""

    pub transaction: Transaction
    pub bodies: int
    pub fallbacks: int


class PreparedBodyRecordSource with RecordSource:
    """Authenticate reads from the exact values staged by one compiled-body publication transaction."""

    scope: ReadScope
    values: Dict[str, bytes] = {}

    @staticmethod
    pub def open(scope: ReadScope) -> PreparedBodyRecordSource:
        """Create an empty source bound to one compiler profile and publication preparation."""
        return PreparedBodyRecordSource(scope=scope)

    pub def add(mut self, key: str, value: bytes) -> None:
        """Make one exact pending value available to later producers in the same transaction."""
        self.values[key] = value

    def read(self, scope: ReadScope, request: RecordRequest) -> RecordRead:
        """Return one staged field with content evidence, or fail when publication order left it unavailable."""
        if scope != self.scope:
            return RecordRead.Failed(ReadFault.SnapshotMismatch)
        key = match encode_record_key(request.key):
            Ok(value) => value
            Err(_) => return RecordRead.Failed(ReadFault.InvalidEvidence)

        if key not in self.values:
            return RecordRead.Failed(ReadFault.UnfinishedSupplier)
        value = self.values[key]
        semantic = hexlify(sha256.digest(value))
        evidence = RevisionEvidence(scope=scope, request=request, revision=semantic, semantic_digest=semantic)
        return RecordRead.Found(SelectedFact(evidence=evidence, value=value, selection_digest=semantic))


pub model PublishedSourceInputs:
    """The graph generation and logical keys rewritten by captured source projection."""

    pub snapshot: Snapshot
    pub keys: list[RecordKey]


pub model PreparedSourceInputs:
    """Captured source projections staged for one atomic native request and the keys whose values changed."""

    pub transaction: Transaction
    pub keys: list[RecordKey]


pub def publish_captured_source_inputs(
    selected: Snapshot,
    unit: UnitDescription,
    inputs: list[CapturedInput],
) -> Result[PublishedSourceInputs, str]:
    """Publish captured Incan source projections in one standalone transaction."""
    prepared = prepare_captured_source_inputs(selected, begin(selected), unit, inputs)?
    published = commit(prepared.transaction).map_err((error) => error.message())?
    return Ok(PublishedSourceInputs(snapshot=published, keys=prepared.keys))


pub def prepare_captured_source_inputs(
    selected: Snapshot,
    transaction: Transaction,
    unit: UnitDescription,
    inputs: list[CapturedInput],
) -> Result[PreparedSourceInputs, str]:
    """Stage captured source projections and report only keys whose semantic values differ from the selected view."""
    mut prepared = transaction
    mut changed: list[RecordKey] = []
    for input in inputs:
        if input.path.endswith(".incn") and input.role in [InputRole.Root, InputRole.Member, InputRole.Resolved]:
            match captured_source_identity(unit, input.path):
                None => continue
                Some(identity) =>
                    source = Path(input.path).read_text("utf-8", "strict").map_err((error) => error.message())?
                    projection = project_source(identity[0], identity[1], source)?
                    header_key = encode_record_key(projection.header.key)?
                    header_value = projection.header.text.encode("utf-8")
                    if get(selected, header_key).map_err((error) => error.message())? != Some(header_value):
                        changed.append(projection.header.key)
                    prepared = put(prepared, header_key, header_value)
                    declaration_key = encode_record_key(projection.declarations.key)?
                    declaration_value = projection.declarations.text.encode("utf-8")
                    if get(selected, declaration_key).map_err((error) => error.message())? != Some(declaration_value):
                        changed.append(projection.declarations.key)
                    prepared = put(prepared, declaration_key, declaration_value)
                    for owner in projection.owners:
                        owner_key = encode_record_key(owner.key)?
                        owner_value = owner.text.encode("utf-8")
                        if get(selected, owner_key).map_err((error) => error.message())? != Some(owner_value):
                            changed.append(owner.key)
                        prepared = put(prepared, owner_key, owner_value)
    return Ok(PreparedSourceInputs(transaction=prepared, keys=changed))


def captured_source_identity(unit: UnitDescription, path: str) -> Option[Tuple[str, str]]:
    """Map one captured source to its package-owned logical module identity without retaining checkout location."""
    mut normalized = ""
    match Path(path).resolve():
        Err(_) => return None
        Ok(resolved) => normalized = resolved.0
    for dependency in dependency_source_roots(unit):
        prefix = dependency[1] + "/"
        if normalized.startswith(prefix):
            return Some((dependency[0], logical_module(normalized[len(prefix):])))
    prefix = unit.project_root + "/"
    if normalized.startswith(prefix):
        return Some((source_origin(unit), normalized[len(prefix):]))
    return None


def logical_module(relative: str) -> str:
    """Canonicalize an editable dependency source path the same way source-module resolution names its module."""
    mut without_extension = relative
    if without_extension.endswith(".incn"):
        without_extension = without_extension[:len(without_extension) - len(".incn")]
    mut parts = without_extension.split("/")
    if len(parts) > 0 and parts[len(parts) - 1] in ["mod", "__init__"]:
        parts = parts[:len(parts) - 1]
    elif len(parts) > 1 and parts[len(parts) - 1] == "prelude":
        parts = parts[:len(parts) - 1]
    return "/".join(parts)


pub def publish_compiled_bodies(
    selected: Snapshot,
    unit: UnitDescription,
    output: Path,
) -> Result[PublishedCompiledBodies, str]:
    """Publish one successful compiler sidecar in a standalone atomic transaction."""
    prepared = prepare_compiled_bodies(begin(selected), unit, output)?
    published = commit(prepared.transaction).map_err((error) => error.message())?
    return Ok(PublishedCompiledBodies(snapshot=published, bodies=prepared.bodies, fallbacks=prepared.fallbacks))


pub def prepare_compiled_bodies(
    transaction: Transaction,
    unit: UnitDescription,
    output: Path,
) -> Result[PreparedCompiledBodies, str]:
    """
    Stage one successful compiler sidecar through source projections and witnessed checker evaluations.

    1. Authenticate the bounded sidecar through the shared checker codec.
    2. Stage each source projection and declaration value before any body receipt reads them.
    3. Stage local, final and Body IR evaluations in the caller's request transaction.
    """
    # 1. The sidecar is invocation output, not an authority until this graph publication succeeds.
    if not output.is_file():
        return Err("successful graph-enabled compile did not publish body outputs")
    encoded = output.read_bytes().map_err((error) => error.message())?
    discard_file(output)
    outputs = decode_compiled_body_outputs(encoded).map_err((error) => f"compiled body output refused: {error:?}")?
    origin = source_origin(unit)

    # 2. The prepared source authenticates only values carried by this exact request transaction.
    scope = ReadScope(snapshot=transaction.id, profile=CHECKER_PROFILE)
    mut source = PreparedBodyRecordSource.open(scope)
    mut prepared = transaction
    mut modules: list[str] = []
    for value in outputs.values:
        if value.module not in modules:
            projection = source_projection(unit, origin, value.module)?
            header_key = encode_record_key(projection.header.key)?
            header_value = projection.header.text.encode("utf-8")
            prepared = put(prepared, header_key, header_value)
            source.add(header_key, header_value)
            declaration_key = encode_record_key(projection.declarations.key)?
            declaration_value = projection.declarations.text.encode("utf-8")
            prepared = put(prepared, declaration_key, declaration_value)
            source.add(declaration_key, declaration_value)
            for owner in projection.owners:
                owner_key = encode_record_key(owner.key)?
                owner_value = owner.text.encode("utf-8")
                prepared = put(prepared, owner_key, owner_value)
                source.add(owner_key, owner_value)
            modules.append(value.module)
    for fallback in outputs.fallbacks:
        if fallback.module not in modules:
            projection = source_projection(unit, origin, fallback.module)?
            header_key = encode_record_key(projection.header.key)?
            header_value = projection.header.text.encode("utf-8")
            prepared = put(prepared, header_key, header_value)
            source.add(header_key, header_value)
            declaration_key = encode_record_key(projection.declarations.key)?
            declaration_value = projection.declarations.text.encode("utf-8")
            prepared = put(prepared, declaration_key, declaration_value)
            source.add(declaration_key, declaration_value)
            for owner in projection.owners:
                owner_key = encode_record_key(owner.key)?
                owner_value = owner.text.encode("utf-8")
                prepared = put(prepared, owner_key, owner_value)
                source.add(owner_key, owner_value)
            modules.append(fallback.module)
    editable_packages = [dependency[0] for dependency in dependency_source_roots(unit)]
    for value in outputs.values:
        for dependency in value.dependency_reads:
            match dependency.package:
                Some(package) =>
                    if package in editable_packages:
                        owner = dependency_owner_record(unit, package, dependency.module, dependency.name)?
                        source.add(encode_record_key(owner.key)?, owner.text.encode("utf-8"))
                None =>
                    slot = project_declaration_slot(origin, dependency.module, dependency.name)
                    slot_value = dependency.identity.encode("utf-8")
                    prepared = put(prepared, encode_record_key(slot)?, slot_value)
                    source.add(encode_record_key(slot)?, slot_value)
                    dependency_module = project_dependency_module(unit, dependency.module)?
                    dependency_projection = source_projection(unit, origin, dependency_module)?
                    declaration_key = encode_record_key(dependency_projection.declarations.key)?
                    declaration_value = dependency_projection.declarations.text.encode("utf-8")
                    prepared = put(prepared, declaration_key, declaration_value)
                    source.add(declaration_key, declaration_value)
    for value in outputs.values:
        declaration_key = encode_record_key(
            body_key("declaration", origin, value.identity, value.name, root(value.declaration)?),
        )?
        prepared = put(prepared, declaration_key, value.declaration)
        source.add(declaration_key, value.declaration)
        prepared = put(
            prepared,
            encode_record_key(eligibility_key(origin, value.identity, value.name))?,
            b"record-eligible",
        )
    for fallback in outputs.fallbacks:
        match fallback.identity:
            Some(identity) =>
                prepared = put(
                    prepared,
                    encode_record_key(eligibility_key(origin, identity, fallback.name))?,
                    ("full-source: " + fallback.reason).encode("utf-8"),
                )
            None => pass

    # 3. A cold whole check stages the same graph values later edited activations replace independently.
    mut published = 0
    for value in outputs.values:
        projection = source_projection(unit, origin, value.module)?
        owner = owner_record(projection, value.name)?
        declarations = module_declarations(outputs.values, origin, value.module)?
        local_key = body_key("local", origin, value.identity, "checked", root(value.local)?)
        mut local_reads = [request(owner.key), request(projection.header.key)]
        for declaration in declarations:
            local_reads.append(request(declaration))
        for dependency in value.dependency_reads:
            match dependency_read_key(origin, dependency, editable_packages):
                Some(key) => local_reads.append(request(key))
                None => pass
            match dependency_invalidation_key(unit, origin, dependency)?:
                Some(key) => local_reads.append(request(key))
                None => pass
        local_receipt = prepared_receipt(source, scope, local_key, local_reads)?
        local = prepare_evaluation(
            prepared,
            "compiled-local-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0),
            value.local,
            local_receipt,
        )?
        prepared = local.transaction
        source.add(encode_record_key(local_key)?, value.local)
        final_key = body_key("final", origin, value.identity, "checked", root(value.final)?)
        mut final_reads = [request(owner.key), request(projection.header.key), request(local_key)]
        for declaration in declarations:
            final_reads.append(request(declaration))
        for dependency in value.dependency_reads:
            match dependency_read_key(origin, dependency, editable_packages):
                Some(key) => final_reads.append(request(key))
                None => pass
            match dependency_invalidation_key(unit, origin, dependency)?:
                Some(key) => final_reads.append(request(key))
                None => pass
        final_receipt = prepared_receipt(source, scope, final_key, final_reads)?
        final = prepare_evaluation(
            prepared,
            "compiled-final-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=1),
            value.final,
            final_receipt,
        )?
        prepared = final.transaction
        source.add(encode_record_key(final_key)?, value.final)
        body_ir_key = body_key("body-ir", origin, value.identity, "checked", root(value.final)?)
        body_ir_receipt = prepared_receipt(source, scope, body_ir_key, [request(final_key)])?
        body_ir = prepare_evaluation(
            prepared,
            "compiled-body-ir-" + value.identity,
            ProducerRank(namespace=0, stage=ProducerStage.BodyIr, dependency=0),
            value.body_ir,
            body_ir_receipt,
        )?
        prepared = body_ir.transaction
        published += 1
    return Ok(PreparedCompiledBodies(transaction=prepared, bodies=published, fallbacks=len(outputs.fallbacks)))


def source_projection(unit: UnitDescription, origin: str, module: str) -> Result[SourceProjection, str]:
    """Recreate one already-published projection to select its logical owner and header keys."""
    path = Path(unit.project_root).joinpath(module)
    source = path.read_text("utf-8", "strict").map_err((error) => error.message())?
    return project_source(origin, module, source)


def owner_record(projection: SourceProjection, name: str) -> Result[SourceProjectionRecord, str]:
    """Select one compiled owner's source record across callable and kind-qualified declaration facets."""
    for owner in projection.owners:
        if owner.key.facet == name or owner.key.facet.endswith(":" + name):
            return Ok(owner)
    return Err("compiled body output has no matching owner source: " + name)


def dependency_owner_record(
    unit: UnitDescription,
    package: str,
    module: str,
    name: str,
) -> Result[SourceProjectionRecord, str]:
    """Read one compiler-witnessed editable dependency owner from its described logical module root."""
    mut root = ""
    for dependency in dependency_source_roots(unit):
        if dependency[0] == package:
            root = dependency[1]
    if root == "":
        return Err("compiled body output names an unselected editable dependency: " + package)
    base = Path(root).joinpath(module)
    mut candidates = [Path(base.0 + ".incn"), base.joinpath("mod.incn"), base.joinpath("__init__.incn")]
    if "/" in module:
        candidates.append(base.joinpath("prelude.incn"))
    for candidate in candidates:
        if candidate.is_file():
            source = candidate.read_text("utf-8", "strict").map_err((error) => error.message())?
            return owner_record(project_source(package, module, source)?, name)
    return Err(f"compiled body output dependency module is absent: {package}:{module}")


def module_declarations(values: list[CompiledBodyValue], origin: str, module: str) -> Result[list[RecordKey], str]:
    """Name the complete immutable declaration environment available to one cold-checked module."""
    mut declarations: list[RecordKey] = []
    for value in values:
        if value.module == module:
            declarations.append(body_key("declaration", origin, value.identity, value.name, root(value.declaration)?))
    return Ok(declarations)


def dependency_read_key(
    origin: str,
    dependency: CompiledBodyDependencyRead,
    editable_packages: list[str],
) -> Option[RecordKey]:
    """Select the producer declaration for a project read or the existing editable-package source witness."""
    match dependency.package:
        Some(package) =>
            if package in editable_packages:
                return Some(owner_source_key(package, dependency.module, dependency.name))
            return None
        None => return Some(project_declaration_slot(origin, dependency.module, dependency.name))


def dependency_invalidation_key(
    unit: UnitDescription,
    origin: str,
    dependency: CompiledBodyDependencyRead,
) -> Result[Option[RecordKey], str]:
    """Select the captured project declaration surface that makes signature and removal edits visible before checking."""
    if dependency.package is not None:
        return Ok(None)
    return Ok(Some(declaration_index_key(origin, project_dependency_module(unit, dependency.module)?)))


def project_dependency_module(unit: UnitDescription, module: str) -> Result[str, str]:
    """Resolve a checked project module identity to the captured source path used by source projection."""
    base = Path(unit.source_root).joinpath(module)
    mut candidates = [Path(base.0 + ".incn"), base.joinpath("mod.incn"), base.joinpath("__init__.incn")]
    if "/" in module:
        candidates.append(base.joinpath("prelude.incn"))
    # Candidates resolve through symlinks (macOS `/var` is `/private/var`), so the root they're compared with must too.
    root = Path(unit.project_root).resolve().map_err((error) => f"cannot resolve project root {error.message()}")?
    prefix = root.0 + "/"
    for candidate in candidates:
        match candidate.resolve():
            Ok(resolved) =>
                if resolved.0.startswith(prefix) and candidate.is_file():
                    return Ok(resolved.0[len(prefix):])
            Err(_) => pass
    return Err("compiled body output dependency module is absent: project:" + module)


def project_declaration_slot(origin: str, module: str, name: str) -> RecordKey:
    """Name one project declaration slot whose value is the producer's checked stable identity."""
    return RecordKey(
        family="declaration-slot",
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=module,
        facet=name,
        context="checked-signature",
    )


def body_key(family: str, origin: str, identity: str, facet: str, context: str) -> RecordKey:
    """Name one canonical checker value under its stable owner and semantic root."""
    return RecordKey(
        family=family,
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=identity,
        facet=facet,
        context=context,
    )


def eligibility_key(origin: str, identity: str, name: str) -> RecordKey:
    """Name the explicit record-fast-path decision for one successfully checked owner."""
    return RecordKey(
        family="eligibility",
        identity_profile=IDENTITY_PROFILE,
        origin=origin,
        identity=identity,
        facet=name,
        context="checker-record",
    )


def source_origin(unit: UnitDescription) -> str:
    """Use the package authority, or the standalone namespace whose view already isolates manifest-free sources."""
    if unit.package != "":
        return unit.package
    return "standalone"


def root(encoded: bytes) -> Result[str, str]:
    """Map codec faults at the engine boundary without weakening checker-record validation."""
    return record_root(encoded).map_err((error) => f"compiled checker root refused: {error:?}")


def request(key: RecordKey) -> RecordRequest:
    """Read one complete logical checker or source-projection value."""
    return RecordRequest(key=key, selection=RecordSelection.Field("value"))


def prepared_receipt(
    source: PreparedBodyRecordSource,
    scope: ReadScope,
    output: RecordKey,
    requests: list[RecordRequest],
) -> Result[ReadReceipt, str]:
    """Authenticate one producer's exact inputs from the caller-owned publication transaction."""
    preparation = PreparationEvidence(
        output=output,
        rank_certificate="compiled-check",
        selector_witnesses="compiled-check",
    )
    mut reads = RecordReads.start(scope, preparation, requests)
    for item in requests:
        match reads.read(source, item):
            RecordRead.Failed(fault) =>
                return Err(f"compiled body publication could not read {encode_record_key(item.key)?}: {fault:?}")
            _ => pass
    return reads.finish().map_err((_) => "compiled body publication produced an incomplete receipt")
