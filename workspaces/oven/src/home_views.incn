"""
Each home's own view of the physical bakery it uses (BE-01, `incan.store-view/1`).

A home finds its bakery through `<home>/bakery.view`: the store's identity, its locator and the home's view key. The
key is drawn once, when the home first binds the bakery, and the descriptor is configuration for finding the store,
not a second database: copying or moving it never forks a view.
"""

from std.encoding.hex import hexlify
from std.fs import Path
from home_paths import BAKERY_OVERRIDE, BakeryLocation, bakery_location, home
from publication import publish_binary
from store_selection_records import encode_binding
from pub::incan_platform.ipc import session_id
from pub::incan_platform.store import begin, commit, put, read_store_identity, snapshot as placed_snapshot
from pub::incan_platform.store import store_identity
from pub::incan_worker_host.record_snapshot import StoreView, encode_store_binding, portable_store_view, select_store_view
from store_path_conversion import claim, store_path

# A home's view key: this prefix and 128 bits of OS entropy, drawn once when the home first binds a bakery.
const HOME_VIEW_PREFIX: str = "home-"
# The record that makes a new home view's root durable before its descriptor is published.
const HOME_VIEW_RECORD: str = "incan.home-view"


pub def selected_home_view() -> Result[Option[str], str]:
    """This invocation's home view, bound when the home builds for the first time."""
    return bind_home_view(home()?, bakery_location()?)


pub def bind_home_view(home: Path, location: BakeryLocation) -> Result[Option[str], str]:
    """
    The home's own view of the bakery its configuration selects. A bakery that `INCAN_BAKERY` selects serves one
    invocation: it binds no view, and the home's descriptor never names it.
    """
    if location.source == BAKERY_OVERRIDE:
        return Ok(None)
    store = location.path.absolute().map_err((error) => f"cannot {error.message()}")?
    root = store_path(store)
    mut identity = ""
    match read_store_identity(root):
        Ok(found) => identity = found
        Err(_) => identity = store_identity(root).map_err((error) => error.message())?
    return Ok(Some(home_view(home, store, identity)?))


pub def home_view(home: Path, store: Path, identity: str) -> Result[str, str]:
    """
    The home's own view of the physical bakery `store`, created when the home first binds it.

    1. A descriptor naming this store keeps its view, even after the store moved: copying or moving a descriptor
       never forks a view. A descriptor naming another store is refused, never silently replaced.
    2. Otherwise, under the home's claim, a new view key is drawn and its root made durable; only then is the
       descriptor published.
    """
    descriptor = home.joinpath("bakery.view")
    # 1. An existing binding answers without a claim.
    if let Some(view) = bound_view(descriptor, store, identity)?:
        return Ok(view)
    # 2. One process creates the view; a racing one finds the descriptor the winner published.
    _held = claim(store, f"{HOME_VIEW_RECORD}\t{home.0}").map_err((error) => error.message())?
    if let Some(view) = bound_view(descriptor, store, identity)?:
        return Ok(view)
    view = HOME_VIEW_PREFIX + hexlify(session_id()?)
    created = placed_snapshot(store_path(store), view).map_err((error) => error.message())?
    _ = commit(put(begin(created), HOME_VIEW_RECORD, encode_binding(HOME_VIEW_RECORD, view)?)).map_err((error) => error.message())?
    publish_binding(descriptor, StoreView(store_id=identity, locator=store.0, home_view=view))?
    return Ok(view)


def bound_view(descriptor: Path, store: Path, identity: str) -> Result[Option[str], str]:
    """
    The view a home's descriptor binds in this store, or none. A store found at another locator keeps its view, and
    the descriptor is republished with the new locator.
    """
    if not descriptor.is_file():
        return Ok(None)
    selected = select_store_view(descriptor.0)?
    bound = selected.binding
    if bound.store_id != identity:
        return Err(f"{descriptor.0} binds bakery {bound.store_id} at {bound.locator}, not {identity} at {store.0}")
    if bound.locator != store.0:
        rebound = StoreView(store_id=identity, locator=store.0, home_view=bound.home_view)
        publish_binding(descriptor, rebound)?
    elif selected.backfill:
        # Older homes and copied portable bindings remain usable when the home is mounted read-only.
        _ = publish_binary(Path(descriptor.0 + ".crumb"), encode_store_binding(bound)?)
    return Ok(Some(bound.home_view))


def publish_binding(path: Path, binding: StoreView) -> Result[None, str]:
    """Publish the private row before committing a portable binding so independently installed readers agree."""
    publish_binary(Path(path.0 + ".crumb"), encode_store_binding(binding)?)?
    return publish_binary(path, portable_store_view(binding)?)
