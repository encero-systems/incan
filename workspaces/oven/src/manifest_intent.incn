"""Parse a Loaf manifest into its declared intent: the project, features, dependencies, facets and requests."""

# Explicit payload import until foreign None type qualification is fixed (#2010).
from std.toml import TomlLocation
from std import toml
from std.toml import TomlValue, TomlKind
from std.hash import sha256
from rust::std::str import from_utf8
from manifest_errors import IntakeError, IntakeErrorKind
from loaf_identity import crate_name, validate_loaf_identity, validate_project_identity
from toolchain_access import BINARY_SEPARATOR, BUILD_SEPARATOR, ToolchainAccess, access_keys, read_access
from pub::incan_platform.trace import Operation
from jec import begin, record, text_size

# The manifest's tables.
const ROOT_TABLES: FrozenList[str] = [
    "project",
    "dependencies",
    # Retained only so intake can issue the table's migration-specific refusal.
    "rust-dependencies",
    "build",
    "rust",
    "vocab",
    "tool",
    "interop",
    "envs",
]
# The keys of `[project]`.
const PROJECT_KEYS: FrozenList[str] = [
    "name",
    "version",
    "scripts",
    "features",
    "description",
    "authors",
    "license",
    "license-files",
    "readme",
    "requires-incan",
    "private",
]


pub model ManifestEvidence:
    """Physical source evidence, excluded from effective intent and unit identity."""

    pub path: str
    pub raw_bytes: bytes
    pub source: str
    pub sha256_digest: bytes


@derive(Eq)
pub model LocalDependency:
    """An authored alias and relative path; neither is a resolved symbol name."""

    pub alias: str
    pub path: str
    # Whether the edge stays inactive until a package feature selects `dep:<alias>`.
    pub optional: bool = false
    # Whether the edge selects the dependency's `default` feature.
    pub default_features: bool = true
    # The dependency's features the edge requests.
    pub features: list[str] = []
    # Whether the edge links a sibling Loaf's Rust crate (`loaf = "<name>"` beside `path`) rather than an Incan package.
    pub rust_facet: bool = false


@derive(Eq)
pub model RustInputRequest:
    """An unresolved Rust-facet Loaf requirement, before source or host/target unit admission."""

    pub alias: str
    pub package: str
    pub loaf: Option[str]
    pub version: str
    pub features: list[str]
    pub default_features: bool
    pub optional: bool
    pub target: Option[str]
    pub path: Option[str] = None


@derive(Eq)
pub model FeatureDeclaration:
    """One `[project.features]` entry, compact and expanded forms normalized into the same edges."""

    # Features of the same package the feature includes.
    pub includes: list[str] = []
    # Optional dependencies the feature activates (`dep:<alias>`).
    pub optional_dependencies: list[str] = []
    # Features the feature requests from an active dependency (`<alias>/<feature>`), by alias.
    pub dependency_features: Dict[str, list[str]] = {}


@derive(Eq)
pub model ProjectIntent:
    """Supported authored fields, independent of comments and source locations."""

    pub name: str
    pub version: str
    pub scripts: Dict[str, str]
    pub dependencies: list[LocalDependency]
    pub rust_inputs: list[RustInputRequest]
    pub rust_edition: str
    # The crate name of this project's Rust facet, explicit or derived from the Loaf identity.
    pub rust_name: str = ""
    # The Rust facet kind, empty when this project has no Rust facet.
    pub rust_type: str = ""
    # Whether the Rust facet declares build-time behavior. Intake admits `false`; `true` needs an exact bound fact.
    pub rust_build_script: bool = false
    # Fully normalized Rust-facet dependency slots for each root environment after production overrides are applied.
    pub environment_rust_inputs: Dict[str, list[RustInputRequest]] = {}
    # The declared package features by name.
    pub features: Dict[str, FeatureDeclaration] = {}
    # The source root `[build] source-root` names, project-relative, when it names one.
    pub source_root: Option[str] = None
    # The contract model bundles `[tool.incan.metadata] model-bundles` names, project-relative.
    pub contract_models: list[str] = []
    # The C headers the `[interop.c]` targets declare, project-relative.
    pub c_headers: list[str] = []
    # The Incan module registering this Loaf's vocabulary, project-relative.
    pub vocab_entry: Option[str] = None
    # The rustc-internal access `[build]` declares for the Loaf's Incan units.
    pub toolchain_access: ToolchainAccess = ToolchainAccess()


pub model ManifestSnapshot:
    """One exact source generation and its parsed document, before any view imposes its own validation policy."""

    pub evidence: ManifestEvidence
    pub parsed: TomlValue


pub def refusal(manifest: str, field: list[str], kind: IntakeErrorKind, detail: str) -> IntakeError:
    """Create an unlocated refusal before a source-bearing caller attaches its span."""
    return IntakeError(kind=kind, manifest=manifest, field=field, detail=detail, location=None)


pub def table(value: TomlValue, manifest: str, field: list[str]) -> Result[Dict[str, TomlValue], IntakeError]:
    """Require a TOML table while preserving the caller's literal field path."""
    return value.as_table().map_err((error) => refusal(manifest, field, IntakeErrorKind.Invalid, error.message()))


def text(value: TomlValue, manifest: str, field: list[str]) -> Result[str, IntakeError]:
    """Require a TOML string without coercing another value kind."""
    return value.as_str().map_err((error) => refusal(manifest, field, IntakeErrorKind.Invalid, error.message()))


def allowed(
    values: Dict[str, TomlValue],
    keys: list[str],
    manifest: str,
    field: list[str],
) -> Result[None, IntakeError]:
    """Reject the first unsupported literal key in deterministic order."""
    # TODO: sort the iterator directly once #1461 and #1464 are fixed. Sorting `values.keys()` emits an
    # unsortable Rust iterator, and a list of keys emits an undefined function, so the keys are materialized.
    for key in sorted([key for key in values.keys()]):
        if key not in keys:
            return Err(refusal(manifest, field + [key], IntakeErrorKind.Unsupported, "intent is outside local intake"))
    return Ok(None)


def required(values: Dict[str, TomlValue], key: str, manifest: str, field: list[str]) -> Result[str, IntakeError]:
    """Read a required nonempty string, distinguishing missing fields from invalid values."""
    if key not in values:
        return Err(refusal(manifest, field, IntakeErrorKind.Missing, f"required field {key}"))
    value = text(values[key], manifest, field)?
    if value == "":
        return Err(refusal(manifest, field, IntakeErrorKind.Invalid, "empty value"))
    return Ok(value)


pub def parse_intent(source: str, manifest: str) -> Result[ProjectIntent, IntakeError]:
    """Parse effective intent and retain source spans for literal diagnostic key paths."""
    clock = begin()
    result = parse_raw_intent(source, manifest).map_err((error) => error.with_source(source))
    record(Operation.ManifestParse, manifest, clock, text_size(source, clock))
    return result


pub model ManifestDocument:
    """One byte snapshot and its independently comparable normalized intent."""

    pub evidence: ManifestEvidence
    pub intent: ProjectIntent


pub def parse_document(raw: bytes, manifest: str) -> Result[ManifestDocument, IntakeError]:
    """
    Decode one immutable manifest snapshot and separate evidence from normalized intent.

        Raw bytes, their digest and the source location describe what was read. They do not become an action or unit
        identity. The normalized intent contains supported declarations only; unknown semantic fields refuse explicitly.

        Args:
            raw: Exact UTF-8 manifest bytes, including original comments and line endings.
            manifest: Diagnostic provenance path, not a selected package identity.

        Returns:
            The source evidence and normalized intent, or a structured decoding/schema refusal.

        Example:
            document = parse_document(b"[project]
    name='catalog'
    version='0.1.0'
    ", "loaf.toml")?
            assert document.intent.name == "catalog"
    """
    snapshot = decoded_manifest(raw, manifest)?
    intent = intent_from_snapshot(snapshot)?
    return Ok(ManifestDocument(intent=intent, evidence=snapshot.evidence))


pub def decoded_manifest(raw: bytes, manifest: str) -> Result[ManifestSnapshot, IntakeError]:
    """Parse and hash one immutable byte snapshot once, retaining provenance for every later view."""
    source = str(from_utf8(raw).map_err((error) => refusal(manifest, [], IntakeErrorKind.Invalid, str(error)))?)
    mut clock = begin()
    parsed = toml.parse(source)
    record(Operation.ManifestParse, manifest, clock, len(raw))
    document = parsed.map_err((error) => refusal(manifest, [], IntakeErrorKind.Invalid, error.message()))?
    clock = begin()
    digest = sha256.digest(raw)
    record(Operation.FileHash, manifest, clock, len(raw))
    evidence = ManifestEvidence(path=manifest, raw_bytes=raw, source=source, sha256_digest=digest)
    return Ok(ManifestSnapshot(evidence=evidence, parsed=document))


pub def intent_from_snapshot(snapshot: ManifestSnapshot) -> Result[ProjectIntent, IntakeError]:
    """Validate an already parsed source generation, attaching errors to the exact bytes that produced it."""
    return intent_from_document(snapshot.parsed, snapshot.evidence.path).map_err(
        (error) => error.with_source(snapshot.evidence.source),
    )


def parse_raw_intent(source: str, manifest: str) -> Result[ProjectIntent, IntakeError]:
    """Validate every supported table before projecting effective local intent."""
    parsed = toml.parse(source).map_err((error) => refusal(manifest, [], IntakeErrorKind.Invalid, error.message()))?
    return intent_from_document(parsed, manifest)


def intent_from_document(parsed: TomlValue, manifest: str) -> Result[ProjectIntent, IntakeError]:
    """Project effective intent from an existing parse without rereading or reinterpreting source bytes."""
    root = table(parsed, manifest, [])?
    if "sdk" in root:
        return Err(
            refusal(
                manifest,
                ["sdk"],
                IntakeErrorKind.Unsupported,
                "there is no SDK selection: standard packages are ambient, and a unit reaches every one it uses",
            ),
        )
    allowed(root, list(ROOT_TABLES), manifest, [])?
    if "project" not in root:
        return Err(refusal(manifest, ["project"], IntakeErrorKind.Missing, "project identity is required"))
    project = table(root["project"], manifest, ["project"])?
    allowed(project, list(PROJECT_KEYS), manifest, ["project"])?
    name = required(project, "name", manifest, ["project", "name"])?
    validate_project_identity(name).map_err(
        (error) => refusal(manifest, ["project", "name"], IntakeErrorKind.Invalid, error),
    )?
    version = required(project, "version", manifest, ["project", "version"])?
    mut scripts: Dict[str, str] = {}
    if "scripts" in project:
        values = table(project["scripts"], manifest, ["project", "scripts"])?
        for key in sorted([key for key in values.keys()]):
            scripts[key] = required(values, key, manifest, ["project", "scripts", key])?
    dependencies, rust_inputs = parse_dependencies(root, manifest)?
    features = parse_features(project, dependencies, manifest, rust_inputs)?
    validate_facets(root, manifest, name)?
    environment_rust_inputs = parse_environment_dependencies(root, rust_inputs, manifest)?
    mut edition = "2024"
    mut rust_name = crate_name(name)
    mut rust_type = ""
    mut rust_build_script = false
    mut source_root: Option[str] = None
    mut access = ToolchainAccess()
    if "build" in root:
        build = table(root["build"], manifest, ["build"])?
        keys = ["target", "profile", "rust-edition", "source-root"] + access_keys(BUILD_SEPARATOR)
        allowed(build, keys, manifest, ["build"])?
        access = read_access(build, BUILD_SEPARATOR, manifest, ["build"])?
        if "target" in build:
            required(build, "target", manifest, ["build", "target"])?
        if "profile" in build:
            required(build, "profile", manifest, ["build", "profile"])?
        if "rust-edition" in build:
            edition = required(build, "rust-edition", manifest, ["build", "rust-edition"])?
        if "source-root" in build:
            source_root = Some(required(build, "source-root", manifest, ["build", "source-root"])?)
    if "rust" in root:
        rust_facet = table(root["rust"], manifest, ["rust"])?
        if "name" in rust_facet:
            rust_name = required(rust_facet, "name", manifest, ["rust", "name"])?
        if "type" in rust_facet:
            rust_type = required(rust_facet, "type", manifest, ["rust", "type"])?
        rust_build_script = flag(rust_facet, "build-script", false, manifest, ["rust"])?
        if "edition" in rust_facet:
            edition = required(rust_facet, "edition", manifest, ["rust", "edition"])?
    return Ok(
        ProjectIntent(
            name=name,
            version=version,
            scripts=scripts,
            dependencies=dependencies,
            rust_inputs=rust_inputs,
            rust_edition=edition,
            rust_name=rust_name,
            rust_type=rust_type,
            rust_build_script=rust_build_script,
            environment_rust_inputs=environment_rust_inputs,
            features=features,
            source_root=source_root,
            contract_models=parse_contract_models(root, manifest)?,
            c_headers=parse_c_headers(root, manifest)?,
            vocab_entry=parse_vocab_entry(root, manifest)?,
            toolchain_access=access,
        ),
    )


def validate_environments(root: Dict[str, TomlValue], manifest: str) -> Result[None, IntakeError]:
    """Admit inactive environment tables without treating their partial dependency overrides as production edges."""
    if "envs" not in root:
        return Ok(None)
    environments = table(root["envs"], manifest, ["envs"])?
    for name in sorted([name for name in environments.keys()]):
        environment = table(environments[name], manifest, ["envs", name])?
        if "rust-dependencies" in environment:
            entries = table(environment["rust-dependencies"], manifest, ["envs", name, "rust-dependencies"])?
            alias = first_key(entries)
            replacement = dependency_replacement(
                alias,
                entries[alias],
                manifest,
                ["envs", name, "rust-dependencies", alias],
            )?
            detail = f"use [envs.{name}.dependencies] {replacement}"
            return Err(
                refusal(manifest, ["envs", name, "rust-dependencies"], IntakeErrorKind.Unsupported, detail),
            )
        allowed(environment, ["dependencies"], manifest, ["envs", name])?
        for group in sorted([group for group in environment.keys()]):
            table(environment[group], manifest, ["envs", name, group])?
    return Ok(None)


def parse_environment_dependencies(
    root: Dict[str, TomlValue],
    production: list[RustInputRequest],
    manifest: str,
) -> Result[Dict[str, list[RustInputRequest]], IntakeError]:
    """Normalize each root environment's partial dependency overlay against the admitted production graph."""
    validate_environments(root, manifest)?
    mut result: Dict[str, list[RustInputRequest]] = {}
    if "envs" not in root:
        return Ok(result)
    environments = table(root["envs"], manifest, ["envs"])?
    for name in sorted([name for name in environments.keys()]):
        environment = table(environments[name], manifest, ["envs", name])?
        mut selected = production.clone()
        if "dependencies" in environment:
            entries = table(environment["dependencies"], manifest, ["envs", name, "dependencies"])?
            for alias in sorted([alias for alias in entries.keys()]):
                mut found = false
                for index in range(len(selected)):
                    if selected[index].alias == alias:
                        selected[index] = overlay_rust_request(
                            selected[index],
                            entries[alias],
                            manifest,
                            ["envs", name, "dependencies", alias],
                        )?
                        found = true
                if not found:
                    entry = table(entries[alias], manifest, ["envs", name, "dependencies", alias])?
                    if "loaf" in entry:
                        selected.append(rust_request(alias, entries[alias], manifest, "dependencies")?)
        result[name] = selected
    return Ok(result)


def overlay_rust_request(
    base: RustInputRequest,
    value: TomlValue,
    manifest: str,
    field: list[str],
) -> Result[RustInputRequest, IntakeError]:
    """Apply explicit environment fields to one normalized production request without inventing omitted values."""
    entry = table(value, manifest, field)?
    allowed(
        entry,
        ["loaf", "version", "features", "default-features", "optional", "path", "target", "package", "crate"],
        manifest,
        field,
    )?
    for retired in ["package", "crate"]:
        if retired in entry:
            return Err(
                refusal(
                    manifest,
                    field + [retired],
                    IntakeErrorKind.Unsupported,
                    f"use `{base.alias}` with its `loaf` identity under this environment's [dependencies] table",
                ),
            )
    mut result = base.clone()
    if "loaf" in entry:
        identity = required(entry, "loaf", manifest, field + ["loaf"])?
        validate_loaf_identity(identity).map_err(
            (error) => refusal(manifest, field + ["loaf"], IntakeErrorKind.Invalid, error),
        )?
        result.loaf = Some(identity)
        result.package = crate_name(identity)
    if "version" in entry:
        result.version = required(entry, "version", manifest, field + ["version"])?
    if "features" in entry:
        result.features = unique_strings(result.features + requested_features(entry["features"], manifest, field)?)
    if "default-features" in entry:
        result.default_features = request_flag(entry["default-features"], manifest, field)?
    if "optional" in entry:
        result.optional = request_flag(entry["optional"], manifest, field)?
    if "target" in entry:
        predicate = required(entry, "target", manifest, field + ["target"])?
        validate_target(predicate).map_err(
            (error) => refusal(manifest, field + ["target"], IntakeErrorKind.Invalid, error),
        )?
        result.target = Some(predicate)
    if "path" in entry:
        result.path = Some(required(entry, "path", manifest, field + ["path"])?)
    return Ok(result)


def unique_strings(values: list[str]) -> list[str]:
    """Return sorted distinct strings for normalized overlay feature requests."""
    mut result: list[str] = []
    for value in values:
        if value not in result:
            result.append(value)
    return sorted(result)


def first_key(values: Dict[str, TomlValue]) -> str:
    """Return the first deterministic key of a dependency table already known to be nonempty."""
    keys = sorted([key for key in values.keys()])
    if len(keys) == 0:
        return "dependency"
    return keys[0]


def dependency_replacement(
    alias: str,
    value: TomlValue,
    manifest: str,
    field: list[str],
) -> Result[str, IntakeError]:
    """Render the Loaf dependency form used by a retired-table or retired-key refusal hint."""
    mut package = alias
    mut version = "*"
    if value.kind() == TomlKind.String:
        version = text(value, manifest, field)?
    else:
        entry = table(value, manifest, field)?
        if "package" in entry:
            package = text(entry["package"], manifest, field + ["package"])?
        if "crate" in entry:
            package = text(entry["crate"], manifest, field + ["crate"])?
        if "version" in entry:
            version = text(entry["version"], manifest, field + ["version"])?
    return Ok(f"{alias} = {{ loaf = \"crates-io/{package}\", version = \"{version}\" }}")


def string_list(value: TomlValue, manifest: str, field: list[str]) -> Result[list[str], IntakeError]:
    """A TOML array of strings."""
    entries = value.as_array().map_err((error) => refusal(manifest, field, IntakeErrorKind.Invalid, error.message()))?
    mut items: list[str] = []
    for index in range(len(entries)):
        items.append(text(entries[index], manifest, field + [str(index)])?)
    return Ok(items)


def flag(
    values: Dict[str, TomlValue],
    key: str,
    fallback: bool,
    manifest: str,
    field: list[str],
) -> Result[bool, IntakeError]:
    """An optional boolean field, `fallback` when absent."""
    if key not in values:
        return Ok(fallback)
    return values[key]
        .as_bool()
        .map_err((error) => refusal(manifest, field + [key], IntakeErrorKind.Invalid, error.message()))


def parse_features(
    project: Dict[str, TomlValue],
    dependencies: list[LocalDependency],
    manifest: str,
    rust_inputs: list[RustInputRequest] = [],
) -> Result[Dict[str, FeatureDeclaration], IntakeError]:
    """
    The `[project.features]` declarations, each checked against the package's features and dependencies.

    1. Read each declared feature, in either spelling.
    2. Collect the dependencies a feature may name: every Incan and Rust dependency, and the optional ones.
    3. Every include, `dep:` activation and `alias/feature` request must name something the package declares.
    4. Features must not include each other in a cycle.
    """
    mut features: Dict[str, FeatureDeclaration] = {}
    if "features" not in project:
        return Ok(features)
    # 1. A feature is written as a list or as a table, and both spellings give the same declaration.
    values = table(project["features"], manifest, ["project", "features"])?
    for name in sorted([key for key in values.keys()]):
        field = ["project", "features", name]
        features[name] = feature_declaration(values[name], manifest, field)?
    # 2. A feature may name an Incan or a Rust dependency, and only an optional one may be activated by `dep:`.
    mut optional: list[str] = []
    mut aliases: list[str] = []
    for dependency in dependencies:
        aliases.append(dependency.alias)
        if dependency.optional:
            optional.append(dependency.alias)
    for request in rust_inputs:
        aliases.append(request.alias)
        if request.optional:
            optional.append(request.alias)
    # 3. A feature never names a feature, dependency or optional activation the package does not declare.
    for name in sorted([key for key in features.keys()]):
        field = ["project", "features", name]
        check_feature_names(features[name], features, optional, aliases, manifest, field)?
    # 4. Features that include each other could never be told apart, so the cycle is refused.
    cycle = feature_cycle(features)
    if cycle != "":
        detail = f"features include each other: {cycle}"
        return Err(refusal(manifest, ["project", "features"], IntakeErrorKind.Cycle, detail))
    return Ok(features)


def check_feature_names(
    declaration: FeatureDeclaration,
    features: Dict[str, FeatureDeclaration],
    optional: list[str],
    aliases: list[str],
    manifest: str,
    field: list[str],
) -> Result[None, IntakeError]:
    """
    Refuse a feature that includes an undeclared feature, activates a dependency that is not optional, or requests
    features of something that is not a dependency.
    """
    for included in declaration.includes:
        if included not in features:
            detail = f"includes `{included}`, which the package does not declare"
            return Err(refusal(manifest, field, IntakeErrorKind.Invalid, detail))
    for alias in declaration.optional_dependencies:
        if alias not in optional:
            detail = f"activates `dep:{alias}`, which is not an optional dependency"
            return Err(refusal(manifest, field, IntakeErrorKind.Invalid, detail))
    for alias in sorted([key for key in declaration.dependency_features.keys()]):
        mut dependency = alias
        if dependency.endswith("?"):
            dependency = dependency[:-1]
        if dependency not in aliases:
            detail = f"requests features of `{dependency}`, which is not a dependency"
            return Err(refusal(manifest, field, IntakeErrorKind.Invalid, detail))
    return Ok(None)


def feature_cycle(features: Dict[str, FeatureDeclaration]) -> str:
    """The first chain of `includes` that returns to where it started, as `a -> b -> a`; empty when there is none."""
    for start in sorted([name for name in features.keys()]):
        mut chain: list[str] = [start]
        mut frontier: list[list[str]] = [chain]
        while len(frontier) > 0:
            path = frontier.pop()
            last = path[len(path) - 1]
            if last not in features:
                continue
            for included in features[last].includes:
                if included == start:
                    return " -> ".join(path + [included])
                if included not in path:
                    frontier.append(path + [included])
    return ""


pub def feature_declaration(
    value: TomlValue,
    manifest: str,
    field: list[str],
) -> Result[FeatureDeclaration, IntakeError]:
    """Normalize either authored feature spelling at the manifest boundary, for both Incan and Rust activation."""
    if value.kind() == TomlKind.Array:
        return compact_feature(value, manifest, field)
    return expanded_feature(value, manifest, field)


def compact_feature(value: TomlValue, manifest: str, field: list[str]) -> Result[FeatureDeclaration, IntakeError]:
    """A compact feature: `name` includes a feature, `dep:alias` activates a dependency, `alias/name` requests one."""
    mut declaration = FeatureDeclaration()
    for entry in string_list(value, manifest, field)?:
        if entry.startswith("dep:"):
            declaration.optional_dependencies.append(entry[4:])
        elif "/" in entry:
            parts = entry.split("/")
            if len(parts) != 2 or parts[0] == "" or parts[1] == "":
                return Err(
                    refusal(manifest, field, IntakeErrorKind.Invalid, f"`{entry}` is not `<dependency>/<feature>`"),
                )
            mut requested: list[str] = []
            if parts[0] in declaration.dependency_features:
                requested = declaration.dependency_features[parts[0]]
            requested.append(parts[1])
            declaration.dependency_features[parts[0]] = requested
        else:
            declaration.includes.append(entry)
    return Ok(declaration)


def expanded_feature(value: TomlValue, manifest: str, field: list[str]) -> Result[FeatureDeclaration, IntakeError]:
    """An expanded feature table naming each edge kind."""
    entries = table(value, manifest, field)?
    allowed(entries, ["includes", "optional-dependencies", "dependency-features"], manifest, field)?
    mut declaration = FeatureDeclaration()
    if "includes" in entries:
        declaration.includes = string_list(entries["includes"], manifest, field + ["includes"])?
    if "optional-dependencies" in entries:
        declaration.optional_dependencies = string_list(
            entries["optional-dependencies"],
            manifest,
            field + ["optional-dependencies"],
        )?
    if "dependency-features" in entries:
        requests = table(entries["dependency-features"], manifest, field + ["dependency-features"])?
        for alias in sorted([key for key in requests.keys()]):
            declaration.dependency_features[alias] = string_list(
                requests[alias],
                manifest,
                field + ["dependency-features", alias],
            )?
    return Ok(declaration)


def parse_contract_models(root: Dict[str, TomlValue], manifest: str) -> Result[list[str], IntakeError]:
    """The model bundles `[tool.incan.metadata] model-bundles` names; other tools' tables are theirs."""
    if "tool" not in root:
        return Ok([])
    tool = table(root["tool"], manifest, ["tool"])?
    if "incan" not in tool:
        return Ok([])
    incan = table(tool["incan"], manifest, ["tool", "incan"])?
    allowed(incan, ["metadata", "codegraph"], manifest, ["tool", "incan"])?
    check_codegraph(incan, manifest)?
    if "metadata" not in incan:
        return Ok([])
    metadata = table(incan["metadata"], manifest, ["tool", "incan", "metadata"])?
    allowed(metadata, ["model-bundles"], manifest, ["tool", "incan", "metadata"])?
    if "model-bundles" not in metadata:
        return Ok([])
    return string_list(metadata["model-bundles"], manifest, ["tool", "incan", "metadata", "model-bundles"])


def check_codegraph(incan: Dict[str, TomlValue], manifest: str) -> Result[None, IntakeError]:
    """Validate `[tool.incan.codegraph]`, whose `sources` name further projects to inspect; only inspection reads it."""
    if "codegraph" not in incan:
        return Ok(None)
    field = ["tool", "incan", "codegraph"]
    codegraph = table(incan["codegraph"], manifest, field)?
    allowed(codegraph, ["sources"], manifest, field)?
    if "sources" in codegraph:
        _ = string_list(codegraph["sources"], manifest, field + ["sources"])?
    return Ok(None)


def parse_c_headers(root: Dict[str, TomlValue], manifest: str) -> Result[list[str], IntakeError]:
    """The headers every `[[interop.c.targets]]` entry declares, each once; the checker reads the rest of the table."""
    if "interop" not in root:
        return Ok([])
    interop = table(root["interop"], manifest, ["interop"])?
    allowed(interop, ["c"], manifest, ["interop"])?
    if "c" not in interop:
        return Ok([])
    c = table(interop["c"], manifest, ["interop", "c"])?
    if "targets" not in c:
        return Ok([])
    targets = c["targets"]
        .as_array()
        .map_err((error) => refusal(manifest, ["interop", "c", "targets"], IntakeErrorKind.Invalid, error.message()))?
    mut headers: list[str] = []
    for index in range(len(targets)):
        field = ["interop", "c", "targets", str(index)]
        entry = table(targets[index], manifest, field)?
        if "headers" in entry:
            for header in string_list(entry["headers"], manifest, field + ["headers"])?:
                if header not in headers:
                    headers.append(header)
    return Ok(headers)


def parse_dependencies(
    root: Dict[str, TomlValue],
    manifest: str,
) -> Result[Tuple[list[LocalDependency], list[RustInputRequest]], IntakeError]:
    """Keep local edges and adopted Loaf target alternatives without resolving either."""
    mut dependencies: list[LocalDependency] = []
    mut rust_inputs: list[RustInputRequest] = []
    if "rust-dependencies" in root:
        entries = table(root["rust-dependencies"], manifest, ["rust-dependencies"])?
        alias = first_key(entries)
        replacement = dependency_replacement(alias, entries[alias], manifest, ["rust-dependencies", alias])?
        return Err(
            refusal(
                manifest,
                ["rust-dependencies"],
                IntakeErrorKind.Unsupported,
                f"use [dependencies] {replacement}",
            ),
        )
    if "dependencies" in root:
        group = "dependencies"
        values = table(root[group], manifest, [group])?
        for alias in sorted([key for key in values.keys()]):
            value = values[alias].clone()
            if value.kind() == TomlKind.Array:
                entries = value
                    .as_array()
                    .map_err((error) => refusal(manifest, [group, alias], IntakeErrorKind.Invalid, error.message()))?
                if len(entries) == 0:
                    return Err(
                        refusal(
                            manifest,
                            [group, alias],
                            IntakeErrorKind.Invalid,
                            "target entry array must not be empty",
                        ),
                    )
                for entry in entries:
                    request = rust_request(alias, entry, manifest, group)?
                    if request.target is None:
                        return Err(
                            refusal(
                                manifest,
                                [group, alias, "target"],
                                IntakeErrorKind.Missing,
                                "array entries require target",
                            ),
                        )
                    rust_inputs.append(request)
            else:
                if value.kind() == TomlKind.String:
                    replacement = dependency_replacement(alias, value, manifest, [group, alias])?
                    return Err(
                        refusal(
                            manifest,
                            [group, alias],
                            IntakeErrorKind.Invalid,
                            f"dependency must name its Loaf; use {replacement}",
                        ),
                    )
                entry = table(value, manifest, [group, alias])?
                if "standard" in entry:
                    return Err(
                        refusal(
                            manifest,
                            [group, alias, "standard"],
                            IntakeErrorKind.Unsupported,
                            "standard packages are ambient: a unit reaches every standard package it uses, and none is declared",
                        ),
                    )
                if "path" in entry:
                    field = [group, alias]
                    allowed(
                        entry,
                        [
                            "loaf",
                            "path",
                            "version",
                            "optional",
                            "default-features",
                            "features",
                            "target",
                            "package",
                            "crate",
                        ],
                        manifest,
                        field,
                    )?
                    path = required(entry, "path", manifest, field + ["path"])?
                    mut features: list[str] = []
                    if "features" in entry:
                        features = string_list(entry["features"], manifest, field + ["features"])?
                    dependencies.append(
                        LocalDependency(
                            alias=alias,
                            path=path,
                            optional=flag(entry, "optional", false, manifest, field)?,
                            default_features=flag(entry, "default-features", true, manifest, field)?,
                            features=features,
                            rust_facet="loaf" in entry,
                        ),
                    )
                    if "loaf" in entry:
                        rust_inputs.append(rust_request(alias, value, manifest, group)?)
                else:
                    rust_inputs.append(rust_request(alias, value, manifest, group)?)
    return Ok((dependencies, rust_inputs))


def validate_facets(root: Dict[str, TomlValue], manifest: str, project_name: str) -> Result[None, IntakeError]:
    """Validate authored facet metadata even when local intake does not execute it."""
    if "rust" in root:
        rust_facet = table(root["rust"], manifest, ["rust"])?
        allowed(
            rust_facet,
            ["name", "type", "edition", "source", "bin", "lib", "build-script"],
            manifest,
            ["rust"],
        )?
        for key in ["name", "type", "edition"]:
            if key in rust_facet:
                value = required(rust_facet, key, manifest, ["rust", key])?
                if key == "type" and value not in ["lib", "proc-macro"]:
                    return Err(refusal(manifest, ["rust", key], IntakeErrorKind.Invalid, "unsupported Rust type"))
                if key == "edition" and value not in ["2015", "2018", "2021", "2024"]:
                    return Err(refusal(manifest, ["rust", key], IntakeErrorKind.Invalid, "unsupported Rust edition"))
        if "source" in rust_facet:
            source = table(rust_facet["source"], manifest, ["rust", "source"])?
            allowed(source, ["root"], manifest, ["rust", "source"])?
            required(source, "root", manifest, ["rust", "source", "root"])?
        if "bin" in rust_facet:
            validate_binaries(rust_facet["bin"], manifest)?
        if flag(rust_facet, "build-script", false, manifest, ["rust"])?:
            return Err(
                refusal(
                    manifest,
                    ["rust", "build-script"],
                    IntakeErrorKind.Unsupported,
                    f"{project_name} requires a recorded build fact for this exact binding",
                ),
            )
    if "vocab" in root:
        vocab = table(root["vocab"], manifest, ["vocab"])?
        if "crate" in vocab:
            return Err(
                refusal(
                    manifest,
                    ["vocab", "crate"],
                    IntakeErrorKind.Unsupported,
                    "[vocab] crate is refused; declare [vocab] entry",
                ),
            )
        allowed(vocab, ["entry"], manifest, ["vocab"])?
        required(vocab, "entry", manifest, ["vocab", "entry"])?
    return Ok(None)


def validate_binaries(value: TomlValue, manifest: str) -> Result[None, IntakeError]:
    """Each `[[rust.bin]]` is a table of known keys, and the access it declares passes `[build]`'s validator."""
    binaries = value
        .as_array()
        .map_err((error) => refusal(manifest, ["rust", "bin"], IntakeErrorKind.Invalid, error.message()))?
    for index in range(len(binaries)):
        field = ["rust", "bin", str(index)]
        binary = table(binaries[index], manifest, field)?
        allowed(binary, ["name", "path"] + access_keys(BINARY_SEPARATOR), manifest, field)?
        read_access(binary, BINARY_SEPARATOR, manifest, field)?
    return Ok(None)


def parse_vocab_entry(root: Dict[str, TomlValue], manifest: str) -> Result[Option[str], IntakeError]:
    """Read the validated vocabulary entry without resolving its filesystem path."""
    if "vocab" not in root:
        return Ok(None)
    vocab = table(root["vocab"], manifest, ["vocab"])?
    return Ok(Some(required(vocab, "entry", manifest, ["vocab", "entry"])?))


def validate_target(value: str) -> Result[None, str]:
    """Admit an exact triple or the RFC 119 canonical cfg grammar without evaluating it."""
    if not value.startswith("cfg("):
        if len(value.split("-")) < 3:
            return Err("target requires an exact triple or canonical cfg(...)")
        for part in value.split("-"):
            if part == "":
                return Err("target triple contains an empty component")
        for char in value:
            if char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.":
                return Err("target triple contains an invalid character")
        return Ok(None)
    if not value.endswith(")"):
        return Err("cfg target requires a closing parenthesis")
    rest = cfg_predicate(value[4:-1], 0)?
    if rest != "":
        return Err("cfg target has a trailing or noncanonical construct")
    return Ok(None)


def cfg_predicate(value: str, depth: int) -> Result[str, str]:
    """Consume one canonical cfg expression and retain the unconsumed suffix."""
    if depth > 64:
        return Err("cfg nesting exceeds 64")
    mut name = ""
    for char in value:
        if char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_":
            break
        name += char
    if name == "" or name[0] in "0123456789":
        return Err("cfg requires an identifier")
    mut rest = value[len(name):]
    if rest.startswith("("):
        if name not in ["all", "any", "not"]:
            return Err("unknown cfg construct: " + name)
        rest = rest[1:]
        mut count = 0
        if not rest.startswith(")"):
            while true:
                rest = cfg_predicate(rest, depth + 1)?
                count += 1
                if not rest.startswith(", "):
                    break
                rest = rest[2:]
        if not rest.startswith(")"):
            return Err("cfg requires canonical comma-space separators and closing parenthesis")
        if name == "not" and count != 1:
            return Err("cfg not requires exactly one argument")
        return Ok(rest[1:])
    if rest.startswith(" = \""):
        rest = rest[4:]
        mut escaped = false
        mut offset = 0
        for char in rest:
            if escaped:
                if char not in ["\\", "\"", "n", "r", "t", "0"]:
                    return Err("cfg value has an unsupported escape")
                escaped = false
            elif char == "\\":
                escaped = true
            elif char == "\"":
                return Ok(rest[offset + 1:])
            elif char in ["\n", "\r", "\t"]:
                return Err("cfg value contains a control character")
            offset += 1
        return Err("cfg value requires a closing quote")
    return Ok(rest)


def rust_request(alias: str, value: TomlValue, manifest: str, group: str) -> Result[RustInputRequest, IntakeError]:
    """
    Normalize one Rust-facet Loaf request without selecting its version or source.

    1. The entry names one syntactically valid Loaf from any registry scope.
    2. Retired Cargo keys refuse with the adopted Loaf form.
    3. Target and feature policy remain authored requests until activation.
    4. A registry request needs a version; a local path is selected by the local graph.
    """
    field = [group, alias]
    entry = table(value, manifest, field)?
    allowed(
        entry,
        ["loaf", "version", "features", "default-features", "optional", "path", "target", "package", "crate"],
        manifest,
        field,
    )?
    for retired in ["package", "crate"]:
        if retired in entry:
            package = required(entry, retired, manifest, field + [retired])?
            mut requirement = "*"
            if "version" in entry:
                requirement = required(entry, "version", manifest, field + ["version"])?
            detail = f"use {alias} = {{ loaf = \"crates-io/{package}\", version = \"{requirement}\" }}"
            return Err(refusal(manifest, field + [retired], IntakeErrorKind.Unsupported, detail))
    identity = required(entry, "loaf", manifest, field + ["loaf"])?
    validate_loaf_identity(identity).map_err(
        (error) => refusal(manifest, field + ["loaf"], IntakeErrorKind.Invalid, error),
    )?
    mut version = ""
    mut features: list[str] = []
    mut default_features = true
    mut optional = false
    mut target: Option[str] = None
    mut local_path: Option[str] = None
    # 3. Keep canonical target and feature requests at the intake boundary.
    if "target" in entry:
        predicate = required(entry, "target", manifest, field + ["target"])?
        validate_target(predicate).map_err(
            (error) => refusal(manifest, field + ["target"], IntakeErrorKind.Invalid, error),
        )?
        target = Some(predicate)
    if "version" in entry:
        version = required(entry, "version", manifest, field + ["version"])?
    if "features" in entry:
        features = requested_features(entry["features"], manifest, field)?
    if "default-features" in entry:
        default_features = request_flag(entry["default-features"], manifest, field)?
    if "optional" in entry:
        optional = request_flag(entry["optional"], manifest, field)?
    if "path" in entry:
        local_path = Some(required(entry, "path", manifest, field + ["path"])?)
    # 4. Nothing other than a path can identify a source without a version requirement.
    if version == "" and local_path is None:
        return Err(refusal(manifest, field, IntakeErrorKind.Missing, "version requirement is required"))
    return Ok(
        RustInputRequest(
            alias=alias,
            package=crate_name(identity),
            loaf=Some(identity),
            version=version,
            features=features,
            default_features=default_features,
            optional=optional,
            target=target,
            path=local_path,
        ),
    )


def requested_features(value: TomlValue, manifest: str, field: list[str]) -> Result[list[str], IntakeError]:
    """The features a requirement asks for, each once, sorted."""
    entries = value.as_array().map_err((error) => refusal(manifest, field, IntakeErrorKind.Invalid, error.message()))?
    mut features: list[str] = []
    for item in entries:
        feature = text(item, manifest, field + ["features"])?
        if feature not in features:
            features.append(feature)
    return Ok(sorted(features))


def request_flag(value: TomlValue, manifest: str, field: list[str]) -> Result[bool, IntakeError]:
    """Require a TOML boolean in a requirement, without coercing another kind; a refusal names the requirement."""
    return value.as_bool().map_err((error) => refusal(manifest, field, IntakeErrorKind.Invalid, error.message()))
