"""Read compiler-produced checker and Body IR values from independently bounded Crumb row files."""

from std.fs import Path
from pub::internal_models.namespace_order import IMPORT_ORDER_FILE, NamespaceOrder, certified_namespace_order, ranked_output_suffix, read_import_closures

from pub::internal_models.overload_members import LOOKUP_FILE, MethodReads, method_lookup_suffix, read_method_lookups
from pub::internal_models import (
    CompiledBodyFallback,
    CompiledBodyOutput,
    CompiledBodyOutputs,
    CompiledBodyValue,
    CompiledNamespaceValue,
    decode_compiled_body_row,
)

const MAX_COMPILED_BODY_ROWS: int = 4096
const MAX_COMPILED_BODY_ROW_BYTES: int = 67108864


pub def compiled_namespace_order(path: Path, origin: str, namespaces: Borrowed[list[CompiledNamespaceValue]]) -> Result[Dict[str, NamespaceOrder], str]:
    """Bind fresh owners to verified import closures even when their entire namespace cannot be restored."""
    mut closures: Dict[str, list[str]] = {}
    order_path = path.joinpath(IMPORT_ORDER_FILE)
    if path.0.endswith(ranked_output_suffix()) and order_path.exists():
        size = order_path.stat().map_err((error) => error.message())?.size().map_err((error) => error.message())?
        if not order_path.is_file() or size <= 0 or size > MAX_COMPILED_BODY_ROW_BYTES:
            return Err("compiled import inventory exceeds its bound")
        closures = read_import_closures(order_path.read_bytes().map_err((error) => error.message())?)?
        for namespace in namespaces:
            if namespace.module not in closures or closures[namespace.module] != namespace.dependencies:
                return Err("compiled namespace and import inventory disagree: " + namespace.module)
    else:
        for namespace in namespaces:
            closures[namespace.module] = namespace.dependencies
    return certified_namespace_order(origin, closures)

pub def compiled_method_reads(path: Path) -> Result[MethodReads, str]:
    page = path.joinpath(LOOKUP_FILE)
    if not path.0.endswith(method_lookup_suffix()) or not page.exists():
        return Ok(MethodReads(groups={}, retained=set()))
    size = page.stat().map_err((error) => error.message())?.size().map_err((error) => error.message())?
    if not page.is_file() or size <= 0 or size > MAX_COMPILED_BODY_ROW_BYTES:
        return Err("invalid method lookup inventory length")
    return read_method_lookups(page.read_bytes().map_err((error) => error.message())?)


pub def read_compiled_body_outputs(path: Path) -> Result[CompiledBodyOutputs, str]:
    """Read one bounded Crumb row per sidecar file while retaining only decoded semantic values."""
    if not path.is_dir():
        return Err("compiled body output is not a row directory")
    entries = sorted([entry.0 for entry in path.iterdir().map_err((error) => error.message())?])
    order_file = path.joinpath(IMPORT_ORDER_FILE).0
    has_order = path.0.endswith(ranked_output_suffix()) and order_file in entries
    mut row_count = len(entries)
    if has_order:
        row_count -= 1
    member_file = path.joinpath(LOOKUP_FILE).0
    has_members = path.0.endswith(method_lookup_suffix()) and member_file in entries
    if has_members:
        row_count -= 1
    if row_count > MAX_COMPILED_BODY_ROWS:
        return Err("compiled body output contains too many rows")
    mut values: list[CompiledBodyValue] = []
    mut fallbacks: list[CompiledBodyFallback] = []
    mut namespaces: list[CompiledNamespaceValue] = []
    mut previous_namespace = ""
    mut previous_value = ""
    mut previous_fallback = ""
    for entry in entries:
        if (has_order and entry == order_file) or (has_members and entry == member_file):
            continue
        row = Path(entry)
        if not row.is_file() or not row.name().endswith(".crumb"):
            return Err("compiled body output contains a non-row entry")
        size = row.stat().map_err((error) => error.message())?.size().map_err((error) => error.message())?
        if size <= 0 or size > MAX_COMPILED_BODY_ROW_BYTES:
            return Err("compiled body output row exceeds its bound")
        encoded = row.read_bytes().map_err((error) => f"cannot read compiled body row: {error.message()}")?
        output = decode_compiled_body_row(encoded).map_err((error) => f"compiled body output refused: {error:?}")?
        match output:
            CompiledBodyOutput.Namespace(value) =>
                if len(values) > 0 or len(fallbacks) > 0 or value.module <= previous_namespace:
                    return Err("compiled namespace rows are not in canonical order")
                previous_namespace = value.module
                namespaces.append(value)
            CompiledBodyOutput.LegacyNamespace(module) =>
                # Older compilers emitted no package-root set. Their callable rows still stand independently.
                if len(values) > 0 or len(fallbacks) > 0 or module <= previous_namespace:
                    return Err("compiled namespace rows are not in canonical order")
                previous_namespace = module
            CompiledBodyOutput.Value(value) =>
                if len(fallbacks) > 0:
                    return Err("compiled body value follows a fallback row")
                order = value.module + "\n" + value.identity
                if order <= previous_value:
                    return Err("compiled body value rows are not in canonical order")
                previous_value = order
                values.append(value)
            CompiledBodyOutput.Fallback(fallback) =>
                identity = match fallback.identity:
                    Some(value) => value
                    None => ""

                order = fallback.module + "\n" + fallback.name + "\n" + identity
                if order <= previous_fallback:
                    return Err("compiled body fallback rows are not in canonical order")
                if identity != "":
                    for value in values:
                        if value.module == fallback.module and value.identity == identity:
                            return Err("compiled body fallback duplicates an eligible owner")
                previous_fallback = order
                fallbacks.append(fallback)
    return Ok(CompiledBodyOutputs(namespaces=namespaces, values=values, fallbacks=fallbacks))
