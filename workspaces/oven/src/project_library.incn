"""
A project's shared library unit: every module of its source root but its test modules and root entry files, compiled
once per project and profile. Each test unit and each program unit of the project links it, and the compiler reads the
unit's project-local imports of those modules as imports of the library, so the unit compiles only its own modules.
"""

from std.fs import Path
from files import make_directory, read
from home import dependency_artifact_dir, standard_packages
from observation import entered, skipped_directory
from publication import publish
from unit import UnitDescription, UnitLoaf

# The suffix that names a project's shared library, as package and dependency key, after the project's package.
pub const LIBRARY_SUFFIX: str = "_project_library"
# The generated root of a shared library. It imports nothing: a library unit holds every module of its source root.
const ROOT_TEXT: str = "\"\"\"A project's shared library: its source-root modules but its tests.\"\"\"\n"
# A source root's own entry files, which no shared library holds.
const ROOT_ENTRIES: FrozenList[str] = ["main.incn", "lib.incn"]


pub def with_project_library(unit: UnitDescription, captured: Option[list[str]] = None) -> Result[UnitDescription, str]:
    """
    A test or program unit of a project, set to link its project's shared library, and every other unit as it was.

    Both leave out the same test modules, so the programs and tests of one project and profile link one library unit.
    A test unit whose entry batches further modules keeps compiling its whole source graph, as does a program with
    further program entries, each of which must stay a module of the program, a unit that registers a vocabulary, one
    of a standard package, and one whose source root holds no module beside its tests, its root entry files and its own
    entry.
    """
    if unit.vocab_entry != None:
        return Ok(unit)
    if unit.kind == "test":
        if len(unit.test_batch) > 0 or not is_test_module(Path(unit.source).name()):
            return Ok(unit)
    elif unit.kind != "program" or len(unit.program_entries) > 0:
        return Ok(unit)
    if not Path(unit.project_root).joinpath("loaf.toml").is_file():
        return Ok(unit)
    # A standard package's modules name their own `std.*` roots, which only that package may own.
    for package in standard_packages(unit.manifests)?:
        if package.name == unit.package:
            return Ok(unit)
    tests, provided = source_modules(Path(unit.source_root), captured)?
    if len([path for path in provided if path != unit.source]) == 0:
        return Ok(unit)
    mut linked = unit
    linked.project_library = Some(library_key(unit.package))
    linked.excluded_sources = tests
    return Ok(linked)


pub def planned_program(
    unit: UnitDescription, direct: bool, captured: Option[list[str]] = None,
) -> Result[UnitDescription, str]:
    """
    A program unit as `build` and `run` both compile it: a project's program links the project's shared library, so it
    compiles only its own modules, and a direct source, which is no project's unit, never does. A request with an
    admitted source inventory supplies it here so the planner uses the same membership without listing it again.
    """
    if direct:
        return Ok(unit)
    return with_project_library(unit, captured)


pub def library_key(package: str) -> str:
    """The package name and dependency key of a project's shared library."""
    return package.replace("-", "_") + LIBRARY_SUFFIX


pub def with_testing_features(unit: UnitDescription, features: list[str]) -> UnitDescription:
    """
    A test unit with each `--feature NAME` testing feature active, so its collection observes it. A name the unit
    does not already have active is recorded as a testing feature, which its shared library does not take.
    """
    mut tested = unit
    for feature in features:
        if feature not in tested.active_features:
            tested.active_features.append(feature)
            tested.testing_features.append(feature)
    return tested


pub def shared_library(unit: UnitDescription, key: str) -> Result[UnitDescription, str]:
    """
    The shared library carries the requesting unit's own project, package features and Loaves. It has its own package
    name and checks the project's modules as a program does. Testing features apply only to the test unit.
    """
    mut library = unit
    library.kind = "library"
    library.source = library_root(unit, key)?.0
    library.package = key
    library.project_library = None
    library.program_checks = true
    library.program_entries = []
    library.test_batch = []
    library.active_features = [feature for feature in unit.active_features if feature not in unit.testing_features]
    library.testing_features = []
    return Ok(library)


pub def library_output(unit: UnitDescription, key: str, native_name: str) -> Path:
    """Where a project's shared library is compiled, beside the project's path dependencies."""
    return dependency_artifact_dir(unit.project_root, key, unit.profile).joinpath(f"lib{native_name}.rlib")


pub def library_loaf(unit: UnitDescription, key: str, output: Path) -> UnitLoaf:
    """The shared library as a project unit reaches it, under its key."""
    return UnitLoaf(key=key, name=key, dir=output.parent().0, standard=false, source_root=Some(unit.source_root))


def library_root(unit: UnitDescription, key: str) -> Result[Path, str]:
    """The shared library's generated root, written only when it is absent or differs."""
    directory = Path(unit.project_root).joinpath("target/incan/project-library").joinpath(key)
    root = directory.joinpath("lib.incn")
    if root.is_file() and read(root)? == ROOT_TEXT:
        return Ok(root)
    make_directory(directory)?
    # Concurrent cold programs can share this directory in the same engine process.
    generation = directory.joinpath("generate").lock_exclusive().map_err((error) => error.message())?
    if not root.is_file() or read(root)? != ROOT_TEXT:
        publish(root, ROOT_TEXT)?
    return Ok(root)


pub def is_test_module(name: str) -> bool:
    """Whether a source file is a test module, as test collection names them, or a conftest fixture module."""
    if not name.endswith(".incn"):
        return false
    return name.startswith("test_") or name.endswith("_test.incn") or name == "conftest.incn"


pub def source_modules(
    source_root: Path, captured: Option[list[str]] = None,
) -> Result[tuple[list[str], list[str]], str]:
    """
    The test modules under a source root and the modules its shared library provides, each in byte order. Root
    `main.incn` and `lib.incn` are entry files of neither; the walk enters what every source walk enters (see
    `entered`): no hidden directory, build output or vendored packages, and no nested project.
    """
    if let Some(files) = captured:
        return Ok(partition_sources(source_root, files))
    if not source_root.is_dir():
        return Ok(([], []))
    mut files: list[str] = []
    mut pending = [source_root]
    mut index = 0
    while index < len(pending):
        directory = pending[index]
        index += 1
        for entry in directory.iterdir().map_err((error) => f"cannot list {directory.0}: {error.message()}")?:
            name = entry.name()
            if name.startswith("."):
                continue
            if entry.is_dir():
                if entered(entry):
                    pending.append(entry)
            elif name.endswith(".incn"):
                files.append(entry.0)
    return Ok(partition_sources(source_root, files))


def partition_sources(root: Path, files: list[str]) -> tuple[list[str], list[str]]:
    """Classify source files admitted by either planner, retaining canonical order."""
    mut tests: list[str] = []
    mut provided: list[str] = []
    for file in files:
        name = Path(file).name()
        if name.startswith("."):
            continue
        if is_test_module(name):
            tests.append(file)
        elif provides_source(file[len(root.0) + 1:]):
            provided.append(file)
    return (sorted(tests), sorted(provided))


pub def provides_source(relative: str) -> bool:
    """Whether a source-root relative module is eligible for ownership by the project's shared library."""
    if relative in ROOT_ENTRIES or not relative.endswith(".incn") or is_test_module(Path(relative).name()):
        return false
    for part in relative.split("/"):
        if skipped_directory(part):
            return false
    return true
