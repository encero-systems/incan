"""Choose one intact foundation for all checked source-unit dependency bindings."""

from std.json import JsonValue
from plan import (
    NativeCandidate,
    NativeCandidateEvidence,
    NativeSelection,
    ProviderCapability,
    SelectionRequest,
    SelectionError,
    SelectionErrorKind,
    select_native,
    validate_selection_request,
    validate_capabilities,
    validate_names as unique,
    covers,
    candidate_covers,
)


@derive(Eq)
pub model ProviderIdentity:
    """Exact provider/plan.rs ProviderIdentity fields; features are a validated set."""

    pub name: str
    pub version: str
    pub digest: str
    pub feature_projection: list[str]


pub enum NativeRequirementRole(str):
    """The two persisted dependency activation roles."""

    Normal = "normal"
    Dev = "dev"


pub enum ProviderEdgeKind(str):
    """Existing checked provider visibility, separate from Rust request source kinds."""

    PublicPackage = "public_package"
    PrivateImplementation = "private_implementation"


pub enum NativePathAnchor(str):
    """The sole persisted authored-path coordinate anchor."""

    AuthoringProject = "authoring_project"


pub enum NativeUnboundPathReason(str):
    """The existing schema1 unavailable-source reason."""

    PortableSourceBindingUnavailable = "portable_source_binding_unavailable"


pub enum NativeGitReference:
    """A declared reference, never a resolved checkout."""

    Branch(str)
    Tag(str)
    Rev(str)


pub enum NativeRequirementSource:
    """Payload variants mirror native_source.rs without parallel tags or sentinel fields."""

    ProviderEdge(ProviderEdgeKind, str)
    RegistryRequest
    GitRequest(str, NativeGitReference)
    AuthoredPathRequest(NativePathAnchor, str)
    UnboundPathRequest(str, NativeUnboundPathReason)


pub model Requirement:
    """A schema1 request retained verbatim alongside its checked provider-edge coordinates."""

    pub role: NativeRequirementRole
    pub alias: str
    pub package: Option[str]
    pub version_requirement: Option[str]
    pub features: list[str]
    pub default_features: bool
    pub optional: bool
    pub source: NativeRequirementSource


pub enum CompilerSupport(str):
    """Original compiler emission sites, independent of SDK provider identities."""

    Stdlib = "stdlib"
    Derive = "derive"


pub model CompilerSupportRequest:
    """Actual emitted support and features consumed by native runtime input construction."""

    pub support: CompilerSupport
    pub features: list[str]


pub model SourceUnit:
    """Original owner and definition evidence; the JSON definition is never rewritten."""

    pub unit_id: str
    pub owner_id: str
    pub identity: ProviderIdentity
    pub definition_id: str
    pub definition_digest: str
    pub definition: JsonValue
    pub requirements: list[Requirement]
    pub compiler_support: Option[list[CompilerSupportRequest]] = None


pub model CheckedEdge:
    """One original checked descriptor association, never a newly resolved dependency."""

    pub edge_id: str
    pub owner_id: str
    pub owner: ProviderIdentity
    pub descriptor_index: int
    pub kind: ProviderEdgeKind
    pub dependency_key: str
    pub target_owner_id: str
    pub target: ProviderIdentity
    pub target_unit_id: str
    pub requested_features: list[str]
    pub default_features: bool
    pub optional: bool


pub model ReservedNeed:
    """Checked SDK requirement independent of an offered foundation."""

    pub need_id: str
    pub unit_id: str
    pub owner_id: str
    pub provider: ProviderIdentity
    pub capability: ProviderCapability
    pub role: str
    pub extern_name: str


pub model ReservedGrant:
    """Original receipt/member handle with explicit candidate, owner, role and named authority."""

    pub grant_id: str
    pub candidate_id: str
    pub candidate_evidence_id: str
    pub plan_identity: str
    pub need_id: str
    pub owner_id: str
    pub provider: ProviderIdentity
    pub capability: ProviderCapability
    pub role: str
    pub extern_name: str


pub model RuntimeNeed:
    """One emitted support slot joined to its original unit and verified current feature input.

    The feature input is the existing runtime receipt field, not a newly computed macro-specific key.
    """

    pub need_id: str
    pub unit_id: str
    pub unit_owner_id: str
    pub support_index: int
    pub features: list[str]
    pub runtime_features_input: str


pub model RuntimeGrant:
    """A named member of one admitted native supplier, without a fabricated SDK identity.

    The host supplies source_role and artifact_digest from the retained original member handle and validates
    selected IDs against that table before attachment. JSON text alone authenticates neither field.
    """

    pub grant_id: str
    pub candidate_id: str
    pub candidate_evidence_id: str
    pub plan_identity: str
    pub need_id: str
    pub unit_owner_id: str
    pub extern_name: str
    pub source_role: str
    pub artifact_digest: str
    # Exact-unit candidates have no recipe fields; recipe suppliers retain the original feature input.
    pub runtime_features_input: Option[str]


pub model SourceBatch:
    """One selected-profile command request with all units and original checked associations."""

    pub foundation: SelectionRequest
    pub purpose: str
    pub units: list[SourceUnit]
    pub edges: list[CheckedEdge]
    pub needs: list[ReservedNeed]
    pub grants: list[ReservedGrant]
    pub runtime_needs: list[RuntimeNeed] = []
    pub runtime_grants: list[RuntimeGrant] = []
    # The wire decoder derives this from the batch version; the JSON object has no override field.
    pub requires_compiler_support: bool = false


pub model SlotBinding:
    """One original dependency slot and its checked edge handle."""

    pub role: NativeRequirementRole
    pub alias: str
    pub edge_id: str


pub model UnitBinding:
    """Original unit/definition handles plus its exact edge and reserved member handles."""

    pub unit_id: str
    pub owner_id: str
    pub definition_id: str
    pub definition_digest: str
    pub slots: list[SlotBinding]
    pub grant_ids: list[str]


pub model BatchSelection:
    """One foundation and complete bindings; no physical paths or native-ready claim."""

    pub foundation: NativeSelection
    pub units: list[UnitBinding]


pub def select_source_units(batch: SourceBatch) -> Result[BatchSelection, SelectionError]:
    """
    Filter candidates by whole-batch bindings, then rank once with the existing selector.

    A missing binding excludes a candidate. Invalid evidence refuses the request even when that candidate would lose.
    The host must authenticate all returned original handles before any physical effect.
    """
    validate_selection_request(batch.foundation)?
    validate_batch(batch)?
    mut candidates: list[NativeCandidate] = []
    mut bindings: list[list[UnitBinding]] = []
    for candidate in batch.foundation.candidates:
        if let Some(bound) = bind_candidate(batch, candidate):
            candidates.append(candidate)
            bindings.append(bound)
    original = batch.foundation
    filtered = SelectionRequest(
        request_id=original.request_id,
        evidence_id=original.evidence_id,
        build_unit=original.build_unit,
        context=original.context,
        runtime=original.runtime,
        providers=original.providers,
        candidates=candidates,
        unsupported_intent=original.unsupported_intent,
    )
    selected = select_native(filtered)?
    for index in range(len(candidates)):
        if candidates[index].candidate_id == selected.candidate_id:
            return Ok(BatchSelection(foundation=selected, units=bindings[index]))
    return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["selection"]))


def validate_batch(batch: SourceBatch) -> Result[None, SelectionError]:
    """Check all offered associations before candidate filtering can hide malformed facts."""
    if batch.purpose != "library":
        return Err(SelectionError(kind=SelectionErrorKind.UnsupportedIntent, fields=["purpose"]))
    unique([unit.unit_id for unit in batch.units], ["units"])?
    unique([edge.edge_id for edge in batch.edges], ["edges"])?
    unique([grant.grant_id for grant in batch.grants] + [grant.grant_id for grant in batch.runtime_grants], ["grants"])?
    unique([need.need_id for need in batch.needs] + [need.need_id for need in batch.runtime_needs], ["needs"])?
    unique([candidate.candidate_id for candidate in batch.foundation.candidates], ["candidates"])?
    if len(batch.units) == 0:
        return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units"]))
    validate_runtime_bindings(batch)?
    for unit in batch.units:
        identity_valid(unit.identity)?
        if unit.owner_id == "" or unit.definition_id == "" or unit.definition_digest == "":
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units", unit.unit_id, "evidence"]))
        unique(
            [request.role.value() + ":" + request.alias for request in unit.requirements],
            ["units", unit.unit_id, "requirements"],
        )?
        for request in unit.requirements:
            unique(request.features, ["requirements", request.alias, "features"])?
            if request.role == NativeRequirementRole.Normal and not is_provider_edge(request.source):
                return Err(
                    SelectionError(
                        kind=SelectionErrorKind.UnsupportedIntent,
                        fields=["units", unit.unit_id, "requirements", request.alias],
                    ),
                )
    for edge in batch.edges:
        if edge.descriptor_index < 0 or edge.dependency_key == "" or edge.target_owner_id == "":
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["edges", edge.edge_id]))
        identity_valid(edge.owner)?
        identity_valid(edge.target)?
        unique(edge.requested_features, ["edges", edge.edge_id, "requested_features"])?
        mut owner_found = false
        for unit in batch.units:
            if unit.owner_id == edge.owner_id and same_identity(unit.identity, edge.owner):
                owner_found = true
        if not owner_found:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["edges", edge.edge_id, "owner"]))
    for index in range(len(batch.edges)):
        for previous in range(index):
            left = batch.edges[index]
            right = batch.edges[previous]
            if left.owner_id == right.owner_id and left.descriptor_index == right.descriptor_index:
                return Err(
                    SelectionError(
                        kind=SelectionErrorKind.InvalidInput,
                        fields=["edges", left.edge_id, "descriptor_index"],
                    ),
                )
    for need in batch.needs:
        identity_valid(need.provider)?
        validate_capabilities([need.capability])?
        if need.role != "source" or need.extern_name == "" or need.owner_id == "":
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["needs", need.need_id]))
        if need.unit_id not in [unit.unit_id for unit in batch.units]:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["needs", need.need_id, "unit_id"]))
    for grant in batch.grants:
        identity_valid(grant.provider)?
        validate_capabilities([grant.capability])?
        mut bound = false
        for candidate in batch.foundation.candidates:
            if candidate.candidate_id == grant.candidate_id and candidate.evidence_id == grant.candidate_evidence_id and candidate.plan_identity == grant.plan_identity:
                bound = true
        if not bound or grant.need_id not in [need.need_id for need in batch.needs]:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["grants", grant.grant_id]))
    return Ok(None)


def validate_runtime_bindings(batch: SourceBatch) -> Result[None, SelectionError]:
    """Require complete source slots and original candidate ownership before any candidate can be filtered."""
    if not batch.requires_compiler_support:
        if len(batch.runtime_needs) != 0 or len(batch.runtime_grants) != 0:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["runtime_needs"]))
        for unit in batch.units:
            if let Some(_) = unit.compiler_support:
                return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units", unit.unit_id, "compiler_support"]))
        return Ok(None)
    for unit in batch.units:
        match unit.compiler_support:
            None => return Err(SelectionError(kind=SelectionErrorKind.UnsupportedIntent, fields=["units", unit.unit_id, "compiler_support"]))
            Some(requests) =>
                if len(requests) == 0 or requests[0].support != CompilerSupport.Stdlib:
                    return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units", unit.unit_id, "compiler_support"]))
                unique([request.support.value() for request in requests], ["units", unit.unit_id, "compiler_support"])?
                for index in range(len(requests)):
                    request = requests[index]
                    unique(request.features, ["units", unit.unit_id, "compiler_support", str(index), "features"])?
                    if request.support == CompilerSupport.Derive and len(request.features) != 0:
                        return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units", unit.unit_id, "compiler_support", str(index), "features"]))
                    matches = [need for need in batch.runtime_needs if runtime_need_matches(
                        need, unit, index, request,
                    )]
                    if len(matches) != 1:
                        return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["units", unit.unit_id, "compiler_support", str(index)]))
    for need in batch.runtime_needs:
        unique(need.features, ["runtime_needs", need.need_id, "features"])?
        if need.runtime_features_input == "" or not runtime_need_has_unit(batch, need):
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["runtime_needs", need.need_id]))
    for grant in batch.runtime_grants:
        unique(
            [grant.source_role], ["runtime_grants", grant.grant_id, "source_role"],
        )?
        if "" in [grant.extern_name, grant.artifact_digest]:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["runtime_grants", grant.grant_id]))
        if grant.need_id not in [need.need_id for need in batch.runtime_needs]:
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["runtime_grants", grant.grant_id]))
        if not runtime_grant_has_supplier(batch, grant):
            return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["runtime_grants", grant.grant_id, "supplier"]))
    return Ok(None)


def runtime_need_matches(
    need: RuntimeNeed, unit: SourceUnit, index: int, request: CompilerSupportRequest,
) -> bool:
    """Bind an original support position to the exact emitted unit and collected request features."""
    return need.unit_id == unit.unit_id and need.unit_owner_id == unit.owner_id and need.support_index == index and same_set(
        need.features, request.features,
    )


def runtime_need_has_unit(batch: SourceBatch, need: RuntimeNeed) -> bool:
    """Check the original definition position instead of identifying compiler support by an alias search."""
    for unit in batch.units:
        if unit.unit_id == need.unit_id and unit.owner_id == need.unit_owner_id:
            if let Some(requests) = unit.compiler_support:
                if need.support_index < 0 or need.support_index >= len(requests):
                    return false
                return same_set(need.features, requests[need.support_index].features)
    return false


def runtime_grant_has_supplier(batch: SourceBatch, grant: RuntimeGrant) -> bool:
    """Keep runtime evidence attached to its original admitted candidate and immutable plan."""
    for candidate in batch.foundation.candidates:
        if candidate.candidate_id == grant.candidate_id and candidate.evidence_id == grant.candidate_evidence_id and candidate.plan_identity == grant.plan_identity:
            match candidate.evidence:
                NativeCandidateEvidence.RuntimeProviderRecipe(_, _) =>
                    match grant.runtime_features_input:
                        None => return false
                        Some(value) => return value != ""
                NativeCandidateEvidence.ExactBuildUnit =>
                    match grant.runtime_features_input:
                        None => return true
                        Some(_) => return false
    return false


def compiler_extern(support: CompilerSupport) -> str:
    """Return the alias written by that exact compiler emission site, never a discovered native filename."""
    match support:
        CompilerSupport.Stdlib => return "incan_stdlib"
        CompilerSupport.Derive => return "incan_derive"


def bind_runtime_grants(batch: SourceBatch, unit: SourceUnit, candidate: NativeCandidate) -> Option[list[str]]:
    """Bind emitted runtime slots using the same runtime/build-unit comparison as the foundation selector."""
    mut result: list[str] = []
    if not batch.requires_compiler_support:
        return Some(result)
    match unit.compiler_support:
        None => return None
        Some(requests) =>
            for need in batch.runtime_needs:
                if need.unit_id != unit.unit_id:
                    continue
                request = requests[need.support_index]
                matches = [grant.grant_id for grant in batch.runtime_grants if runtime_grant_matches(
                    grant, candidate, need, unit, request,
                )]
                if len(matches) != 1:
                    return None
                result.append(matches[0])
    return Some(result)


def runtime_grant_matches(
    grant: RuntimeGrant, candidate: NativeCandidate, need: RuntimeNeed, unit: SourceUnit,
    request: CompilerSupportRequest,
) -> bool:
    """Compare required support and receipt facts; the retained host handle owns physical member validation."""
    if grant.candidate_id != candidate.candidate_id or grant.need_id != need.need_id:
        return false
    if grant.unit_owner_id != unit.owner_id or grant.extern_name != compiler_extern(request.support):
        return false
    match candidate.evidence:
        NativeCandidateEvidence.ExactBuildUnit =>
            # The existing foundation selector still requires its exact request/build-unit match.
            return true
        NativeCandidateEvidence.RuntimeProviderRecipe(_, _) =>
            return grant.runtime_features_input == Some(need.runtime_features_input)


def bind_candidate(batch: SourceBatch, candidate: NativeCandidate) -> Option[list[UnitBinding]]:
    """Compute complete bindings once for this candidate, including empty-authored foundation requirements."""
    mut result: list[UnitBinding] = []
    for unit in batch.units:
        mut slots: list[SlotBinding] = []
        mut grant_ids: list[str] = []
        match bind_runtime_grants(batch, unit, candidate):
            None => return None
            Some(runtime_ids) => grant_ids.extend(runtime_ids)
        mut need_count = len(grant_ids)
        for need in batch.needs:
            if need.unit_id == unit.unit_id:
                need_count += 1
                mut matches: list[str] = []
                for grant in batch.grants:
                    if grant.candidate_id == candidate.candidate_id and grant.need_id == need.need_id and grant.owner_id == need.owner_id and same_identity(
                        grant.provider,
                        need.provider,
                    ) and grant.role == need.role and grant.extern_name == need.extern_name and covers(
                        grant.capability,
                        need.capability,
                    ):
                        if candidate_covers(batch.foundation, candidate, need.capability):
                            matches.append(grant.grant_id)
                if len(matches) != 1:
                    return None
                grant_ids.append(matches[0])
        if need_count == 0:
            return None
        for request in unit.requirements:
            if request.role == NativeRequirementRole.Normal:
                mut matches: list[str] = []
                for edge in batch.edges:
                    if edge.owner_id == unit.owner_id and same_identity(edge.owner, unit.identity) and provider_edge_matches(
                        request.source,
                        edge,
                    ) and same_set(edge.requested_features, request.features) and edge.default_features == request.default_features and edge.optional == request.optional:
                        if target_bound(batch, unit, edge):
                            matches.append(edge.edge_id)
                if len(matches) != 1:
                    return None
                slots.append(SlotBinding(role=request.role, alias=request.alias, edge_id=matches[0]))
        result.append(
            UnitBinding(
                unit_id=unit.unit_id,
                owner_id=unit.owner_id,
                definition_id=unit.definition_id,
                definition_digest=unit.definition_digest,
                slots=slots,
                grant_ids=grant_ids,
            ),
        )
    return Some(result)


def target_bound(batch: SourceBatch, unit: SourceUnit, edge: CheckedEdge) -> bool:
    """Public targets join units; private targets join that unit's checked SDK needs."""
    if edge.kind == ProviderEdgeKind.PublicPackage:
        for target in batch.units:
            if target.unit_id == edge.target_unit_id and target.owner_id == edge.target_owner_id and same_identity(
                target.identity,
                edge.target,
            ):
                return true
    if edge.kind == ProviderEdgeKind.PrivateImplementation:
        for need in batch.needs:
            if need.unit_id == unit.unit_id and need.owner_id == edge.target_owner_id and same_identity(
                need.provider,
                edge.target,
            ):
                return true
    return false


def all_present(required: list[str], supplied: list[str]) -> bool:
    """Set inclusion after duplicate validation."""
    for value in required:
        if value not in supplied:
            return false
    return true


def same_set(left: list[str], right: list[str]) -> bool:
    """Compare feature sets independently of their serialized order."""
    return len(left) == len(right) and all_present(left, right)


def same_identity(left: ProviderIdentity, right: ProviderIdentity) -> bool:
    """Compare all four existing ProviderIdentity fields."""
    return left.name == right.name and left.version == right.version and left.digest == right.digest and same_set(
        left.feature_projection,
        right.feature_projection,
    )


def identity_valid(identity: ProviderIdentity) -> Result[None, SelectionError]:
    """Reject absent identity evidence and duplicate feature projections."""
    if identity.name == "" or identity.version == "" or identity.digest == "":
        return Err(SelectionError(kind=SelectionErrorKind.InvalidInput, fields=["identity"]))
    return unique(identity.feature_projection, ["identity", "feature_projection"])


def is_provider_edge(source: NativeRequirementSource) -> bool:
    """Identify the one implemented checked-source variant without string tags."""
    match source:
        NativeRequirementSource.ProviderEdge(_, _) => return true
        _ => return false


def provider_edge_matches(source: NativeRequirementSource, edge: CheckedEdge) -> bool:
    """Join the typed retained descriptor kind and key to an existing checked edge."""
    match source:
        NativeRequirementSource.ProviderEdge(kind, key) => return kind == edge.kind and key == edge.dependency_key
        _ => return false
