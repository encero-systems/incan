"""
Engines of different generations coexist over one store: during a release the seed's and the candidate's toolchains
alternate over one home, and each keeps its own engine, which neither refuses nor drains the other.
"""

from std.environ import get_or
from std.fs import Path
from engine_client import service_generation, service_identity
from engine_endpoint import connect_with
from engine_messages import Message, Stop
from engine_state import Identity
from engine_wire import zero_id
from scratch import scratch_directory


pub def test_engines_of_two_compiler_generations_coexist_over_one_store() -> Result[None, str]:
    """
    A caller of compiler generation B reaches an engine of its own while generation A's engine keeps serving A, and
    A's caller still reaches that same engine afterwards.
    """
    scratch = scratch_directory()?
    store = scratch.path().joinpath("store")
    store.mkdir(true, true).map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    mut first = service_identity(store)?
    first.service_generation = service_generation(binary)?
    first.compiler_generation = "compiler-generation-a"
    mut second = first
    second.compiler_generation = "compiler-generation-b"
    a = connect_with(store, first, binary).map_err((refusal) => f"generation A: {refusal.detail}")?
    _ = a.transport.close()
    b = connect_with(store, second, binary).map_err((refusal) => f"generation B beside A: {refusal.detail}")?
    _ = b.transport.close()
    again = connect_with(store, first, binary).map_err((refusal) => f"generation A beside B: {refusal.detail}")?
    _ = again.transport.close()
    stop(store, first, binary)?
    return stop(store, second, binary)


def stop(store: Path, identity: Identity, binary: str) -> Result[None, str]:
    """Stop the engine of one generation."""
    mut channel = connect_with(store, identity, binary).map_err((refusal) => refusal.detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="generation test completed"))).map_err((refusal) => refusal.detail)?
    stopped = channel.receive().map_err((refusal) => refusal.detail)?
    match stopped.message:
        Message.Event(value) => assert value.status == "Stopping", f"the engine answered {value.status}"
        _ => return Err("the engine did not stop")
    _ = channel.transport.close()
    return Ok(None)
