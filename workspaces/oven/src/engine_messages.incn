pub model Submit:
    """Command and immutable descriptor handles; no decoded dependency closure."""

    pub command: str
    pub view: str
    pub input_selection: str
    pub requested_roots: str
    pub options: str
    pub observation_policy: str
    # The directory the client's command ran in, which its compilations are for; never the engine's own.
    pub directory: str = ""
    # The canonical unit options the client parsed (`engine_unit_options`); empty for an ordinary unit.
    pub unit_options: str = ""

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Submit's ordered v1 fields."""
        return Ok(
            joined(
                [
                    scalar(1, 2),
                    text(self.command)?,
                    text(self.view)?,
                    text(self.input_selection)?,
                    text(self.requested_roots)?,
                    text(self.options)?,
                    text(self.observation_policy)?,
                    text(self.directory)?,
                    text(self.unit_options)?,
                ],
            ),
        )

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Submit's fields only after checking their declared lengths."""
        command = reader.text()?
        view = reader.text()?
        input_selection = reader.text()?
        requested_roots = reader.text()?
        options = reader.text()?
        observation_policy = reader.text()?
        directory = reader.text()?
        unit_options = reader.text()?
        return Ok(
            Submit(
                command=command,
                view=view,
                input_selection=input_selection,
                requested_roots=requested_roots,
                options=options,
                observation_policy=observation_policy,
                directory=directory,
                unit_options=unit_options,
            ),
        )


pub model Accepted:
    """Capture and interest tokens; acceptance does not imply capture or completion."""

    pub capture_token: str
    pub interest_token: str

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Accepted's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.capture_token)?, text(self.interest_token)?]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Accepted's fields only after checking their declared lengths."""
        capture_token = reader.text()?
        interest_token = reader.text()?
        return Ok(Accepted(capture_token=capture_token, interest_token=interest_token))


pub model Captured:
    """Immutable epoch and snapshot handles; capture is a separate producer."""

    pub epoch: str
    pub snapshot: str

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Captured's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.epoch)?, text(self.snapshot)?]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Captured's fields only after checking their declared lengths."""
        epoch = reader.text()?
        snapshot = reader.text()?
        return Ok(Captured(epoch=epoch, snapshot=snapshot))


pub model Query:
    """Snapshot-bound read-only query with bounded page limits."""

    pub snapshot: str
    pub query_root: str
    pub cursor: str
    pub row_limit: int
    pub byte_limit: int

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Query's ordered v1 fields."""
        if self.row_limit < 0 or self.row_limit > 4294967295:
            return Err(Refusal(kind=RefusalKind.Schema, detail="Query.row_limit exceeds u32"))
        if self.byte_limit < 0 or self.byte_limit > 4294967295:
            return Err(Refusal(kind=RefusalKind.Schema, detail="Query.byte_limit exceeds u32"))
        return Ok(
            joined(
                [
                    scalar(1, 2),
                    text(self.snapshot)?,
                    text(self.query_root)?,
                    text(self.cursor)?,
                    scalar(int(self.row_limit), 4),
                    scalar(int(self.byte_limit), 4),
                ],
            ),
        )

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Query's fields only after checking their declared lengths."""
        snapshot = reader.text()?
        query_root = reader.text()?
        cursor = reader.text()?
        row_limit = int(reader.number(4)?)
        byte_limit = int(reader.number(4)?)
        return Ok(
            Query(snapshot=snapshot, query_root=query_root, cursor=cursor, row_limit=row_limit, byte_limit=byte_limit),
        )


