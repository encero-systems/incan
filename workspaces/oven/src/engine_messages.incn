    """Cancel remaining interests and relinquish service ownership."""

    pub reason: str

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Stop's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.reason)?]))

