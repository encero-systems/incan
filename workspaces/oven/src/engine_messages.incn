pub enum Message:
    """Every engine message family with an explicit binary tag."""

    Hello(Hello)
    Welcome(Welcome)
    Submit(Submit)
    Accepted(Accepted)
    Captured(Captured)
    Query(Query)
    Page(Page)
    Event(Event)
    Complete(Complete)
    Cancel(Cancel)
    Cancelled(Cancelled)
    Resolve(Resolve)
    Pin(Pin)
    Release(Release)
    Drain(Drain)
    Stop(Stop)
    Ack(Ack)
    Refused(Refused)

    pub def encode(self) -> Result[tuple[int, bytes], Refusal]:
        """Encode one v1 body and return its header tag; no records are sent on this channel."""
        match self:
            Message.Hello(value) => return bounded(1, value.encode()?)
            Message.Welcome(value) => return bounded(2, value.encode()?)
            Message.Submit(value) => return bounded(3, value.encode()?)
            Message.Accepted(value) => return bounded(4, value.encode()?)
            Message.Captured(value) => return bounded(5, value.encode()?)
            Message.Query(value) => return bounded(10, value.encode()?)
            Message.Page(value) => return bounded(11, value.encode()?)
            Message.Event(value) => return bounded(12, value.encode()?)
            Message.Complete(value) => return bounded(13, value.encode()?)
            Message.Cancel(value) => return bounded(14, value.encode()?)
            Message.Cancelled(value) => return bounded(15, value.encode()?)
            Message.Resolve(value) => return bounded(16, value.encode()?)
            Message.Pin(value) => return bounded(17, value.encode()?)
            Message.Release(value) => return bounded(18, value.encode()?)
            Message.Drain(value) => return bounded(19, value.encode()?)
            Message.Stop(value) => return bounded(20, value.encode()?)
            Message.Ack(value) => return bounded(21, value.encode()?)
            Message.Refused(value) => return bounded(22, value.encode()?)

    @staticmethod
    pub def decode(tag: int, raw: bytes) -> Result[Self, Refusal]:
        """Decode only the exact known version and tag, rejecting trailing bytes."""
        if len(raw) > MAX_PAYLOAD:
            return Err(Refusal(kind=RefusalKind.Oversized, detail="engine body exceeds 65536 bytes"))
        mut reader = Decoder(raw=raw)
        if reader.number(2)? != 1:
            return Err(Refusal(kind=RefusalKind.Version, detail="unsupported body schema version"))
        message = Message.from_reader(tag, reader)?
        reader.finish()?
        return Ok(message)

    @staticmethod
    def from_reader(tag: int, mut reader: Decoder) -> Result[Self, Refusal]:
        """Dispatch required variants without guessing compatibility with another protocol."""
        if tag == 1:
            return Ok(Message.Hello(Hello.decode(reader)?))
        if tag == 2:
            return Ok(Message.Welcome(Welcome.decode(reader)?))
        if tag == 3:
            return Ok(Message.Submit(Submit.decode(reader)?))
        if tag == 4:
            return Ok(Message.Accepted(Accepted.decode(reader)?))
        if tag == 5:
            return Ok(Message.Captured(Captured.decode(reader)?))
        if tag == 10:
            return Ok(Message.Query(Query.decode(reader)?))
        if tag == 11:
            return Ok(Message.Page(Page.decode(reader)?))
        if tag == 12:
            return Ok(Message.Event(Event.decode(reader)?))
        if tag == 13:
            return Ok(Message.Complete(Complete.decode(reader)?))
        if tag == 14:
            return Ok(Message.Cancel(Cancel.decode(reader)?))
        if tag == 15:
            return Ok(Message.Cancelled(Cancelled.decode(reader)?))
        if tag == 16:
            return Ok(Message.Resolve(Resolve.decode(reader)?))
        if tag == 17:
            return Ok(Message.Pin(Pin.decode(reader)?))
        if tag == 18:
            return Ok(Message.Release(Release.decode(reader)?))
        if tag == 19:
            return Ok(Message.Drain(Drain.decode(reader)?))
        if tag == 20:
            return Ok(Message.Stop(Stop.decode(reader)?))
        if tag == 21:
            return Ok(Message.Ack(Ack.decode(reader)?))
        if tag == 22:
            return Ok(Message.Refused(Refused.decode(reader)?))
        return Err(Refusal(kind=RefusalKind.Schema, detail="unknown required engine message tag"))


def bounded(tag: int, raw: bytes) -> Result[tuple[int, bytes], Refusal]:
    """Enforce the complete body bound after individually bounded fields have been encoded."""
    if len(raw) > MAX_PAYLOAD:
        return Err(Refusal(kind=RefusalKind.Oversized, detail="engine body exceeds 65536 bytes"))
    return Ok((tag, raw))
