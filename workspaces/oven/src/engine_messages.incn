    """Bounded status and trace handle; never program console bytes."""

    pub status: str
    pub trace_handle: str

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Event's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.status)?, text(self.trace_handle)?]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Event's fields only after checking their declared lengths."""
        status = reader.text()?
        trace_handle = reader.text()?
        return Ok(Event(status=status, trace_handle=trace_handle))


pub model Complete:
    """Caller-specific snapshot, admission, leased handles and binding outcome."""

    pub snapshot: str
    pub admission_proof: str
    pub result_handles: str
    pub binding_outcome: BindingOutcome
    pub status: CompletionStatus
    pub observation_handle: str
    # The unit reasons the engine recorded for this request, one per line, for the caller's own trace channel.
    pub notes: str = ""

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Complete's ordered v1 fields."""
        return Ok(
            joined(
                [
                    scalar(1, 2),
                    text(self.snapshot)?,
                    text(self.admission_proof)?,
                    text(self.result_handles)?,
                    scalar(self.binding_outcome.tag(), 2),
                    scalar(self.status.tag(), 2),
                    text(self.observation_handle)?,
                    text(self.notes)?,
                ],
            ),
        )

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Complete's fields only after checking their declared lengths."""
        snapshot = reader.text()?
        admission_proof = reader.text()?
        result_handles = reader.text()?
        binding_outcome = BindingOutcome.from_tag(int(reader.number(2)?))?
        status = CompletionStatus.from_tag(int(reader.number(2)?))?
        observation_handle = reader.text()?
        notes = reader.text()?
        return Ok(
            Complete(
                snapshot=snapshot,
                admission_proof=admission_proof,
                result_handles=result_handles,
                binding_outcome=binding_outcome,
                status=status,
                observation_handle=observation_handle,
                notes=notes,
            ),
        )


pub model Cancel:
    """Detach one interest; other interests may keep shared work alive."""

    pub interest_token: str

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Cancel's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.interest_token)?]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Cancel's fields only after checking their declared lengths."""
        interest_token = reader.text()?
        return Ok(Cancel(interest_token=interest_token))


pub model Cancelled:
    """Interest detachment and effect-stop outcome."""

    pub interest_token: str
    pub effects_stopped: EffectDisposition

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode the exact effect disposition, never a guessed numeric boolean."""
        return Ok(joined([scalar(1, 2), text(self.interest_token)?, scalar(self.effects_stopped.tag(), 2)]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Reject unknown effect dispositions before reporting cancellation complete."""
        token = reader.text()?
        effects = EffectDisposition.from_tag(int(reader.number(2)?))?
        return Ok(Cancelled(interest_token=token, effects_stopped=effects))


pub model Resolve:
    """Transaction identity and Committed, NotCommitted or Unknown outcome."""

    pub transaction: str
    pub outcome: Resolution

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Resolve's ordered v1 fields."""
        return Ok(joined([scalar(1, 2), text(self.transaction)?, scalar(self.outcome.tag(), 2)]))

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Resolve's fields only after checking their declared lengths."""
        transaction = reader.text()?
        outcome = Resolution.from_tag(int(reader.number(2)?))?
        return Ok(Resolve(transaction=transaction, outcome=outcome))


