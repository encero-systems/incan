"""
Language-neutral v1 control-message models and their versioned, tagged binary bodies; strings name descriptors,
never record payloads, and lengths are validated before each decode allocation.
"""

from engine_wire import Decoder, MAX_PAYLOAD, Refusal, RefusalKind, joined, scalar, text, wide


pub model Hello:
    """Client identity and bounded transport limits, before admitting work."""

    pub store_id: str
    pub profile: str
    pub service_generation: str
    pub compiler_generation: str
    pub peer_uid: u32
    pub credits: int
    pub payload_limit: int

    pub def encode(self) -> Result[bytes, Refusal]:
        """Encode Hello's ordered v1 fields."""
        if self.credits < 0 or self.credits > 4294967295:
            return Err(Refusal(kind=RefusalKind.Schema, detail="Hello.credits exceeds u32"))
        if self.payload_limit < 0 or self.payload_limit > 4294967295:
            return Err(Refusal(kind=RefusalKind.Schema, detail="Hello.payload_limit exceeds u32"))
        return Ok(
            joined(
                [
                    scalar(1, 2),
                    text(self.store_id)?,
                    text(self.profile)?,
                    text(self.service_generation)?,
                    text(self.compiler_generation)?,
                    scalar(int(self.peer_uid), 4),
                    scalar(int(self.credits), 4),
                    scalar(int(self.payload_limit), 4),
                ],
            ),
        )

    @staticmethod
    pub def decode(mut reader: Decoder) -> Result[Self, Refusal]:
        """Decode Hello's fields only after checking their declared lengths."""
        store_id = reader.text()?
        profile = reader.text()?
        service_generation = reader.text()?
        compiler_generation = reader.text()?
        peer_uid: u32 = reader.number(4)?.wrapping_resize()
        credits = int(reader.number(4)?)
        payload_limit = int(reader.number(4)?)
        return Ok(
            Hello(
                store_id=store_id,
                profile=profile,
                service_generation=service_generation,
                compiler_generation=compiler_generation,
                peer_uid=peer_uid,
                credits=credits,
                payload_limit=payload_limit,
            ),
        )


