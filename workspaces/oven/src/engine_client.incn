# The schema of the document an overlay request answers with.
const OVERLAY_DIAGNOSTICS_SCHEMA: str = "incan.overlay-diagnostics/1"
# The schema of the document an overlay hover answers with.
const OVERLAY_HOVER_SCHEMA: str = "incan.overlay-hover/1"
# The schema of the document an overlay definition answers with.
const OVERLAY_DEFINITION_SCHEMA: str = "incan.overlay-definition/1"
const OVERLAY_REFERENCES_SCHEMA: str = "incan.overlay-references/1"
const OVERLAY_CALL_HIERARCHY_SCHEMA: str = "incan.overlay-call-hierarchy/1"
const OVERLAY_DOCUMENT_SYMBOLS_SCHEMA: str = "incan.overlay-document-symbols/1"
# While an overlay request runs, its console is collected here instead of being relayed to the terminal.
static console_capture: dict[str, str] = {}


model CheckAnswer:
    """One engine check: whether it passed, the compiler's report, its error text and the engine's work counters."""

    passed: bool
    report: str
    errors: str
    work: JsonValue
    editor_facts: str


pub def execute_overlay(request: OverlayRequest) -> Result[str, str]:
    """Answer one overlay request over a connection of its own."""
    store = bakery()?
    mut channel = engine_channel(store)?
    answer = answer_overlay(channel, store, request)
    _ = channel.transport.close()
    return answer


pub def serve_overlays(profile: str) -> Result[i32, str]:
    """
    Answer overlay requests, one JSON line each on standard input, over one engine connection.

    Each answer is one `incan.overlay-diagnostics/1` line. A request that fails is answered with its reason, and the
    next request gets a new connection, because the old one may be what failed.
    """
    store = bakery()?
    mut channel = engine_channel(store)?
    input = stdin()
    while true:
        mut incoming = RustString.new()
        match input.read_line(incoming):
            Ok(count) =>
                if count == 0:
                    _ = channel.transport.close()
                    return Ok(0)
            Err(error) => return Err(f"cannot read an overlay request: {error}")
        line = str(incoming)
        if line.strip() == "":
            continue
        mut answer = ""
        match parse_served(line, profile):
            Err(reason) => answer = failed_answer(-1, reason)?
            Ok(request) =>
                match answer_overlay(channel, store, request):
                    Ok(document) => answer = document
                    Err(reason) =>
                        _ = channel.transport.close()
                        channel = engine_channel(store)?
                        answer = failed_answer(request.version, reason)?
        println(answer)
        match stdout().flush():
            Ok(_) => pass
            Err(error) => return Err(f"cannot flush an overlay answer: {error}")
    return Ok(0)


def answer_overlay(mut channel: Channel, store: Path, request: OverlayRequest) -> Result[str, str]:
    """
    Answer one overlay request: the diagnostics of its source with its buffer in place of the file, as an
    `incan.overlay-diagnostics/1` document carrying the editor's document version.

    1. Name the program's editor view, and mirror the program with the buffer in place into its overlay root.
    2. Fork the editor view from the store's shared records on its first request.
    3. Check the program's entry in the editor view, collecting the compiler's JSON report.
    4. Place each diagnostic on the editor's document path.
    """
    # 1. The overlay has the program's logical names, so its unit key is the one a build of these bytes has.
    absolute = Path(request.source).absolute().map_err((error) => f"cannot {error.message()}")?
    buffer = Path(request.buffer)
    text = buffer.read_text("utf-8", "strict").map_err((error) => f"cannot {error.message()}")?
    entry = overlay_entry(absolute, Some(text))?
    bound = selected_home_view()?
    project = project_view_name(view_scope(bound)?, entry.0, request.profile, get_optional("OVEN_BODY_REFUSALS"))?
    editor = editor_view_name(project)?
    program = program_root(absolute)
    document = absolute.0[len(program.0) + 1:]
    if not entry.0.startswith(program.0 + "/"):
        return Err(f"the program entry {entry.0} lies outside {program.0}")
    # A hover reads records and the buffer; it needs no mirror and no engine request.
    if request.hover_line > 0:
        return hover_answer(store, editor, program, entry, document, text, request)
    if request.definition_line > 0:
        return definition_answer(editor, program, entry, document, text, request)
    # The overlay root lies beside the store, not in it: capture never re-reads a file under the bakery.
    overlay = store.parent().joinpath("editor").joinpath(editor)
    _ = mirror_overlay(program, overlay, document, text)?
    # 2. The editor view starts from the records every build reads, and nothing it publishes reaches them.
    if snapshot(store, editor).map_err((error) => error.message())?.index == "":
        fork_project_view(store, HOME_VIEW, editor)?
    # 3. A keystroke's check runs no lowering, planning or native compile. A save builds the overlay instead, so the
    # project's next build of the same bytes finds its unit.
    target = overlay.joinpath(entry.0[len(program.0) + 1:])
    if request.build:
        return built_overlay(editor, target, request)
    checked = submit_check(channel, store, editor, target, request.profile, request.report)?
    if request.references_line > 0:
        return references_answer(store, editor, program, absolute, checked.editor_facts, request)
    if request.call_hierarchy_line > 0:
        return call_hierarchy_answer(store, editor, program, absolute, checked.editor_facts, request)
    if request.document_symbols:
        return document_symbols_answer(
            store,
            editor,
            program,
            entry,
            absolute,
            document,
            text,
            checked.editor_facts,
            request,
        )
    # 4. Diagnostics name the editor's documents, never the overlay root.
    mut entries: list[JsonValue] = []
    for found in report_diagnostics(checked.report, overlay.0, program.0).map_err(
        (reason) => f"{reason}: {checked.errors.strip()}",
    )?:
        entries.append(diagnostic_json(found))
    mut fields = {"schema": JsonValue.string(OVERLAY_DIAGNOSTICS_SCHEMA), "version": JsonValue.int(request.version), "ok": JsonValue.bool(
        checked.passed,
    ), "editor_view": JsonValue.string(editor), "diagnostics": JsonValue.array(entries)}
    if request.report:
        fields["work"] = checked.work
    return JsonValue.object(fields).to_json().map_err((error) => error.message())


def hover_answer(
    store: Path,
    editor: str,
    program: Path,
    entry: Path,
    document: str,
    text: str,
    request: OverlayRequest,
) -> Result[str, str]:
    """Answer a hover from the editor view's records, or from the home view's before the editor view's first request."""
    mut view = editor
    if snapshot(store, editor).map_err((error) => error.message())?.index == "":
        view = str(HOME_VIEW)
    mut hover = JsonValue.null()
    if let Some(signature) = overlay_hover(
        store,
        view,
        program,
        entry,
        document,
        text,
        request.hover_line,
        request.hover_column,
    )?:
        hover = JsonValue.string(signature)
    answer = {"schema": JsonValue.string(OVERLAY_HOVER_SCHEMA), "version": JsonValue.int(request.version), "editor_view": JsonValue.string(
        editor,
    ), "hover": hover}
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def definition_answer(
    editor: str,
    program: Path,
    entry: Path,
    document: str,
    text: str,
    request: OverlayRequest,
) -> Result[str, str]:
    """Answer go-to-definition from the buffer and the source projections ordinary builds publish."""
    definition = overlay_definition(
        program,
        entry,
        document,
        text,
        request.definition_line,
        request.definition_column,
    )?
    answer = {
        "schema": JsonValue.string(OVERLAY_DEFINITION_SCHEMA),
        "version": JsonValue.int(request.version),
        "editor_view": JsonValue.string(editor),
        "definition": definition,
    }
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def references_answer(
    store: Path,
    editor: str,
    program: Path,
    document: Path,
    facts_key: str,
    request: OverlayRequest,
) -> Result[str, str]:
    """Answer references only from the witnessed editor-facts value produced by this request's completed check."""
    selected = snapshot(store, editor).map_err((error) => error.message())?
    locations = overlay_references(
        selected,
        facts_key,
        program,
        document,
        request.references_line,
        request.references_column,
    )?
    answer = {
        "schema": JsonValue.string(OVERLAY_REFERENCES_SCHEMA),
        "version": JsonValue.int(request.version),
        "editor_view": JsonValue.string(editor),
        "references": JsonValue.array(locations),
    }
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def call_hierarchy_answer(
    store: Path,
    editor: str,
    program: Path,
    document: Path,
    facts_key: str,
    request: OverlayRequest,
) -> Result[str, str]:
    """Answer incoming and outgoing calls only from this request's witnessed checked editor facts."""
    selected = snapshot(store, editor).map_err((error) => error.message())?
    hierarchy = overlay_call_hierarchy(
        selected,
        facts_key,
        program,
        document,
        request.call_hierarchy_line,
        request.call_hierarchy_column,
    )?
    answer = {
        "schema": JsonValue.string(OVERLAY_CALL_HIERARCHY_SCHEMA),
        "version": JsonValue.int(request.version),
        "editor_view": JsonValue.string(editor),
        "hierarchy": hierarchy,
    }
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def document_symbols_answer(
    store: Path,
    editor: str,
    program: Path,
    entry: Path,
    document: Path,
    logical: str,
    source: str,
    facts_key: str,
    request: OverlayRequest,
) -> Result[str, str]:
    """Answer the complete current-document outline from its witnessed projection and checked editor facts."""
    selected = snapshot(store, editor).map_err((error) => error.message())?
    symbols = overlay_document_symbols(selected, facts_key, program, entry, document, logical, source)?
    answer = {
        "schema": JsonValue.string(OVERLAY_DOCUMENT_SYMBOLS_SCHEMA),
        "version": JsonValue.int(request.version),
        "editor_view": JsonValue.string(editor),
        "symbols": JsonValue.array(symbols),
    }
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def built_overlay(editor: str, target: Path, request: OverlayRequest) -> Result[str, str]:
    """Build a saved overlay in its editor view, collecting the compiler's console instead of relaying it."""
    console_capture["capturing"] = "yes"
    console_capture["captured"] = ""
    console_capture["errors"] = ""
    built = execute_in("build", target, request.profile, [], None, "", false, editor, None)
    console_capture["capturing"] = ""
    code = built?
    none: list[JsonValue] = []
    answer = {"schema": JsonValue.string(OVERLAY_DIAGNOSTICS_SCHEMA), "version": JsonValue.int(request.version), "ok": JsonValue.bool(
        code == 0,
    ), "editor_view": JsonValue.string(editor), "built": JsonValue.bool(true), "diagnostics": JsonValue.array(none)}
    return JsonValue.object(answer).to_json().map_err((error) => error.message())


def submit_check(
    mut channel: Channel,
    store: Path,
    view: str,
    target: Path,
    profile: str,
    proofs: bool,
) -> Result[CheckAnswer, str]:
    """Submit one check of `target` in `view` and collect the compiler's report from the request's console."""
    request = session_id()?
    mut policy = ""
    if proofs:
        policy = "proofs"
    submit = Submit(
        command="check",
        view=view,
        input_selection=profile,
        requested_roots=target.0,
        options="json",
        observation_policy=policy,
        directory=working_directory().unwrap_or(""),
    )
    send(channel, request, Message.Submit(submit))?
    console_capture["capturing"] = "yes"
    console_capture["captured"] = ""
    console_capture["errors"] = ""
    completed = await_completion(channel, request)
    report_text = console_capture.get("captured", "")
    errors = console_capture.get("errors", "")
    console_capture["capturing"] = ""
    complete, _ = completed?
    mut work = JsonValue.null()
    if complete.observation_handle != "":
        work = parse(report(store, complete.observation_handle)?).map_err((error) => error.message())?
    return Ok(
        CheckAnswer(
            passed=complete.status == CompletionStatus.Success,
            report=report_text,
            errors=errors,
            work=work,
            editor_facts=complete.result_handles,
        ),
    )


def engine_channel(store: Path) -> Result[Channel, str]:
    """Connect to the store's records engine, starting it when none runs; a check may outlive any read deadline."""
    store.mkdir(true, true).map_err((error) => f"cannot {error.message()}")?
    identity = identity_for(store, installed_compiler()?)?
    mut channel = connect(store, identity).map_err(detail)?
    channel.transport.wait_at_most(0)
    return Ok(channel)


def failed_answer(version: int, reason: str) -> Result[str, str]:
    """The answer line of a request that could not be answered."""
    answer = JsonValue.object(
        {"schema": JsonValue.string(OVERLAY_DIAGNOSTICS_SCHEMA), "version": JsonValue.int(version), "error": JsonValue.string(
            reason,
        )},
    )
    return answer.to_json().map_err((error) => error.message())


def diagnostic_json(found: OverlayDiagnostic) -> JsonValue:
    """One diagnostic of an overlay answer."""
    return JsonValue.object(
        {"message": JsonValue.string(found.message), "code": JsonValue.string(found.code), "severity": JsonValue.string(
            found.severity,
        ), "path": JsonValue.string(found.path), "line": JsonValue.int(found.line), "column": JsonValue.int(found.column), "end_line": JsonValue.int(
            found.end_line,
        ), "end_column": JsonValue.int(found.end_column)},
    )


pub def project_view_name(scope: str, source: str, profile: str, refusals: Option[str]) -> Result[str, str]:
    """
    The records engine's project view of one program in one home: named from the home's view key (`scope`), so it
    survives moving the home and two homes over one bakery never share it, then from the source and the profile. A
    selected body-refusal diagnosis is a view of its own.
    """
    mut identity = [scope, source, profile]
    if let Some(mode) = refusals:
        identity.append("body-refusals:" + mode)
    return Ok(f"project-{fingerprint(identity)?}")


pub def execute(
    command: str,
    source: Path,
    profile: str,
    arguments: list[str],
    argv0: Option[str],
    format: str,
    proofs: bool,
) -> Result[i32, str]:
    """
    Build or run one file through the selected engine, without a legacy fallback.

    1. Discover the physical store's compatible engine and submit the program root.
    2. Wait for accepted capture and caller-specific completion, relaying diagnostic bytes separately.
    3. Hold the selected execution pin until the program exits, then release it.
    """
    absolute = source.absolute().map_err((error) => f"cannot {error.message()}")?
    # A check is a view of its own, apart from the program's builds.
    mut view_profile = profile
    if command == "check":
        view_profile = profile + "+check"
    bound = selected_home_view()?
    view = project_view_name(view_scope(bound)?, absolute.0, view_profile, get_optional("OVEN_BODY_REFUSALS"))?
    return execute_in(command, absolute, profile, arguments, argv0, format, proofs, view, bound)


def view_scope(bound: Option[str]) -> Result[str, str]:
    """
    What a home's project views are named from: its bound view key, or, for an `INCAN_BAKERY` invocation that binds
    none, the home's path.
    """
    if let Some(found) = bound:
        return Ok(found)
    return Ok(home()?.0)


def execute_in(
    command: str,
    absolute: Path,
    profile: str,
    arguments: list[str],
    argv0: Option[str],
    format: str,
    proofs: bool,
    view: str,
    bound: Option[str],
) -> Result[i32, str]:
    """Run one records request in `view`, forking it from the home view `bound` names when it does not exist yet."""
    source = absolute
    # 1. The admitted compiler identity is derived once per installation, never probed on an unchanged request.
    mut policy = ""
    if proofs:
        policy = "proofs"
    connecting = begin_work()
    store = bakery()?
    store.mkdir(true, true).map_err((error) => f"cannot {error.message()}")?
    compiler = installed_compiler()?
    selected = snapshot(store, view).map_err((error) => error.message())?
    if selected.index == "":
        # A program's first build in a home starts its project view as a copy-on-write fork of the home's view.
        if let Some(found) = bound:
            fork_project_view(store, found, view)?
    elif not proofs and command != "check":
        if let Some(code) = execute_local(store, selected, compiler, command, absolute, profile, arguments, argv0)?:
            return Ok(code)
    request = session_id()?
    identity = identity_for(store, compiler)?
    mut channel = connect(store, identity).map_err(detail)?
    record_work(Operation.EngineConnect, source.0, connecting)
    # A native build may legitimately outlive a fixed read deadline; service ownership still bounds its lifetime.
    channel.transport.wait_at_most(0)
    submitted = begin_work()
    send(
        channel,
        request,
        Message.Submit(
            Submit(
                command=command,
                view=view,
                input_selection=profile,
                requested_roots=absolute.0,
                options=format,
                observation_policy=policy,
                directory=working_directory().unwrap_or(""),
            ),
        ),
    )?
    # 2. Execution is impossible before a real captured epoch and a successful selected native result.
    complete, interest = await_completion(channel, request)?
    record_work(Operation.EngineRequest, source.0, submitted)
    if complete.observation_handle != "":
        println(report(store, complete.observation_handle)?)
    if complete.status != CompletionStatus.Success:
        return Ok(1)
    if command == "check":
        _ = channel.transport.close()
        return Ok(0)
    mut binary = ""
    mut program = ""
    match read_program(store, complete.result_handles)?:
        None => return Err("engine completed without a native descriptor")
        Some(unit) =>
            if unit.identity != complete.admission_proof:
                return Err("engine completion and admitted native identity disagree")
            binary = unit.binary
            program = unit.identity
    # 3. Complete already holds this caller's execution lease, and the run leases the unit in the bakery until the
    # program exits; the engine never runs or retries user code.
    executing = begin_work()
    mut code: Result[i32, str] = Ok(0)
    if command == "run":
        code = run_program(Path(binary), arguments, argv0, true, program)
    record_work(Operation.EngineChild, source.0, executing)
    # Execution has ended. Cleanup cannot replace its outcome, and disconnect releases the lease if delivery fails.
    _ = send(channel, request, Message.Release(Release(lease_id=interest)))
    _ = channel.transport.close()
    return code


def fork_project_view(store: Path, home_view: str, view: str) -> Result[None, str]:
    """
    Start a program's project view as a fork of the home's view: it shares the home view's index pages and copies none
    of its records. A request that forked it first leaves it as that request made it.
    """
    match fork(snapshot(store, home_view).map_err((error) => error.message())?, view):
        Ok(_) => return Ok(None)
        Err(error) =>
            if error.kind == "conflict":
                return Ok(None)
            return Err(error.message())


def execute_local(
    store: Path,
    selected: Snapshot,
    compiler: str,
    command: str,
    source: Path,
    profile: str,
    arguments: list[str],
    argv0: Option[str],
) -> Result[Option[i32], str]:
    """An unchanged local capture of an existing project view and its selected native record need no service request."""
    view = selected.view
    capturing = begin_work()
    captured = prepare_submit(
        store,
        Submit(
            command=command,
            view=view,
            input_selection=profile,
            requested_roots=source.0,
            options="",
            observation_policy="",
        ),
    )?
    record_work(Operation.EngineCapture, source.0, capturing)
    if captured.commits != 0:
        return Ok(None)
    handle = program_handle(captured.identity, compiler, view)?
    selecting = begin_work()
    exact = view_snapshot(captured.snapshot, view).map_err((error) => error.message())?
    match selected_program(exact, handle)?:
        None => return Ok(None)

        Some(unit) =>
            pinning = begin_work()
            if exact.pin is None:
                return Err("selected native snapshot has no execution lease")
            record_work(Operation.EngineLease, view, pinning)
            restoring = begin_work()
            # A unit whose shared carrier is gone is linked again by the engine.
            if not restore_program(store, unit)?:
                return Ok(None)
            record_work(Operation.EngineUnit, unit.identity, restoring)
            record_work(Operation.EngineSelect, view, selecting)
            trace(
                f"engine local: encodings={captured.encodings} publications={captured.commits} reads={captured.counters.in_reach.reads} hashes={captured.counters.in_reach.hashes}",
            )
            if command == "run":
                executing = begin_work()
                code = run_program(Path(unit.binary), arguments, argv0, true, unit.identity)?
                record_work(Operation.EngineChild, source.0, executing)
                return Ok(Some(code))
            return Ok(Some(0))


pub def service_identity(store: Path) -> Result[Identity, str]:
    """Bind one persistent physical-store id to exact service and admitted compiler generations."""
    return identity_for(store, installed_compiler()?)


def installed_compiler() -> Result[str, str]:
    """
    Read this home's installation admission once, before deciding whether a service is needed: in the home's own view
    of its bakery, or, for an `INCAN_BAKERY` invocation, which binds no view, in the home's installation catalog.
    """
    admitting = begin_work()
    mut store = installation_catalog()?
    mut view = str(HOME_VIEW)
    if let Some(bound) = selected_home_view()?:
        store = bakery()?
        view = bound
    compiler = installation_compiler(store, view)?
    record_work(Operation.EngineAdmission, store.0, admitting)
    return Ok(compiler)


def identity_for(store: Path, compiler: str) -> Result[Identity, str]:
    """Prepare service negotiation only for a request that cannot be answered by a local record read."""
    binary = executable()?
    generation = service_generation(binary)?
    return Ok(
        Identity(
            store_id=physical_store_identity(store)?,
            profile="incan.engine.unit-records/1",
            service_generation=generation,
            compiler_generation=compiler,
            uid=owner_uid(store).map_err(detail)?,
        ),
    )


pub def service_generation(binary: str) -> Result[str, str]:
    """Name the engine service implementation by exact bytes, independent of its installed path."""
    return fingerprint(["incan.engine.service/2", installed_digest(Path(binary))?])


def physical_store_identity(store: Path) -> Result[str, str]:
    """Name the physical root by its filesystem identity, independent of homes, aliases and directory contents."""
    match file_metadata(store)?:
        Some(found) => return fingerprint(["incan.engine.physical-store/1", str(found.device), str(found.inode)])
        None => return Err("engine store root disappeared during admission")


def installation_compiler(store: Path, view: str) -> Result[str, str]:
    """Admit a toolchain once per installation in `view` of `store`, independent of project or alternate stores."""
    directory = toolchain_directory()?
    admission = selected_installation(directory)?
    configuration = inherited_deployment_configuration()? + [get_or("SDKROOT", ""), get_or("INCAN_STDLIB", "")]
    key = f"incan.engine.installation\t{fingerprint([directory.0, admission] + configuration)?}"
    if let Some(compiler) = admitted_installation(store, view, key, admission)?:
        return Ok(compiler)
    _held = claim(store, f"incan.engine.installation\t{view}").map_err((error) => error.message())?
    if let Some(compiler) = admitted_installation(store, view, key, admission)?:
        return Ok(compiler)
    return record_installation(store, view, key, admission, compiler_fingerprint(load_toolchain()?)?)


pub def admitted_installation(store: Path, view: str, key: str, admission: str) -> Result[Option[str], str]:
    """The compiler admitted for one installation in `view` of the bakery, if any."""
    return admitted_compiler(snapshot(store, view).map_err((error) => error.message())?, key, admission)


pub def record_installation(store: Path, view: str, key: str, admission: str, compiler: str) -> Result[str, str]:
    """Record `compiler` as the admitted compiler of one installation in `view` of the bakery."""
    value = json_text(
        JsonValue.object({"admission": JsonValue.string(admission), "compiler": JsonValue.string(compiler)}),
    )?
    selected = snapshot(store, view).map_err((error) => error.message())?
    _ = commit(put(begin(selected), key, value.encode("utf-8"))).map_err((error) => error.message())?
    return Ok(compiler)


def selected_installation(directory: Path) -> Result[str, str]:
    """Return the selected installation-page identity, admitting a missing installation once."""
    if let Some(identity) = admitted_identity(directory)?:
        return Ok(identity)
    _ = load_toolchain()?
    match admitted_identity(directory)?:
        Some(identity) => return Ok(identity)
        None => return Err("toolchain installation did not publish its admitted page")


def admitted_compiler(selected: Snapshot, key: str, admission: str) -> Result[Option[str], str]:
    """Read the portable compiler identity selected by the immutable installation-page identity in its key."""
    if let Some(text) = record_text(selected, key)?:
        previous = parse(text).map_err((error) => error.message())?
        if required_text(previous, "admission")? == admission:
            return Ok(Some(required_text(previous, "compiler")?))
    return Ok(None)


def await_completion(mut channel: Channel, request: bytes) -> Result[tuple[Complete, str], str]:
    """Require Accepted before Captured and Captured before Complete, with exact request correlation throughout."""
    mut interest = ""
    mut captured = false
    while true:
        frame = channel.receive().map_err(detail)?
        if frame.header.request != request:
            return Err("engine replied for a different request")
        match frame.message:
            Message.Accepted(value) =>
                if interest != "":
                    return Err("engine accepted this request twice")
                interest = value.interest_token
            Message.Captured(value) =>
                if interest == "" or value.epoch == "" or value.snapshot == "":
                    return Err("engine captured without accepted inputs")
                captured = true
            Message.Event(event) =>
                if event.status == "Console":
                    if console_capture.get("capturing", "") == "yes":
                        streams = collect_console(event.trace_handle)?
                        console_capture["captured"] = console_capture.get("captured", "") + streams[0]
                        console_capture["errors"] = console_capture.get("errors", "") + streams[1]
                    else:
                        relay_console(event.trace_handle)?
            Message.Complete(value) =>
                if not captured:
                    return Err("engine completed before capture")
                channel.acknowledge(frame).map_err(detail)?
                return Ok((value, interest))
            Message.Refused(value) => return Err(value.detail)
            Message.Ack(_) => pass
            _ => return Err("unexpected engine reply while awaiting completion")
        channel.acknowledge(frame).map_err(detail)?


def send(mut channel: Channel, request: bytes, message: Message) -> Result[None, str]:
    """Send one bounded command at a boundary with available credits; no request is queued implicitly."""
    match channel.send(request, message).map_err(detail)?:
        SendOutcome.Sent(_) => return Ok(None)
        SendOutcome.Blocked => return Err("engine request blocked without credit")


def detail(refusal: Refusal) -> str:
    """Preserve the typed protocol refusal's context at the CLI's textual error boundary."""
    return refusal.detail
