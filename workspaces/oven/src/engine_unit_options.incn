"""
The unit options a records request carries to the engine: the features, program entries and interop target its caller
parsed, in one canonical spelling, so every spelling of one unit names one engine unit and one project view.
"""

from std.fs import Path
from std.json import JsonValue, parse
from features import FeatureRequest
from unit_options import Options


pub model UnitOptions:
    """What a request asks of its unit beyond its root and profile."""

    pub request: FeatureRequest = FeatureRequest()
    pub program_entries: list[str] = []
    pub interop_target: str = ""


pub def unit_options_text(options: Options) -> Result[str, str]:
    """
    Spell the unit options of `options` canonically: sorted distinct features and absolute program entries, or empty
    for an ordinary unit, which asks for nothing beyond its root and profile.
    """
    request = options.request
    features = sorted([feature for feature in set(request.features)])
    mut entries: list[str] = []
    for entry in options.program_entries:
        entries.append(Path(entry).absolute().map_err((error) => f"cannot {error.message()}")?.0)
    if (
        len(features) == 0
        and request.default_features
        and not request.all_features
        and len(entries) == 0
        and options.interop_target == ""
    ):
        return Ok("")
    document = JsonValue.object(
        {
            "all_features": JsonValue.bool(request.all_features),
            "default_features": JsonValue.bool(request.default_features),
            "features": JsonValue.array([JsonValue.string(feature) for feature in features]),
            "interop_target": JsonValue.string(options.interop_target),
            "program_entries": JsonValue.array([JsonValue.string(entry) for entry in entries]),
        },
    )
    return document.to_json().map_err((error) => error.message())


pub def decode_unit_options(text: str) -> Result[UnitOptions, str]:
    """Read the options `unit_options_text` spelled; empty text is an ordinary unit."""
    if text == "":
        return Ok(UnitOptions())
    document = parse(text).map_err((error) => f"unit options: {error.message()}")?
    return Ok(
        UnitOptions(
            request=FeatureRequest(
                features=texts(document, "features")?,
                default_features=flag(document, "default_features")?,
                all_features=flag(document, "all_features")?,
            ),
            program_entries=texts(document, "program_entries")?,
            interop_target=document.require("interop_target").and_then((field) => field.expect_str()).map_err(
                (error) => f"unit options: {error.message()}",
            )?,
        ),
    )


def texts(document: JsonValue, name: str) -> Result[list[str], str]:
    """One required list of strings of the options document."""
    mut values: list[str] = []
    items = document.require(name).and_then((field) => field.expect_array()).map_err(
        (error) => f"unit options: {error.message()}",
    )?
    for item in items:
        values.append(item.expect_str().map_err((error) => f"unit options: {error.message()}")?)
    return Ok(values)


def flag(document: JsonValue, name: str) -> Result[bool, str]:
    """One required boolean of the options document."""
    return document.require(name).and_then((field) => field.expect_bool()).map_err(
        (error) => f"unit options: {error.message()}",
    )
