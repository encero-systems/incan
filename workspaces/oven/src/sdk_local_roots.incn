"""Read local procedural-macro Loaf dependencies as host-domain root requests."""

from std import toml
from std.toml import TomlValue
from std.json import JsonValue
from std.fs import Path


def declaration(alias: str, value: TomlValue) -> Result[JsonValue, str]:
    """Project one literal adopted-Loaf dependency through the shared index request grammar."""
    fields = value.as_table().map_err((e) => e.message())?
    for key in fields.keys():
        if key not in ["loaf", "version", "features", "default-features", "optional"]:
            return Err(f"host dependency {alias} has unsupported field {key}")
    loaf = value.get[str]("loaf").map_err((e) => e.message())?
    version = value.get[str]("version").map_err((e) => e.message())?
    mut features: list[str] = []
    if let Some(selected) = value.get_optional[list[str]]("features").map_err((e) => e.message())?:
        features = selected
    mut defaults = true
    if let Some(selected) = value.get_optional[bool]("default-features").map_err((e) => e.message())?:
        defaults = selected
    mut optional = false
    if let Some(selected) = value.get_optional[bool]("optional").map_err((e) => e.message())?:
        optional = selected
    mut feature_values: list[JsonValue] = []
    for feature in features:
        feature_values.append(JsonValue.string(feature))
    return Ok(JsonValue.object({
        "name": JsonValue.string(alias),
        "loaf": JsonValue.string(loaf),
        "req": JsonValue.string(version),
        "features": JsonValue.array(feature_values),
        "default-features": JsonValue.bool(defaults),
        "optional": JsonValue.bool(optional),
    }))


pub def host_roots(document: JsonValue, roots_file: str) -> Result[str, str]:
    """Read explicitly named local proc-macro manifests relative to the root document; never discover Cargo metadata."""
    mut requests: list[JsonValue] = []
    if let Some(projects) = document.get("host-projects"):
        paths = projects.expect_array().map_err((e) => e.message())?
        for entry in paths:
            relative = entry.expect_str().map_err((e) => e.message())?
            path = Path(roots_file).parent().joinpath(relative)
            source = path.read_text("utf-8", "strict").map_err((e) => e.message())?
            manifest = toml.parse(source).map_err((e) => e.message())?
            fields = manifest.as_table().map_err((e) => e.message())?
            for key in ["features", "target", "dev-dependencies", "build-dependencies"]:
                if key in fields:
                    return Err(f"host root project {relative} has unsupported dependency configuration {key}")
            kind = manifest.get[str]("rust.type").map_err((e) => e.message())?
            if kind != "proc-macro":
                return Err(f"host root project {relative} is not a procedural macro")
            table = manifest.get_value("dependencies").map_err((e) => e.message())?
            dependencies = table.as_table().map_err((e) => e.message())?
            for alias in sorted([name for name in dependencies.keys()]):
                requests.append(declaration(alias, dependencies[alias])?)
    return JsonValue.array(requests).to_json().map_err((e) => e.message())
