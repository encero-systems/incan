"""
Propagate Rust feature demands across a locked dependency graph until they stop changing.

`rust_activation.activate_unit` answers one unit against one context. Cargo's answer is graph-wide: a package's
effective features are the union of what every dependent asks of it, and asking for a feature can enable an optional
dependency, which adds a dependent, which can widen another package's demand. The answer is therefore a fixed point,
not a single pass.

This module owns only that propagation. It does not read manifests, evaluate target conditions, validate feature
graphs or select sources; those belong to `rust_source` and `rust_activation` and are called, never reimplemented.

## Why host and target demands stay separate

Procedural macros and their ordinary dependencies compile for the host, while the same package may also appear in
the target graph. Unifying the two would let a host tool's features leak into the shipped unit. `DependencyDomain`
already carries that split and this propagation keeps it: one accumulated demand per (package, domain), never per
package alone. Build-script declarations remain inventory-only and never enter this graph.
"""

# Explicit payload import until foreign None type qualification is fixed (#2010).
from std.toml import TomlLocation

from std.collections import Deque, OrderedSet
from std.json import JsonValue
from manifest_errors import IntakeError, IntakeErrorKind
from rust_activation import (
    activate_unit,
    version_matches,
    ActivationContext,
    ActivationPurpose,
    DependencyDomain,
    RustActivation,
    SlotActivation,
)
from rust_source import RustDependencyCatalog, RustDependencyDeclaration, crate_identifier, extern_crate_name


@derive(Eq, Clone)
pub model SelectedPackageIdentity:
    """Exact selected Cargo package coordinate copied from a validated Rust facet unit."""

    pub package: str
    pub version: str
    pub source: str


@derive(Eq, Clone)
pub model GraphNode:
    """One package identity in the locked graph, kept distinct per domain."""

    pub package: SelectedPackageIdentity
    pub domain: DependencyDomain


@derive(Clone)
pub model NodeDemand:
    """
    Everything the graph has asked of one node so far.

    `features` only grows: a dependent may add a feature, never retract one another dependent asked for. That
    monotonicity is what makes the iteration terminate.
    """

    pub features: list[str]
    pub default_features: bool


@derive(Eq)
pub enum SelectedUnitRole(str):
    """Policy-relevant role copied from a host-validated selected Rust facet unit."""

    Library = "library"
    Binary = "binary"
    UnitTest = "unit_test"
    IntegrationTest = "integration_test"
    Example = "example"
    Doctest = "doctest"
    Benchmark = "benchmark"
    ProcMacro = "proc_macro"
    CompilerSupport = "compiler_support"
    CallerProjection = "caller_projection"


@derive(Eq)
pub enum SelectedCrateKind(str):
    """Exact crate kind copied from a host-validated selected Rust facet unit."""

    Rlib = "rlib"
    Binary = "binary"
    ProcMacro = "proc_macro"


@derive(Clone)
pub model SelectedUnitClosure:
    """Exact non-feature closure facts retained by the authenticated selected-unit projection."""

    # These JSON values stay structural evidence. Rust has already validated their physical representation and
    # Incan validates their wire shape; this graph never interprets them as Cargo activation demand.
    pub environment: JsonValue
    pub generated_inputs: JsonValue
    pub linked_libraries: JsonValue
    # Bare compiler/sysroot externs remain physical compiler inputs, not source-policy activation facts.
    pub sysroot_externs: list[str]


@derive(Clone)
pub model AdmittedSelectedUnit:
    """Physical selected-unit evidence whose effective features the host already cross-checked against the graph."""

    pub identity: str
    pub node: GraphNode
    pub role: SelectedUnitRole
    pub crate_kind: SelectedCrateKind
    # Exact physical closure data is validated by the exchange and echoed without Rust/Cargo reinterpretation.
    pub closure: SelectedUnitClosure
    # Effective compiler-facing activation observed for this physical unit. It deliberately says nothing about
    # whether defaults were requested: that provenance lives only on GraphRoot.
    pub features: list[str]


@derive(Clone)
pub model GraphRoot:
    """One physical root paired with the exact authority-owned feature request that selected it."""

    pub unit: str
    pub requested_features: list[str]
    pub default_features: bool
    pub intent_owner: str


@derive(Eq, Clone)
pub model AdmittedSelectedEdge:
    """Exact raw selected-facet edge; Incan maps ordinary aliases to manifest slots after activation."""

    pub parent_unit: str
    pub alias: str
    pub child_unit: str


@derive(Eq, Clone)
model CheckedSlotBinding:
    """Policy view derived only after both physical IDs resolve through the admitted selected-unit table."""

    parent_unit: str
    parent: GraphNode
    alias: str
    child_unit: str
    child: GraphNode
    child_is_proc_macro: bool
    internal: bool


pub model GraphActivation:
    """Settled package/domain/purpose activations in the order their fixed points were reached."""

    pub nodes: list[GraphNode]
    pub purposes: list[ActivationPurpose]
    pub activations: list[RustActivation]
    # Derived default-feature demand aligned with `activations`; this is policy output, never physical-unit evidence.
    pub default_features: list[bool]
    pub unit_purposes: Dict[str, ActivationPurpose]
    pub rounds: int


@derive(Eq, Clone)
model PolicyNode:
    """One package/domain activation kept distinct for normal and explicit test roots."""

    node: GraphNode
    purpose: ActivationPurpose


def demanded(
    base: ActivationContext,
    demand: NodeDemand,
    domain: DependencyDomain,
    purpose: ActivationPurpose,
) -> ActivationContext:
    """Apply one node's accumulated demand to the shared host/target context."""
    return ActivationContext(
        host=base.host,
        target=base.target,
        purpose=purpose,
        domain=domain,
        requested_features=demand.features,
        default_features=demand.default_features,
        build_unit_present=base.build_unit_present,
    )


def rounds_exhausted(manifest: str, max_rounds: int) -> IntakeError:
    """
    Refuse rather than spin when propagation does not settle.

    Demands only grow and a graph's feature set is finite, so a fixed point exists; reaching this bound means a
    catalog described edges the walk cannot settle, and reporting that is more useful than looping.
    """
    return IntakeError(
        kind=IntakeErrorKind.Invalid,
        manifest=manifest,
        field=["dependencies"],
        location=None,
        detail=f"feature propagation did not settle within {max_rounds} rounds",
    )


def unit_for(
    units: list[AdmittedSelectedUnit],
    identity: str,
    manifest: str,
) -> Result[AdmittedSelectedUnit, IntakeError]:
    """Resolve exactly one physical unit, refusing missing or duplicate identities before policy uses it."""
    mut found: Option[AdmittedSelectedUnit] = None
    for unit in units:
        if unit.identity == identity:
            if let Some(_) = found:
                return Err(
                    IntakeError(
                        kind=IntakeErrorKind.Invalid,
                        manifest=manifest,
                        field=["units", identity],
                        location=None,
                        detail="duplicate selected physical unit identity",
                    ),
                )
            found = Some(unit)
    if let Some(unit) = found:
        return Ok(unit)
    return Err(
        IntakeError(
            kind=IntakeErrorKind.Missing,
            manifest=manifest,
            field=["units", identity],
            location=None,
            detail="selected physical unit identity",
        ),
    )


def admit_bindings(
    units: list[AdmittedSelectedUnit],
    bindings: list[AdmittedSelectedEdge],
    manifest: str,
) -> Result[list[CheckedSlotBinding], IntakeError]:
    """Resolve opaque edge IDs through the host-admitted unit projection before policy coalesces package nodes."""
    mut checked: list[CheckedSlotBinding] = []
    for index in range(len(bindings)):
        binding = bindings[index]
        parent = unit_for(units, binding.parent_unit, manifest)?
        child = unit_for(units, binding.child_unit, manifest)?
        for earlier in checked:
            if earlier.parent_unit == binding.parent_unit and earlier.alias == binding.alias:
                return Err(
                    IntakeError(
                        kind=IntakeErrorKind.Invalid,
                        manifest=manifest,
                        field=["bindings", str(index)],
                        location=None,
                        detail="duplicate physical-unit dependency alias",
                    ),
                )
        checked.append(
            CheckedSlotBinding(
                parent_unit=binding.parent_unit,
                parent=parent.node,
                alias=binding.alias,
                child_unit=binding.child_unit,
                child=child.node,
                child_is_proc_macro=child.role == SelectedUnitRole.ProcMacro,
                internal=parent.node.package == child.node.package and child.role == SelectedUnitRole.Library,
            ),
        )
    return Ok(checked)


def edge_names_declaration(
    binding: CheckedSlotBinding,
    declaration: RustDependencyDeclaration,
    catalogs: Dict[str, RustDependencyCatalog],
) -> bool:
    """
    Whether a raw selected edge is the link Cargo made for one manifest declaration.

    The edge carries the `--extern` crate name rustc saw, not the manifest key: `axum-core` is linked as `axum_core`,
    `rustls-webpki` as `webpki`, and a renamed declaration under its key. Only the declared package's own catalog
    says which library name it links under, so a binding to any other package is compared under the key's
    spelling and left to the package-name check to refuse; a declared child without a catalog is refused later
    and reads as its package name here.
    """
    if binding.child.package.package != declaration.package:
        return binding.alias == crate_identifier(declaration.alias)
    key = package_key(binding.child.package)
    mut library_name: Option[str] = None
    if key in catalogs:
        library_name = catalogs[key].library_name
    return binding.alias == extern_crate_name(declaration, library_name)


def binding_for(
    bindings: list[CheckedSlotBinding],
    parent: GraphNode,
    purpose: ActivationPurpose,
    unit_purposes: Dict[str, ActivationPurpose],
    declaration: RustDependencyDeclaration,
    catalogs: Dict[str, RustDependencyCatalog],
    manifest: str,
) -> Result[CheckedSlotBinding, IntakeError]:
    """Require one exhaustive host-validated selected-unit binding for an active declaration slot."""
    mut found: Option[CheckedSlotBinding] = None
    for binding in bindings:
        if (
            binding.parent == parent
            and edge_names_declaration(binding, declaration, catalogs)
            and not binding.internal
            and binding.parent_unit in unit_purposes
            and unit_purposes[binding.parent_unit] == purpose
        ):
            match found:
                Some(existing) =>
                    if existing.child != binding.child or existing.child_is_proc_macro != binding.child_is_proc_macro:
                        return Err(
                            IntakeError(
                                kind=IntakeErrorKind.Invalid,
                                manifest=manifest,
                                field=declaration.field,
                                location=None,
                                detail="physical units disagree on the resolved child policy identity for one alias",
                            ),
                        )
                None =>
                    found = Some(binding)
    if let Some(binding) = found:
        return Ok(binding)
    return Err(
        IntakeError(
            kind=IntakeErrorKind.Missing,
            manifest=manifest,
            field=declaration.field,
            location=None,
            detail=f"resolved selected-unit binding for {node_key(parent)} alias {declaration.alias}",
        ),
    )


pub def merged(existing: NodeDemand, addition: NodeDemand) -> Option[NodeDemand]:
    """
    Union one incoming demand into an existing one, or None when it adds nothing.

    Returning None is how the caller learns a node need not be revisited; a demand that grew is the only reason to
    recompute one, and without that test the walk would not terminate on a cyclic graph.
    """
    mut names = OrderedSet[str]()
    for feature in existing.features:
        names.add(feature)
    mut grew = false
    for feature in addition.features:
        if not names.contains(feature):
            names.add(feature)
            grew = true
    defaults = existing.default_features or addition.default_features
    if not grew and defaults == existing.default_features:
        return None
    return Some(NodeDemand(features=names.to_list(), default_features=defaults))


def valid_role_kind(unit: AdmittedSelectedUnit) -> bool:
    """Check the raw graph's role/kind/domain matrix without reclassifying a target in the host."""
    if unit.role == SelectedUnitRole.ProcMacro:
        return unit.crate_kind == SelectedCrateKind.ProcMacro and unit.node.domain == DependencyDomain.Host
    if unit.role in [
        SelectedUnitRole.Binary, SelectedUnitRole.UnitTest, SelectedUnitRole.IntegrationTest,
        SelectedUnitRole.Example, SelectedUnitRole.Doctest, SelectedUnitRole.Benchmark,
    ]:
        return unit.crate_kind == SelectedCrateKind.Binary and unit.node.domain == DependencyDomain.Target
    if unit.role == SelectedUnitRole.CallerProjection:
        return unit.crate_kind == SelectedCrateKind.Rlib and unit.node.domain == DependencyDomain.Target
    return unit.crate_kind == SelectedCrateKind.Rlib


def root_purpose(
    unit: AdmittedSelectedUnit,
    selection: ActivationPurpose,
    manifest: str,
) -> Result[ActivationPurpose, IntakeError]:
    """Derive purpose from authenticated target role and the selected graph's explicit global purpose."""
    if unit.role in [
        SelectedUnitRole.UnitTest, SelectedUnitRole.IntegrationTest,
        SelectedUnitRole.Doctest, SelectedUnitRole.Benchmark,
    ]:
        if selection != ActivationPurpose.Test:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid,
                    manifest=manifest,
                    field=["roots", unit.identity],
                    location=None,
                    detail="test target role requires an explicit test graph selection",
                ),
            )
        return Ok(ActivationPurpose.Test)
    if unit.role == SelectedUnitRole.Example and selection == ActivationPurpose.Test:
        return Ok(ActivationPurpose.Test)
    return Ok(ActivationPurpose.Normal)


def has_active_physical_parent(
    binding: CheckedSlotBinding,
    node: GraphNode,
    purpose: ActivationPurpose,
    unit_purposes: Dict[str, ActivationPurpose],
) -> bool:
    """Return whether one raw physical edge belongs to the policy node currently being settled."""
    if binding.parent != node or binding.parent_unit not in unit_purposes:
        return false
    return unit_purposes[binding.parent_unit] == purpose


pub def propagate_features(
    catalogs: Dict[str, RustDependencyCatalog],
    base: ActivationContext,
    manifest: str,
    units: list[AdmittedSelectedUnit],
    roots: list[GraphRoot],
    bindings: list[AdmittedSelectedEdge],
    max_rounds: int,
) -> Result[GraphActivation, IntakeError]:
    """
    Activate the admitted Rust graph until no node's demand grows, refusing inconsistent physical evidence.

    1. Validate the selected units and resolve their physical bindings.
    2. Seed policy demands from the explicitly authored root intents.
    3. Propagate demands through internal edges and active dependency declarations to a fixed point.
    4. Reconcile settled features and reachability with the complete physical projection.
    5. Return activations in first-reached order, with their default intent and iteration count.

    The physical host first validates the complete selected Rust facet graph and projects its unit inventory and
    exact edges into this call. This function checks that projection for policy consistency; it does not claim to
    authenticate source bytes, unit digests or the original graph. Every reached selected package must have a
    catalog, and every active slot must bind one admitted selected child identity. Missing evidence refuses instead
    of silently turning a selected package into a leaf.

    `base` carries the host and target identities every node shares. Each explicit root carries authority-owned
    requested features and default intent; propagated children always use `Normal`, so a test root cannot activate a
    transitive package's dev edges. The physical unit's effective `features` only appears at final reconciliation.

    `max_rounds` bounds the iteration explicitly. Demands only grow and a graph's feature set is finite, so a fixed
    point exists; the bound is there so a malformed catalog reports a refusal instead of spinning.
    """
    # 1. Validate physical identities before admitting any policy demand.
    validate_selected_units(units, manifest)?
    checked_bindings = admit_bindings(units, bindings, manifest)?

    # 2. Only explicit roots seed authored feature and default intent.
    mut state = seed_root_demands(units, roots, base.purpose, manifest)?

    # 3. Every widened demand or newly reached physical child gets another activation pass.
    settle_demands(state, catalogs, base, checked_bindings, manifest, max_rounds)?

    # 4. Observed physical features are evidence to reconcile, never a source of demand.
    reconcile_features(state, units, manifest)?
    reconcile_bindings(state, checked_bindings, catalogs, manifest)?
    require_reachable_units(state, units, manifest)?

    # 5. Preserve the first-reached order independently of repeated queue visits.
    return Ok(graph_activation(state))


model PropagationState:
    """Growing policy demands and physical reachability retained across fixed-point queue visits."""

    demands: Dict[str, NodeDemand]
    unit_purposes: Dict[str, ActivationPurpose]
    order: list[PolicyNode]
    queue: Deque[PolicyNode]
    settled: Dict[str, RustActivation]
    rounds: int


def validate_selected_units(units: list[AdmittedSelectedUnit], manifest: str) -> Result[None, IntakeError]:
    """Require unique, nonempty physical identities whose target roles agree with their crate kinds and domains."""
    for index in range(len(units)):
        unit = units[index]
        if unit.identity == "":
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Missing,
                    manifest=manifest,
                    field=["units", str(index)],
                    location=None,
                    detail="exact selected physical unit identity",
                ),
            )
        unit_for(units, unit.identity, manifest)?
        if not valid_role_kind(unit):
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid,
                    manifest=manifest,
                    field=["units", unit.identity],
                    location=None,
                    detail="selected Rust target role, crate kind and dependency domain disagree",
                ),
            )
    return Ok(None)


def seed_root_demands(
    units: list[AdmittedSelectedUnit],
    roots: list[GraphRoot],
    purpose: ActivationPurpose,
    manifest: str,
) -> Result[PropagationState, IntakeError]:
    """Require explicit root owners and merge their authored demands without consulting effective unit features."""
    if len(roots) == 0:
        return Err(
            IntakeError(
                kind=IntakeErrorKind.Missing,
                manifest=manifest,
                field=["roots"],
                location=None,
                detail="at least one explicitly selected physical root",
            ),
        )
    mut state = PropagationState(
        demands={}, unit_purposes={}, order=[], queue=Deque[PolicyNode](), settled={}, rounds=0,
    )
    for root in roots:
        if root.intent_owner == "":
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Missing,
                    manifest=manifest,
                    field=["roots", root.unit, "intent_owner"],
                    location=None,
                    detail="identity-bound owner for the authored root feature intent",
                ),
            )
        selected = unit_for(units, root.unit, manifest)?
        selected_purpose = root_purpose(selected, purpose, manifest)?
        state.unit_purposes[root.unit] = selected_purpose
        root_demand = NodeDemand(features=root.requested_features, default_features=root.default_features)
        policy_node = PolicyNode(node=selected.node, purpose=selected_purpose)
        enqueue_demand(state, policy_node, root_demand, false)
    return Ok(state)


def enqueue_demand(mut state: PropagationState, node: PolicyNode, incoming: NodeDemand, newly_reached: bool) -> None:
    """Queue a new or widened demand, or revisit unchanged demand when another physical unit becomes reachable."""
    key = activation_key(node)
    if key not in state.demands:
        state.demands[key] = incoming
        state.order.append(node)
        state.queue.append(node)
        return
    if let Some(widened) = merged(state.demands[key], incoming):
        state.demands[key] = widened
        state.queue.append(node)
        return
    if newly_reached:
        state.queue.append(node)


def settle_demands(
    mut state: PropagationState,
    catalogs: Dict[str, RustDependencyCatalog],
    base: ActivationContext,
    bindings: list[CheckedSlotBinding],
    manifest: str,
    max_rounds: int,
) -> Result[None, IntakeError]:
    """Activate each queued policy node, then forward its demand through physical and declared dependency edges."""
    while len(state.queue) > 0:
        policy_node = state.queue.popleft()
        node = policy_node.node
        state.rounds += 1
        if state.rounds > max_rounds:
            return Err(rounds_exhausted(manifest, max_rounds))
        key = activation_key(policy_node)
        demand = state.demands[key]
        package = package_key(node.package)
        if package not in catalogs:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Missing,
                    manifest=manifest,
                    field=["catalogs", package],
                    location=None,
                    detail=f"selected package catalog for {node_key(node)}",
                ),
            )
        unit = catalogs[package]
        context = demanded(base, demand, node.domain, policy_node.purpose)
        activation = activate_unit(unit, context, manifest)?
        state.settled[key] = activation

        propagate_internal_edges(state, bindings, policy_node, demand, manifest)?
        propagate_active_slots(state, bindings, policy_node, unit, activation, catalogs, manifest)?
    return Ok(None)


def reach_normal_child(mut state: PropagationState, identity: str, manifest: str) -> Result[bool, IntakeError]:
    """Admit normal child reachability, refusing reuse of a physical unit already serving a test activation."""
    if identity in state.unit_purposes and state.unit_purposes[identity] != ActivationPurpose.Normal:
        return Err(
            IntakeError(
                kind=IntakeErrorKind.Invalid,
                manifest=manifest,
                field=["bindings", identity],
                location=None,
                detail="one physical unit cannot serve both normal and test activations",
            ),
        )
    newly_reached = identity not in state.unit_purposes
    state.unit_purposes[identity] = ActivationPurpose.Normal
    return Ok(newly_reached)


def propagate_internal_edges(
    mut state: PropagationState,
    bindings: list[CheckedSlotBinding],
    parent: PolicyNode,
    demand: NodeDemand,
    manifest: str,
) -> Result[None, IntakeError]:
    """Reach same-package libraries with the parent's settled demand rather than the child's observed features."""

    for physical in bindings:
        if not has_active_physical_parent(physical, parent.node, parent.purpose, state.unit_purposes):
            continue
        if not physical.internal:
            continue
        newly_reached = reach_normal_child(state, physical.child_unit, manifest)?
        child = PolicyNode(node=physical.child, purpose=ActivationPurpose.Normal)
        incoming = NodeDemand(features=demand.features, default_features=demand.default_features)
        enqueue_demand(state, child, incoming, newly_reached)
    return Ok(None)


def propagate_active_slots(
    mut state: PropagationState,
    bindings: list[CheckedSlotBinding],
    parent: PolicyNode,
    unit: RustDependencyCatalog,
    activation: RustActivation,
    catalogs: Dict[str, RustDependencyCatalog],
    manifest: str,
) -> Result[None, IntakeError]:
    """Forward each uniquely named active declaration through its exact selected child binding."""
    for slot in activation.slots:
        if let SlotActivation.Active(features, defaults, _) = slot.activation:
            declaration = unit.dependencies[slot.index]
            require_unique_active_alias(unit, activation, declaration, manifest)?
            binding = binding_for(
                bindings, parent.node, parent.purpose, state.unit_purposes, declaration, catalogs, manifest,
            )?
            validate_selected_child(binding, parent.node, declaration, manifest)?
            added_physical = reach_declared_children(
                state, bindings, parent, declaration, binding, catalogs, manifest,
            )?
            child = PolicyNode(node=binding.child, purpose=ActivationPurpose.Normal)
            incoming = NodeDemand(features=features, default_features=defaults)
            enqueue_demand(state, child, incoming, added_physical)
    return Ok(None)


def require_unique_active_alias(
    unit: RustDependencyCatalog,
    activation: RustActivation,
    declaration: RustDependencyDeclaration,
    manifest: str,
) -> Result[None, IntakeError]:
    """Refuse a raw alias unless exactly one active manifest declaration owns it."""
    mut active_aliases = 0
    for candidate in activation.slots:
        if unit.dependencies[candidate.index].alias == declaration.alias:
            if let SlotActivation.Active(_, _, _) = candidate.activation:
                active_aliases += 1
    if active_aliases != 1:
        return Err(
            IntakeError(
                kind=IntakeErrorKind.Invalid, manifest=manifest, field=declaration.field, location=None,
                detail="raw selected edge alias does not name exactly one active declaration",
            ),
        )
    return Ok(None)


def validate_selected_child(
    binding: CheckedSlotBinding,
    parent: GraphNode,
    declaration: RustDependencyDeclaration,
    manifest: str,
) -> Result[None, IntakeError]:
    """Check the selected child's package, version and host/target domain against its owning declaration."""
    if declaration.package != binding.child.package.package:
        return Err(
            IntakeError(
                kind=IntakeErrorKind.Invalid, manifest=manifest, field=declaration.field + ["package"], location=None,
                detail="manifest package name disagrees with the admitted selected child",
            ),
        )
    if let Some(requirement) = declaration.version_requirement:
        if not version_matches(requirement, binding.child.package.version, manifest)?:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid, manifest=manifest,
                    field=declaration.field + ["version"], location=None,
                    detail="selected child version does not satisfy the manifest requirement",
                ),
            )
    mut expected_domain = parent.domain
    if binding.child_is_proc_macro:
        expected_domain = DependencyDomain.Host
    if binding.child.domain != expected_domain:
        return Err(
            IntakeError(
                kind=IntakeErrorKind.Invalid, manifest=manifest, field=declaration.field, location=None,
                detail="resolved child domain disagrees with parent propagation or proc-macro role",
            ),
        )
    return Ok(None)


def reach_declared_children(
    mut state: PropagationState,
    bindings: list[CheckedSlotBinding],
    parent: PolicyNode,
    declaration: RustDependencyDeclaration,
    selected: CheckedSlotBinding,
    catalogs: Dict[str, RustDependencyCatalog],
    manifest: str,
) -> Result[bool, IntakeError]:
    """Reach every physical child of one declaration, requiring agreement with its selected policy identity."""
    mut added_physical = false
    for physical in bindings:
        if not has_active_physical_parent(physical, parent.node, parent.purpose, state.unit_purposes):
            continue
        if not edge_names_declaration(physical, declaration, catalogs) or physical.internal:
            continue
        if physical.child != selected.child or physical.child_is_proc_macro != selected.child_is_proc_macro:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid, manifest=manifest, field=declaration.field, location=None,
                    detail="physical units disagree on the selected child for one manifest alias",
                ),
            )
        if reach_normal_child(state, physical.child_unit, manifest)?:
            added_physical = true
    return Ok(added_physical)


def reconcile_features(
    state: PropagationState, units: list[AdmittedSelectedUnit], manifest: str,
) -> Result[None, IntakeError]:
    """Require every reached physical unit's effective features to equal its settled policy activation."""

    # Reconcile only after every declaration demand has reached its fixed point. The raw selected graph records the
    # actual effective features for each physical unit; policy is valid only when every reachable unit, including
    # compiler release support, agrees with the settled package/domain/purpose activation it participates in.
    # Default intent is derived policy state, never a raw-unit claim.
    for unit in units:
        if unit.identity not in state.unit_purposes:
            continue
        policy_node = PolicyNode(node=unit.node, purpose=state.unit_purposes[unit.identity])
        key = activation_key(policy_node)
        if key not in state.settled or key not in state.demands:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Missing,
                    manifest=manifest,
                    field=["units", unit.identity],
                    location=None,
                    detail="settled feature policy for reachable selected unit",
                ),
            )
        if sorted(unit.features) != state.settled[key].effective_features:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid,
                    manifest=manifest,
                    field=["units", unit.identity, "features"],
                    location=None,
                    detail="authenticated selected-unit features disagree with settled feature policy",
                ),
            )

    return Ok(None)


def reconcile_bindings(
    state: PropagationState,
    bindings: list[CheckedSlotBinding],
    catalogs: Dict[str, RustDependencyCatalog],
    manifest: str,
) -> Result[None, IntakeError]:
    """Require reachable parents and exactly one active declaration for every external physical edge."""
    for binding in bindings:
        if binding.parent_unit not in state.unit_purposes:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid,
                    manifest=manifest,
                    field=["bindings"],
                    location=None,
                    detail=f"resolved binding has unreachable parent {node_key(binding.parent)}",
                ),
            )
        if binding.internal:
            continue
        parent_policy = PolicyNode(node=binding.parent, purpose=state.unit_purposes[binding.parent_unit])
        parent_activation = state.settled[activation_key(parent_policy)]
        parent_catalog = catalogs[package_key(binding.parent.package)]
        mut matched = false
        for slot in parent_activation.slots:
            declaration = parent_catalog.dependencies[slot.index]
            if edge_names_declaration(binding, declaration, catalogs):
                match slot.activation:
                    SlotActivation.Inactive(_) => pass
                    SlotActivation.Active(_, _, _) =>
                        if matched:
                            return Err(
                                IntakeError(
                                    kind=IntakeErrorKind.Invalid,
                                    manifest=manifest,
                                    field=declaration.field,
                                    location=None,
                                    detail="raw selected edge alias maps to more than one active manifest declaration",
                                ),
                            )
                        matched = true
        if not matched:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Missing,
                    manifest=manifest,
                    field=["bindings", binding.parent_unit, binding.alias],
                    location=None,
                    detail="manifest declaration for raw selected edge alias",
                ),
            )
    return Ok(None)


def require_reachable_units(
    state: PropagationState, units: list[AdmittedSelectedUnit], manifest: str,
) -> Result[None, IntakeError]:
    """Refuse physical units not reachable from the admitted roots and active edges."""
    for unit in units:
        if unit.identity not in state.unit_purposes:
            return Err(
                IntakeError(
                    kind=IntakeErrorKind.Invalid,
                    manifest=manifest,
                    field=["units", unit.identity],
                    location=None,
                    detail="selected physical unit is unreachable from the admitted roots and edges",
                ),
            )
    return Ok(None)


def graph_activation(state: PropagationState) -> GraphActivation:
    """Collect settled activations in first-reached order without exposing repeated queue visits."""
    mut activations: list[RustActivation] = []
    mut activation_defaults: list[bool] = []
    mut reached: list[GraphNode] = []
    mut reached_purposes: list[ActivationPurpose] = []
    for policy_node in state.order:
        key = activation_key(policy_node)
        if key in state.settled:
            reached.append(policy_node.node)
            reached_purposes.append(policy_node.purpose)
            activations.append(state.settled[key])
            activation_defaults.append(state.demands[key].default_features)
    return GraphActivation(
        nodes=reached,
        purposes=reached_purposes,
        activations=activations,
        default_features=activation_defaults,
        unit_purposes=state.unit_purposes,
        rounds=state.rounds,
    )


def node_key(node: GraphNode) -> str:
    """
    Identity for the demand table.

    The domain is part of the key, never a detail beside it: the same package compiled for a host procedural-macro
    closure and for the target are two nodes, and merging them would leak host-tool features into the shipped unit.
    """
    if node.domain == DependencyDomain.Host:
        return f"host::{package_key(node.package)}"
    return f"target::{package_key(node.package)}"


def activation_key(node: PolicyNode) -> str:
    """Keep explicit test-root policy separate from the normal activation of the same package and domain."""
    if node.purpose == ActivationPurpose.Test:
        return f"test::{node_key(node.node)}"
    return f"normal::{node_key(node.node)}"


pub def package_key(identity: SelectedPackageIdentity) -> str:
    """
    Canonical internal key without treating package name alone as selected identity.

    Each length prefix preserves field boundaries so distinct source, package, and version splits cannot collide.
    """
    source = f"{len(identity.source)}:{identity.source}"
    package = f"{len(identity.package)}:{identity.package}"
    version = f"{len(identity.version)}:{identity.version}"
    return source + package + version
