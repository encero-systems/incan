"""
Replay compiler-certified deterministic outcomes under the same complete identity as compiled outputs.

Two outcomes are retained with their exact stdout and stderr bytes and their status: a unit compilation the compiler
refuses with source diagnostics, and a check whose report unchanged inputs reproduce. A normal repeat of the same
identity replays them without starting a compiler. Crashes, signals, uncertified failures, missing linked artifacts and
inputs that changed while the compiler ran are never retained.

Both are facts of the home bakery (see `bakery`): a refusal or check report is baked once under its identity, and a
crash or an I/O failure publishes nothing.

A retained stream names the producing project's locations relative to its root, and a replay renders them under the
requesting project's root, so the same identity replays at any path exactly as a fresh compiler run there prints.
"""

from rust::std::io import Write, stderr, stdout
from rust::std::process import Command, Stdio, id
from rust::std::string import String as RustString
from std.environ import get_or
from std.fs import Path
from std.io import BytesIO
from std.json import JsonValue
from bakery import claim, fact_file, find, lookup, seal, staging, unit_name
from driver_command import driver_command
from compiler_worker import Completion, captured_resident
from files import json_text, open_stream
from observation import trace
from owner_client import status_code
from publication import publish_binary
from toolchain import Toolchain
from unit import UnitDescription
from unit_freshness import Key, artifact_files, fingerprint, unit_key
from pub::incan_platform.trace import Operation
from jec import begin, record, invocation_key

const RECORD_SCHEMA: str = "incan.oven.outcome/2"
const REFUSAL_RECEIPT: str = "incan.compiler-refusal/1\n"
const CHECK_RECEIPT: str = "incan.compiler-check/1\n"
const CHECK_DOMAIN: str = "incan.oven.check/2"
const REFUSAL_DOMAIN: str = "incan.oven.refusal/2"
const OUTCOME: str = "outcome"
# Stands for the producing project's root in a retained stream; a replay writes the requesting project's root there.
const PROJECT_ROOT: str = "{incan.oven:project-root}"
const MAX_STATUS: int = 255


pub def compile_or_replay(
    unit: UnitDescription,
    toolchain: Toolchain,
    invocation: list[str],
    options: list[str],
    store: Path,
    key: Key,
    reason: str,
) -> Result[i32, str]:
    """
    Preserve compiler outcomes and retain only certified, normally exited refusals of unchanged inputs.

    `invocation` is the compiler command with its positional arguments and `options` its native options; the
    certification path goes between them, where the compiler reads it.

    1. Replay a complete matching refusal unless a caller requested compiler side effects.
    2. Compile through the resident worker, or one compiler process, with a fresh, private certification path.
    3. Publish a certified refusal only if the complete input identity is still unchanged.
    """
    # 1. Replay a complete matching refusal unless a caller requested compiler side effects.
    refused = refusal_identity(key)?
    cacheable = key.refusal == "" and ordinary_compilation() and complete_artifacts(unit)?
    if cacheable:
        if let Some(refusal) = load_outcome(store, refused, unit.project_root)?:
            trace(f"unit {unit.package} {unit.kind}: replayed refusal")
            return show(refusal, toolchain.console)
    # 2. The worker and a single process capture the same streams; only the compiler's receipt certifies a refusal.
    trace(f"unit {unit.package} {unit.kind}: compiled ({reason})")
    certificate = fresh_certificate(store, refused)?
    refusal = completed(toolchain, invocation + ["--certify", certificate.0] + options)?
    # 3. Publish a certified refusal only if the complete input identity is still unchanged.
    if cacheable and refusal.exited and refusal.code == 1 and certified(certificate, REFUSAL_RECEIPT):
        if still_keyed(unit, toolchain, key):
            _ = retain_outcome(store, refused, "refusal", outcome_name(unit, ""), refusal, unit.project_root)
    withdraw(certificate)
    return show(refusal, toolchain.console)


pub def check_or_replay(
    unit: UnitDescription,
    toolchain: Toolchain,
    description: Path,
    format: str,
    store: Path,
    key: Key,
) -> Result[i32, str]:
    """
    Replay the report of an unchanged check, or check and retain a certified report under the same identity rules.

    The record's identity is content alone: the unit's key, which covers its inputs, their project-relative names, the
    toolchain and the configuration, and the report format. No location enters it, so a copy of the project at another
    path, in the same home, replays the report in its own paths.

    1. Replay a complete record of this identity unless a caller requested compiler side channels.
    2. Check through the resident worker, or one compiler process, with a fresh certification path.
    3. Retain a certified, normally completed report only while the unit's inputs are still those of the key.
    """
    label = f"unit {unit.package} check"
    identity = fingerprint([CHECK_DOMAIN, key.digest, format])?
    arguments = ["--check", description.0, toolchain.sysroot, "--format", format]
    # 1. A stored report of this identity is shown as the compiler printed it, in this project's paths.
    cacheable = key.refusal == "" and ordinary_compilation() and complete_artifacts(unit)?
    if cacheable:
        if let Some(report) = load_outcome(store, identity, unit.project_root)?:
            trace(f"{label}: replayed")
            return show(report, toolchain.console)
    # 2. The compiler certifies only a pass or a refusal by source diagnostics.
    trace(f"{label}: checked ({check_reason(store, outcome_name(unit, format))})")
    certificate = fresh_certificate(store, identity)?
    report = completed(toolchain, arguments + ["--certify", certificate.0])?
    # 3. A crash, a signal, an uncertified failure or an edit made meanwhile is checked again next time.
    if cacheable and reported(report) and certified(certificate, CHECK_RECEIPT):
        if still_keyed(unit, toolchain, key):
            _ = retain_outcome(store, identity, "check", outcome_name(unit, format), report, unit.project_root)
    withdraw(certificate)
    return show(report, toolchain.console)


def completed(toolchain: Toolchain, arguments: list[str]) -> Result[Completion, str]:
    """
    Run a unit compilation or a check in the resident worker, or in one compiler process when no worker can start.
    A request submitted to the worker is never run again in another process, whatever its outcome.
    """
    match captured_resident(toolchain, arguments)?:
        Some(found) => return Ok(found)
        None => return cold_completion(toolchain, arguments)


def reported(report: Completion) -> bool:
    """Whether a check exited normally with a report's own status: zero for a pass, one for a refusal."""
    return report.exited and (report.code == 0 or report.code == 1)


def check_reason(store: Path, name: str) -> str:
    """Why a check runs: no report was stored for the unit yet, or the stored one is for other inputs."""
    match lookup(store, name):
        Ok(found) =>
            if found is not None:
                return "inputs changed"
        Err(_) => pass
    return "no stored report"


def outcome_name(unit: UnitDescription, format: str) -> str:
    """The name a retained outcome is indexed under: the unit, and for a check its report format."""
    mut name = unit_name(unit)
    if format != "":
        name += f"\tcheck {format}"
    return name


def ordinary_compilation() -> bool:
    """Explicit diagnostic side channels require a real compiler invocation on every request."""
    return get_or("INCAN_DIRECT_REFUSAL_REPORT", "") == "" and get_or("INCAN_DIRECT_SEMANTIC_REPORT", "") == ""


def complete_artifacts(unit: UnitDescription) -> Result[bool, str]:
    """A missing linked artifact is a preparation failure and must be retried even beside a source diagnostic."""
    for loaf in unit.loaves:
        for artifact in artifact_files(Path(loaf.dir), loaf.name)?:
            if not artifact.is_file():
                return Ok(false)
    return Ok(true)


def cold_completion(toolchain: Toolchain, arguments: list[str]) -> Result[Completion, str]:
    """
    Run one compiler process with its exact streams captured; a process ended by a signal has status one and no
    normal exit.
    """
    mut command = driver_command(toolchain)?
    command.stdin(Stdio.inherit())
    for argument in arguments:
        command.arg(argument)
    clock = begin()
    result = command.output().map_err((error) => f"cannot run {toolchain.driver}: {error}")?
    record(Operation.DriverSpawn, invocation_key(arguments), clock)
    mut code: i32 = 1
    mut exited = false
    if let Some(status) = result.status.code():
        code = status
        exited = true
    return Ok(Completion(code=code, exited=exited, output=result.stdout, error=result.stderr))


def fresh_certificate(store: Path, identity: str) -> Result[Path, str]:
    """A private receipt path in the bakery, in an existing directory and empty before the compiler runs."""
    receipts = store.joinpath("receipts")
    receipts.mkdir(true, true).map_err((error) => f"{receipts.0}: {error.message()}")?
    certificate = receipts.joinpath(f"{identity}.{id()}.certificate")
    if certificate.is_file():
        certificate.unlink().map_err((error) => error.message())?
    return Ok(certificate)


def certified(path: Path, receipt: str) -> bool:
    """An absent, unreadable or unrecognized certificate never authorizes retention."""
    if not path.is_file():
        return false
    match path.read_text("utf-8", "strict"):
        Err(_) => return false
        Ok(text) => return text == receipt


def still_keyed(unit: UnitDescription, toolchain: Toolchain, key: Key) -> bool:
    """Whether the unit's inputs are still those the compiler ran for; a failed reconciliation counts as a change."""
    match unit_key(unit, toolchain):
        Ok(current) => return current.digest == key.digest
        Err(_) => return false


def withdraw(certificate: Path) -> None:
    """Remove a receipt once it has been read; one that stays is replaced by the next run."""
    if certificate.is_file():
        _ = certificate.unlink()


def show(outcome: Completion, console: str) -> Result[i32, str]:
    """Forward exact bytes to the foreground streams or the project owner's request-local console sinks."""
    if console != "":
        mut out = open_stream(f"{console}.out")?
        match out.write_all(outcome.output):
            Err(error) => return Err(str(error))
            Ok(_) => pass
        mut err = open_stream(f"{console}.err")?
        match err.write_all(outcome.error):
            Err(error) => return Err(str(error))
            Ok(_) => pass
        return Ok(outcome.code)
    mut out = stdout()
    match out.write_all(outcome.output):
        Err(error) => return Err(str(error))
        Ok(_) => pass
    mut err = stderr()
    match err.write_all(outcome.error):
        Err(error) => return Err(str(error))
        Ok(_) => pass
    return Ok(outcome.code)


def retain_outcome(
    store: Path,
    identity: str,
    kind: str,
    name: str,
    outcome: Completion,
    root: str,
) -> Result[None, str]:
    """
    Bake a certified outcome as the fact of `identity`, once: a concurrent retention of the same outcome waits.

    The fact names the locations under the project's `root` relative to it; an outcome that cannot be stated that way
    is not retained, so it is produced again rather than replayed with another project's locations.
    """
    match relative_outcome(outcome, root):
        None => return Ok(None)
        Some(relative) =>
            held = claim(store, identity)?
            if find(store, identity)? is None:
                staged = staging(store, identity)?
                save_outcome(staged.joinpath(OUTCOME), identity, relative)?
                _ = seal(store, identity, staged, kind, name, [], "certified compiler outcome")?
            return Ok(None)


def relative_outcome(outcome: Completion, root: str) -> Option[Completion]:
    """The outcome with both streams relative to the project's `root`, or None when either cannot be."""
    if not relocatable_root(root):
        return None
    match relative_stream(outcome.output, root):
        None => return None
        Some(output) =>
            match relative_stream(outcome.error, root):
                None => return None
                Some(error) => return Some(Completion(code=outcome.code, exited=outcome.exited, output=output, error=error))


def relocatable_root(root: str) -> bool:
    """Whether every report spells `root` as it is: an absolute path a JSON report does not escape."""
    if not root.startswith("/"):
        return false
    match json_text(JsonValue.string(root)):
        Ok(text) => return text == f"\"{root}\""
        Err(_) => return false


def relative_stream(stream: bytes, root: str) -> Option[bytes]:
    """
    A stream with each location under `root` named from the placeholder, or None when that would not replay exactly.

    A stream that already holds the placeholder, or still names the root after relocation (alone, or as the start of
    another directory's name), is refused. Bytes that are not text are kept as printed only when they name no root.
    """
    match stream.decode("utf-8", "strict"):
        Ok(text) =>
            if PROJECT_ROOT in text:
                return None
            if root not in text:
                return Some(stream)
            relative = text.replace(f"{root}/", f"{PROJECT_ROOT}/")
            if root in relative:
                return None
            return Some(relative.encode("utf-8"))
        Err(_) =>
            match stream.decode("utf-8", "replace"):
                Ok(lossy) =>
                    if PROJECT_ROOT in lossy or root in lossy:
                        return None
                    return Some(stream)
                Err(_) => return None


def rendered(outcome: Completion, root: str) -> Completion:
    """A retained outcome with its locations under the requesting project's `root`; only the record is read."""
    return Completion(
        code=outcome.code,
        exited=outcome.exited,
        output=rendered_stream(outcome.output, root),
        error=rendered_stream(outcome.error, root),
    )


def rendered_stream(stream: bytes, root: str) -> bytes:
    """A retained stream with the placeholder replaced by `root`; a stream without it is shown as stored."""
    match stream.decode("utf-8", "strict"):
        Ok(text) =>
            if PROJECT_ROOT in text:
                return text.replace(PROJECT_ROOT, root).encode("utf-8")
        Err(_) => pass
    return stream


pub def outcome_record(store: Path, identity: str) -> Result[Option[Path], str]:
    """The retained outcome file of `identity`, when it is baked."""
    match find(store, identity)?:
        Some(fact) => return Ok(fact_file(store, fact, OUTCOME))
        None => return Ok(None)


pub def refusal_identity(key: Key) -> Result[str, str]:
    """The identity a compilation's certified refusal is retained under."""
    return fingerprint([REFUSAL_DOMAIN, key.digest])


def save_outcome(path: Path, identity: str, outcome: Completion) -> Result[None, str]:
    """Publish the status and framed raw streams in one atomic file; replay never decodes or re-encodes their bytes."""
    header = f"{RECORD_SCHEMA}\n{identity}\n{outcome.code}:{len(outcome.output)}:{len(outcome.error)}\n"
    content = BytesIO(header.encode("utf-8"))
    content.seek(0, 2).map_err((error) => error.message())?
    content.write_bytes(outcome.output).map_err((error) => error.message())?
    content.write_bytes(outcome.error).map_err((error) => error.message())?
    return publish_binary(path, content.getvalue())


def load_outcome(store: Path, identity: str, root: str) -> Result[Option[Completion], str]:
    """A retained outcome rendered under the project's `root`; a missing, malformed or damaged record is a miss."""
    match outcome_record(store, identity)?:
        None => return Ok(None)
        Some(record) =>
            match read_outcome(record, identity):
                Err(_) => return Ok(None)
                Ok(found) =>
                    match found:
                        None => return Ok(None)
                        Some(outcome) => return Ok(Some(rendered(outcome, root)))


def read_outcome(path: Path, identity: str) -> Result[Option[Completion], str]:
    """Validate the bounded header, the status and both byte lengths before releasing either stream to the caller."""
    content = path.read_bytes().map_err((error) => error.message())?
    prefix = f"{RECORD_SCHEMA}\n{identity}\n".encode("utf-8")
    if content[:len(prefix)] != prefix:
        return Ok(None)
    mut end = len(prefix)
    while end < len(content) and end - len(prefix) < 24 and content[end:end + 1] != b"\x0a":
        end += 1
    if end >= len(content) or content[end:end + 1] != b"\x0a":
        return Ok(None)
    mut header = ""
    match RustString.from_utf8(content[len(prefix):end]):
        Err(_) => return Ok(None)
        Ok(text) => header = str(text)
    fields = header.split(":")
    if len(fields) != 3:
        return Ok(None)
    code = decimal(fields[0])?
    output = decimal(fields[1])?
    error = decimal(fields[2])?
    first = end + 1
    if code > MAX_STATUS or len(content) != first + output + error:
        return Ok(None)
    printed = content[first:first + output]
    complained = content[first + output:]
    return Ok(Some(Completion(code=status_code(code), exited=true, output=printed, error=complained)))


def decimal(text: str) -> Result[int, str]:
    """Accept only bounded decimal numbers before converting an untrusted record header."""
    if len(text) == 0 or len(text) > 9:
        return Err("invalid outcome record number")
    for character in text:
        if character not in "0123456789":
            return Err("invalid outcome record number")
    return Ok(int(text))
