"""Oven's path adapter at the platform store boundary."""

from std.fs import Path
from pub::incan_platform.store.path import StorePath


pub def store_path(path: Union[Path, StorePath]) -> StorePath:
    """Project an Oven facade path into the platform store's private path contract."""
    if isinstance(path, StorePath):
        return path
    elif isinstance(path, Path):
        return StorePath(path.0)


pub def oven_path(path: StorePath) -> Path:
    """Project a platform store path back into Oven's application-facing path contract."""
    return Path(path.0)
