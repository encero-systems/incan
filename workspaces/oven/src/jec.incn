"""Keep the existing JEC call surface as an adapter over platform observations."""

from pub::incan_platform.trace import Clock
from trace_adapter import work_clock, work


pub def begin() -> Option[Clock]:
    """Start only a requested JEC or canonical engine observation."""
    return work_clock()


pub def record(category: str, input: str, clock: Option[Clock], bytes: int = 0) -> None:
    """Record measured work through the platform; the JEC switch selects its compatibility export."""
    work(category, input, clock, bytes)


pub def text_size(content: str, clock: Option[Clock]) -> int:
    """Count UTF-8 payload bytes only for an enabled observation."""
    match clock:
        None => return 0
        Some(_) => return len(content.encode("utf-8"))


pub def invocation_key(arguments: list[str]) -> str:
    """Identify the ordinary command and its input independently of private console and receipt paths."""
    return " ".join(arguments[:2])
