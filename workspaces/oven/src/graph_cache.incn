"""Content-addressed inspection projections and source observations owned by the requesting home."""

from rust::std::string import String as RustString
from std.fs import Path
from files import make_directory, read
from home import home
from driver_command import driver_command
from toolchain import Toolchain
from observation import Ledger, SETTLE_SECONDS, load_ledger, skipped_directory, trace
from publication import publish
from unit_freshness import fingerprint


pub model GraphUnit:
    """One portable graph and the source root under which this consumer presents its Loaf-relative anchors."""

    pub path: Path
    pub root: Path
    pub package: str = ""
    pub version: str = ""
    # Only source-backed exports observe current authored bytes; published Loaves remain bound to their artifact.
    pub source_root: str = ""


pub def unchecked_marker(graph: Path) -> Path:
    """The note beside a unit's graph entry when not all its facts are checked; a checked graph has none."""
    return Path(f"{graph.0}.unchecked")


pub def is_unchecked(graph: Path) -> bool:
    """Whether the unit behind this graph entry failed checking, so it publishes no interface and no checked facts."""
    return unchecked_marker(graph).is_file()


pub def unchecked_note(graph: Path) -> Result[str, str]:
    """Read why a unit is unchecked: its name, what it still contributes, a summary and one line per diagnostic."""
    marker = unchecked_marker(graph)
    if not marker.is_file():
        return Ok("")
    return read(marker)


pub def publish_unchecked(graph: Path, name: str, consequence: str, reason: str) -> Result[None, str]:
    """Record an unchecked unit beside its entry, before the entry itself, so no reader sees an unmarked entry."""
    return publish(unchecked_marker(graph), f"{name}\n{consequence}\n{reason}")


def note_line(note: str, index: int) -> str:
    """One line of an unchecked note, empty when the note has fewer lines."""
    lines = note.split("\n")
    if index >= len(lines):
        return ""
    return lines[index]


pub def unchecked_warning(note: str) -> str:
    """The warning line a query prints for an unchecked unit: its name, consequence, summary and first diagnostic."""
    mut first = note_line(note, 3)
    if first.startswith("- "):
        first = first[2:]
    mut detail = note_line(note, 2)
    if first != "":
        detail = f"{detail}; first {first}"
    return f"warning: {note_line(note, 0)} is unchecked, {note_line(note, 1)} ({detail})"


pub def unchecked_refusal(note: str) -> str:
    """Strict export names the unit and lists every diagnostic the unit's check produced."""
    details = note.split("\n")[2:]
    return f"codegraph export failed because {note_line(note, 0)} is unchecked\n" + "\n".join(details)


pub def stamp_file(unit: GraphUnit) -> Path:
    """The file that identifies a unit's facts: its graph, or the note of a unit that produced none."""
    if unit.path.is_file():
        return unit.path
    return unchecked_marker(unit.path)


pub def read_graph(unit: GraphUnit, toolchain: Toolchain, group: str, fields: str = "") -> Result[str, str]:
    """Decode indexed records with an optional field projection; only storage runs, never checking or codegen."""
    if not unit.path.is_file() and is_unchecked(unit.path):
        return Ok("")
    mut command = driver_command(toolchain)?
    for argument in ["--read-codegraph", unit.path.0, unit.root.0, group]:
        command.arg(argument)
    if fields != "":
        command.arg(fields)
    result = command.output().map_err((error) => str(error))?
    if not result.status.success():
        return Err(output_text(result.stderr)?)
    return output_text(result.stdout)


pub def output_text(content: bytes) -> Result[str, str]:
    """Graph query output is a UTF-8 protocol; invalid bytes refuse instead of silently replacing characters."""
    match RustString.from_utf8(content):
        Ok(value) => return Ok(str(value))
        Err(_) => return Err("graph reader returned non-UTF-8 output")


pub def tree_inputs(root: Path) -> Result[list[str], str]:
    """
    Return the existing ordered content keys, including manifests and assets, excluding build outputs.

    1. Load observations under this consumer's home, even for a source tree outside its project.
    2. Read directory entries and reconcile file digests in their original traversal order.
    3. Save changed observations; their metadata never enters the content key.
    """
    # 1. Load observations for this root.
    mut ledger = graph_observations(root)?
    # 2. Keep the original file ordering and content digests.
    inputs = observed_tree(root, ledger)?
    # 3. Retain only the work that can be reused next time.
    save_observations(ledger)
    return Ok(inputs)


pub def content_facts(root: Path) -> Result[tuple[list[str], bool], str]:
    """
    Identify exact source bytes and logical alias bindings without retaining physical source anchors.

    Source aliases inside the project name their resolved project-relative binding. An alias outside it cannot be
    rendered under another project's root, so the caller must not retain that checked export.
    """
    observed = tree_inputs(root)?
    mut base = root
    if root.is_file():
        base = root.parent()
    canonical_root = base.resolve().map_err((error) => error.message())?
    mut inputs: list[str] = []
    mut portable = true
    for index in range(0, len(observed), 2):
        path = observed[index]
        mut name = Path(path).name()
        if path.startswith(root.0 + "/"):
            name = path[len(root.0) + 1:]
        inputs.extend(["file", name, observed[index + 1]])
        canonical = Path(path).resolve().map_err((error) => error.message())?
        if not canonical.0.startswith(canonical_root.0 + "/"):
            portable = false
        elif canonical.0 != path:
            inputs.extend(["alias", name, canonical.0[len(canonical_root.0) + 1:]])
    return Ok((inputs, portable))

pub def interface_inputs(directory: Path, package: str) -> Result[list[str], str]:
    """Identify only the interface and native fact cache the checker reads, excluding publication provenance."""
    mut ledger = graph_observations(directory)?
    mut inputs: list[str] = []
    for suffix in ["incnlib", "rustabi"]:
        path = directory.joinpath(f"{package}.{suffix}")
        if path.is_file():
            inputs.extend([suffix, ledger.digest(path)?])
    save_observations(ledger)
    return Ok(inputs)


def graph_observations(root: Path) -> Result[Ledger, str]:
    """Keep inspection's optional observations in its own home, never inside a selected external source or artifact."""
    name = fingerprint([root.0])?
    directory = home()?.joinpath("cache").joinpath("codegraph-observations")
    return Ok(load_ledger(directory.joinpath(f"{name}.json"), SETTLE_SECONDS, ""))


pub def save_observations(mut ledger: Ledger) -> None:
    """An unavailable optional cache must leave inspection using the exact freshly computed content digests."""
    match ledger.save():
        Ok(_) => pass
        Err(reason) => trace(f"graph observations not retained: {reason}")


def observed_tree(root: Path, mut ledger: Ledger) -> Result[list[str], str]:
    """Preserve tree selection, ordering and read failures while reconciling file digests against observations."""
    if root.is_file():
        return Ok([root.0, ledger.digest(root)?])
    mut by_name: Dict[str, Path] = {}
    for entry in root.iterdir().map_err((error) => f"{root.0}: {error.message()}")?:
        name = entry.name()
        if skipped_directory(name):
            continue
        by_name[name] = entry
    mut inputs: list[str] = []
    for name in sorted([key for key in by_name.keys()]):
        for value in observed_tree(by_name[name], ledger)?:
            inputs.append(value)
    return Ok(inputs)


pub def cache_file(digest: str) -> Result[Path, str]:
    """Locate a home-owned projection; its key retains every anchor the rendered bytes depend on."""
    directory = home()?.joinpath("cache").joinpath("codegraph-projections")
    make_directory(directory)?
    return Ok(directory.joinpath(f"{digest}.incngraph"))
