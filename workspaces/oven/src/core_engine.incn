"""Dispatch the sealed Oven engine's versioned request schemas without weakening their individual decoders."""

from std.json import JsonValue, parse
from plan_json import evaluate as evaluate_selection
from rust_policy_exchange import evaluate as evaluate_rust_policy
from loaf_closure_exchange import evaluate as evaluate_loaf_closure
from target_predicate_exchange import evaluate as evaluate_target_predicates
from lock_preparation import evaluate as evaluate_lock_preparation

const RUST_POLICY_SCHEMA: str = "incan.oven.rust-policy-exchange/5"
const TARGET_PREDICATE_SCHEMA: str = "incan.oven.target-predicates/1"
const LOAF_CLOSURE_SCHEMA: str = "incan.oven.loaf-closure-request/1"
const LOCK_PREPARATION_SCHEMA: str = "incan.oven.lock-preparation/1"


pub def evaluate(source: str) -> JsonValue:
    """Route recognized policy schemas through their strict decoder; selection schemas retain their original decoder."""
    if let Ok(document) = parse(source):
        if let Some(schema) = document.get("schema"):
            match schema.as_str():
                Some(name) =>
                    if name == RUST_POLICY_SCHEMA:
                        return evaluate_rust_policy(source)
                    if name == TARGET_PREDICATE_SCHEMA:
                        return evaluate_target_predicates(source)
                    if name == LOAF_CLOSURE_SCHEMA:
                        return evaluate_loaf_closure(source)
                    if name == LOCK_PREPARATION_SCHEMA:
                        return evaluate_lock_preparation(source)
                None => pass
    return evaluate_selection(source)
