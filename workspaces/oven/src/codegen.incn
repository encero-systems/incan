"""Select profile settings for native Incan units and Rust facets."""


model CodegenProfile:
    """Code-generation settings for Incan units and Rust facets."""

    incan_flags: list[str]
    rust_flags: list[str]
    # Native Incan debug information is serialized in the unit's reuse identity.
    debug_info: int = 2


pub def native_debug_info(profile: str) -> int:
    """Return the native Incan debug-information level selected by the profile."""
    return selected_profile(profile).debug_info


pub def native_arguments(profile: str) -> list[str]:
    """Bind optimization into the unit identity while preserving the native driver's debug assertion policy."""
    return [f"-C{argument}" for argument in selected_profile(profile).incan_flags]


pub def rust_arguments(profile: str) -> list[str]:
    """Frame the selected profile's Rust flags for a direct rustc invocation."""
    mut arguments: list[str] = []
    for option in selected_profile(profile).rust_flags:
        arguments.append("-C")
        arguments.append(option)
    return arguments


pub def driver_arguments(profile: str) -> list[str]:
    """Frame each native argument for the compiler's existing `--rustc-arg` boundary."""
    mut forwarded: list[str] = []
    for argument in native_arguments(profile):
        forwarded.append("--rustc-arg")
        forwarded.append(argument)
    return forwarded


def selected_profile(profile: str) -> CodegenProfile:
    """Select native flags and Incan debug information: full in debug, omitted in release."""
    if profile == "release":
        return CodegenProfile(incan_flags=["opt-level=3"], rust_flags=["opt-level=3", "debuginfo=0"], debug_info=0)
    if profile == "debug":
        return CodegenProfile(incan_flags=["opt-level=0", "debug-assertions=no"], rust_flags=["debuginfo=0"])
    return CodegenProfile(incan_flags=["opt-level=0"], rust_flags=["debuginfo=0"])
