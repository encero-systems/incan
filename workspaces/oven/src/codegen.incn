"""Select optimization flags for native units and frame the flags the Incan compiler receives."""

from rust::std::process import id
from std.environ import get_or
from std.fs import Path

pub const SOURCE_PREFIX: str = "source"


model CodegenProfile:
    """Effective native compiler flags for each authored unit language."""

    incan_flags: list[str]
    rust_flags: list[str]


def selected_profile(profile: str) -> CodegenProfile:
    """One profile table preserves each unit language's optimization, assertions and debug-information policy."""
    profiles = {"debug": CodegenProfile(incan_flags=["opt-level=0", "debug-assertions=no"], rust_flags=["debuginfo=0"]), "release": CodegenProfile(
        incan_flags=["opt-level=3"],
        rust_flags=["opt-level=3", "debuginfo=0"],
    )}
    if profile in profiles:
        return profiles[profile]
    return CodegenProfile(incan_flags=["opt-level=0"], rust_flags=["debuginfo=0"])


pub def native_arguments(profile: str) -> list[str]:
    """Bind optimization into the unit identity while preserving the native driver's debug assertion policy."""
    return [f"-C{argument}" for argument in selected_profile(profile).incan_flags]


pub def rust_arguments(profile: str) -> list[str]:
    """Frame the selected profile's Rust flags for a direct rustc invocation."""
    mut arguments: list[str] = []
    for option in selected_profile(profile).rust_flags:
        arguments = arguments + ["-C", option]
    return arguments


pub def rust_iteration_enabled(profile: str, setting: str) -> bool:
    """Enable debug iteration by default; `1` opts release in and `0` disables iteration for any profile."""
    return (profile in ["debug", "release"] and setting == "1") or (profile == "debug" and setting == "")


pub def rust_metadata(profile: str, context: str) -> str:
    """
    Keep a Rust iteration unit's symbol namespace stable across edits and distinct from qualified artifacts.

    The stable context identifies the crate, domain, features and artifact role. Freshness still covers every source
    and linked input. Qualification keeps the conservative identity-derived namespace unchanged.
    """
    if rust_iteration_enabled(profile, get_or("INCAN_RUST_INCREMENTAL", "")):
        return f"metadata=incan-iteration-{context}"
    return "metadata=incan-unit"


pub def rust_incremental_arguments(directory: Path, arguments: list[str]) -> list[str]:
    """
    Attach local scratch only at the hand-written Rust codegen boundary, after identity is complete.

    Neither the directory nor the flag enters freshness, store records or bundles. Generated native invocations use
    identity-derived metadata and cannot opt in through this boundary, even when the environment requests iteration.
    """
    for argument in arguments:
        if argument.startswith("metadata=incan-iteration-"):
            return ["-C", f"incremental={directory.0}"]
    return []


pub def driver_arguments(profile: str) -> list[str]:
    """Frame each native argument for the compiler's existing `--rustc-arg` boundary."""
    mut forwarded: list[str] = []
    for argument in native_arguments(profile):
        forwarded.append("--rustc-arg")
        forwarded.append(argument)
    return forwarded


pub def unit_metadata(identity: str) -> str:
    """Derive symbol identity from the unit's conservative external identity; refused local bakes stay ephemeral."""
    if identity == "":
        return f"metadata=incan-local-{id()}"
    return "metadata=incan-unit-" + identity.replace("sha256:", "")


pub def remap_arguments(project: str) -> list[str]:
    """Keep compile-time source filenames independent of the checkout containing their bytes."""
    return ["--remap-path-prefix", f"{project}={SOURCE_PREFIX}"]


pub def compiled_arguments(profile: str, identity: str, project: str) -> list[str]:
    """Use one effective profile and symbol identity for Oven and direct native source producers."""
    mut arguments = driver_arguments(profile) + ["--rustc-arg", "-C" + unit_metadata(identity)]
    for argument in remap_arguments(project):
        arguments.extend(["--rustc-arg", argument])
    return arguments
