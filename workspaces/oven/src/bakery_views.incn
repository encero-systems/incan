"""Persist a view's selected unit and, for a bound library, its immutable payload snapshot."""

from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from std.primitives.crumb.descriptions import Description
from std.primitives.crumb.values import Value
from pub::internal_models.crumb_rows import ModelField, model_description, required_value
from pub::internal_models.graph_crumb_fields import decode_graph_row, encode_graph_row, text
from bakery_records import Fact, encode_fact, layout_fact_text
from files import read_json
from json_fields import required_text
from observation import file_metadata
from publication import publish_binary
from unit_freshness import fingerprint

const VIEW_ROW: bytes = b"bakvie\x00"
const FILE_VIEW_ROW: bytes = b"bakfil\x00"
pub const VIEW_RECORD: str = "fact.crumb"
pub const LEGACY_VIEW: str = "fact.json"


pub model ViewSelection:
    """A project selects an identity. A frozen library also names its authenticated membership snapshot."""

    pub identity: str
    pub layout: str = ""
    pub snapshot: bytes = b""
    pub legacy: bool = false


def view_description() -> Description:
    """Encode the immutable generation separately from the selected unit identity."""
    return model_description(
        VIEW_ROW,
        "incan.bakery.view/2",
        [
            ModelField(identity=b"ident_", name="identity", storage="string"),
            ModelField(identity=b"layout", name="layout", storage="string"),
            ModelField(identity=b"legacy", name="legacy_layout", storage="boolean"),
            ModelField(identity=b"snapsh", name="snapshot", storage="binary"),
        ],
    )


pub def layout_identity(fact: Fact, legacy: bool) -> Result[str, str]:
    """Reproduce the fingerprint scheme of the layout being opened."""
    if legacy:
        return fingerprint(["incan.bakery.library-layout/1", layout_fact_text(fact, "library bindings")?])
    return Ok(hexlify(sha256.digest(encode_fact(fact, "library bindings")?)))


pub def write_view(directory: Path, selection: ViewSelection) -> Result[None, str]:
    """Publish the selection atomically after the view's members are present."""
    data = encode_graph_row(
        VIEW_ROW,
        view_description(),
        [
            required_value(b"ident_", Value.Text(selection.identity)),
            required_value(b"layout", Value.Text(selection.layout)),
            required_value(b"legacy", Value.Boolean(selection.legacy)),
            required_value(b"snapsh", Value.Binary(selection.snapshot)),
        ],
    )?
    return publish_binary(directory.joinpath(VIEW_RECORD), data)


pub def read_view(directory: Path) -> Result[Option[ViewSelection], str]:
    """Read the selected generation, including immutable layouts created by previous installations."""
    path = directory.joinpath(VIEW_RECORD)
    if path.is_file():
        data = path.read_bytes().map_err((error) => error.message())?
        fields = decode_graph_row(data, VIEW_ROW, view_description(), 4)?
        legacy = match fields[2].value:
            Value.Boolean(flag) => flag
            _ => return Err("invalid layout version flag")

        snapshot = match fields[3].value:
            Value.Binary(value) => value
            _ => return Err("invalid library snapshot bytes")

        layout = text(fields[1].value)?
        if (layout == "") != (len(snapshot) == 0) or (layout != "" and snapshot[:4] != b"CRMB"):
            return Err("invalid bakery view selection")
        return Ok(Some(ViewSelection(identity=text(fields[0].value)?, layout=layout, snapshot=snapshot, legacy=legacy)))
    previous = directory.joinpath(LEGACY_VIEW)
    if not previous.is_file():
        return Ok(None)
    document = read_json(previous)?
    identity = required_text(document, "identity")?
    if document.get("layout") == None:
        return Ok(Some(ViewSelection(identity=identity, legacy=true)))
    layout = required_text(document, "layout")?
    if layout == "":
        return Err("invalid library layout")
    snapshot = required_text(document, "fact")?.encode("utf-8")
    return Ok(Some(ViewSelection(identity=identity, layout=layout, snapshot=snapshot, legacy=true)))


def file_view_path(path: Path) -> Path:
    """Name the private receipt for a single editable payload view."""
    return Path(f"{path.0}.oven-view")


def file_view_description() -> Description:
    """Bind one observed physical view generation to its verified content."""
    return model_description(
        FILE_VIEW_ROW,
        "incan.bakery.file-view/1",
        [
            ModelField(identity=b"digest", name="digest", storage="string"),
            ModelField(identity=b"stamp_", name="observation", storage="string"),
        ],
    )


pub def observed_file_digest(path: Path, stamp: str) -> Result[Option[str], str]:
    """Read a view's digest only for the filesystem generation whose bytes were verified."""
    receipt = file_view_path(path)
    match file_metadata(receipt)?:
        Some(info) =>
            if not info.is_file() or info.size > 4096:
                return Ok(None)
        None => return Ok(None)
    data = receipt.read_bytes().map_err((error) => error.message())?
    fields = decode_graph_row(data, FILE_VIEW_ROW, file_view_description(), 2)?
    if text(fields[1].value)? != stamp:
        return Ok(None)
    return Ok(Some(text(fields[0].value)?))


pub def remember_file_digest(path: Path, stamp: str, digest: str) -> Result[None, str]:
    """Save the digest observed around a completed read of this settled file generation."""
    data = encode_graph_row(
        FILE_VIEW_ROW,
        file_view_description(),
        [required_value(b"digest", Value.Text(digest)), required_value(b"stamp_", Value.Text(stamp))],
    )?
    return publish_binary(file_view_path(path), data)


pub def forget_view(directory: Path) -> Result[None, str]:
    """Retire typed and earlier selections before replacing a project view."""
    for filename in [VIEW_RECORD, LEGACY_VIEW]:
        path = directory.joinpath(filename)
        if path.is_file():
            path.unlink().map_err((error) => error.message())?
    return Ok(None)
