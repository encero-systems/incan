"""
A program that calls a path-dependency Loaf runs the Loaf's current bodies on the records engine: an edit that moves a
dependency declaration rechecks the program bodies that name it, and an edit elsewhere in the Loaf leaves them checked.
"""

from rust::std::process import Command, Stdio
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue, parse
from files import read, write
from lowering_record_fixtures import attempt_trace, command_proof, proof_count, stop_example_engine
from scratch import scratch_directory
from rust_argument_borrow_return_fixture import require_retained_dependency_reader

const LIBRARY: str = "pub def greeting() -> str:\n    return \"from the library\"\n\n\npub def other() -> str:\n    return \"unchanged\"\n"


model FixtureRun:
    """One records run's engine report and the program's own output after it."""

    pub report: JsonValue
    pub output: str
    pub pid: int


pub def test_a_moved_dependency_declaration_reaches_an_unchanged_program() -> Result[None, str]:
    """
    A longer body in the path dependency moves the declaration the unchanged program calls; the program then prints
    the edited text, as the first engine does.
    """
    scratch = scratch_directory()?
    app = path_dependency_fixture(scratch.path(), "greeting, other", "f\"{greeting()}; {other()}\"")?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = scratch.path().joinpath("store")
    cold = records_run(binary, app, store)?
    assert cold.output == "from the library; unchanged\n", cold.output
    edit_library(scratch.path(), "\"from the library\"", "\"from the edited library\"")?
    edited = records_run(binary, app, store)?
    first = first_engine_run(binary, app, scratch.path().joinpath("first-store"))?
    assert edited.output == first, f"records engine: {edited.output}; first engine: {first}"
    assert edited.output == "from the edited library; unchanged\n", edited.output
    text = edited.report.to_json().map_err((error) => error.message())?
    assert proof_count(edited.report, "body_evaluations")? >= 1, text
    return stop_example_engine(binary, store)


pub def test_an_edit_after_a_dependency_declaration_leaves_its_reader_checked() -> Result[None, str]:
    """
    A longer body after the declaration a program calls leaves that declaration in place, so the program's checked
    body is reused and the program prints what it printed before. An unchanged helper calling a dependency enum's
    generated member also remains reusable when a different consumer module changes.
    """
    scratch = scratch_directory()?
    app = path_dependency_fixture(scratch.path(), "greeting", "greeting()")?
    physical = app.resolve().map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = scratch.path().joinpath("store")
    trace = attempt_trace(scratch.path(), "retained-reader")?
    cold = records_run(binary, physical, store, Some(trace))?
    assert cold.output == "from the library\n", cold.output
    edit_library(scratch.path(), "\"unchanged\"", "\"changed after the greeting\"")?
    edited = records_run(binary, physical, store, Some(trace))?
    assert edited.output == "from the library\n", edited.output
    require_retained_dependency_reader(
        edited.report, trace, edited.pid, "run", physical, scratch.path().joinpath("lib"),
        {"greeting": "main", "other": "main"},
    )?
    stop_example_engine(binary, store)?
    return check_generated_enum_member_after_edit(binary, scratch.path().joinpath("generated-enum"))


pub def test_an_edit_inside_a_dependency_class_reaches_a_program_holding_it_as_a_field_default() -> Result[None, str]:
    """
    A program whose class holds a path dependency's class as a field default runs the edited method body after a
    longer string in that body moves the dependency class's span.
    """
    scratch = scratch_directory()?
    app = class_dependency_fixture(scratch.path())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = scratch.path().joinpath("store")
    cold = records_run(binary, app, store)?
    assert cold.output == "sent\nsent\nno credit is left\n", cold.output
    edit_library(scratch.path(), "\"no credit is left\"", "\"no data credit is left\"")?
    edited = records_run(binary, app, store)?
    assert edited.output == "sent\nsent\nno data credit is left\n", edited.output
    return stop_example_engine(binary, store)


def class_dependency_fixture(root: Path) -> Result[Path, str]:
    """Write the program `app` whose `Channel` holds the path-dependency Loaf `pathlib`'s `Credits` as a field default."""
    library = root.joinpath("lib")
    library.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(library.joinpath("loaf.toml"), "[project]\nname = \"pathlib\"\nversion = \"0.1.0\"\n")?
    write(
        library.joinpath("src/lib.incn"),
        "pub class Credits:\n    \"\"\"Outstanding sequences.\"\"\"\n\n    pub limit: int\n    outstanding: list[str] = []\n\n" + "    pub def spend(mut self, sequence: int) -> Result[None, str]:\n        \"\"\"Spend one.\"\"\"\n" + "        if len(self.outstanding) >= self.limit:\n            return Err(\"no credit is left\")\n" + "        self.outstanding.append(str(sequence))\n        return Ok(None)\n",
    )?
    app = root.joinpath("app")
    app.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(
        app.joinpath("loaf.toml"),
        "[project]\nname = \"pathapp\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n\n" + "[dependencies]\npathlib = { path = \"../lib\" }\n",
    )?
    write(
        app.joinpath("src/main.incn"),
        "from pub::pathlib import Credits\n\n\npub class Channel:\n    \"\"\"One end.\"\"\"\n\n    pub sent: int = 0\n" + "    pub pending: Credits = Credits(limit=2)\n\n    pub def send(mut self) -> Result[None, str]:\n" + "        \"\"\"Send one.\"\"\"\n        self.pending.spend(self.sent)?\n        self.sent += 1\n        return Ok(None)\n\n\n" + "def main() -> None:\n    mut channel = Channel()\n    for _ in range(3):\n        match channel.send():\n" + "            Ok(_) => println(\"sent\")\n            Err(reason) => println(reason)\n",
    )?
    return Ok(app)


def path_dependency_fixture(root: Path, names: str, printed: str) -> Result[Path, str]:
    """Write the program `app` that prints from the path-dependency Loaf `pathlib` next to it."""
    main = f"from pub::pathlib import {names}\n\n\ndef main() -> None:\n    println({printed})\n"
    return write_path_dependency(root, LIBRARY, main)


def write_path_dependency(root: Path, library_source: str, main_source: str) -> Result[Path, str]:
    """Write the shared provider and consumer project layout with the requested source bodies."""
    library = root.joinpath("lib")
    library.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(library.joinpath("loaf.toml"), "[project]\nname = \"pathlib\"\nversion = \"0.1.0\"\n")?
    write(library.joinpath("src/lib.incn"), library_source)?
    app = root.joinpath("app")
    app.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(
        app.joinpath("loaf.toml"),
        "[project]\nname = \"pathapp\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n\n" + "[dependencies]\npathlib = { path = \"../lib\" }\n",
    )?
    write(app.joinpath("src/main.incn"), main_source)?
    return Ok(app)


def check_generated_enum_member_after_edit(binary: str, root: Path) -> Result[None, str]:
    """Keep the same provider layout witnesses across a consumer edit and replace the changed model's witness."""
    library = ("@derive(Clone, Eq)\npub enum Level(str):\n    Quiet = \"quiet\"\n    Loud = \"loud\"\n" + "\n\npub model Reading:\n    pub radix: int = 10\n")
    main = ("from helpers import announce\n\ndef main() -> None:\n    announce()\n" + "    println(len(\"text\".encode(\"utf-8\")))\n")
    app = write_path_dependency(root, library, main)?
    write(
        app.joinpath("src/helpers.incn"),
        "from pub::pathlib import Level, Reading\n\npub def announce() -> None:\n" + "    match Level.from_value(\"loud\"):\n        Some(level) => println(f\"{level.value()} {Reading().radix}\")\n" + "        None => println(\"missing\")\n",
    )?
    store = root.joinpath("warm-store")
    warm_trace = attempt_trace(root, "layout-warm")?
    cold = records_run(binary, app, store, Some(warm_trace))?
    assert cold.output == "loud 10\n4\n", cold.output
    before_edit = trace_lengths(warm_trace)?
    write(app.joinpath("src/main.incn"), main + "    println(\"after edit\")\n")?
    warm = records_run(binary, app, store, Some(warm_trace))?
    warm_plan = app.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    fresh_store = root.joinpath("fresh-store")
    fresh_trace = attempt_trace(root, "layout-fresh")?
    fresh = records_run(binary, app, fresh_store, Some(fresh_trace))?
    stop_example_engine(binary, fresh_store)?
    assert warm.output == fresh.output and warm.output == "loud 10\n4\nafter edit\n", warm.output
    assert proof_count(warm.report, "unit_evaluations")? == 1
    assert proof_count(warm.report, "body_evaluations")? == 1
    warm_layouts, reads, reused = provider_layouts(warm_trace, before_edit)?
    assert reads == 2 and reused == 2, f"expected two selected ranges and two reuse hits, got {reads} reads and {reused} hits"
    assert len(warm_layouts) == 2, f"expected the two selected provider layouts, got {warm_layouts}"
    assert (warm_layouts, reads, reused) == provider_layouts(fresh_trace)?
    assert warm_plan == app.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    edit_library(root, "pub radix: int = 10", "pub radix: int = 16\n    pub scale: int = 1")?
    before_provider_edit = trace_lengths(warm_trace)?
    changed = records_run(binary, app, store, Some(warm_trace))?
    stop_example_engine(binary, store)?
    assert changed.output == "loud 16\n4\nafter edit\n", changed.output
    changed_plan = app.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    assert changed_plan != warm_plan
    changed_layouts, changed_reads, changed_reuses = provider_layouts(warm_trace, before_provider_edit)?
    assert changed_reads == 2 and changed_reuses == 2
    assert len(changed_layouts) == 2 and changed_layouts != warm_layouts
    assert [row for row in changed_layouts if "::Level@" in row] == [row for row in warm_layouts if "::Level@" in row]
    changed_fresh = root.joinpath("changed-fresh-store")
    changed_fresh_trace = attempt_trace(root, "layout-changed-fresh")?
    assert records_run(binary, app, changed_fresh, Some(changed_fresh_trace))?.output == changed.output
    stop_example_engine(binary, changed_fresh)?
    assert changed_plan == app.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    assert (changed_layouts, changed_reads, changed_reuses) == provider_layouts(changed_fresh_trace)?
    return Ok(None)


def edit_library(root: Path, before: str, after: str) -> Result[None, str]:
    """Replace one string literal in the path dependency's only module."""
    source = root.joinpath("lib/src/lib.incn")
    text = read(source)?
    assert before in text, text
    return write(source, text.replace(before, after))


def trace_lengths(trace: Path) -> Result[Dict[str, int], str]:
    """Pin where each resident compiler's trace ended before the next request."""
    mut sizes: Dict[str, int] = {}
    for path in trace.iterdir().map_err((error) => error.message())?:
        if path.name().startswith("engine-compiler-"):
            text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
            sizes[path.name()] = len(text.split("\n")) - 1
    return Ok(sizes)


def provider_layouts(trace: Path, before: Dict[str, int] = {}) -> Result[tuple[list[str], int, int], str]:
    """Collect the selected provider layouts, their range reads and runtime preparation's reuse hits."""
    mut layouts: list[str] = []
    mut reads = 0
    mut reused = 0
    for path in trace.iterdir().map_err((error) => error.message())?:
        if not path.name().startswith("engine-compiler-"):
            continue
        text = path.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in text.split("\n")[before.get(path.name(), 0):]:
            if "pathlib" not in line:
                continue
            assert "\"operation\":\"linked_layout_fallback\"" not in line, line
            if "\"phase\":\"linked_layout_read\"" in line:
                reads += 1
            if "\"phase\":\"linked_layout_reused\"" in line:
                reused += 1
            if "\"operation\":\"linked_layout_record\"" in line:
                entry = parse(line).map_err((error) => error.message())?
                layouts.append(
                    entry.require("key").map_err((error) => error.message())?.expect_str().map_err(
                        (error) => error.message(),
                    )?,
                )
    return Ok((sorted(layouts), reads, reused))


def records_run(binary: str, app: Path, store: Path, trace: Option[Path] = None) -> Result[FixtureRun, str]:
    """Run the program through the records engine with its report on the first line."""
    mut command = Command.new(binary)
    if let Some(directory) = trace:
        command.env("INCAN_ENGINE_TRACE", directory.0)
        command.env("INCAN_NATIVE_PLAN_REPORT", app.joinpath("native.plan").0)
    child = command
        .current_dir(app.0)
        .args(["run", "src/main.incn", "--engine-report"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .stdin(Stdio.null()).stdout(Stdio.piped()).stderr(Stdio.piped())
        .spawn()
        .map_err((error) => str(error))?
    pid = int(child.id())
    outcome = child.wait_with_output().map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success():
        return Err(f"records run: status={outcome.status.code()} stdout={output} stderr={errors}")
    report = command_proof(outcome.stdout)?
    lines = output.split("\n")
    return Ok(FixtureRun(report=report, output="\n".join(lines[1:]), pid=pid))


def first_engine_run(binary: str, app: Path, store: Path) -> Result[str, str]:
    """Run the program through the first engine and return its output."""
    outcome = Command
        .new(binary)
        .current_dir(app.0)
        .args(["run", "src/main.incn"])
        .env("INCAN_ENGINE", "legacy")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success():
        return Err(f"first engine run: status={outcome.status.code()} stdout={output} stderr={errors}")
    return Ok(output)
