"""Borrow parsed documents and payload identities from the selected immutable installation page."""

from pub::incan_platform.trace import Operation
from std.fs import Path
from std.json import JsonValue
from jec import begin, record
from payload_types import InstalledPayload, PayloadAdmission


pub model Document:
    """One parsed installed record and the exact filesystem generation admitted with it."""

    pub path: str
    pub stamp: str
    pub value: JsonValue


model Selection:
    """Only the current installation's decoded documents, never a second persisted cache or an older fallback."""

    documents: Dict[str, Document] = {}
    payloads: Dict[str, InstalledPayload] = {}
    observations: Dict[str, str] = {}

    def select(
        mut self,
        documents: list[Document],
        payloads: list[InstalledPayload],
        paths: list[str],
        stamps: list[str],
    ) -> None:
        """Replace the current read scope with the exact documents decoded from its admitted page."""
        self.documents = {document.path: document for document in documents}
        self.payloads = {payload.path: payload for payload in payloads}
        self.observations = {paths[index]: stamps[index] for index in range(len(paths))}
        for document in documents:
            self.observations[document.path] = document.stamp
        for payload in payloads:
            self.observations[payload.path] = payload.admission.observation

    def payload(self, path: Path) -> Result[Option[PayloadAdmission], str]:
        """Name a payload admitted with its installation without reopening the payload or producer record."""
        if path.0 not in self.payloads:
            return Ok(None)
        clock = begin()
        selected = self.payloads[path.0]
        admission = selected.admission
        record(Operation.InstallationPayload, path.0, clock)
        return Ok(
            Some(
                PayloadAdmission(
                    identity=admission.identity,
                    payload=admission.payload,
                    observation=admission.observation,
                    provenance=admission.provenance,
                ),
            ),
        )

    def read(self, path: Path) -> Result[Option[JsonValue], str]:
        """Return fields parsed and admitted with the installation without reopening their original document."""
        if path.0 not in self.documents:
            return Ok(None)
        clock = begin()
        document = self.documents[path.0]
        record(Operation.InstallationDocument, path.0, clock)
        return Ok(Some(document.value.clone()))

    def observation(self, path: Path) -> Option[str]:
        """Return the filesystem generation admitted with one frozen document or payload."""
        return self.observations.get(path.0)

    def admit(mut self, path: str, stamp: str) -> None:
        """Add one subordinate immutable observation to this installation selection."""
        self.observations[path] = stamp


static SELECTED: Selection = Selection()


pub def select(
    documents: list[Document],
    payloads: list[InstalledPayload],
    paths: list[str],
    stamps: list[str],
) -> None:
    """Install a single verified page's document projection for its ordinary readers."""
    SELECTED.select(documents, payloads, paths, stamps)


pub def clear() -> None:
    """End the selection before re-admission so producers cannot accidentally read the preceding generation."""
    SELECTED.select([], [], [], [])


pub def payload(path: Path) -> Result[Option[PayloadAdmission], str]:
    """Read producer identity from the selected page; project-produced payloads keep their publication reader."""
    return SELECTED.payload(path)


pub def read(path: Path) -> Result[Option[JsonValue], str]:
    """Read a selected installed document; other project and publication files keep their ordinary reader."""
    return SELECTED.read(path)


pub def observation(path: Path) -> Option[str]:
    """Return the generation already admitted for a frozen installed input, if selected."""
    return SELECTED.observation(path)


pub def admit_observations(paths: list[str], stamps: list[str]) -> None:
    """Extend the selected installation with immutable observations decoded by a subordinate typed page."""
    for index in range(len(paths)):
        SELECTED.admit(paths[index], stamps[index])
