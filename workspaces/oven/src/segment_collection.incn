"""Oven facade-path adapters for explicit platform store collection."""

from std.fs import Path
from pub::incan_platform.store.collection import Reclaimed
from pub::incan_platform.store.collection import (
    collect_layouts as platform_collect_layouts,
    collect_records as platform_collect_records,
)
from pub::incan_platform.store.files import StoreError
from platform_store_path import store_path


pub def collect_layouts(root: Path) -> Result[Reclaimed, StoreError]:
    """Collect obsolete layouts in the platform store selected by Oven."""
    return platform_collect_layouts(store_path(root))


pub def collect_records(
    root: Path,
    references: (str, bytes) -> Result[list[str], StoreError],
    payloads: bool = true,
) -> Result[Reclaimed, StoreError]:
    """Collect unreachable records while Oven supplies the owning payload codec."""
    return platform_collect_records(store_path(root), references, payloads)
