             \"runtime\"\n              ],\n              \"direct_link\": true\n            }\n          ]\n        },\n        {\n          \"candidate_id\": \"usable\",\n          \"evidence_id\": \"usable-evidence\",\n          \"plan_identity\": \"usable-plan\",\n          \"build_unit_identity\": \"usable-unit\",\n          \"context\": {\n            \"target\": \"target\",\n            \"toolchain\": \"rustc\",\n            \"profile\": \"debug\",\n            \"features\": []\n          },\n          \"runtime\": {\n            \"compiler_version\": \"compiler\",\n            \"sdk_provider_codegen_revision\": \"7\",\n            \"runtime_lock_digest\": \"lock\",\n            \"core_source_digest\": \"core\",\n            \"derive_source_digest\": \"derive\",\n            \"stdlib_source_digest\": \"stdlib\",\n            \"unknown_input_keys\": []\n          },\n          \"providers\": [\n            {\n              \"semantic_identity\": \"sdk-semantic\",\n              \"modules\": [\n                \"prelude\",\n                \"extra\"\n              ],\n              \"facets\": [\n                \"runtime\"\n              ],\n              \"direct_link\": true\n            }\n          ]\n        }\n      ],\n      \"unsupported_intent\": []\n    }\n  },\n  \"purpose\": \"library\",\n  \"units\": [\n    {\n      \"unit_id\": \"catalog\",\n      \"owner_id\": \"catalog-owner\",\n      \"identity\": {\n        \"name\": \"catalog\",\n        \"version\": \"1\",\n        \"digest\": \"catalog-digest\",\n        \"feature_projection\": []\n      },\n      \"definition_id\": \"catalog-definition\",\n      \"definition_digest\": \"catalog-definition-digest\",\n      \"definition\": {\n        \"schema_version\": 1,\n        \"package\": {\n          \"name\": \"catalog\",\n          \"version\": \"1\"\n        },\n        \"crate_name\": \"catalog\",\n        \"crate_kind\": \"rlib\",\n        \"edition\": \"2024\",\n        \"authored_source_digest\": \"catalog-authored\",\n        \"entrypoint\": {\n          \"path\": \"src/lib.rs\",\n          \"digest\": \"entry\"\n        },\n        \"source_tree\": {\n          \"path\": \"src\",\n          \"digest\": \"tree\"\n        },\n        \"requirements\": []\n      }\n    },\n    {\n      \"unit_id\": \"pricing\",\n      \"owner_id\": \"pricing-owner\",\n      \"identity\": {\n        \"name\": \"pricing\",\n        \"version\": \"1\",\n        \"digest\": \"pricing-digest\",\n        \"feature_projection\": []\n      },\n      \"definition_id\": \"pricing-definition\",\n      \"definition_digest\": \"pricing-definition-digest\",\n      \"definition\": {\n        \"schema_version\": 1,\n        \"package\": {\n          \"name\": \"pricing\",\n          \"version\": \"1\"\n        },\n        \"crate_name\": \"pricing\",\n        \"crate_kind\": \"rlib\",\n        \"edition\": \"2024\",\n        \"authored_source_digest\": \"pricing-authored\",\n        \"entrypoint\": {\n          \"path\": \"src/lib.rs\",\n          \"digest\": \"entry\"\n        },\n        \"source_tree\": {\n          \"path\": \"src\",\n          \"digest\": \"tree\"\n        },\n        \"requirements\": [\n          {\n            \"role\": \"normal\",\n            \"alias\": \"renamed_catalog\",\n            \"package\": null,\n            \"version_requirement\": null,\n            \"features\": [],\n            \"default_features\": true,\n            \"optional\": false,\n            \"source\": {\n              \"kind\": \"provider_edge\",\n              \"edge_kind\": \"public_package\",\n              \"dependency_key\": \"catalog-edge\"\n            }\n          },\n          {\n            \"role\": \"normal\",\n            \"alias\": \"private_sdk\",\n            \"package\": null,\n            \"version_requirement\": null,\n            \"features\": [],\n            \"default_features\": true,\n            \"optional\": false,\n            \"source\": {\n              \"k