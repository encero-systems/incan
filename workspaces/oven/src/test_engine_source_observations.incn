"""Count source and payload operations across changed and unchanged program requests."""

from rust::std::process import Command
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue, parse
from pub::incan_platform.store import keys
from files import make_directory, read, write
from lowering_record_fixtures import stop_example_engine
from scratch import scratch_directory
from store_path_conversion import snapshot


const OUTCOME_HEADER: str = "incan.oven.outcome/2\n"


pub def test_an_edit_reads_and_hashes_its_source_once() -> Result[None, str]:
    """
    Count a normal one-file edit and the unchanged launch that follows it.

    1. Warm the records engine with a single source.
    2. Edit its only string and require one private read in each compiler activation.
    3. Launch unchanged and require no new executable or loader-payload hashes.
    """
    scratch = scratch_directory()?
    root = scratch.path().resolve().map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    project = root.joinpath("project")
    trace = root.joinpath("trace")
    store = root.joinpath("bakery")
    make_directory(project)?
    make_directory(trace)?
    source = project.joinpath("hello.incn")
    # 1. The first run installs the unit and its launch payloads.
    write(source, "def main() -> None:\n    println(\"one\")\n")?
    first = run_source(binary, project, store, trace)?
    before = observation_counts(trace, source, store)?
    # 2. Change one input and compare only the operations of this edit.
    write(source, "def main() -> None:\n    println(\"two\")\n")?
    changed = run_source(binary, project, store, trace)?
    edited = observation_counts(trace, source, store)?
    # 3. The selected view and immutable artifacts are current for this launch.
    repeated = run_source(binary, project, store, trace)?
    unchanged = observation_counts(trace, source, store)?
    stop_example_engine(binary, store)?
    assert first == b"one\n" and changed == b"two\n" and repeated == changed
    reads = edited.reads - before.reads
    hashes = edited.hashes - before.hashes
    assert reads == 1 and hashes == 1, f"one edited source was read {reads} times and hashed {hashes} times"
    captured = edited.captured_reads - before.captured_reads
    assert captured == 2, f"the import request and unit opened one staged source {captured} times"
    assert unchanged.captured_reads == edited.captured_reads, "an unchanged run opened a captured source"
    assert unchanged.other_hashes == edited.other_hashes, "an unchanged run hashed content outside compiler outcomes"
    assert unchanged.outcome_hashes - edited.outcome_hashes <= 1, "an unchanged run rehashed a compiler outcome"
    return check_warning_publication(binary, root)


def check_warning_publication(binary: str, root: Path) -> Result[None, str]:
    """A refused native publication leaves no warning receipt; a later cold and warm run replay the same bytes."""
    project = root.joinpath("warnings")
    store = root.joinpath("warning-bakery")
    trace = root.joinpath("warning-trace")
    make_directory(project)?
    make_directory(trace)?
    write(project.joinpath("hello.incn"), "def main() -> None:\n    unused = 1\n    println(\"hello\")\n")?
    mut interrupted = source_command(binary, project, store, trace)
    interrupted.env("INCAN_STORE_CRASH_AFTER", "pin-acquired")
    refused = interrupted.output().map_err((error) => str(error))?
    stop_example_engine(binary, store)?
    assert not refused.status.success(), "the injected publication fault did not refuse the request"
    selected = snapshot(store).map_err((error) => error.message())?
    for key in keys(selected).map_err((error) => error.message())?:
        assert not key.endswith("\tchecked warnings"), "a refused native publication left a warning receipt"
    cold = source_command(binary, project, store, trace).output().map_err((error) => str(error))?
    first = snapshot(store).map_err((error) => error.message())?
    warm = source_command(binary, project, store, trace).output().map_err((error) => str(error))?
    second = snapshot(store).map_err((error) => error.message())?
    stop_example_engine(binary, store)?
    assert cold.status.success() and warm.status.success()
    assert cold.stdout == b"hello\n" and warm.stdout == cold.stdout
    assert len(cold.stderr) > 0 and warm.stderr == cold.stderr, "warm warning bytes differ from the fresh check"
    assert second.digest == first.digest, "warning replay published another generation"
    return Ok(None)


def run_source(binary: str, project: Path, store: Path, trace: Path) -> Result[bytes, str]:
    """Run the fixture through the normal records entry point and trace file operations."""
    outcome = source_command(binary, project, store, trace).output().map_err((error) => str(error))?
    if not outcome.status.success():
        return Err(str(from_utf8(outcome.stderr).map_err((error) => str(error))?))
    return Ok(outcome.stdout)


def source_command(binary: str, project: Path, store: Path, trace: Path) -> Command:
    """Select the fixture's private Bakery and trace on the ordinary Records command."""
    mut command = Command.new(binary)
    command.arg("run").arg("hello.incn").current_dir(project.0)
    command.env("INCAN_ENGINE", "records").env("OVEN_ENGINE_BINARY", binary)
    command.env("INCAN_BAKERY", store.0).env("INCAN_ENGINE_TRACE", trace.0)
    command.env_remove("OVEN_TRACE").env_remove("INCAN_NATIVE_TIMING")
    return command


model Counts:
    """Operations on the source and its staged copy, plus hashes by payload kind."""
    reads: int = 0
    hashes: int = 0
    other_hashes: int = 0
    outcome_hashes: int = 0
    captured_reads: int = 0


def observation_counts(trace: Path, source: Path, store: Path) -> Result[Counts, str]:
    """Sum the flushed process traces and identify retained warning outcomes by their wire header."""
    mut found = Counts()
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().endswith(".jsonl"):
            continue
        for line in read(file)?.split("\n"):
            if line == "":
                continue
            event = parse(line).map_err((error) => error.message())?
            kind = trace_text(event, "kind")?
            if kind == "begin":
                reader = trace_text(event, "function")?
                if reader in [
                    "incan_driver::read_authored_source", "incan_rustc_driver::load_source_file",
                    "incan_driver::read_captured_source",
                ]:
                    fields = event.require("fields").map_err((error) => error.message())?
                    if trace_text(fields, "input")? == source.0:
                        if reader == "incan_driver::read_captured_source":
                            found.captured_reads += 1
                        else:
                            found.reads += 1
                continue
            if kind != "span":
                continue
            operation = trace_text(event, "operation")?
            if operation in ["file_read", "file_hash"]:
                amount = event.require("calls").map_err((error) => error.message())?
                calls = amount.expect_int().map_err((error) => error.message())?
                key = trace_text(event, "key")?
                selected = key == source.0
                if operation == "file_read" and selected:
                    found.reads += calls
                if operation == "file_hash":
                    if outcome_payload(key, store)?:
                        found.outcome_hashes += calls
                    else:
                        found.other_hashes += calls
                    if selected:
                        found.hashes += calls
    return Ok(found)


def outcome_payload(key: str, store: Path) -> Result[bool, str]:
    """A launch can verify its checked warnings receipt alongside the existing binary."""
    if not key.startswith(f"{store.0}/payloads/"):
        return Ok(false)
    content = Path(key).read_bytes().map_err((error) => error.message())?
    header = OUTCOME_HEADER.encode("utf-8")
    return Ok(content[:len(header)] == header)


def trace_text(row: JsonValue, key: str) -> Result[str, str]:
    """Read a required trace field as text without coercing bad evidence."""
    return row.require(key).map_err((error) => error.message())?.expect_str().map_err((error) => error.message())
