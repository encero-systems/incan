)


pub def test_removed_and_replaced_functions_leave_only_their_historical_graph_slots() -> Result[None, str]:
    origin = "app"
    module = "main.incn"
    before = project_source(origin, module, "def gone():\n    pass\ndef same():\n    pass\ndef unknown():\n    pass\n")?
    after = project_source(origin, module, "def same(value: int):\n    pass\ndef unknown(value: int):\n    pass\n")?
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    mut graph = publish_source_projection(empty, before)?.snapshot
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    products = [("local", CHECKER_PROFILE), ("final", CHECKER_PROFILE), ("body-ir", CHECKER_PROFILE),
                ("lowering-demand", LOWERING_PROFILE), ("plan-function", LOWERING_PROFILE)]
    for row in before.owners:
        owner = "function:main::" + row.key.facet + "|old"
        for family, profile in products:
            scope = ReadScope(snapshot=graph.digest, profile=profile)
            mut source = PreparedBodyRecordSource.open(scope)
            source.add(encode_record_key(row.key)?, row.encoded()?)
            output = body_key(family, origin, owner, "owned", "prior")
            receipt = source.receipt(scope, output, [prepared_product_request(row.key)])?
            graph = publish_evaluation(graph, owner + family, rank, b"prior-value", receipt)?.snapshot
    # A checked program can publish individual owner values without a reusable whole-namespace interface.
    current = CompiledBodyOutputs(
        namespaces=[],
        values=[CompiledBodyValue(module=module, name="same", identity="function:main::same|new",
            declaration=b"d", local=b"l", final=b"f", body_ir=b"ir")],
        fallbacks=[CompiledBodyFallback(module=module, name="unknown", identity=None, reason="no stable identity")],
    )
    changes = [after.census.key, signature_record(after.owners[0]).key, signature_record(after.owners[1]).key]
    mut next = begin(graph)
    retire_missing_functions(graph, next, origin, changes, {module: after}, [module], current)?
    supersede_outputs(graph, next)?
    edited = commit(next).map_err((error) => error.message())?
    for row in before.owners:
        for key in [row.key, signature_record(row).key, before.placements[row.key.facet].key]:
            present_before = get(graph, encode_record_key(key)?).map_err((error) => error.message())?
            present_after = get(edited, encode_record_key(key)?).map_err((error) => error.message())?
            assert present_before is not None
            assert (present_after is None) == (row.key.facet == "gone")
    for row in before.owners:
        owner = "function:main::" + row.key.facet + "|old"
        for family, profile in products:
            scope = Some(OutputSlots(origin=origin, identity_profile=body_identity_profile(family), included=Some([owner])))
            assert len(family_outputs(graph, family, profile, scope)?) == 1
            selected = family_outputs(edited, family, profile, scope)?
            if row.key.facet == "unknown":
                assert len(selected) == 1
            else:
                assert len(selected) == 0
                assert len(readers_of(edited, [row.key], profile)?) == 0
                assert get(edited, encode_record_key(body_key(family, origin, owner, "owned", "prior"))?).map_err((error) => error.message())? == Some(b"prior-value")
    return Ok(None)


pub def test_scope_name_leaves_only_after_its_last_reader_is_retired() -> Result[None, str]:
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    projection = project_source("app", "main.incn", "def f():\n    pass\n")?
    binding = scope_member(projection.census, scope_members(projection.census.text), "str")
    key = encode_record_key(binding.key)?
    encoded = binding.encoded()?
    initial = commit(put(begin(empty), key, encoded)).map_err((error) => error.message())?
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    owners = [body_key("local", "app", name, "checked", "current") for name in ["first", "second", "third"]]
    mut graph = initial
    for owner in owners[:2]:
        scope = ReadScope(snapshot=graph.digest, profile=CHECKER_PROFILE)
        mut source = PreparedBodyRecordSource.open(scope)
        source.add(key, encoded)
        receipt = source.receipt(scope, owner, [prepared_product_request(binding.key)])?
        graph = publish_evaluation(graph, owner.identity, rank, b"checked", receipt)?.snapshot
    mut first = begin(graph)
    retire_output(first, CHECKER_PROFILE, owners[0])?
    supersede_outputs(graph, first)?
    shared = commit(first).map_err((error) => error.message())?
    assert get(shared, key).map_err((error) => error.message())? == Some(encoded)
    scope = ReadScope(snapshot=shared.digest, profile=CHECKER_PROFILE)
    mut source = PreparedBodyRecordSource.open(scope)
    source.add(key, encoded)
    receipt = source.receipt(scope, owners[2], [prepared_product_request(binding.key)])?
    mut transfer = begin(shared)
    retire_output(transfer, CHECKER_PROFILE, owners[1])?
    prepared = prepare_evaluation(transfer, owners[2].identity, rank, b"checked", receipt)?
    assert transfer.root.value == shared.root.value and transfer.root.placement == shared.root.placement
    assert transfer.base == shared.generation and transfer.view == shared.view
    assert prepared.edge_count == 1 and len(transfer.writes) == 6
    positions, _output_slots, _renewed_scopes = output_replacements(transfer.writes)
    mut edges = 0
    for position in range(len(transfer.writes)):
        written = transfer.writes[position].key
        assert not written.startswith("incan.engine.edge-out/3\t"), "an evaluation stored a forward copy of its read"
        if written.startswith("incan.engine.edge-in/3\t"):
            assert positions.get(written) == Some(position)
            edges += 1
    assert edges == 1
    supersede_outputs(shared, transfer)?
    moved = commit(transfer).map_err((error) => error.message())?
    assert get(moved, key).map_err((error) => error.message())? == Some(encoded)
    mut last = begin(moved)
    retire_output(last, CHECKER_PROFILE, owners[2])?
    supersede_outputs(moved, last)?
    final_view = commit(last).map_err((error) => error.message())?
    assert get(final_view, key).map_err((error) => error.message())? is None
    assert get(graph, key).map_err((error) => error.message())? == Some(encoded)
    assert len(positions) == edges, f"retirement indexed {len(positions) - edges} non-edge writes"
    return Ok(None)


pub def test_checked_declaration_slots_separate_actual_receivers_and_signature_reads() -> None:
    bare = "function:apple_sdk::selected_sdk"
    first = "|incan.source-signature/2:sha256:2d80b426dc13f3912758ac2c52ad2a1235531fa8b4afe5446164ac2275fee1ea"
    next = "|incan.source-signature/2:sha256:1afbf05e3e945151320b9294edf7fc24ac471db805ece1c9c010f3c3669ca4c5"
    signed = project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare + first)
    assert signed != project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare)
    assert signed == project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare + next)
    field = "member/field:observation::stamp#in(model:observation::"
    assert project_declaration_slot("oven", "observation", "stamp", field + "FileEntry)[0]") != project_declaration_slot("oven", "observation", "stamp", field + "DirectoryEntry)[0]")
    nested = field + "Observation" + first + ")[0]"
    assert project_declaration_slot("oven", "observation", "stamp", nested).context == "symbol:" + nested


pub def test_toolchain_transition_retires_only_previous_profiles_of_the_same_source() -> Result[None, str]:
    """Old compiler indexes leave the current view while another program and prior snapshot keep their values."""
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    projection = project_source("app", "main.incn", "def pick() -> int:\n    return 1\n")?
    mut graph = publish_source_projection(empty, projection)?.snapshot
    dependency = projection.owners[0]
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    for origin, profile in [("app", "checker/18"), ("other", "checker/18"), ("app", "unrelated/18")]:
        scope = ReadScope(snapshot=graph.digest, profile=profile)
        mut source = PreparedBodyRecordSource.open(scope)
        source.add(encode_record_key(dependency.key)?, dependency.encoded()?)
        key = body_key("local", origin, profile, "checked", "context")
        receipt = source.receipt(scope, key, [prepared_product_request(dependency.key)])?
        graph = publish_evaluation(graph, profile + origin, rank, b"old", receipt)?.snapshot
    older = graph
    mut tx = begin(graph)
    retire_compiler_versions(graph, tx, "app", "checker/19")?
    supersede_outputs(graph, tx)?
    current = commit(tx).map_err((error) => error.message())?
    app = encode_record_key(body_key("local", "app", "checker/18", "checked", "context"))?
    other = encode_record_key(body_key("local", "other", "checker/18", "checked", "context"))?
    assert family_outputs(current, "local", "checker/18")? == [other]
    assert len(family_outputs(current, "local", "unrelated/18")?) == 1
    assert app in family_outputs(older, "local", "checker/18")?
    assert get(older, app).map_err((error) => error.message())? == Some(b"old")
    assert len(readers_of(current, [dependency.key], "checker/18")?) == 1
    assert len(readers_of(older, [dependency.key], "checker/18")?) == 2
    return Ok(None)


pub def test_a_reevaluated_slot_keeps_exactly_its_current_reverse_edges() -> Result[None, str]:
    """
    Re-evaluating a slot retires its earlier evaluation's reverse edges from that evaluation's receipt: the reverse
    index then holds the same bytes as a store that only ever made the later evaluation, and no forward copy of a read.
    Outgoing edges an earlier Oven kept under the slot are read for retirement and deleted with it.
    """
    first_input = request("reeval-first-input", RecordSelection.Field("value"))
    second_input = request("reeval-second-input", RecordSelection.Field("value"))
    # Each store is its own memory placement, so no evaluation of one reaches another.
    first = evaluate_slot(seeded(first_input, second_input)?, first_input)?
    fresh = evaluate_slot(seeded(first_input, second_input)?, second_input)?
    second = evaluate_slot(first, second_input)?
    assert len(reverse_index(first)?) == 1, f"first evaluation reverse index {reverse_index(first)?}"
    assert len(reverse_index(fresh)?) == 1, f"fresh evaluation reverse index {reverse_index(fresh)?}"
    second_index = reverse_index(second)?
    assert second_index == reverse_index(fresh)?, f"second {second_index} fresh {reverse_index(fresh)?}"
    assert reverse_index(second)? != reverse_index(first)?, "re-evaluation kept the earlier reverse index"
    forward_copies = count_prefix(keys(second).map_err((error) => error.message())?, "incan.engine.edge-out/3\t")
    assert forward_copies == 0, "an evaluation stored a forward copy of its read"

    # An earlier Oven also kept the first evaluation's read as an outgoing edge under its slot.
    earlier = evaluate_slot(seeded(first_input, second_input)?, first_input)?
    output = encode_record_key(key("reeval-owner"))?
    leftover = "incan.engine.edge-out/3\tprofile\t" + "\t".join(output.split("\t")[:5]) + "\t0"
    forward = OutgoingEdge(reader=output, profile="profile", kind="present", request=first_input, evidence="earlier")
    older = commit(put(begin(earlier), leftover, encode_outgoing(forward)?)).map_err((error) => error.message())?
    migrated = evaluate_slot(older, second_input)?
    assert get(migrated, leftover).map_err((error) => error.message())? is None, "a leftover outgoing edge stayed"
    migrated_index = reverse_index(migrated)?
    assert migrated_index == reverse_index(fresh)?, f"migrated {migrated_index} fresh {reverse_index(fresh)?}"
    return Ok(None)


pub def test_retirement_refuses_a_pointer_or_receipt_bound_to_another_output() -> Result[None, str]:
    """
    Retiring a slot reads its selected pointer and the receipt behind it only as reuse would: a pointer naming a
    record of another slot, or an evaluation whose receipt describes another output, refuses the request instead of
    retiring someone else's reverse edges.
    """
    first_input = request("reeval-first-input", RecordSelection.Field("value"))
    second_input = request("reeval-second-input", RecordSelection.Field("value"))
    output = encode_record_key(key("reeval-owner"))?
    other = encode_record_key(key("reeval-other"))?
    slot = "incan.engine.output/2\tprofile\t" + "\t".join(output.split("\t")[:5])
    owned = evaluate_slot(seeded(first_input, second_input)?, first_input)?
    pointed = evaluate_slot(owned, second_input, "reeval-other")?
    misbound = commit(put(begin(pointed), slot, encode_pointer(other)?)).map_err((error) => error.message())?
    match evaluate_slot(misbound, second_input):
        Ok(_) => return Err("retirement followed a pointer to a record of another slot")
        Err(message) => assert "another slot" in message, message

    stored = evaluate_slot(seeded(first_input, second_input)?, first_input)?
    receipted = evaluate_slot(stored, second_input, "reeval-other")?
    own = read_evaluation(required_bytes(receipted, evaluation_record_key("profile", output))?)?
    foreign = read_evaluation(required_bytes(receipted, evaluation_record_key("profile", other))?)?
    rank = ProducerRank(namespace=2, stage=ProducerStage.CheckBody, dependency=3)
    swapped = encode_evaluation("profile", output, "claim-reeval-owner", own.value_digest, foreign.receipt_root, rank)?
    crossing = put(begin(receipted), evaluation_record_key("profile", output), swapped)
    crossed = commit(crossing).map_err((error) => error.message())?
    match evaluate_slot(crossed, second_input):
        Ok(_) => return Err("retirement trusted a receipt of another output")
        Err(message) => assert "does not describe its evaluation" in message, message
    return Ok(None)


def required_bytes(selected: Snapshot, record: str) -> Result[bytes, str]:
    """One record the fixture store must hold."""
    match get(selected, record).map_err((error) => error.message())?:
        Some(value) => return Ok(value)
        None => return Err(f"fixture store has no {record}")


def seeded(first: RecordRequest, second: RecordRequest) -> Result[Snapshot, str]:
    """A new memory store holding both fixture inputs."""
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    inputs = put(begin(empty), encode_record_key(first.key)?, b"first")
    return commit(put(inputs, encode_record_key(second.key)?, b"second")).map_err((error) => error.message())


def evaluate_slot(selected: Snapshot, dependency: RecordRequest, owner: str = "reeval-owner") -> Result[Snapshot, str]:
    """Evaluate one fixture slot reading `dependency` and supersede its earlier output, as a request does."""
    output = key(owner)
    scope = ReadScope(snapshot=selected.digest, profile="profile")
    preparation = PreparationEvidence(output=output, rank_certificate="rank", selector_witnesses="selectors")
    source = StoreRecordSource.open(selected, scope, [encode_record_key(dependency.key)?])
    mut reads = RecordReads.start(scope, preparation, [dependency])
    match reads.read(source, dependency):
        RecordRead.Failed(_) => return Err("fixture dependency read failed")
        _ => pass
    receipt = reads.finish().map_err((_) => "fixture dependency receipt failed")?
    mut transaction = begin(selected)
    rank = ProducerRank(namespace=2, stage=ProducerStage.CheckBody, dependency=3)
    _ = prepare_evaluation(transaction, "claim-" + owner, rank, ("checked " + owner).encode("utf-8"), receipt)?
    supersede_outputs(selected, transaction)?
    return commit(transaction).map_err((error) => error.message())


def reverse_index(selected: Snapshot) -> Result[list[str], str]:
    """Every reverse edge's key with its exact value bytes."""
    mut entries: list[str] = []
    for indexed in keys(selected).map_err((error) => error.message())?:
        if indexed.startswith("incan.engine.edge-in/3\t"):
            match get(selected, indexed).map_err((error) => error.message())?:
                Some(value) => entries.append(indexed + "\n" + hexlify(value))
                None => return Err("a listed reverse edge has no value")
    return Ok(entries)
