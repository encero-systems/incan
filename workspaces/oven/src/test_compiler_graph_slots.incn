"""Retired compiler graph slots: removed and replaced functions, scope names after their last reader, checked declaration
slots, and toolchain transitions keep only what their history needs."""

from pub::incan_platform.store import begin, commit, get, put
from pub::incan_platform.store import snapshot as store_snapshot
from pub::incan_platform.store.memory import root as memory_root
from pub::internal_models.records import ReadScope, encode_record_key
from pub::internal_models import (
    CompiledBodyFallback,
    CompiledBodyOutputs,
    CompiledBodyValue,
    ProducerRank,
    ProducerStage,
)
from pub::internal_models.checker_records import CHECKER_PROFILE
from compiler_graph_records import (
    OutputSlots,
    family_outputs,
    prepare_evaluation,
    publish_evaluation,
    readers_of,
    retire_compiler_versions,
    retire_output,
    supersede_outputs,
)
from compiler_owner_retirement import retire_missing_functions
from compiler_prepared_records import PreparedBodyRecordSource
from compiler_body_keys import body_key, project_declaration_slot
from compiler_plan_values import LOWERING_PROFILE
from compiler_body_publication import prepared_product_request
from compiler_source_projection import (
    project_source,
    publish_source_projection,
    scope_member,
    scope_members,
    signature_record,
)


pub def test_removed_and_replaced_functions_leave_only_their_historical_graph_slots() -> Result[None, str]:
    origin = "app"
    module = "main.incn"
    before = project_source(origin, module, "def gone():\n    pass\ndef same():\n    pass\ndef unknown():\n    pass\n")?
    after = project_source(origin, module, "def same(value: int):\n    pass\ndef unknown(value: int):\n    pass\n")?
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    mut graph = publish_source_projection(empty, before)?.snapshot
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    products = [("local", CHECKER_PROFILE), ("final", CHECKER_PROFILE), ("body-ir", CHECKER_PROFILE),
                ("lowering-demand", LOWERING_PROFILE), ("plan-function", LOWERING_PROFILE)]
    for row in before.owners:
        owner = "function:main::" + row.key.facet + "|old"
        for family, profile in products:
            scope = ReadScope(snapshot=graph.digest, profile=profile)
            mut source = PreparedBodyRecordSource.open(scope)
            source.add(encode_record_key(row.key)?, row.encoded()?)
            output = body_key(family, origin, owner, "owned", "prior")
            receipt = source.receipt(scope, output, [prepared_product_request(row.key)])?
            graph = publish_evaluation(graph, owner + family, rank, b"prior-value", receipt)?.snapshot
    # A checked program can publish individual owner values without a reusable whole-namespace interface.
    current = CompiledBodyOutputs(
        namespaces=[],
        values=[CompiledBodyValue(module=module, name="same", identity="function:main::same|new",
            declaration=b"d", local=b"l", final=b"f", body_ir=b"ir")],
        fallbacks=[CompiledBodyFallback(module=module, name="unknown", identity=None, reason="no stable identity")],
    )
    changes = [after.census.key, signature_record(after.owners[0]).key, signature_record(after.owners[1]).key]
    mut next = begin(graph)
    retire_missing_functions(graph, next, origin, changes, {module: after}, [module], current)?
    supersede_outputs(graph, next)?
    edited = commit(next).map_err((error) => error.message())?
    for row in before.owners:
        for key in [row.key, signature_record(row).key, before.placements[row.key.facet].key]:
            present_before = get(graph, encode_record_key(key)?).map_err((error) => error.message())?
            present_after = get(edited, encode_record_key(key)?).map_err((error) => error.message())?
            assert present_before is not None
            assert (present_after is None) == (row.key.facet == "gone")
    for row in before.owners:
        owner = "function:main::" + row.key.facet + "|old"
        scope = Some(OutputSlots(origin=origin, identity_profile="incan.stable-declaration/1", included=Some([owner])))
        for family, profile in products:
            assert len(family_outputs(graph, family, profile, scope)?) == 1
            selected = family_outputs(edited, family, profile, scope)?
            if row.key.facet == "unknown":
                assert len(selected) == 1
            else:
                assert len(selected) == 0
                assert len(readers_of(edited, [row.key], profile)?) == 0
                assert get(edited, encode_record_key(body_key(family, origin, owner, "owned", "prior"))?).map_err((error) => error.message())? == Some(b"prior-value")
    return Ok(None)


pub def test_scope_name_leaves_only_after_its_last_reader_is_retired() -> Result[None, str]:
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    projection = project_source("app", "main.incn", "def f():\n    pass\n")?
    binding = scope_member(projection.census, scope_members(projection.census.text), "str")
    key = encode_record_key(binding.key)?
    encoded = binding.encoded()?
    initial = commit(put(begin(empty), key, encoded)).map_err((error) => error.message())?
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    owners = [body_key("local", "app", name, "checked", "current") for name in ["first", "second", "third"]]
    mut graph = initial
    for owner in owners[:2]:
        scope = ReadScope(snapshot=graph.digest, profile=CHECKER_PROFILE)
        mut source = PreparedBodyRecordSource.open(scope)
        source.add(key, encoded)
        receipt = source.receipt(scope, owner, [prepared_product_request(binding.key)])?
        graph = publish_evaluation(graph, owner.identity, rank, b"checked", receipt)?.snapshot
    mut first = begin(graph)
    retire_output(first, CHECKER_PROFILE, owners[0])?
    supersede_outputs(graph, first)?
    shared = commit(first).map_err((error) => error.message())?
    assert get(shared, key).map_err((error) => error.message())? == Some(encoded)
    scope = ReadScope(snapshot=shared.digest, profile=CHECKER_PROFILE)
    mut source = PreparedBodyRecordSource.open(scope)
    source.add(key, encoded)
    receipt = source.receipt(scope, owners[2], [prepared_product_request(binding.key)])?
    mut transfer = begin(shared)
    retire_output(transfer, CHECKER_PROFILE, owners[1])?
    _ = prepare_evaluation(transfer, owners[2].identity, rank, b"checked", receipt)?
    supersede_outputs(shared, transfer)?
    moved = commit(transfer).map_err((error) => error.message())?
    assert get(moved, key).map_err((error) => error.message())? == Some(encoded)
    mut last = begin(moved)
    retire_output(last, CHECKER_PROFILE, owners[2])?
    supersede_outputs(moved, last)?
    final_view = commit(last).map_err((error) => error.message())?
    assert get(final_view, key).map_err((error) => error.message())? is None
    assert get(graph, key).map_err((error) => error.message())? == Some(encoded)
    return Ok(None)


pub def test_checked_declaration_slots_separate_actual_receivers_and_signature_reads() -> None:
    bare = "function:apple_sdk::selected_sdk"
    first = "|incan.source-signature/2:sha256:2d80b426dc13f3912758ac2c52ad2a1235531fa8b4afe5446164ac2275fee1ea"
    next = "|incan.source-signature/2:sha256:1afbf05e3e945151320b9294edf7fc24ac471db805ece1c9c010f3c3669ca4c5"
    signed = project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare + first)
    assert signed != project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare)
    assert signed == project_declaration_slot("oven", "apple_sdk", "selected_sdk", bare + next)
    field = "member/field:observation::stamp#in(model:observation::"
    assert project_declaration_slot("oven", "observation", "stamp", field + "FileEntry)[0]") != project_declaration_slot("oven", "observation", "stamp", field + "DirectoryEntry)[0]")
    nested = field + "Observation" + first + ")[0]"
    assert project_declaration_slot("oven", "observation", "stamp", nested).context == "symbol:" + nested


pub def test_toolchain_transition_retires_only_previous_profiles_of_the_same_source() -> Result[None, str]:
    """Old compiler indexes leave the current view while another program and prior snapshot keep their values."""
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    projection = project_source("app", "main.incn", "def pick() -> int:\n    return 1\n")?
    mut graph = publish_source_projection(empty, projection)?.snapshot
    dependency = projection.owners[0]
    rank = ProducerRank(namespace=0, stage=ProducerStage.CheckBody, dependency=0)
    for origin, profile in [("app", "checker/18"), ("other", "checker/18"), ("app", "unrelated/18")]:
        scope = ReadScope(snapshot=graph.digest, profile=profile)
        mut source = PreparedBodyRecordSource.open(scope)
        source.add(encode_record_key(dependency.key)?, dependency.encoded()?)
        key = body_key("local", origin, profile, "checked", "context")
        receipt = source.receipt(scope, key, [prepared_product_request(dependency.key)])?
        graph = publish_evaluation(graph, profile + origin, rank, b"old", receipt)?.snapshot
    older = graph
    mut tx = begin(graph)
    retire_compiler_versions(graph, tx, "app", "checker/19")?
    supersede_outputs(graph, tx)?
    current = commit(tx).map_err((error) => error.message())?
    app = encode_record_key(body_key("local", "app", "checker/18", "checked", "context"))?
    other = encode_record_key(body_key("local", "other", "checker/18", "checked", "context"))?
    assert family_outputs(current, "local", "checker/18")? == [other]
    assert len(family_outputs(current, "local", "unrelated/18")?) == 1
    assert app in family_outputs(older, "local", "checker/18")?
    assert get(older, app).map_err((error) => error.message())? == Some(b"old")
    assert len(readers_of(current, [dependency.key], "checker/18")?) == 1
    assert len(readers_of(older, [dependency.key], "checker/18")?) == 2
    return Ok(None)
