"""Select private callable products by complete source-independent semantic input equivalence."""

from rust::std::cell import RefCell
from rust::std::ops import DerefMut
from rust::std::rc import Rc
from rust::incan_loaf_names import artifact_stem
from std.fs import Path
from std.json import JsonValue
from files import json_text, read_json
from home import loaf_build_dir, unit_ledger
from json_fields import array_value, required_items, string_value
from loaf_local_graph import unique
from manifest_vocabulary import manifest_vocabulary
from observation import Ledger, SETTLE_SECONDS, load_ledger, trace
from toolchain import NativeCrate, Toolchain
from unit import UnitDescription, UnitLoaf
from unit_freshness import ArtifactIdentities, compiler_fingerprint, fingerprint, toolchain_cache_identities
from frozen_inputs import observation as frozen_observation
from native_references import NativeAnchors, anchored_reference, closure_reference, native_anchors
from pub::incan_platform.trace import Operation
from jec import begin, record

const CHECKED_DOMAIN: str = "incan.oven.checked-source/2"


pub def retain_callable_products(unit: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """
    Select private callable products while leaving source bytes, native profile policy and linking fresh.

    1. Refuse owned vocabulary and C headers without an admitted item producer.
    2. Reconcile interfaces, target, features and the complete selected native closure.
    3. Name item products by that context; each product separately validates its exact current source.
    """
    # 1. Owned vocabulary and C headers have no admitted item producer in this slice.
    if (
        unit.vocab is not None
        or unit.vocabulary
        or unit.vocab_desugarer
        or len(unit.c_headers) != 0
        or len(unit.cloves) != 0
    ):
        trace(f"{unit.package}: checked-source reuse refused for executable vocabulary or C headers")
        mut refused = unit
        refused.checked_context = None
        refused.lowering_context = None
        refused.checked_products = None
        return Ok(refused)
    # 2. Profile flags never enter checked-source equivalence, but every semantic input does.
    mut ledger = load_ledger(unit_ledger(unit.project_root, "checked-source"), SETTLE_SECONDS)
    identities = ArtifactIdentities()
    locations = resolved_loaves(unit)?
    anchors = native_anchors()?
    description = semantic_description(unit, identities, locations, anchors)?
    interfaces = interface_inputs(unit, ledger, identities, locations, anchors)?
    caches = toolchain_cache_identities(toolchain)?
    native_search = native_search_inputs(unit, toolchain, identities, locations)?
    identities.verify()?
    parts = [
        CHECKED_DOMAIN,
        compiler_fingerprint(toolchain)?,
        fingerprint([description])?,
        fingerprint(interfaces)?,
        fingerprint(caches)?,
        fingerprint(native_search)?,
    ]
    trace(f"{unit.package}: checked-source components {" ".join(parts)}")
    ledger.save()?
    # 3. Expanded nodes never enter scalar products; source bytes are checked by the item producer itself.
    mut selected = unit
    producer = fingerprint(parts)?
    selected.lowering_context = Some(producer)
    mut context = producer
    if len(unit.declared_features) > 0 or len(unit.active_features) > 0:
        context = fingerprint(["incan.oven.checked-features/1", producer, fingerprint(unit.declared_features)?, fingerprint(unit.active_features)?])?
    selected.checked_context = Some(context)
    selected.checked_products = Some(
        loaf_build_dir(unit.project_root, unit.package).joinpath(".products").joinpath(context).0,
    )
    return Ok(selected)


pub def desugared_by_a_dependency(unit: UnitDescription) -> Result[bool, str]:
    """
    Whether a Loaf the unit links, other than a standard package, publishes vocabulary: its desugaring writes
    declarations into the unit's modules that no source line owns, so no declaration record can name them. Each
    manifest is read once per generation, in the reading vocabulary admission shares: an edit decodes none of them.
    """
    for loaf in unit.loaves:
        if loaf.standard:
            continue
        if manifest_vocabulary(Path(loaf.dir).joinpath(f"{artifact_stem(loaf.name)}.incnlib"))?.published:
            return Ok(true)
    return Ok(false)


def semantic_description(
    unit: UnitDescription,
    identities: ArtifactIdentities,
    locations: LoafLocations,
    anchors: NativeAnchors,
) -> Result[str, str]:
    """Normalize native profile policy, authenticated Loaf locations and anchored native paths, keeping other fields."""
    mut fields = unit.to_json().expect_object().map_err((error) => error.message())?
    fields["profile"] = JsonValue.string("")
    # Package features select declarations before checking. Guarded modules witness this selection in their graph.
    fields["declared_features"] = JsonValue.array([])
    fields["active_features"] = JsonValue.array([])
    fields["checked_context"] = JsonValue.null()
    fields["checked_products"] = JsonValue.null()
    mut loaves: list[JsonValue] = []
    for loaf in unit.loaves:
        mut item = loaf.to_json().expect_object().map_err((error) => error.message())?
        item["dir"] = JsonValue.string(f"loaf:{loaf.name}")
        loaves.append(JsonValue.object(item))
    fields["loaves"] = JsonValue.array(loaves)
    fields["externs"] = JsonValue.array(
        [JsonValue.string(binding_identity(item, unit, identities, locations, anchors)?) for item in unit.externs],
    )
    fields["search"] = JsonValue.array([JsonValue.string(path) for path in semantic_search(unit, locations, anchors)?])
    return json_text(JsonValue.object(fields))


def semantic_search(unit: UnitDescription, locations: LoafLocations, anchors: NativeAnchors) -> Result[list[str], str]:
    """Retain native search order while collapsing aliases of the same authenticated semantic directory."""
    mut seen: set[str] = set()
    mut paths: list[str] = []
    for path in unit.search:
        selected = search_identity(Path(path), locations, anchors)?
        if selected not in seen:
            seen.add(selected)
            paths.append(selected)
    return Ok(paths)


def interface_inputs(
    unit: UnitDescription,
    mut ledger: Ledger,
    identities: ArtifactIdentities,
    locations: LoafLocations,
    anchors: NativeAnchors,
) -> Result[list[str], str]:
    """Witness semantic interfaces and native closure; separately requested tooling graphs are not checker inputs."""
    mut inputs: list[str] = []
    for loaf in unit.loaves:
        inputs.append(loaf.key)
        inputs.append(loaf.name)
        for extension in ["incnlib", "incnbody", "rustabi"]:
            path = Path(loaf.dir).joinpath(f"{loaf.name}.{extension}")
            inputs.append(extension)
            match frozen_observation(path):
                Some(stamp) => inputs.append(stamp)
                None =>
                    if path.is_file():
                        inputs.append(ledger.digest(path)?)
                    else:
                        inputs.append("absent")
        inputs = inputs + closure_inputs(loaf, unit, identities, locations, anchors)?
    return Ok(inputs)


def closure_inputs(
    loaf: UnitLoaf,
    unit: UnitDescription,
    identities: ArtifactIdentities,
    locations: LoafLocations,
    anchors: NativeAnchors,
) -> Result[list[str], str]:
    """Preserve native graph edges, macro bindings and search order while quotienting only witnessed Loaf profiles."""
    directory = Path(loaf.dir)
    closure = read_json(directory.joinpath(f"{loaf.name}.native.json"))?
    mut inputs: list[str] = []
    for field in ["externs", "macro_externs"]:
        inputs.append(field)
        for item in required_items(closure, field)?:
            pair = array_value(item)?
            if len(pair) != 2:
                return Err("native closure binding must name exactly one alias and artifact")
            name = string_value(pair[0])?
            path = located(directory, string_value(pair[1])?, anchors, locations)?
            inputs.append(binding_identity(NativeCrate(name=name, path=path.0), unit, identities, locations, anchors)?)
    inputs.append("search")
    for item in required_items(closure, "search")?:
        selected = located(directory, string_value(item)?, anchors, locations)?
        inputs.append(search_identity(selected, locations, anchors)?)
    return Ok(inputs)


model ResolvedPaths:
    """The physical spelling of each path one selection resolved, by the spelling it was asked for."""

    paths: Dict[str, str] = {}


model LoafLocations:
    """
    Each Loaf's resolved directory and admitted rlib by resolved path, naming the first Loaf that resolves there, and
    each path the selection resolved: every standard Loaf's closure names the same native archives and directories.
    """

    directories: Dict[str, str] = {}
    rlibs: Dict[str, str] = {}
    # Shared by every copy of these locations, so each path is resolved once per selection.
    resolved: Rc[RefCell[ResolvedPaths]] = Rc.new(RefCell.new(ResolvedPaths()))

    def physical(self, path: Path) -> Result[Path, str]:
        """The physical spelling of `path`, resolved on its first use in this selection."""
        mut held = self.resolved.as_ref().borrow_mut()
        return resolved_once(path, held.deref_mut())


def resolved_once(path: Path, mut state: BorrowedMut[ResolvedPaths]) -> Result[Path, str]:
    """Resolve `path` unless this selection already did; a physical spelling also names itself."""
    if path.0 in state.paths:
        return Ok(Path(state.paths[path.0]))
    selected = physical_path(path)?
    state.paths[path.0] = selected.0
    state.paths[selected.0] = selected.0
    return Ok(selected)


def resolved_loaves(unit: UnitDescription) -> Result[LoafLocations, str]:
    """
    Resolve every Loaf's directory and admitted rlib once per selection. Each native binding and search path is then
    compared against these instead of resolving every Loaf again: a closure names several bindings per Loaf.
    """
    mut locations = LoafLocations()
    for loaf in unit.loaves:
        directory = locations.physical(Path(loaf.dir))?.0
        if directory not in locations.directories:
            locations.directories[directory] = loaf.name
        expected = Path(loaf.dir).joinpath(f"lib{loaf.name.replace("-", "_")}.rlib")
        if frozen_observation(expected).is_some() or expected.is_file():
            rlib = locations.physical(expected)?.0
            if rlib not in locations.rlibs:
                locations.rlibs[rlib] = loaf.name
    return Ok(locations)


def binding_identity(
    native: NativeCrate,
    unit: UnitDescription,
    identities: ArtifactIdentities,
    locations: LoafLocations,
    anchors: NativeAnchors,
) -> Result[str, str]:
    """Use semantic Loaf identity only for its exact admitted rlib; Rust imports retain anchored native identity."""
    path = locations.physical(Path(native.path))?
    if native.name not in unit.rust_crates and path.0 in locations.rlibs:
        return Ok(f"loaf:{native.name}:{locations.rlibs[path.0]}")
    return fingerprint([native.name, anchored_reference(path.0, anchors), identities.identity(path)?])


def search_identity(path: Path, locations: LoafLocations, anchors: NativeAnchors) -> Result[str, str]:
    """Normalize authenticated Loaf directories; native_search_inputs witnesses other directories' native files."""
    selected = locations.physical(path)?
    if selected.0 in locations.directories:
        return Ok(f"loaf:{locations.directories[selected.0]}")
    return Ok(anchored_reference(selected.0, anchors))


def located(directory: Path, path: str, anchors: NativeAnchors, locations: LoafLocations) -> Result[Path, str]:
    """Resolve a published native-closure reference against the current home, then to its physical path."""
    selected = Path(closure_reference(directory, path, anchors)?)
    return locations.physical(selected)


def native_search_inputs(
    unit: UnitDescription,
    toolchain: Toolchain,
    identities: ArtifactIdentities,
    locations: LoafLocations,
) -> Result[list[str], str]:
    """Witness project-selected native search artifacts outside the already-admitted frozen toolchain generation."""
    mut ledger = load_ledger(unit_ledger(unit.project_root, "checked-native"), SETTLE_SECONDS, "")
    providers = [locations.physical(Path(loaf.dir))?.0 for loaf in unit.loaves]
    installed = installed_toolchain_root(toolchain)?
    mut inputs: list[str] = []
    directories = unique([locations.physical(Path(path))?.0 for path in unit.search])
    for path in directories:
        directory = Path(path)
        if directory.0 not in providers and not within(directory, installed):
            for file in ledger.sources(directory, false)?:
                if native_artifact(file):
                    inputs.append(file)
                    inputs.append(identities.identity(Path(file))?)
    ledger.save()?
    return Ok(inputs)


def installed_toolchain_root(toolchain: Toolchain) -> Result[Path, str]:
    """Locate the admitted installation from its driver, accepting synthetic fixtures that keep the driver at root."""
    mut root = Path(toolchain.driver).parent()
    if root.name() == "bin":
        root = root.parent()
    return physical_path(root)


def within(path: Path, root: Path) -> bool:
    """Whether an absolute path belongs to one directory tree, with a component boundary."""
    return path.0 == root.0 or path.0.startswith(root.0 + "/")


def native_artifact(path: str) -> bool:
    """Recognize native artifacts rustc can load from a dependency search directory."""
    for suffix in [".rlib", ".rmeta", ".dylib", ".so", ".a"]:
        if path.endswith(suffix):
            return true
    return false


def physical_path(path: Path) -> Result[Path, str]:
    """Resolve one path to its physical spelling, traced as one resolution of that path."""
    clock = begin()
    resolved = path.resolve().map_err((error) => f"cannot {error.message()}")
    record(Operation.PathResolve, path.0, clock)
    return resolved
