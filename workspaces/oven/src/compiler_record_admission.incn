"""Admit the compiler records a toolchain ships, or convert its installed Loaves once, as one sealed set (#2946)."""

from rust::std::fs import remove_dir_all
from rust::std::process import Command
from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from std.json import JsonValue
from std.tempfile import TemporaryDirectory
from pub::incan_platform.store import begin, commit, stage_put
from files import read_json
from json_fields import required_items, required_text
from observation import file_digest
from sealed_set import Profile, Record, SetSpec, admit, admit_content_revisions, export_set
from pub::incan_worker_host.record_directory import directory_member_key, read_directory
from store_path_conversion import snapshot

pub const COMPILER_RECORD_PROFILE: str = "incan.compiler-records/2"
const EXPORT_SCHEMA: str = "incan.compiler-record-export/2"
# The directory, beside the installed Loaves, where a toolchain archive ships their compiler records as exported.
pub const SHIPPED_RECORDS: str = "compiler-record-export"


pub model CompilerRecordPin:
    """The installed store root and exact sealed-set digest written into the toolchain pin."""

    pub root: str
    pub digest: str
    pub directory: str = ""

    pub def to_json(self) -> JsonValue:
        """Encode the sealed transport and its authenticated lookup root when available."""
        mut fields = {"root": JsonValue.string(self.root), "digest": JsonValue.string(self.digest)}
        if self.directory != "":
            fields["directory"] = JsonValue.string(self.directory)
        return JsonValue.object(fields)


pub def convert(driver: str, installed: Path, installation: Path) -> Result[CompilerRecordPin, str]:
    """
    Admit the installed Loaves' compiler records as one sealed set, converting nothing when the toolchain ships them.

    An archive `incan toolchain pack` wrote ships the candidate compiler's record export beside its Loaves; only an
    archive without one has the compiler export the records here. The compiler owns semantic decoding and the record
    split. Oven owns content admission and records only the resulting installed store root plus sealed-set digest.
    Scratch exports never become a selectable cache, and a shipped export is removed once its set is admitted.
    """
    temporary = TemporaryDirectory.try_new().map_err((error) => f"cannot {error.message()}")?
    shipped = installed.joinpath(SHIPPED_RECORDS)
    mut converted = shipped
    if not shipped.joinpath("index.json").is_file():
        converted = temporary.path().joinpath("converted")
        export_records(driver, installed, converted)?
    index = read_json(converted.joinpath("index.json"))?
    if required_text(index, "schema")? != EXPORT_SCHEMA:
        return Err("candidate compiler returned an unsupported record export")
    source = temporary.path().joinpath("source")
    mut source_records = begin(snapshot(source).map_err((error) => error.message())?)
    mut records: list[Record] = []
    mut receipt: list[str] = []
    for item in required_items(index, "records")?:
        key = required_text(item, "key")?
        revision = required_text(item, "revision")?
        object = required_text(item, "object")?
        if object != f"objects/{revision}":
            return Err(f"compiler record `{key}` names a non-canonical object")
        path = converted.joinpath(object)
        value = path.read_bytes().map_err((error) => f"cannot {error.message()}")?
        if hexlify(sha256.digest(value)) != revision:
            return Err(f"compiler record `{key}` differs from revision {revision}")
        stage_put(source_records, key, value)
        records.append(Record(key=key, revision=revision, payloads=[], references=[]))
        receipt.append(f"{key}\t{revision}")
    view = commit(source_records).map_err((error) => error.message())?
    profile = compiler_record_profile()
    spec = SetSpec(
        profile=profile,
        origin="installed-toolchain",
        producer=file_digest(Path(driver))?,
        receipt=hexlify(sha256.digest("\n".join(receipt).encode("utf-8"))),
        records=records,
        namespaces=[],
        dependencies=[],
    )
    relative = "compiler-records"
    transport = installation.joinpath(relative)
    digest = export_set(view, spec, transport).map_err((error) => error.message())?
    _ = admit(installation.joinpath("compiler-record-store"), transport, digest, profile).map_err(
        (error) => error.message(),
    )?
    # The admitted set now holds every shipped object; the shipped transport would be a third copy.
    if converted.0 == shipped.0:
        remove_dir_all(shipped.0).map_err((error) => f"cannot remove shipped compiler records {shipped.0}: {error}")?
    top = publish_directory(transport, digest, records)?
    return Ok(CompilerRecordPin(root=relative, digest=digest, directory=top))


def publish_directory(transport: Path, digest: str, records: list[Record]) -> Result[str, str]:
    """Root one immutable logical-key index in the toolchain's pin; payloads stay in the sealed transport."""
    view = snapshot(transport.joinpath("selection")).map_err((error) => error.message())?
    mut staged = begin(view)
    stage_put(staged, "@" + digest, b"")
    for item in records:
        stage_put(staged, directory_member_key(digest, item.key, item.revision)?, b"")
    return Ok(commit(staged).map_err((error) => error.message())?.index)


def validate_directory(transport: Path, pin: CompilerRecordPin, spec: SetSpec) -> Result[None, str]:
    """At installation verify the complete relation, including absence of extras, against the admitted set."""
    selected = read_directory(transport.joinpath("selection").0, pin.directory, pin.digest, "", 0)?
    mut expected: Dict[str, str] = {}
    for row in spec.records:
        expected[row.key] = row.revision
    if len(selected.members) != len(expected):
        return Err("compiler directory membership differs from its sealed manifest")
    mut seen: set[str] = set()
    for member in selected.members:
        if member.key in seen or expected.get(member.key, "") != member.revision:
            return Err("installed compiler directory selects an unknown or changed member")
        seen.add(member.key)
    return Ok(None)


pub def installed_records(
    driver: str,
    installation: Path,
    shipped: Option[CompilerRecordPin],
) -> Result[CompilerRecordPin, str]:
    """
    The installation's compiler-record set: the sealed set an archive ships, verified in place, or one converted here.

    An archive `incan toolchain pack` wrote ships the set in the store's own format, its transport and its admitted
    store, with the pin that names it. Admission checks every object against its content name and the store against
    the set receipt, and writes neither; only an archive without a sealed set has its records converted.
    """
    if let Some(pin) = shipped:
        transport = installation.joinpath(pin.root)
        if transport.joinpath("manifest.json").is_file():
            store = installation.joinpath("compiler-record-store")
            if pin.directory != "":
                _, spec = admit_content_revisions(
                    store, transport, pin.digest, compiler_record_profile(), "installed-toolchain", file_digest(Path(driver))?,
                ).map_err((error) => error.message())?
                validate_directory(transport, pin, spec)?
            else:
                _ = admit(store, transport, pin.digest, compiler_record_profile()).map_err((error) => error.message())?
            return Ok(pin)
        if pin.directory != "":
            return Err("missing sealed manifest for the shipped compiler directory")
    return convert(driver, installation, installation)


pub def shipped_pin(document: JsonValue) -> Result[Option[CompilerRecordPin], str]:
    """The compiler-record pin a toolchain description ships, when it names one."""
    match document.get("compiler_records"):
        None => return Ok(None)
        Some(value) =>
            mut directory = ""
            if let Some(found) = value.get("directory"):
                directory = found.expect_str().map_err((error) => error.message())?
                if directory == "":
                    return Err("empty compiler selector index root")
            return Ok(Some(CompilerRecordPin(root=required_text(value, "root")?, digest=required_text(value, "digest")?, directory=directory)))


def export_records(driver: str, installed: Path, output: Path) -> Result[None, str]:
    """Have the candidate compiler validate the installed manifests and export their compiler records into `output`."""
    result = Command
        .new(driver)
        .arg("--compiler-records")
        .arg(installed.0)
        .arg(output.0)
        .output()
        .map_err((error) => f"cannot convert installed compiler records: {error}")?
    if not result.status.success():
        return Err("cannot convert installed compiler records: " + decoded(result.stderr))
    return Ok(None)


pub def compiler_record_profile() -> Profile:
    """The exact identity, value schema and codec accepted for installed compiler records."""
    return Profile(
        identity=COMPILER_RECORD_PROFILE,
        schema=COMPILER_RECORD_PROFILE,
        codec="incan.compiler-record-value/1",
    )


def decoded(value: bytes) -> str:
    """Render a candidate-driver refusal without making invalid UTF-8 hide installation failure."""
    match value.decode("utf-8", "replace"):
        Ok(text) => return text.strip()
        Err(_) => return "candidate compiler returned non-text diagnostics"
