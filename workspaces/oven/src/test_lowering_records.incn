"""Real record-scoped lowering reuse through the installed native driver."""

from rust::std::process import Child, Command, Stdio
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue, parse
from files import write
from scratch import scratch_directory
from engine_client import service_generation, service_identity
from engine_endpoint import connect_with
from engine_messages import Message, Stop
from engine_wire import zero_id
from rust_target import decoded
from store_path_conversion import snapshot as store_snapshot
from pub::incan_platform.store import index_levels as store_index_levels, keys_with_prefix


pub def test_lowering_record_worked_example() -> Result[None, str]:
    """
    Body edits and moves reuse callers; comment and documentation edits check nothing; a callee signature edit
    invalidates their plans and matches cold output; a file nothing imports leaves the unit as it was.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    source = root.joinpath("hello.incn")
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    write(source, "def greeting() -> str:\n    return \"hello\"\n\n\ndef main() -> None:\n    println(greeting())\n")?
    initial = lowering_example_run_with_fingerprints(binary, source, store, "hello")?
    initial_fingerprints = native_fingerprints(root)?
    assert proof_count(initial, "plan_function_evaluations")? == 3
    write(source, "def greeting() -> str:\n    return \"hullo\"\n\n\ndef main() -> None:\n    println(greeting())\n")?
    edited = lowering_example_run_with_fingerprints(binary, source, store, "hullo")?
    edited_fingerprints = native_fingerprints(root)?
    assert fingerprint_for(edited_fingerprints, "greeting")? != fingerprint_for(initial_fingerprints, "greeting")?
    assert fingerprint_for(edited_fingerprints, "main")? == fingerprint_for(initial_fingerprints, "main")?
    assert partition_for(edited_fingerprints, "greeting")? == partition_for(initial_fingerprints, "greeting")?
    assert partition_for(edited_fingerprints, "main")? == partition_for(initial_fingerprints, "main")?
    diagnostic = edited.to_json().map_err((error) => error.message())?
    assert proof_count(edited, "body_evaluations")? == 1, diagnostic
    assert proof_count(edited, "body_ir_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_reuses")? == 2, diagnostic
    assert proof_count(edited, "lowering_demand_evaluations")? == 1, diagnostic
    assert proof_count(edited, "lowering_demand_reuses")? == 1, diagnostic
    assert proof_count(edited, "native_interface_evaluations")? == 1, diagnostic
    write(
        source,
        "def greeting() -> str:\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    commented = lowering_example_run(binary, source, store, "hullo")?
    comment_diagnostic = commented.to_json().map_err((error) => error.message())?
    assert proof_count(commented, "body_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "body_ir_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "plan_function_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "plan_function_reuses")? == 3, comment_diagnostic
    assert proof_count(commented, "lowering_demand_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "native_interface_evaluations")? == 1, comment_diagnostic
    # The comment line moves `main`, so its line tables change and the unit is baked again (BE-34).
    assert proof_count(commented, "native_bakes")? == 1, comment_diagnostic
    # Documentation never reaches checking: a docstring added to `greeting` checks no body and builds no Body IR.
    write(
        source,
        "def greeting() -> str:\n    \"\"\"Greet.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    documented = lowering_example_run(binary, source, store, "hullo")?
    documented_diagnostic = documented.to_json().map_err((error) => error.message())?
    assert proof_count(documented, "body_evaluations")? == 0, documented_diagnostic
    assert proof_count(documented, "body_ir_evaluations")? == 0, documented_diagnostic
    # Rewording the docstring moves no code, so not even `greeting`'s plan is evaluated again.
    write(
        source,
        "def greeting() -> str:\n    \"\"\"Greet the reader.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    reworded = lowering_example_run(binary, source, store, "hullo")?
    reworded_diagnostic = reworded.to_json().map_err((error) => error.message())?
    assert proof_count(reworded, "body_evaluations")? == 0, reworded_diagnostic
    assert proof_count(reworded, "plan_function_evaluations")? == 0, reworded_diagnostic
    # A comment edit that moves no code changes no input of the native unit: nothing is evaluated or baked.
    reworded_source = "def greeting() -> str:\n    \"\"\"Greet the reader.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n"
    for still_source in [
        reworded_source.replace("# inserted above main", "# a longer comment edited above main"),
        reworded_source.replace("println(greeting())", "println(greeting())  # the greeting"),
        reworded_source + "\n# the end of the file\n",
    ]:
        write(source, still_source)?
        still = lowering_example_run(binary, source, store, "hullo")?
        still_diagnostic = still.to_json().map_err((error) => error.message())?
        assert proof_count(still, "unit_evaluations")? == 0, still_diagnostic
        assert proof_count(still, "native_bakes")? == 0, still_diagnostic
    stop_example_engine(binary, store)?
    signature = root.joinpath("signature-source")
    signature.mkdir(true, true).map_err((error) => error.message())?
    linked = root.joinpath("signature")
    linked.symlink_to(signature).map_err((error) => error.message())?
    verify_signature_edit(binary, linked)?
    verify_unit_reads_only_its_graph(binary, root.joinpath("graph"))?
    return verify_rust_closure_debug_reproducibility(binary, root.joinpath("rust-closure"))


def verify_unit_reads_only_its_graph(binary: str, root: Path) -> Result[None, str]:
    """
    A unit is keyed and captured by what its collection read and probed: a module created where an import looked is
    found by name and rebuilds it, and a file nothing imports is never listed or read, so creating or editing one
    leaves the unit as it was, with no unit evaluation and no bake.
    """
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    write(source, "from helpers import shout\n\n\ndef main() -> None:\n    println(shout(\"graph\"))\n")?
    _ = refused_run(binary, source, store)?
    write(root.joinpath("helpers.incn"), "pub def shout(text: str) -> str:\n    return text + \"!\"\n")?
    created = lowering_example_run(binary, source, store, "graph!")?
    created_diagnostic = created.to_json().map_err((error) => error.message())?
    assert proof_count(created, "unit_evaluations")? == 1, created_diagnostic
    assert proof_count(created, "native_bakes")? == 1, created_diagnostic
    assert proof_count(created, "source_listings")? == 0, created_diagnostic
    for text in ["pub def unrelated() -> int:\n    return 1\n", "pub def unrelated() -> int:\n    return 2\n"]:
        write(root.joinpath("other.incn"), text)?
        sibling = lowering_example_run(binary, source, store, "graph!")?
        sibling_diagnostic = sibling.to_json().map_err((error) => error.message())?
        assert proof_count(sibling, "unit_evaluations")? == 0, sibling_diagnostic
        assert proof_count(sibling, "native_bakes")? == 0, sibling_diagnostic
        assert proof_count(sibling, "source_reads")? == 0, sibling_diagnostic
        assert proof_count(sibling, "source_listings")? == 0, sibling_diagnostic
    return stop_example_engine(binary, store)


