pub def test_engine_report_counts_checker_reuse_and_artifact_refusals() -> Result[None, str]:
    """A multi-module cold build reports complete checker admission and groups every refused artifact field."""
    scratch = scratch_directory()?
    root = scratch.path()
    project = root.joinpath("report-project")
    source = project.joinpath("src")
    source.mkdir(true, true).map_err((error) => error.message())?
    write(
        project.joinpath("loaf.toml"),
        "[project]\nname = \"checker_report\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n",
    )?
    write(
        source.joinpath("values.incn"),
        "pub model Flag:\n    pub ready: bool\n\n    property weight -> int:\n        return 2\n\n    def __bool__(self) -> bool:\n        return self.ready\n\n\npub def stable() -> int:\n    return 40\n\n\npub def selected(flag: Flag) -> int:\n    if flag:\n        return 2\n    return 0\n\n\npub def weighed(flag: Flag) -> int:\n    return flag.weight\n",
    )?
    write(
        source.joinpath("main.incn"),
        "from values import Flag, selected, stable, weighed\n\n\ndef main() -> None:\n    println(stable() + selected(Flag(ready=true)) + weighed(Flag(ready=false)))\n",
    )?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    report = report_fixture_build(binary, project, store)?
    diagnostic = report.to_json().map_err((error) => error.message())?
    # `selected` tests a `Flag` for truth through `Flag.__bool__`, a resolved operator call its record keeps. `main`
    # constructs the imported `Flag`, and its record keeps the field binding and the imported field it initializes.
    assert proof_count(report, "reusable_declarations")? == 3, diagnostic
    assert proof_count(report, "all_declarations")? == 4, diagnostic
    assert proof_refusal_count(report, "CallArtifacts.resolved_operator_calls")? == 0, diagnostic
    # `weighed` reads a computed property, which no record keeps yet.
    assert proof_refusal_count(report, "ExpressionArtifacts.computed_property_accesses")? == 1, diagnostic
    return stop_example_engine(binary, store)


pub def test_body_edit_rebuilds_beside_an_unchecked_fallback_owner() -> Result[None, str]:
    """A body edit in one module rebuilds while an untouched module holds an owner that has no checker record."""
    scratch = scratch_directory()?
    root = scratch.path()
    project = root.joinpath("fallback-project")
    source = project.joinpath("src")
    source.mkdir(true, true).map_err((error) => error.message())?
    write(
        project.joinpath("loaf.toml"),
        "[project]\nname = \"fallback_owner\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n",
    )?
    values = "pub model Flag:\n    pub ready: bool\n\n    property weight -> int:\n        return 2\n\n\npub def stable() -> int:\n    return "
    write(source.joinpath("values.incn"), values + "40\n")?
    write(
        source.joinpath("main.incn"),
        "from values import Flag, stable\n\n\ndef main() -> None:\n    println(stable() + Flag(ready=true).weight)\n",
    )?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    cold = report_fixture_build(binary, project, store)?
    cold_diagnostic = cold.to_json().map_err((error) => error.message())?
    # `main` reads a computed property, which no record keeps yet, so it stays on full-source checking.
    assert proof_refusal_count(cold, "ExpressionArtifacts.computed_property_accesses")? == 1, cold_diagnostic
    # The edit leaves `main.incn` alone: the compiler restores that module whole and reports none of its owners.
    write(source.joinpath("values.incn"), values + "41\n")?
    warm = report_fixture_build(binary, project, store)?
    warm_diagnostic = warm.to_json().map_err((error) => error.message())?
    assert proof_count(warm, "body_evaluations")? == 1, warm_diagnostic
    require_probe_output(project.joinpath("target/incan/release/bin/fallback_owner"), "43")?
    return stop_example_engine(binary, store)


pub def test_declaration_edit_keeps_an_imported_enum_read() -> Result[None, str]:
    """
