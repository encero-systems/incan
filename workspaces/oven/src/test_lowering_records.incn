pub def test_partial_module_admission_count() -> Result[None, str]:
    """The native assembly consumes partially restored pages while the whole-module counter excludes them."""
    scratch = scratch_directory()?
    report = scratch.path()
    function = AdmittedFunction(function="main", identity="function:main", references=[])
    whole = encode_module_note(AdmittedModule(module="a", complete=true, functions=[function]))?
    partial_note = encode_module_note(AdmittedModule(module="b", complete=false, functions=[function]))?
    report.joinpath("61" + ADMITTED_MODULE_NOTE).write_bytes(whole).map_err((error) => error.message())?
    report.joinpath("62" + PARTIAL_MODULE_NOTE).write_bytes(partial_note).map_err((error) => error.message())?
    assert restored_modules(report)? == ["a", "b"]
    assert restored_modules(report, whole_only=true)? == ["a"]
    report.joinpath("62" + ADMITTED_MODULE_NOTE).write_bytes(partial_note).map_err((error) => error.message())?
    match restored_modules(report, whole_only=true):
        Ok(_) => return Err("a partially restored module was counted as complete")
        Err(reason) => assert "disagrees with its filename" in reason
    return Ok(None)


pub def test_importer_rename_checks_only_its_direct_signature_reader() -> Result[None, str]:
    """An installed build checks the renamed function and its caller once each, stopping before load_summary."""
    scratch = scratch_directory()?
    root = scratch.path()
    project = root.joinpath("importer")
    project.mkdir(true, true).map_err((error) => error.message())?
    fixture = Path("examples/pro/codegraph_importer")
    fixture.joinpath("src").copy(project.joinpath("src"), false, false).map_err((error) => error.message())?
    fixture.joinpath("tests").copy(project.joinpath("tests"), false, false).map_err((error) => error.message())?
    fixture.joinpath("loaf.toml").copy(project.joinpath("loaf.toml"), false, false).map_err((error) => error.message())?
    trace = root.joinpath("trace")
    trace.mkdir(true, true).map_err((error) => error.message())?
    store = root.joinpath("store")
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    cold = report_fixture_build(binary, project, store, Some(trace))?
    cold_checks = importer_statement_checks(trace)?
    assert len(importer_ranked_completions(trace)?) == 0
    stop_example_engine(binary, store)?
    warm_trace = root.joinpath("warm-trace")
    warm_trace.mkdir(true, true).map_err((error) => error.message())?
    file = project.joinpath("src/importer.incn")
    original = file.read_text("utf-8", "strict").map_err((error) => error.message())?
    edited = original.replace("supported_schema(version: int)", "supported_schema(schema_version: int)").replace(
        "return version >= 1 and version <= 9", "return schema_version >= 1 and schema_version <= 9",
    )
    assert edited != original
    write(file, edited)?
    warm = report_fixture_build(binary, project, store, Some(warm_trace))?
    stop_example_engine(binary, store)?
    diagnostic = warm.to_json().map_err((error) => error.message())?
    assert proof_count(cold, "all_declarations")? == 6
    assert proof_count(cold, "reusable_declarations")? == 6
    assert len(cold_checks) == 6
    assert sorted(importer_statement_checks(warm_trace)?) == ["importer::import_jsonl", "importer::supported_schema"], diagnostic
    leaf = "function:importer::supported_schema"
    reader = "function:importer::import_jsonl"
    stages = [leaf + "\tdeclaration", leaf + "\tlocal", leaf + "\tfinal", reader + "\treader"]
    assert sorted(importer_ranked_completions(warm_trace)?) == sorted(stages), diagnostic
    assert importer_frontier_order(warm_trace)? == stages, diagnostic
    assert proof_count(warm, "body_evaluations")? == 2, diagnostic
    assert proof_count(warm, "plan_function_reuses")? > 0, diagnostic
    warm_values = importer_checked_values(store)?
    project.joinpath("target").move(root.joinpath("warm-target")).map_err((error) => error.message())?
    control = root.joinpath("cold-edited-store")
    control_trace = root.joinpath("cold-edited-trace")
    control_trace.mkdir(true, true).map_err((error) => error.message())?
    control_proof = report_fixture_build(binary, project, control, Some(control_trace))?
    stop_example_engine(binary, control)?
    assert proof_count(control_proof, "body_evaluations")? == 6
    assert proof_count(control_proof, "reusable_declarations")? == 6
    assert sorted(importer_statement_checks(control_trace)?) == sorted(cold_checks)
    assert len(importer_ranked_completions(control_trace)?) == 0
    assert importer_checked_values(control)? == warm_values
    return Ok(None)


def importer_checked_values(store: Path) -> Result[Dict[str, list[bytes]], str]:
    """Read all six owners' published declaration, local, final and Body IR bytes from the build-selected graph."""
    selected = store_snapshot(store).map_err((error) => error.message())?
    origin = "codegraph_importer_experiment"
    scope = OutputSlots(origin=origin, identity_profile=IDENTITY_PROFILE)
    mut declarations: Dict[str, bytes] = {}
    for local in reusable_family_records(selected, "local", CHECKER_PROFILE, Some(scope))?:
        for witness in local.receipt.witnesses:
            if let ReadWitness.Found(prior, _) = witness:
                key = prior.request.key
                if key.family == "declaration" and key.identity == local.key.identity and key.origin == origin:
                    assert key.identity not in declarations
                    match get(selected, encode_record_key(key)?).map_err((error) => error.message())?:
                        None => return Err("a published importer local lost its declaration")
                        Some(value) =>
                            assert record_root(value).map_err((error) => f"invalid importer declaration: {error:?}")? == key.context
                            declarations[key.identity] = value
    assert len(declarations) == 6
    mut values: Dict[str, list[bytes]] = {}
    for row in select_body_inventory_except(selected, CHECKER_PROFILE, origin, [])?:
        assert row.identity in declarations and row.identity not in values
        values[row.identity] = [declarations[row.identity], row.local, row.final, row.body_ir]
    assert len(values) == 6
    return Ok(values)


def importer_frontier_order(trace: Path) -> Result[list[str], str]:
    """Read the claim owner's ordered completions, checking the equal caller signature and empty frontier."""
    mut result: list[str] = []
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().startswith("engine-oven-"):
            continue
        contents = file.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in contents.split("\n"):
            if "ranked-stage" not in line and "ranked-reader" not in line:
                continue
            key = parse(line).and_then((record) => record.require("key")).and_then((field) => field.expect_str()).map_err((error) => error.message())?
            fields = key.split("\t")
            if fields[0] == "ranked-stage":
                assert len(fields) == 3
                result.append(fields[1].split("|")[0] + "\t" + fields[2])
            elif fields[0] == "ranked-reader":
                assert len(fields) == 9
                # The resolved call stores its parameter label in both body records.
                assert len(fields[2]) == 64 and len(fields[3]) == 64 and fields[2] != fields[3]
                assert len(fields[4]) == 64 and len(fields[5]) == 64 and fields[4] != fields[5]
                # Downstream callers read import_jsonl's own declaration, whose signature stays equal.
                assert len(fields[6]) == 64 and fields[6] == fields[7]
                assert fields[8] == "0"
                result.append(fields[1].split("|")[0] + "\treader")
    return Ok(result)


def importer_ranked_completions(trace: Path) -> Result[list[str], str]:
    """Use compiler-side successful production events to distinguish a ranked run from a whole-unit recheck."""
    mut stages: list[str] = []
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().startswith("engine-compiler-"):
            continue
        records = file.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in records.split("\n"):
            if "completed ranked checking producer" not in line:
                continue
            fields = parse(line).and_then((record) => record.require("fields")).map_err((error) => error.message())?
            identity = fields.require("owner").and_then((value) => value.expect_str()).map_err((error) => error.message())?
            root = fields.require("root").and_then((value) => value.expect_str()).map_err((error) => error.message())?
            if len(root) != 64:
                return Err("ranked importer producer did not emit a content root")
            family = fields.require("family").and_then((value) => value.expect_str()).map_err((error) => error.message())?
            stages.append(identity.split("|")[0] + "\t" + family)
    return Ok(stages)


def importer_statement_checks(trace: Path) -> Result[list[str], str]:
    """Read actual entries into the statement checker for the two project modules."""
    mut checked: list[str] = []
    for file in trace.iterdir().map_err((error) => error.message())?:
        if not file.name().startswith("engine-compiler-"):
            continue
        records = file.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in records.split("\n"):
            if "checked owner statements" not in line:
                continue
            fields = parse(line).and_then((record) => record.require("fields")).map_err((error) => error.message())?
            module = fields.require("module").and_then((value) => value.expect_str()).map_err((error) => error.message())?
            if module in ["main", "importer"]:
                owner = fields.require("owner").and_then((value) => value.expect_str()).map_err((error) => error.message())?
                checked.append(module + "::" + owner)
    return Ok(checked)


pub def test_lowering_record_worked_example() -> Result[None, str]:
    """
    Body edits and moves reuse callers; comment and documentation edits check nothing; a callee signature edit
    invalidates their plans and matches cold output; a file nothing imports leaves the unit as it was.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    source = root.joinpath("hello.incn")
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    write(source, "def greeting() -> str:\n    return \"hello\"\n\n\ndef main() -> None:\n    println(greeting())\n")?
    initial = lowering_example_run_with_fingerprints(binary, source, store, "hello")?
    initial_fingerprints = native_fingerprints(root)?
    assert proof_count(initial, "plan_function_evaluations")? == 3
    write(source, "def greeting() -> str:\n    return \"hullo\"\n\n\ndef main() -> None:\n    println(greeting())\n")?
    edited = lowering_example_run_with_fingerprints(binary, source, store, "hullo")?
    edited_fingerprints = native_fingerprints(root)?
    assert fingerprint_for(edited_fingerprints, "greeting")? != fingerprint_for(initial_fingerprints, "greeting")?
    assert fingerprint_for(edited_fingerprints, "main")? == fingerprint_for(initial_fingerprints, "main")?
    assert partition_for(edited_fingerprints, "greeting")? == partition_for(initial_fingerprints, "greeting")?
    assert partition_for(edited_fingerprints, "main")? == partition_for(initial_fingerprints, "main")?
    diagnostic = edited.to_json().map_err((error) => error.message())?
    assert proof_count(edited, "body_evaluations")? == 1, diagnostic
    assert proof_count(edited, "body_ir_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_reuses")? == 2, diagnostic
    assert proof_count(edited, "lowering_demand_evaluations")? == 1, diagnostic
    assert proof_count(edited, "lowering_demand_reuses")? == 1, diagnostic
    assert proof_count(edited, "native_interface_evaluations")? == 1, diagnostic
    write(
        source,
        "def greeting() -> str:\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    commented = lowering_example_run(binary, source, store, "hullo")?
    comment_diagnostic = commented.to_json().map_err((error) => error.message())?
    assert proof_count(commented, "body_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "body_ir_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "plan_function_evaluations")? == 0, comment_diagnostic
    # The comment leaves both bodies as they were: they are restored from the module's plan record, and the entry
    # binding is the one plan function reused by its key.
    assert proof_count(commented, "plan_function_reuses")? == 1, comment_diagnostic
    assert proof_count(commented, "plan_module_reuses")? == 1, comment_diagnostic
    assert proof_count(commented, "lowering_demand_evaluations")? == 0, comment_diagnostic
    assert proof_count(commented, "native_interface_evaluations")? == 1, comment_diagnostic
    # The comment line moves `main`, so its line tables change and the unit is baked again (BE-34).
    assert proof_count(commented, "native_bakes")? == 1, comment_diagnostic
    # Documentation never reaches checking: a docstring added to `greeting` checks no body and builds no Body IR.
    write(
        source,
        "def greeting() -> str:\n    \"\"\"Greet.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    documented = lowering_example_run(binary, source, store, "hullo")?
    documented_diagnostic = documented.to_json().map_err((error) => error.message())?
    assert proof_count(documented, "body_evaluations")? == 0, documented_diagnostic
    assert proof_count(documented, "body_ir_evaluations")? == 0, documented_diagnostic
    # Rewording the docstring moves no code, so not even `greeting`'s plan is evaluated again.
    write(
        source,
        "def greeting() -> str:\n    \"\"\"Greet the reader.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n",
    )?
    reworded = lowering_example_run(binary, source, store, "hullo")?
    reworded_diagnostic = reworded.to_json().map_err((error) => error.message())?
    assert proof_count(reworded, "body_evaluations")? == 0, reworded_diagnostic
    assert proof_count(reworded, "plan_function_evaluations")? == 0, reworded_diagnostic
    # A comment edit that moves no code changes no input of the native unit: nothing is evaluated or baked.
    reworded_source = "def greeting() -> str:\n    \"\"\"Greet the reader.\"\"\"\n    return \"hullo\"\n\n\n# inserted above main\ndef main() -> None:\n    println(greeting())\n"
    for still_source in [
        reworded_source.replace("# inserted above main", "# a longer comment edited above main"),
        reworded_source.replace("println(greeting())", "println(greeting())  # the greeting"),
        reworded_source + "\n# the end of the file\n",
    ]:
        write(source, still_source)?
        still = lowering_example_run(binary, source, store, "hullo")?
        still_diagnostic = still.to_json().map_err((error) => error.message())?
        assert proof_count(still, "unit_evaluations")? == 0, still_diagnostic
        assert proof_count(still, "native_bakes")? == 0, still_diagnostic
    stop_example_engine(binary, store)?
    signature = root.joinpath("signature-source")
    signature.mkdir(true, true).map_err((error) => error.message())?
    linked = root.joinpath("signature")
    linked.symlink_to(signature).map_err((error) => error.message())?
    verify_signature_edit(binary, linked)?
    verify_unit_reads_only_its_graph(binary, root.joinpath("graph"))?
    return verify_rust_closure_debug_reproducibility(binary, root.joinpath("rust-closure"))


def verify_unit_reads_only_its_graph(binary: str, root: Path) -> Result[None, str]:
    """
    A unit is keyed and captured by what its collection read and probed: a module created where an import looked is
    found by name and rebuilds it, and a file nothing imports is never listed or read, so creating or editing one
    leaves the unit as it was, with no unit evaluation and no bake.
    """
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    write(source, "from helpers import shout\n\n\ndef main() -> None:\n    println(shout(\"graph\"))\n")?
    _ = refused_run(binary, source, store)?
    write(root.joinpath("helpers.incn"), "pub def shout(text: str) -> str:\n    return text + \"!\"\n")?
    created = lowering_example_run(binary, source, store, "graph!")?
    created_diagnostic = created.to_json().map_err((error) => error.message())?
    assert proof_count(created, "unit_evaluations")? == 1, created_diagnostic
    assert proof_count(created, "native_bakes")? == 1, created_diagnostic
    assert proof_count(created, "source_listings")? == 0, created_diagnostic
    for text in ["pub def unrelated() -> int:\n    return 1\n", "pub def unrelated() -> int:\n    return 2\n"]:
        write(root.joinpath("other.incn"), text)?
        sibling = lowering_example_run(binary, source, store, "graph!")?
        sibling_diagnostic = sibling.to_json().map_err((error) => error.message())?
        assert proof_count(sibling, "unit_evaluations")? == 0, sibling_diagnostic
        assert proof_count(sibling, "native_bakes")? == 0, sibling_diagnostic
        assert proof_count(sibling, "source_reads")? == 0, sibling_diagnostic
        assert proof_count(sibling, "source_listings")? == 0, sibling_diagnostic
    return stop_example_engine(binary, store)


pub def test_local_rust_source_edit_rebuilds_affected_unit() -> Result[None, str]:
    """A local Rust source edit rebuilds its native unit, while an unchanged request does no work."""
    scratch = scratch_directory()?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    return verify_rust_source_edit_rebuild(binary, scratch.path())


pub def test_one_module_edit_lowers_only_that_module() -> Result[None, str]:
    """
    A body edit in one module of a four-module unit lowers that module alone: lowering visits no body of the three
    unchanged modules, which are admitted whole, and evaluates one plan function.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    observations = root.joinpath("trace")
    observations.mkdir(true, true).map_err((error) => error.message())?
    for name in ["lone_alpha", "lone_beta", "lone_gamma"]:
        write(root.joinpath(name + ".incn"), lone_module(name, "1"))?
    imports = "from lone_alpha import lone_alpha_one, lone_alpha_two\nfrom lone_beta import lone_beta_one, lone_beta_two\nfrom lone_gamma import lone_gamma_one, lone_gamma_two\n"
    calls = "lone_alpha_one(1) + lone_alpha_two(1) + lone_beta_one(1) + lone_beta_two(1) + lone_gamma_one(1) + lone_gamma_two(1)"
    write(source, imports + "\n\ndef main() -> None:\n    println(" + calls + ")\n")?
    _ = traced_example_run(binary, source, store, observations, "12")?
    cold = observed_module_work(observations)?
    for name in ["lone_alpha", "lone_beta", "lone_gamma", "main"]:
        assert cold.get("lower:" + name, 0) > 0, f"the cold build traced no lowered body of {name}"
        assert cold.get("check:" + name + ".incn", 0) > 0, f"the cold build traced no checker entry for {name}"
        assert cold.get("body-ir:" + name + ".incn", 0) > 0, f"the cold build traced no Body IR entry for {name}"
    assert cold.get("body-ir", 0) >= 4, "the cold build did not observe Body IR for all four modules"
    write(root.joinpath("lone_beta.incn"), lone_module("lone_beta", "5"))?
    edited = traced_example_run(binary, source, store, observations, "16")?
    diagnostic = edited.to_json().map_err((error) => error.message())?
    assert proof_count(edited, "plan_function_evaluations")? == 1, diagnostic
    warm = observed_module_work(observations)?
    verify_module_work(cold, warm, "lone_beta")?
    # The three unchanged modules, `main` among them, are restored from their module plan records.
    assert proof_count(edited, "plan_module_reuses")? == 3, diagnostic
    # A later edit of a module that was restored lowers that module again, and its edit reaches the program.
    write(root.joinpath("lone_alpha.incn"), lone_module("lone_alpha", "7"))?
    again = traced_example_run(binary, source, store, observations, "22")?
    again_diagnostic = again.to_json().map_err((error) => error.message())?
    assert proof_count(again, "plan_function_evaluations")? == 1, again_diagnostic
    assert proof_count(again, "plan_module_reuses")? == 3, again_diagnostic
    verify_module_work(warm, observed_module_work(observations)?, "lone_alpha")?
    return stop_example_engine(binary, store)


pub def test_unchanged_import_cycle_is_admitted_as_one_component() -> Result[None, str]:
    """An unrelated edit restores both peers. An exposed change makes both peers run through the checker again."""
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    trace = root.joinpath("trace")
    trace.mkdir(true, true).map_err((error) => error.message())?
    left = "from right import twice\n\npub def base() -> int:\n    return 2\n\n\npub def left() -> int:\n    return twice(base())\n"
    right = "from left import base\n\npub def twice(value: int) -> int:\n    return value + base()\n"
    write(root.joinpath("left.incn"), left)?
    write(root.joinpath("right.incn"), right)?
    leaf = root.joinpath("leaf.incn")
    write(leaf, "pub def leaf() -> int:\n    return 1\n")?
    write(source, "from leaf import leaf\nfrom left import left\n\ndef main() -> None:\n    println(left() + leaf())\n")?
    _ = traced_example_run(binary, source, store, trace, "5")?
    cold = observed_module_work(trace)?
    write(leaf, "pub def leaf() -> int:\n    return 2\n")?
    _ = traced_example_run(binary, source, store, trace, "6")?
    warm = observed_module_work(trace)?
    for peer in ["check:left.incn", "check:right.incn"]:
        assert cold.get(peer, 0) > 0
        assert warm.get(peer, 0) == cold[peer], peer
    assert warm.get("body-ir", 0) == cold.get("body-ir", 0) + 1
    # Adding an exported declaration changes the component's surface without changing either import.
    changed = left.replace("return 2", "return 3") + "\n\npub def exported() -> int:\n    return 9\n"
    write(root.joinpath("left.incn"), changed)?
    _ = traced_example_run(binary, source, store, trace, "8")?
    changed_work = observed_module_work(trace)?
    for peer in ["check:left.incn", "check:right.incn"]:
        assert changed_work.get(peer, 0) > warm.get(peer, 0), peer
    return stop_example_engine(binary, store)


def lone_module(name: str, addend: str) -> str:
    """One module of two functions; `addend` is the text a body edit changes."""
    one = f"pub def {name}_one(value: int) -> int:\n    return value + {addend}\n\n\n"
    return one + f"pub def {name}_two(value: int) -> int:\n    return value * 2\n"


def traced_example_run(binary: str, source: Path, store: Path, trace: Path, expected: str) -> Result[JsonValue, str]:
    """Run one records request whose engine and compiler worker write their trace records into `trace`."""
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .arg("--engine-report")
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .env("INCAN_ENGINE_TRACE", trace.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or not output.endswith(expected + "\n") or errors != "":
        return Err(f"traced example: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def observed_module_work(trace: Path) -> Result[Dict[str, int], str]:
    """Count actual checker and Body IR module entries and lowering work on this fixture's cumulative trace."""
    mut counts: Dict[str, int] = {}
    for entry in trace.iterdir().map_err((error) => error.message())?:
        if not entry.is_file():
            continue
        for line in entry.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
            if "\"kind\":\"begin\"" in line and "\"function\":\"incan_driver::typecheck_module\"" in line:
                document = parse(line).map_err((error) => error.message())?
                fields = document.require("fields").map_err((error) => error.message())?
                path = fields.require("module").map_err((error) => error.message())?.expect_str().map_err((error) => error.message())?
                key = "check:" + Path(path).name()
                counts[key] = counts.get(key, 0) + 1
            elif "\"kind\":\"begin\"" in line and "\"function\":\"incan_driver::build_body_ir_module\"" in line:
                document = parse(line).map_err((error) => error.message())?
                fields = document.require("fields").map_err((error) => error.message())?
                path = fields.require("file").map_err((error) => error.message())?.expect_str().map_err((error) => error.message())?
                key = "body-ir:" + Path(path).name()
                counts[key] = counts.get(key, 0) + 1
                counts["body-ir"] = counts.get("body-ir", 0) + 1
            else:
                parts = line.split("\"key\":\"lowering: body ")
                if len(parts) > 1:
                    key = "lower:" + parts[1].split(" ")[0]
                    counts[key] = counts.get(key, 0) + 1
    return Ok(counts)


def verify_module_work(previous: Dict[str, int], current: Dict[str, int], edited: str) -> Result[None, str]:
    """Each warm edit checks its own module, builds one module's Body IR, and lowers only that module's bodies."""
    changed = sorted([key for key in current.keys() if current[key] > previous.get(key, 0)])
    expected = sorted(["body-ir", "body-ir:" + edited + ".incn", "check:" + edited + ".incn", "lower:" + edited])
    if changed != expected:
        return Err(f"edit of {edited} entered {changed}, expected {expected}")
    if current["body-ir"] - previous.get("body-ir", 0) != 1:
        return Err(f"edit of {edited} rebuilt more than one module's Body IR")
    return Ok(None)


pub def test_body_edits_keep_one_indexed_output_per_slot() -> Result[None, str]:
    """
    Five body edits in a row leave one indexed output per slot: each edit's evaluations retire the outputs they
    replace, so what the next edit selects and invalidates does not grow with the edits before it.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    for edit in range(5):
        write(source, f"def main() -> None:\n    println(\"edit {edit}\")\n")?
        _ = lowering_example_run(binary, source, store, f"edit {edit}")?
    latest = store_snapshot(store).map_err((error) => error.message())?
    mut slots: Dict[str, int] = {}
    for key in keys_with_prefix(latest, "incan.engine.output/2\t").map_err((error) => error.message())?:
        slot = "\t".join(key.split("\t")[:7])
        slots[slot] = slots.get(slot, 0) + 1
    assert len(slots) > 0, "five edits indexed no outputs"
    for slot in sorted([name for name in slots.keys()]):
        assert slots[slot] == 1, f"{slots[slot]} indexed outputs for {slot.replace("\t", " | ")}"
    return stop_example_engine(binary, store)


pub def test_twenty_body_edits_in_a_row_hold_a_flat_median() -> Result[None, str]:
    """
    Twenty body edits in a row do the same work: every edit leaves one indexed output per slot, and the medians of
    edits 16-20 list no more keys, and read no more index pages per level of the index, than those of edits 2-6. The
    index deepening by a level as the store grows adds one page to each lookup; a cost that grows with every edit, a
    leak, fails it. Wall time is left to the proofs: it follows the load.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    mut pages: list[int] = []
    mut levels: list[int] = []
    mut listed: list[int] = []
    mut crowded: list[int] = []
    for edit in range(20):
        write(source, f"def main() -> None:\n    println(\"edit {edit}\")\n")?
        levels.append(index_levels(store)?)
        proof = lowering_example_run(binary, source, store, f"edit {edit}")?
        pages.append(proof_count(proof, "index_pages")?)
        listed.append(proof_count(proof, "keys_listed")?)
        crowded.append(most_outputs_in_one_slot(store)?)
    stop_example_engine(binary, store)?
    println(f"per edit: index pages {pages}, index levels {levels}, keys listed {listed}, most outputs {crowded}")
    assert crowded == [1 for _ in range(20)], f"most indexed outputs in one slot, per edit: {crowded}"
    assert sorted(listed[15:20])[2] <= sorted(listed[1:6])[2], f"keys listed per edit: {listed}"
    per_level = [pages[edit] * 100 // max([levels[edit], 1]) for edit in range(20)]
    early = sorted(per_level[1:6])[2]
    assert sorted(per_level[15:20])[2] * 4 <= early * 5, f"index pages per edit {pages} at index levels {levels}"
    return Ok(None)


def index_levels(store: Path) -> Result[int, str]:
    """How many levels the store's index has, root to leaves; none before the first commit."""
    if not store.joinpath("CURRENT").is_file():
        return Ok(0)
    latest = store_snapshot(store).map_err((error) => error.message())?
    return store_index_levels(latest).map_err((error) => error.message())


def most_outputs_in_one_slot(store: Path) -> Result[int, str]:
    """The most outputs the store's output index holds for one slot: profile, family, identity and facet."""
    latest = store_snapshot(store).map_err((error) => error.message())?
    mut slots: Dict[str, int] = {}
    for key in keys_with_prefix(latest, "incan.engine.output/2\t").map_err((error) => error.message())?:
        slot = "\t".join(key.split("\t")[:7])
        slots[slot] = slots.get(slot, 0) + 1
    mut most = 0
    for slot in slots.keys():
        if slots[slot] > most:
            most = slots[slot]
    return Ok(most)


