pub def test_a_method_body_gets_a_plan_product() -> Result[None, str]:
    """
    A module with a method gets a plan product for each of its bodies: the method's as well as the free function's.
    The unit then has a complete native interface, and an edit of the method keeps a product for every body.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("main.incn")
    store = root.joinpath("store")
    shapes = "pub model Counter:\n    pub count: int\n\n    pub def scaled(self) -> int:\n        return self.count * "
    bump = "\n\n\npub def bump(value: int) -> int:\n    return value + 1\n"
    write(root.joinpath("shapes.incn"), shapes + "2" + bump)?
    write(
        source,
        "from shapes import Counter, bump\n\n\ndef main() -> None:\n    println(Counter(count=2).scaled() + bump(1))\n",
    )?
    # Three bodies: `main`, `bump` and the method `Counter.scaled`.
    cold = lowering_example_run(binary, source, store, "6")?
    cold_diagnostic = cold.to_json().map_err((error) => error.message())?
    assert proof_count(cold, "lowering_demand_evaluations")? == 3, cold_diagnostic
    assert proof_count(cold, "native_interface_evaluations")? == 1, cold_diagnostic
    write(root.joinpath("shapes.incn"), shapes + "5" + bump)?
    warm = lowering_example_run(binary, source, store, "12")?
    warm_diagnostic = warm.to_json().map_err((error) => error.message())?
    evaluated = proof_count(warm, "lowering_demand_evaluations")?
    assert evaluated >= 1 and evaluated + proof_count(warm, "lowering_demand_reuses")? == 3, warm_diagnostic
    assert proof_count(warm, "native_interface_evaluations")? == 1, warm_diagnostic
    return stop_example_engine(binary, store)


pub def test_generic_body_edit_matches_cold_build() -> Result[None, str]:
    """
    A generic body edit in a warm store reproduces the cold plan, executable and output for both instances, and a
    deleted imported module is refused warm exactly as cold.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("generic.incn")
    warm_store = root.joinpath("warm-store")
    write(source, generic_source("0"))?
    _ = lowering_example_run(binary, source, warm_store, "1\na\n42")?
    write(source, generic_source("1"))?
    _ = lowering_example_run(binary, source, warm_store, "2\nb\n42")?
    plan = root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    executable = root.joinpath("target/incan/release/bin/generic").read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, warm_store)?
    root.joinpath("target").remove_tree().map_err((error) => error.message())?
    cold_store = root.joinpath("cold-store")
    _ = lowering_example_run(binary, source, cold_store, "2\nb\n42")?
    cold_plan = root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    cold_executable = root.joinpath("target/incan/release/bin/generic").read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, cold_store)?
    assert plan == cold_plan, "warm and cold generic plans differ"
    assert executable == cold_executable, "warm and cold generic executables differ"
    verify_deleted_module_matches_cold(binary, root.joinpath("deleted-module"))?
    return verify_comment_text_builds_identically(binary, root.joinpath("comment-text"))


def verify_deleted_module_matches_cold(binary: str, root: Path) -> Result[None, str]:
    """Deleting an imported module refuses a warm build with exactly the refusal a cold build of the same source gives."""
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("main.incn")
    helpers = root.joinpath("helpers.incn")
    write(source, "from helpers import shout\n\n\ndef main() -> None:\n    println(shout(\"import\"))\n")?
    write(helpers, "pub def shout(text: str) -> str:\n    return text + \"!\"\n")?
    warm_store = root.joinpath("warm-store")
    _ = lowering_example_run(binary, source, warm_store, "import!")?
    helpers.unlink().map_err((error) => error.message())?
    warm = refused_run(binary, source, warm_store)?
    stop_example_engine(binary, warm_store)?
    root.joinpath("target").remove_tree().map_err((error) => error.message())?
    cold_store = root.joinpath("cold-store")
    cold = refused_run(binary, source, cold_store)?
    stop_example_engine(binary, cold_store)?
    assert warm == cold, f"warm refusal differs from cold: {warm} | {cold}"
    assert "INCAN-I0001" in warm and "helpers" in warm, warm
    return Ok(None)


def verify_comment_text_builds_identically(binary: str, root: Path) -> Result[None, str]:
    """Two cold release builds of sources that differ only in a comment's text produce byte-identical executables."""
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("main.incn")
    mut executables: list[bytes] = []
    for comment in ["# first comment", "# a second, longer comment"]:
        write(source, comment + "\ndef main() -> None:\n    println(\"comment\")  " + comment + "\n")?
        store = root.joinpath(f"store-{len(executables)}")
        _ = lowering_example_run(binary, source, store, "comment")?
        executables.append(
            root.joinpath("target/incan/release/bin/main").read_bytes().map_err((error) => error.message())?,
        )
        stop_example_engine(binary, store)?
        root.joinpath("target").remove_tree().map_err((error) => error.message())?
    assert executables[0] == executables[1], "release executables differ in comment text alone"
    return Ok(None)


def refused_run(binary: str, source: Path, store: Path) -> Result[str, str]:
    """Run one engine request that must be refused, returning its exit status and output streams as one text."""
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if outcome.status.success():
        return Err(f"refused run succeeded: stdout={output} stderr={errors}")
    return Ok(f"status={outcome.status.code()} stdout={output} stderr={errors}")


pub def test_unrelated_edit_rechecks_no_generic_body() -> Result[None, str]:
    """Editing the function beside a generic re-checks and re-plans only that function, and warm matches cold."""
    edited, cold = unrelated_edit_reports("generic", generic_source("0"), "1\na\n42", "1\na\n43")?
    diagnostic = edited.to_json().map_err((error) => error.message())?
    assert proof_count(edited, "body_evaluations")? == 1, diagnostic
    assert proof_count(edited, "body_ir_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_evaluations")? == 1, diagnostic
    # `main`, both `pick` instances and the runtime Loaf's list and copy instances they request: every other function.
    planned = proof_count(cold, "plan_function_evaluations")?
    assert proof_count(edited, "plan_function_reuses")? == planned - 1, diagnostic
    return Ok(None)


pub def test_unrelated_edit_reuses_runtime_list_instances() -> Result[None, str]:
    """A list program's runtime instances keep products: an unrelated edit reuses them, and the interface publishes."""
    edited, cold = unrelated_edit_reports("lists", list_source(), "4\nb\n42", "4\nb\n43")?
    diagnostic = edited.to_json().map_err((error) => error.message())?
    assert proof_count(cold, "native_interface_evaluations")? == 1, cold.to_json().map_err((error) => error.message())?
    assert proof_count(edited, "body_evaluations")? == 1, diagnostic
    assert proof_count(edited, "plan_function_evaluations")? == 1, diagnostic
    planned = proof_count(cold, "plan_function_evaluations")?
    assert proof_count(edited, "plan_function_reuses")? == planned - 1, diagnostic
    assert proof_count(edited, "native_interface_evaluations")? == 1, diagnostic
    return Ok(None)


def unrelated_edit_reports(name: str, text: str, before: str, after: str) -> Result[tuple[JsonValue, JsonValue], str]:
    """
    Build `text`, then its `unrelated` edit in the same store, then the edited source in a fresh store.

    Return the warm edit's report and the fresh build's; the warm plan and executable must equal the fresh ones.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath(f"{name}.incn")
    warm_store = root.joinpath("warm-store")
    write(source, text)?
    _ = lowering_example_run(binary, source, warm_store, before)?
    write(source, text.replace("value + 1", "value + 2"))?
    edited = lowering_example_run(binary, source, warm_store, after)?
    binary_path = f"target/incan/release/bin/{name}"
    plan = root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    executable = root.joinpath(binary_path).read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, warm_store)?
    root.joinpath("target").remove_tree().map_err((error) => error.message())?
    cold_store = root.joinpath("cold-store")
    cold = lowering_example_run(binary, source, cold_store, after)?
    cold_plan = root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    cold_executable = root.joinpath(binary_path).read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, cold_store)?
    assert plan == cold_plan, f"warm and cold plans differ after the unrelated edit of {name}"
    assert executable == cold_executable, f"warm and cold executables differ after the unrelated edit of {name}"
    return Ok((edited, cold))


def list_source() -> str:
    """Lists of `int` and `str` beside an unrelated function, so lowering requests the runtime Loaf's list instances."""
    unrelated = "def unrelated(value: int) -> int:\n    return value + 1\n\n\n"
    lists = "    mut items = [1, 2, 3]\n    items.append(4)\n    names = [\"a\", \"b\"]\n"
    entry = "def main() -> None:\n" + lists + "    println(items[3])\n    println(names[1])\n    println(unrelated(41))\n"
    return unrelated + entry


def generic_source(index: str) -> str:
    """A generic used at two instances beside an unrelated function, selecting the element at `index`."""
    generic = "def pick[T](items: list[T]) -> T:\n    return items[" + index + "]\n\n\n"
    unrelated = "def unrelated(value: int) -> int:\n    return value + 1\n\n\n"
    entry = "def main() -> None:\n    println(pick([1, 2, 3]))\n    println(pick([\"a\", \"b\", \"c\"]))\n    println(unrelated(41))\n"
    return generic + unrelated + entry


pub def test_concurrent_identical_requests_bake_once() -> Result[None, str]:
    """Four concurrent requests for one new program share one unit evaluation and one native bake."""
    scratch = scratch_directory()?
    root = scratch.path()
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    source = root.joinpath("shared.incn")
    store = root.joinpath("store")
    write(
        source,
        "def twice(value: int) -> int:\n    return value * 2\n\n\ndef main() -> None:\n    println(twice(21))\n",
    )?
    first = started_run(binary, source, store)?
    second = started_run(binary, source, store)?
    third = started_run(binary, source, store)?
    fourth = started_run(binary, source, store)?
    first_output = first.wait_with_output().map_err((error) => str(error))?
    second_output = second.wait_with_output().map_err((error) => str(error))?
    third_output = third.wait_with_output().map_err((error) => str(error))?
    fourth_output = fourth.wait_with_output().map_err((error) => str(error))?
    reports = [
        finished_run(first_output.status.success(), first_output.stdout, first_output.stderr)?,
        finished_run(second_output.status.success(), second_output.stdout, second_output.stderr)?,
        finished_run(third_output.status.success(), third_output.stdout, third_output.stderr)?,
        finished_run(fourth_output.status.success(), fourth_output.stdout, fourth_output.stderr)?,
    ]
    mut evaluations = 0
    mut bakes = 0
    for report in reports:
        evaluations += proof_count(report, "unit_evaluations")?
        bakes += proof_count(report, "native_bakes")?
    stop_example_engine(binary, store)?
    assert evaluations == 1, f"four concurrent requests evaluated the unit {evaluations} times"
    assert bakes == 1, f"four concurrent requests baked the unit {bakes} times"
    return Ok(None)


def started_run(binary: str, source: Path, store: Path) -> Result[Child, str]:
    """Start one records-engine run of `source` against `store`, collecting its report and output."""
    mut command = Command.new(binary)
    command.arg("run").arg(source.0).args(["--profile", "release", "--engine-report"])
    command.env("INCAN_ENGINE", "records").env("INCAN_BAKERY", store.0)
    command.stdin(Stdio.null()).stdout(Stdio.piped()).stderr(Stdio.piped())
    return command.spawn().map_err((error) => f"cannot start {binary}: {error}")


def finished_run(succeeded: bool, stdout: bytes, stderr: bytes) -> Result[JsonValue, str]:
    """Require one concurrent run's success, its program output and silence, then return its proof report."""
    text = decoded(stdout)
    errors = decoded(stderr)
    if not succeeded or not text.endswith("42\n") or errors != "":
        return Err(f"concurrent run: stdout={text} stderr={errors}")
    return command_proof(stdout)


def verify_signature_edit(binary: str, root: Path) -> Result[None, str]:
    """A signature edit through a symlink must recheck main and reproduce the cold plan and executable."""
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("hello.incn")
    store = root.joinpath("store")
    write(source, "def value() -> int:\n    return 1\n\n\ndef main() -> None:\n    println(value())\n")?
    _ = lowering_example_run(binary, source, store, "1")?
    write(source, "def value() -> str:\n    return \"one\"\n\n\ndef main() -> None:\n    println(value())\n")?
    warm = lowering_example_run(binary, source, store, "one")?
    diagnostic = warm.to_json().map_err((error) => error.message())?
    assert proof_count(warm, "body_evaluations")? == 2, diagnostic
    assert proof_count(warm, "plan_function_evaluations")? == 3, diagnostic
    assert proof_count(warm, "plan_function_reuses")? == 0, diagnostic
    plan = root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?
    executable = root.joinpath("target/incan/release/bin/hello").read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, store)?
    root.joinpath("target").remove_tree().map_err((error) => error.message())?
    cold_store = root.joinpath("cold-store")
    _ = lowering_example_run(binary, source, cold_store, "one")?
    assert plan == root.joinpath("native.plan").read_bytes().map_err((error) => error.message())?, "warm and cold native plans differ"
    assert executable == root.joinpath("target/incan/release/bin/hello").read_bytes().map_err((error) => error.message())?, "warm and cold executables differ"
    return stop_example_engine(binary, cold_store)


def verify_rust_source_edit_rebuild(binary: str, root: Path) -> Result[None, str]:
    """Build a three-layer local dependency and require exact work after editing only its Rust source."""
    provider = root.joinpath("provider")
    app = root.joinpath("app")
    provider.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    provider.joinpath("rust/src").mkdir(true, true).map_err((error) => error.message())?
    app.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(
        provider.joinpath("loaf.toml"),
        "[project]\nname = \"rust_edit_provider\"\nversion = \"0.1.0\"\n\n[rust]\nname = \"rust_edit_native\"\ntype = \"lib\"\nedition = \"2024\"\n\n[rust.source]\nroot = \"rust\"\n",
    )?
    write(
        provider.joinpath("src/lib.incn"),
        "from rust::rust_edit_native import native_value\n\n\npub def value() -> int:\n    return native_value()\n",
    )?
    native = provider.joinpath("rust/src/lib.rs")
    write(native, "pub fn native_value() -> i64 {\n    42\n}\n")?
    write(
        app.joinpath("loaf.toml"),
        "[project]\nname = \"rust_edit_app\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n\n[dependencies]\nrust_edit_provider = { path = \"../provider\" }\n",
    )?
    write(
        app.joinpath("src/main.incn"),
        "from pub::rust_edit_provider import value\n\n\ndef main() -> None:\n    println(value())\n",
    )?
    store = root.joinpath("store")
    _ = rust_source_probe_build(binary, app, store)?
    executable = app.joinpath("target/incan/debug/bin/rust_edit_app")
    require_probe_output(executable, "42")?
    write(native, "pub fn native_value() -> i64 {\n    43\n}\n")?
    edited = rust_source_probe_build(binary, app, store)?
    edited_diagnostic = edited.to_json().map_err((error) => error.message())?
    require_probe_output(executable, "43")?
    assert proof_count(edited, "source_reads")? == 1, edited_diagnostic
    assert proof_count(edited, "source_listings")? == 0, edited_diagnostic
    assert proof_count(edited, "body_evaluations")? == 0, edited_diagnostic
    assert proof_count(edited, "unit_evaluations")? == 1, edited_diagnostic
    assert proof_count(edited, "native_bakes")? == 1, edited_diagnostic
    unchanged = rust_source_probe_build(binary, app, store)?
    unchanged_diagnostic = unchanged.to_json().map_err((error) => error.message())?
    assert proof_count(unchanged, "source_reads")? == 0, unchanged_diagnostic
    assert proof_count(unchanged, "source_listings")? == 0, unchanged_diagnostic
    assert proof_count(unchanged, "body_evaluations")? == 0, unchanged_diagnostic
    assert proof_count(unchanged, "unit_evaluations")? == 0, unchanged_diagnostic
    assert proof_count(unchanged, "native_bakes")? == 0, unchanged_diagnostic
    return stop_example_engine(binary, store)


def require_probe_output(executable: Path, expected: str) -> Result[None, str]:
    """Run the linked probe and require its exact source-selected value."""
    outcome = Command.new(executable.0).output().map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or output != expected + "\n" or errors != "":
        return Err(f"Rust source probe: status={outcome.status.code()} stdout={output} stderr={errors}")
    return Ok(None)


def rust_source_probe_build(binary: str, app: Path, store: Path) -> Result[JsonValue, str]:
    """Build one debug probe through records lowering and return its measured proof report."""
    outcome = Command
        .new(binary)
        .arg("build")
        .arg(app.0)
        .args(["--profile", "debug", "--engine-report"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or errors != "":
        return Err(f"Rust source probe: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def verify_rust_closure_debug_reproducibility(binary: str, root: Path) -> Result[None, str]:
    """A debug edit linked through an Incan library and local Rust library must reproduce its cold executable."""
    provider = root.joinpath("provider")
    app = root.joinpath("app")
    provider.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    provider.joinpath("rust/src").mkdir(true, true).map_err((error) => error.message())?
    app.joinpath("src").mkdir(true, true).map_err((error) => error.message())?
    write(
        provider.joinpath("loaf.toml"),
        "[project]\nname = \"debug_repro_provider\"\nversion = \"0.1.0\"\n\n[rust]\nname = \"debug_repro_native\"\ntype = \"lib\"\nedition = \"2024\"\n\n[rust.source]\nroot = \"rust\"\n",
    )?
    write(
        provider.joinpath("src/lib.incn"),
        "from rust::debug_repro_native import native_value\n\n\npub def value() -> int:\n    return native_value()\n",
    )?
    write(provider.joinpath("rust/src/lib.rs"), "pub fn native_value() -> i64 {\n    42\n}\n")?
    write(
        app.joinpath("loaf.toml"),
        "[project]\nname = \"debug_repro_app\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n\n[dependencies]\ndebug_repro_provider = { path = \"../provider\" }\n",
    )?
    source = app.joinpath("src/main.incn")
    write(source, "from pub::debug_repro_provider import value\n\n\ndef main() -> None:\n    println(value())\n")?
    warm_store = root.joinpath("warm-store")
    _ = debug_probe_build(binary, app, warm_store)?
    write(source, "from pub::debug_repro_provider import value\n\n\ndef main() -> None:\n    println(value() + 1)\n")?
    warm_report = debug_probe_build(binary, app, warm_store)?
    diagnostic = warm_report.to_json().map_err((error) => error.message())?
    assert proof_count(warm_report, "native_bakes")? == 1, diagnostic
    executable = app.joinpath("target/incan/debug/bin/debug_repro_app")
    warm = executable.read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, warm_store)?
    app.joinpath("target").remove_tree().map_err((error) => error.message())?
    # The cold build starts from an empty bakery at the same path. A development executable names its carriers'
    # bakery (debug map and run-time search paths), so a bakery at another path is a relocation, not a cold build.
    warm_store.remove_tree().map_err((error) => error.message())?
    _ = debug_probe_build(binary, app, warm_store)?
    cold = executable.read_bytes().map_err((error) => error.message())?
    stop_example_engine(binary, warm_store)?
    assert warm == cold, "warm and cold debug executables with a Rust library differ"
    return Ok(None)


def debug_probe_build(binary: str, app: Path, store: Path) -> Result[JsonValue, str]:
    """Build one real debug probe through records lowering and return its measured proof report."""
    outcome = Command
        .new(binary)
        .arg("build")
        .arg(app.0)
        .args(["--profile", "debug", "--engine-report"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or errors != "":
        return Err(f"debug reproducibility probe: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def stop_example_engine(binary: str, store: Path) -> Result[None, str]:
    """Stop one disposable records engine after its final request."""
    mut identity = service_identity(store)?
    identity.service_generation = service_generation(binary)?
    mut channel = connect_with(store, identity, binary).map_err((refusal) => refusal.detail)?
    channel
        .send(zero_id(), Message.Stop(Stop(reason="lowering example completed")))
        .map_err((refusal) => refusal.detail)?
    stopped = channel.receive().map_err((refusal) => refusal.detail)?
    match stopped.message:
        Message.Event(value) =>
            assert value.status == "Stopping"
        _ => return Err("lowering example did not stop its engine")
    _ = channel.transport.close()
    return Ok(None)


def lowering_example_run(binary: str, source: Path, store: Path, expected: str) -> Result[JsonValue, str]:
    """Run one real engine request and require both successful native output and its measured proof."""
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release", "--engine-report"])
        .env("INCAN_NATIVE_PLAN_REPORT", source.parent().joinpath("native.plan").0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or not output.endswith(expected + "\n") or errors != "":
        return Err(f"lowering example: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def lowering_example_run_with_fingerprints(
    binary: str,
    source: Path,
    store: Path,
    expected: str,
) -> Result[JsonValue, str]:
    """Run one native request while asking the adapter for per-definition tracked-input evidence."""
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release", "--engine-report"])
        .env("INCAN_NATIVE_PLAN_REPORT", source.parent().joinpath("native.plan").0)
        .env("INCAN_NATIVE_FINGERPRINT_REPORT", source.parent().joinpath("native.fingerprints").0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or not output.endswith(expected + "\n") or errors != "":
        return Err(f"lowering example: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def command_proof(output: bytes) -> Result[JsonValue, str]:
    """Decode the first line emitted by `--engine-report`, leaving the following program stdout independent."""
    text = from_utf8(output).map_err((error) => str(error))?
    lines = text.split("\n")
    if len(lines) < 2:
        return Err("records command emitted no proof report")
    return parse(lines[0]).map_err((error) => error.message())


def report_fixture_build(binary: str, project: Path, store: Path, trace: Option[Path] = None) -> Result[JsonValue, str]:
    """Build one fixture through the records engine and decode its requested report."""
    mut command = Command.new(binary)
    command.arg("build")
        .arg(project.0)
        .args(["--profile", "release", "--engine-report"])
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
    if let Some(directory) = trace:
        command.env("INCAN_ENGINE_TRACE", directory.0)
    outcome = command.output().map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    if not outcome.status.success() or (errors != "" and (trace is None or "warning[INCAN-T0125]" not in errors)):
        return Err(f"checker report fixture: status={outcome.status.code()} stdout={output} stderr={errors}")
    return command_proof(outcome.stdout)


def proof_count(report: JsonValue, name: str) -> Result[int, str]:
    """Read one required producer counter without accepting an absent or nonnumeric field."""
    return report.require(name).map_err((error) => error.message())?.expect_int().map_err((error) => error.message())


def proof_refusal_count(report: JsonValue, name: str) -> Result[int, str]:
    """Read one grouped artifact refusal count, requiring the report's structured refusal object."""
    refusals = report
        .require("artifact_refusals")
        .map_err((error) => error.message())?
        .expect_object()
        .map_err((error) => error.message())?
    match refusals.get(name):
        Some(value) => return value.expect_int().map_err((error) => error.message())
        None => return Ok(0)


def native_fingerprints(root: Path) -> Result[list[str], str]:
    """Read the adapter's one-line-per-definition tracked-input report."""
    text = root.joinpath("native.fingerprints").read_text("utf-8", "strict").map_err((error) => error.message())?
    return Ok([line for line in text.split("\n") if line != ""])


def fingerprint_for(rows: list[str], function: str) -> Result[str, str]:
    """Select one function's complete tracked fingerprint without accepting duplicates."""
    matches = [row.split("\t")[2] for row in rows if len(row.split("\t")) == 4 and row.split("\t")[1] == function]
    if len(matches) != 1:
        return Err(f"native fingerprint report has {len(matches)} rows for {function}: {rows}")
    return Ok(matches[0])


def partition_for(rows: list[str], function: str) -> Result[str, str]:
    """Select one function's fixed native partition without accepting duplicates."""
    matches = [row.split("\t")[3] for row in rows if len(row.split("\t")) == 4 and row.split("\t")[1] == function]
    if len(matches) != 1:
        return Err(f"native fingerprint report has {len(matches)} partitions for {function}: {rows}")
    return Ok(matches[0])
