"""Clove units: their archives are part of the identity of every unit that reaches them, and entries select targets."""

from rust::std::env import current_exe
from rust::std::env::consts import ARCH
from rust::std::process import Command
from rust::std::string import String as RustString
from std.environ import get_or
from std.fs import Path
from c_facet import CCompile, CConfiguration, CFacet
from c_interop import host_triple
from clove_units import CloveConfigurationUnit, CloveUnit, clove_unit, entry_applies
from files import read, write
from scratch import scratch_directory
from trace_adapter import finish as finish_trace
from unit import UnitDescription
from unit_freshness import description_digest


def clove(root: str, identity: str, definitions: list[str]) -> CloveUnit:
    """One Clove with one compiled configuration under `root`."""
    return CloveUnit(
        name="shim",
        root=root,
        library="shim",
        public_headers=["include/shim.h"],
        include=[f"{root}/include"],
        cplusplus=false,
        compiler="host:fixed",
        configurations=[
            CloveConfigurationUnit(
                name="default",
                definitions=definitions,
                archive=f"{root}/target/incan/cloves/shim/default/debug/libshim.a",
                identity=identity,
            ),
        ],
    )


def linking(cloves: list[CloveUnit]) -> UnitDescription:
    """A program unit that reaches `cloves`, described with fixed locations."""
    return UnitDescription(
        source="/checkout/project/src/main.incn",
        project_root="/checkout/project",
        source_root="/checkout/project/src",
        package="app",
        version="0.1.0",
        profile="debug",
        declared_features=[],
        active_features=[],
        loaves=[],
        rust_crates=[],
        contract_models=[],
        c_headers=[],
        cloves=cloves,
    )


pub def test_a_rebuilt_clove_archive_rekeys_the_units_that_reach_it() -> Result[None, str]:
    """
    A unit is compiled again when a Clove it reaches compiled different archive bytes or definitions.

    1. Reaching a Clove changes the description digest.
    2. A rebuilt archive with different bytes, or different definitions, changes it again.
    3. The same archive at another location keeps it.
    """
    # 1. The Clove is an input of the unit.
    first = description_digest(linking([clove("/checkout/project", "sha256:aa", ["SHIM_OFFSET=2"])]))?
    assert first != description_digest(linking([]))?
    # 2. Different archive bytes or definitions are a different input.
    assert description_digest(linking([clove("/checkout/project", "sha256:bb", ["SHIM_OFFSET=2"])]))? != first
    assert description_digest(linking([clove("/checkout/project", "sha256:aa", ["SHIM_OFFSET=3"])]))? != first
    # 3. Locations are provenance, not identity.
    assert description_digest(linking([clove("/elsewhere/project", "sha256:aa", ["SHIM_OFFSET=2"])]))? == first
    return Ok(None)


pub def test_a_compile_entry_selects_the_host_by_exact_triple_or_cfg() -> Result[None, str]:
    """
    A compile entry's `target` selects the host by its exact triple or by a cfg predicate over the host's facts.

    1. No predicate always applies.
    2. The host's exact triple applies and another triple does not.
    3. A cfg predicate is evaluated against the host's architecture.
    """
    # 1. An entry without a target compiles everywhere.
    assert entry_applies(CCompile(sources=["a.c"]))?
    # 2. Exact triples compare whole, so `aarch64-apple-darwin` selects a macOS arm64 host.
    assert entry_applies(CCompile(sources=["a.c"], target=Some(host_triple())))?
    assert not entry_applies(CCompile(sources=["a.c"], target=Some("riscv64gc-unknown-none-elf")))?
    # 3. The cfg form reads the host's facts.
    assert entry_applies(CCompile(sources=["a.c"], target=Some(f"cfg(target_arch = \"{ARCH}\")")))?
    return Ok(None)


pub def test_editing_one_configuration_recompiles_only_that_clove_unit() -> Result[None, str]:
    """
    Editing one configuration's source compiles that configuration again and reuses every other configuration.

    1. Build two configurations in a traced child process.
    2. Edit only the default configuration's source and build both again.
    3. Count three compiles total: default twice, alternate once, with alternate reused on the second build.
    """
    if get_or("INCAN_CLOVE_REBUILD_PROOF_CHILD", "") == "1":
        return edit_one_configuration(get_or("INCAN_CLOVE_REBUILD_PROOF_ROOT", ""))

    scratch = scratch_directory()?
    trace = scratch.path().joinpath("clove.trace")
    executable = current_exe().map_err((error) => str(error))?.to_string_lossy().into_owned()
    outcome = Command
        .new(executable)
        .arg("--exact")
        .arg("test_editing_one_configuration_recompiles_only_that_clove_unit")
        .arg("--nocapture")
        .arg("--test-threads=1")
        .env("INCAN_CLOVE_REBUILD_PROOF_CHILD", "1")
        .env("INCAN_CLOVE_REBUILD_PROOF_ROOT", scratch.path().0)
        .env("INCAN_C_COMPILER", "host")
        .env("OVEN_TRACE", trace.0)
        .output()
        .map_err((error) => str(error))?
    if not outcome.status.success():
        error = RustString.from_utf8_lossy(outcome.stderr).into_owned()
        return Err(f"Clove rebuild proof child failed: {outcome.status.code()} {error}")
    reasons = read(trace)?
    assert occurrences(reasons, "oven: unit proof clove default: compiled") == 2
    assert occurrences(reasons, "oven: unit proof clove alternate: compiled") == 1
    assert occurrences(reasons, "oven: unit proof clove alternate: reused") == 1
    assert occurrences(reasons, "oven: unit proof clove default: reused") == 0
    return Ok(None)


def edit_one_configuration(root: str) -> Result[None, str]:
    """Build two configuration-specific sources, edit one, and build the Clove again."""
    Path(root).joinpath("include").mkdir(true, true).map_err((error) => error.message())?
    Path(root).joinpath("csrc").mkdir(true, true).map_err((error) => error.message())?
    write(Path(root).joinpath("include/proof.h"), "int proof_value(void);\n")?
    default_source = Path(root).joinpath("csrc/default.c")
    write(default_source, "int proof_value(void) { return 1; }\n")?
    write(Path(root).joinpath("csrc/alternate.c"), "int proof_value(void) { return 2; }\n")?
    facet = CFacet(
        library="proof",
        public_headers=["include/proof.h"],
        configurations={"alternate": CConfiguration(sources=["csrc/alternate.c"]), "default": CConfiguration(
            sources=["csrc/default.c"],
        )},
    )
    _ = clove_unit("proof", root, facet, "debug", root)?
    write(default_source, "int proof_value(void) { return 3; }\n")?
    _ = clove_unit("proof", root, facet, "debug", root)?
    finish_trace()
    return Ok(None)


def occurrences(text: str, needle: str) -> int:
    """How often one exact trace fragment occurs."""
    return len(text.split(needle)) - 1
