from rust::std::env::consts import OS

const UNIT_DOMAIN: str = "incan.oven.unit/4"
const INVOKE: bytes = b"invoke\x00"
const CODEGEN_DOMAIN: str = "incan.oven.codegen/2"


pub def artifact_files(directory: Path, package: str) -> Result[list[Path], str]:
    """The executable DD-0007 artifact set; optional inspection graphs are not native compilation inputs."""
    linked = native_crate_name(package)
    compiled = [f"lib{linked}.rlib", f"{artifact_stem(package)}.incnlib", f"{artifact_stem(package)}.incnbody"]
    described = [f"{artifact_stem(package)}.native.json"]
    mut artifacts = [directory.joinpath(name) for name in compiled + described]
    cache = directory.joinpath(f"{artifact_stem(package)}.rustabi")
    if artifact_available(cache):
        artifacts.append(cache)
    # The semantic facts a library's compiler published travel with its manifest when it published them.
    facts = directory.joinpath(f"{artifact_stem(package)}.incnfacts")
    if artifact_available(facts):
        artifacts.append(facts)
    manifest = directory.joinpath(f"{artifact_stem(package)}.incnlib")
    if artifact_available(manifest):
        declared = manifest_vocabulary(manifest)?
        if not declared.desugarer.is_null():
            artifacts.append(directory.joinpath("vocab-worker"))
    return Ok(artifacts)


pub def artifact_available(path: Path) -> bool:
    """Whether a frozen installation payload was admitted or an editable project artifact exists now."""
    return frozen_observation(path).is_some() or path.is_file()


pub def artifact_identity(path: Path) -> Result[str, str]:
    """
    Use an admitted registry entry or frozen generation before observing a local artifact.

    That is its device and inode, size and mode, and the nanosecond times of its last modification and last status
    change: replacing the file changes the inode, and rewriting it in place changes the status change time even when
    the modification time is put back.
    """
    if let Some(stamp) = frozen_observation(path):
        # Registry-page recall adds a filesystem observation to the same authenticated producer.
        return Ok(admitted_registry_identity(path)?.unwrap_or(stamp))
    if let Some(identity) = admitted_payload_identity(path)?:
        return Ok(identity)
    clock = begin()
    result = observe(path)
    record_work(Operation.ArtifactIdentity, path.0, clock)
    return Ok(result?.stamp)


model ArtifactIdentityState:
    """Artifact generations first observed by one request."""

    pub files: Dict[str, str] = {}


pub model ArtifactIdentities:
    """One request's shared artifact identities, revalidated before the request accepts them."""

    pub state: Rc[RefCell[ArtifactIdentityState]] = Rc.new(RefCell.new(ArtifactIdentityState()))

    pub def identity(self, path: Path) -> Result[str, str]:
        """Observe one artifact only on its first use in this request."""
        mut held = self.state.as_ref().borrow_mut()
        return retained_artifact_identity(path, held.deref_mut())

    pub def verify(self) -> Result[None, str]:
        """Refuse any artifact whose filesystem generation changed after its retained observation."""
        held = self.state.as_ref().borrow()
        return verify_artifact_identities(held.deref())


def retained_artifact_identity(path: Path, mut state: BorrowedMut[ArtifactIdentityState]) -> Result[str, str]:
    """Return this request's first observed generation of `path`."""
    if path.0 in state.files:
        return Ok(state.files[path.0])
    identity = artifact_identity(path)?
    state.files[path.0] = identity
    return Ok(identity)


def verify_artifact_identities(state: Borrowed[ArtifactIdentityState]) -> Result[None, str]:
    """Reconcile retained generations once after every checked-context consumer has finished."""
    for path in sorted([key for key in state.files.keys()]):
        if frozen_observation(Path(path)) == Some(state.files[path]):
            continue
        if admitted_payload_identity(Path(path))? == Some(state.files[path]):
            continue
        if observe(Path(path))?.stamp != state.files[path]:
            return Err(f"artifact changed while preparing request: {path}")
    return Ok(None)


pub model Key:
    """A portable identity and its input dimensions, publication provenance, or a named refusal of portability."""

    pub digest: str
    # One `kind digest` line per kind of input, in a fixed order, so that a changed key can name what changed.
    pub parts: list[str]
    # Symbol identity excludes producer bytes while retaining authored source and effective code generation options.
    pub codegen: str = ""
    # Source origins travel with publication but never enter the identity or its changed-input dimensions.
    pub provenance: list[str] = []
    # A refused portable identity permits a local bake, never reusable publication under a fabricated key.
    pub refusal: str = ""
    # Exact descriptor publication is a provenance guard, separate from portable invocation identity.
    pub descriptor: str = ""
    # The admitted compiler input for revalidation; an opaque caller-owned key may omit its derivation context.
    pub compiler: str = ""
    # The identity over every authored byte, comments included, for outcomes that show source text or byte offsets:
    # replayed check reports and refusals, and codegraph exports. Empty when it equals `digest`.
    pub replay: str = ""

    pub def replayed(self) -> str:
        """The identity of an outcome that renders source: the raw identity, or `digest` when they agree."""
        if self.replay != "":
            return self.replay
        return self.digest


pub def unit_key(unit: UnitDescription, toolchain: Toolchain, compiler: str = "") -> Result[Key, str]:
    """Reconcile every input of `unit` against the retained observations; the key its outputs are valid for."""
    match identified_unit(unit, toolchain, compiler):
        Ok(key) => return Ok(key)
        Err(reason) =>
            if "unit identity refused:" in reason:
                return Ok(
                    Key(
                        digest="",
                        parts=[],
                        provenance=[unit.project_root, unit.source],
                        refusal=reason,
                        descriptor=fingerprint([json_text(unit.to_json())?])?,
                    ),
                )
            return Err(reason)


def identified_unit(unit: UnitDescription, toolchain: Toolchain, compiler: str) -> Result[Key, str]:
    """Finish identity only when the compiler and every linked unit have admitted identities."""
    mut project = load_ledger(unit_ledger(unit.project_root, ledger_name(unit)), SETTLE_SECONDS)
    mut base_compiler = compiler
    if base_compiler == "":
        base_compiler = compiler_fingerprint(toolchain)?
    refuse_stale_standard(unit, toolchain)?
    selected_compiler = selected_unit_compiler(unit, toolchain, base_compiler)?
    described = description_digest(unit)?
    # A program or test unit is keyed by what its collection read and probed, as the compiler reports it.
    graph = source_graph(unit, toolchain, f"{selected_compiler} {described}", project)?
    mut key = reconciled_key(unit, selected_compiler, described, project, graph)?
    # Revalidation receives the reusable base and derives the unit-specific SDK dimension once again.
    key.compiler = base_compiler
    return Ok(key)


pub def collect_program_reach(unit: UnitDescription, toolchain: Toolchain) -> Result[Option[SourceGraph], str]:
    """Collect the ordinary unit-key graph before a standalone program has a recorded capture."""
    mut project = load_ledger(unit_ledger(unit.project_root, ledger_name(unit)), SETTLE_SECONDS)
    compiler = selected_unit_compiler(unit, toolchain, compiler_fingerprint(toolchain)?)?
    graph = source_graph(unit, toolchain, f"{compiler} {description_digest(unit)?}", project)?
    project.save()?
    return Ok(graph)


pub def graph_imports(unit: UnitDescription, toolchain: Toolchain) -> Result[Option[list[JsonValue]], str]:
    """
    The Rust crate requests recorded with the unit's current source graph under the scope `unit_key` reads, when the
    compiler reported them: the requests `--rust-imports` prints for the same files, compiler and description.
    """
    mut project = load_ledger(unit_ledger(unit.project_root, ledger_name(unit)), SETTLE_SECONDS)
    selected_compiler = selected_unit_compiler(unit, toolchain, compiler_fingerprint(toolchain)?)?
    return recorded_imports(unit, f"{selected_compiler} {description_digest(unit)?}", project)


def refuse_stale_standard(unit: UnitDescription, toolchain: Toolchain) -> Result[None, str]:
    """
    Refuse a linked standard Loaf of this toolchain that another compiler produced.

    A relink keeps the Loaves but replaces the compiler, and its new compiler may not read their records.
    """
    standard = Path(toolchain.driver).parent().parent().joinpath("loaves").0 + "/"
    mut current = ""
    for loaf in unit.loaves:
        if not loaf.dir.startswith(standard):
            continue
        if current == "":
            current = compiler_fingerprint(toolchain)?
        match stale_standard_refusal(loaf.name, Path(loaf.dir), current)?:
            Some(message) => return Err(message)
            None => pass
    return Ok(None)


pub def reconciled_key(
    unit: UnitDescription,
    compiler: str,
    described: str,
    mut project: Ledger,
    graph: Option[SourceGraph] = None,
) -> Result[Key, str]:
    """
    The key of a unit against a ledger that may already hold what earlier requests observed.

    The ledger is saved when this reconciliation changed it, and the work it could not avoid is traced.
    """
    hashed = project.hashed
    listed = project.listed
    key = unit_key_with(unit, compiler, described, project, graph)?
    project.save()?
    work = f"hashed {project.hashed - hashed} files, listed {project.listed - listed} directories"
    trace(f"{ledger_name(unit)}: key {key.digest[:12]}, {work}")
    return Ok(key)


pub def ledger_name(unit: UnitDescription) -> str:
    """The name a unit's ledger is saved under: one per profile, kind and package, so units never share rows."""
    mut name = unit.package
    if name == "":
        name = Path(unit.source).stem()
    return f"{unit.profile}-{unit.kind}-{name}"


pub def compiler_fingerprint(toolchain: Toolchain) -> Result[str, str]:
    """
    Identify the selected compiler by content and its target, independently of its installation location.

    1. Read admitted compiler and Rust fact-cache digests.
    2. Read the identities the linked native units were produced under.
    3. Bind the target and deployment selection without including installation paths. SDK contents belong only to
       units that read or link them, through `selected_unit_compiler`.
    4. Bind the native-closure schemas the compiler and Oven publish, so records from an earlier closure form are
       misses rather than closures this generation cannot resolve.

    The compiler-record pin stays out: it selects how the compiler reads the standard Loaves, whose own identities key
    each unit that links them, and every pack seals a set of its own, so a home installed from a pack would otherwise
    reuse nothing its builder compiled.
    """
    # 1. Installed selections carry the identities admitted with their immutable page. Synthetic and staged
    # toolchains without a page retain the direct fact lookup used by installation preparation and focused tests.
    mut facts: list[str] = []
    if len(toolchain.compiler_facts) == len(toolchain.rust_abi) + 1:
        facts = [toolchain.compiler_facts[0]] + toolchain_cache_identities(toolchain)?
    else:
        facts = [fact_identity(Path(toolchain.driver))?] + cache_identities(toolchain.rust_abi)?
    # 2. Native dependencies carry identities recorded by their producers, never inferred from payloads.
    natives = native_identities(toolchain.externs)?
    # 3. Registry selection and search directories locate providers; the exact linked identities select them.
    #    The compiler's own answers are probed once per rustc installation and deployment selection.
    target = compiler_target(toolchain)?
    selection = inherited_deployment_selection()?
    mut deployment = toolchain.default_deployment_target
    if len(selection) > 0 or toolchain.rust_version == "":
        deployment = deployment_target(rust_compiler(toolchain), target, selection)?
    facts.extend([target, deployment])
    # 4. The schemas name the reference form of every native closure a unit of this compiler publishes or reads.
    facts.extend([NATIVE_CLOSURE_SCHEMA, RUST_NATIVE_SCHEMA])
    return fingerprint(facts + natives)


pub def unit_compiler_identity(unit: UnitDescription, compiler: str, sdk: str) -> Result[str, str]:
    """Bind SDK contents only to unit kinds whose compiler invocation can read them."""
    if unit.kind not in ["program", "test"] and len(unit.c_headers) == 0 and len(unit.cloves) == 0:
        return Ok(compiler)
    return fingerprint([compiler, sdk])


pub def selected_unit_compiler(unit: UnitDescription, toolchain: Toolchain, compiler: str) -> Result[str, str]:
    """Use the admitted default SDK identity for a final link or C-ABI unit."""
    if unit.kind not in ["program", "test"] and len(unit.c_headers) == 0 and len(unit.cloves) == 0:
        return Ok(compiler)
    if toolchain.default_sdk_identity != "":
        return unit_compiler_identity(unit, compiler, toolchain.default_sdk_identity)
    return unit_compiler_identity(unit, compiler, sdk_content_identity(toolchain.sysroot)?)


pub def sdk_content_identity(sysroot: str) -> Result[str, str]:
    """Identify the selected SDK's declared contents without its installation location or selection observations."""
    mut sdk = selected_sdk(sysroot)?
    if sdk == "":
        sdk = get_or("SDKROOT", "")
    if sdk == "":
        return Ok("")
    return sdk_settings_identity(Path(sdk).joinpath("SDKSettings.json"))


pub def sdk_settings_identity(settings: Path) -> Result[str, str]:
    """Admit a newly selected SDK settings generation exactly where SDK-sensitive work first reads it."""
    admit_fact(settings)?
    return fingerprint([fact_identity(settings)?])


def compiler_target(toolchain: Toolchain) -> Result[str, str]:
    """Read the installed compiler's version and host without retaining its physical sysroot location."""
    if toolchain.target != "":
        return Ok(toolchain.target)
    if toolchain.rust_version != "":
        return Ok(toolchain.rust_version)
    return compiler_version(rust_compiler(toolchain))


pub def native_identities(externs: list[NativeCrate]) -> Result[list[str], str]:
    """
    Canonical native aliases and the content their producers published, without reading artifact bytes.

    A linked dependency is identified by the digest of the bytes its publication recorded, not by its producer
    identity, so a rebuild that produced the same native code, such as a documentation edit, rekeys none of its
    consumers. A toolchain native keeps the identity it was admitted under, together with where the installation
    holds it, anchored as a unit's native closure names it: an installation keeps its natives in generation
    directories, and a unit baked against one generation names that directory, which another installation with the
    same natives in another generation does not have.
    """
    mut inputs: list[str] = []
    mut anchors = NativeAnchors(toolchain="", bakery="")
    for native in externs:
        if native.identity != "":
            anchors = native_anchors()?
            break
    for native in externs:
        mut identity = native.identity
        if identity == "":
            _, content = publication(Path(native.path))?
            identity = f"content {content}"
        else:
            identity = f"{identity} at {anchored_reference(native.path, anchors)}"
        inputs.append(f"{native.name} {identity}")
    return Ok(sorted(inputs))


pub def cache_identities(caches: list[str]) -> Result[list[str], str]:
    """Read admitted Rust-fact digests in canonical order, independently of their installation paths."""
    mut inputs: list[str] = []
    for path in caches:
        inputs.append(fact_identity(Path(path))?)
    return Ok(sorted(inputs))


pub def toolchain_cache_identities(toolchain: Toolchain) -> Result[list[str], str]:
    """Use Rust ABI identities sealed into an installed page, retaining direct lookup for staged toolchains."""
    if len(toolchain.compiler_facts) == len(toolchain.rust_abi) + 1:
        return Ok(sorted(toolchain.compiler_facts[1:]))
    return cache_identities(toolchain.rust_abi)


pub def description_digest(unit: UnitDescription) -> Result[str, str]:
    """Only facts the compiler observes, excluding source, target and provider locations retained as provenance."""
    mut uuid_salt = ""
    if OS == "macos":
        uuid_salt = DARWIN_UUID_SALT
    bindings = [f"{loaf.key}={loaf.name}:{loaf.standard}:{loaf.toolchain_provided}" for loaf in unit.loaves]
    mut flags = native_arguments(unit.profile)
    if unit.kind in ["program", "test"]:
        flags = native_executable_arguments(unit.profile)
    selected = [f"feature={feature}" for feature in sorted(unit.active_features)]
    declared = [f"declared-feature={feature}" for feature in sorted(unit.declared_features)]
    mut record_identity: list[str] = []
    if let Some(registry) = unit.registry_id:
        record_identity.append(f"registry-id={registry}")
    # A project's shared library is checked as a program, and a test unit linking it reads its imports through it;
    # the modules it leaves out are source inputs. A unit with neither keeps the identity it had before them.
    if let Some(library) = unit.project_library:
        record_identity.append(f"project-library={library}")
    if unit.program_checks:
        record_identity.append("program-checks")
    description = model_description(INVOKE, "incan.oven.compiler-invocation/1", [
        ModelField(identity=b"crate_", name="crate_name", storage="string"),
        ModelField(identity=b"versio", name="version", storage="string"),
        ModelField(identity=b"editio", name="edition", storage="string"),
        ModelField(identity=b"domain", name="domain", storage="string"),
        ModelField(identity=b"kind__", name="kind", storage="string"),
        ModelField(identity=b"srcmap", name="source_mapping", storage="string"),
        ModelField(identity=b"tchmap", name="toolchain_mapping", storage="string"),
        ModelField(identity=b"uidslt", name="linker_uuid_salt", storage="string"),
        ModelField(identity=b"ovrchk", name="overflow_checks", storage="boolean"),
        ModelField(identity=b"vocabl", name="vocabulary", storage="boolean"),
        ModelField(identity=b"policy", name="vocabulary_policy", storage="string"),
        ModelField(identity=b"desugr", name="vocabulary_desugarer", storage="boolean"),
        ModelField(identity=b"flags_", name="native_flags", storage="list<string>"),
        ModelField(identity=b"select", name="selected_features", storage="list<string>"),
        ModelField(identity=b"declrd", name="declared_features", storage="list<string>"),
        ModelField(identity=b"bindng", name="loaf_bindings", storage="list<string>"),
        ModelField(identity=b"rustcr", name="rust_crates", storage="list<string>"),
        ModelField(identity=b"vocadm", name="vocabulary_admissions", storage="list<string>"),
        ModelField(identity=b"access", name="toolchain_access", storage="list<string>"),
        ModelField(identity=b"recids", name="record_inputs", storage="list<string>"),
        ModelField(identity=b"cloves", name="clove_inputs", storage="list<string>"),
    ])
    encoded = encode_graph_row(INVOKE, description, [
        required_value(b"crate_", Value.Text(unit.package)),
        required_value(b"versio", Value.Text(unit.version)),
        required_value(b"editio", Value.Text("2024")),
        required_value(b"domain", Value.Text("target")),
        required_value(b"kind__", Value.Text(unit.kind)),
        required_value(b"srcmap", Value.Text(SOURCE_PREFIX)),
        required_value(b"tchmap", Value.Text(TOOLCHAIN_PREFIX)),
        required_value(b"uidslt", Value.Text(uuid_salt)),
        required_value(b"ovrchk", Value.Boolean(unit.profile != "release")),
        required_value(b"vocabl", Value.Boolean(unit.vocabulary)),
        required_value(b"policy", Value.Text(unit.vocab_policy)),
        required_value(b"desugr", Value.Boolean(unit.vocab_desugarer)),
        required_value(b"flags_", Value.List([Value.Text(item) for item in flags])),
        required_value(b"select", Value.List([Value.Text(item) for item in selected])),
        required_value(b"declrd", Value.List([Value.Text(item) for item in declared])),
        required_value(b"bindng", Value.List([Value.Text(item) for item in sorted(bindings)])),
        required_value(b"rustcr", Value.List([Value.Text(item) for item in sorted(unit.rust_crates)])),
        required_value(b"vocadm", Value.List([Value.Text(item) for item in sorted(unit.vocab_admissions)])),
        required_value(b"access", Value.List([Value.Text(item) for item in access_facts(unit)])),
        required_value(b"recids", Value.List([Value.Text(item) for item in record_identity])),
        required_value(b"cloves", Value.List([Value.Text(item) for item in clove_facts(unit)])),
    ])?
    return Ok(hexlify(sha256.digest(encoded)))


def clove_facts(unit: UnitDescription) -> list[str]:
    """
    Each Clove the unit reaches, by its library, compiler and every configuration's definitions and archive bytes, so
    a rebuilt archive rekeys the units that link it, each declared static archive it links, and the declared target its
    bindings verify against when `--interop-target` selects one. Locations are provenance. A unit that reaches none
    has none.
    """
    mut facts: list[str] = []
    for clove in unit.cloves:
        facts.append(f"clove={clove.name}:{clove.library}:{clove.cplusplus}:{clove.compiler}")
        facts.extend([f"clove-header={clove.name}:{header}" for header in clove.public_headers])
        for configuration in clove.configurations:
            definitions = ",".join(configuration.definitions)
            facts.append(f"clove-configuration={clove.name}:{configuration.name}:{definitions}:{configuration.identity}")
    # Declared static archives link in order, so their order is identity too.
    for archive in unit.c_archives:
        facts.append(f"static-archive={archive.name}:{archive.link_name}:{archive.identity}")
    if let Some(target) = unit.c_abi_target:
        facts.append(target.fact())
    return facts


def access_facts(unit: UnitDescription) -> list[str]:
    """
    The declared rustc-internal access, and the sysroot an executable that links its libraries loads them from. An
    undeclared unit has none, so its identity is the one it had before units could declare access.
    """
    mut facts = unit.toolchain_access.identity_lines()
    if unit.runtime_sysroot != "" and unit.kind != "library":
        facts.append(f"runtime-sysroot={unit.runtime_sysroot}")
    return facts


pub def linked_natives(unit: UnitDescription) -> list[NativeCrate]:
    """The unit's native crates except its declared sysroot libraries, which the compiler fingerprint identifies."""
    return [native for native in unit.externs if native.name not in unit.toolchain_access.sysroot_dependencies]


pub def unit_key_with(
    unit: UnitDescription,
    compiler: str,
    described: str,
    mut project: Ledger,
    graph: Option[SourceGraph] = None,
) -> Result[Key, str]:
    """
    Digest compiled source contents and fold the recorded identities of the units it links.

    A caller that keeps the unit's description digest (it only changes with the description) passes it in. Sorted
    logical source bindings make added, removed and renamed modules observable. Dependency identities bind consumers
    to rebuilt providers, including transitive ones.

    1. Pair every authored file the compilation reads with its digest.
    2. Pair every linked artifact with its identity.
    3. Combine them with the compiler and the description into the key.
    """
    # 1. An edit to any authored file the compilation reads changes the key; an untouched file costs no read.
    # A program or test unit's native code reads only positioned code, so comments that move no code are not its inputs.
    native = unit.kind in ["program", "test"]
    sources = source_contents(unit, project, graph, native)?
    # 2. A rebuilt library or native crate the unit links changes the key of the unit linking it. The selected
    # compiler identity already binds every admitted Rust ABI cache, so repeating those lookups here would reopen
    # frozen installation inputs after admission.
    artifacts = loaf_identities(unit)? + native_identities(linked_natives(unit))?
    # 3. The compiler and the unit's description are part of the key beside its two kinds of input.
    key = assembled(compiler, described, sources, artifacts)?
    mut replay = ""
    if native:
        replay = assembled(compiler, described, source_contents(unit, project, graph, false)?, artifacts)?.digest
    return Ok(
        Key(
            digest=key.digest,
            parts=key.parts,
            codegen=key.codegen,
            provenance=[unit.project_root, unit.source],
            descriptor=fingerprint([json_text(unit.to_json())?])?,
            compiler=key.compiler,
            replay=replay,
        ),
    )


def source_contents(
    unit: UnitDescription,
    mut project: Ledger,
    graph: Option[SourceGraph],
    code: bool,
) -> Result[list[str], str]:
    """
    Resolve declared entries from their project and identify their roles without physical source locations.

    A unit with a source graph reads exactly its graph's files, and the graph's absent paths are inputs too: a file
    created at one changes what collection reads. Any other unit reads every source under its roots.
    With `code`, an Incan source counts by its positioned code (`Ledger.code_digest`) instead of its bytes.
    """
    root = Path(unit.source_root)
    declared = Path(unit.project_root)
    mut entry_digest = ""
    if code:
        entry_digest = project.code_digest(Path(unit.source))?
    else:
        entry_digest = project.digest(Path(unit.source))?
    mut contents = ["entry", entry_scope(Path(unit.source), root), entry_digest]
    match graph:
        Some(collected) =>
            # The collection's own paths are physical; bind them under the physical root.
            physical = root.resolve().unwrap_or(root)
            entry = Path(unit.source).resolve().unwrap_or(Path(unit.source)).0
            modules = [path for path in collected.read if path != entry and path != unit.source]
            contents.extend(source_inputs(modules, physical, project, code)?)
            contents.extend(["absent"] + absent_inputs(collected.absent, physical))
        None =>
            # A project's shared library reads no test module, so editing a test never rebuilds it.
            modules = [path for path in unit_files(unit, project)? if path != unit.source and path not in unit.excluded_sources]
            contents.extend(source_inputs(modules, root, project, code)?)
    for entry in unit.program_entries:
        contents.extend(["program-entry"] + source_inputs([declared.joinpath(entry).0], root, project)?)
    # A batch unit's further test modules are entries of their own, in run order.
    for entry in unit.test_batch:
        contents.extend(["test-batch"] + source_inputs([declared.joinpath(entry).0], root, project)?)
    if let Some(entry) = unit.vocab_entry:
        contents.extend(["vocabulary-entry"] + source_inputs([declared.joinpath(entry).0], root, project)?)
    for schema in unit.contract_models:
        contents.extend(["contract-model", project.digest(Path(unit.project_root).joinpath(schema))?])
    for header in unit.c_headers:
        contents.extend(["c-header", project.digest(Path(unit.project_root).joinpath(header))?])
    # A Clove's public headers are verification inputs even when an edit leaves its archive bytes unchanged.
    for clove in unit.cloves:
        for header in clove.public_headers:
            contents.extend(["clove-header", project.digest(Path(clove.root).joinpath(header))?])
    if let Some(vocab) = unit.vocab:
        contents.extend(["vocabulary", vocabulary_facts(Path(vocab))?])
    return Ok(contents)


pub def vocabulary_facts(path: Path) -> Result[str, str]:
    """Identify prepared vocabulary semantics and producer identities, excluding worker payload checksums and locations."""
    prepared = read_json(path)?
    worker = prepared.require("worker").map_err((error) => error.message())?
    mut provider = JsonValue.null()
    if not worker.is_null():
        provider = JsonValue.object(
            {"kind": JsonValue.string(required_text(worker, "artifact_kind")?), "unit": JsonValue.string(
                required_text(worker, "unit_identity")?,
            ), "abi": worker.require("abi_version").map_err((error) => error.message())?},
        )
    facts = JsonValue.object(
        {"module": JsonValue.string(required_text(prepared, "crate_path")?), "package": JsonValue.string(
            required_text(prepared, "package_name")?,
        ), "registration": JsonValue.string(required_text(prepared, "unit_identity")?), "metadata": prepared
            .require("metadata")
            .map_err((error) => error.message())?, "worker": provider},
    )
    return fingerprint([json_text(facts)?])


def loaf_identities(unit: UnitDescription) -> Result[list[str], str]:
    """
    Canonical Loaf bindings and the identities their consumer is keyed on; absent producer evidence refuses.

    A unit is keyed on the semantic facts the Loaf's publication recorded, so a documentation edit in the Loaf leaves
    it alone (RFC 179); what a program or test links is identified by its content in `native_identities`. A Loaf
    whose publication recorded no facts keys its consumers on its producer identity.
    """
    mut inputs: list[str] = []
    for loaf in unit.loaves:
        path = Path(loaf.dir).joinpath(f"{artifact_stem(loaf.name)}.incnlib")
        mut identity = published_identity(path)?
        if let Some(facts) = published_facts(path)?:
            identity = f"facts {facts}"
        inputs.append(f"{loaf.key}={loaf.name} {identity}")
    return Ok(sorted(inputs))


def assembled(compiler: str, described: str, sources: list[str], artifacts: list[str]) -> Result[Key, str]:
    """Build separate producer-sensitive reuse and producer-independent codegen identities."""
    authored = fingerprint(sources)?
    linked = fingerprint(artifacts)?
    digest = "sha256:" + fingerprint([UNIT_DOMAIN, compiler, described, authored, linked])?
    codegen = "sha256:" + fingerprint([CODEGEN_DOMAIN, described, authored])?
    parts = [f"compiler {compiler}", f"description {described}", f"sources {authored}", f"artifacts {linked}"]
    return Ok(Key(digest=digest, parts=parts, codegen=codegen, compiler=compiler))


def unit_files(unit: UnitDescription, mut project: Ledger) -> Result[list[str], str]:
    """
    The source files and metadata inputs a unit's compilation reads; manifest facts already reach its invocation.

    Modules resolve from the source root and from the entry's own directory, so an entry outside the source root (a
    test beside `src`) brings its directory with it; an entry in the project root brings only its own siblings.
    """
    root = Path(unit.project_root)
    mut paths = [unit.source]
    paths = paths + project.sources(Path(unit.source_root), true)?
    entry_directory = Path(unit.source).parent()
    if not unit.source.startswith(unit.source_root + "/"):
        paths = paths + project.sources(entry_directory, entry_directory.0 != unit.project_root)?
    for extra in unit.contract_models + unit.c_headers:
        paths.append(root.joinpath(extra).0)
    return Ok(unique(paths))


pub def fingerprint(inputs: list[str]) -> Result[str, str]:
    """Frame every input independently before hashing so paths and contents cannot alias each other."""
    text = json_text(JsonValue.array([JsonValue.string(value) for value in inputs]))?
    return Ok(hexlify(sha256.digest(text.encode("utf-8"))))


pub def reusable(outputs: list[Path], stamp: Path, key: Key) -> Result[bool, str]:
    """Whether the stamp of a completed build vouches for `key` and for the very outputs it recorded."""
    return Ok(staleness(outputs, stamp, key)? == "")


pub def staleness(outputs: list[Path], stamp: Path, key: Key) -> Result[str, str]:
    """
    Why the stored outputs cannot be kept for `key`; empty when they can.

    1. Without a stamp there is no stored build.
    2. A stamp of another key names the kinds of input that changed.
    3. A stamp records exactly the outputs expected.
    4. Every output is still the one the stamp recorded.
    """
    # 1. An output without a stamp was never vouched for.
    if key.refusal != "":
        return Ok(key.refusal)
    if not stamp.is_file():
        return Ok("no stored build")
    recorded = stamp.read_text("utf-8", "strict").map_err((error) => f"{stamp.0}: {error.message()}")?.split("\n")
    # 2. A stamp of another key says which kinds of input changed since, so a rebuild can say why.
    if recorded[0] != key.digest:
        return Ok(f"{changed_kinds(recorded[1:], key.parts)} changed")
    # 3. A stamp that recorded fewer or more outputs than expected describes some other build.
    first = 1 + len(key.parts)
    if len(recorded) != first + len(outputs):
        return Ok("the stored build is incomplete")
    # 4. Each output is the very file the stamp recorded, so a binary replaced behind its back is not reused.
    return replaced_output(outputs, recorded, first)


def replaced_output(outputs: list[Path], recorded: list[str], first: int) -> Result[str, str]:
    """Why an output is not the one the stamp recorded at line `first` onward; empty when each one is."""
    for index in range(len(outputs)):
        if not outputs[index].is_file():
            return Ok("the stored build is missing")
        if observe(outputs[index])?.stamp != recorded[first + index]:
            return Ok("the stored build was replaced")
    return Ok("")


def changed_kinds(recorded: list[str], parts: list[str]) -> str:
    """The kinds of input whose digest differs from the recorded one, as a list in words."""
    mut kinds: list[str] = []
    for part in parts:
        if part not in recorded:
            kinds.append(part.split(" ")[0])
    if len(kinds) == 0:
        return "inputs"
    return ", ".join(kinds)


pub def record(stamp: Path, key: Key, outputs: list[Path], borrowed: list[Path] = []) -> Result[None, str]:
    """Stamp every output's generation, publishing owned payloads while preserving borrowed units' producer identities."""
    borrowed_paths = [artifact.0 for artifact in borrowed]
    if key.refusal != "":
        if stamp.is_file():
            stamp.unlink().map_err((error) => f"cannot {error.message()}")?
        for output in outputs:
            if output.0 not in borrowed_paths:
                record_payload(output, "", key.provenance, key.refusal)?
        return Ok(None)
    mut lines = [key.digest] + key.parts
    for output in outputs:
        lines.append(observe(output)?.stamp)
        if output.0 not in borrowed_paths:
            record_payload(output, key.digest, key.provenance)?
    return publish(stamp, "\n".join(lines))


pub def install_all(staged: list[Path], finals: list[Path], stamp: Path, key: Key) -> Result[None, str]:
    """
    Replace the stored outputs with a completed build of `key`: each staged file is renamed onto its place.

    The old stamp goes first and the new one comes last, so no stamp ever vouches for outputs it did not describe: an
    interruption leaves either no stamp, or a stamp and outputs that belong together.
    """
    if stamp.is_file():
        stamp.unlink().map_err((error) => f"{stamp.0}: {error.message()}")?
    for index in range(len(staged)):
        place(staged[index], finals[index])?
    return record(stamp, key, finals)


pub def replay_key(key: Key) -> Key:
    """`key` under its raw identity, for an output that shows source text or positions, such as a codegraph export."""
    mut raw = key
    raw.digest = key.replayed()
    raw.replay = ""
    return raw
