"""Identify units by compiled sources, effective invocation facts and recorded linked identities; guard reuse locally."""

from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from std.json import JsonValue
from codegen import native_arguments, SOURCE_PREFIX
from files import json_text, read_json
from json_fields import required_text
from home import unit_ledger
from loaf_local_graph import unique
from manifest_vocabulary import manifest_vocabulary
from observation import Ledger, SETTLE_SECONDS, load_ledger, observe, trace
from jec import begin, record as record_work
from publication import place, publish
from toolchain import NativeCrate, Toolchain, rust_compiler
from unit import UnitDescription
from unit_publication import published_identity, record_payload
from source_identity import entry_scope, source_inputs
from compiler_facts import fact_identity
from rust_target import compiler_version, deployment_target, inherited_deployment_selection
from apple_sdk import selected_sdk
from std.environ import get_or

const UNIT_DOMAIN: str = "incan.oven.unit/2"


pub def artifact_files(directory: Path, package: str) -> Result[list[Path], str]:
    """The complete DD-0007 artifact set required to reuse a library."""
    linked = package.replace("-", "_")
    compiled = [f"lib{linked}.rlib", f"{package}.incnlib", f"{package}.incnbody"]
    described = [f"{package}.native.json", f"{package}.incngraph"]
    mut artifacts = [directory.joinpath(name) for name in compiled + described]
    cache = directory.joinpath(f"{package}.rustabi")
    if cache.is_file():
        artifacts.append(cache)
    manifest = directory.joinpath(f"{package}.incnlib")
    if manifest.is_file():
        declared = manifest_vocabulary(manifest)?
        if not declared.desugarer.is_null():
            artifacts.append(directory.joinpath("vocab-worker"))
    return Ok(artifacts)


pub def artifact_identity(path: Path) -> Result[str, str]:
    """
    Identify a published artifact by its filesystem identity, without reading its bytes.

    That is its device and inode, size and mode, and the nanosecond times of its last modification and last status
    change: replacing the file changes the inode, and rewriting it in place changes the status change time even when
    the modification time is put back.
    """
    clock = begin()
    result = observe(path)
    record_work("artifact_identity", path.0, clock)
    return Ok(result?.stamp)


pub model Key:
    """A portable identity and its input dimensions, publication provenance, or a named refusal of portability."""

    pub digest: str
    # One `kind digest` line per kind of input, in a fixed order, so that a changed key can name what changed.
    pub parts: list[str]
    # Source origins travel with publication but never enter the identity or its changed-input dimensions.
    pub provenance: list[str] = []
    # A refused portable identity permits a local bake, never reusable publication under a fabricated key.
    pub refusal: str = ""
    # Exact descriptor publication is a provenance guard, separate from portable invocation identity.
    pub descriptor: str = ""


pub def unit_key(unit: UnitDescription, toolchain: Toolchain, compiler: str = "") -> Result[Key, str]:
    """Reconcile every input of `unit` against the retained observations; the key its outputs are valid for."""
    match identified_unit(unit, toolchain, compiler):
        Ok(key) => return Ok(key)
        Err(reason) =>
            if "unit identity refused:" in reason:
                return Ok(
                    Key(
                        digest="",
                        parts=[],
                        provenance=[unit.project_root, unit.source],
                        refusal=reason,
                        descriptor=fingerprint([json_text(unit.to_json())?])?,
                    ),
                )
            return Err(reason)


def identified_unit(unit: UnitDescription, toolchain: Toolchain, compiler: str) -> Result[Key, str]:
    """Finish identity only when the compiler and every linked unit have admitted identities."""
    mut project = load_ledger(unit_ledger(unit.project_root, ledger_name(unit)), SETTLE_SECONDS)
    mut selected_compiler = compiler
    if selected_compiler == "":
        selected_compiler = compiler_fingerprint(toolchain)?
    return reconciled_key(unit, selected_compiler, description_digest(unit)?, project)


pub def reconciled_key(unit: UnitDescription, compiler: str, described: str, mut project: Ledger) -> Result[Key, str]:
    """
    The key of a unit against a ledger that may already hold what earlier requests observed.

    The ledger is saved when this reconciliation changed it, and the work it could not avoid is traced.
    """
    hashed = project.hashed
    listed = project.listed
    key = unit_key_with(unit, compiler, described, project)?
    project.save()?
    work = f"hashed {project.hashed - hashed} files, listed {project.listed - listed} directories"
    trace(f"{ledger_name(unit)}: key {key.digest[:12]}, {work}")
    return Ok(key)


pub def ledger_name(unit: UnitDescription) -> str:
    """The name a unit's ledger is saved under: one per profile, kind and package, so units never share rows."""
    mut name = unit.package
    if name == "":
        name = Path(unit.source).stem()
    return f"{unit.profile}-{unit.kind}-{name}"


pub def compiler_fingerprint(toolchain: Toolchain) -> Result[str, str]:
    """
    Identify the selected compiler by content and its target, independently of its installation location.

    1. Read admitted compiler and Rust fact-cache digests.
    2. Read the identities the linked native units were produced under.
    3. Bind the target and selected SDK settings without including their installation paths.
    """
    # 1. Metadata avoids reading unchanged compiler facts but never enters the compiler identity.
    mut facts = [fact_identity(Path(toolchain.driver))?] + cache_identities(toolchain.rust_abi)?
    # 2. Native dependencies carry identities recorded by their producers, never inferred from payloads.
    natives = native_identities(toolchain.externs)?
    # 3. Registry selection and search directories locate providers; the exact linked identities select them.
    #    The compiler's own answers are probed once per rustc installation and deployment selection.
    target = compiler_target(toolchain)?
    facts.extend([target, deployment_target(rust_compiler(toolchain), target, inherited_deployment_selection()?)?])
    return fingerprint(facts + natives + [sdk_content_identity(toolchain.sysroot)?])


pub def sdk_content_identity(sysroot: str) -> Result[str, str]:
    """Identify the selected SDK's declared contents without its installation location or selection observations."""
    mut sdk = selected_sdk(sysroot)?
    if sdk == "":
        sdk = get_or("SDKROOT", "")
    if sdk == "":
        return Ok("")
    return fingerprint(cache_identities([Path(sdk).joinpath("SDKSettings.json").0])?)


def compiler_target(toolchain: Toolchain) -> Result[str, str]:
    """Read the installed compiler's version and host without retaining its physical sysroot location."""
    if toolchain.target != "":
        return Ok(toolchain.target)
    return compiler_version(rust_compiler(toolchain))


pub def native_identities(externs: list[NativeCrate]) -> Result[list[str], str]:
    """Canonical native aliases and the identities their producers recorded, without reading artifact bytes."""
    mut inputs: list[str] = []
    for native in externs:
        inputs.append(f"{native.name} {published_identity(Path(native.path))?}")
    return Ok(sorted(inputs))


pub def cache_identities(caches: list[str]) -> Result[list[str], str]:
    """Read admitted Rust-fact digests in canonical order, independently of their installation paths."""
    mut inputs: list[str] = []
    for path in caches:
        inputs.append(fact_identity(Path(path))?)
    return Ok(sorted(inputs))


pub def description_digest(unit: UnitDescription) -> Result[str, str]:
    """Only facts the compiler observes, excluding source, target and provider locations retained as provenance."""
    facts = JsonValue.object(
        {"crate": JsonValue.string(unit.package), "version": JsonValue.string(unit.version), "edition": JsonValue.string(
            "2024",
        ), "domain": JsonValue.string("target"), "kind": JsonValue.string(unit.kind), "source_mapping": JsonValue.string(
            SOURCE_PREFIX,
        ), "overflow_checks": JsonValue.bool(unit.profile != "release"), "vocabulary": JsonValue.bool(unit.vocabulary), "vocab_policy": JsonValue.string(
            unit.vocab_policy,
        ), "vocab_desugarer": JsonValue.bool(unit.vocab_desugarer)},
    )
    bindings = [f"{loaf.key}={loaf.name}:{loaf.standard}:{loaf.toolchain_provided}" for loaf in unit.loaves]
    flags = native_arguments(unit.profile)
    selected = [f"feature={feature}" for feature in sorted(unit.active_features)]
    declared = [f"declared-feature={feature}" for feature in sorted(unit.declared_features)]
    return fingerprint(
        [json_text(facts)?] + flags + selected + declared + sorted(bindings) + sorted(unit.rust_crates) + sorted(
            unit.vocab_admissions,
        ) + access_facts(unit),
    )


def access_facts(unit: UnitDescription) -> list[str]:
    """
    The declared rustc-internal access, and the sysroot an executable that links its libraries loads them from. An
    undeclared unit has none, so its identity is the one it had before units could declare access.
    """
    mut facts = unit.toolchain_access.identity_lines()
    if unit.runtime_sysroot != "" and unit.kind != "library":
        facts.append(f"runtime-sysroot={unit.runtime_sysroot}")
    return facts


pub def linked_natives(unit: UnitDescription) -> list[NativeCrate]:
    """The unit's native crates except its declared sysroot libraries, which the compiler fingerprint identifies."""
    return [native for native in unit.externs if native.name not in unit.toolchain_access.sysroot_dependencies]


pub def unit_key_with(unit: UnitDescription, compiler: str, described: str, mut project: Ledger) -> Result[Key, str]:
    """
    Digest compiled source contents and fold the recorded identities of the units it links.

    A caller that keeps the unit's description digest (it only changes with the description) passes it in. Sorted
    logical source bindings make added, removed and renamed modules observable. Dependency identities bind consumers
    to rebuilt providers, including transitive ones.

    1. Pair every authored file the compilation reads with its digest.
    2. Pair every linked artifact with its identity.
    3. Combine them with the compiler and the description into the key.
    """
    # 1. An edit to any authored file the compilation reads changes the key; an untouched file costs no read.
    sources = source_contents(unit, project)?
    # 2. A rebuilt library, native crate or ABI cache the unit links changes the key of the unit linking it.
    artifacts = loaf_identities(unit)? + native_identities(linked_natives(unit))? + cache_identities(unit.rust_abi)?
    # 3. The compiler and the unit's description are part of the key beside its two kinds of input.
    key = assembled(compiler, described, sources, artifacts)?
    return Ok(
        Key(
            digest=key.digest,
            parts=key.parts,
            provenance=[unit.project_root, unit.source],
            descriptor=fingerprint([json_text(unit.to_json())?])?,
        ),
    )


def source_contents(unit: UnitDescription, mut project: Ledger) -> Result[list[str], str]:
    """Resolve declared entries from their project and identify their roles without physical source locations."""
    root = Path(unit.source_root)
    declared = Path(unit.project_root)
    mut contents = ["entry", entry_scope(Path(unit.source), root), project.digest(Path(unit.source))?]
    modules = [path for path in unit_files(unit, project)? if path != unit.source]
    contents.extend(source_inputs(modules, root, project)?)
    for entry in unit.program_entries:
        contents.extend(["program-entry"] + source_inputs([declared.joinpath(entry).0], root, project)?)
    if let Some(entry) = unit.vocab_entry:
        contents.extend(["vocabulary-entry"] + source_inputs([declared.joinpath(entry).0], root, project)?)
    for schema in unit.contract_models:
        contents.extend(["contract-model", project.digest(Path(unit.project_root).joinpath(schema))?])
    for header in unit.c_headers:
        contents.extend(["c-header", project.digest(Path(unit.project_root).joinpath(header))?])
    if let Some(vocab) = unit.vocab:
        contents.extend(["vocabulary", vocabulary_facts(Path(vocab))?])
    return Ok(contents)


def vocabulary_facts(path: Path) -> Result[str, str]:
    """Identify prepared vocabulary semantics and producer identities, excluding worker payload checksums and locations."""
    prepared = read_json(path)?
    worker = prepared.require("worker").map_err((error) => error.message())?
    mut provider = JsonValue.null()
    if not worker.is_null():
        provider = JsonValue.object(
            {"kind": JsonValue.string(required_text(worker, "artifact_kind")?), "unit": JsonValue.string(
                required_text(worker, "unit_identity")?,
            ), "abi": worker.require("abi_version").map_err((error) => error.message())?},
        )
    facts = JsonValue.object(
        {"module": JsonValue.string(required_text(prepared, "crate_path")?), "package": JsonValue.string(
            required_text(prepared, "package_name")?,
        ), "registration": JsonValue.string(required_text(prepared, "unit_identity")?), "metadata": prepared
            .require("metadata")
            .map_err((error) => error.message())?, "worker": provider},
    )
    return fingerprint([json_text(facts)?])


def loaf_identities(unit: UnitDescription) -> Result[list[str], str]:
    """Canonical Loaf bindings and their published producer identities; absent producer evidence refuses."""
    mut inputs: list[str] = []
    for loaf in unit.loaves:
        path = Path(loaf.dir).joinpath(f"{loaf.name}.incnlib")
        inputs.append(f"{loaf.key}={loaf.name} {published_identity(path)?}")
    return Ok(sorted(inputs))


def assembled(compiler: str, described: str, sources: list[str], artifacts: list[str]) -> Result[Key, str]:
    """A key from the digests of its four kinds of input."""
    authored = fingerprint(sources)?
    linked = fingerprint(artifacts)?
    digest = "sha256:" + fingerprint([UNIT_DOMAIN, compiler, described, authored, linked])?
    parts = [f"compiler {compiler}", f"description {described}", f"sources {authored}", f"artifacts {linked}"]
    return Ok(Key(digest=digest, parts=parts))


def unit_files(unit: UnitDescription, mut project: Ledger) -> Result[list[str], str]:
    """
    The source files and metadata inputs a unit's compilation reads; manifest facts already reach its invocation.

    Modules resolve from the source root and from the entry's own directory, so an entry outside the source root (a
    test beside `src`) brings its directory with it; an entry in the project root brings only its own siblings.
    """
    root = Path(unit.project_root)
    mut paths = [unit.source]
    paths = paths + project.sources(Path(unit.source_root), true)?
    entry_directory = Path(unit.source).parent()
    if not unit.source.startswith(unit.source_root + "/"):
        paths = paths + project.sources(entry_directory, entry_directory.0 != unit.project_root)?
    for extra in unit.contract_models + unit.c_headers:
        paths.append(root.joinpath(extra).0)
    return Ok(unique(paths))


pub def fingerprint(inputs: list[str]) -> Result[str, str]:
    """Frame every input independently before hashing so paths and contents cannot alias each other."""
    text = json_text(JsonValue.array([JsonValue.string(value) for value in inputs]))?
    return Ok(hexlify(sha256.digest(text.encode("utf-8"))))


pub def reusable(outputs: list[Path], stamp: Path, key: Key) -> Result[bool, str]:
    """Whether the stamp of a completed build vouches for `key` and for the very outputs it recorded."""
    return Ok(staleness(outputs, stamp, key)? == "")


pub def staleness(outputs: list[Path], stamp: Path, key: Key) -> Result[str, str]:
    """
    Why the stored outputs cannot be kept for `key`; empty when they can.

    1. Without a stamp there is no stored build.
    2. A stamp of another key names the kinds of input that changed.
    3. A stamp records exactly the outputs expected.
    4. Every output is still the one the stamp recorded.
    """
    # 1. An output without a stamp was never vouched for.
    if key.refusal != "":
        return Ok(key.refusal)
    if not stamp.is_file():
        return Ok("no stored build")
    recorded = stamp.read_text("utf-8", "strict").map_err((error) => f"{stamp.0}: {error.message()}")?.split("\n")
    # 2. A stamp of another key says which kinds of input changed since, so a rebuild can say why.
    if recorded[0] != key.digest:
        return Ok(f"{changed_kinds(recorded[1:], key.parts)} changed")
    # 3. A stamp that recorded fewer or more outputs than expected describes some other build.
    first = 1 + len(key.parts)
    if len(recorded) != first + len(outputs):
        return Ok("the stored build is incomplete")
    # 4. Each output is the very file the stamp recorded, so a binary replaced behind its back is not reused.
    return replaced_output(outputs, recorded, first)


def replaced_output(outputs: list[Path], recorded: list[str], first: int) -> Result[str, str]:
    """Why an output is not the one the stamp recorded at line `first` onward; empty when each one is."""
    for index in range(len(outputs)):
        if not outputs[index].is_file():
            return Ok("the stored build is missing")
        if observe(outputs[index])?.stamp != recorded[first + index]:
            return Ok("the stored build was replaced")
    return Ok("")


def changed_kinds(recorded: list[str], parts: list[str]) -> str:
    """The kinds of input whose digest differs from the recorded one, as a list in words."""
    mut kinds: list[str] = []
    for part in parts:
        if part not in recorded:
            kinds.append(part.split(" ")[0])
    if len(kinds) == 0:
        return "inputs"
    return ", ".join(kinds)


pub def record(stamp: Path, key: Key, outputs: list[Path], borrowed: list[Path] = []) -> Result[None, str]:
    """Stamp every output's generation, publishing owned payloads while preserving borrowed units' producer identities."""
    borrowed_paths = [artifact.0 for artifact in borrowed]
    if key.refusal != "":
        if stamp.is_file():
            stamp.unlink().map_err((error) => error.message())?
        for output in outputs:
            if output.0 not in borrowed_paths:
                record_payload(output, "", key.provenance, key.refusal)?
        return Ok(None)
    mut lines = [key.digest] + key.parts
    for output in outputs:
        lines.append(observe(output)?.stamp)
        if output.0 not in borrowed_paths:
            record_payload(output, key.digest, key.provenance)?
    return publish(stamp, "\n".join(lines))


pub def install_all(staged: list[Path], finals: list[Path], stamp: Path, key: Key) -> Result[None, str]:
    """
    Replace the stored outputs with a completed build of `key`: each staged file is renamed onto its place.

    The old stamp goes first and the new one comes last, so no stamp ever vouches for outputs it did not describe: an
    interruption leaves either no stamp, or a stamp and outputs that belong together.
    """
    if stamp.is_file():
        stamp.unlink().map_err((error) => f"{stamp.0}: {error.message()}")?
    for index in range(len(staged)):
        place(staged[index], finals[index])?
    return record(stamp, key, finals)
