"""Validate Rust library reuse against rustc's recorded file and environment dependencies."""

from rust::std::env import VarError, var as env_var
from std.fs import Path
from files import read, write
from observation import load_ledger, observe, skipped_directory, SETTLE_SECONDS
from toolchain import Toolchain, located
from unit_freshness import Key, artifact_identity, compiler_fingerprint, fingerprint

# How a key spells the project directory, so the same sources key alike in any checkout.
const PROJECT: str = "<project>"


pub def library_key(
    project: Path,
    directory: Path,
    dependencies: Path,
    arguments: list[str],
    environment: Dict[str, str],
    linked: list[str],
    toolchain: Toolchain,
    compiler: str = "",
) -> Result[Key, str]:
    """
    Key the actual compiler inputs; unavailable dependency evidence prevents reuse.

    1. Read the files and environment keys rustc recorded.
    2. Reconcile their current contents, read in this checkout, and the exact linked libraries.
    3. Bind them to the compiler, arguments and package environment, spelling the project's own paths from it.
    """
    # 1. Read the files and environment keys rustc recorded, in whichever checkout it compiled.
    text = read(dependencies)?
    paths, variables = dependency_inputs(text)?
    recorded = recorded_project(paths, project, crate_root(arguments))
    mut ledger = load_ledger(directory.joinpath("observations.json"), SETTLE_SECONDS)
    mut sources: list[str] = []
    # 2. A source is keyed by where it sits relative to its project and by the bytes this checkout holds there.
    for relative in sorted([relative_path(path, recorded) for path in paths] + ["loaf.toml"]):
        sources.extend([relative, ledger.digest(Path(located(project, relative)))?])
    mut artifacts: list[str] = []
    for path in sorted(linked + extern_paths(arguments)):
        artifacts.extend([path, artifact_identity(Path(path))?])
    ledger.save()?
    # 3. Bind them to the compiler, arguments and package environment.
    mut selected_compiler = compiler
    if selected_compiler == "":
        selected_compiler = compiler_fingerprint(toolchain)?
    command = fingerprint([project_argument(argument, project) for argument in arguments])?
    authored = fingerprint(sources)?
    native = fingerprint(artifacts)?
    ambient = fingerprint(environment_inputs(variables, keyed_environment(environment, variables, project))?)?
    digest = fingerprint(["incan.oven.rust-library/2", selected_compiler, command, authored, native, ambient])?
    return Ok(
        Key(
            digest=digest,
            parts=[
                f"compiler {selected_compiler}",
                f"command {command}",
                f"sources {authored}",
                f"artifacts {native}",
                f"environment {ambient}",
            ],
        ),
    )


def crate_root(arguments: list[str]) -> str:
    """The crate root a producer command compiles: its first argument, ahead of every option."""
    if len(arguments) == 0 or arguments[0].startswith("-"):
        return ""
    return arguments[0]


def recorded_project(paths: list[str], project: Path, root: str) -> str:
    """The project directory rustc's evidence was recorded in, found through the crate root path it names."""
    if not root.startswith(project.0 + "/"):
        return project.0
    suffix = root[len(project.0):]
    for path in paths:
        if path.endswith(suffix):
            return path[:len(path) - len(suffix)]
    return project.0


pub def relative_path(path: str, base: str) -> str:
    """`path` as seen from the directory `base`, so one layout spells it alike in any checkout."""
    if not path.startswith("/"):
        return path
    directories = [part for part in base.split("/") if part != ""]
    parts = [part for part in path.split("/") if part != ""]
    mut common = 0
    while common < len(directories) and common < len(parts) and directories[common] == parts[common]:
        common += 1
    return "/".join([".." for _ in range(len(directories) - common)] + parts[common:])


pub def project_argument(argument: str, project: Path) -> str:
    """Spell a path inside the project from the project, so a command keys alike in any checkout."""
    return argument.replace(project.0 + "/", PROJECT + "/")


def keyed_environment(environment: Dict[str, str], variables: list[str], project: Path) -> Dict[str, str]:
    """The package environment as keyed: the manifest directory stays a location unless the crate reads it."""
    mut keyed = environment
    if "CARGO_MANIFEST_DIR" in keyed and "CARGO_MANIFEST_DIR" not in variables:
        keyed["CARGO_MANIFEST_DIR"] = PROJECT
    return keyed


pub def producer_arguments(arguments: list[str]) -> list[str]:
    """
    Keep the native producer command independent of unrelated installed search directories.

    Exact extern artifacts, their identities, source dependencies, environment and code generation flags remain in
    the producer key. Search directories locate those artifacts; they do not select another provider identity.
    """
    mut retained: list[str] = []
    mut directory = false
    for argument in arguments:
        if directory:
            directory = false
        elif argument == "-L":
            directory = true
        else:
            retained.append(argument)
    return retained


pub def dependency_arguments(arguments: list[str], dependencies: Path) -> list[str]:
    """Discover rustc's full dependency set without generating a library before its inputs can be observed."""
    return without_emission(arguments) + ["--emit", f"dep-info={dependencies.0}"]


pub def graph_arguments(arguments: list[str]) -> list[str]:
    """Analyze the native inputs without writing a library or replacing its retained dependency evidence."""
    return without_emission(arguments) + ["--emit", "metadata"]


def without_emission(arguments: list[str]) -> list[str]:
    """Remove the caller-owned emission pair before selecting one native compiler observation mode."""
    mut retained: list[str] = []
    mut emission = false
    for argument in arguments:
        if emission:
            emission = false
        elif argument == "--emit":
            emission = true
        else:
            retained.append(argument)
    return retained


pub def compilation_observations(
    project: Path,
    dependencies: Path,
    arguments: list[str],
    linked: list[str],
    toolchain: Toolchain,
) -> Result[Dict[str, str], str]:
    """
    Capture inputs before compiling so later file changes cannot be vouched for by a completed build.

    1. Collect authored files, known external dependencies and installed native inputs.
    2. Retain their metadata before the compiler can read them.
    """
    # 1. Collect authored files, known external dependencies and installed native inputs.
    mut paths = authored_files(project, set())?
    paths.extend([toolchain.driver] + toolchain.rust_abi + [native.path for native in toolchain.externs])
    paths.extend(linked + extern_paths(arguments))
    if dependencies.is_file():
        match dependencies.read_text("utf-8", "strict"):
            Err(_) => pass
            Ok(text) =>
                match dependency_inputs(text):
                    Err(_) => pass
                    Ok(inputs) =>
                        external, _ = inputs
                        paths.extend([dependency_location(project, path).0 for path in external])
    # 2. Retain their metadata before the compiler can read them.
    mut observations: Dict[str, str] = {}
    for path in paths:
        observations[path] = observe(Path(path))?.stamp
    return Ok(observations)


pub def inputs_unchanged(dependencies: Path, observations: Dict[str, str], project: Path) -> Result[bool, str]:
    """
    Allow publication only for files captured before compilation and still unchanged afterward.

    1. Read the compiler's complete dependency list.
    2. Require every recorded dependency to have been observed before compilation.
    3. Refuse proof for any changed source, compiler or linked artifact.
    """
    # 1. Read the compiler's complete dependency list.
    text = read(dependencies)?
    paths, _ = dependency_inputs(text)?
    # 2. Require every recorded dependency to have been observed before compilation.
    for path in paths:
        if dependency_location(project, path).0 not in observations:
            return Ok(false)
    # 3. Refuse proof for any changed source, compiler or linked artifact.
    for path in observations.keys():
        if observe(Path(path))?.stamp != observations[path]:
            return Ok(false)
    return Ok(true)


def authored_files(root: Path, mut visited: set[str]) -> Result[list[str], str]:
    """Observe project files without entering outputs, hidden directories or symbolic-link cycles."""
    if root.is_file():
        return Ok([root.0])
    canonical = root.resolve().map_err((error) => error.message())?.0
    if canonical in visited:
        return Ok([])
    visited.add(canonical)
    mut paths: list[str] = []
    for entry in root.iterdir().map_err((error) => error.message())?:
        name = entry.name()
        if skipped_directory(name):
            continue
        paths.extend(authored_files(entry, visited)?)
    return Ok(paths)


def dependency_inputs(text: str) -> Result[tuple[list[str], list[str]], str]:
    """Read rustc's first dependency rule and tracked environment names, never its recorded values."""
    mut paths: list[str] = []
    mut variables: list[str] = []
    for line in text.replace("\\\n", "").split("\n"):
        if len(paths) == 0 and ": " in line and not line.startswith("#"):
            paths = dependency_paths(": ".join(line.split(": ")[1:]))?
        if line.startswith("# env-dep:"):
            variables.append(line[10:].split("=")[0])
    if len(paths) == 0:
        return Err("Rust dependency evidence contains no source files")
    return Ok((paths, variables))


def dependency_paths(text: str) -> Result[list[str], str]:
    """Decode make-style escaped spaces and backslashes; malformed evidence triggers compilation."""
    mut paths: list[str] = []
    mut path = ""
    mut escaped = false
    for character in text:
        if escaped:
            path += character
            escaped = false
        elif character == "\\":
            escaped = true
        elif character in " \t":
            if path != "":
                paths.append(path)
                path = ""
        else:
            path += character
    if escaped:
        return Err("Rust dependency evidence ends with an escape")
    if path != "":
        paths.append(path)
    return Ok(paths)


pub def extern_paths(arguments: list[str]) -> list[str]:
    """Extract named native libraries; rustc's built-in `proc_macro` has no artifact argument."""
    mut paths: list[str] = []
    for index in range(1, len(arguments)):
        if arguments[index - 1] == "--extern" and "=" in arguments[index]:
            paths.append("=".join(arguments[index].split("=")[1:]))
    return paths


def environment_inputs(names: list[str], environment: Dict[str, str]) -> Result[list[str], str]:
    """Observe tracked variables with package overrides, distinguishing unset from empty Unicode values."""
    mut inputs: list[str] = []
    for name in sorted(names + [key for key in environment.keys()]):
        inputs.append(name)
        if name in environment:
            inputs.extend(["set", environment[name]])
            continue
        match env_var(name):
            Ok(value) => inputs.extend(["set", str(value)])
            Err(error) =>
                match error:
                    VarError.NotPresent => inputs.append("unset")
                    _ => return Err("Rust environment dependency is not Unicode")
    return Ok(inputs)


pub def relocate_dependencies(dependencies: Path, project: Path) -> Result[None, str]:
    """
    Rewrite rustc's dependency evidence so it names no checkout or home: project files relative to the project and
    each rule's target by its file name. Evidence copied to another machine then still describes its sources.
    """
    prefixes = project_prefixes(project)
    text = read(dependencies)?
    rewritten = "\n".join([relocated_rule(line, prefixes) for line in text.split("\n")])
    if rewritten == text:
        return Ok(None)
    return write(dependencies, rewritten)


pub def dependency_location(project: Path, path: str) -> Path:
    """Where a recorded dependency is read: a relative name lies in the project that is being built."""
    if path.startswith("/"):
        return Path(path)
    return project.joinpath(path)


def project_prefixes(project: Path) -> list[str]:
    """The spellings of a project directory a dependency path can start with, as given and as resolved."""
    mut prefixes = [project.0 + "/"]
    match project.resolve():
        Ok(canonical) =>
            if canonical.0 + "/" not in prefixes:
                prefixes.append(canonical.0 + "/")
        Err(_) => pass
    return prefixes


def relocated_rule(line: str, prefixes: list[str]) -> str:
    """One dependency rule with its project files made relative and its absolute target reduced to a file name."""
    if line.startswith("#") or not line.endswith(":") and ": " not in line:
        return line
    mut target = line[:len(line) - 1]
    mut rest = ""
    if ": " in line:
        parts = line.split(": ")
        target = parts[0]
        rest = " " + ": ".join(parts[1:])
    for prefix in prefixes:
        rest = rest.replace(" " + prefix.replace(" ", "\\ "), " ")
    target = dependency_target(target, prefixes)
    return f"{target}:{rest}"


def dependency_target(target: str, prefixes: list[str]) -> str:
    """A rule target inside the project keeps its relative name; any other absolute target keeps its file name."""
    for prefix in prefixes:
        escaped = prefix.replace(" ", "\\ ")
        if target.startswith(escaped):
            return target[len(escaped):]
    if target.startswith("/"):
        return Path(target).name()
    return target
