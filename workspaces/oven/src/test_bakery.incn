"""Bakery contracts: one bake per identity across projects and processes, views that cost nothing to lose, collection."""

from rust::std::fs import Permissions, set_permissions
from rust::std::os::unix::fs import PermissionsExt
from rust::std::process import Command
from std.fs import Path
from std.fs.locking import FileLock
from bakery import (
    Fact,
    claim,
    claim_file,
    collect,
    fact_file,
    find,
    forget_verified,
    verification_entries,
    view,
    lookup,
    library_directory,
    register_root,
    seal,
    prepare_seal,
    staging,
    staging_root,
    view_directory,
    verify_all,
    repair_derived,
)
from segment_store import begin, commit, delete, get, keys, put, put_payload, payload_path, readmit_payload, snapshot
from files import make_directory, read, write as write_file
from incan_units import compile_executable, obtain_executable
from scratch import scratch_directory
from toolchain import Toolchain
from unit import UnitDescription
from unit_freshness import Key, fingerprint


def write(path: Path, text: str) -> Result[None, str]:
    """Create or replace a file, creating its directory."""
    make_directory(path.parent())?
    return write_file(path, text)


def bake(store: Path, identity: str, content: str, reaches: list[str] = [], name: str = "") -> Result[bool, str]:
    """Ask for `identity` the way Oven does; true when this call baked it, false when it found the unit."""
    if found(find(store, identity)?):
        return Ok(false)
    held = claim(store, identity)?
    if found(find(store, identity)?):
        return Ok(false)
    staged = staging(store, identity)?
    write(staged.joinpath("payload"), content)?
    mut label = name
    if label == "":
        label = f"dep\t{identity}"
    baked = seal(store, identity, staged, "library", label, reaches, "test")?
    return Ok(baked.identity == identity)


def claim_is_free(store: Path, identity: str) -> Result[bool, str]:
    """Whether nobody holds the claim of `identity`; the probe's own lock is released when this returns."""
    make_directory(claim_file(store, identity).parent())?
    probe = claim_file(store, identity).try_lock_exclusive().map_err((error) => error.message())?
    return Ok(locked(probe))


def project_unit(root: Path) -> Result[UnitDescription, str]:
    """A program unit of a project at `root` with one source and no Loaves."""
    write(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\n")?
    write(root.joinpath("src").joinpath("main.incn"), "def main() -> None:\n    pass\n")?
    return Ok(
        UnitDescription(
            source=root.joinpath("src").joinpath("main.incn").0,
            project_root=root.0,
            source_root=root.joinpath("src").0,
            package="app",
            version="0.1.0",
            profile="debug",
            declared_features=[],
            active_features=[],
            loaves=[],
            rust_crates=[],
            contract_models=[],
            c_headers=[],
        ),
    )


def counted_toolchain(scratch: Path) -> Result[Toolchain, str]:
    """A compiler that cannot start a worker, counts each compilation and writes a fixed executable."""
    driver = scratch.joinpath("toolchain").joinpath("driver")
    attempts = scratch.joinpath("attempts")
    mut script = "#!/bin/sh\n[ \"$1\" = --resident ] && exit 1\n"
    script += f"printf x >> '{attempts.0}'\nprintf 'compiled program' > \"$4\"\n"
    script += "printf '%s' '{\"schema\":\"incan.native-shared/1\",\"libraries\":[]}' > \"$4.native-shared.json\"\nexit 0\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    return Ok(Toolchain(driver=driver.0, sysroot="/rust/1.98.0", rust_abi=[], externs=[], search=[], registry_units=""))


def attempts(scratch: Path) -> str:
    """The compilations the counted compiler ran so far, one `x` each."""
    match read(scratch.joinpath("attempts")):
        Ok(text) => return text
        Err(_) => return ""


pub def test_two_projects_with_the_same_unit_compile_it_once_and_target_holds_only_views() -> Result[None, str]:
    """
    Two projects asking for one identity compile it once; deleting `target/` or editing a view costs only views.

    1. The first project bakes; the second views the same fact without starting a compiler.
    2. An edited view leaves the fact intact, and it is the edited view that starts.
    3. Deleting a project's `target/` recreates its view and compiles nothing.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    store = root.joinpath("home").joinpath("bakery")
    toolchain = counted_toolchain(root)?
    key = Key(digest=digest_of("a1"), parts=["compiler c", "sources s"])
    first = project_unit(root.joinpath("one"))?
    second = project_unit(root.joinpath("two"))?
    first_output = root
        .joinpath("one")
        .joinpath("target")
        .joinpath("incan")
        .joinpath("debug")
        .joinpath("bin")
        .joinpath("app")
    second_output = root
        .joinpath("two")
        .joinpath("target")
        .joinpath("incan")
        .joinpath("debug")
        .joinpath("bin")
        .joinpath("app")
    # 1. One compilation serves both projects.
    assert compile_executable(first, toolchain, first_output, key, false, Some(store))? == 0
    assert compile_executable(second, toolchain, second_output, key, false, Some(store))? == 0
    assert attempts(root) == "x"
    assert read(second_output)? == "compiled program"
    # 2. A view is the user's to change; the unit is not, and the changed view is what starts.
    write_file(first_output, "stripped by the user")?
    assert payload_text(store, key.digest, "app")? == "compiled program"
    # 3. A deleted target directory is only views.
    root.joinpath("two").joinpath("target").remove_tree().map_err((error) => error.message())?
    assert compile_executable(second, toolchain, second_output, key, false, Some(store))? == 0
    assert read(second_output)? == "compiled program"
    assert attempts(root) == "x"
    # Development linkage must also start the requested view, so the host reports it as the executable image.
    made = obtain_executable(second, toolchain, second_output, key, true, Some(store))?
    assert made.launch.0 == second_output.0, "a development run replaced the view with its bakery payload"
    assert verification_entries() > 0
    forget_verified()
    assert verification_entries() == 0, "request teardown retained verified payload metadata"
    return Ok(None)


pub def test_a_claimed_identity_is_baked_once_and_waiters_find_it() -> Result[None, str]:
    """
    While one baker holds an identity's claim, another asker cannot claim it; once it is published, the asker finds it.

    1. A held claim excludes a second claimant.
    2. The holder publishes; the next asker finds the unit and bakes nothing.
    """
    scratch = scratch_directory()?
    store = scratch.path().joinpath("bakery")
    identity = digest_of("b2")
    # 1. The kernel lock is the claim: a second open of it does not get it while the first is held.
    held = claim(store, identity)?
    contended = claim_file(store, identity).try_lock_exclusive().map_err((error) => error.message())?
    assert not locked(contended)
    staged = staging(store, identity)?
    write(staged.joinpath("payload"), "baked once")?
    baked = seal(store, identity, staged, "library", "dep", [], "test")?
    assert baked.identity == identity
    # 2. Under the claim the unit is found, so the waiter does not bake again.
    assert not bake(store, identity, "baked twice")?
    assert payload_text(store, identity, "payload")? == "baked once"
    return Ok(None)


pub def test_a_killed_baker_leaves_no_claim_and_a_damaged_unit_is_baked_again() -> Result[None, str]:
    """
    A dead baker releases its claim; damage is reported until explicit recomputation or verified re-admission.

    1. The dead baker's staging directory is not a unit, and its claim is free.
    2. The next asker bakes the unit.
    3. Lookup and verification report damage without changing it; explicit repair uses authoritative inputs.
    """
    scratch = scratch_directory()?
    store = scratch.path().joinpath("bakery")
    identity = digest_of("c3")
    dead = staging_root(store).joinpath(f"{identity}.999999")
    write(dead.joinpath("payload"), "half written")?
    # 1. Nothing unpublished is ever found, and the kernel released the dead baker's lock.
    assert not found(find(store, identity)?)
    assert claim_is_free(store, identity)?
    # 2. The next asker bakes.
    assert bake(store, identity, "complete")?
    assert payload_text(store, identity, "payload")? == "complete"
    # A repair request cannot overwrite healthy immutable contents.
    unneeded = staging(store, identity)?
    write(unneeded.joinpath("payload"), "unrequested replacement")?
    match repair_derived(store, identity, unneeded, "library", "dep", [], "verified-test-inputs"):
        Ok(_) =>
            assert false, "repair replaced an intact unit"
        Err(error) =>
            assert "intact" in error, error
    assert payload_text(store, identity, "payload")? == "complete"
    # 3. Damage is an error, and verification preserves evidence for an explicit owner repair.
    payload = stored_payload(store, identity, "payload")?
    match payload.write_text("damaged", "utf-8", "strict", None):
        Ok(_) =>
            assert false, "a stored payload file was writable"
        Err(_) => pass
    replacement = scratch.path().joinpath("verified-replacement")
    payload.copy(replacement, true, true).map_err((error) => error.message())?
    digest = payload.name()
    damage(payload, "damaged!")?
    forget_verified()
    match find(store, identity):
        Ok(_) =>
            assert false, "damage became absence"
        Err(error) =>
            assert payload.0 in error and "integrity" in error, error
    assert len(verify_all(store)?) == 1
    assert read(payload)? == "damaged!"
    readmit_payload(store, replacement, digest).map_err((error) => error.message())?
    assert payload_text(store, identity, "payload")? == "complete"
    damage(payload, "damaged!")?
    forget_verified()
    staged = staging(store, identity)?
    write(staged.joinpath("payload"), "rebaked")?
    repair_derived(store, identity, staged, "library", "dep", [], "verified-test-inputs")?
    assert store.joinpath("quarantine").is_dir()
    assert payload_text(store, identity, "payload")? == "rebaked"
    prove_codec_repair(store, identity)?
    return Ok(None)


pub def test_collection_preserves_published_units_for_cold_and_warm_readers() -> Result[None, str]:
    """Collection between publication and view selection preserves both cold and warm unit readers and payloads."""
    scratch = scratch_directory()?
    store = scratch.path().joinpath("bakery")
    library = digest_of("d4")
    orphan = digest_of("f6")
    assert bake(store, library, "library")?
    assert bake(store, orphan, "orphan")?
    register_root(store, scratch.path().joinpath("project").0, library)?
    abandoned = scratch.path().joinpath("abandoned")
    write(abandoned, "uncommitted payload")?
    digest = abandoned_digest(store, abandoned)?
    collect(store, -1)?
    assert not payload_path(store, digest).exists(), "abandoned payload was retained"
    for _turn in range(2):
        collected = collect(store, -1)?
        assert collected.kept == 2 and collected.removed == 0
        assert found(find(store, library)?)
        assert found(find(store, orphan)?)
        assert payload_text(store, library, "payload")? == "library"
        assert payload_text(store, orphan, "payload")? == "orphan"
        match find(store, library)?:
            None => return Err("published unit disappeared before view selection")
            Some(fact) =>
                destination = scratch.path().joinpath("selected/payload")
                view(store, fact, "payload", destination)?
                assert read(destination)? == "library"
    prove_prepared_payload_survives_collection(store, scratch.path())?
    prove_superseded_payloads_are_collected(store, scratch.path())?
    active = prove_active_staging_survives(store)?
    reclaimed = collect(store, -1)?
    assert reclaimed.staging_cleared > 0 and not active.exists(), "abandoned staging was retained"
    return Ok(None)


pub def test_the_name_record_answers_the_latest_identity_of_a_name() -> Result[None, str]:
    """The name record returns the identity a name was last baked under, across merged deltas."""
    scratch = scratch_directory()?
    store = scratch.path().joinpath("bakery")
    assert not named(lookup(store, "dep")?)
    for index in range(20):
        assert bake(store, digest_of(f"{index}a"), f"{index}", [], "dep")?
    assert lookup(store, "dep")? == Some(digest_of("19a"))
    verify_frozen_library_bindings(scratch.path())?
    return Ok(None)


def verify_frozen_library_bindings(root: Path) -> Result[None, str]:
    """Repairing a unit record gives new consumers another layout without retargeting an older native closure."""
    store = root.joinpath("library-bakery")
    identity = fingerprint(["library-layout-fixture", root.0])?
    first = staging(store, identity)?
    write(first.joinpath("payload"), "first library")?
    fact = seal(store, identity, first, "library", identity, [], "test")?
    target = root.joinpath("target/library")
    view_directory(store, fact, target)?
    original = library_directory(store, target)?
    damage_unit_record(store, identity)?
    replacement = staging(store, identity)?
    write(replacement.joinpath("payload"), "repaired library")?
    repaired = repair_derived(store, identity, replacement, "library", identity, [], "verified-test-inputs")?
    view_directory(store, repaired, target)?
    current = library_directory(store, target)?
    assert current.0 != original.0
    assert library_directory(store, original)?.0 == original.0
    assert read(original.joinpath("payload"))? == "first library"
    assert read(current.joinpath("payload"))? == "repaired library"
    assert original.joinpath("payload").is_symlink()
    return Ok(None)


def digest_of(prefix: str) -> str:
    """A 64-character identity that starts with `prefix`."""
    mut text = prefix
    while len(text) < 64:
        text += "0"
    return text


def stored_payload(store: Path, identity: str, relative: str) -> Result[Path, str]:
    """The stored payload of one file of a baked unit."""
    match find(store, identity)?:
        None => return Err(f"{identity[:12]} is not baked")
        Some(fact) =>
            match fact_file(store, fact, relative):
                Some(path) => return Ok(path)
                None => return Err(f"{identity[:12]} has no {relative}")


def baked(store: Path, identity: str) -> Result[Fact, str]:
    """The baked unit of `identity`."""
    match find(store, identity)?:
        None => return Err(f"{identity[:12]} is not baked")
        Some(fact) => return Ok(fact)


def payload_text(store: Path, identity: str, relative: str) -> Result[str, str]:
    """The text of one file of a baked unit."""
    return read(stored_payload(store, identity, relative)?)


pub def found(fact: Option[Fact]) -> bool:
    """Whether an ask found a baked unit."""
    match fact:
        Some(_) => return true
        None => return false


def named(identity: Option[str]) -> bool:
    """Whether the name record answered an identity."""
    match identity:
        Some(_) => return true
        None => return false


def locked(lock: Option[FileLock]) -> bool:
    """Whether a lock attempt got the lock."""
    match lock:
        Some(_) => return true
        None => return false


def damage(path: Path, text: str) -> Result[None, str]:
    """Overwrite a stored payload file, as a stray tool would, past its read-only permissions."""
    set_permissions(path.0, Permissions.from_mode(420)).map_err((error) => str(error))?
    return path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())


def prove_codec_repair(store: Path, identity: str) -> Result[None, str]:
    """A frame with a valid storage digest but invalid unit encoding is quarantined by its owning codec."""
    damage_unit_record(store, identity)?
    match find(store, identity):
        Ok(_) =>
            assert false, "a malformed unit was read as absence"
        Err(error) =>
            assert "integrity" in error, error
    assert len(verify_all(store)?) == 1
    before = len(store.joinpath("quarantine").iterdir().map_err((error) => error.message())?)
    replacement = staging(store, identity)?
    write(replacement.joinpath("payload"), "codec repaired")?
    repair_derived(store, identity, replacement, "library", "dep", [], "verified-test-inputs")?
    assert len(store.joinpath("quarantine").iterdir().map_err((error) => error.message())?) == before + 1, "codec damage was not quarantined"
    assert payload_text(store, identity, "payload")? == "codec repaired"
    return Ok(None)


def damage_unit_record(store: Path, identity: str) -> Result[None, str]:
    """Replace one test fact's typed record with malformed bytes while retaining its canonical payloads."""
    view = snapshot(store).map_err((error) => error.message())?
    unit_keys = [key for key in keys(view).map_err((error) => error.message())? if key.startswith("incan.bakery.unit\t") and key.endswith(
        f"\t{identity}",
    )]
    assert len(unit_keys) == 1, f"expected one unit record, found {len(unit_keys)}"
    commit(put(begin(view), unit_keys[0], b"invalid unit encoding")).map_err((error) => error.message())?
    return Ok(None)


def abandoned_digest(store: Path, source: Path) -> Result[str, str]:
    """Install and abandon an unpublished payload by dropping its preparation guard."""
    return Ok(put_payload(store, source).map_err((error) => error.message())?.digest)


def prove_active_staging_survives(store: Path) -> Result[Path, str]:
    """Force collection while an active producer owns its staging, then abandon that producer on return."""
    identity = "sha256:" + digest_of("ee1")
    held = claim(store, identity)?
    active = staging(store, identity)?
    write(active.joinpath("payload"), "active producer")?
    collect(store, -1)?
    assert read(active.joinpath("payload"))? == "active producer"
    return Ok(active)


def prove_prepared_payload_survives_collection(store: Path, root: Path) -> Result[None, str]:
    """Force collection after immutable installation but before publication, then commit without reinstalling."""
    identity = digest_of("abc")
    staged = staging(store, identity)?
    write(staged.joinpath("payload"), "prepared before collection")?
    prepared = prepare_seal(store, identity, staged, "library", "prepared", [], "test")?
    path = payload_path(store, prepared.fact.files[0].digest)
    assert not found(find(store, identity)?)
    collect(store, -1)?
    assert read(path)? == "prepared before collection", "collection removed a live preparation"
    commit(prepared.transaction).map_err((error) => error.message())?
    assert payload_text(store, identity, "payload")? == "prepared before collection"
    return Ok(None)


def prove_superseded_payloads_are_collected(store: Path, root: Path) -> Result[None, str]:
    """Explicitly dropped unit roots reclaim their payloads; an old live snapshot retains its late payload reads."""
    first = digest_of("100")
    assert bake(store, first, "old live payload", [], "history")?
    old_path = stored_payload(store, first, "payload")?
    mut old = snapshot(store).map_err((error) => error.message())?
    mut previous = first
    mut bytes = 0
    mut payload_bytes = 0
    mut payloads = 0
    for index in range(20):
        identity = digest_of(f"{index + 200}")
        content = f"replacement unit generation {index}"
        assert bake(store, identity, content, [], "history")?
        previous_path = stored_payload(store, previous, "payload")?
        commit(delete(begin(snapshot(store).map_err((error) => error.message())?), "incan.bakery.unit\t" + previous)).map_err(
            (error) => error.message(),
        )?
        reclaimed = collect(store, -1)?
        bytes += reclaimed.bytes_reclaimed
        payload_bytes += reclaimed.payload_bytes_reclaimed
        payloads += reclaimed.payloads_removed
        if previous != first:
            assert not previous_path.exists(), "a superseded unit payload was retained"
        previous = identity
    assert read(old_path)? == "old live payload"
    assert get(old, "incan.bakery.unit\t" + first).map_err((error) => error.message())? is not None
    old.pin = None
    released = collect(store, -1)?
    assert not old_path.exists(), "released historical payload was retained"
    payload_bytes += released.payload_bytes_reclaimed
    payloads += released.payloads_removed
    assert payloads == 20 and payload_bytes > 0
    println(
        f"payload collection: 20 superseded generations, {payloads} payloads and {payload_bytes} payload bytes reclaimed, {bytes} total immutable bytes before release, live old payload retained",
    )
    return Ok(None)
