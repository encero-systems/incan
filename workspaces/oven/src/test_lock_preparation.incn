"""Lock policy preserves canonical fallbacks and never retains incomplete or racing evidence."""

from std.json import JsonValue
from std.hash import sha256
from std.encoding.hex import hexlify
from lock_preparation import (
    evaluate,
    route,
    reuse,
    retain,
    RouteInputs,
    ReuseInputs,
    RetentionInputs,
    RouteDecision,
    ReuseDecision,
    RetentionDecision,
)


def decision(phase: str, facts: dict[str, JsonValue]) -> Result[JsonValue, str]:
    """Exercise the production policy decoder with complete caller-supplied observations."""
    source = JsonValue
        .object(
            {"schema": JsonValue.string("incan.oven.lock-preparation/1"), "phase": JsonValue.string(phase), "facts": JsonValue.object(
                facts,
            )},
        )
        .to_json()
        .map_err((e) => e.message())?
    result = evaluate(source)
    assert len(result.keys()) == 4
    assert result.require("schema").map_err((e) => e.message())?.expect_str().map_err((e) => e.message())? == "incan.oven.lock-preparation/1"
    assert result.require("request_digest").map_err((e) => e.message())?.expect_str().map_err((e) => e.message())? == "sha256:" + hexlify(
        sha256.digest(source.encode("utf-8")),
    )
    return Ok(result)


def action(phase: str, facts: dict[str, JsonValue]) -> Result[str, str]:
    """Require a complete selected response rather than silently accepting a refusal."""
    result = decision(phase, facts)?
    assert result.require("status").map_err((e) => e.message())?.expect_str().map_err((e) => e.message())? == "selected"
    return result.require("action").map_err((e) => e.message())?.expect_str().map_err((e) => e.message())


pub def test_lock_route_preserves_workspace_and_external_fallbacks() -> Result[None, str]:
    """Unsupported retained layouts retain canonical collection; relative paths always refuse first."""
    mut facts = {"paths_absolute": JsonValue.bool(true), "workspace": JsonValue.bool(false), "entries_owned": JsonValue.bool(
        true,
    ), "has_entry": JsonValue.bool(true)}
    assert action("route", facts)? == "observe"
    facts["has_entry"] = JsonValue.bool(false)
    assert action("route", facts)? == "missing_entry"
    facts["workspace"] = JsonValue.bool(true)
    assert action("route", facts)? == "canonical_prepared"
    facts["has_entry"] = JsonValue.bool(true)
    assert action("route", facts)? == "observe"
    facts["workspace"] = JsonValue.bool(false)
    facts["entries_owned"] = JsonValue.bool(false)
    assert action("route", facts)? == "canonical_prepared"
    facts["paths_absolute"] = JsonValue.bool(false)
    assert action("route", facts)? == "relative_paths"
    return Ok(None)


pub def test_lock_reuse_requires_every_original_observation() -> Result[None, str]:
    """Changed request, source, publication or test discovery forces canonical publication."""
    mut facts = {"session_available": JsonValue.bool(true), "request": JsonValue.string("request-a"), "source": JsonValue.string(
        "source-a",
    ), "retained_request": JsonValue.string("request-a"), "retained_source": JsonValue.string("source-a"), "discovery_current": JsonValue.bool(
        true,
    ), "publication_current": JsonValue.bool(true)}
    assert action("reuse", facts)? == "reuse"
    for key in ["request", "source", "retained_request", "retained_source"]:
        original = facts[key]
        facts[key] = JsonValue.string("changed")
        assert action("reuse", facts)? == "publish"
        facts[key] = original
    for key in ["source", "retained_request", "retained_source"]:
        original = facts[key]
        facts[key] = JsonValue.null()
        assert action("reuse", facts)? == "publish"
        facts[key] = original
    for key in ["discovery_current", "publication_current"]:
        facts[key] = JsonValue.bool(false)
        assert action("reuse", facts)? == "publish"
        facts[key] = JsonValue.bool(true)
    facts["session_available"] = JsonValue.bool(false)
    assert action("reuse", facts)? == "canonical_collect"
    return Ok(None)


pub def test_lock_retention_refuses_races_and_unbound_sessions() -> Result[None, str]:
    """Successful publication alone cannot retain a changed or unsupported generation."""
    mut facts = {"source_before": JsonValue.string("source-a"), "source_after": JsonValue.string("source-a"), "discovery_current": JsonValue.bool(
        true,
    ), "publication_current": JsonValue.bool(true), "session_bound": JsonValue.bool(true)}
    assert action("retain", facts)? == "retain"
    facts["source_after"] = JsonValue.string("source-b")
    assert action("retain", facts)? == "complete"
    facts["source_after"] = JsonValue.string("source-a")
    for key in ["source_before", "source_after"]:
        facts[key] = JsonValue.null()
        assert action("retain", facts)? == "complete"
        facts[key] = JsonValue.string("source-a")
    for key in ["discovery_current", "publication_current", "session_bound"]:
        facts[key] = JsonValue.bool(false)
        assert action("retain", facts)? == "complete"
        facts[key] = JsonValue.bool(true)
    return Ok(None)


pub def test_lock_policy_refuses_partial_and_unknown_facts() -> Result[None, str]:
    """A missing field, wrong phase or unknown fact cannot authorize an action."""
    for phase in ["route", "reuse", "retain", "unknown"]:
        result = decision(phase, {})?
        assert result.require("status").map_err((e) => e.message())?.expect_str().map_err((e) => e.message())? == "refused"
        assert "action" not in result.keys()
    facts = {"paths_absolute": JsonValue.bool(true), "workspace": JsonValue.bool(false), "entries_owned": JsonValue.bool(
        true,
    ), "has_entry": JsonValue.bool(true), "unknown": JsonValue.bool(true)}
    assert "action" not in decision("route", facts)?.keys()
    return Ok(None)


def expect_route(absolute: bool, workspace: bool, owned: bool, entry: bool, expected: RouteDecision) -> None:
    """Route one observed layout, taking every flag by value, and compare it with the expected decision."""
    inputs = RouteInputs(paths_absolute=absolute, workspace=workspace, entries_owned=owned, has_entry=entry)
    assert route(inputs) == expected


pub def test_typed_lock_routes_preserve_precedence() -> None:
    """Typed callers distinguish entry observation, canonical fallback, and refusal without decoding strings."""
    expect_route(false, false, true, true, RouteDecision.RelativePaths)
    expect_route(false, true, false, false, RouteDecision.RelativePaths)
    expect_route(true, false, true, true, RouteDecision.Observe)
    expect_route(true, true, true, true, RouteDecision.Observe)
    expect_route(true, false, true, false, RouteDecision.MissingEntry)
    expect_route(true, true, true, false, RouteDecision.CanonicalPrepared)
    expect_route(true, false, false, true, RouteDecision.CanonicalPrepared)
    expect_route(true, false, false, false, RouteDecision.CanonicalPrepared)


pub def test_typed_lock_reuse_requires_current_bound_evidence() -> None:
    """An exact identity pair alone cannot authorize reuse without both live observations."""
    mut inputs = ReuseInputs(
        session_available=true,
        request="request-a",
        source=Some("source-a"),
        retained_request=Some("request-a"),
        retained_source=Some("source-a"),
        discovery_current=true,
        publication_current=true,
    )
    assert reuse(inputs) == ReuseDecision.Reuse
    inputs.discovery_current = false
    assert reuse(inputs) == ReuseDecision.Publish
    inputs.discovery_current = true
    inputs.publication_current = false
    assert reuse(inputs) == ReuseDecision.Publish
    inputs.publication_current = true
    inputs.source = None
    assert reuse(inputs) == ReuseDecision.Publish
    inputs.source = Some("source-b")
    assert reuse(inputs) == ReuseDecision.Publish
    inputs.source = Some("source-a")
    inputs.retained_request = Some("request-b")
    assert reuse(inputs) == ReuseDecision.Publish
    inputs.session_available = false
    assert reuse(inputs) == ReuseDecision.CanonicalCollect


pub def test_typed_lock_retention_requires_unchanged_original_session() -> None:
    """Typed retention preserves source-race and absent-session refusal outcomes."""
    mut inputs = RetentionInputs(
        source_before=Some("source-a"),
        source_after=Some("source-a"),
        discovery_current=true,
        publication_current=true,
        session_bound=true,
    )
    assert retain(inputs) == RetentionDecision.Retain
    inputs.source_after = Some("source-b")
    assert retain(inputs) == RetentionDecision.Complete
    inputs.source_after = None
    assert retain(inputs) == RetentionDecision.Complete
    inputs.source_after = Some("source-a")
    inputs.session_bound = false
    assert retain(inputs) == RetentionDecision.Complete
    inputs.session_bound = true
    inputs.discovery_current = false
    assert retain(inputs) == RetentionDecision.Complete
    inputs.discovery_current = true
    inputs.publication_current = false
    assert retain(inputs) == RetentionDecision.Complete
