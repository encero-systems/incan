"""A build counts the checked bodies the compiler restored, never the records the engine merely selected for it."""

from pub::incan_platform.store import begin
from pub::incan_platform.store import snapshot as store_snapshot
from pub::incan_platform.store.memory import root as memory_root
from pub::internal_models import CompiledBodyOutputs, CompiledBodyValue, encode_compiled_body_rows
from pub::internal_models.checked_body_counts import CheckedBodyCounts, encode_checked_body_counts
from checker_record_fixtures import empty_checker_record
from pub::internal_models.checker_records import CheckedFamily
from std.fs import Path
from compiler_body_publication import prepare_compiled_bodies
from compiler_body_values import SelectedBodyRecord
from files import write
from publication import publish_binary
from scratch import scratch_directory
from unit import UnitDescription
from unit_compiler import checked_body_counts


pub def test_checked_body_sidecars_preserve_observed_work_and_report_replay() -> Result[None, str]:
    scratch = scratch_directory()?
    legacy = scratch.path().joinpath("check.checked-bodies")
    current = scratch.path().joinpath("check.checked-bodies.crumb")
    expected = CheckedBodyCounts(checked=1, reused=2, decoded=0)
    publish_binary(current, encode_checked_body_counts(expected)?)?
    counts = checked_body_counts(current)?
    assert counts.checked == 1 and counts.reused == 2 and counts.decoded == 0
    assert not current.is_file()
    replayed = checked_body_counts(current)?
    assert replayed.checked == 0 and replayed.reused == 0 and replayed.decoded == 0
    public = '{"schema":"incan.checked-bodies/1","checked":1,"reused":2}'
    write(legacy, public)?
    old = checked_body_counts(legacy)?
    assert old.checked == 1 and old.reused == 2 and old.decoded == 2
    assert not legacy.is_file()
    write(current, public)?
    assert checked_body_counts(current).is_err()
    return Ok(None)


pub def test_a_selected_body_the_compiler_checked_again_counts_as_checked() -> Result[None, str]:
    """Both owners' records were selected, but the compiler restored neither: both bodies were checked afresh."""
    scratch = scratch_directory()?
    unit = program(scratch.path())?
    values = [body_value("main")?, body_value("other")?]
    output = scratch.path().joinpath("compiled-body-output")
    publish_output_rows(output, CompiledBodyOutputs(namespaces=[], values=values, fallbacks=[]))?
    selected = [SelectedBodyRecord(identity=value.identity, local=value.local, final=value.final, body_ir=value.body_ir) for value in values]
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    prepared = prepare_compiled_bodies(begin(empty), unit, output, None, Some(empty), selected)?
    assert prepared.checking_evaluations == 2, f"{prepared.checking_evaluations} checking evaluations, expected 2"
    assert prepared.body_reuses == 0, f"{prepared.body_reuses} reuses, expected none"
    return Ok(None)


pub def test_a_body_the_compiler_restored_counts_as_reused() -> Result[None, str]:
    """Both owners' records were selected and the compiler restored one: one body was checked, one reused."""
    scratch = scratch_directory()?
    unit = program(scratch.path())?
    values = [body_value("main")?, body_value("other")?]
    output = scratch.path().joinpath("compiled-body-output")
    publish_output_rows(output, CompiledBodyOutputs(namespaces=[], values=values, fallbacks=[]))?
    selected = [SelectedBodyRecord(identity=value.identity, local=value.local, final=value.final, body_ir=value.body_ir) for value in values]
    empty = store_snapshot(memory_root()).map_err((error) => error.message())?
    restored = [values[1].identity]
    prepared = prepare_compiled_bodies(begin(empty), unit, output, None, Some(empty), selected, restored)?
    assert prepared.body_ir_evaluations == 2
    assert prepared.checking_evaluations == 1, f"{prepared.checking_evaluations} checking evaluations, expected 1"
    assert prepared.body_reuses == 1, f"{prepared.body_reuses} reuses, expected 1"
    publish_output_rows(output, CompiledBodyOutputs(namespaces=[], values=values, fallbacks=[]))?
    installed = prepare_compiled_bodies(begin(empty), unit, output, None, Some(empty), selected, restored, [], [values[1].identity])?
    assert installed.body_ir_evaluations == 1 and installed.checking_evaluations == 1
    return Ok(None)


def program(scratch: Path) -> Result[UnitDescription, str]:
    """A two-function program whose sidecar the tests publish by hand."""
    root = scratch.joinpath("program")
    root.mkdir(true, true).map_err((error) => error.message())?
    source = root.joinpath("main.incn")
    source
        .write_text("def main() -> None:\n    pass\n\n\ndef other() -> None:\n    pass\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    return Ok(
        UnitDescription(
            source=source.0,
            project_root=root.0,
            source_root=root.0,
            package="main",
            version="0.1.0",
            profile="debug",
            declared_features=[],
            active_features=[],
            loaves=[],
            rust_crates=[],
            contract_models=[],
            c_headers=[],
        ),
    )


def body_value(name: str) -> Result[CompiledBodyValue, str]:
    """One owner's compiler output: its three checker records, empty but valid, and an opaque Body IR row."""
    identity = f"main|module:main|{name}|function|module|0|() -> unit"
    return Ok(
        CompiledBodyValue(
            module="main.incn",
            name=name,
            identity=identity,
            declaration=empty_checker_record(identity, CheckedFamily.Declaration)?,
            local=empty_checker_record(identity, CheckedFamily.Local)?,
            final=empty_checker_record(identity, CheckedFamily.Final)?,
            body_ir=b"owner-frame",
            dependency_reads=[],
        ),
    )


def publish_output_rows(output: Path, outputs: CompiledBodyOutputs) -> Result[None, str]:
    """Write one independently bounded Crumb row per sidecar page, as the compiler does."""
    output.mkdir(true, true).map_err((error) => error.message())?
    rows = encode_compiled_body_rows(outputs).map_err((error) => f"{error:?}")?
    for index in range(len(rows)):
        publish_binary(output.joinpath(str(index) + ".crumb"), rows[index])?
    return Ok(None)
