"""Prove unchanged native producer bytes after a toolchain's artifact stores move."""

from std.fs import Path
from files import read
from observation import SETTLE_SECONDS, Ledger, load_ledger, observe
from publication import publish
from rust_freshness import producer_arguments, project_argument
from unit_freshness import Key, fingerprint


pub def portable_key(
    native: Key,
    directory: Path,
    arguments: list[str],
    project: Path,
    compiler: str,
) -> Result[Key, str]:
    """
    Preserve a native producer's sources and environment while identifying its compiler and externs by content.

    1. Retain the checked native input dimensions that name no machine location or filesystem identity.
    2. Identify the compiler by its portable identity: another machine's copy of the same compiler proves alike.
    3. Normalize output, project and named extern locations, preserving all other compiler arguments.
    4. Identify each named extern by its alias and exact content.
    """
    # 1. Sources are keyed by their place in the project and their bytes, so another checkout of them still proves.
    mut parts = [part for part in native.parts if not machine_bound(part)]
    mut ledger = portable_ledger(directory)
    # 2. The native compiler part names where rustc is installed; this one names only what it is.
    parts.append(f"compiler {compiler}")
    # 3. Search directories are locators; selected extern aliases and every code-generation flag remain explicit.
    command = fingerprint(normalized_arguments(producer_arguments(arguments), directory, project))?
    parts.append(f"command {command}")
    # 4. Only byte-identical dependencies can survive a changed path or filesystem identity.
    artifacts = fingerprint(extern_contents(arguments, ledger)?)?
    parts.append(f"artifacts {artifacts}")
    ledger.save()?
    return Ok(Key(digest=fingerprint(["incan.oven.portable-native/1"] + parts)?, parts=parts))


def machine_bound(part: str) -> bool:
    """A native key part that names this machine's compiler, command paths or artifact files, not their content."""
    return part.startswith("compiler ") or part.startswith("command ") or part.startswith("artifacts ")


pub def portable_reusable(directory: Path, key: Key, outputs: list[Path]) -> Result[bool, str]:
    """
    Accept a relocated producer only when its complete input proof and every completed output still match.

    1. Require the producer's existing content proof and matching native input key.
    2. Compare all output names and exact bytes, excluding concurrent replacements.
    """
    # 1. Neither a missing proof nor another native producer may authorize relocation.
    stamp = directory.joinpath("library.portable-inputs")
    if not stamp.is_file():
        return Ok(false)
    recorded = read(stamp)?.split("\n")
    first = 1 + len(key.parts)
    if len(recorded) != first + len(outputs) or recorded[0] != key.digest:
        return Ok(false)
    for output in outputs:
        if not output.is_file():
            return Ok(false)
    # 2. A copied file is valid only when its bytes are exactly those the original producer completed.
    before = output_observations(outputs)?
    mut ledger = portable_ledger(directory)
    current = output_contents(outputs, ledger)?
    ledger.save()?
    return Ok(recorded[first:] == current and output_observations(outputs)? == before)


pub def record_portable(directory: Path, key: Key, outputs: list[Path]) -> Result[None, str]:
    """
    Retain a content proof only after the caller has proved a completed native producer.

    1. Read every completed output's exact bytes without allowing concurrent replacement.
    2. Publish the complete native input key and output content identities together.
    """
    # 1. Callers retain their producer lock and validate source/native inputs before publishing this proof.
    before = output_observations(outputs)?
    mut ledger = portable_ledger(directory)
    contents = output_contents(outputs, ledger)?
    ledger.save()?
    if output_observations(outputs)? != before:
        return Err("Rust producer outputs changed while recording relocation proof")
    # 2. A partial proof never replaces the previous completed publication.
    stamp = directory.joinpath("library.portable-inputs")
    text = "\n".join([key.digest] + key.parts + contents)
    if stamp.is_file() and read(stamp)? == text:
        return Ok(None)
    return publish(stamp, text)


def normalized_arguments(arguments: list[str], directory: Path, project: Path) -> list[str]:
    """Remove only output-store and project locations and the paths of explicitly named extern artifacts."""
    mut normalized: list[str] = []
    mut external = false
    for argument in arguments:
        if external and "=" in argument:
            name = argument.split("=")[0]
            normalized.append(f"{name}=<native:{name}>")
        else:
            normalized.append(project_argument(argument.replace(directory.0, "<producer-output>"), project))
        external = argument == "--extern"
    return normalized


def extern_contents(arguments: list[str], mut ledger: Ledger) -> Result[list[str], str]:
    """Identify each named extern by its explicit alias and content rather than its physical store path."""
    mut contents: list[str] = []
    for index in range(1, len(arguments)):
        if arguments[index - 1] == "--extern" and "=" in arguments[index]:
            binding = arguments[index].split("=")
            contents.append(binding[0])
            contents.append(ledger.digest(Path("=".join(binding[1:])))?)
    return Ok(contents)


def output_contents(outputs: list[Path], mut ledger: Ledger) -> Result[list[str], str]:
    """Keep each expected output's file name and full-content digest in the producer's declared order."""
    mut contents: list[str] = []
    for output in outputs:
        contents.append(f"{output.name()} {ledger.digest(output)?}")
    return Ok(contents)


def output_observations(outputs: list[Path]) -> Result[list[str], str]:
    """Observe every output together so replacements during content verification cannot receive a proof."""
    mut observations: list[str] = []
    for output in outputs:
        observations.append(observe(output)?.stamp)
    return Ok(observations)


def portable_ledger(directory: Path) -> Ledger:
    """Reuse content digests only while the exact file generations that supplied them remain unchanged."""
    return load_ledger(directory.joinpath("portable-observations.json"), SETTLE_SECONDS)
