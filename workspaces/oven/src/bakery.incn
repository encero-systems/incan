"""
The home bakery: one store per Incan home that every project, test and CI step asks for its units (DD-0012, RFC 124).

Units are records in the home's segment store (`segment_store`), keyed by unit identity. A unit record names its kind,
its name, the identities it reaches and each payload file: a path inside the unit, the content digest it is stored
under, its size and whether it is a program. Payload files are content-named files of the store, which rustc and the
OS read as files. `target/` folders hold views of them: copy-on-write clones a user may run, edit or strip.

Under `<home>/bakery/` (or the directory `INCAN_BAKERY` names): the segment store itself, `staging/` for bakes in
progress, and `roots/<project>/<identity>` for the identities each project's builds use.

Asking is one path for cold and warm builds: find the record, or claim its identity, look again, bake into a private
staging directory, store the payloads and publish the record. Concurrent askers wait on the claim and then find the
record. A missing or damaged record or payload is a miss: it is baked again. Collection is explicit
(`incan bakery gc`) and by reachability only; the store has no size ceiling.
"""

from rust::std::fs import OpenOptions, Permissions, copy as copy_file, metadata, rename, set_permissions
from rust::std::os::unix::fs import MetadataExt, PermissionsExt
from rust::std::process import id
from rust::std::string import String as RustString
from std.environ import get_or
from std.fs import Path
from std.fs.locking import FileLock
from std.json import JsonValue
from files import json_text, make_directory, read_json
from home import home
from json_fields import required_items, required_text, string_value
from observation import now_seconds, trace
from publication import publish
from segment_store import (
    Snapshot,
    claim as claim_key,
    compact,
    drop_payload,
    get,
    keys,
    payload_intact,
    payload_path,
    publish as publish_entries,
    put_payload,
    snapshot,
    sweep_payloads,
    sweep_segments,
    text_key,
)
from unit import UnitDescription
from unit_freshness import Key, fingerprint

const UNIT_SCHEMA: str = "incan.bakery.unit/1"
const VIEW_RECORD: str = "fact.json"
const SECONDS_PER_DAY: int = 86400
const VERIFY: int = -2
const OPEN_FILE: u32 = 420
const OPEN_PROGRAM: u32 = 493

# Payload digests this process has read in full and found intact; it then trusts them while their sizes hold.
static verified: dict[str, bool] = {}


pub model FactFile:
    """One payload file of a unit: where it sits inside the unit, the digest it is stored under, its size and mode."""

    pub path: str
    pub digest: str
    pub size: int
    pub program: bool


pub model Fact:
    """One baked unit: its identity, kind and name, the identities it reaches, and its payload files."""

    pub identity: str
    pub kind: str
    pub name: str
    pub reaches: list[str]
    pub files: list[FactFile]


pub model Collected:
    """What one collection did: units kept and removed, roots dropped, staging directories cleared."""

    pub kept: int
    pub removed: int
    pub roots_dropped: int
    pub staging_cleared: int


pub def unit_identity(key: Key) -> str:
    """The identity a unit is stored under: RFC 124's unit identity, which the unit key carries."""
    return key.digest


pub def unit_name(unit: UnitDescription) -> str:
    """The name a unit is indexed under: package, version, kind, profile and active features."""
    features = ",".join(unit.active_features)
    return f"{unit.package}\t{unit.version}\t{unit.kind}\t{unit.profile}\t{features}"


pub def bakery() -> Result[Path, str]:
    """This home's bakery: `<home>/bakery`, or the directory `INCAN_BAKERY` names (a cache volume, or a case's own)."""
    configured = get_or("INCAN_BAKERY", "")
    if configured != "":
        return Path(configured).absolute().map_err((error) => error.message())
    return Ok(home()?.joinpath("bakery"))


def record_key(identity: str) -> str:
    """The store key of a unit record."""
    return text_key(["unit", identity])


def name_key(name: str) -> str:
    """The store key of the record naming the latest identity of `name`."""
    return text_key(["name", name])


# ---- Asking ----


pub def find(store: Path, identity: str) -> Result[Option[Fact], str]:
    """
    The baked unit of `identity`, or nothing.

    A record that cannot be decoded, or a payload file that is missing or no longer matches its digest, is a miss: the
    damaged payload is dropped and the caller bakes the unit again. Each payload is read in full once per process.
    """
    match get(snapshot(store)?, record_key(identity)):
        None => return Ok(None)
        Some(value) =>
            match decode_fact(value):
                None =>
                    trace(f"bakery {identity[:12]}: unreadable record, baked again")
                    return Ok(None)
                Some(fact) =>
                    if fact.identity != identity:
                        return Ok(None)
                    for file in fact.files:
                        if not payload_current(store, file):
                            trace(f"bakery {identity[:12]}: payload {file.path} is damaged, baked again")
                            _ = drop_payload(store, file.digest)
                            return Ok(None)
                    return Ok(Some(fact))


def payload_current(store: Path, file: FactFile) -> bool:
    """Whether a payload file still has its recorded size, and, the first time in this process, its digest."""
    path = payload_path(store, file.digest)
    match metadata(path.0):
        Err(_) => return false
        Ok(info) =>
            if int(info.len()) != file.size:
                return false
    if verified.get(file.digest, false):
        return true
    if not payload_intact(store, file.digest):
        return false
    verified[file.digest] = true
    return true


pub def claim(store: Path, identity: str) -> Result[FileLock, str]:
    """
    Claim `identity` for baking; waits while another baker holds it. The claim lasts as long as the lock.

    The caller asks `find` again once it holds the claim, because the previous holder may have published the unit. A
    holder that died released its lock with its process, so its claim is a miss for the next asker.
    """
    return claim_key(store, record_key(identity))


pub def staging(store: Path, identity: str) -> Result[Path, str]:
    """A fresh, empty staging directory for baking `identity`; the caller holds its claim."""
    directory = store.joinpath("staging").joinpath(f"{identity}.{id()}")
    if directory.is_dir():
        directory.remove_tree().map_err((error) => f"{directory.0}: {error.message()}")?
    make_directory(directory)?
    return Ok(directory)


pub def seal(
    store: Path,
    identity: str,
    staged: Path,
    kind: str,
    name: str,
    reaches: list[str],
    provenance: str,
) -> Result[Fact, str]:
    """
    Publish a completed bake of `identity`; the caller holds its claim.

    1. Store every staged file as a content-named payload.
    2. Publish the unit record and the record of its name in one delta.
    3. Remove the staging directory.
    """
    # 1. Payload files are stored before any record names them.
    mut files: list[FactFile] = []
    for relative in staged_files(staged, "")?:
        files.append(stored_file(store, staged, relative)?)
    fact = Fact(identity=identity, kind=kind, name=name, reaches=reaches, files=files)
    # 2. A reader's snapshot holds either no record or the whole unit.
    mut entries: Dict[str, bytes] = {}
    entries[record_key(identity)] = encode_fact(fact, provenance)?.encode("utf-8")
    entries[name_key(name)] = identity.encode("utf-8")
    published = publish_entries(store, snapshot(store)?, entries)?
    # 3. Staging belongs to this bake only.
    _ = staged.remove_tree()
    trace(f"bakery {identity[:12]}: baked {kind} {name} (generation {published.generation})")
    return Ok(fact)


def stored_file(store: Path, staged: Path, relative: str) -> Result[FactFile, str]:
    """Store one staged file as a payload and describe it."""
    path = staged.joinpath(relative)
    info = metadata(path.0).map_err((error) => f"{path.0}: {error}")?
    digest = put_payload(store, path)?
    verified[digest] = true
    program = int(info.permissions().mode()) // 64 % 2 == 1
    return Ok(FactFile(path=relative, digest=digest, size=int(info.len()), program=program))


def staged_files(directory: Path, prefix: str) -> Result[list[str], str]:
    """Every regular file under `directory`, as sorted paths relative to the staging root."""
    mut files: list[str] = []
    for entry in directory.iterdir().map_err((error) => error.message())?:
        mut relative = entry.name()
        if prefix != "":
            relative = f"{prefix}/{entry.name()}"
        if entry.is_dir() and not entry.is_symlink():
            files = files + staged_files(entry, relative)?
        elif entry.is_file():
            files.append(relative)
    return Ok(sorted(files))


pub def fact_file(store: Path, fact: Fact, relative: str) -> Option[Path]:
    """The stored payload of one file of a unit, for readers that read it in place."""
    for file in fact.files:
        if file.path == relative:
            return Some(payload_path(store, file.digest))
    return None


pub def has_files_under(fact: Fact, prefix: str) -> bool:
    """Whether a unit has payload files below the directory `prefix`, such as a debug bundle."""
    for file in fact.files:
        if file.path.startswith(prefix + "/"):
            return true
    return false


# ---- Records ----


def encode_fact(fact: Fact, provenance: str) -> Result[str, str]:
    """The canonical text of a unit record."""
    mut files: list[JsonValue] = []
    for file in fact.files:
        files.append(
            JsonValue.object(
                {"path": JsonValue.string(file.path), "sha256": JsonValue.string(file.digest), "size": JsonValue.int(
                    file.size,
                ), "program": JsonValue.bool(file.program)},
            ),
        )
    document = JsonValue.object(
        {"schema": JsonValue.string(UNIT_SCHEMA), "identity": JsonValue.string(fact.identity), "kind": JsonValue.string(
            fact.kind,
        ), "name": JsonValue.string(fact.name), "reaches": JsonValue.array(
            [JsonValue.string(item) for item in fact.reaches],
        ), "payload": JsonValue.array(files), "provenance": JsonValue.string(provenance)},
    )
    return json_text(document)


def decode_fact(value: bytes) -> Option[Fact]:
    """A unit record, when `value` is one."""
    match RustString.from_utf8(value):
        Err(_) => return None
        Ok(text) =>
            match JsonValue.parse(str(text)):
                Err(_) => return None
                Ok(document) =>
                    match fact_document(document):
                        Ok(fact) => return Some(fact)
                        Err(_) => return None


def fact_document(document: JsonValue) -> Result[Fact, str]:
    """Read a decoded unit record; any missing field refuses it."""
    if required_text(document, "schema")? != UNIT_SCHEMA:
        return Err("another record schema")
    mut files: list[FactFile] = []
    for entry in required_items(document, "payload")?:
        files.append(fact_file_entry(entry)?)
    mut reaches: list[str] = []
    for item in required_items(document, "reaches")?:
        reaches.append(string_value(item)?)
    return Ok(
        Fact(
            identity=required_text(document, "identity")?,
            kind=required_text(document, "kind")?,
            name=required_text(document, "name")?,
            reaches=reaches,
            files=files,
        ),
    )


def fact_file_entry(entry: JsonValue) -> Result[FactFile, str]:
    """One payload entry of a unit record."""
    mut size = -1
    match entry.get("size"):
        Some(value) =>
            match value.as_int():
                Some(found) => size = found
                None => return Err("size")
        None => return Err("size")
    mut program = false
    match entry.get("program"):
        Some(value) =>
            match value.as_bool():
                Some(found) => program = found
                None => return Err("program")
        None => return Err("program")
    return Ok(FactFile(path=required_text(entry, "path")?, digest=required_text(entry, "sha256")?, size=size, program=program))


pub def lookup(store: Path, name: str) -> Result[Option[str], str]:
    """The identity `name` was last baked under, if any bake recorded one."""
    match get(snapshot(store)?, name_key(name)):
        None => return Ok(None)
        Some(value) =>
            match RustString.from_utf8(value):
                Ok(text) => return Ok(Some(str(text)))
                Err(_) => return Ok(None)


# ---- Views ----


pub def view(store: Path, fact: Fact, relative: str, destination: Path) -> Result[None, str]:
    """
    Make `destination` a view of one payload file of `fact` that its user may run, edit or strip.

    The view is a copy-on-write clone where the filesystem has one (APFS `clonefile`; reflinking `copy_file_range` on
    Linux) and a full copy otherwise, renamed into place so the destination is never half written. A view that still
    has its payload's size and modification time is current and is not cloned again.
    """
    for file in fact.files:
        if file.path == relative:
            return view_file(store, file, destination)
    return Err(f"bakery unit {fact.identity[:12]} has no file {relative}")


def view_file(store: Path, file: FactFile, destination: Path) -> Result[None, str]:
    """Clone one payload file to `destination` unless a current view is already there."""
    source = payload_path(store, file.digest)
    if same_file(source, destination):
        return Ok(None)
    make_directory(destination.parent())?
    staged = Path(f"{destination.0}.view-{id()}")
    clone(source, staged, file.program)?
    rename(staged.0, destination.0).map_err((error) => f"{destination.0}: {error}")?
    return Ok(None)


def clone(source: Path, destination: Path, program: bool) -> Result[None, str]:
    """Clone one payload and give the copy its owner's write bit and the unit's execute bit."""
    copy_file(source.0, destination.0).map_err((error) => f"{destination.0}: {error}")?
    mut mode = OPEN_FILE
    if program:
        mode = OPEN_PROGRAM
    set_permissions(destination.0, Permissions.from_mode(mode)).map_err((error) => f"{destination.0}: {error}")?
    # A clone keeps the payload's modification time, so an unchanged view is recognized without reading it.
    modified = metadata(source.0).map_err((error) => f"{source.0}: {error}")?.modified().map_err(
        (error) => f"{source.0}: {error}",
    )?
    mut options = OpenOptions.new()
    options.write(true)
    opened = options.open(destination.0).map_err((error) => f"{destination.0}: {error}")?
    opened.set_modified(modified).map_err((error) => f"{destination.0}: {error}")?
    return Ok(None)


pub def view_directory(store: Path, fact: Fact, destination: Path, prefix: str = "") -> Result[None, str]:
    """
    Make the directory `destination` a view of a whole unit, or of its files below `prefix`.

    A new view is assembled beside the destination and swapped in, so it is never half written. A whole-unit view also
    holds `fact.json`, which names the unit it was viewed from.
    """
    mut files = fact.files
    if prefix != "":
        files = [file for file in fact.files if file.path.startswith(prefix + "/")]
    if not destination.is_symlink() and destination.is_dir() and all_same(store, files, destination, prefix):
        return Ok(None)
    make_directory(destination.parent())?
    staged = Path(f"{destination.0}.view-{id()}")
    if staged.is_dir():
        staged.remove_tree().map_err((error) => f"{staged.0}: {error.message()}")?
    make_directory(staged)?
    for file in files:
        target = staged.joinpath(relative_to(file.path, prefix))
        make_directory(target.parent())?
        clone(payload_path(store, file.digest), target, file.program)?
    if prefix == "":
        marker = JsonValue.object({"identity": JsonValue.string(fact.identity)})
        publish(staged.joinpath(VIEW_RECORD), json_text(marker)?)?
    swap_in(staged, destination, store, files, prefix)?
    return Ok(None)


def relative_to(path: str, prefix: str) -> str:
    """`path` below `prefix`, or `path` itself when there is no prefix."""
    if prefix == "":
        return path
    return path[len(prefix) + 1:]


def swap_in(staged: Path, destination: Path, store: Path, files: list[FactFile], prefix: str) -> Result[None, str]:
    """
    Replace `destination` with the assembled view. A concurrent command may swap in its own view of the same unit
    meanwhile; a destination that already holds a current view is kept and this one discarded.
    """
    if destination.is_symlink():
        _ = destination.unlink()
    elif destination.is_dir():
        retired = Path(f"{destination.0}.retired-{id()}")
        match rename(destination.0, retired.0):
            Ok(_) => _ = retired.remove_tree()
            Err(_) => pass
    match rename(staged.0, destination.0):
        Ok(_) => return Ok(None)
        Err(error) =>
            if destination.is_dir() and all_same(store, files, destination, prefix):
                _ = staged.remove_tree()
                return Ok(None)
            return Err(f"{destination.0}: {error}")


def same_file(source: Path, view: Path) -> bool:
    """Whether a view still has its payload's size and modification time; a clone keeps both, an edit does not."""
    match metadata(source.0):
        Err(_) => return false
        Ok(original) =>
            match metadata(view.0):
                Err(_) => return false
                Ok(copied) =>
                    return original.len() == copied.len() and original.mtime() == copied.mtime() and original.mtime_nsec() == copied.mtime_nsec()


def all_same(store: Path, files: list[FactFile], view: Path, prefix: str) -> bool:
    """Whether a directory view still holds an unchanged clone of each of the unit's files."""
    for file in files:
        if not same_file(payload_path(store, file.digest), view.joinpath(relative_to(file.path, prefix))):
            return false
    return true


pub def reached(store: Path, directories: list[str]) -> Result[list[str], str]:
    """The identities of the units that `directories` (whole-unit views) were viewed from."""
    _ = store
    mut identities: list[str] = []
    for directory in directories:
        record = Path(directory).joinpath(VIEW_RECORD)
        if record.is_file():
            identity = required_text(read_json(record)?, "identity")?
            if identity not in identities:
                identities.append(identity)
    return Ok(identities)


pub def viewed_fact(directory: Path) -> Result[Option[Path], str]:
    """
    The current view of the unit a directory was viewed from, for readers of a library's artifacts.

    A view whose files were changed or removed is cloned again. A view whose unit is no longer baked, or is damaged, is
    not a view: the caller treats the library as absent and bakes it again.
    """
    record = directory.joinpath(VIEW_RECORD)
    if not record.is_file():
        return Ok(None)
    identity = required_text(read_json(record)?, "identity")?
    store = bakery()?
    match find(store, identity)?:
        None => return Ok(None)
        Some(fact) =>
            view_directory(store, fact, directory)?
            return Ok(Some(directory))


pub def forget_verified() -> None:
    """Forget which payloads this process verified, as a new process would; the next find reads them again."""
    for digest in [name for name in verified.keys()]:
        verified[digest] = false


# ---- Roots and collection ----


pub def register_root(store: Path, project: str, identity: str) -> Result[None, str]:
    """Record that builds of `project` use `identity`, so collection keeps it; the marker's time is its last use."""
    directory = store.joinpath("roots").joinpath(fingerprint([project])?[:32])
    make_directory(directory)?
    owner = directory.joinpath("project")
    if not owner.is_file():
        publish(owner, project)?
    publish(directory.joinpath(identity), "")?
    return Ok(None)


pub def collect(store: Path, keep_days: int) -> Result[Collected, str]:
    """
    Remove every unit no root reaches. Nothing runs automatically; this is `incan bakery gc`.

    1. Drop roots not used within the last `keep_days` days (all roots are kept when it is negative).
    2. Mark every identity a root reaches, through the identities each unit records.
    3. Compact the store to the marked units and their names, then remove unnamed segments, unreachable payloads and
       staging directories no baker holds.
    """
    # 1. A root's age is the time of its last use.
    roots = store.joinpath("roots")
    mut dropped = 0
    mut pending: list[str] = []
    if roots.is_dir():
        for project in roots.iterdir().map_err((error) => error.message())?:
            for marker in project.iterdir().map_err((error) => error.message())?:
                if marker.name() == "project":
                    continue
                if keep_days >= 0 and age_seconds(marker) >= keep_days * SECONDS_PER_DAY:
                    marker.unlink().map_err((error) => error.message())?
                    dropped += 1
                else:
                    pending.append(marker.name())
    # 2. Reachability follows the identities each unit records.
    current = snapshot(store)?
    marked = reachable(current, pending)
    # 3. Only what nothing reaches is removed.
    return sweep(store, current, marked, dropped)


def age_seconds(path: Path) -> int:
    """Seconds since `path` was last modified."""
    match path.stat():
        Err(_) => return 0
        Ok(info) =>
            match info.modified_unix():
                Ok(modified) => return now_seconds() - modified
                Err(_) => return 0


def reachable(current: Snapshot, roots: list[str]) -> Dict[str, Fact]:
    """Every baked unit reachable from `roots`, by identity."""
    mut marked: Dict[str, Fact] = {}
    mut pending = roots
    while len(pending) > 0:
        identity = pending.pop()
        if identity in marked:
            continue
        if let Some(value) = get(current, record_key(identity)):
            if let Some(fact) = decode_fact(value):
                marked[identity] = fact
                for item in fact.reaches:
                    pending.append(item)
    return marked


def sweep(store: Path, current: Snapshot, marked: Dict[str, Fact], dropped: int) -> Result[Collected, str]:
    """Compact to the marked units, then remove what no kept record names."""
    mut keep: set[str] = set()
    mut live: set[str] = set()
    for identity in marked.keys():
        fact = marked[identity]
        keep.add(record_key(identity))
        keep.add(name_key(fact.name))
        for file in fact.files:
            live.add(file.digest)
    units = unit_count(current)
    compacted = compact(store, keep)?
    removed_segments = sweep_segments(store)?
    removed_payloads = sweep_payloads(store, live)?
    trace(f"bakery gc: generation {compacted.generation}, {removed_segments} segment files, {removed_payloads} payloads")
    cleared = clear_staging(store)?
    return Ok(Collected(kept=len(marked), removed=units - len(marked), roots_dropped=dropped, staging_cleared=cleared))


def unit_count(current: Snapshot) -> int:
    """How many unit records the snapshot holds."""
    mut count = 0
    for key in keys(current):
        if let Some(value) = get(current, key):
            if let Some(fact) = decode_fact(value):
                count += 1
    return count


def clear_staging(store: Path) -> Result[int, str]:
    """Remove staging directories whose baker no longer holds the claim of their identity."""
    directory = store.joinpath("staging")
    if not directory.is_dir():
        return Ok(0)
    mut cleared = 0
    for entry in directory.iterdir().map_err((error) => error.message())?:
        identity = entry.name().split(".")[0]
        lock = store.joinpath("claims").joinpath(record_key(identity))
        make_directory(lock.parent())?
        match lock.try_lock_exclusive().map_err((error) => error.message())?:
            None => pass
            Some(held) =>
                if removed_tree(entry):
                    cleared += 1
    return Ok(cleared)


# ---- Verification ----


pub def verify_all(store: Path) -> Result[list[str], str]:
    """
    Read every byte of every unit's payloads and compare them with their digests; return what was damaged.

    A damaged payload is dropped, so its unit is a miss and the next build bakes it again.
    """
    current = snapshot(store)?
    mut damaged: list[str] = []
    for key in keys(current):
        if let Some(value) = get(current, key):
            if let Some(fact) = decode_fact(value):
                for file in fact.files:
                    if not payload_intact(store, file.digest):
                        damaged.append(f"bakery unit {fact.identity}: payload file {file.path} is damaged")
                        _ = drop_payload(store, file.digest)
    return Ok(damaged)


# ---- Command line ----


pub def parse_bakery(arguments: list[str]) -> Result[int, str]:
    """
    Parse `incan bakery verify` or `incan bakery gc [--keep-days N]`: `VERIFY`, or the days of root history to keep
    (-1 keeps every root).
    """
    if len(arguments) == 0:
        return Err("a subcommand is required: gc or verify")
    if arguments[0] == "verify":
        if len(arguments) > 1:
            return Err(f"unexpected argument `{arguments[1]}`")
        return Ok(VERIFY)
    if arguments[0] != "gc":
        return Err(f"unknown command `{arguments[0]}`")
    rest = arguments[1:]
    if len(rest) == 0:
        return Ok(-1)
    if rest[0] != "--keep-days":
        if rest[0].startswith("-"):
            return Err(f"unknown option `{rest[0]}`")
        return Err(f"unexpected argument `{rest[0]}`")
    if len(rest) != 2 or len(rest[1]) == 0 or len(rest[1]) > 6:
        return Err("`--keep-days` needs a number of days")
    for character in rest[1]:
        if character not in "0123456789":
            return Err("`--keep-days` needs a number of days")
    return Ok(int(rest[1]))


pub def bakery_command(request: int) -> Result[i32, str]:
    """Verify every unit's bytes, or collect the bakery, and say what was found or done."""
    store = bakery()?
    if request == VERIFY:
        damaged = verify_all(store)?
        for reason in damaged:
            println(reason)
        println(f"{len(damaged)} damaged payload files")
        if len(damaged) > 0:
            return Ok(1)
        return Ok(0)
    collected = collect(store, request)?
    println(
        f"kept {collected.kept} units, removed {collected.removed}, dropped {collected.roots_dropped} roots, "
        + f"cleared {collected.staging_cleared} staging directories",
    )
    return Ok(0)


def removed_tree(directory: Path) -> bool:
    """Remove a directory tree; false when it could not be removed."""
    match directory.remove_tree():
        Ok(_) => return true
        Err(_) => return false


pub def claim_file(store: Path, identity: str) -> Path:
    """The lock file whose exclusive lock is the claim of `identity`."""
    return store.joinpath("claims").joinpath(record_key(identity))


pub def staging_root(store: Path) -> Path:
    """Where bakes in progress stage their files."""
    return store.joinpath("staging")
