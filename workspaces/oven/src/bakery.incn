"""
The home bakery: one store per Incan home that every project, test and CI step asks for its units (DD-0012, RFC 124).

Units are records in the home's platform store, keyed by unit identity. A unit record names its kind,
its name, the identities it reaches and each payload file: a path inside the unit, the content digest it is stored
under, its size and whether it is a program. Payload files are content-named files of the store, which rustc and the
OS read as files. `target/` folders hold views of them: copy-on-write clones a user may run, edit or strip.

Under the bakery directory (`<home>/bakery/`, unless `[storage] root` or `INCAN_BAKERY` selects another, see
`home_paths`): the segment store itself, `staging/` for bakes in progress, `reservations/` for the free space each
bake was admitted for (`storage_admission`), and `roots/<project>/<identity>` for the identities each project's builds
use.

Asking is one path for cold and warm builds: find the record, or claim its identity, look again, bake into a private
staging directory, store the payloads and publish the record. Concurrent askers wait on the claim and then find the
record. Staging and storing the payloads are admitted against free space; a warm selection writes neither. The store
reports a damaged record or payload; lookup refuses damage until an explicit repair or verified re-admission.
Explicit collection reclaims superseded layouts and unreachable payloads under live snapshot and preparation leases;
the store has no size ceiling.
"""

from rust::std::fs import OpenOptions, Permissions, copy as copy_file, metadata, rename, set_permissions
from rust::std::os::unix::fs import MetadataExt, PermissionsExt
from rust::std::process import id
from rust::std::string import String as RustString
from std.encoding.hex import hexlify
from std.environ import get_or
from std.hash import file_digest
from std.fs import Path
from std.fs.locking import FileLock
from std.json import JsonValue
from files import json_text, make_directory, read_json
from home_paths import home
pub from home_paths import bakery
from pub::incan_platform.trace import Operation
from jec import begin as begin_work, record as record_work
from json_fields import required_text
from observation import observe, trace
from publication import publish
from unit_publication import record_path, record_verified_payload, source_origins
from storage_admission import extend, release, reserve, tree_bytes
from pub::incan_platform.store import (
    EXPECT_REPAIR,
    Lookup,
    Snapshot,
    Transaction,
    begin,
    commit,
    get,
    keys,
    lookup as store_lookup,
    owned,
    put,
)
from pub::incan_platform.store.files import StoreError
from pub::incan_platform.store.repair import quarantine_record
from store_path_conversion import (
    claim as claim_key,
    payload_intact,
    payload_path,
    prepare_payloads,
    quarantine_payload,
    readmit_payload,
    snapshot,
)
from unit import UnitDescription
from unit_freshness import Key, fingerprint
from bakery_records import Fact, FactFile, claim_file, decode_fact, encode_fact, record_key, staging_root, store_failure
from bakery_roots import collect, preview_collection

const VIEW_RECORD: str = "fact.json"
const VERIFY: int = -2
const OPEN_FILE: u32 = 420
const OPEN_PROGRAM: u32 = 493
const RECORD_SUFFIX: str = ".oven-unit"
# Payload digests verified against exact metadata observations; external changes require a fresh digest.
static verified: dict[str, str] = {}


pub def unit_identity(key: Key) -> str:
    """The identity a unit is stored under: RFC 124's unit identity, which the unit key carries."""
    return key.digest


pub def unit_name(unit: UnitDescription) -> str:
    """The name a unit is indexed under: package, version, kind, profile and active features."""
    features = ",".join(unit.active_features)
    return f"{unit.package}\t{unit.version}\t{unit.kind}\t{unit.profile}\t{features}"


def name_key(name: str) -> str:
    """The full store key of the record naming the latest identity of `name`."""
    return f"incan.bakery.name\t{name}"


# ---- Asking ----


pub def find(store: Path, identity: str) -> Result[Option[Fact], str]:
    """The baked unit of `identity`, or nothing; see `find_unit`."""
    clock = begin_work()
    found = find_unit(store, identity)
    record_work(Operation.BakeryFind, identity, clock)
    return found


def find_unit(store: Path, identity: str) -> Result[Option[Fact], str]:
    """Find an intact unit; damage names its object and requires an explicit owner repair."""
    view = snapshot(store).map_err(store_failure)?
    match store_lookup(view, record_key(identity)).map_err(store_failure)?:
        Lookup.Found(value) => return checked_fact(store, identity, owned(value))
        Lookup.Deleted => return Ok(None)
        Lookup.Absent => return Ok(None)


def checked_fact(store: Path, identity: str, value: bytes) -> Result[Option[Fact], str]:
    """Decode a selected unit and verify its payloads without mutating the store on failure."""
    object = record_key(identity)
    match decode_fact(value):
        None => return Err(StoreError(kind="integrity", object=object, detail="invalid unit record").message())
        Some(fact) =>
            if fact.identity != identity:
                return Err(StoreError(kind="integrity", object=object, detail="unit names another identity").message())
            for file in fact.files:
                if not payload_current(store, file):
                    path = payload_path(store, file.digest)
                    return Err(StoreError(kind="integrity", object=path.0, detail="unit payload is damaged").message())
            return Ok(Some(fact))


def payload_current(store: Path, file: FactFile) -> bool:
    """Whether a payload matches its digest, revalidated whenever its metadata observation changes."""
    path = payload_path(store, file.digest)
    match metadata(path.0):
        Err(_) => return false
        Ok(info) =>
            if int(info.len()) != file.size:
                return false
    stamp = match observe(path):
        Ok(observed) => observed.stamp
        Err(_) => return false

    if verified.get(file.digest, "") == stamp:
        return true
    if not payload_intact(store, file.digest):
        return false
    verified[file.digest] = stamp
    return true


pub def claim(store: Path, identity: str) -> Result[FileLock, str]:
    """Claim `identity` for baking; see `claim_unit`."""
    clock = begin_work()
    held = claim_unit(store, identity)
    record_work(Operation.BakeryClaim, identity, clock)
    return held


def claim_unit(store: Path, identity: str) -> Result[FileLock, str]:
    """
    Claim `identity` for baking; waits while another baker holds it. The claim lasts as long as the lock.

    The caller asks `find` again once it holds the claim, because the previous holder may have published the unit. A
    holder that died released its lock with its process, so its claim is a miss for the next asker.
    """
    return claim_key(store, record_key(identity)).map_err(store_failure)


pub def staging(store: Path, identity: str, estimate: int = 0, claimed: str = "") -> Result[Path, str]:
    """
    A fresh, empty staging directory for baking `identity`, admitted against the store's free space.

    The caller holds the claim of `claimed` (`identity` unless named) until it seals or abandons the bake; that claim
    proves the attempt alive. `estimate` is the bytes the bake is expected to stage, such as the size of the unit
    last baked under its name. Without one, admission still refuses a store that is already inside its reserve. A
    write that does not fit stops here with a decision-required outcome, before anything is staged.
    """
    name = f"{identity}.{id()}"
    directory = staging_root(store).joinpath(name)
    if directory.is_dir():
        directory.remove_tree().map_err((error) => f"{directory.0}: {error.message()}")?
    mut owner = claimed
    if owner == "":
        owner = identity
    mut basis = "unknown"
    if estimate > 0:
        basis = "estimate"
    reserve(store, name, f"bake {identity}", claim_file(store, owner).0, estimate, basis, preview_collection)?
    make_directory(directory)?
    return Ok(directory)


pub def prior_size(store: Path, name: str) -> int:
    """The payload bytes of the unit last baked under `name`, an estimate of what its next bake stages; else zero."""
    match prior_fact(store, name):
        Ok(found) =>
            if let Some(fact) = found:
                return fact_bytes(fact)
        Err(_) => pass
    return 0


def prior_fact(store: Path, name: str) -> Result[Option[Fact], str]:
    """The record last baked under `name`, read without verifying its payloads."""
    match lookup(store, name)?:
        None => return Ok(None)
        Some(identity) =>
            match get(snapshot(store).map_err(store_failure)?, record_key(identity)).map_err(store_failure)?:
                None => return Ok(None)
                Some(value) => return Ok(decode_fact(value))


def fact_bytes(fact: Fact) -> int:
    """The logical bytes of a unit's payload files."""
    mut total = 0
    for file in fact.files:
        total += file.size
    return total


pub def seal(
    store: Path,
    identity: str,
    staged: Path,
    kind: str,
    name: str,
    reaches: list[str],
    provenance: str,
) -> Result[Fact, str]:
    """
    Publish a completed bake of `identity`; the caller holds its claim.

    1. Store every staged file as a content-named payload.
    2. Publish the unit record and the record of its name in one delta.
    3. Remove the staging directory.
    """
    clock = begin_work()
    prepared = prepare_seal(store, identity, staged, kind, name, reaches, provenance)?
    published = commit(prepared.transaction).map_err(store_failure)?
    trace(f"bakery {identity[:12]}: baked {kind} {name} (generation {published.generation})")
    record_work(Operation.BakerySeal, identity, clock)
    return Ok(prepared.fact)


pub model PreparedFact:
    """An unpublished fact whose transaction holds every payload lease; the producer also retains its unit claim."""

    pub fact: Fact
    pub transaction: Transaction


pub def prepare_seal(
    store: Path,
    identity: str,
    staged: Path,
    kind: str,
    name: str,
    reaches: list[str],
    provenance: str,
) -> Result[PreparedFact, str]:
    """
    Store immutable payloads before preparing their records; only the caller's commit makes the unit visible.

    Copying the staged files into the store is admitted first. A refusal removes the staging directory, so the
    decision-required outcome leaves no private state of the attempt behind.
    """
    relatives = staged_files(staged, "")?
    match extend(store, staged.name(), f"seal {identity}", tree_bytes(staged), preview_collection):
        Ok(_) => pass
        Err(reason) =>
            _ = staged.remove_tree()
            release(store, staged.name())
            return Err(reason)
    digests = prepare_payloads(store, [staged.joinpath(relative) for relative in relatives]).map_err(store_failure)?
    mut files: list[FactFile] = []
    for index in range(len(relatives)):
        files.append(stored_file(staged, relatives[index], digests[index].digest)?)
    fact = Fact(identity=identity, kind=kind, name=name, reaches=reaches, files=files)
    mut transaction = begin(snapshot(store).map_err(store_failure)?)
    transaction.payloads = digests
    transaction = put(transaction, record_key(identity), encode_fact(fact, provenance)?.encode("utf-8"), EXPECT_REPAIR)
    transaction = put(transaction, name_key(name), identity.encode("utf-8"))
    _ = staged.remove_tree()
    release(store, staged.name())
    return Ok(PreparedFact(fact=fact, transaction=transaction))


def stored_file(staged: Path, relative: str, digest: str) -> Result[FactFile, str]:
    """Describe one staged file stored under `digest`."""
    path = staged.joinpath(relative)
    info = metadata(path.0).map_err((error) => f"{path.0}: {error}")?
    verified[digest] = ""
    program = int(info.permissions().mode()) // 64 % 2 == 1
    return Ok(FactFile(path=relative, digest=digest, size=int(info.len()), program=program))


def staged_files(directory: Path, prefix: str) -> Result[list[str], str]:
    """Every regular file under `directory`, as sorted paths relative to the staging root."""
    mut files: list[str] = []
    for entry in directory.iterdir().map_err((error) => error.message())?:
        mut relative = entry.name()
        if prefix != "":
            relative = f"{prefix}/{entry.name()}"
        if entry.is_dir() and not entry.is_symlink():
            files = files + staged_files(entry, relative)?
        elif entry.is_file():
            files.append(relative)
    return Ok(sorted(files))


pub def fact_file(store: Path, fact: Fact, relative: str) -> Option[Path]:
    """The stored payload of one file of a unit, for readers that read it in place."""
    for file in fact.files:
        if file.path == relative:
            return Some(payload_path(store, file.digest))
    return None


pub def has_files_under(fact: Fact, prefix: str) -> bool:
    """Whether a unit has payload files below the directory `prefix`, such as a debug bundle."""
    for file in fact.files:
        if file.path.startswith(prefix + "/"):
            return true
    return false


# ---- Records ----


pub def lookup(store: Path, name: str) -> Result[Option[str], str]:
    """The identity last selected by a name; a damaged binding is an error, never absence."""
    key = name_key(name)
    match get(snapshot(store).map_err(store_failure)?, key).map_err(store_failure)?:
        None => return Ok(None)
        Some(value) =>
            match RustString.from_utf8(value):
                Ok(text) => return Ok(Some(str(text)))
                Err(_) => return Err(StoreError(kind="integrity", object=key, detail="invalid name binding").message())


# ---- Views ----


pub def view(store: Path, fact: Fact, relative: str, destination: Path) -> Result[None, str]:
    """Make `destination` a view of one file of `fact`; see `view_unit_file`."""
    clock = begin_work()
    viewed = view_unit_file(store, fact, relative, destination)
    record_work(Operation.BakeryView, destination.0, clock)
    return viewed


def view_unit_file(store: Path, fact: Fact, relative: str, destination: Path) -> Result[None, str]:
    """
    Make `destination` a view of one payload file of `fact` that its user may run, edit or strip.

    The view is a copy-on-write clone where the filesystem has one (APFS `clonefile`; reflinking `copy_file_range` on
    Linux) and a full copy otherwise, renamed into place so the destination is never half written. A view that still
    has its payload's size and modification time is current and is not cloned again.
    """
    for file in fact.files:
        if file.path == relative:
            view_file(store, file, destination)?
            for record in fact.files:
                if record.path == relative + RECORD_SUFFIX and not record_path(destination).is_file():
                    view_file(store, record, record_path(destination))?
            return admit_view(destination)
    return Err(f"bakery unit {fact.identity[:12]} has no file {relative}")


def view_file(store: Path, file: FactFile, destination: Path) -> Result[None, str]:
    """Clone one payload file to `destination` unless a current view is already there."""
    source = payload_path(store, file.digest)
    if same_file(source, destination):
        return Ok(None)
    make_directory(destination.parent())?
    staged = Path(f"{destination.0}.view-{id()}")
    clone(source, staged, file.program)?
    rename(staged.0, destination.0).map_err((error) => f"{destination.0}: {error}")?
    return Ok(None)


def clone(source: Path, destination: Path, program: bool) -> Result[None, str]:
    """Clone one payload and give the copy its owner's write bit and the unit's execute bit."""
    copy_file(source.0, destination.0).map_err((error) => f"{destination.0}: {error}")?
    mut mode = OPEN_FILE
    if program:
        mode = OPEN_PROGRAM
    set_permissions(destination.0, Permissions.from_mode(mode)).map_err((error) => f"{destination.0}: {error}")?
    # A clone keeps the payload's modification time, so an unchanged view is recognized without reading it.
    modified = metadata(source.0).map_err((error) => f"{source.0}: {error}")?.modified().map_err(
        (error) => f"{source.0}: {error}",
    )?
    mut options = OpenOptions.new()
    options.write(true)
    opened = options.open(destination.0).map_err((error) => f"{destination.0}: {error}")?
    opened.set_modified(modified).map_err((error) => f"{destination.0}: {error}")?
    return Ok(None)


pub def view_directory(store: Path, fact: Fact, destination: Path, prefix: str = "") -> Result[None, str]:
    """Make `destination` a view of a whole unit, or of its files below `prefix`; see `view_unit_directory`."""
    clock = begin_work()
    viewed = view_unit_directory(store, fact, destination, prefix)
    record_work(Operation.BakeryView, destination.0, clock)
    return viewed


def view_unit_directory(store: Path, fact: Fact, destination: Path, prefix: str = "") -> Result[None, str]:
    """
    Make the directory `destination` a view of a whole unit, or of its files below `prefix`.

    A new view is assembled beside the destination and swapped in, so it is never half written. A whole-unit view also
    holds `fact.json`, which names the unit it was viewed from.
    """
    mut files = fact.files
    if prefix != "":
        files = [file for file in fact.files if file.path.startswith(prefix + "/")]
    if not destination.is_symlink() and destination.is_dir() and all_same(store, files, destination, prefix):
        return Ok(None)
    make_directory(destination.parent())?
    staged = Path(f"{destination.0}.view-{id()}")
    if staged.is_dir():
        staged.remove_tree().map_err((error) => f"{staged.0}: {error.message()}")?
    make_directory(staged)?
    for file in files:
        target = staged.joinpath(relative_to(file.path, prefix))
        make_directory(target.parent())?
        clone(payload_path(store, file.digest), target, file.program)?
    if prefix == "":
        marker = JsonValue.object({"identity": JsonValue.string(fact.identity)})
        publish(staged.joinpath(VIEW_RECORD), json_text(marker)?)?
    swap_in(staged, destination, store, files, prefix)?
    admit_views(files, destination, prefix)?
    return Ok(None)


def relative_to(path: str, prefix: str) -> str:
    """`path` below `prefix`, or `path` itself when there is no prefix."""
    if prefix == "":
        return path
    return path[len(prefix) + 1:]


def swap_in(staged: Path, destination: Path, store: Path, files: list[FactFile], prefix: str) -> Result[None, str]:
    """
    Replace `destination` with the assembled view. A concurrent command may swap in its own view of the same unit
    meanwhile; a destination that already holds a current view is kept and this one discarded.
    """
    if destination.is_symlink():
        _ = destination.unlink()
    elif destination.is_dir():
        retired = Path(f"{destination.0}.retired-{id()}")
        match rename(destination.0, retired.0):
            Ok(_) => _ = retired.remove_tree()
            Err(_) => pass
    match rename(staged.0, destination.0):
        Ok(_) => return Ok(None)
        Err(error) =>
            if destination.is_dir() and all_same(store, files, destination, prefix):
                _ = staged.remove_tree()
                return Ok(None)
            return Err(f"{destination.0}: {error}")


def same_file(source: Path, view: Path) -> bool:
    """Whether a view still has its payload's size and modification time; a clone keeps both, an edit does not."""
    match metadata(source.0):
        Err(_) => return false
        Ok(original) =>
            match metadata(view.0):
                Err(_) => return false
                Ok(copied) =>
                    return (
                        original.len() == copied.len()
                        and original.mtime() == copied.mtime()
                        and original.mtime_nsec() == copied.mtime_nsec()
                    )


def all_same(store: Path, files: list[FactFile], view: Path, prefix: str) -> bool:
    """Whether a directory view still holds an unchanged clone of each of the unit's files."""
    for file in files:
        target = view.joinpath(relative_to(file.path, prefix))
        if is_record(file):
            if not target.is_file():
                return false
        elif not same_file(payload_path(store, file.digest), target):
            return false
    return true


pub def reached(store: Path, directories: list[str]) -> Result[list[str], str]:
    """The identities of the units that `directories` (whole-unit views) were viewed from."""
    _ = store
    mut identities: list[str] = []
    for directory in directories:
        record = Path(directory).joinpath(VIEW_RECORD)
        if record.is_file():
            identity = required_text(read_json(record)?, "identity")?
            if identity not in identities:
                identities.append(identity)
    return Ok(identities)


pub def forget_view(directory: Path) -> Result[None, str]:
    """Remove only a directory's fact selection before an unbaked producer replaces its local outputs."""
    marker = directory.joinpath(VIEW_RECORD)
    if marker.is_file():
        marker.unlink().map_err((error) => error.message())?
    return Ok(None)


pub def library_directory(store: Path, directory: Path) -> Result[Path, str]:
    """
    Name a baked library through store-owned filename bindings, independently of any project's disposable views.

    Native libraries require their original filenames and sibling metadata. Each layout names the exact payload set,
    so a later fact repair cannot retarget an existing native closure. Data bindings link canonical payloads;
    executable workers are materialized inside the layout to preserve the compiler's artifact-root confinement.
    Producer records describe these bindings' generations.
    An unbaked or installed directory retains its existing location.

    1. Read the view's exact unit identity and require its complete fact.
    2. Under a layout claim, bind every member to its canonical payload and admit its producer records.
    """
    # 1. A view selects an exact fact; the name index never substitutes another revision.
    marker = directory.joinpath(VIEW_RECORD)
    if not marker.is_file():
        return Ok(directory)
    canonical = store.resolve().map_err((error) => error.message())?
    fact = library_fact(canonical, read_json(marker)?)?
    return bind_library(canonical, fact)


def library_fact(store: Path, marker: JsonValue) -> Result[Fact, str]:
    """Read a layout's exact payload snapshot, or a project's current unit selection, refusing damaged payloads."""
    if marker.get("layout") != None:
        document = required_text(marker, "fact")?
        match decode_fact(document.encode("utf-8")):
            None => return Err("invalid library layout fact")
            Some(fact) =>
                if (
                    required_text(marker, "identity")? != fact.identity
                    or required_text(marker, "layout")? != library_layout(fact)?
                ):
                    return Err("library layout names another payload set")
                for file in fact.files:
                    if not payload_current(store, file):
                        return Err(f"{file.path}: library payload is damaged")
                return Ok(fact)
    identity = required_text(marker, "identity")?
    match find(store, identity)?:
        None => return Err(f"library's baked unit is absent: {identity}")
        Some(fact) => return Ok(fact)


def library_layout(fact: Fact) -> Result[str, str]:
    """Name the exact member payloads, keeping earlier layouts valid after a unit-record repair."""
    return fingerprint(["incan.bakery.library-layout/1", encode_fact(fact, "library bindings")?])


def bind_library(store: Path, fact: Fact) -> Result[Path, str]:
    """Complete immutable filename bindings under a claim before returning the library to any consumer."""
    # 2. A crashed first binder is completed by the next caller before any consumer gets the directory.
    layout = library_layout(fact)?
    held = claim(store, f"library-layout/{layout}")?
    selected = store.joinpath("libraries").joinpath(layout)
    make_directory(selected)?
    for file in fact.files:
        if file.path == "" or file.path.startswith("/") or ".." in file.path.split("/"):
            return Err("library member is not a relative filename")
        source = payload_path(store, file.digest)
        target = selected.joinpath(file.path)
        make_directory(target.parent())?
        if is_record(file):
            if not target.is_file():
                clone(source, target, false)?
        elif file.program:
            # A worker's resolved executable must remain inside the library's verified artifact root.
            if target.is_symlink():
                target.unlink().map_err((error) => error.message())?
            view_file(store, file, target)?
        elif target.is_symlink():
            resolved = target.resolve().map_err((error) => error.message())?
            if resolved.0 != source.0:
                return Err(f"{target.0}: library binding names another payload")
        elif target.exists():
            return Err(f"{target.0}: library binding is not a payload link")
        else:
            target.symlink_to(source).map_err((error) => error.message())?
    if not selected.joinpath(VIEW_RECORD).is_file():
        marker = JsonValue.object(
            {"identity": JsonValue.string(fact.identity), "layout": JsonValue.string(layout), "fact": JsonValue.string(
                encode_fact(fact, "library bindings")?,
            )},
        )
        publish(selected.joinpath(VIEW_RECORD), json_text(marker)?)?
    admit_views(fact.files, selected, "")?
    return Ok(selected)


pub def viewed_fact(directory: Path) -> Result[Option[Path], str]:
    """
    The current view of the unit a directory was viewed from, for readers of a library's artifacts.

    Only changed or missing view members are cloned again; intact members keep their file generations. A view whose unit is no longer baked, or is damaged, is
    refused with a named integrity error; normal lookup never repairs frozen bytes.
    """
    record = directory.joinpath(VIEW_RECORD)
    if not record.is_file():
        return Ok(None)
    marker = read_json(record)?
    store = bakery()?
    if marker.get("layout") != None:
        return Ok(Some(library_directory(store, directory)?))
    identity = required_text(marker, "identity")?
    match find(store, identity)?:
        None => return Ok(None)
        Some(fact) =>
            repair_view(store, fact, directory)?
            return Ok(Some(directory))


def repair_view(store: Path, fact: Fact, directory: Path) -> Result[None, str]:
    """
    Repair members of a verified unit view independently, preserving every intact member's file generation.

    Build publication still swaps a complete directory. Readers already selected this unit through its fact marker;
    each damaged member is atomically replaced from its verified canonical payload instead of replacing its siblings.
    Producer records already bound to intact views stay bound to them. A linked directory is replaced without
    modifying its referent.
    """
    if directory.is_symlink():
        return view_directory(store, fact, directory)
    for file in fact.files:
        target = directory.joinpath(file.path)
        if is_record(file) and target.is_file():
            continue
        view_file(store, file, target)?
    return admit_views(fact.files, directory, "")


pub def forget_verified() -> None:
    """Forget which payloads this process verified, as a new process would; the next find reads them again."""
    verified = {}


pub def verification_entries() -> int:
    """Payload metadata observations owned by the current request; idle services must retain zero."""
    return len(verified)


# ---- Verification ----


pub def verify_all(store: Path) -> Result[list[str], str]:
    """
    Read every byte of every unit's payloads and compare them with their digests; return what was damaged.

    Verification only reports. A damaged payload remains untouched until explicit verified re-admission.
    """
    current = snapshot(store).map_err(store_failure)?
    mut damaged: list[str] = []
    for key in keys(current).map_err(store_failure)?:
        if not key.startswith("incan.bakery.unit\t"):
            continue
        match get(current, key):
            Err(error) => damaged.append(error.message())
            Ok(found) =>
                if let Some(value) = found:
                    damaged.extend(verify_record(store, key, value))
    return Ok(damaged)


def verify_record(store: Path, key: str, value: bytes) -> list[str]:
    """Audit a record's schema, exact identity and every payload; report all damage without mutations."""
    mut damaged: list[str] = []
    match decode_fact(value):
        None => damaged.append(StoreError(kind="integrity", object=key, detail="invalid unit record").message())
        Some(fact) =>
            if record_key(fact.identity) != key:
                damaged.append(StoreError(kind="integrity", object=key, detail="unit names another identity").message())
            for file in fact.files:
                if not payload_intact(store, file.digest):
                    path = payload_path(store, file.digest)
                    damaged.append(
                        StoreError(kind="integrity", object=path.0, detail="unit payload is damaged").message(),
                    )
    return damaged


# ---- Command line ----


pub def parse_bakery(arguments: list[str]) -> Result[int, str]:
    """
    Parse `oven bakery verify` or `oven bakery gc [--keep-days N]`: `VERIFY`, or the compatibility `--keep-days`
    argument (-1 when omitted). Collection follows registrations and never expires a record by age.
    """
    if len(arguments) == 0:
        return Err("a subcommand is required: gc or verify")
    if arguments[0] == "verify":
        if len(arguments) > 1:
            return Err(f"unexpected argument `{arguments[1]}`")
        return Ok(VERIFY)
    if arguments[0] != "gc":
        return Err(f"unknown command `{arguments[0]}`")
    rest = arguments[1:]
    if len(rest) == 0:
        return Ok(-1)
    if rest[0] != "--keep-days":
        if rest[0].startswith("-"):
            return Err(f"unknown option `{rest[0]}`")
        return Err(f"unexpected argument `{rest[0]}`")
    if len(rest) != 2 or len(rest[1]) == 0 or len(rest[1]) > 6:
        return Err("`--keep-days` needs a number of days")
    for character in rest[1]:
        if character not in "0123456789":
            return Err("`--keep-days` needs a number of days")
    return Ok(int(rest[1]))


pub def bakery_command(request: int) -> Result[i32, str]:
    """Verify every unit's bytes, or collect the bakery, and say what was found or done."""
    store = bakery()?
    if request == VERIFY:
        damaged = verify_all(store)?
        for reason in damaged:
            println(reason)
        println(f"{len(damaged)} damaged objects")
        if len(damaged) > 0:
            return Ok(1)
        return Ok(0)
    collected = collect(store, request)?
    println(
        f"kept {collected.kept} units, removed {collected.removed}, dropped {collected.roots_dropped} roots, " + f"cleared {collected.staging_cleared} staging directories, reclaimed {collected.layouts_removed} layouts and {collected.payloads_removed} payloads ({collected.bytes_reclaimed} bytes)",
    )
    return Ok(0)


def admit_views(files: list[FactFile], view: Path, prefix: str) -> Result[None, str]:
    """
    Bind each viewed artifact's producer record to the view itself.

    A producer record names the file generation it describes. A view is a new generation of a verified payload, so its
    record is republished for that generation; the unit and payload identities do not change.
    """
    for file in files:
        if file.path.endswith(RECORD_SUFFIX):
            continue
        admit_view(view.joinpath(relative_to(file.path, prefix)))?
    return Ok(None)


def admit_view(artifact: Path) -> Result[None, str]:
    """Republish one view's producer record for the view's own file generation, when the unit carries one."""
    record = record_path(artifact)
    if not record.is_file() or not artifact.is_file():
        return Ok(None)
    document = read_json(record)?
    observation = observe(artifact)?.stamp
    if required_text(document, "observation")? == observation:
        return Ok(None)
    return record_verified_payload(
        artifact,
        required_text(document, "unit")?,
        required_text(document, "payload")?,
        observation,
        source_origins(artifact)?,
    )


def is_record(file: FactFile) -> bool:
    """Whether a unit file is a producer record, which a view keeps once it is bound to the view."""
    return file.path.endswith(RECORD_SUFFIX)


pub def repair_derived(
    store: Path,
    identity: str,
    staged: Path,
    kind: str,
    name: str,
    reaches: list[str],
    provenance: str,
) -> Result[Fact, str]:
    """
    Publish an explicitly recomputed derived unit after preserving damage as quarantine evidence.

    The owner must supply a complete bake from verified inputs under this exact identity, not frozen imported facts.
    Ordinary reads and verification never invoke this operation.

    1. Claim the exact identity and preserve any selected damage.
    2. Clear damaged canonical names needed by the verified replacement.
    3. Publish the recomputed unit in a new record transaction.
    """
    # 1. The claim excludes a competing producer while the old damage is preserved.
    held = claim(store, identity)?
    view = snapshot(store).map_err(store_failure)?
    if not preserve_unit_damage(store, identity, view)?:
        return Err(
            StoreError(
                kind="conflict",
                object=record_key(identity),
                detail="unit is intact or absent; repair is not applicable",
            ).message(),
        )
    # 2. The owner supplied complete replacement bytes, independently of damaged storage.
    for relative in staged_files(staged, "")?:
        source = staged.joinpath(relative)
        digest = hexlify(file_digest(source, "sha256").map_err((error) => error.message())?)
        quarantine_payload(store, digest).map_err(store_failure)?
    # 3. Record publication uses the same transaction path as an ordinary bake.
    forget_verified()
    return seal(store, identity, staged, kind, name, reaches, provenance)


pub def repair_payload_command(arguments: list[str]) -> Result[i32, str]:
    """Re-admit a payload only from an explicit replacement whose full digest matches its committed name."""
    if len(arguments) != 3:
        return Err("usage: oven bakery repair-payload SHA256 FILE")
    readmit_payload(bakery()?, Path(arguments[2]), arguments[1]).map_err(store_failure)?
    forget_verified()
    println(f"re-admitted payload {arguments[1]}")
    return Ok(0)


def preserve_unit_damage(store: Path, identity: str, view: Snapshot) -> Result[bool, str]:
    """Preserve diagnosed physical or unit-codec damage; healthy or absent units cannot authorize repair."""
    key = record_key(identity)
    match store_lookup(view, key):
        Err(error) =>
            if error.kind != "integrity":
                return Err(error.message())
            quarantine_record(view, key).map_err(store_failure)?
            return Ok(true)
        Ok(found) =>
            match found:
                Lookup.Found(value) =>
                    match decode_fact(owned(value)):
                        None =>
                            quarantine_record(view, key, true).map_err(store_failure)?
                            return Ok(true)
                        Some(fact) =>
                            if fact.identity != identity:
                                quarantine_record(view, key, true).map_err(store_failure)?
                                return Ok(true)
                            mut damaged = false
                            for file in fact.files:
                                if not payload_current(store, file):
                                    quarantine_payload(store, file.digest).map_err(store_failure)?
                                    damaged = true
                            return Ok(damaged)
                Lookup.Deleted => return Ok(false)
                Lookup.Absent => return Ok(false)
