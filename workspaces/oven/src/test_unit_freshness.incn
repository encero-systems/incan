model Fixture:
    """A project with one dependency Loaf, one standard Loaf and a toolchain, all under one scratch directory."""

    unit: UnitDescription
    toolchain: Toolchain
    root: Path


model Pass:
    """One reconciliation of a unit: its key and the work it could not avoid."""

    key: str
    hashed: int
    listed: int


def write(path: Path, text: str) -> Result[None, str]:
    """Create or replace a file, making its directory first."""
    make_directory(path.parent())?
    return write_file(path, text)


def rewrite_in_place(path: Path, text: str) -> Result[None, str]:
    """Replace a file's bytes where they are with `text`, then put its modification time back as it was."""
    prefix = f"{path.0}: "
    stat = metadata(f"{path.0}").map_err((error) => f"{prefix}{error}")?
    before = stat.modified().map_err((error) => f"{prefix}{error}")?
    write_file(path, text)?
    mut options = OpenOptions.new()
    options.write(true)
    file = options.open(f"{path.0}").map_err((error) => f"{prefix}{error}")?
    file.set_modified(before).map_err((error) => f"{prefix}{error}")?
    return Ok(None)


def publish_loaf(directory: Path, name: str, text: str) -> Result[None, str]:
    """Write the complete artifact set of a Loaf."""
    for artifact in artifact_files(directory, name)?:
        mut content = f"{text} {artifact.name()}"
        if artifact.name().endswith(".incnlib"):
            content = JsonValue.object({"fixture": JsonValue.string(text)}).to_json().unwrap_or("{}")
        write(artifact, content)?
    return Ok(None)


def fixture(scratch: Path) -> Result[Fixture, str]:
    """Lay out `project/` with a manifest and one source, a dependency under its target, and the toolchain's files."""
    root = scratch.joinpath("project")
    write(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\n")?
    write(root.joinpath("src").joinpath("main.incn"), "def main() -> None:\n    println(\"one\")\n")?
    dependency = root.joinpath("target").joinpath("incan").joinpath("loaves").joinpath("dep").joinpath("debug")
    standard = scratch.joinpath("home").joinpath("loaves").joinpath("std").joinpath("debug")
    publish_loaf(dependency, "dep", "dependency")?
    publish_loaf(standard, "std", "standard")?
    write(scratch.joinpath("toolchain").joinpath("driver"), "driver one")?
    write(scratch.joinpath("toolchain").joinpath("libruntime.rlib"), "runtime one")?
    write(scratch.joinpath("toolchain").joinpath("std.rustabi"), "abi one")?
    toolchain = Toolchain(
        driver=scratch.joinpath("toolchain").joinpath("driver").0,
        sysroot="/rust/1.98.0-aarch64-apple-darwin",
        rust_abi=[scratch.joinpath("toolchain").joinpath("std.rustabi").0],
        externs=[NativeCrate(name="runtime", path=scratch.joinpath("toolchain").joinpath("libruntime.rlib").0)],
        search=[],
        registry_units="",
    )
    unit = UnitDescription(
        source=root.joinpath("src").joinpath("main.incn").0,
        project_root=root.0,
        source_root=root.joinpath("src").0,
        package="app",
        version="0.1.0",
        profile="debug",
        declared_features=[],
        active_features=[],
        loaves=[
            UnitLoaf(key="dep", name="dep", dir=dependency.0, standard=false),
            UnitLoaf(key="std", name="std", dir=standard.0, standard=true),
        ],
        rust_crates=[],
        contract_models=[],
        c_headers=[],
        externs=toolchain.externs,
        rust_abi=toolchain.rust_abi,
    )
    return Ok(Fixture(unit=unit, toolchain=toolchain, root=root))


def reconcile(scratch: Path, setup: Fixture) -> Result[Pass, str]:
    """Key the unit as a new process would: load its ledger, reconcile, save it. Settling is immediate."""
    mut project = load_ledger(scratch.joinpath("ledgers").joinpath("project.json"), 0)
    key = unit_key_with(setup.unit, compiler_fingerprint(setup.toolchain)?, description_digest(setup.unit)?, project)?.digest
    project.save()?
    return Ok(Pass(key=key, hashed=project.hashed, listed=project.listed))


pub def test_unchanged_unit_is_keyed_without_reading_or_listing() -> Result[None, str]:
    """Unchanged inputs reuse metadata, with native profile settings explicitly included in their identity."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    assert setup.unit.to_json().get("codegraph") == None
    mut requested = setup.unit
    requested.codegraph = true
    assert requested.to_json().get("codegraph") == None
    assert description_digest(requested)? == description_digest(setup.unit)?
    first = reconcile(scratch.path(), setup)?
    assert first.hashed > 0
    assert first.listed == 1
    second = reconcile(scratch.path(), setup)?
    assert second.key == first.key
    assert second.hashed == 0
    assert second.listed == 0
    assert "\"debug_info\":2" in json_text(setup.unit.to_json())?
    debug_description = description_digest(setup.unit)?
    mut release = setup.unit
    release.profile = "release"
    assert "\"debug_info\":0" in json_text(release.to_json())?
    assert description_digest(release)? != debug_description
    verify_checked_source_profiles(setup)?
    return Ok(None)


def verify_checked_source_profiles(setup: Fixture) -> Result[None, str]:
    """
    Check shared semantic identity and independent native policy in the existing freshness contract.

    1. Prepare equivalent dependency profiles with complete semantic and native evidence.
    2. Prove profile sharing, then invalidate features, source, interfaces and native bindings independently.
    3. Refuse dynamic vocabulary and unobserved C-header inputs.
    """
    # 1. Only native code bytes differ between the dependency's two profiles.
    mut debug = setup.unit
    debug.kind = "library"
    debug.search = [debug.loaves[0].dir]
    for loaf in debug.loaves:
        closure = Path(loaf.dir).joinpath(f"{loaf.name}.native.json")
        write(closure, "{\"externs\":[],\"macro_externs\":[],\"search\":[]}")?
    absent = retain_checked_source(debug, setup.toolchain)?
    for loaf in debug.loaves:
        write(Path(loaf.dir).joinpath(f"{loaf.name}.incngraph"), "one requested checked graph")?
    first = retain_checked_source(debug, setup.toolchain)?
    assert first.checked_key is not None
    assert first.checked_context is not None
    assert first.checked_key == absent.checked_key
    assert retain_checked_source(first, setup.toolchain)?.checked_key == first.checked_key
    mut release = debug
    release.profile = "release"
    mut providers: list[UnitLoaf] = []
    for loaf in release.loaves:
        directory = Path(loaf.dir).parent().joinpath("release")
        for name in [f"{loaf.name}.incnlib", f"{loaf.name}.incnbody", f"{loaf.name}.native.json"]:
            write(directory.joinpath(name), read(Path(loaf.dir).joinpath(name))?)?
        write(directory.joinpath(f"lib{loaf.name}.rlib"), "different native profile")?
        mut selected = loaf
        selected.dir = directory.0
        providers.append(selected)
    release.loaves = providers
    release.search = [release.loaves[0].dir, release.loaves[0].dir]
    # 2. Semantic equivalence does not authorize reusing profile-dependent native results.
    shared = retain_checked_source(release, setup.toolchain)?
    assert shared.checked_key == first.checked_key
    assert shared.checked_context == first.checked_context
    for loaf in release.loaves:
        write(Path(loaf.dir).joinpath(f"{loaf.name}.incngraph"), "a different requested graph")?
    assert retain_checked_source(release, setup.toolchain)?.checked_key == first.checked_key
    assert description_digest(debug)? != description_digest(release)?
    mut changed = release
    changed.active_features = ["other"]
    assert retain_checked_source(changed, setup.toolchain)?.checked_key != first.checked_key
    changed = release
    changed.declared_features = ["available"]
    assert retain_checked_source(changed, setup.toolchain)?.checked_key != first.checked_key
    source = Path(release.source)
    original = read(source)?
    write(source, original + "# a source edit\n")?
    assert retain_checked_source(release, setup.toolchain)?.checked_key != first.checked_key
    assert retain_checked_source(release, setup.toolchain)?.checked_context == first.checked_context
    write(source, original)?
    interface = Path(release.loaves[0].dir).joinpath("dep.incnbody")
    body = read(interface)?
    write(interface, body + "changed")?
    assert retain_checked_source(release, setup.toolchain)?.checked_key != first.checked_key
    assert retain_checked_source(release, setup.toolchain)?.checked_context != first.checked_context
    write(interface, body)?
    closure = Path(release.loaves[0].dir).joinpath("dep.native.json")
    original_closure = read(closure)?
    extra = JsonValue.array([JsonValue.string("native_alias"), JsonValue.string(release.externs[0].path)])
    for field in ["externs", "macro_externs"]:
        mut document = JsonValue.object(
            {"externs": JsonValue.array([]), "macro_externs": JsonValue.array([]), "search": JsonValue.array([])},
        )
        document.set(field, JsonValue.array([extra])).map_err((error) => error.message())?
        write(closure, json_text(document)?)?
        assert retain_checked_source(release, setup.toolchain)?.checked_key != first.checked_key
    write(closure, original_closure)?
    indirect = setup.root.joinpath("native-search").joinpath("libindirect.rlib")
    write(indirect, "first transitive artifact")?
    changed = release
    changed.search = [indirect.parent().0]
    indirect_before = retain_checked_source(changed, setup.toolchain)?
    write(indirect.parent().joinpath("build.log"), "nonsemantic observation output")?
    assert retain_checked_source(changed, setup.toolchain)?.checked_key == indirect_before.checked_key
    rewrite_in_place(indirect, "second transitive artifact")?
    assert retain_checked_source(changed, setup.toolchain)?.checked_key != indirect_before.checked_key
    native = Path(release.externs[0].path)
    artifact = read(native)?
    write(native, artifact + "changed")?
    assert retain_checked_source(release, setup.toolchain)?.checked_key != first.checked_key
    # 3. Unwitnessed dynamic inputs cannot enter a reusable checked-source artifact.
    changed = shared
    changed.vocabulary = true
    vocabulary = retain_checked_source(changed, setup.toolchain)?
    match vocabulary.checked_key:
        None => pass
        Some(_) =>
            assert false, "executable vocabulary authorized checked-source reuse"
    changed = shared
    changed.c_headers = ["include/header.h"]
    headers = retain_checked_source(changed, setup.toolchain)?
    match headers.checked_key:
        None => pass
        Some(_) =>
            assert false, "unobserved C headers authorized checked-source reuse"
    return Ok(None)


pub def test_source_edit_rekeys_and_hashes_only_what_changed() -> Result[None, str]:
    """
    Retain precise source keys and current executable behavior after edits.

    1. Rekey changed sources and directories, keeping equivalent rewritten bytes reusable.
    2. Invalidate changed manifests and test siblings.
    3. Replay only unchanged certified refusals and check reports.
    4. Compare a private body edit's executed result with an independent cold build.
    5. Verify real cold compiler work against its retained inventory.
    """
    # 1. Changed inputs cost only their own hash or directory listing.
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    write(Path(setup.unit.source), "def main() -> None:\n    println(\"edited\")\n")?
    edited = reconcile(scratch.path(), setup)?
    assert edited.key != first.key
    assert edited.hashed == 1
    assert edited.listed == 0
    write(setup.root.joinpath("src").joinpath("util.incn"), "pub def util() -> int:\n    return 1\n")?
    added = reconcile(scratch.path(), setup)?
    assert added.key != edited.key
    assert added.listed == 1
    # The same bytes written again change the metadata, which is a reason to recheck them and no reason to rebuild.
    write(Path(setup.unit.source), "def main() -> None:\n    println(\"edited\")\n")?
    rewritten = reconcile(scratch.path(), setup)?
    assert rewritten.key == added.key
    # 2. Configuration and siblings of an entry outside the source root belong in the key too.
    write(setup.root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.2.0\"\n")?
    manifest = reconcile(scratch.path(), setup)?
    assert manifest.key != rewritten.key
    mut test_unit = setup.unit
    test_unit.source = setup.root.joinpath("tests").joinpath("test_app.incn").0
    write(Path(test_unit.source), "def test_app() -> None:\n    assert true\n")?
    write(setup.root.joinpath("tests").joinpath("helpers.incn"), "pub def helper() -> int:\n    return 1\n")?
    testing = Fixture(unit=test_unit, toolchain=setup.toolchain, root=setup.root)
    before = reconcile(scratch.path(), testing)?
    write(setup.root.joinpath("tests").joinpath("helpers.incn"), "pub def helper() -> int:\n    return 2\n")?
    helper = reconcile(scratch.path(), testing)?
    assert helper.key != before.key
    # 3. Cached failures and check reports obey the same source freshness rules.
    verify_refusal_replay(scratch.path().joinpath("refusals"))?
    verify_check_replay(scratch.path().joinpath("checks"))?
    # 4. A current key must produce current behavior, including through an unchanged caller.
    verify_private_body_execution(scratch.path().joinpath("execution"))?
    # 5. A private fresh project has four source frames, regardless of linked retained bodies.
    verify_work_observations(scratch.path().joinpath("work"))?
    verify_callable_item_products(scratch.path().joinpath("items"))?
    return Ok(None)


def verify_work_observations(project: Path) -> Result[None, str]:
    """
    Require actual frontend and native work observations from a fresh four-function project.

    1. Prepare the ordinary exact inputs and compiler arguments.
    2. Request diagnostics only on this child, preserving the parent's environment.
    3. Check real source work, independently of loaded dependency inventories.
    """
    # 1. The normal description and preparation own the native closure and profile flags.
    toolchain = load_toolchain()?
    write_body_project(project, "def private_value() -> int:\n    return 7\n")?
    unit = describe(project.joinpath("src/main.incn"), "release", FeatureRequest(), selected_toolchain=Some(toolchain))?
    ready = prepare_native(unit, toolchain)?
    compiled = crate_name(ready)
    path = write_unit(ready, compiled)?
    binary = project.joinpath("observed")
    trace = project.joinpath("trace")
    arguments = ["--unit", path.0, compiled, binary.0, toolchain.sysroot] + driver_arguments(ready.profile)
    # 2. Direct capture observes the compiler; executable reuse cannot manufacture these diagnostics.
    mut command = driver_command(toolchain)?
    command.env("INCAN_NATIVE_TIMING", "1")
    command.env("INCAN_TRACE_DIR", trace.0)
    for argument in arguments:
        command.arg(argument)
    output = command.output().map_err((error) => f"cannot observe compiler work: {error}")?
    diagnostics = decoded(output.stderr)
    assert output.status.success(), diagnostics
    # 3. Every source declaration and frame executes once; retained dependency bodies do not count as built.
    counts = checked_work_counts(trace)?
    for key in ["checking/declaration", "checking/body", "body_ir/built"]:
        assert key in counts, f"missing {key} observations"
        assert counts[key] == 4, f"expected four {key} executions, got {counts[key]}"
    assert "redo-item: lowering\t" in diagnostics, diagnostics
    assert "redo-codegen: " in diagnostics, diagnostics
    verify_observed_library_bytes(ready, toolchain, project)?
    return Ok(None)


def verify_observed_library_bytes(unit: UnitDescription, toolchain: Toolchain, project: Path) -> Result[None, str]:
    """Require diagnostics to preserve a library's bytes with identical compiler inputs and output paths."""
    mut library = unit
    library.kind = "library"
    compiled = crate_name(library)
    path = write_unit(library, compiled)?
    artifact = project.joinpath(f"lib{compiled}.rlib")
    arguments = ["--unit", path.0, compiled, artifact.0, toolchain.sysroot] + driver_arguments(library.profile)
    mut baseline: bytes = b""
    for observed in [false, true]:
        mut command = driver_command(toolchain)?
        command.env_remove("INCAN_NATIVE_TIMING")
        command.env_remove("INCAN_TRACE_DIR")
        if observed:
            command.env("INCAN_NATIVE_TIMING", "1")
        for argument in arguments:
            command.arg(argument)
        output = command.output().map_err((error) => f"cannot compare observed library: {error}")?
        assert output.status.success(), decoded(output.stderr)
        produced = artifact.read_bytes().map_err((error) => error.message())?
        if observed:
            assert produced == baseline, "diagnostic observation changed native library bytes"
        else:
            baseline = produced
    return Ok(None)


def verify_callable_item_products(project: Path) -> Result[None, str]:
    """
    Require real checked-body, Body IR and native function hits after a private scalar implementation changes.

    1. Compile an ordinary library with three private scalar helpers and one public caller.
    2. Edit one helper and require one source check, one Body IR build and three fewer native lowerings.
    3. Compare every library product with a cold compilation using identical material compiler arguments.
    4. Corrupt private products, require full work and compare against a cold build again.
    5. Execute an ordinary consumer and require the edited result.
    """
    # 1. The unchanged caller retains the complete checked signatures it reads from this source-only module.
    toolchain = load_toolchain()?
    source = project.joinpath("src/lib.incn")
    write(project.joinpath("loaf.toml"), "[project]\nname='scalar_item_products'\nversion='0.1.0'\n")?
    original = "\n\n".join(
        [
            "def first() -> int:\n    return 1",
            "def second() -> int:\n    return 2",
            "def third() -> int:\n    return 3",
            "pub def answer() -> int:\n    return first() + second() + third()",
        ],
    ) + "\n"
    write(source, original)?
    mut unit = describe(source, "release", FeatureRequest(), selected_toolchain=Some(toolchain))?
    unit.kind = "library"
    unit = prepare_native(unit, toolchain)?
    initial = retain_checked_source(unit, toolchain)?
    cold_counts, cold_native, _before = observe_item_library(initial, toolchain, project, "initial")?
    assert cold_counts["checking/declaration"] == 4, f"cold source checks: {cold_counts}"
    assert cold_counts["body_ir/built"] == 4, f"cold source Body IR: {cold_counts}"
    # 2. The source coordinates and signatures remain fixed; only one private implementation changes.
    write(source, original.replace("return 1", "return 9"))?
    edited = retain_checked_source(unit, toolchain)?
    assert initial.checked_context is not None, "ordinary scalar library has no checked context"
    assert edited.checked_context == initial.checked_context, "a private body edit changed the semantic context"
    # The installed interop vocabulary can refuse whole-source snapshots while authored item products remain safe.
    counts, native, products = observe_item_library(edited, toolchain, project, "edited")?
    assert counts["checking/declaration"] == 1, f"unexpected item checking work: {counts}"
    assert counts["body_ir/built"] == 1, f"unexpected item Body IR work: {counts}"
    assert native == cold_native - 3, f"native function products did not reuse three frames: {cold_native} -> {native}"
    # 3. Cache placement and permission are the only differences from a full compilation of the edited source.
    mut independent = edited
    independent.checked_context = None
    independent.checked_artifact = None
    independent.checked_key = None
    independent.checked_products = None
    full_counts, full_native, cold_products = observe_item_library(independent, toolchain, project, "cold-edited")?
    assert full_counts["checking/declaration"] == 4, f"cold edited source checks: {full_counts}"
    assert full_counts["body_ir/built"] == 4, f"cold edited source Body IR: {full_counts}"
    assert full_native == cold_native, f"cold native work changed: {full_native} vs {cold_native}"
    assert products == cold_products, "item replay changed a native or governed library product"
    # 4. Both checked-body and native product damage are misses, never acceptance or native-code authority.
    corrupt_item_products(edited)?
    write(source, original.replace("return 1", "return 8"))?
    damaged = retain_checked_source(unit, toolchain)?
    damaged_counts, damaged_native, damaged_products = observe_item_library(damaged, toolchain, project, "damaged")?
    assert damaged_counts["checking/declaration"] == 4, f"damaged source products were reused: {damaged_counts}"
    assert damaged_counts["body_ir/built"] == 4, f"damaged Body IR products were reused: {damaged_counts}"
    assert damaged_native == cold_native, f"damaged native products were reused: {damaged_native}"
    _counts, _native, damaged_cold = observe_item_library(independent, toolchain, project, "cold-damaged")?
    assert damaged_products == damaged_cold, "damaged private products changed a compiled library"
    write(source, original.replace("return 1", "return 9"))?
    # 5. An unchanged public caller must observe the new private implementation through the compiled Loaf.
    consumer = project.joinpath("consumer")
    manifest = "\n".join(
        [
            "[project]",
            "name='scalar_item_consumer'",
            "version='0.1.0'",
            "[project.scripts]",
            "main='src/main.incn'",
            "[dependencies]",
            "values={path='..'}",
        ],
    ) + "\n"
    write(consumer.joinpath("loaf.toml"), manifest)?
    write(
        consumer.joinpath("src/main.incn"),
        "from pub::values import answer\n\ndef main() -> None:\n    println(answer())\n",
    )?
    actual = body_program_output(consumer, toolchain)?
    assert actual == "14\n", f"edited scalar consumer: {actual}"
    return Ok(None)


def corrupt_item_products(unit: UnitDescription) -> Result[None, str]:
    """Damage only this test producer's private checked and native product files, retaining complete artifacts."""
    if let Some(root) = unit.checked_products:
        for directory in [Path(root), Path(root).joinpath(unit.profile)]:
            for path in directory.iterdir().map_err((error) => error.message())?:
                if path.name().endswith(".incnitems") or path.name().endswith(".incnfunction"):
                    write(path, "damaged private product")?
        return Ok(None)
    return Err("item test has no private product directory")


def observe_item_library(
    unit: UnitDescription,
    toolchain: Toolchain,
    project: Path,
    label: str,
) -> Result[tuple[Dict[str, int], int, list[bytes]], str]:
    """
    Observe one real library compile with the same output paths across source generations.

    1. Invoke the ordinary driver with private child-local work observations.
    2. Retain actual phase counts and every material library product.
    """
    # 1. This direct invocation bypasses executable reuse while preserving ordinary compiler inputs.
    compiled = crate_name(unit)
    path = write_unit(unit, compiled)?
    artifact = project.joinpath(f"lib{compiled}.rlib")
    trace = project.joinpath(f"trace-{label}")
    mut command = driver_command(toolchain)?
    command.env("INCAN_NATIVE_TIMING", "1")
    command.env("INCAN_TRACE_DIR", trace.0)
    arguments = ["--unit", path.0, compiled, artifact.0, toolchain.sysroot] + driver_arguments(unit.profile)
    for argument in arguments:
        command.arg(argument)
    output = command.output().map_err((error) => f"cannot observe item products: {error}")?
    diagnostics = decoded(output.stderr)
    assert output.status.success(), diagnostics
    # 2. Native lowering counts include linked frames; only two covered source frames should disappear.
    mut native = 0
    for line in diagnostics.split("\n"):
        if line.startswith("redo-item: lowering\t"):
            native += 1
    mut products: list[bytes] = []
    for name in [artifact.name(), f"{unit.package}.incnlib", f"{unit.package}.incnbody"]:
        products.append(project.joinpath(name).read_bytes().map_err((error) => error.message())?)
    return Ok((checked_work_counts(trace)?, native, products))


def checked_work_counts(directory: Path) -> Result[Dict[str, int], str]:
    """Count actual producer events from the private child's complete structured trace files."""
    mut counts: Dict[str, int] = {}
    for file in directory.iterdir().map_err((error) => error.message())?:
        for line in read(file)?.split("\n"):
            if line == "":
                continue
            record = parse_json(line)?
            if let Some(fields) = record.get("fields"):
                if work_text(fields, "message") == "compiler work":
                    key = work_text(fields, "phase") + "/" + work_text(fields, "action")
                    if key not in counts:
                        counts[key] = 0
                    counts[key] += 1
    return Ok(counts)


def work_text(fields: JsonValue, name: str) -> str:
    """Read one optional diagnostic string without treating a missing or differently typed value as evidence."""
    if let Some(value) = fields.get(name):
        if let Some(text) = value.as_str():
            return text
    return ""


def verify_private_body_execution(scratch: Path) -> Result[None, str]:
    """
    Compare warm and cold executable behavior after a private function body changes without changing its signature.

    1. Build a three-module program and reuse its unchanged executable.
    2. Edit one private body, shifting a later declaration, and require its callers to observe the new result.
    3. Compare with an independent cold project, then restore the original body and behavior.
    """
    toolchain = load_toolchain()?
    warm = scratch.joinpath("warm")
    cold = scratch.joinpath("cold")
    original = "def private_value() -> int:\n    return 7\n"
    edited = "def private_value() -> int:\n    answer = 40\n    return answer + 1\n"
    # 1. The stable sibling and the public caller are unchanged throughout the edit sequence.
    write_body_project(warm, original)?
    assert body_program_output(warm, toolchain)? == "10\n"
    binary = warm.joinpath("target/body-probe")
    before = artifact_identity(binary)?
    assert body_program_output(warm, toolchain)? == "10\n"
    assert artifact_identity(binary)? == before
    # 2. The private declaration's signature stays the same; its body and the caller's coordinates change.
    write_body_module(warm, edited)?
    actual = body_program_output(warm, toolchain)?
    assert actual == "44\n", actual
    # 3. A fresh project has no retained unit, checked module or function plan to replay.
    write_body_project(cold, edited)?
    assert body_program_output(cold, toolchain)? == actual
    write_body_module(warm, original)?
    assert body_program_output(warm, toolchain)? == "10\n"
    return Ok(None)


def write_body_project(project: Path, body: str) -> Result[None, str]:
    """Create one program whose private helper is reached through an unchanged public caller and sibling module."""
    manifest = "[project]\nname='body_reuse'\nversion='0.1.0'\n[project.scripts]\nmain='src/main.incn'\n"
    write(project.joinpath("loaf.toml"), manifest)?
    imports = "from values import read_value\nfrom stable import stable_value\n\n\n"
    main = "def main() -> None:\n    println(read_value() + stable_value())\n"
    write(project.joinpath("src/main.incn"), imports + main)?
    write(project.joinpath("src/stable.incn"), "pub def stable_value() -> int:\n    return 3\n")?
    return write_body_module(project, body)


def write_body_module(project: Path, body: str) -> Result[None, str]:
    """Replace the private implementation while preserving the exact public caller's source text."""
    caller = "\n\npub def read_value() -> int:\n    return private_value()\n"
    return write(project.joinpath("src/values.incn"), body + caller)


def body_program_output(project: Path, toolchain: Toolchain) -> Result[str, str]:
    """Build through the ordinary described-unit producer and return the successfully executed program's stdout."""
    source = project.joinpath("src/main.incn")
    unit = describe(source, "debug", FeatureRequest(), selected_toolchain=Some(toolchain))?
    binary = project.joinpath("target/body-probe")
    code = compile_unit(unit, toolchain, binary)?
    assert code == 0, f"body-edit program failed to compile: {code}"
    mut command = Command.new(binary.0)
    output = command.output().map_err((error) => f"cannot run {binary.0}: {error}")?
    assert output.status.success(), decoded(output.stderr)
    return Ok(decoded(output.stdout))


def verify_refusal_replay(scratch: Path) -> Result[None, str]:
    """
    Exercise certified replay, edited input, malformed storage and abnormal failures with a counted compiler that
    cannot start a worker, so every compilation is one process. Its receipt path arrives as `--certify PATH` right
    after the sysroot, as the worker would receive it.

    1. Replay an unchanged refusal with exact binary streams.
    2. Recompile edited sources and malformed records.
    3. Retry crashes, signals, I/O failures and success without artifacts.
    """
    setup = fixture(scratch)?
    driver = Path(setup.toolchain.driver)
    attempts = scratch.joinpath("attempts")
    source = Path(setup.unit.source)
    cache = scratch.joinpath("refusal.json")
    mut script = "#!/bin/sh\n[ \"$1\" = --resident ] && exit 1\n"
    script += "[ \"$6\" = --certify ] && [ \"$8\" = --library ] || exit 2\n"
    script += f"printf x >> '{attempts.0}'\nmode=$(cat '{source.0}')\n"
    script += "case \"$mode\" in\nio) printf 'I/O failure' >&2; exit 1;;\nmissing) exit 0;;\nesac\n"
    script += "printf 'incan.compiler-refusal/1\\n' > \"$7\"\n"
    script += "printf '\\377out'; printf 'named refusal\\000tail' >&2\n"
    script += "case \"$mode\" in\ncrash) exit 101;;\nsignal) kill -TERM $$;;\nesac\nexit 1\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    invocation = ["--unit", "unit.json", "app", "app.rlib", setup.toolchain.sysroot]
    options = ["--library"]
    # 1. Replay an unchanged refusal with exact binary streams.
    write(source, "refuse")?
    key = unit_key(setup.unit, setup.toolchain)?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, key, "test")? == 1
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, key, "test")? == 1
    retained = cache.read_bytes().map_err((error) => error.message())?
    expected = b"\xffoutnamed refusal\x00tail"
    assert retained[len(retained) - len(expected):] == expected
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    mut capturing = setup.toolchain
    capturing.console = scratch.joinpath("console").0
    assert compile_or_replay(setup.unit, capturing, invocation, options, cache, key, "test")? == 1
    assert compile_or_replay(setup.unit, capturing, invocation, options, cache, key, "test")? == 1
    output = Path(f"{capturing.console}.out").read_bytes().map_err((error) => error.message())?
    error = Path(f"{capturing.console}.err").read_bytes().map_err((error) => error.message())?
    assert output == b"\xffout\xffout"
    assert error == b"named refusal\x00tailnamed refusal\x00tail"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    # 2. Recompile edited sources and malformed records.
    write(source, "refuse edited")?
    edited = unit_key(setup.unit, setup.toolchain)?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xx"
    write(cache, "incomplete document")?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xxx"
    framed = cache.read_bytes().map_err((error) => error.message())?
    cache.write_bytes(framed[:len(framed) - 1]).map_err((error) => error.message())?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xxxx"
    # 3. Retry crashes, signals, I/O failures and success without artifacts.
    for mode in ["crash", "signal", "io", "missing"]:
        write(source, mode)?
        changed = unit_key(setup.unit, setup.toolchain)?
        before = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
        first_status = compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, changed, "test")?
        second_status = compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, changed, "test")?
        assert first_status == second_status
        after = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
        assert after == before + "xx", mode
    write(source, "refuse with missing artifact")?
    linked = artifact_files(Path(setup.unit.loaves[0].dir), "dep")?
    linked[0].unlink().map_err((error) => error.message())?
    incomplete = unit_key(setup.unit, setup.toolchain)?
    before_missing = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, incomplete, "test")? == 1
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, incomplete, "test")? == 1
    after_missing = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
    assert after_missing == before_missing + "xx"
    return Ok(None)


def verify_check_replay(scratch: Path) -> Result[None, str]:
    """
    Exercise check replay with a counted compiler that cannot start a worker, so every check is one process.

    1. Replay an unchanged pass and an unchanged refusal with exact binary streams and status.
    2. Check again for another report format and after an edit.
    3. Check again after crashes, signals, uncertified failures and statuses no report has.
    """
    setup = fixture(scratch)?
    driver = Path(setup.toolchain.driver)
    attempts = scratch.joinpath("attempts")
    source = Path(setup.unit.source)
    record = scratch.joinpath("main.text.oven-check")
    mut script = "#!/bin/sh\n[ \"$1\" = --resident ] && exit 1\n"
    script += f"printf x >> '{attempts.0}'\nmode=$(cat '{source.0}')\nprevious=''\n"
    script += "for argument in \"$@\"; do\n[ \"$previous\" = --certify ] && receipt=$argument\n"
    script += "previous=$argument\ndone\n"
    script += "case \"$mode\" in\nio) printf 'I/O failure' >&2; exit 1;;\nstatus) exit 2;;\nesac\n"
    script += "printf 'incan.compiler-check/1\\n' > \"$receipt\"\nprintf '\\377report'; printf 'warning\\000tail' >&2\n"
    script += "case \"$mode\" in\ncrash) exit 101;;\nsignal) kill -TERM $$;;\nrefuse*) exit 1;;\nesac\nexit 0\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    text = ["--check", "unit.json", setup.toolchain.sysroot, "--format", "text"]
    # 1. Replay an unchanged pass and an unchanged refusal with exact binary streams and status.
    write(source, "pass")?
    passing = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, passing)? == 0
    assert check_or_replay(setup.unit, setup.toolchain, text, record, passing)? == 0
    write(source, "refuse")?
    refused = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, refused)? == 1
    assert check_or_replay(setup.unit, setup.toolchain, text, record, refused)? == 1
    mut expected = "xx"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected
    mut capturing = setup.toolchain
    capturing.console = scratch.joinpath("console").0
    assert check_or_replay(setup.unit, capturing, text, record, refused)? == 1
    assert Path(f"{capturing.console}.out").read_bytes().map_err((error) => error.message())? == b"\xffreport"
    assert Path(f"{capturing.console}.err").read_bytes().map_err((error) => error.message())? == b"warning\x00tail"
    # 2. Check again for another report format and after an edit.
    json = ["--check", "unit.json", setup.toolchain.sysroot, "--format", "json"]
    assert check_or_replay(setup.unit, setup.toolchain, json, record, refused)? == 1
    write(source, "refuse edited")?
    edited = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, edited)? == 1
    assert check_or_replay(setup.unit, setup.toolchain, text, record, edited)? == 1
    expected += "xx"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected
    # 3. Check again after crashes, signals, uncertified failures and statuses no report has.
    for mode in ["crash", "signal", "io", "status"]:
        write(source, mode)?
        changed = unit_key(setup.unit, setup.toolchain)?
        first_status = check_or_replay(setup.unit, setup.toolchain, text, record, changed)?
        assert check_or_replay(setup.unit, setup.toolchain, text, record, changed)? == first_status
        expected += "xx"
        assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected, mode
    return Ok(None)


pub def test_dependency_artifacts_rekey_their_consumers() -> Result[None, str]:
    """Dependency rebuilds rekey consumers; exact relocated native artifacts and fresh ABI publication stay valid."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    verify_closure_readings(scratch.path().joinpath("closure.json"))?
    # Inspection publications are independent of executable freshness, including first materialization and corruption.
    graph = Path(setup.unit.loaves[0].dir).joinpath("dep.incngraph")
    for contents in ["a requested graph", "a replaced inspection graph"]:
        write(graph, contents)?
        assert reconcile(scratch.path(), setup)?.key == first.key
    dependency = artifact_files(Path(setup.unit.loaves[0].dir), "dep")?
    write(dependency[0], "dependency rebuilt with different code")?
    rebuilt = reconcile(scratch.path(), setup)?
    assert rebuilt.key != first.key
    assert rebuilt.hashed == 0
    standard_artifacts = artifact_files(Path(setup.unit.loaves[1].dir), "std")?
    write(standard_artifacts[1], "{\"fixture\":\"standard package recompiled\"}")?
    recompiled = reconcile(scratch.path(), setup)?
    assert recompiled.key != rebuilt.key
    # A manifest that declares a vocabulary worker adds it to the artifact set; rewritten without one, it does not.
    standard = Path(setup.unit.loaves[1].dir)
    manifest = standard.joinpath("std.incnlib")
    write(manifest, "{\"vocab\": {\"desugarer_artifact\": {\"artifact_kind\": \"NativeWorker\"}}}")?
    assert "vocab-worker" in [artifact.name() for artifact in artifact_files(standard, "std")?]
    write(manifest, "{}")?
    assert "vocab-worker" not in [artifact.name() for artifact in artifact_files(standard, "std")?]
    write(manifest, "malformed manifest")?
    match artifact_files(standard, "std"):
        Ok(_) =>
            assert false, "a malformed manifest cannot authorize an incomplete artifact set"
        Err(_) => pass
    verify_completed_library_abi(scratch.path().joinpath("publication"))?
    verify_native_alias_artifacts(scratch.path().joinpath("aliases"))?
    verify_requested_loaf_roots(scratch.path().joinpath("requested-roots"))?
    return Ok(None)


def verify_requested_loaf_roots(scratch: Path) -> Result[None, str]:
    """Requested native roots keep their offered identity; unrelated published bindings do not become graph anchors."""
    setup = fixture(scratch)?
    mut unit = setup.unit
    unit.loaves = [unit.loaves[0]]
    directory = Path(unit.loaves[0].dir)
    closure = directory.joinpath("dep.native.json")
    write(closure, "{\"externs\":[[\"wanted\",\"libwanted.rlib\"],[\"private\",\"libprivate.rlib\"]]}")?
    assert published_bindings(unit, setup.toolchain, ["wanted"])? == [directory.joinpath("libwanted.rlib").0]
    assert published_bindings(unit, setup.toolchain, ["other"])? == []
    return Ok(None)


def verify_native_alias_artifacts(scratch: Path) -> Result[None, str]:
    """Retain one alias for byte-identical relocated artifacts, refusing different or unreadable candidates."""
    setup = fixture(scratch)?
    selected = setup.toolchain.externs[0]
    assert len(add_extern(setup.unit, selected)?.externs) == 1
    copy = scratch.joinpath("relocated.rlib")
    write(copy, read(Path(selected.path))?)?
    candidate = NativeCrate(name=selected.name, path=copy.0)
    retained = add_extern(setup.unit, candidate)?
    assert len(retained.externs) == 1
    assert retained.externs[0].path == selected.path
    write(copy, "different runtime")?
    match add_extern(setup.unit, candidate):
        Ok(_) =>
            assert false, "a shared alias cannot select different artifact bytes"
        Err(reason) =>
            assert "names conflicting artifacts" in reason
    remove(copy)?
    match add_extern(setup.unit, candidate):
        Ok(_) =>
            assert false, "a missing candidate cannot prove artifact identity"
        Err(reason) =>
            assert copy.0 in reason
    return Ok(None)


def verify_completed_library_abi(scratch: Path) -> Result[None, str]:
    """
    Reuse complete libraries, rebuild edited or damaged ones, and preserve publication across failed replacements.

    1. Count a compiler that cannot start a worker and publishes the complete library artifact set, including a new
       ABI cache.
    2. Compile the prepared library twice without changing its inputs.
    3. Require one invocation, then invalidate source and outputs without losing the previous build on failure.
    """
    # 1. The optional cache appears only after the first compiler invocation.
    setup = fixture(scratch)?
    attempts = scratch.joinpath("attempts")
    mode = scratch.joinpath("mode")
    write(mode, "complete")?
    driver = Path(setup.toolchain.driver)
    mut script = "#!/bin/sh\nset -eu\n[ \"$1\" = --resident ] && exit 1\n" + f"printf x >> '{attempts.0}'\n"
    script += "directory=${4%/*}\nmkdir -p \"$directory\"\n"
    script += f"mode=$(cat '{mode.0}')\n[ \"$mode\" != fail ] || exit 7\n"
    script += "for name in libapp.rlib app.incnlib app.incnbody app.native.json app.incngraph app.rustabi; do\n"
    script += "printf published > \"$directory/$name\"\ndone\n"
    script += "printf '{}' > \"$directory/app.incnlib\"\n"
    script += "[ \"$mode\" != incomplete ] || rm \"$directory/app.incnbody\"\n"
    script += "if [ \"$mode\" = without-abi ]; then rm \"$directory/app.rustabi\"; fi\n"
    script += "exit 0\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    # 2. The completed stamp must include the cache that publication added.
    mut library = setup.unit
    library.kind = "library"
    output = setup.root.joinpath("target").joinpath("published").joinpath("libapp.rlib")
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    # 3. A missing cache or an incomplete stamp cannot pass by recompiling silently.
    assert read(attempts)? == "x"
    assert output.parent().joinpath("app.rustabi").is_file()
    before = artifact_identity(output)?
    stamp = output.parent().joinpath(".oven-inputs.sha256")
    witnessed = read(stamp)?
    write(Path(library.source), "def main() -> None:\n    println(\"edited\")\n")?
    write(mode, "fail")?
    assert compile_library_unit(library, setup.toolchain, output)? == 7
    assert artifact_identity(output)? == before
    assert read(stamp)? == witnessed
    write(mode, "incomplete")?
    match compile_library_unit(library, setup.toolchain, output):
        Ok(_) =>
            assert false, "an incomplete build cannot replace a published library"
        Err(reason) =>
            assert "compiler did not publish" in reason
    assert artifact_identity(output)? == before
    assert read(stamp)? == witnessed
    write(mode, "without-abi")?
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    assert artifact_identity(output)? != before
    assert not output.parent().joinpath("app.rustabi").is_file()
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    assert read(attempts)? == "xxxx"
    # A missing output or a rewritten output invalidates its otherwise unchanged input proof.
    remove(output.parent().joinpath("app.incnbody"))?
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    write(output, "damaged")?
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    assert read(attempts)? == "xxxxxx"
    assert read(output)? == "published"
    return Ok(None)


pub def test_toolchain_change_rekeys_every_unit() -> Result[None, str]:
    """Compiler, native, ABI, recorded producer selection and target changes each invalidate a unit's generation."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = compiler_fingerprint(setup.toolchain)?
    mut pinned = setup.unit
    pinned.selected_toolchain = Some(setup.toolchain)
    assert json_text(pinned.to_json())? == json_text(setup.unit.to_json())?
    assert compiler_fingerprint(setup.toolchain)? == first
    write(Path(setup.toolchain.driver), "driver two, a longer compiler")?
    driver = compiler_fingerprint(setup.toolchain)?
    assert driver != first
    write(Path(setup.toolchain.externs[0].path), "runtime two, another interface")?
    runtime = compiler_fingerprint(setup.toolchain)?
    assert runtime != driver
    write(Path(setup.toolchain.rust_abi[0]), "abi two, other facts")?
    abi = compiler_fingerprint(setup.toolchain)?
    assert abi != runtime
    mut recorded = setup.toolchain
    lock = scratch.path().joinpath("selected.json")
    write(lock, "first producer closure")?
    recorded.registry_lock = lock.0
    selected = compiler_fingerprint(recorded)?
    assert selected != abi
    write(lock, "other producer closure")?
    assert compiler_fingerprint(recorded)? != selected
    mut moved = setup.toolchain
    moved.sysroot = "/rust/1.98.0-x86_64-unknown-linux-gnu"
    assert compiler_fingerprint(moved)? != abi
    # Rewriting the driver in place with the same length and putting its modification time back is still a change.
    rewrite_in_place(Path(setup.toolchain.driver), "driver 2.., a longer compiler")?
    assert compiler_fingerprint(setup.toolchain)? != driver
    # A unit that links the replaced native crate is keyed differently too.
    before = reconcile(scratch.path(), setup)?
    write(Path(setup.toolchain.externs[0].path), "runtime three, once more different")?
    assert reconcile(scratch.path(), setup)?.key != before.key
    return Ok(None)


pub def test_stored_executable_is_never_half_written() -> Result[None, str]:
    """Reuse needs a stamp for the key and the outputs it recorded; every interruption leaves a rebuild, not a mix."""
    scratch = scratch_directory()?
    bin = scratch.path().joinpath("bin")
    output = bin.joinpath("app")
    stamp = bin.joinpath("app.oven-inputs")
    staged = bin.joinpath("app-4242")
    one = Key(digest="key one", parts=["compiler c", "sources one"])
    two = Key(digest="key two", parts=["compiler c", "sources two"])
    three = Key(digest="key three", parts=["compiler c", "sources three"])
    write(staged, "first build")?
    # A build that was interrupted before installing leaves only its staged file.
    assert not reusable([output], stamp, one)?
    install_executable(staged, output, "program", stamp, one)?
    assert reusable([output], stamp, one)?
    assert not reusable([output], stamp, two)?
    stale = staleness([output], stamp, two)?
    assert stale == "sources changed", stale
    assert not staged.is_file()
    # A replacement in flight does not disturb the installed pair.
    write(staged, "second build, still being linked")?
    assert reusable([output], stamp, one)?
    assert read(output)? == "first build"
    # An installation that fails after the old stamp is withdrawn leaves no stamp to vouch for the old outputs.
    remove(staged)?
    match install_executable(staged, output, "program", stamp, two):
        Ok(_) =>
            assert false, "installing a missing build succeeded"
        Err(_) => pass
    assert not reusable([output], stamp, one)?
    assert not reusable([output], stamp, two)?
    assert staleness([output], stamp, two)? == "no stored build"
    # An output replaced behind the stamp's back is not the output it recorded.
    write(staged, "third build")?
    install_executable(staged, output, "program", stamp, three)?
    assert reusable([output], stamp, three)?
    write(output, "someone else's binary")?
    assert not reusable([output], stamp, three)?
    # A test unit's report is installed and vouched for with its executable; without the report nothing is reused.
    tests = scratch.path().joinpath("tests")
    write(tests.joinpath("app-77"), "test executable")?
    write(test_report(tests.joinpath("app-77")), "[]")?
    install_executable(tests.joinpath("app-77"), tests.joinpath("app"), "test", tests.joinpath("app.oven-inputs"), one)?
    outputs = executable_outputs("test", tests.joinpath("app"))
    assert reusable(outputs, tests.joinpath("app.oven-inputs"), one)?
    remove(test_report(tests.joinpath("app")))?
    assert not reusable(outputs, tests.joinpath("app.oven-inputs"), one)?
    # Rust libraries retain rustc's file dependencies, including escaped paths outside the source directory.
    setup = fixture(scratch.path())?
    native = scratch.path().joinpath("native")
    dependencies = native.joinpath("library.d")
    included = scratch.path().joinpath("included value.txt")
    write(included, "first included value")?
    escaped = included.0.replace(" ", "\\ ")
    write(dependencies, f"library: {escaped}\n\n# env-dep:CARGO_PKG_NAME=old\n")?
    arguments = ["--extern", f"runtime={setup.toolchain.externs[0].path}"]
    environment = {"CARGO_PKG_NAME": "app"}
    first = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    retained = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    assert retained.digest == first.digest
    observations = compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain)?
    assert inputs_unchanged(dependencies, observations)?
    write(included, "changed included value")?
    changed = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    assert changed.digest != first.digest
    assert not inputs_unchanged(dependencies, observations)?
    write(included, "first included value")?
    changed_environment = library_key(
        setup.root,
        native,
        dependencies,
        arguments,
        {"CARGO_PKG_NAME": "other"},
        [],
        setup.toolchain,
    )?
    assert changed_environment.digest != first.digest
    # A late source or native-artifact write invalidates publication even after a key was computed.
    stable = compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain)?
    _ = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    write(Path(setup.toolchain.externs[0].path), "changed while compiling")?
    assert not inputs_unchanged(dependencies, stable)?
    Path(setup.toolchain.externs[0].path).unlink().map_err((error) => error.message())?
    match compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain):
        Err(_) => pass
        Ok(_) =>
            assert false, "missing linked artifacts cannot supply compilation observations"
    return Ok(None)


pub def test_rust_unit_key_follows_its_crate_manifest_how_it_is_built_and_what_it_links() -> Result[None, str]:
    """
    A Rust unit is keyed like an Incan one: every file of its crate, its manifest, its arguments, the compiler and
    the libraries it links; unchanged, it is keyed from metadata alone.
    """
    facet = LocalFacet(
        project="root",
        domain=DependencyDomain.Target,
        features=[],
        local=[],
        registry=[],
        registry_aliases=[],
    )
    request = RustBuild(project="root", rustc="rustc", registry=RegistryUnits(units=[], search=[]))
    unrelated = BuiltUnit(crate_name="other", artifact="/other/library.rlib", directory="/other")
    assert linking(facet, request, {}, [])? == linking(facet, request, {"other": unrelated}, ["/other"])?
    scratch = scratch_directory()?
    setup = rust_crate(scratch.path())?
    sources = setup.facet.joinpath("rust").joinpath("src")
    # Unchanged, the key is the same and costs no hashing or listing.
    first = rust_pass(setup, "compiler", "std")?
    second = rust_pass(setup, "compiler", "std")?
    assert first.key == second.key
    assert second.hashed + second.listed == 0
    # Each input of the key changes it: a source, a data file, a new module, the manifest, the cfg, the compiler and
    # a linked library.
    write(sources.joinpath("json.rs"), "pub fn parse() { let _ = 1; }\n")?
    edited = rust_pass(setup, "compiler", "std")?.key
    assert edited != first.key
    write(sources.joinpath("table.json"), "{\"a\": 1}")?
    data = rust_pass(setup, "compiler", "std")?.key
    assert data != edited
    write(sources.joinpath("extra.rs"), "")?
    added = rust_pass(setup, "compiler", "std")?.key
    assert added != data
    write(setup.facet.joinpath("loaf.toml"), "[project]\nname = \"data\"\nversion = \"0.2.0\"\n")?
    manifest = rust_pass(setup, "compiler", "std")?.key
    assert manifest != added
    features = rust_pass(setup, "compiler", "alloc")?.key
    assert features != manifest
    compiler = rust_pass(setup, "another compiler", "alloc")?.key
    assert compiler != features
    write(setup.dependency, "core two, rebuilt")?
    linked = rust_pass(setup, "another compiler", "alloc")?.key
    assert linked != compiler
    verify_installed_rust_producer(scratch.path().joinpath("installed"))?
    return Ok(None)


def verify_installed_rust_producer(scratch: Path) -> Result[None, str]:
    """
    A complete installed proof reuses one producer without invoking a compiler; every changed input still refuses.

    1. Stamp a source facet with an external included file and one exact native dependency.
    2. Require installed reuse after unrelated search directories are added or the artifact store is relocated.
    3. Refuse changed features, rustc, source, environment, output and exact extern artifacts.
    """
    # 1. This synthetic producer's compiler path is deliberately not executable.
    setup = rust_crate(scratch)?
    consumer = fixture(scratch.joinpath("consumer"))?
    mut facet = LocalFacet(
        project=setup.facet.0,
        domain=DependencyDomain.Target,
        features=[],
        local=[LocalEdge(alias="core", project="native-core", domain=DependencyDomain.Target)],
        registry=[],
        registry_aliases=[],
    )
    mut declared = RustFacet(
        crate_name="data",
        kind="lib",
        edition="2024",
        library=setup.facet.joinpath("rust/src/lib.rs").0,
        binaries=[],
        package="data",
        version="0.1.0",
        unstable=false,
        sysroot=false,
    )
    installed = scratch.joinpath("generation")
    artifact = installed.joinpath(f"libdata-{identity(facet, "release")}.rlib")
    graph = installed.joinpath("data.incngraph")
    dependencies = installed.joinpath("library.d")
    included = scratch.joinpath("included value.txt")
    write(artifact, "one installed library")?
    write(graph, "one checked graph")?
    write(included, "one included value")?
    escaped = included.0.replace(" ", "\\ ")
    write(dependencies, f"library: {declared.library} {escaped}\n\n# env-dep:CARGO_PKG_VERSION=0.1.0\n")?
    mut toolchain = consumer.toolchain
    toolchain.externs.append(NativeCrate(name="data", path=artifact.0))
    # #2427: supply the fresh empty reader before later fields instead of deferring its nested default.
    mut request = RustBuild(
        project=setup.facet.0,
        profile="release",
        rustc="must-not-run-rustc",
        registry=RegistryUnits(units=[], search=[]),
        toolchain=Some(toolchain),
        manifests=ManifestReader(),
        native_compiler="pinned native compiler",
        installed=native_artifacts(toolchain.externs),
    )
    built = {"native-core@target": BuiltUnit(crate_name="core", artifact=setup.dependency.0, directory=scratch.0)}
    arguments = library_compile_arguments(facet, declared, installed, request, built, [])?
    environment = package_environment(facet.project, declared, declared.crate_name)
    key = rust_library_producer_key(facet, installed, arguments, environment, request, toolchain)?
    stamp = installed.joinpath("library.oven-inputs")
    # A fully validated older three-output proof migrates without asking its observer to run.
    record(stamp, key, [artifact, graph, dependencies])?
    record(installed.joinpath("library.graph-inputs"), rust_library_graph_key(key, toolchain.driver)?, [graph])?
    # 2. The selected producer is returned, rather than creating a consumer-local library with the same identity.
    output = scratch.joinpath("must-not-build")
    request.toolchain_search = [scratch.joinpath("unrelated-standard-directory").0]
    retained = compile_rust_library(facet, declared, output, request, built, [])?
    assert retained.reused and retained.artifact == artifact.0
    assert not output.is_dir()
    assert reusable([artifact, dependencies], stamp, key)?
    verify_relocated_rust_producer(facet, declared, output, request, built, artifact)?
    verify_installed_graph_refresh(facet, declared, output, request, built, artifact, graph, dependencies, included)?
    # 3. Each proof dimension independently prevents reuse.
    request.installed["data"] = [artifact.0, artifact.0]
    require_installed_refusal(facet, declared, output, request, built, "unique")?
    request.installed["data"] = [artifact.0]
    remove(stamp)?
    require_installed_refusal(facet, declared, output, request, built, "no stored build")?
    record(stamp, key, [artifact, dependencies])?
    facet.features = ["alloc"]
    require_installed_refusal(facet, declared, output, request, built, "features")?
    facet.features = []
    request.native_compiler = "different pinned native compiler"
    require_installed_refusal(facet, declared, output, request, built, "compiler")?
    request.native_compiler = "pinned native compiler"
    write(included, "changed included value")?
    require_installed_refusal(facet, declared, output, request, built, "sources")?
    write(included, "one included value")?
    declared.version = "0.2.0"
    require_installed_refusal(facet, declared, output, request, built, "environment")?
    declared.version = "0.1.0"
    write(artifact, "replaced installed library")?
    require_installed_refusal(facet, declared, output, request, built, "replaced")?
    write(artifact, "one installed library")?
    record(stamp, key, [artifact, dependencies])?
    write(setup.dependency, "rebuilt exact native dependency")?
    require_installed_refusal(facet, declared, output, request, built, "artifacts")?
    assert not output.is_dir()
    return Ok(None)


def verify_relocated_rust_producer(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    artifact: Path,
) -> Result[None, str]:
    """
    Relocate an unchanged native producer and its dependency, retaining all changed-input refusals.

    1. Replace the optional observer without changing native completeness.
    2. Copy the complete producer and exact dependency into another store.
    3. Reuse those bytes, then refuse replaced native and dependency bytes.
    """
    # 1. Native reuse must not invoke even an analysis-only observer after its replacement.
    selected = request
    toolchain = match selected.toolchain:
        Some(value) => value
        None => return Err("relocation fixture has no selected toolchain")

    driver = Path(toolchain.driver)
    script = "#!/bin/sh\nset -eu\n[ \"$1\" = --rust-codegraph ] || exit 2\n"
    write(driver, script + "printf 'relocated checked graph' > \"$2\"\n")?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    _ = compile_rust_library(facet, declared, output, selected, built, [])?
    # 2. A fresh installation changes paths, inodes and status-change times, while preserving complete bytes.
    directory = artifact.parent().parent().joinpath("relocated")
    for source in artifact.parent().iterdir().map_err((error) => error.message())?:
        if source.is_file():
            write(directory.joinpath(source.name()), read(source)?)?
    dependency = directory.joinpath("libcore.rlib")
    write(dependency, read(Path(built["native-core@target"].artifact))?)?
    mut relocated = built
    relocated["native-core@target"] = BuiltUnit(crate_name="core", artifact=dependency.0, directory=directory.0)
    moved = directory.joinpath(artifact.name())
    mut moved_request = request
    moved_request.installed["data"] = [moved.0]
    # 3. Filesystem relocation must not authorize changed content or another native compilation.
    proof = directory.joinpath("library.portable-inputs")
    saved = read(proof)?
    remove(proof)?
    require_installed_refusal(facet, declared, output, moved_request, relocated, "command")?
    write(proof, saved)?
    retained = compile_rust_library(facet, declared, output, moved_request, relocated, [])?
    assert retained.reused and retained.artifact == moved.0
    assert read(moved)? == "one installed library"
    assert not output.is_dir()
    write(moved, "replaced relocated library")?
    require_installed_refusal(facet, declared, output, moved_request, relocated, "replaced")?
    write(moved, "one installed library")?
    graph = directory.joinpath("data.incngraph")
    write(graph, "replaced relocated graph")?
    kept = compile_rust_library(facet, declared, output, moved_request, relocated, [])?
    assert kept.reused and kept.artifact == moved.0
    requested = inspect_rust_library(facet, declared, kept, moved_request, relocated, [], toolchain)?
    assert read(requested)? == "relocated checked graph"
    write(dependency, "replaced relocated dependency")?
    require_installed_refusal(facet, declared, output, moved_request, relocated, "artifacts")?
    return Ok(None)


def verify_installed_graph_refresh(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    artifact: Path,
    graph: Path,
    dependencies: Path,
    included: Path,
) -> Result[None, str]:
    """
    Native reuse never observes a graph; explicit inspection refreshes it only for unchanged native inputs.

    1. Replace the synthetic graph observer with one that refuses native code generation.
    2. Reuse with a missing graph, then explicitly refresh without changing either native output's identity.
    3. Reuse its graph, then refuse a changed source before invoking another observer generation.
    """
    # 1. The test driver accepts only the graph observation command.
    selected = request
    toolchain = match selected.toolchain:
        Some(value) => value
        None => return Err("graph fixture has no selected toolchain")

    driver = Path(toolchain.driver)
    attempts = graph.parent().joinpath("graph-attempts")
    header = "#!/bin/sh\nset -eu\n[ \"$1\" = --rust-codegraph ] || exit 2\n"
    script = header + f"printf x >> '{attempts.0}'\n" + "printf 'new checked graph' > \"$2\"\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    native_before = artifact_identity(artifact)?
    dependencies_before = artifact_identity(dependencies)?
    # 2. A missing graph and a changed observer do not create native work or an implicit inspection.
    remove(graph)?
    refreshed = compile_rust_library(facet, declared, output, selected, built, [])?
    assert refreshed.reused and refreshed.artifact == artifact.0
    assert not graph.is_file() and not attempts.is_file()
    requested = inspect_rust_library(facet, declared, refreshed, selected, built, [], toolchain)?
    assert requested.0 == graph.0
    assert graph.read_text("utf-8", "strict").map_err((error) => error.message())? == "new checked graph"
    assert artifact_identity(artifact)? == native_before
    assert artifact_identity(dependencies)? == dependencies_before
    # 3. No second analysis is needed, and stale source never authorizes a graph refresh.
    retained = compile_rust_library(facet, declared, output, selected, built, [])?
    assert retained.artifact == artifact.0
    reused_graph = inspect_rust_library(facet, declared, retained, selected, built, [], toolchain)?
    assert reused_graph.0 == graph.0
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    write(driver, script + "# another observer generation\n")?
    write(included, "source changed before graph refresh")?
    require_installed_refusal(facet, declared, output, selected, built, "sources")?
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    write(included, "one included value")?
    native = compile_rust_library(facet, declared, output, selected, built, [])?
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    updated_graph = inspect_rust_library(facet, declared, native, selected, built, [], toolchain)?
    assert updated_graph.0 == graph.0
    # A source mutation during observation cannot publish either the pending graph or a new native proof.
    changed = script + f"printf 'late source write' > '{included.0}'\n" + "printf 'must not publish' > \"$2\"\n"
    write(driver, changed)?
    match inspect_rust_library(facet, declared, native, selected, built, [], toolchain):
        Ok(_) =>
            assert false, "graph refresh certified a source mutation"
        Err(error) =>
            assert "inputs changed while refreshing data" in error, error
    assert graph.read_text("utf-8", "strict").map_err((error) => error.message())? == "new checked graph"
    assert artifact_identity(artifact)? == native_before
    assert artifact_identity(dependencies)? == dependencies_before
    write(included, "one included value")?
    return Ok(None)


def require_installed_refusal(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    cause: str,
) -> Result[None, str]:
    """Require a named installed-producer refusal without falling back to a consumer-local compilation."""
    match compile_rust_library(facet, declared, output, request, built, []):
        Ok(_) =>
            assert false, f"changed {cause} authorized stale installed support"
        Err(error) =>
            assert "installed native" in error and "data" in error and cause in error, error
    return Ok(None)


model RustCrate:
    """A Rust unit's crate on disk, the library it links and the ledger its keys are reconciled through."""

    facet: Path
    dependency: Path
    ledger: Path


def rust_crate(scratch: Path) -> Result[RustCrate, str]:
    """Lay out a crate `data` with a manifest, a module, a data file and one linked library."""
    facet = scratch.joinpath("data")
    sources = facet.joinpath("rust").joinpath("src")
    write(facet.joinpath("loaf.toml"), "[project]\nname = \"data\"\nversion = \"0.1.0\"\n")?
    write(sources.joinpath("lib.rs"), "pub mod json;\n")?
    write(sources.joinpath("json.rs"), "pub fn parse() {}\n")?
    write(sources.joinpath("table.json"), "{}")?
    dependency = scratch.joinpath("libcore.rlib")
    write(dependency, "core one")?
    return Ok(RustCrate(facet=facet, dependency=dependency, ledger=scratch.joinpath("ledger.json")))


def rust_pass(setup: RustCrate, compiler: str, feature: str) -> Result[Pass, str]:
    """Key the crate as a new process would, built with `feature`: load the ledger, reconcile, save it."""
    described = ["crate data lib", "--cfg", f"feature=\"{feature}\""]
    manifest = setup.facet.joinpath("loaf.toml")
    sources = setup.facet.joinpath("rust").joinpath("src")
    mut crates = load_ledger(setup.ledger, 0, "")
    key = rust_key(compiler, described, manifest, sources, [setup.dependency.0], crates)?
    crates.save()?
    return Ok(Pass(key=key.digest, hashed=crates.hashed, listed=crates.listed))


def verify_closure_readings(path: Path) -> Result[None, str]:
    """Reuse exact linking fields, refresh rewrites, and never let deleted or malformed input serve old fields."""
    readings = NativeClosureInput()
    write(path, "{\"search\":[\"first\"],\"externs\":[[\"serde\",\"libserde.rlib\"]],\"unused_receipt\":true}")?
    first = readings.read(path)?
    match first.get("unused_receipt"):
        Some(_) =>
            assert false, "linking fields must exclude unrelated receipt payloads"
        None => pass
    assert json_text(readings.read(path)?)? == json_text(first)?
    assert first.get("externs") != None
    assert native_bindings(path, readings)? == [("serde", "libserde.rlib")]
    write(path, "{\"externs\":[[\"missing_artifact\"]]}")?
    match native_bindings(path, readings):
        Ok(_) =>
            assert false, "a native binding without its artifact was accepted"
        Err(reason) =>
            assert "native extern must contain a name and artifact" in reason
    write(path, "{\"search\":[\"other\"],\"macro_externs\":[]}")?
    assert json_text(readings.read(path)?)? != json_text(first)?
    selected = first.require("search").map_err((error) => error.message())?
    assert json_text(selected)? == "[\"first\"]"
    write(path, "malformed")?
    match readings.read(path):
        Ok(_) =>
            assert false, "malformed native closure cannot reuse earlier linking fields"
        Err(_) => pass
    remove(path)?
    match readings.read(path):
        Ok(_) =>
            assert false, "a deleted native closure cannot reuse earlier linking fields"
        Err(_) => pass
    write(path, "{\"search\":[\"first\"],\"externs\":[[\"serde\",\"libserde.rlib\"]],\"unused_receipt\":true}")?
    assert json_text(readings.read(path)?)? == json_text(first)?
    return Ok(None)
