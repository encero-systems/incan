"""Reuse contracts: an unchanged unit is keyed from metadata alone, and any relevant change is a different key."""

from rust::std::fs import OpenOptions, metadata
from rust::std::process import Command
from std.fs import Path
from files import make_directory, read, remove, write as write_file
from compiler_refusals import check_or_replay, compile_or_replay
from incan_units import executable_outputs, install_executable, test_report
from observation import load_ledger
from scratch import scratch_directory
from rust_freshness import compilation_observations, inputs_unchanged, library_key
from toolchain import NativeCrate, Toolchain
from unit import UnitDescription, UnitLoaf
from unit_rust import compile_library_unit
from unit_freshness import (
    Key,
    artifact_files,
    compiler_fingerprint,
    reusable,
    rust_key,
    source_fingerprint,
    staleness,
    unit_key,
)


model Fixture:
    """A project with one dependency Loaf, one standard Loaf and a toolchain, all under one scratch directory."""

    unit: UnitDescription
    toolchain: Toolchain
    root: Path


model Pass:
    """One reconciliation of a unit: its key and the work it could not avoid."""

    key: str
    hashed: int
    listed: int


def write(path: Path, text: str) -> Result[None, str]:
    """Create or replace a file, making its directory first."""
    make_directory(path.parent())?
    return write_file(path, text)


def rewrite_in_place(path: Path, text: str) -> Result[None, str]:
    """Replace a file's bytes where they are with `text`, then put its modification time back as it was."""
    prefix = f"{path.0}: "
    stat = metadata(f"{path.0}").map_err((error) => f"{prefix}{error}")?
    before = stat.modified().map_err((error) => f"{prefix}{error}")?
    write_file(path, text)?
    mut options = OpenOptions.new()
    options.write(true)
    file = options.open(f"{path.0}").map_err((error) => f"{prefix}{error}")?
    file.set_modified(before).map_err((error) => f"{prefix}{error}")?
    return Ok(None)


def publish_loaf(directory: Path, name: str, text: str) -> Result[None, str]:
    """Write the complete artifact set of a Loaf."""
    for artifact in artifact_files(directory, name):
        write(artifact, f"{text} {artifact.name()}")?
    return Ok(None)


def fixture(scratch: Path) -> Result[Fixture, str]:
    """Lay out `project/` with a manifest and one source, a dependency under its target, and the toolchain's files."""
    root = scratch.joinpath("project")
    write(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\n")?
    write(root.joinpath("src").joinpath("main.incn"), "def main() -> None:\n    println(\"one\")\n")?
    dependency = root.joinpath("target").joinpath("incan").joinpath("loaves").joinpath("dep").joinpath("debug")
    standard = scratch.joinpath("home").joinpath("loaves").joinpath("std").joinpath("debug")
    publish_loaf(dependency, "dep", "dependency")?
    publish_loaf(standard, "std", "standard")?
    write(scratch.joinpath("toolchain").joinpath("driver"), "driver one")?
    write(scratch.joinpath("toolchain").joinpath("libruntime.rlib"), "runtime one")?
    write(scratch.joinpath("toolchain").joinpath("std.rustabi"), "abi one")?
    toolchain = Toolchain(
        driver=scratch.joinpath("toolchain").joinpath("driver").0,
        sysroot="/rust/1.98.0-aarch64-apple-darwin",
        rust_abi=[scratch.joinpath("toolchain").joinpath("std.rustabi").0],
        externs=[NativeCrate(name="runtime", path=scratch.joinpath("toolchain").joinpath("libruntime.rlib").0)],
        search=[],
        registry_units="",
    )
    unit = UnitDescription(
        source=root.joinpath("src").joinpath("main.incn").0,
        project_root=root.0,
        source_root=root.joinpath("src").0,
        package="app",
        version="0.1.0",
        profile="debug",
        declared_features=[],
        active_features=[],
        loaves=[
            UnitLoaf(key="dep", name="dep", dir=dependency.0, standard=false),
            UnitLoaf(key="std", name="std", dir=standard.0, standard=true),
        ],
        rust_crates=[],
        contract_models=[],
        c_headers=[],
        externs=toolchain.externs,
        rust_abi=toolchain.rust_abi,
    )
    return Ok(Fixture(unit=unit, toolchain=toolchain, root=root))


def reconcile(scratch: Path, setup: Fixture) -> Result[Pass, str]:
    """Key the unit as a new process would: load its ledger, reconcile, save it. Settling is immediate."""
    mut project = load_ledger(scratch.joinpath("ledgers").joinpath("project.json"), 0)
    key = source_fingerprint(setup.unit, compiler_fingerprint(setup.toolchain)?, project)?.digest
    project.save()?
    return Ok(Pass(key=key, hashed=project.hashed, listed=project.listed))


pub def test_unchanged_unit_is_keyed_without_reading_or_listing() -> Result[None, str]:
    """A second pass over unchanged inputs yields the same key from metadata alone: nothing hashed or listed."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    assert first.hashed > 0
    assert first.listed == 1
    second = reconcile(scratch.path(), setup)?
    assert second.key == first.key
    assert second.hashed == 0
    assert second.listed == 0
    return Ok(None)


pub def test_source_edit_rekeys_and_hashes_only_what_changed() -> Result[None, str]:
    """An edited source changes the key and costs one hash; a new module also relists its directory."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    write(Path(setup.unit.source), "def main() -> None:\n    println(\"edited\")\n")?
    edited = reconcile(scratch.path(), setup)?
    assert edited.key != first.key
    assert edited.hashed == 1
    assert edited.listed == 0
    write(setup.root.joinpath("src").joinpath("util.incn"), "pub def util() -> int:\n    return 1\n")?
    added = reconcile(scratch.path(), setup)?
    assert added.key != edited.key
    assert added.listed == 1
    # The same bytes written again change the metadata, which is a reason to recheck them and no reason to rebuild.
    write(Path(setup.unit.source), "def main() -> None:\n    println(\"edited\")\n")?
    rewritten = reconcile(scratch.path(), setup)?
    assert rewritten.key == added.key
    # Configuration is part of the key, and so are the siblings of an entry outside the source root (a test).
    write(setup.root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.2.0\"\n")?
    manifest = reconcile(scratch.path(), setup)?
    assert manifest.key != rewritten.key
    mut test_unit = setup.unit
    test_unit.source = setup.root.joinpath("tests").joinpath("test_app.incn").0
    write(Path(test_unit.source), "def test_app() -> None:\n    assert true\n")?
    write(setup.root.joinpath("tests").joinpath("helpers.incn"), "pub def helper() -> int:\n    return 1\n")?
    testing = Fixture(unit=test_unit, toolchain=setup.toolchain, root=setup.root)
    before = reconcile(scratch.path(), testing)?
    write(setup.root.joinpath("tests").joinpath("helpers.incn"), "pub def helper() -> int:\n    return 2\n")?
    helper = reconcile(scratch.path(), testing)?
    assert helper.key != before.key
    verify_refusal_replay(scratch.path().joinpath("refusals"))?
    verify_check_replay(scratch.path().joinpath("checks"))?
    return Ok(None)


def verify_refusal_replay(scratch: Path) -> Result[None, str]:
    """
    Exercise certified replay, edited input, malformed storage and abnormal failures with a counted compiler that
    cannot start a worker, so every compilation is one process. Its receipt path arrives as `--certify PATH` right
    after the sysroot, as the worker would receive it.

    1. Replay an unchanged refusal with exact binary streams.
    2. Recompile edited sources and malformed records.
    3. Retry crashes, signals, I/O failures and success without artifacts.
    """
    setup = fixture(scratch)?
    driver = Path(setup.toolchain.driver)
    attempts = scratch.joinpath("attempts")
    source = Path(setup.unit.source)
    cache = scratch.joinpath("refusal.json")
    mut script = "#!/bin/sh\n[ \"$1\" = --resident ] && exit 1\n"
    script += "[ \"$6\" = --certify ] && [ \"$8\" = --library ] || exit 2\n"
    script += f"printf x >> '{attempts.0}'\nmode=$(cat '{source.0}')\n"
    script += "case \"$mode\" in\nio) printf 'I/O failure' >&2; exit 1;;\nmissing) exit 0;;\nesac\n"
    script += "printf 'incan.compiler-refusal/1\\n' > \"$7\"\n"
    script += "printf '\\377out'; printf 'named refusal\\000tail' >&2\n"
    script += "case \"$mode\" in\ncrash) exit 101;;\nsignal) kill -TERM $$;;\nesac\nexit 1\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    invocation = ["--unit", "unit.json", "app", "app.rlib", setup.toolchain.sysroot]
    options = ["--library"]
    # 1. Replay an unchanged refusal with exact binary streams.
    write(source, "refuse")?
    key = unit_key(setup.unit, setup.toolchain)?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, key, "test")? == 1
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, key, "test")? == 1
    retained = cache.read_bytes().map_err((error) => error.message())?
    expected = b"\xffoutnamed refusal\x00tail"
    assert retained[len(retained) - len(expected):] == expected
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    mut capturing = setup.toolchain
    capturing.console = scratch.joinpath("console").0
    assert compile_or_replay(setup.unit, capturing, invocation, options, cache, key, "test")? == 1
    assert compile_or_replay(setup.unit, capturing, invocation, options, cache, key, "test")? == 1
    output = Path(f"{capturing.console}.out").read_bytes().map_err((error) => error.message())?
    error = Path(f"{capturing.console}.err").read_bytes().map_err((error) => error.message())?
    assert output == b"\xffout\xffout"
    assert error == b"named refusal\x00tailnamed refusal\x00tail"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "x"
    # 2. Recompile edited sources and malformed records.
    write(source, "refuse edited")?
    edited = unit_key(setup.unit, setup.toolchain)?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xx"
    write(cache, "incomplete document")?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xxx"
    framed = cache.read_bytes().map_err((error) => error.message())?
    cache.write_bytes(framed[:len(framed) - 1]).map_err((error) => error.message())?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, edited, "test")? == 1
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == "xxxx"
    # 3. Retry crashes, signals, I/O failures and success without artifacts.
    for mode in ["crash", "signal", "io", "missing"]:
        write(source, mode)?
        changed = unit_key(setup.unit, setup.toolchain)?
        before = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
        first_status = compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, changed, "test")?
        second_status = compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, changed, "test")?
        assert first_status == second_status
        after = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
        assert after == before + "xx", mode
    write(source, "refuse with missing artifact")?
    linked = artifact_files(Path(setup.unit.loaves[0].dir), "dep")
    linked[0].unlink().map_err((error) => error.message())?
    incomplete = unit_key(setup.unit, setup.toolchain)?
    before_missing = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, incomplete, "test")? == 1
    assert compile_or_replay(setup.unit, setup.toolchain, invocation, options, cache, incomplete, "test")? == 1
    after_missing = attempts.read_text("utf-8", "strict").map_err((error) => error.message())?
    assert after_missing == before_missing + "xx"
    return Ok(None)


def verify_check_replay(scratch: Path) -> Result[None, str]:
    """
    Exercise check replay with a counted compiler that cannot start a worker, so every check is one process.

    1. Replay an unchanged pass and an unchanged refusal with exact binary streams and status.
    2. Check again for another report format and after an edit.
    3. Check again after crashes, signals, uncertified failures and statuses no report has.
    """
    setup = fixture(scratch)?
    driver = Path(setup.toolchain.driver)
    attempts = scratch.joinpath("attempts")
    source = Path(setup.unit.source)
    record = scratch.joinpath("main.text.oven-check")
    mut script = "#!/bin/sh\n[ \"$1\" = --resident ] && exit 1\n"
    script += f"printf x >> '{attempts.0}'\nmode=$(cat '{source.0}')\nprevious=''\n"
    script += "for argument in \"$@\"; do\n[ \"$previous\" = --certify ] && receipt=$argument\n"
    script += "previous=$argument\ndone\n"
    script += "case \"$mode\" in\nio) printf 'I/O failure' >&2; exit 1;;\nstatus) exit 2;;\nesac\n"
    script += "printf 'incan.compiler-check/1\\n' > \"$receipt\"\nprintf '\\377report'; printf 'warning\\000tail' >&2\n"
    script += "case \"$mode\" in\ncrash) exit 101;;\nsignal) kill -TERM $$;;\nrefuse*) exit 1;;\nesac\nexit 0\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    text = ["--check", "unit.json", setup.toolchain.sysroot, "--format", "text"]
    # 1. Replay an unchanged pass and an unchanged refusal with exact binary streams and status.
    write(source, "pass")?
    passing = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, passing)? == 0
    assert check_or_replay(setup.unit, setup.toolchain, text, record, passing)? == 0
    write(source, "refuse")?
    refused = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, refused)? == 1
    assert check_or_replay(setup.unit, setup.toolchain, text, record, refused)? == 1
    mut expected = "xx"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected
    mut capturing = setup.toolchain
    capturing.console = scratch.joinpath("console").0
    assert check_or_replay(setup.unit, capturing, text, record, refused)? == 1
    assert Path(f"{capturing.console}.out").read_bytes().map_err((error) => error.message())? == b"\xffreport"
    assert Path(f"{capturing.console}.err").read_bytes().map_err((error) => error.message())? == b"warning\x00tail"
    # 2. Check again for another report format and after an edit.
    json = ["--check", "unit.json", setup.toolchain.sysroot, "--format", "json"]
    assert check_or_replay(setup.unit, setup.toolchain, json, record, refused)? == 1
    write(source, "refuse edited")?
    edited = unit_key(setup.unit, setup.toolchain)?
    assert check_or_replay(setup.unit, setup.toolchain, text, record, edited)? == 1
    assert check_or_replay(setup.unit, setup.toolchain, text, record, edited)? == 1
    expected += "xx"
    assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected
    # 3. Check again after crashes, signals, uncertified failures and statuses no report has.
    for mode in ["crash", "signal", "io", "status"]:
        write(source, mode)?
        changed = unit_key(setup.unit, setup.toolchain)?
        first_status = check_or_replay(setup.unit, setup.toolchain, text, record, changed)?
        assert check_or_replay(setup.unit, setup.toolchain, text, record, changed)? == first_status
        expected += "xx"
        assert attempts.read_text("utf-8", "strict").map_err((error) => error.message())? == expected, mode
    return Ok(None)


pub def test_dependency_artifacts_rekey_their_consumers() -> Result[None, str]:
    """Dependency rebuilds rekey consumers; fresh ABI publication remains reusable."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    write(artifact_files(Path(setup.unit.loaves[0].dir), "dep")[0], "dependency rebuilt with different code")?
    rebuilt = reconcile(scratch.path(), setup)?
    assert rebuilt.key != first.key
    assert rebuilt.hashed == 0
    write(artifact_files(Path(setup.unit.loaves[1].dir), "std")[1], "standard package recompiled")?
    recompiled = reconcile(scratch.path(), setup)?
    assert recompiled.key != rebuilt.key
    # A manifest that declares a vocabulary worker adds it to the artifact set; rewritten without one, it does not.
    standard = Path(setup.unit.loaves[1].dir)
    manifest = standard.joinpath("std.incnlib")
    write(manifest, "{\"vocab\": {\"desugarer_artifact\": {\"artifact_kind\": \"NativeWorker\"}}}")?
    assert "vocab-worker" in [artifact.name() for artifact in artifact_files(standard, "std")]
    write(manifest, "{}")?
    assert "vocab-worker" not in [artifact.name() for artifact in artifact_files(standard, "std")]
    verify_completed_library_abi(scratch.path().joinpath("publication"))?
    return Ok(None)


def verify_completed_library_abi(scratch: Path) -> Result[None, str]:
    """
    Reuse a library whose first compilation creates its indexed Rust ABI cache.

    1. Count a compiler that cannot start a worker and publishes the complete library artifact set, including a new
       ABI cache.
    2. Compile the prepared library twice without changing its inputs.
    3. Require one compiler invocation and retain the published ABI cache.
    """
    # 1. The optional cache appears only after the first compiler invocation.
    setup = fixture(scratch)?
    attempts = scratch.joinpath("attempts")
    driver = Path(setup.toolchain.driver)
    mut script = "#!/bin/sh\nset -eu\n[ \"$1\" = --resident ] && exit 1\n" + f"printf x >> '{attempts.0}'\n"
    script += "directory=${4%/*}\nmkdir -p \"$directory\"\n"
    script += "for name in libapp.rlib app.incnlib app.incnbody app.native.json app.incngraph app.rustabi; do\n"
    script += "printf published > \"$directory/$name\"\ndone\n"
    write(driver, script)?
    mut chmod = Command.new("/bin/chmod")
    assert chmod.arg("+x").arg(driver.0).status().map_err((error) => str(error))?.success()
    # 2. The completed stamp must include the cache that publication added.
    mut library = setup.unit
    library.kind = "library"
    output = setup.root.joinpath("target").joinpath("published").joinpath("libapp.rlib")
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    assert compile_library_unit(library, setup.toolchain, output)? == 0
    # 3. A missing cache or an incomplete stamp cannot pass by recompiling silently.
    assert read(attempts)? == "x"
    assert output.parent().joinpath("app.rustabi").is_file()
    return Ok(None)


pub def test_toolchain_change_rekeys_every_unit() -> Result[None, str]:
    """The driver, a native crate, a Rust ABI cache and the target each change the fingerprint; nothing else does."""
    scratch = scratch_directory()?
    setup = fixture(scratch.path())?
    first = compiler_fingerprint(setup.toolchain)?
    assert compiler_fingerprint(setup.toolchain)? == first
    write(Path(setup.toolchain.driver), "driver two, a longer compiler")?
    driver = compiler_fingerprint(setup.toolchain)?
    assert driver != first
    write(Path(setup.toolchain.externs[0].path), "runtime two, another interface")?
    runtime = compiler_fingerprint(setup.toolchain)?
    assert runtime != driver
    write(Path(setup.toolchain.rust_abi[0]), "abi two, other facts")?
    abi = compiler_fingerprint(setup.toolchain)?
    assert abi != runtime
    mut moved = setup.toolchain
    moved.sysroot = "/rust/1.98.0-x86_64-unknown-linux-gnu"
    assert compiler_fingerprint(moved)? != abi
    # Rewriting the driver in place with the same length and putting its modification time back is still a change.
    rewrite_in_place(Path(setup.toolchain.driver), "driver 2.., a longer compiler")?
    assert compiler_fingerprint(setup.toolchain)? != driver
    # A unit that links the replaced native crate is keyed differently too.
    before = reconcile(scratch.path(), setup)?
    write(Path(setup.toolchain.externs[0].path), "runtime three, once more different")?
    assert reconcile(scratch.path(), setup)?.key != before.key
    return Ok(None)


pub def test_stored_executable_is_never_half_written() -> Result[None, str]:
    """Reuse needs a stamp for the key and the outputs it recorded; every interruption leaves a rebuild, not a mix."""
    scratch = scratch_directory()?
    bin = scratch.path().joinpath("bin")
    output = bin.joinpath("app")
    stamp = bin.joinpath("app.oven-inputs")
    staged = bin.joinpath("app-4242")
    one = Key(digest="key one", parts=["compiler c", "sources one"])
    two = Key(digest="key two", parts=["compiler c", "sources two"])
    three = Key(digest="key three", parts=["compiler c", "sources three"])
    write(staged, "first build")?
    # A build that was interrupted before installing leaves only its staged file.
    assert not reusable([output], stamp, one)?
    install_executable(staged, output, "program", stamp, one)?
    assert reusable([output], stamp, one)?
    assert not reusable([output], stamp, two)?
    stale = staleness([output], stamp, two)?
    assert stale == "sources changed", stale
    assert not staged.is_file()
    # A replacement in flight does not disturb the installed pair.
    write(staged, "second build, still being linked")?
    assert reusable([output], stamp, one)?
    assert read(output)? == "first build"
    # An installation that fails after the old stamp is withdrawn leaves no stamp to vouch for the old outputs.
    remove(staged)?
    match install_executable(staged, output, "program", stamp, two):
        Ok(_) =>
            assert false, "installing a missing build succeeded"
        Err(_) => pass
    assert not reusable([output], stamp, one)?
    assert not reusable([output], stamp, two)?
    assert staleness([output], stamp, two)? == "no stored build"
    # An output replaced behind the stamp's back is not the output it recorded.
    write(staged, "third build")?
    install_executable(staged, output, "program", stamp, three)?
    assert reusable([output], stamp, three)?
    write(output, "someone else's binary")?
    assert not reusable([output], stamp, three)?
    # A test unit's report is installed and vouched for with its executable; without the report nothing is reused.
    tests = scratch.path().joinpath("tests")
    write(tests.joinpath("app-77"), "test executable")?
    write(test_report(tests.joinpath("app-77")), "[]")?
    install_executable(tests.joinpath("app-77"), tests.joinpath("app"), "test", tests.joinpath("app.oven-inputs"), one)?
    outputs = executable_outputs("test", tests.joinpath("app"))
    assert reusable(outputs, tests.joinpath("app.oven-inputs"), one)?
    remove(test_report(tests.joinpath("app")))?
    assert not reusable(outputs, tests.joinpath("app.oven-inputs"), one)?
    # Rust libraries retain rustc's file dependencies, including escaped paths outside the source directory.
    setup = fixture(scratch.path())?
    native = scratch.path().joinpath("native")
    dependencies = native.joinpath("library.d")
    included = scratch.path().joinpath("included value.txt")
    write(included, "first included value")?
    escaped = included.0.replace(" ", "\\ ")
    write(dependencies, f"library: {escaped}\n\n# env-dep:CARGO_PKG_NAME=old\n")?
    arguments = ["--extern", f"runtime={setup.toolchain.externs[0].path}"]
    environment = {"CARGO_PKG_NAME": "app"}
    first = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    retained = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    assert retained.digest == first.digest
    observations = compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain)?
    assert inputs_unchanged(dependencies, observations)?
    write(included, "changed included value")?
    changed = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    assert changed.digest != first.digest
    assert not inputs_unchanged(dependencies, observations)?
    write(included, "first included value")?
    changed_environment = library_key(
        setup.root,
        native,
        dependencies,
        arguments,
        {"CARGO_PKG_NAME": "other"},
        [],
        setup.toolchain,
    )?
    assert changed_environment.digest != first.digest
    # A late source or native-artifact write invalidates publication even after a key was computed.
    stable = compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain)?
    _ = library_key(setup.root, native, dependencies, arguments, environment, [], setup.toolchain)?
    write(Path(setup.toolchain.externs[0].path), "changed while compiling")?
    assert not inputs_unchanged(dependencies, stable)?
    Path(setup.toolchain.externs[0].path).unlink().map_err((error) => error.message())?
    match compilation_observations(setup.root, dependencies, arguments, [], setup.toolchain):
        Err(_) => pass
        Ok(_) =>
            assert false, "missing linked artifacts cannot supply compilation observations"
    return Ok(None)


pub def test_rust_unit_key_follows_its_crate_manifest_how_it_is_built_and_what_it_links() -> Result[None, str]:
    """
    A Rust unit is keyed like an Incan one: every file of its crate, its manifest, its arguments, the compiler and
    the libraries it links; unchanged, it is keyed from metadata alone.
    """
    scratch = scratch_directory()?
    setup = rust_crate(scratch.path())?
    sources = setup.facet.joinpath("rust").joinpath("src")
    # Unchanged, the key is the same and costs no hashing or listing.
    first = rust_pass(setup, "compiler", "std")?
    second = rust_pass(setup, "compiler", "std")?
    assert first.key == second.key
    assert second.hashed + second.listed == 0
    # Each input of the key changes it: a source, a data file, a new module, the manifest, the cfg, the compiler and
    # a linked library.
    write(sources.joinpath("json.rs"), "pub fn parse() { let _ = 1; }\n")?
    edited = rust_pass(setup, "compiler", "std")?.key
    assert edited != first.key
    write(sources.joinpath("table.json"), "{\"a\": 1}")?
    data = rust_pass(setup, "compiler", "std")?.key
    assert data != edited
    write(sources.joinpath("extra.rs"), "")?
    added = rust_pass(setup, "compiler", "std")?.key
    assert added != data
    write(setup.facet.joinpath("loaf.toml"), "[project]\nname = \"data\"\nversion = \"0.2.0\"\n")?
    manifest = rust_pass(setup, "compiler", "std")?.key
    assert manifest != added
    features = rust_pass(setup, "compiler", "alloc")?.key
    assert features != manifest
    compiler = rust_pass(setup, "another compiler", "alloc")?.key
    assert compiler != features
    write(setup.dependency, "core two, rebuilt")?
    linked = rust_pass(setup, "another compiler", "alloc")?.key
    assert linked != compiler
    return Ok(None)


model RustCrate:
    """A Rust unit's crate on disk, the library it links and the ledger its keys are reconciled through."""

    facet: Path
    dependency: Path
    ledger: Path


def rust_crate(scratch: Path) -> Result[RustCrate, str]:
    """Lay out a crate `data` with a manifest, a module, a data file and one linked library."""
    facet = scratch.joinpath("data")
    sources = facet.joinpath("rust").joinpath("src")
    write(facet.joinpath("loaf.toml"), "[project]\nname = \"data\"\nversion = \"0.1.0\"\n")?
    write(sources.joinpath("lib.rs"), "pub mod json;\n")?
    write(sources.joinpath("json.rs"), "pub fn parse() {}\n")?
    write(sources.joinpath("table.json"), "{}")?
    dependency = scratch.joinpath("libcore.rlib")
    write(dependency, "core one")?
    return Ok(RustCrate(facet=facet, dependency=dependency, ledger=scratch.joinpath("ledger.json")))


def rust_pass(setup: RustCrate, compiler: str, feature: str) -> Result[Pass, str]:
    """Key the crate as a new process would, built with `feature`: load the ledger, reconcile, save it."""
    described = ["crate data lib", "--cfg", f"feature=\"{feature}\""]
    manifest = setup.facet.joinpath("loaf.toml")
    sources = setup.facet.joinpath("rust").joinpath("src")
    mut crates = load_ledger(setup.ledger, 0, "")
    key = rust_key(compiler, described, manifest, sources, [setup.dependency.0], crates)?
    crates.save()?
    return Ok(Pass(key=key.digest, hashed=crates.hashed, listed=crates.listed))
