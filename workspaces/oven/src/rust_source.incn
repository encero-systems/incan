"""Project intake's Loaf dependency model into Rust-facet activation slots."""

from manifest_intent import FeatureDeclaration, LocalDependency, ProjectIntent, RustInputRequest


@derive(Eq)
pub enum RustRegistryRequest:
    """A registry edge whose provider is selected by Oven configuration, not by dependency syntax."""

    Default


@derive(Eq)
pub enum RustDependencySource:
    """The two source forms admitted by the Loaf grammar."""

    Registry(RustRegistryRequest)
    Path(str, RustRegistryRequest)


@derive(Eq)
pub model RustDependencyDeclaration:
    """One normalized Loaf dependency slot before feature and target activation."""

    pub index: int
    pub field: list[str]
    pub target_condition: Option[str]
    pub alias: str
    # The Loaf identity, never a crate name or filesystem name.
    pub package: str
    # Whether the authored edge names and therefore constrains the reached Loaf identity.
    pub identity_declared: bool = true
    pub version_requirement: Option[str]
    pub features: list[str]
    pub default_features: Option[bool]
    pub optional: Option[bool]
    pub source: RustDependencySource


pub model RustDependencyCatalog:
    """The dependency and feature declarations activation reads from one normalized project intent."""

    pub dependencies: list[RustDependencyDeclaration]
    pub features: Dict[str, list[str]]
    # The explicit or derived `[rust] name`, when the project has a Rust facet.
    pub library_name: Option[str]


pub def dependency_catalog(intent: ProjectIntent) -> RustDependencyCatalog:
    """
    Convert one admitted project intent into activation slots without reading or parsing its manifest again.

    Each request retains its authored alias, Loaf identity, version, feature flags and optional target. The catalog
    contains no Cargo roles, Git source, workspace inheritance or second dependency grammar.
    """
    return dependency_catalog_with(intent, intent.rust_inputs)


pub def dependency_catalog_with(
    intent: ProjectIntent,
    requests: list[RustInputRequest],
) -> RustDependencyCatalog:
    """Project an already normalized environment overlay through the same activation catalog boundary."""
    mut dependencies: list[RustDependencyDeclaration] = []
    for dependency in intent.dependencies:
        if not dependency.rust_facet:
            dependencies.append(local_declaration(dependency, len(dependencies)))
    for request in requests:
        dependencies.append(declaration(request, len(dependencies)))
    mut features: Dict[str, list[str]] = {}
    for name in sorted([name for name in intent.features.keys()]):
        features[name] = feature_entries(intent.features[name])
    mut library_name: Option[str] = None
    if intent.rust_name != "":
        library_name = Some(intent.rust_name)
    return RustDependencyCatalog(dependencies=dependencies, features=features, library_name=library_name)


def local_declaration(dependency: LocalDependency, index: int) -> RustDependencyDeclaration:
    """Project one Incan path edge into activation without inventing a Loaf identity constraint."""
    return RustDependencyDeclaration(
        index=index,
        field=["dependencies", dependency.alias],
        target_condition=None,
        alias=dependency.alias,
        package=dependency.alias,
        identity_declared=false,
        version_requirement=None,
        features=dependency.features,
        default_features=Some(dependency.default_features),
        optional=Some(dependency.optional),
        source=RustDependencySource.Path(dependency.path, RustRegistryRequest.Default),
    )


def declaration(request: RustInputRequest, index: int) -> RustDependencyDeclaration:
    """Project one normalized dependency request into its stable activation slot."""
    mut identity = ""
    match request.loaf:
        Some(loaf) => identity = loaf
        None => pass
    mut requirement: Option[str] = None
    if request.version != "":
        requirement = Some(request.version)
    mut source = RustDependencySource.Registry(RustRegistryRequest.Default)
    if let Some(path) = request.path:
        source = RustDependencySource.Path(path, RustRegistryRequest.Default)
    return RustDependencyDeclaration(
        index=index,
        field=["dependencies", request.alias],
        target_condition=request.target,
        alias=request.alias,
        package=identity,
        version_requirement=requirement,
        features=request.features,
        default_features=Some(request.default_features),
        optional=Some(request.optional),
        source=source,
    )


def feature_entries(declaration: FeatureDeclaration) -> list[str]:
    """Spell one normalized feature declaration in the activation policy's compact edge grammar."""
    mut entries = declaration.includes.clone()
    for alias in declaration.optional_dependencies:
        entries.append(f"dep:{alias}")
    for alias in sorted([alias for alias in declaration.dependency_features.keys()]):
        for feature in declaration.dependency_features[alias]:
            entries.append(f"{alias}/{feature}")
    return entries


pub def crate_identifier(name: str) -> str:
    """Spell a code-facing Rust crate name with hyphens replaced by underscores."""
    return name.replace("-", "_")


pub def extern_crate_name(declaration: RustDependencyDeclaration, child_library_name: Option[str]) -> str:
    """
    Return the dependency key rustc links, independently of the Loaf identity and child filesystem path.

    `child_library_name` is retained in the call contract because the caller also checks the selected child's Rust
    facet, but the authored dependency key is always the consumer-facing crate alias in the Loaf grammar.
    """
    _ = child_library_name
    return crate_identifier(declaration.alias)
