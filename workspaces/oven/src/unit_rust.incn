"""Resolve a described unit's Rust facet to exact artifacts before it reaches the compiler (DD-0008)."""

from std.fs import Path
from std.json import parse
from std.toml import TomlValue
from features import FeatureRequest
from json_fields import field, strings
from loaf_local_graph import LocalDemand, local_facets, unique
from rust_activation import DependencyDomain
from rust_units import RustBuild, read_registry_units, target_configuration, build_dependencies, registry_features, rust_facet
from toolchain import NativeCrate, Toolchain, load_toolchain, rust_compiler
from unit import UnitDescription, describe


pub def describe_native(source: Path, profile: str, request: FeatureRequest) -> Result[UnitDescription, str]:
    """Describe the source and prepare the exact native inputs checking and compilation share."""
    return prepare_native(describe(source, profile, request)?, load_toolchain()?)


pub def prepare_native(described: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """Prepare native inputs on an already selected unit, preserving unified features, unit kind and Loaf artifact directories.

    Dependency preparation calls this after its providers compile so their published native search paths join the
    same descriptor boundary as ordinary programs. No source graph or feature request is selected again here.
    """
    mut unit = described
    unit.search = toolchain.search
    unit.rust_abi = toolchain.rust_abi
    if Path(unit.project_root).joinpath("loaf.toml").is_file():
        unit = resolve_dependencies(unit, toolchain)?
    for native in toolchain.externs:
        if native.name not in [item.name for item in unit.externs]:
            unit.externs.append(native)
    loaves = unit.loaves
    for loaf in loaves:
        linked = loaf.name.replace("-", "_")
        library = Path(loaf.dir).joinpath(f"lib{linked}.rlib")
        # During bootstrap only already compiled standard packages may be linked.
        if loaf.standard and not library.is_file():
            continue
        unit = add_extern(unit, NativeCrate(name=linked, path=library.0))?
        unit.search.append(loaf.dir)
        closure = Path(loaf.dir).joinpath(f"{loaf.name}.native.json")
        unit.search = unit.search + loaf_search(closure)?
    unit.search = unique(unit.search)
    return Ok(unit)


def resolve_dependencies(unit: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """Activate the project's Rust edges once, compile their local units, and bind its direct aliases."""
    declared = rust_facet(unit.project_root, false)?
    if len(unit.rust_crates) == 0 and declared.kind == "":
        return Ok(unit)
    rustc = rust_compiler(toolchain)
    configuration = target_configuration(rustc)?
    demand = LocalDemand(project=unit.project_root, domain=DependencyDomain.Target, features=unit.active_features, defaults=false)
    facets = local_facets(demand, configuration, None, {})?
    registry = read_registry_units(Path(toolchain.registry_units))?
    request = RustBuild(project=unit.project_root, profile=unit.profile, rustc=rustc, registry=registry, features=unit.active_features, default_features=false)
    built = build_dependencies(request, facets)?
    mut result = unit
    result.search = result.search + registry.search
    for key in sorted([key for key in built.keys()]):
        result.search.append(built[key].directory)
    own_key = f"{unit.project_root}@target"
    if own_key in built:
        own = built[own_key]
        result = add_extern(result, NativeCrate(name=own.crate_name, path=own.artifact))?
    for facet in facets:
        if facet.project != unit.project_root or facet.domain != DependencyDomain.Target:
            continue
        for edge in facet.local:
            key = f"{edge.project}@{edge.domain.value()}"
            result = add_extern(result, NativeCrate(name=edge.alias.replace("-", "_"), path=built[key].artifact))?
        for index in range(len(facet.registry)):
            selected = facet.registry[index]
            loaf = selected.require("loaf").map_err((error) => error.message())?.expect_str().map_err((error) => error.message())?
            requirement = selected.require("req").map_err((error) => error.message())?.expect_str().map_err((error) => error.message())?
            features = registry_features(selected)?
            artifact = registry.artifact(loaf, requirement, facet.domain.value(), features)?
            result = add_extern(result, NativeCrate(name=facet.registry_aliases[index].replace("-", "_"), path=artifact))?
    return Ok(result)


def add_extern(unit: UnitDescription, native: NativeCrate) -> Result[UnitDescription, str]:
    """Bind an alias exactly once; a conflicting artifact is an error rather than directory-based selection."""
    for current in unit.externs:
        if current.name == native.name:
            if current.path != native.path:
                return Err(f"Rust crate `{native.name}` names conflicting artifacts: {current.path} and {native.path}")
            return Ok(unit)
    mut result = unit
    result.externs.append(native)
    return Ok(result)


def loaf_search(closure: Path) -> Result[list[str], str]:
    """Read a reached Loaf's transitive search directories without exposing its private extern aliases."""
    if not closure.is_file():
        return Ok([])
    text = closure.read_text("utf-8", "strict").map_err((error) => f"{closure.0}: {error.message()}")?
    document = parse(text).map_err((error) => f"{closure.0}: {error.message()}")?
    match strings(field(document, "search", []).map_err((_) => f"{closure.0}: missing search")?, ["search"]):
        Err(_) => return Err(f"{closure.0}: search is not a list of directories")
        Ok(directories) => return Ok(directories)
