"""Bind the shared local graph's exact artifacts to a compiler unit description (DD-0008)."""

from std.fs import Path
from std.toml import TomlValue
from features import FeatureRequest
from files import read_json
from json_fields import array, strings
from loaf_local_graph import LocalDemand, LocalFacet, local_facets, unique
from rust_activation import DependencyDomain
from rust_units import (
    BuiltUnit,
    RegistryUnits,
    RustBuild,
    build_dependencies,
    facet_bindings,
    incan_artifacts,
    native_search,
    read_registry_units,
    rust_facet,
    target_configuration,
)
from toolchain import NativeCrate, Toolchain, load_toolchain, located, rust_compiler
from standalone_rust import standalone_crates
from unit import UnitDescription, UnitLoaf, describe
from observation import trace
from unit_compiler import compile_prepared_unit
from unit_freshness import artifact_files, record, staleness, unit_key
from vocabulary import prepare_vocabulary


pub def describe_native(source: Path, profile: str, request: FeatureRequest) -> Result[UnitDescription, str]:
    """Describe the source and prepare the exact native inputs checking and compilation share."""
    return prepare_native(describe(source, profile, request)?, load_toolchain()?)


pub def compile_incan_library(
    source: str,
    profile: str,
    features: list[str],
    output: str,
    bindings: list[Tuple[str, str]],
    loaves: list[Tuple[str, str]],
    search: list[str],
) -> Result[i32, str]:
    """
    Prepare one activated Incan provider after the shared graph prepared all its dependencies.

    1. Describe the provider with its already selected features and profile.
    2. Bind the graph's exact artifacts without selecting or compiling dependencies again.
    3. Compile or reuse the library at the consumer's selected artifact path.
    """
    # 1. Defaults have already contributed to the local graph's closure.
    selected = FeatureRequest(features=features, default_features=false)
    mut unit = describe(Path(source), profile, selected)?
    unit.kind = "library"
    toolchain = load_toolchain()?
    # 2. A provider sees the same selected artifacts as every other consumer in this graph.
    unit.loaves = rebase_loaves(unit.loaves, loaves)
    unit.externs = [NativeCrate(name=alias, path=artifact) for alias, artifact in bindings]
    unit.search = search
    ready = prepare_linked(unit, toolchain)?
    # 3. The ordinary library stamp preserves a current artifact for either language's consumer.
    return compile_library_unit(ready, toolchain, Path(output))


def rebase_loaves(declared: list[UnitLoaf], providers: list[Tuple[str, str]]) -> list[UnitLoaf]:
    """Preserve declared aliases while binding every selected source provider to the graph's single artifact."""
    mut result: list[UnitLoaf] = []
    for loaf in declared:
        mut directory = loaf.dir
        if not loaf.standard:
            for name, prepared in providers:
                if name == loaf.name:
                    directory = prepared
        result.append(UnitLoaf(key=loaf.key, name=loaf.name, dir=directory, standard=loaf.standard))
    return result


def compile_library_unit(library: UnitDescription, toolchain: Toolchain, output: Path) -> Result[i32, str]:
    """
    Keep a prepared library's current artifact or compile and record its complete replacement.

    1. Key the library against its stored artifact stamp.
    2. Reuse a current library, or withdraw its stale stamp before compilation.
    3. Require every artifact before recording the completed build.
    """
    # 1. Both source and native inputs contribute to the ordinary library key.
    directory = output.parent()
    artifacts = artifact_files(directory, library.package)
    key = unit_key(library, toolchain)?
    stamp = directory.joinpath(".oven-inputs.sha256")
    why = staleness(artifacts, stamp, key)?
    # 2. A stamp vouches only for a complete current build.
    if why == "":
        trace(f"unit {library.package} library: reused")
        return Ok(0)
    if stamp.is_file():
        stamp.unlink().map_err((error) => f"{stamp.0}: {error.message()}")?
    compiled = compile_prepared_unit(library, toolchain, output, Some(key), why)?
    if compiled != 0:
        return Ok(compiled)
    # 3. Partial publication never receives a stamp.
    for artifact in artifacts:
        if not artifact.is_file():
            return Err(f"compiler did not publish {artifact.0}")
    record(stamp, key, artifacts)?
    return Ok(0)


pub def prepare_native(described: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """
    Prepare exact artifacts for one selected unit, preserving its kind and activated root features.

    1. Prepare the shared local graph, or resolve a standalone unit's declared Rust imports.
    2. Bind the selected artifacts and toolchain inputs to the unit.
    """
    # 1. Incan and Rust consumers share one activation graph and one artifact per source provider.
    mut unit = described
    if Path(unit.project_root).joinpath("loaf.toml").is_file():
        unit = resolve_dependencies(unit, toolchain)?
    else:
        externs, search = standalone_crates(unit, toolchain)?
        for native in externs:
            unit = add_extern(unit, native)?
            if native.name not in unit.rust_crates:
                unit.rust_crates.append(native.name)
        unit.search = unit.search + search
    # 2. No source graph is selected again while the prepared unit is linked.
    return prepare_linked(unit, toolchain)


def prepare_linked(described: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """Bind exact native inputs and register a producer vocabulary after shared dependency preparation is complete."""
    mut unit = described
    unit.search = toolchain.search + unit.search
    unit.rust_abi = toolchain.rust_abi
    unit = with_toolchain_crates(unit, toolchain)
    unit.loaves = [loaf for loaf in unit.loaves if standard_available(loaf)]
    loaves = unit.loaves
    for loaf in loaves:
        unit = link_loaf(unit, loaf, toolchain)?
    unit.search = unique(unit.search)
    return prepare_vocabulary(unit, toolchain)


def standard_available(loaf: UnitLoaf) -> bool:
    """Keep source dependencies and published standard providers; an unbuilt standard package grants no interface."""
    if not loaf.standard:
        return true
    directory = Path(loaf.dir)
    return directory.joinpath(f"lib{loaf.name}.rlib").is_file() and directory.joinpath(f"{loaf.name}.incnlib").is_file()


def with_toolchain_crates(described: UnitDescription, toolchain: Toolchain) -> UnitDescription:
    """The unit with the toolchain's native crates bound; a crate that ships an interface also joins its Loaves."""
    mut unit = described
    for native in toolchain.externs:
        if native.name not in [item.name for item in unit.externs]:
            unit.externs.append(native)
        directory = Path(native.path).parent()
        if native.name != unit.package and directory.joinpath(f"{native.name}.incnlib").is_file():
            if native.name not in [loaf.name for loaf in unit.loaves]:
                unit.loaves.append(UnitLoaf(key=native.name, name=native.name, dir=directory.0, standard=false))
    return unit


def link_loaf(described: UnitDescription, loaf: UnitLoaf, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """
    The unit linking one of its Loaves: its library, the directories its closure searches and its macro crates.

    During bootstrap only already compiled standard packages may be linked.
    """
    linked = loaf.name.replace("-", "_")
    library = Path(loaf.dir).joinpath(f"lib{linked}.rlib")
    if loaf.standard and not library.is_file():
        return Ok(described)
    mut unit = add_extern(described, NativeCrate(name=linked, path=library.0))?
    unit.search.append(loaf.dir)
    closure = Path(loaf.dir).joinpath(f"{loaf.name}.native.json")
    unit.search = unit.search + native_search(closure)?
    return expose_macro_crates(unit, closure, toolchain)


def resolve_dependencies(unit: UnitDescription, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """
    Activate the complete local graph once, compile each provider, and bind the selected direct aliases.

    1. A project with no local Loaves, Rust facet or Rust crates has nothing to resolve.
    2. Activate both languages' edges and read the toolchain's registry units.
    3. Compile the local units the edges reach.
    4. Bind the project's own crate, then the aliases of its local and registry edges.
    """
    # 1. A project with no local source or Rust inputs needs no dependency preparation.
    declared = rust_facet(unit.project_root, false)?
    if not needs_local_preparation(unit, declared.kind):
        return Ok(unit)
    # 2. The edges are activated for the features the unit already has, against the toolchain's compiled registry.
    rustc = rust_compiler(toolchain)
    configuration = target_configuration(rustc)?
    demand = LocalDemand(
        project=unit.project_root,
        domain=DependencyDomain.Target,
        features=unit.active_features,
        defaults=false,
    )
    facets = local_facets(demand, configuration, None, {}, true)?
    registry = read_registry_units(Path(toolchain.registry_units))?
    # 3. The local units the edges reach are compiled, each once, before the unit that links them.
    request = RustBuild(
        project=unit.project_root,
        profile=unit.profile,
        rustc=rustc,
        registry=registry,
        features=unit.active_features,
        default_features=false,
        incan_compiler=Some(compile_incan_library),
    )
    built = build_dependencies(request, facets)?
    # 4. The unit searches what was built, names its own crate, and binds each edge under the alias it is written by.
    mut result = unit
    result.search = result.search + registry.search
    for key in sorted([key for key in built.keys()]):
        result.search = result.search + [built[key].directory] + built[key].search
    result.loaves = rebase_loaves(result.loaves, incan_artifacts(built))
    own_key = f"{unit.project_root}@target"
    if own_key in built:
        own = built[own_key]
        result = add_extern(result, NativeCrate(name=own.crate_name, path=own.artifact))?
    for facet in facets:
        if facet.project == unit.project_root and facet.domain == DependencyDomain.Target:
            result = bind_edges(result, facet, built, registry)?
    return Ok(result)


def needs_local_preparation(unit: UnitDescription, kind: str) -> bool:
    """Whether the shared graph must prepare a local Loaf, the root's Rust facet, or declared Rust crates."""
    return kind != "" or len(unit.rust_crates) > 0 or len([loaf for loaf in unit.loaves if not loaf.standard]) > 0


def bind_edges(
    unit: UnitDescription,
    facet: LocalFacet,
    built: Dict[str, BuiltUnit],
    registry: RegistryUnits,
) -> Result[UnitDescription, str]:
    """Bind the alias of each local and registry edge of the unit's own facet to the library built for it."""
    mut result = unit
    for binding in facet_bindings(facet, built, registry)?:
        result = add_extern(result, binding)?
    return Ok(result)


def add_extern(unit: UnitDescription, native: NativeCrate) -> Result[UnitDescription, str]:
    """Bind an alias exactly once; a conflicting artifact is an error rather than directory-based selection."""
    for current in unit.externs:
        if current.name == native.name:
            if current.path != native.path:
                return Err(f"Rust crate `{native.name}` names conflicting artifacts: {current.path} and {native.path}")
            return Ok(unit)
    mut result = unit
    result.externs.append(native)
    return Ok(result)


def expose_macro_crates(unit: UnitDescription, closure: Path, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """
    Bind the Rust crates a reached Loaf's attribute macros expand against.

    rustc expands an attribute macro in the crate that applies it, so the crates the macro's output names must be this
    unit's direct externs. A Loaf that exports such a macro lists them in its native closure; the toolchain's own
    crates are already bound for every unit and stay as they are.
    """
    if not closure.is_file():
        return Ok(unit)
    document = read_json(closure)?
    mut result = unit
    match document.get("macro_externs"):
        None => return Ok(result)
        Some(listed) =>
            entries = array(listed, ["macro_externs"]).map_err((_) => f"{closure.0}: macro_externs is not a list")?
            toolchain_names = [native.name for native in toolchain.externs]
            malformed = f"{closure.0}: a macro extern is not a name and a path"
            for entry in entries:
                pair = strings(entry, ["macro_externs"]).map_err((_) => malformed)?
                if len(pair) != 2:
                    return Err(malformed)
                if pair[0] in toolchain_names:
                    continue
                result = add_extern(result, NativeCrate(name=pair[0], path=located(closure.parent(), pair[1])))?
            return Ok(result)
