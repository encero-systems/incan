"""Owner lifecycle contracts: one starter, stale state recovered, retained answers guarded, and retirement."""

from std.fs import Path
from std.json import JsonValue
from files import read, remove, write
from owner_endpoint import Endpoint, attach, deployment_configuration, endpoint_for, greeted, timeout_for
from owner_protocol import Connection, Reply, Request, listen
from owner_state import Owner, unchanged, watch
from scratch import scratch_directory
from intake import ManifestReader
from rust_units import registry_record_path


def endpoint_in(directory: Path) -> Endpoint:
    """An endpoint whose files live in `directory`."""
    return Endpoint(
        generation="g",
        directory=directory.0,
        socket=directory.joinpath("o.sock").0,
        lock=directory.joinpath("o.lock").0,
        ready=directory.joinpath("o.ready").0,
        mailbox=directory.joinpath("o.trace").0,
    )


def leave_stale(path: str) -> Result[None, str]:
    """Bind a socket and let the listener go, as a crashed owner does: the socket file stays, nothing listens."""
    # The listener is dropped at once; the socket file it bound stays behind.
    _ = listen(path, true)?
    return Ok(None)


def absent(found: Result[Option[Connection], str]) -> bool:
    """Whether an attempt to connect found no owner."""
    match found:
        Err(_) => return false
        Ok(connected) => return connected is None


def refused_attach(found: Result[Option[Connection], str]) -> bool:
    """Whether an attempt to connect was refused with an error."""
    match found:
        Err(_) => return true
        Ok(_) => return false


def refused_greeting(found: Result[None, str]) -> bool:
    """Whether a readiness greeting was refused."""
    match found:
        Err(_) => return true
        Ok(_) => return false


def ready_greeting(generation: str) -> Result[JsonValue, str]:
    """The greeting an owner of `generation` sends when it listens."""
    return Ok(Reply(status="ready", generation=generation, pid=1).to_json())


pub def test_startup_is_arbitrated_and_stale_state_recovers() -> Result[None, str]:
    """No owner is none; a stale socket is removed; a file in its place is kept; one starter holds the lock."""
    scratch = scratch_directory()?
    endpoint = endpoint_in(scratch.path())
    assert absent(attach(endpoint))
    check_stale_socket_is_removed(endpoint)?
    check_foreign_file_is_kept(endpoint)?
    check_one_starter_holds_the_lock(endpoint)?
    check_greetings_are_validated()
    check_deployment_configuration()
    assert timeout_for("run") == 0
    assert timeout_for("stop") == 5
    return Ok(None)


def check_deployment_configuration() -> None:
    """A deployment selection cannot share an owner with another value, absence or another Apple platform's input."""
    absent = deployment_configuration([("OVEN_TRACE", "-")])
    empty = deployment_configuration([("MACOSX_DEPLOYMENT_TARGET", "")])
    first = deployment_configuration([("MACOSX_DEPLOYMENT_TARGET", "11.0")])
    second = deployment_configuration([("MACOSX_DEPLOYMENT_TARGET", "14.0")])
    platform = deployment_configuration([("IPHONEOS_DEPLOYMENT_TARGET", "14.0")])
    assert absent == []
    assert empty != absent and first != empty and first != second and second != platform
    assert deployment_configuration([("OVEN_TRACE", "changed"), ("MACOSX_DEPLOYMENT_TARGET", "11.0")]) == first


def check_stale_socket_is_removed(endpoint: Endpoint) -> Result[None, str]:
    """A socket nobody listens at is no owner, and attaching removes it."""
    leave_stale(endpoint.socket)?
    assert Path(endpoint.socket).exists()
    assert absent(attach(endpoint))
    assert not Path(endpoint.socket).exists()
    return Ok(None)


def check_foreign_file_is_kept(endpoint: Endpoint) -> Result[None, str]:
    """An ordinary file where the socket belongs is refused and left alone; a live listener is an owner."""
    write(Path(endpoint.socket), "not a socket")?
    assert refused_attach(attach(endpoint))
    assert read(Path(endpoint.socket))? == "not a socket"
    remove(Path(endpoint.socket))?
    # The listener stays up until this function returns, so the attach below finds a live owner.
    mut listener = listen(endpoint.socket, true)?
    assert not absent(attach(endpoint))
    return Ok(None)


def check_one_starter_holds_the_lock(endpoint: Endpoint) -> Result[None, str]:
    """Of two starters, the first gets the lock and the second does not."""
    first = Path(endpoint.lock).try_lock_exclusive().map_err((error) => error.message())?
    match first:
        None =>
            assert false, "the first starter did not get the lock"
        Some(held) =>
            # `held` is the first starter's lock, kept while the second starter tries.
            second = Path(endpoint.lock).try_lock_exclusive().map_err((error) => error.message())?
            match second:
                Some(_) =>
                    assert false, "two starters held the lock at once"
                None => pass
    return Ok(None)


def check_greetings_are_validated() -> None:
    """Only a `ready` greeting of the expected generation is accepted."""
    assert refused_greeting(greeted(ready_greeting("other"), "g"))
    assert refused_greeting(greeted(Ok(Reply(status="done", generation="g", pid=1).to_json()), "g"))
    assert refused_greeting(greeted(Err("closed"), "g"))
    assert not refused_greeting(greeted(ready_greeting("g"), "g"))


pub def test_the_owner_serves_one_generation_and_retires() -> Result[None, str]:
    """Another generation or a bad path is refused; stop retires; idle retires only when idle long enough."""
    mut owner = Owner(generation="g", last_served=1000)
    assert owner.handle(Request(command="status", generation="other"), 600).status == "refused"
    assert owner.handle(Request(command="status", generation="g"), 600).status == "done"
    assert owner.handle(Request(command="stop", generation="g"), 600).status == "retiring"
    assert owner.handle(Request(command="idle", generation="g"), 600).status == "retiring"
    owner.last_served = 99999999999
    assert owner.handle(Request(command="idle", generation="g"), 600).status == "done"
    assert owner.handle(Request(command="dance", generation="g"), 600).status == "refused"
    relative = owner.handle(Request(command="run", generation="g", path="src/main.incn"), 600)
    assert relative.status == "refused"
    assert "absolute" in relative.reason
    missing = owner.handle(Request(command="run", generation="g", path="/no/such/main.incn"), 600)
    assert missing.status == "refused"
    return Ok(None)


pub def test_retained_answers_are_guarded_by_the_files_they_came_from() -> Result[None, str]:
    """An edited, created or removed file ends a retained answer; an untouched one keeps it."""
    scratch = scratch_directory()?
    manifest = scratch.path().joinpath("loaf.toml")
    lock = scratch.path().joinpath("oven.lock")
    write(manifest, "[project]\nname = \"a\"\n")?
    guard = watch([manifest.0, lock.0])
    assert unchanged(guard)
    write(manifest, "[project]\nname = \"bb\"\n")?
    assert not unchanged(guard)
    renewed = watch([manifest.0, lock.0])
    write(lock, "")?
    assert not unchanged(renewed)
    again = watch([manifest.0, lock.0])
    remove(lock)?
    assert not unchanged(again)
    write(manifest, "[build]\nregistry-lock='producer.json'\n")?
    producer = registry_record_path(scratch.path().0, ManifestReader())?
    assert producer == scratch.path().joinpath("producer.json").0
    absent = watch([producer])
    write(Path(producer), "first producer")?
    assert not unchanged(absent)
    present = watch([producer])
    write(Path(producer), "another producer")?
    assert not unchanged(present)
    return Ok(None)
