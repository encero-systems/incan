"""Settle one captured program request, select its result and protect the caller's execution roots."""

from std.fs import Path
from std.primitives.locking import LockGuard
from rust::incan_std_primitives::locking import LockGuard as NativeLockGuard
from rust::std::marker import Send, Sync
from rust::std::rc import Rc
from rust::std::sync import Arc, Mutex
from std.encoding.hex import hexlify
from engine_messages import BindingOutcome, Captured, Complete, CompletionStatus, Submit
from request_directory import serve_from, served
from engine_programs import ProgramOutcome, check_program, obtain, prepare_selection, program_handle
from engine_epochs import CapturedRequest, after_projection, prepare_submit
from engine_proofs import retain, prepare_report
from pub::incan_platform.store import Transaction, begin as begin_selection, commit, commit_pinned, read_counts
from observation import trace
from jec import begin, record
from pub::incan_platform.trace import Operation
from installation_page import begin_command, end_command
from trace_adapter import count_frozen_work, finish_frozen_counting
from toolchain import toolchain_directory
from home import standard_library_dir


pub type ThreadSafeLockGuard = rusttype NativeLockGuard with Send, Sync


pub model Pending:
    """One transient captured request; its input observations are released when this activation settles."""

    pub request: bytes
    pub token: str
    pub submit: Submit
    pub producer: str


pub model ExecutionLease:
    """A live substrate lease over the exact selected view, retained until release or client disconnect."""

    pub token: str
    pub snapshot: str
    pub handle: str
    pub held: Arc[ThreadSafeLockGuard]


pub model Ready:
    """A completed caller's control reply, diagnostic stream handles and optional execution lease."""

    pub message: Complete
    pub console: str
    pub pin: Option[ExecutionLease] = None


pub enum WorkerEvent:
    """Ordered worker progress returned to the socket event loop without moving captured store state across threads."""

    Captured(bytes, Captured)
    Settled(bytes, str, Result[Ready, str])


pub def finish_request(store: Path, pending: Pending, events: Arc[Mutex[list[WorkerEvent]]]) -> None:
    """Capture installed facts once for this activation and resume reconciliation before the next request."""
    begin_command()
    serve_from(pending.submit.directory)
    capturing = begin()
    captured = match prepare_submit(store, pending.submit):
        Err(reason) =>
            record(Operation.EngineCapture, pending.submit.requested_roots, capturing)
            served()
            end_command()
            emit(events, WorkerEvent.Settled(pending.request, pending.token, Err(reason)))
            return None
        Ok(value) => value
    record(Operation.EngineCapture, pending.submit.requested_roots, capturing)
    selected = f"snapshot:{captured.snapshot.generation}:{captured.snapshot.digest}"
    notification = Captured(epoch=captured.identity, snapshot=selected)
    emit(events.clone(), WorkerEvent.Captured(pending.request, notification))
    handle = match program_handle(captured.identity, pending.producer, pending.submit.view):
        Err(reason) =>
            served()
            end_command()
            emit(events, WorkerEvent.Settled(pending.request, pending.token, Err(reason)))
            return None
        Ok(value) => value
    ready = settled_request(store, pending, captured, handle)
    served()
    end_command()
    emit(events, WorkerEvent.Settled(pending.request, pending.token, ready))


def emit(events: Arc[Mutex[list[WorkerEvent]]], event: WorkerEvent) -> None:
    """Publish one worker event; a poisoned queue means its owning client can no longer receive progress."""
    mut queue = match events.lock():
        Err(_) => return None
        Ok(value) => value
    queue.push(event)


def settled_request(store: Path, pending: Pending, captured_request: CapturedRequest, handle: str) -> Result[Ready, str]:
    """
    Settle one request without executing user code in the engine.

    1. Ask for the captured unit record, activating its epoch only on a miss.
    2. Retain counters only when this caller explicitly requested a proof report.
    3. Select successful results in the caller's virtual view and hold an execution lease before replying.
    """
    # 1. The compiler owns whole-unit production; the engine holds no semantic closure after this activation.
    run = hexlify(pending.request)
    directory = store.joinpath("engine/console")
    directory.mkdir(true, true).map_err((error) => f"cannot {error.message()}")?
    if pending.submit.command == "check":
        return settled_check(store, pending, captured_request, directory.joinpath(run).0)
    producing = begin()
    toolchain = toolchain_directory()?.0 + "/"
    standard = standard_library_dir()?.0 + "/"
    count_frozen_work([toolchain, standard])
    reading = read_counts()
    produced_result = obtain(
        store,
        captured_request.revision,
        handle,
        directory.joinpath(run).0,
        Some(captured_request.epoch),
        pending.producer,
        Some(captured_request.selected),
    )
    frozen = finish_frozen_counting()
    read = read_counts()
    mut produced = produced_result?
    produced.index_pages = read.pages - reading.pages
    produced.keys_listed = read.listed - reading.listed
    mut counters = captured_request.counters
    counters.frozen.stats += frozen.stats
    counters.frozen.reads += frozen.reads
    counters.frozen.hashes += frozen.hashes
    record(Operation.EngineUnit, captured_request.revision, producing)
    # 2. A report is an explicit retained root, never an automatic write on an unchanged run.
    mut observation = ""
    match produced.unit:
        None =>
            if pending.submit.observation_policy == "proofs":
                observation = retain(store, run, counters, produced)?
            return Ok(
                Ready(
                    message=Complete(
                        snapshot="",
                        admission_proof="",
                        result_handles="",
                        binding_outcome=BindingOutcome.NotSelected,
                        status=CompletionStatus.Failed,
                        observation_handle=observation,
                    ),
                    console=produced.console,
                ),
            )
        Some(unit) =>
            # 3. A completed native descriptor is selected independently for each caller.
            selecting = begin()
            captured = after_projection(captured_request)?
            selection = prepare_selection(store, pending.submit.view, unit, handle)?
            mut group: list[Transaction] = []
            if let Some(transaction) = captured.transaction:
                group.append(transaction)
            if let Some(transaction) = produced.transaction:
                group.append(transaction)
            if let Some(transaction) = produced.view_transaction:
                group.append(transaction)
            if let Some(transaction) = selection.transaction:
                group.append(transaction)
            if pending.submit.observation_policy == "proofs":
                group.append(prepare_report(store, run, counters, produced)?)
                observation = run
            if len(group) == 0:
                group.append(begin_selection(selection.snapshot))
            published = commit_pinned(group, pending.submit.view).map_err((error) => error.message())?
            selected = published.snapshot
            if produced.native_bakes > 0:
                trace(
                    f"bakery {unit.identity[:12]}: baked program {Path(unit.binary).name()} (generation {selected.generation})",
                )

            record(Operation.EngineSelect, pending.submit.view, selecting)
            pinning = begin()
            held = required_pin(published.pin)?
            record(Operation.EngineLease, pending.submit.view, pinning)
            pin = ExecutionLease(token=pending.token, snapshot=selected.digest, handle=handle, held=held)
            return Ok(
                Ready(
                    message=Complete(
                        snapshot=selected.digest,
                        admission_proof=unit.identity,
                        result_handles=handle,
                        binding_outcome=BindingOutcome.Selected,
                        status=CompletionStatus.Success,
                        observation_handle=observation,
                    ),
                    console=produced.console,
                    pin=Some(pin),
                ),
            )


def settled_check(store: Path, pending: Pending, captured_request: CapturedRequest, console: str) -> Result[Ready, str]:
    """Check the captured build reach, publish its capture, and return no native selection or execution lease."""
    checking = begin()
    outcome = check_program(
        store,
        captured_request.revision,
        console,
        pending.submit.options,
        Some(captured_request.epoch),
        Some(captured_request.selected),
        pending.submit.view,
    )?
    record(Operation.EngineUnit, captured_request.revision, checking)
    captured = after_projection(captured_request)?
    mut snapshot = captured.snapshot.digest
    if let Some(transaction) = captured.transaction:
        snapshot = commit(transaction).map_err((error) => error.message())?.digest
    mut status = CompletionStatus.Success
    if outcome.code != 0:
        status = CompletionStatus.Failed
    # A requested report shows that a check produced no unit, no plans and no native bake, and which bodies it checked.
    mut observation = ""
    if pending.submit.observation_policy == "proofs":
        checked = ProgramOutcome(
            code=outcome.code,
            body_evaluations=outcome.body_evaluations,
            body_reuses=outcome.body_reuses,
            body_page_writes=outcome.body_page_writes,
            body_page_decodes=outcome.body_page_decodes,
        )
        observation = retain(store, hexlify(pending.request), captured_request.counters, checked)?
    return Ok(
        Ready(
            message=Complete(
                snapshot=snapshot,
                admission_proof="",
                result_handles="",
                binding_outcome=BindingOutcome.NotSelected,
                status=status,
                observation_handle=observation,
            ),
            console=outcome.console,
        ),
    )


def required_pin(pin: Option[Rc[LockGuard]]) -> Result[Arc[ThreadSafeLockGuard], str]:
    """A completed request must already hold its selected generation's execution pin."""
    match pin:
        Some(held) => return Ok(Arc.new(held.as_ref().0.clone()))
        None => return Err("publication completed without an execution pin")
