"""Select the records engine, the default, or the legacy engine `INCAN_ENGINE` names, without falling back after a refusal."""

from engine_wire import Refusal, RefusalKind

# The engine a command runs on when `INCAN_ENGINE` is unset.
pub const DEFAULT_ENGINE: str = "records"


pub enum Engine:
    """The engines a command can select: records is the default, and legacy stays selectable until E7 removes it."""

    Legacy
    Records


pub def select(value: str) -> Result[Engine, Refusal]:
    """Require the exact configured engine name; unknown values never silently choose legacy."""
    if value == "legacy":
        return Ok(Engine.Legacy)
    if value == "records":
        return Ok(Engine.Records)
    return Err(Refusal(kind=RefusalKind.Schema, detail="INCAN_ENGINE must be legacy or records"))
