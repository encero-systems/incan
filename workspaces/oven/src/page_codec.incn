"""Checked little-endian fields for typed bakery pages, decoded directly from immutable mapped bytes."""

from rust::std::string import String as RustString
from std.fs import MappedView
from std.io import BytesIO, Endian, _BytesIO


pub model Reader:
    """A cursor bounded by one admitted page; lengths are checked before copying or allocating."""

    pub view: MappedView
    pub offset: int = 0

    def number(mut self) -> Result[int, str]:
        """Read a nonnegative length or tag without stepping outside the page."""
        match self.view.read_u64_le(self.offset):
            None => return Err("page scalar runs past the page")
            Some(value) =>
                self.offset += 8
                result = int(value)
                if result < 0:
                    return Err("page scalar is outside the supported range")
                return Ok(result)

    def text(mut self) -> Result[str, str]:
        """Copy one checked UTF-8 field."""
        size = self.number()?
        if size > self.view.len() - self.offset:
            return Err("page text runs past the page")
        match self.view.slice(self.offset, size):
            None => return Err("page text has an invalid range")
            Some(field) =>
                self.offset += size
                return RustString
                    .from_utf8(field.to_bytes())
                    .map((value) => str(value))
                    .map_err((_) => "page text is not UTF-8")

    def count(mut self, minimum: int = 8) -> Result[int, str]:
        """Bound a collection by the minimum encoded size of each member."""
        count = self.number()?
        if count > (self.view.len() - self.offset) // minimum:
            return Err("page collection runs past the page")
        return Ok(count)

    def texts(mut self) -> Result[list[str], str]:
        """Decode ordinary vectors with one native string split; fields containing its separator use explicit lengths."""
        count = self.number()?
        tag = self.number()?
        if tag == 0:
            content = self.text()?
            if count == 0:
                if content != "":
                    return Err("empty page vector has contents")
                return Ok([])
            if count > len(content) + 1:
                return Err("page vector count exceeds its contents")
            values = content.split("\\x00")
            if len(values) != count:
                return Err("page vector count differs from its contents")
            return Ok(values)
        if tag != 1 or count > (self.view.len() - self.offset) // 8:
            return Err("invalid page vector encoding")
        mut values: list[str] = []
        for _index in range(count):
            values.append(self.text()?)
        if len([value for value in values if "\\x00" in value]) == 0:
            return Err("noncanonical page vector encoding")
        return Ok(values)

    def flag(mut self) -> Result[bool, str]:
        """Accept exactly the two boolean encodings."""
        value = self.number()?
        if value > 1:
            return Err("page flag is not a boolean")
        return Ok(value == 1)

    def optional(mut self) -> Result[Option[str], str]:
        """Read an optional string without conflating absence and an empty string."""
        if self.flag()?:
            return Ok(Some(self.text()?))
        return Ok(None)


pub def put_number(buffer: _BytesIO, value: int) -> Result[None, str]:
    """Write a nonnegative portable unsigned scalar."""
    maybe: Option[u64] = value.try_resize()
    match maybe:
        None => return Err("page length is outside the supported range")
        Some(number) =>
            buffer.write(number, Endian.Little).map_err((error) => error.message())?
            return Ok(None)


pub def put_text(buffer: _BytesIO, value: str) -> Result[None, str]:
    """Write the exact byte length and UTF-8 contents."""
    data = value.encode("utf-8")
    put_number(buffer, len(data))?
    buffer.write_bytes(data).map_err((error) => error.message())?
    return Ok(None)


pub def put_texts(buffer: _BytesIO, values: list[str]) -> Result[None, str]:
    """Pack ordinary vectors into one UTF-8 field; preserve strings containing its separator with explicit lengths."""
    put_number(buffer, len(values))?
    if len([value for value in values if "\\x00" in value]) == 0:
        put_number(buffer, 0)?
        return put_text(buffer, "\\x00".join(values))
    put_number(buffer, 1)?
    for value in values:
        put_text(buffer, value)?
    return Ok(None)


pub def put_flag(buffer: _BytesIO, value: bool) -> Result[None, str]:
    """Write the canonical encoding of a boolean."""
    if value:
        return put_number(buffer, 1)
    return put_number(buffer, 0)


pub def put_optional(buffer: _BytesIO, value: Option[str]) -> Result[None, str]:
    """Write presence separately from the string's contents."""
    match value:
        None => return put_flag(buffer, false)
        Some(text) =>
            put_flag(buffer, true)?
            return put_text(buffer, text)
