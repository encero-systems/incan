"""Read local Loaf intent without selecting Rust versions or authorizing compilation."""

from std.toml import TomlValue
from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from std.graph import Dag, NodeId
from manifest_errors import IntakeError, IntakeErrorKind
from pub::incan_platform.trace import Operation
from jec import begin, record
from observation import observe
from rust::std::rc import Rc
from rust::std::cell import RefCell
from rust::std::ops import DerefMut
from manifest_intent import (
    LocalDependency,
    ManifestEvidence,
    ManifestSnapshot,
    ProjectIntent,
    decoded_manifest,
    intent_from_snapshot,
    refusal,
    table,
)
from manifest_tolerance import library_scripts, without_scripts
from rust_activation import ActivationPurpose


pub model LocalProject:
    """One canonical local root and its separate evidence and effective intent."""

    pub root: str
    pub evidence: ManifestEvidence
    pub intent: ProjectIntent
    # The same parse used for intent, retained for dependency and Rust-facet views.
    pub parsed: TomlValue
    # The `[project.scripts]` entries that name the conventional library, ignored, with their authored paths.
    pub library_scripts: Dict[str, str] = {}


pub model DependencyEdge:
    """Preserve requester and authored alias even when two aliases reach one package."""

    pub requester_root: str
    pub alias: str
    pub dependency_root: str


pub model LocalIntake:
    """A local topology only; every native selection still needs admitted compiler facts."""

    pub projects: list[LocalProject]
    pub edges: list[DependencyEdge]


model ManifestReading:
    """A parsed snapshot bound to the unchanged filesystem generation it was read from, and the digest of its bytes."""

    stamp: str
    digest: str
    snapshot: ManifestSnapshot


model ManifestStore:
    """Mutable memo state owned by one preparation context, never by process-global collection storage."""

    pub manifests: Dict[str, ManifestReading] = {}
    pub projects: Dict[str, LocalProject] = {}
    # The lock text a command resolved in memory for each root whose oven.lock is missing or stale, by lock path.
    pub resolved_locks: Dict[str, str] = {}


pub model ManifestReader:
    """One preparation's shared source readings; cloning its handle never snapshots the memo's document trees."""

    pub state: Rc[RefCell[ManifestStore]] = Rc.new(RefCell.new(ManifestStore()))


pub def read_manifest_snapshot(
    root: Path,
    reader: ManifestReader = ManifestReader(),
) -> Result[ManifestSnapshot, IntakeError]:
    """
    Read and parse one file generation for the current command, without imposing project-intent policy.

    Reuse requires the same filesystem identity. A rewrite or replacement is read again, a missing file refuses,
    and a generation changed during the read never enters the snapshot table. The caller owns the context's lifetime.
    """
    mut held = reader.state.as_ref().borrow_mut()
    return snapshot_in(root, held.deref_mut())


def snapshot_in(root: Path, mut store: BorrowedMut[ManifestStore]) -> Result[ManifestSnapshot, IntakeError]:
    """Read or recall a snapshot while holding the preparation's one mutable memo view."""
    manifest = root.joinpath("loaf.toml")
    observed = observe(manifest).map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, error))?
    if manifest.0 in store.manifests:
        previous = store.manifests[manifest.0]
        if previous.stamp == observed.stamp:
            return Ok(previous.snapshot)
    clock = begin()
    raw = manifest
        .read_bytes()
        .map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, f"cannot {error.message()}"))?
    record(Operation.FileRead, manifest.0, clock, len(raw))
    snapshot = decoded_manifest(raw, manifest.0)?
    current = observe(manifest).map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, error))?
    if current.stamp == observed.stamp:
        digest = hexlify(sha256.digest(raw))
        store.manifests[manifest.0] = ManifestReading(stamp=observed.stamp, digest=digest, snapshot=snapshot)
    return Ok(snapshot)


pub def remember_resolved_lock(reader: ManifestReader, path: str, text: str) -> None:
    """
    Select, for the rest of this preparation, the lock a command resolved in memory for the root whose lock file is
    `path`. Only `oven lock`, `oven add` and `oven update` write a lock, so a missing or stale file keeps its bytes.
    """
    mut held = reader.state.as_ref().borrow_mut()
    resolve_in(held.deref_mut(), path, text)


def resolve_in(mut store: BorrowedMut[ManifestStore], path: str, text: str) -> None:
    """Record one resolved lock in the preparation's memo."""
    store.resolved_locks[path] = text


pub def resolved_lock_text(reader: ManifestReader, path: str) -> Option[str]:
    """The lock text this preparation resolved in memory for the lock file `path`, if it resolved one."""
    mut held = reader.state.as_ref().borrow_mut()
    return resolved_in(held.deref_mut(), path)


def resolved_in(mut store: BorrowedMut[ManifestStore], path: str) -> Option[str]:
    """Read one resolved lock from the preparation's memo."""
    if path in store.resolved_locks:
        return Some(store.resolved_locks[path])
    return None


pub def read_digests(reader: ManifestReader) -> Dict[str, str]:
    """Every manifest this reader parsed, by path, with the SHA-256 of the bytes it parsed."""
    mut held = reader.state.as_ref().borrow_mut()
    return digests_in(held.deref_mut())


def digests_in(mut store: BorrowedMut[ManifestStore]) -> Dict[str, str]:
    """The content digests a preparation's manifest memo recorded, by manifest path."""
    mut digests: Dict[str, str] = {}
    for path in store.manifests.keys():
        digests[path] = store.manifests[path].digest
    return digests


pub def read_project(root: Path, reader: ManifestReader = ManifestReader()) -> Result[LocalProject, IntakeError]:
    """Normalize one parsed generation once, preserving its raw evidence and the independent parsed view."""
    snapshot = read_manifest_snapshot(root, reader)?
    mut held = reader.state.as_ref().borrow_mut()
    return project_in(root, snapshot, held.deref_mut())


def project_in(
    root: Path,
    snapshot: ManifestSnapshot,
    mut store: BorrowedMut[ManifestStore],
) -> Result[LocalProject, IntakeError]:
    """Normalize an exact snapshot once within the caller-owned preparation context."""
    if root.0 in store.projects:
        previous = store.projects[root.0]
        if previous.evidence.sha256_digest == snapshot.evidence.sha256_digest:
            return Ok(previous)
    mut intent = intent_from_snapshot(snapshot)?
    # A script that names the conventional library is ignored; the library is built as one (`manifest_tolerance`).
    library = Path(source_root_for(root, intent)).joinpath("lib.incn")
    ignored = library_scripts(root, intent.scripts, library)
    intent.scripts = without_scripts(intent.scripts, ignored)
    project = LocalProject(
        root=root.0,
        intent=intent,
        evidence=snapshot.evidence,
        parsed=snapshot.parsed,
        library_scripts=ignored,
    )
    store.projects[root.0] = project
    return Ok(project)


pub def source_root_of(project: LocalProject) -> str:
    """The declared source root, otherwise `src` when present, otherwise the project root."""
    return source_root_for(Path(project.root), project.intent)


def source_root_for(root: Path, intent: ProjectIntent) -> str:
    """Apply source-root policy to an already read intent without rediscovering the manifest."""
    if let Some(declared) = intent.source_root:
        return root.joinpath(declared).0
    if root.joinpath("src").is_dir():
        return root.joinpath("src").0
    return root.0


pub def library_source(root: Path, reader: ManifestReader = ManifestReader()) -> Result[Path, str]:
    """Locate an Incan library through the same source-root policy as its compiler unit."""
    project = read_project(root, reader).map_err((error) => error.message())?
    return Ok(Path(source_root_of(project)).joinpath("lib.incn"))


pub def entry_source(path: Path, reader: ManifestReader) -> Result[Option[Path], str]:
    """
    Select an explicit source or a directory's conventional Incan entry; other directories name Rust projects. A path
    that names nothing is refused here, before a Rust project route would read it as a project.
    """
    if path.is_file():
        return Ok(Some(path))
    if not path.is_dir():
        return Err(f"{path.0}: no such source file or Loaf directory")
    if not path.joinpath("loaf.toml").is_file():
        return Ok(None)
    project = read_project(path, reader).map_err((error) => error.message())?
    root = Path(source_root_of(project))
    for name in ["lib.incn", "main.incn"]:
        source = root.joinpath(name)
        if source.is_file():
            return Ok(Some(source))
    return Ok(None)


pub def load_project(root: Path, reader: ManifestReader = ManifestReader()) -> Result[LocalProject, IntakeError]:
    """Validate script paths against one snapshot; conventional libraries and test-only packages need no script."""
    project = read_project(root, reader)?
    intent = project.intent
    source = project.evidence.source
    manifest = root.joinpath("loaf.toml")
    for script in intent.scripts.keys():
        path = root.joinpath(intent.scripts[script])
        if not path.is_file():
            return Err(
                refusal(manifest.0, ["project", "scripts", script], IntakeErrorKind.Missing, path.0).with_source(source),
            )
        _ = path
            .resolve()
            .map_err(
                (error) => refusal(manifest.0, ["project", "scripts", script], IntakeErrorKind.Invalid, error.message()),
            )?
    if declares_no_entry(root, intent):
        return Err(
            refusal(
                manifest.0,
                ["project", "scripts"],
                IntakeErrorKind.Missing,
                "expected a conventional library or explicit script",
            ),
        )
    return Ok(project)


def declares_no_entry(root: Path, intent: ProjectIntent) -> bool:
    """
    Whether a project has no script, no conventional library in either language and no `tests` directory: an Incan
    `lib.incn` under its source root, or a Rust `src/lib.rs`.
    """
    incan_library = Path(source_root_for(root, intent)).joinpath("lib.incn").is_file()
    has_library = incan_library or root.joinpath("src/lib.rs").is_file()
    return len(intent.scripts) == 0 and not has_library and not root.joinpath("tests").is_dir()


@derive(Eq)
model IntakeOwner:
    """A production Loaf and the test unit it owns are distinct nodes even when they share a project root."""

    root: str
    purpose: ActivationPurpose = ActivationPurpose.Normal

    def identity(self) -> str:
        """Name this node for cycle detection."""
        if self.purpose == ActivationPurpose.Test:
            return "test:" + self.root
        return self.root


model IntakeLink:
    """A local dependency joins the requesting unit to a production Loaf."""

    requester: IntakeOwner
    dependency_root: str
    alias: str
    field: list[str]


pub def intake(
    root: Path,
    reader: ManifestReader = ManifestReader(),
    purpose: ActivationPurpose = ActivationPurpose.Normal,
) -> Result[LocalIntake, IntakeError]:
    """
    Read reachable local package requests and return their dependency-first topology.

    Authored aliases remain separate edges even when they select the same canonical local path. Graph handles are
    temporary traversal state. The returned request packet contains no selected Rust version, admitted compiler
    inputs or build plan; those require checked provider facts from the host boundary.

    Args:
        root: Existing project directory whose loaf.toml starts the local dependency closure.
        reader: Shared source readings for this preparation; every manifest the closure visits is read through it.
        purpose: The root unit's selection. Dependencies always contribute their production edges.

    Returns:
        Local projects, alias-bearing edges and dependency order, or a refusal for unsupported or missing intent.

    Example:
        packet = intake(Path("../../workbench/app"))?
        assert len(packet.projects) == 3
    """
    canonical = root
        .resolve()
        .map_err((error) => refusal(root.0, [], IntakeErrorKind.Missing, f"cannot {error.message()}"))?
    mut owners = [IntakeOwner(root=canonical.0, purpose=purpose)]
    mut projects: list[LocalProject] = []
    mut positions: Dict[str, int] = {}
    mut links: list[IntakeLink] = []
    mut index = 0
    while index < len(owners):
        owner = owners[index]
        if owner.root not in positions:
            positions[owner.root] = len(projects)
            projects.append(load_project(Path(owner.root), reader)?)
        append_project_links(projects[positions[owner.root]], owner, owners, links)?
        index += 1
    verify_acyclic(owners, links, projects, positions)?
    # Feature projection describes the selected root. Its production counterpart only participates in cycle checks.
    mut edges: list[DependencyEdge] = []
    for link in links:
        if link.requester.root == canonical.0 and link.requester.purpose != purpose:
            continue
        edges.append(
            DependencyEdge(requester_root=link.requester.root, alias=link.alias, dependency_root=link.dependency_root),
        )
    return Ok(LocalIntake(projects=projects, edges=edges))


def append_project_links(
    project: LocalProject, owner: IntakeOwner, mut owners: list[IntakeOwner], mut links: list[IntakeLink],
) -> Result[None, IntakeError]:
    """Visit a project's selected local edges and queue each previously unseen production owner."""
    if owner.purpose == ActivationPurpose.Test:
        environment = owner.purpose.value()
        if project.intent.has_local_dependency_overlay(environment):
            return append_local_links(
                project, owner, project.intent.environment_local_dependencies[environment], environment, owners, links,
            )
    return append_local_links(project, owner, project.intent.dependencies, "", owners, links)


def append_local_links(
    project: LocalProject,
    owner: IntakeOwner,
    dependencies: list[LocalDependency],
    environment: str,
    mut owners: list[IntakeOwner],
    mut links: list[IntakeLink],
) -> Result[None, IntakeError]:
    """Resolve one selected list and add its alias-bearing links to the intake."""
    for dependency in dependencies:
        if dependency.rust_facet:
            continue
        field = dependency_field(project, dependency, environment)
        path = Path(project.root).joinpath(dependency.path)
        selected = path.resolve().map_err(
            (error) => refusal(
                project.evidence.path, field + ["path"], IntakeErrorKind.Missing, error.message(),
            ).with_source(project.evidence.source),
        )?
        links.append(IntakeLink(requester=owner, dependency_root=selected.0, alias=dependency.alias, field=field))
        child = IntakeOwner(root=selected.0)
        if child not in owners:
            owners.append(child)
    return Ok(None)


def dependency_field(project: LocalProject, dependency: LocalDependency, environment: str) -> list[str]:
    """Point to the local path's declaration, including an override that supplies a different path."""
    field = ["dependencies", dependency.alias]
    if environment == "":
        return field
    for base in project.intent.dependencies:
        if base.alias == dependency.alias and base.path == dependency.path:
            return field
    return ["envs", environment] + field


def verify_acyclic(
    owners: list[IntakeOwner],
    links: list[IntakeLink],
    projects: list[LocalProject],
    positions: Dict[str, int],
) -> Result[None, IntakeError]:
    """Check unit cycles while permitting a Test root to reach its production counterpart through a fixture."""
    mut graph = Dag[str]()
    mut nodes: Dict[str, NodeId] = {}
    for owner in owners:
        identity = owner.identity()
        nodes[identity] = graph.add_node(owner.root)
    for link in links:
        child = nodes[link.dependency_root]
        parent = nodes[link.requester.identity()]
        if not graph.contains_edge(child, parent):
            graph.add_edge(child, parent).map_err(
                (error) => cycle_refusal(projects[positions[link.requester.root]], link.field, error.message()),
            )?
    return Ok(None)


def cycle_refusal(project: LocalProject, field: list[str], detail: str) -> IntakeError:
    """Report the attempted cycle at the requester's selected manifest edge."""
    return refusal(project.evidence.path, field, IntakeErrorKind.Cycle, detail).with_source(project.evidence.source)
