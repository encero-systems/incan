"""Read local Loaf intent without selecting Rust versions or authorizing compilation."""

from std.toml import TomlValue
from std.fs import Path
from std.graph import Dag, NodeId
from manifest_errors import IntakeError, IntakeErrorKind
from pub::incan_platform.trace import Operation
from jec import begin, record
from observation import observe
from rust::std::rc import Rc
from rust::std::cell import RefCell
from rust::std::ops import DerefMut
from manifest_intent import (
    ManifestEvidence,
    ManifestSnapshot,
    ProjectIntent,
    decoded_manifest,
    intent_from_snapshot,
    refusal,
    table,
)


pub model LocalProject:
    """One canonical local root and its separate evidence and effective intent."""

    pub root: str
    pub evidence: ManifestEvidence
    pub intent: ProjectIntent
    # The same parse used for intent, retained for dependency and Rust-facet views.
    pub parsed: TomlValue


pub model DependencyEdge:
    """Preserve requester and authored alias even when two aliases reach one package."""

    pub requester_root: str
    pub alias: str
    pub dependency_root: str


pub model LocalIntake:
    """A local topology only; every native selection still needs admitted compiler facts."""

    pub projects: list[LocalProject]
    pub edges: list[DependencyEdge]


model ManifestReading:
    """A parsed snapshot bound to the unchanged filesystem generation it was read from."""

    stamp: str
    snapshot: ManifestSnapshot


model ManifestStore:
    """Mutable memo state owned by one preparation context, never by process-global collection storage."""

    pub manifests: Dict[str, ManifestReading] = {}
    pub projects: Dict[str, LocalProject] = {}


pub model ManifestReader:
    """One preparation's shared source readings; cloning its handle never snapshots the memo's document trees."""

    pub state: Rc[RefCell[ManifestStore]] = Rc.new(RefCell.new(ManifestStore()))


pub def read_manifest_snapshot(
    root: Path,
    reader: ManifestReader = ManifestReader(),
) -> Result[ManifestSnapshot, IntakeError]:
    """
    Read and parse one file generation for the current command, without imposing project-intent policy.

    Reuse requires the same filesystem identity. A rewrite or replacement is read again, a missing file refuses,
    and a generation changed during the read never enters the snapshot table. The caller owns the context's lifetime.
    """
    mut held = reader.state.as_ref().borrow_mut()
    return snapshot_in(root, held.deref_mut())


def snapshot_in(root: Path, mut store: &mut ManifestStore) -> Result[ManifestSnapshot, IntakeError]:
    """Read or recall a snapshot while holding the preparation's one mutable memo view."""
    manifest = root.joinpath("loaf.toml")
    observed = observe(manifest).map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, error))?
    if manifest.0 in store.manifests:
        previous = store.manifests[manifest.0]
        if previous.stamp == observed.stamp:
            return Ok(previous.snapshot)
    clock = begin()
    raw = manifest.read_bytes().map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, error.message()))?
    record(Operation.FileRead, manifest.0, clock, len(raw))
    snapshot = decoded_manifest(raw, manifest.0)?
    current = observe(manifest).map_err((error) => refusal(manifest.0, [], IntakeErrorKind.Missing, error))?
    if current.stamp == observed.stamp:
        store.manifests[manifest.0] = ManifestReading(stamp=observed.stamp, snapshot=snapshot)
    return Ok(snapshot)


pub def read_project(root: Path, reader: ManifestReader = ManifestReader()) -> Result[LocalProject, IntakeError]:
    """Normalize one parsed generation once, preserving its raw evidence and the independent parsed view."""
    snapshot = read_manifest_snapshot(root, reader)?
    mut held = reader.state.as_ref().borrow_mut()
    return project_in(root, snapshot, held.deref_mut())


def project_in(
    root: Path,
    snapshot: ManifestSnapshot,
    mut store: &mut ManifestStore,
) -> Result[LocalProject, IntakeError]:
    """Normalize an exact snapshot once within the caller-owned preparation context."""
    if root.0 in store.projects:
        previous = store.projects[root.0]
        if previous.evidence.sha256_digest == snapshot.evidence.sha256_digest:
            return Ok(previous)
    intent = intent_from_snapshot(snapshot)?
    project = LocalProject(root=root.0, intent=intent, evidence=snapshot.evidence, parsed=snapshot.parsed)
    store.projects[root.0] = project
    return Ok(project)


pub def source_root_of(project: LocalProject) -> str:
    """The declared source root, otherwise `src` when present, otherwise the project root."""
    return source_root_for(Path(project.root), project.intent)


def source_root_for(root: Path, intent: ProjectIntent) -> str:
    """Apply source-root policy to an already read intent without rediscovering the manifest."""
    if let Some(declared) = intent.source_root:
        return root.joinpath(declared).0
    if root.joinpath("src").is_dir():
        return root.joinpath("src").0
    return root.0


pub def library_source(root: Path, reader: ManifestReader = ManifestReader()) -> Result[Path, str]:
    """Locate an Incan library through the same source-root policy as its compiler unit."""
    project = read_project(root, reader).map_err((error) => error.message())?
    return Ok(Path(source_root_of(project)).joinpath("lib.incn"))


pub def load_project(root: Path, reader: ManifestReader = ManifestReader()) -> Result[LocalProject, IntakeError]:
    """Validate script paths against one snapshot; conventional libraries and test-only packages need no script."""
    project = read_project(root, reader)?
    intent = project.intent
    source = project.evidence.source
    manifest = root.joinpath("loaf.toml")
    for script in intent.scripts.keys():
        path = root.joinpath(intent.scripts[script])
        if not path.is_file():
            return Err(
                refusal(manifest.0, ["project", "scripts", script], IntakeErrorKind.Missing, path.0).with_source(source),
            )
        resolved = path
            .resolve()
            .map_err(
                (error) => refusal(manifest.0, ["project", "scripts", script], IntakeErrorKind.Invalid, error.message()),
            )?
        library = Path(source_root_for(root, intent)).joinpath("lib.incn")
        if library.is_file():
            canonical = library
                .resolve()
                .map_err(
                    (error) => refusal(
                        manifest.0,
                        ["project", "scripts", script],
                        IntakeErrorKind.Invalid,
                        error.message(),
                    ),
                )?
            if resolved.0 == canonical.0:
                return Err(
                    refusal(
                        manifest.0,
                        ["project", "scripts", script],
                        IntakeErrorKind.Invalid,
                        "script resolves to conventional library",
                    ).with_source(source),
                )
    if declares_no_entry(root, intent):
        return Err(
            refusal(
                manifest.0,
                ["project", "scripts"],
                IntakeErrorKind.Missing,
                "expected a conventional library or explicit script",
            ),
        )
    return Ok(project)


def declares_no_entry(root: Path, intent: ProjectIntent) -> bool:
    """
    Whether a project has no script, no conventional library in either language and no `tests` directory: an Incan
    `lib.incn` under its source root, or a Rust `src/lib.rs`.
    """
    incan_library = Path(source_root_for(root, intent)).joinpath("lib.incn").is_file()
    has_library = incan_library or root.joinpath("src/lib.rs").is_file()
    return len(intent.scripts) == 0 and not has_library and not root.joinpath("tests").is_dir()


pub def intake(root: Path, reader: ManifestReader = ManifestReader()) -> Result[LocalIntake, IntakeError]:
    """
    Read reachable local package requests and return their dependency-first topology.

    Authored aliases remain separate edges even when they select the same canonical local path. Graph handles are
    temporary traversal state. The returned request packet contains no selected Rust version, admitted compiler
    inputs or build plan; those require checked provider facts from the host boundary.

    Args:
        root: Existing project directory whose loaf.toml starts the local dependency closure.

    Returns:
        Local projects, alias-bearing edges and dependency order, or a refusal for unsupported or missing intent.

    Example:
        packet = intake(Path("../../workbench/app"))?
        assert len(packet.projects) == 3
    """
    canonical = root.resolve().map_err((error) => refusal(root.0, [], IntakeErrorKind.Missing, error.message()))?
    mut roots: list[str] = [canonical.0]
    mut projects: list[LocalProject] = []
    mut edges: list[DependencyEdge] = []
    mut index = 0
    while index < len(roots):
        project = load_project(Path(roots[index]), reader)?
        for dependency in project.intent.dependencies:
            if dependency.rust_facet:
                continue
            path = Path(project.root).joinpath(dependency.path)
            selected = path
                .resolve()
                .map_err(
                    (error) => refusal(
                        project.evidence.path,
                        ["dependencies", dependency.alias, "path"],
                        IntakeErrorKind.Missing,
                        error.message(),
                    ).with_source(project.evidence.source),
                )?
            edges.append(DependencyEdge(requester_root=project.root, alias=dependency.alias, dependency_root=selected.0))
            if selected.0 not in roots:
                roots.append(selected.0)
        projects.append(project)
        index += 1
    mut graph = Dag[str]()
    mut nodes: Dict[str, NodeId] = {}
    mut sources: Dict[str, str] = {}
    for project in projects:
        nodes[project.root] = graph.add_node(project.root)
        sources[project.root] = project.evidence.source
    for edge in edges:
        if not graph.contains_edge(nodes[edge.dependency_root], nodes[edge.requester_root]):
            graph
                .add_edge(nodes[edge.dependency_root], nodes[edge.requester_root])
                .map_err(
                    (error) => refusal(
                        Path(edge.requester_root).joinpath("loaf.toml").0,
                        ["dependencies", edge.alias],
                        IntakeErrorKind.Cycle,
                        error.message(),
                    ).with_source(sources[edge.requester_root]),
                )?
    return Ok(LocalIntake(projects=projects, edges=edges))
