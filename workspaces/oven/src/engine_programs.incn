"""The E1a unit-record producer: obtain today's whole native unit and select its exact payload in a project view."""

from std.fs import Path
from std.environ import get_or
from std.primitives.locking import LockGuard
from rust::std::rc import Rc
from engine_capture import BuildEpoch, InputRole
from std.json import JsonValue, parse
from bakery import find, fact_file
from bakery_records import Fact
from bakery_roots import register_root
from compiler_body_publication import prepare_captured_source_inputs, prepare_compiled_bodies, source_origin
from compiler_body_values import (
    body_owners_reading,
    encode_body_inventory,
    invalid_namespace_modules,
    select_body_inventory_except,
    select_namespace_inventory_except,
)
from compiler_plan_values import select_plan_inventory_except, plan_owners_reading
from engine_epochs import record_text, load_epoch
from features import FeatureRequest
from files import json_text
from incan_units import obtain_executable, program_binary, executable_view, view_executable
from json_fields import required_text
from pub::incan_platform.store import EXPECT_ABSENT, Snapshot, Transaction, begin, commit, put
from store_path_conversion import snapshot
from toolchain import load_toolchain, toolchain_directory
from unit import describe
from unit_compiler import graph_body_output_path, plan_record_counts, plan_record_report_path
from unit_rust import prepare_native
from unit_freshness import Key, fingerprint, unit_key
from observation import FileMetadata, file_metadata
from shared_link import development_link, linkage_key, library_witness
from jec import begin as begin_work, record as record_work
from pub::incan_platform.trace import Operation
from pub::internal_models.checker_records import CHECKER_PROFILE

const SCHEMA: str = "incan.engine.native-unit/1"


@derive(Eq)
pub model NativeUnit:
    """An exact unit record and executable payload; output location is selection provenance, never unit identity."""

    pub identity: str
    pub payload: str
    pub binary: str

    pub def encoded(self) -> Result[str, str]:
        """The language-neutral native descriptor stored in a caller's virtual view."""
        return json_text(
            JsonValue.object(
                {"schema": JsonValue.string(SCHEMA), "unit": JsonValue.string(self.identity), "payload": JsonValue.string(
                    self.payload,
                ), "binary": JsonValue.string(self.binary)},
            ),
        )


pub model ProgramOutcome:
    """One caller's selection and the whole-unit producer work performed for it."""

    pub code: i32
    pub unit: Option[NativeUnit] = None
    pub evaluations: int = 0
    pub body_evaluations: int = 0
    pub body_ir_evaluations: int = 0
    pub native_bakes: int = 0
    pub plan_function_evaluations: int = 0
    pub plan_function_reuses: int = 0
    pub lowering_demand_evaluations: int = 0
    pub lowering_demand_reuses: int = 0
    pub native_interface_evaluations: int = 0
    pub console: str = ""
    pub epoch_reads: int = 0
    pub transaction: Option[Transaction] = None
    pub claim: Option[Rc[LockGuard]] = None


pub model NativeSelection:
    """The exact selected view and the encoding and publication work needed to select it."""

    pub snapshot: Snapshot
    pub encodings: int = 1
    pub commits: int = 1
    pub transaction: Option[Transaction] = None


pub def obtain(
    store: Path,
    revision: str,
    handle: str,
    console: str,
    captured: Option[BuildEpoch] = None,
    producer: str = "",
) -> Result[ProgramOutcome, str]:
    """
    Ask for a unit record, using the existing RFC 124 producer on a miss.

    1. Read a previously finalized native descriptor without preparing frozen inputs again.
    2. Otherwise read the captured epoch, describe the program and finalize its RFC 124 identity.
    3. Obtain its executable through the bakery's claim, recheck, worker compilation and publication path.
    4. Return the descriptor after checking capture; caller selection publishes it in the caller's view.
    """
    listing_refusals = get_or("OVEN_BODY_REFUSALS", "default") == "list"
    # 1. A hit uses the same whole-unit record as the legacy producer, without another compiler activation.
    # Refusal diagnosis must reach the checker: an earlier successful descriptor contains no refusal evidence.
    if not listing_refusals:
        match read_program(store, handle)?:
            Some(unit) =>
                restore_program(store, unit)?
                return Ok(ProgramOutcome(code=0, unit=Some(unit)))
            None => pass
    # 2. Unsupported roots refuse explicitly; this producer does not pretend to expose declaration records.
    opening = begin_work()
    mut epoch_reads = 0
    if captured is None:
        epoch_reads = 1
    epoch = request_epoch(store, revision, captured, handle)?
    record_work(Operation.EngineEpoch, revision, opening)
    if len(epoch.roots) != 1:
        return Err("unit records require exactly one program root")
    selector = standalone_selector(epoch, producer)?
    if not listing_refusals:
        if let Some(unit) = indexed_program(store, epoch, selector)?:
            restore_program(store, unit)?
            return Ok(ProgramOutcome(code=0, unit=Some(unit), epoch_reads=epoch_reads))
    preparing = begin_work()

    mut toolchain = load_toolchain()?
    toolchain.console = console
    described = describe(
        Path(epoch.roots[0]),
        epoch.selection.profile,
        FeatureRequest(),
        selected_toolchain=Some(toolchain),
    )?
    if (
        described.kind != "program"
        or described.vocabulary
        or len(described.contract_models) > 0
        or len(described.c_headers) > 0
    ):
        return Err("unit records currently support ordinary program units without vocabulary or foreign headers")
    ready = prepare_native(described, toolchain)?
    compiled_key = unit_key(ready, toolchain)?
    if compiled_key.refusal != "":
        return Err(compiled_key.refusal)
    # Diagnosis has a separate native identity: a normal successful unit is not proof that all bodies were rechecked.
    mut native_key = compiled_key
    if listing_refusals:
        native_key = refusal_diagnostic_key(compiled_key)?
    # Build and run ask for the same debug program, including its existing shared native linkage policy.
    key = linkage_key(native_key, development_link(ready, true))?
    binary = program_binary(ready)
    record_work(Operation.EnginePrepare, epoch.roots[0], preparing)
    # 3. Exactly one existing producer owns claiming and publishing a native unit.
    graph = snapshot(store).map_err((error) => error.message())?
    projected = prepare_captured_source_inputs(graph, begin(graph), ready, epoch.inputs)?
    mut invalid = body_owners_reading(graph, projected.keys, CHECKER_PROFILE)?
    origin = source_origin(ready)
    if listing_refusals:
        invalid = [record.identity for record in select_body_inventory_except(graph, CHECKER_PROFILE, origin, [])?]
    invalid_namespaces = invalid_namespace_modules(graph, projected.keys, CHECKER_PROFILE)?
    retained_bodies = select_body_inventory_except(graph, CHECKER_PROFILE, origin, invalid)?
    mut selected_bodies = encode_body_inventory(retained_bodies)?
    selected_bodies.extend(select_namespace_inventory_except(graph, CHECKER_PROFILE, origin, invalid_namespaces)?)
    # Lowering revalidates its exact checked inputs; a changed raw source slice may still produce equal meaning.
    invalid_plans = plan_owners_reading(graph, projected.keys)?
    selected_bodies.extend(select_plan_inventory_except(graph, invalid_plans)?)
    produced = obtain_executable(ready, toolchain, binary, native_key, true, Some(store), true, Some(selected_bodies))?
    plan_counts = plan_record_counts(ready, compiled_key)?
    if produced.code != 0:
        return Ok(
            ProgramOutcome(
                code=produced.code,
                evaluations=produced.evaluations,
                body_evaluations=len(invalid),
                console=console,
                epoch_reads=epoch_reads,
                plan_function_evaluations=plan_counts.plan_evaluations,
                plan_function_reuses=plan_counts.plan_reuses,
                lowering_demand_evaluations=plan_counts.lowering_demand_evaluations,
                lowering_demand_reuses=plan_counts.lowering_demand_reuses,
            ),
        )
    # 4. Source edits cannot certify a native unit for a different captured epoch.
    installed = toolchain_directory()?.0
    for input in epoch.inputs:
        if frozen_path(input.path, installed, toolchain.sysroot):
            continue
        if not captured_file_current(Path(input.path), input.metadata):
            return Err("captured inputs changed before native selection; submit a new request")
    mut request_transaction = merge_request_transaction(produced.transaction, projected.transaction)
    mut body_evaluations = 0
    mut body_ir_evaluations = 0
    if produced.native_bakes == 1:
        bodies = prepare_compiled_bodies(
            request_transaction,
            ready,
            graph_body_output_path(ready, compiled_key),
            Some(plan_record_report_path(ready, compiled_key)),
            Some(graph),
            retained_bodies,
        )?
        request_transaction = bodies.transaction
        body_evaluations = bodies.checking_evaluations
        body_ir_evaluations = bodies.body_ir_evaluations
    fact = produced_fact(produced.fact)?
    unit = NativeUnit(identity=key.digest, payload=executable_payload(fact, binary.name())?, binary=binary.0)
    return Ok(
        ProgramOutcome(
            code=0,
            unit=Some(unit),
            evaluations=produced.evaluations,
            body_evaluations=body_evaluations,
            body_ir_evaluations=body_ir_evaluations,
            native_bakes=produced.native_bakes,
            plan_function_evaluations=plan_counts.plan_evaluations,
            plan_function_reuses=plan_counts.plan_reuses,
            lowering_demand_evaluations=plan_counts.lowering_demand_evaluations,
            lowering_demand_reuses=plan_counts.lowering_demand_reuses,
            native_interface_evaluations=plan_counts.native_interface_evaluations,
            console=console,
            epoch_reads=epoch_reads,
            transaction=index_program(store, selector, unit, Some(request_transaction))?,
            claim=produced.claim,
        ),
    )


def refusal_diagnostic_key(key: Key) -> Result[Key, str]:
    """Keep list-mode compiler evidence separate from an ordinary reusable native unit."""
    domain = "incan.body-refusal-list-native/1"
    return Ok(
        Key(
            digest="sha256:" + fingerprint([domain, key.digest])?,
            parts=key.parts + [f"diagnostic {domain}"],
            codegen=key.codegen,
            provenance=key.provenance,
            descriptor=key.descriptor,
        ),
    )


def merge_request_transaction(native: Option[Transaction], source: Transaction) -> Transaction:
    """Combine prepared native payload records and captured source projections under one request publication."""
    match native:
        None => return source
        Some(value) =>
            mut combined = value
            combined.writes.extend(source.writes)
            combined.payloads.extend(source.payloads)
            return combined


pub def select_program(store: Path, view: str, unit: NativeUnit, handle: str) -> Result[NativeSelection, str]:
    """Commit a standalone selection through the engine's shared preparation boundary."""
    mut selection = prepare_selection(store, view, unit, handle)?
    if let Some(transaction) = selection.transaction:
        selection.snapshot = commit(transaction).map_err((error) => error.message())?
    return Ok(selection)


pub def prepare_selection(store: Path, view: str, unit: NativeUnit, handle: str) -> Result[NativeSelection, str]:
    """Stage the descriptor and its caller selection; an equal selection encodes and publishes nothing."""
    if program_view(handle)? != view:
        return Err("native descriptor belongs to a different project view")
    selected = snapshot(store, view).map_err((error) => error.message())?
    if record_text(selected, "incan.engine.selected-native-unit/2")? == Some(handle):
        match record_text(selected, program_key(handle))?:
            None => return Err("selected native descriptor is missing")
            Some(text) =>
                if decoded_program(text)? == unit:
                    return Ok(NativeSelection(snapshot=selected, encodings=0, commits=0))
    mut transaction = begin(selected)
    transaction = put(transaction, program_key(handle), unit.encoded()?.encode("utf-8"))
    transaction = put(transaction, "incan.engine.selected-native-unit/2", handle.encode("utf-8"))
    return Ok(NativeSelection(snapshot=selected, transaction=Some(transaction)))


pub def program_handle(epoch: str, producer: str, view: str) -> Result[str, str]:
    """The opaque handle of a captured program's native descriptor, kept apart from its RFC 124 unit identity."""
    return Ok(f"program:{fingerprint(["incan.engine.program/3", epoch, producer])?}:{view}")


pub def read_program(store: Path, handle: str) -> Result[Option[NativeUnit], str]:
    """Read one finalized descriptor by handle; damaged schema and missing selected payloads refuse."""
    view = program_view(handle)?
    return selected_program(snapshot(store, view).map_err((error) => error.message())?, handle)


pub def selected_program(selected: Snapshot, handle: str) -> Result[Option[NativeUnit], str]:
    """Read a descriptor from the exact immutable view whose generation the execution pin protects."""
    if selected.view != program_view(handle)?:
        return Err("native program handle belongs to another virtual view")
    match record_text(selected, program_key(handle))?:
        None => return Ok(None)
        Some(text) => return Ok(Some(decoded_program(text)?))


def program_view(handle: str) -> Result[str, str]:
    """Decode only the bounded view locator of an opaque handle; it is never a compilation identity input."""
    if len(handle) < 74 or not handle.startswith("program:") or handle[72:73] != ":":
        return Err("invalid native program handle")
    for character in handle[8:72]:
        if character not in "0123456789abcdef":
            return Err("invalid native program identity")
    return Ok(handle[73:])


def decoded_program(text: str) -> Result[NativeUnit, str]:
    """Validate the single native descriptor schema for both immutable records and selected view bindings."""
    value = parse(text).map_err((error) => error.message())?
    if required_text(value, "schema")? != SCHEMA:
        return Err("unsupported native unit descriptor")
    return Ok(
        NativeUnit(
            identity=required_text(value, "unit")?,
            payload=required_text(value, "payload")?,
            binary=required_text(value, "binary")?,
        ),
    )


pub def restore_program(store: Path, unit: NativeUnit) -> Result[None, str]:
    """Validate the selected immutable unit and restore only missing or changed derived executable views."""
    fact = unit_record(store, unit)?
    return view_executable(store, fact, Path(unit.binary), "program", loader_witness(store, fact, unit) is not None)


def unit_record(store: Path, unit: NativeUnit) -> Result[Fact, str]:
    """Verify the exact executable payload; its immutable record already admitted native loader generations."""
    fact = required_unit(store, unit.identity)?
    if executable_payload(fact, Path(unit.binary).name())? != unit.payload:
        return Err("selected native payload disagrees with its unit record")
    return Ok(fact)


def loader_witness(store: Path, fact: Fact, unit: NativeUnit) -> Option[Path]:
    """Resolve the loader witness through this unit's immutable payload binding, never an ambient path."""
    binary = Path(unit.binary)
    return fact_file(store, fact, library_witness(Path(binary.name())).0)


def required_unit(store: Path, identity: str) -> Result[Fact, str]:
    """A selected unit must exist; absence after descriptor publication is a store failure, never a rebake."""
    match find(store, identity)?:
        Some(fact) => return Ok(fact)
        None => return Err("selected native unit record is missing")


def executable_payload(fact: Fact, name: str) -> Result[str, str]:
    """The payload identity of the descriptor's executable, excluding sidecars and debug files."""
    for file in fact.files:
        if file.path == name and file.program:
            return Ok(file.digest)
    return Err("unit record does not contain the selected executable")


def program_key(handle: str) -> str:
    """The one record family that maps captured program inputs to a finalized native descriptor."""
    return f"incan.engine.native-unit\t{handle}"


def captured_file_current(path: Path, recorded: FileMetadata) -> bool:
    """Refuse a file replaced while compilation ran; this observation never enters compilation identity."""
    match file_metadata(path):
        Ok(Some(found)) => return found == recorded
        _ => return false


def frozen_path(path: str, installed: str, sysroot: str) -> bool:
    """Whether an obsolete captured row belongs to an installation already admitted as immutable."""
    return path == installed or path.startswith(installed + "/") or path == sysroot or path.startswith(sysroot + "/")


def request_epoch(store: Path, revision: str, captured: Option[BuildEpoch], handle: str) -> Result[BuildEpoch, str]:
    """Use this activation's captured inputs, or open a previously committed capture."""
    match captured:
        Some(epoch) => return Ok(epoch)
        None => return load_epoch(store, revision, program_view(handle)?)


def produced_fact(found: Option[Fact]) -> Result[Fact, str]:
    """A successful native producer must return its exact staged or committed fact."""
    match found:
        Some(fact) => return Ok(fact)
        None => return Err("producer completed without a native fact")


def standalone_selector(epoch: BuildEpoch, producer: str) -> Result[Option[str], str]:
    """
    Index an exact standalone input selection without redefining its native unit identity.

    Only manifest-free units wholly inside their file's directory qualify. Logical names, exact input bytes, the
    installed pin, profile and admitted compiler select an already finalized RFC 124 record. Any broader input shape
    takes the existing producer path. Metadata, projection paths and absent ancestor manifests do not affect a unit.
    """
    if producer == "" or len(epoch.roots) != 1 or get_or("INCAN_STDLIB", "") != "":
        return Ok(None)
    source = Path(epoch.roots[0])
    prefix = source.parent().0 + "/"
    mut inputs = ["incan.engine.standalone-inputs/2", producer, source.name(), epoch.selection.profile]
    inputs.extend([f"admitted:{item}" for item in epoch.admitted])
    mut bindings: list[str] = []
    for input in epoch.inputs:
        if input.role == InputRole.ToolchainPin:
            bindings.append(f"toolchain-pin:{input.path}:{input.digest}")
        elif input.path.startswith(prefix) and input.role in [InputRole.Root, InputRole.Member, InputRole.Resolved]:
            bindings.append(f"{input.role.value()}:{input.path[len(prefix):]}:{input.digest}")
        else:
            return Ok(None)
    for absent in epoch.absent:
        if Path(absent.path).name() != "loaf.toml":
            return Ok(None)
    for listing in epoch.listings:
        if not (listing.path == source.parent().0 or listing.path.startswith(prefix)):
            return Ok(None)
        names = [listing.path[len(source.parent().0):]]
        contents = names + [f"file:{name}" for name in listing.files] + [f"directory:{name}" for name in listing.directories]
        bindings.append(f"listing:{fingerprint(contents)?}")
    return Ok(Some(f"incan.engine.standalone-program\t{fingerprint(inputs + sorted(bindings))?}"))


def indexed_program(store: Path, epoch: BuildEpoch, selector: Option[str]) -> Result[Option[NativeUnit], str]:
    """Resolve a finalized unit index and give its executable the requesting project's ordinary projection path."""
    match selector:
        None => return Ok(None)
        Some(key) =>
            match record_text(snapshot(store).map_err((error) => error.message())?, key)?:
                None => return Ok(None)
                Some(encoded) =>
                    unit = decoded_program(encoded)?
                    if unit.binary in ["", ".", ".."] or Path(unit.binary).name() != unit.binary:
                        return Err("standalone native index contains an invalid executable name")
                    register_root(store, Path(epoch.roots[0]).parent().0, f"program\t{unit.binary}", [unit.identity])?
                    binary = executable_view(Path(epoch.roots[0]).parent(), epoch.selection.profile, "bin", unit.binary)
                    return Ok(Some(NativeUnit(identity=unit.identity, payload=unit.payload, binary=binary.0)))


def index_program(
    store: Path,
    selector: Option[str],
    unit: NativeUnit,
    native: Option[Transaction],
) -> Result[Option[Transaction], str]:
    """Add a path-independent finalized-unit index to the same atomic request, never a second publication."""
    match selector:
        None => return Ok(native)
        Some(key) =>
            mut transaction = begin(snapshot(store).map_err((error) => error.message())?)
            if let Some(prepared) = native:
                transaction = prepared
            descriptor = NativeUnit(identity=unit.identity, payload=unit.payload, binary=Path(unit.binary).name())
            return Ok(Some(put(transaction, key, descriptor.encoded()?.encode("utf-8"), EXPECT_ABSENT)))
