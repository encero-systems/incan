"""Focused closed-envelope tests for the selected Rust graph policy exchange."""

from std.json import JsonValue
from std.testing import fail, fail_t
from core_engine import evaluate as evaluate_core
from rust_policy_exchange import evaluate


def request(
    role: str = "library",
    extra: str = "",
    schema: str = "incan.oven.rust-policy-exchange/5",
    operation: str = "validate_selected_rust_graph",
    intent_owner: str = "sha256:project-authority",
    malformed_closure: bool = false,
    sensitive_environment: bool = false,
    unsupported_sysroot_extern: bool = false,
    duplicate_sysroot_extern: bool = false,
    unsorted_generated_members: bool = false,
    inconsistent_generated_digest: bool = false,
    invalid_provider_members: bool = false,
    empty_generated_input: bool = false,
) -> str:
    """One exact selected leaf; the manifest digest is SHA-256 of empty bytes."""
    mut closure = JsonValue.object(
        {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([])},
    )
    if malformed_closure:
        closure = JsonValue.object({"environment": JsonValue.object({})})
    elif sensitive_environment:
        closure = JsonValue.object(
            {"environment": JsonValue.object(
                {"DEP_TOKEN": JsonValue.object(
                    {"kind": JsonValue.string("sensitive_digest"), "hmac_sha256": JsonValue.string("sha256:token")},
                )},
            ), "generated_inputs": JsonValue.array([]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([])},
        )
    elif unsupported_sysroot_extern:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([JsonValue.string("std")])},
        )
    elif duplicate_sysroot_extern:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([JsonValue.string("proc_macro"), JsonValue.string("proc_macro")])},
        )
    elif unsorted_generated_members:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([JsonValue.object(
                {"name": JsonValue.string("generated"), "source": JsonValue.object({"owner": JsonValue.string("sha256:generated"), "path": JsonValue.string("out")}), "digest": JsonValue.string("sha256:declared"), "members": JsonValue.array([
                    JsonValue.object({"path": JsonValue.string("z.rs"), "digest": JsonValue.string("sha256:z")}),
                    JsonValue.object({"path": JsonValue.string("a.rs"), "digest": JsonValue.string("sha256:a")}),
                ])},
            )]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([])},
        )
    elif inconsistent_generated_digest:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([JsonValue.object(
                {"name": JsonValue.string("generated"), "source": JsonValue.object({"owner": JsonValue.string("sha256:generated"), "path": JsonValue.string("out")}), "digest": JsonValue.string("sha256:not-the-member-catalog"), "members": JsonValue.array([
                    JsonValue.object({"path": JsonValue.string("a.rs"), "digest": JsonValue.string("sha256:a")}),
                ])},
            )]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([])},
        )
    elif invalid_provider_members:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([]), "linked_libraries": JsonValue.array([JsonValue.object(
                {"input": JsonValue.string("provider"), "name": JsonValue.string("Fixture"), "kind": JsonValue.string("system"), "provider": JsonValue.string("sha256:provider"), "target": JsonValue.string("x86_64-unknown-linux-gnu"), "capability": JsonValue.string("fixture.system"), "receipt_identity": JsonValue.string("sha256:receipt"), "provenance": JsonValue.object({"owner": JsonValue.string("sha256:provider"), "path": JsonValue.string("provenance.json")}), "provenance_digest": JsonValue.string("sha256:provenance"), "search_root": JsonValue.object({"owner": JsonValue.string("sha256:provider"), "path": JsonValue.string("providers")}), "artifact": JsonValue.object({"owner": JsonValue.string("sha256:provider"), "path": JsonValue.string("providers/libfixture.a")}), "digest": JsonValue.string("sha256:artifact"), "members": JsonValue.array([
                    JsonValue.object({"path": JsonValue.string("z.a"), "digest": JsonValue.string("sha256:z")}),
                    JsonValue.object({"path": JsonValue.string("libfixture.a"), "digest": JsonValue.string("sha256:artifact")}),
                ])},
            )]), "sysroot_externs": JsonValue.array([])},
        )
    elif empty_generated_input:
        closure = JsonValue.object(
            {"environment": JsonValue.object({}), "generated_inputs": JsonValue.array([JsonValue.object(
                {"name": JsonValue.string("empty-generated"), "source": JsonValue.object({"owner": JsonValue.string("sha256:generated"), "path": JsonValue.string("out")}), "digest": JsonValue.string("sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"), "members": JsonValue.array([])},
            )]), "linked_libraries": JsonValue.array([]), "sysroot_externs": JsonValue.array([])},
        )
    mut document: Dict[str, JsonValue] = {"schema": JsonValue.string(schema), "operation": JsonValue.string(operation), "graph_digest": JsonValue.string(
        "sha256:selected-graph",
    ), "context": JsonValue.object(
        {"host": JsonValue.object({"triple": JsonValue.string("x86_64-unknown-linux-gnu"), "cfg": JsonValue.null()}), "target": JsonValue.object(
            {"triple": JsonValue.string("x86_64-unknown-linux-gnu"), "cfg": JsonValue.null()},
        ), "selection_purpose": JsonValue.string("normal")},
    ), "units": JsonValue.array(
        [JsonValue.object(
            {"identity": JsonValue.string("sha256:root-unit"), "package": JsonValue.object(
                {"name": JsonValue.string("root"), "version": JsonValue.string("1.0.0"), "source": JsonValue.string(
                    "path:root",
                )},
            ), "domain": JsonValue.string("target"), "role": JsonValue.string(role), "crate_kind": JsonValue.string(
                "rlib",
            ), "closure": closure, "features": JsonValue.array([])},
        )],
    ), "roots": JsonValue.array([JsonValue.object(
        {"unit": JsonValue.string("sha256:root-unit"), "requested_features": JsonValue.array([]), "default_features": JsonValue.bool(
            true,
        ), "intent_owner": JsonValue.string(intent_owner)},
    )]), "bindings": JsonValue.array(
        [],
    ), "catalogs": JsonValue.array(
        [JsonValue.object(
            {"package": JsonValue.object(
                {"name": JsonValue.string("root"), "version": JsonValue.string("1.0.0"), "source": JsonValue.string(
                    "path:root",
                )},
            ), "owner": JsonValue.string("sha256:project-owner"), "intent_owner": JsonValue.string(
                "sha256:project-authority",
            ), "package_root": JsonValue.string("root"), "members": JsonValue.array(
                [JsonValue.string("Cargo.toml"), JsonValue.string("src/lib.rs")],
            ), "build_unit_present": JsonValue.bool(false), "manifest": JsonValue.object(
                {"path": JsonValue.string("Cargo.toml"), "bytes_hex": JsonValue.string(""), "sha256_hex": JsonValue.string(
                    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                )},
            )},
        )],
    ), "max_rounds": JsonValue.int(8)}
    if extra != "":
        document["unexpected"] = JsonValue.bool(true)
    match JsonValue.object(document).to_json():
        Ok(value) => return value
        Err(error) => return fail_t[str](error.message())


def status(response: JsonValue) -> str:
    """Return the closed response status, or a sentinel when the response omits it."""
    match response.get("status"):
        None => return "missing"
        Some(value) =>
            match value.as_str():
                None => return "missing"
                Some(name) => return name


pub def test_selected_leaf_echoes_authenticated_graph_identity() -> None:
    """Protects echoing the host-authenticated graph identity through the selected response."""
    response = evaluate(request())
    assert status(response) == "selected"
    match response.get("graph_digest"):
        None => fail("selected response omitted graph digest")
        Some(value) =>
            assert value.as_str() == Some("sha256:selected-graph")
    match response.get("activations"):
        None => fail("selected response omitted activations")
        Some(value) =>
            match value.as_array():
                None => fail("selected response activations were not an array")
                Some(_) => pass


pub def test_selected_leaf_echoes_exact_empty_closure() -> None:
    """Protects preservation of the host-authenticated closure through policy output."""
    response = evaluate(request())
    match response.get("units"):
        None => fail("selected response omitted physical units")
        Some(value) =>
            match value.as_array():
                None => fail("selected response physical units were not an array")
                Some(units) =>
                    if len(units) != 1:
                        fail("selected response changed the physical unit count")
                    match units[0].get("closure"):
                        None => fail("selected response omitted the unit closure")
                        Some(closure) =>
                            match closure.get("linked_libraries"):
                                None => fail("selected response omitted linked closure facts")
                                Some(libraries) =>
                                    match libraries.as_array():
                                        None => fail("selected linked closure facts were not an array")
                                        Some(values) => assert len(values) == 0


pub def test_sensitive_closure_digest_is_structurally_preserved() -> None:
    """Protects the sensitive-digest wire shape without exposing a raw environment value."""
    assert status(evaluate(request(sensitive_environment=true))) == "selected"


pub def test_core_engine_dispatches_the_rust_policy_schema() -> None:
    """Protects core-engine dispatch for the closed Rust policy schema."""
    assert status(evaluate_core(request())) == "selected"


pub def test_malformed_physical_closure_refuses() -> None:
    """Protects the closure envelope from accepting incomplete physical evidence."""
    assert status(evaluate(request(malformed_closure=true))) == "refused"


pub def test_unadmitted_bare_compiler_extern_refuses() -> None:
    """Protects the captured compiler-only boundary from accepting arbitrary sysroot names."""
    assert status(evaluate(request(unsupported_sysroot_extern=true))) == "refused"


pub def test_noncanonical_sysroot_and_generated_closure_facts_refuse() -> None:
    """Reject duplicate sysroot names, unsorted generated members and a generated digest detached from its members."""
    assert status(evaluate(request(duplicate_sysroot_extern=true))) == "refused"
    assert status(evaluate(request(unsorted_generated_members=true))) == "refused"
    assert status(evaluate(request(inconsistent_generated_digest=true))) == "refused"


pub def test_provider_member_catalog_must_be_canonical_and_bind_the_selected_artifact() -> None:
    """Reject provider member catalogs that cannot prove the named selected artifact."""
    assert status(evaluate(request(invalid_provider_members=true))) == "refused"


pub def test_checked_empty_generated_tree_is_distinct_from_an_absent_generated_input() -> None:
    """Accept the canonical explicit empty generated tree without inventing a placeholder source file."""
    assert status(evaluate(request(empty_generated_input=true))) == "selected"


pub def test_unknown_top_level_field_refuses() -> None:
    """Protects strict refusal of unrecognized envelope fields."""
    assert status(evaluate(request(extra=",\"unexpected\":true"))) == "refused"


pub def test_selected_build_script_role_refuses() -> None:
    """Protects the inventory-only boundary for build-script roles."""
    assert status(evaluate(request(role="build_script"))) == "refused"


pub def test_unknown_schema_and_operation_refuse() -> None:
    """Protects strict refusal of unsupported schema and operation values."""
    assert status(evaluate(request(schema="incan.oven.rust-policy-exchange/1"))) == "refused"
    assert status(evaluate(request(schema="incan.oven.rust-policy-exchange/2"))) == "refused"
    assert status(evaluate(request(schema="incan.oven.rust-policy-exchange/3"))) == "refused"
    assert status(evaluate(request(schema="incan.oven.rust-policy-exchange/4"))) == "refused"
    assert status(evaluate(request(operation="select_again"))) == "refused"


pub def test_root_intent_owner_must_match_its_catalog_authority() -> None:
    """Protects refusal when root feature intent is detached from the admitted package authority."""
    assert status(evaluate(request(intent_owner="sha256:other-authority"))) == "refused"


pub def test_compiler_release_root_uses_its_sealed_source_catalog() -> None:
    """Admits a compiler-release root only when the exchanged catalog carries the matching authored owner."""
    assert status(evaluate(request(role="compiler_support"))) == "selected"


pub def test_compiler_release_root_refuses_a_detached_intent_owner() -> None:
    """Protects compiler-release policy from accepting feature intent outside its source-owned catalog."""
    assert status(evaluate(request(role="compiler_support", intent_owner="sha256:other-authority"))) == "refused"
