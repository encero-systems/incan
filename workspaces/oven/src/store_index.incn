"""Oven compatibility adapters for the platform store's copy-on-write index."""

from std.fs import MappedView, Path
from pub::incan_platform.store.index import Entry, IndexError, Location, Page
from pub::incan_platform.store.index import (
    build as platform_build,
    entries as platform_entries,
    find as platform_find,
    insert as platform_insert,
    page_path as platform_page_path,
    read_page as platform_read_page,
    staged_pages as platform_staged_pages,
)
from platform_store_path import oven_path, store_path


pub def page_path(root: Path, name: str) -> Path:
    """Return one index-page path through Oven's facade path type."""
    return oven_path(platform_page_path(store_path(root), name))


pub def find(root: Path, top: str, key: str) -> Result[Option[Location], IndexError]:
    """Find one key through an Oven facade path."""
    return platform_find(store_path(root), top, key)


pub def entries(root: Path, top: str) -> Result[list[Entry], IndexError]:
    """Read every leaf entry through an Oven facade path."""
    return platform_entries(store_path(root), top)


pub def read_page(root: Path, name: str) -> Result[Page, IndexError]:
    """Read one index page through an Oven facade path."""
    return platform_read_page(store_path(root), name)


pub def insert(root: Path, top: str, staged: Path, additions: list[Entry]) -> Result[str, IndexError]:
    """Insert index entries through Oven facade paths."""
    return platform_insert(store_path(root), top, store_path(staged), additions)


pub def staged_pages(staged: Path, roots: list[str]) -> Result[list[Path], IndexError]:
    """Return staged index pages as Oven facade paths."""
    return Ok([oven_path(path) for path in platform_staged_pages(store_path(staged), roots)?])


pub def build(staged: Path, leaves: list[Entry]) -> Result[str, IndexError]:
    """Build a canonical index through an Oven facade path."""
    return platform_build(store_path(staged), leaves)
