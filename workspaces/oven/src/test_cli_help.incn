"""CLI help contracts, including exact command synopses and the boundaries of help flag recognition."""

from std.testing import fail
from command_help import command_help, usage


pub def test_help_uses_each_commands_synopsis_and_respects_operands() -> None:
    """
    Check help text without loading a project, compiler or installed toolchain.

    1. Each command's detailed help begins with its documented synopsis and includes an example.
    2. The overview uses those same synopses.
    3. Program arguments, option values and unknown commands never become help requests.
    """
    commands: list[tuple[str, str]] = [
        ("run", "incan run PATH [UNIT OPTIONS] [--argv0 TEXT] [--program-entry PATH]... [-- ARGS...]"),
        ("check", "incan check PATH [--format text|json] [UNIT OPTIONS]"),
        ("explain", "incan explain CODE"),
        ("test", "incan test PATH [UNIT OPTIONS]"),
        ("describe-unit", "incan describe-unit PATH [UNIT OPTIONS]"),
        ("build", "incan build PATH [--substitute NAME=DIR]... [--program-entry PATH]... [UNIT OPTIONS]"),
        ("fmt", "incan fmt [--check] PATH..."),
        ("owner stop", "incan owner stop"),
        ("inspect codegraph", "incan inspect codegraph PATH [GRAPH OPTIONS]"),
        ("mcp", "incan mcp PATH"),
        ("toolchain pack", "incan toolchain pack OUT"),
        ("toolchain install", "incan toolchain install ARCHIVE"),
        ("--version", "incan --version"),
    ]
    for invocation, synopsis in commands:
        parts = invocation.split(" ")
        command = parts[0]
        prefix = parts[1:]
        # 1. Both help flags print this command's contract, rather than a sibling's help.
        for flag in ["--help", "-h"]:
            response: Option[str] = command_help(command, prefix + [flag])
            match response:
                None => fail(f"{synopsis}: missing help")
                Some(text) =>
                    assert text.split("\n")[0] == f"usage: {synopsis}"
                    assert "\nOptions:\n" in text
                    assert "\nExample:\n  incan " in text
        # 2. The overview and detailed help agree on the complete synopsis.
        overview: list[str] = usage().split("\n")
        assert synopsis in overview
    # 3. Help flags in value or program positions retain their ordinary meaning.
    assert command_help("run", ["src/main.incn", "--", "--help"]) == None
    assert command_help("run", ["--argv0", "--help", "src/main.incn"]) == None
    assert command_help("check", ["--profile", "--help", "src/main.incn"]) == None
    assert command_help("fmt", ["--", "--help"]) == None
    assert command_help("inspect", ["codegraph", ".", "--query", "defs", "--help"]) == None
    assert command_help("nonexistent", ["--help"]) == None
    assert command_help("owner", ["nonexistent", "--help"]) == None
