"""Owner protocol contracts: frames are bounded and self-checking, and a bad one never harms the next."""

from rust::std::io import Write
from rust::std::os::unix::net import UnixStream
from std.json import JsonValue, parse
from std.fs import Path
from pub::incan_platform.trace import (
    SCHEMA,
    Emitter,
    Operation,
    MAX_TEXT,
    TraceError,
    Counters,
    begin as trace_begin,
    complete,
    encode,
    record,
    append as trace_append,
    flush as flush_trace,
    MAX_RECORD,
)
from pub::incan_platform.ipc import MAX_FRAME, dial, length_of, listen, padded
from owner_protocol import Reply, Request, receive_document, reply_of, request_of, send_document
from scratch import scratch_directory
from jec import text_size


def raw(path: str, bytes_sent: bytes) -> Result[None, str]:
    """Connect, write exactly these bytes and hang up, as a broken client does."""
    match UnixStream.connect(path):
        Err(error) => return Err(f"cannot connect: {error}")
        Ok(stream) =>
            mut open = stream
            match open.write_all(bytes_sent):
                Ok(_) => return Ok(None)
                Err(error) => return Err(f"cannot write: {error}")


def refuses(result: Result[int, str]) -> bool:
    """Whether a frame length was refused."""
    match result:
        Ok(_) => return false
        Err(_) => return true


def refused_frame(result: Result[JsonValue, str]) -> bool:
    """Whether reading a frame was refused."""
    match result:
        Ok(_) => return false
        Err(_) => return true


def refused_request(result: Result[Request, str]) -> bool:
    """Whether a document was refused as a request."""
    match result:
        Ok(_) => return false
        Err(_) => return true


pub def test_frames_round_trip_and_stay_bounded() -> Result[None, str]:
    """A document survives a frame in both directions; the bound is a refusal before any allocation."""
    scratch = scratch_directory()?
    trace_contract(scratch.path().0)?
    typed_trace_contract(scratch.path().0)?
    path = scratch.path().joinpath("o.sock").0
    mut listener = listen(path, true)?
    mut client = dial(path)?
    mut server = listener.accept()?
    assert client.peer()?.uid == server.peer()?.uid
    assert client.peer()?.gid == server.peer()?.gid
    # A request travels from the client to the server, and a reply back.
    request = Request(
        command="run",
        generation="abc",
        path="/p/src/main.incn",
        features=["a", "b"],
        default_features=false,
    )
    send_document(client, request.to_json())?
    seen = request_of(receive_document(server)?)?
    assert seen.command == "run"
    assert seen.path == "/p/src/main.incn"
    assert seen.features == ["a", "b"]
    assert not seen.default_features
    reply = Reply(status="done", exit=3, binary="/p/target/bin/p", stdout="out", stderr="err", trace=["oven: x"], pid=7)
    send_document(server, reply.to_json())?
    answer = reply_of(receive_document(client)?)?
    assert answer.status == "done"
    assert answer.exit == 3
    assert answer.binary == "/p/target/bin/p"
    assert answer.trace == ["oven: x"]
    # A header states a length of eight digits, within the bound.
    assert padded(42) == "00000042"
    assert length_of(padded(MAX_FRAME).encode("utf-8"))? == MAX_FRAME
    assert refuses(length_of(padded(MAX_FRAME + 1).encode("utf-8")))
    assert refuses(length_of("12ab5678".encode("utf-8")))
    assert refuses(length_of("123".encode("utf-8")))
    return Ok(None)


pub def test_a_broken_client_leaves_the_next_request_healthy() -> Result[None, str]:
    """A cut-off payload, a junk header and a non-request each refuse one connection and nothing else."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("o.sock").0
    mut listener = listen(path, true)?
    raw(path, "00000100{".encode("utf-8"))?
    mut cut = listener.accept()?
    assert refused_frame(receive_document(cut))
    raw(path, "not-a-header".encode("utf-8"))?
    mut junk = listener.accept()?
    assert refused_frame(receive_document(junk))
    raw(path, "00000002{}".encode("utf-8"))?
    mut empty = listener.accept()?
    assert refused_request(request_of(receive_document(empty)?))
    mut client = dial(path)?
    mut server = listener.accept()?
    send_document(client, Request(command="status", generation="abc").to_json())?
    assert request_of(receive_document(server)?)?.command == "status"
    return Ok(None)


def trace_contract(directory: str) -> Result[None, str]:
    """Disabled observation is empty; a parent and child round-trip with counters and monotonic durations."""
    match trace_begin(false):
        None => pass
        Some(_) => return Err("disabled observation started a clock")
    parent_clock = match trace_begin(true):
        Some(value) => value
        None => return Err("enabled parent did not start")

    child_clock = match trace_begin(true):
        Some(value) => value
        None => return Err("enabled child did not start")

    child = complete(
        child_clock,
        "test",
        "read",
        "quote\"\\\n\tλ",
        Counters(bytes=17, records=2, calls=3),
        run="run",
        request="request",
        work="work",
        parent=parent_clock.span,
        snapshot="snapshot",
    )
    parent = complete(parent_clock, "test", "request", "root", run="run", request="request", work="work")
    child_text = encode(child).map_err((_) => "child encoding failed")?
    parent_text = encode(parent).map_err((_) => "parent encoding failed")?
    decoded = parse(child_text).map_err((error) => error.message())?
    root = parse(parent_text).map_err((error) => error.message())?
    assert trace_value(root, "span")?.expect_int().map_err((error) => error.message())? == parent.span
    assert trace_value(decoded, "schema")?.expect_str().map_err((error) => error.message())? == SCHEMA
    assert trace_value(decoded, "key")?.expect_str().map_err((error) => error.message())? == child.key
    assert trace_value(decoded, "parent")?.expect_int().map_err((error) => error.message())? == parent.span
    assert trace_value(decoded, "bytes")?.expect_int().map_err((error) => error.message())? == 17
    assert trace_value(decoded, "records")?.expect_int().map_err((error) => error.message())? == 2
    assert trace_value(decoded, "calls")?.expect_int().map_err((error) => error.message())? == 3
    assert trace_value(decoded, "cpu_ns")?.is_null()
    assert trace_value(decoded, "clock")?.expect_str().map_err((error) => error.message())? == "host-monotonic-raw"
    assert parent.start_ns > 0
    assert child.clock_id == parent.clock_id and child.clock_id != ""
    for key in ["run", "request", "work", "producer", "operation", "snapshot", "thread", "outcome", "clock_id"]:
        assert trace_value(decoded, key)?.expect_str().map_err((error) => error.message())? != ""
    assert child.start_ns >= parent.start_ns and child.end_ns <= parent.end_ns
    record(directory + "/spans.jsonl", child).map_err((_) => "trace output failed")?
    flush_trace().map_err((_) => "trace flush failed")?
    mut saved = Path(directory + "/spans.jsonl").read_text("utf-8", "strict").map_err((error) => error.message())?
    assert saved == child_text
    # More than one buffer is drained without losing, reordering or splitting encoded records.
    mut expected = child_text
    while len(expected) < MAX_RECORD * 2:
        trace_append(directory + "/spans.jsonl", child_text).map_err((_) => "batched append failed")?
        expected += child_text
    flush_trace().map_err((_) => "batch flush failed")?
    saved = Path(directory + "/spans.jsonl").read_text("utf-8", "strict").map_err((error) => error.message())?
    assert saved == expected
    assert trace_refused(trace_append(directory + "/missing/spans.jsonl", child_text))
    assert trace_refused(record("-", parent))
    mut oversized = "x"
    while len(oversized) <= MAX_TEXT:
        oversized = oversized + oversized
    assert trace_refused(encode(complete(child_clock, "test", "read", oversized)))
    mut invalid = child
    invalid.end_ns = invalid.start_ns - 1
    assert trace_refused(encode(invalid))
    record("", invalid).map_err((_) => "disabled output encoded an event")?
    mut quoted = "\""
    while len(quoted) < MAX_TEXT:
        quoted = quoted + quoted
    crowded = complete(
        child_clock,
        quoted,
        quoted,
        quoted,
        run=quoted,
        request=quoted,
        work=quoted,
        snapshot=quoted,
        outcome=quoted,
    )
    match encode(crowded):
        Err(TraceError.RecordBound) => pass
        Err(_) => return Err("wrong refusal for an oversized encoded record")
        Ok(_) => return Err("oversized encoded record was accepted")
    return Ok(None)


def typed_trace_contract(directory: str) -> Result[None, str]:
    """A retained emitter preserves escaping and counters, and refuses dynamic bounds before writing a prefix."""
    destination = directory + "/typed.jsonl"
    emitter = Emitter.open(destination, "test", "run", "request").map_err((_) => "emitter open failed")?
    clock = match trace_begin(true):
        Some(value) => value
        None => return Err("enabled emitter did not start")

    key = "quote\"\\\n\tλ"
    emitter.emit(clock, Operation.JsonRead, key, 17).map_err((_) => "typed emit failed")?
    flush_trace().map_err((_) => "typed flush failed")?
    saved = Path(destination).read_text("utf-8", "strict").map_err((error) => error.message())?
    decoded = parse(saved).map_err((error) => error.message())?
    assert trace_value(decoded, "operation")?.expect_str().map_err((error) => error.message())? == "json_read"
    assert trace_value(decoded, "key")?.expect_str().map_err((error) => error.message())? == key
    assert trace_value(decoded, "bytes")?.expect_int().map_err((error) => error.message())? == 17
    assert trace_value(decoded, "calls")?.expect_int().map_err((error) => error.message())? == 1
    assert trace_value(decoded, "request")?.expect_str().map_err((error) => error.message())? == "request"
    assert trace_value(decoded, "clock_id")?.expect_str().map_err((error) => error.message())? == clock.origin
    assert trace_refused(emitter.emit(clock, Operation.FileRead, key, -1))
    mut oversized = "x"
    while len(oversized) <= MAX_TEXT:
        oversized += oversized
    assert trace_refused(emitter.emit(clock, Operation.FileRead, oversized))
    assert trace_refused(Emitter.open(destination, oversized))
    flush_trace().map_err((_) => "refused flush failed")?
    assert Path(destination).read_text("utf-8", "strict").map_err((error) => error.message())? == saved
    # Escaping can overflow fixed scratch even though every source field fits its own bound.
    control = parse("\"\\u0001\"").map_err((error) => error.message())?
    mut quoted = control.expect_str().map_err((error) => error.message())?
    while len(quoted) < MAX_TEXT:
        quoted += quoted
    crowded = Emitter.open(destination, quoted, quoted, quoted).map_err((_) => "bounded open failed")?
    match crowded.emit(clock, Operation.FileRead, quoted):
        Err(TraceError.RecordBound) => pass
        Err(_) => return Err("typed record returned the wrong bound")
        Ok(_) => return Err("typed record exceeded its encoding bound")
    # A refused scratch prefix is neither published nor retained for the next complete record.
    for index in range(400):
        next_clock = match trace_begin(true):
            Some(value) => value
            None => return Err("enabled drain did not start")

        emitter.emit(next_clock, Operation.FileRead, f"read-{index}", index).map_err((_) => "typed drain failed")?
    flush_trace().map_err((_) => "typed drain flush failed")?
    drained = Path(destination).read_text("utf-8", "strict").map_err((error) => error.message())?
    lines = drained.strip().split("\n")
    assert len(lines) == 401
    for index in range(400):
        row = parse(lines[index + 1]).map_err((error) => error.message())?
        assert trace_value(row, "key")?.expect_str().map_err((error) => error.message())? == f"read-{index}"
        assert trace_value(row, "bytes")?.expect_int().map_err((error) => error.message())? == index
    # The byte counter borrows UTF-8 text rather than encoding an allocated copy.
    assert text_size("λ", Some(clock)) == 2
    assert text_size("λ", None) == 0
    return Ok(None)


def trace_refused[T](result: Result[T, TraceError]) -> bool:
    """Whether a malformed observation or unavailable channel was refused."""
    match result:
        Err(_) => return true
        Ok(_) => return false


def trace_value(document: JsonValue, key: str) -> Result[JsonValue, str]:
    """A required observation field; absence is a broken schema."""
    match document.get(key):
        Some(value) => return Ok(value)
        None => return Err(f"missing {key}")
