"""Format-1 oven.lock contracts for serialization, identity and tamper refusal."""

from files import read, write
from lock_format import (
    LockDependency,
    LockFeatures,
    LockLoaf,
    LockToolchain,
    OvenLock,
    graph_identity,
    lock_text,
    read_lock,
    write_lock,
)
from scratch import scratch_directory


def example_lock() -> Result[OvenLock, str]:
    """Build a sealed graph with a path Loaf and two compatibility classes of one toolchain Loaf."""
    target = "aarch64-apple-darwin"
    root = LockLoaf(
        name="app",
        version="0.1.0",
        origin="root",
        dependencies=[
            LockDependency(key="helper", loaf="helper", version="0.2.0"),
            LockDependency(key="random2", loaf="crates-io/getrandom", version="0.2.17", entry="getrandom-02"),
            LockDependency(key="random3", loaf="crates-io/getrandom", version="0.3.4", entry="getrandom-03"),
            LockDependency(key="published", loaf="acme/published", version="1.2.3"),
        ],
        features=[LockFeatures(target=target, domain="target", requested=[], enabled=[])],
    )
    helper = LockLoaf(
        name="helper",
        version="0.2.0",
        origin="path",
        path="deps/helper",
        features=[LockFeatures(target=target, domain="target", requested=["extra"], enabled=["extra"])],
    )
    random2 = LockLoaf(
        name="crates-io/getrandom",
        version="0.2.17",
        origin="toolchain",
        entry="getrandom-02",
        features=[LockFeatures(target=target, domain="target", enabled=["std"])],
    )
    random3 = LockLoaf(
        name="crates-io/getrandom",
        version="0.3.4",
        origin="toolchain",
        entry="getrandom-03",
        features=[LockFeatures(target=target, domain="target", enabled=["std"])],
    )
    published = LockLoaf(
        name="acme/published",
        version="1.2.3",
        origin="registry",
        registry="loaves.pub",
        protocol="filesystem",
        revision=2,
        checksum="sha256:source",
        source="records/acme/published/1.2.3/source.loaf",
        trust="digest",
        adopted=true,
        features=[LockFeatures(target=target, domain="target", predicates=["cfg(unix)"])],
    )
    mut lock = OvenLock(
        format=1,
        mode="lowest",
        graph="",
        toolchain=LockToolchain(version="0.6.0", identity="toolchain-closure"),
        loaves=[root, helper, random2, random3, published],
    )
    lock.graph = graph_identity(lock)?
    return Ok(lock)


pub def test_format_one_round_trips_every_reserved_field() -> Result[None, str]:
    """The hand-written TOML layout reads back to the same semantic document without dropping reserved fields."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("oven.lock")
    expected = example_lock()?
    write_lock(path, expected)?
    actual = read_lock(path)?
    assert actual.format == expected.format
    assert actual.mode == expected.mode
    assert actual.graph == expected.graph
    assert actual.toolchain == expected.toolchain
    assert lock_text(actual)? == lock_text(expected)?
    assert read(path)?.startswith("# Generated by Oven. Do not edit.\nformat = 1\n")
    return Ok(None)


pub def test_graph_identity_ignores_table_and_edge_order() -> Result[None, str]:
    """The closure fold changes neither when tables move nor when one entry's exact edges move."""
    expected = example_lock()?
    mut reordered = OvenLock(
        format=expected.format,
        mode=expected.mode,
        graph=expected.graph,
        toolchain=expected.toolchain,
        loaves=[expected.loaves[4], expected.loaves[1], expected.loaves[0], expected.loaves[3], expected.loaves[2]],
    )
    reordered.loaves[2].dependencies = [
        reordered.loaves[2].dependencies[3],
        reordered.loaves[2].dependencies[2],
        reordered.loaves[2].dependencies[0],
        reordered.loaves[2].dependencies[1],
    ]
    assert graph_identity(reordered)? == expected.graph
    assert lock_text(reordered)? == lock_text(expected)?
    return Ok(None)


pub def test_two_versions_of_one_loaf_remain_distinct() -> Result[None, str]:
    """Exact edge versions and compiled entries distinguish two compatibility classes with one Loaf name."""
    lock = example_lock()?
    matches = [entry for entry in lock.loaves if entry.name == "crates-io/getrandom"]
    assert len(matches) == 2
    assert sorted([entry.version for entry in matches]) == ["0.2.17", "0.3.4"]
    assert graph_identity(lock)? == lock.graph
    return Ok(None)


pub def test_edited_graph_is_refused_with_an_entry_name() -> Result[None, str]:
    """A stored digest cannot authenticate different text, and the refusal points back to the graph's first entry."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("oven.lock")
    text = lock_text(example_lock()?)?.replace("graph = \"sha256:", "graph = \"sha256:edited-")
    write(path, text)?
    match read_lock(path):
        Ok(_) => return Err("edited graph identity was accepted")
        Err(message) =>
            assert "graph differs at Loaf acme/published@1.2.3" in message
            assert "run `oven lock`" in message
    return Ok(None)
