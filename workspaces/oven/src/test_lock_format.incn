"""Format-1 oven.lock contracts for serialization, identity and tamper refusal."""

from rust::std::fs import OpenOptions, metadata
from std.fs import Path
from c_interop import CArtifactKind, CArtifactOrigin, CInteropArtifact, CInteropTarget
from features import FeatureRequest
from files import make_directory, read, write
from intake import ManifestReader
from interop_lock import interop_difference, locked_interop
from lock_format import (
    LockDependency,
    LockFeatures,
    LockLoaf,
    LockToolchain,
    OvenLock,
    graph_identity,
    lock_text,
    read_lock,
    write_lock,
)
from project_lock import ensure_project_lock, local_interop
from scratch import scratch_directory
from trace_adapter import count_work, finish_counting


def example_lock() -> Result[OvenLock, str]:
    """Build a sealed graph with a path Loaf and two compatibility classes of one toolchain Loaf."""
    target = "aarch64-apple-darwin"
    root = LockLoaf(
        name="app",
        version="0.1.0",
        origin="root",
        dependencies=[
            LockDependency(key="helper", loaf="helper", version="0.2.0"),
            LockDependency(key="random2", loaf="crates-io/getrandom", version="0.2.17", entry="getrandom-02"),
            LockDependency(key="random3", loaf="crates-io/getrandom", version="0.3.4", entry="getrandom-03"),
            LockDependency(key="published", loaf="acme/published", version="1.2.3"),
        ],
        features=[LockFeatures(target=target, domain="target", requested=[], enabled=[])],
    )
    helper = LockLoaf(
        name="helper",
        version="0.2.0",
        origin="path",
        path="deps/helper",
        features=[LockFeatures(target=target, domain="target", requested=["extra"], enabled=["extra"])],
    )
    random2 = LockLoaf(
        name="crates-io/getrandom",
        version="0.2.17",
        origin="toolchain",
        entry="getrandom-02",
        features=[LockFeatures(target=target, domain="target", enabled=["std"])],
    )
    random3 = LockLoaf(
        name="crates-io/getrandom",
        version="0.3.4",
        origin="toolchain",
        entry="getrandom-03",
        features=[LockFeatures(target=target, domain="target", enabled=["std"])],
    )
    published = LockLoaf(
        name="acme/published",
        version="1.2.3",
        origin="registry",
        registry="loaves.pub",
        protocol="filesystem",
        revision=2,
        checksum="sha256:source",
        source="records/acme/published/1.2.3/source.loaf",
        trust="digest",
        adopted=true,
        features=[LockFeatures(target=target, domain="target", predicates=["cfg(unix)"])],
    )
    mut lock = OvenLock(
        format=1,
        mode="lowest",
        graph="",
        toolchain=LockToolchain(version="0.6.0", identity="toolchain-closure"),
        loaves=[root, helper, random2, random3, published],
    )
    lock.graph = graph_identity(lock)?
    return Ok(lock)


pub def test_format_one_round_trips_every_reserved_field() -> Result[None, str]:
    """The hand-written TOML layout reads back to the same semantic document without dropping reserved fields."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("oven.lock")
    expected = example_lock()?
    write_lock(path, expected)?
    actual = read_lock(path)?
    assert actual.format == expected.format
    assert actual.mode == expected.mode
    assert actual.graph == expected.graph
    assert actual.toolchain == expected.toolchain
    assert lock_text(actual)? == lock_text(expected)?
    assert read(path)?.startswith("# Generated by Oven. Do not edit.\nformat = 1\n")
    return Ok(None)


pub def test_graph_identity_ignores_table_and_edge_order() -> Result[None, str]:
    """The closure fold changes neither when tables move nor when one entry's exact edges move."""
    expected = example_lock()?
    mut reordered = OvenLock(
        format=expected.format,
        mode=expected.mode,
        graph=expected.graph,
        toolchain=expected.toolchain,
        loaves=[expected.loaves[4], expected.loaves[1], expected.loaves[0], expected.loaves[3], expected.loaves[2]],
    )
    reordered.loaves[2].dependencies = [
        reordered.loaves[2].dependencies[3],
        reordered.loaves[2].dependencies[2],
        reordered.loaves[2].dependencies[0],
        reordered.loaves[2].dependencies[1],
    ]
    assert graph_identity(reordered)? == expected.graph
    assert lock_text(reordered)? == lock_text(expected)?
    return Ok(None)


pub def test_two_versions_of_one_loaf_remain_distinct() -> Result[None, str]:
    """Exact edge versions and compiled entries distinguish two compatibility classes with one Loaf name."""
    lock = example_lock()?
    matches = [entry for entry in lock.loaves if entry.name == "crates-io/getrandom"]
    assert len(matches) == 2
    assert sorted([entry.version for entry in matches]) == ["0.2.17", "0.3.4"]
    assert graph_identity(lock)? == lock.graph
    return Ok(None)


pub def test_edited_graph_is_refused_with_an_entry_name() -> Result[None, str]:
    """A stored digest cannot authenticate different text, and the refusal points back to the graph's first entry."""
    scratch = scratch_directory()?
    path = scratch.path().joinpath("oven.lock")
    text = lock_text(example_lock()?)?.replace("graph = \"sha256:", "graph = \"sha256:edited-")
    write(path, text)?
    match read_lock(path):
        Ok(_) => return Err("edited graph identity was accepted")
        Err(message) =>
            assert "graph differs at Loaf acme/published@1.2.3" in message
            assert "run `oven lock`" in message
    return Ok(None)


pub def test_c_interop_facts_are_locked_and_name_what_changed() -> Result[None, str]:
    """
    A root's C interop contract is locked with each declared file's digest.

    1. The facts round-trip through the lock and are part of its graph identity.
    2. A changed bundled file is named as that artifact.
    3. A changed requirement is named as the target's contract.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    runtime = root.joinpath("libbridge.so")
    write(runtime, "first\n")?
    bundled = CInteropArtifact(
        name="bridge",
        kind=CArtifactKind.Bundled,
        path="libbridge.so",
        runtime_name="libbridge.so",
        placement="jniLibs/arm64-v8a",
        minimum_platform="24",
    )
    target = CInteropTarget(target="aarch64-linux-android", artifacts=[bundled])
    first = locked_interop(root.0, [target])?
    # 1. The lock carries the facts, and they are part of what its graph identity authenticates.
    mut lock = example_lock()?
    plain = lock.graph
    lock.interop = first
    lock.graph = graph_identity(lock)?
    assert lock.graph != plain
    path = root.joinpath("oven.lock")
    write_lock(path, lock)?
    stored = read_lock(path)?
    assert stored.interop == first
    assert lock_text(stored)? == lock_text(lock)?
    # 2. Other bytes in a bundled file are another lock.
    write(runtime, "second\n")?
    changed = locked_interop(root.0, [target])?
    assert interop_difference(first, changed) == "bundled artifact `bridge` of `aarch64-linux-android`"
    assert interop_difference(first, first) == ""
    # 3. Another requirement is another contract.
    wider = CInteropTarget(target="aarch64-linux-android", definitions=["WIDE=1"], artifacts=[bundled])
    write(runtime, "first\n")?
    widened = locked_interop(root.0, [wider])?
    assert interop_difference(first, widened) == "the C interop contract of `aarch64-linux-android`"
    return Ok(None)


pub def test_a_path_dependency_s_c_interop_contract_is_locked_under_its_package() -> Result[None, str]:
    """
    A path dependency's `[[interop.c.targets]]` contract is locked beside the root's, keyed by its package.

    1. The root's contract carries no package; the dependency's carries its package.
    2. A changed bundled file in the dependency is named with its package.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("app")
    dependency = scratch.path().joinpath("bridge")
    for directory in [root, dependency]:
        directory.mkdir(true, true).map_err((error) => error.message())?
    head = "[project]\nname = \"{name}\"\nversion = \"0.1.0\"\n\n[interop.c]\n\n[[interop.c.targets]]\n"
    write(root.joinpath("loaf.toml"), head.replace("{name}", "app") + "target = \"aarch64-apple-darwin\"\n")?
    android = "target = \"aarch64-linux-android\"\nsdk = { capability = \"android\" }\n"
    platform = "platform = { kind = \"android\", api-level = 24 }\n\n[[interop.c.targets.artifacts]]\n"
    bundled = "name = \"runtime\"\nkind = \"bundled\"\npath = \"libruntime.so\"\nruntime-name = \"libruntime.so\"\n"
    placement = "placement = \"jniLibs/arm64-v8a\"\nminimum-platform = \"24\"\n"
    write(dependency.joinpath("loaf.toml"), head.replace("{name}", "bridge") + android + platform + bundled + placement)?
    write(dependency.joinpath("libruntime.so"), "first\n")?
    projects = [("app", root.0), ("bridge", dependency.0)]
    resolved = root.resolve().map_err((error) => error.message())?.0
    # 1. Each project's contract, the dependency's under its package.
    first = local_interop(resolved, projects, ManifestReader())?
    keys = [(entry.package, entry.target) for entry in first]
    assert keys == [("", "aarch64-apple-darwin"), ("bridge", "aarch64-linux-android")]
    # 2. Other bytes in the dependency's bundled file are named with the dependency.
    write(dependency.joinpath("libruntime.so"), "second\n")?
    second = local_interop(resolved, projects, ManifestReader())?
    assert interop_difference(first, second) == "bundled artifact `runtime` of `aarch64-linux-android` in `bridge`"
    return Ok(None)


pub def test_an_artifact_s_origin_and_license_are_locked() -> Result[None, str]:
    """
    A package-owned artifact's upstream source, revision and license are locked with its digest, as 0.5.1 locked them.

    1. The lock records the origin and it round-trips.
    2. Another license is another lock.
    """
    scratch = scratch_directory()?
    root = scratch.path()
    write(root.joinpath("libbridge.a"), "!<arch>\n")?
    origin = CArtifactOrigin(source="https://example.invalid/bridge", revision="v1.2.3", license="MIT")
    archive = CInteropArtifact(
        name="bridge",
        kind=CArtifactKind.Static,
        path="libbridge.a",
        link_name="bridge",
        origin=Some(origin),
    )
    locked = locked_interop(root.0, [CInteropTarget(target="aarch64-apple-darwin", artifacts=[archive])])?
    # 1. The origin is a locked fact of the artifact.
    recorded = locked[0].artifacts[0]
    assert [recorded.source, recorded.revision, recorded.license] == ["https://example.invalid/bridge", "v1.2.3", "MIT"]
    mut lock = example_lock()?
    lock.interop = locked
    lock.graph = graph_identity(lock)?
    path = root.joinpath("oven.lock")
    write_lock(path, lock)?
    assert read_lock(path)?.interop == locked
    # 2. A relicensed copy is another contract.
    mut relicensed = archive
    relicensed.origin = Some(CArtifactOrigin(source=origin.source, revision=origin.revision, license="Apache-2.0"))
    changed = locked_interop(root.0, [CInteropTarget(target="aarch64-apple-darwin", artifacts=[relicensed])])?
    assert interop_difference(locked, changed) == "static artifact `bridge` of `aarch64-apple-darwin`"
    return Ok(None)


def rewrite_in_place(path: Path, text: str) -> Result[None, str]:
    """Replace a file's bytes where they are with `text`, then put its modification time back as it was."""
    prefix = f"{path.0}: "
    before = metadata(path.0).map_err((error) => f"{prefix}{error}")?.modified().map_err((error) => f"{prefix}{error}")?
    write(path, text)?
    mut options = OpenOptions.new()
    options.write(true)
    file = options.open(path.0).map_err((error) => f"{prefix}{error}")?
    file.set_modified(before).map_err((error) => f"{prefix}{error}")?
    return Ok(None)


pub def test_a_settled_lock_is_not_resolved_again_until_its_inputs_change() -> Result[None, str]:
    """
    A root lock reconciled to no change is not resolved again by the next command while it and its manifest keep
    their bytes; an edited manifest is resolved again, even one that keeps its size and modification time.

    1. The first command writes the lock; the second reconciles it to no change, with no wait for the files to settle.
    2. The next command parses no manifest.
    3. A rewritten manifest is parsed and resolved again.
    4. So is one rewritten in place to bytes of the same size, with its modification time put back.

    Work is counted under the project's physical path, the spelling the lock is resolved under, so a temporary
    directory reached through a symbolic link still counts every parse.
    """
    scratch = scratch_directory()?
    root = scratch.path().joinpath("app")
    make_directory(root.joinpath("src"))?
    write(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\n")?
    write(root.joinpath("src/main.incn"), "def main() -> None:\n    println(\"app\")\n")?
    physical = root.resolve().map_err((error) => error.message())?.0 + "/"
    # 1. The second command's no-change reconciliation is retained at once: it is keyed by bytes, not by time.
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    # 2. Nothing the lock is resolved from changed.
    count_work(physical)
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    settled = finish_counting()
    assert settled.parses == 0, f"an unchanged lock was resolved again: {settled.parses} manifest parses"
    # 3. An edit to the manifest is resolved again.
    write(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\ndescription = \"edited\"\n")?
    count_work(physical)
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    edited = finish_counting()
    assert edited.parses > 0, "an edited manifest was not resolved again"
    # 4. The same size and modification time do not hide an edit.
    count_work(physical)
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    assert finish_counting().parses == 0, "the edited manifest's no-change reconciliation was not retained"
    rewrite_in_place(root.joinpath("loaf.toml"), "[project]\nname = \"app\"\nversion = \"0.1.0\"\ndescription = \"EDITED\"\n")?
    count_work(physical)
    ensure_project_lock(root, "debug", FeatureRequest(), {}, ManifestReader(), false)?
    rewritten = finish_counting()
    assert rewritten.parses > 0, "a manifest rewritten to the same size and modification time was not resolved again"
    return Ok(None)


pub def test_a_loaf_name_with_a_capital_letter_is_refused_not_folded() -> Result[None, str]:
    """
    RFC 125: a Loaf name has no capital letter, and Oven refuses one rather than fold its case. A lock whose graph
    identity matches its entries is still refused when an entry or an edge names a Loaf with a capital.
    """
    scratch = scratch_directory()?
    path = scratch.path().joinpath("oven.lock")
    mut lock = example_lock()?
    lock.loaves[4].name = "acme/Published"
    lock.loaves[0].dependencies[3].loaf = "acme/Published"
    lock.graph = graph_identity(lock)?
    write(path, lock_text(lock)?)?
    match read_lock(path):
        Ok(_) => return Err("a Loaf name with a capital letter was accepted")
        Err(message) =>
            assert "`acme/Published` has a capital letter" in message, message
    return Ok(None)
