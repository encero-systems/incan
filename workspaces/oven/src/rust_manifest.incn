"""Read a Loaf's Rust facet declaration: its library crate, its binaries and what they ask of the toolchain."""

from std.toml import TomlValue
from std.fs import Path
from json_fields import field
from intake import library_source, read_project, ManifestReader
from rust_target import compiler_version, host_triple
from toml_fields import optional_flag, optional_string, optional_strings, required_string
from toolchain_access import BINARY_SEPARATOR, read_access


pub model RustBuildFact:
    """
    One `[[rust.facts]]` record (RFC 119): the exact binding it was recorded for, and what the crate's build script
    answered for that binding.
    """

    pub toolchain: str
    pub target: str
    pub profile: str
    # The complete enabled feature set of the binding, sorted.
    pub features: list[str]
    pub cfg: list[str]
    # The committed generated tree the crate reads as `OUT_DIR`, relative to the Loaf; empty when it has none.
    pub out: str = ""
    pub environment: Dict[str, str] = {}
    # Declared publisher-side work (`link`, `tool`) the record carries; this Oven does not run it yet.
    pub work: list[str] = []


pub model RustFacet:
    """What a local Loaf's manifest says about its Rust crate."""

    pub crate_name: str
    # `lib`, `proc-macro`, or an `incan` provider; empty when the Loaf has no library crate.
    pub kind: str
    pub edition: str
    # The library crate's Rust or Incan root file, when there is one.
    pub library: str
    # The `[[rust.bin]]` crates: name and root file.
    pub binaries: list[Tuple[str, str]]
    # The package name and version the unit is compiled as.
    pub package: str
    pub version: str
    # Whether a binary needs the toolchain's unstable features (`unstable_features`).
    pub unstable: bool
    # Whether a binary links the toolchain's own libraries (`sysroot_dependencies`) and finds them at run time.
    pub sysroot: bool
    # Whether the crate has a build script, whose effect only a recorded build fact may carry.
    pub build_script: bool = false
    pub facts: list[RustBuildFact] = []


model RustBinaries:
    """The `[[rust.bin]]` crates of a manifest, and what they ask of the toolchain."""

    crates: list[Tuple[str, str]]
    unstable: bool
    sysroot: bool


pub def rust_facet(
    project: str,
    required: bool = true,
    reader: ManifestReader = ManifestReader(),
) -> Result[RustFacet, str]:
    """
    The Rust crate a local Loaf's manifest declares; an Incan consumer may have no Rust facet of its own.

    1. Read the manifest and name the package, the crate and its edition.
    2. Find the library crate and its type.
    3. Read the `[[rust.bin]]` crates and what they ask of the toolchain.
    4. A Loaf that must declare a Rust crate and declares none is refused.
    """
    root = Path(project)
    # 1. The package, its crate name and its edition come from the manifest, with the documented fallbacks.
    project_intent = read_project(root, reader).map_err((error) => error.message())?
    document = project_intent.parsed
    package = project_intent.intent.name
    crate_name = project_intent.intent.rust_name
    edition = project_intent.intent.rust_edition
    # 2. A library crate is the `src/lib.rs` of the source root, and the manifest may type it a procedural macro.
    mut library = library_root(document, root)?.joinpath("src").joinpath("lib.rs")
    mut kind = library_type(document, library)?
    # 3. Each `[[rust.bin]]` is a crate of its own, and may need unstable features or the toolchain's libraries.
    binaries = read_binaries(document, root)?
    # 4. An Incan library supplies its compiled Rust crate; a project with neither language's crate is refused.
    if required and kind == "":
        source = library_source(root, reader)?
        if source.is_file():
            kind = "incan"
            library = source
        elif len(binaries.crates) == 0:
            return Err(f"{project} declares no Rust crate: no {library.0} and no [[rust.bin]]")
    version = required_string(document, "project.version")?
    mut library_path = ""
    if library.is_file():
        library_path = library.0
    return Ok(
        RustFacet(
            crate_name=crate_name,
            kind=kind,
            edition=edition,
            library=library_path,
            binaries=binaries.crates,
            package=package,
            version=version,
            unstable=binaries.unstable,
            sysroot=binaries.sysroot,
            build_script=optional_flag(document, "rust.build-script", false)?,
            facts=read_facts(document)?,
        ),
    )


pub def build_fact(
    declared: RustFacet,
    toolchain: str,
    target: str,
    profile: str,
    features: list[str],
) -> Result[Option[RustBuildFact], str]:
    """
    The build fact recorded for exactly this binding: toolchain, target, profile and the complete feature set. A near
    record is never taken. A crate with no build script needs no record; one with a build script and no exact record
    is refused, naming the unit and the binding. Declared `link` or `tool` work is refused until this Oven runs it.
    """
    wanted = sorted(features)
    unit = f"{declared.package} {declared.version}"
    for fact in declared.facts:
        if fact.toolchain != toolchain or fact.target != target or fact.profile != profile or fact.features != wanted:
            continue
        if len(fact.work) > 0:
            return Err(f"{unit}: its build fact declares {", ".join(fact.work)} work, which this Oven does not run")
        return Ok(Some(fact))
    if not declared.build_script:
        return Ok(None)
    binding = f"{toolchain}, {target}, {profile}, features [{", ".join(wanted)}]"
    return Err(f"{unit} requires a recorded build fact for this exact binding: {binding}")


pub def fact_arguments(fact: RustBuildFact) -> list[str]:
    """The compiler arguments a build fact answers with: one `--cfg` per recorded flag, in recorded order."""
    mut arguments: list[str] = []
    for flag in fact.cfg:
        arguments.append("--cfg")
        arguments.append(flag)
    return arguments


pub def fact_environment(project: str, fact: RustBuildFact) -> Dict[str, str]:
    """The environment a build fact gives the crate's compile: its recorded variables, and `OUT_DIR` for its tree."""
    mut environment: Dict[str, str] = {}
    for name in sorted([name for name in fact.environment.keys()]):
        environment[name] = fact.environment[name]
    if fact.out != "":
        environment["OUT_DIR"] = Path(project).joinpath(fact.out).0
    return environment


def unit_build_fact(
    declared: RustFacet,
    rustc: str,
    profile: str,
    features: list[str],
) -> Result[Option[RustBuildFact], str]:
    """The build fact of a unit's binding: the pinned rustc's identity and host target, the profile and the features."""
    if len(declared.facts) == 0 and not declared.build_script:
        return Ok(None)
    identity = compiler_version(rustc)?.split("\n")[0].strip()
    return build_fact(declared, identity, host_triple(rustc)?, profile, features)


pub def unit_fact_arguments(
    declared: RustFacet,
    rustc: str,
    profile: str,
    features: list[str],
) -> Result[list[str], str]:
    """The compiler arguments a unit's build fact adds, none when the unit has no fact for its binding."""
    match unit_build_fact(declared, rustc, profile, features)?:
        None => return Ok([])
        Some(fact) => return Ok(fact_arguments(fact))


pub def unit_environment(
    project: str,
    declared: RustFacet,
    rustc: str,
    profile: str,
    features: list[str],
) -> Result[Dict[str, str], str]:
    """A unit's compile environment: its package environment, then what its build fact records for its binding."""
    mut environment = package_environment(project, declared, declared.crate_name)
    if let Some(fact) = unit_build_fact(declared, rustc, profile, features)?:
        recorded = fact_environment(project, fact)
        for name in sorted([name for name in recorded.keys()]):
            environment[name] = recorded[name]
    return Ok(environment)


def read_facts(document: TomlValue) -> Result[list[RustBuildFact], str]:
    """The `[[rust.facts]]` records of a manifest. `harvested-from` is evidence only and is not read."""
    root = document.as_table().map_err((error) => error.message())?
    if "rust" not in root:
        return Ok([])
    facet = root["rust"].as_table().map_err((error) => error.message())?
    if "facts" not in facet:
        return Ok([])
    mut facts: list[RustBuildFact] = []
    for record in facet["facts"].as_array().map_err((error) => f"rust.facts: {error.message()}")?:
        facts.append(read_fact(record)?)
    return Ok(facts)


def read_fact(record: TomlValue) -> Result[RustBuildFact, str]:
    """One build fact record: its binding, its answers and the kinds of publisher-side work it declares."""
    table = record.as_table().map_err((error) => f"rust.facts: {error.message()}")?
    mut environment: Dict[str, str] = {}
    if "environment" in table:
        values = table["environment"].as_table().map_err((error) => f"rust.facts.environment: {error.message()}")?
        for name in sorted([name for name in values.keys()]):
            environment[name] = required_string(record, f"environment.{name}")?
    mut work: list[str] = []
    for kind in ["link", "tool"]:
        if kind in table:
            work.append(kind)
    return Ok(
        RustBuildFact(
            toolchain=required_string(record, "toolchain")?,
            target=required_string(record, "target")?,
            profile=required_string(record, "profile")?,
            features=sorted(optional_strings(record, "features")?.unwrap_or([])),
            cfg=optional_strings(record, "cfg")?.unwrap_or([]),
            out=optional_string(record, "out")?.unwrap_or(""),
            environment=environment,
            work=work,
        ),
    )


def crate_name_of(document: TomlValue, package: str) -> Result[str, str]:
    """The crate's name: `rust.name` when declared, else the package's, with underscores for hyphens."""
    match optional_string(document, "rust.name")?:
        Some(declared) => return Ok(declared.replace("-", "_"))
        None => return Ok(package.replace("-", "_"))


def library_root(document: TomlValue, root: Path) -> Result[Path, str]:
    """The directory whose `src/lib.rs` is the library crate: `rust.source.root` under the project, else the project."""
    match optional_string(document, "rust.source.root")?:
        Some(declared) => return Ok(root.joinpath(declared))
        None => return Ok(root)


def library_type(document: TomlValue, library: Path) -> Result[str, str]:
    """The library crate's type (`lib` unless `rust.type` says otherwise), or empty when there is no library file."""
    if not library.is_file():
        return Ok("")
    match optional_string(document, "rust.type")?:
        Some(declared) => return Ok(declared)
        None => return Ok("lib")


def read_binaries(document: TomlValue, root: Path) -> Result[RustBinaries, str]:
    """The `[[rust.bin]]` crates, and whether any declares unstable features or links the toolchain's own libraries."""
    manifest = root.joinpath("loaf.toml").0
    mut crates: list[Tuple[str, str]] = []
    mut unstable = false
    mut sysroot = false
    binaries = declared_binaries(document)?
    for index in range(len(binaries)):
        binary = binaries[index]
        name = required_string(binary, "name")?
        path = required_string(binary, "path")?
        crates.append((name, root.joinpath(path).0))
        values = binary.as_table().map_err((error) => error.message())?
        field = ["rust", "bin", str(index)]
        access = read_access(values, BINARY_SEPARATOR, manifest, field).map_err((error) => error.message())?
        if len(access.unstable_features) > 0:
            unstable = true
        if len(access.sysroot_dependencies) > 0:
            sysroot = true
    return Ok(RustBinaries(crates=crates, unstable=unstable, sysroot=sysroot))


def declared_binaries(document: TomlValue) -> Result[list[TomlValue], str]:
    """The `[[rust.bin]]` tables of a manifest."""
    root = document.as_table().map_err((error) => error.message())?
    if "rust" not in root:
        return Ok([])
    facet = root["rust"].as_table().map_err((error) => error.message())?
    if "bin" not in facet:
        return Ok([])
    return facet["bin"].as_array().map_err((error) => error.message())


pub def package_environment(project: str, declared: RustFacet, crate_name: str) -> Dict[str, str]:
    """The package environment Rust code reads at compile time (`env!`), under the names the Rust ecosystem uses."""
    mut environment: Dict[str, str] = {"CARGO_PKG_NAME": declared.crate_name, "CARGO_PKG_VERSION": declared.version, "CARGO_MANIFEST_DIR": project, "CARGO_CRATE_NAME": crate_name, "CARGO_PKG_AUTHORS": "", "CARGO_PKG_DESCRIPTION": ""}
    release = declared.version.split("-")
    mut pre = ""
    if len(release) > 1:
        pre = "-".join(release[1:])
    numbers = release[0].split(".")
    names = ["CARGO_PKG_VERSION_MAJOR", "CARGO_PKG_VERSION_MINOR", "CARGO_PKG_VERSION_PATCH"]
    for index in range(3):
        mut number = "0"
        if index < len(numbers):
            number = numbers[index]
        environment[names[index]] = number
    environment["CARGO_PKG_VERSION_PRE"] = pre
    return environment
