"""
Submit unit compilations, checks and formatting runs to one serial compiler worker per home, compiler generation and
inherited environment.
"""

from rust::std::env import current_dir, vars_os
from rust::std::ffi import OsString
from rust::std::io import Error as IoError, Write, stderr, stdout
from rust::std::os::unix::process import CommandExt
from rust::std::process import Child, Command, Stdio, id
from rust::std::string import String as RustString
from rust::std::thread import available_parallelism, sleep
from std.environ import get_or
from rust::std::time import Duration
from std.fs import Path
from std.fs.locking import FileLock
from pub::incan_platform.ipc import Connection, Listener, listen
from files import discard_file
from home import owners_dir
from pub::incan_worker_host.protocol import SCHEMA, completion, ready, request_document, retired
from observation import trace, trace_boundary
from owner_client import status_code
from owner_endpoint import Endpoint, attach, bindable, prepare_directory, socket_prefix
from decimal_text import digits_only
from owner_protocol import receive_document, send_document
from toolchain import Toolchain
from unit_freshness import compiler_fingerprint, fingerprint
from driver_command import driver_command
from jec import begin, record, invocation_key

const READINESS_POLLS: int = 7500
# The resident memory one worker may reach while it compiles, which bounds how many physical memory holds.
const WORKER_CEILING_BYTES: int = 4294967296
# The pool size when physical memory cannot be read.
const UNBOUNDED_WORKERS: int = 1024


pub model Completion:
    """A finished compiler invocation: its status, whether it exited normally, and the exact bytes of each stream."""

    pub code: i32
    # False when the process ended by a signal; its status is then one.
    pub exited: bool
    pub output: bytes
    pub error: bytes


pub def served_resident(arguments: list[str]) -> bool:
    """Whether the worker serves this compiler invocation: a unit compilation, a check or a formatting run."""
    if len(arguments) == 0:
        return false
    command = arguments[0]
    return command == "--unit" or command == "--check" or command == "--fmt"


pub def compile_resident(toolchain: Toolchain, arguments: list[str]) -> Result[Option[i32], str]:
    """
    Run a served invocation through the shared worker, or keep the cold path when startup is unavailable.

    1. Select private request console sinks, retaining a project owner's existing sinks.
    2. Submit the ordinary compiler invocation without replaying a submitted request.
    3. A foreground command relays its original console bytes and removes its temporary sinks.
    """
    # 1. A foreground command owns private sinks; a project owner already supplied its request's sinks.
    match capture_for(toolchain):
        Err(reason) =>
            trace(f"compiler worker: cold path ({reason})")
            return Ok(None)
        Ok(capturing) =>
            # 2. Only a failure before submission permits the original single-process path.
            compiled = compile_at(capturing, arguments)
            # 3. Foreground console bytes stay outside the protocol, exactly as for a project owner.
            if toolchain.console == "":
                relay_console(capturing.console)?
            return compiled


pub def captured_resident(toolchain: Toolchain, arguments: list[str]) -> Result[Option[Completion], str]:
    """
    Run a served invocation through the shared worker and return its completion with the exact bytes it wrote,
    relaying nothing; `None` keeps the cold path when startup is unavailable.

    1. Select private request console sinks, even for a project owner, so the caller decides where the bytes go.
    2. Submit the ordinary compiler invocation without replaying a submitted request.
    3. Collect and withdraw both sinks; a failed submission relays what it wrote to this command's streams.
    """
    # 1. Private sinks hold exactly this request's bytes.
    mut foreground = toolchain
    foreground.console = ""
    match capture_for(foreground):
        Err(reason) =>
            trace(f"compiler worker: cold path ({reason})")
            return Ok(None)
        Ok(capturing) =>
            # 2. Only a failure before submission permits the original single-process path.
            compiled = compile_at(capturing, arguments)
            # 3. A completed request hands its bytes to the caller; any other ending shows them here.
            match compiled:
                Ok(Some(code)) =>
                    output = collected(Path(f"{capturing.console}.out"))?
                    error = collected(Path(f"{capturing.console}.err"))?
                    return Ok(Some(Completion(code=code, exited=true, output=output, error=error)))
                Ok(None) =>
                    relay_console(capturing.console)?
                    return Ok(None)
                Err(reason) =>
                    relay_console(capturing.console)?
                    return Err(reason)


def capture_for(toolchain: Toolchain) -> Result[Toolchain, str]:
    """The original owner sinks, or private request-local sinks for a foreground native compilation."""
    if toolchain.console != "":
        return Ok(toolchain)
    directory = owners_dir()?
    prepare_directory(directory.0)?
    mut capturing = toolchain
    capturing.console = directory.joinpath(f"r-{id()}").0
    discard_file(Path(f"{capturing.console}.out"))
    discard_file(Path(f"{capturing.console}.err"))
    return Ok(capturing)


pub def relay_console(prefix: str) -> Result[None, str]:
    """Relay exact diagnostic bytes before withdrawing foreground request files, including on a compile refusal."""
    relay_file(Path(f"{prefix}.out"), false)?
    relay_file(Path(f"{prefix}.err"), true)?
    return Ok(None)


def relay_file(path: Path, error_stream: bool) -> Result[None, str]:
    """Copy a completed compiler stream without changing its encoding or adding a newline."""
    contents = collected(path)?
    if error_stream:
        mut stream = stderr()
        console_result(stream.write_all(contents))?
        console_result(stream.flush())?
    else:
        mut stream = stdout()
        console_result(stream.write_all(contents))?
        console_result(stream.flush())?
    return Ok(None)


def collected(path: Path) -> Result[bytes, str]:
    """The exact bytes a request wrote to one console sink, which is then withdrawn; an absent sink holds none."""
    if not path.is_file():
        return Ok(b"")
    contents = path.read_bytes().map_err((error) => error.message())?
    discard_file(path)
    return Ok(contents)


def console_result(result: Result[None, IoError]) -> Result[None, str]:
    """Report a standard-stream write or flush failure through the command's existing error boundary."""
    return result.map_err((error) => f"cannot relay compiler console: {error}")


def compile_at(toolchain: Toolchain, arguments: list[str]) -> Result[Option[i32], str]:
    """
    Run an invocation through a shared worker, or return `None` before submission for the cold path.

    1. Select and connect the worker for this compiler and environment.
    2. Submit the ordinary compiler arguments and this request's console paths and working directory.
    3. Read its completion; a submitted request is never replayed after a transport failure.
    4. A worker that retired with this reply is not dialed again: the next request starts a fresh one.
    """
    # 1. Unsupported observations and failed startup retain the existing one-process compilation path.
    connecting = begin()
    found_connection = connection_for(toolchain)
    record("worker_connect", toolchain.driver, connecting)
    match found_connection:
        Err(reason) =>
            trace(f"compiler worker: cold path ({reason})")
            return Ok(None)
        Ok(found) =>
            # The slot stays held until this request completes, so no other caller queues behind it.
            connected_socket, generation, slot = found
            mut connected = connected_socket
            # 2. Once submission begins, failure cannot silently run the same compilation twice.
            clock = begin()
            directory = current_dir().map_err((error) => f"compiler working directory: {error}")?
            document = request_document(
                generation,
                arguments,
                directory.to_string_lossy().into_owned(),
                f"{toolchain.console}.out",
                f"{toolchain.console}.err",
                toolchain.retire_worker,
            )
            send_document(connected, document)?
            # 3. A completed request grants only its actual exit code, never a retained checking result.
            reply = receive_document(connected)?
            record("driver_request", invocation_key(arguments), clock)
            # 4. Retirement is an ordinary completion: the worker withdrew its endpoint before it replied.
            if retired(reply):
                trace("compiler worker: retired after its request")
            elif toolchain.retire_worker:
                return Err("compiler worker did not honor the requested activation lifetime")
            return Ok(Some(status_code(completion(reply)?)))


def connection_for(toolchain: Toolchain) -> Result[tuple[Connection, str, FileLock], str]:
    """
    Take an idle slot of the worker pool and connect to its worker before any source request is submitted.

    1. Take the first slot nobody holds; a slot is held for exactly one request.
    2. With every slot of the pool held, wait for this caller's own slot.
    3. Connect to the slot's worker, starting it when there is none.
    """
    generation = generation_of(toolchain)?
    directory = Path(toolchain.console).parent()
    prepare_directory(directory.0)?
    # 1. and 2. A slot nobody holds, or this caller's own slot once the pool is full.
    slot, held = take_slot(directory, generation)?
    endpoint = slot_endpoint(directory, generation, slot)?
    trace_boundary("worker_selected")
    # 3. The slot's lock also arbitrates startup: only its holder can start the slot's worker.
    connected = slot_connection(toolchain, endpoint)?
    trace_boundary("worker_connected")
    return Ok((connected, generation, held))


def take_slot(directory: Path, generation: str) -> Result[tuple[int, FileLock], str]:
    """
    Hold the first slot nobody holds, trying from the first so the pool grows only while every lower slot is busy;
    with the whole pool busy, wait for this caller's own slot, which spreads waiting callers over the pool.
    """
    match try_slot(directory, generation, 0)?:
        Some(lock) => return Ok((0, lock))
        None => pass
    size = pool_size()
    for slot in range(1, size):
        match try_slot(directory, generation, slot)?:
            Some(lock) => return Ok((slot, lock))
            None => pass
    own = int(id()) % size
    lock = Path(slot_endpoint(directory, generation, own)?.lock).lock_exclusive().map_err((error) => error.message())?
    return Ok((own, lock))


def try_slot(directory: Path, generation: str, slot: int) -> Result[Option[FileLock], str]:
    """The lock of one slot when nobody holds it."""
    path = Path(slot_endpoint(directory, generation, slot)?.lock)
    return path.try_lock_exclusive().map_err((error) => error.message())


def slot_connection(toolchain: Toolchain, endpoint: Endpoint) -> Result[Connection, str]:
    """Connect to the held slot's worker, or start it and connect after its readiness acknowledgment."""
    match attach(endpoint)?:
        Some(found) => return Ok(found)
        None => pass
    launch(toolchain, endpoint)?
    match attach(endpoint)?:
        Some(found) => return Ok(found)
        None => return Err("the compiler worker disappeared after readiness")


def generation_of(toolchain: Toolchain) -> Result[str, str]:
    """The generation a resident owner retained, or the one this invocation's compiler and environment select."""
    if toolchain.worker_generation != "":
        return Ok(toolchain.worker_generation)
    return generation_for(compiler_fingerprint(toolchain)?)


def slot_endpoint(directory: Path, generation: str, slot: int) -> Result[Endpoint, str]:
    """
    The private endpoint of one slot of the pool bound to the complete compiler fingerprint and inherited
    nonincidental environment. Its lock stays beside the console sinks; its sockets go to the user's endpoint
    directory, so their path does not grow with the home's depth.
    """
    sockets = f"{socket_prefix(directory.0)?}c-{generation}-{slot}"
    ready = f"{sockets}.{id()}.ready"
    bindable(f"{sockets}.sock")?
    bindable(ready)?
    return Ok(
        Endpoint(
            generation=generation,
            directory=directory.0,
            socket=f"{sockets}.sock",
            lock=directory.joinpath(f"c-{generation}-{slot}.lock").0,
            ready=ready,
            mailbox="",
        ),
    )


def pool_size() -> int:
    """
    How many workers one compiler generation may run at once: `INCAN_JOBS` when the run sets its concurrency, else the
    CPU count; never more than physical memory holds at the workers' footprint ceiling, and never fewer than one.
    """
    mut size = 1
    match available_parallelism():
        Ok(count) => size = int(count.get())
        Err(_) => pass
    configured = get_or("INCAN_JOBS", "")
    if configured != "" and digits_only(configured):
        size = int(configured)
    memory = memory_workers()
    if memory < size:
        size = memory
    if size < 1:
        return 1
    return size


def memory_workers() -> int:
    """How many workers at their footprint ceiling physical memory holds; unknown memory does not limit the pool."""
    match Command.new("/usr/sbin/sysctl").arg("-n").arg("hw.memsize").stderr(Stdio.null()).output():
        Err(_) => return UNBOUNDED_WORKERS
        Ok(found) =>
            if not found.status.success():
                return UNBOUNDED_WORKERS
            match RustString.from_utf8(found.stdout):
                Err(_) => return UNBOUNDED_WORKERS
                Ok(decoded) =>
                    text = str(decoded).strip()
                    if not digits_only(text):
                        return UNBOUNDED_WORKERS
                    return int(text) // WORKER_CEILING_BYTES


pub def generation_for(compiler: str) -> Result[str, str]:
    """
    Bind a worker to the complete observed compiler identity and this process's inherited configuration.

    A resident owner may retain this digest only while it watches all compiler inputs and its environment remains
    unchanged. Every other caller derives it for the request; source, checking and compilation are never retained.
    """
    return Ok(fingerprint([SCHEMA, compiler] + environment()?)?[0:16])


def environment() -> Result[list[str], str]:
    """Hash inherited configuration without recording its values; non-Unicode inputs keep the cold path."""
    mut entries: list[str] = []
    for key, value in vars_os():
        name = unicode_environment(key)?
        if incidental_environment(name):
            continue
        text = unicode_environment(value)?
        entries.append(f"{name}={text}")
    return Ok(sorted(entries))


def incidental_environment(name: str) -> bool:
    """
    Exclude console routing, the removed bootstrap switch and the shell's own bookkeeping from compiler configuration
    identity. A shell rewrites `_`, `PWD`, `OLDPWD` and `SHLVL` for every command and directory; each request carries
    its actual working directory, so commands from any directory share one worker.
    """
    if name == "OVEN_TRACE" or name == "RUSTC_BOOTSTRAP":
        return true
    return name == "_" or name == "PWD" or name == "OLDPWD" or name == "SHLVL"


def unicode_environment(value: OsString) -> Result[str, str]:
    """Require exact Unicode for an environment observation, so lossy replacement cannot alias two configurations."""
    return value.into_string().map_err((_) => "a compiler environment entry is not Unicode")


def launch(toolchain: Toolchain, endpoint: Endpoint) -> Result[None, str]:
    """
    Start the exact driver detached from the owner, with protocol and console on separate streams. The worker decides
    its own retirement, after its idle period among others.
    """
    mut listener = listen(f"{endpoint.ready}", false)?
    mut command = driver_command(toolchain)?
    command.arg("--resident").arg(f"{endpoint.socket}").arg(f"{endpoint.generation}")
    command.arg(f"{endpoint.ready}")
    command.stdin(Stdio.null()).stdout(Stdio.null()).stderr(Stdio.null())
    command.process_group(0)
    clock = begin()
    child = command.spawn().map_err((error) => f"cannot start compiler worker: {error}")?
    record("driver_spawn", toolchain.driver, clock)
    waiting = begin()
    started = await_ready(listener, child, endpoint)
    record("worker_ready", toolchain.driver, waiting)
    discard_file(Path(endpoint.ready))
    return started


def await_ready(mut listener: Listener, mut child: Child, endpoint: Endpoint) -> Result[None, str]:
    """Require the child's protocol, generation and PID; a silent or failed child never receives a request."""
    for poll in range(READINESS_POLLS):
        match listener.poll()?:
            Some(waiting) =>
                mut connected = waiting
                connected.wait_at_most(5)
                document = receive_document(connected)?
                ready(document, endpoint.generation, int(child.id()))?
                trace(f"compiler worker: started pid {child.id()}")
                return Ok(None)
            None => pass
        if child.try_wait().map_err((error) => f"compiler worker readiness: {error}")? is not None:
            return Err("the compiler worker exited before readiness")
        sleep(Duration.from_millis(2))
    _ = child.kill()
    return Err("the compiler worker did not acknowledge readiness")
