"""Read published standard and registry Loaf graphs; legacy source-backed packages have one cached export."""

from std.fs import Path
from std.toml import TomlValue
from files import parse_json
from graph_cache import GraphUnit, read_graph
from graph_dependencies import unit_natives
from graph_incan import inspect_incan
from graph_queries import text
from home import standard_artifact_dir, standard_packages
from intake import ManifestReader, library_source
from loaf_local_graph import LocalDemand, LocalFacet, local_facets
from rust_activation import DependencyDomain
from rust_units import (
    RegistryUnits,
    RustBuild,
    project_registry,
    registry_selection,
    selected_registry,
    target_configuration,
)
from toolchain import Toolchain, rust_compiler


pub def standard_graphs(
    owner: Path,
    profile: str,
    toolchain: Toolchain,
    units: list[GraphUnit],
    registry: RegistryUnits,
    exclude: str = "",
    reader: ManifestReader = ManifestReader(),
) -> Result[list[GraphUnit], str]:
    """
    Follow compiler-proven package origins into standard Loaves, without treating ambient availability as a dependency.

    1. Every standard package of the toolchain is available, except the one `exclude` names.
    2. Read the origins each unit's graph records, starting from the selected units.
    3. A package origin that names an available standard package not seen yet adds that package's graph, whose own
       origins are followed in turn.
    """
    # 1. Every standard package of the toolchain is available to follow; ambient availability makes none a dependency.
    mut available: Dict[str, str] = {}
    for package in standard_packages(reader)?:
        available[package.name] = package.root
    # 2. The origins to follow are the ones each unit's graph records, starting from the units selected.
    mut graphs: list[GraphUnit] = []
    mut seen = [exclude] + [unit.package for unit in units if unit.package in available]
    mut queue = units
    while len(queue) > 0:
        current = queue.pop()
        for line in read_graph(current, toolchain, "origins")?.split("\n"):
            if line == "":
                continue
            # 3. A package met for the first time contributes its graph, and its own origins are followed in turn.
            match origin_package(line, available, seen)?:
                None => pass
                Some(name) =>
                    seen.append(name)
                    unit = standard_graph(owner, profile, toolchain, name, available[name], registry, reader)?
                    graphs.append(unit)
                    queue.append(unit)
    return Ok(graphs)


def origin_package(line: str, available: Dict[str, str], seen: list[str]) -> Result[Option[str], str]:
    """The standard package a graph origin record names, when it is an available one not seen yet."""
    origin = parse_json(line)?
    name = text(origin, "library")
    if text(origin, "kind") != "package" or name not in available or name in seen:
        return Ok(None)
    return Ok(Some(name))


def standard_graph(
    owner: Path,
    profile: str,
    toolchain: Toolchain,
    package: str,
    source_root: str,
    registry: RegistryUnits,
    reader: ManifestReader,
) -> Result[GraphUnit, str]:
    """
    Read a published standard graph, or ask the home bakery for a checked legacy source export.

    1. A standard package compiled with a graph publishes it beside its artifacts.
    2. Otherwise export the package's own source through the home-wide checked export path.
    """
    # 1. A package compiled with a graph is read from the graph it published.
    graph = standard_artifact_dir(package, profile)?.joinpath(f"{package}.incngraph")
    if graph.is_file():
        return Ok(GraphUnit(path=graph, root=Path(f"@std/{package}"), package=package))
    # 2. Any other is exported from its source once per content identity in the home bakery.
    rustc = rust_compiler(toolchain)
    demand = LocalDemand(project=source_root, domain=DependencyDomain.Target, features=[], defaults=true)
    facets = local_facets(demand, target_configuration(rustc)?, reader=reader)?
    request = RustBuild(
        project=owner.0,
        profile=profile,
        rustc=rustc,
        registry=selected_registry(project_registry(registry, source_root, reader)?, facets, profile)?,
        toolchain_search=toolchain.search,
        toolchain=Some(toolchain),
    )
    for facet in facets:
        if facet.project != source_root or facet.domain != DependencyDomain.Target:
            continue
        source = library_source(Path(source_root), reader)?
        natives = unit_natives(facet, {}, request)?
        legacy = inspect_incan(
            source, toolchain, natives, {}, facet.features, false, [], Some(owner), Some(registry), reader, facets,
        )?
        return Ok(GraphUnit(path=legacy, root=Path(f"@std/{package}"), package=package, source_root=source_root))
    return Err(f"no standard graph source selected for {package}")


pub def registry_artifacts(facets: list[LocalFacet], request: RustBuild) -> Result[Dict[str, str], str]:
    """Select each exact registry artifact once through the ordinary prepared-unit registry."""
    mut artifacts: Dict[str, str] = {}
    for facet in facets:
        for selected in facet.registry:
            selection = registry_selection(selected)?
            artifact = request.registry.artifact_for(selection, facet.domain.value())?
            artifacts[artifact] = selection.loaf
    return Ok(artifacts)


pub def registry_graphs(artifacts: Dict[str, str]) -> list[GraphUnit]:
    """Read graphs supplied by registry Loaves; older source-free registry artifacts remain external references."""
    mut graphs: list[GraphUnit] = []
    for artifact in sorted([key for key in artifacts.keys()]):
        loaf = artifacts[artifact]
        parts = loaf.split("/")
        graph = Path(artifact).parent().joinpath(f"{parts[len(parts) - 1]}.incngraph")
        if graph.is_file():
            graphs.append(GraphUnit(path=graph, root=Path(f"@{loaf}")))
    return graphs
