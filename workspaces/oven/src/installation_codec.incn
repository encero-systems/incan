"""One versioned typed page holds the installed toolchain, normalized standard manifests and their generations."""

from std.fs import MappedView
from std.io import BytesIO, _BytesIO
from manifest_intent import ProjectIntent
from installation_intent import read_intent, write_intent
from page_codec import Reader, put_number, put_text, put_texts
from toolchain_types import NativeCrate, InstalledCompiler
from compiler_record_admission import CompilerRecordPin
from frozen_inputs import Document
from page_values import read_value, write_value
from payload_types import InstalledPayload, PayloadAdmission

pub const PROFILE: str = "incan.installation-page/30"


pub model StandardManifest:
    """A standard package's validated authored intent and exact manifest identity, at its admitted location."""

    pub root: str
    pub digest: str
    pub intent: ProjectIntent


pub model Installation:
    """One installation's frozen facts and the input generations that justified admitting them."""

    pub toolchain: InstalledCompiler
    pub manifests: list[StandardManifest]
    pub paths: list[str]
    pub stamps: list[str]
    pub documents: list[Document] = []
    pub payloads: list[InstalledPayload] = []


pub def encode(page: Installation) -> Result[bytes, str]:
    """Encode complete normalized facts in deterministic field order, excluding request-local mutable readings."""
    if len(page.paths) != len(page.stamps):
        return Err("installation page observations differ from its paths")
    buffer = BytesIO(b"")
    put_text(buffer, PROFILE)?
    write_toolchain(buffer, page.toolchain)?
    put_number(buffer, len(page.manifests))?
    for manifest in page.manifests:
        put_text(buffer, manifest.root)?
        put_text(buffer, manifest.digest)?
        write_intent(buffer, manifest.intent)?
    put_texts(buffer, page.paths)?
    put_texts(buffer, page.stamps)?
    put_number(buffer, len(page.documents))?
    for document in page.documents:
        put_text(buffer, document.path)?
        put_text(buffer, document.stamp)?
        write_value(buffer, document.value)?
    put_number(buffer, len(page.payloads))?
    for payload in page.payloads:
        write_payload(buffer, payload)?
    return Ok(buffer.getvalue())


pub def decode(view: MappedView) -> Result[Installation, str]:
    """Refuse unknown versions, truncated or duplicate rows, malformed identities and trailing bytes."""
    mut reader = Reader(view=view)
    profile = reader.text()?
    if profile not in [PROFILE, "incan.installation-page/29", "incan.installation-page/28", "incan.installation-page/27", "incan.installation-page/26", "incan.installation-page/25", "incan.installation-page/24", "incan.installation-page/23", "incan.installation-page/22"]:
        return Err("unsupported installation page version")
    toolchain = read_toolchain(reader, profile)?
    mut manifests: list[StandardManifest] = []
    mut roots: set[str] = set()
    mut names: set[str] = set()
    for _index in range(reader.count(32)?):
        root = reader.text()?
        digest = reader.text()?
        intent = read_intent(reader)?
        if root in roots or intent.name in names or len(digest) != 64:
            return Err("installation page has duplicate manifests or invalid identities")
        roots.add(root)
        names.add(intent.name)
        manifests.append(StandardManifest(root=root, digest=digest, intent=intent))
    paths = reader.texts()?
    stamps = reader.texts()?
    mut documents: list[Document] = []
    mut document_paths: set[str] = set()
    for _index in range(reader.count(24)?):
        path = reader.text()?
        if path in document_paths:
            return Err("installation page has duplicate document paths")
        document_paths.add(path)
        documents.append(Document(path=path, stamp=reader.text()?, value=read_value(reader)?))
    mut payloads: list[InstalledPayload] = []
    mut payload_paths: set[str] = set()
    for _index in range(reader.count(56)?):
        payload = read_payload(reader, profile)?
        if payload.path in payload_paths or len(payload.admission.payload) != 64:
            return Err("installation page has duplicate payload paths or invalid digests")
        payload_paths.add(payload.path)
        payloads.append(payload)
    if len(paths) != len(stamps) or reader.offset != view.len():
        return Err("installation page has inconsistent observations or trailing bytes")
    if len(set(paths)) != len(paths):
        return Err("installation page has duplicate observation paths")
    return Ok(
        Installation(
            toolchain=toolchain,
            manifests=manifests,
            paths=paths,
            stamps=stamps,
            documents=documents,
            payloads=payloads,
        ),
    )


def read_payload(mut reader: Reader, profile: str) -> Result[InstalledPayload, str]:
    """Read the producer identity and exact admitted payload generation without reconstructing publication JSON."""
    path = reader.text()?
    record = reader.text()?
    stamp = reader.text()?
    mut proof = PayloadAdmission(
        identity=reader.text()?, payload=reader.text()?, observation=reader.text()?, provenance=reader.texts()?,
        facts=reader.text()?,
    )
    if profile != "incan.installation-page/22":
        proof.refusal = reader.text()?
    return Ok(InstalledPayload(path=path, record=record, record_stamp=stamp, admission=proof))


def write_payload(buffer: _BytesIO, payload: InstalledPayload) -> Result[None, str]:
    """Keep producer, payload digest, provenance, filesystem observations and published facts distinct in the page."""
    admission = payload.admission
    for value in [
        payload.path,
        payload.record,
        payload.record_stamp,
        admission.identity,
        admission.payload,
        admission.observation,
    ]:
        put_text(buffer, value)?
    put_texts(buffer, admission.provenance)?
    put_text(buffer, admission.facts)?
    return put_text(buffer, admission.refusal)


def read_toolchain(mut reader: Reader, profile: str) -> Result[InstalledCompiler, str]:
    """Read installed compiler fields without reconstructing the description's JSON tree."""
    driver = reader.text()?
    sysroot = reader.text()?
    abi = reader.texts()?
    mut externs: list[NativeCrate] = []
    for _index in range(reader.count(16)?):
        externs.append(NativeCrate(name=reader.text()?, path=reader.text()?, identity=reader.text()?))
    mut toolchain = InstalledCompiler(
        driver=driver,
        sysroot=sysroot,
        rust_abi=abi,
        externs=externs,
        search=reader.texts()?,
        registry_units=reader.text()?,
        registry_units_identity=reader.text()?,
        codegraph_on_request=reader.count(1)? == 1,
        closure_anchors=reader.count(1)? == 1,
        registry_lock=reader.text()?,
        c_compiler=reader.text()?,
        target=reader.text()?,
        rust_version=reader.text()?,
        default_deployment_target=reader.text()?,
        default_sdk_identity=reader.text()?,
        rustc_observation=reader.text()?,
        default_trusted_publishers=reader.texts()?,
        compiler_records=read_compiler_record_pin(reader, profile)?,
        compiler_facts=reader.texts()?,
        driver_observation=reader.text()?,
    )
    if profile in [PROFILE, "incan.installation-page/29", "incan.installation-page/28", "incan.installation-page/27", "incan.installation-page/26", "incan.installation-page/25", "incan.installation-page/24"]:
        toolchain.search_index_crumb = reader.count(1)? == 1
    if profile in [PROFILE, "incan.installation-page/29", "incan.installation-page/28", "incan.installation-page/27", "incan.installation-page/26"]:
        toolchain.checked_body_counts_crumb = reader.count(1)? == 1
    if profile in [PROFILE, "incan.installation-page/29", "incan.installation-page/28", "incan.installation-page/27"]:
        toolchain.worker_protocol_crumb = reader.count(1)? == 1
    if profile in [PROFILE, "incan.installation-page/29", "incan.installation-page/28"]:
        toolchain.unit_descriptor_crumb = reader.count(1)? == 1
    if profile in [PROFILE, "incan.installation-page/29"]:
        toolchain.compiler_record_export_crumb = reader.count(1)? == 1
    if profile == PROFILE:
        toolchain.namespace_references = reader.count(1)? == 1
    return Ok(toolchain)


def write_toolchain(buffer: _BytesIO, toolchain: InstalledCompiler) -> Result[None, str]:
    """Persist installed fields only; console, worker selection and closure memoization belong to each request."""
    put_text(buffer, toolchain.driver)?
    put_text(buffer, toolchain.sysroot)?
    put_texts(buffer, toolchain.rust_abi)?
    put_number(buffer, len(toolchain.externs))?
    for native in toolchain.externs:
        put_text(buffer, native.name)?
        put_text(buffer, native.path)?
        put_text(buffer, native.identity)?
    put_texts(buffer, toolchain.search)?
    put_text(buffer, toolchain.registry_units)?
    put_text(buffer, toolchain.registry_units_identity)?
    if toolchain.codegraph_on_request:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.closure_anchors:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    put_text(buffer, toolchain.registry_lock)?
    put_text(buffer, toolchain.c_compiler)?
    put_text(buffer, toolchain.target)?
    put_text(buffer, toolchain.rust_version)?
    put_text(buffer, toolchain.default_deployment_target)?
    put_text(buffer, toolchain.default_sdk_identity)?
    put_text(buffer, toolchain.rustc_observation)?
    put_texts(buffer, toolchain.default_trusted_publishers)?
    match toolchain.compiler_records:
        None => put_number(buffer, 0)?
        Some(pin) =>
            put_number(buffer, 1)?
            put_text(buffer, pin.root)?
            put_text(buffer, pin.digest)?
            put_text(buffer, pin.directory)?
    put_texts(buffer, toolchain.compiler_facts)?
    put_text(buffer, toolchain.driver_observation)?
    if toolchain.search_index_crumb:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.checked_body_counts_crumb:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.worker_protocol_crumb:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.unit_descriptor_crumb:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.compiler_record_export_crumb:
        put_number(buffer, 1)?
    else:
        put_number(buffer, 0)?
    if toolchain.namespace_references:
        return put_number(buffer, 1)
    return put_number(buffer, 0)


def read_compiler_record_pin(mut reader: Reader, profile: str) -> Result[Option[CompilerRecordPin], str]:
    """Read the optional installed record authority; any non-Boolean discriminator is malformed."""
    present = reader.count(1)?
    if present == 0:
        return Ok(None)
    if present != 1:
        return Err("installation page has an invalid compiler-record discriminator")
    root = reader.text()?
    digest = reader.text()?
    if root == "" or len(digest) != 64:
        return Err("installation page has an invalid compiler-record pin")
    mut directory = ""
    if profile in [PROFILE, "incan.installation-page/29", "incan.installation-page/28", "incan.installation-page/27", "incan.installation-page/26", "incan.installation-page/25"]:
        directory = reader.text()?
    return Ok(Some(CompilerRecordPin(root=root, digest=digest, directory=directory)))
