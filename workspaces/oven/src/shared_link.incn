"""Select local debug linkage and bind its loader generations at link time."""

from std.fs import Path
from home import home
from unit import UnitDescription
from unit_freshness import Key, fingerprint

# Version 2 admits the witness's frozen loader generations when the native unit is recorded instead of on each use.
const LINKAGE_SCHEMA: str = "incan.native-shared-linkage/2"


pub def development_link(unit: UnitDescription, requested: bool) -> bool:
    """
    Requested debug executables use shared linkage; libraries and release programs retain static linkage. A unit that
    links the toolchain's own libraries uses the standard library they were built with, so it shares no carriers.
    """
    sysroot = len(unit.toolchain_access.sysroot_dependencies) > 0
    return requested and unit.profile == "debug" and unit.kind != "library" and not sysroot


pub def linkage_key(key: Key, shared: bool) -> Result[Key, str]:
    """Keep source and artifact evidence while separating shared development outputs from ordinary build outputs."""
    if not shared or key.refusal != "":
        return Ok(key)
    return Ok(
        Key(
            digest="sha256:" + fingerprint([LINKAGE_SCHEMA, key.digest])?,
            parts=key.parts + [f"linkage {LINKAGE_SCHEMA}"],
            codegen=key.codegen,
            provenance=key.provenance,
            descriptor=key.descriptor,
            compiler=key.compiler,
        ),
    )


pub def shared_arguments(unit: UnitDescription, requested: bool) -> Result[list[str], str]:
    """Select the home's immutable native store only for a requested development executable."""
    if not development_link(unit, requested):
        return Ok([])
    directory = home()?.joinpath("store").joinpath("native-shared").absolute().map_err(
        (error) => f"cannot make absolute {error.message()}",
    )?
    return Ok(["--shared-native", directory.0])


pub def library_witness(binary: Path) -> Path:
    """The native compiler's exact dynamic-library generations beside a completed development executable."""
    return Path(f"{binary.0}.native-shared.json")
