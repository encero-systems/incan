"""Read dependency Loaf graphs and export only the selected project's own Rust units."""

from rust::std::process import Command, id
from std.fs import Path
from features import FeatureRequest
from graph_cache import GraphUnit, cache_file, compiler_digest, fingerprint, publish_binary, tree_inputs
from graph_dependencies import prepare_graph
from graph_loaves import registry_artifacts, registry_graphs, standard_graphs
from loaf_local_graph import LocalFacet
from rust_activation import DependencyDomain
from rust_units import RustBuild, BuiltUnit, binary_environment, decoded, library_arguments, linking, package_environment, rust_facet
from toolchain import Toolchain


pub def inspect_rust(root: Path, profile: str, features: FeatureRequest, substitutes: Dict[str, str], toolchain: Toolchain) -> Result[list[GraphUnit], str]:
    """Dependencies contribute their published binary graphs; older local Loaves get one cached checked export."""
    prepared = prepare_graph(root, profile, features, substitutes, toolchain)?
    mut paths = prepared.paths
    if len(paths) > 0:
        paths = paths + standard_graphs(root, profile, toolchain, paths)?
    mut native = ["incan.codegraph.rust/3", compiler_digest(root, toolchain.driver)?, toolchain.sysroot]
    mut search = prepared.request.registry.search
    for key in sorted([key for key in prepared.built.keys()]):
        library = prepared.built[key]
        native = native + [library.artifact, compiler_digest(root, library.artifact)?]
        search.append(library.directory)
    registry = registry_artifacts(prepared.facets, prepared.request)?
    for artifact in sorted([key for key in registry.keys()]):
        native = native + [artifact, compiler_digest(root, artifact)?]
    paths = paths + registry_graphs(registry)
    for facet in prepared.facets:
        declared = rust_facet(facet.project, false)?
        own = facet.project == root.0 and facet.domain == DependencyDomain.Target
        key = f"{facet.project}@{facet.domain.value()}"
        if declared.kind != "":
            mut graph = Path("")
            if not own and key in prepared.built:
                graph = Path(prepared.built[key].directory).joinpath(f"{declared.package}.incngraph")
            if graph.0 != "" and graph.is_file():
                paths.append(GraphUnit(path=graph, root=Path(facet.project), package=declared.package, version=declared.version))
            else:
                inputs = native + [facet.project, facet.domain.value(), str(facet.features), "library"] + tree_inputs(Path(facet.project))?
                graph = cache_file(root, fingerprint(inputs)?)?
                if not graph.is_file():
                    arguments = library_arguments(declared) + linking(facet, prepared.request, prepared.built, search)?
                    observe(graph, facet, arguments, package_environment(facet.project, declared, declared.crate_name), false, toolchain)?
                paths.append(GraphUnit(path=graph, root=Path(facet.project)))
        if own:
            for name, source in declared.binaries:
                inputs = native + [facet.project, f"binary:{name}", str(facet.features)] + tree_inputs(root)?
                graph = cache_file(root, fingerprint(inputs)?)?
                if not graph.is_file():
                    mut arguments = [source, "--crate-name", name.replace("-", "_"), "--crate-type", "bin", "--edition", declared.edition] + linking(facet, prepared.request, prepared.built, search)?
                    if key in prepared.built:
                        arguments = arguments + ["--extern", f"{declared.crate_name}={prepared.built[key].artifact}"]
                    environment = binary_environment(prepared.request.rustc, facet.project, declared, name.replace("-", "_"))?
                    observe(graph, facet, arguments, environment, declared.unstable, toolchain)?
                paths.append(GraphUnit(path=graph, root=root))
    return Ok(paths)


def observe(path: Path, facet: LocalFacet, arguments: list[str], environment: Dict[str, str], unstable: bool, toolchain: Toolchain) -> Result[None, str]:
    """Run the installed compiler in analysis-only mode and atomically publish only its complete binary graph."""
    output = Path(f"{path.0}.{id()}.analysis")
    mut command = Command.new(toolchain.driver)
    command.env_remove("RUSTC_BOOTSTRAP")
    if unstable:
        command.env("RUSTC_BOOTSTRAP", "1")
    for name in sorted([key for key in environment.keys()]):
        value = environment[name]
        command.env(name, value)
    for argument in ["--rust-codegraph", output.0, facet.project, "--sysroot", toolchain.sysroot, "--cap-lints", "allow"] + arguments:
        command.arg(argument)
    result = command.output().map_err((error) => str(error))?
    if not result.status.success():
        return Err(f"Rust graph analysis failed for {facet.project}:\n{decoded(result.stderr)}")
    content = output.read_bytes().map_err((error) => error.message())?
    publish_binary(path, content)?
    output.unlink().map_err((error) => error.message())?
    return Ok(None)
