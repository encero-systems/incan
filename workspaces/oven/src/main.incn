"""
`incan`: the command line, which is Oven (DD-0008).

    incan run PATH [UNIT OPTIONS] [-- ARGS...]
    incan check PATH [--format text|json] [UNIT OPTIONS]
    incan test PATH [UNIT OPTIONS]
    incan describe-unit PATH [UNIT OPTIONS]
    incan build PATH [--substitute NAME=DIR] [UNIT OPTIONS]
    incan fmt [--check] PATH...
    incan inspect codegraph PATH [--format json|jsonl] [--query KIND TERM] [--limit N] [--strict]
    incan toolchain pack OUT
    incan toolchain install ARCHIVE
    incan --version

UNIT OPTIONS are `--profile NAME`, `--features A,B`, `--no-default-features` and `--all-features`.
"""

from rust::std::env import args
from rust::std::io import Write, stderr
from rust::std::process import exit
from rust::std::string import String as RustString
from std.fs import Path
from features import FeatureRequest
from home import TOOLCHAIN, dependency_artifact_dir
from unit_rust import describe_native
from incan_units import check_unit, compile_unit, crate_name, run_program
from rust_units import RustBuild, build_rust, read_registry_units
from toolchain import load_toolchain, rust_compiler
from formatting import format_paths
from testing import run_tests
from graph_inspection import inspect_codegraph
from toolchain_archive import toolchain_command


pub model Options:
    """The options shared by the commands that describe a unit."""

    pub path: str = ""
    pub profile: str = "debug"
    pub request: FeatureRequest = FeatureRequest()
    pub substitutes: Dict[str, str] = {}


def main() -> None:
    mut arguments: list[str] = []
    for argument in args():
        arguments.append(argument)
    if len(arguments) < 2:
        fail(usage(), 2)
    command = arguments[1]
    rest = arguments[2:]
    if command == "--version" or command == "version":
        println(f"incan {TOOLCHAIN}")
        return
    if command == "run":
        run(rest)
        return
    if command == "check":
        check(rest)
        return
    if command == "test":
        test(rest)
        return
    if command == "build":
        build(rest)
        return
    if command == "describe-unit":
        describe_unit(rest)
        return
    if command == "fmt":
        finish("fmt", format_paths(rest))
        return
    if command == "inspect":
        finish("inspect", inspect_codegraph(rest))
        return
    if command == "toolchain":
        finish("toolchain", toolchain_command(rest))
        return
    fail(f"incan: unknown command `{command}`\n{usage()}", 2)


def usage() -> str:
    """The command line's usage."""
    return "usage: incan run PATH [UNIT OPTIONS] [-- ARGS...]\n       incan check PATH [--format text|json] [UNIT OPTIONS]\n       incan test PATH [UNIT OPTIONS]\n       incan describe-unit PATH [UNIT OPTIONS]\n       incan build PATH [--substitute NAME=DIR] [UNIT OPTIONS]\n       incan fmt [--check] PATH...\nUNIT OPTIONS: --profile NAME, --features A,B, --no-default-features, --all-features"


def fail(message: str, code: i32) -> None:
    """Print `message` to stderr and exit with `code`."""
    mut err = stderr()
    _ = err.write_all(RustString.from(f"{message}\n").into_bytes())
    exit(code)


def parse_options(arguments: list[str]) -> Result[Options, str]:
    """The unit options: one PATH and the profile and feature flags."""
    mut options = Options()
    mut index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--profile" or argument == "--features" or argument == "--substitute":
            if index + 1 >= len(arguments):
                return Err(f"`{argument}` needs a value")
            value = arguments[index + 1]
            if argument == "--substitute":
                parts = value.split("=")
                if len(parts) != 2 or parts[0] == "" or parts[1] == "":
                    return Err(f"`--substitute` takes NAME=DIR, got `{value}`")
                options.substitutes[parts[0]] = parts[1]
            elif argument == "--profile":
                options.profile = value
            else:
                for name in value.split(","):
                    if name.strip() != "":
                        options.request.features.append(name.strip())
            index += 2
            continue
        if argument == "--no-default-features":
            options.request.default_features = false
        elif argument == "--all-features":
            options.request.all_features = true
        elif argument.startswith("-"):
            return Err(f"unknown option `{argument}`")
        elif options.path != "":
            return Err(f"one PATH is described at a time; `{argument}` is a second")
        else:
            options.path = argument
        index += 1
    if options.path == "":
        return Err("a PATH is required")
    return Ok(options)


def run(arguments: list[str]) -> None:
    """Compile the program whose entry source is PATH and run it with the arguments after `--`."""
    mut own: list[str] = []
    mut passed: list[str] = []
    mut after = false
    for argument in arguments:
        if after:
            passed.append(argument)
        elif argument == "--":
            after = true
        else:
            own.append(argument)
    match parse_options(own):
        Err(reason) => fail(f"incan run: {reason}\n{usage()}", 2)
        Ok(options) => finish("run", ran(options, passed))


def ran(options: Options, passed: list[str]) -> Result[i32, str]:
    """Compile the unit into its project's target directory and run it; a refused compile is the run's result."""
    unit = describe_native(Path(options.path), options.profile, options.request)?
    toolchain = load_toolchain()?
    binary = Path(unit.project_root).joinpath("target").joinpath("incan").joinpath(options.profile).joinpath("bin").joinpath(crate_name(unit))
    compiled = compile_unit(unit, toolchain, binary)?
    if compiled != 0:
        return Ok(compiled)
    return run_program(binary, passed)


def test(arguments: list[str]) -> None:
    """Compile one collected test unit and report each test's observed outcome."""
    match parse_options(arguments):
        Err(reason) => fail(f"incan test: {reason}\n{usage()}", 2)
        Ok(options) => finish("test", tested(options))


def tested(options: Options) -> Result[i32, str]:
    """Prepare a test unit's exact native dependencies with the same profile and feature options as a program."""
    mut unit = describe_native(Path(options.path), options.profile, options.request)?
    unit.kind = "test"
    return run_tests(unit, load_toolchain()?)


def check(arguments: list[str]) -> None:
    """Check the unit whose entry source is PATH; the report is text, or JSON with `--format json`."""
    mut format = "text"
    mut own: list[str] = []
    mut index = 0
    while index < len(arguments):
        if arguments[index] == "--format" and index + 1 < len(arguments):
            format = arguments[index + 1]
            index += 2
            continue
        own.append(arguments[index])
        index += 1
    if format != "text" and format != "json":
        fail(f"incan check: `--format` is text or json, got `{format}`", 2)
    match parse_options(own):
        Err(reason) => fail(f"incan check: {reason}\n{usage()}", 2)
        Ok(options) => finish("check", checked(options, format))


def checked(options: Options, format: str) -> Result[i32, str]:
    """Check the described unit with the toolchain's compiler."""
    unit = describe_native(Path(options.path), options.profile, options.request)?
    return check_unit(unit, load_toolchain()?, format)


def finish(command: str, result: Result[i32, str]) -> None:
    """Exit with a command's exit code, or report why it could not run."""
    match result:
        Err(reason) => fail(f"incan {command}: {reason}", 1)
        Ok(code) => exit(code)


def describe_unit(arguments: list[str]) -> None:
    """Print the unit description of the unit whose entry source is PATH."""
    match parse_options(arguments):
        Err(reason) => fail(f"incan describe-unit: {reason}\n{usage()}", 2)
        Ok(options) =>
            match describe_native(Path(options.path), options.profile, options.request):
                Err(reason) => fail(f"incan describe-unit: {reason}", 1)
                Ok(unit) =>
                    match unit.to_json().to_pretty_json():
                        Err(error) => fail(f"incan describe-unit: {error.message()}", 1)
                        Ok(text) => println(text)


def build(arguments: list[str]) -> None:
    """Compile an Incan source unit or a Rust project against the installed toolchain's registry units."""
    match parse_options(arguments):
        Err(reason) => fail(f"incan build: {reason}\n{usage()}", 2)
        Ok(options) =>
            match build_source(Path(options.path)):
                Some(source) =>
                    finish("build", built(options, source))
                    return
                None => pass
            match build_project(options):
                Err(reason) => fail(f"incan build: {reason}", 1)
                Ok(binaries) =>
                    for binary in binaries:
                        println(f"binary: {binary}")


def build_project(options: Options) -> Result[list[str], str]:
    """Compile a Rust project against the registry units of its installed toolchain."""
    toolchain = load_toolchain()?
    registry = read_registry_units(Path(toolchain.registry_units))?
    request = RustBuild(
        project=options.path,
        profile=options.profile,
        rustc=rust_compiler(toolchain),
        registry=registry,
        features=options.request.features,
        default_features=options.request.default_features,
        substitutes=options.substitutes,
    )
    return build_rust(request)


def build_source(path: Path) -> Option[Path]:
    """Select an explicit source or a directory's conventional Incan entry; other directories name Rust projects."""
    if path.is_file():
        return Some(path)
    for name in ["lib.incn", "main.incn"]:
        source = path.joinpath("src").joinpath(name)
        if source.is_file():
            return Some(source)
    return None


def built(options: Options, source: Path) -> Result[i32, str]:
    """Build a source file or a project's conventional library or main program, preparing its path dependencies."""
    mut unit = describe_native(source, options.profile, options.request)?
    library = source.name() == "lib.incn"
    mut output = Path(unit.project_root).joinpath("target").joinpath("incan").joinpath(unit.profile).joinpath("bin").joinpath(crate_name(unit))
    if library:
        unit.kind = "library"
        output = dependency_artifact_dir(unit.project_root, unit.package, unit.profile).joinpath(f"lib{crate_name(unit)}.rlib")
    return compile_unit(unit, load_toolchain()?, output)
