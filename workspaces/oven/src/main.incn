"""Dispatch Oven's public commands and report command syntax before accessing projects or the toolchain."""

from rust::std::env import args
from rust::std::io import Write, stderr
from rust::std::process import exit
from rust::std::string import String as RustString
from std.fs import Path
from features import FeatureRequest
from home import TOOLCHAIN, dependency_artifact_dir
from intake import read_project, source_root_of
from unit import describe, project_root_of
from unit_rust import compile_incan_library, describe_native
from incan_units import check_unit, compile_unit, program_binary, run_program
from unit_compiler import crate_name
from rust_units import RustBuild, build_rust, read_registry_units
from toolchain import load_toolchain, rust_compiler
from formatting import format_paths, parse_arguments as format_options
from testing import run_collected, run_tests
from owner_client import owned, status_code
from owner_protocol import Reply
from owner_endpoint import stop_owners
from observation import trace_boundary
from owner_service import serve_owner
from graph_inspection import inspect_codegraph, options as graph_options
from graph_mcp import serve_graph, parse_path
from toolchain_archive import toolchain_command, parse_arguments as archive_options
from cli_help import HELP_HINT, unknown_option
from command_help import UNIT_VALUE_OPTIONS, command_help, usage


pub model Options:
    """The options shared by the commands that describe a unit."""

    pub path: str = ""
    pub profile: str = "debug"
    pub request: FeatureRequest = FeatureRequest()
    pub substitutes: Dict[str, str] = {}
    pub program_entries: list[str] = []
    pub argv0: Option[str] = None
    pub feature_options: bool = false


def main() -> None:
    """
    Dispatch the public CLI with syntax errors reported as exit status two.

    1. Read the process arguments and require a command.
    2. Answer help before accessing projects, installations or transports.
    3. Execute the selected command.
    """
    trace_boundary("command_entered")
    # 1. A missing command is a syntax error.
    mut arguments: list[str] = []
    for argument in args():
        arguments.append(argument)
    if len(arguments) < 2:
        fail("incan: a command is required", 2)
    command = arguments[1]
    rest = arguments[2:]
    # 2. Help never prepares a unit or starts a server.
    if command in ["--help", "-h", "help"]:
        require_no_arguments(command, rest)
        println(usage())
        return
    match command_help(command, rest):
        Some(text) =>
            println(text)
            return
        None => pass
    # 3. Each command keeps its own parsing and execution boundary.
    dispatch(command, rest)


def dispatch(command: str, rest: list[str]) -> None:
    """Execute one command, preserving syntax status two separately from runtime failures."""
    if command == "--version" or command == "version":
        require_no_arguments(command, rest)
        println(f"incan {TOOLCHAIN}")
        return
    if command == "run":
        run(rest)
        return
    if command == "_run-built":
        run_built(rest)
        return
    if command == "check":
        check(rest)
        return
    if command == "test":
        test(rest)
        return
    if command == "build":
        build(rest)
        return
    if command == "describe-unit":
        describe_unit(rest)
        return
    if command == "fmt":
        match format_options(rest):
            Err(reason) => argument_error("fmt", reason)
            Ok(options) => finish("fmt", format_paths(options))
        return
    if command == "--internal-owner":
        finish("owner", serve_owner(rest))
        return
    if command == "owner":
        owner(rest)
        return
    if command == "inspect":
        match graph_options(rest):
            Err(reason) => argument_error("inspect", reason)
            Ok(options) => finish("inspect", inspect_codegraph(options))
        return
    if command == "mcp":
        match parse_path(rest):
            Err(reason) => argument_error("mcp", reason)
            Ok(path) => finish("mcp", serve_graph(path))
        return
    if command == "toolchain":
        match archive_options(rest):
            Err(reason) => argument_error("toolchain", reason)
            Ok(options) => finish("toolchain", toolchain_command(options))
        return
    if command.startswith("-"):
        fail(f"incan: unknown option `{command}`", 2)
    fail(f"incan: unknown command `{command}`", 2)


def require_no_arguments(command: str, arguments: list[str]) -> None:
    """Refuse extra version or overview arguments instead of silently discarding them."""
    match unknown_option(arguments):
        Some(reason) => syntax_error(command, reason)
        None => pass
    if len(arguments) > 0:
        syntax_error(command, f"unexpected argument `{arguments[0]}`")


def syntax_error(command: str, reason: str) -> None:
    """Report a command parser's refusal using the CLI syntax status and common help pointer."""
    fail(f"incan {command}: {reason}", 2)


def argument_error(command: str, reason: str) -> None:
    """Give unknown commands/options status two while preserving existing operand-value refusal statuses."""
    if reason.startswith("unknown command `") or reason.startswith("unknown option `"):
        syntax_error(command, reason)
    fail(f"incan {command}: {reason}", 1)


def fail(message: str, code: i32) -> None:
    """Print `message` to stderr and exit with `code`."""
    mut err = stderr()
    # A closed standard error cannot be told about, so a failed write is ignored.
    mut text = f"{message}\n"
    if code == 2:
        text += f"{HELP_HINT}\n"
    _ = err.write_all(RustString.from(text).into_bytes())
    exit(code)


def parse_options(arguments: list[str]) -> Result[Options, str]:
    """The unit options: one PATH and the profile and feature flags."""
    mut options = Options()
    mut index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in UNIT_VALUE_OPTIONS:
            if index + 1 >= len(arguments):
                return Err(f"`{argument}` needs a value")
            apply_option(options, argument, arguments[index + 1])?
            if argument == "--features":
                options.feature_options = true
            index += 2
            continue
        if argument == "--no-default-features":
            options.feature_options = true
            options.request.default_features = false
        elif argument == "--all-features":
            options.feature_options = true
            options.request.all_features = true
        elif argument.startswith("-"):
            return Err(f"unknown option `{argument}`")
        elif options.path != "":
            return Err(f"one PATH is described at a time; `{argument}` is a second")
        else:
            options.path = argument
        index += 1
    if options.path == "":
        return Err("a PATH is required")
    return Ok(options)


def apply_option(mut options: Options, name: str, value: str) -> Result[None, str]:
    """Apply one option that takes a value: the profile, features, a substitute, a program entry or `--argv0`."""
    if name == "--argv0":
        options.argv0 = Some(value)
    elif name == "--program-entry":
        options.program_entries.append(value)
    elif name == "--substitute":
        parts = value.split("=")
        if len(parts) != 2 or parts[0] == "" or parts[1] == "":
            return Err(f"`--substitute` takes NAME=DIR, got `{value}`")
        options.substitutes[parts[0]] = parts[1]
    elif name == "--profile":
        options.profile = value
    else:
        for feature in value.split(","):
            if feature.strip() != "":
                options.request.features.append(feature.strip())
    return Ok(None)


def run(arguments: list[str]) -> None:
    """Compile the program whose entry source is PATH and run it with the arguments after `--`."""
    own, passed = program_arguments(arguments)
    match parse_options(own):
        Err(reason) => syntax_error("run", reason)
        Ok(options) => finish("run", ran(validated("run", options), passed))


def program_arguments(arguments: list[str]) -> tuple[list[str], list[str]]:
    """Separate command options from the program's arguments without forwarding internal selectors."""
    mut own: list[str] = []
    mut passed: list[str] = []
    mut after = false
    for argument in arguments:
        if after:
            passed.append(argument)
        elif argument == "--":
            after = true
        else:
            own.append(argument)
    return (own, passed)


def run_built(arguments: list[str]) -> None:
    """
    Execute a program the calling build just verified, through run's canonical process policy.

    This internal caller owns input freshness.
    """
    own, passed = program_arguments(arguments)
    match parse_options(own):
        Err(reason) => fail(f"incan run: {reason}", 2)
        Ok(options) =>
            if len(options.program_entries) > 0:
                fail("a built program already has its selected entries", 2)
            finish("run", run_program(Path(options.path), passed, options.argv0))


def ran(options: Options, passed: list[str]) -> Result[i32, str]:
    """
    Make the unit's executable, through its owner or in this process, and become it; a refused compile is the run's
    result.

    1. The project's owner makes the executable when it serves the unit.
    2. Otherwise describe the unit, compile it here and keep the stored executable while its inputs are unchanged.
    3. Become the program.
    """
    # 1. When the project's owner serves the unit, it made the executable, and a refused compile is the run's result.
    match via_owner("run", options, Path(options.path)):
        Some(reply) =>
            if reply.exit != 0:
                return Ok(status_code(reply.exit))
            return run_program(Path(reply.binary), passed, options.argv0)
        None => pass
    # 2. Otherwise this process describes and compiles the unit, keeping the stored executable while its inputs hold.
    mut unit = describe(Path(options.path), options.profile, options.request)?
    unit.program_entries = options.program_entries
    toolchain = load_toolchain()?
    binary = program_binary(unit)
    compiled = compile_unit(unit, toolchain, binary, true)?
    if compiled != 0:
        return Ok(compiled)
    # 3. The process becomes the program, so its exit status is the run's.
    return run_program(binary, passed, options.argv0)


def via_owner(command: str, options: Options, entry: Path) -> Option[Reply]:
    """The reply of the project's resident owner, which has made the executable; `None` when this process should."""
    if len(options.substitutes) > 0 or len(options.program_entries) > 0:
        return None
    request = options.request
    return owned(command, entry, options.profile, request.features, request.default_features, request.all_features)


def test(arguments: list[str]) -> None:
    """Compile one collected test unit and report each test's observed outcome."""
    match parse_options(arguments):
        Err(reason) => syntax_error("test", reason)
        Ok(options) => finish("test", tested(validated("test", options)))


def tested(options: Options) -> Result[i32, str]:
    """Make a test unit's executable, through its owner or in this process, and report each test's fresh outcome."""
    match via_owner("test", options, Path(options.path)):
        Some(reply) =>
            if reply.exit != 0:
                return Ok(status_code(reply.exit))
            return run_collected(Path(reply.binary), Path(options.path).name())
        None => pass
    mut unit = describe(Path(options.path), options.profile, options.request)?
    unit.kind = "test"
    return run_tests(unit, load_toolchain()?)


def check(arguments: list[str]) -> None:
    """Check the unit whose entry source is PATH; the report is text, or JSON with `--format json`."""
    mut format = "text"
    mut own: list[str] = []
    mut index = 0
    while index < len(arguments):
        if arguments[index] == "--format" and index + 1 < len(arguments):
            format = arguments[index + 1]
            index += 2
            continue
        own.append(arguments[index])
        index += 1
    if format != "text" and format != "json":
        fail(f"incan check: `--format` is text or json, got `{format}`", 2)
    match parse_options(own):
        Err(reason) => syntax_error("check", reason)
        Ok(options) => finish("check", checked(validated("check", options), format))


def checked(options: Options, format: str) -> Result[i32, str]:
    """Describe an ordinary unit, then let checking prepare its dependencies and exact native inputs once."""
    unit = describe(Path(options.path), options.profile, options.request)?
    return check_unit(unit, load_toolchain()?, format)


def finish(command: str, result: Result[i32, str]) -> None:
    """Exit with a command's exit code, or report why it could not run."""
    match result:
        Err(reason) => fail(f"incan {command}: {reason}", 1)
        Ok(code) => exit(code)


def validated(command: str, options: Options) -> Options:
    """Report unsupported option combinations with the command syntax exit status before preparation."""
    match require_command_options(command, options):
        Err(reason) => fail(f"incan {command}: {reason}", 2)
        Ok(_) => pass
    return options


def require_command_options(command: str, options: Options) -> Result[None, str]:
    """Each command admits only options it applies, and feature selection requires an owning project."""
    if options.argv0 != None and command != "run":
        return Err("--argv0 requires run")
    if len(options.program_entries) > 0 and command not in ["run", "build"]:
        return Err("--program-entry requires run/build")
    if len(options.substitutes) > 0 and command != "build":
        return Err("--substitute requires a Rust-project build")
    source = Path(options.path)
    mut project = project_root_of(source)
    if source.is_dir() and source.joinpath("loaf.toml").is_file():
        project = Some(source)
    if options.feature_options and project is None:
        return Err("feature selection requires a project")
    if command == "build" and (len(options.substitutes) > 0 or len(options.program_entries) > 0):
        selected = build_source(source)?
        if len(options.substitutes) > 0 and selected != None:
            return Err("--substitute requires a Rust-project build")
        if len(options.program_entries) > 0:
            match selected:
                None => return Err("--program-entry requires an Incan program build")
                Some(entry) =>
                    if entry.name() == "lib.incn":
                        return Err("--program-entry requires an Incan program build")
    return Ok(None)


def describe_unit(arguments: list[str]) -> None:
    """Print the unit description of the unit whose entry source is PATH."""
    match parse_options(arguments):
        Err(reason) => syntax_error("describe-unit", reason)
        Ok(options) => print_description(validated("describe-unit", options))


def print_description(options: Options) -> None:
    """
    Print the description of the unit `options` select.

    1. Options that only a run or build understands are refused (exit 2).
    2. The unit is described against the toolchain (exit 1 when it cannot be).
    3. The description is printed as JSON (exit 1 when it cannot be encoded).
    """
    # 1. Options that only a run or build understands are refused with the usage exit status.
    # 2. A unit that cannot be described against the toolchain ends the command with status 1.
    match describe_native(Path(options.path), options.profile, options.request):
        Err(reason) => fail(f"incan describe-unit: {reason}", 1)
        Ok(unit) =>
            # 3. The description is printed as JSON, or ends the command with status 1 when it cannot be encoded.
            match unit.to_json().to_pretty_json():
                Err(error) => fail(f"incan describe-unit: {error.message()}", 1)
                Ok(text) => println(text)


def build(arguments: list[str]) -> None:
    """Compile an Incan source unit or a Rust project against the installed toolchain's registry units."""
    match parse_options(arguments):
        Err(reason) => syntax_error("build", reason)
        Ok(options) => build_selected(validated("build", options))


def build_selected(options: Options) -> None:
    """Build an Incan source if the path names one, else the Rust project it names, printing its binaries."""
    match build_source(Path(options.path)):
        Err(reason) => fail(f"incan build: {reason}", 1)
        Ok(Some(source)) =>
            finish("build", built(options, source))
            return
        Ok(None) => pass
    match build_project(options):
        Err(reason) => fail(f"incan build: {reason}", 1)
        Ok(binaries) =>
            for binary in binaries:
                println(f"binary: {binary}")


def build_project(options: Options) -> Result[list[str], str]:
    """Compile a Rust project against the registry units of its installed toolchain."""
    toolchain = load_toolchain()?
    registry = read_registry_units(Path(toolchain.registry_units))?
    request = RustBuild(
        project=options.path,
        profile=options.profile,
        rustc=rust_compiler(toolchain),
        registry=registry,
        features=options.request.features,
        default_features=options.request.default_features,
        all_features=options.request.all_features,
        substitutes=options.substitutes,
        incan_compiler=Some(compile_incan_library),
        toolchain_search=toolchain.search,
        toolchain=Some(toolchain),
    )
    return build_rust(request)


def build_source(path: Path) -> Result[Option[Path], str]:
    """Select an explicit source or a directory's conventional Incan entry; other directories name Rust projects."""
    if path.is_file():
        return Ok(Some(path))
    if not path.joinpath("loaf.toml").is_file():
        return Ok(None)
    project = read_project(path).map_err((error) => error.message())?
    root = Path(source_root_of(project))
    for name in ["lib.incn", "main.incn"]:
        source = root.joinpath(name)
        if source.is_file():
            return Ok(Some(source))
    return Ok(None)


def built(options: Options, source: Path) -> Result[i32, str]:
    """
    Build a source file or a project's conventional library or main program, preparing its path dependencies.

    1. A library takes no program entries, and no build takes `--argv0`.
    2. A program is built by the project's owner when it serves the unit.
    3. Otherwise describe the unit and build it here: a library into its artifact directory, a program into `bin`.
    """
    # 1. A library takes no program entries, and no build takes `--argv0`.
    library = source.name() == "lib.incn"
    if options.argv0 != None or (library and len(options.program_entries) > 0):
        return Err("--argv0 requires run; program entries require a program unit")
    # 2. A program the project's owner serves is built there, and this process only reports the owner's status.
    if not library:
        match via_owner("build", options, source):
            Some(reply) => return Ok(status_code(reply.exit))
            None => pass
    # 3. Anything else is described and built here: a library into its artifact directory, a program into `bin`.
    mut unit = describe(source, options.profile, options.request)?
    unit.program_entries = options.program_entries
    mut output = program_binary(unit)
    if library:
        unit.kind = "library"
        directory = dependency_artifact_dir(unit.project_root, unit.package, unit.profile)
        output = directory.joinpath(f"lib{crate_name(unit)}.rlib")
    return compile_unit(unit, load_toolchain()?, output)


def owner(arguments: list[str]) -> None:
    """`incan owner stop`: stop the resident owners of this home."""
    match unknown_option(arguments):
        Some(reason) => syntax_error("owner", reason)
        None => pass
    if len(arguments) > 0 and arguments[0] != "stop":
        syntax_error("owner", f"unknown command `{arguments[0]}`")
    if arguments != ["stop"]:
        syntax_error("owner", "expected `stop`")
    match stop_owners():
        Err(reason) => fail(f"incan owner: {reason}", 1)
        Ok(stopped) => println(f"stopped {stopped} owners")
