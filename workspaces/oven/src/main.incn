from jec import begin as begin_work, record as record_work
from pub::incan_platform.trace import Operation


pub model Options:
    """The options shared by the commands that describe a unit."""

    pub path: str = ""
    pub profile: str = "debug"
    pub request: FeatureRequest = FeatureRequest()
    pub substitutes: Dict[str, str] = {}
    pub program_entries: list[str] = []
    pub argv0: Option[str] = None
    pub feature_options: bool = false
    pub engine_report: bool = false
    pub locked: bool = false
    pub direct: bool = false
    pub unattended: bool = false
    pub codegraph: bool = false
    # A build's OUTPUT_DIR, which also receives the program it builds; empty for none.
    pub output: str = ""
    # One CLI preparation owns its source readings, including its provider callbacks.
    pub manifests: ManifestReader = ManifestReader()


def main() -> None:
    """Dispatch the CLI and drain observations on normal return; explicit exits drain at their own boundary."""
    observe_work(WorkObserver(start=Some(begin_work), finish=Some(record_work)))
    command_line()
    finish_trace()


def command_line() -> None:
    """
    Dispatch the public CLI with syntax errors reported as exit status two.

    1. Read the process arguments and require a command.
    2. Refuse a command only the other surface runs, then answer help before accessing projects, installations or
       transports.
    3. Execute the selected command.
    """
    starting = begin_work()
    trace_boundary("command_entered")
    # 1. A missing command is a syntax error.
    surface = invoked()
    mut arguments: list[str] = []
    for argument in args():
        arguments.append(argument)
    if len(arguments) < 2:
        fail(f"{surface}: a command is required", 2)
    command = arguments[1]
    rest = arguments[2:]
    if command == "__rust-unit":
        scheduled_unit_command(rest)
        return
    # 2. A command of the other surface runs nowhere; help never prepares a unit or starts a server.
    match misplaced(surface, command, rest):
        Some(reason) => fail(reason, 2)
        None => pass
    if command in ["--help", "-h", "help"]:
        require_no_arguments(command, rest)
        println(usage(surface))
        return
    match command_help(surface, command, rest):
        Some(text) =>
            println(text)
            return
        None => pass
    # 3. Each command keeps its own parsing and execution boundary.
    record_work(Operation.CliStart, command, starting)
    dispatch(command, rest)


def dispatch(command: str, rest: list[str]) -> None:
    """Execute one command, preserving syntax status two separately from runtime failures."""
    if command in ["new", "init"] or (command == "version" and len(rest) > 0):
        project_command(command, rest)
        return
    if command == "workspace":
        workspace_command(rest)
        return
    if command in ["run", "check", "test", "build", "fmt"]:
        match parse_selection(rest):
            Err(reason) => syntax_error(command, reason)
            Ok(selection) =>
                if selected(selection):
                    finish(command, run_members(invoked(), command, selection))
    if command == "build":
        match parse_report(rest):
            Err(reason) => syntax_error(command, reason)
            Ok(report) =>
                if report.format is not None:
                    finish(command, reported_build(invoked(), report, expected_artifacts(report.remaining)))
    if command == "env":
        match parse_env(rest):
            Err(reason) => syntax_error(command, reason)
            Ok(request) => finish(command, env_command(request))
        return
    # `incan check` inspects; every other project command executes only on a toolchain the project admits (RFC 073).
    if command in ["run", "test", "build", "lock"] or (command == "check" and invoked() == OVEN):
        match command_admission(command, rest):
            Err(reason) => fail(f"{invoked()} {command}: {reason}", 1)
            Ok(_) => pass
    if command == "--version" or command == "version":
        require_no_arguments(command, rest)
        println(version_text(invoked()))
        return
    if command in ["run", "check", "test", "build", "describe-unit", "fmt", "inspect", "lock", "trust"]:
        begin_installation_command()
    if command == "--internal-engine":
        match serve_engine(rest):
            Ok(_) => return
            Err(reason) => fail(f"incan engine: refusal {refusal_code(reason.kind)}: {reason.detail}", 1)
        return
    if command == "tools":
        match parse_tools(rest):
            Err(reason) => argument_error("tools", reason)
            Ok(format) => finish("tools", doctor(format))
        return
    if command == "explain":
        explain(rest)
        return
    if command == "lock":
        lock(rest)
        return
    if command == "run":
        own, _passed = program_arguments(rest)
        if inline(own):
            run(rest)
            return
        match parse_options(own):
            Ok(options) =>
                if options.direct:
                    run(rest)
                    return
            Err(_) => pass
    if command == "trust":
        match trust_command(rest):
            Err(reason) => argument_error("trust", reason)
            Ok(report) => println(report)
        return
    match select_engine(get_or("INCAN_ENGINE", "legacy")):
        Err(reason) => fail(f"{invoked()} {command}: engine refusal {refusal_code(reason.kind)}: {reason.detail}", 2)
        Ok(Engine.Records) =>
            records_command(command, rest)
            return
        Ok(Engine.Legacy) => pass
    if command == "run":
        run(rest)
        return
    if command == "check":
        check(rest)
        return
    if command == "test":
        test(rest)
        return
    if command == "build":
        build(rest)
        return
    if command == "describe-unit":
        describe_unit(rest)
        return
    if command == "fmt":
        match format_options(rest):
            Err(reason) => argument_error("fmt", reason)
            Ok(options) => finish("fmt", format_paths(options))
        return
    if command == "--internal-owner":
        finish("owner", serve_owner(rest))
        return
    if command == "owner":
        owner(rest)
        return
    if command == "inspect" and len(rest) > 0 and rest[0] == "features":
        match parse_features(rest[1:]):
            Err(reason) => argument_error("inspect", reason)
            Ok(selected) => finish("inspect", inspect_features(selected))
        return
    if command == "inspect" and len(rest) > 0 and rest[0] == "dependencies":
        match parse_options(rest[1:]):
            Err(reason) => syntax_error("inspect", reason)
            Ok(options) => finish("inspect", inspected_dependencies(validated("inspect", options)))
        return
    if command == "inspect" and len(rest) > 0 and rest[0] == "interop-plan":
        match plan_options(rest[1:]):
            Err(reason) => syntax_error("inspect", reason)
            Ok(options) => finish("inspect", inspect_interop_plan(options))
        return
    if command == "inspect" and invoked() == OVEN:
        if len(rest) > 0 and rest[0] != "run":
            syntax_error("inspect", f"unknown command `{rest[0]}`")
        syntax_error(
            "inspect",
            "inspects `dependencies PATH`, `interop-plan [--target TRIPLE] [PATH]`, or `run ID --proofs` with INCAN_ENGINE=records",
        )
    if command == "inspect" and len(rest) > 0 and rest[0] == "bindings":
        match binding_options(rest[1:]):
            Err(reason) => argument_error("inspect", reason)
            Ok(options) => finish("inspect", inspect_bindings(options))
        return
    if command == "inspect":
        match graph_options(rest):
            Err(reason) => argument_error("inspect", reason)
            Ok(options) => finish("inspect", inspect_codegraph(options))
        return
    if command == "mcp":
        match mcp_options(rest):
            Err(reason) => argument_error("mcp", reason)
            Ok(options) => finish("mcp", serve_graph(options))
        return
    if command == "toolchain":
        match archive_options(rest):
            Err(reason) => argument_error("toolchain", reason)
            Ok(options) => finish("toolchain", toolchain_command(options))
        return
    if command == "bakery":
        if len(rest) > 0 and rest[0] == "status":
            match parse_status(rest[1:]):
                Err(reason) => argument_error("bakery", reason)
                Ok(format) => finish("bakery", status_command(format), format)
            return
        if len(rest) > 0 and rest[0] == "repair-payload":
            finish("bakery", repair_payload_command(rest))
            return
        match parse_bakery(rest):
            Err(reason) => argument_error("bakery", reason)
            Ok(keep_days) => finish("bakery", bakery_command(keep_days))
        return
    if command.startswith("-"):
        fail(f"{invoked()}: unknown option `{command}`", 2)
    fail(f"{invoked()}: unknown command `{command}`", 2)


def require_no_arguments(command: str, arguments: list[str]) -> None:
    """Refuse extra version or overview arguments instead of silently discarding them."""
    match unknown_option(arguments):
        Some(reason) => syntax_error(command, reason)
        None => pass
    if len(arguments) > 0:
        syntax_error(command, f"unexpected argument `{arguments[0]}`")


def scheduled_unit_command(arguments: list[str]) -> None:
    """Run one parent-admitted Rust facet without exposing the scheduler protocol as a public command."""
    if len(arguments) < 4:
        fail("oven internal Rust unit request is incomplete", 2)
    facet = arguments[0]
    inputs = Path(arguments[1])
    output = Path(arguments[2])
    match parse_options(arguments[3:]):
        Err(reason) => fail(f"oven internal Rust unit request: {reason}", 2)
        Ok(options) => finish(
            "internal Rust unit",
            rust_request(options).and_then((request) => scheduled_unit(request, facet, inputs, output)),
        )


def explain(arguments: list[str]) -> None:
    """Resolve one diagnostic through the installed compiler's catalog, independently of a project or engine."""
    match parse_explain(arguments):
        Err(reason) => syntax_error("explain", reason)
        Ok(selected) =>
            code, format = selected
            match load_toolchain():
                Err(reason) => fail(f"incan explain: {reason}", 1)
                Ok(toolchain) =>
                    if format == "json":
                        finish("explain", explained_json(toolchain, code))
                    finish("explain", run_compiler(toolchain, ["--explain", code]))


def project_command(command: str, arguments: list[str]) -> None:
    """Create a project (`new`, `init`) or change its version (`version BUMP`); usage errors exit with status two."""
    mut outcome: Result[str, str] = Err("")
    if command == "version":
        match parse_version_request(arguments):
            Err(reason) => syntax_error(command, reason)
            Ok(request) => outcome = change_version(request)
    else:
        mut selected = ScaffoldCommand.New
        if command == "init":
            selected = ScaffoldCommand.Init
        match parse_scaffold(selected, arguments):
            Err(reason) => syntax_error(command, reason)
            Ok(request) => outcome = scaffold(request)
    match outcome:
        Err(reason) => fail(f"{invoked()} {command}: {reason}", 1)
        Ok(text) => println(text)


def workspace_command(arguments: list[str]) -> None:
    """`oven workspace inspect`: the workspace root, its manifest, the selected members and the lock."""
    if len(arguments) == 0:
        syntax_error("workspace", "expected `inspect`")
    if arguments[0] != "inspect":
        syntax_error("workspace", f"unknown command `{arguments[0]}`")
    match inspect_workspace(arguments[1:]):
        Err(reason) => argument_error("workspace", reason)
        Ok(text) => println(text)


def lock(arguments: list[str]) -> None:
    """Resolve and report the root project's generated lock."""
    match parse_lock_command(arguments):
        Err(reason) => syntax_error("lock", reason)
        Ok(command) =>
            match lock_project(command):
                Err(reason) => fail(f"oven lock: {reason}", 1)
                Ok(result) => println(f"locked {result.name} {result.version} ({result.mode})")


def syntax_error(command: str, reason: str) -> None:
    """Report a command parser's refusal using the CLI syntax status and common help pointer."""
    fail(f"{invoked()} {command}: {reason}", 2)


def argument_error(command: str, reason: str) -> None:
    """Give unknown commands/options status two while preserving existing operand-value refusal statuses."""
    if reason.startswith("unknown command `") or reason.startswith("unknown option `"):
        syntax_error(command, reason)
    fail(f"{invoked()} {command}: {reason}", 1)


def fail(message: str, code: i32) -> None:
    """Print `message` to stderr and exit with `code`."""
    mut err = stderr()
    # A closed standard error cannot be told about, so a failed write is ignored.
    mut text = f"{message}\n"
    if code == 2:
        text += f"{help_hint(invoked())}\n"
    _ = err.write_all(RustString.from(text).into_bytes())
    finish_trace()
    exit(code)


def parse_options(arguments: list[str], default_path: str = "", outputs: bool = false) -> Result[Options, str]:
    """The unit options: one PATH, or `default_path` when the command has one, and the profile and feature flags."""
    mut options = Options()
    mut index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in UNIT_VALUE_OPTIONS:
            if index + 1 >= len(arguments):
                return Err(f"`{argument}` needs a value")
            apply_option(options, argument, arguments[index + 1])?
            if argument == "--features":
                options.feature_options = true
            index += 2
            continue
        if argument == "--engine-report":
            options.engine_report = true
        elif argument == "--locked":
            options.locked = true
        elif argument == "--release":
            return Err("unknown option `--release`: select the release profile with `--profile release`")
        elif argument == "--direct":
            options.direct = true
        elif argument == "--unattended":
            options.unattended = true
        elif argument == "--codegraph":
            options.codegraph = true
        elif argument == "--no-default-features":
            options.feature_options = true
            options.request.default_features = false
        elif argument == "--all-features":
            options.feature_options = true
            options.request.all_features = true
        elif argument.startswith("-"):
            return Err(f"unknown option `{argument}`")
        elif options.path != "" and outputs and options.output == "":
            options.output = argument
        elif options.path != "":
            return Err(f"one PATH is described at a time; `{argument}` is a second")
        else:
            options.path = argument
        index += 1
    if options.path == "":
        options.path = default_path
    if options.path == "":
        return Err("a PATH is required")
    return Ok(options)


def records_command(command: str, arguments: list[str]) -> None:
    """Dispatch only connected records capabilities; unsupported commands never enter the legacy path."""
    if command == "inspect" and len(arguments) == 3 and arguments[0] == "run" and arguments[2] == "--proofs":
        match bakery().and_then((store) => proof_report(store, arguments[1])):
            Ok(text) => println(text)
            Err(reason) => fail(f"oven inspect: {reason}", 1)
        return
    if command not in ["run", "build"]:
        fail(f"{invoked()} {command}: records engine does not implement `{command}`", 1)
    own, passed = program_arguments(arguments)
    match parse_options(own, "."):
        Err(reason) => syntax_error(command, reason)
        Ok(parsed) =>
            options = located(command, parsed)
            if options.feature_options or len(options.substitutes) > 0 or len(options.program_entries) > 0:
                fail(
                    f"{invoked()} {command}: unit records do not implement feature, substitution or program-entry options",
                    1,
                )
            if command == "build" and (len(passed) > 0 or options.argv0 is not None):
                syntax_error(command, "program arguments and --argv0 require run")
            mut source = Path(options.path)
            match build_source(source, options.manifests):
                Err(reason) => fail(f"{invoked()} {command}: {reason}", 1)
                Ok(None) => fail(f"{invoked()} {command}: records engine requires an Incan program", 1)
                Ok(Some(selected)) => source = selected
            prepared_lock(command, options)
            finish(
                command,
                execute_records(command, source, options.profile, passed, options.argv0, options.engine_report),
            )


def apply_option(mut options: Options, name: str, value: str) -> Result[None, str]:
    """Apply one option that takes a value: the profile, features, a substitute, a program entry or `--argv0`."""
    if name == "--argv0":
        options.argv0 = Some(value)
    elif name == "--program-entry":
        options.program_entries.append(value)
    elif name == "--substitute":
        parts = value.split("=")
        if len(parts) != 2 or parts[0] == "" or parts[1] == "":
            return Err(f"`--substitute` takes NAME=DIR, got `{value}`")
        options.substitutes[parts[0]] = parts[1]
    elif name == "--profile":
        options.profile = value
    else:
        for feature in value.split(","):
            if feature.strip() != "":
                options.request.features.append(feature.strip())
    return Ok(None)


def run(arguments: list[str]) -> None:
    """
    Compile the program whose entry source is PATH and run it with the arguments after `--`. Without PATH, or with a
    directory, the program is the enclosing Loaf's; `-c CODE` runs CODE as a direct source module.
    """
    own, passed = program_arguments(arguments)
    mut unit_arguments = own
    match inline_arguments(own, invoked()):
        Err(reason) => syntax_error("run", reason)
        Ok(replaced) => unit_arguments = replaced
    match parse_options(unit_arguments, "."):
        Err(reason) => syntax_error("run", reason)
        Ok(options) =>
            mut selected = validated("run", located("run", options))
            match build_source(Path(selected.path), selected.manifests):
                Err(reason) => fail(f"{invoked()} run: {reason}", 1)
                Ok(Some(source)) => selected.path = source.0
                Ok(None) => pass
            prepared_lock("run", selected)
            finish("run", ran(selected, passed))


def program_arguments(arguments: list[str]) -> tuple[list[str], list[str]]:
    """Separate command options from the program's arguments without forwarding internal selectors."""
    mut own: list[str] = []
    mut passed: list[str] = []
    mut after = false
    for argument in arguments:
        if after:
            passed.append(argument)
        elif argument == "--":
            after = true
        else:
            own.append(argument)
    return (own, passed)


def located(command: str, options: Options) -> Options:
    """A directory PATH, or no PATH, names the Loaf at or above that directory; a file PATH or direct source is kept."""
    if options.direct or not Path(options.path).is_dir():
        return options
    match enclosing_loaf(Path(options.path)):
        Err(reason) => fail(f"{invoked()} {command}: {reason}", 1)
        Ok(root) =>
            mut selected = options
            selected.path = root.0
            return selected
    return options


def enclosing_loaf(directory: Path) -> Result[Path, str]:
    """The nearest directory at or above `directory` that holds a `loaf.toml`."""
    mut current = directory.absolute().map_err((error) => f"cannot resolve {directory.0}: {error.message()}")?
    while true:
        if current.joinpath("loaf.toml").is_file():
            return Ok(current)
        match retired_refusal(current):
            Some(reason) => return Err(reason)
            None => pass
        parent = current.parent()
        if parent.0 == current.0 or parent.0 == "":
            break
        current = parent
    return Err(f"{directory.0}: no loaf.toml in this directory or above it; name a source file")


def prepared_lock(command: str, options: Options) -> None:
    """Reconcile a project command's root lock; explicit direct source execution has no project lock to prepare."""
    if options.direct:
        return
    match ensure_project_lock(
        Path(options.path),
        options.profile,
        options.request,
        options.substitutes,
        options.manifests,
        options.locked,
    ):
        Err(reason) => fail(f"{invoked()} {command}: {reason}", 1)
        Ok(_) => return


def ran(options: Options, passed: list[str]) -> Result[i32, str]:
    """
    Make the unit's executable, through its owner or in this process, and become it; direct source execution always
    stays in process and a refused compile is the run's result.

    1. The project's owner makes the executable when it serves a project unit.
    2. Otherwise describe the unit, compile it here and keep the stored executable while its inputs are unchanged.
    3. Become the program.
    """
    # 1. When the project's owner serves the unit, it made the executable, and a refused compile is the run's result.
    if not options.direct:
        requesting = begin_work()
        owned = via_owner("run", options, Path(options.path))
        record_work(Operation.LegacyRequest, options.path, requesting)
        match owned:
            Some(reply) =>
                if reply.exit != 0:
                    return Ok(status_code(reply.exit))
                return run_program(Path(reply.binary), passed, options.argv0)
            None => pass
    # 2. Otherwise this process describes and compiles the unit, keeping the stored executable while its inputs hold.
    preparing = begin_work()
    mut unit = describe(
        Path(options.path),
        options.profile,
        options.request,
        options.manifests,
        None,
        [],
        options.direct,
    )?
    unit.program_entries = options.program_entries
    toolchain = toolchain_for(unit)?
    binary = program_binary(unit)
    made = make_unit(unit, toolchain, binary, true)?
    record_work(Operation.LegacyPrepare, options.path, preparing)
    if made.code != 0:
        return Ok(made.code)
    # 3. The process becomes the program, so its exit status is the run's; it keeps the view's name as its own.
    mut argv0 = binary.0
    if let Some(selected) = options.argv0:
        argv0 = selected
    return run_program(made.launch, passed, Some(argv0))


def via_owner(command: str, options: Options, entry: Path) -> Option[Reply]:
    """The reply of the project's resident owner, which has made the executable; `None` when this process should."""
    if len(options.substitutes) > 0 or len(options.program_entries) > 0:
        return None
    request = options.request
    return owned(command, entry, options.profile, request.features, request.default_features, request.all_features)


def test(arguments: list[str]) -> None:
    """
    Compile the collected test units of a file, a directory or, with no PATH, the current one, then select, run and
    report their tests under the invocation's runner options.
    """
    match split_runner_options(arguments):
        Err(reason) => syntax_error("test", reason)
        Ok(split) =>
            runner, unit_arguments = split
            match parse_options(unit_arguments, "."):
                Err(reason) => syntax_error("test", reason)
                Ok(options) =>
                    mut selected = validated("test", options)
                    if Path(selected.path).is_dir():
                        # A directory's project is found from the directory itself, so it is named absolutely.
                        match Path(selected.path).absolute():
                            Ok(absolute) => selected.path = absolute.0
                            Err(error) => fail(f"{invoked()} test: cannot resolve {error.message()}", 1)
                    prepared_lock("test", selected)
                    finish("test", tested(selected, runner))


model Collected:
    """The tests one invocation compiled, and the first failed compilation's status, or zero."""

    cases: list[TestCase] = []
    compiled: i32 = 0


def tested(options: Options, runner: RunnerOptions) -> Result[i32, str]:
    """Collect a Loaf's, a directory's or one module's tests, then run them as one session."""
    path = Path(options.path)
    mut collected = Collected()
    if path.joinpath("loaf.toml").is_file():
        collected = project_cases(options, runner)?
    elif path.is_dir():
        collected = module_cases(options, runner, directory_test_sources(path)?, path)?
    else:
        collected = module_cases(options, runner, [path], path.parent())?
    return run_session(collected.cases, runner, collected.compiled)


def project_cases(options: Options, runner: RunnerOptions) -> Result[Collected, str]:
    """
    Collect a Loaf's Rust harness tests, when it declares a Rust facet, and its Incan test modules' tests. A Loaf with
    neither is refused rather than reported as passing.
    """
    declared = rust_facet(options.path, false)?
    facet = declared.kind != "" or len(declared.binaries) > 0
    sources = test_sources(Path(options.path))?
    if not facet and len(sources) == 0:
        return Err(f"{options.path}: the Loaf has no test_*.incn modules and no Rust facet tests")
    mut collected = Collected()
    if facet:
        for binary in build_rust_tests(rust_request(options)?)?:
            for test_case in rust_cases(Path(binary), Path(options.path))?:
                collected.cases.append(test_case)
    modules = module_cases(options, runner, sources, Path(options.path))?
    for test_case in modules.cases:
        collected.cases.append(test_case)
    collected.compiled = modules.compiled
    return Ok(collected)


def module_cases(options: Options, runner: RunnerOptions, sources: list[Path], root: Path) -> Result[Collected, str]:
    """
    Compile each test module and collect its tests: listings name a module below `root`, and reports below the working
    directory. A failed module keeps its compilation status.
    """
    mut here = root
    match Path.cwd():
        Ok(directory) => here = directory
        Err(_) => pass
    mut collected = Collected()
    for source in sources:
        mut selected = options
        selected.path = source.0
        code, binary = compiled_tests(selected, runner)?
        if code != 0:
            if collected.compiled == 0:
                collected.compiled = code
            continue
        reported = relative_name(source, here)
        for test_case in collected_cases(binary, relative_name(source, root), source.name(), reported)?:
            collected.cases.append(test_case)
    return Ok(collected)


def relative_name(source: Path, root: Path) -> str:
    """A module's path below `root`, as listings and reports name it."""
    mut prefix = root.0
    if not prefix.endswith("/"):
        prefix += "/"
    if source.0.startswith(prefix):
        return source.0[len(prefix):]
    return source.0


def compiled_tests(options: Options, runner: RunnerOptions) -> Result[tuple[i32, Path], str]:
    """
    Make a test unit's executable through its owner or in this process. Testing features change what is collected,
    so a unit with any is compiled here, with each feature active.
    """
    if len(runner.features) == 0:
        match via_owner("test", options, Path(options.path)):
            Some(reply) => return Ok((status_code(reply.exit), Path(reply.binary)))
            None => pass
    mut unit = describe(
        Path(options.path),
        options.profile,
        options.request,
        options.manifests,
        purpose=ActivationPurpose.Test,
    )?
    unit.kind = "test"
    for feature in runner.features:
        if feature not in unit.active_features:
            unit.active_features.append(feature)
    return compile_tests(unit, toolchain_for(unit)?)


def check(arguments: list[str]) -> None:
    """Check the unit whose entry source is PATH; the report is text, or JSON with `--format json`."""
    mut format = "text"
    mut own: list[str] = []
    mut index = 0
    while index < len(arguments):
        if arguments[index] == "--format" and index + 1 < len(arguments):
            format = arguments[index + 1]
            index += 2
            continue
        own.append(arguments[index])
        index += 1
    if format != "text" and format != "json":
        fail(f"{invoked()} check: `--format` is text or json, got `{format}`", 2)
    match parse_options(own, "."):
        Err(reason) => syntax_error("check", reason)
        Ok(options) => finish("check", checked(validated("check", located("check", options)), format), format)


def checked(options: Options, format: str) -> Result[i32, str]:
    """
    Describe an ordinary unit, then let checking prepare its dependencies and exact native inputs once. A directory,
    or no PATH, checks the entry `build` selects for the Loaf at or above it.
    """
    mut source = Path(options.path)
    if source.is_dir():
        match build_source(source, options.manifests)?:
            Some(entry) => source = entry
            None => return Err(f"{source.0}: the Loaf has no Incan entry to check; name a source file")
    unit = describe(source, options.profile, options.request, options.manifests)?
    return check_unit(unit, toolchain_for(unit)?, format)


def inspected_dependencies(options: Options) -> Result[i32, str]:
    """
    Describe the unit a build of PATH compiles, then let the compiler settle and print the dependency closure that
    build links. As for `build`, a `lib.incn` source is a library unit.
    """
    source = Path(options.path)
    mut unit = describe(source, options.profile, options.request, options.manifests)?
    if source.name() == "lib.incn":
        unit.kind = "library"
    return report_dependencies(unit, toolchain_for(unit)?)


def finish(command: str, result: Result[i32, str], format: str = "text") -> None:
    """Exit with a command's exit code, its decision-required storage outcome, or report why it could not run."""
    match result:
        Err(reason) =>
            decide(command, reason, format)
            fail(f"{invoked()} {command}: {reason}", 1)
        Ok(code) =>
            finish_trace()
            exit(code)


def decide(command: str, reason: str, format: str) -> None:
    """
    Exit with status three when a command stopped because storage admission refused a write.

    The outcome is never a prompt: `--format json` prints its versioned document on stdout, and text prints its
    explanation on stderr. A failure that is not that refusal returns to ordinary reporting.
    """
    match take_decision():
        None => return
        Some(decided) =>
            if decided.summary not in reason:
                return
            if format == "json":
                println(decided.document)
            else:
                mut err = stderr()
                # A closed standard error cannot be told about, so a failed write is ignored.
                _ = err.write_all(RustString.from(f"{invoked()} {command}: {decided.text}\n").into_bytes())
            finish_trace()
            exit(3)


def validated(command: str, options: Options) -> Options:
    """Report unsupported option combinations with the command syntax exit status before preparation."""
    match require_command_options(command, options):
        Err(reason) => fail(f"{invoked()} {command}: {reason}", 2)
        Ok(_) => pass
    return options


def require_command_options(command: str, options: Options) -> Result[None, str]:
    """Each command admits only options it applies, and feature selection requires an owning project."""
    if options.codegraph:
        if command != "build":
            return Err("--codegraph requires an Incan library build")
        match build_source(Path(options.path), options.manifests)?:
            None => return Err("--codegraph requires an Incan library build")
            Some(entry) =>
                if entry.name() != "lib.incn":
                    return Err("--codegraph requires an Incan library build")
    if options.direct:
        if invoked() == OVEN or command != "run":
            return Err("--direct requires incan run")
        if options.engine_report:
            return Err("--direct does not produce an Oven engine report")
        if options.locked:
            return Err("--direct does not use an Oven lock")
        if options.feature_options or len(options.program_entries) > 0 or len(options.substitutes) > 0:
            return Err("--direct does not accept project features, substitutions or additional program entries")
        return Ok(None)
    if options.engine_report:
        return Err("--engine-report requires INCAN_ENGINE=records run or build")
    if options.locked and command not in ["run", "build", "test"]:
        return Err("--locked requires run, build or test")
    if options.unattended and command != "describe-unit":
        return Err("--unattended requires oven describe-unit")
    if options.argv0 != None and command != "run":
        return Err("--argv0 requires run")
    if len(options.program_entries) > 0 and command not in ["run", "build"]:
        return Err("--program-entry requires run/build")
    if len(options.substitutes) > 0 and command != "build":
        return Err("--substitute requires a Rust-project build")
    source = Path(options.path)
    mut project = project_root_of(source)
    if source.is_dir() and source.joinpath("loaf.toml").is_file():
        project = Some(source)
    if options.feature_options and project is None:
        return Err("feature selection requires a project")
    if command == "build" and (len(options.substitutes) > 0 or len(options.program_entries) > 0):
        selected = build_source(source, options.manifests)?
        if len(options.substitutes) > 0 and selected != None:
            return Err("--substitute requires a Rust-project build")
        if len(options.program_entries) > 0:
            match selected:
                None => return Err("--program-entry requires an Incan program build")
                Some(entry) =>
                    if entry.name() == "lib.incn":
                        return Err("--program-entry requires an Incan program build")
    return Ok(None)


def describe_unit(arguments: list[str]) -> None:
    """Print the unit description of the unit whose entry source is PATH."""
    match parse_options(arguments):
        Err(reason) => syntax_error("describe-unit", reason)
        Ok(options) => print_description(validated("describe-unit", options))


def print_description(options: Options) -> None:
    """
    Print the description of the unit `options` select.

    1. Options that only a run or build understands are refused (exit 2).
    2. The unit is described against the toolchain (exit 1 when it cannot be).
    3. The description is printed as JSON (exit 1 when it cannot be encoded).
    """
    # 1. Options that only a run or build understands are refused with the usage exit status.
    # 2. A unit that cannot be described against the toolchain ends the command with status 1.
    match describe_native(Path(options.path), options.profile, options.request, options.unattended):
        Err(reason) => fail(f"oven describe-unit: {reason}", 1)
        Ok(unit) =>
            if unit.trust_stop != "":
                mut err = stderr()
                _ = err.write_all(RustString.from(unit.trust_stop + "\n").into_bytes())
            # 3. The description is printed as JSON, or ends the command with status 1 when it cannot be encoded.
            match unit.to_json().to_pretty_json():
                Err(error) => fail(f"oven describe-unit: {error.message()}", 1)
                Ok(text) => println(text)


def build(arguments: list[str]) -> None:
    """
    Compile an Incan source unit or a Rust project against the installed toolchain's registry units. Without PATH, or
    with a directory, the unit is the enclosing Loaf's.
    """
    match parse_options(arguments, ".", true):
        Err(reason) => syntax_error("build", reason)
        Ok(options) =>
            selected = validated("build", located("build", options))
            prepared_lock("build", selected)
            build_selected(selected)


def build_selected(options: Options) -> None:
    """Build an Incan source if the path names one, else the Rust project it names, printing its binaries."""
    match build_source(Path(options.path), options.manifests):
        Err(reason) => fail(f"{invoked()} build: {reason}", 1)
        Ok(Some(source)) =>
            finish("build", built(options, source))
            return
        Ok(None) => pass
    if options.output != "":
        fail(f"{invoked()} build: OUTPUT_DIR requires an Incan program build", 1)
    match build_project(options):
        Err(reason) => fail(f"{invoked()} build: {reason}", 1)
        Ok(binaries) =>
            for binary in binaries:
                println(f"binary: {binary}")


def build_project(options: Options) -> Result[list[str], str]:
    """Compile a Rust project against the registry units of its installed toolchain."""
    return build_rust(rust_request(options)?)


def rust_request(options: Options) -> Result[RustBuild, str]:
    """Select one installed toolchain and its registry for either a Rust production build or its tests."""
    toolchain = load_toolchain()?
    registry = read_registry_units(Path(toolchain.registry_units), options.path, options.manifests)?
    request = RustBuild(
        project=options.path,
        profile=options.profile,
        rustc=rust_compiler(toolchain),
        registry=registry,
        features=options.request.features,
        default_features=options.request.default_features,
        all_features=options.request.all_features,
        substitutes=options.substitutes,
        rust_facet_dependencies=true,
        schedule_rust_units=true,
        incan_compiler=Some(compile_incan_library),
        toolchain_search=toolchain.search,
        toolchain=Some(toolchain),
        manifests=options.manifests,
    )
    return Ok(request)


def build_source(path: Path, reader: ManifestReader) -> Result[Option[Path], str]:
    """Select an explicit source or a directory's conventional Incan entry; other directories name Rust projects."""
    if path.is_file():
        return Ok(Some(path))
    if not path.joinpath("loaf.toml").is_file():
        return Ok(None)
    project = read_project(path, reader).map_err((error) => error.message())?
    root = Path(source_root_of(project))
    for name in ["lib.incn", "main.incn"]:
        source = root.joinpath(name)
        if source.is_file():
            return Ok(Some(source))
    return Ok(None)


def built(options: Options, source: Path) -> Result[i32, str]:
    """
    Build a source file or a project's conventional library or main program, preparing its path dependencies.

    1. A library takes no program entries, and no build takes `--argv0`.
    2. A program is built by the project's owner when it serves the unit.
    3. Otherwise describe the unit and build it here: a library into its artifact directory, a program into `bin`.
    """
    # 1. A library takes no program entries, and no build takes `--argv0`.
    library = source.name() == "lib.incn"
    if options.argv0 != None or (library and len(options.program_entries) > 0):
        return Err("--argv0 requires run; program entries require a program unit")
    # 2. A program the project's owner serves is built there, and this process only reports the owner's status.
    if not library:
        match via_owner("build", options, source):
            Some(reply) => return delivered(options, status_code(reply.exit), Path(reply.binary))
            None => pass
    # 3. Anything else is described and built here: a library into its artifact directory, a program into `bin`.
    mut unit = describe(source, options.profile, options.request, options.manifests)?
    unit.program_entries = options.program_entries
    mut output = program_binary(unit)
    if library:
        if options.output != "":
            return Err("OUTPUT_DIR requires an Incan program build")
        unit.kind = "library"
        directory = dependency_artifact_dir(unit.project_root, unit.package, unit.profile)
        output = directory.joinpath(f"lib{crate_name(unit)}.rlib")
        toolchain = toolchain_for(unit)?
        ready = prepare_native(unit, toolchain)?
        status = compile_library_unit(ready, toolchain, output)?
        if status != 0 or not options.codegraph:
            return Ok(status)
        graph = inspect_prepared(ready, toolchain)?
        if not publish_prepared_graph(ready, toolchain, directory, graph)?:
            return Err(f"{ready.package}: native publication changed while exporting its graph; retry the build")
        return Ok(0)
    return delivered(options, compile_unit(unit, toolchain_for(unit)?, output)?, output)


def delivered(options: Options, code: i32, binary: Path) -> Result[i32, str]:
    """After a successful program build, place a fresh copy of the executable in OUTPUT_DIR, as 0.5.1's build did."""
    if code != 0 or options.output == "":
        return Ok(code)
    directory = Path(options.output)
    directory.mkdir(true, true).map_err((error) => f"cannot create {directory.0}: {error.message()}")?
    destination = directory.joinpath(binary.name())
    # A new file rather than one rewritten in place, so a program that ran from it is never replaced under itself.
    if destination.exists():
        destination.unlink().map_err((error) => f"cannot replace {destination.0}: {error.message()}")?
    _ = binary.copy(destination, true, true).map_err((error) => f"cannot copy {binary.0}: {error.message()}")?
    return Ok(0)


def owner(arguments: list[str]) -> None:
    """`oven owner stop`: stop the resident owners of this home."""
    match unknown_option(arguments):
        Some(reason) => syntax_error("owner", reason)
        None => pass
    if len(arguments) > 0 and arguments[0] != "stop":
        syntax_error("owner", f"unknown command `{arguments[0]}`")
    if arguments != ["stop"]:
        syntax_error("owner", "expected `stop`")
    match stop_owners():
        Err(reason) => fail(f"oven owner: {reason}", 1)
        Ok(stopped) => println(f"stopped {stopped} owners")


def expected_artifacts(arguments: list[str]) -> list[str]:
    """
    The artifacts a build of an Incan source writes, for its report: a library's `.rlib` or a program's executable.
    A build that cannot be described here reports none; the build itself reports why it failed.
    """
    own, _passed = program_arguments(arguments)
    match parse_options(own):
        Err(_) => return []
        Ok(options) =>
            match build_source(Path(options.path), options.manifests):
                Ok(Some(source)) =>
                    match describe(source, options.profile, options.request, options.manifests):
                        Err(_) => return []
                        Ok(unit) =>
                            if source.name() == "lib.incn":
                                directory = dependency_artifact_dir(unit.project_root, unit.package, unit.profile)
                                return [directory.joinpath(f"lib{crate_name(unit)}.rlib").0]
                            return [program_binary(unit).0]
                Ok(None) => return []
                Err(_) => return []
