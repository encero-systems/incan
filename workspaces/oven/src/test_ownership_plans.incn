"""The copies a native plan holds for values the source never asked to copy, counted from the driver's plan report."""

from rust::std::process import Command
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from files import read, write
from scratch import scratch_directory
from engine_client import service_generation, service_identity
from engine_endpoint import connect_with
from engine_messages import Message, Stop
from engine_wire import zero_id

const FIELD_OUT: str = """pub enum Value:
    Empty
    Many(str, list[Value])


pub model Decoded:
    pub value: Value
    pub index: list[int]


def decode(size: int) -> Decoded:
    mut items: list[Value] = []
    for _ in range(size):
        items.append(Value.Empty)
    return Decoded(value=Value.Many("label", items), index=[1, 2, 3])


def field_out(size: int) -> Value:
    decoded = decode(size)
    return decoded.value


def field_out_result(size: int) -> Result[Value, str]:
    decoded = decode(size)
    return Ok(decoded.value)


def keep(value: Value) -> Value:
    return value


def branch_exclusive(flag: bool, size: int) -> Value:
    decoded = decode(size)
    value = decoded.value
    if flag:
        return keep(value)
    else:
        return keep(value)


def arity(value: Value) -> int:
    match value:
        Value.Many(_, items) => return len(items)
        _ => return 0


def main() -> None:
    println(arity(field_out(17)))
    match field_out_result(17):
        Ok(value) => println(arity(value))
        Err(message) => println(message)
    println(arity(branch_exclusive(true, 5)) + arity(branch_exclusive(false, 6)))
"""


pub def test_a_field_leaves_its_owner_at_the_owners_last_read() -> Result[None, str]:
    """The last read of a local model takes a field out of it, so the plan clones nothing (#1604)."""
    report = plan_report("fields", FIELD_OUT, "17\n17\n11")?
    for function in ["field_out", "field_out_result", "branch_exclusive"]:
        copies = clones(report, function)?
        assert copies == 0, f"{function} holds {copies} clone calls"
    return Ok(None)


def plan_report(name: str, source_text: str, expected: str) -> Result[str, str]:
    """Run one program through the records engine in a store of its own and return the driver's plan report."""
    scratch = scratch_directory()?
    root = scratch.path()
    source = root.joinpath(f"{name}.incn")
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    write(source, source_text)?
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release"])
        .env("INCAN_NATIVE_PLAN_REPORT", root.joinpath("native.plan").0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    stop_engine(binary, store)?
    if not outcome.status.success() or output != expected + "\n":
        return Err(f"{name}: status={outcome.status.code()} stdout={output} stderr={errors}")
    return read(root.joinpath("native.plan"))


def clones(report: str, function: str) -> Result[int, str]:
    """The model and enum clone calls the plan of `function` holds, summed over every frame of that name."""
    mut total = 0
    mut found = false
    for line in report.split("\n"):
        fields = line.split("\t")
        if len(fields) < 2 or fields[0] != "plan-function" or fields[len(fields) - 1] != function:
            continue
        found = true
        for position in range(len(fields) - 1):
            if fields[position] == "model-clones" or fields[position] == "enum-clones":
                total += int(fields[position + 1])
    if not found:
        return Err(f"the plan report names no function {function}")
    return Ok(total)


def stop_engine(binary: str, store: Path) -> Result[None, str]:
    """Stop the disposable records engine of one test's store."""
    mut identity = service_identity(store)?
    identity.service_generation = service_generation(binary)?
    mut channel = connect_with(store, identity, binary).map_err((refusal) => refusal.detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="ownership plan read"))).map_err((refusal) => refusal.detail)?
    _ = channel.receive().map_err((refusal) => refusal.detail)?
    _ = channel.transport.close()
    return Ok(None)
