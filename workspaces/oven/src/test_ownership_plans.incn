"""The copies a native plan holds for values the source never asked to copy, counted from the driver's plan report."""

from rust::std::process import Command
from rust::std::str import from_utf8
from std.environ import get_or
from std.fs import Path
from files import read, write
from scratch import scratch_directory
from engine_client import service_generation, service_identity
from engine_endpoint import connect_with
from engine_messages import Message, Stop
from engine_wire import zero_id

const FIELD_OUT: str = """pub enum Value:
    Empty
    Many(str, list[Value])


pub model Decoded:
    pub value: Value
    pub index: list[int]


def decode(size: int) -> Decoded:
    mut items: list[Value] = []
    for _ in range(size):
        items.append(Value.Empty)
    return Decoded(value=Value.Many("label", items), index=[1, 2, 3])


def field_out(size: int) -> Value:
    decoded = decode(size)
    return decoded.value


def field_out_result(size: int) -> Result[Value, str]:
    decoded = decode(size)
    return Ok(decoded.value)


def keep(value: Value) -> Value:
    return value


def branch_exclusive(flag: bool, size: int) -> Value:
    decoded = decode(size)
    value = decoded.value
    if flag:
        return keep(value)
    else:
        return keep(value)


def arity(value: Value) -> int:
    match value:
        Value.Many(_, items) => return len(items)
        _ => return 0


def main() -> None:
    println(arity(field_out(17)))
    match field_out_result(17):
        Ok(value) => println(arity(value))
        Err(message) => println(message)
    println(arity(branch_exclusive(true, 5)) + arity(branch_exclusive(false, 6)))
"""


const COPY_MODEL: str = """@derive(Copy, Clone)
pub model Point:
    pub x: int
    pub y: int


def point_sum(point: Point) -> int:
    return point.x + point.y


def copy_twice(point: Point) -> int:
    first = point_sum(point)
    pair = (point, point)
    return first + point_sum(pair.0) + point_sum(point)


def main() -> None:
    println(copy_twice(Point(x=3, y=4)))
"""


pub def test_a_model_that_derives_copy_is_copied_and_never_cloned() -> Result[None, str]:
    """Reading a `@derive(Copy)` model into a call, a tuple and a second call copies it and calls no clone (#1603)."""
    report = plan_report("copies", COPY_MODEL, "21")?
    copies = clones(report, "copy_twice")?
    assert copies == 0, f"copy_twice holds {copies} clone calls"
    return Ok(None)


pub def test_a_field_leaves_its_owner_at_the_owners_last_read() -> Result[None, str]:
    """The last read of a local model takes a field out of it, so the plan clones nothing (#1604)."""
    report = plan_report("fields", FIELD_OUT, "17\n17\n11")?
    for function in ["field_out", "field_out_result", "branch_exclusive"]:
        copies = clones(report, function)?
        assert copies == 0, f"{function} holds {copies} clone calls"
    return Ok(None)


const INDEXED_LIST: str = """pub model Variant:
    pub identity: bytes
    pub labels: list[str]


pub model Stored:
    pub variants: list[Variant]


def count_labels(labels: &list[str]) -> int:
    return len(labels)


def via_index(stored: &Stored, at: int) -> int:
    return count_labels(stored.variants[at].labels)


def main() -> None:
    stored = Stored(variants=[Variant(identity=b"ab", labels=["x", "y"])])
    println(via_index(stored, 0))
"""


pub def test_a_list_inside_an_indexed_element_is_lent_without_a_copy() -> Result[None, str]:
    """A list field of a list element passed to a shared list parameter is lent through the element (#1605)."""
    report = plan_report("indexed", INDEXED_LIST, "2")?
    dropped = plan_counts(report, "via_index", ["drops"])?
    assert dropped == 0, f"via_index drops {dropped} copies"
    return Ok(None)


const READ_ONLY_MATCH: str = """pub enum Value:
    NoneValue
    Text(str)
    List(list[Value])


pub model ValueField:
    pub value: Value
    pub empty_omits: bool


def omitted(field: &ValueField) -> bool:
    match field.value:
        Value.NoneValue => return true
        Value.List(items) => return field.empty_omits and len(items) == 0
        _ => return false


def count(items: list[Value]) -> int:
    return len(items)


def emit_inner(value: Value) -> int:
    match value:
        Value.NoneValue => return 0
        Value.Text(text) => return len(text)
        Value.List(items) => return count(items)


def main() -> None:
    field = ValueField(value=Value.List([Value.Text("ab"), Value.NoneValue]), empty_omits=true)
    if omitted(field):
        println(0)
    else:
        println(1)
    println(emit_inner(field.value))
"""


pub def test_a_match_whose_arms_only_read_binds_its_payloads_by_reference() -> Result[None, str]:
    """A payload an arm only measures or passes to a shared parameter is bound by reference, never copied (#1607)."""
    report = plan_report("matched", READ_ONLY_MATCH, "1\n2")?
    for function in ["omitted", "emit_inner"]:
        dropped = plan_counts(report, function, ["drops"])?
        assert dropped == 0, f"{function} drops {dropped} copies"
    return Ok(None)


const BORROWED_LOOP: str = """pub model Field:
    pub identity: bytes
    pub labels: list[str]


def total_identity(fields: list[Field]) -> int:
    mut total = 0
    for field in fields:
        total += len(field.identity)
    return total


def main() -> None:
    fields = [Field(identity=b"ab", labels=["x"]), Field(identity=b"cde", labels=[])]
    println(total_identity(fields))
"""


pub def test_a_loop_that_only_reads_its_item_borrows_each_element() -> Result[None, str]:
    """A `for` loop over a lent list whose body only reads its item borrows each element, never copying it (#1605)."""
    report = plan_report("looped", BORROWED_LOOP, "5")?
    dropped = plan_counts(report, "total_identity", ["drops"])?
    assert dropped == 0, f"total_identity drops {dropped} copies"
    return Ok(None)


def plan_report(name: str, source_text: str, expected: str) -> Result[str, str]:
    """Run one program through the records engine in a store of its own and return the driver's plan report."""
    scratch = scratch_directory()?
    root = scratch.path()
    source = root.joinpath(f"{name}.incn")
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    store = root.joinpath("store")
    write(source, source_text)?
    outcome = Command
        .new(binary)
        .arg("run")
        .arg(source.0)
        .args(["--profile", "release"])
        .env("INCAN_NATIVE_PLAN_REPORT", root.joinpath("native.plan").0)
        .env("INCAN_ENGINE", "records")
        .env("INCAN_BAKERY", store.0)
        .output()
        .map_err((error) => str(error))?
    output = from_utf8(outcome.stdout).map_err((error) => str(error))?
    errors = from_utf8(outcome.stderr).map_err((error) => str(error))?
    stop_engine(binary, store)?
    if not outcome.status.success() or output != expected + "\n":
        return Err(f"{name}: status={outcome.status.code()} stdout={output} stderr={errors}")
    return read(root.joinpath("native.plan"))


def clones(report: str, function: str) -> Result[int, str]:
    """The model and enum clone calls the plan of `function` holds, summed over every frame of that name."""
    return plan_counts(report, function, ["model-clones", "enum-clones"])


def plan_counts(report: str, function: str, columns: list[str]) -> Result[int, str]:
    """The named counts of the plan report's rows for `function`, summed over every frame of that name."""
    mut total = 0
    mut found = false
    for line in report.split("\n"):
        fields = line.split("\t")
        if len(fields) < 2 or fields[0] != "plan-function" or fields[len(fields) - 1] != function:
            continue
        found = true
        for position in range(len(fields) - 1):
            if fields[position] in columns:
                total += int(fields[position + 1])
    if not found:
        return Err(f"the plan report names no function {function}")
    return Ok(total)


def stop_engine(binary: str, store: Path) -> Result[None, str]:
    """Stop the disposable records engine of one test's store."""
    mut identity = service_identity(store)?
    identity.service_generation = service_generation(binary)?
    mut channel = connect_with(store, identity, binary).map_err((refusal) => refusal.detail)?
    channel.send(zero_id(), Message.Stop(Stop(reason="ownership plan read"))).map_err((refusal) => refusal.detail)?
    _ = channel.receive().map_err((refusal) => refusal.detail)?
    _ = channel.transport.close()
    return Ok(None)
