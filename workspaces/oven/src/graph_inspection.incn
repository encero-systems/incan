"""The inspection CLI selects units and presents the compiler's single graph representation."""

from rust::std::process import id
from std.fs import Path
from std.json import JsonValue, parse
from features import FeatureRequest
from graph_cache import cache_file, compiler_digest, fingerprint, publish, tree_inputs
from graph_queries import query, text
from graph_rust import inspect_rust
from graph_index import query_paths
from incan_units import crate_name, prepare_dependencies, run_compiler, write_unit
from toolchain import Toolchain, load_toolchain
from unit import dependency_units, describe
from unit_rust import prepare_native
from unit_freshness import file_digest


pub model GraphOptions:
    """A source or project and its graph presentation, independent of compiler semantics."""

    pub path: str = ""
    pub format: str = "jsonl"
    pub query: str = ""
    pub term: str = ""
    pub substitutes: Dict[str, str] = {}


def options(arguments: list[str]) -> Result[GraphOptions, str]:
    """Validate the full invocation before any build or cache operation."""
    if len(arguments) == 0 or arguments[0] != "codegraph":
        return Err("usage: incan inspect codegraph PATH [--format json|jsonl] [--query defs|refs|callers|callees|imports TERM]")
    mut result = GraphOptions()
    mut index = 1
    while index < len(arguments):
        value = arguments[index]
        if value in ["--format", "--query", "--substitute"]:
            if index + 1 >= len(arguments):
                return Err(f"{value} needs a value")
            item = arguments[index + 1]
            if value == "--format":
                result.format = item
            elif value == "--substitute":
                parts = item.split("=")
                if len(parts) != 2 or parts[0] == "" or parts[1] == "":
                    return Err("--substitute takes NAME=DIR")
                result.substitutes[parts[0]] = parts[1]
            else:
                result.query = item
                if index + 2 >= len(arguments):
                    return Err("--query needs a query kind and TERM")
                result.term = arguments[index + 2]
                index += 1
            index += 2
            continue
        if value.startswith("-") or result.path != "":
            return Err(f"unexpected argument `{value}`")
        result.path = value
        index += 1
    if result.path == "":
        return Err("a PATH is required")
    if result.format not in ["json", "jsonl"]:
        return Err("--format is json or jsonl")
    if result.query != "" and result.query not in ["defs", "refs", "callers", "callees", "imports"]:
        return Err(f"unknown graph query `{result.query}`")
    return Ok(result)


pub def inspect_codegraph(arguments: list[str]) -> Result[i32, str]:
    """Export JSON/JSONL or answer a compact query, reusing content-addressed unit exports."""
    selected = options(arguments)?
    path = Path(selected.path).resolve().map_err((error) => error.message())?
    toolchain = load_toolchain()?
    mut paths: list[Path] = []
    mut source = path
    if path.is_dir() and not path.joinpath("src").joinpath("lib.rs").is_file():
        for name in ["lib.incn", "main.incn"]:
            candidate = path.joinpath("src").joinpath(name)
            if candidate.is_file():
                source = candidate
                break
    if source.is_file() and source.name().endswith(".incn"):
        paths.append(inspect_incan(source, toolchain)?)
    else:
        mut root = path
        if root.is_file():
            root = root.parent()
            while not root.joinpath("loaf.toml").is_file():
                parent = root.parent()
                if parent.0 == root.0:
                    return Err(f"{selected.path}: no owning loaf.toml")
                root = parent
        paths = inspect_rust(root, "debug", FeatureRequest(), selected.substitutes, toolchain)?
    rendered = response(paths, path.0, selected)?
    if rendered != "":
        println(rendered)
    return Ok(0)


def response(paths: list[Path], root: str, selected: GraphOptions) -> Result[str, str]:
    """Cache presentation by immutable unit graph paths and query arguments; a warm repeat decodes no graph records."""
    if len(paths) == 0:
        return Err("no units selected for graph inspection")
    inputs = ["incan.codegraph.presentation/1", root, selected.format, selected.query, selected.term] + [path.0 for path in paths]
    digest = fingerprint(inputs)?
    cached = paths[0].parent().joinpath(f"{digest}.answer")
    if cached.is_file():
        return cached.read_text("utf-8", "strict").map_err((error) => error.message())
    mut rendered = ""
    if selected.query != "":
        records = read_records(query_paths(paths, selected.query)?, root)?
        rendered = "\n".join(query(records, selected.query, selected.term))
    else:
        # An exported snapshot is query-ready: the one-time projection belongs to cold export, not a later query.
        _ = query_paths(paths, "defs")?
        records = read_records(paths, root)?
        if selected.format == "json":
            rendered = JsonValue.array(records).to_json().map_err((error) => error.message())?
        else:
            rendered = "\n".join([record.to_json().map_err((error) => error.message())? for record in records])
    publish(cached, rendered)?
    return Ok(rendered)


def inspect_incan(source: Path, toolchain: Toolchain) -> Result[Path, str]:
    """Describe before checking the cache; only a changed unit prepares dependencies and invokes shared analysis."""
    unit = describe(source, "debug", FeatureRequest())?
    project = Path(unit.project_root)
    mut inputs = ["incan.codegraph.incan/1", compiler_digest(project, toolchain.driver)?, toolchain.sysroot, unit.to_json().to_json().map_err((error) => error.message())?]
    for native in toolchain.externs:
        inputs = inputs + [native.name, native.path, compiler_digest(project, native.path)?]
    for cache in toolchain.rust_abi:
        inputs = inputs + [cache, compiler_digest(project, cache)?]
    inputs = inputs + toolchain.search
    inputs.append(compiler_digest(project, toolchain.registry_units)?)
    inputs = inputs + tree_inputs(Path(unit.project_root))?
    for dependency in dependency_units(unit)?:
        inputs = inputs + tree_inputs(Path(dependency.project_root))?
    for loaf in unit.loaves:
        inputs = inputs + tree_inputs(Path(loaf.dir))?
    entry = cache_file(Path(unit.project_root), fingerprint(inputs)?)?
    if entry.is_file():
        return Ok(entry)
    if prepare_dependencies(unit, toolchain)? != 0:
        return Err("graph dependency preparation failed")
    ready = prepare_native(unit, toolchain)?
    description = write_unit(ready, crate_name(ready))?
    output = Path(f"{entry.0}.{id()}.analysis")
    code = run_compiler(toolchain, ["--codegraph", description.0, toolchain.sysroot, output.0])?
    if code != 0:
        return Err("Incan graph export failed")
    document = output.read_text("utf-8", "strict").map_err((error) => error.message())?
    publish(entry, document)?
    output.unlink().map_err((error) => error.message())?
    return Ok(entry)


def read_records(paths: list[Path], root: str) -> Result[list[JsonValue], str]:
    """Merge unit documents deterministically, retaining one header and one instance of each identified fact."""
    mut records: list[JsonValue] = []
    mut seen: Dict[str, bool] = {}
    mut header: Dict[str, JsonValue] = {}
    mut languages: list[str] = []
    mut contexts: list[JsonValue] = []
    for path in paths:
        document = path.read_text("utf-8", "strict").map_err((error) => error.message())?
        for line in document.split("\n"):
            if line.strip() == "":
                continue
            record = parse(line).map_err((error) => f"{path.0}: {error.message()}")?
            mut key = text(record, "id")
            if text(record, "record") == "header":
                header = record.expect_object().map_err((error) => error.message())?
                for language in record.require("languages").map_err((error) => error.message())?.expect_array().map_err((error) => error.message())?:
                    name = language.expect_str().map_err((error) => error.message())?
                    if name not in languages:
                        languages.append(name)
                match record.get("semantic_contexts"):
                    Some(value) =>
                        contexts = contexts + value.expect_array().map_err((error) => error.message())?
                    None => pass
                continue
            if key != "" and key in seen:
                continue
            seen[key] = true
            records.append(record)
    header["root_path"] = JsonValue.string(root)
    header["languages"] = JsonValue.array([JsonValue.string(name) for name in sorted(languages)])
    header["semantic_contexts"] = JsonValue.array(contexts)
    return Ok([JsonValue.object(header)] + records)
