"""The inspection CLI selects units and presents the compiler's single graph representation."""

from rust::std::io import Write, stderr
from rust::std::string import String as RustString
from rust::std::time import Instant
from std.fs import Path
from std.json import JsonValue, parse
from bakery import bakery, claim
from features import FeatureRequest
from files import json_text, read
from graph_cache import (
    GraphUnit,
    cache_file,
    read_graph,
    stamp_file,
    tree_inputs,
    unchecked_note,
    unchecked_refusal,
    unchecked_warning,
)
from graph_dependencies import GraphDependencies, prepare_graph, unit_natives, unit_loaves
from observation import file_digest, trace
from graph_incan import inspect_incan
from graph_loaves import registry_artifacts, registry_graphs, standard_graphs
from graph_queries import matches, query, query_group, text
from graph_identity import keyed, link_keys, declaration_digests
from graph_snapshot import snapshot_identity, snapshot_status
from graph_context import pack
from graph_context_index import ContextIndex
from graph_context_items import anchor_root
from graph_process import process_facts
from graph_rust import inspect_rust
from json_fields import required_items, string_value
from publication import publish
from rust_units import rust_facet
from toolchain import Toolchain, load_toolchain
from unit import project_root_of
from unit_freshness import artifact_identity, fingerprint
from cli_help import render as render_help

const QUERY_KINDS: FrozenList[str] = ["defs", "refs", "callers", "callees", "imports"]
pub const USAGE: str = "incan inspect codegraph PATH [GRAPH OPTIONS]"
pub const VALUE_OPTIONS: FrozenList[str] = [
    "--query",
    "--format",
    "--limit",
    "--substitute",
    "--stale",
    "--task",
    "--budget",
]
# The version of the key an answer is cached under; changing it discards every cached answer.
const PRESENTATION_DOMAIN: str = "incan.codegraph.presentation/19"


pub model GraphOptions:
    """A source or project and its graph presentation, independent of compiler semantics."""

    pub path: str = ""
    pub format: str = "jsonl"
    pub query: str = ""
    pub term: str = ""
    pub limit: int = 20
    pub strict: bool = false
    pub substitutes: Dict[str, str] = {}
    pub stale: str = ""
    pub task: str = ""
    pub budget: int = 8000
    pub risk: bool = false


pub def options(arguments: list[str]) -> Result[GraphOptions, str]:
    """
    Validate the full invocation before any build or cache operation.

    1. The command is `codegraph`.
    2. Read each argument: `--strict`, a flag with its value, or the one path.
    3. A path is required, and the format and query kind must be known.
    """
    # 1. Only the `codegraph` inspection exists, and anything else is answered with the usage.
    if len(arguments) == 0:
        return Err("expected `codegraph`")
    if arguments[0] != "codegraph":
        if arguments[0].startswith("-"):
            return Err(f"unknown option `{arguments[0]}`")
        return Err(f"unknown command `{arguments[0]}`")
    # 2. A flag takes the arguments it needs, nothing else starts with `-`, and the first plain argument is the path.
    mut result = GraphOptions()
    mut index = 1
    while index < len(arguments):
        value = arguments[index]
        if value == "--risk":
            result.risk = true
            index += 1
            continue
        if value == "--strict":
            result.strict = true
            index += 1
        elif value == "--query":
            read_query(result, arguments, index)?
            index += 3
        elif value in VALUE_OPTIONS:
            if index + 1 >= len(arguments):
                return Err(f"{value} needs a value")
            apply_flag(result, value, arguments[index + 1])?
            index += 2
        elif value.startswith("-"):
            return Err(f"unknown option `{value}`")
        elif result.path != "":
            return Err(f"unexpected argument `{value}`")
        else:
            result.path = value
            index += 1
    # 3. Nothing is built or cached before the path, the format and the query kind are known to be valid.
    if result.path == "":
        return Err("a PATH is required")
    if result.format not in ["json", "jsonl", "compact"]:
        return Err("--format is json, jsonl or compact")
    if result.format == "compact" and result.task == "":
        return Err("--format compact requires --task")
    if result.task != "" and (result.query != "" or result.stale != ""):
        return Err("--task cannot be combined with --query or --stale")
    if result.query != "" and result.query not in QUERY_KINDS:
        return Err(f"unknown graph query `{result.query}`")
    return Ok(result)


pub def help_text() -> str:
    """Describe graph selection and presentation options from the inspection parser's public contract."""
    return render_help(
        USAGE,
        [
            "  --format json|jsonl|compact  Output format (default jsonl); compact requires --task.",
            "  --query KIND TERM           Query defs, refs, callers, callees or imports.",
            "  --limit N                   Maximum query hits (default 20; minimum 0).",
            "  --task TASK                 Select a context pack; excludes --query and --stale.",
            "  --budget N                  Context byte bound (default 8000; 128..1000000).",
            "  --stale SNAPSHOT            Check an exported snapshot: identity.",
            "  --strict                    Refuse unchecked units.",
            "  --risk                      Include optional local git observations.",
            "  --substitute NAME=DIR       Select a local dependency source; repeatable.",
        ],
        "incan inspect codegraph . --query defs main",
    )


def read_query(mut result: GraphOptions, arguments: list[str], index: int) -> Result[None, str]:
    """Read `--query KIND TERM`, which takes the two arguments after the flag."""
    if index + 1 >= len(arguments):
        return Err("--query needs a value")
    result.query = arguments[index + 1]
    if index + 2 >= len(arguments):
        return Err("--query needs a query kind and TERM")
    result.term = arguments[index + 2]
    return Ok(None)


def apply_flag(mut result: GraphOptions, flag: str, item: str) -> Result[None, str]:
    """Apply one value flag, retaining its format, limit, budget, task or snapshot constraints."""
    if flag == "--format":
        result.format = item
    elif flag == "--limit":
        result.limit = limit_of(item)?
    elif flag == "--task":
        if item.strip() == "":
            return Err("--task needs a nonempty task or declaration")
        result.task = item
    elif flag == "--budget":
        result.budget = budget_of(item)?
    elif flag == "--stale":
        if not item.startswith("snapshot:"):
            return Err("--stale needs an exported snapshot: identity")
        result.stale = item
    else:
        parts = item.split("=")
        if len(parts) != 2 or parts[0] == "" or parts[1] == "":
            return Err("--substitute takes NAME=DIR")
        result.substitutes[parts[0]] = parts[1]
    return Ok(None)


def limit_of(item: str) -> Result[int, str]:
    """A nonnegative whole number given as a `--limit`."""
    limit = parse(item).map_err((_) => limit_refusal())?.expect_int().map_err((_) => limit_refusal())?
    if limit < 0:
        return Err(limit_refusal())
    return Ok(limit)


def limit_refusal() -> str:
    """What a `--limit` that is not a nonnegative whole number is refused with."""
    return "--limit needs a nonnegative integer"


def budget_of(item: str) -> Result[int, str]:
    """Accept the context byte bound only within the public token-budget range."""
    refusal = "--budget needs an integer"
    budget = parse(item).map_err((_) => refusal)?.expect_int().map_err((_) => refusal)?
    if budget < 128 or budget > 1000000:
        return Err("--budget must be between 128 and 1000000")
    return Ok(budget)


pub def inspect_codegraph(selected: GraphOptions) -> Result[i32, str]:
    """Print a public export or query, leaving an empty query answer silent."""
    rendered = selected_response(selected)?
    if rendered != "":
        println(rendered)
    return Ok(0)


pub def graph_response(arguments: list[str], preferences: Dict[str, int] = {}) -> Result[str, str]:
    """Validate a graph service invocation before preparing its current, content-addressed answer."""
    return selected_response(options(arguments)?, preferences)


def selected_response(selected: GraphOptions, preferences: Dict[str, int] = {}) -> Result[str, str]:
    """Prepare one command and render its answer; no prepared facts outlive the command."""
    return prepare_inspection(selected)?.respond(preferences)


pub model PreparedInspection:
    """One request's graph selection, shared by its snapshot probe and response and dropped with that request."""

    pub paths: list[GraphUnit]
    pub root: str
    pub selected: GraphOptions
    pub toolchain: Toolchain

    def snapshot(self) -> Result[str, str]:
        """Identify the exact prepared inputs used by feedback and the answer in this request."""
        return snapshot_identity(self.paths, self.root, self.selected.strict)

    def respond(self, preferences: Dict[str, int] = {}) -> Result[str, str]:
        """Render the admitted request over its prepared graph without reopening the dependency closure."""
        return response(self.paths, self.root, self.selected, self.toolchain, preferences)


pub def prepare_inspection(selected: GraphOptions) -> Result[PreparedInspection, str]:
    """
    Prepare and render a validated graph request; CLI syntax failures never enter this boundary.

    1. Resolve the path and read the installed toolchain.
    2. Select the units to inspect: an Incan source through its checked interfaces, anything else as a Rust project.
    3. Return the rendered answer through the shared inspection boundary.
    """
    # 1. Path and installation failures are execution errors after syntax has been admitted.
    started = Instant.now()
    path = Path(selected.path).resolve().map_err((error) => error.message())?
    toolchain = load_toolchain()?
    # 2. An Incan source is inspected through its checked dependencies' interfaces; anything else is a Rust project.
    source = entry_source(path)
    mut paths: list[GraphUnit] = []
    if source.is_file() and source.name().endswith(".incn"):
        paths = inspect_source(source, toolchain, selected.substitutes)?
    else:
        root = owning_project(path, selected.path)?
        paths = inspect_rust(root, "debug", FeatureRequest(), selected.substitutes, toolchain, selected.query == "defs")?
    trace(f"graph preparation: {started.elapsed().as_millis()} ms")
    # 3. CLI and service consumers share the same rendered facts and freshness checks.
    return Ok(PreparedInspection(paths=paths, root=path.0, selected=selected, toolchain=toolchain))


def entry_source(path: Path) -> Path:
    """The path itself, or for a directory that is not a Rust crate its conventional Incan entry, library first."""
    if path.is_dir() and not path.joinpath("src").joinpath("lib.rs").is_file():
        for name in ["lib.incn", "main.incn"]:
            candidate = path.joinpath("src").joinpath(name)
            if candidate.is_file():
                return candidate
    return path


def owning_project(path: Path, given: str) -> Result[Path, str]:
    """The project directory of a path: itself, or the nearest directory above a file that holds a `loaf.toml`."""
    if not path.is_file():
        return Ok(path)
    match project_root_of(path):
        Some(root) => return Ok(root)
        None => return Err(f"{given}: no owning loaf.toml")


def response(
    paths: list[GraphUnit],
    root: str,
    selected: GraphOptions,
    toolchain: Toolchain,
    preferences: Dict[str, int],
) -> Result[str, str]:
    """
    Cache presentation by immutable unit graph paths and query arguments; a warm repeat decodes no graph records.

    Every unit that failed checking is named on stderr, one line each, before any answer; `--strict` refuses instead.

    1. Units that failed checking are named, or refused with `--strict`.
    2. An answer cached under the digest of the selection and the units' graphs is returned as it is.
    3. Otherwise render the answer and cache it.
    """
    if len(paths) == 0:
        return Err("no units selected for graph inspection")
    # 1. A unit that failed checking is named on stderr before any answer, and under `--strict` it refuses the answer.
    started = Instant.now()
    notes = unchecked_notes(paths)?
    if selected.strict and len(notes) > 0:
        return Err("\n".join([unchecked_refusal(note) for note in notes]))
    for note in notes:
        warn(unchecked_warning(note))
    # 2. The same selection over the same graphs gets its answer from the cache without decoding a record.
    mut snapshot = ""
    if needs_snapshot(selected):
        snapshot = snapshot_identity(paths, root, selected.strict)?
    trace(f"graph snapshot: {started.elapsed().as_millis()} ms")
    lookup = Instant.now()
    mut process: list[JsonValue] = []
    if selected.risk:
        files = read_records(paths, root, toolchain, "file", selected.strict, len(notes) > 0, snapshot)?
        process = process_facts(anchor_root(Path(root)), files)?
        if len(process) > 0:
            observed = JsonValue.array(process).to_json().map_err((error) => error.message())?
            snapshot = f"snapshot:{fingerprint([snapshot, observed])?}"
    if selected.stale != "":
        return json_text(snapshot_status(selected.stale, snapshot))
    portable = shared_query(selected)
    mut inputs: list[str] = []
    match presentation_inputs(paths, root, selected, snapshot, preferences, portable)?:
        None => return render(paths, root, selected, toolchain, len(notes) > 0, snapshot, process, preferences)
        Some(ready) => inputs = ready
    cached = Path(f"{cache_file(fingerprint(inputs)?)?.0}.answer")
    trace(f"graph answer lookup: {lookup.elapsed().as_millis()} ms")
    if cached.is_file():
        return read(cached)
    # 3. A missing answer is rendered once, after rechecking its claim.
    held = claim(bakery()?, fingerprint(["graph-answer"] + inputs)?)?
    if cached.is_file():
        return read(cached)
    evaluation = Instant.now()
    rendered = render(paths, root, selected, toolchain, len(notes) > 0, snapshot, process, preferences)?
    if not portable or portable_answer(rendered):
        publish(cached, rendered)?
    trace(f"graph answer evaluation: {evaluation.elapsed().as_millis()} ms")
    return Ok(rendered)


def needs_snapshot(selected: GraphOptions) -> bool:
    """Only snapshot-bearing responses hash graph contents; plain queries are keyed by prepared artifact identities."""
    return selected.query == "" or selected.stale != "" or selected.risk


def presentation_inputs(
    paths: list[GraphUnit],
    root: str,
    selected: GraphOptions,
    snapshot: str,
    preferences: Dict[str, int],
    portable: bool,
) -> Result[Option[list[str]], str]:
    """Everything an answer depends on: the options, and each unit's graph with the identity of its file."""
    mut key_root = root
    mut anchors = ""
    if portable:
        anchors = anchor_root(Path(root)).0
        match relative_scope(root, anchors):
            None => return Ok(None)
            Some(scope) => key_root = f"relative:{scope}"
    mut inputs = [PRESENTATION_DOMAIN, snapshot, key_root, selected.format, selected.query, selected.term]
    inputs = inputs + [str(selected.limit), str(selected.strict)]
    inputs = inputs + [selected.task, str(selected.budget)]
    boost_values = JsonValue.object(
        {key: JsonValue.int(preferences[key]) for key in sorted([key for key in preferences.keys()])},
    )
    inputs = inputs + [str(selected.risk), json_text(boost_values)?]
    if selected.query == "imports":
        inputs.append("nonempty-import-labels/1")
    for unit in paths:
        if portable:
            match relative_scope(unit.root.0, anchors):
                None => return Ok(None)
                Some(scope) =>
                    observed = tree_inputs(stamp_file(unit))?
                    inputs.extend([scope, unit.package, unit.version, observed[1]])
        else:
            inputs.extend([unit.path.0, unit.root.0, unit.package, unit.version, artifact_identity(stamp_file(unit))?])
    return Ok(Some(inputs))


def shared_query(selected: GraphOptions) -> bool:
    """Only plain, risk-free query lines can be reused without rendering requester-specific structured headers."""
    structured = selected.query == "defs" and selected.format == "json"
    return selected.query != "" and not structured and not selected.risk


def relative_scope(path: str, root: str) -> Option[str]:
    """Name a virtual package or a binding within the requester's repository; external roots remain unshared."""
    if path.startswith("@"):
        return Some(path)
    if path == root:
        return Some(".")
    if path.startswith(root + "/"):
        return Some(path[len(root) + 1:])
    return None


def portable_answer(answer: str) -> bool:
    """Refuse retention of plain answers that expose an absolute source location instead of a relative anchor."""
    for line in answer.split("\n"):
        for word in line.split(" "):
            if word.startswith("/") or word.startswith("\\\\") or word.startswith("file://"):
                return false
            if len(word) > 2 and word[1:3] in [":/", ":\\"]:
                return false
    return true


def render(
    paths: list[GraphUnit],
    root: str,
    selected: GraphOptions,
    toolchain: Toolchain,
    degraded: bool,
    snapshot: str,
    process: list[JsonValue],
    preferences: Dict[str, int],
) -> Result[str, str]:
    """The answer to a query, at most `limit` hits, or the merged records as one JSON array or one record per line."""
    if selected.task != "":
        started = Instant.now()
        mut index = context_index(paths, root, toolchain, process)?
        trace(f"graph context index: {started.elapsed().as_millis()} ms")
        return pack(
            index,
            snapshot,
            JsonValue.bool(degraded),
            selected.task,
            selected.budget,
            anchor_root(Path(root)).0,
            selected.format,
            preferences,
        )
    if selected.query != "":
        started = Instant.now()
        group = query_group(selected.query)
        mut definition: Option[str] = None
        if selected.query == "defs":
            definition = Some(selected.term)
        records = read_records(paths, root, toolchain, group, selected.strict, degraded, snapshot, definition)?
        trace(f"graph query records: {started.elapsed().as_millis()} ms")
        if selected.format == "json" and selected.query == "defs":
            return definition_response(records, selected.term, selected.limit)
        hits = query(records, selected.query, selected.term, anchor_root(Path(root)).0)
        mut lines = hits[:selected.limit]
        if len(hits) > selected.limit:
            lines.append(f"… {len(hits) - selected.limit} more")
        return Ok("\n".join(lines))
    records = export_records(paths, root, selected, toolchain, degraded, snapshot)? + process
    if selected.format == "json":
        return json_text(JsonValue.array(records))
    return Ok("\n".join([json_text(record)? for record in records]))


def definition_response(records: list[JsonValue], term: str, limit: int) -> Result[str, str]:
    """Bound structured definition records and their digest metadata to the same exact selection."""
    declarations = [record for record in records[1:] if definition_candidate(record, term) and matches(record, term)]
    selected = declarations[:limit]
    mut header = records[0].expect_object().map_err((error) => error.message())?
    header["declaration_digests"] = declaration_digests(selected)?
    header["remaining_hits"] = JsonValue.int(len(declarations) - len(selected))
    return json_text(JsonValue.array([JsonValue.object(header)] + selected))


def export_records(
    paths: list[GraphUnit],
    root: str,
    selected: GraphOptions,
    toolchain: Toolchain,
    degraded: bool,
    snapshot: str,
) -> Result[list[JsonValue], str]:
    """
    Export the requested unit's facts, retaining immutable dependency graphs by identity and location.

    1. Separate the requested project's units from its dependency providers.
    2. Read provider declaration keys for joins, without copying their records into the answer.
    3. Export local facts and references to each provider's original graph.
    """
    # 1. An explicit additional source is also a separate unit, rather than an owner of this project's records.
    mut owner = Path(root)
    if owner.is_file():
        owner = project_root_of(owner).unwrap_or(owner.parent())
    local = [unit for unit in paths if unit.root.0 == owner.0]
    dependencies = [unit for unit in paths if unit.root.0 != owner.0]
    # 2. Foreign keys remain available to local references through the exact published declaration identities.
    providers = provider_keys(dependencies, toolchain)?
    # 3. Every dependency keeps one graph; the answer carries only its address and content identity.
    records = read_records(local, root, toolchain, "", selected.strict, degraded, snapshot, None, providers)?
    mut header = records[0].expect_object().map_err((error) => error.message())?
    mut references: list[JsonValue] = []
    for unit in dependencies:
        if not unit.path.is_file():
            continue
        references.append(dependency_reference(unit)?)
    header["dependencies"] = JsonValue.array(references)
    return Ok([JsonValue.object(header)] + records[1:])


def dependency_reference(unit: GraphUnit) -> Result[JsonValue, str]:
    """Address original immutable graph bytes by digest, retaining their package and source-anchor provenance."""
    mut fields: Dict[str, JsonValue] = {}
    fields["id"] = JsonValue.string(f"graph:sha256:{file_digest(unit.path)?}")
    fields["graph"] = JsonValue.string(unit.path.0)
    fields["root_path"] = JsonValue.string(unit.root.0)
    fields["package"] = JsonValue.string(unit.package)
    fields["version"] = JsonValue.string(unit.version)
    return Ok(JsonValue.object(fields))


def provider_keys(paths: list[GraphUnit], toolchain: Toolchain) -> Result[list[JsonValue], str]:
    """Read only identity columns from published declarations; dependency payloads never enter an export."""
    columns = [JsonValue.string(field) for field in ["record", "id", "stable_identity"]]
    fields = json_text(JsonValue.object({"declaration": JsonValue.array(columns)}))?
    mut records: list[JsonValue] = []
    for unit in paths:
        mut package = unit.package
        for line in read_graph(unit, toolchain, "declaration", fields)?.split("\n"):
            if line == "":
                continue
            record = parse(line).map_err((error) => error.message())?
            if text(record, "record") == "header":
                check_identity(unit, record)?
                package = text(record.get("package").unwrap_or(JsonValue.null()), "name")
            else:
                records.append(keyed(record, package)?)
    return Ok(records)


def context_index(
    paths: list[GraphUnit],
    root: str,
    toolchain: Toolchain,
    process: list[JsonValue],
) -> Result[ContextIndex, str]:
    """
    Prepare demand-readable context facts without joining full graph payloads.

    1. Validate each package header and load its ranking rows.
    2. Join only the identity columns, then attach current process observations.
    """
    mut index = ContextIndex()
    mut owner = Path(root)
    if owner.is_file():
        owner = owner.parent()
    # 1. Header validation stays at the inspection boundary, shared with ordinary exports.
    for unit in paths:
        previous = len(index.headers)
        index.add(unit, toolchain, owner)?
        for header in index.headers[previous:]:
            check_identity(unit, header)?
            header_languages(header)?
            if let Some(value) = header.get("semantic_contexts"):
                value.expect_array().map_err((error) => error.message())?
    # 2. Payloads remain unread until their ranked node or selected relationship is requested.
    index.join()?
    index.add_process(process, anchor_root(owner).0)?
    return Ok(index)


def unchecked_notes(paths: list[GraphUnit]) -> Result[list[str], str]:
    """The notes of the selected units whose facts are not all checked, one per distinct unit."""
    mut notes: list[str] = []
    for unit in paths:
        note = unchecked_note(unit.path)?
        if note != "" and note not in notes:
            notes.append(note)
    return Ok(notes)


def warn(message: str) -> None:
    """Print one warning line to stderr; the answer itself stays on stdout."""
    mut err = stderr()
    # A closed standard error cannot be told about, so a failed write is ignored.
    _ = err.write_all(RustString.from(f"{message}\n").into_bytes())


def inspect_source(source: Path, toolchain: Toolchain, substitutes: Dict[str, str]) -> Result[list[GraphUnit], str]:
    """
    Inspect the source closure through checked interfaces, without building an Incan library.

    1. A source outside any project is inspected alone.
    2. A project's dependency graphs are prepared, and the registry graphs join them.
    3. A library is inspected as its project's library; any other source as the project's own unit that contains it.
    4. The standard Loaves the units reach join the answer.
    """
    # 1. A source outside any project stands alone, with no dependencies to prepare.
    match project_root_of(source):
        None =>
            parent = source.parent()
            graph = inspect_incan(source, toolchain)?
            return Ok([GraphUnit(path=graph, root=parent, source_root=parent.0)])
        Some(root) =>
            # 2. A project's dependencies contribute the graphs they published, and registry Loaves theirs.
            prepared = prepare_graph(root, "debug", FeatureRequest(), substitutes, toolchain)?
            mut paths = prepared.paths + registry_graphs(registry_artifacts(prepared.facets, prepared.request)?)
            # 3. A library is already among the prepared graphs; any other source adds the graph of its own unit.
            if source.name() != "lib.incn":
                paths.append(own_unit_graph(source, root, prepared, toolchain)?)
            # 4. The standard Loaves the units reach join, except the one the project itself is.
            package = rust_facet(root.0, false, prepared.request.manifests)?.package
            standard = standard_graphs(root, "debug", toolchain, paths, prepared.registry, package,
                                       prepared.request.manifests)?
            return Ok(paths + standard)


def own_unit_graph(
    source: Path,
    root: Path,
    prepared: GraphDependencies,
    toolchain: Toolchain,
) -> Result[GraphUnit, str]:
    """The graph of a source of the project's own target unit, checked against the interfaces of its dependencies."""
    for facet in prepared.facets:
        if facet.project == root.0 and facet.domain.value() == "target":
            loaves = unit_loaves(facet, prepared.interfaces, prepared.request.manifests)?
            natives = unit_natives(facet, prepared.built, prepared.request, loaves)?
            graph = inspect_incan(source, toolchain, natives, prepared.interfaces, facet.features, false, loaves,
                                  registry=Some(prepared.registry), reader=prepared.request.manifests,
                                  facets=prepared.facets)?
            return Ok(GraphUnit(path=graph, root=root, source_root=root.0))
    return Err("inspection selected no source unit")


def read_records(
    paths: list[GraphUnit],
    root: str,
    toolchain: Toolchain,
    group: str,
    strict: bool,
    degraded: bool,
    snapshot: str,
    definition: Option[str] = None,
    providers: list[JsonValue] = [],
) -> Result[list[JsonValue], str]:
    """
    Merge unit documents deterministically, retaining one header and one instance of each identified fact.

    The header states the requested mode and whether any selected unit is unchecked, whichever unit's header was kept.

    1. Read the records of each unit for the group, one JSON document per line.
    2. A header is checked against the unit it came from. The first one is kept, and then that of the unit that holds
       the root; all of them contribute their languages and semantic contexts.
    3. Keep requested definition candidates, or all records, once per identity.
    4. The kept header is completed with the mode, degradation, languages and contexts of the whole selection.
    """
    mut records: list[JsonValue] = []
    mut seen: Dict[str, bool] = {}
    mut header: Dict[str, JsonValue] = {}
    mut languages: list[str] = []
    mut contexts: list[JsonValue] = []
    for unit in paths:
        started = Instant.now()
        # 1. Each unit's records are read for the group the query needs, one JSON document to a line.
        document = read_graph(unit, toolchain, group)?
        mut package_name = unit.package
        for line in document.split("\n"):
            if line.strip() == "":
                continue
            mut record = parse(line).map_err((error) => f"{unit.path.0}: {error.message()}")?
            # 2. A header must belong to the unit it was read for; the one kept is the first, or the root unit's.
            if text(record, "record") == "header":
                package_name = text(record.get("package").unwrap_or(JsonValue.null()), "name")
                check_identity(unit, record)?
                if len(header) == 0 or unit.root.0 == root or root.startswith(f"{unit.root.0}/"):
                    header = record.expect_object().map_err((error) => error.message())?
                for name in header_languages(record)?:
                    if name not in languages:
                        languages.append(name)
                match record.get("semantic_contexts"):
                    Some(value) => contexts = contexts + value.expect_array().map_err((error) => error.message())?
                    None => pass
                continue
            # 3. A fact several units report is kept once, under the first that reported it.
            if let Some(term) = definition:
                if not definition_candidate(record, term):
                    continue
            record = keyed(record, package_name)?
            key = text(record, "id")
            if key != "" and key in seen:
                continue
            seen[key] = true
            records.append(record)
        trace(f"graph records {unit.package}: {started.elapsed().as_millis()} ms")
    # 4. The header tells the reader the mode, whether any unit was unchecked, and every language and context involved.
    # An unchecked unit may have only its refusal note; the request still has a presentation header.
    header["record"] = JsonValue.string("header")
    header["root_path"] = JsonValue.string(root)
    header["mode"] = JsonValue.string("allow_errors")
    if strict:
        header["mode"] = JsonValue.string("strict")
    header["degraded"] = JsonValue.bool(degraded)
    header["languages"] = JsonValue.array([JsonValue.string(name) for name in sorted(languages)])
    header["semantic_contexts"] = JsonValue.array(contexts)
    header["identity_schema"] = JsonValue.string("incan.graph.identity/2")
    records = link_keys(records, providers)?
    header["declaration_digests"] = declaration_digests(records)?
    header["snapshot_id"] = JsonValue.string(snapshot)
    return Ok([JsonValue.object(header)] + records)


def definition_candidate(record: JsonValue, term: str) -> bool:
    """Defer consumer-key matching until keys exist; ordinary names and export ids can filter before graph joins."""
    if text(record, "record") != "declaration":
        return false
    return term.startswith("symbol:") or matches(record, term)


def check_identity(unit: GraphUnit, header: JsonValue) -> Result[None, str]:
    """Refuse a graph whose header names no Loaf, or another Loaf or version than the unit it was read for."""
    package = header.get("package")
    if unit.package != "" and package is None:
        return Err(f"{unit.path.0}: graph has no Loaf identity")
    if let Some(value) = package:
        if unit.package != "" and text(value, "name") != unit.package:
            return Err(f"{unit.path.0}: graph names a different Loaf")
        if unit.version != "" and text(value, "version") != unit.version:
            return Err(f"{unit.path.0}: graph has a different Loaf version")
    return Ok(None)


def header_languages(header: JsonValue) -> Result[list[str], str]:
    """The languages a graph header says its facts are in."""
    mut names: list[str] = []
    for language in required_items(header, "languages")?:
        names.append(string_value(language)?)
    return Ok(names)
