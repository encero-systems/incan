"""The inspection CLI selects units and presents the compiler's single graph representation."""

from std.fs import Path
from std.json import JsonValue, parse
from features import FeatureRequest
from graph_cache import GraphUnit, cache_file, compiler_digest, fingerprint, publish, read_graph
from graph_dependencies import prepare_graph, unit_natives, unit_loaves
from graph_incan import inspect_incan
from graph_loaves import registry_artifacts, registry_graphs, standard_graphs
from graph_queries import query, query_group, text
from graph_rust import inspect_rust
from toolchain import Toolchain, load_toolchain
from unit import project_root_of
from rust_units import rust_facet


pub model GraphOptions:
    """A source or project and its graph presentation, independent of compiler semantics."""

    pub path: str = ""
    pub format: str = "jsonl"
    pub query: str = ""
    pub term: str = ""
    pub limit: int = 20
    pub substitutes: Dict[str, str] = {}


def options(arguments: list[str]) -> Result[GraphOptions, str]:
    """Validate the full invocation before any build or cache operation."""
    if len(arguments) == 0 or arguments[0] != "codegraph":
        return Err("usage: incan inspect codegraph PATH [--format json|jsonl] [--query defs|refs|callers|callees|imports TERM] [--limit N]")
    mut result = GraphOptions()
    mut index = 1
    while index < len(arguments):
        value = arguments[index]
        if value in ["--format", "--query", "--substitute", "--limit"]:
            if index + 1 >= len(arguments):
                return Err(f"{value} needs a value")
            item = arguments[index + 1]
            if value == "--format":
                result.format = item
            elif value == "--limit":
                result.limit = parse(item).map_err((_) => "--limit needs a nonnegative integer")?.expect_int().map_err((_) => "--limit needs a nonnegative integer")?
                if result.limit < 0:
                    return Err("--limit needs a nonnegative integer")
            elif value == "--substitute":
                parts = item.split("=")
                if len(parts) != 2 or parts[0] == "" or parts[1] == "":
                    return Err("--substitute takes NAME=DIR")
                result.substitutes[parts[0]] = parts[1]
            else:
                result.query = item
                if index + 2 >= len(arguments):
                    return Err("--query needs a query kind and TERM")
                result.term = arguments[index + 2]
                index += 1
            index += 2
            continue
        if value.startswith("-") or result.path != "":
            return Err(f"unexpected argument `{value}`")
        result.path = value
        index += 1
    if result.path == "":
        return Err("a PATH is required")
    if result.format not in ["json", "jsonl"]:
        return Err("--format is json or jsonl")
    if result.query != "" and result.query not in ["defs", "refs", "callers", "callees", "imports"]:
        return Err(f"unknown graph query `{result.query}`")
    return Ok(result)


pub def inspect_codegraph(arguments: list[str]) -> Result[i32, str]:
    """Export JSON/JSONL or answer a compact query, reusing content-addressed unit exports."""
    selected = options(arguments)?
    path = Path(selected.path).resolve().map_err((error) => error.message())?
    toolchain = load_toolchain()?
    mut paths: list[GraphUnit] = []
    mut source = path
    if path.is_dir() and not path.joinpath("src").joinpath("lib.rs").is_file():
        for name in ["lib.incn", "main.incn"]:
            candidate = path.joinpath("src").joinpath(name)
            if candidate.is_file():
                source = candidate
                break
    if source.is_file() and source.name().endswith(".incn"):
        paths = inspect_source(source, toolchain, selected.substitutes)?
    else:
        mut root = path
        if root.is_file():
            root = root.parent()
            while not root.joinpath("loaf.toml").is_file():
                parent = root.parent()
                if parent.0 == root.0:
                    return Err(f"{selected.path}: no owning loaf.toml")
                root = parent
        paths = inspect_rust(root, "debug", FeatureRequest(), selected.substitutes, toolchain)?
    rendered = response(paths, path.0, selected, toolchain)?
    if rendered != "":
        println(rendered)
    return Ok(0)


def response(paths: list[GraphUnit], root: str, selected: GraphOptions, toolchain: Toolchain) -> Result[str, str]:
    """Cache presentation by immutable unit graph paths and query arguments; a warm repeat decodes no graph records."""
    if len(paths) == 0:
        return Err("no units selected for graph inspection")
    mut owner = Path(root)
    if owner.is_file():
        owner = owner.parent()
    mut inputs = ["incan.codegraph.presentation/6", root, selected.format, selected.query, selected.term, str(selected.limit)]
    if selected.query == "imports":
        inputs.append("nonempty-import-labels/1")
    for unit in paths:
        inputs = inputs + [unit.path.0, unit.root.0, unit.package, unit.version, compiler_digest(owner, unit.path.0)?]
    digest = fingerprint(inputs)?
    cached = Path(f"{cache_file(owner, digest)?.0}.answer")
    if cached.is_file():
        return cached.read_text("utf-8", "strict").map_err((error) => error.message())
    mut rendered = ""
    if selected.query != "":
        records = read_records(paths, root, toolchain, query_group(selected.query))?
        hits = query(records, selected.query, selected.term, anchor_root(Path(root)).0)
        mut lines = hits[:selected.limit]
        if len(hits) > selected.limit:
            lines.append(f"… {len(hits) - selected.limit} more")
        rendered = "\n".join(lines)
    else:
        records = read_records(paths, root, toolchain, "")?
        if selected.format == "json":
            rendered = JsonValue.array(records).to_json().map_err((error) => error.message())?
        else:
            rendered = "\n".join([record.to_json().map_err((error) => error.message())? for record in records])
    publish(cached, rendered)?
    return Ok(rendered)


def anchor_root(path: Path) -> Path:
    """Prefer repository-relative source anchors, falling back to the nearest owning project for standalone Loaves."""
    mut directory = path
    if directory.is_file():
        directory = directory.parent()
    mut project = directory
    mut found = false
    while true:
        if directory.joinpath(".git").is_file() or directory.joinpath(".git").is_dir():
            return directory
        if not found and directory.joinpath("loaf.toml").is_file():
            project = directory
            found = true
        parent = directory.parent()
        if parent.0 == directory.0 or parent.0 in [".", ""]:
            return project
        directory = parent


def inspect_source(source: Path, toolchain: Toolchain, substitutes: Dict[str, str]) -> Result[list[GraphUnit], str]:
    """Inspect the source closure through checked interfaces, without building an Incan library."""
    match project_root_of(source):
        None => return Ok([GraphUnit(path=inspect_incan(source, toolchain)?, root=source.parent())])
        Some(root) =>
            prepared = prepare_graph(root, "debug", FeatureRequest(), substitutes, toolchain)?
            mut paths = prepared.paths + registry_graphs(registry_artifacts(prepared.facets, prepared.request)?)
            if source.name() == "lib.incn":
                standard = standard_graphs(root, "debug", toolchain, paths, rust_facet(root.0, false)?.package)?
                return Ok(paths + standard)
            for facet in prepared.facets:
                if facet.project == root.0 and facet.domain.value() == "target":
                    paths.append(GraphUnit(path=inspect_incan(source, toolchain, unit_natives(facet, prepared.built, prepared.request)?, prepared.interfaces, facet.features, false, unit_loaves(facet, prepared.interfaces)?)?, root=root))
                    standard = standard_graphs(root, "debug", toolchain, paths, rust_facet(root.0, false)?.package)?
                    return Ok(paths + standard)
            return Err("inspection selected no source unit")


def read_records(paths: list[GraphUnit], root: str, toolchain: Toolchain, group: str) -> Result[list[JsonValue], str]:
    """Merge unit documents deterministically, retaining one header and one instance of each identified fact."""
    mut records: list[JsonValue] = []
    mut seen: Dict[str, bool] = {}
    mut header: Dict[str, JsonValue] = {}
    mut languages: list[str] = []
    mut contexts: list[JsonValue] = []
    for unit in paths:
        document = read_graph(unit, toolchain.driver, group)?
        for line in document.split("\n"):
            if line.strip() == "":
                continue
            record = parse(line).map_err((error) => f"{unit.path.0}: {error.message()}")?
            mut key = text(record, "id")
            if text(record, "record") == "header":
                package = record.get("package")
                if unit.package != "" and package is None:
                    return Err(f"{unit.path.0}: graph has no Loaf identity")
                if let Some(value) = package:
                    if unit.package != "" and text(value, "name") != unit.package:
                        return Err(f"{unit.path.0}: graph names a different Loaf")
                    if unit.version != "" and text(value, "version") != unit.version:
                        return Err(f"{unit.path.0}: graph has a different Loaf version")
                if len(header) == 0 or unit.root.0 == root or root.startswith(f"{unit.root.0}/"):
                    header = record.expect_object().map_err((error) => error.message())?
                for language in record.require("languages").map_err((error) => error.message())?.expect_array().map_err((error) => error.message())?:
                    name = language.expect_str().map_err((error) => error.message())?
                    if name not in languages:
                        languages.append(name)
                match record.get("semantic_contexts"):
                    Some(value) =>
                        contexts = contexts + value.expect_array().map_err((error) => error.message())?
                    None => pass
                continue
            if key != "" and key in seen:
                continue
            seen[key] = true
            records.append(record)
    header["root_path"] = JsonValue.string(root)
    header["languages"] = JsonValue.array([JsonValue.string(name) for name in sorted(languages)])
    header["semantic_contexts"] = JsonValue.array(contexts)
    return Ok([JsonValue.object(header)] + records)
