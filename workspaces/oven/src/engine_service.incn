"""
Serve one physical store's engine under the store's lifetime lock: admit clients and carry each client's requests to
a request worker of its own.

The engine settles nothing in this process. Each connected client holds one request worker (`engine_workers.incn`),
which captures and settles that client's requests (`engine_requests.incn`); this loop carries frames between the two
and answers the service's own lifecycle messages. Independent requests therefore progress together, and a request
that takes long holds no other client.
"""

from rust::std::thread import sleep
from rust::std::time import Duration, Instant
from std.fs import Path
from pub::incan_platform.ipc import Listener, listen
from engine_admission import Arrival, Notice, arrivals, notices, start_admission
from engine_channel import Channel, Envelope, deliver, refuse
from engine_endpoint import endpoint, record_endpoint, transport, withdraw_endpoint
from engine_messages import Event, Message
from engine_requests import idle_seconds, service_identity_of, withdraw_stale
from engine_state import Identity, ServiceState
from engine_wire import Refusal, RefusalKind
from engine_workers import Workers
from files import discard_file
from pub::incan_platform.trace import flush as flush_trace


class Session:
    """One welcomed client, the worker connection that settles its requests, and the requests still open on it."""

    pub client: Channel
    # The held worker's socket and this client's connection to it; none before the client's first request.
    pub worker: str = ""
    pub lane: Option[Channel] = None
    pub open: list[bytes] = []
    pub closed: bool = false


pub def serve(arguments: list[str]) -> Result[None, Refusal]:
    """Enter the internal service role in this executable; no standalone engine executable is created."""
    if len(arguments) != 6:
        return Err(
            transport(
                "internal engine requires store directory, store id, profile, service/compiler generations and idle seconds",
            ),
        )
    root, identity = service_identity_of(arguments)?
    return serve_at(root, identity, idle_seconds(arguments[5])?)


pub def serve_at(root: Path, identity: Identity, idle: int = 600) -> Result[None, Refusal]:
    """Hold the store scheduling lock through startup, all client work and final socket withdrawal."""
    selected = endpoint(root, identity)?
    held = Path(selected.lock).try_lock_exclusive().map_err((error) => transport(error.message()))?
    if held is None:
        return Err(transport("another engine owns this store"))
    withdraw_stale(selected.socket)?
    listener = listen(selected.socket, false).map_err(transport)?
    # A caller whose runtime directory names another socket path finds this one through the store; without the
    # record only callers sharing this environment can.
    _ = record_endpoint(root, selected.socket)
    mut state = ServiceState(identity=identity, store=root, last_active=0)
    outcome = event_loop(listener, state, idle)
    withdraw_endpoint(root, selected.socket)
    discard_file(Path(selected.socket))
    return outcome


def event_loop(listener: Listener, mut state: ServiceState, idle: int) -> Result[None, Refusal]:
    """
    Carry frames between welcomed clients and their workers until the service stops or has been idle for `idle` seconds.

    Connections are accepted and welcomed on the admission thread. Nothing here waits for a request to settle, so
    every client's frames move in every turn.
    """
    mut sessions: list[Session] = []
    mut workers = Workers(root=state.store, identity=state.identity)
    announce, arriving = arrivals()
    telling, told = notices()
    admission = start_admission(listener, state.identity, announce, told)
    # Connections the admission thread holds: greeting, or welcomed and not taken here yet.
    mut waiting = 0
    clock = Instant.now()
    # A finished admission thread lost its listener; the service then leaves with that failure.
    while not admission.is_finished():
        now = int(clock.elapsed().as_millis())
        while true:
            match arriving.try_recv():
                Ok(arrival) =>
                    match arrival:
                        Arrival.Entered => waiting += 1
                        Arrival.Left => waiting -= 1
                        Arrival.Welcomed(channel) =>
                            waiting -= 1
                            sessions.append(Session(client=channel))
                Err(_) => break
        if len(sessions) > 0:
            serviced = len(sessions)
            for index in range(len(sessions)):
                mut session = sessions[index]
                service_session(session, state, workers)
                sessions[index] = session
            sessions = [session for session in sessions if not session.closed]
            if len(sessions) < serviced:
                _ = telling.send(Notice.Released(serviced - len(sessions)))
        state.clients = len(sessions) + waiting
        if state.stopping or state.exits(now, idle * 1000):
            break
        sleep(Duration.from_millis(2))
    workers.retire()
    _ = telling.send(Notice.Closing)
    match admission.join():
        Ok(outcome) => return outcome.map_err(transport)
        Err(_) => return Err(transport("engine admission thread panicked"))


def service_session(mut session: Session, mut state: ServiceState, mut workers: Workers) -> None:
    """One failed connection ends only its own session; its worker serves the next client."""
    match carry(session, state, workers):
        Ok(_) => pass
        Err(_) => close_session(session, workers)


def carry(mut session: Session, mut state: ServiceState, mut workers: Workers) -> Result[None, Refusal]:
    """
    Move at most eight ready frames each way.

    1. The client's frames: lifecycle messages are answered here, request messages go to the client's worker.
    2. The worker's frames go to the client while the client has a data credit for them.
    """
    # 1. A frame the worker has no credit for stays unread until the worker acknowledges earlier ones.
    for _turn in range(8):
        if blocked(session.lane) or not session.client.transport.readable().map_err(transport)?:
            break
        frame = session.client.receive()?
        match handle(session, state, workers, frame):
            Err(reason) => refuse(session.client, frame.header.request, reason, "request")?
            Ok(_) => pass
        session.client.acknowledge(frame)?
        if state.stopping:
            return Ok(None)
    # 2. A worker that ended takes its open requests with it, each refused by name.
    match session.lane:
        None => return Ok(None)
        Some(held) =>
            mut lane = held
            outcome = answer(session, lane)
            session.lane = Some(lane)
            match outcome:
                Ok(_) => return Ok(None)
                Err(reason) =>
                    for request in session.open:
                        _ = refuse(session.client, request, transport("the engine's request worker ended"), "request")
                    return Err(reason)


def blocked(lane: Option[Channel]) -> bool:
    """Whether the client's worker has no data credit left for another frame."""
    match lane:
        Some(held) => return held.pending.exhausted()
        None => return false


def answer(mut session: Session, mut lane: Channel) -> Result[None, Refusal]:
    """Carry the worker's ready frames to the client, and close each request its last frame ends."""
    for _turn in range(8):
        if session.client.pending.exhausted() or not lane.transport.readable().map_err(transport)?:
            break
        frame = lane.receive()?
        request = frame.header.request
        match frame.message:
            Message.Ack(_) => pass
            Message.Complete(_) =>
                session.open = [held for held in session.open if held != request]
                deliver(session.client, request, frame.message)?
            Message.Refused(_) =>
                session.open = [held for held in session.open if held != request]
                deliver(session.client, request, frame.message)?
            _ => deliver(session.client, request, frame.message)?
        lane.acknowledge(frame)?
    return Ok(None)


def handle(
    mut session: Session,
    mut state: ServiceState,
    mut workers: Workers,
    frame: Envelope,
) -> Result[None, Refusal]:
    """Answer the service's lifecycle messages; every request message belongs to the client's worker."""
    request = frame.header.request
    match frame.message:
        Message.Ack(_) => return Ok(None)
        Message.Drain(_) =>
            state.draining = true
            return deliver(session.client, request, Message.Event(Event(status="Draining", trace_handle="")))
        Message.Stop(_) =>
            state.stopping = true
            _ = flush_trace()
            return deliver(session.client, request, Message.Event(Event(status="Stopping", trace_handle="")))
        Message.Submit(_) =>
            if state.draining or state.stopping:
                return Err(Refusal(kind=RefusalKind.Draining, detail="engine is draining"))
            session.open.append(request)
            return to_worker(session, workers, frame)
        Message.Resolve(_) => return to_worker(session, workers, frame)
        Message.Cancel(_) => return to_held_worker(session, frame)
        Message.Pin(_) => return to_held_worker(session, frame)
        Message.Release(_) => return to_held_worker(session, frame)
        _ => return Err(Refusal(kind=RefusalKind.Schema, detail="message family has no E1 handler"))


def to_worker(mut session: Session, mut workers: Workers, frame: Envelope) -> Result[None, Refusal]:
    """Carry a request to the client's worker, taking a worker for the client's first one."""
    if session.lane is None:
        socket, lane = workers.take()?
        session.worker = socket
        session.lane = Some(lane)
    return to_held_worker(session, frame)


def to_held_worker(mut session: Session, frame: Envelope) -> Result[None, Refusal]:
    """Carry a message about an earlier request to the worker that holds it."""
    match session.lane:
        None =>
            return Err(Refusal(kind=RefusalKind.Identity, detail="the message names no request or lease of this client"))
        Some(held) =>
            mut lane = held
            sent = deliver(lane, frame.header.request, frame.message)
            session.lane = Some(lane)
            return sent


def close_session(mut session: Session, mut workers: Workers) -> None:
    """
    Close both of the client's connections; the worker then drops the client's requests and reader pins. A worker
    left in the middle of a request is dismissed instead of serving the next client behind that request.
    """
    _ = session.client.transport.close()
    if let Some(lane) = session.lane:
        _ = lane.transport.close()
        if len(session.open) > 0:
            workers.dismiss(session.worker)
        else:
            workers.release(session.worker)
    session.lane = None
    session.open = []
    session.closed = true
