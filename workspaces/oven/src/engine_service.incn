"""Serve disposable engine control state from Oven under the physical store's lifetime lock."""

from rust::std::fs import symlink_metadata
from rust::std::os::unix::fs import FileTypeExt
from rust::std::mem import drop
from rust::std::sync import Arc, Mutex
from rust::std::thread import sleep, spawn
from rust::std::time import Duration, Instant
from std.encoding.hex import hexlify
from std.fs import Path
from pub::incan_platform.ipc import Listener, listen, session_id, stale
from decimal_text import digits_only
from engine_channel import Channel, Envelope, SendOutcome
from engine_endpoint import HANDSHAKE_SECONDS, endpoint, owner_uid, record_endpoint, transport, withdraw_endpoint
from engine_messages import (
    Accepted,
    Cancelled,
    Captured,
    Complete,
    Event,
    Message,
    Refused,
    BindingOutcome,
    CompletionStatus,
    EffectDisposition,
)
from engine_state import Identity, ServiceState
from engine_actions import Pending, Ready, WorkerEvent, ExecutionLease, finish_request
from engine_programs import read_program
from engine_messages import Resolve, Resolution
from engine_messages import Submit
from engine_wire import MAX_PAYLOAD, Refusal, RefusalKind, zero_id
from bakery import forget_verified, verification_entries
from observation import trace
from files import discard_file
from pub::incan_platform.trace import flush as flush_trace
from rust_scheduler import LOWERING_RESERVATION_BYTES, scheduler_jobs, scheduler_memory

const MAX_CLIENTS: int = 16


pub class Client:
    """A client's bounded volatile interests; disconnect releases exactly these reader pins and requests."""

    pub channel: Channel
    pub pending: list[Pending] = []
    pub active: list[ActiveRequest] = []
    pub completed: Arc[Mutex[list[WorkerEvent]]]
    pub pins: list[ExecutionLease] = []
    pub closed: bool = false


pub model ActiveRequest:
    """The identity retained on the event loop while one background request settles."""

    pub request: bytes
    pub token: str


class Greeting:
    """An accepted connection waiting to present its complete initial Hello without blocking other clients."""

    pub channel: Channel
    pub accepted: int


pub def serve(arguments: list[str]) -> Result[None, Refusal]:
    """Enter the internal service role in this executable; no standalone engine executable is created."""
    if len(arguments) != 6:
        return Err(
            transport(
                "internal engine requires store directory, store id, profile, service/compiler generations and idle seconds",
            ),
        )
    root = Path(arguments[0])
    uid = owner_uid(root)?
    identity = Identity(
        store_id=arguments[1],
        profile=arguments[2],
        service_generation=arguments[3],
        compiler_generation=arguments[4],
        uid=uid,
    )
    if arguments[5] == "" or len(arguments[5]) > 9 or not digits_only(arguments[5]) or int(arguments[5]) < 1:
        return Err(transport("engine idle timeout must be positive seconds"))
    return serve_at(root, identity, int(arguments[5]))


pub def serve_at(root: Path, identity: Identity, idle: int = 600) -> Result[None, Refusal]:
    """Hold the store scheduling lock through startup, all client work and final socket withdrawal."""
    selected = endpoint(root, identity)?
    held = Path(selected.lock).try_lock_exclusive().map_err((error) => transport(error.message()))?
    if held is None:
        return Err(transport("another engine owns this store"))
    withdraw_stale(selected.socket)?
    mut listener = listen(selected.socket, false).map_err(transport)?
    # A caller whose runtime directory names another socket path finds this one through the store; without the
    # record only callers sharing this environment can.
    _ = record_endpoint(root, selected.socket)
    mut state = ServiceState(identity=identity, store=root, last_active=0)
    outcome = event_loop(listener, state, idle)
    withdraw_endpoint(root, selected.socket)
    discard_file(Path(selected.socket))
    return outcome


def withdraw_stale(path: str) -> Result[None, Refusal]:
    """Remove only an actual stale socket; ordinary files, symlinks and live endpoints are refused."""
    if not Path(path).exists():
        return Ok(None)
    found = symlink_metadata(path).map_err((error) => transport(str(error)))?
    if not found.file_type().is_socket() or not stale(path):
        return Err(transport("engine endpoint is occupied; refusing to replace it"))
    discard_file(Path(path))
    return Ok(None)


def event_loop(mut listener: Listener, mut state: ServiceState, idle: int) -> Result[None, Refusal]:
    """Poll bounded client state and release it after use; no decoded compilation closure enters this process."""
    mut clients: list[Client] = []
    mut greetings: list[Greeting] = []
    worker_limit = request_pool_size()
    clock = Instant.now()
    while true:
        now = int(clock.elapsed().as_millis())
        match listener.poll().map_err(transport)?:
            Some(connected) =>
                if len(clients) + len(greetings) < MAX_CLIENTS and not state.stopping:
                    greetings.append(Greeting(channel=Channel(transport=connected), accepted=now))
            None => pass
        greetings = greet_ready(greetings, clients, state, now)
        if len(clients) > 0:
            for index in range(len(clients)):
                mut client = clients[index]
                service_client(client, state, worker_limit)
                clients[index] = client
            clients = [client for client in clients if not client.closed or len(client.active) > 0]
        state.clients = len(clients) + len(greetings)
        if state.exits(now, idle * 1000):
            return Ok(None)
        sleep(Duration.from_millis(2))


def greet_ready(greetings: list[Greeting], mut clients: list[Client], state: ServiceState, now: int) -> list[Greeting]:
    """Admit every ready Hello while silent peers wait independently until their bounded handshake expires."""
    mut waiting: list[Greeting] = []
    for index in range(len(greetings)):
        mut greeting = greetings[index]
        if now - greeting.accepted >= int(HANDSHAKE_SECONDS) * 1000:
            _ = greeting.channel.transport.close()
            continue
        match greeting.channel.transport.readable():
            Ok(true) =>
                match greet(greeting.channel, state):
                    Ok(client) => clients.append(client)
                    Err(_) => pass
            Ok(false) => waiting.append(greeting)
            Err(_) => _ = greeting.channel.transport.close()
    return waiting


def greet(initial: Channel, state: ServiceState) -> Result[Client, Refusal]:
    """Authenticate OS credentials and Hello before assigning a fresh nonzero session id."""
    mut channel = initial
    channel.transport.wait_at_most(HANDSHAKE_SECONDS)
    channel.transport.write_at_most(HANDSHAKE_SECONDS)
    first = channel.receive()?
    if first.header.session != zero_id() or first.header.request != zero_id():
        return Err(Refusal(kind=RefusalKind.Identity, detail="initial Hello must have zero identities"))
    match first.message:
        Message.Hello(hello) =>
            peer = channel.transport.peer().map_err(transport)?
            match state.negotiate(hello, peer.uid):
                Err(reason) =>
                    send_refusal(channel, zero_id(), reason, "Hello")?
                    return Err(reason)
                Ok(welcome) =>
                    channel.session = session_id().map_err(transport)?
                    send(channel, zero_id(), Message.Welcome(welcome))?
                    channel.acknowledge(first)?
                    completed: Arc[Mutex[list[WorkerEvent]]] = Arc.new(Mutex.new([]))
                    return Ok(Client(channel=channel, completed=completed))
        _ => return Err(Refusal(kind=RefusalKind.Schema, detail="Hello must be the first engine message"))


def service_client(mut client: Client, mut state: ServiceState, worker_limit: int) -> None:
    """One invalid connection retires only its own interests; other clients retain their requests."""
    mut outcome = settle(client, state, worker_limit)
    if not client.closed:
        outcome = poll_client(client, state, worker_limit)
    match outcome:
        Ok(_) => pass
        Err(_) => close_client(client, state)
    if len(client.pending) == 0 and len(client.active) == 0 and verification_entries() > 0:
        released = verification_entries()
        forget_verified()
        trace(f"engine request released: captures=0 verification={verification_entries()} released={released}")


def poll_client(mut client: Client, mut state: ServiceState, worker_limit: int) -> Result[None, Refusal]:
    """Consume at most eight ready frames, then settle accepted requests within available credits."""
    for _turn in range(8):
        if not client.channel.transport.readable().map_err(transport)?:
            break
        frame = client.channel.receive()?
        match handle(client, state, frame):
            Err(reason) => send_refusal(client.channel, frame.header.request, reason, "request")?
            Ok(_) => pass
        client.channel.acknowledge(frame)?
        if state.stopping:
            return Ok(None)
    return settle(client, state, worker_limit)


def handle(mut client: Client, mut state: ServiceState, frame: Envelope) -> Result[None, Refusal]:
    """Handle E1 controls and drain observations before acknowledging Stop; unsupported execution families refuse."""
    request = frame.header.request
    match frame.message:
        Message.Ack(_) => return Ok(None)
        Message.Submit(submit) => return accept(client, state, request, submit)
        Message.Cancel(cancel) =>
            if cancel.interest_token not in [item.token for item in client.pending]:
                return Err(
                    Refusal(kind=RefusalKind.Identity, detail="interest belongs to another client or is complete"),
                )
            state.detach(request, cancel.interest_token)?
            client.pending = [item for item in client.pending if item.token != cancel.interest_token]
            return send(
                client.channel,
                request,
                Message.Cancelled(
                    Cancelled(interest_token=cancel.interest_token, effects_stopped=EffectDisposition.NoEffects),
                ),
            )
        Message.Pin(pin) =>
            mut found = false
            for held in client.pins:
                if held.token == pin.lease_id and held.snapshot == pin.snapshot and held.handle == pin.allowed_roots:
                    found = true
            if not found:
                return Err(
                    Refusal(
                        kind=RefusalKind.Identity,
                        detail="execution lease does not belong to this caller and result",
                    ),
                )
            return send(client.channel, request, Message.Event(Event(status="Pinned", trace_handle=pin.lease_id)))
        Message.Release(release) =>
            if release.lease_id not in [held.token for held in client.pins]:
                return Err(Refusal(kind=RefusalKind.Identity, detail="reader lease belongs to another client"))
            state.release(release.lease_id)?
            client.pins = [held for held in client.pins if held.token != release.lease_id]
            return send(client.channel, request, Message.Event(Event(status="Released", trace_handle=release.lease_id)))
        Message.Resolve(resolve) =>
            mut outcome = Resolution.NotCommitted
            if read_program(state.store, resolve.transaction).map_err(transport)? is not None:
                outcome = Resolution.Committed
            return send(
                client.channel,
                request,
                Message.Resolve(Resolve(transaction=resolve.transaction, outcome=outcome)),
            )
        Message.Drain(_) =>
            state.draining = true
            return send(client.channel, request, Message.Event(Event(status="Draining", trace_handle="")))
        Message.Stop(_) =>
            state.stopping = true
            _ = flush_trace()
            return send(client.channel, request, Message.Event(Event(status="Stopping", trace_handle="")))
        _ => return Err(Refusal(kind=RefusalKind.Schema, detail="message family has no E1 handler"))


def accept(mut client: Client, mut state: ServiceState, request: bytes, submit: Submit) -> Result[None, Refusal]:
    """Accept work before capture and name its initial store generation; completion publishes the whole request."""
    if len(client.pending) == 4 or client.channel.pending.held() > 4:
        return Err(Refusal(kind=RefusalKind.Busy, detail="client admission window is full"))
    token = f"{hexlify(client.channel.session)}:{hexlify(request)}"
    state.accept(request, submit.requested_roots, token)?
    send(client.channel, request, Message.Accepted(Accepted(capture_token=token, interest_token=token)))?
    client.pending.append(
        Pending(request=request, token=token, submit=submit, producer=state.identity.compiler_generation),
    )
    return Ok(None)


def settle(mut client: Client, mut state: ServiceState, worker_limit: int) -> Result[None, Refusal]:
    """Deliver completed requests, then admit captured work while the host-sized pool has capacity."""
    collect_settled(client, state)?
    mut waiting: list[Pending] = []
    for pending in client.pending:
        if client.channel.pending.exhausted() or state.workers >= worker_limit:
            waiting.append(pending)
            continue
        completed = client.completed.clone()
        request = pending.request
        token = pending.token
        store = state.store
        _ = spawn(() => finish_in_background(completed, store, pending))
        client.active.append(ActiveRequest(request=request, token=token))
        state.workers += 1
    client.pending = waiting
    return Ok(None)


def collect_settled(mut client: Client, mut state: ServiceState) -> Result[None, Refusal]:
    """Move finished outcomes back onto the event loop, preserving replies while client credit is exhausted."""
    if not client.closed and client.channel.pending.exhausted():
        return Ok(None)
    mut completed = match client.completed.lock():
        Err(_) => return Err(transport("engine completion queue is poisoned"))
        Ok(value) => value
    mut settled: list[WorkerEvent] = []
    while true:
        match completed.pop():
            Some(value) => settled.append(value)
            None => break
    drop(completed)
    while len(settled) > 0:
        match settled.pop():
            WorkerEvent.Captured(request, captured) =>
                if not client.closed:
                    send(client.channel, request, Message.Captured(captured))?
            WorkerEvent.Settled(request, token, result) => deliver_settled(client, state, request, token, result)?
    return Ok(None)


def deliver_settled(
    mut client: Client,
    mut state: ServiceState,
    request: bytes,
    token: str,
    result: Result[Ready, str],
) -> Result[None, Refusal]:
    """Publish one worker outcome on its owning client, or only release it after that client disconnected."""
    if not client.closed:
        match result:
            Err(reason) =>
                send_request_refusal(client.channel, state.store, request, transport(reason), "unit-record")?
            Ok(ready) =>
                if ready.console != "":
                    send(
                        client.channel,
                        request,
                        Message.Event(Event(status="Console", trace_handle=ready.console)),
                    )?
                match ready.pin:
                    Some(pin) =>
                        state.pin(pin.token)?
                        client.pins.append(pin)
                    None => pass
                send(client.channel, request, Message.Complete(ready.message))?
    state.detach(request, token)?
    client.active = [active for active in client.active if active.token != token]
    state.workers -= 1
    return Ok(None)


def finish_in_background(completed: Arc[Mutex[list[WorkerEvent]]], store: Path, pending: Pending) -> None:
    """Settle one captured request away from socket polling and return its typed outcome to the event loop."""
    finish_request(store, pending, completed)


def request_pool_size() -> int:
    """Bound concurrent request lowering by host CPUs, configured jobs and the 6 GiB lowering reservation."""
    mut size = scheduler_jobs()
    memory = scheduler_memory() // LOWERING_RESERVATION_BYTES
    if memory < size:
        size = memory
    if size < 1:
        return 1
    return size


def close_client(mut client: Client, mut state: ServiceState) -> None:
    """Drop queued interests and pins; active work remains until its background outcome releases the interest."""
    for pending in client.pending:
        state.detach(pending.request, pending.token)
    for held in client.pins:
        state.release(held.token)
    client.pending = []
    client.pins = []
    client.closed = true


def send(mut channel: Channel, request: bytes, message: Message) -> Result[None, Refusal]:
    """Require an available credit at a handler boundary; admission gates leave room for all replies."""
    match channel.send(request, message)?:
        SendOutcome.Sent(_) => return Ok(None)
        SendOutcome.Blocked =>
            return Err(Refusal(kind=RefusalKind.Credit, detail="engine sender is blocked awaiting credit"))


def send_refusal(mut channel: Channel, request: bytes, reason: Refusal, command: str) -> Result[None, Refusal]:
    """Send a stable refusal code with context; receivers never parse prose to choose their next action."""
    return send(
        channel,
        request,
        Message.Refused(Refused(code=refusal_code(reason.kind), command=command, detail=reason.detail)),
    )


def send_request_refusal(
    mut channel: Channel,
    store: Path,
    request: bytes,
    reason: Refusal,
    command: str,
) -> Result[None, Refusal]:
    """Keep control frames bounded while relaying an exact large diagnostic through the console channel."""
    detail = reason.detail.encode("utf-8")
    body_size = 14 + len(command.encode("utf-8")) + len(detail)
    if body_size <= MAX_PAYLOAD:
        return send_refusal(channel, request, reason, command)
    prefix = store.joinpath("engine/console").joinpath(f"{hexlify(request)}-refusal").0
    Path(f"{prefix}.err")
        .write_text(reason.detail, "utf-8", "strict", None)
        .map_err((error) => transport(f"cannot retain engine refusal: {error.message()}"))?
    send(channel, request, Message.Event(Event(status="Console", trace_handle=prefix)))?
    return send_refusal(
        channel,
        request,
        Refusal(
            kind=reason.kind,
            detail="engine request refused; the full diagnostic was relayed through the console stream",
        ),
        command,
    )


pub def refusal_code(kind: RefusalKind) -> int:
    """The stable v1 refusal discriminants carried by Refused bodies."""
    match kind:
        RefusalKind.BadMagic => return 1
        RefusalKind.Version => return 2
        RefusalKind.Oversized => return 3
        RefusalKind.ShortRead => return 4
        RefusalKind.Reserved => return 5
        RefusalKind.Flags => return 6
        RefusalKind.Schema => return 7
        RefusalKind.Identity => return 8
        RefusalKind.Sequence => return 9
        RefusalKind.Credit => return 10
        RefusalKind.UnsupportedCommand => return 11
        RefusalKind.Busy => return 12
        RefusalKind.Draining => return 13
        RefusalKind.Transport => return 14
