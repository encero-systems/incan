"""
A release signed the way the release workflow signs, for the release signature tests.

OpenSSL 3.6.5 made every key, certificate and signature here, so no fixture depends on Sigstore's services: a
P-384 root and intermediate stand for Fulcio, a P-256 key stands for Rekor, and the leaf certificate carries the release
workflow's identity and GitHub's token issuer in Fulcio's extensions. Each function returns Base64 of its document.
"""

pub const IDENTITY: str = "https://github.com/encero-systems/incan/.github/workflows/release.yml@refs/tags/v0.6.0"
pub const ISSUER: str = "https://token.actions.githubusercontent.com"


pub def archive() -> str:
    """The signed asset."""
    return (
        "Zml4dHVyZSB0b29sY2hhaW4gYXJjaGl2ZSBmb3IgcmVsZWFzZSBzaWduYXR1cmUgdGVzdHMK"    )


