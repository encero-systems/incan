"""Resolve, compare and atomically publish the one oven.lock owned by a root project or a workspace root."""

from std.fs import Path
from std.json import JsonValue
from c_interop import parse_c_targets
from cli_help import refused_option
from features import FeatureRequest
from home_paths import TOOLCHAIN
from intake import ManifestReader, read_digests, read_manifest_snapshot, read_project
from interop_lock import LockInterop, interop_difference, locked_interop
from loaf_local_graph import LocalDemand, LocalFacet, compiled_domain, local_facets, unique
from lock_authority import LockAuthority, lock_authority
from lock_format import (
    DEFAULT_MODE,
    LockDependency,
    LockFeatures,
    LockLoaf,
    LockToolchain,
    OvenLock,
    graph_identity,
    lock_roots,
    read_lock,
    validate_mode,
    write_lock,
)
from json_fields import required_items, required_text
from observation import file_digest, observe, trace
from registry_units import RegistryDemand, RegistryUnit, RegistryUnits
from retained_readings import recall, retain_content
from rust_activation import DependencyDomain
from semver_req import (
    Version,
    compare_versions,
    lower_bound,
    parse_requirement,
    parse_version,
    requirement_matches,
    version_text,
)
from rust_registry import read_registry_units, registry_selection, resolve_registry
from rust_target import target_configuration
from toolchain import load_toolchain, rust_compiler
from unit import discovered_project
from unit_freshness import compiler_fingerprint

# The selection under which a root lock's last no-change reconciliation is retained beside the lock.
const SETTLED_LOCK: str = "incan.oven.settled-lock/3"


pub model LockResult:
    """
    The root identity and mode of a resolved lock, and whether this command published it. A virtual workspace's lock
    is named `workspace` and its directory.
    """

    pub name: str
    pub version: str
    pub mode: str
    pub changed: bool
    # The C interop contracts the lock records; their declared files are identified by bytes, not by a manifest.
    pub interop: int = 0
    # One line for each local requirement whose lower bound is not published, so that bound was not tested (RFC 125).
    pub untested: list[str] = []


pub def locked_report(result: LockResult) -> list[str]:
    """What `oven lock` prints: `locked NAME VERSION (MODE)`, then each untested lower bound."""
    return [f"locked {result.name} {result.version} ({result.mode})"] + result.untested


pub model LockCommand:
    """The path and optional version mode accepted by `oven lock`."""

    pub path: str
    pub mode: str = ""


pub def parse_lock_command(arguments: list[str]) -> Result[LockCommand, str]:
    """Parse `oven lock [--versions MODE] PATH`, defaulting PATH to the current directory."""
    mut command = LockCommand(path=".")
    mut path_seen = false
    mut index = 0
    while index < len(arguments):
        argument = str(arguments[index])
        if argument == "--versions":
            if index + 1 >= len(arguments):
                return Err("`--versions` needs a value")
            command.mode = validate_mode(arguments[index + 1])?
            index += 2
            continue
        if argument.startswith("-"):
            return Err(refused_option(argument))
        if path_seen:
            return Err(f"one PATH is locked at a time; `{argument}` is a second")
        command.path = argument
        path_seen = true
        index += 1
    return Ok(command)


pub def lock_project(command: LockCommand) -> Result[LockResult, str]:
    """
    Resolve and publish the lock of the explicit project, reporting its selected sticky mode: a workspace root's or a
    member's is the workspace's one lock, for every member.
    """
    match root_project(Path(command.path))?:
        None => return Err(f"{command.path}: no root loaf.toml")
        Some(root) =>
            authority = lock_authority(root)?
            request = FeatureRequest()
            return reconcile(authority, root.0, "debug", request, {}, ManifestReader(), command.mode, false, true)


pub def ensure_project_lock(
    path: Path,
    profile: str,
    request: FeatureRequest,
    substitutes: Dict[str, str],
    reader: ManifestReader,
    locked: bool,
) -> Result[None, str]:
    """
    Refresh a run, build or test root's lock silently, or prove `--locked` needs no change.

    1. A lock last reconciled to no change, under the same question, is not resolved again while it and the manifests
       that reconciliation read keep the identities they had.
    2. Otherwise reconcile, and retain a no-change result for the next command.

    The lock is the project's own, or its workspace's when a workspace lists the project (`lock_authority`).
    """
    match root_project(path)?:
        None => return Ok(None)
        Some(root) =>
            # 1. An edit to a source changes nothing a lock is resolved from.
            authority = lock_authority(root)?
            question = settled_question(root.0, profile, request, substitutes, locked)?
            mut lock = ""
            if authority.lock().is_file():
                lock = content_identity(authority.lock())?
            if settled(authority, question, lock)?:
                return Ok(None)
            # 2. Only a no-change result is retained, for the lock bytes it compared against.
            result = reconcile(authority, root.0, profile, request, substitutes, reader, "", locked, true)?
            if not result.changed and result.interop == 0:
                remember_settled(authority, question, reader, lock)
            return Ok(None)


def settled_question(
    selected: str,
    profile: str,
    request: FeatureRequest,
    substitutes: Dict[str, str],
    locked: bool,
) -> Result[str, str]:
    """
    Everything a root's lock is resolved from besides its own manifest and lock: the request, the toolchain and the
    registry closure it ships, and the project the request selects, as one selection.
    """
    toolchain = load_toolchain()?
    closure = observe(Path(toolchain.registry_units))?
    mut parts = [SETTLED_LOCK, TOOLCHAIN, compiler_fingerprint(toolchain)?, toolchain.registry_units_identity]
    parts.append(closure.stamp)
    parts.append(selected)
    parts.append(profile)
    parts.append(",".join(request.features))
    parts.append(f"{request.default_features} {request.all_features} {locked}")
    for name in sorted([key for key in substitutes.keys()]):
        parts.append(f"{name}={substitutes[name]}")
    return Ok("\n".join(parts))


def content_identity(path: Path) -> Result[str, str]:
    """A file's identity by its bytes alone; a restored modification time or an unchanged size hides no edit."""
    return Ok(f"sha256:{file_digest(path)?}")


def settled(authority: LockAuthority, question: str, lock: str) -> Result[bool, str]:
    """
    Whether the lock, whose bytes have identity `lock`, was last reconciled to no change under `question`, and every
    manifest that reconciliation read still has the bytes it read: exactly the manifests the lock is resolved from now.
    """
    if lock == "":
        return Ok(false)
    path = authority.lock()
    match recall(path, question, lock):
        None => return Ok(false)
        Some(value) =>
            mut seen: list[str] = []
            for item in required_items(value, "manifests").unwrap_or([]):
                manifest = Path(required_text(item, "manifest").unwrap_or(""))
                if manifest.0 == "" or not manifest.is_file():
                    return Ok(false)
                if content_identity(manifest)? != required_text(item, "digest").unwrap_or(""):
                    return Ok(false)
                seen.append(manifest.0)
            if sorted(seen) != sorted(authority.manifests()):
                return Ok(false)
            trace(f"lock settled {path.0}")
            return Ok(true)


def remember_settled(authority: LockAuthority, question: str, reader: ManifestReader, lock: str) -> None:
    """
    Retain a no-change reconciliation of the lock with identity `lock` when it read no manifest but those the lock is
    resolved from, the root's and a workspace's members', and they and the lock still hold the bytes it read. A
    project with path dependencies outside its workspace is reconciled every time.
    """
    if lock == "":
        return
    # 1. Every manifest the reader parsed must be one of the authority's, however its path was spelled, with one set
    #    of bytes.
    owned = authority.manifests()
    digests = read_digests(reader)
    mut read: Dict[str, str] = {}
    for spelled in digests.keys():
        match Path(spelled).resolve():
            Err(_) => return
            Ok(resolved) =>
                if resolved.0 not in owned:
                    return
                if resolved.0 in read and read[resolved.0] != digests[spelled]:
                    return
                read[resolved.0] = digests[spelled]
    if len(read) == 0:
        return
    # 2. No manifest the lock is resolved from changed since the reconciliation, and neither did the lock.
    mut manifests: list[JsonValue] = []
    for manifest in owned:
        match content_identity(Path(manifest)):
            Err(_) => return
            Ok(current) =>
                if manifest in read and current != f"sha256:{read[manifest]}":
                    return
                manifests.append(
                    JsonValue.object({"manifest": JsonValue.string(manifest), "digest": JsonValue.string(current)}),
                )
    path = authority.lock()
    match content_identity(path):
        Err(_) => return
        Ok(current) =>
            if current != lock:
                return
    retain_content(path, question, lock, JsonValue.object({"manifests": JsonValue.array(manifests)}))


pub def root_project(path: Path) -> Result[Option[Path], str]:
    """Resolve only the command's root project; dependency roots are never consulted for their own locks."""
    if path.is_dir() and path.joinpath("loaf.toml").is_file():
        return Ok(Some(path.resolve().map_err((error) => f"cannot {error.message()}")?))
    match discovered_project(path)?:
        None => return Ok(None)
        Some(root) => return Ok(Some(root.resolve().map_err((error) => f"cannot {error.message()}")?))


def root_demands(
    authority: LockAuthority,
    selected: str,
    request: FeatureRequest,
    reader: ManifestReader,
) -> Result[list[LocalDemand], str]:
    """
    One root demand for each project the lock resolves: the command's request for the project it selects, and each
    other workspace member with its default features.
    """
    mut demands: list[LocalDemand] = []
    for project in authority.projects:
        mut demand = LocalDemand(project=project, domain=DependencyDomain.Target, features=[], defaults=true)
        if project == selected or not authority.workspace:
            demand = LocalDemand(
                project=project,
                domain=DependencyDomain.Target,
                features=request.features,
                defaults=request.default_features,
                all_features=request.all_features,
            )
        demands.append(compiled_domain(demand, reader)?)
    if len(demands) == 0:
        return Err(f"{authority.root.joinpath("loaf.toml").0}: the workspace lists no member to lock")
    return Ok(demands)


def reconcile(
    authority: LockAuthority,
    selected: str,
    profile: str,
    request: FeatureRequest,
    substitutes: Dict[str, str],
    reader: ManifestReader,
    requested_mode: str,
    locked: bool,
    write: bool,
) -> Result[LockResult, str]:
    """
    Resolve today's local and shipped-unit graph, retain valid pins, then compare or publish the generated lock.

    1. Read and authenticate an existing lock before it can constrain selection.
    2. Choose the explicit mode, else the one the existing lock records under any toolchain, else the default.
    3. Resolve every project of the authority in one graph, with valid existing producer pins, and construct the
       complete format-1 graph.
    4. Refuse a locked change, or publish a changed lock without changing command output.
    """
    root = authority.root
    path = authority.lock()
    mut existing: Option[OvenLock] = None
    if path.is_file():
        existing = Some(read_lock(path)?)
    if locked and existing is None:
        return Err(f"{path.0} is missing; run `oven lock`")
    toolchain = load_toolchain()?
    identity = compiler_fingerprint(toolchain)?
    if locked:
        if let Some(known) = existing:
            if known.toolchain.version != TOOLCHAIN or known.toolchain.identity != identity:
                return Err(
                    f"{path.0} records toolchain {known.toolchain.version} ({known.toolchain.identity}), not {TOOLCHAIN} ({identity}); run `oven lock`",
                )
    mode = selected_mode(existing, requested_mode)
    rustc = rust_compiler(toolchain)
    configuration = target_configuration(rustc)?
    demands = root_demands(authority, selected, request, reader)?
    facets = local_facets(demands[0], configuration, substitutes, reader, demands[1:])?
    refuse_unmanaged_providers(authority.projects + [facet.project for facet in facets], reader)?
    mut registry = read_registry_units(Path(toolchain.registry_units), root.0, reader, false)?
    registry.resolution_mode = mode
    if let Some(known) = existing:
        if keeps_existing(known, requested_mode, mode):
            registry.recorded_bindings = retained_bindings(known, facets, registry.units)?
    selected_units = resolve_registry(registry, facets, profile, authority.projects)?
    mut generated = resolved_lock(authority, mode, identity, configuration.triple, facets, selected_units)?
    mut projects = [(facet_package(facet), facet.project) for facet in facets]
    if root.0 in authority.projects:
        projects = [("", root.0)] + projects
    generated.interop = local_interop(root.0, projects, reader)?
    generated.graph = graph_identity(generated)?
    changed = existing is None or not same_resolution(existing, generated)
    if locked and changed:
        return Err(f"{path.0} would change at {difference(existing, generated)}; run `oven lock`")
    if write and changed:
        write_lock(path, generated)?
        trace(f"lock refreshed {path.0} graph={generated.graph}")
    mut result = LockResult(name="workspace", version=root.name(), mode=mode, changed=changed)
    result.interop = len(generated.interop)
    result.untested = untested_bounds(facets, registry.units, selected_units)?
    for entry in generated.loaves:
        if entry.origin == "root":
            result.name = entry.name
            result.version = entry.version
    return Ok(result)


def refuse_unmanaged_providers(projects: list[str], reader: ManifestReader) -> Result[None, str]:
    """
    RFC 117: an Oven-managed provider satisfies a `provider` requirement, and this toolchain manages none, so a graph
    that declares one is refused by name rather than resolved without it.
    """
    for project in unique(projects):
        intent = read_project(Path(project), reader).map_err((error) => error.message())?.intent
        for wanted in intent.providers:
            manifest = Path(project).joinpath("loaf.toml").0
            return Err(
                f"{manifest}: `dependencies.{wanted.alias}` requires provider `{wanted.provider}` "
                + f"{wanted.version}, and Oven {TOOLCHAIN} manages no providers",
            )
    return Ok(None)


pub def untested_bounds(
    facets: list[LocalFacet],
    published: list[RegistryUnit],
    selected: RegistryUnits,
) -> Result[list[str], str]:
    """
    RFC 125: each local requirement whose lower bound names a version that is not published, with the version locked
    in its place, so the report shows that the bound itself was not tested.
    """
    mut lines: list[str] = []
    for facet in facets:
        for record in facet.registry:
            selection = registry_selection(record)?
            match lower_bound(parse_requirement(selection.requirement)?):
                None => pass
                Some(bound) =>
                    demand = RegistryDemand(selection=selection, domain=facet.domain.value())
                    if not published_version(published, selection.loaf, bound)? and demand.key() in selected.bindings:
                        unit = unit_for(selected.bindings[demand.key()], selected.units)?
                        line = f"untested lower bound: {selection.loaf} {version_text(bound)} is not published; locked {unit.version}"
                        if line not in lines:
                            lines.append(line)
    return Ok(lines)


def published_version(units: list[RegistryUnit], loaf: str, version: Version) -> Result[bool, str]:
    """Whether the registry publishes exactly `version` of `loaf`."""
    for unit in units:
        if unit.loaf == loaf and unit.refusal == "" and compare_versions(parse_version(unit.version)?, version) == 0:
            return Ok(true)
    return Ok(false)


pub def local_interop(
    root: str,
    projects: list[Tuple[str, str]],
    reader: ManifestReader,
) -> Result[list[LockInterop], str]:
    """
    Each local project's `[[interop.c.targets]]` contracts, as `(package, root)` pairs name them: the root's, then each
    path dependency's under its package, every declared file identified by its bytes.
    """
    mut entries: list[LockInterop] = []
    mut seen: list[str] = []
    for package, named in projects:
        project = Path(named).resolve().map_err((error) => f"{named}: {error.message()}")?.0
        if project in seen:
            continue
        seen.append(project)
        for entry in project_interop(Path(project), reader)?:
            mut scoped = entry
            if project != root:
                scoped.package = package
            entries.append(scoped)
    return Ok(entries)


def project_interop(root: Path, reader: ManifestReader) -> Result[list[LockInterop], str]:
    """
    One manifest's `[[interop.c.targets]]` contracts. Only the `[interop]` table is read here, so a project of any
    kind, a Rust facet's included, locks as before.
    """
    snapshot = read_manifest_snapshot(root, reader).map_err((error) => error.message())?
    manifest = root.joinpath("loaf.toml").0
    table = snapshot.parsed.as_table().map_err((error) => f"{manifest}: {error.message()}")?
    targets = parse_c_targets(table, manifest).map_err((error) => error.message())?
    return locked_interop(root.0, targets)


pub def selected_mode(existing: Option[OvenLock], requested: str) -> str:
    """
    Use an explicit mode, otherwise keep the mode an existing lock records, under any toolchain, so nothing switches
    it back quietly (RFC 125); a project without a lock takes the default.
    """
    if requested != "":
        return requested
    if let Some(known) = existing:
        return known.mode
    return DEFAULT_MODE


def keeps_existing(existing: OvenLock, requested: str, mode: str) -> bool:
    """Retain still-valid producers unless an explicit mode change requests another selection."""
    return requested == "" or existing.mode == mode


def retained_bindings(
    lock: OvenLock,
    facets: list[LocalFacet],
    units: list[RegistryUnit],
) -> Result[list[Tuple[str, str]], str]:
    """Keep each prior root producer that exists and still satisfies the current requirement and feature demand."""
    available = [unit.entry for unit in units]
    mut bindings: list[Tuple[str, str]] = []
    for facet in facets:
        for request in facet.registry:
            selection = registry_selection(request)?
            for entry in lock.loaves:
                if entry.origin != "toolchain" or entry.name != selection.loaf or entry.entry not in available:
                    continue
                if (
                    not requirement_matches(parse_requirement(selection.requirement)?, parse_version(entry.version)?)
                    or not locked_features_cover(entry, facet.domain.value(), selection.features)
                ):
                    continue
                binding = (facet.domain.value(), entry.entry)
                if binding not in bindings:
                    bindings.append(binding)
    return Ok(bindings)


def locked_features_cover(entry: LockLoaf, domain: str, requested: list[str]) -> bool:
    """Whether one prior compiled entry's recorded domain contains every currently requested feature."""
    for features in entry.features:
        if features.domain == domain and len([name for name in requested if name not in features.enabled]) == 0:
            return true
    return false


def resolved_lock(
    authority: LockAuthority,
    mode: str,
    identity: str,
    target: str,
    facets: list[LocalFacet],
    registry: RegistryUnits,
) -> Result[OvenLock, str]:
    """Project the selected local and compiled registry graph into format 1, then seal its semantic identity."""
    mut loaves: list[LockLoaf] = []
    for facet in facets:
        loaves.append(local_entry(authority, facet, facets, registry, target)?)
    for unit in registry.units:
        loaves.append(toolchain_entry(unit, registry.units, facets, registry.bindings, target)?)
    mut lock = OvenLock(
        format=1,
        mode=mode,
        graph="",
        toolchain=LockToolchain(version=TOOLCHAIN, identity=identity),
        loaves=loaves,
    )
    lock.graph = graph_identity(lock)?
    return Ok(lock)


def local_entry(
    authority: LockAuthority,
    facet: LocalFacet,
    facets: list[LocalFacet],
    registry: RegistryUnits,
    target: str,
) -> Result[LockLoaf, str]:
    """
    Record one root, workspace member or path facet with every active local and registry edge. A workspace's root
    project is the lock's root; each other member is a `member`, with its path from the workspace root.
    """
    root = authority.root
    mut dependencies: list[LockDependency] = []
    for edge in facet.local:
        child = facet_for(edge.project, edge.domain, facets)?
        dependencies.append(
            LockDependency(key=edge.alias, loaf=child.package, version=child.version, domain=edge.domain.value()),
        )
    for index in range(len(facet.registry)):
        selection = registry_selection(facet.registry[index])?
        demand = RegistryDemand(selection=selection, domain=facet.domain.value())
        if demand.key() not in registry.bindings:
            return Err(f"locked registry selection is absent for {selection.loaf}")
        unit = unit_for(registry.bindings[demand.key()], registry.units)?
        dependencies.append(
            LockDependency(
                key=facet.registry_aliases[index],
                loaf=unit.loaf,
                version=unit.version,
                domain=facet.domain.value(),
                entry=unit.entry,
            ),
        )
    mut origin = "path"
    mut path = relative_path(root, Path(facet.project))
    if facet.project in authority.projects:
        origin = "member"
    if facet.project == root.0 and facet.project in authority.projects:
        origin = "root"
        path = ""
    return Ok(
        LockLoaf(
            name=facet.package,
            version=facet.version,
            origin=origin,
            path=path,
            dependencies=dependencies,
            features=[
                LockFeatures(
                    target=target,
                    domain=facet.domain.value(),
                    requested=facet.requested,
                    enabled=facet.features,
                ),
            ],
        ),
    )


pub def toolchain_entry(
    unit: RegistryUnit,
    units: list[RegistryUnit],
    facets: list[LocalFacet],
    bindings: Dict[str, str],
    target: str,
) -> Result[LockLoaf, str]:
    """Record one selected shipped unit, the source digest its closure records, and its exact dependency entries."""
    mut dependencies: list[LockDependency] = []
    for dependency in unit.dependencies:
        child = unit_for(dependency, units)?
        dependencies.append(
            LockDependency(
                key=dependency_key(child),
                loaf=child.loaf,
                version=child.version,
                domain=dependency_domain(unit, child),
                entry=child.entry,
            ),
        )
    return Ok(
        LockLoaf(
            name=unit.loaf,
            version=unit.version,
            origin="toolchain",
            registry=unit.registry,
            checksum=unit.source_digest,
            entry=unit.entry,
            dependencies=dependencies,
            features=[
                LockFeatures(
                    target=target,
                    domain=unit.domain,
                    requested=registry_requests(unit.entry, facets, bindings)?,
                    enabled=unit.features,
                ),
            ],
        ),
    )


def dependency_domain(parent: RegistryUnit, child: RegistryUnit) -> str:
    """Select the host domain only for a procedural-macro edge; every other edge follows its producer."""
    if child.kind == "proc-macro":
        return "host"
    return parent.domain


def registry_requests(entry: str, facets: list[LocalFacet], bindings: Dict[str, str]) -> Result[list[str], str]:
    """Union explicit feature requests whose root binding selected one compiled entry."""
    mut requested: list[str] = []
    for facet in facets:
        for value in facet.registry:
            selection = registry_selection(value)?
            demand = RegistryDemand(selection=selection, domain=facet.domain.value())
            if demand.key() in bindings and bindings[demand.key()] == entry:
                requested = unique(requested + selection.features)
    return Ok(requested)


def facet_for(project: str, domain: DependencyDomain, facets: list[LocalFacet]) -> Result[LocalFacet, str]:
    """Find the exact local facet an active edge reaches."""
    for facet in facets:
        if facet.project == project and facet.domain == domain:
            return Ok(facet)
    return Err(f"locked local facet is absent: {project}@{domain.value()}")


def unit_for(entry: str, units: list[RegistryUnit]) -> Result[RegistryUnit, str]:
    """Find one selected compiled unit by its producer entry."""
    for unit in units:
        if unit.entry == entry:
            return Ok(unit)
    return Err(f"locked toolchain entry is absent: {entry}")


def dependency_key(unit: RegistryUnit) -> str:
    """Give a transitive compiled edge its published crate name, or its Loaf's final segment."""
    if unit.name != "":
        return unit.name
    return unit.loaf.split("/")[-1].replace("-", "_")


def relative_path(root: Path, selected: Path) -> str:
    """Spell a local Loaf relative to the lock directory without retaining an absolute checkout path."""
    base = root.0.split("/")
    target = selected.0.split("/")
    mut common = 0
    while common < len(base) and common < len(target) and base[common] == target[common]:
        common += 1
    parts = [".." for _ in range(len(base) - common)] + target[common:]
    if len(parts) == 0:
        return "."
    return "/".join(parts)


def same_resolution(existing: Option[OvenLock], generated: OvenLock) -> bool:
    """Compare semantic graph, mode and format independently of generated table order."""
    if let Some(known) = existing:
        return known.format == generated.format and known.mode == generated.mode and known.graph == generated.graph
    return false


def difference(existing: Option[OvenLock], generated: OvenLock) -> str:
    """Name the first user-actionable lock dimension that changed."""
    if let Some(known) = existing:
        if known.toolchain != generated.toolchain:
            return f"toolchain {known.toolchain.version} -> {generated.toolchain.version}"
        if known.mode != generated.mode:
            return f"version mode {known.mode} -> {generated.mode}"
        interop = interop_difference(known.interop, generated.interop)
        if interop != "":
            return interop
        known_roots = lock_roots(known)
        generated_roots = lock_roots(generated)
        if known_roots != generated_roots:
            if len(known_roots) > 1 or len(generated_roots) > 1:
                return "a workspace member or one of its dependency edges"
            return "the root Loaf or one of its dependency edges"
        return "the resolved dependency graph"
    return "the missing lock"


def facet_package(facet: LocalFacet) -> str:
    """The package name a local project's lock facts are keyed by: its declared name, else its directory's."""
    if facet.package != "":
        return facet.package
    return Path(facet.project).name()
