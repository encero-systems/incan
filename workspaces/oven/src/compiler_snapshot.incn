"""
Stage leased compiler snapshot descriptors in the owner's physical bakery before worker activation, under the owner
home's own view of that bakery.
"""

from std.fs import Path
from std.encoding.hex import hexlify
from std.primitives.hash import sha256
from home_paths import BAKERY_OVERRIDE, BakeryLocation
from owner_endpoint import prepare_directory
from home_views import home_view
from pub::incan_platform.store import Snapshot, begin, commit, lease_token, put, snapshot as placed_snapshot
from pub::incan_platform.store import store_identity
from pub::incan_worker_host.record_snapshot import (
    SnapshotHandle,
    canonical_roots,
    encode_snapshot_record,
    snapshot_record_key,
)
from store_path_conversion import store_path


pub class StagedSnapshot:
    """A descriptor digest whose exact source view and publication stay leased until the owner drops this value."""

    pub digest: str
    pub authority: Path
    selected: Snapshot
    published: Snapshot

    @staticmethod
    pub def retained(digest: str, authority: Path, selected: Snapshot, published: Snapshot) -> StagedSnapshot:
        """Retain both leases only after the descriptor and home binding are fully published."""
        return StagedSnapshot(digest=digest, authority=authority, selected=selected, published=published)


pub def stage_selected_snapshot(
    home: Path, workers: Path, location: BakeryLocation, store: Path, selected: Snapshot,
    allowed_roots: list[str], format_profile: str,
) -> Result[StagedSnapshot, str]:
    """Bind the worker to this invocation's physical bakery without rebinding the configured home."""
    selected_path = location.path.resolve().map_err((error) => error.message())?
    engine_path = store.resolve().map_err((error) => error.message())?
    if selected_path.0 != engine_path.0:
        return Err("compiler snapshot store differs from the invocation's selected bakery")
    if location.source != BAKERY_OVERRIDE:
        return stage_snapshot(home, store, selected, allowed_roots, format_profile)
    root = store_path(store)
    if selected.root.placement != root.placement or selected.root.value != root.value:
        return Err("compiler snapshot belongs to another physical store")
    identity = store_identity(root).map_err((error) => error.message())?
    # A worker authority belongs to one home and one selected physical store. No locator enters activation messages.
    parts = [home.0, engine_path.0, identity]
    key = hexlify(sha256.digest("".join([str(len(part)) + ":" + part for part in parts]).encode("utf-8")))
    authority = workers.joinpath("snapshot-authorities").joinpath(key)
    prepare_directory(workers.0)?
    prepare_directory(authority.parent().0)?
    prepare_directory(authority.0)?
    return stage_snapshot(authority, store, selected, allowed_roots, format_profile)


pub def stage_snapshot(
    home: Path,
    store: Path,
    selected: Snapshot,
    allowed_roots: list[str],
    format_profile: str,
) -> Result[StagedSnapshot, str]:
    """
    Stage one content-named `SnapshotHandle` in the owner home's own view of that physical bakery.

    The returned value keeps the target revision and descriptor publication leased across `Prepare` or `Evaluate`;
    the worker receives only its digest and independently resolves `<home>/bakery.view`.
    """
    root = store_path(store)
    if selected.root.placement != root.placement or selected.root.value != root.value:
        return Err("compiler snapshot belongs to another physical store")
    if selected.generation < 1 or selected.index == "" or selected.pin is None:
        return Err("compiler snapshot must name a leased nonempty view")
    roots = canonical_roots(allowed_roots)?
    identity = store_identity(root).map_err((error) => error.message())?
    handle = SnapshotHandle(
        store_id=identity,
        generation=selected.generation,
        manifest=selected.digest,
        view=selected.view,
        view_revision=selected.index,
        allowed_roots=roots,
        lease=lease_token(selected),
        format_profile=format_profile,
    )
    encoded = encode_snapshot_record(handle)?
    digest = hexlify(sha256.digest(encoded))
    view = home_view(home, store, identity)?
    home_snapshot = placed_snapshot(root, view).map_err((error) => error.message())?
    published = commit(put(begin(home_snapshot), snapshot_record_key(digest), encoded)).map_err(
        (error) => error.message(),
    )?
    return Ok(StagedSnapshot.retained(digest, home, selected, published))
