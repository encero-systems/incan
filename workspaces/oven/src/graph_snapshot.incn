"""Content-addressed graph snapshots, independent of query and presentation options."""

from files import json_text
from std.fs import Path
from std.json import JsonValue
from graph_cache import GraphUnit, save_observations, stamp_file, tree_inputs
from observation import Ledger, SETTLE_SECONDS, load_ledger
from unit_freshness import fingerprint


pub def snapshot_identity(units: list[GraphUnit], root: str, strict: bool) -> Result[str, str]:
    """
    Hash exact exports and anchor roots, including unchecked notes, in deterministic order.

    Published Loaves identify their published facts; an unbuilt edit to their source does not change that artifact.
    Source-backed units have already been refreshed against current inputs by the ordinary inspection preparation.

    1. Load artifact observations owned by the requesting project, shared across consumer homes.
    2. Retain each unit's exported digest and source root.
    3. Include current source observations for every distinct source root.
    4. Save artifact observations and hash the same sorted inputs under the snapshot schema.
    """
    # 1. Different homes can reuse artifact digests without writing into dependencies or toolchain artifacts.
    mut ledger = artifact_observations(root)
    # 2. Exported artifacts and their anchors identify the represented graph facts.
    mut parts: list[str] = []
    mut sources: list[str] = []
    for unit in units:
        coordinates = [unit.root.0, unit.package, unit.version, ledger.digest(stamp_file(unit))?]
        parts.append(json_text(JsonValue.array([JsonValue.string(item) for item in coordinates]))?)
        if unit.source_root != "" and unit.source_root not in sources:
            sources.append(unit.source_root)
    # 3. Source edits expire a source-backed snapshot even when its graph facts do not change.
    for source in sorted(sources):
        parts.append(fingerprint(tree_inputs(Path(source))?)?)
    # 4. Observations only avoid hashing unchanged bytes; their metadata never enters the identity.
    save_observations(ledger)
    return Ok(f"snapshot:{fingerprint(["incan.graph.snapshot/1", root, str(strict)] + sorted(parts))?}")


pub def artifact_observations(root: str) -> Ledger:
    """Keep optional artifact digest observations in the caller's cache; missing storage still hashes exact bytes."""
    mut owner = Path(root)
    if owner.is_file():
        owner = owner.parent()
    cache = owner.joinpath("target").joinpath("incan").joinpath("codegraph")
    return load_ledger(cache.joinpath("snapshot-observations.json"), SETTLE_SECONDS, "")


pub def snapshot_status(expected: str, current: str) -> JsonValue:
    """Compare a retained export with current facts without interpreting an unavailable input as fresh."""
    return JsonValue.object(
        {"record": JsonValue.string("snapshot_status"), "expected": JsonValue.string(expected), "snapshot_id": JsonValue.string(
            current,
        ), "stale": JsonValue.bool(expected != current)},
    )
