"""Stop the records engine owning the run 69 home Bakery."""

from std.fs import Path
from engine_client import service_identity
from engine_endpoint import connect_with
from engine_messages import Message, Stop
from engine_wire import zero_id
from observation import observe
from unit_freshness import fingerprint


def main() -> Result[None, str]:
    store = Path("/Volumes/Builds/incan-dev9-work/memory/home/bakery")
    binary = "/Volumes/Builds/incan-dev9-work/memory/lane/run33/repo/workspaces/oven/target/incan/release/bin/oven"
    mut identity = service_identity(store)?
    identity.service_generation = fingerprint([binary, observe(Path(binary))?.stamp])?
    mut channel = connect_with(store, identity, binary).map_err((error) => error.detail)?
    _ = channel.send(zero_id(), Message.Stop(Stop(reason="run 69 matched Oven handoff"))).map_err((error) => error.detail)?
    reply = channel.receive().map_err((error) => error.detail)?
    match reply.message:
        Message.Event(value) =>
            if value.status != "Stopping":
                return Err(f"records engine answered Stop with {value.status}")
        _ => return Err("records engine did not acknowledge Stop")
    _ = channel.transport.close()
    return Ok(None)
