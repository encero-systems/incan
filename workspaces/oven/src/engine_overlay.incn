"""
Overlay requests (14.1): an editor's unsaved buffer reaches the records engine through an editor view.

Each project view has one editor view, forked on the first overlay request and never merged back. The editor's buffer
and the program's other editable files are mirrored into an overlay root beside the store, outside the bakery whose
files capture never re-reads, so the engine captures the overlay exactly as it would a build, with the same logical
names and therefore the same unit keys. The engine checks the overlay's entry, and the compiler's JSON report answers
with its diagnostics in document coordinates.
"""

from std.fs import Path
from std.json import JsonValue, parse
from intake import ManifestReader, entry_source
from unit_freshness import fingerprint

# The prefix of every editor view, which the producer recognizes to keep the overlay's records in that view.
pub const EDITOR_VIEW_PREFIX: str = "editor-"


pub model OverlayDiagnostic:
    """One compiler diagnostic in document coordinates: its message, document and one-based start and end."""

    pub message: str
    pub path: str
    pub line: int
    pub column: int
    pub severity: str
    pub code: str = ""
    pub end_line: int = 0
    pub end_column: int = 0


pub def editor_view_name(project_view: str) -> Result[str, str]:
    """The one editor view of a project view."""
    return Ok(EDITOR_VIEW_PREFIX + fingerprint(["incan.editor-view/1", project_view])?)


pub def is_editor_view(view: str) -> bool:
    """Whether a view holds an editor's overlay requests."""
    return view.startswith(EDITOR_VIEW_PREFIX)


pub def program_root(document: Path) -> Path:
    """The program an editor's document belongs to: the nearest directory with `loaf.toml`, else its own directory."""
    mut directory = document.parent()
    while directory.0.startswith("/") and directory.0 != "/":
        if directory.joinpath("loaf.toml").is_file():
            return directory
        directory = directory.parent()
    return document.parent()


pub def overlay_entry(document: Path, text: Option[str] = None) -> Result[Path, str]:
    """
    The program an overlay of `document` checks: its package's entry; for a manifest-free document, itself when it
    declares a top-level `main`, else the `main.incn` beside it when there is one, else itself. `text` is the
    document's unsaved buffer; without one the file is read.
    """
    program = program_root(document)
    if program.joinpath("loaf.toml").is_file():
        if let Some(entry) = entry_source(program, ManifestReader())?:
            return Ok(entry)
        return Ok(document)
    conventional = program.joinpath("main.incn")
    if conventional.0 == document.0 or not conventional.is_file():
        return Ok(document)
    mut source = ""
    match text:
        Some(buffer) => source = buffer
        None => source = document.read_text("utf-8", "strict").map_err((error) => f"{document.0}: {error.message()}")?
    if declares_main(source):
        return Ok(document)
    return Ok(conventional)


def declares_main(source: str) -> bool:
    """Whether a source declares a top-level `main` function."""
    for line in source.split("\n"):
        if line.startswith("def main(") or line.startswith("pub def main("):
            return true
    return false


pub def mirror_overlay(program: Path, overlay: Path, document: str, buffer: str) -> Result[int, str]:
    """
    Mirror `program`'s editable files into `overlay` with `buffer` in place of `document` (a path relative to
    `program`), and remove mirrored files the program no longer has. Returns how many files were written; a file whose
    bytes already match is left as it is, so an unchanged buffer leaves the overlay's metadata unchanged too.
    """
    mut written = mirror_directory(program, overlay, "", document)?
    if write_if_changed(overlay.joinpath(document), buffer.encode("utf-8"))?:
        written += 1
    remove_absent(program, overlay, "", document)?
    return Ok(written)


def mirror_directory(source: Path, destination: Path, relative: str, document: str) -> Result[int, str]:
    """Mirror one directory's files, leaving out the document, build output and hidden entries."""
    mut written = 0
    for entry in source.iterdir().map_err((error) => f"cannot list {source.0}: {error.message()}")?:
        name = entry.name()
        if name.startswith(".") or name == "target":
            continue
        mut path = name
        if relative != "":
            path = f"{relative}/{name}"
        if entry.is_dir():
            written += mirror_directory(entry, destination.joinpath(name), path, document)?
        elif entry.is_file() and path != document:
            content = entry.read_bytes().map_err((error) => f"cannot read {entry.0}: {error.message()}")?
            if write_if_changed(destination.joinpath(name), content)?:
                written += 1
    return Ok(written)


def remove_absent(source: Path, destination: Path, relative: str, document: str) -> Result[None, str]:
    """
    Remove mirrored files and directories the program no longer has; the document always stays. What the mirror leaves
    out is never mirrored, so it is the overlay's own: its build output and hidden entries stay too.
    """
    if not destination.is_dir():
        return Ok(None)
    for entry in destination.iterdir().map_err((error) => f"cannot list {destination.0}: {error.message()}")?:
        name = entry.name()
        if name.startswith(".") or name == "target":
            continue
        mut path = name
        if relative != "":
            path = f"{relative}/{name}"
        if path == document:
            continue
        original = source.joinpath(name)
        if entry.is_dir():
            if original.is_dir():
                remove_absent(original, entry, path, document)?
            elif not document.startswith(path + "/"):
                entry.remove_tree().map_err((error) => f"cannot remove {entry.0}: {error.message()}")?
        elif not original.is_file():
            entry.unlink().map_err((error) => f"cannot remove {entry.0}: {error.message()}")?
    return Ok(None)


def write_if_changed(path: Path, content: bytes) -> Result[bool, str]:
    """Write `content` at `path` unless the file already holds exactly those bytes."""
    if path.is_file():
        current = path.read_bytes().map_err((error) => f"cannot read {path.0}: {error.message()}")?
        if current == content:
            return Ok(false)
    path.parent().mkdir(true, true).map_err((error) => f"cannot create {path.parent().0}: {error.message()}")?
    path.write_bytes(content).map_err((error) => f"cannot write {path.0}: {error.message()}")?
    return Ok(true)


pub def report_diagnostics(report: str, overlay: str, program: str) -> Result[list[OverlayDiagnostic], str]:
    """
    The diagnostics of the compiler's JSON check report, each on the editor's path for its document: a file under the
    `overlay` root is named under `program` instead.
    """
    document = parse(report).map_err((error) => f"the check answered no report ({error.message()})")?
    entries = document.require("diagnostics").map_err((error) => error.message())?.expect_array().map_err(
        (error) => error.message(),
    )?
    mut found: list[OverlayDiagnostic] = []
    for entry in entries:
        mut diagnostic = OverlayDiagnostic(
            message=text_field(entry, "message"),
            path="",
            line=1,
            column=1,
            severity=text_field(entry, "severity"),
            code=text_field(entry, "code"),
        )
        if let Some(span) = entry.get("primary_span"):
            diagnostic.path = document_path(text_field(span, "file"), overlay, program)
            if let Some(start) = span.get("start"):
                diagnostic.line = int_field(start, "line", 1)
                diagnostic.column = int_field(start, "column", 1)
            if let Some(end) = span.get("end"):
                diagnostic.end_line = int_field(end, "line", diagnostic.line)
                diagnostic.end_column = int_field(end, "column", diagnostic.column)
        found.append(diagnostic)
    return Ok(found)


def document_path(path: str, overlay: str, program: str) -> str:
    """The editor's path of a file the check named under the overlay root."""
    if path.startswith(overlay + "/"):
        return program + path[len(overlay):]
    return path


def text_field(value: JsonValue, name: str) -> str:
    """One string field of a report entry, or an empty string."""
    if let Some(found) = value.get(name):
        if let Ok(text) = found.expect_str():
            return text
    return ""


def int_field(value: JsonValue, name: str, fallback: int) -> int:
    """One integer field of a report entry, or `fallback`."""
    if let Some(found) = value.get(name):
        if let Ok(number) = found.expect_int():
            return number
    return fallback
