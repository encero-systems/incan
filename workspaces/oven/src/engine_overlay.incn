"""
Overlay requests (14.1): an editor's unsaved buffer reaches the records engine through an editor view.

Each project view has one editor view, forked on the first overlay request and never merged back. The editor's buffer
and the program's other editable files are mirrored into an overlay root beside the store, outside the bakery whose
files capture never re-reads, so the engine captures the overlay exactly as it would a build, with the same logical
names and therefore the same unit keys. The engine checks the overlay's entry, and the compiler's JSON report answers
with its diagnostics in document coordinates.
"""

from std.fs import Path
from observation import FileMetadata, SETTLE_SECONDS, file_metadata, trace
from publication import publish_binary
from std.json import JsonValue, parse
from intake import ManifestReader, entry_source
from unit_freshness import fingerprint

# The prefix of every editor view, which the producer recognizes to keep the overlay's records in that view.
pub const EDITOR_VIEW_PREFIX: str = "editor-"


pub model OverlayDiagnostic:
    """One compiler diagnostic in document coordinates: its message, document and one-based start and end."""

    pub message: str
    pub path: str
    pub line: int
    pub column: int
    pub severity: str
    pub code: str = ""
    pub end_line: int = 0
    pub end_column: int = 0
    pub preparation_stop: bool = false


pub def editor_view_name(project_view: str) -> Result[str, str]:
    """The one editor view of a project view."""
    return Ok(EDITOR_VIEW_PREFIX + fingerprint(["incan.editor-view/1", project_view])?)


pub def is_editor_view(view: str) -> bool:
    """Whether a view holds an editor's overlay requests."""
    return view.startswith(EDITOR_VIEW_PREFIX)


pub def program_root(document: Path) -> Path:
    """The program an editor's document belongs to: the nearest directory with `loaf.toml`, else its own directory."""
    mut directory = document.parent()
    while directory.0.startswith("/") and directory.0 != "/":
        if directory.joinpath("loaf.toml").is_file():
            return directory
        directory = directory.parent()
    return document.parent()


pub def overlay_entry(document: Path, text: Option[str] = None) -> Result[Path, str]:
    """
    The program an overlay of `document` checks: its package's entry; for a manifest-free document, itself when it
    declares a top-level `main`, else the `main.incn` beside it when there is one, else itself. `text` is the
    document's unsaved buffer; without one the file is read.
    """
    program = program_root(document)
    if program.joinpath("loaf.toml").is_file():
        if let Some(entry) = entry_source(program, ManifestReader())?:
            return Ok(entry)
        return Ok(document)
    conventional = program.joinpath("main.incn")
    if conventional.0 == document.0 or not conventional.is_file():
        return Ok(document)
    mut source = ""
    match text:
        Some(buffer) => source = buffer
        None => source = document.read_text("utf-8", "strict").map_err((error) => f"{document.0}: {error.message()}")?
    if declares_main(source):
        return Ok(document)
    return Ok(conventional)


def declares_main(source: str) -> bool:
    """Whether a source declares a top-level `main` function."""
    for line in source.split("\n"):
        if line.startswith("def main(") or line.startswith("pub def main("):
            return true
    return false


pub model MirroredFile:
    """The exact pair of filesystem generations whose contents the mirror compared."""

    pub source: FileMetadata
    pub destination: FileMetadata


pub model OverlayMirror:
    """The open editor connection's metadata for one mirrored project. Source bytes stay in the overlay files."""

    pub root: str = ""
    pub files: Dict[str, Option[MirroredFile]] = {}
    pub read_files: int = 0
    pub read_bytes: int = 0


pub def mirror_overlay(program: Path, overlay: Path, document: str, buffer: str) -> Result[int, str]:
    """Mirror a standalone request without carrying any observations to a later connection."""
    mut state = OverlayMirror()
    return mirror_into(state, program, overlay, document, buffer)


pub def mirror_into(
    mut state: OverlayMirror,
    program: Path,
    overlay: Path,
    document: str,
    buffer: str,
    siblings: Dict[str, str] = {},
) -> Result[int, str]:
    """Reconcile disk generations and the current editor snapshot in the same mirror."""
    root = program.0 + "\n" + overlay.0
    if state.root != root:
        state.files = {}
        state.root = root
    state.read_files = 0
    state.read_bytes = 0
    mut buffers = {path: siblings[path] for path in siblings.keys()}
    buffers[document] = buffer
    mut virtual_directories: set[str] = set()
    for path in buffers.keys():
        # An unsaved buffer never stands in for a verified disk-to-mirror comparison.
        if path in state.files:
            state.files[path] = None
        mut parent = Path(path).parent()
        while parent.0 not in ["", "."] and parent.0 not in virtual_directories:
            virtual_directories.add(parent.0)
            parent = parent.parent()
    mut written = mirror_directory(state, program, overlay, "", buffers)?
    for path in buffers.keys():
        if write_if_changed(overlay.joinpath(path), buffers[path].encode("utf-8"))?:
            written += 1
    remove_absent(program, overlay, "", buffers, virtual_directories)?
    trace(f"overlay mirror read {state.read_files} disk sources, {state.read_bytes} source bytes, wrote {written} files")
    return Ok(written)


def mirror_directory(
    mut state: OverlayMirror,
    source: Path,
    destination: Path,
    relative: str,
    buffers: Dict[str, str],
) -> Result[int, str]:
    """Mirror one directory, observing each source entry once and opening only files whose generations changed."""
    mut written = 0
    for entry in source.iterdir().map_err((error) => f"cannot {error.message()}")?:
        name = entry.name()
        if name.startswith(".") or name == "target":
            continue
        mut path = name
        if relative != "":
            path = f"{relative}/{name}"
        if path in buffers:
            continue
        if let Some(before) = file_metadata(entry)?:
            if before.is_directory():
                written += mirror_directory(state, entry, destination.joinpath(name), path, buffers)?
            elif before.is_file():
                if mirror_file(state, entry, destination.joinpath(name), path, before)?:
                    written += 1
    return Ok(written)


def mirror_file(mut state: OverlayMirror, source: Path, destination: Path, key: str, before: FileMetadata) -> Result[bool, str]:
    """Reuse a settled source only while both observed generations still agree with the verified copy."""
    if let Some(Some(previous)) = state.files.get(key):
        if previous.source == before and file_metadata(destination)? == Some(previous.destination):
            return Ok(false)
    if key in state.files:
        state.files[key] = None
    settled = before.settled(SETTLE_SECONDS)
    content = source.read_bytes().map_err((error) => f"cannot {error.message()}")?
    state.read_files += 1
    state.read_bytes += len(content)
    written = write_if_changed(destination, content)?
    if settled and file_metadata(source)? == Some(before):
        if let Some(after) = file_metadata(destination)?:
            if key in state.files or len(state.files) < 8192:
                state.files[key] = Some(MirroredFile(source=before, destination=after))
    return Ok(written)


def remove_absent(
    source: Path,
    destination: Path,
    relative: str,
    buffers: Dict[str, str],
    virtual_directories: set[str],
) -> Result[None, str]:
    """
    Remove stale mirror files and directories unless an open document still needs them. The overlay owns its build
    output and hidden entries.
    """
    if not destination.is_dir():
        return Ok(None)
    for entry in destination.iterdir().map_err((error) => f"cannot {error.message()}")?:
        name = entry.name()
        if name.startswith(".") or name == "target":
            continue
        mut path = name
        if relative != "":
            path = f"{relative}/{name}"
        if path in buffers:
            continue
        original = source.joinpath(name)
        if entry.is_dir():
            if original.is_dir() or path in virtual_directories:
                remove_absent(original, entry, path, buffers, virtual_directories)?
            else:
                entry.remove_tree().map_err((error) => f"cannot {error.message()}")?
        elif not original.is_file():
            entry.unlink().map_err((error) => f"cannot {error.message()}")?
    return Ok(None)


def write_if_changed(path: Path, content: bytes) -> Result[bool, str]:
    """Write `content` at `path` unless the file already holds exactly those bytes."""
    if path.is_file():
        current = path.read_bytes().map_err((error) => f"cannot {error.message()}")?
        if current == content:
            return Ok(false)
    path.parent().mkdir(true, true).map_err((error) => f"cannot {error.message()}")?
    publish_binary(path, content)?
    return Ok(true)


pub def preparation_stop_report(stopped: OverlayDiagnostic) -> Result[str, str]:
    """Use the ordinary check-report console for a typed stop that occurred before a compiler could run."""
    entry = JsonValue.object({
        "preparation_stop": JsonValue.bool(stopped.preparation_stop),
        "code": JsonValue.string(stopped.code),
        "message": JsonValue.string(stopped.message),
        "severity": JsonValue.string(stopped.severity),
        "primary_span": JsonValue.object({"file": JsonValue.string(stopped.path)}),
    })
    return JsonValue.object({"diagnostics": JsonValue.array([entry])}).to_json().map_err((error) => error.message())


pub def report_diagnostics(

    report: str,
    overlay: str,
    program: str,
    requesting: str = "",
) -> Result[list[OverlayDiagnostic], str]:
    """
    Project one check report in authored coordinates. When an editor requests a document, summarize the imported
    modules that failed its check so the editor can report the cause on the requesting document too.
    """
    document = parse(report).map_err((error) => f"the check answered no report ({error.message()})")?
    entries = document.require("diagnostics").map_err((error) => error.message())?.expect_array().map_err(
        (error) => error.message(),
    )?
    mut found: list[OverlayDiagnostic] = []
    mut imported: set[str] = set()
    for entry in entries:
        mut diagnostic = OverlayDiagnostic(
            message=text_field(entry, "message"),
            path="",
            line=1,
            column=1,
            severity=text_field(entry, "severity"),
            code=text_field(entry, "code"),
            preparation_stop=entry.get("preparation_stop").unwrap_or(JsonValue.null()).as_bool().unwrap_or(false),
        )
        if let Some(span) = entry.get("primary_span"):
            diagnostic.path = document_path(text_field(span, "file"), overlay, program)
            if let Some(start) = span.get("start"):
                diagnostic.line = int_field(start, "line", 1)
                diagnostic.column = int_field(start, "column", 1)
            if let Some(end) = span.get("end"):
                diagnostic.end_line = int_field(end, "line", diagnostic.line)
                diagnostic.end_column = int_field(end, "column", diagnostic.column)
        if requesting != "" and diagnostic.path not in ["", requesting] and diagnostic.severity == "error":
            if diagnostic.code != "INCAN-T0134":
                imported.add(diagnostic.path)
        found.append(diagnostic)
    for path in sorted([path for path in imported]):
        found.append(
            OverlayDiagnostic(
                message=f"imported module {path} has errors; open it for details",
                path=requesting,
                severity="error",
                line=1,
                column=1,
                end_line=1,
                end_column=1,
            ),
        )
    return Ok(found)


def document_path(path: str, overlay: str, program: str) -> str:
    """The editor's path of a file the check named under the overlay root."""
    if path.startswith(overlay + "/"):
        return program + path[len(overlay):]
    return path


def text_field(value: JsonValue, name: str) -> str:
    """One string field of a report entry, or an empty string."""
    if let Some(found) = value.get(name):
        if let Ok(text) = found.expect_str():
            return text
    return ""


def int_field(value: JsonValue, name: str, fallback: int) -> int:
    """One integer field of a report entry, or `fallback`."""
    if let Some(found) = value.get(name):
        if let Ok(number) = found.expect_int():
            return number
    return fallback
