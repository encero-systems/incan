"""
Which collected tests a run selects and in what order: `-k` keyword and `-m` marker expressions, slow tests and a
seeded shuffle. An expression combines terms with `and`, `or`, `not` and parentheses, as 0.5.1 and pytest spell them.
Before a module is compiled, a `-k` expression can already rule it out: its tests' identifiers are known up to the
case ids a parametrized test adds, and an expression false for every completion of them selects none of its tests.
"""

from rust::std::time import SystemTime, UNIX_EPOCH

# The multiplier, increment and modulus of the shuffle's linear congruential sequence; products stay within `int`.
const MULTIPLIER: int = 1103515245
const INCREMENT: int = 12345
const MODULUS: int = 2147483648


pub def keyword_matches(expression: str, identifier: str) -> Result[bool, str]:
    """Whether a `-k` expression selects a test: each term matches a case-insensitive part of its identifier."""
    truth = evaluate(expression, "-k", Terms(subjects=[identifier.lower()], substring=true))?
    return Ok(truth == Truth.Yes)


pub def keyword_may_select(expression: str, identifiers: list[str], open: bool) -> Result[bool, str]:
    """
    Whether a `-k` expression may select a test of a module that is not compiled yet, from the identifiers its
    declarations give its tests. With `open`, a test's identifier may continue past what is known of it, as a
    parametrized case's `[ids]` do, so a term absent from the known part is undecided rather than unmatched.
    """
    for identifier in identifiers:
        truth = evaluate(expression, "-k", Terms(subjects=[identifier.lower()], substring=true, open=open))?
        if truth != Truth.No:
            return Ok(true)
    return Ok(false)


pub def markers_match(expression: str, markers: list[str]) -> Result[bool, str]:
    """Whether a `-m` expression selects a test: each term names one of its markers exactly."""
    truth = evaluate(expression, "-m", Terms(subjects=markers, substring=false))?
    return Ok(truth == Truth.Yes)


enum Truth(str):
    """An expression's value for a test whose identifier may be only partly known, in three-valued logic."""

    No = "no"
    Undecided = "undecided"
    Yes = "yes"


model Terms:
    """What an expression's terms are matched against: a test's subjects, each term a part of one or one exactly."""

    subjects: list[str]
    substring: bool
    # Whether each subject may continue past its known text, so a term absent from that text is undecided.
    open: bool = false


model Parsed:
    """A parsed part of an expression: its value for the test and the index of the token after it."""

    value: Truth
    next: int


def evaluate(expression: str, option: str, terms: Terms) -> Result[Truth, str]:
    """Evaluate one expression over a test's subjects; an empty expression selects every test."""
    tokens = tokenize(expression)
    if len(tokens) == 0:
        return Ok(Truth.Yes)
    parsed = disjunction(tokens, 0, terms).map_err((reason) => f"`{option}` {reason}")?
    if parsed.next != len(tokens):
        return Err(f"`{option}` expression has an unexpected `{tokens[parsed.next]}`")
    return Ok(parsed.value)


def tokenize(expression: str) -> list[str]:
    """Split an expression into terms, operators and parentheses."""
    mut tokens: list[str] = []
    mut current = ""
    for character in expression:
        if character in ["(", ")", " ", "\t"]:
            if current != "":
                tokens.append(current)
                current = ""
            if character in ["(", ")"]:
                tokens.append(character)
        else:
            current += character
    if current != "":
        tokens.append(current)
    return tokens


def disjunction(tokens: list[str], start: int, terms: Terms) -> Result[Parsed, str]:
    """`A or B ...`, every operand evaluated so a malformed later operand is still refused."""
    mut parsed = conjunction(tokens, start, terms)?
    while parsed.next < len(tokens) and tokens[parsed.next] == "or":
        operand = conjunction(tokens, parsed.next + 1, terms)?
        parsed = Parsed(value=either(parsed.value, operand.value), next=operand.next)
    return Ok(parsed)


def conjunction(tokens: list[str], start: int, terms: Terms) -> Result[Parsed, str]:
    """`A and B ...`."""
    mut parsed = negation(tokens, start, terms)?
    while parsed.next < len(tokens) and tokens[parsed.next] == "and":
        operand = negation(tokens, parsed.next + 1, terms)?
        parsed = Parsed(value=both(parsed.value, operand.value), next=operand.next)
    return Ok(parsed)


def negation(tokens: list[str], start: int, terms: Terms) -> Result[Parsed, str]:
    """`not A`, a parenthesized expression or one term."""
    if start >= len(tokens):
        return Err("expression ends where a term is expected")
    token = tokens[start]
    if token == "not":
        operand = negation(tokens, start + 1, terms)?
        return Ok(Parsed(value=negated(operand.value), next=operand.next))
    if token == "(":
        inner = disjunction(tokens, start + 1, terms)?
        if inner.next >= len(tokens) or tokens[inner.next] != ")":
            return Err("expression has an unclosed `(`")
        return Ok(Parsed(value=inner.value, next=inner.next + 1))
    if token in [")", "and", "or"]:
        return Err(f"expression has an unexpected `{token}`")
    return Ok(Parsed(value=term_value(token, terms), next=start + 1))


def term_value(term: str, terms: Terms) -> Truth:
    """
    One term's value: it matches a case-insensitive part of a subject, or a subject exactly; otherwise it is undecided
    while a subject may continue past its known text.
    """
    for subject in terms.subjects:
        if terms.substring and term.lower() in subject:
            return Truth.Yes
        if not terms.substring and term == subject:
            return Truth.Yes
    if terms.open:
        return Truth.Undecided
    return Truth.No


def negated(value: Truth) -> Truth:
    """`not`: an undecided value stays undecided."""
    if value == Truth.Yes:
        return Truth.No
    if value == Truth.No:
        return Truth.Yes
    return Truth.Undecided


def both(left: Truth, right: Truth) -> Truth:
    """`and`: false when either side is, true when both are."""
    if left == Truth.No or right == Truth.No:
        return Truth.No
    if left == Truth.Yes and right == Truth.Yes:
        return Truth.Yes
    return Truth.Undecided


def either(left: Truth, right: Truth) -> Truth:
    """`or`: true when either side is, false when both are."""
    if left == Truth.Yes or right == Truth.Yes:
        return Truth.Yes
    if left == Truth.No and right == Truth.No:
        return Truth.No
    return Truth.Undecided


pub def shuffle_seed(requested: Option[int]) -> int:
    """The requested seed, or one taken from the clock so each unseeded shuffle differs."""
    match requested:
        Some(seed) => return seed
        None => pass
    match SystemTime.now().duration_since(UNIX_EPOCH):
        Ok(elapsed) => return int(elapsed.subsec_nanos()) % MODULUS
        Err(_) => return 0


pub def shuffled(count: int, seed: int) -> list[int]:
    """A permutation of `0..count` that depends only on `seed`: a Fisher-Yates shuffle over a seeded sequence."""
    mut order = [index for index in range(count)]
    mut state = seed % MODULUS
    mut index = count - 1
    while index > 0:
        state = (state * MULTIPLIER + INCREMENT) % MODULUS
        other = state % (index + 1)
        held = order[index].clone()
        order[index] = order[other]
        order[other] = held
        index -= 1
    return order
