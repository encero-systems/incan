"""RFC 125 registry roots, delegated signing keys and signed statements."""

from std.encoding.hex import unhexlify
from registry_trust import Key, KeyKind, Signature, StatementKind, delegate, pin, verify_statement

const REGISTRY: str = "0073f8c44b82ef7f3f0fd95558bfe9261e8500a2de9e214bc1983cad43c57a67"
const ROOT_KEY: str = "c84248d610c216a70ac930c7cbf36b3a3c8c84f8aa9472ca522344f5360d5b85"
const DELEGATED_KEY: str = "cd62abd5b7a3f6364e2e2693485f589b77da3fef5b2a1b6a0d6e0f969865a23b"
const DELEGATION_SIGNATURE: str = "17f7acc196e7e1e35c1330d66297b78ab31de54c6a56b841f1c7ca5e615a1a47d64605f0d88b1e1527563f20b1a9afa35fefcc3c3019f912567fcb3810792f07"
const STATEMENT_SIGNATURE: str = "2961d41c64c5efba3893c948551347968816c96e8698f9af43854464959fa00b920705dc0a26abd2e74df605b80186ebafcb30984152a4f8b85667f1a7bd7808"


def octets(text: str) -> Result[bytes, str]:
    """Decode one hexadecimal fixture value."""
    return unhexlify(text).map_err((error) => error.message())


def key(text: str) -> Result[Key, str]:
    """Build an Ed25519 registry key."""
    return Ok(Key(kind=KeyKind.Ed25519, material=octets(text)?))


def signature(text: str) -> Result[Signature, str]:
    """Build an Ed25519 registry signature."""
    return Ok(Signature(raw=octets(text)?, r=b"", s=b""))


def changed(value: bytes) -> bytes:
    """Return a same-sized byte string with its last bit changed."""
    mut result: list[u8] = []
    for byte in value:
        result.append(byte.wrapping_resize())
    last = len(result) - 1
    result[last] = result[last] ^ 1
    return result


pub def test_a_pinned_root_delegates_the_key_that_signs_registry_statements() -> Result[None, str]:
    """The root-key digest is the registry identity; its delegated key signs an index statement."""
    root = pin(REGISTRY, key(ROOT_KEY)?)?
    trust = delegate(root, key(DELEGATED_KEY)?, signature(DELEGATION_SIGNATURE)?)?
    verified = verify_statement(
        trust,
        StatementKind.Index,
        7,
        b"catalog entry",
        signature(STATEMENT_SIGNATURE)?,
    )?
    assert verified.registry == REGISTRY
    assert verified.sequence == 7
    assert verified.kind == StatementKind.Index
    return Ok(None)


pub def test_registry_identity_delegation_and_statement_tampering_are_refused() -> Result[None, str]:
    """A false pin, changed root authorization, changed payload or changed registry signature is refused."""
    root_key = key(ROOT_KEY)?
    match pin("sha256:another-registry", root_key):
        Ok(_) => return Err("a false registry pin was admitted")
        Err(reason) => assert reason == "the registry root key does not match its pinned identity"
    root = pin(REGISTRY, key(ROOT_KEY)?)?
    altered_delegation = Signature(raw=changed(octets(DELEGATION_SIGNATURE)?), r=b"", s=b"")
    match delegate(root, key(DELEGATED_KEY)?, altered_delegation):
        Ok(_) => return Err("a changed root delegation was admitted")
        Err(reason) => assert reason == "the registry root did not authorize its signing key"
    trust = delegate(pin(REGISTRY, key(ROOT_KEY)?)?, key(DELEGATED_KEY)?, signature(DELEGATION_SIGNATURE)?)?
    match verify_statement(trust, StatementKind.Index, 7, b"changed catalog entry", signature(STATEMENT_SIGNATURE)?):
        Ok(_) => return Err("a changed registry statement was admitted")
        Err(reason) => assert reason == "the registry statement signature does not verify"
    changed_signature = Signature(raw=changed(octets(STATEMENT_SIGNATURE)?), r=b"", s=b"")
    assert verify_statement(trust, StatementKind.Index, 7, b"catalog entry", changed_signature).is_err()
    return Ok(None)
