"""Sealed sets preserve identities, share contents, refuse damage and admit without selecting a namespace."""

from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import file_digest, sha256
from std.io import BytesIO, Endian, IoError
from scratch import scratch_directory
from segment_store import EXPECT_ABSENT, Snapshot, begin, commit, get, payload_path, put, put_payload, snapshot, read_counts
from sealed_set import ExternalReference, Profile, Record, SetSpec, admit, export_set, mapped_value, record_key, readmit, verify


pub def test_sealed_sets_are_canonical_shared_idempotent_and_checked() -> Result[None, str]:
    """
    Sealed contents have one portable representation and one admission path for packages and bundles.

    1. Equal snapshots with different histories export identical bytes.
    2. Two owners share value and payload bytes while retaining separate record identities.
    3. A repeat import leaves the entire store inventory unchanged and selects no namespace.
    4. Damaged objects and identity conflicts refuse admission without publication.
    """
    scratch = scratch_directory()?
    base = scratch.path()
    profile = Profile(identity="test/1", schema="bytes/1", codec="raw/1")
    source = base.joinpath("source")
    other = base.joinpath("other")
    payload_file = base.joinpath("native-file")
    payload_file.write_bytes(b"shared native file").map_err((error) => error.message())?
    payload = put_payload(source, payload_file).map_err((error) => error.message())?
    assert put_payload(other, payload_file).map_err((error) => error.message())? == payload
    first = write_value(source, "entry", b"shared value")?
    write_value(other, "unrelated", b"history")?
    second = write_value(other, "entry", b"shared value")?
    spec = specification(profile, "package-one", [payload])
    left = base.joinpath("left")
    right = base.joinpath("right")

    # 1. Local generations, unselected records and physical segment layouts never enter the exported identity.
    root = export_set(first, spec, left).map_err((error) => error.message())?
    assert export_set(second, spec, right).map_err((error) => error.message())? == root
    assert inventory(left)? == inventory(right)?
    verify(left, root, profile).map_err((error) => error.message())?

    # 2. Ownership remains separate even when all the value bytes are shared.
    home = base.joinpath("home")
    admitted = admit(home, left, root, profile).map_err((error) => error.message())?
    payloads_before = inventory(home.joinpath("payloads"))?
    other_spec = specification(profile, "package-two", [payload])
    other_set = base.joinpath("other-set")
    other_root = export_set(second, other_spec, other_set).map_err((error) => error.message())?
    both = admit(home, other_set, other_root, profile).map_err((error) => error.message())?
    assert root != other_root
    left_key = record_key(spec, spec.records[0]).map_err((error) => error.message())?
    right_key = record_key(other_spec, other_spec.records[0]).map_err((error) => error.message())?
    assert left_key != right_key
    assert get(both, left_key).map_err((error) => error.message())? != None
    assert get(both, right_key).map_err((error) => error.message())? != None
    prove_mapped_value(both, spec, payload)?
    assert inventory(home.joinpath("payloads"))? == payloads_before
    bundle_spec = specification(profile, "toolchain-bundle", [payload])
    bundle = base.joinpath("bundle")
    bundle_root = export_set(second, bundle_spec, bundle).map_err((error) => error.message())?
    bundled = admit(home, bundle, bundle_root, profile).map_err((error) => error.message())?
    assert bundled.generation > both.generation
    assert inventory(home.joinpath("payloads"))? == payloads_before

    # 3. The import receipt is available, but an existing plan selection stays untouched.
    selected = commit(put(begin(bundled), "plan/selected", b"previous", EXPECT_ABSENT)).map_err(
        (error) => error.message(),
    )?
    before = inventory(home)?
    repeated = admit(home, left, root, profile).map_err((error) => error.message())?
    assert repeated.generation == selected.generation
    assert inventory(home)? == before
    assert get(repeated, "plan/selected").map_err((error) => error.message())? == Some(b"previous")
    assert get(admitted, "plan/selected").map_err((error) => error.message())? == None
    println(
        f"S2 sealed admission: origins=3 retained_payload_bytes={payload_bytes(home.joinpath("payloads"))?} repeat_growth_bytes=0 repeat_manifest_writes=0",
    )
    prove_frozen_readmission(base, left, root, profile, payload)?
    prove_overlap(base, source, spec, left, root)?
    prove_external_membership(base, source, spec, left, root)?

    # 4. Damage and invalid identities are errors before any publication.
    prove_refusals(base, source, first, spec, left, home, root, payload)?
    assert inventory(home)? == before
    return Ok(None)


def prove_mapped_value(view: Snapshot, spec: SetSpec, other_digest: str) -> Result[None, str]:
    """Map an exact revision while copying only its envelope, and refuse a different selected value digest."""
    key = record_key(spec, spec.records[0]).map_err((error) => error.message())?
    envelope = get(view, key).map_err((error) => error.message())?.unwrap_or(b"")
    value_digest = hexlify(sha256.digest(b"shared value"))
    before = read_counts().decoded
    mapped = mapped_value(view, spec, spec.records[0], value_digest).map_err((error) => error.message())?
    assert read_counts().decoded - before == len(envelope)
    assert mapped.to_bytes() == b"shared value"
    match mapped_value(view, spec, spec.records[0], other_digest):
        Ok(_) => assert false, "a different value digest was accepted for an admitted revision"
        Err(_) => pass
    return Ok(None)


def prove_refusals(
    base: Path,
    source: Path,
    view: Snapshot,
    spec: SetSpec,
    left: Path,
    home: Path,
    root: str,
    payload: str,
) -> Result[None, str]:
    """Refuse damaged metadata, content and indexes, incompatible codecs and immutable identity conflicts."""
    before = inventory(home)?
    profile = spec.profile
    manifest = left.joinpath("manifest.json")
    original = manifest.read_bytes().map_err((error) => error.message())?
    manifest.write_bytes(b"damaged").map_err((error) => error.message())?
    match admit(home, left, root, profile):
        Ok(_) =>
            assert false, "a damaged manifest was admitted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert inventory(home)? == before
    manifest.write_bytes(original).map_err((error) => error.message())?
    payload_file = left.joinpath("payloads").joinpath(payload)
    payload_bytes = payload_file.read_bytes().map_err((error) => error.message())?
    payload_file.chmod(false).map_err((error) => error.message())?
    payload_file.write_bytes(b"damaged payload").map_err((error) => error.message())?
    match admit(home, left, root, profile):
        Ok(_) =>
            assert false, "a damaged payload was admitted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert inventory(home)? == before
    payload_file.write_bytes(payload_bytes).map_err((error) => error.message())?
    prove_manifest_length(left, root, profile, payload, len(payload_bytes))?
    payload_file.unlink().map_err((error) => error.message())?
    payload_file.symlink_to(base.joinpath("native-file")).map_err((error) => error.message())?
    match verify(left, root, profile):
        Ok(_) =>
            assert false, "a symlinked payload was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    payload_file.unlink().map_err((error) => error.message())?
    payload_file.write_bytes(payload_bytes).map_err((error) => error.message())?
    incompatible = Profile(identity=profile.identity, schema=profile.schema, codec="unsupported/2")
    match verify(left, root, incompatible):
        Ok(_) =>
            assert false, "an unsupported required codec was accepted"
        Err(error) =>
            assert error.kind == "format", error.message()
    changed = write_value(source, "entry", b"conflicting bytes")?
    conflict = base.joinpath("conflict")
    conflict_root = export_set(changed, spec, conflict).map_err((error) => error.message())?
    match admit(home, conflict, conflict_root, profile):
        Ok(_) =>
            assert false, "one immutable revision accepted different values"
        Err(error) =>
            assert error.kind == "conflict", error.message()
    assert inventory(home)? == before
    prove_dependencies(base, view, spec, left, root)?
    prove_invalid_selections(base, view, spec)?
    installed = payload_path(home, payload)
    saved = installed.read_bytes().map_err((error) => error.message())?
    installed.chmod(false).map_err((error) => error.message())?
    installed.write_bytes(b"damaged installed object").map_err((error) => error.message())?
    damaged = inventory(home)?
    match admit(home, left, root, profile):
        Ok(_) =>
            assert false, "a repeated import hid installed payload damage"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert inventory(home)? == damaged
    installed.write_bytes(saved).map_err((error) => error.message())?
    installed.chmod(true).map_err((error) => error.message())?
    index = left.joinpath("index.seg")
    index.write_bytes(b"damaged index").map_err((error) => error.message())?
    match verify(left, root, profile):
        Ok(_) =>
            assert false, "a damaged index was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    return Ok(None)


def prove_dependencies(base: Path, view: Snapshot, spec: SetSpec, original: Path, root: str) -> Result[None, str]:
    """A dependency is an exact admitted set root, never an unresolved or recursively embedded closure."""
    mut dependent = spec
    dependent.origin = "consumer"
    dependent.dependencies = [root]
    directory = base.joinpath("dependent")
    digest = export_set(view, dependent, directory).map_err((error) => error.message())?
    empty = base.joinpath("missing-dependency")
    match admit(empty, directory, digest, spec.profile):
        Ok(_) =>
            assert false, "a missing external set was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert not empty.exists()
    home = base.joinpath("dependencies-home")
    admit(home, original, root, spec.profile).map_err((error) => error.message())?
    assert admit(home, directory, digest, spec.profile).map_err((error) => error.message())?.generation > 0
    return Ok(None)


def prove_overlap(base: Path, source: Path, spec: SetSpec, original: Path, root: str) -> Result[None, str]:
    """A partially overlapping import writes only the missing envelope, its content and the new membership receipt."""
    view = write_value(source, "extra", b"new contents")?
    mut expanded = spec
    expanded.records.append(Record(key="extra", revision="one", payloads=[], references=["entry"]))
    directory = base.joinpath("expanded")
    digest = export_set(view, expanded, directory).map_err((error) => error.message())?
    mut reordered = expanded
    reordered.records = [expanded.records[1], expanded.records[0]]
    reordered_directory = base.joinpath("reordered")
    assert export_set(view, reordered, reordered_directory).map_err((error) => error.message())? == digest
    assert inventory(directory)? == inventory(reordered_directory)?
    home = base.joinpath("overlap-home")
    first = admit(home, original, root, spec.profile).map_err((error) => error.message())?
    objects_before = len(inventory(home.joinpath("payloads"))?)
    second = admit(home, directory, digest, spec.profile).map_err((error) => error.message())?
    assert len(second.segments) == len(first.segments) + 1
    assert segment_count(second, second.segments[len(second.segments) - 1])? == 2
    assert len(inventory(home.joinpath("payloads"))?) == objects_before + 1
    before = inventory(home)?
    repeated = admit(home, directory, digest, spec.profile).map_err((error) => error.message())?
    assert repeated.generation == second.generation
    assert inventory(home)? == before
    return Ok(None)


def prove_manifest_length(directory: Path, root: str, profile: Profile, payload: str, length: int) -> Result[None, str]:
    """A correctly hashed manifest still refuses an inconsistent object length."""
    path = directory.joinpath("manifest.json")
    original = path.read_text("utf-8", "strict").map_err((error) => error.message())?
    changed = original.replace(f"[\"{payload}\",{length}]", f"[\"{payload}\",{length + 1}]")
    assert changed != original
    path.write_bytes(changed.encode("utf-8")).map_err((error) => error.message())?
    changed_root = hexlify(sha256.digest(changed.encode("utf-8")))
    match verify(directory, changed_root, profile):
        Ok(_) =>
            assert false, "an inconsistent object length was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    path.write_bytes(original.encode("utf-8")).map_err((error) => error.message())?
    verify(directory, root, profile).map_err((error) => error.message())?
    return Ok(None)


def prove_invalid_selections(base: Path, view: Snapshot, spec: SetSpec) -> Result[None, str]:
    """Duplicate identities, path-bearing payload names and missing record closure members cannot be exported."""
    mut duplicate = spec
    duplicate.records.append(spec.records[0])
    match export_set(view, duplicate, base.joinpath("duplicate")):
        Ok(_) =>
            assert false, "a duplicate record key was exported"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    mut escaped = spec
    escaped.records = [Record(key="entry", revision="one", payloads=["../outside"], references=[])]
    match export_set(view, escaped, base.joinpath("escaped")):
        Ok(_) =>
            assert false, "a path-bearing payload name was exported"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    mut incomplete = spec
    incomplete.records = [Record(key="entry", revision="one", payloads=[], references=["missing"])]
    match export_set(view, incomplete, base.joinpath("incomplete")):
        Ok(_) =>
            assert false, "a missing record reference was exported"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    return Ok(None)


def specification(profile: Profile, origin: str, payloads: list[str] = []) -> SetSpec:
    """One selected revision, with its exact namespace root and immutable source receipt."""
    return SetSpec(
        profile=profile,
        origin=origin,
        producer="test-producer",
        receipt="source-publication",
        records=[Record(key="entry", revision="revision-one", payloads=payloads, references=[])],
        namespaces=["entry"],
        dependencies=[],
    )


def write_value(root: Path, key: str, value: bytes) -> Result[Snapshot, str]:
    """Write one source record through the store's public transaction boundary."""
    view = snapshot(root).map_err((error) => error.message())?
    return commit(put(begin(view), key, value)).map_err((error) => error.message())


def inventory(directory: Path, prefix: str = "") -> Result[list[str], str]:
    """Sorted relative filenames and full digests, so a no-op cannot hide any new or changed file."""
    if not directory.is_dir():
        return Ok([])
    mut entries: list[str] = []
    for entry in directory.iterdir().map_err((error) => error.message())?:
        name = prefix + entry.name()
        if entry.is_dir():
            entries.extend(inventory(entry, name + "/")?)
        else:
            digest = hexlify(file_digest(entry, "sha256").map_err((error) => error.message())?)
            entries.append(f"{name} {digest}")
    return Ok(sorted(entries))


def segment_count(view: Snapshot, digest: str) -> Result[int, str]:
    """Count retained frames from the segment header, independently of the snapshot's descriptor representation."""
    path = view.root.joinpath("segments").joinpath(f"{digest}.seg")
    reader = BytesIO(path.read_bytes().map_err((error) => error.message())?)
    reader.seek(8, 0).map_err((error) => error.message())?
    count: Result[u64, IoError] = reader.read(Endian.Little)
    return Ok(int(count.map_err((error) => error.message())?))


def prove_external_membership(
    base: Path,
    source: Path,
    dependency: SetSpec,
    original: Path,
    root: str,
) -> Result[None, str]:
    """An external target must belong to the exact supplying set; availability alone cannot authorize admission."""
    profile = dependency.profile
    target = record_key(dependency, dependency.records[0]).map_err((error) => error.message())?
    external = ExternalReference(
        set_root=root,
        key=target,
        revision="revision-one",
        value=hexlify(sha256.digest(b"shared value")),
    )
    view = write_value(source, "consumer", b"consumer")?
    consumer = SetSpec(
        profile=profile,
        origin="consumer",
        producer="test",
        receipt="receipt",
        namespaces=["consumer"],
        dependencies=[root],
        records=[Record(key="consumer", revision="one", payloads=[], references=[], external=[external])],
    )
    directory = base.joinpath("external-set")
    selected = export_set(view, consumer, directory).map_err((error) => error.message())?
    home = base.joinpath("external-home")
    match admit(home, directory, selected, profile):
        Ok(_) =>
            assert false, "an unadmitted dependency was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    admit(home, original, root, profile).map_err((error) => error.message())?
    admitted = admit(home, directory, selected, profile).map_err((error) => error.message())?
    before = inventory(home)?
    assert admit(home, directory, selected, profile).map_err((error) => error.message())?.digest == admitted.digest
    assert inventory(home)? == before
    # The same target supplied by another receipt keeps its logical identity and immutable envelope.
    mut alternate = dependency
    alternate.receipt = "other receipt"
    alternate_directory = base.joinpath("alternate-dependency")
    alternate_root = export_set(view, alternate, alternate_directory).map_err((error) => error.message())?
    admit(home, alternate_directory, alternate_root, profile).map_err((error) => error.message())?
    mut transported = consumer
    transported.dependencies = [alternate_root]
    transported.records[0].external = [
        ExternalReference(set_root=alternate_root, key=target, revision="revision-one", value=external.value),
    ]
    transport_directory = base.joinpath("alternate-consumer")
    transport_root = export_set(view, transported, transport_directory).map_err((error) => error.message())?
    overlap = admit(home, transport_directory, transport_root, profile).map_err((error) => error.message())?
    assert segment_count(overlap, overlap.segments[len(overlap.segments) - 1])? == 1
    # An unrelated set cannot vouch for an available record, even with the same key spelling and value.
    mut unrelated = dependency
    unrelated.origin = "unrelated-owner"
    unrelated_directory = base.joinpath("unrelated-dependency")
    unrelated_root = export_set(view, unrelated, unrelated_directory).map_err((error) => error.message())?
    admit(home, unrelated_directory, unrelated_root, profile).map_err((error) => error.message())?
    transported.dependencies = [unrelated_root]
    transported.records[0].external = [
        ExternalReference(set_root=unrelated_root, key=target, revision="revision-one", value=external.value),
    ]
    invalid_directory = base.joinpath("invalid-consumer")
    invalid_root = export_set(view, transported, invalid_directory).map_err((error) => error.message())?
    before_failure = inventory(home)?
    match admit(home, invalid_directory, invalid_root, profile):
        Ok(_) =>
            assert false, "global availability replaced exact external membership"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert inventory(home)? == before_failure
    return Ok(None)


def payload_bytes(directory: Path) -> Result[int, str]:
    """Logical retained content lengths, excluding envelopes, transport copies and filesystem allocation metadata."""
    mut total = 0
    for entry in directory.iterdir().map_err((error) => error.message())?:
        if entry.is_dir():
            total += payload_bytes(entry)?
        else:
            total += entry.stat().map_err((error) => error.message())?.size().map_err((error) => error.message())?
    return Ok(total)


def prove_frozen_readmission(
    base: Path,
    directory: Path,
    root: str,
    profile: Profile,
    payload: str,
) -> Result[None, str]:
    """A frozen payload refuses normal admission after damage; explicit re-admission restores verified exact bytes."""
    home = base.joinpath("frozen-repair")
    original = admit(home, directory, root, profile).map_err((error) => error.message())?
    path = payload_path(home, payload)
    path.chmod(false).map_err((error) => error.message())?
    path.write_bytes(b"damaged").map_err((error) => error.message())?
    before = inventory(home)?
    match admit(home, directory, root, profile):
        Ok(_) =>
            assert false, "normal import silently repaired frozen damage"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    assert inventory(home)? == before
    restored = readmit(home, directory, root, profile).map_err((error) => error.message())?
    assert restored.digest == original.digest
    assert payload_bytes(home.joinpath("payloads"))? == 30
    assert home.joinpath("quarantine").is_dir()
    spec = verify(directory, root, profile).map_err((error) => error.message())?
    digest = hexlify(sha256.digest(b"shared value"))
    value_file = payload_path(home, digest)
    value_file.chmod(false).map_err((error) => error.message())?
    value_file.write_bytes(b"damaged value").map_err((error) => error.message())?
    match mapped_value(restored, spec, spec.records[0], digest):
        Ok(_) => assert false, "a damaged mapped value was accepted"
        Err(error) => assert error.kind == "integrity", error.message()
    readmit(home, directory, root, profile).map_err((error) => error.message())?
    segment = home.joinpath("segments").joinpath(f"{restored.segments[len(restored.segments) - 1]}.seg")
    bytes = segment.read_bytes().map_err((error) => error.message())?
    segment.write_bytes(bytes[:len(bytes) - 1]).map_err((error) => error.message())?
    match admit(home, directory, root, profile):
        Ok(_) =>
            assert false, "a damaged frozen frame was accepted"
        Err(error) =>
            assert error.kind == "integrity", error.message()
    repaired_records = readmit(home, directory, root, profile).map_err((error) => error.message())?
    assert repaired_records.generation > restored.generation
    admit(home, directory, root, profile).map_err((error) => error.message())?
    return Ok(None)
