"""
Operating-system containment for compile-time workers (RFC 160, RFC 119).

A worker that runs a Loaf's compile-time code has an empty grant: no network, no local IPC beyond its pipes to the
compiler, no writes, and reads limited to its own artifact and the system's own libraries. On macOS the grant becomes
a Seatbelt profile the worker starts under. Other hosts start the worker with a cleared environment only.
"""

from rust::std::env::consts import OS
from rust::std::process import Command
from std.fs import Path
from rust_target import decoded

const SANDBOX_EXEC: str = "/usr/bin/sandbox-exec"


pub model Contained:
    """What a contained worker left: whether it succeeded, its exit status as text, and its output pipe's text."""

    pub success: bool
    pub status: str
    pub stdout: str


pub def seatbelt_profile(worker: str) -> Result[str, str]:
    """
    The Seatbelt profile of the empty grant for one worker artifact.

    Everything is denied but running the worker itself and reading it, the system's libraries and two devices. A
    path that is not absolute, or that a profile string cannot hold, is refused.
    """
    if not worker.startswith("/") or "\"" in worker or "\\" in worker:
        return Err(f"cannot contain worker {worker}: its path cannot be named in a containment profile")
    reads = (
        f"(literal \"{worker}\") (literal \"/\") (subpath \"/System\") (subpath \"/usr/lib\") " +
        "(subpath \"/private/var/db/dyld\") (literal \"/dev/null\") (literal \"/dev/urandom\")"
    )
    return Ok(
        "(version 1)(deny default)" +
        f"(allow process-exec (literal \"{worker}\"))" +
        f"(allow file-read* {reads})" +
        "(allow file-read-metadata)(allow sysctl-read)",
    )


pub def run_contained(worker: Path, arguments: list[str]) -> Result[Contained, str]:
    """
    Run a worker to completion with a cleared environment under its empty grant, and capture its output pipe.

    1. On macOS the worker starts under the grant's Seatbelt profile; a host that cannot start it so refuses it.
    2. The worker inherits no environment, whatever the host.
    """
    mut command = Command.new(worker.0)
    # 1. The profile is in force before the worker's first instruction.
    if OS == "macos":
        if not Path(SANDBOX_EXEC).is_file():
            return Err(f"cannot contain worker {worker.0}: {SANDBOX_EXEC} is missing")
        command = Command.new(SANDBOX_EXEC)
        command.arg("-p")
        command.arg(seatbelt_profile(worker.0)?)
        command.arg(worker.0)
    for argument in arguments:
        command.arg(argument)
    # 2. Nothing ambient reaches the worker.
    _ = command.env_clear()
    captured = command.output().map_err((error) => f"cannot run worker {worker.0}: {error}")?
    return Ok(
        Contained(success=captured.status.success(), status=f"{captured.status}", stdout=decoded(captured.stdout)),
    )
