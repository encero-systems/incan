"""
Compile local Rust facets and Incan libraries from one shared dependency graph (DD-0008).

The graph is `loaf_local_graph.local_facets`. Each unit compiles after the local units it links. Rust facet directories
retain project, domain, feature and profile identities; Incan providers use the Loaf artifact layout and library stamp.
Native Rust producers live in the home store, keyed by their complete native inputs and shared across consumers.
Registry units come compiled: their rlibs by root name and the directories their dependencies live in.

Each Rust library also records its graph-selected externs and search directories in `native.json`. Release assembly
uses those bindings instead of inferring a dependency's identity from an artifact directory.
"""

from rust::std::process import Command, id
from std.toml import TomlValue
from std.fs import Path
from std.json import JsonValue
from std.hash import sha256
from std.encoding.hex import hexlify
from codegen import rust_arguments
from apple_sdk import sdk_identity
from driver_command import driver_command
from files import json_text, parse_json, read, read_json
from home import dependency_artifact_dir, unit_ledger
from json_fields import field, required_items, required_text, strings
from intake import library_source, read_project, ManifestReader
from native_closure_input import NativeClosureInput
from loaf_local_graph import LocalDemand, LocalFacet, local_facets
from observation import SETTLE_SECONDS, load_ledger, observe, trace
from jec import begin, record as record_work
from publication import place, publish
from rust_activation import DependencyDomain
from registry_units import RegistryUnit, RegistrySelection, RegistryDemand, RegistryUnits, is_dynamic_library
from registry_metadata import complete_legacy
from rust_target import decoded, run_text, target_configuration
from toml_fields import optional_string, optional_strings, read_manifest, required_string
from toolchain import NativeCrate, Toolchain, load_toolchain, located
from unit_freshness import (
    Key,
    artifact_identity,
    compiler_fingerprint,
    fingerprint,
    install_all,
    record,
    reusable,
    rust_key,
    staleness,
)
from rust_freshness import (
    compilation_observations,
    dependency_arguments,
    graph_arguments,
    inputs_unchanged,
    library_key,
    producer_arguments,
    extern_paths,
)
from rust_portable import portable_key, portable_reusable, record_portable
from rust_store import discovery_directory, producer_directory

# The schema of the receipt a build leaves of the libraries it built.
const RECEIPT_SCHEMA: str = "incan.rust-units/1"
# The schema of the registry closure a toolchain ships.
const CLOSURE_SCHEMA: str = "incan.oven.closure/1"


pub model RustFacet:
    """What a local Loaf's manifest says about its Rust crate."""

    pub crate_name: str
    # `lib`, `proc-macro`, or an `incan` provider; empty when the Loaf has no library crate.
    pub kind: str
    pub edition: str
    # The library crate's Rust or Incan root file, when there is one.
    pub library: str
    # The `[[rust.bin]]` crates: name and root file.
    pub binaries: list[Tuple[str, str]]
    # The package name and version the unit is compiled as.
    pub package: str
    pub version: str
    # Whether a binary needs the toolchain's unstable features (`unstable_features`).
    pub unstable: bool
    # Whether a binary links the toolchain's own libraries (`sysroot_dependencies`) and finds them at run time.
    pub sysroot: bool


pub model BuiltUnit:
    """One compiled local unit: what its dependents pass as `--extern`, and where its outputs are."""

    pub crate_name: str
    pub artifact: str
    pub directory: str
    # Whether this build kept a stored Rust facet; Incan providers trace their library decision separately.
    pub reused: bool = false
    # An Incan provider's native closure, needed when Rust links the provider's transitive crates.
    pub search: list[str] = []
    # The Incan package identity, empty for a Rust-only library.
    pub loaf: str = ""


pub def read_registry_units(
    path: Path,
    project: str = "",
    reader: ManifestReader = ManifestReader(),
) -> Result[RegistryUnits, str]:
    """
    Registry units from a closure result (`incan.oven.closure/1`): every compiled unit and its store directory.

    1. The document is a closure of this version.
    2. The store's entries directory follows from the artifact of the first extern.
    3. Each unit is read with its store directory, and those directories are the search path.
    """
    # 1. Only a closure of this version describes units the way the rest of Oven reads them.
    clock = begin()
    document = read_json(path)?
    schema = required_text(document, "schema")?
    if schema != CLOSURE_SCHEMA:
        return Err(f"{path.0}: expected {CLOSURE_SCHEMA}, found {schema}")
    # 2. The store keeps all its entries side by side, so one extern's artifact path locates them all.
    entries = entries_directory(document, path)?
    # 3. Each unit knows its own artifact directory, and every such directory is searched for dependencies.
    mut units: list[RegistryUnit] = []
    mut search: list[str] = []
    for item in required_items(document, "units")?:
        unit = registry_unit(item, entries)?
        units.append(unit)
        if unit.directory not in search:
            search.append(unit.directory)
    record_work("registry_index", path.0, clock)
    completed = complete_legacy(units)?
    registry = RegistryUnits(
        units=completed,
        search=search,
        anchors=[],
        recorded_bindings=recorded_registry_bindings(completed, path)?,
    )
    return project_registry(registry, project, reader)


def project_registry(registry: RegistryUnits, project: str, reader: ManifestReader) -> Result[RegistryUnits, str]:
    """A project's explicit build.registry-lock supersedes the installation's standard-producer root selection."""
    path = registry_record_path(project, reader)?
    if path == "":
        return Ok(registry)
    mut selected = registry
    selected.recorded_bindings = registry_record(registry.units, Path(path))?
    return Ok(selected)


pub def registry_record_path(project: str, reader: ManifestReader) -> Result[str, str]:
    """Locate a project's explicit producer record for ordinary preparation and resident input observation."""
    if project == "" or not Path(project).joinpath("loaf.toml").is_file():
        return Ok("")
    manifest = read_manifest(Path(project), reader)?
    match optional_string(manifest, "build.registry-lock")?:
        None => return Ok("")
        Some(path) =>
            if path == "":
                return Err(f"{project}: build.registry-lock must name a producer closure")
            return Ok(located(Path(project), path))


def recorded_registry_bindings(units: list[RegistryUnit], source: Path) -> Result[list[Tuple[str, str]], str]:
    """Read only the selected installation's explicit producer record, validating every named catalog identity."""
    toolchain = load_toolchain()?
    if toolchain.registry_lock == "":
        return Ok([])
    actual = source.resolve().map_err((error) => error.message())?.0
    selected = Path(toolchain.registry_units).resolve().map_err((error) => error.message())?.0
    if actual != selected:
        return Ok([])
    return registry_record(units, Path(toolchain.registry_lock))


def registry_record(units: list[RegistryUnit], path: Path) -> Result[list[Tuple[str, str]], str]:
    """Validate a closure's exact entries and logical compilation domains before they can decide any root."""
    document = read_json(path)?
    if required_text(document, "schema")? != CLOSURE_SCHEMA:
        return Err(f"{path.0}: expected {CLOSURE_SCHEMA}")
    available = [unit.entry for unit in units]
    mut bindings: list[Tuple[str, str]] = []
    for item in required_items(document, "units")?:
        entry = required_text(item, "entry")?
        domain = required_text(item, "domain")?
        if entry not in available:
            return Err(f"recorded registry closure names absent entry {entry}")
        if domain != "target" and domain != "host":
            return Err(f"recorded registry closure names invalid domain {domain}")
        bindings.append((domain, entry))
    return Ok(bindings)


def entries_directory(document: JsonValue, path: Path) -> Result[str, str]:
    """The directory of the store's entries, three levels above the artifact of the first extern of a closure."""
    externs = document.require("externs").map_err((error) => error.message())?
    for name in externs.keys():
        extern = externs.require(name).map_err((error) => error.message())?
        artifact = required_text(extern, "path")?
        # An extern's path is absolute, or relative to the closure document (a packed toolchain's registry).
        return Ok(Path(located(path.parent(), artifact)).parent().parent().parent().0)
    return Err(f"{path.0} names no compiled unit")


def registry_unit(item: JsonValue, entries: str) -> Result[RegistryUnit, str]:
    """One compiled unit of a closure, with the artifact directory its store entry holds."""
    entry = required_text(item, "entry")?
    directory = Path(entries).joinpath(entry.replace(":", "-")).joinpath("artifacts").0
    return Ok(
        RegistryUnit(
            loaf=required_text(item, "loaf")?,
            version=required_text(item, "version")?,
            domain=required_text(item, "domain")?,
            directory=directory,
            features=registry_features(item)?,
            entry=entry,
            dependencies=registry_dependencies(item)?,
            profile=registry_text(item, "profile")?,
            recorded=item.get("dependencies") != None,
            name=registry_text(item, "name")?,
            kind=registry_text(item, "kind")?,
        ),
    )


def registry_text(item: JsonValue, key: str) -> Result[str, str]:
    """Allow a missing legacy field, while refusing a present field of the wrong type."""
    match item.get(key):
        None => return Ok("")
        Some(value) => return value.expect_str().map_err((error) => error.message())


def registry_dependencies(item: JsonValue) -> Result[list[str], str]:
    """Read exact producer dependency entries; absent legacy metadata is completed separately."""
    match item.get("dependencies"):
        None => return Ok([])
        Some(value) =>
            records = value.expect_array().map_err((error) => error.message())?
            return Ok([required_text(record, "entry")? for record in records])


pub def selected_registry(
    registry: RegistryUnits,
    facets: list[LocalFacet],
    profile: str,
) -> Result[RegistryUnits, str]:
    """Select every local facet's registry roots together before any producer compiles or any alias is bound."""
    mut demands: list[RegistryDemand] = []
    for facet in facets:
        for record in facet.registry:
            demands.append(RegistryDemand(selection=registry_selection(record)?, domain=facet.domain.value()))
    return registry.select(demands, profile)


pub def registry_features(value: JsonValue) -> Result[list[str], str]:
    """The explicit features of a registry request or prepared unit, refusing malformed closure input."""
    selected = field(value, "features", []).map_err((_) => "registry unit or request names no features")?
    return strings(selected, ["features"]).map_err((_) => "registry features must be a list of strings")


pub def registry_selection(selected: JsonValue) -> Result[RegistrySelection, str]:
    """What one registry request of a facet asks for: its Loaf, its version requirement and its features."""
    loaf = required_text(selected, "loaf")?
    requirement = required_text(selected, "req")?
    return Ok(RegistrySelection(loaf=loaf, requirement=requirement, features=registry_features(selected)?))


model RustBinaries:
    """The `[[rust.bin]]` crates of a manifest, and what they ask of the toolchain."""

    crates: list[Tuple[str, str]]
    unstable: bool
    sysroot: bool


pub def rust_facet(
    project: str,
    required: bool = true,
    reader: ManifestReader = ManifestReader(),
) -> Result[RustFacet, str]:
    """
    The Rust crate a local Loaf's manifest declares; an Incan consumer may have no Rust facet of its own.

    1. Read the manifest and name the package, the crate and its edition.
    2. Find the library crate and its type.
    3. Read the `[[rust.bin]]` crates and what they ask of the toolchain.
    4. A Loaf that must declare a Rust crate and declares none is refused.
    """
    root = Path(project)
    # 1. The package, its crate name and its edition come from the manifest, with the documented fallbacks.
    project_intent = read_project(root, reader).map_err((error) => error.message())?
    document = project_intent.parsed
    package = required_string(document, "project.name")?
    crate_name = crate_name_of(document, package)?
    edition = project_intent.intent.rust_edition
    # 2. A library crate is the `src/lib.rs` of the source root, and the manifest may type it a procedural macro.
    mut library = library_root(document, root)?.joinpath("src").joinpath("lib.rs")
    mut kind = library_type(document, library)?
    # 3. Each `[[rust.bin]]` is a crate of its own, and may need unstable features or the toolchain's libraries.
    binaries = read_binaries(document, root)?
    # 4. An Incan library supplies its compiled Rust crate; a project with neither language's crate is refused.
    if required and kind == "":
        source = library_source(root, reader)?
        if source.is_file():
            kind = "incan"
            library = source
        elif len(binaries.crates) == 0:
            return Err(f"{project} declares no Rust crate: no {library.0} and no [[rust.bin]]")
    version = required_string(document, "project.version")?
    mut library_path = ""
    if library.is_file():
        library_path = library.0
    return Ok(
        RustFacet(
            crate_name=crate_name,
            kind=kind,
            edition=edition,
            library=library_path,
            binaries=binaries.crates,
            package=package,
            version=version,
            unstable=binaries.unstable,
            sysroot=binaries.sysroot,
        ),
    )


def crate_name_of(document: TomlValue, package: str) -> Result[str, str]:
    """The crate's name: `rust.name` when declared, else the package's, with underscores for hyphens."""
    match optional_string(document, "rust.name")?:
        Some(declared) => return Ok(declared.replace("-", "_"))
        None => return Ok(package.replace("-", "_"))


def library_root(document: TomlValue, root: Path) -> Result[Path, str]:
    """The directory whose `src/lib.rs` is the library crate: `rust.source.root` under the project, else the project."""
    match optional_string(document, "rust.source.root")?:
        Some(declared) => return Ok(root.joinpath(declared))
        None => return Ok(root)


def library_type(document: TomlValue, library: Path) -> Result[str, str]:
    """The library crate's type (`lib` unless `rust.type` says otherwise), or empty when there is no library file."""
    if not library.is_file():
        return Ok("")
    match optional_string(document, "rust.type")?:
        Some(declared) => return Ok(declared)
        None => return Ok("lib")


def read_binaries(document: TomlValue, root: Path) -> Result[RustBinaries, str]:
    """The `[[rust.bin]]` crates, and whether any needs unstable features or the toolchain's own libraries."""
    mut crates: list[Tuple[str, str]] = []
    mut unstable = false
    mut sysroot = false
    for binary in declared_binaries(document)?:
        name = required_string(binary, "name")?
        path = required_string(binary, "path")?
        crates.append((name, root.joinpath(path).0))
        if declares_any(binary, "unstable_features")?:
            unstable = true
        if declares_any(binary, "sysroot_dependencies")?:
            sysroot = true
    return Ok(RustBinaries(crates=crates, unstable=unstable, sysroot=sysroot))


def declares_any(table: TomlValue, key: str) -> Result[bool, str]:
    """Whether a manifest table declares a non-empty list of strings at `key`."""
    match optional_strings(table, key)?:
        Some(names) => return Ok(len(names) > 0)
        None => return Ok(false)


pub def identity(facet: LocalFacet, profile: str) -> str:
    """A unit's identity: its project, domain, features and profile."""
    text = f"{facet.project}\n{facet.domain.value()}\n{",".join(sorted(facet.features))}\n{profile}"
    return hexlify(sha256.digest(text.encode("utf-8")))[0:16]


pub def ordered(facets: list[LocalFacet]) -> Result[list[LocalFacet], str]:
    """The facets in an order where every unit follows the local units it links."""
    mut done: list[str] = []
    mut result: list[LocalFacet] = []
    while len(result) < len(facets):
        mut progressed = false
        for facet in facets:
            if facet.key() in done:
                continue
            mut ready = true
            for edge in facet.local:
                if edge.key() not in done:
                    ready = false
            if ready:
                done.append(facet.key())
                result.append(facet)
                progressed = true
        if not progressed:
            return Err("the local Rust units depend on each other in a cycle")
    return Ok(result)


pub model RustBuild:
    """The selected features, profile and compilers for one consumer's shared local dependency graph."""

    pub project: str
    pub profile: str = "debug"
    # The toolchain's pinned compiler; never whichever `rustc` is first on PATH.
    pub rustc: str
    pub registry: RegistryUnits
    pub features: list[str] = []
    pub default_features: bool = true
    # `--all-features`: the root selects every feature its manifest declares.
    pub all_features: bool = false
    # Loaves to use in place of the Loaf of a package name, wherever the graph reaches it.
    pub substitutes: Dict[str, str] = {}
    # The Incan unit orchestrator supplies its compiler without a reverse module dependency.
    pub incan_compiler: Option[(str, str, list[str], str, list[Tuple[str, str]], list[Tuple[str, str]], list[str], Toolchain, str, ManifestReader) -> Result[i32, str]] = None
    # The toolchain's own search directories. An Incan provider's native closure leaves them to the search index, so a
    # Rust facet, which rustc links directly, searches them beside the registry's.
    pub toolchain_search: list[str] = []
    # One installed generation is selected for the whole build, including Incan providers.
    pub toolchain: Option[Toolchain] = None
    pub compiler: str = ""
    # All provider callbacks share the preparation's exact source readings.
    pub manifests: ManifestReader = ManifestReader()
    # Native Rust artifacts depend on the actual rustc, independently of installed Incan providers.
    pub native_compiler: str = ""
    # One name index retains ambiguity in the selected installed artifact generation.
    pub installed: Dict[str, list[str]] = {}
    # Rust implementations consume native facets; Incan consumers require complete public Loaf facades.
    pub rust_facet_dependencies: bool = false


pub def rust_output(project: Path, profile: str) -> Path:
    """Where a project's Rust units and the receipt of its last build are stored for a profile."""
    return project.joinpath("target").joinpath("incan").joinpath("rust").joinpath(profile)


pub def prepared_build(request: RustBuild) -> Result[RustBuild, str]:
    """
    Select the installed compiler once, then retain its fingerprint for every facet in this build.

    1. Preserve a caller's loaded toolchain, or load it once.
    2. Derive Incan-generation and actual Rust-compiler fingerprints once.
    """
    # 1. The selected generation is shared by native facets and Incan providers.
    selected = selected_toolchain(request)?
    mut prepared = request
    prepared.toolchain = Some(selected)
    # 2. Reuse the generation identity throughout this build.
    if prepared.compiler == "":
        prepared.compiler = compiler_fingerprint(selected)?
    prepared.installed = native_artifacts(selected.externs)
    if prepared.native_compiler == "":
        prepared.native_compiler = native_compiler_fingerprint(prepared.rustc, prepared.project)?
    return Ok(prepared)


pub def native_artifacts(externs: list[NativeCrate]) -> Dict[str, list[str]]:
    """Index the installed generation once without hiding duplicate native crate bindings."""
    mut artifacts: Dict[str, list[str]] = {}
    for native in externs:
        if native.name not in artifacts:
            artifacts[native.name] = []
        artifacts[native.name].append(native.path)
    return artifacts


def native_compiler_fingerprint(rustc: str, project: str) -> Result[str, str]:
    """Identify the actual pinned compiler and SDK, resolving an installation's sysroot alias before observing them."""
    compiler = Path(rustc).resolve().map_err((error) => error.message())?
    libraries = toolchain_libraries(compiler.0, project)?
    return fingerprint(
        [
            compiler.0,
            artifact_identity(compiler)?,
            libraries.environment["INCAN_DRIVER_RUSTC_IDENTITY"],
            libraries.environment["INCAN_DRIVER_LIBRARY_DIGEST"],
            sdk_identity(compiler.parent().parent().0)?,
            native_deployment_target(compiler.0, libraries.environment["INCAN_DRIVER_RUSTC_IDENTITY"])?,
        ],
    )


def native_deployment_target(rustc: str, compiler: str) -> Result[str, str]:
    """Ask rustc for its effective Apple deployment target, including the platform-specific environment policy."""
    for line in compiler.split("\n"):
        if line.startswith("host: ") and "-apple-" in line:
            return run_text(rustc, ["--print", "deployment-target"])
    return Ok("")


def selected_toolchain(request: RustBuild) -> Result[Toolchain, str]:
    """The build's loaded toolchain; direct one-facet callers may select it here."""
    match request.toolchain:
        Some(selected) => return Ok(selected)
        None => return load_toolchain()


pub def build_rust(request: RustBuild) -> Result[list[str], str]:
    """Compile the requested graph against one selected installed compiler generation."""
    return build_prepared_rust(prepared_build(request)?)


def build_prepared_rust(request: RustBuild) -> Result[list[str], str]:
    """
    Compile the project's Rust facet and every local facet it reaches, then its binaries; returns their paths.

    A unit that fails does not stop the others: every unit whose local dependencies compiled is attempted, the units
    that link a failed one are reported as blocked by it, and the build fails with every report.

    1. Activate the graph of local facets and order it, so every unit follows the units it links.
    2. Attempt each facet: one that links a failed unit is blocked by it; any other is compiled.
    3. Any report fails the build, and the error carries them all.
    4. Publish the receipt of the libraries built, which the code graph reads.
    """
    # 1. The graph is the one the pinned rustc's own target selects, and every unit comes after those it links.
    configuration = target_configuration(request.rustc)?
    root = Path(request.project).resolve().map_err((error) => f"{request.project}: {error.message()}")?
    demand = LocalDemand(
        project=root.0,
        domain=DependencyDomain.Target,
        features=request.features,
        defaults=request.default_features,
        all_features=request.all_features,
    )
    facets = ordered(local_facets(demand, configuration, request.substitutes, request.manifests)?)?
    mut request = request
    request.registry = selected_registry(request.registry, facets, request.profile)?
    validate_incan_packages(facets, root.0, request.manifests)?
    output = rust_output(root, request.profile)
    # 2. A unit that fails blocks only the units that link it, so every other unit is still attempted.
    mut built: Dict[str, BuiltUnit] = {}
    mut failed: Dict[str, str] = {}
    mut reports: list[str] = []
    mut search: list[str] = []
    mut binaries: list[str] = []
    for facet in facets:
        blocker = blocking_unit(facet, failed)
        if blocker != "":
            failed[facet.key()] = blocker
            reports.append(f"{facet.project}: blocked by {blocker}")
            continue
        match unit_outputs(facet, root, output, request, built, search):
            Err(reason) =>
                failed[facet.key()] = facet.project
                reports.append(reason)
            Ok(outputs) =>
                unit, programs = outputs
                if let Some(library) = unit:
                    built[facet.key()] = library
                    search = search + [library.directory] + library.search
                for program in programs:
                    binaries.append(program)
    # 3. A build with any failed or blocked unit fails, and its error carries every report.
    if len(reports) > 0:
        body = "\n\n".join(reports)
        return Err(f"{len(reports)} of {len(facets)} Rust units did not compile:\n\n{body}")
    # 4. The libraries that were built are recorded, so a later code graph finds them without scanning directories.
    publish(output.joinpath("units.json"), json_text(receipt_document(built, false))?)?
    return Ok(binaries)


def blocking_unit(facet: LocalFacet, failed: Dict[str, str]) -> str:
    """The project of the first failed unit the facet links, or empty when it links none."""
    for edge in facet.local:
        if edge.key() in failed:
            return failed[edge.key()]
    return ""


pub def receipt_document(built: Dict[str, BuiltUnit], keyed: bool) -> JsonValue:
    """The receipt of built libraries: each one's crate, artifact and directory, and with `keyed` its unit key."""
    mut units: list[JsonValue] = []
    for key in sorted([key for key in built.keys()]):
        mut fields: Dict[str, JsonValue] = {}
        if keyed:
            fields["key"] = JsonValue.string(key)
        fields["crate"] = JsonValue.string(built[key].crate_name)
        fields["artifact"] = JsonValue.string(built[key].artifact)
        fields["directory"] = JsonValue.string(built[key].directory)
        fields["search"] = JsonValue.array([JsonValue.string(path) for path in built[key].search])
        fields["loaf"] = JsonValue.string(built[key].loaf)
        units.append(JsonValue.object(fields))
    return JsonValue.object({"schema": JsonValue.string(RECEIPT_SCHEMA), "units": JsonValue.array(units)})


pub def read_receipt(path: Path, keyed: bool = false) -> Result[Dict[str, BuiltUnit], str]:
    """
    The exact native libraries a build recorded in its receipt, by crate name or, with `keyed`, by unit key.

    A library is never selected by scanning directories, and one whose artifact is gone is left out.
    """
    if not path.is_file():
        return Ok({})
    receipt = parse_json(read(path)?)?
    if required_text(receipt, "schema")? != RECEIPT_SCHEMA:
        return Err(f"{path.0}: unsupported native unit receipt")
    mut result: Dict[str, BuiltUnit] = {}
    for item in required_items(receipt, "units")?:
        name = required_text(item, "crate")?
        artifact = required_text(item, "artifact")?
        directory = required_text(item, "directory")?
        mut key = name
        if keyed:
            key = required_text(item, "key")?
        if key in result:
            return Err(f"{path.0}: ambiguous native library {name}")
        if Path(artifact).is_file():
            listed = field(item, "search", []).map_err((_) => f"{path.0}: missing search")?
            search = strings(listed, ["search"]).map_err((_) => f"{path.0}: search is not a list of directories")?
            mut loaf = ""
            if item.contains_key("loaf"):
                loaf = required_text(item, "loaf")?
            result[key] = BuiltUnit(crate_name=name, artifact=artifact, directory=directory, search=search, loaf=loaf)
    return Ok(result)


pub def build_dependencies(
    request: RustBuild,
    facets: list[LocalFacet],
    include_root: bool = true,
) -> Result[Dict[str, BuiltUnit], str]:
    """Prepare reached dependencies against one installed compiler generation."""
    mut prepared = prepared_build(request)?
    prepared.registry = selected_registry(prepared.registry, facets, prepared.profile)?
    return build_prepared_dependencies(prepared, facets, include_root)


def build_prepared_dependencies(
    request: RustBuild,
    facets: list[LocalFacet],
    include_root: bool,
) -> Result[Dict[str, BuiltUnit], str]:
    """
    Build the Rust facets and Incan providers a consumer reaches through the shared unit compiler.

    Analysis may leave out the project's own library (`include_root` false) when no binary links it.
    """
    root = Path(request.project).resolve().map_err((error) => error.message())?
    validate_incan_packages(facets, root.0, request.manifests)?
    output = rust_output(root, request.profile)
    mut built: Dict[str, BuiltUnit] = {}
    # The libraries built for the graph; `linking` adds the registry's and the toolchain's directories.
    mut search: list[str] = []
    for facet in ordered(facets)?:
        own = facet.project == request.project and facet.domain == DependencyDomain.Target
        if own and not include_root:
            continue
        declared = rust_facet(facet.project, not own, request.manifests)?
        if declared.kind == "":
            if own:
                continue
            return Err(f"{facet.project} declares no Rust library")
        unit = compile_library(facet, declared, output, request, built, search)?
        built[facet.key()] = unit
        search = search + [unit.directory] + unit.search
    return Ok(built)


def validate_incan_packages(facets: list[LocalFacet], root: str, reader: ManifestReader) -> Result[None, str]:
    """Preserve the path-library identity rule before two different providers could overwrite one package artifact."""
    mut names: Dict[str, str] = {}
    for facet in facets:
        if facet.project == root or not library_source(Path(facet.project), reader)?.is_file():
            continue
        package = required_string(read_manifest(Path(facet.project), reader)?, "project.name")?
        if package in names and names[package] != facet.project:
            return Err(f"path dependencies {names[package]} and {facet.project} share package name `{package}`")
        names[package] = facet.project
    return Ok(None)


def unit_outputs(
    facet: LocalFacet,
    root: Path,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[Tuple[Option[BuiltUnit], list[str]], str]:
    """Compile one facet's library, and the root facet's binaries."""
    declared = rust_facet(facet.project, true, request.manifests)?
    mut library: Option[BuiltUnit] = None
    mut local_built = built
    if declared.kind != "":
        unit = compile_library(facet, declared, output, request, built, search)?
        if unit.loaf != "":
            println(f"prepared {unit.crate_name} ({facet.domain.value()})")
        elif unit.reused:
            println(f"reused {declared.crate_name} ({facet.domain.value()})")
        else:
            println(f"compiled {declared.crate_name} ({facet.domain.value()})")
        local_built[facet.key()] = unit
        library = Some(unit)
        publish_native_inputs(facet, request, built, search, unit)?
    mut programs: list[str] = []
    if facet.project == root.0 and facet.domain == DependencyDomain.Target:
        for name, source in declared.binaries:
            programs.append(compile_binary(name, source, facet, declared, output, request, local_built, search)?)
    return Ok((library, programs))


pub def linking(
    facet: LocalFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[list[str], str]:
    """
    The arguments that link a unit.

    1. Its features, as `--cfg`.
    2. The search directories: the registry's and the toolchain's, then those of the libraries built for the graph.
    3. One `--extern` per local edge, then one per registry edge.
    4. The optimization and debug settings of the profile.
    """
    # 1. The unit's code sees the features the graph activated, as `cfg(feature = ...)`.
    mut arguments: list[str] = []
    for feature in facet.features:
        arguments.append("--cfg")
        arguments.append(f"feature=\"{feature}\"")
    # 2. The libraries the unit links, and what they link in turn, are found in the search directories, each once.
    mut searched: set[str] = set()
    for directory in request.registry.search + request.toolchain_search + facet_search(facet, built)?:
        if directory in searched:
            continue
        searched.add(directory)
        arguments.append("-L")
        arguments.append(f"dependency={directory}")
    # 3. Each edge names its library exactly, local edges first, so no library is chosen by scanning a directory.
    arguments = arguments + local_externs(facet, built)? + registry_externs(facet, request)?
    # 4. Both unit languages read their flags from one profile table.
    arguments = arguments + rust_arguments(request.profile)
    return Ok(arguments)


def local_externs(facet: LocalFacet, built: Dict[str, BuiltUnit]) -> Result[list[str], str]:
    """One `--extern alias=library` per local edge; an edge whose unit is not built is an error."""
    return Ok(extern_arguments(local_bindings(facet, built)?))


pub def facet_search(facet: LocalFacet, built: Dict[str, BuiltUnit]) -> Result[list[str], str]:
    """Search only direct libraries and the native closure each retains, independently of build order."""
    mut directories: list[str] = []
    for edge in facet.local:
        if edge.key() not in built:
            return Err(f"{facet.project} links {edge.alias}, which has no compiled library")
        unit = built[edge.key()]
        for directory in [unit.directory] + unit.search:
            if directory not in directories:
                directories.append(directory)
    return Ok(sorted(directories))


def local_bindings(facet: LocalFacet, built: Dict[str, BuiltUnit]) -> Result[list[NativeCrate], str]:
    """Retain each local graph edge's exact alias and built artifact for compilation and its native receipt."""
    mut bindings: list[NativeCrate] = []
    for edge in facet.local:
        if edge.key() not in built:
            return Err(f"{facet.project} links {edge.alias}, which has no compiled library")
        bindings.append(NativeCrate(name=edge.alias.replace("-", "_"), path=built[edge.key()].artifact))
    return Ok(bindings)


def registry_externs(facet: LocalFacet, request: RustBuild) -> Result[list[str], str]:
    """One `--extern alias=library` per registry edge, naming the edge when no compiled library serves it."""
    return Ok(extern_arguments(registry_bindings(facet, request.registry)?))


def registry_bindings(facet: LocalFacet, registry: RegistryUnits) -> Result[list[NativeCrate], str]:
    """Bind registry aliases through the same version, feature and domain selection for either language."""
    mut bindings: list[NativeCrate] = []
    for index in range(len(facet.registry)):
        alias = facet.registry_aliases[index]
        selection = registry_selection(facet.registry[index])?
        artifact = registry
            .artifact_for(selection, facet.domain.value())
            .map_err((reason) => f"{facet.project} links `{alias}`: {reason}")?
        bindings.append(NativeCrate(name=alias.replace("-", "_"), path=artifact))
    return Ok(bindings)


def extern_arguments(bindings: list[NativeCrate]) -> list[str]:
    """Render selected structured bindings once at rustc's argument boundary."""
    mut arguments: list[str] = []
    for binding in bindings:
        arguments.append("--extern")
        arguments.append(f"{binding.name}={binding.path}")
    return arguments


def publish_native_inputs(
    facet: LocalFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    unit: BuiltUnit,
) -> Result[None, str]:
    """Record selected dependencies and search directories, adding the library's own directory for consumers."""
    bindings = facet_bindings(facet, built, request.registry)?
    mut externs: list[JsonValue] = []
    for binding in bindings:
        externs.append(JsonValue.array([JsonValue.string(binding.name), JsonValue.string(binding.path)]))
    document = JsonValue.object(
        {"schema": JsonValue.string("incan.rust-native/1"), "externs": JsonValue.array(externs), "search": JsonValue.array(
            [JsonValue.string(directory) for directory in search + [unit.directory]],
        )},
    )
    return publish(Path(unit.directory).joinpath("native.json"), json_text(document)?)


pub def facet_bindings(
    facet: LocalFacet,
    built: Dict[str, BuiltUnit],
    registry: RegistryUnits,
) -> Result[list[NativeCrate], str]:
    """The facet's exact direct aliases, selected once by the shared local and registry binding policy."""
    return Ok(local_bindings(facet, built)? + registry_bindings(facet, registry)?)


pub def incan_artifacts(built: Dict[str, BuiltUnit]) -> list[Tuple[str, str]]:
    """The exact package identities and artifact directories of already compiled Incan providers."""
    mut result: list[Tuple[str, str]] = []
    for key in sorted([key for key in built.keys()]):
        unit = built[key]
        if unit.loaf != "":
            result.append((unit.loaf, unit.directory))
    return result


pub def compile_library(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[BuiltUnit, str]:
    """Prepare a foreign Incan provider's complete facade, or the Rust facet of the root or a Rust-only dependency."""
    if request.rust_facet_dependencies and declared.library.endswith(".rs"):
        return compile_rust_library(facet, declared, output, request, built, search)
    source = library_source(Path(facet.project), request.manifests)?
    if source.is_file():
        root = Path(request.project).resolve().map_err((error) => error.message())?
        if facet.project != root.0:
            return compile_incan_library(facet, declared, output, request, built, search)
    return compile_rust_library(facet, declared, output, request, built, search)


pub def compile_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[BuiltUnit, str]:
    """
    Compile or reuse one Rust facet and return its exact artifact.

    1. Reuse a selected installed producer only with a complete current input and output proof.
    2. Otherwise compile or reuse the graph's local producer.
    """
    # 1. An installed native generation is immutable beneath its runtime and standard providers.
    toolchain = selected_toolchain(request)?
    selected = installed_rust_library(facet, declared, request, built, search, toolchain)?
    if let Some(unit) = selected:
        return Ok(unit)
    # 2. A facet absent from the installed generation retains ordinary local compilation.
    return compile_local_rust_library(facet, declared, output, request, built, search, toolchain)


def installed_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    toolchain: Toolchain,
) -> Result[Option[BuiltUnit], str]:
    """
    Reuse an installed facet only after validating its source, features, compiler, environment and exact externs.

    1. Require one selected artifact with the requested source/domain/features/profile identity.
    2. Reconcile the producer's recorded dependencies and every completed output against its stamp.
    3. Return that same artifact; stale installed support is an explicit refusal, never a second producer.
    """
    # 1. Direct callers may lack the prepared request's shared name index.
    mut artifacts = request.installed
    if len(artifacts) == 0:
        artifacts = native_artifacts(toolchain.externs)
    if declared.crate_name not in artifacts:
        return Ok(None)
    if len(artifacts[declared.crate_name]) != 1:
        return Err(f"installed native generation has no unique {declared.crate_name} artifact")
    artifact = Path(artifacts[declared.crate_name][0])
    unit = identity(facet, request.profile)
    if not artifact.name().startswith(f"lib{declared.crate_name}-{unit}."):
        return Err(
            f"installed native {declared.crate_name} does not match the selected source, domain, features and profile",
        )
    # 2. A filename selects a candidate; only the complete producer proof authorizes its reuse.
    directory = artifact.parent()
    reading = directory.lock_exclusive().map_err((error) => error.message())?
    arguments = library_compile_arguments(facet, declared, directory, request, built, search)?
    environment = package_environment(facet.project, declared, declared.crate_name)
    key = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain).map_err(
        (error) => f"installed native {declared.crate_name} has no current producer proof: {error}",
    )?
    graph = directory.joinpath(f"{declared.package}.incngraph")
    dependencies = directory.joinpath("library.d")
    outputs = [artifact, graph, dependencies]
    stamp = directory.joinpath("library.oven-inputs")
    why = staleness(outputs, stamp, key)?
    portable = portable_key(key, directory, arguments)?
    if not retain_current_rust_library(
        facet,
        declared,
        artifact,
        arguments,
        environment,
        request,
        toolchain,
        key,
        portable,
    )?:
        return Err(f"installed native {declared.crate_name} is stale: {why}; rebuild its support generation")
    # 3. Consumers search the same graph-selected native closure as the installed producer.
    trace(f"unit {declared.crate_name} rust: reused installed producer")
    return Ok(
        Some(
            BuiltUnit(
                crate_name=declared.crate_name,
                artifact=artifact.0,
                directory=directory.0,
                reused=true,
                search=facet_search(facet, built)?,
            ),
        ),
    )


pub def library_compile_arguments(
    facet: LocalFacet,
    declared: RustFacet,
    directory: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[list[str], str]:
    """Frame one facet's exact native command for both local production and installed-producer verification."""
    unit = identity(facet, request.profile)
    dependencies = directory.joinpath("library.d")
    arguments = library_arguments(declared)
    outputs = ["--out-dir", directory.0, "-C", f"metadata={unit}", "-C", f"extra-filename=-{unit}"]
    return Ok(
        arguments + outputs + ["--emit", f"link,dep-info={dependencies.0}"] + linking(facet, request, built, search)?,
    )


pub def rust_library_producer_key(
    facet: LocalFacet,
    directory: Path,
    arguments: list[str],
    environment: Dict[str, str],
    request: RustBuild,
    toolchain: Toolchain,
) -> Result[Key, str]:
    """Reconcile a Rust producer with the actual compiler and exact inputs, independently of installed Incan Loaves."""
    mut compiler = request.native_compiler
    if compiler == "":
        compiler = native_compiler_fingerprint(request.rustc, request.project)?
    return library_key(
        Path(facet.project),
        directory,
        directory.joinpath("library.d"),
        producer_arguments(arguments),
        environment,
        extern_artifacts(arguments),
        toolchain,
        compiler,
    )


pub def rust_library_graph_key(native: Key, driver: str) -> Result[Key, str]:
    """
    Bind a checked graph to its unchanged native inputs and exact graph-generating driver.

    The driver identity includes its graph observer and encoded schema; changing either refreshes only the graph.
    """
    producer = fingerprint([driver, artifact_identity(Path(driver))?])?
    return Ok(
        Key(
            digest=fingerprint(["incan.oven.rust-graph/1", native.digest, producer])?,
            parts=[f"native {native.digest}", f"graph-producer {producer}"],
        ),
    )


def retain_rust_library_graph(
    facet: LocalFacet,
    declared: RustFacet,
    artifact: Path,
    arguments: list[str],
    environment: Dict[str, str],
    request: RustBuild,
    toolchain: Toolchain,
    native: Key,
) -> Result[None, str]:
    """
    Refresh a stale checked graph only after the native producer's full input/output proof was validated.

    1. Reuse a graph from the current driver generation.
    2. Analyze unchanged native inputs without code generation or dependency-file replacement.
    3. Require unchanged native outputs, inputs and graph producer before replacing the graph and both proofs.
    """
    # 1. The caller holds the producer directory lock across validation and graph publication.
    directory = artifact.parent()
    graph = directory.joinpath(f"{declared.package}.incngraph")
    graph_stamp = directory.joinpath("library.graph-inputs")
    selected = rust_library_graph_key(native, toolchain.driver)?
    if reusable([graph], graph_stamp, selected)?:
        return Ok(None)
    # 2. Graph observation stops after analysis; only its pending graph may be written.
    dependencies = directory.joinpath("library.d")
    native_output = artifact_identity(artifact)?
    dependency_output = artifact_identity(dependencies)?
    observations = compilation_observations(
        Path(facet.project),
        dependencies,
        arguments,
        extern_artifacts(arguments),
        toolchain,
    )?
    pending = directory.joinpath(f"{declared.package}.incngraph.{id()}.checking.pending")
    inspected = ["--rust-codegraph", pending.0, facet.project, "--sysroot", toolchain.sysroot] + graph_arguments(
        arguments,
    )
    invoke_rustc(toolchain.driver, inspected, environment, false, declared.crate_name, Some(toolchain))?
    # 3. A new graph cannot vouch for stale source, a changed native artifact or another observer generation.
    current = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain)?
    if current.digest != native.digest or not inputs_unchanged(dependencies, observations)?:
        return Err(f"Rust producer inputs changed while refreshing {declared.crate_name}'s graph")
    if artifact_identity(artifact)? != native_output or artifact_identity(dependencies)? != dependency_output:
        return Err(f"Rust producer outputs changed while refreshing {declared.crate_name}'s graph")
    if rust_library_graph_key(native, toolchain.driver)?.digest != selected.digest:
        return Err(f"Rust graph producer changed while refreshing {declared.crate_name}")
    place(pending, graph)?
    record(directory.joinpath("library.oven-inputs"), native, [artifact, graph, dependencies])?
    return record(graph_stamp, selected, [graph])


def compile_local_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    _output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    toolchain: Toolchain,
) -> Result[BuiltUnit, str]:
    """
    Compile or reuse one home-owned producer with complete dep-info observations.

    1. Lock the source unit's discovery and try its last complete dependency evidence.
    2. Discover current dependencies on a miss and select the complete native input identity.
    3. Lock that producer, reuse a completed publication or compile through the ordinary producer.
    """
    # 1. Consumers of the same source unit share dependency discovery, never a partial native publication.
    directory = discovery_directory(identity(facet, request.profile))?
    directory.mkdir(true, true).map_err((error) => error.message())?
    discovering = directory.lock_exclusive().map_err((error) => error.message())?
    dependencies = directory.joinpath("library.d")
    arguments = library_compile_arguments(facet, declared, directory, request, built, search)?
    environment = package_environment(facet.project, declared, declared.crate_name)
    if dependencies.is_file():
        match shared_rust_key(facet, directory, arguments, environment, request, toolchain):
            Err(_) => pass
            Ok(key) =>
                selected = producer_directory(key)?
                if selected.is_dir():
                    reading = selected.lock_exclusive().map_err((error) => error.message())?
                    retained = reuse_shared_rust_library(
                        facet,
                        declared,
                        selected,
                        key,
                        request,
                        built,
                        search,
                        toolchain,
                    )?
                    if let Some(unit) = retained:
                        return Ok(unit)
    # 2. A changed source or configuration may discover a different include or tracked environment variable.
    discovered = dependency_arguments(arguments, dependencies) + ["--sysroot", toolchain.sysroot]
    invoke_rustc(request.rustc, discovered, environment, false, declared.crate_name)?
    key = shared_rust_key(facet, directory, arguments, environment, request, toolchain)?
    selected = producer_directory(key)?
    selected.mkdir(true, true).map_err((error) => error.message())?
    # 3. Only this input variant's lock protects its native artifact, graph and completion proofs.
    building = selected.lock_exclusive().map_err((error) => error.message())?
    retained = reuse_shared_rust_library(facet, declared, selected, key, request, built, search, toolchain)?
    if let Some(unit) = retained:
        return Ok(unit)
    publish(selected.joinpath("library.d"), read(dependencies)?)?
    return produce_rust_library(facet, declared, selected, key, request, built, search, toolchain)


def shared_rust_key(
    facet: LocalFacet,
    directory: Path,
    arguments: list[str],
    environment: Dict[str, str],
    request: RustBuild,
    toolchain: Toolchain,
) -> Result[Key, str]:
    """Bind the existing producer proof to content-identified externs and consumer-independent output locations."""
    native = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain)?
    return portable_key(native, directory, arguments)


def reuse_shared_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    directory: Path,
    selected: Key,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    toolchain: Toolchain,
) -> Result[Option[BuiltUnit], str]:
    """
    Reuse a locked producer only with its complete native proof; a new graph observer refreshes only the graph.

    1. Require the requested native identity and every completed output.
    2. Reconcile relocation by exact output and extern bytes, never by artifact names.
    3. Refresh the graph independently and return the same native artifact to this consumer.
    """
    # 1. An entry directory's name alone cannot certify either its inputs or a partial publication.
    artifact = match library_artifact(directory, declared.crate_name, identity(facet, request.profile), declared.kind)?:
        None => return Ok(None)
        Some(path) => path

    arguments = library_compile_arguments(facet, declared, directory, request, built, search)?
    environment = package_environment(facet.project, declared, declared.crate_name)
    native = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain)?
    portable = portable_key(native, directory, arguments)?
    if portable.digest != selected.digest:
        return Ok(None)
    # 2. Installed generations and shared entries obey one complete producer/relocation proof policy.
    if not retain_current_rust_library(
        facet,
        declared,
        artifact,
        arguments,
        environment,
        request,
        toolchain,
        native,
        portable,
    )?:
        return Ok(None)
    # 3. A different graph producer does not invalidate native compilation.
    trace(f"unit {declared.crate_name} rust: reused shared producer")
    return Ok(
        Some(
            BuiltUnit(
                crate_name=declared.crate_name,
                artifact=artifact.0,
                directory=directory.0,
                reused=true,
                search=facet_search(facet, built)?,
            ),
        ),
    )


def retain_current_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    artifact: Path,
    arguments: list[str],
    environment: Dict[str, str],
    request: RustBuild,
    toolchain: Toolchain,
    native: Key,
    portable: Key,
) -> Result[bool, str]:
    """
    Validate a locked native producer under the same proof policy for installed generations and shared entries.

    1. Require complete outputs and either current filesystem identities or an exact relocation content proof.
    2. Refresh a changed graph observer without compiling native code.
    3. Retain the completed output content proof for later relocation.
    """
    directory = artifact.parent()
    graph = directory.joinpath(f"{declared.package}.incngraph")
    outputs = [artifact, graph, directory.joinpath("library.d")]
    stamp = directory.joinpath("library.oven-inputs")
    # 1. A moved store still needs its completed proof and stable current inputs.
    if not reusable(outputs, stamp, native)?:
        if not stamp.is_file() or not portable_reusable(directory, portable, outputs)?:
            return Ok(false)
        current = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain)?
        if current.digest != native.digest:
            return Err(f"Rust producer inputs changed while verifying {declared.crate_name}")
        record(stamp, native, outputs)?
    # 2. The graph producer has its own identity and cannot authorize stale native inputs.
    retain_rust_library_graph(facet, declared, artifact, arguments, environment, request, toolchain, native)?
    # 3. Only completed and validated producers receive a portable proof.
    record_portable(directory, portable, outputs)?
    return Ok(true)


def produce_rust_library(
    facet: LocalFacet,
    declared: RustFacet,
    directory: Path,
    selected: Key,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    toolchain: Toolchain,
) -> Result[BuiltUnit, str]:
    """
    Compile a locked native producer through the ordinary driver and publish only unchanged complete inputs.

    1. Withdraw any old proof and observe the discovered native inputs.
    2. Compile the native artifact and checked graph together.
    3. Require the selected identity and unchanged inputs before publishing completion proofs.
    """
    # 1. The discovery prepass already recorded every include and environment dependency.
    stamp = directory.joinpath("library.oven-inputs")
    if stamp.is_file():
        stamp.unlink().map_err((error) => error.message())?
    dependencies = directory.joinpath("library.d")
    arguments = library_compile_arguments(facet, declared, directory, request, built, search)?
    environment = package_environment(facet.project, declared, declared.crate_name)
    observations = compilation_observations(
        Path(facet.project),
        dependencies,
        arguments,
        extern_artifacts(arguments),
        toolchain,
    )?
    # 2. Native code generation and graph collection remain one existing producer invocation.
    trace(f"unit {declared.crate_name} rust: compiled (no current library proof)")
    pending = directory.joinpath(f"{declared.package}.incngraph.{id()}.pending")
    graph_arguments = ["--rust-compile-codegraph", pending.0, facet.project, "--sysroot", toolchain.sysroot] + arguments
    invoke_rustc(toolchain.driver, graph_arguments, environment, false, declared.crate_name, Some(toolchain))?
    # 3. Publish the graph and stamp the complete successful output set.
    graph = directory.joinpath(f"{declared.package}.incngraph")
    place(pending, graph)?
    unit = identity(facet, request.profile)
    match library_artifact(directory, declared.crate_name, unit, declared.kind)?:
        None => return Err(f"rustc wrote no library for {declared.crate_name} into {directory.0}")
        Some(artifact) =>
            key = rust_library_producer_key(facet, directory, arguments, environment, request, toolchain)?
            portable = portable_key(key, directory, arguments)?
            if portable.digest != selected.digest or not inputs_unchanged(dependencies, observations)?:
                return Err(f"Rust producer inputs changed while compiling {declared.crate_name}")
            record(stamp, key, [artifact, graph, dependencies])?
            record(directory.joinpath("library.graph-inputs"), rust_library_graph_key(key, toolchain.driver)?, [graph])?
            record_portable(directory, portable, [artifact, graph, dependencies])?
            return Ok(
                BuiltUnit(
                    crate_name=declared.crate_name,
                    artifact=artifact.0,
                    directory=directory.0,
                    search=facet_search(facet, built)?,
                ),
            )


def library_artifact(directory: Path, crate_name: str, unit: str, kind: str) -> Result[Option[Path], str]:
    """Find the selected library kind before and after compilation, ignoring artifacts from a previous kind."""
    for candidate in directory.iterdir().map_err((error) => error.message())?:
        name = candidate.name()
        if not name.startswith(f"lib{crate_name}-{unit}."):
            continue
        if kind in ["lib", "rlib"] and name.endswith(".rlib"):
            return Ok(Some(candidate))
        if kind not in ["lib", "rlib"] and (name.endswith(".dylib") or name.endswith(".so")):
            return Ok(Some(candidate))
    return Ok(None)


def compile_incan_library(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[BuiltUnit, str]:
    """
    Compile an Incan provider with the installed compiler, preserving the activated facet's features and profile.

    1. Describe the library with the features the shared local graph selected.
    2. Compile its complete Loaf artifact through the ordinary Incan unit compiler.
    3. Return its exact rlib to the Rust consumer.
    """
    # 1. The graph's selected profile and features identify the provider's artifact.
    root = Path(request.project).resolve().map_err((error) => error.message())?
    directory = dependency_artifact_dir(root.0, declared.package, request.profile)
    compiled_name = declared.package.replace("-", "_")
    artifact = directory.joinpath(f"lib{compiled_name}.rlib")
    mut bindings = facet_bindings(facet, built, request.registry)?
    mut dependency_search = facet_search(facet, built)?
    if declared.kind != "incan":
        native = compile_rust_library(facet, declared, output, request, built, search)?
        bindings.append(NativeCrate(name=native.crate_name, path=native.artifact))
        dependency_search = dependency_search + [native.directory] + native.search
    loaves = incan_artifacts(built)
    # 2. The graph already prepared every dependency; the source compiler only binds these selected artifacts.
    mut code: i32 = 1
    mut readings = NativeClosureInput()
    match request.incan_compiler:
        Some(compile) =>
            source = library_source(Path(facet.project), request.manifests)?
            selected = [(binding.name, binding.path) for binding in bindings]
            toolchain = selected_toolchain(request)?
            readings = toolchain.native_closures
            code = compile(
                source.0,
                request.profile,
                facet.features,
                artifact.0,
                selected,
                loaves,
                dependency_search,
                toolchain,
                request.compiler,
                request.manifests,
            )?
        None => return Err(f"no Incan unit compiler was supplied for {declared.package}")
    if code != 0:
        return Err(f"Incan library {declared.package} failed with exit code {code}")
    # 3. Rust's extern edge names the same public facade an Incan consumer receives.
    return Ok(
        BuiltUnit(
            crate_name=compiled_name,
            artifact=artifact.0,
            directory=directory.0,
            search=native_search(directory.joinpath(f"{declared.package}.native.json"), readings)?,
            loaf=declared.package,
        ),
    )


pub def native_search(closure: Path, readings: NativeClosureInput = NativeClosureInput()) -> Result[list[str], str]:
    """Read a Loaf's transitive search directories, resolving packed paths relative to its artifact directory."""
    if not closure.is_file():
        return Ok([])
    return closure_search(closure, readings.read(closure)?)


pub def closure_search(closure: Path, document: JsonValue) -> Result[list[str], str]:
    """The search directories of the native closure `document` read from `closure`, resolved beside it."""
    match strings(field(document, "search", []).map_err((_) => f"{closure.0}: missing search")?, ["search"]):
        Err(_) => return Err(f"{closure.0}: search is not a list of directories")
        Ok(directories) => return Ok([located(closure.parent(), directory) for directory in directories])


def extern_artifacts(arguments: list[str]) -> list[str]:
    """The libraries a unit links: the file each `--extern alias=file` names."""
    return extern_paths(arguments)


pub def library_arguments(declared: RustFacet) -> list[str]:
    """The crate selection shared by compilation and inspection; linking remains facet-owned."""
    mut arguments = [declared.library, "--crate-name", declared.crate_name]
    arguments = arguments + ["--crate-type", declared.kind, "--edition", declared.edition]
    if declared.kind == "proc-macro":
        arguments = arguments + ["--extern", "proc_macro"]
    return arguments


pub def compile_binary(
    name: str,
    source: str,
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    testing: bool = false,
    test_role: str = "unit",
    root_library_key: str = "",
) -> Result[str, str]:
    """
    Reuse or compile one root binary, publishing only a complete executable bound to its inputs.

    1. Name the binary and the crate it compiles from.
    2. Link the root's own library, then everything the facet links.
    3. A binary that links the toolchain's own libraries carries the runpaths to find them.
    4. Reuse an unchanged binary, or compile and atomically publish it.
    """
    # 1. The binary is named after its `[[rust.bin]]` and compiled from its root file, into the profile's `bin`.
    directory = output.joinpath("bin")
    directory.mkdir(true, true).map_err((error) => error.message())?
    mut output_name = name
    if testing:
        output_name = f"{test_role}-{name}-tests"
    binary = directory.joinpath(output_name)
    crate_id = name.replace("-", "_")
    mut arguments = binary_arguments(name, source, facet, declared, request, built, search, testing, root_library_key)?
    # 2. The binary links the root's own library first when it has one, then everything the facet links.
    mut libraries: Option[ToolchainLibraries] = None
    if declared.sysroot:
        libraries = Some(toolchain_libraries(request.rustc, facet.project)?)
    environment = binary_environment(request.rustc, facet.project, declared, crate_id, libraries)?
    # 3. A binary that loads the toolchain's own libraries can find them, wherever its `sysroot` link points.
    if let Some(selected) = libraries:
        arguments = arguments + runpath_arguments(selected)
    # 4. An unchanged binary is reused; otherwise the completed replacement is published atomically.
    stamp = directory.joinpath(f"{output_name}.oven-inputs")
    inputs = binary_key(output_name, source, facet, declared, request, arguments, environment)?
    why = staleness([binary], stamp, inputs)?
    label = f"unit {name} rust binary"
    if why == "":
        trace(f"{label}: reused")
        println(f"reused {name}")
        return Ok(binary.0)
    building = binary.lock_exclusive().map_err((error) => error.message())?
    if reusable([binary], stamp, inputs)?:
        trace(f"{label}: reused (built meanwhile by another command)")
        println(f"reused {name}")
        return Ok(binary.0)
    trace(f"{label}: compiled ({why})")
    staged = directory.joinpath(f"{name}.pending")
    invoke_rustc(request.rustc, arguments + ["-o", staged.0], environment, declared.unstable, name)?
    install_all([staged], [binary], stamp, inputs)?
    println(f"compiled {name}")
    return Ok(binary.0)


pub def binary_arguments(
    name: str,
    source: str,
    facet: LocalFacet,
    declared: RustFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    testing: bool = false,
    root_library_key: str = "",
) -> Result[list[str], str]:
    """Frame crate and link arguments, preserving the planner's explicit host library for a macro test consumer."""
    arguments = [source, "--crate-name", name.replace("-", "_"), "--crate-type", "bin", "--edition", declared.edition]
    mut selected = arguments
    if testing and source == declared.library:
        selected = library_arguments(declared)
    if testing:
        selected.append("--test")
    mut library = root_library_key
    if library == "":
        library = facet.key()
    elif library not in built:
        return Err(f"Rust test graph has no selected production library {library}")
    if library in built and (not testing or source != declared.library):
        selected = selected + ["--extern", f"{declared.crate_name}={built[library].artifact}"]
    return Ok(selected + linking(facet, request, built, search)?)


def runpath_arguments(libraries: ToolchainLibraries) -> list[str]:
    """
    The linker arguments that let a binary find the toolchain's `rustc_driver` and the libraries it links.

    The binary carries runpaths to them and the identity it was built against, which it verifies before it compiles
    anything. The relative runpaths come first, so an installed toolchain runs wherever its `sysroot` link points; the
    building machine's sysroot follows, which keeps a binary without that link (a bootstrap build) runnable. The linker
    also searches `lib`, where a Linux toolchain keeps LLVM as a shared library.
    """
    mut arguments = ["-L", f"native={libraries.sysroot}/lib"]
    for relative in libraries.directories:
        arguments = arguments + ["-C", f"link-arg=-Wl,-rpath,{libraries.origin}/../sysroot/{relative}"]
    for relative in libraries.directories:
        arguments = arguments + ["-C", f"link-arg=-Wl,-rpath,{libraries.sysroot}/{relative}"]
    return arguments


def binary_key(
    name: str,
    source: str,
    facet: LocalFacet,
    declared: RustFacet,
    request: RustBuild,
    arguments: list[str],
    environment: Dict[str, str],
) -> Result[Key, str]:
    """Key a binary's sources, exact rustc, arguments, linked libraries and effective build environment."""
    unit = identity(facet, request.profile)
    ledger = unit_ledger(request.project, f"rust-{request.profile}-bin-{name}-{unit}")
    mut crates = load_ledger(ledger, SETTLE_SECONDS, "")
    compiler = fingerprint([request.rustc, artifact_identity(Path(request.rustc))?, run_text(request.rustc, ["-vV"])?])?
    mut described = [f"binary {name} {declared.package} {declared.version} unstable={declared.unstable}"] + arguments
    for variable in sorted([key for key in environment.keys()]):
        described.append(f"{variable}={environment[variable]}")
    key = rust_key(
        compiler,
        described,
        Path(facet.project).joinpath("loaf.toml"),
        Path(source).parent(),
        extern_artifacts(arguments),
        crates,
    )?
    crates.save()?
    return Ok(key)


pub def binary_environment(
    rustc: str,
    project: str,
    declared: RustFacet,
    name: str,
    retained: Option[ToolchainLibraries] = None,
) -> Result[Dict[str, str], str]:
    """The package and pinned-driver identity environment shared by binary compilation and analysis."""
    mut environment = package_environment(project, declared, name)
    if declared.sysroot:
        libraries = binary_libraries(rustc, project, retained)?
        for variable in sorted([key for key in libraries.environment.keys()]):
            value = libraries.environment[variable]
            environment[variable] = value
    return Ok(environment)


def binary_libraries(rustc: str, project: str, retained: Option[ToolchainLibraries]) -> Result[ToolchainLibraries, str]:
    """Reuse the binary's selected toolchain libraries during both argument and environment construction."""
    match retained:
        Some(selected) => return Ok(selected)
        None => return toolchain_libraries(rustc, project)


model ToolchainLibraries:
    """Compile-time and runtime directories, with the exact identity of the first loadable pinned driver copy."""

    # The runpath directories, relative to a sysroot: `lib`, which holds `rustc_driver` beside the libraries it loads
    # itself, then `lib/rustlib/<host>/lib`, which holds the host's Rust standard libraries.
    directories: list[str]
    # The building machine's sysroot: the link search root and the fallback for a binary without a `sysroot` link.
    sysroot: str
    # The loader's token for the binary's own directory, so `<origin>/../sysroot` is the `sysroot` link beside `bin`.
    origin: str
    # `INCAN_DRIVER_RUSTC_IDENTITY`, `_LIBRARY` (relative to the sysroot) and `_LIBRARY_DIGEST`: content, not location.
    environment: Dict[str, str]


def toolchain_libraries(rustc: str, project: str) -> Result[ToolchainLibraries, str]:
    """
    The pinned toolchain's one `rustc_driver` library (in `lib`) and its identity.

    1. Ask the pinned rustc for its sysroot and host.
    2. The toolchain's `lib` holds exactly one `rustc_driver`. The rustc-dev component keeps a byte-identical copy in
       `lib/rustlib/<host>/lib`, but only the copy in `lib` finds the libraries it loads itself, such as a Linux
       toolchain's shared LLVM: an ELF loader resolves a library's dependencies through that library's own runpath.
    3. Its identity is the compiler's version output and the digest of the library's bytes.
    """
    # 1. The sysroot and host triple are the pinned compiler's own, so the library found is the one it was built with.
    sysroot = run_text(rustc, ["--print", "sysroot"])?.strip()
    compiler = run_text(rustc, ["-vV"])?
    mut host = ""
    for line in compiler.split("\n"):
        if line.startswith("host: "):
            host = line[6:].strip()
    relative = "lib"
    directory = Path(sysroot).joinpath(relative)
    # 2. Two `rustc_driver` libraries, or none, leave it unsaid which one the binary is built against.
    mut found: list[Path] = []
    for candidate in directory.iterdir().map_err((error) => f"{directory.0}: {error.message()}")?:
        name = candidate.name()
        if name.startswith("librustc_driver-") and is_dynamic_library(name):
            found.append(candidate)
    if len(found) != 1:
        holds = f"{directory.0} holds {len(found)} rustc_driver libraries"
        return Err(f"{holds}; the rustc component gives exactly one")
    # 3. The identity is content, not location: the compiler's version output and the digest of the library's bytes.
    library = found[0]
    mut observations = load_ledger(unit_ledger(project, "rustc-driver"), SETTLE_SECONDS, "")
    digest = observations.digest(library)?
    observations.save()?
    environment: Dict[str, str] = {"INCAN_DRIVER_RUSTC_IDENTITY": compiler, "INCAN_DRIVER_LIBRARY": f"{relative}/{library.name()}", "INCAN_DRIVER_LIBRARY_DIGEST": digest}
    mut origin = "$ORIGIN"
    if host.endswith("apple-darwin"):
        origin = "@loader_path"
    return Ok(
        ToolchainLibraries(
            directories=[relative, f"lib/rustlib/{host}/lib"],
            sysroot=sysroot,
            origin=origin,
            environment=environment,
        ),
    )


def invoke_rustc(
    rustc: str,
    arguments: list[str],
    environment: Dict[str, str],
    unstable: bool,
    unit: str,
    driver: Option[Toolchain] = None,
) -> Result[None, str]:
    """Run the pinned rustc for one unit; a failure carries rustc's diagnostics."""
    mut command = Command.new(rustc)
    if let Some(toolchain) = driver:
        command = driver_command(toolchain)?
    for argument in arguments:
        command.arg(argument)
    for name in sorted([key for key in environment.keys()]):
        value = environment[name]
        command.env(name, value)
    command.env_remove("RUSTC_BOOTSTRAP")
    if unstable:
        command.env("RUSTC_BOOTSTRAP", "1")
    match command.output():
        Err(error) => return Err(f"cannot run {rustc}: {error}")
        Ok(result) =>
            if result.status.success():
                return Ok(None)
            return Err(f"rustc failed for {unit}:\n{decoded(result.stderr)}")


def declared_binaries(document: TomlValue) -> Result[list[TomlValue], str]:
    """The `[[rust.bin]]` tables of a manifest."""
    root = document.as_table().map_err((error) => error.message())?
    if "rust" not in root:
        return Ok([])
    facet = root["rust"].as_table().map_err((error) => error.message())?
    if "bin" not in facet:
        return Ok([])
    return facet["bin"].as_array().map_err((error) => error.message())


pub def package_environment(project: str, declared: RustFacet, crate_name: str) -> Dict[str, str]:
    """The package environment Rust code reads at compile time (`env!`), under the names the Rust ecosystem uses."""
    mut environment: Dict[str, str] = {"CARGO_PKG_NAME": declared.package, "CARGO_PKG_VERSION": declared.version, "CARGO_MANIFEST_DIR": project, "CARGO_CRATE_NAME": crate_name, "CARGO_PKG_AUTHORS": "", "CARGO_PKG_DESCRIPTION": ""}
    release = declared.version.split("-")
    mut pre = ""
    if len(release) > 1:
        pre = "-".join(release[1:])
    numbers = release[0].split(".")
    names = ["CARGO_PKG_VERSION_MAJOR", "CARGO_PKG_VERSION_MINOR", "CARGO_PKG_VERSION_PATCH"]
    for index in range(3):
        mut number = "0"
        if index < len(numbers):
            number = numbers[index]
        environment[names[index]] = number
    environment["CARGO_PKG_VERSION_PRE"] = pre
    return environment
