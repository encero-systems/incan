"""
Rust units: a local Loaf's Rust facet and the local facets it reaches, compiled with one `rustc` per unit against
compiled registry units (DD-0008).

The graph is `loaf_local_graph.local_facets`. Each unit compiles after the local units it links. A unit's output lives
under the root project's target directory, named by the unit's identity: its project, domain, features and profile.
Registry units come compiled: their rlibs by root name and the directories their dependencies live in.

Each Rust library also records its graph-selected externs and search directories in `native.json`. Release assembly
uses those bindings instead of inferring a dependency's identity from an artifact directory.
"""

from rust::std::process import Command, id
from rust::std::string import String as RustString
from std.toml import TomlValue
from std.fs import Path
from std.json import JsonValue
from std.hash import sha256
from std.encoding.hex import hexlify
from codegen import optimization_level
from files import json_text, parse_json, read, read_json
from home import unit_ledger
from json_fields import field, required_items, required_text, strings
from loaf_local_graph import LocalDemand, LocalFacet, local_facets
from observation import SETTLE_SECONDS, load_ledger, trace
from publication import place, publish
from rust_activation import CfgSnapshot, DependencyDomain, TargetConfiguration, version_matches
from semver_req import compare_version_order, parse_version
from toml_fields import optional_string, optional_strings, read_manifest, required_string
from toolchain import NativeCrate, Toolchain, load_toolchain, located
from unit_freshness import (
    Key, artifact_identity, compiler_fingerprint, fingerprint, install_all, record, reusable, rust_key, staleness,
)
from rust_freshness import compilation_observations, inputs_unchanged, library_key


# The schema of the receipt a build leaves of the libraries it built.
const RECEIPT_SCHEMA: str = "incan.rust-units/1"
# The schema of the registry closure a toolchain ships.
const CLOSURE_SCHEMA: str = "incan.oven.closure/1"


@derive(Eq)
pub model RegistryUnit:
    """One compiled registry unit: its package, version and domain, and the directory its artifacts are in."""

    pub loaf: str
    pub version: str
    pub domain: str
    pub directory: str
    # Whether the stored unit was kept because nothing it was built from had changed.
    pub reused: bool = false
    pub features: list[str] = []


pub model RegistrySelection:
    """What a facet asks of the registry for one dependency: the Loaf, its version requirement and its features."""

    pub loaf: str
    pub requirement: str
    pub features: list[str]


pub model RegistryUnits:
    """Compiled registry units, and every directory they live in."""

    pub units: list[RegistryUnit]
    pub search: list[str]

    def artifact_for(self, selection: RegistrySelection, domain: str) -> Result[str, str]:
        """The library `artifact` selects for what a facet asked of the registry."""
        return self.artifact(selection.loaf, selection.requirement, domain, selection.features)

    def artifact(self, loaf: str, requirement: str, domain: str, features: list[str] = []) -> Result[str, str]:
        """
        The single library of the highest compiled compatible version with every requested feature, preferring
        `domain` and otherwise using the other native domain. An ambiguous artifact directory is refused.

        1. Take the highest qualifying version of `loaf` from the first of `domain`, `host` and `target` that has one.
        2. No qualifying unit is an error.
        3. The unit's directory holds exactly one library.
        """
        # 1. The preferred domain wins when it has a qualifying unit, and the newest version of the winning domain.
        best = self.best_unit(loaf, requirement, domain, features)?
        # 2. A request nothing compiled can serve is an error that names what was asked.
        match best:
            None => return Err(f"no compiled registry unit of {loaf} satisfies {requirement} with features {features}")
            Some(unit) =>
                # 3. A unit directory with no library, or with several, is refused rather than guessed at.
                return sole_library(unit)

    def best_unit(
        self,
        loaf: str,
        requirement: str,
        domain: str,
        features: list[str],
    ) -> Result[Option[RegistryUnit], str]:
        """The highest-versioned compiled unit of `loaf` that qualifies, from the first domain that has one."""
        mut best: Option[RegistryUnit] = None
        for preferred in [domain, "host", "target"]:
            for unit in self.units:
                if unit.loaf != loaf or unit.domain != preferred:
                    continue
                if not qualifies(unit, requirement, features)?:
                    continue
                match best:
                    None => best = Some(unit)
                    Some(current) =>
                        if newer(unit, current)?:
                            best = Some(unit)
            if best != None:
                break
        return Ok(best)


def qualifies(unit: RegistryUnit, requirement: str, features: list[str]) -> Result[bool, str]:
    """Whether a compiled unit's version meets `requirement` and it was built with every requested feature."""
    if not version_matches(requirement, unit.version, unit.loaf).map_err((error) => error.message())?:
        return Ok(false)
    return Ok(len([feature for feature in features if feature not in unit.features]) == 0)


def newer(unit: RegistryUnit, current: RegistryUnit) -> Result[bool, str]:
    """Whether `unit` is of a higher version than `current`."""
    return Ok(compare_version_order(parse_version(unit.version)?, parse_version(current.version)?) > 0)


def sole_library(unit: RegistryUnit) -> Result[str, str]:
    """The one library in a compiled unit's artifact directory; none, or several, are refused."""
    mut artifacts: list[str] = []
    for candidate in Path(unit.directory).iterdir().map_err((error) => error.message())?:
        name = candidate.name()
        if name.startswith("lib") and is_rust_library(name):
            artifacts.append(candidate.0)
    if len(artifacts) != 1:
        return Err(
            f"the compiled unit of {unit.loaf} {unit.version} has {len(artifacts)} libraries in {unit.directory}; "
            + "expected exactly one",
        )
    return Ok(artifacts[0])


def is_rust_library(name: str) -> bool:
    """Whether a file name is a Rust library: a static `rlib` or a dynamic library."""
    return name.endswith(".rlib") or is_dynamic_library(name)


def is_dynamic_library(name: str) -> bool:
    """Whether a file name is a dynamic library, as macOS or Linux names one."""
    return name.endswith(".dylib") or name.endswith(".so")


pub model RustFacet:
    """What a local Loaf's manifest says about its Rust crate."""

    pub crate_name: str
    # `lib` or `proc-macro`; empty when the Loaf has no library crate.
    pub kind: str
    pub edition: str
    # The library crate's root file, when there is one.
    pub library: str
    # The `[[rust.bin]]` crates: name and root file.
    pub binaries: list[Tuple[str, str]]
    # The package name and version the unit is compiled as.
    pub package: str
    pub version: str
    # Whether a binary needs the toolchain's unstable features (`unstable_features`).
    pub unstable: bool
    # Whether a binary links the toolchain's own libraries (`sysroot_dependencies`) and finds them at run time.
    pub sysroot: bool


pub model BuiltUnit:
    """One compiled local unit: what its dependents pass as `--extern`, and where its outputs are."""

    pub crate_name: str
    pub artifact: str
    pub directory: str
    # Whether the stored unit was kept because nothing it was built from had changed.
    pub reused: bool = false


pub def read_registry_units(path: Path) -> Result[RegistryUnits, str]:
    """
    Registry units from a closure result (`incan.oven.closure/1`): every compiled unit and its store directory.

    1. The document is a closure of this version.
    2. The store's entries directory follows from the artifact of the first extern.
    3. Each unit is read with its store directory, and those directories are the search path.
    """
    # 1. Only a closure of this version describes units the way the rest of Oven reads them.
    document = read_json(path)?
    schema = required_text(document, "schema")?
    if schema != CLOSURE_SCHEMA:
        return Err(f"{path.0}: expected {CLOSURE_SCHEMA}, found {schema}")
    # 2. The store keeps all its entries side by side, so one extern's artifact path locates them all.
    entries = entries_directory(document, path)?
    # 3. Each unit knows its own artifact directory, and every such directory is searched for dependencies.
    mut units: list[RegistryUnit] = []
    mut search: list[str] = []
    for item in required_items(document, "units")?:
        unit = registry_unit(item, entries)?
        units.append(unit)
        if unit.directory not in search:
            search.append(unit.directory)
    return Ok(RegistryUnits(units=units, search=search))


def entries_directory(document: JsonValue, path: Path) -> Result[str, str]:
    """The directory of the store's entries, three levels above the artifact of the first extern of a closure."""
    externs = document.require("externs").map_err((error) => error.message())?
    for name in externs.keys():
        extern = externs.require(name).map_err((error) => error.message())?
        artifact = required_text(extern, "path")?
        # An extern's path is absolute, or relative to the closure document (a packed toolchain's registry).
        return Ok(Path(located(path.parent(), artifact)).parent().parent().parent().0)
    return Err(f"{path.0} names no compiled unit")


def registry_unit(item: JsonValue, entries: str) -> Result[RegistryUnit, str]:
    """One compiled unit of a closure, with the artifact directory its store entry holds."""
    entry = required_text(item, "entry")?
    directory = Path(entries).joinpath(entry.replace(":", "-")).joinpath("artifacts").0
    return Ok(
        RegistryUnit(
            loaf=required_text(item, "loaf")?,
            version=required_text(item, "version")?,
            domain=required_text(item, "domain")?,
            directory=directory,
            features=registry_features(item)?,
        ),
    )


pub def registry_features(value: JsonValue) -> Result[list[str], str]:
    """The explicit features of a registry request or prepared unit, refusing malformed closure input."""
    selected = field(value, "features", []).map_err((_) => "registry unit or request names no features")?
    return strings(selected, ["features"]).map_err((_) => "registry features must be a list of strings")


pub def registry_selection(selected: JsonValue) -> Result[RegistrySelection, str]:
    """What one registry request of a facet asks for: its Loaf, its version requirement and its features."""
    loaf = required_text(selected, "loaf")?
    requirement = required_text(selected, "req")?
    return Ok(RegistrySelection(loaf=loaf, requirement=requirement, features=registry_features(selected)?))


pub def target_configuration(rustc: str) -> Result[TargetConfiguration, str]:
    """The host target and its complete `cfg`, as the pinned rustc prints them."""
    host = run_text(rustc, ["-vV"])?
    mut triple = ""
    for line in host.split("\n"):
        if line.startswith("host: "):
            triple = line[6:].strip()
    if triple == "":
        return Err(f"{rustc} -vV names no host")
    printed = run_text(rustc, ["--print", "cfg", "--target", triple])?
    mut flags: list[str] = []
    mut values: Dict[str, list[str]] = {}
    for line in printed.split("\n"):
        entry = line.strip()
        if entry == "":
            continue
        if "=" in entry:
            parts = entry.split("=")
            name = parts[0]
            value = unquoted("=".join(parts[1:]))
            mut known: list[str] = []
            if name in values:
                known = values[name]
            known.append(value)
            values[name] = known
        else:
            flags.append(entry)
    return Ok(TargetConfiguration(triple=triple, cfg=Some(CfgSnapshot(flags=flags, values=values))))


def run_text(program: str, arguments: list[str]) -> Result[str, str]:
    """Run a program to completion and return its stdout; a failure returns its stderr."""
    mut command = Command.new(program)
    for argument in arguments:
        command.arg(argument)
    match command.output():
        Err(error) => return Err(f"cannot run {program}: {error}")
        Ok(output) =>
            stdout = decoded(output.stdout)
            if not output.status.success():
                return Err(f"{program} {' '.join(arguments)} failed:\n{decoded(output.stderr)}")
            return Ok(stdout)


pub def decoded(bytes: bytes) -> str:
    """Process output as text; output that is not UTF-8 is named, not repaired."""
    match RustString.from_utf8(bytes):
        Ok(text) => return str(text)
        Err(_) => return "(output that is not UTF-8)"


model RustBinaries:
    """The `[[rust.bin]]` crates of a manifest, and what they ask of the toolchain."""

    crates: list[Tuple[str, str]]
    unstable: bool
    sysroot: bool


pub def rust_facet(project: str, required: bool = true) -> Result[RustFacet, str]:
    """
    The Rust crate a local Loaf's manifest declares; an Incan consumer may have no Rust facet of its own.

    1. Read the manifest and name the package, the crate and its edition.
    2. Find the library crate and its type.
    3. Read the `[[rust.bin]]` crates and what they ask of the toolchain.
    4. A Loaf that must declare a Rust crate and declares none is refused.
    """
    root = Path(project)
    # 1. The package, its crate name and its edition come from the manifest, with the documented fallbacks.
    document = read_manifest(root)?
    package = required_string(document, "project.name")?
    crate_name = crate_name_of(document, package)?
    edition = edition_of(document)?
    # 2. A library crate is the `src/lib.rs` of the source root, and the manifest may type it a procedural macro.
    library = library_root(document, root)?.joinpath("src").joinpath("lib.rs")
    kind = library_type(document, library)?
    # 3. Each `[[rust.bin]]` is a crate of its own, and may need unstable features or the toolchain's libraries.
    binaries = read_binaries(document, root)?
    # 4. A Loaf that must have a Rust crate and has neither a library nor a binary is refused, with the reason.
    if required and kind == "" and len(binaries.crates) == 0:
        if root.joinpath("src").joinpath("lib.incn").is_file():
            reason = "its Rust crate comes from compiling it, which this build does not do yet"
            return Err(f"{project} is an Incan Loaf; {reason}")
        return Err(f"{project} declares no Rust crate: no {library.0} and no [[rust.bin]]")
    version = required_string(document, "project.version")?
    mut library_path = ""
    if library.is_file():
        library_path = library.0
    return Ok(
        RustFacet(
            crate_name=crate_name,
            kind=kind,
            edition=edition,
            library=library_path,
            binaries=binaries.crates,
            package=package,
            version=version,
            unstable=binaries.unstable,
            sysroot=binaries.sysroot,
        ),
    )


def crate_name_of(document: TomlValue, package: str) -> Result[str, str]:
    """The crate's name: `rust.name` when declared, else the package's, with underscores for hyphens."""
    match optional_string(document, "rust.name")?:
        Some(declared) => return Ok(declared.replace("-", "_"))
        None => return Ok(package.replace("-", "_"))


def edition_of(document: TomlValue) -> Result[str, str]:
    """The Rust edition: `rust.edition` over `build.rust-edition` over 2024."""
    mut edition = "2024"
    if let Some(declared) = optional_string(document, "build.rust-edition")?:
        edition = declared
    if let Some(declared) = optional_string(document, "rust.edition")?:
        edition = declared
    return Ok(edition)


def library_root(document: TomlValue, root: Path) -> Result[Path, str]:
    """The directory whose `src/lib.rs` is the library crate: `rust.source.root` under the project, else the project."""
    match optional_string(document, "rust.source.root")?:
        Some(declared) => return Ok(root.joinpath(declared))
        None => return Ok(root)


def library_type(document: TomlValue, library: Path) -> Result[str, str]:
    """The library crate's type (`lib` unless `rust.type` says otherwise), or empty when there is no library file."""
    if not library.is_file():
        return Ok("")
    match optional_string(document, "rust.type")?:
        Some(declared) => return Ok(declared)
        None => return Ok("lib")


def read_binaries(document: TomlValue, root: Path) -> Result[RustBinaries, str]:
    """The `[[rust.bin]]` crates, and whether any needs unstable features or the toolchain's own libraries."""
    mut crates: list[Tuple[str, str]] = []
    mut unstable = false
    mut sysroot = false
    for binary in declared_binaries(document)?:
        name = required_string(binary, "name")?
        path = required_string(binary, "path")?
        crates.append((name, root.joinpath(path).0))
        if declares_any(binary, "unstable_features")?:
            unstable = true
        if declares_any(binary, "sysroot_dependencies")?:
            sysroot = true
    return Ok(RustBinaries(crates=crates, unstable=unstable, sysroot=sysroot))


def declares_any(table: TomlValue, key: str) -> Result[bool, str]:
    """Whether a manifest table declares a non-empty list of strings at `key`."""
    match optional_strings(table, key)?:
        Some(names) => return Ok(len(names) > 0)
        None => return Ok(false)


pub def identity(facet: LocalFacet, profile: str) -> str:
    """A unit's identity: its project, domain, features and profile."""
    text = f"{facet.project}\n{facet.domain.value()}\n{','.join(sorted(facet.features))}\n{profile}"
    return hexlify(sha256.digest(text.encode("utf-8")))[0:16]


pub def ordered(facets: list[LocalFacet]) -> Result[list[LocalFacet], str]:
    """The facets in an order where every unit follows the local units it links."""
    mut done: list[str] = []
    mut result: list[LocalFacet] = []
    while len(result) < len(facets):
        mut progressed = false
        for facet in facets:
            if facet.key() in done:
                continue
            mut ready = true
            for edge in facet.local:
                if edge.key() not in done:
                    ready = false
            if ready:
                done.append(facet.key())
                result.append(facet)
                progressed = true
        if not progressed:
            return Err("the local Rust units depend on each other in a cycle")
    return Ok(result)


pub model RustBuild:
    """One build of a local Loaf's Rust facet."""

    pub project: str
    pub profile: str = "debug"
    pub rustc: str = "rustc"
    pub registry: RegistryUnits
    pub features: list[str] = []
    pub default_features: bool = true
    # Loaves to use in place of the Loaf of a package name, wherever the graph reaches it.
    pub substitutes: Dict[str, str] = {}


pub def rust_output(project: Path, profile: str) -> Path:
    """Where a project's Rust units and the receipt of its last build are stored for a profile."""
    return project.joinpath("target").joinpath("incan").joinpath("rust").joinpath(profile)


pub def build_rust(request: RustBuild) -> Result[list[str], str]:
    """
    Compile the project's Rust facet and every local facet it reaches, then its binaries; returns their paths.

    A unit that fails does not stop the others: every unit whose local dependencies compiled is attempted, the units
    that link a failed one are reported as blocked by it, and the build fails with every report.

    1. Activate the graph of local facets and order it, so every unit follows the units it links.
    2. Attempt each facet: one that links a failed unit is blocked by it; any other is compiled.
    3. Any report fails the build, and the error carries them all.
    4. Publish the receipt of the libraries built, which the code graph reads.
    """
    # 1. The graph is the one the pinned rustc's own target selects, and every unit comes after those it links.
    configuration = target_configuration(request.rustc)?
    root = Path(request.project).resolve().map_err((error) => f"{request.project}: {error.message()}")?
    demand = LocalDemand(
        project=root.0,
        domain=DependencyDomain.Target,
        features=request.features,
        defaults=request.default_features,
    )
    facets = ordered(local_facets(demand, configuration, None, request.substitutes)?)?
    output = rust_output(root, request.profile)
    # 2. A unit that fails blocks only the units that link it, so every other unit is still attempted.
    mut built: Dict[str, BuiltUnit] = {}
    mut failed: Dict[str, str] = {}
    mut reports: list[str] = []
    mut search = request.registry.search
    mut binaries: list[str] = []
    for facet in facets:
        blocker = blocking_unit(facet, failed)
        if blocker != "":
            failed[facet.key()] = blocker
            reports.append(f"{facet.project}: blocked by {blocker}")
            continue
        match unit_outputs(facet, root, output, request, built, search):
            Err(reason) =>
                failed[facet.key()] = facet.project
                reports.append(reason)
            Ok(outputs) =>
                unit, programs = outputs
                if let Some(library) = unit:
                    built[facet.key()] = library
                    search.append(library.directory)
                for program in programs:
                    binaries.append(program)
    # 3. A build with any failed or blocked unit fails, and its error carries every report.
    if len(reports) > 0:
        body = "\n\n".join(reports)
        return Err(f"{len(reports)} of {len(facets)} Rust units did not compile:\n\n{body}")
    # 4. The libraries that were built are recorded, so a later code graph finds them without scanning directories.
    publish(output.joinpath("units.json"), json_text(receipt_document(built, false))?)?
    return Ok(binaries)


def blocking_unit(facet: LocalFacet, failed: Dict[str, str]) -> str:
    """The project of the first failed unit the facet links, or empty when it links none."""
    for edge in facet.local:
        if edge.key() in failed:
            return failed[edge.key()]
    return ""


pub def receipt_document(built: Dict[str, BuiltUnit], keyed: bool) -> JsonValue:
    """The receipt of built libraries: each one's crate, artifact and directory, and with `keyed` its unit key."""
    mut units: list[JsonValue] = []
    for key in sorted([key for key in built.keys()]):
        mut fields: Dict[str, JsonValue] = {}
        if keyed:
            fields["key"] = JsonValue.string(key)
        fields["crate"] = JsonValue.string(built[key].crate_name)
        fields["artifact"] = JsonValue.string(built[key].artifact)
        fields["directory"] = JsonValue.string(built[key].directory)
        units.append(JsonValue.object(fields))
    return JsonValue.object({"schema": JsonValue.string(RECEIPT_SCHEMA), "units": JsonValue.array(units)})


pub def read_receipt(path: Path, keyed: bool = false) -> Result[Dict[str, BuiltUnit], str]:
    """
    The exact native libraries a build recorded in its receipt, by crate name or, with `keyed`, by unit key.

    A library is never selected by scanning directories, and one whose artifact is gone is left out.
    """
    if not path.is_file():
        return Ok({})
    receipt = parse_json(read(path)?)?
    if required_text(receipt, "schema")? != RECEIPT_SCHEMA:
        return Err(f"{path.0}: unsupported native unit receipt")
    mut result: Dict[str, BuiltUnit] = {}
    for item in required_items(receipt, "units")?:
        name = required_text(item, "crate")?
        artifact = required_text(item, "artifact")?
        directory = required_text(item, "directory")?
        mut key = name
        if keyed:
            key = required_text(item, "key")?
        if key in result:
            return Err(f"{path.0}: ambiguous native library {name}")
        if Path(artifact).is_file():
            result[key] = BuiltUnit(crate_name=name, artifact=artifact, directory=directory)
    return Ok(result)


pub def build_dependencies(
    request: RustBuild,
    facets: list[LocalFacet],
    include_root: bool = true,
) -> Result[Dict[str, BuiltUnit], str]:
    """
    Build the Rust facets a consumer reaches through the shared unit compiler.

    Analysis may leave out the project's own library (`include_root` false) when no binary links it.
    """
    output = rust_output(Path(request.project), request.profile)
    mut built: Dict[str, BuiltUnit] = {}
    mut search = request.registry.search
    for facet in ordered(facets)?:
        own = facet.project == request.project and facet.domain == DependencyDomain.Target
        if own and not include_root:
            continue
        declared = rust_facet(facet.project, not own)?
        if declared.kind == "":
            if own:
                continue
            return Err(f"{facet.project} declares no Rust library")
        unit = compile_library(facet, declared, output, request, built, search)?
        built[facet.key()] = unit
        search.append(unit.directory)
    return Ok(built)


def unit_outputs(
    facet: LocalFacet,
    root: Path,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[Tuple[Option[BuiltUnit], list[str]], str]:
    """Compile one facet's library, and the root facet's binaries."""
    declared = rust_facet(facet.project)?
    mut library: Option[BuiltUnit] = None
    mut local_built = built
    if declared.kind != "":
        unit = compile_library(facet, declared, output, request, built, search)?
        if unit.reused:
            println(f"reused {declared.crate_name} ({facet.domain.value()})")
        else:
            println(f"compiled {declared.crate_name} ({facet.domain.value()})")
        local_built[facet.key()] = unit
        library = Some(unit)
        publish_native_inputs(facet, request, built, search, unit)?
    mut programs: list[str] = []
    if facet.project == root.0 and facet.domain == DependencyDomain.Target:
        for name, source in declared.binaries:
            programs.append(compile_binary(name, source, facet, declared, output, request, local_built, search)?)
    return Ok((library, programs))


pub def linking(
    facet: LocalFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[list[str], str]:
    """
    The arguments that link a unit.

    1. Its features, as `--cfg`.
    2. The search directories.
    3. One `--extern` per local edge, then one per registry edge.
    4. The optimization and debug settings of the profile.
    """
    # 1. The unit's code sees the features the graph activated, as `cfg(feature = ...)`.
    mut arguments: list[str] = []
    for feature in facet.features:
        arguments.append("--cfg")
        arguments.append(f"feature=\"{feature}\"")
    # 2. The libraries the unit links, and what they link in turn, are found in the search directories given.
    for directory in search:
        arguments.append("-L")
        arguments.append(f"dependency={directory}")
    # 3. Each edge names its library exactly, local edges first, so no library is chosen by scanning a directory.
    arguments = arguments + local_externs(facet, built)? + registry_externs(facet, request)?
    # 4. A release build optimizes, and no build carries debug information.
    if request.profile == "release":
        arguments.append("-C")
        arguments.append(f"opt-level={optimization_level(request.profile)}")
    arguments.append("-C")
    arguments.append("debuginfo=0")
    return Ok(arguments)


def local_externs(facet: LocalFacet, built: Dict[str, BuiltUnit]) -> Result[list[str], str]:
    """One `--extern alias=library` per local edge; an edge whose unit is not built is an error."""
    return Ok(extern_arguments(local_bindings(facet, built)?))


def local_bindings(facet: LocalFacet, built: Dict[str, BuiltUnit]) -> Result[list[NativeCrate], str]:
    """Retain each local graph edge's exact alias and built artifact for compilation and its native receipt."""
    mut bindings: list[NativeCrate] = []
    for edge in facet.local:
        if edge.key() not in built:
            return Err(f"{facet.project} links {edge.alias}, which has no compiled library")
        bindings.append(NativeCrate(name=edge.alias.replace("-", "_"), path=built[edge.key()].artifact))
    return Ok(bindings)


def registry_externs(facet: LocalFacet, request: RustBuild) -> Result[list[str], str]:
    """One `--extern alias=library` per registry edge, naming the edge when no compiled library serves it."""
    return Ok(extern_arguments(registry_bindings(facet, request)?))


def registry_bindings(facet: LocalFacet, request: RustBuild) -> Result[list[NativeCrate], str]:
    """Select registry graph edges through the same version, feature and domain rules used to link the unit."""
    mut bindings: list[NativeCrate] = []
    for index in range(len(facet.registry)):
        alias = facet.registry_aliases[index]
        selection = registry_selection(facet.registry[index])?
        artifact = request.registry.artifact_for(selection, facet.domain.value()).map_err(
            (reason) => f"{facet.project} links `{alias}`: {reason}",
        )?
        bindings.append(NativeCrate(name=alias.replace("-", "_"), path=artifact))
    return Ok(bindings)


def extern_arguments(bindings: list[NativeCrate]) -> list[str]:
    """Render selected structured bindings once at rustc's argument boundary."""
    mut arguments: list[str] = []
    for binding in bindings:
        arguments.append("--extern")
        arguments.append(f"{binding.name}={binding.path}")
    return arguments


def publish_native_inputs(
    facet: LocalFacet,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
    unit: BuiltUnit,
) -> Result[None, str]:
    """Record selected dependencies and search directories, adding the library's own directory for consumers."""
    bindings = local_bindings(facet, built)? + registry_bindings(facet, request)?
    mut externs: list[JsonValue] = []
    for binding in bindings:
        externs.append(JsonValue.array([JsonValue.string(binding.name), JsonValue.string(binding.path)]))
    document = JsonValue.object({
        "schema": JsonValue.string("incan.rust-native/1"),
        "externs": JsonValue.array(externs),
        "search": JsonValue.array([JsonValue.string(directory) for directory in search + [unit.directory]]),
    })
    return publish(Path(unit.directory).joinpath("native.json"), json_text(document)?)


pub def compile_library(
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[BuiltUnit, str]:
    """Reuse one library only with complete current input and output evidence, otherwise compile it.

    1. Describe the compiler command and validate a previous library and graph.
    2. Withdraw the old proof and compile with rustc's dependency evidence.
    3. Publish the graph and stamp the complete successful output set.
    """
    # 1. Describe the compiler command and validate a previous library and graph.
    unit = identity(facet, request.profile)
    directory = output.joinpath(f"{declared.crate_name}-{unit}")
    directory.mkdir(true, true).map_err((error) => error.message())?
    building = directory.lock_exclusive().map_err((error) => error.message())?
    dependencies = directory.joinpath("library.d")
    graph = directory.joinpath(f"{declared.package}.incngraph")
    stamp = directory.joinpath("library.oven-inputs")
    mut arguments = library_arguments(declared)
    arguments = arguments + ["--out-dir", directory.0, "-C", f"metadata={unit}", "-C", f"extra-filename=-{unit}"]
    arguments = arguments + ["--emit", f"link,dep-info={dependencies.0}"]
    arguments = arguments + linking(facet, request, built, search)?
    toolchain = load_toolchain()?
    environment = package_environment(facet.project, declared, declared.crate_name)
    linked = [built[key].artifact for key in sorted([key for key in built.keys()])]
    match library_artifact(directory, declared.crate_name, unit, declared.kind)?:
        None => pass
        Some(artifact) =>
            match library_key(Path(facet.project), directory, dependencies, arguments, environment, linked, toolchain):
                Err(_) => pass
                Ok(key) =>
                    if reusable([artifact, graph, dependencies], stamp, key)?:
                        trace(f"unit {declared.crate_name} rust: reused")
                        return Ok(BuiltUnit(
                            crate_name=declared.crate_name, artifact=artifact.0, directory=directory.0, reused=true,
                        ))
    # 2. Withdraw the old proof and compile with rustc's dependency evidence.
    if stamp.is_file():
        stamp.unlink().map_err((error) => error.message())?
    mut observations: Dict[str, str] = {}
    match compilation_observations(Path(facet.project), dependencies, arguments, linked, toolchain):
        Err(_) => pass
        Ok(captured) => observations = captured
    trace(f"unit {declared.crate_name} rust: compiled (no current library proof)")
    pending = directory.joinpath(f"{declared.package}.incngraph.{id()}.pending")
    graph_arguments = ["--rust-compile-codegraph", pending.0, facet.project, "--sysroot", toolchain.sysroot] + arguments
    invoke_rustc(toolchain.driver, graph_arguments, environment, false, declared.crate_name)?
    # 3. Publish the graph and stamp the complete successful output set.
    place(pending, graph)?
    match library_artifact(directory, declared.crate_name, unit, declared.kind)?:
        None => return Err(f"rustc wrote no library for {declared.crate_name} into {directory.0}")
        Some(artifact) =>
            match library_key(Path(facet.project), directory, dependencies, arguments, environment, linked, toolchain):
                Err(_) => pass
                Ok(key) =>
                    match inputs_unchanged(dependencies, observations):
                        Err(_) => pass
                        Ok(unchanged) =>
                            if unchanged:
                                record(stamp, key, [artifact, graph, dependencies])?
            return Ok(BuiltUnit(crate_name=declared.crate_name, artifact=artifact.0, directory=directory.0))


def library_artifact(directory: Path, crate_name: str, unit: str, kind: str) -> Result[Option[Path], str]:
    """Find the selected library kind before and after compilation, ignoring artifacts from a previous kind."""
    for candidate in directory.iterdir().map_err((error) => error.message())?:
        name = candidate.name()
        if not name.startswith(f"lib{crate_name}-{unit}."):
            continue
        if kind in ["lib", "rlib"] and name.endswith(".rlib"):
            return Ok(Some(candidate))
        if kind not in ["lib", "rlib"] and (name.endswith(".dylib") or name.endswith(".so")):
            return Ok(Some(candidate))
    return Ok(None)


def extern_artifacts(arguments: list[str]) -> list[str]:
    """The libraries a unit links: the file each `--extern alias=file` names."""
    mut artifacts: list[str] = []
    for index in range(len(arguments) - 1):
        if arguments[index] == "--extern" and "=" in arguments[index + 1]:
            artifacts.append(arguments[index + 1].split("=")[1])
    return artifacts


pub def library_arguments(declared: RustFacet) -> list[str]:
    """The crate selection shared by compilation and inspection; linking remains facet-owned."""
    mut arguments = [declared.library, "--crate-name", declared.crate_name]
    arguments = arguments + ["--crate-type", declared.kind, "--edition", declared.edition]
    if declared.kind == "proc-macro":
        arguments = arguments + ["--extern", "proc_macro"]
    return arguments


def compile_binary(
    name: str,
    source: str,
    facet: LocalFacet,
    declared: RustFacet,
    output: Path,
    request: RustBuild,
    built: Dict[str, BuiltUnit],
    search: list[str],
) -> Result[str, str]:
    """
    Reuse or compile one root binary, publishing only a complete executable bound to its inputs.

    1. Name the binary and the crate it compiles from.
    2. Link the root's own library, then everything the facet links.
    3. A binary that links the toolchain's own libraries carries the runpaths to find them.
    4. Reuse an unchanged binary, or compile and atomically publish it.
    """
    # 1. The binary is named after its `[[rust.bin]]` and compiled from its root file, into the profile's `bin`.
    directory = output.joinpath("bin")
    directory.mkdir(true, true).map_err((error) => error.message())?
    binary = directory.joinpath(name)
    crate_id = name.replace("-", "_")
    mut arguments = [source, "--crate-name", crate_id, "--crate-type", "bin", "--edition", declared.edition]
    # 2. The binary links the root's own library first when it has one, then everything the facet links.
    if facet.key() in built:
        arguments = arguments + ["--extern", f"{declared.crate_name}={built[facet.key()].artifact}"]
    arguments = arguments + linking(facet, request, built, search)?
    environment = binary_environment(request.rustc, facet.project, declared, crate_id)?
    # 3. A binary that loads the toolchain's own libraries can find them, wherever its `sysroot` link points.
    if declared.sysroot:
        arguments = arguments + runpath_arguments(toolchain_libraries(request.rustc, facet.project)?)
    # 4. An unchanged binary is reused; otherwise the completed replacement is published atomically.
    stamp = directory.joinpath(f"{name}.oven-inputs")
    inputs = binary_key(name, source, facet, declared, request, arguments, environment)?
    why = staleness([binary], stamp, inputs)?
    label = f"unit {name} rust binary"
    if why == "":
        trace(f"{label}: reused")
        println(f"reused {name}")
        return Ok(binary.0)
    building = binary.lock_exclusive().map_err((error) => error.message())?
    if reusable([binary], stamp, inputs)?:
        trace(f"{label}: reused (built meanwhile by another command)")
        println(f"reused {name}")
        return Ok(binary.0)
    trace(f"{label}: compiled ({why})")
    staged = directory.joinpath(f"{name}.pending")
    invoke_rustc(request.rustc, arguments + ["-o", staged.0], environment, declared.unstable, name)?
    install_all([staged], [binary], stamp, inputs)?
    println(f"compiled {name}")
    return Ok(binary.0)


def runpath_arguments(libraries: ToolchainLibraries) -> list[str]:
    """
    The linker arguments that let a binary find the toolchain's `rustc_driver` in its sysroot.

    The binary carries a runpath to it and the identity it was built against, which it verifies before it compiles
    anything. The first runpath is relative to the binary, so an installed toolchain runs wherever its `sysroot` link
    points; the second, the building machine's sysroot, keeps a binary without that link (a bootstrap build) runnable.
    """
    return [
        "-C",
        f"link-arg=-Wl,-rpath,{libraries.runpath}",
        "-C",
        f"link-arg=-Wl,-rpath,{libraries.directory}",
    ]


def binary_key(
    name: str,
    source: str,
    facet: LocalFacet,
    declared: RustFacet,
    request: RustBuild,
    arguments: list[str],
    environment: Dict[str, str],
) -> Result[Key, str]:
    """Key a binary's sources, exact rustc, arguments, linked libraries and effective build environment."""
    unit = identity(facet, request.profile)
    ledger = unit_ledger(request.project, f"rust-{request.profile}-bin-{name}-{unit}")
    mut crates = load_ledger(ledger, SETTLE_SECONDS, "")
    compiler = fingerprint([
        request.rustc, artifact_identity(Path(request.rustc))?, run_text(request.rustc, ["-vV"])?,
    ])?
    mut described = [f"binary {name} {declared.package} {declared.version} unstable={declared.unstable}"] + arguments
    for variable in sorted([key for key in environment.keys()]):
        described.append(f"{variable}={environment[variable]}")
    key = rust_key(
        compiler, described, Path(facet.project).joinpath("loaf.toml"), Path(source).parent(),
        extern_artifacts(arguments), crates,
    )?
    crates.save()?
    return Ok(key)


pub def binary_environment(rustc: str, project: str, declared: RustFacet, name: str) -> Result[Dict[str, str], str]:
    """The package and pinned-driver identity environment shared by binary compilation and analysis."""
    mut environment = package_environment(project, declared, name)
    if declared.sysroot:
        libraries = toolchain_libraries(rustc, project)?
        for variable in sorted([key for key in libraries.environment.keys()]):
            value = libraries.environment[variable]
            environment[variable] = value
    return Ok(environment)


model ToolchainLibraries:
    """Where the pinned toolchain's `rustc_driver` is, and the identity a binary that links it is built against."""

    # The binary's runpath to the directory of the toolchain's `rustc_driver`, through the `sysroot` link beside the
    # binary's `bin` directory: `<loader token for the binary's directory>/../sysroot/lib/rustlib/<host>/lib`.
    runpath: str
    # The same directory in the building machine's sysroot: the fallback runpath.
    directory: str
    # `INCAN_DRIVER_RUSTC_IDENTITY`, `_LIBRARY` (relative to the sysroot) and `_LIBRARY_DIGEST`: content, not location.
    environment: Dict[str, str]


def toolchain_libraries(rustc: str, project: str) -> Result[ToolchainLibraries, str]:
    """
    The pinned toolchain's one `rustc_driver` library (in `lib/rustlib/<host>/lib`) and its identity.

    1. Ask the pinned rustc for its sysroot and host.
    2. The library directory holds exactly one `rustc_driver`.
    3. Its identity is the compiler's version output and the digest of the library's bytes.
    """
    # 1. The sysroot and host triple are the pinned compiler's own, so the library found is the one it was built with.
    sysroot = run_text(rustc, ["--print", "sysroot"])?.strip()
    compiler = run_text(rustc, ["-vV"])?
    mut host = ""
    for line in compiler.split("\n"):
        if line.startswith("host: "):
            host = line[6:].strip()
    relative = f"lib/rustlib/{host}/lib"
    directory = Path(sysroot).joinpath(relative)
    # 2. Two `rustc_driver` libraries, or none, leave it unsaid which one the binary is built against.
    mut found: list[Path] = []
    for candidate in directory.iterdir().map_err((error) => f"{directory.0}: {error.message()}")?:
        name = candidate.name()
        if name.startswith("librustc_driver-") and is_dynamic_library(name):
            found.append(candidate)
    if len(found) != 1:
        holds = f"{directory.0} holds {len(found)} rustc_driver libraries"
        return Err(f"{holds}; the rustc-dev component gives exactly one")
    # 3. The identity is content, not location: the compiler's version output and the digest of the library's bytes.
    library = found[0]
    mut observations = load_ledger(unit_ledger(project, "rustc-driver"), SETTLE_SECONDS, "")
    digest = observations.digest(library)?
    observations.save()?
    environment: Dict[str, str] = {
        "INCAN_DRIVER_RUSTC_IDENTITY": compiler,
        "INCAN_DRIVER_LIBRARY": f"{relative}/{library.name()}",
        "INCAN_DRIVER_LIBRARY_DIGEST": digest,
    }
    mut origin = "$ORIGIN"
    if host.endswith("apple-darwin"):
        origin = "@loader_path"
    return Ok(
        ToolchainLibraries(runpath=f"{origin}/../sysroot/{relative}", directory=directory.0, environment=environment),
    )


def invoke_rustc(
    rustc: str,
    arguments: list[str],
    environment: Dict[str, str],
    unstable: bool,
    unit: str,
) -> Result[None, str]:
    """Run the pinned rustc for one unit; a failure carries rustc's diagnostics."""
    mut command = Command.new(rustc)
    for argument in arguments:
        command.arg(argument)
    for name in sorted([key for key in environment.keys()]):
        value = environment[name]
        command.env(name, value)
    if unstable:
        command.env("RUSTC_BOOTSTRAP", "1")
    match command.output():
        Err(error) => return Err(f"cannot run {rustc}: {error}")
        Ok(result) =>
            if result.status.success():
                return Ok(None)
            return Err(f"rustc failed for {unit}:\n{decoded(result.stderr)}")


def unquoted(text: str) -> str:
    """A `cfg` value without the quotes rustc prints around it."""
    if len(text) >= 2 and text.startswith("\"") and text.endswith("\""):
        return text[1:len(text) - 1]
    return text


def declared_binaries(document: TomlValue) -> Result[list[TomlValue], str]:
    """The `[[rust.bin]]` tables of a manifest."""
    root = document.as_table().map_err((error) => error.message())?
    if "rust" not in root:
        return Ok([])
    facet = root["rust"].as_table().map_err((error) => error.message())?
    if "bin" not in facet:
        return Ok([])
    return facet["bin"].as_array().map_err((error) => error.message())


pub def package_environment(project: str, declared: RustFacet, crate_name: str) -> Dict[str, str]:
    """The package environment Rust code reads at compile time (`env!`), under the names the Rust ecosystem uses."""
    mut environment: Dict[str, str] = {
        "CARGO_PKG_NAME": declared.package,
        "CARGO_PKG_VERSION": declared.version,
        "CARGO_MANIFEST_DIR": project,
        "CARGO_CRATE_NAME": crate_name,
        "CARGO_PKG_AUTHORS": "",
        "CARGO_PKG_DESCRIPTION": "",
    }
    release = declared.version.split("-")
    mut pre = ""
    if len(release) > 1:
        pre = "-".join(release[1:])
    numbers = release[0].split(".")
    names = ["CARGO_PKG_VERSION_MAJOR", "CARGO_PKG_VERSION_MINOR", "CARGO_PKG_VERSION_PATCH"]
    for index in range(3):
        mut number = "0"
        if index < len(numbers):
            number = numbers[index]
        environment[names[index]] = number
    environment["CARGO_PKG_VERSION_PRE"] = pre
    return environment
