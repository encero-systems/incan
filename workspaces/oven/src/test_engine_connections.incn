"""How a caller connects to a records engine: it waits for a busy engine's Welcome while the engine holds its lifetime
lock, and connects again when the engine exits idle as it connects."""

from core_process import executable
from rust::std::os::unix::fs import symlink
from rust::std::process import Command
from rust::std::str import from_utf8
from rust::std::thread import sleep, spawn
from rust::std::time import Duration, Instant
from std.environ import get_or
from std.fs import Path
from std.json import JsonValue, parse
from files import discard_file
from home_paths import installation_catalog
from lowering_record_fixtures import proof_count, stop_example_engine
from engine_client import service_generation, service_identity
from pub::incan_platform.ipc import Listener, listen
from engine_endpoint import HANDSHAKE_SECONDS, endpoint, handshake, owner_uid, connect_with
from engine_service import greet
from engine_channel import Channel
from engine_messages import Hello
from engine_state import Identity, ServiceState
from scratch import scratch_directory
from engine_wire import joined
from engine_protocol_fixtures import detail, json_text_is
from store_path_conversion import snapshot


pub def test_a_records_client_authenticates_its_bakery_once_before_submit() -> Result[None, str]:
    """A real lock preparation and project lookup share admission, and completion still reopens the committed store."""
    scratch = scratch_directory()?
    root = scratch.path()
    store = root.joinpath("bakery")
    trace = root.joinpath("trace")
    trace.mkdir(true, true).map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    seed = client_project(root.joinpath("seed"))?
    measured = client_project(root.joinpath("measured"))?
    run_client_project(binary, seed, store, None)?
    outcome = run_client_project(binary, measured, store, Some(trace))
    stopped = stop_example_engine(binary, store)
    outcome?
    stopped?
    rows = client_submission_trace(trace)?
    reads = client_submission_reads(rows, store.resolve().map_err((error) => error.message())?)?
    before, after = reads
    println(f"work bakery manifest opens: {before} before Submit, {after} after Complete")
    assert before == 1, f"the same work bakery manifest was opened {before} times before Submit"
    assert after == 1, "the client must read the selected executable after Complete"
    catalog = installation_catalog()?.resolve().map_err((error) => error.message())?
    catalog_reads = client_admission_catalog_reads(rows, catalog)?
    println(f"installation catalog manifest opens in compiler admission: {catalog_reads}")
    assert catalog_reads == 1, f"compiler admission opened the same installation catalog manifest {catalog_reads} times"
    return check_enclosing_view_spelling(binary, root)


def check_enclosing_view_spelling(binary: str, root: Path) -> Result[None, str]:
    """Directory spellings reuse one selected project view while symbolic links and other roots stay distinct."""
    project = root.joinpath("enclosing")
    _ = client_project(project)?
    store = root.joinpath("enclosing-bakery")
    run_project_argument(binary, project, store, [])?
    run_project_argument(binary, project, store, [])?
    before = snapshot(store).map_err((error) => error.message())?
    run_project_argument(binary, project, store, ["src"])?
    equivalent = snapshot(store).map_err((error) => error.message())?
    if equivalent.digest != before.digest:
        stop_example_engine(binary, store)?
        return Err(
            f"equivalent project-directory spelling published generation {equivalent.generation} after {before.generation}"
        )

    linked = root.joinpath("enclosing-link")
    symlink(project.0, linked.0).map_err((error) => str(error))?
    run_project_argument(binary, root, store, [linked.0])?
    through_link = snapshot(store).map_err((error) => error.message())?
    other = root.joinpath("another-project")
    _ = client_project(other)?
    run_project_argument(binary, other, store, [])?
    distinct = snapshot(store).map_err((error) => error.message())?
    stop_example_engine(binary, store)?
    assert len(through_link.views.as_ref()) == len(before.views.as_ref()) + 1
    assert len(distinct.views.as_ref()) == len(through_link.views.as_ref()) + 1
    return Ok(None)


def client_project(project: Path) -> Result[Path, str]:
    """Write a named unit so its CLI takes the ordinary project-lock preparation route."""
    source = project.joinpath("src/main.incn")
    source.parent().mkdir(true, true).map_err((error) => error.message())?
    project.joinpath("loaf.toml").write_text(
        "[project]\nname = \"client_admission_probe\"\nversion = \"0.1.0\"\n[project.scripts]\nmain = \"src/main.incn\"\n",
        "utf-8", "strict", None,
    ).map_err((error) => error.message())?
    source.write_text("def main() -> None:\n    println(\"admitted\")\n", "utf-8", "strict", None).map_err(
        (error) => error.message(),
    )?
    return Ok(source)


def run_client_project(binary: str, source: Path, store: Path, trace: Option[Path]) -> Result[None, str]:
    """Require the same real native stdout before counting the normal client's work."""
    mut command = Command.new(binary)
    command.arg("run").arg(source.0).env("INCAN_ENGINE", "records").env("INCAN_BAKERY", store.0)
    command.env_remove("INCAN_ENGINE_TRACE")
    if let Some(observation) = trace:
        command.env("INCAN_ENGINE_TRACE", observation.0)
    return check_client_output(command)


def run_project_argument(binary: str, project: Path, store: Path, arguments: list[str]) -> Result[None, str]:
    """Invoke one directory spelling through the normal Records command."""
    mut command = Command.new(binary)
    command.arg("run").args(arguments).current_dir(project.0)
    command.env("INCAN_ENGINE", "records").env("INCAN_BAKERY", store.0).env_remove("INCAN_ENGINE_TRACE")
    return check_client_output(command)


def check_client_output(mut command: BorrowedMut[Command]) -> Result[None, str]:
    """Require the exact fixture output on both console streams."""
    outcome = command.output().map_err((error) => str(error))?
    if not outcome.status.success():
        return Err(str(from_utf8(outcome.stderr).map_err((error) => str(error))?))
    assert from_utf8(outcome.stdout).map_err((error) => str(error))? == "admitted\n"
    assert outcome.stderr == b""
    return Ok(None)


def client_submission_trace(trace: Path) -> Result[list[JsonValue], str]:
    """Find the completed CLI copy of the request span, apart from the service and its settlement worker."""
    for file in trace.glob("engine-oven-*.jsonl").map_err((error) => error.message())?:
        source = file.read_text("utf-8", "strict").map_err((error) => error.message())?
        if "\"operation\":\"engine_request\"" in source:
            mut rows: list[JsonValue] = []
            for line in source.split("\n"):
                if line != "":
                    rows.append(parse(line).map_err((error) => error.message())?)
            return Ok(rows)
    return Err("the client emitted no submission span")


def client_admission_catalog_reads(rows: list[JsonValue], catalog: Path) -> Result[int, str]:
    """Count catalog manifest opens during compiler admission, excluding the later capture probe."""
    mut start = 0
    mut finish = 0
    for row in rows:
        if json_text_is(row, "operation", "engine_admission"):
            assert start == 0, "the client admitted its compiler twice"
            start = proof_count(row, "start_ns")?
            finish = proof_count(row, "end_ns")?
    assert start > 0 and finish > start
    mut count = 0
    snapshots = catalog.joinpath("snapshots").0 + "/"
    for row in rows:
        if json_text_is(row, "operation", "store_manifest_read"):
            key = row.require("key").map_err((error) => error.message())?.expect_str().map_err((error) => error.message())?
            if key.startswith(snapshots):
                if proof_count(row, "start_ns")? >= start and proof_count(row, "end_ns")? <= finish:
                    count += 1
    return Ok(count)


def client_submission_reads(rows: list[JsonValue], store: Path) -> Result[tuple[int, int], str]:
    """Count only this work bakery before Submit and after Complete, using the client's host-clock boundaries."""
    mut start = 0
    mut finish = 0
    for row in rows:
        if json_text_is(row, "operation", "engine_request"):
            start = proof_count(row, "start_ns")?
            finish = proof_count(row, "end_ns")?
    assert start > 0 and finish > start
    mut before = 0
    mut after = 0
    for row in rows:
        if json_text_is(row, "operation", "store_manifest_read"):
            path = row.require("key").map_err((error) => error.message())?.expect_str().map_err(
                (error) => error.message(),
            )?
            if path.startswith(store.joinpath("snapshots").0 + "/"):
                if proof_count(row, "end_ns")? <= start:
                    before += 1
                elif proof_count(row, "start_ns")? >= finish:
                    after += 1
    return Ok((before, after))


pub def test_a_caller_waits_for_a_busy_engine_to_answer_hello() -> Result[None, str]:
    """
    An engine answers Hello between requests, so a caller that connects while another caller's build runs is greeted
    only after that build: it waits past the handshake bound for its Welcome while the engine holds its lifetime lock.
    """
    scratch = scratch_directory()?
    store = scratch.path().joinpath("store")
    store.mkdir(true, true).map_err((error) => error.message())?
    identity = Identity(
        store_id="busy-store",
        profile="profile",
        service_generation="service",
        compiler_generation="compiler",
        uid=owner_uid(store).map_err(detail)?,
    )
    selected = endpoint(store, identity).map_err(detail)?
    # The engine holds its lifetime lock for as long as it lives; this test holds it for the busy engine.
    _lifetime = match Path(selected.lock).try_lock_exclusive().map_err((error) => error.message())?:
        Some(lock) => lock
        None => return Err("the test could not hold the engine's lifetime lock")
    listener = listen(selected.socket, true)?
    engine = spawn(() => greet_after_a_build(listener, identity, store))
    started = Instant.now()
    connected = connect_with(store, identity, executable()?)
    waited = int(started.elapsed().as_secs())
    joined = engine.join()
    mut channel = connected.map_err(detail)?
    _ = channel.transport.close()
    match joined:
        Ok(outcome) => outcome?
        Err(_) => return Err("the busy engine thread panicked")
    assert waited >= int(HANDSHAKE_SECONDS), f"the caller was greeted after {waited} s, inside the handshake bound"
    return Ok(None)


pub def test_a_caller_reconnects_when_the_engine_exits_as_it_connects() -> Result[None, str]:
    """
    An engine that exits idle just as a caller connects closes that connection before Welcome. The caller has sent no
    request, so it connects again and starts a fresh engine instead of failing.
    """
    scratch = scratch_directory()?
    store = scratch.path().joinpath("store")
    store.mkdir(true, true).map_err((error) => error.message())?
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    mut identity = service_identity(store)?
    identity.service_generation = service_generation(binary)?
    selected = endpoint(store, identity).map_err(detail)?
    listener = listen(selected.socket, true)?
    exiting = spawn(() => close_as_an_exiting_engine(listener, selected.socket))
    connected = connect_with(store, identity, binary)
    joined = exiting.join()
    mut channel = connected.map_err(detail)?
    _ = channel.transport.close()
    match joined:
        Ok(outcome) => outcome?
        Err(_) => return Err("the exiting engine thread panicked")
    return stop_example_engine(binary, store)


def close_as_an_exiting_engine(listener: Listener, socket: str) -> Result[None, str]:
    """Accept one caller, then withdraw the socket and close the connection, as an engine exiting idle does."""
    mut accepting = listener
    mut caller = accepting.accept()?
    discard_file(Path(socket))
    _ = caller.close()
    return Ok(None)


def greet_after_a_build(listener: Listener, identity: Identity, store: Path) -> Result[None, str]:
    """Accept one caller, stay busy past the handshake bound as a running build does, then greet it."""
    mut accepting = listener
    caller = accepting.accept()?
    sleep(Duration.from_secs(HANDSHAKE_SECONDS))
    sleep(Duration.from_millis(500))
    state = ServiceState(identity=identity, store=store, last_active=0)
    mut client = greet(Channel(transport=caller), state).map_err(detail)?
    # An engine keeps a greeted caller open; this one reads until the caller closes its end.
    while client.channel.receive().is_ok():
        pass
    return Ok(None)
