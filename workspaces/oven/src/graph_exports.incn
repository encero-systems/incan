"""
Checked graph exports are claimed and published once through the home bakery, and read where the bakery binds them:
`graphs/<identity>/` in the bakery, immutable links to the export's payloads, shared by every project and checkout
that reads the export. A binding is complete once its marker exists, so a reader of a bound export makes one status
query.
"""

from std.fs import Path
from std.primitives.locking import LockGuard
from bakery import bakery, claim, find, seal, staging
from bakery_records import Fact
from files import make_directory
from publication import publish
from store_path_conversion import payload_path
from unit_freshness import fingerprint

# The name of a unit's graph inside its export, and of the marker that completes a binding.
const ENTRY: str = "unit.incngraph"
const BOUND: str = ".bound"


pub def exported(identity: str) -> Result[Option[Path], str]:
    """The bound graph of a published export; `None` when it was never published."""
    store = bakery()?
    directory = store.joinpath("graphs").joinpath(identity)
    if directory.joinpath(BOUND).is_file():
        return Ok(Some(directory.joinpath(ENTRY)))
    match find(store, identity)?:
        None => return Ok(None)
        Some(fact) => return Ok(Some(bound(store, fact)?.joinpath(ENTRY)))


pub def claim_export(identity: str) -> Result[LockGuard, str]:
    """Claim this completed export identity; callers recheck after acquiring the claim."""
    return claim(bakery()?, identity)


pub def pending_export(identity: str, provenance: Path, claimed: str = "") -> Result[Path, str]:
    """
    Stage one producer's export privately; unchecked diagnostics are never admitted as a relocatable fact.

    Staging provenance distinguishes equal source at different roots within one request. It is not an input to the
    checked export identity and is never published in a graph record. The producer holds the claim of `claimed`, the
    export identity unless named, which proves the staging alive.
    """
    pending = fingerprint([identity, provenance.0])?
    mut owner = claimed
    if owner == "":
        owner = identity
    return Ok(staging(bakery()?, pending, 0, owner)?.joinpath(ENTRY))


pub def publish_export(identity: str, pending: Path, name: str = "") -> Result[Path, str]:
    """Admit a complete checked graph and its interface, and return the graph where the bakery binds it."""
    store = bakery()?
    mut binding = name
    if binding == "":
        binding = f"graph\t{identity}"
    fact = seal(store, identity, pending.parent(), "graph", binding, [], "checked graph export")?
    return Ok(bound(store, fact)?.joinpath(ENTRY))


def bound(store: Path, fact: Fact) -> Result[Path, str]:
    """
    Bind an export's files to its payloads under one claim, then mark the binding complete; a binder that died first is
    completed by the next one.
    """
    directory = store.joinpath("graphs").joinpath(fact.identity)
    marker = directory.joinpath(BOUND)
    if marker.is_file():
        return Ok(directory)
    held = claim(store, f"graph-binding/{fact.identity}")?
    if marker.is_file():
        return Ok(directory)
    for file in fact.files:
        if file.path == "" or file.path.startswith("/") or ".." in file.path.split("/"):
            return Err("graph export member is not a relative filename")
        target = directory.joinpath(file.path)
        make_directory(target.parent())?
        if target.is_symlink():
            target.unlink().map_err((error) => f"cannot {error.message()}")?
        target.symlink_to(payload_path(store, file.digest)).map_err((error) => f"cannot {error.message()}")?
    publish(marker, fact.identity)?
    return Ok(directory)
