"""Rust facets use their test dependencies and report both passing and failing unit tests."""

from std.fs import Path
from std.environ import get_or
from std.io import BytesIO
from std.testing import fail
from codegen import (
    compiled_arguments,
    native_executable_arguments,
    rust_executable_arguments,
    rust_incremental_arguments,
)
from codegen import rust_iteration_enabled
from darwin_executable import normalized_macho
from files import make_directory, read, write
from graph_dependencies import prepare_graph
from graph_rust import inspect_rust
from features import FeatureRequest
from rust_testing import build_rust_tests
from loaf_local_graph import LocalEdge, LocalFacet
from rust_activation import DependencyDomain
from rust_units import build_rust
from rust_build import RustBuild, facet_slot, ordered, rust_output
from rust_registry import read_registry_units
from rust_scheduler import LOWERING_RESERVATION_BYTES, UNIT_RESERVATION_BYTES, RustUnitSchedule
from scratch import scratch_directory
from testing import run_rust_harness, test_sources
from toolchain import Toolchain, load_toolchain, rust_compiler
from unit_rust import compile_incan_library
from rust::std::env::consts import OS
from rust::std::process import Command


pub def test_rust_facet_reports_passing_and_failing_tests() -> Result[None, str]:
    """
    Exercise the real Rust test producer and reporter, including a test-only local dependency.

    1. Create a Rust library with a passing test and a failing test using a test-only helper, and a module of its own.
    2. Compile and run both tests, requiring a failing command outcome; rediscover an unavailable old witness.
    3. Repair the failing assertion, remove and add a module with its file, and require the same harness path to rebuild
       and pass.
    4. Compile procedural macro unit and integration harnesses in their producer's host domain.
    5. Require optimized qualification and iteration to preserve the same edit/revert behavior.
    6. Reuse and execute the test harnesses repeatedly from another checkout.
    """
    verify_scheduler_policy()?
    temporary = scratch_directory()?
    root = temporary.path()
    verify_incremental_policy(root)?
    verify_macho_uuid_normalization()?
    project = root.joinpath("project")
    helper = root.joinpath("helper")
    alternate = root.joinpath("alternate")
    make_directory(project.joinpath("src"))?
    make_directory(helper.joinpath("src"))?
    make_directory(alternate.joinpath("src"))?
    make_directory(project.joinpath("tests"))?
    # 1. The test helper is absent from production dependencies.
    manifest = "[project]\nname='facet_tests'\nversion='1.0.0'\n[rust]\ntype='lib'\nedition='2024'\n"
    binaries = "[[rust.bin]]\nname='facet_tests'\npath='src/main.rs'\n"
    test_dependencies = "[envs.test.dependencies]\nhelper={loaf='helper',path='../helper'}\n"
    aliases = "helper_alt={loaf='alternate',path='../alternate'}\n"
    write(project.joinpath("loaf.toml"), manifest + binaries + test_dependencies + aliases)?
    write(helper.joinpath("loaf.toml"), "[project]\nname='helper'\nversion='1.0.0'\n[rust]\ntype='lib'\n")?
    alternate_manifest = "[project]\nname='alternate'\nversion='1.0.0'\n[rust]\nname='helper'\ntype='lib'\n"
    write(alternate.joinpath("loaf.toml"), alternate_manifest)?
    helper_source = "/// Return the support facet's fixture value.\npub fn value() -> u32 { 7 }\n"
    write(helper.joinpath("src/lib.rs"), helper_source)?
    write(alternate.joinpath("src/lib.rs"), helper_source.replace("{ 7 }", "{ 9 }"))?
    write(helper.joinpath("src/lib.incn"), incan_fixture("pub def facade_only() -> int:", "return 99"))?
    source = project.joinpath("src/lib.rs")
    removed = project.joinpath("src/removed.rs")
    write(removed, "/// The module's fixture value.\npub const VALUE: u32 = 7;\n")?
    module = "/// A module the repair removes.\npub mod removed;\n"
    in_module = "#[test]\nfn in_module() { assert_eq!(removed::VALUE, 7); }\n"
    write(source, module + in_module + rust_tests(8))?
    binary = "fn main() {}\n#[test]\nfn in_binary() { assert_eq!(facet_tests::value(), 7); }\n"
    write(project.joinpath("src/main.rs"), binary)?
    integration = "#[test]\nfn imported() { assert_eq!(facet_tests::value(), 7); }\n"
    write(project.joinpath("tests/imported.rs"), integration)?
    write(project.joinpath("src/lib.incn"), incan_fixture("def ordinary_library_function() -> None:", "pass"))?
    write(project.joinpath("tests/test_inline.incn"), incan_fixture("def test_inline() -> None:", "assert true"))?
    assert [path.0 for path in test_sources(project)?] == [project.joinpath("tests/test_inline.incn").0]
    toolchain = load_toolchain()?
    request = RustBuild(
        project=project.0,
        rustc=rust_compiler(toolchain),
        registry=read_registry_units(Path(toolchain.registry_units))?,
        toolchain=Some(toolchain),
        toolchain_search=toolchain.search,
    )
    # 2. A failure must not hide the other test or become a successful command.
    programs = build_rust_tests(request)?
    assert len(programs) == 3
    assert run_rust_harness(Path(programs[0]), project)? == 1
    for program in programs[1:]:
        assert run_rust_harness(Path(program), project)? == 0
    # An older target view's unlocatable dependency witness is rediscovered, never mistaken for current inputs.
    write(Path(programs[0] + ".d"), "old: /unavailable/checkout/src/lib.rs\n")?
    assert build_rust_tests(request)? == programs
    # 3. Source edits invalidate the ordinary executable proof; the evidence that named a removed module is rescanned.
    write(source, rust_tests(7))?
    removed.unlink().map_err((error) => error.message())?
    rebuilt = build_rust_tests(request)?
    assert rebuilt == programs
    for program in rebuilt:
        assert run_rust_harness(Path(program), project)? == 0
    # Adding a module refreshes dep-info before the producer is keyed, just as removing one does.
    write(removed, "/// The added module's fixture value.\npub const VALUE: u32 = 7;\n")?
    write(source, module + in_module + rust_tests(7))?
    assert build_rust_tests(request)? == programs
    for program in programs:
        assert run_rust_harness(Path(program), project)? == 0
    write(source, rust_tests(7))?
    removed.unlink().map_err((error) => error.message())?
    assert build_rust_tests(request)? == programs
    verify_incremental_revert(request, helper, helper_source, project)?
    # 4. A procedural macro retains its crate kind and sysroot proc_macro binding.
    macro = root.joinpath("macro")
    make_directory(macro.joinpath("src"))?
    macro_manifest = "[project]\nname='macro_fixture'\nversion='1.0.0'\n[rust]\ntype='proc-macro'\nedition='2024'\n"
    macro_dependencies = "[envs.test.dependencies]\nhelper={loaf='helper',path='../helper',default-features=false}\n"
    write(macro.joinpath("loaf.toml"), macro_manifest + macro_dependencies)?
    macro_source = "use proc_macro::TokenStream;\n"
    macro_docs = "/// Preserve the macro input.\n"
    macro_entry = "#[proc_macro]\npub fn passthrough(tokens: TokenStream) -> TokenStream { tokens }\n"
    macro_test = "#[test]\nfn marker() { assert_eq!(helper::value(), 7); }\n"
    write(macro.joinpath("src/lib.rs"), macro_source + macro_docs + macro_entry + macro_test)?
    make_directory(macro.joinpath("tests"))?
    use_macro = "macro_fixture::passthrough! { const VALUE: u32 = 4; }\n"
    macro_integration = "#[test]\nfn imported() { assert_eq!((VALUE, helper::value()), (4, 7)); }\n"
    write(macro.joinpath("tests/imported.rs"), use_macro + macro_integration)?
    mut macro_request = request
    macro_request.project = macro.0
    macro_request.default_features = false
    macro_programs = build_rust_tests(macro_request)?
    assert len(macro_programs) == 2
    verify_macro_domains(macro, helper, macro_request)?
    for program in macro_programs:
        assert run_rust_harness(Path(program), macro)? == 0
    # 5. Optimized qualification and opt-in iteration obey the same edit/revert contract.
    mut optimized = request
    optimized.profile = "release"
    for program in build_rust_tests(optimized)?:
        assert run_rust_harness(Path(program), project)? == 0
    verify_incremental_revert(optimized, helper, helper_source, project)?
    # 6. The bakery's dependency evidence remains valid in a second checkout.
    verify_relocated_harnesses(optimized, project, root.joinpath("relocated"))?
    verify_native_graph_publication(helper, toolchain)?
    verify_mixed_provider(optimized, root.joinpath("mixed-consumer"))?
    return Ok(None)


def verify_scheduler_policy() -> Result[None, str]:
    """Admit newly ready work immediately and keep lowering within its larger memory reservation."""
    left = scheduling_facet("left")
    right = scheduling_facet("right")
    dependent = scheduling_facet("dependent", [LocalEdge(alias="left", project="left", domain=DependencyDomain.Target)])
    mut schedule = RustUnitSchedule.start(
        [left, right, dependent],
        jobs=2,
        memory=2 * UNIT_RESERVATION_BYTES,
    )
    assert schedule.admit() == [0, 1]
    schedule.finish(0)?
    assert schedule.admit() == [2], "a newly ready unit waited for an unrelated active unit"
    schedule.finish(2)?
    schedule.finish(1)?
    assert schedule.done()

    lowering = scheduling_facet("incan_mir_lowering")
    ordinary = scheduling_facet("ordinary")
    mut bounded = RustUnitSchedule.start([lowering, ordinary], jobs=2, memory=LOWERING_RESERVATION_BYTES)
    assert bounded.admit() == [0], "lowering shared its six-GiB reservation"
    bounded.finish(0)?
    assert bounded.admit() == [1]
    bounded.finish(1)?
    assert bounded.done()
    return Ok(None)


def scheduling_facet(name: str, local: list[LocalEdge] = []) -> LocalFacet:
    """Construct one target-domain scheduler fixture without filesystem or compiler inputs."""
    return LocalFacet(
        project=name,
        domain=DependencyDomain.Target,
        features=[],
        local=local,
        registry=[],
        registry_aliases=[],
        package=name,
        version="1.0.0",
    )


def verify_native_graph_publication(helper: Path, toolchain: Toolchain) -> Result[None, str]:
    """A cached native preparation returns a complete graph publication, restoring a lost filename binding."""
    provider = helper.resolve().map_err((error) => error.message())?
    root = provider.parent().joinpath("graph_consumer")
    make_directory(root.joinpath("src"))?
    manifest = "[project]\nname='graph_consumer'\nversion='0.1.0'\n[dependencies]\nhelper={path='../helper'}\n"
    write(root.joinpath("loaf.toml"), manifest)?
    write(root.joinpath("src/main.incn"), "def main() -> None:\n    pass\n")?
    facet = local_facet(provider.0, DependencyDomain.Target, "helper")
    prepared = prepare_graph(root, "debug", FeatureRequest(), {}, toolchain, [], true)?
    unit = prepared.built[facet.key()]
    graph = Path(unit.directory).joinpath("helper.incngraph")
    original = graph.read_bytes().map_err((error) => error.message())?
    _ = inspect_rust(root, "debug", FeatureRequest(), {}, toolchain, true)?
    # Losing a filename is not losing a fact, and a cached preparation must not return a partial publication.
    Path(unit.artifact).unlink().map_err((error) => error.message())?
    restored = inspect_rust(root, "debug", FeatureRequest(), {}, toolchain, true)?
    assert len(restored) > 0
    assert Path(unit.artifact).is_file(), "cached native preparation returned an incomplete library publication"
    assert graph.read_bytes().map_err((error) => error.message())? == original
    return Ok(None)


def verify_mixed_provider(request: RustBuild, root: Path) -> Result[None, str]:
    """A Rust root stages the complete three-Loaf Incan chain, including its mixed leaf provider."""
    outer = root.joinpath("outer")
    bridge = outer.joinpath("deps/bridge")
    mixed = bridge.joinpath("deps/mixed")
    for project in [root, outer, bridge, mixed]:
        make_directory(project.joinpath("src"))?
    make_directory(mixed.joinpath("rust/src"))?
    write(
        root.joinpath("loaf.toml"),
        "[project]\nname='mixed_consumer'\nversion='1.0.0'\n[rust]\nedition='2024'\n[[rust.bin]]\nname='mixed_consumer'\npath='src/main.rs'\n[dependencies]\nouter={path='outer'}\n",
    )?
    write(root.joinpath("src/main.rs"), "fn main() { println!(\"{}\", outer::value()); }\n")?
    write(
        outer.joinpath("loaf.toml"),
        "[project]\nname='outer'\nversion='1.0.0'\n[dependencies]\nbridge={path='deps/bridge'}\n",
    )?
    write(
        outer.joinpath("src/lib.incn"),
        "from pub::bridge import bridged\n\npub def value() -> int:\n    \"\"\"Return the value from the direct bridge.\"\"\"\n    return bridged()\n",
    )?
    write(
        bridge.joinpath("loaf.toml"),
        "[project]\nname='bridge'\nversion='1.0.0'\n[dependencies]\nmixed={path='deps/mixed'}\n",
    )?
    write(
        bridge.joinpath("src/lib.incn"),
        "from pub::mixed import amount\n\npub def bridged() -> int:\n    \"\"\"Return the value from the transitive mixed provider.\"\"\"\n    return amount()\n",
    )?
    write(
        mixed.joinpath("loaf.toml"),
        "[project]\nname='mixed'\nversion='1.0.0'\n[rust]\nname='mixed_native'\nedition='2024'\n[rust.source]\nroot='rust'\n",
    )?
    write(
        mixed.joinpath("src/lib.incn"),
        "from rust::mixed_native import native_value\n\npub def amount() -> int:\n    \"\"\"Return the native leaf value.\"\"\"\n    return native_value()\n",
    )?
    write(
        mixed.joinpath("rust/src/lib.rs"),
        "/// The value exposed through the Incan facade.\npub fn native_value() -> i64 { 7 }\n",
    )?
    mut selected = request
    selected.project = root.0
    selected.rust_facet_dependencies = true
    selected.incan_compiler = Some(compile_incan_library)
    programs = build_rust(selected)?
    assert len(programs) == 1
    output = Command.new(programs[0]).output().map_err((error) => str(error))?
    assert output.status.success() and output.stdout == b"7\x0a" and output.stderr == b""
    leaf = outer.joinpath(f"target/incan/loaves/mixed/{selected.profile}")
    for name in ["mixed.incnlib", "libmixed.rlib"]:
        artifact = leaf.joinpath(name)
        assert artifact.is_file(), f"transitive library artifact was not staged: {artifact.0}"
        producer = Path(f"{artifact.0}.oven-unit")
        assert producer.is_file(), f"transitive library producer identity was not staged: {producer.0}"
    assert build_rust(selected)? == programs
    return Ok(None)


def verify_relocated_harnesses(request: RustBuild, project: Path, relocated: Path) -> Result[None, str]:
    """Baked test harnesses run repeatedly from another checkout with its own source and dependency evidence."""
    make_directory(relocated)?
    write(relocated.joinpath("loaf.toml"), read(project.joinpath("loaf.toml"))?)?
    for directory in ["src", "tests"]:
        make_directory(relocated.joinpath(directory))?
        for source in project.joinpath(directory).iterdir().map_err((error) => error.message())?:
            destination = relocated.joinpath(directory).joinpath(source.name())
            write(destination, read(source)?)?
    mut selected = request
    selected.project = relocated.0
    first = build_rust_tests(selected)?
    second = build_rust_tests(selected)?
    assert first == second
    for program in second:
        assert run_rust_harness(Path(program), relocated)? == 0
    return Ok(None)


def verify_incremental_policy(root: Path) -> Result[None, str]:
    """Rust iteration uses local scratch, while generated units and qualification retain their ordinary flags."""
    assert rust_iteration_enabled("debug", "")
    assert not rust_iteration_enabled("release", "")
    assert rust_iteration_enabled("release", "1")
    assert not rust_iteration_enabled("debug", "0")
    assert not rust_iteration_enabled("release", "true")
    assert not rust_iteration_enabled("unknown", "1")
    scratch = root.joinpath("target/incremental/library")
    ordinary = ["-C", "metadata=incan-unit"]
    iteration = ["-C", "metadata=incan-iteration-library"]
    assert rust_incremental_arguments(scratch, ordinary) == []
    assert rust_incremental_arguments(scratch, iteration) == ["-C", f"incremental={scratch.0}"]
    for profile in ["debug", "release"]:
        generated = compiled_arguments(profile, "sha256:fixture", root.0)?
        assert rust_incremental_arguments(scratch, generated) == []
        for argument in generated:
            assert "incremental=" not in argument
    assert "-Cstrip=debuginfo" in native_executable_arguments("release")
    assert "strip=debuginfo" in rust_executable_arguments("release")
    if OS == "macos":
        assert "-Clink-arg=-Wl,-reproducible" in native_executable_arguments("release")
        assert "link-arg=-Wl,-reproducible" in rust_executable_arguments("release")
        assert "-Clink-arg=-Wl,-no_adhoc_codesign" in native_executable_arguments("release")
        assert "link-arg=-Wl,-no_adhoc_codesign" in rust_executable_arguments("release")
    else:
        assert "-Clink-arg=-Wl,-reproducible" not in native_executable_arguments("release")
        assert "link-arg=-Wl,-reproducible" not in rust_executable_arguments("release")
        assert "-Clink-arg=-Wl,-no_adhoc_codesign" not in native_executable_arguments("release")
        assert "link-arg=-Wl,-no_adhoc_codesign" not in rust_executable_arguments("release")
    assert "-Cstrip=debuginfo" in compiled_arguments("release", "sha256:fixture", root.0, true)?
    assert "-Cstrip=debuginfo" not in compiled_arguments("release", "sha256:fixture", root.0)?
    relocated = compiled_arguments(
        "release",
        "sha256:fixture",
        "/checkout/project",
        true,
        [("platform", "/checkout/loaves/platform/src")],
        "/checkout/toolchain",
    )?
    mut remaps_workspace = false
    for argument in relocated:
        if argument.endswith("=workspace"):
            remaps_workspace = true
    assert remaps_workspace
    assert "/checkout/project=source" in relocated
    assert "/checkout/loaves/platform/src=source/loaves/platform" in relocated
    assert "/checkout/toolchain=toolchain" in relocated
    return Ok(None)


def verify_macho_uuid_normalization() -> Result[None, str]:
    """Different linker UUIDs and prior signatures normalize to one stable, idempotent executable payload."""
    header = b"\xcf\xfa\xed\xfe\x0c\x00\x00\x01\x00\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    command = b"\x1b\x00\x00\x00\x18\x00\x00\x00"
    first = normalized_macho(macho_fixture(header, command, b"first-uuid-value"))?
    second = normalized_macho(macho_fixture(header, command, b"other-uuid-value"))?
    assert first == second
    assert normalized_macho(first)? == first
    signed_header = b"\xcf\xfa\xed\xfe\x0c\x00\x00\x01\x00\x00\x00\x00\x02\x00\x00\x00\x02\x00\x00\x00(\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    signature_command = b"\x1d\x00\x00\x00\x10\x00\x00\x00H\x00\x00\x00\x10\x00\x00\x00"
    first_signed = macho_fixture(signed_header, command, b"first-uuid-value", signature_command, b"first-signature!")
    second_signed = macho_fixture(signed_header, command, b"other-uuid-value", signature_command, b"other-signature!")
    first_normalized = normalized_macho(first_signed)?
    second_normalized = normalized_macho(second_signed)?
    assert first_normalized[40:56] == second_normalized[40:56]
    return Ok(None)


def macho_fixture(
    header: bytes,
    command: bytes,
    uuid: bytes,
    signature_command: bytes = b"",
    signature: bytes = b"",
) -> bytes:
    """Assemble the small Mach-O byte fixture without relying on byte-sequence addition."""
    buffer = BytesIO(b"")
    for value in [header, command, uuid, signature_command, signature, b"payload"]:
        _ = buffer.write_bytes(value)
    return buffer.getvalue()


def verify_incremental_revert(request: RustBuild, helper: Path, original: str, project: Path) -> Result[None, str]:
    """A dependency body edit changes executable behavior; reverting restores it through the same scratch cache."""
    if rust_iteration_enabled(request.profile, get_or("INCAN_RUST_INCREMENTAL", "")):
        root = helper.resolve().map_err((error) => error.message())?
        facet = local_facet(root.0, DependencyDomain.Target, "helper")
        slot = facet_slot(facet, request.profile)
        output = rust_output(project, request.profile)
        directory = output.joinpath(f"helper-{slot}")
        # A bakery hit needs no local rustc scratch; its retained producer proof still excludes scratch flags.
        assert "incremental=" not in read(directory.joinpath("library.portable-inputs"))?
    source = helper.joinpath("src/lib.rs")
    write(source, original.replace("{ 7 }", "{ 9 }"))?
    changed = build_rust_tests(request)?
    assert run_rust_harness(Path(changed[0]), project)? == 1
    write(source, original)?
    restored = build_rust_tests(request)?
    assert restored == changed
    for program in restored:
        assert run_rust_harness(Path(program), project)? == 0
    return Ok(None)


def verify_macro_domains(macro: Path, helper: Path, request: RustBuild) -> Result[None, str]:
    """
    Require distinct host/target producer slots and refuse two local Loaves declaring the same name and version.

    1. Each producer directory is selected by its project, domain, features and profile.
    2. Two Loaves declaring one name and version refuse before compilation.
    """
    # 1. Both fixtures declare version 1.0.0.
    roles = [(macro, DependencyDomain.Host, "macro_fixture"), (helper, DependencyDomain.Target, "helper")]
    for project, domain, name in roles:
        root = project.resolve().map_err((error) => error.message())?
        facet = local_facet(root.0, domain, name)
        directory = rust_output(macro, request.profile).joinpath(f"{name}-{facet_slot(facet, request.profile)}")
        assert directory.is_dir(), f"{name} must retain its {domain.value()} producer identity"
    # 2. A different Loaf with the same declaration is refused independently of its target slot.
    here = local_facet(helper.0, DependencyDomain.Target, "helper")
    elsewhere = local_facet("/another/checkout/helper", DependencyDomain.Target, "helper")
    assert facet_slot(here, request.profile) == facet_slot(elsewhere, request.profile)
    match ordered([here, elsewhere]):
        Ok(_) => fail("two local Loaves declaring one name and version were compiled as one unit")
        Err(reason) =>
            assert "both declare helper 1.0.0" in reason
    return Ok(None)


def local_facet(project: str, domain: DependencyDomain, name: str) -> LocalFacet:
    """A dependency-free facet of a Loaf that declares `name` at version 1.0.0."""
    return LocalFacet(
        project=project,
        domain=domain,
        features=[],
        local=[],
        registry=[],
        registry_aliases=[],
        package=name,
        version="1.0.0",
    )


def incan_fixture(header: str, body: str) -> str:
    """Give each generated Incan fixture a module contract and a declaration docstring."""
    module = "\"\"\"Exercise Rust facet test selection.\"\"\"\n\n"
    docstring = "    \"\"\"Provide the fixture behavior.\"\"\"\n"
    return module + header + "\n" + docstring + "    " + body + "\n"


def rust_tests(expected: int) -> str:
    """The same two observable tests with one changeable expected helper value."""
    passing = "#[test]\nfn a_passing() { assert_eq!((helper::value(), helper_alt::value()), (7, 9)); }\n"
    checked = "#[test]\nfn z_checked() { assert_eq!(helper::value(), " + str(expected) + "); }\n"
    source = "/// Return the library fixture value.\npub fn value() -> u32 { 7 }\n"
    return source + passing + checked
