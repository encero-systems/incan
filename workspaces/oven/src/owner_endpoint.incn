"""
Finding a project's resident owner, starting one when there is none, and asking it for an executable.

An owner is identified by a generation: a digest of the protocol, this Oven executable's identity (so a rebuilt `incan`
never talks to an older owner), the project, the home, the standard library and the toolchain description. Only
semantic configuration is in it, so an incidental environment variable does not start another owner. Its lock and
mailbox live in the private `owners` directory of the home; its socket and readiness socket live in the user's private
endpoint directory, named after a digest of that `owners` directory, so a deep home still has a short socket path.

Starting is arbitrated: whoever finds no owner takes an exclusive lock, looks again, and only then starts one, so
simultaneous commands start exactly one. A stale socket (nothing listens) is removed; a socket that something refuses
or an ordinary file in its place is left alone and the command prepares its executable itself.
"""

from rust::std::env import current_exe
from rust::std::fs import Permissions, metadata, set_permissions, symlink_metadata
from rust::std::os::unix::fs import FileTypeExt, MetadataExt, PermissionsExt
from rust::std::os::unix::process import CommandExt
from rust::std::process import Child, Command, Stdio
from rust::std::thread import sleep
from rust::std::time import Duration
from std.environ import get_optional, get_or
from std.fs import Path
from std.json import JsonValue
from pub::incan_platform.ipc import Connection, Listener, dial_live, listen
from files import discard_file
from home import home, owners_dir
from observation import observe, relay
from decimal_text import digits_only
from owner_protocol import PROTOCOL, Reply, Request, discard_reply, prepares_executable, receive_document, reply_of
from owner_protocol import send_document, send_quietly
from rust_target import inherited_deployment_configuration
from toolchain import toolchain_file
from unit_freshness import artifact_identity, fingerprint

# How long a started owner has to say it is listening, in 2 ms polls.
const READINESS_POLLS: int = 7500
# The seconds an owner may be idle before it retires, unless OVEN_OWNER_IDLE says otherwise.
const DEFAULT_IDLE: int = 600
# An owner idle for less than this would retire before its own watchdog could ask.
const MINIMUM_IDLE: int = 4
# The longest socket path the system accepts, with room to spare.
const MAX_SOCKET_PATH: int = 100
# Read, write and search permission for the user alone (octal 700).
const PRIVATE_DIRECTORY: u32 = 448
# The seconds a client waits for a lifecycle reply; preparing an executable is not bounded.
const LIFECYCLE_SECONDS: u64 = 5
# The suffix of an owner's socket file name.
const SOCKET_SUFFIX: str = ".sock"
# Where the user's endpoint directory is made when the platform names no user runtime directory.
const ENDPOINT_ROOT: str = "/tmp"
# The digits of a directory's digest that name its sockets in the endpoint directory.
const DIRECTORY_DIGITS: int = 12


pub model Endpoint:
    """Where one owner lives."""

    pub generation: str
    pub directory: str
    pub socket: str
    pub lock: str
    pub ready: str
    # The file the owner's trace lines are collected in.
    pub mailbox: str


pub def endpoint_for(root: str) -> Result[Endpoint, str]:
    """
    The endpoint of the owner of the project at `root` for this Oven, home and toolchain.

    1. The generation names the owner: a digest of what decides which owner may serve this project.
    2. Its lock and mailbox live in the home's private `owners` directory; its sockets in the user's endpoint directory.
    3. A socket path the system could not bind is refused, naming it.
    """
    # 1. The generation names exactly the owner that may serve this project with this Oven, home and toolchain.
    generation = generation_of(root)?
    # 2. The sockets' path does not grow with the home's depth.
    directory = owners_dir()?.0
    endpoint = endpoint_at(directory, socket_prefix(directory)?, generation)
    # 3. Only an endpoint directory deeper than the system allows can still be refused here.
    bindable(endpoint.socket)?
    bindable(endpoint.ready)?
    return Ok(endpoint)


pub def bindable(socket: str) -> Result[None, str]:
    """Refuse a socket path longer than the system can bind, naming it."""
    if len(socket) > MAX_SOCKET_PATH:
        return Err(f"the socket path {socket} is longer than the system allows")
    return Ok(None)


pub def socket_prefix(directory: str) -> Result[str, str]:
    """
    The short, depth-independent path prefix of the sockets that belong to the private `directory`.

    1. Make `directory` private; the user who owns it owns its sockets.
    2. Make that user's private endpoint directory: `incan-<uid>` under the user runtime directory, or under `/tmp`.
    3. Name the sockets by a digest of `directory`, so different homes never share one.
    """
    # 1. The directory the sockets belong to is private to its user before anything is named after it.
    prepare_directory(directory)?
    uid = owner_of(directory)?
    # 2. The endpoint directory belongs to the same user and nobody else can enter it.
    endpoints = f"{endpoint_root()}/incan-{uid}"
    prepare_endpoints(endpoints, uid)?
    # 3. A digest of the directory keeps the sockets of every home apart at a fixed length.
    return Ok(f"{endpoints}/{fingerprint([directory])?[0:DIRECTORY_DIGITS]}-")


def endpoint_root() -> str:
    """The user runtime directory when the platform names one, else `/tmp`."""
    runtime = get_or("XDG_RUNTIME_DIR", "")
    if runtime != "" and runtime.startswith("/"):
        return runtime
    return ENDPOINT_ROOT


def owner_of(directory: str) -> Result[u32, str]:
    """The user who owns `directory`."""
    match metadata(f"{directory}"):
        Ok(found) => return Ok(found.uid())
        Err(error) => return Err(f"{directory}: {error}")


def prepare_endpoints(directory: str, uid: u32) -> Result[None, str]:
    """
    Make the user's endpoint directory and refuse one that is a link, belongs to another user, or is open to others.

    1. A link in its place is never followed.
    2. Make it private, as any owner directory.
    3. It must belong to the user who owns the home.
    """
    # 1. A link could be swapped for another user's directory after the checks, so none is accepted.
    match symlink_metadata(f"{directory}"):
        Ok(found) =>
            if found.file_type().is_symlink():
                return Err(f"{directory} is a link")
        Err(_) => pass
    # 2. Creation, the mode and the refusal of a directory others can enter are those of every owner directory.
    prepare_directory(directory)?
    # 3. A directory made by another user is refused even when its mode is private.
    if owner_of(directory)? != uid:
        return Err(f"{directory} belongs to another user")
    return Ok(None)


def generation_of(root: str) -> Result[str, str]:
    """
    The first sixteen digits of the digest of the protocol, this executable, the project, the home, the standard
    library, toolchain description, selected SDK/deployment configuration and requested compiler diagnostics.
    """
    exe = executable()?
    mut configuration = [
        PROTOCOL,
        exe,
        observe(Path(exe))?.stamp,
        root,
        home()?.0,
        get_or("INCAN_STDLIB", ""),
        identity_of(toolchain_file()?),
        inherited_setting("DEVELOPER_DIR"),
        inherited_setting("TOOLCHAINS"),
        inherited_setting("SDKROOT"),
        inherited_setting("INCAN_NATIVE_TIMING"),
        inherited_setting("INCAN_TRACE_DIR"),
        inherited_setting("INCAN_JEC_TRACE"),
        inherited_setting("INCAN_ENGINE_TRACE"),
        inherited_setting("INCAN_ENGINE_RUN"),
        inherited_setting("INCAN_ENGINE_REQUEST"),
    ]
    # An inherited deployment selection keeps the owner distinct before it can prepare native inputs for a caller.
    configuration.extend(inherited_deployment_configuration()?)
    return Ok(fingerprint(configuration)?[0:16])


def inherited_setting(name: str) -> str:
    """Bind an owner's inherited selection to its caller's setting, distinguishing absent and explicitly empty."""
    match get_optional(name):
        Some(value) => return f"set:{value}"
        None => return "unset"


def endpoint_at(directory: str, prefix: str, generation: str) -> Endpoint:
    """The files of the owner of `generation`: its lock and mailbox in `directory`, its sockets after `prefix`."""
    return Endpoint(
        generation=generation,
        directory=directory,
        socket=f"{prefix}{generation}{SOCKET_SUFFIX}",
        lock=f"{directory}/{generation}.lock",
        ready=f"{prefix}{generation}.ready",
        mailbox=f"{directory}/{generation}.trace",
    )


def executable() -> Result[str, str]:
    """The path of the running Oven."""
    match current_exe():
        Ok(path) => return Ok(f"{path.display()}")
        Err(error) => return Err(f"cannot locate this executable: {error}")


def identity_of(path: Path) -> str:
    """A file's identity, or `absent`."""
    match artifact_identity(path):
        Ok(stamp) => return stamp
        Err(_) => return "absent"


pub def idle_seconds() -> int:
    """
    How long an owner started by this command may stay idle: `OVEN_OWNER_IDLE` seconds when it is a whole number,
    at least `MINIMUM_IDLE`, else the default.
    """
    configured = get_or("OVEN_OWNER_IDLE", "")
    if configured == "" or not digits_only(configured):
        return DEFAULT_IDLE
    seconds = int(configured)
    if seconds < MINIMUM_IDLE:
        return MINIMUM_IDLE
    return seconds


pub def timeout_for(command: str) -> u64:
    """
    How long a client waits for a reply: lifecycle requests are bounded, preparing an executable is not, because a
    build takes as long as it takes.
    """
    if prepares_executable(command):
        return 0
    return LIFECYCLE_SECONDS


pub def connect(endpoint: Endpoint, start: bool) -> Result[Option[Connection], str]:
    """
    A connection to the endpoint's owner. With `start`, one is started when none is running.

    1. Connect to an owner that is already running.
    2. Without `start`, report that there is none.
    3. Take the exclusive lock, so simultaneous commands start exactly one owner.
    4. Look again under the lock: another command may have started it while this one waited.
    5. Start the owner and connect to it.
    """
    # 1. A running owner is used as it is.
    match attach(endpoint)?:
        Some(present) => return Ok(Some(present))
        None => pass
    # 2. A command that may not start an owner finds there is none.
    if not start:
        return Ok(None)
    # 3. Only the command holding the exclusive lock can start an owner. The lock is held until this function returns.
    prepare_directory(f"{endpoint.directory}")?
    arbitration = Path(endpoint.lock).lock_exclusive().map_err((error) => error.message())?
    # 4. An owner another command started while this one waited for the lock is used, not a second one.
    match attach(endpoint)?:
        Some(started) => return Ok(Some(started))
        None => pass
    # 5. No owner exists, so one is started and connected to.
    launch(endpoint)?
    return attach(endpoint)


pub def attach(endpoint: Endpoint) -> Result[Option[Connection], str]:
    """
    Connect to a live owner. Nothing there is `None`; a socket nothing listens at is removed first; a live owner that
    refuses us, or an ordinary file in the socket's place, is an error and is left as it is.

    1. No socket file means no owner.
    2. Anything but a socket at that path is an error.
    3. Connect; a socket nothing listens at is removed.
    """
    # 1. A path with nothing at it has no owner.
    if not Path(endpoint.socket).exists():
        return Ok(None)
    # 2. Something that is not a socket is never removed or connected to.
    require_socket(endpoint.socket)?
    # 3. A socket nothing listens at is stale and goes; one that refuses us is another command's owner and stays.
    return connect_or_clear(endpoint.socket)


def require_socket(path: str) -> Result[None, str]:
    """Refuse a path that holds anything but a socket."""
    match metadata(f"{path}"):
        Err(error) => return Err(f"{path}: {error}")
        Ok(found) =>
            if not found.file_type().is_socket():
                return Err(f"{path} is not a socket")
    return Ok(None)


def connect_or_clear(path: str) -> Result[Option[Connection], str]:
    """A connection to the owner at the socket `path`; a socket nothing listens at is removed and gives `None`."""
    match dial_live(path)?:
        Some(found) => return Ok(Some(found))
        None =>
            discard_file(Path(path))
            return Ok(None)


pub def prepare_directory(directory: str) -> Result[None, str]:
    """
    Make the owners directory, private to the user, and refuse one that anyone else can enter.

    1. Create it, with its parents.
    2. Restrict it to the user.
    3. Refuse it when group or others can still enter it.
    """
    # 1. The directory exists, with the parents it needs.
    Path(directory).mkdir(true, true).map_err((error) => f"{directory}: {error.message()}")?
    # 2. Only the user can enter it, whatever mode it was created with.
    match set_permissions(f"{directory}", Permissions.from_mode(PRIVATE_DIRECTORY)):
        Ok(_) => pass
        Err(error) => return Err(f"cannot restrict {directory}: {error}")
    # 3. A directory that group or others can still enter is never trusted with a socket.
    match metadata(f"{directory}"):
        Err(error) => return Err(f"{directory}: {error}")
        Ok(found) =>
            if int(found.permissions().mode()) % 64 != 0:
                return Err(f"{directory} is accessible to others")
    return Ok(None)


def launch(endpoint: Endpoint) -> Result[None, str]:
    """
    Start an owner and wait for it to say it is listening.

    1. Listen on the readiness socket the owner will greet.
    2. Start the owner, detached from this command's terminal and process group.
    3. Wait for its greeting; an owner that exits or stays silent fails the start.
    """
    exe = executable()?
    # 1. The owner has a socket to greet on before it exists, so its greeting cannot be missed.
    mut listener = listen(f"{endpoint.ready}", false)?
    # 2. The owner outlives this command: it has no terminal and a process group of its own.
    mut command = owner_command(exe, endpoint)
    match command.spawn():
        Err(error) =>
            discard_ready(endpoint)
            return Err(f"cannot start an owner: {error}")
        Ok(child) =>
            # 3. The start succeeds on the owner's greeting, and fails if the owner exits or stays silent.
            return await_greeting(listener, child, endpoint)


def owner_command(exe: str, endpoint: Endpoint) -> Command:
    """
    The command line that runs this Oven as the owner of `endpoint`, with no terminal and a process group of its
    own, tracing into the endpoint's mailbox.
    """
    mut command = Command.new(exe)
    command.arg("--internal-owner")
    command.arg(f"{endpoint.socket}")
    command.arg(f"{endpoint.generation}")
    command.arg(f"{endpoint.ready}")
    command.arg(str(idle_seconds()))
    command.env("OVEN_TRACE", f"{endpoint.mailbox}")
    command.stdin(Stdio.null())
    command.stdout(Stdio.null())
    command.stderr(Stdio.null())
    command.process_group(0)
    return command


def await_greeting(mut listener: Listener, child: Child, endpoint: Endpoint) -> Result[None, str]:
    """Poll the readiness socket until the started owner greets, exits, or the polls run out (it is then killed)."""
    mut started = child
    for poll in range(READINESS_POLLS):
        match listener.poll()?:
            Some(waiting) => return read_greeting(waiting, endpoint)
            None => pass
        # An owner that cannot be asked counts as still starting.
        mut ended = false
        match started.try_wait():
            Ok(finished) => ended = finished is not None
            Err(_) => pass
        if ended:
            discard_ready(endpoint)
            return Err("the owner exited before it was ready")
        sleep(Duration.from_millis(2))
    # An owner that never greeted is killed; one that already exited needs no killing, so the outcome is ignored.
    _ = started.kill()
    discard_ready(endpoint)
    return Err("the owner was not ready in time")


def read_greeting(waiting: Connection, endpoint: Endpoint) -> Result[None, str]:
    """Read the greeting of a started owner and remove the readiness socket."""
    mut greeting = waiting
    greeting.wait_at_most(LIFECYCLE_SECONDS)
    greeting_read = receive_document(greeting)
    discard_ready(endpoint)
    return greeted(greeting_read, endpoint.generation)


def discard_ready(endpoint: Endpoint) -> None:
    """Remove the readiness socket of a start that is over."""
    discard_file(Path(endpoint.ready))


pub def greeted(heard: Result[JsonValue, str], generation: str) -> Result[None, str]:
    """Accept a readiness greeting only from an owner of this protocol and generation."""
    match heard:
        Err(reason) => return Err(f"the owner's greeting was unreadable: {reason}")
        Ok(document) =>
            reply = reply_of(document)?
            if reply.status != "ready":
                return Err(f"the owner greeted with `{reply.status}`")
            if reply.generation != generation:
                return Err("the owner is of another generation")
            return Ok(None)


pub def ask(endpoint: Endpoint, request: Request, start: bool) -> Result[Option[Reply], str]:
    """
    Put a request to the owner and read its reply. `None` when there is no owner and none was to be started.

    1. Connect to the owner, starting it when `start` allows.
    2. Bound the wait for the reply by the kind of request, and the write by a fixed time.
    3. Send the request and read the reply, relaying the trace lines the owner recorded.
    """
    # 1. A request needs an owner; without one, and none to start, the command prepares the executable itself.
    match connect(endpoint, start)?:
        None => return Ok(None)
        Some(found) =>
            # 2. A build may take as long as it takes, while a lifecycle question and any write are bounded.
            mut owner = found
            owner.wait_at_most(timeout_for(request.command))
            owner.write_at_most(10)
            # 3. The owner's answer arrives with the trace lines of its reasoning, which this command relays.
            send_document(owner, request.to_json())?
            reply = reply_of(receive_document(owner)?)?
            relay(reply.trace)
            return Ok(Some(reply))


pub def stop_owners() -> Result[int, str]:
    """Stop every owner and compiler worker of this home. Returns how many answered."""
    directory = owners_dir()?
    if not directory.is_dir():
        return Ok(0)
    prefix = socket_prefix(directory.0)?
    endpoints = Path(prefix).parent()
    named = Path(prefix).name()
    mut stopped = 0
    for entry in endpoints.iterdir().map_err((error) => error.message())?:
        name = entry.name()
        if name.startswith(named) and name.endswith(SOCKET_SUFFIX):
            generation = name[len(named):len(name) - len(SOCKET_SUFFIX)]
            if stop_owner(entry, generation):
                stopped += 1
    return Ok(stopped)


def stop_owner(socket: Path, generation: str) -> bool:
    """Ask the owner listening at `socket` to stop. Whether one answered; a socket nobody listens at is removed."""
    match dial_live(socket.0):
        Err(_) => return false
        Ok(found) =>
            match found:
                None =>
                    discard_file(socket)
                    return false
                Some(live) =>
                    mut owner = live
                    owner.wait_at_most(LIFECYCLE_SECONDS)
                    # An owner that answered counts as stopped, whether or not its reply to `stop` arrives.
                    send_quietly(owner, Request(command="stop", generation=generation).to_json())
                    discard_reply(owner)
                    return true
