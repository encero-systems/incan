"""
Checked compiler metadata for tooling and documentation: a source package's public API and its typed registries.

Each view reads the library manifest the compiler publishes for the package's checked source interface, the same
`contract_metadata` a compiled Loaf's `.incnlib` carries. Nothing is compiled natively and no module is executed.
"""

from rust::incan_loaf_names import artifact_stem
from rust::std::fs import remove_dir_all
from std.fs import Path
from std.json import JsonValue
from features import FeatureRequest
from files import make_directory, read_json
from cli_help import render
from intake import ManifestReader, entry_source
from unit import describe
from unit_compiler import crate_name, run_compiler, write_unit
from unit_rust import prepare_native, toolchain_for

pub const API_USAGE: str = "incan tools metadata api [PATH] [--format json]"
pub const REGISTRY_USAGE: str = "incan inspect registry IDENTITY [--project PATH] [--format json]"


@derive(Eq)
pub enum MetadataView(str):
    """Which checked metadata a request prints."""

    Api = "api"
    Registry = "registry"


pub model MetadataRequest:
    """One metadata command: the view, the source or project it reads, the model or registry it names and the format."""

    pub view: MetadataView
    pub path: str = "."
    pub name: str = ""
    pub format: str = "json"


pub def parse_metadata(arguments: list[str]) -> Result[MetadataRequest, str]:
    """`tools metadata api [PATH] [--format json]`."""
    if len(arguments) == 0:
        return Err("expected `api`")
    if arguments[0] != "api":
        if arguments[0].startswith("-"):
            return Err(f"unknown option `{arguments[0]}`")
        return Err(f"unknown command `{arguments[0]}`")
    mut format = "json"
    mut operands: list[str] = []
    mut index = 1
    while index < len(arguments):
        if arguments[index] == "--format" and index + 1 < len(arguments):
            format = arguments[index + 1]
            index += 2
            continue
        if arguments[index].startswith("-"):
            return Err(f"unknown option `{arguments[index]}`")
        operands.append(arguments[index])
        index += 1
    if len(operands) > 1:
        return Err(f"unexpected argument `{operands[1]}`")
    if format != "json":
        return Err(f"`--format` is json, got `{format}`")
    mut path = "."
    if len(operands) == 1:
        path = operands[0]
    return Ok(MetadataRequest(view=MetadataView.Api, path=path, format=format))


pub def parse_registry(arguments: list[str]) -> Result[MetadataRequest, str]:
    """`inspect registry IDENTITY [--project PATH] [--format json]`."""
    mut project = "."
    mut format = "json"
    mut operands: list[str] = []
    mut index = 0
    while index < len(arguments):
        if arguments[index] in ["--project", "--format"] and index + 1 < len(arguments):
            if arguments[index] == "--project":
                project = arguments[index + 1]
            else:
                format = arguments[index + 1]
            index += 2
            continue
        if arguments[index].startswith("-"):
            return Err(f"unknown option `{arguments[index]}`")
        operands.append(arguments[index])
        index += 1
    if len(operands) != 1:
        return Err("expected one registry identity, such as `feature::functions`")
    if format != "json":
        return Err(f"`--format` is json, got `{format}`")
    return Ok(MetadataRequest(view=MetadataView.Registry, path=project, name=operands[0], format=format))


pub def checked_metadata(request: MetadataRequest) -> Result[i32, str]:
    """Print the requested view; a registry the package does not publish is refused with the ones it does."""
    metadata = contract_metadata(checked_manifest(Path(request.path))?)?
    if request.view == MetadataView.Registry:
        return print_registry(metadata, request)
    match metadata.get("api"):
        Some(api) =>
            println(api.to_pretty_json().map_err((error) => error.message())?)
            return Ok(0)
        None => return Err(f"{request.path}: the compiler published no checked API metadata")


def checked_manifest(path: Path) -> Result[Path, str]:
    """
    The library manifest of the package at or around `path`, as the compiler checks its source interface.

    1. Select the source: a file as named, or a directory's library entry, then its program entry.
    2. Describe it as a library unit and bind its exact dependencies.
    3. Publish the checked source interface into a private directory.
    """
    # 1. A directory names its Loaf's conventional entry.
    mut source = path
    if path.is_dir():
        match entry_source(path, ManifestReader())?:
            Some(entry) => source = entry
            None => return Err(f"{path.0}: the Loaf has no Incan entry to inspect; name a source file")
    # 2. Every declaration a library would export is checked exactly as a dependent sees it.
    mut unit = describe(source, "debug", FeatureRequest(), ManifestReader())?
    unit.kind = "library"
    toolchain = toolchain_for(unit)?
    ready = prepare_native(unit, toolchain)?
    description = write_unit(ready, crate_name(ready))?
    # 3. A source interface never replaces an earlier publication, so each request starts from an empty directory.
    directory = Path(ready.project_root).joinpath("target/incan/metadata").joinpath(artifact_stem(ready.package))
    if directory.exists():
        remove_dir_all(directory.0).map_err((error) => f"cannot clear {directory.0}: {error}")?
    make_directory(directory)?
    code = run_compiler(toolchain, ["--source-interface", description.0, toolchain.sysroot, directory.0])?
    if code != 0:
        return Err(f"{source.0}: the compiler could not check the source interface (exit {code})")
    return Ok(directory.joinpath(f"{artifact_stem(ready.package)}.incnlib"))


def contract_metadata(manifest: Path) -> Result[JsonValue, str]:
    """The checked `contract_metadata` a library manifest carries."""
    match read_json(manifest)?.get("contract_metadata"):
        Some(metadata) => return Ok(metadata)
        None => return Err(f"{manifest.0}: the library manifest carries no checked metadata")


def print_registry(metadata: JsonValue, request: MetadataRequest) -> Result[i32, str]:
    """
    Print one checked registry and its entries, selected by `<module>::<binding>` or the package-qualified identity.

    The document is 0.5.1's: schema version, provenance, package, the registry definition and its entries.
    """
    registry = match metadata.get("registry"):
        Some(found) => found
        None => return Err(registry_absent(request.name, []))

    package = registry_package(registry)
    modules = elements(registry.get("modules"))?
    mut available: list[str] = []
    mut selected: Option[JsonValue] = None
    for module in modules:
        for definition in elements(module.get("registries"))?:
            identity = text(definition, "identity")?
            available.append(qualified_identity(package, identity))
            if request.name == identity or request.name == qualified_identity(package, identity):
                selected = Some(definition)
    definition = match selected:
        Some(found) => found
        None => return Err(registry_absent(request.name, available))

    identity = text(definition, "identity")?
    mut entries: list[JsonValue] = []
    for module in modules:
        for entry in elements(module.get("entries"))?:
            if text(entry, "registry_identity")? == identity:
                entries.append(entry)
    mut document: Dict[str, JsonValue] = {}
    document["schema_version"] = JsonValue.int(1)
    document["provenance"] = JsonValue.string("checked")
    if let Some(named) = registry.get("package"):
        document["package"] = named
    document["registry"] = definition
    document["entries"] = JsonValue.array(entries)
    println(JsonValue.object(document).to_pretty_json().map_err((error) => error.message())?)
    return Ok(0)


def registry_package(registry: JsonValue) -> str:
    """The package name the registry metadata names, or an empty string."""
    match registry.get("package"):
        None => return ""
        Some(package) =>
            match package.get("name"):
                None => return ""
                Some(name) => return name.as_str().unwrap_or("")


def qualified_identity(package: str, identity: str) -> str:
    """A registry identity qualified by its package, as refusals list them."""
    if package == "":
        return identity
    return f"{package}::{identity}"


def registry_absent(name: str, available: list[str]) -> str:
    """0.5.1's refusal for a registry the checked package does not define."""
    mut listed = "none"
    if len(available) > 0:
        listed = ", ".join(sorted(available))
    return f"checked registry `{name}` was not found; available registries: {listed}"


def elements(value: Option[JsonValue]) -> Result[list[JsonValue], str]:
    """An optional array field; an absent one is empty."""
    match value:
        None => return Ok([])
        Some(found) => return found.expect_array().map_err((error) => error.message())


def text(value: JsonValue, key: str) -> Result[str, str]:
    """A required string field."""
    return value.require(key).and_then((field) => field.expect_str()).map_err((error) => error.message())


pub def metadata_help(view: MetadataView) -> str:
    """`incan tools metadata api --help` and `incan inspect registry --help`."""
    match view:
        MetadataView.Api =>
            return render(
                API_USAGE,
                ["  --format json  Checked public API metadata, the `contract_metadata.api` a library publishes."],
                "incan tools metadata api src/lib.incn",
            )
        MetadataView.Registry =>
            return render(
                REGISTRY_USAGE,
                [
                    "  --project PATH  Source project root (default the current directory).",
                    "  --format json   Deterministic checked registry JSON.",
                ],
                "incan inspect registry feature::functions",
            )
