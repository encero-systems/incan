"""Oven's formatting invocation; the compiler owns parsing and the single formatter implementation."""

from rust::std::env import temp_dir
from rust::std::process import id as process_id
from std.fs import Path
from rust::std::string import String as RustString
from compiler_worker import captured_resident
from driver_command import driver_command
from files import parse_json
from json_fields import strings
from features import FeatureRequest
from incan_units import format_unit
from unit_compiler import crate_name, write_unit
from intake import intake
from toolchain import Toolchain, load_toolchain
from unit import UnitDescription, describe
from unit_rust import prepare_native
from cli_help import render

pub const USAGE: str = "incan fmt [--check] [--diff] [PATH...]"


pub model FormatRequest:
    """What `incan fmt` was asked to do: the paths to format, and whether to only check them or show their changes."""

    pub check: bool
    pub paths: list[str]
    pub diff: bool = false


pub def help_text() -> str:
    """Describe the formatting options without discovering or reading source files."""
    return render(
        USAGE,
        [
            "  --check  Report changes without writing; exit 1 when a file would change.",
            "  --diff   Show each change without writing; exit 1 when a file would change.",
            "  --       End option parsing.",
        ],
        "incan fmt --check src",
    )


pub def format_paths(request: FormatRequest) -> Result[i32, str]:
    """
    Format every `.incn` file in the given files and trees, or with `--check` report the files that would change, or
    with `--diff` show each change.

    A file that cannot be described or formatted is reported and the others still run. The exit code is 1 when any
    file failed or, with `--check`, would change.

    1. Load the installed toolchain once for the invocation.
    2. Discover the source files through the compiler's authored-file policy.
    3. Format every selected file, retaining a failure even when a later file succeeds.
    """
    # 1. Every file uses the same selected installation.
    toolchain = load_toolchain()?
    # 2. The compiler owns hidden-directory and symbolic-link policy for every client.
    files = discover(request.paths, toolchain)?
    if request.diff:
        return show_changes(files, toolchain)
    mut code: i32 = 0
    # 3. One failed file does not prevent the remaining files from being processed.
    for file in files:
        if format_file(file, toolchain, request.check)? != 0:
            code = 1
    return Ok(code)


pub def parse_arguments(arguments: list[str]) -> Result[FormatRequest, str]:
    """
    Read `--check`, `--diff` and the paths; `--` ends the options, so a path after it may start with `-`. Without a
    path, the current directory is formatted, as in 0.5.1.
    """
    mut check = false
    mut diff = false
    mut paths: list[str] = []
    mut options = true
    for argument in arguments:
        if options and argument == "--":
            options = false
        elif options and argument == "--diff":
            diff = true
        elif options and argument == "--check":
            check = true
        elif options and argument.startswith("-"):
            return Err(f"unknown option `{argument}`")
        else:
            paths.append(argument)
    if len(paths) == 0:
        paths.append(".")
    return Ok(FormatRequest(check=check, paths=paths, diff=diff))


def discover(paths: list[str], toolchain: Toolchain) -> Result[list[str], str]:
    """Every source under the given paths, each once, in a deterministic order."""
    mut files: list[str] = []
    for path in paths:
        for file in sources(Path(path), toolchain)?:
            if file not in files:
                files.append(file)
    if len(files) == 0:
        return Err("no .incn files found")
    return Ok(files)


def format_file(file: str, toolchain: Toolchain, check: bool) -> Result[i32, str]:
    """Format or check one file with its own unit's vocabulary; a file whose unit cannot be described reports why."""
    match describe_formatting(file, toolchain):
        Err(reason) =>
            println(f"Error formatting {file}: {reason}")
            return Ok(1)
        Ok(unit) => return format_unit(unit, toolchain, file, check)


def describe_formatting(file: str, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """Describe one source and prepare its registered syntax; ordinary syntax needs no native build."""
    unit = describe(Path(file), "debug", FeatureRequest())?
    if needs_vocabulary(unit)?:
        return prepare_native(unit, toolchain)
    return Ok(unit)


def needs_vocabulary(unit: UnitDescription) -> Result[bool, str]:
    """Whether an active local dependency declares an entry whose registration supplies parser syntax."""
    if not Path(unit.project_root).joinpath("loaf.toml").is_file():
        return Ok(false)
    graph = intake(Path(unit.project_root)).map_err((error) => error.message())?
    reached = [loaf.name for loaf in unit.loaves if not loaf.standard]
    for project in graph.projects:
        if project.intent.name in reached and project.intent.vocab_entry != None:
            return Ok(true)
    return Ok(false)


def sources(path: Path, toolchain: Toolchain) -> Result[list[str], str]:
    """
    Ask the installed compiler for its single deterministic authored-file discovery result.

    The resident worker that formats the files answers it, so discovery starts no compiler process of its own; the
    one-process driver answers it only when no worker can start.
    """
    arguments = ["--source-files", path.0]
    match captured_resident(toolchain, arguments)?:
        Some(found) =>
            if found.code != 0:
                return Err(decode(found.error)?)
            return discovered(found.output)
        None => pass
    mut command = driver_command(toolchain)?
    for argument in arguments:
        command.arg(argument)
    output = command.output().map_err((error) => f"{path.0}: {error}")?
    if not output.status.success():
        return Err(decode(output.stderr)?)
    return discovered(output.stdout)


def discovered(listing: bytes) -> Result[list[str], str]:
    """The path list the compiler's discovery printed."""
    paths = parse_json(decode(listing)?)?
    return strings(paths, []).map_err((_) => "compiler source discovery must be a path list")


def decode(value: bytes) -> Result[str, str]:
    """Require UTF-8 for the compiler's discovery protocol and diagnostics."""
    match RustString.from_utf8(value):
        Ok(text) => return Ok(str(text))
        Err(error) => return Err(str(error))


def show_changes(files: list[str], toolchain: Toolchain) -> Result[i32, str]:
    """
    Print the changes formatting would make to each file, as 0.5.1's `--diff` does, without writing any file.
    The exit code is 1 when a file would change or could not be formatted.
    """
    mut changed = 0
    mut failed = false
    for file in files:
        match changes(file, toolchain):
            Err(reason) =>
                println(f"Error formatting {file}: {reason}")
                failed = true
            Ok(lines) =>
                if len(lines) > 0:
                    changed += 1
                    println("\n".join([f"--- {displayed(file)}", "--- original", "+++ formatted"] + lines + [""]))
    if changed > 0:
        println(f"\n{changed} file(s) need formatting")
        return Ok(1)
    if failed:
        return Ok(1)
    println(f"✓ {len(files)} file(s) already formatted")
    return Ok(0)


def displayed(file: str) -> str:
    """A file as `--diff` names it: relative to the working directory when it is below it."""
    match Path.cwd():
        Ok(here) =>
            prefix = here.0 + "/"
            if file.startswith(prefix):
                return file[len(prefix):]
        Err(_) => pass
    return file


def changes(file: str, toolchain: Toolchain) -> Result[list[str], str]:
    """The numbered lines formatting removes from and adds to `file`, or none when it is already formatted."""
    original = Path(file).read_text("utf-8", "strict").map_err((error) => f"cannot read: {error.message()}")?
    formatted = formatted_text(file, original, toolchain)?
    if formatted == original:
        return Ok([])
    return Ok(line_changes(original.split("\n"), formatted.split("\n")))


def formatted_text(file: str, original: str, toolchain: Toolchain) -> Result[str, str]:
    """What the compiler formats `file` to, read from a private copy so the file itself never changes."""
    unit = describe_formatting(file, toolchain)?
    directory = Path(str(temp_dir().display())).joinpath(f"incan-fmt-diff-{process_id()}")
    directory.mkdir(true, true).map_err((error) => f"cannot create {directory.0}: {error.message()}")?
    copy = directory.joinpath(Path(file).name())
    copy.write_bytes(RustString.from(original).into_bytes()).map_err((error) => error.message())?
    arguments = ["--fmt", write_unit(unit, crate_name(unit))?.0, copy.0]
    mut code: i32 = 0
    mut complaint = ""
    match captured_resident(toolchain, arguments)?:
        Some(found) =>
            code = found.code
            complaint = decode(found.error)?
        None =>
            mut command = driver_command(toolchain)?
            for argument in arguments:
                command.arg(argument)
            output = command.output().map_err((error) => f"{file}: {error}")?
            if not output.status.success():
                code = 1
            complaint = decode(output.stderr)?
    formatted = copy.read_text("utf-8", "strict").map_err((error) => error.message())
    _ = directory.remove_tree()
    if code != 0:
        return Err(complaint.strip())
    return formatted


pub def line_changes(original: list[str], formatted: list[str]) -> list[str]:
    """
    The lines a longest-common-subsequence comparison removes and adds, as `-   N | TEXT` and `+   N | TEXT` with each
    line's number in its own text.
    """
    rows = len(original) + 1
    columns = len(formatted) + 1
    # common[i * columns + j] is the length of the longest common subsequence of original[i:] and formatted[j:].
    mut common: list[int] = [0 for _ in range(rows * columns)]
    mut i = len(original) - 1
    while i >= 0:
        mut j = len(formatted) - 1
        while j >= 0:
            if original[i] == formatted[j]:
                common[i * columns + j] = common[(i + 1) * columns + j + 1] + 1
            elif common[(i + 1) * columns + j] >= common[i * columns + j + 1]:
                common[i * columns + j] = common[(i + 1) * columns + j]
            else:
                common[i * columns + j] = common[i * columns + j + 1]
            j -= 1
        i -= 1
    mut lines: list[str] = []
    mut a = 0
    mut b = 0
    while a < len(original) or b < len(formatted):
        if a < len(original) and b < len(formatted) and original[a] == formatted[b]:
            a += 1
            b += 1
        elif b >= len(formatted) or (a < len(original) and common[(a + 1) * columns + b] >= common[a * columns + b + 1]):
            lines.append(f"-{numbered(a + 1)} | {original[a]}")
            a += 1
        else:
            lines.append(f"+{numbered(b + 1)} | {formatted[b]}")
            b += 1
    return lines


def numbered(line: int) -> str:
    """A line number right-aligned in four columns."""
    mut text = str(line)
    while len(text) < 4:
        text = " " + text
    return text
