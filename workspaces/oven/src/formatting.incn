"""Oven's formatting invocation; the compiler owns parsing and the single formatter implementation."""

from std.fs import Path
from rust::std::string import String as RustString
from driver_command import driver_command
from files import parse_json
from json_fields import strings
from features import FeatureRequest
from incan_units import format_unit
from intake import intake
from toolchain import Toolchain, load_toolchain
from unit import UnitDescription, describe
from unit_rust import prepare_native
from cli_help import render

pub const USAGE: str = "incan fmt [--check] PATH..."


pub model FormatRequest:
    """What `incan fmt` was asked to do: the paths to format, and whether to only check them."""

    pub check: bool
    pub paths: list[str]


pub def help_text() -> str:
    """Describe the formatting options without discovering or reading source files."""
    return render(
        USAGE,
        [
            "  --check  Report changes without writing; exit 1 when a file would change.",
            "  --       End option parsing.",
        ],
        "incan fmt --check src",
    )


pub def format_paths(request: FormatRequest) -> Result[i32, str]:
    """
    Format every `.incn` file in the given files and trees, or with `--check` report the files that would change.

    A file that cannot be described or formatted is reported and the others still run. The exit code is 1 when any
    file failed or, with `--check`, would change.

    1. Load the installed toolchain once for the invocation.
    2. Discover the source files through the compiler's authored-file policy.
    3. Format every selected file, retaining a failure even when a later file succeeds.
    """
    # 1. Every file uses the same selected installation.
    toolchain = load_toolchain()?
    # 2. The compiler owns hidden-directory and symbolic-link policy for every client.
    files = discover(request.paths, toolchain)?
    mut code: i32 = 0
    # 3. One failed file does not prevent the remaining files from being processed.
    for file in files:
        if format_file(file, toolchain, request.check)? != 0:
            code = 1
    return Ok(code)


pub def parse_arguments(arguments: list[str]) -> Result[FormatRequest, str]:
    """Read `--check` and the paths; `--` ends the options, so a path after it may start with `-`."""
    mut check = false
    mut paths: list[str] = []
    mut options = true
    for argument in arguments:
        if options and argument == "--":
            options = false
        elif options and argument == "--check":
            check = true
        elif options and argument.startswith("-"):
            return Err(f"unknown option `{argument}`")
        else:
            paths.append(argument)
    if len(paths) == 0:
        return Err("a PATH is required")
    return Ok(FormatRequest(check=check, paths=paths))


def discover(paths: list[str], toolchain: Toolchain) -> Result[list[str], str]:
    """Every source under the given paths, each once, in a deterministic order."""
    mut files: list[str] = []
    for path in paths:
        for file in sources(Path(path), toolchain)?:
            if file not in files:
                files.append(file)
    if len(files) == 0:
        return Err("no .incn files found")
    return Ok(files)


def format_file(file: str, toolchain: Toolchain, check: bool) -> Result[i32, str]:
    """Format or check one file with its own unit's vocabulary; a file whose unit cannot be described reports why."""
    match describe_formatting(file, toolchain):
        Err(reason) =>
            println(f"Error formatting {file}: {reason}")
            return Ok(1)
        Ok(unit) => return format_unit(unit, toolchain, file, check)


def describe_formatting(file: str, toolchain: Toolchain) -> Result[UnitDescription, str]:
    """Describe one source and prepare its registered syntax; ordinary syntax needs no native build."""
    unit = describe(Path(file), "debug", FeatureRequest())?
    if needs_vocabulary(unit)?:
        return prepare_native(unit, toolchain)
    return Ok(unit)


def needs_vocabulary(unit: UnitDescription) -> Result[bool, str]:
    """Whether an active local dependency declares an entry whose registration supplies parser syntax."""
    if not Path(unit.project_root).joinpath("loaf.toml").is_file():
        return Ok(false)
    graph = intake(Path(unit.project_root)).map_err((error) => error.message())?
    reached = [loaf.name for loaf in unit.loaves if not loaf.standard]
    for project in graph.projects:
        if project.intent.name in reached and project.intent.vocab_entry != None:
            return Ok(true)
    return Ok(false)


def sources(path: Path, toolchain: Toolchain) -> Result[list[str], str]:
    """Ask the installed compiler for its single deterministic authored-file discovery result."""
    mut command = driver_command(toolchain)?
    command.arg("--source-files").arg(path.0)
    output = command.output().map_err((error) => f"{path.0}: {error}")?
    if not output.status.success():
        return Err(decode(output.stderr)?)
    paths = parse_json(decode(output.stdout)?)?
    return strings(paths, []).map_err((_) => "compiler source discovery must be a path list")


def decode(value: bytes) -> Result[str, str]:
    """Require UTF-8 for the compiler's discovery protocol and diagnostics."""
    match RustString.from_utf8(value):
        Ok(text) => return Ok(str(text))
        Err(error) => return Err(str(error))
