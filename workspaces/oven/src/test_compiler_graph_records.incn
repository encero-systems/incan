"""Ranked compiler graph records publish their value, receipt and both edge directions atomically."""

from pub::incan_platform.store import get, keys
from pub::incan_platform.store import snapshot as store_snapshot
from pub::incan_platform.store.memory import root as memory_root
from pub::internal_models.records import (
    AbsentFact,
    DeletedFact,
    MemberSelection,
    PayloadSelection,
    PreparationEvidence,
    ReadReceipt,
    ReadScope,
    ReadWitness,
    RecordKey,
    RecordRequest,
    RecordSelection,
    RevisionEvidence,
    READ_SCHEMA,
)
from pub::internal_models import ProducerRank, ProducerStage
from compiler_graph_records import publish_evaluation


pub def test_value_evaluation_and_edges_publish_in_one_generation() -> Result[None, str]:
    """No selected snapshot can observe only part of a completed evaluation and its four witness kinds."""
    before = store_snapshot(memory_root()).map_err((error) => error.message())?
    receipt = witnessed_receipt()
    published = publish_evaluation(
        before,
        "claim",
        ProducerRank(namespace=2, stage=ProducerStage.CheckBody, dependency=3),
        b"checked local",
        receipt,
    )?
    assert published.snapshot.generation == before.generation + 1
    assert get(before, published.value_key).map_err((error) => error.message())? is None
    assert get(before, published.receipt_key).map_err((error) => error.message())? is None
    assert get(before, published.evaluation_key).map_err((error) => error.message())? is None
    assert get(published.snapshot, published.value_key).map_err((error) => error.message())? == Some(b"checked local")
    assert get(published.snapshot, published.receipt_key).map_err((error) => error.message())? is not None
    assert get(published.snapshot, published.evaluation_key).map_err((error) => error.message())? is not None
    selected = keys(published.snapshot).map_err((error) => error.message())?
    assert count_prefix(selected, "incan.engine.edge-out\t") == 4
    assert count_prefix(selected, "incan.engine.edge-in\t") == 4
    assert published.edge_count == 4
    return Ok(None)


def witnessed_receipt() -> ReadReceipt:
    """Build one complete receipt containing present, deleted, absent and member witnesses."""
    scope = ReadScope(snapshot="snapshot", profile="profile")
    present = request("present", RecordSelection.Payload(PayloadSelection(reference="payload", offset=0, length=2)))
    deleted = request("deleted", RecordSelection.Field("value"))
    absent = request("absent", RecordSelection.Field("value"))
    members = request(
        "members",
        RecordSelection.Members(
            MemberSelection(selector="children", order="canonical", lower="", upper="", continuation=""),
        ),
    )
    return ReadReceipt(
        schema=READ_SCHEMA,
        scope=scope,
        preparation=PreparationEvidence(
            output=key("output"),
            rank_certificate="rank-certificate",
            selector_witnesses="selector-witnesses",
        ),
        witnesses=[
            ReadWitness.Found(
                RevisionEvidence(
                    scope=scope,
                    request=present,
                    revision="present-revision",
                    semantic_digest="value-digest",
                ),
                "selection-digest",
            ),
            ReadWitness.Deleted(DeletedFact(scope=scope, request=deleted, revision="tombstone-revision")),
            ReadWitness.Absent(AbsentFact(scope=scope, request=absent, exclusion_digest="exclusion-digest")),
            ReadWitness.Members(scope, members, "membership-digest", "end"),
        ],
        operations=4,
        response_bytes=2,
    )


def request(identity: str, selection: RecordSelection) -> RecordRequest:
    """Create one exact prepared request."""
    return RecordRequest(key=key(identity), selection=selection)


def key(identity: str) -> RecordKey:
    """Create one compiler record key."""
    return RecordKey(
        family="local",
        identity_profile="identity/1",
        origin="package",
        identity=identity,
        facet="checked",
        context="",
    )


def count_prefix(values: list[str], prefix: str) -> int:
    """Count selected store keys in one engine-owned graph family."""
    mut count = 0
    for value in values:
        if value.startswith(prefix):
            count += 1
    return count
