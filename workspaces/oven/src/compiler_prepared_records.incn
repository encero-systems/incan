"""Authenticate compiler facts staged in the current unpublished graph transaction."""

from std.encoding.hex import hexlify
from std.primitives.hash import sha256
from pub::internal_models.source_value_records import source_value
from pub::internal_models.record_scope import MAX_CHECKER_ROW_BYTES, checked_row_family, checked_row_request
from pub::internal_models.records import (
    PayloadSelection,
    PreparationEvidence,
    ReadFault,
    ReadReceipt,
    ReadScope,
    RevisionEvidence,
    SelectedFact,
    RecordKey,
    RecordRead,
    RecordReads,
    RecordSource,
    RecordRequest,
    RecordSelection,
    encode_record_key,
    selected_record_bytes,
)


pub class PreparedBodyRecordSource with RecordSource:
    """Authenticate reads from the exact values staged by one compiled-body publication transaction."""

    scope: ReadScope
    values: Dict[str, bytes] = {}

    @staticmethod
    pub def open(scope: ReadScope) -> PreparedBodyRecordSource:
        """Create an empty source bound to one compiler profile and publication preparation."""
        return PreparedBodyRecordSource(scope=scope)

    pub def add(mut self, key: str, value: bytes) -> None:
        """Make one exact pending value available to later producers in the same transaction."""
        self.values[key] = value

    pub def holds(self, key: str) -> bool:
        """Whether a value is already available under one encoded record key."""
        return key in self.values

    pub def for_profile(self, profile: str) -> PreparedBodyRecordSource:
        """Bind the same staged values to the next producer profile without weakening its read-scope check."""
        scope = ReadScope(snapshot=self.scope.snapshot, profile=profile)
        return PreparedBodyRecordSource(scope=scope, values=self.values)

    pub def receipt(
        self,
        scope: ReadScope,
        output: RecordKey,
        requests: list[RecordRequest],
        rank_certificate: str = "compiled-check",
    ) -> Result[ReadReceipt, str]:
        """Authenticate one producer's exact inputs from the caller-owned publication transaction."""
        preparation = PreparationEvidence(
            output=output,
            rank_certificate=rank_certificate,
            selector_witnesses="compiled-check",
        )
        mut bounded: list[RecordRequest] = []
        for item in requests:
            if item.byte_limit == MAX_CHECKER_ROW_BYTES and checked_row_family(item.key.family) and item.selection == RecordSelection.Field("value"):
                encoded_key = encode_record_key(item.key)?
                if encoded_key in self.values:
                    bounded.append(checked_row_request(item.key, len(self.values[encoded_key]))?)
                    continue
            bounded.append(item)
        mut reads = RecordReads.start(scope, preparation, bounded)
        for item in bounded:
            match reads.read(self, item):
                RecordRead.Failed(fault) =>
                    written = encode_record_key(output)?
                    wanted = encode_record_key(item.key)?
                    return Err(f"compiled body publication for {written} could not read {wanted}: {fault:?}")
                _ => pass
        return reads.finish().map_err((_) => "compiled body publication produced an incomplete receipt")

    def read(self, scope: ReadScope, request: RecordRequest) -> RecordRead:
        """Return one staged selection with full-value evidence, or fail when publication left it unavailable."""
        if scope != self.scope:
            return RecordRead.Failed(ReadFault.SnapshotMismatch)
        key = match encode_record_key(request.key):
            Ok(value) => value
            Err(_) => return RecordRead.Failed(ReadFault.InvalidEvidence)

        if key not in self.values:
            return RecordRead.Failed(ReadFault.UnfinishedSupplier)
        physical = self.values[key]
        value = match source_value(request.key, physical):
            Ok(logical) => logical
            Err(_) => return RecordRead.Failed(ReadFault.DamagedRecord)

        selected = match selected_record_bytes(value, request):
            Some(result) => result
            None => return RecordRead.Failed(ReadFault.InvalidEvidence)

        semantic = hexlify(sha256.digest(value))
        evidence = RevisionEvidence(scope=scope, request=request, revision=hexlify(sha256.digest(physical)), semantic_digest=semantic)
        return RecordRead.Found(SelectedFact(evidence=evidence, value=selected, selection_digest=semantic))


pub def prepared_product_request(key: RecordKey) -> RecordRequest:
    """Read scalar facts and bind opaque compiler products through their complete semantic digest."""
    if key.family in ["body-ir", "lowering-demand", "plan-function", "namespace", "plan-module"]:
        selected = PayloadSelection(reference=key.context, offset=0, length=0)
        return RecordRequest(key=key, selection=RecordSelection.Payload(selected))
    if checked_row_family(key.family):
        return RecordRequest(key=key, selection=RecordSelection.Field("value"), byte_limit=MAX_CHECKER_ROW_BYTES)
    return RecordRequest(key=key, selection=RecordSelection.Field("value"))
