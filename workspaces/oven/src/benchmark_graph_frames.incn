"""Replay the measured request's semantic graph selections against the committed index for each selection."""

from rust::std::rc import Rc
from std.encoding.hex import hexlify
from std.fs import Path
from std.hash import sha256
from std.json import JsonValue
from pub::incan_platform.store import Snapshot, get, lookup_members, read_manifest
from pub::incan_platform.store.index import Location, find
from pub::internal_models import decode_read_receipt
from pub::internal_models.overload_members import OVERLOAD_MEMBERS
from pub::internal_models.records import ReadReceipt, ReadWitness, RecordRequest, RecordSelection, encode_record_key
from compiler_graph_rows import read_evaluation
from compiler_graph_records import evaluation_record_key
from decimal_text import digits_only
from json_fields import required_items, required_text
from store_path_conversion import store_path

const RECEIPT_KEY_PREFIX: str = "incan.engine.receipt\t"


pub model GraphFrames:
    """An immutable frame has one required read regardless of the number of semantically equivalent requests."""

    pub lengths: Dict[str, int] = {}
    pub roots: list[str] = []
    pub unknown: list[str] = []


pub def required_graph_frames(report: JsonValue, store: Path) -> Result[GraphFrames, str]:
    """
    Derive required frame identities and widths without consulting the measured read inventory.

    Read each demand's pinned view, then resolve only the frame or typed request it selects.
    """
    mut result = GraphFrames()
    mut snapshots: Dict[str, Snapshot] = {}
    mut receipts = ReceiptViews()
    mut reported = 0
    for demand in required_items(report, "graph_demands")?:
        role = required_text(demand, "role")?
        directory = required_text(demand, "store")?
        generation = demand.require("generation").map_err((error) => error.message())?.expect_int().map_err((error) => error.message())?
        manifest = required_text(demand, "manifest")?
        view = required_text(demand, "view")?
        key = required_text(demand, "key")?
        if role == "capture-mode":
            reported += 1
            if directory != store.0 or len(key) != 64:
                return Err("capture belongs to another bakery or lacks a revision")
        if role not in [
            "capture-mode", "program-handle", "standalone-selector", "baked-unit", "bakery-name", "output-slot",
            "reverse-edge", "evaluation", "evaluation-digest", "evaluation-frame", "evaluation-value", "receipt-frame",
            "witness",
        ]:
            return Err(f"unknown graph selector {role}")
        if directory != store.0:
            result.unknown.append(f"independent store root required for {directory}: {role} {key}")
            continue
        result.roots.append(f"{role}\t{generation}\t{manifest}\t{view}\t{key}")
        needs_view = role in ["evaluation-frame", "evaluation-value", "receipt-frame", "witness"]
        if generation == 0 and manifest == "" and not needs_view:
            continue
        if generation <= 0 or len(manifest) != 64:
            return Err("incomplete graph snapshot identity")
        witness = manifest + "/" + view
        if witness not in snapshots:
            snapshots[witness] = read_manifest(store_path(store), generation, manifest, view).map_err((error) => error.message())?
        selected = snapshots[witness]
        if selected.generation != generation:
            return Err("graph selector generation differs from its selected snapshot")
        if role != "capture-mode":
            select_graph_frames(selected, role, key, receipts, result)?
    if reported != 1:
        return Err(f"request records {reported} capture roots")
    return Ok(result)


def select_graph_frames(
    selected: Snapshot, role: str, key: str, mut receipts: ReceiptViews, mut result: GraphFrames,
) -> Result[None, str]:
    """Budget one ordinary lookup or expand an actual typed witness read."""
    if role == "witness":
        return select_witness_frames(selected, key, receipts, result)
    live = role in ["evaluation-frame", "evaluation-value", "receipt-frame"]
    match frame_location(selected, key)?:
        Some(found) =>
            if live and found.tombstone:
                return Err(f"selected graph value is deleted: {key}")
            if role == "receipt-frame":
                _ = receipts.read(selected, key)?
            if role == "evaluation" and not found.tombstone:
                evaluation = read_evaluation(required_value(selected, key)?)?
                if evaluation_record_key(evaluation.profile, evaluation.output) != key:
                    return Err("graph evaluation differs from its selected key")
            if role != "evaluation-frame":
                add_frame(result, key, found)
        None =>
            if live:
                return Err(f"selected graph value is absent: {key}")
    return Ok(None)


def select_witness_frames(
    selected: Snapshot, selection: str, mut receipts: ReceiptViews, mut result: GraphFrames,
) -> Result[None, str]:
    """Recover the exact typed request and independently resolve its selected frame or page."""
    fields = selection.split("\t")
    if len(fields) < 3 or len(fields[0]) != 64:
        return Err("invalid graph witness identity")
    ordinal_text = fields[1]
    if ordinal_text == "" or len(ordinal_text) > 9 or not digits_only(ordinal_text):
        return Err("invalid graph witness ordinal")
    ordinal = int(ordinal_text)
    # Only the first two delimiters belong to the event. The canonical key can end in an empty field.
    key = selection[len(fields[0]) + len(ordinal_text) + 2:]
    receipt = receipts.read(selected, RECEIPT_KEY_PREFIX + fields[0])?
    selected_receipt = receipt.as_ref()
    if ordinal >= len(selected_receipt.witnesses) or str(ordinal) != ordinal_text:
        return Err("graph witness ordinal is outside its receipt")
    request = witness_request(selected_receipt.witnesses[ordinal])
    if encode_record_key(request.key)? != key:
        return Err("graph witness key differs from its receipt request")
    if let RecordSelection.Members(page) = request.selection:
        if request.key.family != OVERLOAD_MEMBERS:
            if page.order != "canonical" or request.byte_limit <= 0:
                return Err("invalid membership request in graph witness")
            members = lookup_members(
                selected, key, page.lower, page.upper, page.continuation, request.byte_limit,
            ).map_err((error) => error.message())?
            names = [member.key[len(key) + 1:] for member in members.members]
            if len("\n".join(names).encode("utf-8")) > request.byte_limit:
                return Err("membership result exceeds the graph witness's byte limit")
            for member in members.members:
                match frame_location(selected, member.key)?:
                    Some(found) =>
                        if found.tombstone or hexlify(found.digest) != member.revision:
                            return Err("graph member frame differs from its selected revision")
                        add_frame(result, member.key, found)
                    None => return Err("graph member frame is missing")
            return Ok(None)
    # Slot, range, digest-only and overload reads authenticate a point frame, including a selected tombstone.
    if let Some(found) = frame_location(selected, key)?:
        add_frame(result, key, found)
    return Ok(None)


def witness_request(witness: ReadWitness) -> RecordRequest:
    """Recover all selection fields, including the exact byte allowance, from the recorded witness."""
    match witness:
        ReadWitness.Found(found, _) => return found.request
        ReadWitness.Deleted(deleted) => return deleted.request
        ReadWitness.Absent(absent) => return absent.request
        ReadWitness.Members(_, request, _, _) => return request


class ReceiptViews:
    """Reuse decoded receipts only within the same authenticated immutable view of this store."""

    by_view: Dict[tuple[int, str, str, str], Rc[ReadReceipt]] = {}

    pub def read(mut self, selected: Snapshot, key: str) -> Result[Rc[ReadReceipt], str]:
        """Authenticate the selected content root once, sharing the immutable receipt across its witnesses."""
        identity = (selected.generation, selected.digest, selected.view, key)
        if let Some(prior) = self.by_view.get(identity):
            return Ok(prior)
        if not key.startswith(RECEIPT_KEY_PREFIX) or len(key) != len(RECEIPT_KEY_PREFIX) + 64:
            return Err("invalid graph receipt key")
        payload = required_value(selected, key)?
        if hexlify(sha256.digest(payload)) != key[len(RECEIPT_KEY_PREFIX):]:
            return Err("graph receipt payload differs from its content root")
        receipt = Rc.new(decode_read_receipt(payload)?)
        self.by_view[identity] = receipt.clone()
        return Ok(receipt)


def frame_location(selected: Snapshot, key: str) -> Result[Option[Location], str]:
    """Return the authenticated index's physical address, including a tombstone selection."""
    return find(selected.root, selected.index, key).map_err((error) => f"{error.object}: {error.detail}")


def required_value(selected: Snapshot, key: str) -> Result[bytes, str]:
    """Read the bytes of a live graph record selected by the current pinned view."""
    match get(selected, key).map_err((error) => error.message())?:
        Some(value) => return Ok(value)
        None => return Err("missing certified graph value: " + key)


def add_frame(mut result: GraphFrames, key: str, location: Location) -> None:
    result.lengths[hexlify(location.digest) + "\t" + key] = location.length
