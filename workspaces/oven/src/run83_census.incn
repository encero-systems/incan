"""Read the retained run-83 compiler sidecar without hiding later owner evidence."""

from std.fs import File, Path
from rust::std::fs import metadata
from pub::internal_models import CompiledBodyOutput, compiled_body_frame_size, decode_compiled_body_payload


def main() -> Result[None, str]:
    path = Path(
        "/Volumes/Builds/incan-dev9-work/b4/lane/run80/repo/workspaces/oven/target/incan/units/0eb925855a8127da11399af99bff399485af989afdf6d19db27c5cc785493a22.unit.json.graph-body-output",
    )
    mut file = path.open("rb").map_err((error) => error.message())?
    mut remaining = metadata(path.0).map_err((error) => str(error))?.len()
    mut index = 0
    while remaining > 0u64:
        if remaining < 8u64:
            return Err(f"truncated prefix after frame {index}")
        prefix = file.read_exact(8).map_err((error) => error.message())?
        size = compiled_body_frame_size(prefix).map_err((error) => f"frame {index} prefix: {error:?}")?
        converted: Option[u64] = size.try_resize()
        frame_bytes = match converted:
            Some(value) => value
            None => return Err(f"frame {index} exceeds host range")

        if frame_bytes + 8u64 > remaining:
            return Err(f"frame {index} is truncated")
        payload = file.read_exact(size).map_err((error) => error.message())?
        remaining -= frame_bytes + 8u64
        match decode_compiled_body_payload(payload):
            Err(error) => println(f"MALFORMED\t{index}\t{error:?}")
            Ok(CompiledBodyOutput.Namespace(_)) => pass
            Ok(CompiledBodyOutput.Value(value)) =>
                println(f"ELIGIBLE\t{value.module}\t{value.name}")
            Ok(CompiledBodyOutput.Fallback(fallback)) =>
                println(f"FALLBACK\t{fallback.module}\t{fallback.name}\t{fallback.reason}")
        index += 1
    println(f"FRAMES\t{index}")
    return Ok(None)
