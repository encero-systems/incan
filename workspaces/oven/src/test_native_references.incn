"""Anchored native-closure references resolve in every home that shares a bakery."""

from files import json_text
from json_fields import required_text
from native_references import (
    RUST_NATIVE_SCHEMA,
    NativeAnchors,
    anchored_reference,
    closure_reference,
    rust_native_document,
)
from toolchain_types import NativeCrate
from std.fs import Path


pub def test_reference_published_in_one_home_resolves_in_another() -> Result[None, str]:
    """
    Publish references in one home and resolve them in a second home with the same toolchain and bakery.

    1. Toolchain and bakery paths are anchored, so the spelling names neither home.
    2. The second home resolves each anchor against its own toolchain and the shared bakery.
    3. A path under neither stays absolute.
    """
    first = NativeAnchors(toolchain="/homes/a/toolchains/t", bakery="/shared/bakery")
    second = NativeAnchors(toolchain="/homes/b/toolchains/t", bakery="/shared/bakery")
    library = Path("/shared/bakery/libraries/layout")
    # 1. Neither published spelling names the publishing home.
    runtime = anchored_reference("/homes/a/toolchains/t/native/d/libruntime.rlib", first)
    dependency = anchored_reference("/shared/bakery/libraries/l/libdependency.rlib", first)
    assert runtime == "toolchain:native/d/libruntime.rlib", runtime
    assert dependency == "bakery:libraries/l/libdependency.rlib", dependency
    # 2. The second home reads its own toolchain and the shared bakery.
    assert closure_reference(library, runtime, second)? == "/homes/b/toolchains/t/native/d/libruntime.rlib"
    assert closure_reference(library, dependency, second)? == "/shared/bakery/libraries/l/libdependency.rlib"
    # 3. An outside path is written and read as it is.
    outside = anchored_reference("/opt/native/libsystem.rlib", first)
    assert outside == "absolute:/opt/native/libsystem.rlib", outside
    assert closure_reference(library, outside, second)? == "/opt/native/libsystem.rlib"
    return Ok(None)


pub def test_sibling_and_legacy_references_resolve_from_the_loaf() -> Result[None, str]:
    """
    Resolve Loaf-relative references and the bare spellings of closures published before anchors.

    1. A sibling reference and a bare relative path both name their target from the Loaf's directory.
    2. A bare absolute path is used as written.
    3. An anchor with the wrong path form is refused.
    """
    anchors = NativeAnchors(toolchain="/toolchain", bakery="/bakery")
    directory = Path("/toolchain/loaves/std/debug")
    # 1. Both spellings collapse onto the same artifact.
    expected = "/toolchain/native/d/libstd.rlib"
    assert closure_reference(directory, "sibling:../../../native/d/libstd.rlib", anchors)? == expected
    assert closure_reference(directory, "../../../native/d/libstd.rlib", anchors)? == expected
    # 2. A legacy absolute path keeps its meaning.
    assert closure_reference(directory, "/opt/search", anchors)? == "/opt/search"
    # 3. Mixed forms are not guessed.
    assert closure_reference(directory, "toolchain:/native", anchors).is_err()
    assert closure_reference(directory, "absolute:native", anchors).is_err()
    return Ok(None)


pub def test_rust_facet_inputs_are_anchored_under_their_schema() -> Result[None, str]:
    """A Rust facet's recorded inputs carry the anchored schema and name no home's toolchain or bakery path."""
    anchors = NativeAnchors(toolchain="/homes/a/toolchains/t", bakery="/shared/bakery")
    serde = NativeCrate(name="serde", path="/homes/a/toolchains/t/registry/entries/e/artifacts/libserde.rlib")
    document = rust_native_document([serde], ["/shared/bakery/rust/unit"], anchors)
    assert required_text(document, "schema")? == RUST_NATIVE_SCHEMA
    text = json_text(document)?
    assert "toolchain:registry/entries/e/artifacts/libserde.rlib" in text, text
    assert "bakery:rust/unit" in text, text
    assert "/homes/a" not in text and "/shared/bakery" not in text, text
    return Ok(None)
