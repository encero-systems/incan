"""
Exercise the ordinary developer loop through the actual selected compiler.

Run this executable with COMPILER ROOT SCENARIO arguments. ROOT is a disposable test directory. Missing commands fail
the selected case; they are never reported as supported merely because the command returned a diagnostic.
"""

from rust::std::env import args
from rust::std::process import Command
from rust::std::string import String as RustString
from std.fs import Path


def invoke(compiler: str, root: str, arguments: list[str]) -> str:
    """Run one real command, preserving stderr on failure and requiring successful process completion."""
    mut command = Command.new(compiler)
    command.current_dir(root)
    for argument in arguments:
        command.arg(argument)
    match command.output():
        Err(error) =>
            println(str(error))
            assert false
            return ""
        Ok(output) =>
            match RustString.from_utf8(output.stderr):
                Ok(stderr) =>
                    if str(stderr) != "":
                        println(str(stderr))
                Err(_) =>
                    assert false
            match RustString.from_utf8(output.stdout):
                Ok(stdout) =>
                    if not output.status.success():
                        println(str(stdout))
                    assert output.status.success()
                    return str(stdout)
                Err(_) =>
                    assert false
                    return ""


def write_source(path: str, content: str) -> None:
    """Write only a caller-selected disposable fixture path and surface filesystem failure."""
    match Path(path).write_text(content, encoding="utf-8", errors="strict", newline=None):
        Ok(_) => pass
        Err(error) =>
            println(error.message())
            assert false


def scaffold(compiler: str, root: str) -> None:
    """Create two ordinary projects without any explicit bake command."""
    invoke(compiler, root, ["new", "workflow_a", "--yes"])
    invoke(compiler, root, ["new", "workflow_b", "--yes"])


def ordinary(compiler: str, root: str) -> None:
    """Require changed output and a stable second project through public ordinary commands."""
    a = f"{root}/workflow_a"
    b = f"{root}/workflow_b"
    source = "pub def answer() -> int:\n    return 42\n\ndef main() -> None:\n    println(answer())\n"
    write_source(f"{a}/src/main.incn", source)
    write_source(f"{b}/src/main.incn", source)
    write_source(
        f"{a}/tests/test_main.incn",
        "from main import answer\n\ndef test_answer() -> None:\n    assert answer() == 42\n",
    )
    assert invoke(compiler, a, ["run", "--release"]) == "42\n"
    assert invoke(compiler, a, ["run", "--release"]) == "42\n"
    invoke(compiler, a, ["check", "src/main.incn"])
    invoke(compiler, a, ["build", "--release"])
    invoke(compiler, a, ["test"])
    write_source(
        f"{a}/src/main.incn",
        "pub def answer() -> int:\n    return 43\n\ndef main() -> None:\n    println(answer())\n",
    )
    write_source(
        f"{a}/tests/test_main.incn",
        "from main import answer\n\ndef test_answer() -> None:\n    assert answer() == 43\n",
    )
    assert invoke(compiler, a, ["run", "--release"]) == "43\n"
    assert invoke(compiler, a, ["run", "--release"]) == "43\n"
    invoke(compiler, a, ["test"])
    assert invoke(compiler, b, ["run", "--release"]) == "42\n"


def dependency_fixture(compiler: str, root: str) -> None:
    """Create a controlled local source loaf; both consumers must prepare the same authored dependency."""
    invoke(compiler, root, ["new", "workflow_dependency", "--yes"])
    dependency = f"{root}/workflow_dependency"
    write_source(f"{dependency}/loaf.toml", "[project]\nname = \"workflow_dependency\"\nversion = \"0.1.0\"\n")
    write_source(f"{dependency}/src/lib.incn", "pub def value() -> int:\n    return 100\n")


def local_dependency(compiler: str, root: str) -> None:
    """Require automatic preparation and child-source invalidation without a manual bake."""
    for name in ["workflow_a", "workflow_b"]:
        project = f"{root}/{name}"
        write_source(
            f"{project}/loaf.toml",
            f"[project]\nname = \"{name}\"\nversion = \"0.1.0\"\n\n[project.scripts]\nmain = \"src/main.incn\"\n\n[dependencies]\nworkflow_dependency = {{ path = \"../workflow_dependency\" }}\n",
        )
        write_source(
            f"{project}/src/main.incn",
            "from pub::workflow_dependency import value\n\ndef main() -> None:\n    println(value())\n",
        )
        assert invoke(compiler, project, ["run", "--release"]) == "100\n"
    write_source(f"{root}/workflow_dependency/src/lib.incn", "pub def value() -> int:\n    return 101\n")
    for name in ["workflow_a", "workflow_b"]:
        assert invoke(compiler, f"{root}/{name}", ["run", "--release"]) == "101\n"
        assert invoke(compiler, f"{root}/{name}", ["run", "--release"]) == "101\n"


def require_failed_native_test(compiler: str, project: str) -> None:
    """Require the selected assertion to fail; setup or compilation errors do not satisfy this check."""
    mut command = Command.new(compiler)
    command.current_dir(project)
    for argument in ["oven", "tests", "src/lib.rs", "--rust-only", "--fail-on-empty", "--format", "json"]:
        command.arg(argument)
    match command.output():
        Ok(output) =>
            match RustString.from_utf8(output.stdout):
                Ok(stdout) =>
                    text = str(stdout)
                    println(text)
                    assert not output.status.success()
                    assert "external_value" in text
                    assert "\"failed\":1" in text.replace(" ", "")
                Err(_) =>
                    assert false
        Err(error) =>
            println(str(error))
            assert false


def external_test_input(compiler: str, root: str, change_root: bool) -> None:
    """Expose stale native-test reuse with a path module outside src and unchanged root source."""
    mut name = "workflow_rust"
    if change_root:
        name = "workflow_rust_control"
    invoke(compiler, root, ["new", name, "--yes"])
    project = f"{root}/{name}"
    write_source(
        f"{project}/loaf.toml",
        "[project]\nname = \"workflow_rust\"\nversion = \"0.1.0\"\n\n[rust]\ntype = \"lib\"\nedition = \"2024\"\n",
    )
    write_source(
        f"{project}/src/lib.rs",
        "#[path = \"../helper.rs\"]\nmod helper;\n#[test]\nfn external_value() { assert_eq!(helper::value(), 42); }\n",
    )
    write_source(f"{project}/helper.rs", "pub fn value() -> i32 { 42 }\n")
    invoke(compiler, project, ["oven", "tests", "src/lib.rs", "--rust-only", "--fail-on-empty", "--format", "json"])
    write_source(f"{project}/helper.rs", "pub fn value() -> i32 { 43 }\n")
    if change_root:
        write_source(
            f"{project}/src/lib.rs",
            "#[path = \"../helper.rs\"]\nmod helper;\n#[test]\nfn external_value() { assert_eq!(helper::value(), 42); }\n\n",
        )
    require_failed_native_test(compiler, project)

    write_source(f"{project}/helper.rs", "pub fn value() -> i32 { 42 }\n")
    if change_root:
        write_source(
            f"{project}/src/lib.rs",
            "#[path = \"../helper.rs\"]\nmod helper;\n#[test]\nfn external_value() { assert_eq!(helper::value(), 42); }\n",
        )
    invoke(compiler, project, ["oven", "tests", "src/lib.rs", "--rust-only", "--fail-on-empty"])


def main() -> None:
    """Select one acceptance case so missing capabilities remain individually reproducible."""
    mut arguments: list[str] = []
    for argument in args():
        arguments.append(argument)
    assert len(arguments) == 4
    compiler = arguments[1]
    root = arguments[2]
    scenario = arguments[3]
    if scenario == "scaffold":
        scaffold(compiler, root)
    elif scenario == "ordinary":
        ordinary(compiler, root)
    elif scenario == "oven-build":
        invoke(compiler, f"{root}/workflow_a", ["oven", "build", "--release"])
    elif scenario == "oven-run":
        assert invoke(compiler, f"{root}/workflow_a", ["oven", "run", "--release"]) == "43\n"
    elif scenario == "dependency-fixture":
        dependency_fixture(compiler, root)
    elif scenario == "local-dependency":
        local_dependency(compiler, root)
    elif scenario == "external-test-input":
        external_test_input(compiler, root, false)
    elif scenario == "external-test-control":
        external_test_input(compiler, root, true)
    elif scenario == "dependency-add":
        invoke(
            compiler,
            f"{root}/workflow_a",
            ["oven", "add", "workflow_dependency", "--path", "../workflow_dependency"],
        )
    else:
        println(f"unknown acceptance case: {scenario}")
        assert false
    println(f"developer workflow passed: {scenario}")
