"""Project one source file into independently digestible owner, default-expression and module-header records."""

from std.encoding.hex import hexlify
from std.primitives.hash import sha256
from pub::incan_platform.store import Snapshot, begin, commit, put
from pub::internal_models.records import RecordKey, encode_record_key

const SOURCE_PROFILE: str = "incan.source-projection/1"


pub model SourceProjectionRecord:
    """One exact source slice, its original coordinates and its digest over only the slice bytes."""

    pub key: RecordKey
    pub text: str
    pub start: int
    pub end: int

    pub def digest(self) -> str:
        """Return the semantic identity of this slice without folding file-wide coordinates into it."""
        return hexlify(sha256.digest(self.text.encode("utf-8")))


pub model SourceProjection:
    """The module context, declaration surface and independently reusable callable owners projected from one source file."""

    pub header: SourceProjectionRecord
    pub declarations: SourceProjectionRecord
    pub owners: list[SourceProjectionRecord]


pub model PublishedSourceProjection:
    """The store generation and canonical record keys published by one source projection."""

    pub snapshot: Snapshot
    pub keys: list[str]


model Boundary:
    """One top-level source chunk and the callable name it owns, when it is a body owner."""

    start: int
    owner: str


class SourceProjector:
    """A single-file projector that keeps source slicing state inside its owning operation."""

    origin: str
    path: str
    source: str
    lines: list[str]
    boundaries: list[Boundary] = []

    @staticmethod
    pub def open(origin: str, path: str, source: str) -> SourceProjector:
        """Prepare exact newline-preserving lines for one source file."""
        parts = source.split("\n")
        mut lines: list[str] = []
        for index in range(len(parts)):
            mut suffix = ""
            if index + 1 < len(parts):
                suffix = "\n"
            lines.append(parts[index] + suffix)
        return SourceProjector(origin=origin, path=path, source=source, lines=lines)

    def discover(mut self) -> None:
        """Locate top-level chunks while attaching consecutive decorators to their following declaration."""
        mut offset = 0
        mut decorated_start = -1
        for line in self.lines:
            content = line.strip()
            top_level = content != "" and line[0] not in " \t"
            if top_level and content.startswith("@"):
                if decorated_start < 0:
                    decorated_start = offset
            elif top_level and not content.startswith("#"):
                mut start = 0
                if decorated_start >= 0:
                    start = decorated_start
                else:
                    start = offset
                self.boundaries.append(Boundary(start=start, owner=declaration_owner(content)))
                decorated_start = -1
            offset += len(line)
        if decorated_start >= 0:
            self.boundaries.append(Boundary(start=decorated_start, owner=""))

    pub def projection(mut self) -> Result[SourceProjection, str]:
        """Partition source owners and nested defaults while retaining a declaration surface for selector invalidation."""
        self.discover()
        mut header = ""
        mut declarations = ""
        mut owners: list[SourceProjectionRecord] = []
        if len(self.boundaries) == 0:
            header = self.source
        else:
            if self.boundaries[0].start > 0:
                header += self.source[:self.boundaries[0].start]
            for index in range(len(self.boundaries)):
                boundary = self.boundaries[index]
                mut end = len(self.source)
                if index + 1 < len(self.boundaries):
                    end = self.boundaries[index + 1].start
                text = self.source[boundary.start:end]
                if boundary.owner == "":
                    header += text
                else:
                    declarations += boundary.owner + "\n" + declaration_surface(text) + "\n"
                    owners.append(
                        SourceProjectionRecord(
                            key=source_key("owner-source", self.origin, self.path, boundary.owner),
                            text=text,
                            start=boundary.start,
                            end=end,
                        ),
                    )
                    for field in field_records(boundary.owner, text, boundary.start, self.origin, self.path):
                        owners.append(field)
                    for default in field_default_records(boundary.owner, text, boundary.start, self.origin, self.path):
                        owners.append(default)
        return Ok(
            SourceProjection(
                header=SourceProjectionRecord(
                    key=source_key("module-header", self.origin, self.path, "module"),
                    text=header,
                    start=0,
                    end=len(self.source),
                ),
                declarations=SourceProjectionRecord(
                    key=source_key("declaration-index", self.origin, self.path, "module"),
                    text=declarations,
                    start=0,
                    end=len(self.source),
                ),
                owners=owners,
            ),
        )


pub def project_source(origin: str, path: str, source: str) -> Result[SourceProjection, str]:
    """Produce one module header plus exact source records for top-level owners and nested field defaults."""
    if origin == "" or path == "":
        return Err("source projection requires an origin and logical path")
    return SourceProjector.open(origin, path, source).projection()


pub def owner_source_key(origin: str, path: str, name: str) -> RecordKey:
    """Name one declaration owner's exact source projection for a compiler-witnessed dependency read."""
    return source_key("owner-source", origin, path, name)


pub def compiled_owner_source(
    projection: SourceProjection,
    module: str,
    name: str,
    identity: str = "",
) -> Result[SourceProjectionRecord, str]:
    """Map one compiler body name to its exact owner or unambiguous declaration-qualified default expression."""
    for owner in projection.owners:
        if owner.key.facet == name:
            return Ok(owner)
    declaration = stable_member_declaration(identity)
    if declaration != "":
        for prefix in ["default:", "field:"]:
            for owner in projection.owners:
                if owner.key.facet.startswith(prefix) and owner.key.facet.endswith(":" + declaration + ":" + name):
                    return Ok(owner)
    else:
        for owner in projection.owners:
            if (
                (owner.key.facet.startswith("default:") or owner.key.facet.startswith("field:"))
                and owner.key.facet.endswith(":" + name)
            ):
                return Err(f"compiled field body has no stable declaration identity: {module}:{name}")
    mut default: Option[SourceProjectionRecord] = None
    for owner in projection.owners:
        if owner.key.facet.startswith("default:") and owner.key.facet.endswith(":" + name):
            if default is not None:
                return Err(f"compiled body output has ambiguous default source: {module}:{name}; identity={identity}")
            default = Some(owner)
    match default:
        Some(owner) => return Ok(owner)
        None => pass
    for owner in projection.owners:
        if owner.key.facet.startswith("field:") and owner.key.facet.endswith(":" + name):
            return Ok(owner)
    for owner in projection.owners:
        if owner.key.facet.endswith(":" + name):
            return Ok(owner)
    return Err(f"compiled body output has no matching owner source: {module}:{name}")


def stable_member_declaration(identity: str) -> str:
    """Recover the enclosing nominal declaration name from one compiler-owned stable identity."""
    compact = identity.split("|")[0].split("::")
    if len(compact) >= 2:
        return compact[len(compact) - 2]
    nested = identity.split("#in(")
    if len(nested) < 2:
        return ""
    owner = nested[len(nested) - 1].split(")")[0]
    parts = owner.split(":")
    if len(parts) < 2 or parts[len(parts) - 1] == "":
        return ""
    return parts[len(parts) - 1]


pub def declaration_index_key(origin: str, path: str) -> RecordKey:
    """Name the body-independent declaration surface used to invalidate project declaration readers before checking."""
    return source_key("declaration-index", origin, path, "module")


pub def signature_record(owner: &SourceProjectionRecord) -> SourceProjectionRecord:
    """Project one declaration's header without its implementation, preserving its kind-qualified source owner."""
    mut key = owner.key
    key.family = "declaration-signature"
    return SourceProjectionRecord(key=key, text=declaration_surface(owner.text), start=owner.start, end=owner.end)


pub def publish_source_projection(
    selected: Snapshot,
    projection: SourceProjection,
) -> Result[PublishedSourceProjection, str]:
    """Publish a complete file projection in one transaction, replacing only equal canonical logical keys."""
    mut transaction = put(
        begin(selected),
        encode_record_key(projection.header.key)?,
        projection.header.text.encode("utf-8"),
    )
    mut published = [encode_record_key(projection.header.key)?]
    declaration_key = encode_record_key(projection.declarations.key)?
    transaction = put(transaction, declaration_key, projection.declarations.text.encode("utf-8"))
    published.append(declaration_key)
    for owner in projection.owners:
        for record in [owner, signature_record(owner)]:
            key = encode_record_key(record.key)?
            transaction = put(transaction, key, record.text.encode("utf-8"))
            published.append(key)
    snapshot = commit(transaction).map_err((error) => error.message())?
    return Ok(PublishedSourceProjection(snapshot=snapshot, keys=published))


def declaration_surface(source: str) -> str:
    """Project a callable header without its body; retain complete non-callable declarations conservatively."""
    mut callable = false
    mut depth = 0
    mut surface = ""
    for line in source.split("\n"):
        content = line.strip()
        if not callable and not content.startswith("@"):
            callable = callable_declaration(content)
            if not callable:
                return source
        surface += line + "\n"
        for character in line:
            if character in "([{":
                depth += 1
            elif character in ")]}":
                depth -= 1
        if callable and depth == 0 and content.endswith(":"):
            return surface
    return source


def callable_declaration(line: str) -> bool:
    """Recognize the callable declaration forms whose indented bodies do not contribute to checked signatures."""
    mut header = line
    for prefix in ["pub ", "async "]:
        if header.startswith(prefix):
            header = header[len(prefix):]
    return header.startswith("def ")


def declaration_owner(line: str) -> str:
    """Name an independently owned declaration while imports, aliases and other module forms stay in the header."""
    mut header = f"{line}"
    for prefix in ["pub ", "async "]:
        if header.startswith(prefix):
            header = header[len(prefix):]
    for kind in ["def", "const", "static", "model", "capability", "class", "trait", "partial", "newtype", "enum"]:
        prefix = kind + " "
        if header.startswith(prefix):
            name = identifier_prefix(header[len(prefix):])
            if kind == "def":
                return name
            if name != "":
                return kind + ":" + name
    return ""


def identifier_prefix(candidate: str) -> str:
    """Read one declaration name without interpreting its following type, generic or parameter syntax."""
    mut end = 0
    while end < len(candidate) and candidate[end] in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789":
        end += 1
    if end == 0:
        return ""
    return candidate[:end]


def field_default_records(
    declaration: str,
    source: str,
    source_start: int,
    origin: str,
    path: str,
) -> list[SourceProjectionRecord]:
    """Project each direct model or class field default as its own expression-only source facet."""
    if not declaration.startswith("model:") and not declaration.startswith("class:"):
        return []
    starts = direct_member_starts(source)
    mut records: list[SourceProjectionRecord] = []
    for index in range(len(starts)):
        start = starts[index]
        mut end = len(source)
        if index + 1 < len(starts):
            end = starts[index + 1]
        match default_expression(source[start:end]):
            None => pass
            Some((field, relative_start, relative_end)) =>
                records.append(
                    SourceProjectionRecord(
                        key=source_key("owner-source", origin, path, "default:" + declaration + ":" + field),
                        text=source[start + relative_start:start + relative_end],
                        start=source_start + start + relative_start,
                        end=source_start + start + relative_end,
                    ),
                )
    return records


def field_records(
    declaration: str,
    source: str,
    source_start: int,
    origin: str,
    path: str,
) -> list[SourceProjectionRecord]:
    """Project each direct nominal field independently, including fields without a default expression."""
    starts = direct_member_starts(source)
    mut records: list[SourceProjectionRecord] = []
    for index in range(len(starts)):
        start = starts[index]
        mut end = len(source)
        if index + 1 < len(starts):
            end = starts[index + 1]
        member = source[start:end]
        match field_name(member):
            None => pass
            Some(field) =>
                records.append(
                    SourceProjectionRecord(
                        key=source_key("owner-source", origin, path, "field:" + declaration + ":" + field),
                        text=member,
                        start=source_start + start,
                        end=source_start + end,
                    ),
                )
    return records


def field_name(member: str) -> Option[str]:
    """Return one direct field name without mistaking a method or nested declaration for a field."""
    first = member.split("\n")[0]
    mut header = first.strip()
    if header.startswith("pub "):
        header = header[4:]
    colon = character_index(header, ":")
    if colon <= 0:
        return None
    field = identifier_prefix(header[:colon].strip())
    if field == "" or field != header[:colon].strip():
        return None
    return Some(field)


def direct_member_starts(source: str) -> list[int]:
    """Locate direct nominal members after any decorators while bracketed defaults remain one member chunk."""
    mut starts: list[int] = []
    mut offset = 0
    mut member_indent = -1
    mut depth = 0
    for line in source.split("\n"):
        content = line.strip()
        indent = leading_whitespace(line)
        if content != "" and not content.startswith("#") and indent > 0:
            if member_indent < 0:
                member_indent = indent
            if indent == member_indent and depth == 0:
                starts.append(offset)
            depth += delimiter_delta(line)
            if depth < 0:
                depth = 0
        offset += len(line) + 1
    return starts


def default_expression(member: str) -> Option[tuple[str, int, int]]:
    """Return one direct field name and the trimmed byte range of its declared default expression."""
    first = member.split("\n")[0]
    mut header = first.strip()
    if header.startswith("pub "):
        header = header[4:]
    colon = character_index(header, ":")
    equals = character_index(header, "=")
    if colon <= 0 or equals <= colon:
        return None
    field = identifier_prefix(header[:colon].strip())
    if field == "" or field != header[:colon].strip():
        return None
    raw_equals = character_index(member, "=")
    if raw_equals < 0:
        return None
    mut start = raw_equals + 1
    while start < len(member) and member[start] in " \t":
        start += 1
    mut end = len(member)
    while end > start and member[end - 1] in " \t\n\r":
        end -= 1
    if start == end:
        return None
    return Some((field, start, end))


def leading_whitespace(line: str) -> int:
    """Count a line's indentation bytes without assigning a tab-width policy to source coordinates."""
    mut count = 0
    while count < len(line) and line[count] in " \t":
        count += 1
    return count


def character_index(text: str, sought: str) -> int:
    """Return the first byte position of one ASCII syntax character, or `-1` when absent."""
    for index in range(len(text)):
        if text[index:index + 1] == sought:
            return index
    return -1


def delimiter_delta(line: str) -> int:
    """Track grouping delimiters well enough to keep ordinary multi-line field defaults in one source facet."""
    mut delta = 0
    for character in line:
        if character in "([{":
            delta += 1
        elif character in ")]}":
            delta -= 1
    return delta


def source_key(family: str, origin: str, path: str, facet: str) -> RecordKey:
    """Name one source projection independently of the file-wide content revision and physical coordinates."""
    return RecordKey(
        family=family,
        identity_profile=SOURCE_PROFILE,
        origin=origin,
        identity=path,
        facet=facet,
        context="",
    )
