"""Compatibility imports and facade-path entry points for the platform store substrate."""

from std.fs import Path
from std.primitives.fs.locking import FileLock
from pub::incan_platform.store import (
    EXPECT_ABSENT,
    EXPECT_ABSENT_OR_DAMAGED,
    EXPECT_ANY,
    EXPECT_REPAIR,
    HOME_VIEW,
    Lookup,
    PreparedPayload,
    Publication,
    ReadCounts,
    Snapshot,
    Transaction,
    ViewRoot,
    begin,
    commit,
    commit_group,
    commit_pinned,
    current,
    delete,
    durable_commits,
    durable_syncs,
    fork,
    get,
    keys,
    lease,
    lease_token,
    lookup,
    owned,
    put,
    read_counts,
    view_snapshot,
)
from pub::incan_platform.store import claim as platform_claim, compact as platform_compact
from pub::incan_platform.store import snapshot as platform_snapshot
from pub::incan_platform.store.files import StoreError
from platform_store_path import store_path


pub def snapshot(root: Path, view: str = HOME_VIEW) -> Result[Snapshot, StoreError]:
    """Open a platform snapshot from Oven's facade path."""
    return platform_snapshot(store_path(root), view)


pub def claim(root: Path, key: str) -> Result[FileLock, StoreError]:
    """Acquire a platform computation claim from Oven's facade path."""
    return platform_claim(store_path(root), key)


pub def compact(root: Path) -> Result[Snapshot, StoreError]:
    """Compact a platform store selected by Oven's facade path."""
    return platform_compact(store_path(root))
