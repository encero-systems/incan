pub def test_dependency_artifacts_rekey_their_consumers() -> Result[None, str]:
    """Dependency rebuilds rekey consumers; exact relocated native artifacts and fresh ABI publication stay valid."""
    scratch = scratch_directory()?
    if get_or("INCAN_E2_NAMESPACE_ONLY", "") == "1":
        verify_semantic_edit_matrix(scratch.path().joinpath("semantic-edit-matrix"))?
        return Ok(None)
    setup = fixture(scratch.path())?
    first = reconcile(scratch.path(), setup)?
    verify_closure_readings(scratch.path().joinpath("closure.json"))?
    verify_toolchain_interface_admission(scratch.path(), setup.toolchain)?
    dependency = artifact_files(Path(setup.unit.loaves[0].dir), "dep")?
    write(dependency[0], "dependency rebuilt with different code")?
    record_payload(dependency[0], fingerprint(["rebuilt dependency"])?)?
    record_payload(dependency[1], fingerprint(["rebuilt dependency"])?)?
    rebuilt = reconcile(scratch.path(), setup)?
    assert rebuilt.key != first.key
    assert rebuilt.hashed == 0
    standard_artifacts = artifact_files(Path(setup.unit.loaves[1].dir), "std")?
    write(standard_artifacts[1], "{\"fixture\":\"standard package recompiled\"}")?
    record_payload(standard_artifacts[1], fingerprint(["rebuilt standard"])?)?
    recompiled = reconcile(scratch.path(), setup)?
    assert recompiled.key != rebuilt.key
    # A manifest that declares a vocabulary worker adds it to the artifact set; rewritten without one, it does not.
    standard = Path(setup.unit.loaves[1].dir)
    manifest = standard.joinpath("std.incnlib")
    write(manifest, "{\"vocab\": {\"desugarer_artifact\": {\"artifact_kind\": \"NativeWorker\"}}}")?
    assert "vocab-worker" in [artifact.name() for artifact in artifact_files(standard, "std")?]
    write(manifest, "{}")?
    assert "vocab-worker" not in [artifact.name() for artifact in artifact_files(standard, "std")?]
    write(manifest, "malformed manifest")?
    match artifact_files(standard, "std"):
        Ok(_) =>
            assert false, "a malformed manifest cannot authorize an incomplete artifact set"
        Err(_) => pass
    verify_completed_library_abi(scratch.path().joinpath("publication"))?
    verify_worker_publication(scratch.path().joinpath("workers"))?
    verify_native_alias_artifacts(scratch.path().joinpath("aliases"))?
    verify_requested_loaf_roots(scratch.path().joinpath("requested-roots"))?
    verify_checked_product_context(scratch.path().joinpath("checked-products"))?
    verify_request_artifact_identities(scratch.path().joinpath("artifact-identities"))?
    verify_semantic_edit_matrix(scratch.path().joinpath("semantic-edit-matrix"))?
    return Ok(None)


pub def test_installed_inputs_are_admitted_once() -> Result[None, str]:
    """An installed generation is selected from its admitted page without reopening any frozen input."""
    scratch = scratch_directory()?
    original = scratch.path().joinpath("producer/runtime.incnlib")
    write(original, "runtime interface")?
    record_payload(original, "runtime producer")?
    return verify_published_installation(scratch.path(), original)


@derive(Eq)
enum SemanticEdit(str):
    """The fixed E2 source-edit matrix; each spelling is stable evidence in failures and timing rows."""

    Body = "body-only"
    Signature = "signature"
    AddDeclaration = "add-declaration"
    RemoveDeclaration = "remove-declaration"
    RenameDeclaration = "rename-declaration"
    FieldType = "field-type"
    Import = "import"
    Documentation = "documentation"
    GenericInstantiation = "generic-instantiation"
    Dependency = "dependency"
    NamespaceBody = "namespace-body-only"
    NamespaceSignature = "namespace-signature"
    NamespaceModel = "namespace-model"
    NamespaceConst = "namespace-const"
    NamespaceClass = "namespace-class"
    NamespaceEnum = "namespace-enum"
    NamespaceStatic = "namespace-static"
    NamespaceTrait = "namespace-trait"
    NamespaceNewtype = "namespace-newtype"
    NamespaceTypeAlias = "namespace-type-alias"
    NamespaceReexport = "namespace-reexport"


@derive(Eq)
enum MatrixFixture(str):
    """The three Incan-only fixture shapes whose compiler records E2 compares."""

    Hello = "hello"
    Siblings = "siblings"
    Library = "library"
    Namespaces = "namespaces"


@derive(Eq)
enum MatrixBuildKind(str):
    """The three builds that establish one matrix row's retained and cold states."""

    Base = "base"
    Warm = "warm"
    Cold = "cold"


model MatrixCase:
    """One edit's complete base and edited source trees and the build request that observes them."""

    edit: SemanticEdit
    fixture: MatrixFixture
    target: str
    base: Dict[str, str]
    edited: Dict[str, str]
    expected_module_checks: int = -1
    expected_body_ir_modules: int = -1
    expected_lowered_modules: int = -1


model PhaseCounts:
    """Actual producer work at the five executing compiler phases retained by the existing work trace."""

    declarations: int = 0
    bodies: int = 0
    body_ir: int = 0
    lowering: int = 0
    llvm: int = 0
    module_checks: int = 0
    body_ir_modules: int = 0
    lowered_modules: int = 0
    checked_module_paths: list[str] = []
    body_ir_module_paths: list[str] = []
    lowering_items: list[str] = []

    def display(self) -> str:
        """Render one stable compact count row for a failure or timing receipt."""
        return f"{self.declarations}/{self.bodies}/{self.body_ir}/{self.lowering}/{self.llvm}"

    def after(self, before: PhaseCounts) -> PhaseCounts:
        """Return work added after an earlier cumulative trace snapshot from the same records service."""
        lowering_items = self.lowering_items[len(before.lowering_items):]
        return PhaseCounts(
            declarations=self.declarations - before.declarations,
            bodies=self.bodies - before.bodies,
            body_ir=self.body_ir - before.body_ir,
            lowering=self.lowering - before.lowering,
            llvm=self.llvm - before.llvm,
            module_checks=self.module_checks - before.module_checks,
            body_ir_modules=self.body_ir_modules - before.body_ir_modules,
            lowered_modules=lowering_module_count(lowering_items),
            checked_module_paths=self.checked_module_paths[len(before.checked_module_paths):],
            body_ir_module_paths=self.body_ir_module_paths[len(before.body_ir_module_paths):],
            lowering_items=lowering_items,
        )


def lowering_module_count(items: list[str]) -> int:
    """Count unique source modules in one non-cumulative lowering trace slice."""
    mut modules: set[str] = set()
    for item in items:
        fields = item.split("\t")
        if len(fields) >= 5 and fields[4] != "":
            modules.add(fields[4])
    return len(modules)


model MatrixBuild:
    """The comparable outputs and work evidence from one completed edited or cold build."""

    artifacts: Dict[str, str]
    counts: PhaseCounts
    wall_ms: int


model SemanticEditMatrix:
    """Own one E2 run's fixtures, compiler process, failures and optional measurement rows."""

    root: Path
    binary: str
    failures: list[str] = []
    rows: list[str] = []

    pub def verify(mut self) -> Result[None, str]:
        """
        Compare every warm edit with a target-clean cold build of the edited source.

        1. Build the unedited source and then the edit against its retained private compiler records.
        2. Keep exact digests of the warm records and selected native artifacts, then remove only this scratch target.
        3. Build the edited source cold and require every cold record and artifact to have identical warm bytes.
        """
        cases = semantic_edit_cases()
        for scenario in [scenario for scenario in cases if scenario.expected_module_checks >= 0]:
            match self.verify_case(scenario):
                Ok(_) => pass
                Err(reason) => self.failures.append(f"{scenario.edit.value()}: {reason}")
        if len(self.failures) != 0:
            return Err("E2 namespace admission differences:\n- " + "\n- ".join(self.failures))
        if get_or("INCAN_E2_NAMESPACE_ONLY", "") == "1":
            self.write_rows()?
            return Ok(None)
        for scenario in [scenario for scenario in cases if scenario.expected_module_checks < 0]:
            match self.verify_case(scenario):
                Ok(_) => pass
                Err(reason) => self.failures.append(f"{scenario.edit.value()}: {reason}")
        self.write_rows()?
        if len(self.failures) != 0:
            return Err("E2 cold-oracle differences:\n- " + "\n- ".join(self.failures))
        return Ok(None)

    def verify_case(mut self, scenario: MatrixCase) -> Result[None, str]:
        """Run one warm/cold pair, retaining the edit name in every reported mismatch."""
        project = self.root.joinpath(scenario.edit.value())
        self.write_sources(project, scenario.base)?
        base = self.build(scenario, project, MatrixBuildKind.Base)?
        self.write_sources(project, scenario.edited)?
        mut warm = self.build(scenario, project, MatrixBuildKind.Warm)?
        warm.counts = warm.counts.after(base.counts)
        mut phase_differences: list[str] = []
        if scenario.expected_module_checks >= 0 and warm.counts.module_checks != scenario.expected_module_checks:
            phase_differences.append(
                f"warm module checks: expected {scenario.expected_module_checks}, found {warm.counts.module_checks}",
            )
            phase_differences.append("checked modules: " + ", ".join(warm.counts.checked_module_paths))
        if scenario.expected_body_ir_modules >= 0 and warm.counts.body_ir_modules != scenario.expected_body_ir_modules:
            phase_differences.append(
                f"warm Body IR modules: expected {scenario.expected_body_ir_modules}, found {warm.counts.body_ir_modules}",
            )
            phase_differences.append("Body IR modules: " + ", ".join(warm.counts.body_ir_module_paths))
        if scenario.expected_lowered_modules >= 0 and warm.counts.lowered_modules != scenario.expected_lowered_modules:
            phase_differences.append(
                f"warm lowered modules: expected {scenario.expected_lowered_modules}, found {warm.counts.lowered_modules}",
            )
            phase_differences.append("lowering items: " + ", ".join(warm.counts.lowering_items))
        self.stop_engine(project.joinpath("warm-store"))?
        target = project.joinpath("target")
        if not target.is_dir():
            return Err("warm build produced no target directory")
        warm_target = project.joinpath("warm-target")
        _ = target.copy(warm_target, true, false).map_err((error) => error.message())?
        remove_dir_all(target.0).map_err((error) => str(error))?
        cold = self.build(scenario, project, MatrixBuildKind.Cold)?
        self.stop_engine(project.joinpath("cold-store"))?
        for path in cold.artifacts.keys():
            if path not in warm.artifacts:
                return Err(f"cold output {path} is absent from the incremental build")
            if cold.artifacts[path] != warm.artifacts[path]:
                return Err(f"incremental and cold bytes differ for {path}")
            comparison = Command
                .new("cmp")
                .arg(warm_target.joinpath(path).0)
                .arg(target.joinpath(path).0)
                .output()
                .map_err((error) => str(error))?
            if not comparison.status.success():
                return Err(f"cmp rejected incremental and cold bytes for {path}")
        if len(cold.artifacts) == 0:
            return Err("the cold build exposed no compiler records or selected artifacts")
        if len(phase_differences) != 0:
            return Err("; ".join(phase_differences))
        self.rows.append(
            "\t".join(
                [
                    scenario.edit.value(),
                    scenario.fixture.value(),
                    warm.counts.display(),
                    str(warm.counts.module_checks),
                    str(warm.counts.body_ir_modules),
                    str(warm.counts.lowered_modules),
                    str(warm.wall_ms),
                    str(cold.wall_ms),
                    "identical",
                ],
            ),
        )
        return Ok(None)

    def write_sources(self, project: Path, sources: Dict[str, str]) -> Result[None, str]:
        """Materialize one complete source state under its owned scratch fixture."""
        for relative in sources.keys():
            write(project.joinpath(relative), sources[relative])?
        return Ok(None)

    def build(self, scenario: MatrixCase, project: Path, kind: MatrixBuildKind) -> Result[MatrixBuild, str]:
        """Build one matrix state with compiler-work tracing and retain only semantic records and selected artifacts."""
        mut trace_name = "retained"
        if kind == MatrixBuildKind.Cold:
            trace_name = "cold"
        trace = project.joinpath(f"e2-trace-{trace_name}")
        trace.mkdir(true, true).map_err((error) => error.message())?
        native = project.joinpath(f"e2-native-{trace_name}.trace")
        target = project.joinpath(scenario.target)
        mut store = project.joinpath("warm-store")
        if kind == MatrixBuildKind.Cold:
            store = project.joinpath("cold-store")
        started = Instant.now()
        output = Command
            .new(self.binary)
            .arg("build")
            .arg(target.0)
            .args(["--profile", "release"])
            .env("OVEN_OWNER", "off")
            .env("INCAN_ENGINE", "records")
            .env("INCAN_BAKERY", store.0)
            .env("INCAN_NATIVE_TIMING", "1")
            .env("INCAN_TRACE_DIR", trace.0)
            .env("OVEN_TRACE", native.0)
            .output()
            .map_err((error) => str(error))?
        wall_ms = int(started.elapsed().as_millis())
        if not output.status.success():
            stdout = decoded(output.stdout)
            stderr = decoded(output.stderr)
            return Err(f"{kind.value()} build refused: status={output.status.code()} stdout={stdout} stderr={stderr}")
        return Ok(
            MatrixBuild(
                artifacts=self.artifact_digests(project.joinpath("target"))?,
                counts=self.phase_counts(trace, native)?,
                wall_ms=wall_ms,
            ),
        )

    def stop_engine(self, store: Path) -> Result[None, str]:
        """Stop one disposable records service after its final matrix request has completed."""
        mut identity = service_identity(store)?
        identity.service_generation = fingerprint([self.binary, observe(Path(self.binary))?.stamp])?
        mut channel = connect_with(store, identity, self.binary).map_err((error) => error.detail)?
        channel
            .send(zero_id(), Message.Stop(Stop(reason="semantic edit matrix row completed")))
            .map_err((error) => error.detail)?
        stopped = channel.receive().map_err((error) => error.detail)?
        match stopped.message:
            Message.Event(value) =>
                if value.status != "Stopping":
                    return Err(f"records service returned stop status {value.status}")
            _ => return Err("records service did not acknowledge matrix stop")
        _ = channel.transport.close()
        return Ok(None)

    def artifact_digests(self, target: Path) -> Result[Dict[str, str], str]:
        """Hash compiler records and final artifacts, excluding mutable receipts and observations."""
        mut result: Dict[str, str] = {}
        mut pending: list[Path] = [target]
        while len(pending) > 0:
            directory = pending.pop()
            for entry in directory.iterdir().map_err((error) => error.message())?:
                if entry.is_dir():
                    pending.append(entry)
                elif entry.is_file():
                    relative = entry.0[len(target.0) + 1:]
                    if comparable_matrix_output(relative):
                        result[relative] = file_digest(entry)?
        return Ok(result)

    def phase_counts(self, traces: Path, native: Path) -> Result[PhaseCounts, str]:
        """Count actual work observations from the edited build, never inventories of retained products."""
        mut counts = PhaseCounts()
        mut lowered_modules: set[str] = set()
        for trace in traces.iterdir().map_err((error) => error.message())?:
            if not trace.is_file():
                continue
            for line in trace.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
                if "\"phase\":\"checking\"" in line and "\"action\":\"declaration\"" in line:
                    counts.declarations += 1
                elif "\"phase\":\"checking\"" in line and "\"action\":\"body\"" in line:
                    counts.bodies += 1
                elif "\"phase\":\"body_ir\"" in line and "\"action\":\"built\"" in line:
                    counts.body_ir += 1
                if "\"kind\":\"begin\"" in line and "\"function\":\"incan_driver::typecheck_module\"" in line:
                    counts.module_checks += 1
                    counts.checked_module_paths.append(line)
                elif "\"kind\":\"begin\"" in line and "\"function\":\"incan_driver::build_body_ir_module\"" in line:
                    counts.body_ir_modules += 1
                    counts.body_ir_module_paths.append(line)
        if native.is_file():
            for line in native.read_text("utf-8", "strict").map_err((error) => error.message())?.split("\n"):
                if line.startswith("redo-item: lowering\t"):
                    counts.lowering += 1
                    counts.lowering_items.append(line)
                    fields = line.split("\t")
                    if len(fields) >= 5:
                        lowered_modules.add(fields[4])
                elif line.startswith("redo-codegen: "):
                    document = parse(line[len("redo-codegen: "):]).map_err((error) => error.message())?
                    execution = document.require("execution").map_err((error) => error.message())?.expect_str().map_err(
                        (error) => error.message(),
                    )?
                    if execution == "all_on_success":
                        partitions = document.require("partitions").map_err((error) => error.message())?
                        counts.llvm += partitions.expect_int().map_err((error) => error.message())?
        counts.lowered_modules = len(lowered_modules)
        return Ok(counts)

    def write_rows(self) -> Result[None, str]:
        """Write optional development-loop samples without changing the test's verdict or ordinary console."""
        destination = get_or("INCAN_E2_MATRIX_REPORT", "")
        if destination != "":
            header = (
                "edit\tfixture\tdeclarations/bodies/body_ir/lowering/llvm\tchecked_modules\t"
                + "body_ir_modules\tlowered_modules\twarm_ms\tcold_ms\tverdict\n"
            )
            Path(destination)
                .write_text(header + "\n".join(self.rows) + "\n", "utf-8", "strict", None)
                .map_err((error) => error.message())?
        return Ok(None)


def verify_semantic_edit_matrix(root: Path) -> Result[None, str]:
    """Run DD-0015's fixed Incan-only E2 matrix through the installed compiler selected by this Oven test."""
    binary = get_or("OVEN_ENGINE_BINARY", f"{get_or("INCAN_HOME", "")}/bin/incan")
    return SemanticEditMatrix(root=root, binary=binary).verify()


def comparable_matrix_output(relative: str) -> bool:
    """Select semantic compiler records and final artifact bytes while excluding ledgers and publication receipts."""
    if "/.products/" in "/" + relative:
        return relative.endswith(".incnitems") or relative.endswith(".incnfunction")
    if "/release/bin/" in "/" + relative:
        return true
    if not relative.startswith("incan/loaves/") or "/release/" not in relative:
        return false
    for suffix in [".rlib", ".incnlib", ".incnbody", ".incngraph", ".native.json", ".rustabi"]:
        if relative.endswith(suffix):
            return true
    return false


def semantic_edit_cases() -> list[MatrixCase]:
    """Define the fixed E2 matrix over hello, sibling declarations and one sibling library module."""
    return [
        MatrixCase(
            edit=SemanticEdit.Body,
            fixture=MatrixFixture.Hello,
            target="hello.incn",
            base={"hello.incn": fixture_source(
                [
                    "def greeting() -> str:",
                    "    return \"hello\"",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(greeting())",
                ],
            )},
            edited={"hello.incn": fixture_source(
                [
                    "def greeting() -> str:",
                    "    return \"hullo\"",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(greeting())",
                ],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.Signature,
            fixture=MatrixFixture.Hello,
            target="hello.incn",
            base={"hello.incn": fixture_source(
                ["def value() -> str:", "    return \"one\"", "", "", "def main() -> None:", "    println(value())"],
            )},
            edited={"hello.incn": fixture_source(
                ["def value() -> int:", "    return 1", "", "", "def main() -> None:", "    println(value())"],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.AddDeclaration,
            fixture=MatrixFixture.Siblings,
            target="fixture.incn",
            base={"fixture.incn": fixture_source(["def main() -> None:", "    println(\"stable\")"])},
            edited={"fixture.incn": fixture_source(
                ["def other() -> int:", "    return 2", "", "", "def main() -> None:", "    println(\"stable\")"],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.RemoveDeclaration,
            fixture=MatrixFixture.Siblings,
            target="fixture.incn",
            base={"fixture.incn": fixture_source(
                ["def other() -> int:", "    return 2", "", "", "def main() -> None:", "    println(\"stable\")"],
            )},
            edited={"fixture.incn": fixture_source(["def main() -> None:", "    println(\"stable\")"])},
        ),
        MatrixCase(
            edit=SemanticEdit.RenameDeclaration,
            fixture=MatrixFixture.Siblings,
            target="fixture.incn",
            base={"fixture.incn": fixture_source(
                ["def changed() -> int:", "    return 2", "", "", "def main() -> None:", "    println(changed())"],
            )},
            edited={"fixture.incn": fixture_source(
                ["def renamed() -> int:", "    return 2", "", "", "def main() -> None:", "    println(renamed())"],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.FieldType,
            fixture=MatrixFixture.Siblings,
            target="fixture.incn",
            base={"fixture.incn": fixture_source(
                ["model Item:", "    value: int", "", "", "def main() -> None:", "    println(Item(value=1).value)"],
            )},
            edited={"fixture.incn": fixture_source(
                [
                    "model Item:",
                    "    value: str",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(Item(value=\"one\").value)",
                ],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.Import,
            fixture=MatrixFixture.Siblings,
            target="main.incn",
            base={"main.incn": fixture_source(
                ["from helper import greeting", "", "", "def main() -> None:", "    println(greeting())"],
            ), "helper.incn": fixture_source(
                [
                    "pub def greeting() -> str:",
                    "    return \"hello\"",
                    "",
                    "",
                    "pub def salutation() -> str:",
                    "    return \"hello\"",
                ],
            )},
            edited={"main.incn": fixture_source(
                ["from helper import salutation", "", "", "def main() -> None:", "    println(salutation())"],
            ), "helper.incn": fixture_source(
                [
                    "pub def greeting() -> str:",
                    "    return \"hello\"",
                    "",
                    "",
                    "pub def salutation() -> str:",
                    "    return \"hello\"",
                ],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.Documentation,
            fixture=MatrixFixture.Hello,
            target="hello.incn",
            base={"hello.incn": fixture_source(
                [
                    "def greeting() -> str:",
                    "    return \"hello\"",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(greeting())",
                ],
            )},
            edited={"hello.incn": fixture_source(
                [
                    "def greeting() -> str:",
                    "    \"\"\"Return the greeting.\"\"\"",
                    "    return \"hello\"",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(greeting())",
                ],
            )},
        ),
        MatrixCase(
            edit=SemanticEdit.GenericInstantiation,
            fixture=MatrixFixture.Siblings,
            target="fixture.incn",
            base={"fixture.incn": fixture_source(
                [
                    "def identity[T](value: T) -> T:",
                    "    return value",
                    "",
                    "",
                    "def main() -> None:",
                    "    println(identity[int](1))",
                ],
            )},
