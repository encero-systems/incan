from rust::std::env import var as env_var
from rust::std::process import exit
from std.fs import Path
from std.json import JsonValue

const RUST_POLICY: str = "The toolchain installer provisions this exact Rust release into an Incan-owned rustup home, leaving your own default toolchain untouched, and ensures the wasm32-wasip1 target for packages that ship vocab companions."
const PINNED_RUST_RELEASE: str = "1.98.0"
const PINNED_MIN_RUST: str = "1.98"


model HostAsset:
    target: str
    archive_name: str
    archive_url: str
    archive_sha256: str


def env_or(name: str, fallback: str) -> str:
    match env_var(name):
        Ok(value) => return value
        Err(_) => return fallback


def env_flag(name: str) -> bool:
    value = env_or(name, "")
    return value == "1" or value == "true" or value == "TRUE" or value == "yes" or value == "YES"


def read_first_line(path: str) -> Result[str, str]:
    text = Path(path).read_text("utf-8", "strict").map_err((err) => f"read {path}: {err.message()}")?
    lines = text.split("\n")
    if len(lines) == 0:
        return Err(f"{path} is empty")
    return Ok(lines[0].strip())


def write_text(path: str, text: str) -> Result[None, str]:
    return Path(path).write_text(text, "utf-8", "strict", None).map_err((err) => f"write {path}: {err.message()}")


def copy_text(source: str, target: str) -> Result[None, str]:
    text = Path(source).read_text("utf-8", "strict").map_err((err) => f"read {source}: {err.message()}")?
    return write_text(target, text)


def archive_target(archive_name: str, release: str) -> Result[str, str]:
    prefix = f"incan-{release}-"
    suffix = ".tar.gz"
    if not archive_name.startswith(prefix) or not archive_name.endswith(suffix):
        return Err(f"archive name does not match release {release}: {archive_name}")
    return Ok(archive_name[len(prefix):len(archive_name) - len(suffix)])


def sorted_strings(values: list[str]) -> list[str]:
    mut out: list[str] = []
    for value in values:
        out.append(value)
    mut i = 1
    while i < len(out):
        current = out[i]
        mut j = i
        while j > 0 and out[j - 1] > current:
            out[j] = out[j - 1]
            j = j - 1
        out[j] = current
        i = i + 1
    return out


def collect_assets(dist_dir: str, release: str) -> Result[list[HostAsset], str]:
    pattern = f"incan-{release}-*.tar.gz"
    paths = Path(dist_dir).glob(pattern).map_err((err) => err.message())?
    mut archive_paths: list[str] = []
    for path in paths:
        archive_paths.append(path.0)
    archive_paths = sorted_strings(archive_paths)
    if len(archive_paths) == 0:
        return Err(f"no toolchain archives found in {dist_dir}")

    mut assets: list[HostAsset] = []
    for archive_path in archive_paths:
        archive_name = Path(archive_path).name()
        target = archive_target(archive_name, release)?
        checksum = read_first_line(f"{archive_path}.sha256")?
        assets.append(
            HostAsset(
                target=target,
                archive_name=archive_name,
                archive_url=f"https://github.com/encero-systems/incan/releases/download/{release}/{archive_name}",
                archive_sha256=checksum,
            ),
        )
    return Ok(assets)


def is_plain_release_version(value: str) -> bool:
    """Accept only a concrete `X.Y.Z` Rust release, which resolves to exactly one compiler build."""
    parts = value.split(".")
    if len(parts) != 3:
        return false
    for part in parts:
        if len(part) == 0:
            return false
        for character in part:
            if character < "0" or character > "9":
                return false
    return true


def resolve_rust_channel(dist_dir: str) -> Result[str, str]:
    """Determine the one Rust release every packaged host sealed its Oven Loafs against.

    Each packaging job records its own compiler under a per-host name. Loafs only load under the exact compiler
    that sealed them, so the published manifest has to name a concrete release rather than a floating channel.
    Hosts disagreeing means a Rust release landed mid-workflow and the archives are no longer mutually
    describable by one manifest, so this refuses to publish instead of shipping a channel that fits only part of
    the release.
    """
    paths = Path(dist_dir).glob("rust-channel-*.txt").map_err((err) => err.message())?
    mut channel_paths: list[str] = []
    for path in paths:
        channel_paths.append(path.0)
    channel_paths = sorted_strings(channel_paths)
    if len(channel_paths) == 0:
        return Err(f"no recorded Rust channel found in {dist_dir}; packaging must record the compiler it sealed Loafs with")

    mut resolved = ""
    mut resolved_path = ""
    for channel_path in channel_paths:
        channel = read_first_line(channel_path)?
        if len(channel) == 0:
            return Err(f"{channel_path} records an empty Rust channel")
        if not is_plain_release_version(channel):
            return Err(f"{channel_path} records {channel}, which is not a concrete Rust release; package releases with Rust {PINNED_RUST_RELEASE}")
        if channel != PINNED_RUST_RELEASE:
            return Err(f"{channel_path} records unsupported Rust {channel}; Incan releases require {PINNED_RUST_RELEASE}")
        if len(resolved) == 0:
            resolved = channel
            resolved_path = f"{channel_path}"
        elif channel != resolved:
            return Err(f"packaged hosts disagree on the Rust release: {resolved_path} recorded {resolved} but {channel_path} recorded {channel}")
    return Ok(resolved)


def command_paths_json() -> JsonValue:
    return JsonValue.object({"incan": JsonValue.str("bin/incan"), "incan-lsp": JsonValue.str("bin/incan-lsp")})


def host_json(asset: HostAsset) -> JsonValue:
    return JsonValue.object(
        {"archive_url": JsonValue.str(asset.archive_url), "archive_sha256": JsonValue.str(asset.archive_sha256), "archive_format": JsonValue.str(
            "tar.gz",
        ), "commands": command_paths_json()},
    )


def hosts_json(assets: list[HostAsset]) -> JsonValue:
    mut hosts: Dict[str, JsonValue] = {}
    for asset in assets:
        hosts[asset.target] = host_json(asset)
    return JsonValue.object(hosts)


def manifest_json(
    version: str,
    release: str,
    generated_at: str,
    rust_channel: str,
    assets: list[HostAsset],
) -> JsonValue:
    return JsonValue.object(
        {"schema_version": JsonValue.int(1), "toolchain_version": JsonValue.str(version), "release": JsonValue.str(
            release,
        ), "channel": JsonValue.str("stable"), "generated_at": JsonValue.str(generated_at), "manifest_url": JsonValue.str(
            f"https://github.com/encero-systems/incan/releases/download/{release}/manifest.json",
        ), "rust_toolchain": JsonValue.object(
            {"channel": JsonValue.str(rust_channel), "min_rust": JsonValue.str(PINNED_MIN_RUST), "targets": JsonValue.array(
                [JsonValue.str("wasm32-wasip1")],
            ), "policy": JsonValue.str(RUST_POLICY)},
        ), "commands": JsonValue.array([JsonValue.str("incan"), JsonValue.str("incan-lsp")]), "hosts": hosts_json(assets)},
    )


def ruby_string(value: str) -> str:
    return value.replace("\\", "\\\\").replace("\"", "\\\"")


def find_asset(assets: list[HostAsset], target: str) -> Option[HostAsset]:
    for asset in assets:
        if asset.target == target:
            return Some(asset)
    return None


def has_asset(assets: list[HostAsset], target: str) -> bool:
    match find_asset(assets, target):
        Some(_) => return true
        None => return false


def host_block(assets: list[HostAsset], target: str, indent: str) -> Result[str, str]:
    match find_asset(assets, target):
        Some(asset) =>
            url = ruby_string(asset.archive_url)
            checksum = ruby_string(asset.archive_sha256)
            return Ok(f"{indent}url \"{url}\"\n{indent}sha256 \"{checksum}\"")
        None => return Err(target)


def render_formula(version: str, rust_channel: str, assets: list[HostAsset]) -> Result[str, str]:
    mut missing: list[str] = []
    if not has_asset(assets, "aarch64-apple-darwin"):
        missing.append("aarch64-apple-darwin")
    if not has_asset(assets, "x86_64-apple-darwin"):
        missing.append("x86_64-apple-darwin")
    if not has_asset(assets, "x86_64-unknown-linux-gnu"):
        missing.append("x86_64-unknown-linux-gnu")
    if len(missing) > 0:
        return Err("manifest is missing Homebrew targets: " + ", ".join(missing))

    mac_arm = host_block(assets, "aarch64-apple-darwin", "    ")?
    mac_intel = host_block(assets, "x86_64-apple-darwin", "    ")?
    linux_x86 = host_block(assets, "x86_64-unknown-linux-gnu", "    ")?

    # The formula is mostly fixed Ruby with a few substitution points, so it reads best as literal blocks joined
    # at those seams. A plain triple-quoted string rather than an f-string is deliberate: the formula is full of
    # Ruby `#{...}` interpolations, which an f-string would require escaping as `#{{...}}` at every occurrence.
    header = """# typed: false
# frozen_string_literal: true

class Incan < Formula
  desc "Statically typed language that compiles to native Rust"
  homepage "https://github.com/encero-systems/incan"

  if OS.mac? && Hardware::CPU.arm?
"""
    body = """  end

  def staged_files
    (Dir["#{buildpath}/**/*"] + Dir["**/*"]).uniq
  end

  def staged_binary(name)
    path = staged_files.find do |candidate|
      File.basename(candidate) == name && File.basename(File.dirname(candidate)) == "bin"
    end
    path.nil? ? nil : Pathname.new(path)
  end

  def staged_file_sample
    staged_files.first(25).join(", ")
  end

  def install
    incan_bin = staged_binary("incan")
    incan_lsp_bin = staged_binary("incan-lsp")
    sdk_inventory = Pathname.new("share/incan/sdk/sdk-inventory.json")
    odie "could not find incan binary in archive; staged files: #{staged_file_sample}" if incan_bin.nil?
    odie "could not find incan-lsp binary in archive; staged files: #{staged_file_sample}" if incan_lsp_bin.nil?
    unless sdk_inventory.exist?
      odie "could not find SDK provider inventory in archive; staged files: #{staged_file_sample}"
    end
    libexec.install Dir["*"]
    bin.write_exec_script libexec/"bin/incan"
    bin.write_exec_script libexec/"bin/incan-lsp"
  end

  def caveats
    <<~EOS
      Incan ships prebuilt Rust libraries that load only under the exact Rust compiler that built them, which for this release is """
    caveats_tail = """.

      The direct installer, npm, and pipx provision that compiler into an Incan-owned rustup home and leave your own default toolchain alone. Homebrew installs only the prebuilt Incan commands, so select the matching compiler yourself before building projects:
        rustup toolchain install """
    targets_tail = """
        rustup target add wasm32-wasip1

      To keep your own default toolchain untouched, install through the direct installer instead:
        curl -fsSL https://github.com/encero-systems/incan/releases/latest/download/install.sh | bash
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/incan --version")
  end
end
"""
    return Ok(
        header + mac_arm + "\n  elsif OS.mac?\n" + mac_intel + "\n  elsif OS.linux? && Hardware::CPU.intel?\n"
        + linux_x86 + "\n" + body + rust_channel + caveats_tail + rust_channel + "\n        rustup default "
        + rust_channel + targets_tail,
    )


def prepare_assets() -> Result[None, str]:
    repo_root = env_or("INCAN_REPO_ROOT", ".")
    dist_dir = env_or("INCAN_TOOLCHAIN_DIST_DIR", "dist/toolchain")
    generated_at = env_or("INCAN_TOOLCHAIN_GENERATED_AT", "unspecified")
    skip_homebrew = env_flag("INCAN_TOOLCHAIN_SKIP_HOMEBREW")

    Path(dist_dir).mkdir(parents=true, exist_ok=true).map_err((err) => err.message())?
    version = read_first_line(f"{dist_dir}/toolchain-version.txt")?
    release = read_first_line(f"{dist_dir}/toolchain-release.txt")?
    assets = collect_assets(dist_dir, release)?
    rust_channel = resolve_rust_channel(dist_dir)?

    manifest = manifest_json(version, release, generated_at, rust_channel, assets)
    manifest_text = manifest.to_pretty_json().map_err((err) => err.message())?
    write_text(f"{dist_dir}/manifest.json", manifest_text + "\n")?
    copy_text(f"{repo_root}/workspaces/release/install-incan.sh", f"{dist_dir}/install.sh")?
    copy_text(
        f"{repo_root}/workspaces/release/toolchain/manifest.schema.v1.json",
        f"{dist_dir}/toolchain-manifest.schema.v1.json",
    )?

    if not skip_homebrew:
        formula = render_formula(version, rust_channel, assets)?
        write_text(f"{dist_dir}/incan.rb", formula)?

    return Ok(None)


def main() -> None:
    match prepare_assets():
        Ok(_) => return
        Err(err) =>
            println(f"prepare-assets: {err}")
            exit(1)
