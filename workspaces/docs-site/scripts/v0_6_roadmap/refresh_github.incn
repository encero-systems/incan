"""Refresh the checked-in v0.6 GitHub issue and blocker snapshots through the GitHub CLI."""

from rust::std::env import current_exe
from rust::std::io import Write, stderr
from rust::std::process import Command, exit
from rust::std::string import String as RustString
from std.datetime.civil import DateTime
from std.environ import args
from std.fs import Path
from std.json import JsonValue
from std.tempfile import TemporaryDirectory

const REPOSITORY: str = "repos/encero-systems/incan"


def main() -> None:
    """Fetch every milestone page and dependency record, then replace the snapshot as one complete update."""
    arguments = args().unwrap_or([])
    if len(arguments) > 2:
        write_stderr("refresh v0.6 roadmap: usage: refresh_github.incn [OUTPUT_DIRECTORY]\n")
        exit(2)
    mut output: Option[Path] = None
    if len(arguments) == 2:
        output = Some(Path(arguments[1]))
    match refresh(output):
        Ok(_) =>
            println("Refreshed the v0.6 roadmap GitHub snapshot.")
            exit(0)
        Err(message) =>
            write_stderr(f"refresh v0.6 roadmap: {message}\n")
            exit(1)


pub def refresh(output: Option[Path]) -> Result[None, str]:
    """
    Replace the snapshot only after every issue page and reported prerequisite list was fetched.

    1. Fetch all issue pages for milestone 6.
    2. Fetch blocker relationships for each issue that reports prerequisites.
    3. Publish both JSON documents and the UTC snapshot date together.
    """
    mut directory = repository_root()?.joinpath("workspaces/docs-site/scripts/v0_6_roadmap")
    if let Some(selected) = output:
        directory = selected
    directory.mkdir(true, true).map_err((error) => error.message())?
    temporary = TemporaryDirectory.try_new_with(".refresh.", "", Some(directory)).map_err((error) => error.message())?
    staging = temporary.path()

    # 1. GitHub pagination remains explicit so a short final page proves intake is complete.
    issues = fetch_issues()?
    write_json(staging.joinpath("github_issues.json"), JsonValue.array(issues))?

    # 2. A reported count without its records is never published as a complete blocker snapshot.
    blockers = fetch_blockers(issues)?
    write_json(staging.joinpath("github_blocked_by.json"), JsonValue.object(blockers))?

    # 3. Move the complete staged records into place and record the UTC day they represent.
    for name in ["github_issues.json", "github_blocked_by.json"]:
        destination = directory.joinpath(name)
        if destination.exists() or destination.is_symlink():
            destination.unlink().map_err((error) => error.message())?
        _ = staging.joinpath(name).move(destination).map_err((error) => error.message())?
    directory
        .joinpath("github_snapshot_date.txt")
        .write_text(DateTime.utc_now().date.isoformat() + "\n", "utf-8", "strict", None)
        .map_err((error) => error.message())?
    return Ok(None)


def fetch_issues() -> Result[list[JsonValue], str]:
    """Fetch every issue and pull-request record in milestone 6."""
    mut issues: list[JsonValue] = []
    mut page = 1
    while true:
        values = github_array(f"{REPOSITORY}/issues?milestone=6&state=all&per_page=100&page={page}")?
        count = len(values)
        issues += values
        if count < 100:
            break
        page += 1
    return Ok(issues)


def fetch_blockers(issues: list[JsonValue]) -> Result[Dict[str, JsonValue], str]:
    """Fetch prerequisite records for each non-pull-request issue that reports a positive count."""
    mut blockers: Dict[str, JsonValue] = {}
    for issue in issues:
        if issue.get("pull_request") != None:
            continue
        summary = issue.require("issue_dependencies_summary").map_err((error) => error.message())?
        count = summary
            .require("blocked_by")
            .and_then((value) => value.expect_int())
            .map_err((error) => error.message())?
        if count > 0:
            number = issue.require("number").and_then((value) => value.expect_int()).map_err((error) => error.message())?
            blockers[str(number)] = JsonValue.array(
                github_array(f"{REPOSITORY}/issues/{number}/dependencies/blocked_by?per_page=100")?,
            )
    return Ok(blockers)


def github_array(endpoint: str) -> Result[list[JsonValue], str]:
    """Read one GitHub REST array through `gh api`, retaining its complete refusal text."""
    output = Command
        .new("gh")
        .arg("api")
        .arg("--header")
        .arg("Accept: application/vnd.github+json")
        .arg("--header")
        .arg("X-GitHub-Api-Version: 2022-11-28")
        .arg(endpoint)
        .output()
        .map_err((error) => f"cannot run gh api: {error}")?
    if not output.status.success():
        return Err(RustString.from_utf8_lossy(output.stderr).into_owned())
    source = RustString.from_utf8(output.stdout).map_err((error) => error.to_string())?
    return JsonValue.parse(source).map_err((error) => error.message())?.expect_array().map_err(
        (error) => error.message(),
    )


def write_json(path: Path, value: JsonValue) -> Result[None, str]:
    """Write a pretty JSON snapshot with one trailing newline."""
    text = value.to_pretty_json().map_err((error) => error.message())? + "\n"
    return path.write_text(text, "utf-8", "strict", None).map_err((error) => error.message())


def repository_root() -> Result[Path, str]:
    """Find the repository above this program's Oven output directory."""
    binary = current_exe().map_err((error) => error.to_string())?
    mut directory = Path(binary.to_string_lossy().into_owned()).parent()
    while true:
        if directory.joinpath("AGENTS.md").is_file() and directory.joinpath("workspaces/docs-site").is_dir():
            return Ok(directory)
        parent = directory.parent()
        if parent.0 in [directory.0, "", "."]:
            return Err("cannot find the repository above the refresh program")
        directory = parent


def write_stderr(message: str) -> None:
    """Write one complete diagnostic, ignoring a closed diagnostic stream."""
    mut stream = stderr()
    _ = stream.write_all(RustString.from(message).into_bytes())
