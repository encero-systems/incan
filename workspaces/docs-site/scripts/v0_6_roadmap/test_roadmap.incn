"""Prove deterministic v0.6 roadmap hierarchy, blockers, state counts, and refusal boundaries."""

from rust::std::env import current_exe
from std.fs import Path
from roadmap import render


def test_fixture_renders_hierarchy_blockers_state_and_determinism() -> Result[None, str]:
    """The checked-in fixture renders every public graph and status invariant deterministically."""
    directory = fixture_directory()?
    issues = read(directory.joinpath("github_issues.json"))?
    blockers = read(directory.joinpath("github_blocked_by.json"))?
    first = render("2026-08-24", issues, blockers)?
    second = render("2026-08-24", issues, blockers)?
    assert first == second
    assert "s1137 -- owns --> i653" in first
    assert "flowchart LR" in first
    assert "i1103 -. blocks .-> i653" in first
    assert "class i1103,s1137 incv06complete" in first or "class s1137,i1103 incv06complete" in first
    assert "<span class=\"inc-v06-status inc-v06-status--complete\">1 complete</span>" in first
    assert "<span class=\"inc-v06-status inc-v06-status--open\">1 open</span>" in first
    assert "Blocked-by relationships are unavailable" not in first
    return Ok(None)


def test_missing_blocker_records_are_visible() -> Result[None, str]:
    """A positive blocker count without fetched records produces the publication warning."""
    directory = fixture_directory()?
    rendered = render("2026-08-24", read(directory.joinpath("github_issues.json"))?, "{}")?
    assert "Blocked-by relationships are unavailable in this snapshot" in rendered
    return Ok(None)


def fixture_directory() -> Result[Path, str]:
    """Find the fixture directory above this test's Oven output path."""
    binary = current_exe().map_err((error) => error.to_string())?
    mut directory = Path(binary.to_string_lossy().into_owned()).parent()
    while true:
        candidate = directory.joinpath("workspaces/docs-site/scripts/v0_6_roadmap/fixtures")
        if candidate.is_dir():
            return Ok(candidate)
        parent = directory.parent()
        if parent.0 in [directory.0, "", "."]:
            return Err("cannot find the v0.6 roadmap fixtures")
        directory = parent


def read(path: Path) -> Result[str, str]:
    """Read one fixture as strict UTF-8."""
    return path.read_text("utf-8", "strict").map_err((error) => error.message())
