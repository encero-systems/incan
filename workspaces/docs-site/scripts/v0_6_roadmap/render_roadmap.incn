"""Render the checked-in v0.6 GitHub snapshot into the documentation snippet."""

from rust::std::env import current_exe
from rust::std::io import Write, stderr
from rust::std::process import exit
from rust::std::string import String as RustString
from std.environ import args
from std.fs import Path
from roadmap import render


def main() -> None:
    """Locate the repository, render its retained snapshot, and replace the generated snippet."""
    arguments = args().unwrap_or([])
    match run(arguments[1:]):
        Ok(output) =>
            println(output.0)
            exit(0)
        Err(message) =>
            write_stderr(f"render v0.6 roadmap: {message}\n")
            exit(1)


pub def run(arguments: list[str]) -> Result[Path, str]:
    """Render the repository snapshot, or an explicit `DATE ISSUES BLOCKERS OUTPUT` proof fixture."""
    if len(arguments) == 4:
        output = Path(arguments[3])
        rendered = render(arguments[0], read(Path(arguments[1]))?, read(Path(arguments[2]))?)?
        output.parent().mkdir(true, true).map_err((error) => error.message())?
        output.write_text(rendered, "utf-8", "strict", None).map_err((error) => error.message())?
        return Ok(output)
    if len(arguments) != 0:
        return Err("usage: render_roadmap.incn [DATE ISSUES_JSON BLOCKERS_JSON OUTPUT]")
    root = repository_root()?
    directory = root.joinpath("workspaces/docs-site/scripts/v0_6_roadmap")
    date = read(directory.joinpath("github_snapshot_date.txt"))?.strip()
    if date == "":
        return Err("github_snapshot_date.txt is empty; refresh the snapshot first")
    output = root.joinpath("workspaces/docs-site/docs/_snippets/project/v0_6_roadmap.md")
    rendered = render(
        date,
        read(directory.joinpath("github_issues.json"))?,
        read(directory.joinpath("github_blocked_by.json"))?,
    )?
    output.write_text(rendered, "utf-8", "strict", None).map_err((error) => error.message())?
    return Ok(output)


def repository_root() -> Result[Path, str]:
    """Find the repository above this program's Oven output directory."""
    binary = current_exe().map_err((error) => error.to_string())?
    mut directory = Path(binary.to_string_lossy().into_owned()).parent()
    while true:
        if directory.joinpath("AGENTS.md").is_file() and directory.joinpath("workspaces/docs-site").is_dir():
            return Ok(directory)
        parent = directory.parent()
        if parent.0 in [directory.0, "", "."]:
            return Err("cannot find the repository above the rendered program")
        directory = parent


def read(path: Path) -> Result[str, str]:
    """Read one strict UTF-8 roadmap input."""
    return path.read_text("utf-8", "strict").map_err((error) => f"{path.0}: {error.message()}")


def write_stderr(message: str) -> None:
    """Write one complete diagnostic, ignoring a closed diagnostic stream."""
    mut stream = stderr()
    _ = stream.write_all(RustString.from(message).into_bytes())
