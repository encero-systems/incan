"""Render the checked-in v0.6 issue snapshot as the public roadmap table and dependency graphs."""

from std.json import JsonValue


pub model Slice:
    """One ordered roadmap slice and the public proof text shown for it."""

    pub number: int
    pub issue_number: int
    pub slug: str
    pub title: str
    pub focus: str
    pub proof: str
    pub exit_evidence: str


pub model Issue:
    """The GitHub issue fields that determine roadmap hierarchy, state, links, and blocker edges."""

    pub number: int
    pub title: str
    pub state: str
    pub url: str
    pub blocked_by: int
    pub parent: Option[int]


pub def render(snapshot_date: str, issues_json: str, blockers_json: str) -> Result[str, str]:
    """
    Render one deterministic roadmap snapshot.

    1. Decode the issue and blocker records into the renderer's typed boundary.
    2. Render the summary table and one graph-backed detail block per slice.
    3. Warn when GitHub reported blocker counts whose relationship records are absent.
    """
    # 1. Decode the checked-in GitHub facts once.
    issues = decode_issues(issues_json)?
    blockers = decode_blockers(blockers_json)?
    specs = slices()

    # 2. Build the stable table and ordered slice details.
    mut output = "<!-- Generated by `scripts/v0_6_roadmap/render_roadmap.incn`; do not edit by hand. -->\n\n"
    output += f"**GitHub snapshot:** {snapshot_date}. In this map, **complete** means the GitHub issue is closed; "
    output += "**open** means it remains unfinished. Complete issue nodes are green; open nodes retain the gold outline.\n\n"

    # 3. Make incomplete dependency intake visible instead of silently omitting edges.
    missing = missing_blocker_relationships(issues, blockers)
    if len(missing) > 0:
        output += "> **Blocked-by relationships are unavailable in this snapshot.** GitHub reports prerequisites for "
        output += f"{len(missing)} issues, but their relationship records were not fetched; dashed edges are therefore omitted. "
        output += "Refresh with `GITHUB_TOKEN` before publishing.\n\n"
    output += roadmap_table(specs, issues) + "\n"
    mut details: list[str] = []
    for spec in specs:
        details.append(slice_detail(spec, issues, blockers)?)
    output += "\n".join(details)
    return Ok(output.strip() + "\n")


pub def decode_issues(source: str) -> Result[list[Issue], str]:
    """Decode non-pull-request issue records from one GitHub milestone response."""
    values = JsonValue.parse(source).map_err((error) => error.message())?.expect_array().map_err(
        (error) => error.message(),
    )?
    mut issues: list[Issue] = []
    for value in values:
        if value.get("pull_request") != None:
            continue
        issues.append(decode_issue(value)?)
    return Ok(issues)


pub def decode_blockers(source: str) -> Result[Dict[str, list[Issue]], str]:
    """Decode the issue-number keyed prerequisite responses retained beside the snapshot."""
    fields = JsonValue.parse(source).map_err((error) => error.message())?.expect_object().map_err(
        (error) => error.message(),
    )?
    mut blockers: Dict[str, list[Issue]] = {}
    for key in fields.keys():
        mut entries: list[Issue] = []
        for value in fields[key].expect_array().map_err((error) => error.message())?:
            entries.append(decode_issue(value)?)
        blockers[key] = entries
    return Ok(blockers)


def roadmap_table(specs: list[Slice], issues: list[Issue]) -> str:
    """Render the compact slice summary table."""
    mut output = "<div class=\"inc-v06-roadmap-table-wrap\">\n<table class=\"inc-v06-roadmap-table\">\n"
    output += "  <thead>\n    <tr>\n      <th scope=\"col\">Slice</th>\n      <th scope=\"col\">Focus</th>\n"
    output += "      <th scope=\"col\">Proof before moving on</th>\n    </tr>\n  </thead>\n  <tbody>\n"
    for spec in specs:
        nodes = tree_issues(issues, spec.issue_number)
        complete = len([issue for issue in nodes if issue.state == "closed"])
        open_count = len([issue for issue in nodes if issue.state == "open"])
        output += f"    <tr data-v06-slice-target=\"{slice_id(spec)}\">\n"
        output += f"      <td><button type=\"button\" class=\"inc-v06-slice-toggle\">{spec.number}. {spec.title}</button>"
        output += "<div class=\"inc-v06-slice-status\">"
        output += f"<span class=\"inc-v06-status inc-v06-status--complete\">{complete} complete</span>"
        output += f"<span class=\"inc-v06-status inc-v06-status--open\">{open_count} open</span></div></td>\n"
        output += f"      <td>{spec.focus}</td>\n      <td>{spec.proof}</td>\n    </tr>\n"
    return output + "  </tbody>\n</table>\n</div>\n"


def slice_detail(spec: Slice, issues: list[Issue], blockers: Dict[str, list[Issue]]) -> Result[str, str]:
    """Render one expandable slice with its exit evidence, graph, and root issue link."""
    nodes = tree_issues(issues, spec.issue_number)
    root = root_issue(issues, spec.issue_number)?
    mut opening = f"<details id=\"{slice_id(spec)}\" class=\"inc-v06-slice\" markdown=\"1\""
    if spec.number == 1:
        opening += " open"
    mut output = opening + f">\n<summary>{spec.number}. {spec.title}</summary>\n\n"
    output += f"**Exit evidence:** {spec.exit_evidence}\n\n"
    output += render_graph(spec, nodes, blockers)
    output += f"[Open Slice {spec.number} in GitHub]({root.url})\n\n</details>\n"
    return Ok(output)


def render_graph(spec: Slice, nodes: list[Issue], blockers: Dict[str, list[Issue]]) -> str:
    """Render hierarchy, prerequisite edges, completed-node styling, and GitHub links for one slice."""
    external = blocker_nodes(nodes, blockers)
    all_nodes = unique_issues(nodes + external)
    mut complete: list[str] = []
    mut output = "```mermaid\nflowchart LR\n"
    for issue in all_nodes:
        output += f"  {node_id(issue.number, spec.issue_number)}[\"{node_label(issue, spec)}\"]\n"
        if issue.state == "closed":
            complete.append(node_id(issue.number, spec.issue_number))
    for issue in nodes:
        if issue.number != spec.issue_number:
            if let Some(parent) = issue.parent:
                output += f"  {node_id(parent, spec.issue_number)} -- owns --> {node_id(issue.number, spec.issue_number)}\n"
    for issue in nodes:
        for blocker in blockers.get(str(issue.number)).unwrap_or([]):
            output += f"  {node_id(blocker.number, spec.issue_number)} -. blocks .-> {node_id(
                issue.number,
                spec.issue_number,
            )}\n"
    if len(complete) > 0:
        output += "  classDef incv06complete fill:#0b2724,stroke:#66d9a3,color:#e4ebf2,stroke-width:1.7px\n"
        complete_ids = ",".join(complete)
        output += f"  class {complete_ids} incv06complete\n"
    for issue in all_nodes:
        identifier = node_id(issue.number, spec.issue_number)
        output += f"  click {identifier} href \"{issue.url}\" \"Open #{issue.number} on GitHub\"\n"
    return output + "```\n"


def tree_issues(issues: list[Issue], root: int) -> list[Issue]:
    """Return one root and all descendants in stable snapshot order without duplicate issue numbers."""
    mut selected: list[Issue] = []
    for issue in issues:
        if issue.number == root:
            selected.append(issue)
    selected += descendants(issues, root)
    return unique_issues(selected)


def descendants(issues: list[Issue], parent: int) -> list[Issue]:
    """Return the recursively nested children of one issue in snapshot order."""
    mut selected: list[Issue] = []
    for issue in issues:
        if issue.parent == Some(parent):
            selected.append(issue)
            selected += descendants(issues, issue.number)
    return selected


def blocker_nodes(nodes: list[Issue], blockers: Dict[str, list[Issue]]) -> list[Issue]:
    """Return prerequisites that sit outside the slice hierarchy."""
    numbers = [issue.number for issue in nodes]
    mut selected: list[Issue] = []
    for issue in nodes:
        for blocker in blockers.get(str(issue.number)).unwrap_or([]):
            if blocker.number not in numbers:
                selected.append(blocker)
    return unique_issues(selected)


def missing_blocker_relationships(issues: list[Issue], blockers: Dict[str, list[Issue]]) -> list[int]:
    """Return issues whose reported prerequisite count has no fetched relationship entry."""
    return [issue.number for issue in issues if issue.blocked_by > 0 and str(issue.number) not in blockers]


def unique_issues(issues: list[Issue]) -> list[Issue]:
    """Keep the first issue for each number without reordering the snapshot."""
    mut seen: set[int] = set()
    mut unique: list[Issue] = []
    for issue in issues:
        if issue.number not in seen:
            seen.add(issue.number)
            unique.append(issue)
    return unique


def decode_issue(value: JsonValue) -> Result[Issue, str]:
    """Decode one GitHub issue or dependency record, accepting absent hierarchy metadata."""
    number = integer(value, "number")?
    mut blocked_by = 0
    if let Some(summary) = value.get("issue_dependencies_summary"):
        if let Some(count) = summary.get("blocked_by"):
            blocked_by = count.expect_int().map_err((error) => error.message())?
    mut parent: Option[int] = None
    if let Some(parent_url) = value.get("parent_issue_url"):
        if not parent_url.is_null():
            parts = parent_url.expect_str().map_err((error) => error.message())?.split("/")
            if len(parts) > 0:
                parent = decimal(parts[len(parts) - 1])
    return Ok(
        Issue(
            number=number,
            title=text(value, "title")?,
            state=text(value, "state")?,
            url=text(value, "html_url")?,
            blocked_by=blocked_by,
            parent=parent,
        ),
    )


def root_issue(issues: list[Issue], number: int) -> Result[Issue, str]:
    """Return the required slice root or explain which milestone issue is absent."""
    for issue in issues:
        if issue.number == number:
            return Ok(issue)
    return Err(f"the v0.6 milestone snapshot does not contain slice root #{number}")


def node_label(issue: Issue, spec: Slice) -> str:
    """Return the root or child label shown inside a Mermaid node."""
    if issue.number == spec.issue_number:
        return f"Slice {spec.number}<br/>#{issue.number}"
    return f"#{issue.number}<br/>{graph_title(issue.title)}"


def graph_title(title: str) -> str:
    """Remove the change prefix, bound the title, and escape Mermaid string syntax."""
    mut value = title[:]
    for prefix in ["feature - ", "bugfix - ", "chore - ", "docs - ", "refactor - "]:
        if value.startswith(prefix):
            value = value[len(prefix):]
            break
    if len(value) > 42:
        value = value[:39] + "…"
    return value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", " ").replace("\n", " ")


def node_id(number: int, root: int) -> str:
    """Use the slice prefix for a root and the issue prefix for every other node."""
    if number == root:
        return f"s{number}"
    return f"i{number}"


def slice_id(spec: Slice) -> str:
    """Return the zero-padded public fragment identifier for one slice."""
    mut number = str(spec.number)
    if len(number) == 1:
        number = "0" + number
    return f"slice-{number}-{spec.slug}"


def text(value: JsonValue, key: str) -> Result[str, str]:
    """Return one required string field with its key in any diagnostic."""
    return value.require(key).and_then((entry) => entry.expect_str()).map_err((error) => f"{key}: {error.message()}")


def integer(value: JsonValue, key: str) -> Result[int, str]:
    """Return one required integer field with its key in any diagnostic."""
    return value.require(key).and_then((entry) => entry.expect_int()).map_err((error) => f"{key}: {error.message()}")


def decimal(value: str) -> Option[int]:
    """Parse a non-empty decimal issue number without accepting signs or whitespace."""
    if value == "":
        return None
    for character in value:
        if character not in "0123456789":
            return None
    return Some(int(value))


def slices() -> list[Slice]:
    """Return the maintainer-authored v0.6 slice order and public proof text."""
    return [
        Slice(
            number=1,
            issue_number=1137,
            slug="cutover-foundation",
            title="Cutover foundation",
            focus="Cutover facts, Body IR, and parity.",
            proof="Selected and executed routes are receipted; unavailable comparisons stay non-green.",
            exit_evidence="backend selection and execution are explicit; parity records have stable IDs; unavailable or skipped comparisons remain non-green.",
        ),
        Slice(
            number=2,
            issue_number=1138,
            slug="first-executable-proof",
            title="First executable proof",
            focus="Direct execution of a bounded Body-IR program.",
            proof="Source spans, semantic facts, and paired receipts survive execution.",
            exit_evidence="a bounded Body-IR program executes through the replacement route with source spans, ownership/runtime facts, and paired receipts.",
        ),
        Slice(
            number=3,
            issue_number=1140,
            slug="language-runtime-matrix",
            title="Language and runtime matrix",
            focus="Embedded fragments, capabilities, and package vocabulary.",
            proof="Accepted constructs have parity, diagnostics, inspection, and migration evidence.",
            exit_evidence="every accepted construct has parity coverage, diagnostics, inspection output, formatter/LSP proof where relevant, and an explicit migration disposition.",
        ),
        Slice(
            number=4,
            issue_number=1141,
            slug="oven-authority-native-rust",
            title="Oven authority and native Rust",
            focus="Loaf authority, direct-rustc planning, and bounded Rust facets.",
            proof="Incan-only, Rust-only, and mixed Loaves bake without Cargo being authoritative.",
            exit_evidence="Rust-only, Incan-only, and mixed Loaves bake without Cargo being the project authority; Cargo remains valid as explicit compatibility/adoption mode.",
        ),
        Slice(
            number=5,
            issue_number=1478,
            slug="workspace-layout-rewrite",
            title="Workspace layout rewrite, five rings under loaves/",
            focus="Kernel, compiler, Oven, stdlib and toolchain rings with an Incan-free Oven ring.",
            proof="The Oven ring depends on no Incan ring, incan-lsp builds without the CLI, and every ring carries its own version line.",
            exit_evidence="the root crate is split along the four import knots into ring crates under loaves/; the Oven ring checks in a tree with no compiler crates; paths, tests and CI follow the rings; incan_core is renamed incan_lang last.",
        ),
        Slice(
            number=6,
            issue_number=1561,
            slug="loaf-native-ecosystem",
            title="Loaf-native ecosystem, build scripts inert",
            focus="Manifest-declared package needs; no build-script execution.",
            proof="Every dependency in the corpus bakes from its manifest alone, byte-equivalent to its Cargo build.",
            exit_evidence="a build.rs anywhere in a bake produces one warning and nothing else; every package in incan's and IncQL's resolved graphs bakes under Oven from a loaf.toml with no Cargo invocation; adoption writes those manifests from an existing Cargo build.",
        ),
        Slice(
            number=7,
            issue_number=1675,
            slug="replacement-route-parity-cutover",
            title="Replacement-route parity and cutover",
            focus="Incan as a second front end to the pinned rustc at HIR, driven by Oven.",
            proof="Every parity corpus case is green on the native lane against the emitted-Rust route, or explicitly migrated.",
            exit_evidence="no Rust source is produced at any point in building a program or the toolchain; Oven builds both and Cargo is invoked nowhere on a developer machine; every parity corpus case is green on the native lane against the emitted-Rust route, or explicitly migrated, with receipts.",
        ),
        Slice(
            number=8,
            issue_number=1142,
            slug="oven-cli-delivery",
            title="Oven CLI delivery",
            focus="Shared Oven planning for build and bake.",
            proof="One plan and receipt model; neither CLI gains a competing planner.",
            exit_evidence="one installation, two non-competing CLIs, one Loaf authority, and one plan/receipt model.",
        ),
        Slice(
            number=9,
            issue_number=1143,
            slug="first-class-inspectability",
            title="First-class inspectability",
            focus="Shared compiler, package, artifact, and Rust/Oven inspection facts.",
            proof="CLI, LSP, Architect, MCP, and Rust inspection agree on identity and provenance.",
            exit_evidence="CLI, LSP, Architect, MCP, and Rust inspection agree on identity, range, provenance, and stale-state semantics.",
        ),
        Slice(
            number=10,
            issue_number=1379,
            slug="native-windows",
            title="Native Windows support",
            focus="A Windows host that builds, bakes, and ships like the others.",
            proof="A packaged Windows toolchain builds and runs a project, not merely a bake that exits zero.",
            exit_evidence="the release bake produces a Windows archive; that archive, extracted and installed, scaffolds a project and builds it; platform-gated behavior is implemented or its divergence is stated in code and docs.",
        ),
        Slice(
            number=11,
            issue_number=1144,
            slug="cutover-release",
            title="Cutover and release",
            focus="Corpus-led compatibility reporting and normal-path removal.",
            proof="The complete matrix is green or explicitly migrated before generated Rust loses authority.",
            exit_evidence="generated Rust is an inspection/debug projection only; normal compilation, package contracts, and Oven no longer depend on it as semantic authority.",
        ),
        Slice(
            number=12,
            issue_number=1421,
            slug="incan-authored-control-plane",
            title="Incan-authored control plane and governed runtime",
            focus="Incan-authored Oven components and the RFC 104 authority model.",
            proof="Components migrate only behind a bridge that exists, and declared authority matches observed receipts.",
            exit_evidence="every semantic Oven responsibility with an Incan-authored owner is authored in Incan through a typed, governed host kernel; no migrated component relies on an undocumented bridge; declared authority and observed receipts describe the same run and stay inspectable without executing source or parsing logs.",
        ),
    ]
